pub mod io {
    use crate::*;
    pub use crate::{IoError,IoErrorKind};
    pub trait Read {
        type Effects: EffectRow;
        fn read(value: &mut Self, buffer: SliceMut<u8>) -> Result<usize,IoError>
            / { | <Self as Read>::Effects };
    }
    pub trait Write {
        type Effects: EffectRow;
        fn write(value: &mut Self, buffer: Slice<u8>) -> Result<usize,IoError>
            / { | <Self as Write>::Effects };
        fn flush(value: &mut Self) -> Result<(),IoError> / { | <Self as Write>::Effects };
    }
    pub enum SeekFrom { Start(u64), End(i64), Current(i64) }
    pub trait Seek {
        type Effects: EffectRow;
        fn seek(value: &mut Self, from: SeekFrom) -> Result<u64,IoError>
            / { | <Self as Seek>::Effects };
    }
    pub trait BufferedRead: Read {
        fn fill_buf<'a>(value: &'a mut Self) -> Result<Slice<'a,u8>,IoError>
            / { | <Self as Read>::Effects };
        fn consume(value: &mut Self, count: usize) -> Result<(),RangeError>;
    }
    pub struct ReadExactError { pub filled: usize, pub error: IoError }
    pub struct WriteAllError { pub written: usize, pub error: IoError }
    pub struct CopyError { pub read: u64, pub written: u64, pub error: IoError }
    pub struct ReadToEndError { pub appended: usize, pub error: IoError }
    fn error(kind: IoErrorKind) -> IoError { IoError { kind: kind, native_code: None } }
    fn suffix<'a>(bytes: Slice<'a,u8>, start: usize) -> Slice<'a,u8> {
        handle Slice::slice(bytes, Range { start: start, end: Slice::len(&bytes) }) {
            Result::Ok(view) => view, Result::Err(_) => crate::__g1_abort(),
        }
    }
    fn prefix<'a>(bytes: Slice<'a,u8>, count: usize) -> Slice<'a,u8> {
        handle Slice::slice(bytes, Range { start: 0, end: count }) {
            Result::Ok(view) => view, Result::Err(_) => crate::__g1_abort(),
        }
    }
    fn reborrow<'a,'b>(bytes: &'b mut SliceMut<'a,u8>, start: usize, end: usize) -> SliceMut<'b,u8> {
        let view = SliceMut { storage: &mut *bytes.storage, length: bytes.length };
        handle SliceMut::slice(view, Range { start: start, end: end }) {
            Result::Ok(view) => view, Result::Err(_) => crate::__g1_abort(),
        }
    }
    fn read_exact_from<R>(reader: &mut R, buffer: &mut SliceMut<u8>, filled: usize)
        -> Result<(),ReadExactError> / { | <R as Read>::Effects } where R: Read {
        let length = SliceMut::len(& *buffer);
        handle filled == length {
            true => Result::Ok(()),
            false => handle Read::read(&mut *reader, reborrow(buffer, filled, length)) {
                Result::Err(error) => Result::Err(ReadExactError { filled: filled, error: error }),
                Result::Ok(count) => handle count > length - filled {
                    true => Result::Err(ReadExactError { filled: filled, error: error(IoErrorKind::InvalidData) }),
                    false => handle count == 0 {
                        true => Result::Err(ReadExactError { filled: filled, error: error(IoErrorKind::UnexpectedEof) }),
                        false => tail read_exact_from(reader, buffer, filled + count),
                    },
                },
            },
        }
    }
    pub fn read_exact<R>(reader: &mut R, buffer: SliceMut<u8>) -> Result<(),ReadExactError>
        / { | <R as Read>::Effects } where R: Read {
        let mut buffer = buffer;
        read_exact_from(reader, &mut buffer, 0)
    }
    fn write_from<W>(writer: &mut W, bytes: Slice<u8>, written: usize) -> Result<(),WriteAllError>
        / { | <W as Write>::Effects } where W: Write {
        handle written == Slice::len(&bytes) {
            true => Result::Ok(()),
            false => handle Write::write(&mut *writer, suffix(bytes, written)) {
                Result::Err(error) => Result::Err(WriteAllError { written: written, error: error }),
                Result::Ok(count) => handle count > Slice::len(&bytes) - written {
                    true => Result::Err(WriteAllError { written: written, error: error(IoErrorKind::InvalidData) }),
                    false => handle count == 0 {
                        true => Result::Err(WriteAllError { written: written, error: error(IoErrorKind::WriteZero) }),
                        false => tail write_from(writer, bytes, written + count),
                    },
                },
            },
        }
    }
    pub fn write_all<W>(writer: &mut W, buffer: Slice<u8>) -> Result<(),WriteAllError>
        / { | <W as Write>::Effects } where W: Write { write_from(writer, buffer, 0) }
    fn read_end_from<R>(reader: &mut R, out: &mut Vec<u8>, buffer: &mut Vec<u8>, limit: usize, appended: usize)
        -> Result<usize,ReadToEndError> / { | <R as Read>::Effects } where R: Read {
        handle appended == limit {
            true => Result::Ok(appended),
            false => {
                let length = min(limit - appended, Vec::len(& *buffer));
                let view = handle SliceMut::slice(Vec::as_mut_slice(&mut *buffer), Range { start: 0, end: length }) {
                    Result::Ok(view) => view, Result::Err(_) => crate::__g1_abort(),
                };
                handle Read::read(&mut *reader, view) {
                    Result::Err(error) => Result::Err(ReadToEndError { appended: appended, error: error }),
                    Result::Ok(count) => handle count > length {
                        true => Result::Err(ReadToEndError { appended: appended, error: error(IoErrorKind::InvalidData) }),
                        false => handle count == 0 {
                            true => Result::Ok(appended),
                            false => handle Vec::try_reserve(&mut *out, count) {
                                Result::Err(_) => Result::Err(ReadToEndError { appended: appended, error: error(IoErrorKind::ResourceLimit) }),
                                Result::Ok(_) => {
                                    Vec::extend_from_slice(&mut *out, prefix(Vec::as_slice(& *buffer), count));
                                    tail read_end_from(reader, out, buffer, limit, appended + count)
                                },
                            },
                        },
                    },
                }
            },
        }
    }
    pub fn read_to_end<R>(reader: &mut R, out: &mut Vec<u8>, limit: usize) -> Result<usize,ReadToEndError>
        / { | <R as Read>::Effects } where R: Read {
        let length = min(limit, 4096);
        let mut buffer = Vec::with_capacity(length);
        Vec::resize(&mut buffer, length, 0);
        read_end_from(reader, out, &mut buffer, limit, 0)
    }
    fn copy_from<R,W>(reader: &mut R, writer: &mut W, buffer: &mut Vec<u8>, limit: u64, copied: u64)
        -> Result<u64,CopyError> / { | <R as Read>::Effects,<W as Write>::Effects } where R: Read, W: Write {
        handle copied == limit {
            true => Result::Ok(copied),
            false => {
                let length = as<usize>(min(limit - copied, as<u64>(Vec::len(& *buffer))));
                let view = handle SliceMut::slice(Vec::as_mut_slice(&mut *buffer), Range { start: 0, end: length }) {
                    Result::Ok(view) => view, Result::Err(_) => crate::__g1_abort(),
                };
                handle Read::read(&mut *reader, view) {
                    Result::Err(error) => Result::Err(CopyError { read: copied, written: copied, error: error }),
                    Result::Ok(count) => handle count > length {
                        true => Result::Err(CopyError { read: copied, written: copied, error: error(IoErrorKind::InvalidData) }),
                        false => handle count == 0 {
                            true => Result::Ok(copied),
                            false => handle write_all(&mut *writer, prefix(Vec::as_slice(& *buffer), count)) {
                                Result::Err(failure) => Result::Err(CopyError { read: copied + as<u64>(count),
                                    written: copied + as<u64>(failure.written), error: failure.error }),
                                Result::Ok(_) => tail copy_from(reader, writer, buffer, limit, copied + as<u64>(count)),
                            },
                        },
                    },
                }
            },
        }
    }
    pub fn copy_stream<R,W>(reader: &mut R, writer: &mut W, limit: u64) -> Result<u64,CopyError>
        / { | <R as Read>::Effects,<W as Write>::Effects } where R: Read, W: Write {
        let length = as<usize>(min(limit, 4096));
        let mut buffer = Vec::with_capacity(length);
        Vec::resize(&mut buffer, length, 0);
        copy_from(reader, writer, &mut buffer, limit, 0)
    }

    pub struct BufferReader<R> { private reader: R, private buffer: Vec<u8>, private start: usize, private end: usize }
    pub struct BufferWriter<W> { private writer: W, private buffer: Vec<u8>, private start: usize, private capacity: usize }
    pub struct FinishWriteFailure<W> { pub writer: W, pub pending: Vec<u8>, pub error: IoError }
    fn allocation_error(failure: ReserveError) -> AllocError {
        handle failure { ReserveError::CapacityOverflow => AllocError::LimitExceeded, ReserveError::Allocation(error) => error }
    }
    impl<R> BufferReader<R> {
        pub fn new(reader: R, capacity: usize) -> Result<Self,Rejected<R,AllocError>> {
            let capacity = max(capacity, 1);
            handle Vec::try_with_capacity(capacity) {
                Result::Err(error) => Result::Err(Rejected { value: reader, error: allocation_error(error) }),
                Result::Ok(buffer) => {
                    let mut buffer = buffer;
                    Vec::resize(&mut buffer, capacity, 0);
                    Result::Ok(BufferReader { reader: reader, buffer: buffer, start: 0, end: 0 })
                },
            }
        }
        pub fn get_ref<'a>(value: &'a Self) -> &'a R { &value.reader }
        pub fn into_parts(value: Self) -> (R,Vec<u8>) {
            let BufferReader { reader: reader, buffer: buffer, start: start, end: end } = value;
            let mut buffer = buffer;
            Vec::truncate(&mut buffer, end);
            let unread = handle Vec::split_off(&mut buffer, start) {
                Result::Ok(unread) => unread, Result::Err(_) => crate::__g1_abort(),
            };
            (reader, unread)
        }
    }
    fn ensure_buffer<R>(value: &mut BufferReader<R>) -> Result<(),IoError>
        / { | <R as Read>::Effects } where R: Read {
        handle value.start < value.end {
            true => Result::Ok(()),
            false => {
                (*value).start = 0;
                (*value).end = 0;
                handle Read::read(&mut value.reader, Vec::as_mut_slice(&mut value.buffer)) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(count) => handle count > Vec::len(&value.buffer) {
                        true => Result::Err(error(IoErrorKind::InvalidData)),
                        false => { (*value).end = count; Result::Ok(()) },
                    },
                }
            },
        }
    }
    pub impl<R> Read for BufferReader<R> where R: Read {
        type Effects = <R as Read>::Effects;
        fn read(value: &mut Self, buffer: SliceMut<u8>) -> Result<usize,IoError>
            / { | <R as Read>::Effects } {
            handle SliceMut::len(&buffer) == 0 {
                true => Result::Ok(0),
                false => handle ensure_buffer(&mut *value) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(_) => {
                        let count = min(SliceMut::len(&buffer), value.end - value.start);
                        copy_bytes(prefix(suffix(Vec::as_slice(&value.buffer), value.start), count), buffer, 0);
                        (*value).start = value.start + count;
                        Result::Ok(count)
                    },
                },
            }
        }
    }
    pub impl<R> BufferedRead for BufferReader<R> where R: Read {
        fn fill_buf<'a>(value: &'a mut Self) -> Result<Slice<'a,u8>,IoError>
            / { | <R as Read>::Effects } {
            handle ensure_buffer(&mut *value) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => Result::Ok(prefix(suffix(Vec::as_slice(&value.buffer), value.start), value.end - value.start)),
            }
        }
        fn consume(value: &mut Self, count: usize) -> Result<(),RangeError> {
            handle count > value.end - value.start {
                true => Result::Err(RangeError::OutOfBounds),
                false => { (*value).start = value.start + count; Result::Ok(()) },
            }
        }
    }
    impl<W> BufferWriter<W> {
        pub fn new(writer: W, capacity: usize) -> Result<Self,Rejected<W,AllocError>> {
            let capacity = max(capacity, 1);
            handle Vec::try_with_capacity(capacity) {
                Result::Err(error) => Result::Err(Rejected { value: writer, error: allocation_error(error) }),
                Result::Ok(buffer) => Result::Ok(BufferWriter { writer: writer, buffer: buffer, start: 0, capacity: capacity }),
            }
        }
        pub fn get_ref<'a>(value: &'a Self) -> &'a W { &value.writer }
        pub fn pending<'a>(value: &'a Self) -> Slice<'a,u8> { suffix(Vec::as_slice(&value.buffer), value.start) }
        pub fn into_parts(value: Self) -> (W,Vec<u8>) {
            let BufferWriter { writer: writer, buffer: buffer, start: start, capacity: capacity } = value;
            let mut buffer = buffer;
            let pending = handle Vec::split_off(&mut buffer, start) {
                Result::Ok(pending) => pending, Result::Err(_) => crate::__g1_abort(),
            };
            (writer, pending)
        }
        pub fn finish(value: Self) -> Result<W,FinishWriteFailure<W>>
            / { | <W as Write>::Effects } where W: Write {
            let mut value = value;
            let result = handle flush_pending(&mut value) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => Write::flush(&mut value.writer),
            };
            let (writer, pending) = Self::into_parts(value);
            handle result {
                Result::Err(error) => Result::Err(FinishWriteFailure { writer: writer, pending: pending, error: error }),
                Result::Ok(_) => Result::Ok(writer),
            }
        }
    }
    fn flush_pending<W>(value: &mut BufferWriter<W>) -> Result<(),IoError>
        / { | <W as Write>::Effects } where W: Write {
        handle value.start == Vec::len(&value.buffer) {
            true => { Vec::clear(&mut value.buffer); (*value).start = 0; Result::Ok(()) },
            false => handle Write::write(&mut value.writer, suffix(Vec::as_slice(&value.buffer), value.start)) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(count) => handle count > Vec::len(&value.buffer) - value.start {
                    true => Result::Err(error(IoErrorKind::InvalidData)),
                    false => handle count == 0 {
                        true => Result::Err(error(IoErrorKind::WriteZero)),
                        false => { (*value).start = value.start + count; tail flush_pending(value) },
                    },
                },
            },
        }
    }
    pub impl<W> Write for BufferWriter<W> where W: Write {
        type Effects = <W as Write>::Effects;
        fn write(value: &mut Self, buffer: Slice<u8>) -> Result<usize,IoError>
            / { | <W as Write>::Effects } {
            handle Slice::len(&buffer) == 0 { true => return(Result::Ok(0), @write), false => () };
            handle Vec::len(&value.buffer) == value.capacity {
                false => (),
                true => handle flush_pending(&mut *value) {
                    Result::Ok(_) => (), Result::Err(error) => return(Result::Err(error), @write),
                },
            };
            let count = min(Slice::len(&buffer), value.capacity - Vec::len(&value.buffer));
            Vec::extend_from_slice(&mut value.buffer, prefix(buffer, count));
            Result::Ok(count)
        }
        fn flush(value: &mut Self) -> Result<(),IoError> / { | <W as Write>::Effects } {
            handle flush_pending(&mut *value) {
                Result::Err(error) => Result::Err(error), Result::Ok(_) => Write::flush(&mut value.writer),
            }
        }
    }

    pub struct MemoryCursor { private bytes: Vec<u8>, private position: u64 }
    impl MemoryCursor {
        pub fn new(bytes: Vec<u8>) -> Self { MemoryCursor { bytes: bytes, position: 0 } }
        pub fn position(value: &Self) -> u64 { value.position }
        pub fn as_slice<'a>(value: &'a Self) -> Slice<'a,u8> { Vec::as_slice(&value.bytes) }
        pub fn into_inner(value: Self) -> Vec<u8> { value.bytes }
    }
    fn copy_bytes(input: Slice<u8>, out: SliceMut<u8>, index: usize) {
        handle index == Slice::len(&input) {
            true => (),
            false => handle SliceMut::split_at(out, 1) {
                Result::Err(_) => crate::__g1_abort(),
                Result::Ok((first, rest)) => {
                    let destination = SliceMut::get_unchecked(first, 0);
                    *destination = *Slice::get_unchecked(input, index);
                    tail copy_bytes(input, rest, index + 1)
                },
            },
        }
    }
    pub impl Read for MemoryCursor {
        type Effects = {};
        fn read(value: &mut Self, buffer: SliceMut<u8>) -> Result<usize,IoError> {
            handle value.position >= as<u64>(Vec::len(&value.bytes)) {
                true => Result::Ok(0),
                false => {
                    let position = as<usize>(value.position);
                    let count = min(SliceMut::len(&buffer), Vec::len(&value.bytes) - position);
                    copy_bytes(prefix(suffix(Vec::as_slice(&value.bytes), position), count), buffer, 0);
                    (*value).position = value.position + as<u64>(count);
                    Result::Ok(count)
                },
            }
        }
    }
    pub impl Write for MemoryCursor {
        type Effects = {};
        fn write(value: &mut Self, buffer: Slice<u8>) -> Result<usize,IoError> {
            let count = Slice::len(&buffer);
            handle count == 0 { true => return(Result::Ok(0), @write), false => () };
            handle value.position > as<u64>(bit_not<usize>(0)) {
                true => Result::Err(error(IoErrorKind::ResourceLimit)),
                false => {
                    let position = as<usize>(value.position);
                    handle count > bit_not<usize>(0) - position {
                        true => Result::Err(error(IoErrorKind::ResourceLimit)),
                        false => {
                            let end = position + count;
                            let length = Vec::len(&value.bytes);
                            let additional = handle end > length { true => end - length, false => 0 };
                            handle Vec::try_reserve(&mut value.bytes, additional) {
                                Result::Err(_) => Result::Err(error(IoErrorKind::ResourceLimit)),
                                Result::Ok(_) => {
                                    handle end > length { true => Vec::resize(&mut value.bytes, end, 0), false => () };
                                    let destination = handle SliceMut::slice(Vec::as_mut_slice(&mut value.bytes), Range { start: position, end: end }) {
                                        Result::Ok(view) => view, Result::Err(_) => crate::__g1_abort(),
                                    };
                                    copy_bytes(buffer, destination, 0);
                                    (*value).position = as<u64>(end);
                                    Result::Ok(count)
                                },
                            }
                        },
                    }
                },
            }
        }
        fn flush(value: &mut Self) -> Result<(),IoError> { Result::Ok(()) }
    }
    fn offset_position(base: u64, offset: i64) -> Result<u64,IoError> {
        handle offset < 0 {
            true => {
                let magnitude = wrapping_sub(0, as<u64>(offset));
                handle magnitude > base { true => Result::Err(error(IoErrorKind::InvalidInput)), false => Result::Ok(base - magnitude) }
            },
            false => handle as<u64>(offset) > bit_not<u64>(0) - base {
                true => Result::Err(error(IoErrorKind::InvalidInput)), false => Result::Ok(base + as<u64>(offset)),
            },
        }
    }
    pub impl Seek for MemoryCursor {
        type Effects = {};
        fn seek(value: &mut Self, from: SeekFrom) -> Result<u64,IoError> {
            let target = handle from {
                SeekFrom::Start(position) => Result::Ok(position),
                SeekFrom::End(offset) => offset_position(as<u64>(Vec::len(&value.bytes)), offset),
                SeekFrom::Current(offset) => offset_position(value.position, offset),
            };
            handle target {
                Result::Err(error) => Result::Err(error),
                Result::Ok(position) => { (*value).position = position; Result::Ok(position) },
            }
        }
    }
}
