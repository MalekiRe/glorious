pub mod graph {
    use crate::*;
    pub trait Graph {
        type Node: Eq + Hash + Use<[0,*]>;
        fn successors<'a>(value: &'a Self, node: <Self as Graph>::Node) -> Slice<'a,<Self as Graph>::Node>;
    }
    pub struct Cycle<N> { pub nodes: Vec<N> }
    pub enum GraphError<N> { Cycle(Cycle<N>), Limit(BudgetExceeded) }

    // Work budget: one charge per dequeued node and examined outgoing edge.
    fn enqueue<N>(edges: Slice<N>, index: usize, seen: &mut HashSet<N>, queue: &mut Vec<N>, budget: &mut StepBudget)
        -> Result<(),BudgetExceeded> where N: Eq, N: Hash, N: Use<[0,*]> {
        handle index == Slice::len(&edges) {
            true => Result::Ok(()),
            false => handle StepBudget::charge(&mut *budget, 1) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => {
                    let node = *Slice::get_unchecked(edges, index);
                    handle HashSet::insert(&mut *seen, node) { true => Vec::push(&mut *queue, node), false => () };
                    tail enqueue(edges, index + 1, seen, queue, budget)
                },
            },
        }
    }
    fn breadth_first<G>(graph: &G, seen: &mut HashSet<<G as Graph>::Node>, queue: &mut Vec<<G as Graph>::Node>,
        head: usize, budget: &mut StepBudget) -> Result<(),BudgetExceeded> where G: Graph {
        handle head == Vec::len(queue) {
            true => Result::Ok(()),
            false => handle StepBudget::charge(&mut *budget, 1) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => {
                    let node = *Vec::get_unchecked(queue, head);
                    handle enqueue(Graph::successors(graph, node), 0, &mut *seen, &mut *queue, &mut *budget) {
                        Result::Err(error) => Result::Err(error),
                        Result::Ok(_) => tail breadth_first(graph, seen, queue, head + 1, budget),
                    }
                },
            },
        }
    }
    pub fn reachable<G>(graph: &G, start: <G as Graph>::Node, budget: &mut StepBudget)
        -> Result<Vec<<G as Graph>::Node>,BudgetExceeded> where G: Graph {
        let mut seen = HashSet::new();
        let mut queue = Vec::new();
        HashSet::insert(&mut seen, start);
        Vec::push(&mut queue, start);
        handle breadth_first(graph, &mut seen, &mut queue, 0, budget) {
            Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(queue),
        }
    }
    struct Frame<N> { node: N, next: usize }
    struct Search<N> { colors: HashMap<N,u8>, stack: Vec<Frame<N>>, finished: Vec<N> }
    fn color<N>(state: &Search<N>, node: &N) -> u8 where N: Eq, N: Hash {
        handle HashMap::get(&state.colors, node) { Result::Ok(color) => *color, Result::Err(_) => 0 }
    }
    fn enter<N>(state: &mut Search<N>, node: N) where N: Eq, N: Hash, N: Use<[0,*]> {
        HashMap::insert(&mut state.colors, node, 1);
        Vec::push(&mut state.stack, Frame { node: node, next: 0 })
    }
    fn cycle_from<N>(stack: &Vec<Frame<N>>, node: N, index: usize, copying: Bool, output: &mut Vec<N>, budget: &mut StepBudget)
        -> Result<(),BudgetExceeded> where N: Eq, N: Use<[0,*]> {
        handle index == Vec::len(stack) {
            true => { Vec::push(output, node); Result::Ok(()) },
            false => handle StepBudget::charge(&mut *budget, 1) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => {
                    let current = Vec::get_unchecked(stack, index).node;
                    let copying = handle copying { true => true, false => PartialEq::eq(&current, &node) };
                    handle copying { true => Vec::push(&mut *output, current), false => () };
                    tail cycle_from(stack, node, index + 1, copying, output, budget)
                },
            },
        }
    }
    // Explicit frames bound native/VM call storage independently of graph depth.
    fn finish_component<G>(graph: &G, state: &mut Search<<G as Graph>::Node>, cycles_are_errors: Bool, budget: &mut StepBudget)
        -> Result<(),GraphError<<G as Graph>::Node>> where G: Graph {
        handle Vec::len(&state.stack) == 0 {
            true => Result::Ok(()),
            false => handle StepBudget::charge(&mut *budget, 1) {
                Result::Err(error) => Result::Err(GraphError::Limit(error)),
                Result::Ok(_) => {
                    let top = Vec::len(&state.stack) - 1;
                    let node = Vec::get_unchecked(&state.stack, top).node;
                    let next = Vec::get_unchecked(&state.stack, top).next;
                    let edges = Graph::successors(graph, node);
                    handle next == Slice::len(&edges) {
                        true => {
                            Vec::pop(&mut state.stack);
                            HashMap::insert(&mut state.colors, node, 2);
                            Vec::push(&mut state.finished, node);
                            tail finish_component(graph, state, cycles_are_errors, budget)
                        },
                        false => {
                            let child = *Slice::get_unchecked(edges, next);
                            handle Vec::get_mut(&mut state.stack, top) { Result::Ok(frame) => { (*frame).next = next + 1; }, Result::Err(_) => __g1_abort() };
                            handle color(state, &child) {
                                0 => { enter(&mut *state, child); tail finish_component(graph, state, cycles_are_errors, budget) },
                                1 => handle cycles_are_errors {
                                    false => tail finish_component(graph, state, cycles_are_errors, budget),
                                    true => {
                                        let mut nodes = Vec::new();
                                        handle cycle_from(&state.stack, child, 0, false, &mut nodes, budget) {
                                            Result::Err(error) => Result::Err(GraphError::Limit(error)),
                                            Result::Ok(_) => Result::Err(GraphError::Cycle(Cycle { nodes: nodes })),
                                        }
                                    },
                                },
                                _ => tail finish_component(graph, state, cycles_are_errors, budget),
                            }
                        },
                    }
                },
            },
        }
    }
    fn finish_roots<G>(graph: &G, nodes: Slice<<G as Graph>::Node>, index: usize, state: &mut Search<<G as Graph>::Node>,
        cycles_are_errors: Bool, budget: &mut StepBudget) -> Result<(),GraphError<<G as Graph>::Node>> where G: Graph {
        handle index == Slice::len(&nodes) {
            true => Result::Ok(()),
            false => handle StepBudget::charge(&mut *budget, 1) {
                Result::Err(error) => Result::Err(GraphError::Limit(error)),
                Result::Ok(_) => {
                    let node = *Slice::get_unchecked(nodes, index);
                    handle color(state, &node) == 0 {
                        false => tail finish_roots(graph, nodes, index + 1, state, cycles_are_errors, budget),
                        true => {
                            enter(&mut *state, node);
                            handle finish_component(graph, &mut *state, cycles_are_errors, &mut *budget) {
                                Result::Err(error) => Result::Err(error),
                                Result::Ok(_) => tail finish_roots(graph, nodes, index + 1, state, cycles_are_errors, budget),
                            }
                        },
                    }
                },
            },
        }
    }
    pub fn topological_order<G>(graph: &G, nodes: Slice<<G as Graph>::Node>, budget: &mut StepBudget)
        -> Result<Vec<<G as Graph>::Node>,GraphError<<G as Graph>::Node>> where G: Graph {
        let mut state = Search { colors: HashMap::new(), stack: Vec::new(), finished: Vec::new() };
        handle finish_roots(graph, nodes, 0, &mut state, true, budget) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => { Vec::reverse(&mut state.finished); Result::Ok(state.finished) },
        }
    }
    struct Reverse<N> { edges: HashMap<N,Vec<N>>, empty: Vec<N> }
    impl<N> Graph for Reverse<N> where N: Eq, N: Hash, N: Use<[0,*]> {
        type Node = N;
        fn successors<'a>(value: &'a Self, node: N) -> Slice<'a,N> {
            handle HashMap::get(&value.edges, &node) {
                Result::Ok(edges) => Vec::as_slice(edges), Result::Err(_) => Vec::as_slice(&value.empty),
            }
        }
    }
    fn reverse_edges<N>(reverse: &mut Reverse<N>, node: N, edges: Slice<N>, index: usize, budget: &mut StepBudget)
        -> Result<(),BudgetExceeded> where N: Eq, N: Hash, N: Use<[0,*]> {
        handle index == Slice::len(&edges) {
            true => Result::Ok(()),
            false => handle StepBudget::charge(&mut *budget, 1) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => {
                    let child = *Slice::get_unchecked(edges, index);
                    handle HashMap::get_mut(&mut reverse.edges, &child) {
                        Result::Ok(parents) => Vec::push(parents, node),
                        Result::Err(_) => { let mut parents = Vec::new(); Vec::push(&mut parents, node); HashMap::insert(&mut reverse.edges, child, parents); },
                    };
                    tail reverse_edges(reverse, node, edges, index + 1, budget)
                },
            },
        }
    }
    fn reverse_nodes<G>(graph: &G, nodes: &Vec<<G as Graph>::Node>, index: usize, reverse: &mut Reverse<<G as Graph>::Node>, budget: &mut StepBudget)
        -> Result<(),BudgetExceeded> where G: Graph {
        handle index == Vec::len(nodes) {
            true => Result::Ok(()),
            false => handle StepBudget::charge(&mut *budget, 1) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => {
                    let node = *Vec::get_unchecked(nodes, index);
                    handle reverse_edges(&mut *reverse, node, Graph::successors(graph, node), 0, &mut *budget) {
                        Result::Err(error) => Result::Err(error),
                        Result::Ok(_) => tail reverse_nodes(graph, nodes, index + 1, reverse, budget),
                    }
                },
            },
        }
    }
    fn components_from<N>(reverse: &Reverse<N>, roots: &Vec<N>, remaining: usize, seen: &mut HashSet<N>, output: &mut Vec<Vec<N>>, budget: &mut StepBudget)
        -> Result<(),BudgetExceeded> where N: Eq, N: Hash, N: Use<[0,*]> {
        handle remaining == 0 {
            true => Result::Ok(()),
            false => handle StepBudget::charge(&mut *budget, 1) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => {
                    let node = *Vec::get_unchecked(roots, remaining - 1);
                    handle HashSet::insert(&mut *seen, node) {
                        false => tail components_from(reverse, roots, remaining - 1, seen, output, budget),
                        true => {
                            let mut component = Vec::new(); Vec::push(&mut component, node);
                            handle breadth_first(reverse, &mut *seen, &mut component, 0, &mut *budget) {
                                Result::Err(error) => Result::Err(error),
                                Result::Ok(_) => {
                                    Vec::push(&mut *output, component);
                                    tail components_from(reverse, roots, remaining - 1, seen, output, budget)
                                },
                            }
                        },
                    }
                },
            },
        }
    }
    pub fn strongly_connected_components<G>(graph: &G, nodes: Slice<<G as Graph>::Node>, budget: &mut StepBudget)
        -> Result<Vec<Vec<<G as Graph>::Node>>,BudgetExceeded> where G: Graph {
        let mut state = Search { colors: HashMap::new(), stack: Vec::new(), finished: Vec::new() };
        handle finish_roots(graph, nodes, 0, &mut state, false, &mut *budget) {
            Result::Err(GraphError::Limit(error)) => Result::Err(error),
            Result::Err(GraphError::Cycle(_)) => __g1_abort(),
            Result::Ok(_) => {
                let mut reverse = Reverse { edges: HashMap::new(), empty: Vec::new() };
                handle reverse_nodes(graph, &state.finished, 0, &mut reverse, &mut *budget) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(_) => {
                        let mut seen = HashSet::new(); let mut output = Vec::new();
                        handle components_from(&reverse, &state.finished, Vec::len(&state.finished), &mut seen, &mut output, budget) {
                            Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(output),
                        }
                    },
                }
            },
        }
    }
}
