pub mod random {
    use crate::*;
    pub enum RandomError { Exhausted, InvalidRange, Unsupported, Host(IoError) }
    pub effect Entropy { fill_random<'a>(out: SliceMut<'a,u8>) -> Result<(),RandomError>; }
    pub trait RandomSource {
        type Effects: EffectRow;
        fn fill(value: &mut Self, out: SliceMut<u8>) -> Result<(),RandomError>
            / { | <Self as RandomSource>::Effects };
    }

    // Algorithm version 1 is the concatenation, for n=0,1,..., of:
    // BLAKE3("GLORIOUS-RNG\0" || seed[32] || little_endian_u128(n)).
    // The block counter wraps modulo 2^128. All requests consume this one byte
    // stream; next_u64 consumes eight bytes in little-endian order, including
    // across a previous partial fill. No host observation or crypto guarantee.
    pub struct SeededRng {
        private seed: [u8;32], private block: Vec<u8>,
        private counter: u128, private offset: usize,
    }
    fn append_counter(out: &mut Vec<u8>, counter: u128, index: u32) {
        handle index == 16 {
            true => (),
            false => {
                Vec::push(&mut *out, as<u8>(bit_shr(counter, index * 8)));
                tail append_counter(out, counter, index + 1)
            },
        }
    }
    fn refill(value: &mut SeededRng) {
        let mut input = Vec::with_capacity(61);
        Vec::extend_from_slice(&mut input, b"GLORIOUS-RNG\x00");
        Vec::extend_from_slice(&mut input, array_as_slice(&value.seed));
        append_counter(&mut input, value.counter, 0);
        (*value).block = crate::blake3(Vec::as_slice(&input));
        (*value).counter = wrapping_add(value.counter, 1);
        (*value).offset = 0;
    }
    fn next_byte(value: &mut SeededRng) -> u8 {
        handle value.offset == Vec::len(&value.block) {
            true => refill(&mut *value), false => (),
        };
        let byte = *Vec::get_unchecked(&value.block, value.offset);
        (*value).offset = value.offset + 1;
        byte
    }
    fn next_word(value: &mut SeededRng, index: u32, result: u64) -> u64 {
        handle index == 8 {
            true => result,
            false => {
                let byte = next_byte(&mut *value);
                tail next_word(value, index + 1, bit_or(result, bit_shl(as<u64>(byte), index * 8)))
            },
        }
    }
    fn fill_seeded(value: &mut SeededRng, out: SliceMut<u8>) {
        handle SliceMut::len(&out) == 0 {
            true => (),
            false => handle SliceMut::split_at(out, 1) {
                Result::Err(_) => crate::__g1_abort(),
                Result::Ok((first, rest)) => {
                    let place = SliceMut::get_unchecked(first, 0);
                    *place = next_byte(&mut *value);
                    tail fill_seeded(value, rest)
                },
            },
        }
    }
    impl SeededRng {
        pub fn from_seed(seed: [u8;32]) -> Self {
            SeededRng { seed: seed, block: Vec::new(), counter: 0, offset: 0 }
        }
        pub fn algorithm_version() -> u32 { 1 }
        pub fn next_u64(value: &mut Self) -> u64 { next_word(value, 0, 0) }
    }
    pub impl RandomSource for SeededRng {
        type Effects = {};
        fn fill(value: &mut Self, out: SliceMut<u8>) -> Result<(),RandomError> {
            fill_seeded(value, out);
            Result::Ok(())
        }
    }
    fn decode_word(bytes: Slice<u8>, index: u32, result: u64) -> u64 {
        handle index == 8 {
            true => result,
            false => tail decode_word(bytes, index + 1, bit_or(result,
                bit_shl(as<u64>(*Slice::get_unchecked(bytes, as<usize>(index))), index * 8))),
        }
    }
    pub fn random_u64<R>(source: &mut R) -> Result<u64,RandomError>
        / { | <R as RandomSource>::Effects } where R: RandomSource {
        let mut bytes = [as<u8>(0),as<u8>(0),as<u8>(0),as<u8>(0),as<u8>(0),as<u8>(0),as<u8>(0),as<u8>(0)];
        handle RandomSource::fill(source, array_as_mut_slice(&mut bytes)) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => Result::Ok(decode_word(array_as_slice(&bytes), 0, 0)),
        }
    }
    fn below_from<R>(source: &mut R, exclusive: u64, threshold: u64) -> Result<u64,RandomError>
        / { | <R as RandomSource>::Effects } where R: RandomSource {
        handle random_u64(&mut *source) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(value) => handle value < threshold {
                true => tail below_from(source, exclusive, threshold),
                false => Result::Ok(value % exclusive),
            },
        }
    }
    pub fn random_below<R>(source: &mut R, exclusive: u64) -> Result<u64,RandomError>
        / { | <R as RandomSource>::Effects } where R: RandomSource {
        handle exclusive == 0 {
            true => Result::Err(RandomError::InvalidRange),
            // 2^64 modulo exclusive, computed without representing 2^64.
            // Removing this prefix leaves equally many values in each class.
            false => below_from(source, exclusive, wrapping_sub(0, exclusive) % exclusive),
        }
    }
}
