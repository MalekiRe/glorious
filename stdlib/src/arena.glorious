pub struct Arena<Tag,T> { private owner: IdentityToken, private generation: u64, private values: IndexVec<Tag,T> }
pub struct ArenaMark<Tag> { private owner: IdentityToken, private generation: u64, private position: usize }
pub impl<Tag> Clone for ArenaMark<Tag> {
    fn clone(value: &Self) -> Self { ArenaMark { owner: Clone::clone(&value.owner), generation: value.generation, position: value.position } }
}
impl<Tag,T> Arena<Tag,T> {
    pub fn new() -> Self { Arena { owner: identity_new(), generation: 0, values: IndexVec::new() } }
    pub fn insert(value: &mut Self, item: T) -> Result<Id<Tag>,Rejected<T,IndexOverflow>> { IndexVec::push(&mut value.values, item) }
    pub fn get<'a>(value: &'a Self, id: Id<Tag>) -> Option<&'a T> { IndexVec::get(&value.values, id) }
    pub fn get_mut<'a>(value: &'a mut Self, id: Id<Tag>) -> Option<&'a mut T> { IndexVec::get_mut(&mut value.values, id) }
    pub fn mark(value: &Self) -> ArenaMark<Tag> {
        ArenaMark { owner: Clone::clone(&value.owner), generation: value.generation, position: IndexVec::len(&value.values) }
    }
    pub fn rollback_take(value: &mut Self, mark: ArenaMark<Tag>) -> Result<Vec<T>,MarkError> {
        handle identity_same(&value.owner, &mark.owner) {
            false => Result::Err(MarkError::WrongOwner),
            true => handle value.generation == mark.generation {
                false => Result::Err(MarkError::Stale),
                true => handle mark.position > IndexVec::len(&value.values) {
                    true => Result::Err(MarkError::OutOfRange),
                    false => {
                        let removed = handle Vec::split_off(&mut value.values.values, mark.position) {
                            Result::Ok(removed) => removed, Result::Err(_) => __g1_abort(),
                        };
                        // Every successful rollback ends this mark generation.
                        handle value.generation == bit_not<u64>(0) {
                            true => { (*value).owner = identity_new(); (*value).generation = 0; },
                            false => { (*value).generation = value.generation + 1; },
                        };
                        Result::Ok(removed)
                    },
                },
            },
        }
    }
    pub fn truncate(value: &mut Self, mark: ArenaMark<Tag>) -> Result<(),MarkError> where T: Use<[0,1]> {
        handle Self::rollback_take(value, mark) { Result::Ok(_) => Result::Ok(()), Result::Err(error) => Result::Err(error) }
    }
    pub fn into_vec(value: Self) -> Vec<T> {
        let Arena { owner: owner, generation: generation, values: values } = value;
        IndexVec::into_vec(values)
    }
}

pub struct GenId<Tag> { private owner: IdentityToken, private index: u32, private generation: u64 }
pub impl<Tag> Clone for GenId<Tag> {
    fn clone(value: &Self) -> Self { GenId { owner: Clone::clone(&value.owner), index: value.index, generation: value.generation } }
}
pub impl<Tag> PartialEq for GenId<Tag> {
    fn eq(left: &Self, right: &Self) -> Bool {
        handle identity_same(&left.owner, &right.owner) {
            false => false,
            true => handle left.index == right.index { false => false, true => left.generation == right.generation },
        }
    }
}
pub impl<Tag> Eq for GenId<Tag> {}
pub impl<Tag> Ord for GenId<Tag> {
    fn cmp(left: &Self, right: &Self) -> Ordering {
        let left_owner = ptr_address(ptr_as_const(left.owner.pointer));
        let right_owner = ptr_address(ptr_as_const(right.owner.pointer));
        handle Ord::cmp(&left_owner, &right_owner) {
            Ordering::Equal => handle Ord::cmp(&left.index, &right.index) {
                Ordering::Equal => Ord::cmp(&left.generation, &right.generation), order => order,
            },
            order => order,
        }
    }
}
pub impl<Tag> PartialOrd for GenId<Tag> {
    fn partial_cmp(left: &Self, right: &Self) -> Option<Ordering> { Some(Ord::cmp(left, right)) }
}
pub impl<Tag> Hash for GenId<Tag> {
    fn hash(value: &Self, state: &mut Hasher) {
        Hash::hash(&ptr_address(ptr_as_const(value.owner.pointer)), &mut *state);
        Hash::hash(&value.index, &mut *state);
        Hash::hash(&value.generation, state)
    }
}
struct GenSlot<T> { generation: u64, resident: Option<T> }
pub struct GenArena<Tag,T> { private owner: IdentityToken, private slots: Vec<GenSlot<T>>, private free: Vec<u32> }
fn gen_arena_slot<Tag,T>(value: &GenArena<Tag,T>, id: &GenId<Tag>) -> Option<usize> {
    handle identity_same(&value.owner, &id.owner) {
        false => None,
        true => handle Vec::get(&value.slots, as<usize>(id.index)) {
            Result::Err(_) => None,
            Result::Ok(slot) => handle slot.generation == id.generation {
                false => None,
                true => handle slot.resident { Result::Ok(_) => Some(as<usize>(id.index)), Result::Err(_) => None },
            },
        },
    }
}
impl<Tag,T> GenArena<Tag,T> {
    pub fn new() -> Self { GenArena { owner: identity_new(), slots: Vec::new(), free: Vec::new() } }
    pub fn insert(value: &mut Self, item: T) -> Result<GenId<Tag>,Rejected<T,IndexOverflow>> {
        handle Vec::pop(&mut value.free) {
            Result::Ok(index) => {
                let generation = handle Vec::get_mut(&mut value.slots, as<usize>(index)) {
                    Result::Err(_) => __g1_abort(),
                    Result::Ok(slot) => {
                        handle Option::insert(&mut slot.resident, item) { Result::Err(_) => (), Result::Ok(_) => __g1_abort() };
                        slot.generation
                    },
                };
                Result::Ok(GenId { owner: Clone::clone(&value.owner), index: index, generation: generation })
            },
            Result::Err(_) => handle Vec::len(&value.slots) > 4294967295 {
                true => Result::Err(Rejected { value: item, error: IndexOverflow {} }),
                false => {
                    let index = as<u32>(Vec::len(&value.slots));
                    Vec::push(&mut value.slots, GenSlot { generation: 0, resident: Some(item) });
                    Result::Ok(GenId { owner: Clone::clone(&value.owner), index: index, generation: 0 })
                },
            },
        }
    }
    pub fn contains(value: &Self, id: GenId<Tag>) -> Bool {
        handle gen_arena_slot(value, &id) { Result::Ok(_) => true, Result::Err(_) => false }
    }
    pub fn get<'a>(value: &'a Self, id: GenId<Tag>) -> Option<&'a T> {
        handle gen_arena_slot(value, &id) {
            Result::Err(_) => None,
            Result::Ok(index) => {
                let mut slot = Vec::get_unchecked(&value.slots, index);
                handle slot.resident { Result::Ok(_) => Some(&slot.resident.0), Result::Err(_) => None }
            },
        }
    }
    pub fn get_mut<'a>(value: &'a mut Self, id: GenId<Tag>) -> Option<&'a mut T> {
        handle gen_arena_slot(value, &id) {
            Result::Err(_) => None,
            Result::Ok(index) => handle Vec::get_mut(&mut value.slots, index) {
                Result::Err(_) => None,
                Result::Ok(slot) => handle slot.resident { Result::Ok(_) => Some(&mut slot.resident.0), Result::Err(_) => None },
            },
        }
    }
    pub fn remove(value: &mut Self, id: GenId<Tag>) -> Option<T> {
        handle gen_arena_slot(value, &id) {
            Result::Err(_) => None,
            Result::Ok(index) => {
                let removed = handle Vec::get_mut(&mut value.slots, index) {
                    Result::Err(_) => __g1_abort(),
                    Result::Ok(slot) => {
                        let removed = Option::take(&mut slot.resident);
                        handle slot.generation == bit_not<u64>(0) {
                            true => (),
                            false => { (*slot).generation = slot.generation + 1; Vec::push(&mut value.free, as<u32>(index)); },
                        };
                        removed
                    },
                };
                removed
            },
        }
    }
    pub fn into_vec(value: Self) -> Vec<T> {
        let GenArena { owner: owner, slots: slots, free: free } = value;
        let mut slots = slots;
        let mut output = Vec::new();
        gen_arena_collect(&mut slots, &mut output);
        handle Vec::finish_empty(slots) { Result::Ok(_) => (), Result::Err(_) => __g1_abort() };
        output
    }
}
fn gen_arena_collect<T>(slots: &mut Vec<GenSlot<T>>, output: &mut Vec<T>) {
    handle Vec::remove(&mut *slots, 0) {
        Result::Err(_) => (),
        Result::Ok(GenSlot { generation: generation, resident: resident }) => {
            handle resident { Result::Err(_) => (), Result::Ok(item) => Vec::push(&mut *output, item) };
            tail gen_arena_collect(slots, output)
        },
    }
}
