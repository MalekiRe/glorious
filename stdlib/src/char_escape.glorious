pub struct CharEscape { private scalar: u32, private mode: u8, private index: u32, private digits: u32 }
fn char_escape_digits(value: u32, count: u32) -> u32 {
    handle value < 16 { true => count, false => tail char_escape_digits(value / 16, count + 1) }
}
impl char {
    pub fn encode_utf8(value: char, out: &mut [u8;4]) -> usize {
        let scalar = char_to_u32(value);
        let width = char_utf8_len(value);
        let output = array_as_mut_slice(out);
        let pointer = unsafe { __g1_memory_cast<(),u8>(__g1_memory_as_raw_unique(output.storage)) };
        // Each clause acknowledges its writes: callable clause bodies do not
        // inherit unsafe permission. All offsets stay in the used prefix.
        handle width {
            1 => unsafe { __g1_memory_write(pointer, as<u8>(scalar)) },
            2 => unsafe {
                __g1_memory_write(pointer, as<u8>(192 + scalar / 64));
                __g1_memory_write(__g1_memory_offset(pointer, 1), as<u8>(128 + scalar % 64));
            },
            3 => unsafe {
                __g1_memory_write(pointer, as<u8>(224 + scalar / 4096));
                __g1_memory_write(__g1_memory_offset(pointer, 1), as<u8>(128 + (scalar / 64) % 64));
                __g1_memory_write(__g1_memory_offset(pointer, 2), as<u8>(128 + scalar % 64));
            },
            _ => unsafe {
                __g1_memory_write(pointer, as<u8>(240 + scalar / 262144));
                __g1_memory_write(__g1_memory_offset(pointer, 1), as<u8>(128 + (scalar / 4096) % 64));
                __g1_memory_write(__g1_memory_offset(pointer, 2), as<u8>(128 + (scalar / 64) % 64));
                __g1_memory_write(__g1_memory_offset(pointer, 3), as<u8>(128 + scalar % 64));
            },
        };
        width
    }
    pub fn escape_unicode(value: char) -> CharEscape {
        let scalar = char_to_u32(value);
        CharEscape { scalar: scalar, mode: 2, index: 0, digits: char_escape_digits(scalar, 1) }
    }
    pub fn escape_default(value: char) -> CharEscape {
        let scalar = char_to_u32(value);
        let escaped = handle scalar { 9 => Some(116), 10 => Some(110), 13 => Some(114), 34 => Some(34), 39 => Some(39), 92 => Some(92), _ => None };
        handle escaped {
            Result::Ok(character) => CharEscape { scalar: character, mode: 1, index: 0, digits: 0 },
            Result::Err(_) => handle scalar >= 32 {
                false => Self::escape_unicode(value),
                true => handle scalar <= 126 {
                    true => CharEscape { scalar: scalar, mode: 0, index: 0, digits: 0 },
                    false => Self::escape_unicode(value),
                },
            },
        }
    }
}
impl CharEscape {
    pub fn next(value: &mut Self) -> Option<char> {
        let length = handle value.mode { 0 => 1, 1 => 2, _ => value.digits + 4 };
        handle value.index >= length {
            true => None,
            false => {
                let index = value.index;
                (*value).index = index + 1;
                let code = handle value.mode {
                    0 => value.scalar,
                    1 => handle index == 0 { true => 92, false => value.scalar },
                    _ => handle index {
                        0 => 92, 1 => 117, 2 => 123,
                        _ => handle index == length - 1 {
                            true => 125,
                            false => {
                                let digit = bit_and(bit_shr(value.scalar, (value.digits - (index - 3) - 1) * 4), 15);
                                handle digit < 10 { true => 48 + digit, false => 97 + digit - 10 }
                            },
                        },
                    },
                };
                Some(__g1_char_from_u32_checked(code))
            },
        }
    }
}
