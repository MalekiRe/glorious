    pub fn swap_bytes(value: Self) -> Self { as<Self>(num_isize_swap_bytes(as<usize>(value), 0, 8)) }
    pub fn is_power_of_two(value: Self) -> Bool {
        handle value > 0 { false => false, true => bit_and(value, value - 1) == 0 }
    }
    pub fn abs_diff(left: Self, right: Self) -> usize {
        handle left >= right {
            true => wrapping_sub(as<usize>(left), as<usize>(right)),
            false => wrapping_sub(as<usize>(right), as<usize>(left)),
        }
    }
    pub fn checked_ilog(value: Self, base: Self) -> Option<u32> {
        handle value <= 0 {
            true => None,
            false => handle base < 2 { true => None, false => Some(num_isize_ilog(value, base, 0)) },
        }
    }
    pub fn checked_ilog2(value: Self) -> Option<u32> { Self::checked_ilog(value, 2) }
    pub fn checked_ilog10(value: Self) -> Option<u32> { Self::checked_ilog(value, 10) }
    pub fn checked_div_euclid(left: Self, right: Self) -> Option<Self> {
        handle Self::checked_div(left, right) {
            Result::Err(_) => None,
            Result::Ok(quotient) => handle left % right < 0 {
                false => Some(quotient),
                true => handle right > 0 { true => Some(quotient - 1), false => Some(quotient + 1) },
            },
        }
    }
    pub fn checked_rem_euclid(left: Self, right: Self) -> Option<Self> {
        handle Self::checked_rem(left, right) {
            Result::Err(_) => None,
            Result::Ok(remainder) => handle remainder < 0 {
                false => Some(remainder),
                true => handle right > 0 { true => Some(remainder + right), false => Some(remainder - right) },
            },
        }
    }

    pub fn unsigned_abs(value: Self) -> usize { num_isize_magnitude(value) }
    pub fn checked_abs(value: Self) -> Option<Self> {
        handle value < 0 { true => Self::checked_neg(value), false => Some(value) }
    }
    pub fn wrapping_abs(value: Self) -> Self {
        handle value < 0 { true => wrapping_sub(0, value), false => value }
    }
    pub fn saturating_abs(value: Self) -> Self {
        handle Self::checked_abs(value) { Result::Ok(result) => result, Result::Err(_) => 9223372036854775807 }
    }
    pub fn signum(value: Self) -> Self { handle value < 0 { true => -1, false => handle value == 0 { true => 0, false => 1 } } }
    pub fn is_negative(value: Self) -> Bool { value < 0 }
    pub fn is_positive(value: Self) -> Bool { value > 0 }
}
fn num_isize_checked_pow(value: isize, exponent: u32, result: isize) -> Option<isize> {
    handle exponent == 0 {
        true => Some(result),
        false => {
            let result = handle exponent % 2 == 1 {
                true => isize::checked_mul(result, value), false => Some(result),
            };
            handle result {
                Result::Err(_) => None,
                Result::Ok(result) => handle exponent == 1 {
                    true => Some(result),
                    false => handle isize::checked_mul(value, value) {
                        Result::Err(_) => None,
                        Result::Ok(square) => tail num_isize_checked_pow(square, exponent / 2, result),
                    },
                },
            }
        },
    }
}
fn num_isize_wrapping_pow(value: isize, exponent: u32, result: isize) -> isize {
    handle exponent == 0 {
        true => result,
        false => {
            let result = handle exponent % 2 == 1 { true => wrapping_mul(result, value), false => result };
            tail num_isize_wrapping_pow(wrapping_mul(value, value), exponent / 2, result)
        },
    }
}
fn num_isize_next_power(value: isize, power: isize) -> Option<isize> {
    handle power >= value {
        true => Some(power),
        false => handle isize::checked_mul(power, 2) {
            Result::Err(_) => None, Result::Ok(next) => tail num_isize_next_power(value, next),
        },
    }
}
fn num_isize_ones(value: usize, count: u32) -> u32 {
    handle value == 0 { true => count, false => tail num_isize_ones(bit_and(value, value - 1), count + 1) }
}
fn num_isize_leading(value: usize, count: u32) -> u32 {
    handle value == 0 { true => count, false => tail num_isize_leading(bit_shr(value, 1), count - 1) }
}
fn num_isize_trailing(value: usize, count: u32) -> u32 {
    handle count == 64 {
        true => count,
        false => handle bit_and(value, 1) == 1 {
            true => count, false => tail num_isize_trailing(bit_shr(value, 1), count + 1),
        },
    }
}
fn num_isize_reverse(value: usize, result: usize, count: u32) -> usize {
    handle count == 0 {
        true => result,
        false => tail num_isize_reverse(bit_shr(value, 1), bit_or(bit_shl(result, 1), bit_and(value, 1)), count - 1),
    }
}
fn num_isize_swap_bytes(value: usize, result: usize, count: u32) -> usize {
    handle count == 0 {
        true => result,
        false => tail num_isize_swap_bytes(bit_shr(value, 8), bit_or(bit_shl(result, 8), bit_and(value, 255)), count - 1),
    }
}
fn num_isize_ilog(value: isize, base: isize, count: u32) -> u32 {
    handle value < base { true => count, false => tail num_isize_ilog(value / base, base, count + 1) }
}
