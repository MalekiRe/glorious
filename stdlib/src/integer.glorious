fn num_u16_checked_pow(value: u16, exponent: u32, result: u16) -> Option<u16> {
    handle exponent == 0 {
        true => Some(result),
        false => {
            let result = handle exponent % 2 == 1 {
                true => u16::checked_mul(result, value), false => Some(result),
            };
            handle result {
                Result::Err(_) => None,
                Result::Ok(result) => handle exponent == 1 {
                    true => Some(result),
                    false => handle u16::checked_mul(value, value) {
                        Result::Err(_) => None,
                        Result::Ok(square) => tail num_u16_checked_pow(square, exponent / 2, result),
                    },
                },
            }
        },
    }
}
fn num_u16_wrapping_pow(value: u16, exponent: u32, result: u16) -> u16 {
    handle exponent == 0 {
        true => result,
        false => {
            let result = handle exponent % 2 == 1 { true => wrapping_mul(result, value), false => result };
            tail num_u16_wrapping_pow(wrapping_mul(value, value), exponent / 2, result)
        },
    }
}
fn num_u16_next_power(value: u16, power: u16) -> Option<u16> {
    handle power >= value {
        true => Some(power),
        false => handle u16::checked_mul(power, 2) {
            Result::Err(_) => None, Result::Ok(next) => tail num_u16_next_power(value, next),
        },
    }
}
fn num_u16_ones(value: u16, count: u32) -> u32 {
    handle value == 0 { true => count, false => tail num_u16_ones(bit_and(value, value - 1), count + 1) }
}
fn num_u16_leading(value: u16, count: u32) -> u32 {
    handle value == 0 { true => count, false => tail num_u16_leading(bit_shr(value, 1), count - 1) }
}
fn num_u16_trailing(value: u16, count: u32) -> u32 {
    handle count == 16 {
        true => count,
        false => handle bit_and(value, 1) == 1 {
            true => count, false => tail num_u16_trailing(bit_shr(value, 1), count + 1),
        },
    }
}
fn num_u16_reverse(value: u16, result: u16, count: u32) -> u16 {
    handle count == 0 {
        true => result,
        false => tail num_u16_reverse(bit_shr(value, 1), bit_or(bit_shl(result, 1), bit_and(value, 1)), count - 1),
    }
}
fn num_u16_swap_bytes(value: u16, result: u16, count: u32) -> u16 {
    handle count == 0 {
        true => result,
        false => tail num_u16_swap_bytes(bit_shr(value, 8), bit_or(bit_shl(result, 8), bit_and(value, 255)), count - 1),
    }
}
fn num_u16_ilog(value: u16, base: u16, count: u32) -> u32 {
    handle value < base { true => count, false => tail num_u16_ilog(value / base, base, count + 1) }
}

