// Concrete integer families (specification §11.2). Generated mechanical
// repetition is checked in as Glorious source; execution uses no code generator.
// Every arithmetic failure is checked in source before a trapping operation.
pub enum ConversionError { OutOfRange, NonFinite, Fractional, PrecisionLoss }
pub enum RadixError { TooSmall, TooLarge }
pub enum IntParseErrorKind { Empty, InvalidDigit, InvalidSeparator, InvalidSign, Overflow, InvalidRadix }
pub struct IntParseError { pub offset: usize, pub kind: IntParseErrorKind }

fn num_u8_magnitude(value: u8) -> u8 { value }
impl u8 {
    pub fn min_value() -> Self { 0 }
    pub fn max_value() -> Self { 255 }
    pub fn bits() -> u32 { 8 }
    pub fn checked_add(left: Self, right: Self) -> Option<Self> {
        let wrapped = wrapping_add(left, right);
        handle wrapped < left { true => None, false => Some(wrapped) }
    }
    pub fn checked_sub(left: Self, right: Self) -> Option<Self> {
        let wrapped = wrapping_sub(left, right);
        handle left < right { true => None, false => Some(wrapped) }
    }
    pub fn checked_mul(left: Self, right: Self) -> Option<Self> {
        let a = num_u8_magnitude(left);
        let b = num_u8_magnitude(right);
        let limit: u8 = 255;
        handle b == 0 {
            true => Some(0),
            false => handle a > limit / b { true => None, false => Some(wrapping_mul(left, right)) },
        }
    }
    pub fn checked_div(left: Self, right: Self) -> Option<Self> {
        handle right == 0 {
            true => None,
            false => handle false { true => None, false => Some(left / right) },
        }
    }
    pub fn checked_rem(left: Self, right: Self) -> Option<Self> {
        handle right == 0 {
            true => None,
            false => handle false { true => None, false => Some(left % right) },
        }
    }
    pub fn checked_neg(value: Self) -> Option<Self> { handle value == 0 { true => Some(0), false => None } }
    pub fn checked_shl(value: Self, count: u32) -> Option<Self> {
        handle count < 8 { true => Some(bit_shl(value, count)), false => None }
    }
    pub fn checked_shr(value: Self, count: u32) -> Option<Self> {
        handle count < 8 { true => Some(bit_shr(value, count)), false => None }
    }
    pub fn wrapping_add(left: Self, right: Self) -> Self { wrapping_add(left, right) }
    pub fn wrapping_sub(left: Self, right: Self) -> Self { wrapping_sub(left, right) }
    pub fn wrapping_mul(left: Self, right: Self) -> Self { wrapping_mul(left, right) }
    pub fn wrapping_neg(value: Self) -> Self { wrapping_sub(0, value) }
    pub fn wrapping_shl(value: Self, count: u32) -> Self { bit_shl(value, count % 8) }
    pub fn wrapping_shr(value: Self, count: u32) -> Self { bit_shr(value, count % 8) }
    pub fn saturating_add(left: Self, right: Self) -> Self {
        handle Self::checked_add(left, right) { Result::Ok(value) => value, Result::Err(_) => 255 }
    }
    pub fn saturating_sub(left: Self, right: Self) -> Self {
        handle Self::checked_sub(left, right) { Result::Ok(value) => value, Result::Err(_) => 0 }
    }
    pub fn saturating_mul(left: Self, right: Self) -> Self {
        handle Self::checked_mul(left, right) { Result::Ok(value) => value, Result::Err(_) => 255 }
    }
    pub fn overflowing_add(left: Self, right: Self) -> (Self,Bool) {
        (wrapping_add(left, right), handle Self::checked_add(left, right) { Result::Ok(_) => false, Result::Err(_) => true })
    }
    pub fn overflowing_sub(left: Self, right: Self) -> (Self,Bool) {
        (wrapping_sub(left, right), handle Self::checked_sub(left, right) { Result::Ok(_) => false, Result::Err(_) => true })
    }
    pub fn overflowing_mul(left: Self, right: Self) -> (Self,Bool) {
        (wrapping_mul(left, right), handle Self::checked_mul(left, right) { Result::Ok(_) => false, Result::Err(_) => true })
    }
    pub fn overflowing_neg(value: Self) -> (Self,Bool) {
        (wrapping_sub(0, value), handle Self::checked_neg(value) { Result::Ok(_) => false, Result::Err(_) => true })
    }
    pub fn checked_pow(value: Self, exponent: u32) -> Option<Self> { num_u8_checked_pow(value, exponent, 1) }
    pub fn wrapping_pow(value: Self, exponent: u32) -> Self { num_u8_wrapping_pow(value, exponent, 1) }
    pub fn saturating_pow(value: Self, exponent: u32) -> Self {
        handle Self::checked_pow(value, exponent) {
            Result::Ok(result) => result,
            Result::Err(_) => 255,
        }
    }
    pub fn checked_next_power_of_two(value: Self) -> Option<Self> {
        num_u8_next_power(value, 1)
    }
    pub fn count_ones(value: Self) -> u32 { num_u8_ones(as<u8>(value), 0) }
    pub fn count_zeros(value: Self) -> u32 { 8 - Self::count_ones(value) }
    pub fn leading_zeros(value: Self) -> u32 { num_u8_leading(as<u8>(value), 8) }
    pub fn trailing_zeros(value: Self) -> u32 { num_u8_trailing(as<u8>(value), 0) }
    pub fn leading_ones(value: Self) -> u32 { Self::leading_zeros(bit_not(value)) }
    pub fn trailing_ones(value: Self) -> u32 { Self::trailing_zeros(bit_not(value)) }
    pub fn rotate_left(value: Self, count: u32) -> Self {
        let count = count % 8;
        handle count == 0 {
            true => value,
            false => as<Self>(bit_or(bit_shl(as<u8>(value), count), bit_shr(as<u8>(value), 8 - count))),
        }
    }
    pub fn rotate_right(value: Self, count: u32) -> Self { Self::rotate_left(value, 8 - count % 8) }
    pub fn reverse_bits(value: Self) -> Self { as<Self>(num_u8_reverse(as<u8>(value), 0, 8)) }
    pub fn swap_bytes(value: Self) -> Self { as<Self>(num_u8_swap_bytes(as<u8>(value), 0, 1)) }
    pub fn is_power_of_two(value: Self) -> Bool {
        handle value > 0 { false => false, true => bit_and(value, value - 1) == 0 }
    }
    pub fn abs_diff(left: Self, right: Self) -> u8 {
        handle left >= right {
            true => wrapping_sub(as<u8>(left), as<u8>(right)),
            false => wrapping_sub(as<u8>(right), as<u8>(left)),
        }
    }
    pub fn checked_ilog(value: Self, base: Self) -> Option<u32> {
        handle value <= 0 {
            true => None,
            false => handle base < 2 { true => None, false => Some(num_u8_ilog(value, base, 0)) },
        }
    }
    pub fn checked_ilog2(value: Self) -> Option<u32> { Self::checked_ilog(value, 2) }
    pub fn checked_ilog10(value: Self) -> Option<u32> { Self::checked_ilog(value, 10) }
    pub fn checked_div_euclid(left: Self, right: Self) -> Option<Self> {
        handle Self::checked_div(left, right) {
            Result::Err(_) => None,
            Result::Ok(quotient) => Some(quotient),
        }
    }
    pub fn checked_rem_euclid(left: Self, right: Self) -> Option<Self> {
        handle Self::checked_rem(left, right) {
            Result::Err(_) => None,
            Result::Ok(remainder) => Some(remainder),
        }
    }
}
fn num_u8_checked_pow(value: u8, exponent: u32, result: u8) -> Option<u8> {
    handle exponent == 0 {
        true => Some(result),
        false => {
            let result = handle exponent % 2 == 1 {
                true => u8::checked_mul(result, value), false => Some(result),
            };
            handle result {
                Result::Err(_) => None,
                Result::Ok(result) => handle exponent == 1 {
                    true => Some(result),
                    false => handle u8::checked_mul(value, value) {
                        Result::Err(_) => None,
                        Result::Ok(square) => tail num_u8_checked_pow(square, exponent / 2, result),
                    },
                },
            }
        },
    }
}
fn num_u8_wrapping_pow(value: u8, exponent: u32, result: u8) -> u8 {
    handle exponent == 0 {
        true => result,
        false => {
            let result = handle exponent % 2 == 1 { true => wrapping_mul(result, value), false => result };
            tail num_u8_wrapping_pow(wrapping_mul(value, value), exponent / 2, result)
        },
    }
}
fn num_u8_next_power(value: u8, power: u8) -> Option<u8> {
    handle power >= value {
        true => Some(power),
        false => handle u8::checked_mul(power, 2) {
            Result::Err(_) => None, Result::Ok(next) => tail num_u8_next_power(value, next),
        },
    }
}
fn num_u8_ones(value: u8, count: u32) -> u32 {
    handle value == 0 { true => count, false => tail num_u8_ones(bit_and(value, value - 1), count + 1) }
}
fn num_u8_leading(value: u8, count: u32) -> u32 {
    handle value == 0 { true => count, false => tail num_u8_leading(bit_shr(value, 1), count - 1) }
}
fn num_u8_trailing(value: u8, count: u32) -> u32 {
    handle count == 8 {
        true => count,
        false => handle bit_and(value, 1) == 1 {
            true => count, false => tail num_u8_trailing(bit_shr(value, 1), count + 1),
        },
    }
}
fn num_u8_reverse(value: u8, result: u8, count: u32) -> u8 {
    handle count == 0 {
        true => result,
        false => tail num_u8_reverse(bit_shr(value, 1), bit_or(bit_shl(result, 1), bit_and(value, 1)), count - 1),
    }
}
fn num_u8_swap_bytes(value: u8, result: u8, count: u32) -> u8 {
    handle count == 0 {
        true => result,
        false => value,
    }
}
fn num_u8_ilog(value: u8, base: u8, count: u32) -> u32 {
    handle value < base { true => count, false => tail num_u8_ilog(value / base, base, count + 1) }
}

