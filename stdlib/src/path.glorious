// Native-byte/POSIX lexical profile. No filesystem observation, symlink
// resolution, lossy decoding, or containment claim is made by these functions.
// A wide-unit target requires a distinct admitted implementation profile.
pub mod path {
    use crate::*;
    pub struct OsString { private units: Vec<u8> }
    pub struct OsStr<'a> { private units: Slice<'a,u8> }
    pub struct PathBuf { private text: OsString }
    pub struct Path<'a> { private text: OsStr<'a> }
    pub enum PathComponent<'a> { Prefix(OsStr<'a>), Root, Current, Parent, Normal(OsStr<'a>) }
    pub struct Components<'a> { private units: Slice<'a,u8>, private position: usize, private root: Bool }
    pub enum PathError { InvalidEncoding, InvalidComponent, UnsupportedPrefix }
    fn view<'a>(units: Slice<'a,u8>, start: usize, end: usize) -> Slice<'a,u8> {
        handle Slice::slice(units, Range { start: start, end: end }) { Result::Ok(value) => value, Result::Err(_) => crate::__g1_abort() }
    }
    fn trim_end(units: Slice<u8>, end: usize) -> usize {
        handle end == 0 {
            true => 0,
            false => handle *Slice::get_unchecked(units, end - 1) == 47 { true => tail trim_end(units, end - 1), false => end },
        }
    }
    fn segment_start(units: Slice<u8>, end: usize) -> usize {
        handle end == 0 {
            true => 0,
            false => handle *Slice::get_unchecked(units, end - 1) == 47 { true => end, false => tail segment_start(units, end - 1) },
        }
    }
    fn nonzero_units(units: Slice<u8>, index: usize) -> Bool {
        handle index == Slice::len(&units) {
            true => true,
            false => handle *Slice::get_unchecked(units, index) == 0 { true => false, false => tail nonzero_units(units, index + 1) },
        }
    }
    impl OsString {
        pub fn new() -> Self { OsString { units: Vec::new() } }
        pub fn from_string(value: String) -> Self { OsString { units: value.storage } }
        pub fn as_os_str<'a>(value: &'a Self) -> OsStr<'a> { OsStr { units: Vec::as_slice(&value.units) } }
        pub fn into_string(value: Self) -> Result<String,Self> {
            handle String::from_utf8(value.units) {
                Result::Ok(text) => Result::Ok(text),
                Result::Err(error) => Result::Err(OsString { units: error.bytes }),
            }
        }
    }
    impl<'a> OsStr<'a> {
        pub fn from_str(value: Str<'a>) -> Self { OsStr { units: Str::as_bytes(value) } }
        pub fn to_str(value: Self) -> Option<Str<'a>> {
            handle crate::utf8_valid_up_to(value.units, 0) == Slice::len(&value.units) {
                true => Some(Str { bytes: value.units }), false => None,
            }
        }
        pub fn to_owned(value: Self) -> OsString {
            let mut units = Vec::with_capacity(Slice::len(&value.units));
            Vec::extend_from_slice(&mut units, value.units);
            OsString { units: units }
        }
    }
    impl PathBuf {
        pub fn new() -> Self { PathBuf { text: OsString::new() } }
        pub fn from_os_string(value: OsString) -> Self { PathBuf { text: value } }
        pub fn as_path<'a>(value: &'a Self) -> Path<'a> { Path { text: OsString::as_os_str(&value.text) } }
        pub fn into_os_string(value: Self) -> OsString { value.text }
        pub fn push(value: &mut Self, component: Path) -> Result<(),PathError> {
            let units = component.text.units;
            handle nonzero_units(units, 0) {
                false => Result::Err(PathError::InvalidComponent),
                true => {
                    let count = Slice::len(&units);
                    handle count == 0 { true => return(Result::Ok(()), @push), false => () };
                    let absolute = Path::is_absolute(component);
                    let length = handle absolute { true => 0, false => Vec::len(&value.text.units) };
                    let separator = handle length == 0 {
                        true => 0,
                        false => handle *Vec::get_unchecked(&value.text.units, length - 1) == 47 { true => 0, false => 1 },
                    };
                    handle separator > bit_not<usize>(0) - length {
                        true => return(Result::Err(PathError::InvalidComponent), @push), false => (),
                    };
                    handle count > bit_not<usize>(0) - length - separator {
                        true => Result::Err(PathError::InvalidComponent),
                        false => {
                            handle absolute { true => Vec::clear(&mut value.text.units), false => () };
                            Vec::reserve(&mut value.text.units, count + separator);
                            handle separator == 1 { true => Vec::push(&mut value.text.units, 47), false => () };
                            Vec::extend_from_slice(&mut value.text.units, units);
                            Result::Ok(())
                        },
                    }
                },
            }
        }
        pub fn pop(value: &mut Self) -> Bool {
            let length = handle Path::parent(Self::as_path(& *value)) {
                Result::Err(_) => return(false, @pop), Result::Ok(parent) => Slice::len(&parent.text.units),
            };
            Vec::truncate(&mut value.text.units, length);
            true
        }
    }
    impl<'a> Path<'a> {
        pub fn from_os_str(value: OsStr<'a>) -> Self { Path { text: value } }
        pub fn as_os_str(value: Self) -> OsStr<'a> { value.text }
        pub fn is_absolute(value: Self) -> Bool {
            handle Slice::get(value.text.units, 0) { Result::Ok(first) => *first == 47, Result::Err(_) => false }
        }
        pub fn parent(value: Self) -> Option<Self> {
            let units = value.text.units;
            let end = trim_end(units, Slice::len(&units));
            handle end == 0 {
                true => None,
                false => {
                    let start = segment_start(units, end);
                    let parent_end = trim_end(units, start);
                    let parent_end = handle parent_end == 0 {
                        true => handle Self::is_absolute(value) { true => 1, false => 0 }, false => parent_end,
                    };
                    Some(Path { text: OsStr { units: view(units, 0, parent_end) } })
                },
            }
        }
        pub fn file_name(value: Self) -> Option<OsStr<'a>> {
            let units = value.text.units;
            let end = trim_end(units, Slice::len(&units));
            handle end == 0 {
                true => None,
                false => {
                    let start = segment_start(units, end);
                    let name = view(units, start, end);
                    handle Slice::lex_compare(name, b".") { Ordering::Equal => return(None, @file_name), _ => () };
                    handle Slice::lex_compare(name, b"..") { Ordering::Equal => None, _ => Some(OsStr { units: name }) }
                },
            }
        }
        pub fn extension(value: Self) -> Option<OsStr<'a>> {
            handle Self::file_name(value) {
                Result::Err(_) => None,
                Result::Ok(name) => extension_from(name.units, Slice::len(&name.units)),
            }
        }
        pub fn components(value: Self) -> Components<'a> {
            Components { units: value.text.units, position: 0, root: Self::is_absolute(value) }
        }
        pub fn join(value: Self, other: Path) -> Result<PathBuf,PathError> {
            let mut output = Self::to_owned(value);
            handle PathBuf::push(&mut output, other) { Result::Ok(_) => Result::Ok(output), Result::Err(error) => Result::Err(error) }
        }
        pub fn to_owned(value: Self) -> PathBuf { PathBuf { text: OsStr::to_owned(value.text) } }
    }
    fn extension_from<'a>(units: Slice<'a,u8>, index: usize) -> Option<OsStr<'a>> {
        handle index <= 1 {
            true => None,
            false => handle *Slice::get_unchecked(units, index - 1) == 46 {
                true => Some(OsStr { units: view(units, index, Slice::len(&units)) }),
                false => tail extension_from(units, index - 1),
            },
        }
    }
    fn skip_separators(units: Slice<u8>, index: usize) -> usize {
        handle index == Slice::len(&units) {
            true => index,
            false => handle *Slice::get_unchecked(units, index) == 47 { true => tail skip_separators(units, index + 1), false => index },
        }
    }
    fn segment_end(units: Slice<u8>, index: usize) -> usize {
        handle index == Slice::len(&units) {
            true => index,
            false => handle *Slice::get_unchecked(units, index) == 47 { true => index, false => tail segment_end(units, index + 1) },
        }
    }
    impl<'a> Components<'a> {
        pub fn next(value: &mut Self) -> Option<PathComponent<'a>> {
            handle value.root {
                true => { (*value).root = false; Some(PathComponent::Root) },
                false => {
                    let start = skip_separators(value.units, value.position);
                    handle start == Slice::len(&value.units) {
                        true => { (*value).position = start; None },
                        false => {
                            let end = segment_end(value.units, start);
                            (*value).position = end;
                            let units = view(value.units, start, end);
                            handle Slice::lex_compare(units, b".") {
                                Ordering::Equal => Some(PathComponent::Current),
                                _ => handle Slice::lex_compare(units, b"..") {
                                    Ordering::Equal => Some(PathComponent::Parent), _ => Some(PathComponent::Normal(OsStr { units: units })),
                                },
                            }
                        },
                    }
                },
            }
        }
    }
    pub mod unix {
        use crate::*;
        use super::{OsString,OsStr};
        pub fn from_bytes(units: Vec<u8>) -> OsString { OsString { units: units } }
        pub fn into_bytes(value: OsString) -> Vec<u8> { value.units }
        pub fn as_bytes<'a>(value: OsStr<'a>) -> Slice<'a,u8> { value.units }
    }
}
