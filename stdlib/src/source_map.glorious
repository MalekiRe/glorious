pub struct SourceId(u32);
pub struct SourceSpan { pub source: SourceId, pub range: Range<usize> }
pub struct SourceLocation { pub source: SourceId, pub line: usize, pub column_bytes: usize }
pub struct Utf16Location { pub line: usize, pub column_units: usize }
pub enum SourceError { UnknownSource, InvalidRange, InvalidBoundary, IndexOverflow, Allocation(ReserveError) }
struct SourceFile { name: String, text: String, lines: Vec<usize> }
pub struct SourceMap { private files: Vec<SourceFile> }
fn source_lines(bytes: Slice<u8>, index: usize, lines: &mut Vec<usize>) -> Result<(),ReserveError> {
    handle index == Slice::len(&bytes) {
        true => Result::Ok(()),
        false => {
            handle *Slice::get_unchecked(bytes, index) == 10 {
                false => (),
                true => handle Vec::try_push(&mut *lines, index + 1) {
                    Result::Ok(_) => (), Result::Err(error) => return(Result::Err(error.error), @source_lines),
                },
            };
            tail source_lines(bytes, index + 1, lines)
        },
    }
}
fn source_file<'a>(value: &'a SourceMap, source: SourceId) -> Result<&'a SourceFile,SourceError> {
    let SourceId(index) = source;
    handle Vec::get(&value.files, as<usize>(index)) { Result::Ok(file) => Result::Ok(file), Result::Err(_) => Result::Err(SourceError::UnknownSource) }
}
fn source_line(file: &SourceFile, offset: usize) -> usize {
    Slice::upper_bound(Vec::as_slice(&file.lines), &offset) - 1
}
fn source_utf16_count(bytes: Slice<u8>, index: usize, end: usize, count: usize) -> usize {
    handle index == end {
        true => count,
        false => handle utf8::decode_at(bytes, index) {
            Result::Err(_) => __g1_abort(),
            Result::Ok((character, width)) => {
                let units = handle char_to_u32(character) >= 65536 { true => 2, false => 1 };
                tail source_utf16_count(bytes, index + width, end, count + units)
            },
        },
    }
}
fn source_utf16_offset(bytes: Slice<u8>, index: usize, end: usize, final_line: Bool, count: usize, requested: usize)
    -> Result<usize,SourceError> {
    handle index == end {
        true => handle final_line {
            false => Result::Err(SourceError::InvalidRange),
            true => handle count == requested { true => Result::Ok(index), false => Result::Err(SourceError::InvalidRange) },
        },
        false => handle count == requested {
            true => Result::Ok(index),
            false => handle utf8::decode_at(bytes, index) {
                Result::Err(_) => __g1_abort(),
                Result::Ok((character, width)) => {
                    let units = handle char_to_u32(character) >= 65536 { true => 2, false => 1 };
                    handle requested - count < units {
                        true => Result::Err(SourceError::InvalidBoundary),
                        false => tail source_utf16_offset(bytes, index + width, end, final_line, count + units, requested),
                    }
                },
            },
        },
    }
}
impl SourceMap {
    pub fn new() -> Self { SourceMap { files: Vec::new() } }
    pub fn insert(value: &mut Self, name: String, text: String) -> Result<SourceId,Rejected<(String,String),SourceError>> {
        handle Vec::len(&value.files) > 4294967295 {
            true => Result::Err(Rejected { value: (name, text), error: SourceError::IndexOverflow }),
            false => {
                let mut lines = Vec::new();
                handle Vec::try_push(&mut lines, 0) {
                    Result::Ok(_) => (),
                    Result::Err(error) => return(Result::Err(Rejected { value: (name, text), error: SourceError::Allocation(error.error) }), @insert),
                };
                handle source_lines(Str::as_bytes(String::as_str(&text)), 0, &mut lines) {
                    Result::Err(error) => Result::Err(Rejected { value: (name, text), error: SourceError::Allocation(error) }),
                    Result::Ok(_) => {
                        let index = as<u32>(Vec::len(&value.files));
                        handle Vec::try_push(&mut value.files, SourceFile { name: name, text: text, lines: lines }) {
                            Result::Ok(_) => Result::Ok(SourceId(index)),
                            Result::Err(error) => {
                                let SourceFile { name: name, text: text, lines: lines } = error.value;
                                Result::Err(Rejected { value: (name, text), error: SourceError::Allocation(error.error) })
                            },
                        }
                    },
                }
            },
        }
    }
    pub fn name<'a>(value: &'a Self, source: SourceId) -> Option<Str<'a>> {
        handle source_file(value, source) { Result::Ok(file) => Some(String::as_str(&file.name)), Result::Err(_) => None }
    }
    pub fn text<'a>(value: &'a Self, source: SourceId) -> Option<Str<'a>> {
        handle source_file(value, source) { Result::Ok(file) => Some(String::as_str(&file.text)), Result::Err(_) => None }
    }
    pub fn slice<'a>(value: &'a Self, span: SourceSpan) -> Result<Str<'a>,SourceError> {
        handle source_file(value, span.source) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(file) => handle span.range.start > span.range.end {
                true => Result::Err(SourceError::InvalidRange),
                false => handle Str::subslice(String::as_str(&file.text), span.range.start, span.range.end - span.range.start) {
                    Result::Ok(text) => Result::Ok(text),
                    Result::Err(StringRangeError::NotCharBoundary) => Result::Err(SourceError::InvalidBoundary),
                    Result::Err(_) => Result::Err(SourceError::InvalidRange),
                },
            },
        }
    }
    pub fn locate(value: &Self, source: SourceId, offset: usize) -> Result<SourceLocation,SourceError> {
        handle source_file(value, source) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(file) => handle offset > String::len(&file.text) {
                true => Result::Err(SourceError::InvalidRange),
                false => handle Str::is_char_boundary(String::as_str(&file.text), offset) {
                    false => Result::Err(SourceError::InvalidBoundary),
                    true => {
                        let line = source_line(file, offset);
                        Result::Ok(SourceLocation { source: source, line: line, column_bytes: offset - *Vec::get_unchecked(&file.lines, line) })
                    },
                },
            },
        }
    }
    pub fn to_utf16(value: &Self, source: SourceId, offset: usize) -> Result<Utf16Location,SourceError> {
        handle Self::locate(value, source, offset) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(location) => handle source_file(value, source) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(file) => Result::Ok(Utf16Location { line: location.line, column_units: source_utf16_count(
                    Str::as_bytes(String::as_str(&file.text)), offset - location.column_bytes, offset, 0) }),
            },
        }
    }
    pub fn from_utf16(value: &Self, source: SourceId, location: Utf16Location) -> Result<usize,SourceError> {
        handle source_file(value, source) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(file) => handle Vec::get(&file.lines, location.line) {
                Result::Err(_) => Result::Err(SourceError::InvalidRange),
                Result::Ok(start) => {
                    let final_line = location.line + 1 == Vec::len(&file.lines);
                    let end = handle final_line { true => String::len(&file.text), false => *Vec::get_unchecked(&file.lines, location.line + 1) };
                    source_utf16_offset(Str::as_bytes(String::as_str(&file.text)), *start, end, final_line, 0, location.column_units)
                },
            },
        }
    }
    // A line extent includes its LF/CRLF bytes; the final line ends at EOF.
    pub fn line_range(value: &Self, source: SourceId, line: usize) -> Result<Range<usize>,SourceError> {
        handle source_file(value, source) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(file) => handle Vec::get(&file.lines, line) {
                Result::Err(_) => Result::Err(SourceError::InvalidRange),
                Result::Ok(start) => Result::Ok(Range { start: *start, end: handle line + 1 == Vec::len(&file.lines) {
                    true => String::len(&file.text), false => *Vec::get_unchecked(&file.lines, line + 1),
                } }),
            },
        }
    }
}
