// Ownership-preserving additions from specification §§3, 8–10.
pub enum Either<A,B> { Left(A), Right(B) }
pub enum RangeError { Reversed, OutOfBounds, Overflow }
pub struct CapacityError { pub requested: usize }

pub fn absurd<T>(value: !) -> T { handle value {} }

impl<T,E> Result<T,E> {
    pub fn as_refs<'a>(value: &'a Self) -> Result<&'a T,&'a E> {
        handle *value {
            Result::Ok(_) => Result::Ok(&value.0),
            Result::Err(_) => Result::Err(&value.0),
        }
    }
    pub fn as_muts<'a>(value: &'a mut Self) -> Result<&'a mut T,&'a mut E> {
        handle *value {
            Result::Ok(_) => Result::Ok(&mut value.0),
            Result::Err(_) => Result::Err(&mut value.0),
        }
    }
    pub fn ok(value: Self) -> Option<T> where E: Use<[0,1]> {
        handle value { Result::Ok(item) => Some(item), Result::Err(_) => None }
    }
    pub fn err(value: Self) -> Option<E> where T: Use<[0,1]> {
        handle value { Result::Ok(_) => None, Result::Err(error) => Some(error) }
    }
    pub fn swap(value: Self) -> Result<E,T> {
        handle value { Result::Ok(item) => Result::Err(item), Result::Err(error) => Result::Ok(error) }
    }
    pub fn contains(value: &Self, expected: &T) -> Bool where T: PartialEq {
        handle *value { Result::Ok(_) => PartialEq::eq(&value.0, expected), Result::Err(_) => false }
    }
    pub fn contains_err(value: &Self, expected: &E) -> Bool where E: PartialEq {
        handle *value { Result::Ok(_) => false, Result::Err(_) => PartialEq::eq(&value.0, expected) }
    }
    pub fn unwrap_or_default(value: Self) -> T where T: Default, E: Use<[0,1]> {
        handle value { Result::Ok(item) => item, Result::Err(_) => Default::default() }
    }
    pub fn expect(value: Self, message: Str) -> T where E: Debug {
        handle value { Result::Ok(item) => item, Result::Err(error) => __g1_abort() }
    }
    pub fn expect_err(value: Self, message: Str) -> E where T: Debug {
        handle value { Result::Ok(item) => __g1_abort(), Result::Err(error) => error }
    }
}
impl<T,E> Result<Result<T,E>,E> {
    pub fn flatten(value: Self) -> Result<T,E> {
        handle value { Result::Ok(inner) => inner, Result::Err(error) => Result::Err(error) }
    }
}
impl<T,E,D> Result<Result<T,E>,D> {
    pub fn transpose(value: Self) -> Result<Result<T,D>,E> {
        handle value {
            Result::Ok(inner) => handle inner {
                Result::Ok(item) => Result::Ok(Result::Ok(item)),
                Result::Err(error) => Result::Err(error),
            },
            Result::Err(error) => Result::Ok(Result::Err(error)),
        }
    }
}
impl<'a,T,E> Result<&'a T,E> {
    pub fn copied(value: Self) -> Result<T,E> where T: Use<[0,*]> {
        handle value { Result::Ok(item) => Result::Ok(*item), Result::Err(error) => Result::Err(error) }
    }
    pub fn cloned(value: Self) -> Result<T,E> where T: Clone {
        handle value { Result::Ok(item) => Result::Ok(Clone::clone(item)), Result::Err(error) => Result::Err(error) }
    }
}
impl<'a,T,E> Result<T,&'a E> {
    pub fn copied_err(value: Self) -> Result<T,E> where E: Use<[0,*]> {
        handle value { Result::Ok(item) => Result::Ok(item), Result::Err(error) => Result::Err(*error) }
    }
    pub fn cloned_err(value: Self) -> Result<T,E> where E: Clone {
        handle value { Result::Ok(item) => Result::Ok(item), Result::Err(error) => Result::Err(Clone::clone(error)) }
    }
}
pub enum ZipFailure<T,U,E,D> {
    LeftFailed { error: E, right: U },
    RightFailed { left: T, error: D },
    BothFailed { left: E, right: D },
}
pub fn zip_lossless<T,U,E,D>(left: Result<T,E>, right: Result<U,D>)
    -> Result<(T,U),ZipFailure<T,U,E,D>> {
    handle left {
        Result::Ok(item) => handle right {
            Result::Ok(other) => Result::Ok((item, other)),
            Result::Err(error) => Result::Err(ZipFailure::RightFailed { left: item, error: error }),
        },
        Result::Err(error) => handle right {
            Result::Ok(other) => Result::Err(ZipFailure::LeftFailed { error: error, right: other }),
            Result::Err(other) => Result::Err(ZipFailure::BothFailed { left: error, right: other }),
        },
    }
}
pub fn unzip_result<A,B,E>(value: Result<(A,B),E>) -> (Result<A,E>,Result<B,E>)
    where E: Use<[0,*]> {
    handle value {
        Result::Ok((left, right)) => (Result::Ok(left), Result::Ok(right)),
        Result::Err(error) => (Result::Err(error), Result::Err(error)),
    }
}
pub fn unzip_result_cloned<A,B,E>(value: Result<(A,B),E>) -> (Result<A,E>,Result<B,E>)
    where E: Clone {
    handle value {
        Result::Ok((left, right)) => (Result::Ok(left), Result::Ok(right)),
        Result::Err(error) => { let other = Clone::clone(&error); (Result::Err(error), Result::Err(other)) },
    }
}
pub fn zip_option<A,B>(left: Option<A>, right: Option<B>) -> Option<(A,B)>
    where A: Use<[0,1]>, B: Use<[0,1]> {
    handle left {
        Result::Ok(item) => handle right { Result::Ok(other) => Some((item, other)), Result::Err(_) => None },
        Result::Err(_) => None,
    }
}
pub fn zip_option_lossless<A,B>(left: Option<A>, right: Option<B>)
    -> Result<(A,B),(Option<A>,Option<B>)> {
    handle left {
        Result::Ok(item) => handle right {
            Result::Ok(other) => Result::Ok((item, other)),
            Result::Err(_) => Result::Err((Some(item), None)),
        },
        Result::Err(_) => Result::Err((None, right)),
    }
}
pub fn unzip_option<A,B>(value: Option<(A,B)>) -> (Option<A>,Option<B>) {
    handle value { Result::Ok((left, right)) => (Some(left), Some(right)), Result::Err(_) => (None, None) }
}
impl<T> Option<T> {
    pub fn insert_or_return<'a>(target: &'a mut Self, value: T) -> (&'a mut T,Option<T>) {
        handle *target {
            Result::Ok(_) => (&mut target.0, Some(value)),
            Result::Err(_) => { *target = Some(value); (&mut target.0, None) },
        }
    }
    pub fn ok_or<E>(value: Self, error: E) -> Result<T,E> where E: Use<[0,1]> {
        handle value { Result::Ok(item) => Result::Ok(item), Result::Err(_) => Result::Err(error) }
    }
}
impl Bool {
    pub fn to_u8(value: Bool) -> u8 { handle value { true => 1, false => 0 } }
    pub fn from_u8(value: u8) -> Option<Bool> {
        handle value { 0 => Some(false), 1 => Some(true), _ => None }
    }
    pub fn xor(left: Bool, right: Bool) -> Bool { handle left { true => not(right), false => right } }
    pub fn equivalent(left: Bool, right: Bool) -> Bool { not(Bool::xor(left, right)) }
    pub fn parse(text: Str) -> Option<Bool> {
        handle Slice::lex_compare(Str::as_bytes(text), Str::as_bytes("true")) {
            Ordering::Equal => Some(true),
            _ => handle Slice::lex_compare(Str::as_bytes(text), Str::as_bytes("false")) {
                Ordering::Equal => Some(false), _ => None,
            },
        }
    }
}
impl Ordering {
    pub fn reverse(value: Self) -> Self {
        handle value { Ordering::Less => Ordering::Greater, Ordering::Equal => Ordering::Equal, Ordering::Greater => Ordering::Less }
    }
    pub fn is_less(value: Self) -> Bool { handle value { Ordering::Less => true, _ => false } }
    pub fn is_equal(value: Self) -> Bool { handle value { Ordering::Equal => true, _ => false } }
    pub fn is_greater(value: Self) -> Bool { handle value { Ordering::Greater => true, _ => false } }
    pub fn then(left: Self, right: Self) -> Self { handle left { Ordering::Equal => right, _ => left } }
}
pub fn min_ref<'a,T>(left: &'a T, right: &'a T) -> &'a T where T: Ord {
    handle Ord::cmp(left, right) { Ordering::Greater => right, _ => left }
}
pub fn max_ref<'a,T>(left: &'a T, right: &'a T) -> &'a T where T: Ord {
    handle Ord::cmp(left, right) { Ordering::Less => right, _ => left }
}
impl Range<usize> {
    pub fn checked(value: Self, length: usize) -> Result<Self,RangeError> {
        handle value.start > value.end {
            true => Result::Err(RangeError::Reversed),
            false => handle value.end > length {
                true => Result::Err(RangeError::OutOfBounds), false => Result::Ok(value),
            },
        }
    }
    pub fn split_at(value: Self, relative: usize) -> Result<(Self,Self),RangeError> {
        handle value.start > value.end {
            true => Result::Err(RangeError::Reversed),
            false => handle relative > value.end - value.start {
                true => Result::Err(RangeError::OutOfBounds),
                false => {
                    let middle = value.start + relative;
                    Result::Ok((Range { start: value.start, end: middle }, Range { start: middle, end: value.end }))
                },
            },
        }
    }
}
