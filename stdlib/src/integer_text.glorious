// Strict integer parsing and radix formatting. Bounds are mathematical
// magnitudes, so the signed minimum never requires an unrepresentable abs.
fn integer_digit(byte: u8) -> Option<u32> {
    handle byte >= 48 {
        false => None,
        true => handle byte <= 57 {
            true => Some(as<u32>(byte - 48)),
            false => handle byte >= 65 {
                false => None,
                true => handle byte <= 90 {
                    true => Some(as<u32>(byte - 65) + 10),
                    false => handle byte >= 97 {
                        false => None,
                        true => handle byte <= 122 { true => Some(as<u32>(byte - 97) + 10), false => None },
                    },
                },
            },
        },
    }
}
fn parse_integer_digits(bytes: Slice<u8>, radix: u32, limit: u128, index: usize, value: u128)
    -> Result<u128,IntParseError> {
    handle index == Slice::len(&bytes) {
        true => Result::Ok(value),
        false => {
            let byte = *Slice::get_unchecked(bytes, index);
            handle integer_digit(byte) {
                Result::Err(_) => Result::Err(IntParseError { offset: index, kind: handle byte {
                    95 => IntParseErrorKind::InvalidSeparator,
                    43 => IntParseErrorKind::InvalidSign,
                    45 => IntParseErrorKind::InvalidSign,
                    _ => IntParseErrorKind::InvalidDigit,
                } }),
                Result::Ok(digit) => handle digit >= radix {
                    true => Result::Err(IntParseError { offset: index, kind: IntParseErrorKind::InvalidDigit }),
                    false => {
                        let digit = as<u128>(digit);
                        handle value > (limit - digit) / as<u128>(radix) {
                            true => Result::Err(IntParseError { offset: index, kind: IntParseErrorKind::Overflow }),
                            false => tail parse_integer_digits(bytes, radix, limit, index + 1, value * as<u128>(radix) + digit),
                        }
                    },
                },
            }
        },
    }
}
fn parse_integer(text: Str, radix: u32, positive_limit: u128, negative_limit: u128, signed: Bool)
    -> Result<(Bool,u128),IntParseError> {
    handle radix < 2 {
        true => Result::Err(IntParseError { offset: 0, kind: IntParseErrorKind::InvalidRadix }),
        false => handle radix > 36 {
            true => Result::Err(IntParseError { offset: 0, kind: IntParseErrorKind::InvalidRadix }),
            false => {
                let bytes = Str::as_bytes(text);
                handle Slice::len(&bytes) == 0 {
                    true => Result::Err(IntParseError { offset: 0, kind: IntParseErrorKind::Empty }),
                    false => {
                        let first = *Slice::get_unchecked(bytes, 0);
                        let negative = first == 45;
                        let start = handle first { 43 => 1, 45 => 1, _ => 0 };
                        handle negative {
                            true => handle signed { false => return(Result::Err(IntParseError { offset: 0, kind: IntParseErrorKind::InvalidSign }), @parse_integer), true => () },
                            false => (),
                        };
                        handle start == Slice::len(&bytes) {
                            true => Result::Err(IntParseError { offset: start, kind: IntParseErrorKind::Empty }),
                            false => {
                                let limit = handle negative { true => negative_limit, false => positive_limit };
                                handle parse_integer_digits(bytes, radix, limit, start, 0) {
                                    Result::Err(error) => Result::Err(error),
                                    Result::Ok(value) => Result::Ok((negative, value)),
                                }
                            },
                        }
                    },
                }
            },
        },
    }
}
fn format_integer_digits(value: u128, radix: u128, output: &mut String) {
    let quotient = value / radix;
    handle quotient == 0 { true => (), false => format_integer_digits(quotient, radix, &mut *output) };
    let digit = as<u8>(value % radix);
    let byte = handle digit < 10 { true => digit + 48, false => digit - 10 + 97 };
    Vec::push(&mut output.storage, byte)
}
fn format_integer(value: u128, negative: Bool, radix: u32) -> Result<String,RadixError> {
    handle radix < 2 {
        true => Result::Err(RadixError::TooSmall),
        false => handle radix > 36 {
            true => Result::Err(RadixError::TooLarge),
            false => {
                let mut output = String::new();
                handle negative { true => Vec::push(&mut output.storage, 45), false => () };
                format_integer_digits(value, as<u128>(radix), &mut output);
                Result::Ok(output)
            },
        },
    }
}

pub trait TryAs<T> { type Error; fn try_cast(value: Self) -> Result<T,<Self as TryAs<T>>::Error>; }
pub trait ExactAs<T> { type Error; fn exact_cast(value: Self) -> Result<T,<Self as ExactAs<T>>::Error>; }
pub fn try_as<T,S>(value: S) -> Result<T,<S as TryAs<T>>::Error> where S: TryAs<T> { TryAs<T>::try_cast(value) }
pub fn exact_convert<T,S>(value: S) -> Result<T,<S as ExactAs<T>>::Error> where S: ExactAs<T> { ExactAs<T>::exact_cast(value) }

impl u8 {
    pub fn parse(text: Str) -> Result<Self,IntParseError> { Self::parse_radix(text, 10) }
    pub fn parse_radix(text: Str, radix: u32) -> Result<Self,IntParseError> {
        handle parse_integer(text, radix, 255, 0, false) {
            Result::Err(error) => Result::Err(error),
            Result::Ok((negative, magnitude)) => handle negative {
                true => Result::Ok(crate::wrapping_sub(0, as<Self>(magnitude))),
                false => Result::Ok(as<Self>(magnitude)),
            },
        }
    }
    pub fn format_radix(value: Self, radix: u32) -> Result<String,RadixError> {
        format_integer(as<u128>(num_u8_magnitude(value)), false, radix)
    }
}

pub impl TryAs<u8> for u8 {
    type Error = ConversionError;
    fn try_cast(value: u8) -> Result<u8,ConversionError> {
        handle as<u128>(value) > 255 { true => Result::Err(ConversionError::OutOfRange), false => Result::Ok(as<u8>(value)) }
    }
}
pub impl ExactAs<u8> for u8 {
    type Error = ConversionError;
    fn exact_cast(value: u8) -> Result<u8,ConversionError> { TryAs<u8>::try_cast(value) }
}

