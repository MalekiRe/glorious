pub enum BudgetKind { Steps, Depth, Memory, Diagnostics, Items }
pub struct BudgetExceeded { pub kind: BudgetKind, pub requested: u64, pub remaining: u64 }
pub enum MarkError { WrongOwner, Stale, OutOfRange, NotTop }
pub enum ControlSignal { Proceed, CancelRequested }
pub effect RequestControl { poll() -> ControlSignal; }

pub struct StepBudget { private remaining: u64 }
impl StepBudget {
    pub fn new(limit: u64) -> Self { StepBudget { remaining: limit } }
    pub fn remaining(value: &Self) -> u64 { value.remaining }
    pub fn charge(value: &mut Self, steps: u64) -> Result<(),BudgetExceeded> {
        handle steps > value.remaining {
            true => Result::Err(BudgetExceeded { kind: BudgetKind::Steps, requested: steps, remaining: value.remaining }),
            false => { (*value).remaining = value.remaining - steps; Result::Ok(()) },
        }
    }
}
pub struct MemoryBudget { private owner: IdentityToken, private remaining: u64, private limit: u64 }
pub struct MemoryCharge { private owner: IdentityToken, private bytes: u64 }
pub impl Use<[1,1]> for MemoryCharge {}
impl MemoryBudget {
    pub fn new(limit: u64) -> Self { MemoryBudget { owner: identity_new(), remaining: limit, limit: limit } }
    pub fn remaining(value: &Self) -> u64 { value.remaining }
    pub fn charge(value: &mut Self, bytes: u64) -> Result<MemoryCharge,BudgetExceeded> {
        handle bytes > value.remaining {
            true => Result::Err(BudgetExceeded { kind: BudgetKind::Memory, requested: bytes, remaining: value.remaining }),
            false => {
                let owner = Clone::clone(&value.owner);
                (*value).remaining = value.remaining - bytes;
                Result::Ok(MemoryCharge { owner: owner, bytes: bytes })
            },
        }
    }
    pub fn release(value: &mut Self, charge: MemoryCharge) -> Result<(),Rejected<MemoryCharge,MarkError>> {
        handle identity_same(&value.owner, &charge.owner) {
            false => Result::Err(Rejected { value: charge, error: MarkError::WrongOwner }),
            true => handle charge.bytes > value.limit - value.remaining {
                true => Result::Err(Rejected { value: charge, error: MarkError::Stale }),
                false => {
                    let MemoryCharge { owner: owner, bytes: bytes } = charge;
                    (*value).remaining = value.remaining + bytes;
                    Result::Ok(())
                },
            },
        }
    }
}
pub struct DepthBudget { private owner: IdentityToken, private limit: u32, private next: u64, private active: Vec<u64> }
pub struct DepthPermit { private owner: IdentityToken, private serial: u64 }
pub impl Use<[1,1]> for DepthPermit {}
fn depth_find(active: &Vec<u64>, serial: u64, index: usize) -> Option<usize> {
    handle index == Vec::len(active) {
        true => None,
        false => handle *Vec::get_unchecked(active, index) == serial { true => Some(index), false => tail depth_find(active, serial, index + 1) },
    }
}
impl DepthBudget {
    pub fn new(limit: u32) -> Self { DepthBudget { owner: identity_new(), limit: limit, next: 0, active: Vec::new() } }
    pub fn enter(value: &mut Self) -> Result<DepthPermit,BudgetExceeded> {
        handle Vec::len(&value.active) >= as<usize>(value.limit) {
            true => Result::Err(BudgetExceeded { kind: BudgetKind::Depth, requested: 1, remaining: 0 }),
            false => {
                // Serial exhaustion is a resource limit; it never revives a retired permit.
                handle value.next == bit_not<u64>(0) {
                    true => Result::Err(BudgetExceeded { kind: BudgetKind::Depth, requested: 1, remaining: 0 }),
                    false => {
                        let serial = value.next;
                        let owner = Clone::clone(&value.owner);
                        Vec::push(&mut value.active, serial);
                        (*value).next = value.next + 1;
                        Result::Ok(DepthPermit { owner: owner, serial: serial })
                    },
                }
            },
        }
    }
    pub fn leave(value: &mut Self, permit: DepthPermit) -> Result<(),Rejected<DepthPermit,MarkError>> {
        handle identity_same(&value.owner, &permit.owner) {
            false => Result::Err(Rejected { value: permit, error: MarkError::WrongOwner }),
            true => handle depth_find(&value.active, permit.serial, 0) {
                Result::Err(_) => Result::Err(Rejected { value: permit, error: MarkError::Stale }),
                Result::Ok(index) => {
                    let DepthPermit { owner: owner, serial: serial } = permit;
                    Vec::swap_remove(&mut value.active, index);
                    Result::Ok(())
                },
            },
        }
    }
}
