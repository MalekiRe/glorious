pub struct Box<T> { private pointer: *mut T, private ownership: PhantomData<T>, private unique: VecOwner }
impl<T> Box<T> {
    pub fn try_new(value: T) -> Result<Self,Rejected<T,AllocError>> {
        let pointer = unsafe { __g1_memory_allocate(size_of<T>(), align_of<T>()) };
        handle unsafe { __g1_memory_is_null(pointer) } != 0 {
            true => Result::Err(Rejected { value: value, error: AllocError::Exhausted }),
            false => {
                let pointer = unsafe { __g1_memory_cast<u8,T>(pointer) };
                unsafe { __g1_memory_write(pointer, value) };
                Result::Ok(Box { pointer: pointer, ownership: PhantomData {}, unique: VecOwner {} })
            },
        }
    }
    pub fn new(value: T) -> Self {
        handle Self::try_new(value) { Result::Ok(owner) => owner, Result::Err(_) => __g1_abort() }
    }
    pub fn as_ref<'a>(value: &'a Self) -> &'a T { unsafe { __g1_memory_borrow_shared(__g1_memory_as_const(value.pointer)) } }
    pub fn as_mut<'a>(value: &'a mut Self) -> &'a mut T { unsafe { __g1_memory_borrow_unique(value.pointer) } }
    pub fn allocator(value: &Self) -> AllocatorId { AllocatorId(0) }
    pub fn into_inner(value: Self) -> T {
        let Box { pointer: pointer, ownership: PhantomData {}, unique: VecOwner {} } = value;
        let item = unsafe { __g1_memory_read(__g1_memory_as_const(pointer)) };
        unsafe { __g1_memory_deallocate(__g1_memory_cast<T,u8>(pointer), size_of<T>(), align_of<T>()) };
        item
    }
    pub unsafe fn into_raw(value: Self) -> *mut T {
        let Box { pointer: pointer, ownership: PhantomData {}, unique: VecOwner {} } = value;
        pointer
    }
    pub unsafe fn from_raw(value: *mut T, allocator: AllocatorId) -> Self {
        let AllocatorId(domain) = allocator;
        handle domain == 0 { true => (), false => __g1_abort() };
        Box { pointer: value, ownership: PhantomData {}, unique: VecOwner {} }
    }
}
impl<T> Drop for Box<T> where T: Use<[0,1]> {
    drop(&mut self) -> {
        let item = unsafe { __g1_memory_read(__g1_memory_as_const(self.pointer)) };
        discard(item);
        unsafe { __g1_memory_deallocate(__g1_memory_cast<T,u8>(self.pointer), size_of<T>(), align_of<T>()) }
    }
}
