// Typed index domains and source-owned compiler data structures (§24).
// An Id carries its nominal Tag in its type, never ownership of a Tag value.
pub struct Id<Tag> { private index: u32 }
pub struct IndexOverflow {}
pub impl<Tag> Use<[0,*]> for Id<Tag> {}
pub impl<Tag> Eq for Id<Tag> { fn eq(left: &Self, right: &Self) -> Bool { left.index == right.index } }
pub impl<Tag> Ord for Id<Tag> { fn compare(left: &Self, right: &Self) -> Ordering { Ord::compare(&left.index, &right.index) } }
pub impl<Tag> Hash for Id<Tag> { fn hash(value: &Self, state: &mut Hasher) { Hash::hash(&value.index, state) } }
pub impl<Tag> Clone for Id<Tag> { fn clone(value: &Self) -> Self { Id { index: value.index } } }
impl<Tag> Id<Tag> {
    pub fn from_u32(value: u32) -> Self { Id { index: value } }
    pub fn to_u32(value: Self) -> u32 { value.index }
    pub fn from_usize(value: usize) -> Result<Self,IndexOverflow> {
        handle value > 4294967295 { true => Result::Err(IndexOverflow {}), false => Result::Ok(Id { index: as<u32>(value) }) }
    }
    pub fn to_usize(value: Self) -> usize { as<usize>(value.index) }
}
pub struct IndexVec<Tag,T> { private values: Vec<T> }
impl<Tag,T> IndexVec<Tag,T> {
    pub fn new() -> Self { IndexVec { values: Vec::new() } }
    pub fn len(value: &Self) -> usize { Vec::len(&value.values) }
    pub fn push(value: &mut Self, item: T) -> Result<Id<Tag>,Rejected<T,IndexOverflow>> {
        handle Id::from_usize(Vec::len(&value.values)) {
            Result::Err(error) => Result::Err(Rejected { value: item, error: error }),
            Result::Ok(id) => { Vec::push(&mut value.values, item); Result::Ok(id) },
        }
    }
    pub fn get<'a>(value: &'a Self, id: Id<Tag>) -> Option<&'a T> { Vec::get(&value.values, Id::to_usize(id)) }
    pub fn get_mut<'a>(value: &'a mut Self, id: Id<Tag>) -> Option<&'a mut T> { Vec::get_mut(&mut value.values, Id::to_usize(id)) }
    pub fn as_slice<'a>(value: &'a Self) -> Slice<'a,T> { Vec::as_slice(&value.values) }
    pub fn into_vec(value: Self) -> Vec<T> { value.values }
}
pub enum InternOutcome<Tag,T> { Inserted(Id<Tag>), Existing { id: Id<Tag>, unused: T } }
pub struct Interner<Tag,T> { private values: IndexVec<Tag,T> }
fn interner_find_from<Tag,T>(values: &IndexVec<Tag,T>, item: &T, index: usize) -> Option<Id<Tag>> where T: Eq {
    handle index == IndexVec::len(values) {
        true => None,
        false => handle Eq::eq(Vec::get_unchecked(&values.values, index), item) {
            true => Some(Id { index: as<u32>(index) }),
            false => tail interner_find_from(values, item, index + 1),
        },
    }
}
impl<Tag,T> Interner<Tag,T> where T: Eq, T: Hash {
    pub fn new() -> Self { Interner { values: IndexVec::new() } }
    pub fn find(value: &Self, item: &T) -> Option<Id<Tag>> { interner_find_from(&value.values, item, 0) }
    pub fn get<'a>(value: &'a Self, id: Id<Tag>) -> Option<&'a T> { IndexVec::get(&value.values, id) }
    pub fn intern(value: &mut Self, item: T) -> Result<InternOutcome<Tag,T>,Rejected<T,IndexOverflow>> {
        handle Self::find(value, &item) {
            Result::Ok(id) => Result::Ok(InternOutcome::Existing { id: id, unused: item }),
            Result::Err(_) => handle IndexVec::push(&mut value.values, item) {
                Result::Ok(id) => Result::Ok(InternOutcome::Inserted(id)), Result::Err(error) => Result::Err(error),
            },
        }
    }
    pub fn intern_discarding(value: &mut Self, item: T) -> Result<Id<Tag>,Rejected<T,IndexOverflow>> where T: Use<[0,1]> {
        handle Self::intern(value, item) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(InternOutcome::Inserted(id)) => Result::Ok(id),
            Result::Ok(InternOutcome::Existing { id: id, unused: _ }) => Result::Ok(id),
        }
    }
    pub fn into_values(value: Self) -> Vec<T> { IndexVec::into_vec(value.values) }
}
pub struct StringInterner<Tag> { private values: IndexVec<Tag,String> }
fn string_interner_find_from<Tag>(value: &StringInterner<Tag>, text: Str, index: usize) -> Option<Id<Tag>> {
    handle index == IndexVec::len(&value.values) {
        true => None,
        false => {
            let resident = Vec::get_unchecked(&value.values.values, index);
            handle Slice::lex_compare(Str::as_bytes(String::as_str(resident)), Str::as_bytes(text)) {
                Ordering::Equal => Some(Id { index: as<u32>(index) }),
                _ => tail string_interner_find_from(value, text, index + 1),
            }
        },
    }
}
impl<Tag> StringInterner<Tag> {
    pub fn new() -> Self { StringInterner { values: IndexVec::new() } }
    pub fn find(value: &Self, text: Str) -> Option<Id<Tag>> { string_interner_find_from(value, text, 0) }
    pub fn intern(value: &mut Self, text: Str) -> Result<Id<Tag>,IndexOverflow> {
        handle Self::find(value, text) {
            Result::Ok(id) => Result::Ok(id),
            Result::Err(_) => {
                let mut owned = String::new();
                String::push_str(&mut owned, text);
                handle IndexVec::push(&mut value.values, owned) {
                    Result::Ok(id) => Result::Ok(id), Result::Err(error) => Result::Err(error.error),
                }
            },
        }
    }
    pub fn get<'a>(value: &'a Self, id: Id<Tag>) -> Option<Str<'a>> {
        handle IndexVec::get(&value.values, id) {
            Result::Ok(text) => Some(String::as_str(text)), Result::Err(_) => None,
        }
    }
}
pub struct BitSet<Tag> { private words: Vec<u64>, private count: usize }
impl<Tag> BitSet<Tag> {
    pub fn new() -> Self { BitSet { words: Vec::new(), count: 0 } }
    pub fn len(value: &Self) -> usize { value.count }
    pub fn contains(value: &Self, id: Id<Tag>) -> Bool {
        let index = Id::to_usize(id);
        handle Vec::get(&value.words, index / 64) {
            Result::Err(_) => false,
            Result::Ok(word) => bit_and(*word, bit_shl(1, as<u32>(index % 64))) != 0,
        }
    }
    pub fn insert(value: &mut Self, id: Id<Tag>) -> Bool {
        handle Self::contains(value, id) {
            true => false,
            false => {
                let index = Id::to_usize(id);
                let word = index / 64;
                handle word >= Vec::len(&value.words) {
                    true => Vec::resize(&mut value.words, word + 1, 0), false => (),
                };
                handle Vec::get_mut(&mut value.words, word) {
                    Result::Err(_) => __g1_abort(),
                    Result::Ok(resident) => { *resident = bit_or(*resident, bit_shl(1, as<u32>(index % 64))); },
                };
                (*value).count = value.count + 1;
                true
            },
        }
    }
    pub fn remove(value: &mut Self, id: Id<Tag>) -> Bool {
        handle Self::contains(value, id) {
            false => false,
            true => {
                let index = Id::to_usize(id);
                handle Vec::get_mut(&mut value.words, index / 64) {
                    Result::Err(_) => __g1_abort(),
                    Result::Ok(word) => { *word = bit_and(*word, bit_not(bit_shl(1, as<u32>(index % 64)))); },
                };
                (*value).count = value.count - 1;
                true
            },
        }
    }
    pub fn clear(value: &mut Self) { Vec::clear(&mut value.words); (*value).count = 0; }
    pub fn to_vec(value: &Self) -> Vec<Id<Tag>> {
        let mut output = Vec::with_capacity(value.count);
        bitset_collect(value, &mut output, 0);
        output
    }
    pub fn union_with(value: &mut Self, other: &Self) -> Bool {
        let ids = Self::to_vec(other);
        bitset_apply(value, Vec::as_slice(&ids), 0, false, false)
    }
    pub fn subtract(value: &mut Self, other: &Self) -> Bool {
        let ids = Self::to_vec(other);
        bitset_apply(value, Vec::as_slice(&ids), 0, true, false)
    }
    pub fn intersect_with(value: &mut Self, other: &Self) -> Bool {
        let ids = Self::to_vec(value);
        bitset_intersect(value, other, Vec::as_slice(&ids), 0, false)
    }
    pub fn is_subset(value: &Self, other: &Self) -> Bool {
        let ids = Self::to_vec(value);
        bitset_subset(other, Vec::as_slice(&ids), 0)
    }
}
fn bitset_collect<Tag>(value: &BitSet<Tag>, output: &mut Vec<Id<Tag>>, word: usize) {
    handle word == Vec::len(&value.words) {
        true => (),
        false => {
            bitset_collect_word(*Vec::get_unchecked(&value.words, word), word * 64, output, 0);
            tail bitset_collect(value, output, word + 1)
        },
    }
}
fn bitset_collect_word<Tag>(word: u64, base: usize, output: &mut Vec<Id<Tag>>, bit: u32) {
    handle bit == 64 {
        true => (),
        false => {
            handle bit_and(word, bit_shl(1, bit)) != 0 {
                true => Vec::push(&mut *output, Id { index: as<u32>(base + as<usize>(bit)) }), false => (),
            };
            tail bitset_collect_word(word, base, output, bit + 1)
        },
    }
}
fn bitset_apply<Tag>(value: &mut BitSet<Tag>, ids: Slice<Id<Tag>>, index: usize, remove: Bool, changed: Bool) -> Bool {
    handle index == Slice::len(&ids) {
        true => changed,
        false => {
            let id = *Slice::get_unchecked(ids, index);
            let update = handle remove { true => BitSet::remove(&mut *value, id), false => BitSet::insert(&mut *value, id) };
            let changed = handle update { true => true, false => changed };
            tail bitset_apply(value, ids, index + 1, remove, changed)
        },
    }
}
fn bitset_intersect<Tag>(value: &mut BitSet<Tag>, other: &BitSet<Tag>, ids: Slice<Id<Tag>>, index: usize, changed: Bool) -> Bool {
    handle index == Slice::len(&ids) {
        true => changed,
        false => {
            let id = *Slice::get_unchecked(ids, index);
            let changed = handle BitSet::contains(other, id) {
                true => changed, false => { BitSet::remove(&mut *value, id); true },
            };
            tail bitset_intersect(value, other, ids, index + 1, changed)
        },
    }
}
fn bitset_subset<Tag>(other: &BitSet<Tag>, ids: Slice<Id<Tag>>, index: usize) -> Bool {
    handle index == Slice::len(&ids) {
        true => true,
        false => handle BitSet::contains(other, *Slice::get_unchecked(ids, index)) {
            false => false, true => tail bitset_subset(other, ids, index + 1),
        },
    }
}
pub struct SparseSet<Tag> { private dense: Vec<Id<Tag>>, private sparse: Vec<Option<usize>> }
impl<Tag> SparseSet<Tag> {
    pub fn new() -> Self { SparseSet { dense: Vec::new(), sparse: Vec::new() } }
    pub fn len(value: &Self) -> usize { Vec::len(&value.dense) }
    pub fn contains(value: &Self, id: Id<Tag>) -> Bool {
        handle Vec::get(&value.sparse, Id::to_usize(id)) {
            Result::Err(_) => false,
            Result::Ok(slot) => handle *slot { Result::Ok(_) => true, Result::Err(_) => false },
        }
    }
    pub fn insert(value: &mut Self, id: Id<Tag>) -> Bool {
        handle Self::contains(value, id) {
            true => false,
            false => {
                let index = Id::to_usize(id);
                handle index >= Vec::len(&value.sparse) {
                    true => Vec::resize(&mut value.sparse, index + 1, None), false => (),
                };
                let position = Vec::len(&value.dense);
                Vec::push(&mut value.dense, id);
                handle Vec::get_mut(&mut value.sparse, index) {
                    Result::Ok(slot) => { *slot = Some(position); }, Result::Err(_) => __g1_abort(),
                };
                true
            },
        }
    }
    pub fn remove(value: &mut Self, id: Id<Tag>) -> Bool {
        handle Self::contains(value, id) {
            false => false,
            true => {
                let index = Id::to_usize(id);
                let position = handle Vec::get_mut(&mut value.sparse, index) {
                    Result::Err(_) => __g1_abort(),
                    Result::Ok(slot) => handle Option::take(slot) { Result::Ok(position) => position, Result::Err(_) => __g1_abort() },
                };
                Vec::swap_remove(&mut value.dense, position);
                handle Vec::get(&value.dense, position) {
                    Result::Err(_) => (),
                    Result::Ok(moved) => {
                        let moved_index = Id::to_usize(*moved);
                        handle Vec::get_mut(&mut value.sparse, moved_index) {
                            Result::Ok(slot) => { *slot = Some(position); }, Result::Err(_) => __g1_abort(),
                        }
                    },
                };
                true
            },
        }
    }
    pub fn clear(value: &mut Self) { Vec::clear(&mut value.dense); Vec::clear(&mut value.sparse); }
    pub fn to_vec(value: &Self) -> Vec<Id<Tag>> { Clone::clone(&value.dense) }
}
pub struct WorkQueue<Tag> { private queue: Vec<Id<Tag>>, private head: usize, private pending: BitSet<Tag> }
impl<Tag> WorkQueue<Tag> {
    pub fn new() -> Self { WorkQueue { queue: Vec::new(), head: 0, pending: BitSet::new() } }
    pub fn contains(value: &Self, id: Id<Tag>) -> Bool { BitSet::contains(&value.pending, id) }
    pub fn is_empty(value: &Self) -> Bool { value.head == Vec::len(&value.queue) }
    pub fn push(value: &mut Self, id: Id<Tag>) -> Bool {
        handle BitSet::insert(&mut value.pending, id) { false => false, true => { Vec::push(&mut value.queue, id); true } }
    }
    pub fn pop(value: &mut Self) -> Option<Id<Tag>> {
        handle Self::is_empty(value) {
            true => None,
            false => {
                let id = *Vec::get_unchecked(&value.queue, value.head);
                (*value).head = value.head + 1;
                BitSet::remove(&mut value.pending, id);
                handle value.head >= Vec::len(&value.queue) / 2 {
                    false => (),
                    true => handle value.head >= 32 {
                        false => (),
                        true => {
                            let head = value.head;
                            handle Vec::split_off(&mut value.queue, head) {
                                Result::Err(_) => __g1_abort(), Result::Ok(rest) => { (*value).queue = rest; },
                            };
                            (*value).head = 0;
                        },
                    },
                };
                Some(id)
            },
        }
    }
    pub fn clear(value: &mut Self) { Vec::clear(&mut value.queue); BitSet::clear(&mut value.pending); (*value).head = 0; }
}
