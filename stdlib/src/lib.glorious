pub enum Result<T, E> { Ok(T), Err(E) }

// Option has Result's representation; it is the ordinary ownership-aware
// temporary storage type rather than a separate Slot abstraction.
pub type Option<T> = Result<T, ()>;
pub let Option::Some = Result::Ok;
pub let Some = Result::Ok;
pub let None = Result::Err(());

pub type Bool = Option<()>;
pub let true = Result::Ok(());
pub let false = Result::Err(());

pub enum Ordering { Less, Equal, Greater }
pub struct Range<T> { start: T, end: T }
pub enum SliceRangeError { Reversed, OutOfBounds }

impl Range<usize> {
    // Public ranges can be constructed with either endpoint.  Keep their query
    // operations total: a reversed range is empty rather than relying on a
    // wrapping `usize` subtraction.
    pub fn len(value: &Self) -> usize {
        handle value.end < value.start {
            true => 0,
            false => value.end - value.start,
        }
    }

    pub fn is_empty(value: &Self) -> Bool {
        handle value.end > value.start { true => false, false => true }
    }

    pub fn contains(value: &Self, index: usize) -> Bool {
        handle index < value.start {
            true => false,
            false => handle index < value.end { true => true, false => false },
        }
    }

    pub fn intersection(left: &Self, right: &Self) -> Option<Self> {
        handle left.start > right.start {
            true => range_intersection_with_start(left.start, left.end, right.end),
            false => range_intersection_with_start(right.start, left.end, right.end),
        }
    }

    // Offset both endpoints without ever forming an overflowing ordinary sum.
    // The wrapping operation is a private-machine-policy wrapper; the comparison
    // turns its overflow signal back into the public checked `Option` result.
    pub fn checked_offset(value: &Self, offset: usize) -> Option<Self> {
        let start = wrapping_add(value.start, offset);
        let end = wrapping_add(value.end, offset);
        handle start < value.start {
            true => None,
            false => handle end < value.end {
                true => None,
                false => Result::Ok(Range { start: start, end: end }),
            },
        }
    }
}

fn range_intersection_finish(start: usize, end: usize) -> Option<Range<usize>> {
    handle start < end {
        true => Result::Ok(Range { start: start, end: end }),
        false => Result::Err(()),
    }
}
fn range_intersection_with_start(start: usize, left_end: usize, right_end: usize) -> Option<Range<usize>> {
    handle left_end < right_end {
        true => range_intersection_finish(start, left_end),
        false => range_intersection_finish(start, right_end),
    }
}

// Two-word source views. The zero-sized checked referent carries the owner
// loan and the actual data address; the length bounds the initialized window.
// Private unsafe operations recover T's pointer without a second stored address.
pub struct Slice<'a, T> {
    private storage: &'a (),
    private length: usize,
}

pub struct SliceMut<'a, T> {
    private storage: &'a mut (),
    private length: usize,
}

// This is intentionally a very small iterator surface rather than a tower of
// adapters. It is enough for indexed compiler passes and makes the ownership
// boundary explicit: `SliceIter` lends elements, while `VecIntoIter` below
// transfers them out.
pub struct SliceIter<'a, T> {
    private slice: Slice<'a, T>,
    private position: usize,
}

// The UTF-8 invariant belongs to `Str`, not to the general byte slice. Its
// sole field is private, so only standard-library constructors can establish
// a `Str` value.
pub struct Str<'a> { private bytes: Slice<'a, u8> }

impl<'a, T> Slice<'a, T> {
    pub fn len(value: &Self) -> usize { value.length }

    pub fn is_empty(value: &Self) -> Bool {
        handle value.length { 0 => true, _ => false }
    }

    pub fn get_unchecked(value: Self, index: usize) -> &'a T {
        // Historical spelling is retained, but this is a SAFE export: invalid
        // indexes abort before pointer arithmetic or reference construction.
        handle index < value.length {
            false => __g1_abort(),
            true => unsafe {
                __g1_memory_borrow_shared(__g1_memory_offset_const(
                    __g1_memory_cast_const<(), T>(__g1_memory_as_raw_shared(value.storage)), index,
                ))
            },
        }
    }

    pub fn get(value: Self, index: usize) -> Option<&'a T> {
        handle index < value.length {
            true => Result::Ok(Slice::get_unchecked(value, index)),
            false => Result::Err(()),
        }
    }
}

impl<'a, T> SliceMut<'a, T> {
    pub fn len(value: &Self) -> usize { value.length }

    pub fn is_empty(value: &Self) -> Bool {
        handle value.length { 0 => true, _ => false }
    }
}

impl<T> SliceMut<'_, T> {
    pub fn get_unchecked(value: Self, index: usize) -> &mut T {
        handle index < value.length {
            false => __g1_abort(),
            true => unsafe {
                __g1_memory_borrow_unique(__g1_memory_offset(
                    __g1_memory_cast<(), T>(__g1_memory_as_raw_unique(value.storage)), index,
                ))
            },
        }
    }

    pub fn get(value: Self, index: usize) -> Option<&mut T> {
        handle index < value.length {
            true => Result::Ok(SliceMut::get_unchecked(value, index)),
            false => Result::Err(()),
        }
    }

    // Unique subviews consume their parent and retain only the checked window.
    pub fn slice(value: Self, range: Range<usize>) -> Result<Self, SliceRangeError> {
        handle range.start > range.end {
            true => Result::Err(SliceRangeError::Reversed),
            false => handle range.end > value.length {
                true => Result::Err(SliceRangeError::OutOfBounds),
                false => unsafe {
                    let pointer = __g1_memory_cast<(), T>(__g1_memory_as_raw_unique(value.storage));
                    Result::Ok(SliceMut {
                        storage: __g1_memory_borrow_unique(__g1_memory_cast<T, ()>(
                            __g1_memory_offset(pointer, range.start),
                        )),
                        length: range.end - range.start,
                    })
                },
            },
        }
    }

    pub fn split_at(value: Self, index: usize) -> Result<(Self, Self), SliceRangeError> {
        handle index > value.length {
            true => Result::Err(SliceRangeError::OutOfBounds),
            false => unsafe {
                let pointer = __g1_memory_cast<(), T>(__g1_memory_as_raw_unique(value.storage));
                Result::Ok((
                    SliceMut {
                        storage: __g1_memory_borrow_unique(__g1_memory_cast<T, ()>(pointer)),
                        length: index,
                    },
                    SliceMut {
                        storage: __g1_memory_borrow_unique(__g1_memory_cast<T, ()>(__g1_memory_offset(pointer, index))),
                        length: value.length - index,
                    },
                ))
            },
        }
    }

    // Iterating a mutable window as shared references consumes the unique view.
    // This is an ordinary reborrow into the existing lending iterator: no element
    // is copied, and the caller cannot mutate through the original SliceMut while
    // any yielded reference may still be live.
    pub fn iter(value: Self) -> SliceIter<'_, T> {
        SliceIter {
            slice: Slice {
                // Spell out the shared reborrow.  A `SliceMut` owns its unique
                // view, and the iterator takes a shared view of precisely that
                // backing storage for the duration of the iterator lifetime.
                storage: &(*value.storage),
                length: value.length,
            },
            position: 0,
        }
    }
}

impl<T> Slice<'_, T> {
    pub fn slice(value: Self, range: Range<usize>) -> Result<Self, SliceRangeError> {
        handle range.start > range.end {
            true => Result::Err(SliceRangeError::Reversed),
            false => handle range.end > value.length {
                true => Result::Err(SliceRangeError::OutOfBounds),
                false => unsafe {
                    let pointer = __g1_memory_cast_const<(), T>(__g1_memory_as_raw_shared(value.storage));
                    Result::Ok(Slice {
                        storage: __g1_memory_borrow_shared(__g1_memory_cast_const<T, ()>(
                            __g1_memory_offset_const(pointer, range.start),
                        )),
                        length: range.end - range.start,
                    })
                },
            },
        }
    }

    pub fn split_at(value: Self, index: usize) -> Result<(Self, Self), SliceRangeError> {
        handle index > value.length {
            true => Result::Err(SliceRangeError::OutOfBounds),
            false => unsafe {
                let pointer = __g1_memory_cast_const<(), T>(__g1_memory_as_raw_shared(value.storage));
                Result::Ok((
                    Slice { storage: value.storage, length: index },
                    Slice {
                        storage: __g1_memory_borrow_shared(__g1_memory_cast_const<T, ()>(
                            __g1_memory_offset_const(pointer, index),
                        )),
                        length: value.length - index,
                    },
                ))
            },
        }
    }

    pub fn iter(value: Self) -> SliceIter<'_, T> {
        SliceIter { slice: value, position: 0 }
    }

    pub fn lower_bound(value: Slice<T>, needle: &T) -> usize
        where T: Ord {
        slice_lower_bound_from(value, needle, 0, value.length)
    }

    pub fn upper_bound(value: Slice<T>, needle: &T) -> usize
        where T: Ord {
        slice_upper_bound_from(value, needle, 0, value.length)
    }

    pub fn binary_search(value: Slice<T>, needle: &T) -> Result<usize, usize>
        where T: Ord {
        let index = Slice::lower_bound(value, needle);
        handle index < value.length {
            false => Result::Err(index),
            true => handle Ord::compare(
                Slice::get_unchecked(value, index),
                needle,
            ) {
                Ordering::Equal => Result::Ok(index),
                _ => Result::Err(index),
            },
        }
    }

    pub fn lex_compare(left: Slice<T>, right: Slice<T>) -> Ordering
        where T: Ord {
        slice_lex_compare_from(left, right, 0)
    }
}

impl<T> SliceIter<'_, T> {
    pub fn next(value: &mut Self) -> Option<&T> {
        handle value.position < value.slice.length {
            false => Result::Err(()),
            true => {
                let index = value.position;
                (*value).position = index + 1;
                Result::Ok(Slice::get_unchecked(Slice {
                    storage: value.slice.storage, length: value.slice.length,
                }, index))
            },
        }
    }
}
fn slice_lower_bound_from<T>(value: Slice<T>, needle: &T, start: usize, end: usize) -> usize
    where T: Ord {
    handle start < end {
        false => start,
        true => {
            let middle = start + ((end - start) / 2);
            let item = Slice::get_unchecked(value, middle);
            handle Ord::compare(item, needle) {
                Ordering::Less => slice_lower_bound_from(value, needle, middle + 1, end),
                _ => slice_lower_bound_from(value, needle, start, middle),
            }
        },
    }
}

fn slice_upper_bound_from<T>(value: Slice<T>, needle: &T, start: usize, end: usize) -> usize
    where T: Ord {
    handle start < end {
        false => start,
        true => {
            let middle = start + ((end - start) / 2);
            let item = Slice::get_unchecked(value, middle);
            handle Ord::compare(item, needle) {
                Ordering::Greater => slice_upper_bound_from(value, needle, start, middle),
                _ => slice_upper_bound_from(value, needle, middle + 1, end),
            }
        },
    }
}

fn slice_lex_compare_from<T>(left: Slice<T>, right: Slice<T>, index: usize) -> Ordering
    where T: Ord {
    handle index >= left.length {
        true => handle index >= right.length {
            true => Ordering::Equal,
            false => Ordering::Less,
        },
        false => handle index >= right.length {
            true => Ordering::Greater,
            false => handle Ord::compare(
                Slice::get_unchecked(left, index),
                Slice::get_unchecked(right, index),
            ) {
                Ordering::Equal => slice_lex_compare_from(left, right, index + 1),
                value => value,
            },
        },
    }
}

// Literal elaboration calls this ordinary standard-library wrapper after the
// compiler has emitted a sealed UTF-8 static-data handle. It is public only
// so the compiler can address the distributed package by its stable name;
// callers still cannot construct or name the handle type themselves.
fn __g1_wrap_static_str(value: __StaticData<Utf8Bytes>) -> Str<'static> {
    unsafe {
        Str<'static> {
            bytes: Slice<'static, u8> {
                storage: __g1_memory_borrow_shared(__g1_memory_cast_const<u8, ()>(__g1_memory_static_utf8_address(value))),
                length: __g1_static_len(value),
            },
        }
    }
}

// Raw-byte literals use the same public Slice representation as dynamic
// arrays.  The raw static tag is preserved by the private manifest leaf and
// never confers permission to construct a Str.
fn __g1_wrap_static_slice(value: __StaticData<u8>) -> Slice<'static, u8> {
    unsafe {
        Slice<'static, u8> {
            storage: __g1_memory_borrow_shared(__g1_memory_cast_const<u8, ()>(__g1_memory_static_bytes_address(value))),
            length: __g1_memory_static_bytes_len(value),
        }
    }
}

// `Str` is a library-facing borrowed UTF-8 view. Its hidden static backing is
// never exposed outside this package; these helpers are ordinary operations
// over the same private source-level slice used by dynamic strings.
pub enum StringRangeError { Reversed, OutOfBounds, NotCharBoundary }
pub struct Chars<'a> { private text: Str<'a>, private position: usize }

// Decode exactly one scalar. Every byte access is bounded before it occurs;
// minimum values reject overlong encodings and char_from_u32 rejects surrogates
// and values beyond Unicode's scalar range.
fn utf8_decode_tail(value: Slice<u8>, index: usize, remaining: usize, code: u32, minimum: u32, width: usize) -> Option<(char, usize)> {
    handle remaining {
        0 => handle code < minimum {
            true => None,
            false => handle char_from_u32(code) {
                Result::Ok(character) => Result::Ok((character, width)),
                Result::Err(_) => None,
            },
        },
        _ => {
            let byte = as<u32>(*Slice::get_unchecked(value, index));
            handle byte >= 128 {
                false => None,
                true => handle byte < 192 {
                    false => None,
                    true => utf8_decode_tail(value, index + 1, remaining - 1, code * 64 + byte - 128, minimum, width),
                },
            }
        },
    }
}
fn utf8_decode_width(value: Slice<u8>, index: usize, code: u32, minimum: u32, width: usize) -> Option<(char, usize)> {
    handle width <= value.length - index {
        false => None,
        true => utf8_decode_tail(value, index + 1, width - 1, code, minimum, width),
    }
}
fn utf8_decode_multibyte(value: Slice<u8>, index: usize, first: u32) -> Option<(char, usize)> {
    handle first < 194 {
        true => None,
        false => handle first < 224 {
            true => utf8_decode_width(value, index, first - 192, 128, 2),
            false => handle first < 240 {
                true => utf8_decode_width(value, index, first - 224, 2048, 3),
                false => handle first < 245 {
                    true => utf8_decode_width(value, index, first - 240, 65536, 4),
                    false => None,
                },
            },
        },
    }
}
fn utf8_decode(value: Slice<u8>, index: usize) -> Option<(char, usize)> {
    handle index < value.length {
        false => None,
        true => {
            let first = as<u32>(*Slice::get_unchecked(value, index));
            handle first < 128 {
                true => Result::Ok((__g1_char_from_u32_checked(first), 1)),
                // ASCII does not allocate the multibyte decoder's register
                // frame. The slow path retains every width/scalar check.
                false => utf8_decode_multibyte(value, index, first),
            }
        },
    }
}
fn utf8_valid_up_to(value: Slice<u8>, index: usize) -> usize {
    handle index < value.length {
        false => index,
        true => handle utf8_decode(value, index) {
            Result::Err(_) => index,
            Result::Ok((_, width)) => utf8_valid_up_to(value, index + width),
        },
    }
}

impl Str {
    pub fn len(value: Self) -> usize { value.bytes.length }

    pub fn is_empty(value: Self) -> Bool {
        handle Str::len(value) { 0 => true, _ => false }
    }

    // A UTF-8 continuation byte is never a character boundary. Index zero and
    // the exclusive end are boundaries by construction; an out-of-range offset
    // is not a boundary and is rejected by `Str::slice` before its result escapes.
    pub fn is_char_boundary(value: Self, index: usize) -> Bool {
        handle index > Str::len(value) {
            true => false,
            false => handle index {
                0 => true,
                _ => handle index == Str::len(value) {
                    true => true,
                    false => handle Slice::get(value.bytes, index) {
                        Result::Ok(byte) => handle *byte < 128 {
                            true => true,
                            false => handle *byte >= 192 {
                                true => true,
                                false => false,
                            },
                        },
                        Result::Err(_) => false,
                    },
                },
            },
        }
    }

    pub fn slice(value: Self, range: Range<usize>) -> Result<Self, StringRangeError> {
        handle range.start > range.end {
            true => Result::Err(StringRangeError::Reversed),
            false => handle range.end > Str::len(value) {
                true => Result::Err(StringRangeError::OutOfBounds),
                false => handle Str::is_char_boundary(value, range.start) {
                    false => Result::Err(StringRangeError::NotCharBoundary),
                    true => handle Str::is_char_boundary(value, range.end) {
                        false => Result::Err(StringRangeError::NotCharBoundary),
                        true => handle Slice::slice(value.bytes, range) {
                            Result::Ok(bytes) => Result::Ok(Str { bytes: bytes }),
                            Result::Err(_) => __g1_abort(),
                        },
                    },
                },
            },
        }
    }

    pub fn subslice(value: Self, start: usize, length: usize) -> Result<Self, StringRangeError> {
        // Check before forming `start + length`: otherwise a caller-supplied
        // oversized offset could overflow before the ordinary range validation
        // has a chance to return OutOfBounds.
        handle start > Str::len(value) {
            true => Result::Err(StringRangeError::OutOfBounds),
            false => handle length > Str::len(value) - start {
                true => Result::Err(StringRangeError::OutOfBounds),
                false => Str::slice(value, Range { start: start, end: start + length }),
            },
        }
    }

    // Byte-indexed scalar access for stepped UTF-8 consumers. The scalar is
    // owned: no borrowed substring or iterator escapes through the result.
    pub fn char_at(value: Self, index: usize) -> Result<char, StringRangeError> {
        handle index >= Str::len(value) {
            true => Result::Err(StringRangeError::OutOfBounds),
            false => handle Str::is_char_boundary(value, index) {
                false => Result::Err(StringRangeError::NotCharBoundary),
                true => handle utf8_decode(value.bytes, index) {
                    Result::Err(_) => Result::Err(StringRangeError::OutOfBounds),
                    Result::Ok((character, _)) => Result::Ok(character),
                },
            },
        }
    }

    pub fn chars(value: Self) -> Chars { Chars { text: value, position: 0 } }

    pub fn to_string(source: Self) -> String {
        let value = String::new();
        String::push_str(&mut value, source);
        value
    }
}

impl<'a> Str<'a> {
    pub fn as_bytes(value: Self) -> Slice<'a, u8> {
        value.bytes
    }
}

impl Chars {
    pub fn next(value: &mut Self) -> Option<char> {
        handle utf8_decode(value.text.bytes, value.position) {
            Result::Err(_) => Result::Err(()),
            Result::Ok((character, width)) => {
                (*value).position = (*value).position + width;
                Result::Ok(character)
            },
        }
    }
}
// An intentional API synonym, not a separate implementation name.
pub let Str::len_bytes = Str::len;

// The allocation, initialized prefix and capacity policy are all source-owned.
// Pointer copies do not copy ownership. The two zero-sized markers make an
// owner nonduplicable and retain the quantity of its logical T residents.
struct VecOwner {}
impl Use<[0, 1]> for VecOwner {}
pub struct Vec<T> {
    private pointer: *mut T,
    private length: usize,
    private capacity: usize,
    private ownership: PhantomData<T>,
    private unique: VecOwner,
}

impl<T> Drop for Vec<T> where T: Use<[0, 1]> {
    drop(&mut self) -> {
        // Remove each resident from the initialized prefix before invoking
        // its ordinary source destruction. The allocation remains live until
        // the final resident and all of its owned fields have been destroyed.
        Vec::clear(&mut *self);
        unsafe {
            __g1_memory_deallocate(__g1_memory_cast<T, u8>(self.pointer),
                self.capacity * __g1_memory_size_of<T>(), __g1_memory_align_of<T>());
        }
    }
}

// The caller withdraws this entire initialized suffix from its Vec first.
// Visit the upper half before the lower half to preserve reverse destruction
// order with logarithmic ordinary call depth. Bounded leaf chunks amortize
// range-dispatch frames without depending on ordinary tail-call recycling.
// No intermediate Vec or Option owner is manufactured for these residents.
unsafe fn vec_drop_range<T>(pointer: *mut T, length: usize) -> ()
    where T: Use<[0, 1]> {
    handle length <= 8 {
        true => unsafe { vec_drop_chunk(pointer, length) },
        false => {
            let half = length / 2;
            unsafe {
                vec_drop_range(__g1_memory_offset(pointer, half), length - half);
                vec_drop_range(pointer, half)
            }
        },
    }
}
// Called only for one through eight initialized residents. Even the ordinary
// non-recycling interpreter therefore needs a fixed, small leaf stack.
// Stop after the first resident instead of making an empty recursive call.
unsafe fn vec_drop_chunk<T>(pointer: *mut T, length: usize) -> ()
    where T: Use<[0, 1]> {
    let last = length - 1;
    unsafe {
        discard(__g1_memory_read(__g1_memory_as_const(__g1_memory_offset(pointer, last))));
    };
    handle last {
        0 => (),
        _ => unsafe { vec_drop_chunk(pointer, last) },
    }
}

// Unkeyed BLAKE3-256, implemented entirely by ordinary source functions.
// Compression, chunk flags, tree shape and byte order follow the BLAKE3
// specification/reference: https://github.com/BLAKE3-team/BLAKE3/tree/master/reference_impl
// The borrowed input is never copied into an intermediate collection. Tree
// recursion is logarithmic; a leaf processes at most sixteen 64-byte blocks.
pub fn blake3(input: Slice<u8>) -> Vec<u8> {
    let digest = blake3_tree(input, 0, input.length, true);
    let output = Vec<u8>::with_capacity(32);
    // The complete result extent is reserved once; publish initialization only
    // after every byte has been written. No native-endian u32 stores are used.
    unsafe {
        blake3_write_word(output.pointer, 0, digest.a);
        blake3_write_word(output.pointer, 4, digest.b);
        blake3_write_word(output.pointer, 8, digest.c);
        blake3_write_word(output.pointer, 12, digest.d);
        blake3_write_word(output.pointer, 16, digest.e);
        blake3_write_word(output.pointer, 20, digest.f);
        blake3_write_word(output.pointer, 24, digest.g);
        blake3_write_word(output.pointer, 28, digest.h);
    };
    output.length = as<usize>(32);
    output
}
struct Blake3Cv { a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32 }
struct Blake3Words {
    a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32,
    i: u32, j: u32, k: u32, l: u32, m: u32, n: u32, o: u32, p: u32,
}
fn blake3_iv() -> Blake3Cv {
    Blake3Cv { a: 1779033703, b: 3144134277, c: 1013904242, d: 2773480762,
        e: 1359893119, f: 2600822924, g: 528734635, h: 1541459225 }
}
fn blake3_rotate(value: u32, shift: u32) -> u32 {
    __g1_int_bit_or(__g1_int_shr(value, shift), __g1_int_shl(value, __g1_int_wrapping_sub<u32>(32, shift)))
}
fn blake3_mix(a: &mut u32, b: &mut u32, c: &mut u32, d: &mut u32, x: u32, y: u32) -> () {
    *a = __g1_int_wrapping_add(__g1_int_wrapping_add(*a, *b), x);
    *d = blake3_rotate(__g1_int_bit_xor(*d, *a), 16);
    *c = __g1_int_wrapping_add(*c, *d);
    *b = blake3_rotate(__g1_int_bit_xor(*b, *c), 12);
    *a = __g1_int_wrapping_add(__g1_int_wrapping_add(*a, *b), y);
    *d = blake3_rotate(__g1_int_bit_xor(*d, *a), 8);
    *c = __g1_int_wrapping_add(*c, *d);
    *b = blake3_rotate(__g1_int_bit_xor(*b, *c), 7);
}
fn blake3_permute(m: Blake3Words) -> Blake3Words {
    Blake3Words { a: m.c, b: m.g, c: m.d, d: m.k, e: m.h, f: m.a, g: m.e, h: m.n,
        i: m.b, j: m.l, k: m.m, l: m.f, m: m.j, n: m.o, o: m.p, p: m.i }
}
fn blake3_rounds(s: &mut Blake3Words, m: Blake3Words, remaining: usize) -> () {
    blake3_mix(&mut s.a, &mut s.e, &mut s.i, &mut s.m, m.a, m.b);
    blake3_mix(&mut s.b, &mut s.f, &mut s.j, &mut s.n, m.c, m.d);
    blake3_mix(&mut s.c, &mut s.g, &mut s.k, &mut s.o, m.e, m.f);
    blake3_mix(&mut s.d, &mut s.h, &mut s.l, &mut s.p, m.g, m.h);
    blake3_mix(&mut s.a, &mut s.f, &mut s.k, &mut s.p, m.i, m.j);
    blake3_mix(&mut s.b, &mut s.g, &mut s.l, &mut s.m, m.k, m.l);
    blake3_mix(&mut s.c, &mut s.h, &mut s.i, &mut s.n, m.m, m.n);
    blake3_mix(&mut s.d, &mut s.e, &mut s.j, &mut s.o, m.o, m.p);
    handle remaining == 1 {
        true => (),
        false => blake3_rounds(s, blake3_permute(m), remaining - 1),
    }
}
fn blake3_compress(cv: Blake3Cv, block: Blake3Words, counter: u64, length: u32, flags: u32) -> Blake3Cv {
    let state = Blake3Words {
        a: cv.a, b: cv.b, c: cv.c, d: cv.d, e: cv.e, f: cv.f, g: cv.g, h: cv.h,
        i: 1779033703, j: 3144134277, k: 1013904242, l: 2773480762,
        m: __g1_int_convert_wrapping_to_u32(counter),
        n: __g1_int_convert_wrapping_to_u32(__g1_int_shr(counter, 32)), o: length, p: flags,
    };
    blake3_rounds(&mut state, block, 7);
    // Both a chaining value and the first 32 root-output bytes use this half.
    Blake3Cv {
        a: __g1_int_bit_xor(state.a, state.i), b: __g1_int_bit_xor(state.b, state.j),
        c: __g1_int_bit_xor(state.c, state.k), d: __g1_int_bit_xor(state.d, state.l),
        e: __g1_int_bit_xor(state.e, state.m), f: __g1_int_bit_xor(state.f, state.n),
        g: __g1_int_bit_xor(state.g, state.o), h: __g1_int_bit_xor(state.h, state.p),
    }
}
fn blake3_byte(input: Slice<u8>, index: usize, end: usize) -> u32 {
    handle index < end {
        false => 0,
        true => unsafe {
            // end belongs to the current block and never exceeds input.length.
            __g1_int_convert_wrapping_to_u32(__g1_memory_read(__g1_memory_offset_const(
                __g1_memory_cast_const<(), u8>(__g1_memory_as_raw_shared(input.storage)), index)))
        },
    }
}
fn blake3_word(input: Slice<u8>, index: usize, end: usize) -> u32 {
    __g1_int_bit_or(
        __g1_int_bit_or(blake3_byte(input, index, end), __g1_int_shl(blake3_byte(input, index + 1, end), 8)),
        __g1_int_bit_or(__g1_int_shl(blake3_byte(input, index + 2, end), 16), __g1_int_shl(blake3_byte(input, index + 3, end), 24)))
}
fn blake3_block(input: Slice<u8>, start: usize, length: usize) -> Blake3Words {
    let end = start + length;
    Blake3Words {
        a: blake3_word(input, start, end), b: blake3_word(input, start + 4, end),
        c: blake3_word(input, start + 8, end), d: blake3_word(input, start + 12, end),
        e: blake3_word(input, start + 16, end), f: blake3_word(input, start + 20, end),
        g: blake3_word(input, start + 24, end), h: blake3_word(input, start + 28, end),
        i: blake3_word(input, start + 32, end), j: blake3_word(input, start + 36, end),
        k: blake3_word(input, start + 40, end), l: blake3_word(input, start + 44, end),
        m: blake3_word(input, start + 48, end), n: blake3_word(input, start + 52, end),
        o: blake3_word(input, start + 56, end), p: blake3_word(input, start + 60, end),
    }
}
fn blake3_chunk(input: Slice<u8>, start: usize, length: usize, offset: usize, cv: Blake3Cv, root: Bool) -> Blake3Cv {
    let remaining = length - offset;
    let first = handle offset == 0 { true => as<u32>(1), false => as<u32>(0) };
    handle remaining <= 64 {
        true => {
            let flags = __g1_int_bit_or(first, handle root { true => as<u32>(10), false => as<u32>(2) });
            blake3_compress(cv, blake3_block(input, start + offset, remaining),
                __g1_int_convert_wrapping_to_u64(start / 1024), __g1_int_convert_wrapping_to_u32(remaining), flags)
        },
        false => {
            let next = blake3_compress(cv, blake3_block(input, start + offset, 64),
                __g1_int_convert_wrapping_to_u64(start / 1024), 64, first);
            blake3_chunk(input, start, length, offset + 64, next, root)
        },
    }
}
// Largest power-of-two chunk extent strictly below length. The comparison
// proves doubling is within length, so even a maximal input cannot overflow.
fn blake3_left_extent(length: usize, extent: usize) -> usize {
    handle extent < length - extent {
        true => blake3_left_extent(length, extent * 2),
        false => extent,
    }
}
fn blake3_tree(input: Slice<u8>, start: usize, length: usize, root: Bool) -> Blake3Cv {
    handle length <= 1024 {
        true => blake3_chunk(input, start, length, 0, blake3_iv(), root),
        false => {
            let left_length = blake3_left_extent(length, 1024);
            let left = blake3_tree(input, start, left_length, false);
            let right = blake3_tree(input, start + left_length, length - left_length, false);
            let block = Blake3Words {
                a: left.a, b: left.b, c: left.c, d: left.d, e: left.e, f: left.f, g: left.g, h: left.h,
                i: right.a, j: right.b, k: right.c, l: right.d, m: right.e, n: right.f, o: right.g, p: right.h,
            };
            blake3_compress(blake3_iv(), block, 0, 64, handle root { true => as<u32>(12), false => as<u32>(4) })
        },
    }
}
// Safety: output is the freshly reserved 32-byte result, and offset is one
// of 0,4,...,28. Every write initializes one distinct in-bounds byte.
unsafe fn blake3_write_word(output: *mut u8, offset: usize, word: u32) -> () {
    unsafe {
        __g1_memory_write(__g1_memory_offset(output, offset), __g1_int_convert_wrapping_to_u8(word));
        __g1_memory_write(__g1_memory_offset(output, offset + 1), __g1_int_convert_wrapping_to_u8(__g1_int_shr(word, 8)));
        __g1_memory_write(__g1_memory_offset(output, offset + 2), __g1_int_convert_wrapping_to_u8(__g1_int_shr(word, 16)));
        __g1_memory_write(__g1_memory_offset(output, offset + 3), __g1_int_convert_wrapping_to_u8(__g1_int_shr(word, 24)))
    }
}

// All extent checks precede mutation; a rejected fixed-width write leaves
// the buffer unchanged. Allocation policy is separate from byte encoding.
pub struct ByteBuf { private bytes: Vec<u8>, private limit: usize }
pub enum ByteError { Limit, Truncated }

impl ByteBuf {
    pub fn new(limit: usize) -> Self {
        ByteBuf { bytes: Vec::new(), limit: limit }
    }

    pub fn len(buffer: &Self) -> usize { Vec::len(&buffer.bytes) }

    pub fn view(buffer: &Self) -> Slice<u8> { Vec::as_slice(&buffer.bytes) }

    pub fn finish(buffer: Self) -> Vec<u8> { move buffer.bytes }

    pub fn push(buffer: &mut Self, value: u8) -> Result<(), ByteError> {
        handle Vec::len(&buffer.bytes) < buffer.limit {
            true => { Vec::push(&mut buffer.bytes, value); Result::Ok(()) },
            false => Result::Err(ByteError::Limit),
        }
    }

    pub fn put_u64(buffer: &mut Self, word: u64) -> Result<(), ByteError> {
        handle byte_buf_has_room(& *buffer, 8) {
            true => { byte_buf_push_word(&mut buffer.bytes, word); Result::Ok(()) },
            false => Result::Err(ByteError::Limit),
        }
    }

    pub fn append(buffer: &mut Self, bytes: Slice<u8>) -> Result<(), ByteError> {
        handle byte_buf_has_room(& *buffer, Slice::len(&bytes)) {
            true => { Vec::extend_from_slice(&mut buffer.bytes, bytes); Result::Ok(()) },
            false => Result::Err(ByteError::Limit),
        }
    }

    pub fn patch(buffer: &mut Self, offset: usize, value: u8) -> Result<(), ByteError> {
        handle Vec::get_mut(&mut buffer.bytes, offset) {
            Result::Ok(byte) => { *byte = value; Result::Ok(()) },
            Result::Err(_) => Result::Err(ByteError::Truncated),
        }
    }
}

fn byte_buf_has_room(buffer: &ByteBuf, width: usize) -> Bool {
    let length = Vec::len(&buffer.bytes);
    handle length <= buffer.limit {
        false => false,
        true => width <= buffer.limit - length,
    }
}
fn byte_buf_push_word(bytes: &mut Vec<u8>, word: u64) -> () {
    Vec::push(&mut *bytes, __g1_int_convert_wrapping_to_u8(word));
    Vec::push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 8)));
    Vec::push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 16)));
    Vec::push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 24)));
    Vec::push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 32)));
    Vec::push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 40)));
    Vec::push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 48)));
    Vec::push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 56)))
}

// A cursor owns positions, not a borrowed view. Callers lend the immutable
// input for each operation, so a suspended work frame need not retain a loan.
pub struct ByteCursor { private position: usize }
impl ByteCursor {
    pub fn new() -> Self {
        ByteCursor { position: 0 }
    }

    pub fn position(cursor: &Self) -> usize { cursor.position }

    pub fn u8(cursor: &mut Self, bytes: Slice<u8>) -> Result<u8, ByteError> {
        handle byte_cursor_has(& *cursor, bytes, 1) {
            false => Result::Err(ByteError::Truncated),
            true => {
                let value = *Slice::get_unchecked(bytes, cursor.position);
                (*cursor).position = cursor.position + 1;
                Result::Ok(value)
            },
        }
    }

    pub fn u64(cursor: &mut Self, bytes: Slice<u8>) -> Result<u64, ByteError> {
        handle byte_cursor_has(& *cursor, bytes, 8) {
            false => Result::Err(ByteError::Truncated),
            true => {
                // The complete eight-byte extent was checked once above.
                let value = unsafe {
                    let pointer = __g1_memory_offset_const(
                        __g1_memory_cast_const<(), u8>(__g1_memory_as_raw_shared(bytes.storage)), cursor.position,
                    );
                    byte_cursor_word(pointer, 0, 0)
                };
                (*cursor).position = cursor.position + 8;
                Result::Ok(value)
            },
        }
    }
}

fn byte_cursor_has(cursor: &ByteCursor, bytes: Slice<u8>, width: usize) -> Bool {
    let length = Slice::len(&bytes);
    let position = cursor.position;
    handle position <= length {
        false => false,
        true => width <= length - position,
    }
}

// Safety: pointer starts an eight-byte extent inside the live borrowed window.
// The public caller proves this before entering with shift=0 and value=0, and
// advances the cursor only on success. Each recursive call consumes one byte;
// shift is 0,8,..,56 and no pointer beyond the checked extent is constructed.
// Read u8 residents, not an unaligned/endian-dependent native u64.
unsafe fn byte_cursor_word(pointer: *const u8, shift: u32, value: u64) -> u64 {
    let next = unsafe {
        __g1_int_bit_or(value, __g1_int_shl(__g1_int_convert_checked_to_u64(__g1_memory_read(pointer)), shift))
    };
    handle shift == 56 {
        true => next,
        false => unsafe { byte_cursor_word(__g1_memory_offset_const(pointer, 1), shift + 8, next) },
    }
}

pub struct VecIntoIter<T> { private remaining: Vec<T> }

impl<T> Vec<T> {
    pub fn new() -> Self {
        unsafe {
            Vec {
                pointer: __g1_memory_dangling(),
                length: 0,
                capacity: handle __g1_memory_size_of<T>() { 0 => 18446744073709551615, _ => 0 },
                ownership: PhantomData {},
                unique: VecOwner {},
            }
        }
    }

    pub fn with_capacity(capacity: usize) -> Self {
        let value = Vec::new();
        Vec::reserve(&mut value, capacity);
        value
    }

    pub fn len(value: &Self) -> usize { value.length }

    pub fn capacity(value: &Self) -> usize { value.capacity }

    pub fn reserve(value: &mut Self, additional: usize) -> () {
        let required = value.length + additional;
        handle required > value.capacity {
            false => (),
            true => Vec::grow(value, required),
        }
    }

    // Keep the common capacity check small. Concrete bytecode allocates a
    // function's register frame at entry, so the growth-only layout and
    // allocator temporaries must not be materialized by every push/append.
    fn grow(value: &mut Self, required: usize) -> () {
        let size = __g1_memory_size_of<T>();
        let maximum = 9223372036854775807 / size;
        handle required > maximum {
            true => __g1_abort(),
            false => {
                let doubled = handle value.capacity > maximum / 2 {
                    true => maximum,
                    false => handle value.capacity { 0 => as<usize>(4), _ => value.capacity * 2 },
                };
                let capacity = handle doubled < required { true => required, false => doubled };
                unsafe {
                    let pointer = __g1_memory_reallocate(
                        __g1_memory_cast<T, u8>(value.pointer), value.capacity * size,
                        __g1_memory_align_of<T>(), capacity * size,
                    );
                    let typed = __g1_memory_cast<u8, T>(pointer);
                    handle __g1_memory_is_null(pointer) {
                        0 => {
                            (*value).pointer = typed;
                            (*value).capacity = capacity;
                        },
                        _ => __g1_abort(),
                    }
                }
            },
        }
    }

    pub fn push(value: &mut Self, item: T) -> () {
        Vec::reserve(&mut *value, 1);
        unsafe { __g1_memory_write(__g1_memory_offset(value.pointer, value.length), item); };
        (*value).length = value.length + 1;
    }

    pub fn extend_from_slice(value: &mut Self, source: Slice<T>) -> ()
        where T: Use<[0, *]> {
        Vec::reserve(&mut *value, source.length);
        unsafe {
            __g1_memory_copy_nonoverlapping(
                __g1_memory_cast_const<(), T>(__g1_memory_as_raw_shared(source.storage)),
                __g1_memory_offset(value.pointer, value.length), source.length,
            );
        };
        (*value).length = value.length + source.length;
    }

    pub fn resize(value: &mut Self, length: usize, fill: T) -> ()
        where T: Use<[0, *]> {
        handle length < Vec::len(& *value) {
            true => Vec::truncate(&mut *value, length),
            false => vec_resize_grow(&mut *value, length, &fill),
        }
    }

    pub fn is_empty(value: &Self) -> Bool {
        handle Vec::len(value) { 0 => true, _ => false }
    }

    pub fn pop(value: &mut Self) -> Option<T> {
        let length = value.length;
        handle length {
            0 => Result::Err(()),
            _ => {
                (*value).length = length - 1;
                unsafe { Result::Ok(__g1_memory_read(__g1_memory_as_const(__g1_memory_offset(value.pointer, length - 1)))) }
            },
        }
    }

    pub fn get_unchecked<'a>(value: &'a Self, index: usize) -> &'a T {
        handle index < value.length {
            false => __g1_abort(),
            true => unsafe {
                __g1_memory_borrow_shared(__g1_memory_as_const(__g1_memory_offset(value.pointer, index)))
            },
        }
    }

    pub fn get<'a>(value: &'a Self, index: usize) -> Option<&'a T> {
        handle index < Vec::len(value) {
            true => Result::Ok(Vec::get_unchecked(value, index)),
            false => Result::Err(()),
        }
    }

    pub fn first<'a>(value: &'a Self) -> Option<&'a T> { Vec::get(value, 0) }

    pub fn last<'a>(value: &'a Self) -> Option<&'a T> {
        let length = Vec::len(value);
        handle length {
            0 => Result::Err(()),
            _ => Vec::get(value, length - 1),
        }
    }

    pub fn get_mut<'a>(value: &'a mut Self, index: usize) -> Option<&'a mut T> {
        let length = value.length;
        handle index < length {
            true => unsafe { Result::Ok(__g1_memory_borrow_unique(__g1_memory_offset(value.pointer, index))) },
            false => Result::Err(()),
        }
    }

    pub fn swap(value: &mut Self, left: usize, right: usize) -> () {
        handle left < value.length {
            false => __g1_abort(),
            true => handle right < value.length {
                false => __g1_abort(),
                true => handle left == right {
                    true => (),
                    false => unsafe {
                        let a = __g1_memory_offset(value.pointer, left);
                        let b = __g1_memory_offset(value.pointer, right);
                        let first = __g1_memory_read(__g1_memory_as_const(a));
                        let second = __g1_memory_read(__g1_memory_as_const(b));
                        __g1_memory_write(a, second);
                        __g1_memory_write(b, first)
                    },
                },
            },
        }
    }

    pub fn swap_remove(value: &mut Self, index: usize) -> Option<T> {
        let length = value.length;
        handle index < length {
            false => Result::Err(()),
            true => {
                let last = length - 1;
                Vec::swap(&mut *value, index, last);
                Vec::pop(&mut *value)
            },
        }
    }

    pub fn insert(value: &mut Self, index: usize, item: T) -> Option<()> {
        handle index <= value.length {
            true => {
                Vec::reserve(&mut *value, 1);
                unsafe {
                    let pointer = __g1_memory_offset(value.pointer, index);
                    __g1_memory_copy(__g1_memory_as_const(pointer), __g1_memory_offset(pointer, 1), value.length - index);
                    __g1_memory_write(pointer, item);
                };
                (*value).length = value.length + 1;
                Result::Ok(())
            },
            false => Result::Err(()),
        }
    }

    pub fn insert_from_slice(value: &mut Self, index: usize, source: Slice<T>) -> Option<()>
        where T: Use<[0, *]> {
        handle index <= value.length {
            false => Result::Err(()),
            true => {
                Vec::reserve(&mut *value, source.length);
                unsafe {
                    let pointer = __g1_memory_offset(value.pointer, index);
                    __g1_memory_copy(__g1_memory_as_const(pointer), __g1_memory_offset(pointer, source.length), value.length - index);
                    __g1_memory_copy_nonoverlapping(
                        __g1_memory_cast_const<(), T>(__g1_memory_as_raw_shared(source.storage)), pointer, source.length,
                    );
                };
                (*value).length = value.length + source.length;
                Result::Ok(())
            },
        }
    }

    pub fn remove(value: &mut Self, index: usize) -> Option<T> {
        handle index < value.length {
            true => unsafe {
                let pointer = __g1_memory_offset(value.pointer, index);
                let removed = __g1_memory_read(__g1_memory_as_const(pointer));
                (*value).length = value.length - 1;
                __g1_memory_copy(__g1_memory_as_const(__g1_memory_offset(pointer, 1)), pointer, value.length - index);
                Result::Ok(removed)
            },
            false => Result::Err(()),
        }
    }

    pub fn append(value: &mut Self, source: Self) -> () {
        Vec::reserve(&mut *value, source.length);
        unsafe {
            __g1_memory_copy_nonoverlapping(__g1_memory_as_const(source.pointer),
                __g1_memory_offset(value.pointer, value.length), source.length);
        };
        (*value).length = value.length + source.length;
        source.length = as<usize>(0);
        unsafe { vec_release_empty(source); }
    }

    pub fn truncate(value: &mut Self, length: usize) -> ()
        where T: Use<[0, 1]> {
        handle length < value.length {
            true => {
                let remaining = value.length - length;
                (*value).length = length;
                unsafe {
                    vec_drop_range(__g1_memory_offset(value.pointer, length), remaining)
                }
            },
            false => (),
        }
    }

    pub fn clear(value: &mut Self) -> ()
        where T: Use<[0, 1]> {
        Vec::truncate(&mut *value, 0)
    }

    pub fn reverse(value: &mut Self) -> () {
        let length = value.length;
        vec_reverse_from(&mut *value, 0, length)
    }

    pub fn split_off(value: &mut Self, index: usize) -> Option<Self> {
        handle index <= value.length {
            false => Result::Err(()),
            true => {
                let output = Vec<T>::with_capacity(value.length - index);
                unsafe {
                    __g1_memory_copy_nonoverlapping(__g1_memory_as_const(__g1_memory_offset(value.pointer, index)),
                        output.pointer, value.length - index);
                };
                output.length = value.length - index;
                (*value).length = index;
                Result::Ok(output)
            },
        }
    }

    // Draining transfers the selected residents into the existing owned iterator
    // representation. The suffix is moved out and restored, so no resident is
    // silently discarded and exact-linear elements remain valid.
    pub fn drain(value: &mut Self, range: Range<usize>) -> Option<VecIntoIter<T>> {
        handle range.start > range.end {
            true => Result::Err(()),
            false => handle range.end > value.length {
                true => Result::Err(()),
                false => {
                    handle Vec::split_off(&mut *value, range.end) {
                        Result::Err(_) => __g1_abort(),
                        Result::Ok(tail) => handle Vec::split_off(&mut *value, range.start) {
                            Result::Err(_) => __g1_abort(),
                            Result::Ok(drained) => {
                                Vec::append(value, tail);
                                Result::Ok(VecIntoIter { remaining: drained })
                            },
                        },
                    }
                },
            },
        }
    }

    pub fn sort_unstable(value: &mut Self) -> ()
        where T: Ord {
        vec_sort_unstable_from(&mut *value, 0)
    }

    pub fn sort_stable(value: &mut Self) -> ()
        where T: Ord {
        let scratch = Vec::with_capacity(Vec::len(& *value));
        vec_sort_stable_into_scratch(&mut *value, &mut scratch);
        Vec::append(&mut *value, scratch)
    }

    pub fn partition_by<F>(value: &mut Self, predicate: F) -> usize
        where F: Fn<(&T), Output = Bool>, F: Use<[0, *]> {
        let length = Vec::len(& *value);
        vec_partition_by_from(&mut *value, predicate, 0, length)
    }

    pub fn dedup(value: &mut Self) -> ()
        where T: Eq, T: Use<[0, 1]> {
        vec_dedup_from(&mut *value, 0)
    }

    pub fn as_slice<'a>(value: &'a Self) -> Slice<'a, T> {
        unsafe {
            Slice<'a, T> {
                storage: __g1_memory_borrow_shared(__g1_memory_cast_const<T, ()>(__g1_memory_as_const(value.pointer))),
                length: value.length,
            }
        }
    }

    pub fn as_mut_slice<'a>(value: &'a mut Self) -> SliceMut<'a, T> {
        unsafe {
            SliceMut<'a, T> {
                storage: __g1_memory_borrow_unique(__g1_memory_cast<T, ()>(value.pointer)),
                length: value.length,
            }
        }
    }

    pub fn iter(value: &Self) -> SliceIter<'_, T> { Slice::iter(Vec::as_slice(value)) }

    pub fn into_iter(value: Self) -> VecIntoIter<T> {
        VecIntoIter { remaining: value }
    }
}

// Growing duplicates the supplied fill value. Shrinking is also valid under
// this stronger bound because duplicable values may be discarded.
fn vec_resize_grow<T>(value: &mut Vec<T>, length: usize, fill: &T) -> ()
    where T: Use<[0, *]> {
    handle Vec::len(& *value) < length {
        false => (),
        true => {
            Vec::push(&mut *value, *fill);
            vec_resize_grow(&mut *value, length, fill)
        },
    }
}

// This deliberately remains a private leaf: `String` owns the UTF-8 policy,
// while `Vec<u8>` only supplies the backing storage.
fn vec_push_utf8_char(value: &mut Vec<u8>, character: char) -> () {
    let code = char_to_u32(character);
    handle code < 128 {
        true => Vec::push(&mut *value, as<u8>(code)),
        false => handle code < 2048 {
            true => {
                Vec::push(&mut *value, as<u8>(192 + code / 64));
                Vec::push(&mut *value, as<u8>(128 + code % 64))
            },
            false => handle code < 65536 {
                true => {
                    Vec::push(&mut *value, as<u8>(224 + code / 4096));
                    Vec::push(&mut *value, as<u8>(128 + (code / 64) % 64));
                    Vec::push(&mut *value, as<u8>(128 + code % 64))
                },
                false => {
                    Vec::push(&mut *value, as<u8>(240 + code / 262144));
                    Vec::push(&mut *value, as<u8>(128 + (code / 4096) % 64));
                    Vec::push(&mut *value, as<u8>(128 + (code / 64) % 64));
                    Vec::push(&mut *value, as<u8>(128 + code % 64))
                },
            },
        },
    }
}

fn vec_get_mut_unchecked<'a, T>(value: &'a mut Vec<T>, index: usize) -> &'a mut T {
    handle Vec::get_mut(value, index) { Result::Ok(item) => item, Result::Err(_) => __g1_abort() }
}

// Caller has moved every initialized resident elsewhere. Release the exact
// allocation and suppress this empty owner's hook without moving any field.
unsafe fn vec_release_empty<T>(value: Vec<T>) -> () {
    unsafe {
        __g1_memory_deallocate(__g1_memory_cast<T, u8>(value.pointer),
            value.capacity * __g1_memory_size_of<T>(), __g1_memory_align_of<T>());
        __g1_memory_forget(value)
    }
}
fn discard<T>(value: T) -> () where T: Use<[0, 1]> { () }

fn vec_reverse_from<T>(value: &mut Vec<T>, start: usize, end: usize) -> () {
    handle start < end {
        false => (),
        true => { Vec::swap(&mut *value, start, end - 1); vec_reverse_from(&mut *value, start + 1, end - 1) },
    }
}

fn vec_selection_min<T>(value: &Vec<T>, best: usize, index: usize) -> usize
    where T: Ord {
    handle index >= Vec::len(value) {
        true => best,
        false => handle Ord::compare(Vec::get_unchecked(value, index), Vec::get_unchecked(value, best)) {
            Ordering::Less => vec_selection_min(value, index, index + 1),
            _ => vec_selection_min(value, best, index + 1),
        },
    }
}
fn vec_sort_unstable_from<T>(value: &mut Vec<T>, index: usize) -> ()
    where T: Ord {
    handle index >= Vec::len(& *value) {
        true => (),
        false => {
            let smallest = vec_selection_min(& *value, index, index + 1);
            Vec::swap(&mut *value, index, smallest);
            vec_sort_unstable_from(&mut *value, index + 1)
        },
    }
}

// A stable sort owns one reusable scratch buffer. Removing the first minimum
// shifts later equal elements left, so equal values enter `scratch` in their
// original order. Every resident is moved exactly once into the buffer and
// once back, which also admits exact-linear element types.
fn vec_sort_stable_into_scratch<T>(value: &mut Vec<T>, scratch: &mut Vec<T>) -> ()
    where T: Ord {
    handle Vec::len(& *value) {
        0 => (),
        _ => {
            let smallest = vec_selection_min(& *value, 0, 1);
            handle Vec::remove(&mut *value, smallest) {
                Result::Err(_) => (),
                Result::Ok(item) => {
                    Vec::push(&mut *scratch, item);
                    vec_sort_stable_into_scratch(&mut *value, &mut *scratch)
                },
            }
        },
    }
}

// `partition_by` is deliberately in-place and makes no stability promise.
// The predicate is explicitly duplicable because it is evaluated once per
// examined resident; capture-free named functions and closures with
// duplicable captures satisfy that contract without a special VM callback
// type.
fn vec_partition_by_from<T, F>(value: &mut Vec<T>, predicate: F, left: usize, end: usize) -> usize
    where F: Fn<(&T), Output = Bool>, F: Use<[0, *]> {
    handle left >= end {
        true => left,
        false => handle predicate(Vec::get_unchecked(& *value, left)) {
            true => vec_partition_by_from(&mut *value, predicate, left + 1, end),
            false => {
                let last = end - 1;
                Vec::swap(&mut *value, left, last);
                vec_partition_by_from(&mut *value, predicate, left, last)
            },
        },
    }
}

fn vec_dedup_from<T>(value: &mut Vec<T>, index: usize) -> ()
    where T: Eq, T: Use<[0, 1]> {
    handle index + 1 >= Vec::len(& *value) {
        true => (),
        false => handle Eq::eq(
            Vec::get_unchecked(& *value, index),
            Vec::get_unchecked(& *value, index + 1),
        ) {
            true => handle Vec::remove(&mut *value, index + 1) {
                Result::Err(_) => (),
                Result::Ok(_) => vec_dedup_from(&mut *value, index),
            },
            false => vec_dedup_from(&mut *value, index + 1),
        },
    }
}

impl<T> VecIntoIter<T> {
    pub fn next(value: &mut Self) -> Option<T> {
        Vec::remove(&mut value.remaining, 0)
    }

    // An explicitly abandoned iterator has the same affine-erasure requirement
    // as `Vec::clear`; an exact-linear resident must be iterated to completion.
    pub fn discard(value: Self) -> ()
        where T: Use<[0, 1]> {
        Vec::clear(&mut value.remaining)
    }
}

// Open addressing is entirely library-owned. Buckets contain 0 for empty,
// 1 for deleted, or a dense entry index + 2. Cached hashes and reverse bucket
// positions are separate from residents: rehashing never copies a K or V,
// and swap-removal repairs exactly one relocated entry's bucket.
pub struct HashMap<K, V> {
    private entries: Vec<HashMapEntry<K, V>>,
    private indices: Vec<HashMapIndex>,
    private buckets: Vec<usize>,
    private deleted: usize,
}
pub struct HashMapEntry<K, V> { private key: K, private value: V }
struct HashMapIndex { fingerprint: usize, bucket: usize }

fn hash_key<K>(key: &K) -> usize
    where K: Hash {
    let state = Hasher::new();
    Hash::hash(key, &mut state);
    Hasher::finish(state)
}
fn hash_bucket(fingerprint: usize, capacity: usize) -> usize {
    bit_and(fingerprint, capacity - 1)
}
fn hash_bucket_set(buckets: &mut Vec<usize>, bucket: usize, slot: usize) -> () {
    *vec_get_mut_unchecked(buckets, bucket) = slot;
}
fn hash_map_matches<K, V>(value: &HashMap<K, V>, key: &K, fingerprint: usize, slot: usize) -> Bool
    where K: Eq {
    handle slot < 2 {
        true => false,
        false => handle Vec::get_unchecked(&(*value).indices, slot - 2).fingerprint == fingerprint {
            false => false,
            true => Eq::eq(&Vec::get_unchecked(&(*value).entries, slot - 2).key, key),
        },
    }
}
fn hash_map_find_from<K, V>(value: &HashMap<K, V>, key: &K, fingerprint: usize, bucket: usize) -> Option<usize>
    where K: Eq {
    let slot = *Vec::get_unchecked(&(*value).buckets, bucket);
    handle slot == 0 {
        true => Result::Err(()),
        false => handle hash_map_matches(value, key, fingerprint, slot) {
            true => Result::Ok(slot - 2),
            false => hash_map_find_from(value, key, fingerprint, hash_bucket(bucket + 1, Vec::len(&(*value).buckets))),
        },
    }
}
fn hash_map_find_hashed<K, V>(value: &HashMap<K, V>, key: &K, fingerprint: usize) -> Option<usize>
    where K: Eq {
    handle Vec::len(&(*value).buckets) {
        0 => Result::Err(()),
        capacity => hash_map_find_from(value, key, fingerprint, hash_bucket(fingerprint, capacity)),
    }
}
fn hash_map_find<K, V>(value: &HashMap<K, V>, key: &K) -> Option<usize>
    where K: Eq, K: Hash {
    hash_map_find_hashed(value, key, hash_key(key))
}
// At most 7/8 of buckets are occupied or deleted, so every probe terminates
// at an empty bucket. Insertion may also reuse a deleted bucket, but only
// after the complete lookup has established that no equal resident exists.
fn hash_map_vacant(buckets: &Vec<usize>, bucket: usize) -> usize {
    handle *Vec::get_unchecked(buckets, bucket) < 2 {
        true => bucket,
        false => hash_map_vacant(buckets, hash_bucket(bucket + 1, Vec::len(buckets))),
    }
}
fn hash_map_reindex(buckets: &mut Vec<usize>, indices: &mut Vec<HashMapIndex>, index: usize) -> () {
    handle index < Vec::len(& *indices) {
        false => (),
        true => {
            let fingerprint = Vec::get_unchecked(& *indices, index).fingerprint;
            let bucket = hash_map_vacant(& *buckets, hash_bucket(fingerprint, Vec::len(& *buckets)));
            hash_bucket_set(&mut *buckets, bucket, index + 2);
            let entry = vec_get_mut_unchecked(&mut *indices, index);
            (*entry).bucket = bucket;
            hash_map_reindex(&mut *buckets, &mut *indices, index + 1)
        },
    }
}
fn hash_map_rehash<K, V>(value: &mut HashMap<K, V>, capacity: usize) -> () {
    let buckets = Vec<usize>::new();
    Vec::resize(&mut buckets, capacity, 0);
    hash_map_reindex(&mut buckets, &mut (*value).indices, 0);
    (*value).buckets = buckets;
    (*value).deleted = as<usize>(0);
}
fn hash_map_prepare_insert<K, V>(value: &mut HashMap<K, V>) -> () {
    let capacity = Vec::len(&(*value).buckets);
    handle capacity {
        0 => hash_map_rehash(&mut *value, 8),
        _ => handle Vec::len(&(*value).entries) + (*value).deleted >= capacity - bit_shr(capacity, 3) {
            false => (),
            true => handle Vec::len(&(*value).entries) < bit_shr(capacity, 1) {
                true => hash_map_rehash(&mut *value, capacity),
                // Overflow is a checked resource failure, never a wrapped
                // zero capacity that could make probing non-terminating.
                false => hash_map_rehash(&mut *value, capacity + capacity),
            },
        },
    }
}
fn hash_map_append<K, V>(value: &mut HashMap<K, V>, key: K, item: V, fingerprint: usize) -> () {
    hash_map_prepare_insert(&mut *value);
    let capacity = Vec::len(&(*value).buckets);
    let bucket = hash_map_vacant(&(*value).buckets, hash_bucket(fingerprint, capacity));
    handle *Vec::get_unchecked(&(*value).buckets, bucket) == 1 {
        false => (),
        true => { (*value).deleted = (*value).deleted - 1; },
    };
    let index = Vec::len(&(*value).entries);
    Vec::push(&mut (*value).entries, HashMapEntry { key: key, value: item });
    Vec::push(&mut (*value).indices, HashMapIndex { fingerprint: fingerprint, bucket: bucket });
    hash_bucket_set(&mut (*value).buckets, bucket, index + 2)
}
impl<K, V> HashMap<K, V> {
    pub fn new() -> Self {
        HashMap { entries: Vec::new(), indices: Vec::new(), buckets: Vec::new(), deleted: 0 }
    }

    pub fn len(value: &Self) -> usize { Vec::len(&(*value).entries) }

    pub fn is_empty(value: &Self) -> Bool { Vec::is_empty(&(*value).entries) }

    // Dense residents can be inspected without copying keys/values or probing
    // buckets. Their order is unspecified and may change after any mutation.
    // Only shared views are exposed: mutating a resident key would break the index.
    pub fn entries<'a>(value: &'a Self) -> Slice<'a, HashMapEntry<K, V>> {
        Vec::as_slice(&value.entries)
    }

    pub fn contains_key(value: &Self, key: &K) -> Bool
        where K: Eq, K: Hash {
        handle hash_map_find(value, key) {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    // The result is tied only to `value`; `key` is consulted during lookup and
    // cannot be the storage behind the returned reference. Its input lifetime is
    // therefore elided, while the output's provenance stays explicit.
    pub fn get<'a>(value: &'a Self, key: &K) -> Option<&'a V>
        where K: Eq, K: Hash {
        handle hash_map_find(value, key) {
            Result::Err(_) => Result::Err(()),
            Result::Ok(index) => {
                let entry = Vec::get_unchecked(&(*value).entries, index);
                Result::Ok(&(*entry).value)
            },
        }
    }

    pub fn get_mut<'a>(value: &'a mut Self, key: &K) -> Option<&'a mut V>
        where K: Eq, K: Hash {
        handle hash_map_find(& *value, key) {
            Result::Err(_) => Result::Err(()),
            Result::Ok(index) => {
                let entry = vec_get_mut_unchecked(&mut (*value).entries, index);
                Result::Ok(&mut (*entry).value)
            },
        }
    }

    pub fn insert(value: &mut Self, key: K, item: V) -> Option<V>
        where K: Eq, K: Hash, K: Use<[0, 1]> {
        let fingerprint = hash_key(&key);
        handle hash_map_find_hashed(& *value, &key, fingerprint) {
            Result::Err(_) => {
                hash_map_append(&mut *value, key, item, fingerprint);
                Result::Err(())
            },
            Result::Ok(index) => {
                let entry = vec_get_mut_unchecked(&mut (*value).entries, index);
                // Preserve the canonical resident key. Only the value changes;
                // discarding the equal incoming key needs the bound above.
                Result::Ok(replace(&mut (*entry).value, item))
            },
        }
    }

    pub fn remove(value: &mut Self, key: &K) -> Option<V>
        where K: Eq, K: Hash, K: Use<[0, 1]> {
        handle hash_map_remove_resident(value, key) {
            Result::Err(_) => Result::Err(()),
            Result::Ok(previous) => Result::Ok(previous.value),
        }
    }

    // Transfer both fields; neither key nor value needs erasure evidence.
    pub fn remove_entry(value: &mut Self, key: &K) -> Option<(K, V)>
        where K: Eq, K: Hash {
        handle hash_map_remove_resident(value, key) {
            Result::Err(_) => Result::Err(()),
            Result::Ok(previous) => Result::Ok((previous.key, previous.value)),
        }
    }
}

impl<K, V> HashMapEntry<K, V> {
    pub fn key<'a>(value: &'a Self) -> &'a K { &value.key }

    pub fn value<'a>(value: &'a Self) -> &'a V { &value.value }
}

fn hash_map_unindex<K, V>(value: &mut HashMap<K, V>, index: usize) -> () {
    let bucket = Vec::get_unchecked(&(*value).indices, index).bucket;
    hash_bucket_set(&mut (*value).buckets, bucket, 1);
    (*value).deleted = (*value).deleted + 1;
    Vec::swap_remove(&mut (*value).indices, index);
    handle index < Vec::len(&(*value).indices) {
        false => (),
        true => {
            let moved_bucket = Vec::get_unchecked(&(*value).indices, index).bucket;
            hash_bucket_set(&mut (*value).buckets, moved_bucket, index + 2)
        },
    }
}
fn hash_map_remove_resident<K, V>(value: &mut HashMap<K, V>, key: &K) -> Option<HashMapEntry<K, V>>
    where K: Eq, K: Hash {
    handle hash_map_find(& *value, key) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(index) => {
            hash_map_unindex(&mut *value, index);
            Vec::swap_remove(&mut (*value).entries, index)
        },
    }
}

// The set shares the map index while retaining the original resident on a
// duplicate insertion and returning ownership of that resident on removal.
pub struct HashSet<T> { private map: HashMap<T, ()> }
impl<T> HashSet<T> {
    pub fn new() -> Self { HashSet { map: HashMap::new() } }

    pub fn len(value: &Self) -> usize { HashMap::len(&(*value).map) }

    pub fn is_empty(value: &Self) -> Bool { HashMap::is_empty(&(*value).map) }

    pub fn contains(value: &Self, item: &T) -> Bool
        where T: Eq, T: Hash {
        HashMap::contains_key(&(*value).map, item)
    }

    // A duplicate consumes `item` without storing it, so affine-erasure evidence
    // is required. `true` means a new resident was inserted.
    pub fn insert(value: &mut Self, item: T) -> Bool
        where T: Eq, T: Hash, T: Use<[0, 1]> {
        let fingerprint = hash_key(&item);
        handle hash_map_find_hashed(&(*value).map, &item, fingerprint) {
            Result::Ok(_) => false,
            Result::Err(_) => {
                hash_map_append(&mut (*value).map, item, (), fingerprint);
                true
            },
        }
    }

    // Removal returns the resident, preserving its complete ownership contract.
    pub fn remove(value: &mut Self, item: &T) -> Option<T>
        where T: Eq, T: Hash {
        handle hash_map_remove_resident(&mut (*value).map, item) {
            Result::Err(_) => Result::Err(()),
            Result::Ok(entry) => Result::Ok(entry.key),
        }
    }
}

// Queue and compiler-work-list shapes are ordinary wrappers over `Vec`; no
// separate VM collection representation is needed.
pub struct VecDeque<T> { private storage: Vec<T> }
impl<T> VecDeque<T> {
    pub fn new() -> Self { VecDeque { storage: Vec::new() } }

    pub fn len(value: &Self) -> usize { Vec::len(&value.storage) }

    pub fn is_empty(value: &Self) -> Bool { Vec::is_empty(&value.storage) }

    pub fn push_back(value: &mut Self, item: T) -> () {
        Vec::push(&mut value.storage, item)
    }

    pub fn push_front(value: &mut Self, item: T) -> () {
        handle Vec::insert(&mut value.storage, 0, item) {
            Result::Ok(_) => (),
            Result::Err(_) => (),
        }
    }

    pub fn pop_back(value: &mut Self) -> Option<T> {
        Vec::pop(&mut value.storage)
    }

    pub fn pop_front(value: &mut Self) -> Option<T> {
        Vec::remove(&mut value.storage, 0)
    }

    pub fn front(value: &Self) -> Option<&T> { Vec::first(&value.storage) }

    pub fn back(value: &Self) -> Option<&T> { Vec::last(&value.storage) }
}

pub struct Stack<T> { private storage: Vec<T> }
impl<T> Stack<T> {
    pub fn new() -> Self { Stack { storage: Vec::new() } }

    pub fn len(value: &Self) -> usize { Vec::len(&value.storage) }

    pub fn is_empty(value: &Self) -> Bool { Vec::is_empty(&value.storage) }

    pub fn push(value: &mut Self, item: T) -> () { Vec::push(&mut value.storage, item) }

    pub fn pop(value: &mut Self) -> Option<T> { Vec::pop(&mut value.storage) }

    pub fn peek(value: &Self) -> Option<&T> { Vec::last(&value.storage) }
}

// WorkList is explicitly LIFO: it is the cheap deterministic building block
// needed by compiler passes that schedule newly discovered work.
pub struct WorkList<T> { private storage: Vec<T> }
impl<T> WorkList<T> {
    pub fn new() -> Self { WorkList { storage: Vec::new() } }

    pub fn len(value: &Self) -> usize { Vec::len(&value.storage) }

    pub fn is_empty(value: &Self) -> Bool { Vec::is_empty(&value.storage) }

    pub fn push(value: &mut Self, item: T) -> () { Vec::push(&mut value.storage, item) }

    pub fn pop(value: &mut Self) -> Option<T> { Vec::pop(&mut value.storage) }
}

// `String` owns an ordinary byte vector. Its constructors and mutators are
// responsible for the UTF-8 invariant; `Str` is the immutable borrowed view
// returned from that storage and never exposes mutable bytes.
pub struct String { private storage: Vec<u8> }
pub struct Utf8Error {
    private bytes: Vec<u8>,
    private valid_up_to: usize,
}

impl String {
    pub fn new() -> Self { String { storage: Vec::new() } }

    pub fn from_utf8(value: Vec<u8>) -> Result<Self, Utf8Error> {
        let valid_up_to = utf8_valid_up_to(Vec::as_slice(&value), 0);
        handle valid_up_to == Vec::len(&value) {
            true => Result::Ok(String { storage: value }),
            false => Result::Err(Utf8Error {
                bytes: value,
                valid_up_to: valid_up_to,
            }),
        }
    }

    pub fn len(value: &Self) -> usize { Vec::len(&value.storage) }

    pub fn is_empty(value: &Self) -> Bool {
        handle String::len(value) { 0 => true, _ => false }
    }

    pub fn push(value: &mut Self, character: char) -> () {
        vec_push_utf8_char(&mut value.storage, character)
    }

    pub fn push_str(value: &mut Self, source: Str) -> () {
        Vec::extend_from_slice(&mut value.storage, source.bytes)
    }

    pub fn insert(value: &mut Self, index: usize, source: Str) -> Result<(), StringRangeError> {
        handle Str::is_char_boundary(String::as_str(& *value), index) {
            false => Result::Err(StringRangeError::NotCharBoundary),
            true => handle Vec::insert_from_slice(&mut value.storage, index, source.bytes) {
                Result::Ok(_) => Result::Ok(()),
                Result::Err(_) => __g1_abort(),
            },
        }
    }

    pub fn pop(value: &mut Self) -> Option<char> {
        handle String::len(& *value) {
            0 => None,
            length => {
                let index = string_last_boundary(String::as_str(& *value), length - 1);
                handle String::remove(&mut *value, index) {
                    Result::Ok(character) => Result::Ok(character),
                    Result::Err(_) => __g1_abort(),
                }
            },
        }
    }

    pub fn remove(value: &mut Self, index: usize) -> Result<char, StringRangeError> {
        handle string_remove_character_info(&value.storage, index) {
            Result::Err(error) => Result::Err(error),
            Result::Ok((character, width)) => {
                unsafe {
                    let pointer = __g1_memory_offset(value.storage.pointer, index);
                    __g1_memory_copy(__g1_memory_as_const(__g1_memory_offset(pointer, width)), pointer,
                        value.storage.length - index - width);
                };
                (*value).storage.length = value.storage.length - width;
                Result::Ok(character)
            },
        }
    }

    pub fn as_str<'a>(value: &'a Self) -> Str<'a> {
        Str<'a> { bytes: Vec::as_slice(&value.storage) }
    }
}

fn string_last_boundary(value: Str, index: usize) -> usize {
    handle Str::is_char_boundary(value, index) {
        true => index,
        false => string_last_boundary(value, index - 1),
    }
}

fn string_remove_character_info(storage: &Vec<u8>, index: usize) -> Result<(char, usize), StringRangeError> {
    let view = Str { bytes: Vec::as_slice(storage) };
    handle index > Str::len(view) {
        true => Result::Err(StringRangeError::OutOfBounds),
        false => handle Str::is_char_boundary(view, index) {
            false => Result::Err(StringRangeError::NotCharBoundary),
            true => handle utf8_decode(view.bytes, index) {
                Result::Err(_) => Result::Err(StringRangeError::OutOfBounds),
                Result::Ok(info) => Result::Ok(info),
            },
        },
    }
}

impl Utf8Error {
    pub fn valid_up_to(value: &Self) -> usize { value.valid_up_to }

    pub fn into_bytes(value: Self) -> Vec<u8> { value.bytes }
}

pub fn identity<T>(value: T) -> T { value }

pub fn replace<T>(target: &mut T, incoming: T) -> T {
    let previous = move *target;
    *target = move incoming;
    previous
}

pub fn swap<T>(left: &mut T, right: &mut T) -> () {
    let left_value = move *left;
    let right_value = move *right;
    *left = move right_value;
    *right = move left_value;
}

pub trait Default { default() -> Self; }

// Explicit cloning constructs a new owner without granting more uses of the
// original. Scalar implementations copy; owning collections clone residents.
// There is no blanket implementation for every unrestricted T: it would
// overlap structural Clone implementations such as Result<A, E>.
pub trait Clone { clone(value: &Self) -> Self; }
pub impl Clone for () { clone(value: &()) -> () { *value } }
pub impl Clone for u8 { clone(value: &u8) -> u8 { *value } }
pub impl Clone for u16 { clone(value: &u16) -> u16 { *value } }
pub impl Clone for u32 { clone(value: &u32) -> u32 { *value } }
pub impl Clone for u64 { clone(value: &u64) -> u64 { *value } }
pub impl Clone for u128 { clone(value: &u128) -> u128 { *value } }
pub impl Clone for usize { clone(value: &usize) -> usize { *value } }
pub impl Clone for i8 { clone(value: &i8) -> i8 { *value } }
pub impl Clone for i16 { clone(value: &i16) -> i16 { *value } }
pub impl Clone for i32 { clone(value: &i32) -> i32 { *value } }
pub impl Clone for i64 { clone(value: &i64) -> i64 { *value } }
pub impl Clone for i128 { clone(value: &i128) -> i128 { *value } }
pub impl Clone for isize { clone(value: &isize) -> isize { *value } }
pub impl Clone for f32 { clone(value: &f32) -> f32 { *value } }
pub impl Clone for f64 { clone(value: &f64) -> f64 { *value } }
pub impl Clone for char { clone(value: &char) -> char { *value } }
fn vec_clone_from<T>(source: &Vec<T>, target: &mut Vec<T>, index: usize) -> () where T: Clone {
    handle index < Vec::len(source) {
        false => (),
        true => {
            Vec::push(&mut *target, Clone::clone(Vec::get_unchecked(source, index)));
            vec_clone_from(source, target, index + 1)
        },
    }
}
pub impl<T> Clone for Vec<T> where T: Clone {
    clone(value: &Vec<T>) -> Vec<T> {
        let result = Vec::with_capacity(Vec::len(value));
        vec_clone_from(value, &mut result, 0);
        result
    }
}
pub impl Clone for String {
    clone(value: &String) -> String {
        let storage = Vec::with_capacity(Vec::len(&value.storage));
        Vec::extend_from_slice(&mut storage, Vec::as_slice(&value.storage));
        String { storage: storage }
    }
}
pub impl<A, E> Clone for Result<A, E> where A: Clone, E: Clone {
    clone(value: &Result<A, E>) -> Result<A, E> {
        handle *value is Result::Ok(_) {
            true => Result::Ok(Clone::clone(&value.0)),
            false => Result::Err(Clone::clone(&value.0)),
        }
    }
}

// Explicit, possibly lossy conversion. Implementations have no outward
// effects and obey ordinary ownership rules; this trait grants no access to
// private representations. Input-domain failure belongs in a checked API.
pub trait As<T> { cast(value: Self) -> T; }
pub fn as<T, S>(value: S) -> T where S: As<T> { As<T>::cast(value) }

pub impl<T> As<T> for T { cast(value: T) -> T { value } }
pub impl As<u16> for u8 { cast(value: u8) -> u16 { __g1_int_convert_wrapping_to_u16(value) } }
