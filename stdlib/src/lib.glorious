pub fn stack_len<T>(value: &Stack<T>) -> usize { vec_len(&value.storage) }
pub fn stack_is_empty<T>(value: &Stack<T>) -> Bool { vec_is_empty(&value.storage) }
pub fn stack_push<T>(value: &mut Stack<T>, item: T) -> () { vec_push(&mut value.storage, item) }
pub fn stack_pop<T>(value: &mut Stack<T>) -> Option<T> { vec_pop(&mut value.storage) }
pub fn stack_peek<T>(value: &Stack<T>) -> Option<&T> { vec_last(&value.storage) }

pub let Stack::new = stack_new;
