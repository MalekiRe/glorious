pub fn default_value<T>() -> T where T: Default { Default::default() }

// Move the old occupant out while restoring a valid default before returning.
// This works for exact-linear values because it performs no implicit discard.
pub fn take<T>(target: &mut T) -> T where T: Default {
    replace(target, default_value())
}

pub impl Default for u8 { default() -> u8 { 0 } }
pub impl Default for u16 { default() -> u16 { 0 } }
pub impl Default for u32 { default() -> u32 { 0 } }
