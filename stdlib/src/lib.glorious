        true => 0,
        false => handle f64_le(value, 0.0) {
            true => 0,
            false => handle f64_ge(value, 4294967296.0) {
                true => 4294967295,
                false => __g1_f64_to_u32_checked(value),
            },
        },
    }
}
pub impl As<u32> for f32 { cast(value: f32) -> u32 { cast_f64_to_u32(__g1_f32_to_f64(value)) } }
pub impl As<u32> for f64 { cast(value: f64) -> u32 { cast_f64_to_u32(value) } }
fn cast_f64_to_u64(value: f64) -> u64 {
    handle f64_ne(value, value) {
        true => 0,
        false => handle f64_le(value, 0.0) {
            true => 0,
            false => handle f64_ge(value, 18446744073709551616.0) {
                true => 18446744073709551615,
                false => __g1_f64_to_u64_checked(value),
