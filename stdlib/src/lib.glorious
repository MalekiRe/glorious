// Integer overflow policy is an ordinary library choice.  The operators keep
// their checked VM semantics; callers that explicitly want modular arithmetic
// cross this small source-level API instead.  These leaves remain generic so
// every frozen integer scalar uses its own width and signedness in the VM.
pub fn wrapping_add<T>(left: T, right: T) -> T {
    __g1_int_wrapping_add(left, right)
}
pub fn wrapping_sub<T>(left: T, right: T) -> T {
    __g1_int_wrapping_sub(left, right)
}
pub fn wrapping_mul<T>(left: T, right: T) -> T {
    __g1_int_wrapping_mul(left, right)
}

// Integer bit operations are ordinary source wrappers. Their private leaves
// retain the representation-specific VM work, while public names never gain
// authority merely by matching an opcode spelling. Shift counts use the
// stable `u32` count ABI for every integer width.
pub fn bit_and<T>(left: T, right: T) -> T { __g1_int_bit_and(left, right) }
pub fn bit_or<T>(left: T, right: T) -> T { __g1_int_bit_or(left, right) }
pub fn bit_xor<T>(left: T, right: T) -> T { __g1_int_bit_xor(left, right) }
pub fn bit_not<T>(value: T) -> T { __g1_int_bit_not(value) }
pub fn bit_shl<T>(value: T, count: u32) -> T { __g1_int_shl(value, count) }
pub fn bit_shr<T>(value: T, count: u32) -> T { __g1_int_shr(value, count) }

// The VM leaf performs the final IEEE-754 checked conversion.  Source owns
// the public failure policy: NaN and values outside the half-open i64 range
// become None rather than execution failures.
pub fn f64_to_i64_checked(value: f64) -> Option<i64> {
    handle __g1_f64_ne(value, value) != 0 {
        true => None,
        false => handle __g1_f64_lt(value, -9223372036854775808.0) != 0 {
            true => None,
            false => handle __g1_f64_ge(value, 9223372036854775808.0) != 0 {
                true => None,
                false => Result::Ok(__g1_f64_to_i64_checked(value)),
            },
        },
    }
}
pub fn i64_to_f32(value: i64) -> f32 { __g1_i64_to_f32(value) }
pub fn f32_add(left: f32, right: f32) -> f32 { __g1_f32_add(left, right) }
pub fn f32_sub(left: f32, right: f32) -> f32 { __g1_f32_sub(left, right) }
pub fn f32_mul(left: f32, right: f32) -> f32 { __g1_f32_mul(left, right) }
pub fn f32_div(left: f32, right: f32) -> f32 { __g1_f32_div(left, right) }
pub fn f32_rem(left: f32, right: f32) -> f32 { __g1_f32_rem(left, right) }
pub fn f32_eq(left: f32, right: f32) -> Bool { __g1_f32_eq(left, right) != 0 }
pub fn f32_ne(left: f32, right: f32) -> Bool { __g1_f32_ne(left, right) != 0 }
pub fn f32_lt(left: f32, right: f32) -> Bool { __g1_f32_lt(left, right) != 0 }
pub fn f32_le(left: f32, right: f32) -> Bool { __g1_f32_le(left, right) != 0 }
pub fn f32_gt(left: f32, right: f32) -> Bool { __g1_f32_gt(left, right) != 0 }
pub fn f32_ge(left: f32, right: f32) -> Bool { __g1_f32_ge(left, right) != 0 }
pub fn f64_add(left: f64, right: f64) -> f64 { __g1_f64_add(left, right) }
pub fn f64_sub(left: f64, right: f64) -> f64 { __g1_f64_sub(left, right) }
pub fn f64_mul(left: f64, right: f64) -> f64 { __g1_f64_mul(left, right) }
pub fn f64_div(left: f64, right: f64) -> f64 { __g1_f64_div(left, right) }
pub fn f64_rem(left: f64, right: f64) -> f64 { __g1_f64_rem(left, right) }
pub fn f64_eq(left: f64, right: f64) -> Bool { __g1_f64_eq(left, right) != 0 }
pub fn f64_ne(left: f64, right: f64) -> Bool { __g1_f64_ne(left, right) != 0 }
pub fn f64_lt(left: f64, right: f64) -> Bool { __g1_f64_lt(left, right) != 0 }
pub fn f64_le(left: f64, right: f64) -> Bool { __g1_f64_le(left, right) != 0 }
pub fn f64_gt(left: f64, right: f64) -> Bool { __g1_f64_gt(left, right) != 0 }
pub fn f64_ge(left: f64, right: f64) -> Bool { __g1_f64_ge(left, right) != 0 }
pub fn f32_to_i64_checked(value: f32) -> Option<i64> {
    handle __g1_f32_ne(value, value) != 0 {
        true => None,
        false => handle __g1_f32_lt(value, __g1_f32_from_bits(3741319168)) != 0 {
            true => None,
            false => handle __g1_f32_ge(value, __g1_f32_from_bits(1593835520)) != 0 {
                true => None,
                false => Result::Ok(__g1_f32_to_i64_checked(value)),
            },
        },
    }
}

// These are regular trait-based helpers, not scalar compiler operations.
// Choosing either value leaves the other unused, hence the explicit affine
// contract.  Duplicable scalars satisfy it automatically.
pub fn min<T>(left: T, right: T) -> T where T: Ord, T: Use<[0, 1]> {
    handle Ord::compare(&left, &right) {
        Ordering::Greater => right,
        _ => left,
    }
}
pub fn max<T>(left: T, right: T) -> T where T: Ord, T: Use<[0, 1]> {
    handle Ord::compare(&left, &right) {
        Ordering::Less => right,
        _ => left,
    }
}
pub fn clamp<T>(value: T, lower: T, upper: T) -> T
    where T: Ord, T: Use<[0, 1]> {
    handle Ord::compare(&value, &lower) {
        Ordering::Less => lower,
        _ => handle Ord::compare(&value, &upper) {
            Ordering::Greater => upper,
            _ => value,
        },
    }
}

impl<A, E> Result<A, E> {
    // Result/Option inspection discards the unselected payload, so both payloads
    // must permit affine erasure. `[0,0]` is intentionally not a public bound.
    pub fn is_ok(value: Self) -> Bool
        where A: Use<[0, 1]>, E: Use<[0, 1]> {
        handle value {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    pub fn is_err(value: Self) -> Bool
        where A: Use<[0, 1]>, E: Use<[0, 1]> {
        not(Result::is_ok(value))
    }

    pub fn map<B, F>(value: Self, transform: F) -> Result<B, E>
        where F: Fn<(A), Output = B> {
        handle value {
            Result::Ok(item) => Result::Ok(transform(item)),
            Result::Err(error) => Result::Err(error),
        }
    }

    pub fn map_err<E2, F>(value: Self, transform: F) -> Result<A, E2>
        where F: Fn<(E), Output = E2> {
        handle value {
            Result::Ok(item) => Result::Ok(item),
            Result::Err(error) => Result::Err(transform(error)),
        }
    }

    pub fn and_then<B, F>(value: Self, transform: F) -> Result<B, E>
        where F: Fn<(A), Output = Result<B, E>> {
        handle value {
            Result::Ok(item) => transform(item),
            Result::Err(error) => Result::Err(error),
        }
    }

    pub fn or_else<E2, F>(value: Self, transform: F) -> Result<A, E2>
        where F: Fn<(E), Output = Result<A, E2>> {
        handle value {
            Result::Ok(item) => Result::Ok(item),
            Result::Err(error) => transform(error),
        }
    }

    pub fn unwrap_or(value: Self, fallback: A) -> A
        where A: Use<[0, 1]>, E: Use<[0, 1]> {
        handle value {
            Result::Ok(item) => item,
            Result::Err(_) => fallback,
        }
    }

    pub fn as_ref<'a>(value: &'a Self) -> Result<&'a A, &'a E> {
        handle *value is Result::Ok(_) {
            true => Result::Ok(&value.0),
            false => Result::Err(&value.0),
        }
    }

    pub fn as_mut<'a>(value: &'a mut Self) -> Result<&'a mut A, &'a mut E> {
        handle *value is Result::Ok(_) {
            true => Result::Ok(&mut value.0),
            false => Result::Err(&mut value.0),
        }
    }
}

impl<T> Option<T> {
    // `Option` is the standard temporary slot. Moving its old representation out
    // before storing `None` transfers a present payload exactly once and leaves a
    // valid empty occupant regardless of whether `T` has a Default value.
    pub fn take(target: &mut Self) -> Self {
        let previous = move *target;
        *target = None;
        previous
    }

    // Replacing an optional resident returns the complete previous state. This is
    // the primitive ownership-preserving insertion operation; callers that only
    // need the old payload can inspect the resulting Option normally.
    pub fn insert(target: &mut Self, value: T) -> Self {
        let previous = move *target;
        *target = Some(value);
        previous
    }

    // `replace` is the same ownership-preserving transition as insertion; the
    // distinct spelling makes the returned previous option explicit at callsites.
    pub fn replace(target: &mut Self, value: T) -> Self {
        Option::insert(target, value)
    }

    // When already occupied, the supplied replacement is erased, so this uses
    // the public affine contract. The returned reference borrows the resident.
    pub fn get_or_insert<'a>(target: &'a mut Self, value: T) -> &'a mut T
        where T: Use<[0, 1]> {
        handle *target is Result::Ok(_) {
            true => &mut target.0,
            false => {
                *target = Some(value);
                &mut target.0
            },
        }
    }

    // These variants defer construction until the empty branch.  In particular,
    // no candidate T is constructed and then erased when the option is already
    // occupied.  The closure itself is affine because that occupied branch does
    // not invoke it.
    pub fn get_or_insert_with<'a, F>(target: &'a mut Self, make: F) -> &'a mut T
        where F: Fn<(), Output = T>, F: Use<[0, 1]> {
        handle *target is Result::Ok(_) {
            true => &mut target.0,
            false => {
                *target = Some(make());
                &mut target.0
            },
        }
    }

    // Default construction is deferred to the vacant branch just like the
    // closure-based variant.  Unlike `get_or_insert`, there is no supplied value
    // to erase on the occupied path, so `T` needs only its normal Default bound.
    pub fn get_or_insert_default<'a>(target: &'a mut Self) -> &'a mut T
        where T: Default {
        handle *target is Result::Ok(_) {
            true => &mut target.0,
            false => {
                *target = Some(default_value<T>());
                &mut target.0
            },
        }
    }
}

// Option is a transparent Result alias. These deliberately re-export the
// shared Result operations; Option's own slot operations live in its impl.
pub let Option::is_some = Result::is_ok;
pub let Option::is_none = Result::is_err;
pub let Option::map = Result::map;
pub let Option::and_then = Result::and_then;
pub let Option::or_else = Result::or_else;
pub let Option::unwrap_or = Result::unwrap_or;
pub let Option::as_ref = Result::as_ref;
pub let Option::as_mut = Result::as_mut;

// These fixities are declaration-owned, never compiler keywords.
pub infixr 1 else;
pub infixl 2 or;
pub infixl 3 and;
pub prefix 4 not;

// The right operands are zero-argument Fn values, so they are evaluated only
// on the selected path. Every discarded payload uses affine erasure.
pub fn if<A, E, B, F>(condition: Result<A, E>, body: F) -> Result<B, E>
    where F: Fn<(), Output = B>, A: Use<[0, 1]> {
    handle condition {
        Result::Ok(_) => Result::Ok(body()),
        Result::Err(error) => Result::Err(error),
    }
}

pub fn else<A, E, F>(value: Result<A, E>, fallback: F) -> A
    where F: Fn<(), Output = A>, E: Use<[0, 1]> {
    handle value {
        Result::Ok(item) => item,
        Result::Err(_) => fallback(),
    }
}

pub fn and<A, E, B, F>(value: Result<A, E>, next: F) -> Result<B, E>
    where F: Fn<(), Output = Result<B, E>>, A: Use<[0, 1]> {
    handle value {
        Result::Ok(_) => next(),
        Result::Err(error) => Result::Err(error),
    }
}

pub fn or<A, E, E2, F>(value: Result<A, E>, alternative: F) -> Result<A, E2>
    where F: Fn<(), Output = Result<A, E2>>, E: Use<[0, 1]> {
    handle value {
        Result::Ok(item) => Result::Ok(item),
        Result::Err(_) => alternative(),
    }
}

pub fn not<A, E>(value: Result<A, E>) -> Result<E, A> {
    handle value {
        Result::Ok(item) => Result::Err(item),
        Result::Err(error) => Result::Ok(error),
    }
}

// The control kernel is ordinary source code. `step` returns `Ok(next)` to
// continue or `Err(final)` to leave through the caller-provided label. This
// keeps the label in the traversal frame: a callback need not own the label
// merely to request an early exit, and the alternatives remain an explicit
// source-level result protocol.
fn fold_until_from<A, F, L>(index: usize, end: usize, accumulator: A, exit: L, step: F) -> A
    where F: Fn<(A, usize), Output = Result<A, A>>, F: Use<[0, *]>, L: Label<A> {
    handle index < end {
        false => accumulator,
        true => handle step(accumulator, index) {
            Result::Ok(next) => fold_until_from(index + 1, end, next, exit, step),
            Result::Err(final) => exit(final),
        },
    }
}
pub fn fold_until<A, F, L>(range: Range<usize>, accumulator: A, exit: L, step: F) -> A
    where F: Fn<(A, usize), Output = Result<A, A>>, F: Use<[0, *]>, L: Label<A> {
    fold_until_from(range.start, range.end, accumulator, exit, step)
}

// Stateful looping is likewise a library protocol. A body owns its incoming
// state and explicitly chooses the next state or final result; recursive
// invocation is the tail position of the Continue arm. The short aliases are
// ordinary bindings, not parser keywords.
pub enum LoopStep<S, B> { Continue(S), Break(B) }
fn loop_state_from<S, B, F>(state: S, body: F) -> B
    where F: Fn<(S), Output = LoopStep<S, B>>, F: Use<[0, *]> {
    handle body(state) {
        LoopStep::Continue(next) => loop_state_from(next, body),
        LoopStep::Break(result) => result,
    }
}
pub fn loop_state<S, B, F>(initial: S, body: F) -> B
    where F: Fn<(S), Output = LoopStep<S, B>>, F: Use<[0, *]> {
    loop_state_from(initial, body)
}
pub let loop = loop_state;
pub let break = LoopStep::Break;
pub let continue = LoopStep::Continue;

// Every named callable already owns an implicit lexical label of its own
// name. `return` is just the ordinary library forwarding helper for that
// compiler-minted capability; source still writes the destination explicitly
// as `@function_name` and no parser keyword is involved.
pub fn return<T, L>(value: T, exit: L) -> ! where L: Label<T> { exit(value) }

// Cooperative control remains effect-based. The library merely names the
// operations and provides ergonomic forwarding functions; an embedding or
// caller supplies the handler policy (scheduling, buffering, diagnostics,
// and so on). No dedicated VM opcode is needed for any of them.
pub effect Yield<T> { yield(value: T) -> (); }
pub effect Await<T> { await(value: T) -> T; }
pub effect Fail<E> { fail(error: E) -> !; }
pub fn yield<T>(value: T) -> () / {Yield<T>} { Yield<T>::yield(value) }
pub fn await<T>(value: T) -> T / {Await<T>} { Await<T>::await(value) }
pub fn fail<E>(error: E) -> ! / {Fail<E>} { Fail<E>::fail(error) }

// Result propagation is likewise a source function. `Label` evidence is
// compiler-sealed, but passing the destination and selecting the Err branch
// are ordinary generic code; an invocation of `exit` is terminal.
pub fn try<T, E, S, L>(value: Result<T, E>, exit: L) -> T
    where L: Label<Result<S, E>> {
    handle value {
        Result::Ok(inner) => inner,
        Result::Err(error) => exit(Result::Err(error)),
    }
}
