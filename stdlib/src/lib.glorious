    handle f64_ne(value, value) {
        true => 0,
        false => handle f64_le(value, 0.0) {
            true => 0,
            false => handle f64_ge(value, 340282366920938463463374607431768211456.0) {
                true => 340282366920938463463374607431768211455,
                false => __g1_f64_to_u128_checked(value),
