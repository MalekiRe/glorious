// Float-to-integer policy stays in source: NaN -> zero, truncate toward
// zero, and saturate at the target bounds. Widening f32 first is exact.
fn cast_f64_to_u8(value: f64) -> u8 {
    handle f64_ne(value, value) {
        true => 0,
        false => handle f64_le(value, 0.0) {
            true => 0,
            false => handle f64_ge(value, 256.0) {
                true => 255,
                false => __g1_f64_to_u8_checked(value),
            },
        },
    }
}
pub impl As<u8> for f32 { cast(value: f32) -> u8 { cast_f64_to_u8(__g1_f32_to_f64(value)) } }
pub impl As<u8> for f64 { cast(value: f64) -> u8 { cast_f64_to_u8(value) } }
fn cast_f64_to_u16(value: f64) -> u16 {
    handle f64_ne(value, value) {
        true => 0,
        false => handle f64_le(value, 0.0) {
            true => 0,
            false => handle f64_ge(value, 65536.0) {
                true => 65535,
                false => __g1_f64_to_u16_checked(value),
            },
        },
    }
}
pub impl As<u16> for f32 { cast(value: f32) -> u16 { cast_f64_to_u16(__g1_f32_to_f64(value)) } }
pub impl As<u16> for f64 { cast(value: f64) -> u16 { cast_f64_to_u16(value) } }
