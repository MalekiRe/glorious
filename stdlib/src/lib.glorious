// Literal elaboration calls this ordinary standard-library wrapper after the
// compiler has emitted a sealed UTF-8 static-data handle. It is public only
// so the compiler can address the distributed package by its stable name;
// callers still cannot construct or name the handle type themselves.
fn __g1_wrap_static_str(value: __StaticData<Utf8Bytes>) -> Str<'static> {
    let storage = __g1_static_as_array(value);
    Str<'static> {
        bytes: Slice<'static, u8> {
            storage: storage,
            start: 0,
            length: __g1_array_len(storage),
        },
    }
}

// Raw-byte literals use the same public Slice representation as dynamic
// arrays.  The raw static tag is preserved by the private manifest leaf and
// never confers permission to construct a Str.
fn __g1_wrap_static_slice(value: __StaticData<u8>) -> Slice<'static, u8> {
    let storage = __g1_static_raw_as_array(value);
    Slice<'static, u8> {
        storage: storage,
        start: 0,
        length: __g1_array_len(storage),
    }
}

// `Str` is a library-facing borrowed UTF-8 view. Its hidden static backing is
// never exposed outside this package; these helpers are ordinary operations
// over the same private source-level slice used by dynamic strings.
pub enum StringRangeError { Reversed, OutOfBounds, NotCharBoundary }
pub struct Chars<'a> { private text: Str<'a>, private position: usize }

pub fn str_len(value: Str) -> usize { value.bytes.length }
pub fn str_is_empty(value: Str) -> Bool {
    handle str_len(value) { 0 => true, _ => false }
}
// A UTF-8 continuation byte is never a character boundary. Index zero and
// the exclusive end are boundaries by construction; an out-of-range offset
// is not a boundary and is rejected by `str_slice` before its result escapes.
pub fn str_is_char_boundary(value: Str, index: usize) -> Bool {
    handle index > str_len(value) {
        true => false,
        false => handle index {
            0 => true,
            _ => handle index == str_len(value) {
                true => true,
                false => handle slice_get(value.bytes, index) {
                    Result::Ok(byte) => handle *byte < 128 {
                        true => true,
                        false => handle *byte >= 192 {
                            true => true,
                            false => false,
                        },
                    },
                    Result::Err(_) => false,
                },
            },
        },
    }
}
pub fn str_slice(value: Str, range: Range<usize>) -> Result<Str, StringRangeError> {
    handle range.start > range.end {
        true => Result::Err(StringRangeError::Reversed),
        false => handle range.end > str_len(value) {
            true => Result::Err(StringRangeError::OutOfBounds),
            false => handle str_is_char_boundary(value, range.start) {
                false => Result::Err(StringRangeError::NotCharBoundary),
                true => handle str_is_char_boundary(value, range.end) {
                    false => Result::Err(StringRangeError::NotCharBoundary),
                    true => Result::Ok(Str {
                        bytes: Slice {
                            storage: value.bytes.storage,
                            start: value.bytes.start + range.start,
                            length: range.end - range.start,
                        },
                    }),
                },
            },
        },
    }
}
pub fn str_subslice(value: Str, start: usize, length: usize) -> Result<Str, StringRangeError> {
    // Check before forming `start + length`: otherwise a caller-supplied
    // oversized offset could overflow before the ordinary range validation
    // has a chance to return OutOfBounds.
    handle start > str_len(value) {
        true => Result::Err(StringRangeError::OutOfBounds),
        false => handle length > str_len(value) - start {
            true => Result::Err(StringRangeError::OutOfBounds),
            false => str_slice(value, Range { start: start, end: start + length }),
        },
    }
}
pub fn str_as_bytes<'a>(value: Str<'a>) -> Slice<'a, u8> {
    value.bytes
}
// Byte-indexed scalar access for stepped UTF-8 consumers. The scalar is
// owned: no borrowed substring or iterator escapes through the result.
pub fn str_char_at(value: Str, index: usize) -> Result<char, StringRangeError> {
    handle index >= str_len(value) {
        true => Result::Err(StringRangeError::OutOfBounds),
        false => handle str_is_char_boundary(value, index) {
            false => Result::Err(StringRangeError::NotCharBoundary),
            true => handle __g1_array_utf8_char_at(
                value.bytes.storage, value.bytes.start, value.bytes.length, index,
            ) {
                (character, 0) => Result::Err(StringRangeError::OutOfBounds),
                (character, _) => Result::Ok(character),
            },
        },
    }
}
pub fn str_chars(value: Str) -> Chars { Chars { text: value, position: 0 } }
pub fn chars_next(value: &mut Chars) -> Option<char> {
    handle __g1_array_utf8_char_at(
        value.text.bytes.storage,
        value.text.bytes.start,
        value.text.bytes.length,
        value.position,
    ) {
        (character, 0) => Result::Err(()),
        (character, width) => {
            (*value).position = (*value).position + width;
            Result::Ok(character)
        },
    }
}
pub let Str::len = str_len;
pub let Str::len_bytes = str_len;
pub let Str::is_empty = str_is_empty;
pub let Str::is_char_boundary = str_is_char_boundary;
pub let Str::slice = str_slice;
pub let Str::subslice = str_subslice;
pub let Str::as_bytes = str_as_bytes;
pub let Str::chars = str_chars;
pub let Str::char_at = str_char_at;
pub let Chars::next = chars_next;


// `Vec` is an ordinary opaque standard-library wrapper. It is intentionally
// the public dense collection; `Array` and its leaves are implementation
// details of this package.
pub struct Vec<T> { private storage: Array<T> }

// BLAKE3's input is an exact borrowed byte window. The legacy immutable Bytes
// representation remains private to these machine bindings.
pub fn blake3(input: Slice<u8>) -> Vec<u8> {
    let bytes = vec_new<u8>();
    vec_extend_from_slice(&mut bytes, input);
    Vec { storage: __g1_bytes_to_array(__g1_blake3(__g1_bytes_from_array_move(move bytes.storage))) }
}

// All extent checks precede mutation; a rejected fixed-width write leaves
// the buffer unchanged. Allocation policy is separate from byte encoding.
pub struct ByteBuf { private bytes: Vec<u8>, private limit: usize }
pub enum ByteError { Limit, Truncated }

pub fn byte_buf_new(limit: usize) -> ByteBuf {
    ByteBuf { bytes: vec_new(), limit: limit }
}
pub fn byte_buf_len(buffer: &ByteBuf) -> usize { vec_len(&buffer.bytes) }
pub fn byte_buf_view(buffer: &ByteBuf) -> Slice<u8> { vec_as_slice(&buffer.bytes) }
pub fn byte_buf_finish(buffer: ByteBuf) -> Vec<u8> { move buffer.bytes }
pub fn byte_buf_push(buffer: &mut ByteBuf, value: u8) -> Result<(), ByteError> {
    handle vec_len(&buffer.bytes) < buffer.limit {
        true => { vec_push(&mut buffer.bytes, value); Result::Ok(()) },
        false => Result::Err(ByteError::Limit),
    }
}
fn byte_buf_has_room(buffer: &ByteBuf, width: usize) -> Bool {
    let length = vec_len(&buffer.bytes);
    handle length <= buffer.limit {
        false => false,
        true => width <= buffer.limit - length,
    }
}
fn byte_buf_push_word(bytes: &mut Vec<u8>, word: u64) -> () {
    vec_push(&mut *bytes, __g1_int_convert_wrapping_to_u8(word));
    vec_push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 8)));
    vec_push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 16)));
    vec_push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 24)));
    vec_push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 32)));
    vec_push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 40)));
    vec_push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 48)));
    vec_push(&mut *bytes, __g1_int_convert_wrapping_to_u8(bit_shr(word, 56)))
}
pub fn byte_buf_put_u64(buffer: &mut ByteBuf, word: u64) -> Result<(), ByteError> {
    handle byte_buf_has_room(& *buffer, 8) {
        true => { byte_buf_push_word(&mut buffer.bytes, word); Result::Ok(()) },
        false => Result::Err(ByteError::Limit),
    }
}
pub fn byte_buf_append(buffer: &mut ByteBuf, bytes: Slice<u8>) -> Result<(), ByteError> {
    handle byte_buf_has_room(& *buffer, slice_len(&bytes)) {
        true => { vec_extend_from_slice(&mut buffer.bytes, bytes); Result::Ok(()) },
        false => Result::Err(ByteError::Limit),
    }
}
pub fn byte_buf_patch(buffer: &mut ByteBuf, offset: usize, value: u8) -> Result<(), ByteError> {
    handle vec_get_mut(&mut buffer.bytes, offset) {
        Result::Ok(byte) => { *byte = value; Result::Ok(()) },
        Result::Err(_) => Result::Err(ByteError::Truncated),
    }
}
pub let ByteBuf::new = byte_buf_new;
pub let ByteBuf::len = byte_buf_len;
pub let ByteBuf::view = byte_buf_view;
pub let ByteBuf::finish = byte_buf_finish;
pub let ByteBuf::push = byte_buf_push;
pub let ByteBuf::put_u64 = byte_buf_put_u64;
pub let ByteBuf::append = byte_buf_append;
pub let ByteBuf::patch = byte_buf_patch;

// A cursor owns positions, not a borrowed view. Callers lend the immutable
// input for each operation, so a suspended work frame need not retain a loan.
pub struct ByteCursor { private position: usize }
pub fn byte_cursor_new() -> ByteCursor {
    ByteCursor { position: 0 }
}
pub fn byte_cursor_position(cursor: &ByteCursor) -> usize { cursor.position }
fn byte_cursor_has(cursor: &ByteCursor, bytes: Slice<u8>, width: usize) -> Bool {
    let length = slice_len(&bytes);
    handle cursor.position <= length {
        false => false,
        true => width <= length - cursor.position,
    }
}
pub fn byte_cursor_u8(cursor: &mut ByteCursor, bytes: Slice<u8>) -> Result<u8, ByteError> {
    handle byte_cursor_has(& *cursor, bytes, 1) {
        false => Result::Err(ByteError::Truncated),
        true => {
            let value = *slice_get_unchecked(bytes, cursor.position);
            (*cursor).position = cursor.position + 1;
            Result::Ok(value)
        },
    }
}
fn byte_cursor_word(bytes: Slice<u8>, offset: usize) -> u64 {
    let b0 = __g1_int_convert_checked_to_u64(*slice_get_unchecked(bytes, offset));
    let b1 = __g1_int_convert_checked_to_u64(*slice_get_unchecked(bytes, offset + 1));
    let b2 = __g1_int_convert_checked_to_u64(*slice_get_unchecked(bytes, offset + 2));
    let b3 = __g1_int_convert_checked_to_u64(*slice_get_unchecked(bytes, offset + 3));
    let b4 = __g1_int_convert_checked_to_u64(*slice_get_unchecked(bytes, offset + 4));
    let b5 = __g1_int_convert_checked_to_u64(*slice_get_unchecked(bytes, offset + 5));
    let b6 = __g1_int_convert_checked_to_u64(*slice_get_unchecked(bytes, offset + 6));
    let b7 = __g1_int_convert_checked_to_u64(*slice_get_unchecked(bytes, offset + 7));
    let low = bit_or(bit_or(b0, bit_shl(b1, 8)), bit_or(bit_shl(b2, 16), bit_shl(b3, 24)));
    let high = bit_or(bit_or(bit_shl(b4, 32), bit_shl(b5, 40)), bit_or(bit_shl(b6, 48), bit_shl(b7, 56)));
    bit_or(low, high)
}
pub fn byte_cursor_u64(cursor: &mut ByteCursor, bytes: Slice<u8>) -> Result<u64, ByteError> {
    handle byte_cursor_has(& *cursor, bytes, 8) {
        false => Result::Err(ByteError::Truncated),
        true => {
            let value = byte_cursor_word(bytes, cursor.position);
            (*cursor).position = cursor.position + 8;
            Result::Ok(value)
        },
    }
}
pub let ByteCursor::new = byte_cursor_new;
pub let ByteCursor::position = byte_cursor_position;
pub let ByteCursor::u8 = byte_cursor_u8;
pub let ByteCursor::u64 = byte_cursor_u64;

pub struct VecIntoIter<T> { private remaining: Vec<T> }

pub fn vec_new<T>() -> Vec<T> { Vec { storage: __g1_array_empty() } }
pub fn vec_with_capacity<T>(capacity: usize) -> Vec<T> {
    let value = vec_new();
    __g1_array_reserve(&mut value.storage, capacity);
    value
}
pub fn vec_len<T>(value: &Vec<T>) -> usize { __g1_array_len(&value.storage) }
pub fn vec_capacity<T>(value: &Vec<T>) -> usize { __g1_array_capacity(&value.storage) }
pub fn vec_reserve<T>(value: &mut Vec<T>, additional: usize) -> () {
    __g1_array_reserve(&mut value.storage, additional)
}
pub fn vec_push<T>(value: &mut Vec<T>, item: T) -> () {
    __g1_array_push_move(&mut value.storage, item)
}
pub fn vec_extend_from_slice<T>(value: &mut Vec<T>, source: Slice<T>) -> ()
    where T: Use<[0, *]> {
    __g1_array_extend_from_slice(
        &mut value.storage,
        source.storage,
        source.start,
        source.length,
    )
}
// Growing duplicates the supplied fill value. Shrinking is also valid under
// this stronger bound because duplicable values may be discarded.
fn vec_resize_grow<T>(value: &mut Vec<T>, length: usize, fill: &T) -> ()
    where T: Use<[0, *]> {
    handle vec_len(& *value) < length {
        false => (),
        true => {
            vec_push(&mut *value, *fill);
            vec_resize_grow(&mut *value, length, fill)
        },
    }
}
pub fn vec_resize<T>(value: &mut Vec<T>, length: usize, fill: T) -> ()
    where T: Use<[0, *]> {
    handle length < vec_len(& *value) {
        true => vec_truncate(&mut *value, length),
        false => vec_resize_grow(&mut *value, length, &fill),
    }
}
// This deliberately remains a private leaf: `String` owns the UTF-8 policy,
// while `Vec<u8>` only supplies the backing storage.
fn vec_push_utf8_char(value: &mut Vec<u8>, character: char) -> () {
    __g1_array_push_utf8_char(&mut value.storage, character)
}
pub fn vec_is_empty<T>(value: &Vec<T>) -> Bool {
    handle vec_len(value) { 0 => true, _ => false }
}
pub fn vec_pop<T>(value: &mut Vec<T>) -> Option<T> {
    let length = __g1_array_len(&value.storage);
    handle length {
        0 => Result::Err(()),
        _ => Result::Ok(__g1_array_pop_move(&mut value.storage)),
    }
}
pub fn vec_get_unchecked<'a, T>(value: &'a Vec<T>, index: usize) -> &'a T {
    __g1_array_get_borrow_shared(&value.storage, index)
}
pub fn vec_get<'a, T>(value: &'a Vec<T>, index: usize) -> Option<&'a T> {
    handle index < vec_len(value) {
        true => Result::Ok(__g1_array_get_borrow_shared(&value.storage, index)),
        false => Result::Err(()),
    }
}
pub fn vec_first<'a, T>(value: &'a Vec<T>) -> Option<&'a T> { vec_get(value, 0) }
pub fn vec_last<'a, T>(value: &'a Vec<T>) -> Option<&'a T> {
    let length = vec_len(value);
    handle length {
        0 => Result::Err(()),
        _ => vec_get(value, length - 1),
    }
}
pub fn vec_get_mut<'a, T>(value: &'a mut Vec<T>, index: usize) -> Option<&'a mut T> {
    let length = __g1_array_len(&value.storage);
    handle index < length {
        true => Result::Ok(__g1_array_get_borrow_unique(&mut value.storage, index)),
        false => Result::Err(()),
    }
}
pub fn vec_swap<T>(value: &mut Vec<T>, left: usize, right: usize) -> () {
    let first = __g1_array_get_move(&mut value.storage, left);
    let second = __g1_array_get_move(&mut value.storage, right);
    __g1_array_set_move(&mut value.storage, left, second);
    __g1_array_set_move(&mut value.storage, right, first)
}
pub fn vec_swap_remove<T>(value: &mut Vec<T>, index: usize) -> Option<T> {
    let length = __g1_array_len(&value.storage);
    handle index < length {
        false => Result::Err(()),
        true => {
            let last = length - 1;
            let removed = __g1_array_get_move(&mut value.storage, index);
            handle index == last {
                true => {
                    __g1_array_pop_move(&mut value.storage);
                    Result::Ok(removed)
                },
                false => {
                    let tail = __g1_array_get_move(&mut value.storage, last);
                    __g1_array_set_move(&mut value.storage, index, tail);
                    __g1_array_pop_move(&mut value.storage);
                    Result::Ok(removed)
                },
            }
        },
    }
}
pub fn vec_insert<T>(value: &mut Vec<T>, index: usize, item: T) -> Option<()> {
    handle index <= __g1_array_len(&value.storage) {
        true => {
            __g1_array_insert_move(&mut value.storage, index, item);
            Result::Ok(())
        },
        false => Result::Err(()),
    }
}
pub fn vec_insert_from_slice<T>(value: &mut Vec<T>, index: usize, source: Slice<T>) -> Option<()>
    where T: Use<[0, *]> {
    handle index <= __g1_array_len(&value.storage) {
        false => Result::Err(()),
        true => {
            __g1_array_insert_from_slice(
                &mut value.storage,
                index,
                source.storage,
                source.start,
                source.length,
            );
            Result::Ok(())
        },
    }
}
pub fn vec_remove<T>(value: &mut Vec<T>, index: usize) -> Option<T> {
    handle index < __g1_array_len(&value.storage) {
        true => Result::Ok(__g1_array_remove_move(&mut value.storage, index)),
        false => Result::Err(()),
    }
}
pub fn vec_append<T>(value: &mut Vec<T>, source: Vec<T>) -> () {
    __g1_array_append_move(&mut value.storage, source.storage)
}
pub fn vec_truncate<T>(value: &mut Vec<T>, length: usize) -> ()
    where T: Use<[0, 1]> {
    handle length < __g1_array_len(&value.storage) {
        true => __g1_array_truncate_discard(&mut value.storage, length),
        false => (),
    }
}
pub fn vec_clear<T>(value: &mut Vec<T>) -> ()
    where T: Use<[0, 1]> {
    __g1_array_truncate_discard(&mut value.storage, 0)
}
pub fn vec_reverse<T>(value: &mut Vec<T>) -> () {
    __g1_array_reverse_move(&mut value.storage)
}
pub fn vec_split_off<T>(value: &mut Vec<T>, index: usize) -> Option<Vec<T>> {
    handle index <= __g1_array_len(&value.storage) {
        false => Result::Err(()),
        true => Result::Ok(Vec { storage: __g1_array_split_off_move(&mut value.storage, index) }),
    }
}
// Draining transfers the selected residents into the existing owned iterator
// representation. The suffix is moved out and restored, so no resident is
// silently discarded and exact-linear elements remain valid.
pub fn vec_drain<T>(value: &mut Vec<T>, range: Range<usize>) -> Option<VecIntoIter<T>> {
    handle range.start > range.end {
        true => Result::Err(()),
        false => handle range.end > __g1_array_len(&value.storage) {
            true => Result::Err(()),
            false => {
                let tail = Vec {
                    storage: __g1_array_split_off_move(&mut value.storage, range.end),
                };
                let drained = Vec {
                    storage: __g1_array_split_off_move(&mut value.storage, range.start),
                };
                vec_append(value, tail);
                Result::Ok(VecIntoIter { remaining: drained })
            },
        },
    }
}
fn vec_selection_min<T>(value: &Vec<T>, best: usize, index: usize) -> usize
    where T: Ord {
    handle index >= vec_len(value) {
        true => best,
        false => handle Ord::compare(vec_get_unchecked(value, index), vec_get_unchecked(value, best)) {
            Ordering::Less => vec_selection_min(value, index, index + 1),
            _ => vec_selection_min(value, best, index + 1),
        },
    }
}
fn vec_sort_unstable_from<T>(value: &mut Vec<T>, index: usize) -> ()
    where T: Ord {
    handle index >= vec_len(& *value) {
        true => (),
        false => {
            let smallest = vec_selection_min(& *value, index, index + 1);
            vec_swap(&mut *value, index, smallest);
            vec_sort_unstable_from(&mut *value, index + 1)
        },
    }
}
pub fn vec_sort_unstable<T>(value: &mut Vec<T>) -> ()
    where T: Ord {
    vec_sort_unstable_from(&mut *value, 0)
}
// A stable sort owns one reusable scratch buffer. Removing the first minimum
// shifts later equal elements left, so equal values enter `scratch` in their
// original order. Every resident is moved exactly once into the buffer and
// once back, which also admits exact-linear element types.
fn vec_sort_stable_into_scratch<T>(value: &mut Vec<T>, scratch: &mut Vec<T>) -> ()
    where T: Ord {
    handle vec_len(& *value) {
        0 => (),
        _ => {
            let smallest = vec_selection_min(& *value, 0, 1);
            handle vec_remove(&mut *value, smallest) {
                Result::Err(_) => (),
                Result::Ok(item) => {
                    vec_push(&mut *scratch, item);
                    vec_sort_stable_into_scratch(&mut *value, &mut *scratch)
                },
            }
        },
    }
}
pub fn vec_sort_stable<T>(value: &mut Vec<T>) -> ()
    where T: Ord {
    let scratch = vec_with_capacity(vec_len(& *value));
    vec_sort_stable_into_scratch(&mut *value, &mut scratch);
    vec_append(&mut *value, scratch)
}
// `partition_by` is deliberately in-place and makes no stability promise.
// The predicate is explicitly duplicable because it is evaluated once per
// examined resident; capture-free named functions and closures with
// duplicable captures satisfy that contract without a special VM callback
// type.
fn vec_partition_by_from<T, F>(value: &mut Vec<T>, predicate: F, left: usize, end: usize) -> usize
    where F: Fn<(&T), Output = Bool>, F: Use<[0, *]> {
    handle left >= end {
        true => left,
        false => handle predicate(vec_get_unchecked(& *value, left)) {
            true => vec_partition_by_from(&mut *value, predicate, left + 1, end),
            false => {
                let last = end - 1;
                vec_swap(&mut *value, left, last);
                vec_partition_by_from(&mut *value, predicate, left, last)
            },
        },
    }
}
pub fn vec_partition_by<T, F>(value: &mut Vec<T>, predicate: F) -> usize
    where F: Fn<(&T), Output = Bool>, F: Use<[0, *]> {
    vec_partition_by_from(&mut *value, predicate, 0, vec_len(& *value))
}
fn vec_dedup_from<T>(value: &mut Vec<T>, index: usize) -> ()
    where T: Eq, T: Use<[0, 1]> {
    handle index + 1 >= vec_len(& *value) {
        true => (),
        false => handle Eq::eq(
            vec_get_unchecked(& *value, index),
            vec_get_unchecked(& *value, index + 1),
        ) {
            true => handle vec_remove(&mut *value, index + 1) {
                Result::Err(_) => (),
                Result::Ok(_) => vec_dedup_from(&mut *value, index),
            },
            false => vec_dedup_from(&mut *value, index + 1),
        },
    }
}
pub fn vec_dedup<T>(value: &mut Vec<T>) -> ()
    where T: Eq, T: Use<[0, 1]> {
    vec_dedup_from(&mut *value, 0)
}
pub fn vec_as_slice<'a, T>(value: &'a Vec<T>) -> Slice<'a, T> {
    Slice<'a, T> {
        storage: &value.storage,
        start: 0,
        length: __g1_array_len(&value.storage),
    }
}
pub fn vec_as_mut_slice<'a, T>(value: &'a mut Vec<T>) -> SliceMut<'a, T> {
    SliceMut<'a, T> {
        storage: &mut value.storage,
        start: 0,
        length: __g1_array_len(&value.storage),
    }
}
pub fn vec_iter<T>(value: &Vec<T>) -> SliceIter<'_, T> { slice_iter(vec_as_slice(value)) }
pub fn vec_into_iter<T>(value: Vec<T>) -> VecIntoIter<T> {
    VecIntoIter { remaining: value }
}
pub fn vec_into_iter_next<T>(value: &mut VecIntoIter<T>) -> Option<T> {
    vec_remove(&mut value.remaining, 0)
}
// An explicitly abandoned iterator has the same affine-erasure requirement
// as `Vec::clear`; an exact-linear resident must be iterated to completion.
pub fn vec_into_iter_discard<T>(value: VecIntoIter<T>) -> ()
    where T: Use<[0, 1]> {
    vec_clear(&mut value.remaining)
}

