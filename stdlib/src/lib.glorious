// G1 standard-library prelude and source-defined control.
//
// This package deliberately contains no public `Text` alias. `Str` is an
// ordinary source-defined UTF-8 view; its private byte window works equally
// for compiler-emitted static data and for a future owned `String` buffer.

// An ownership-only marker has no resident payload or machine representation.
// Its sole principal interval follows T; pointer owners can therefore account
// for their logical residents without pretending that pointer copies own T.
pub struct PhantomData<T> {}
pub impl<T, q: Quantity> Use<q> for PhantomData<T> where T: Use<q> {}

// General machine memory leaves. These do not own collection policy or element
// lifetimes. All pointer operations require explicit unsafe source scopes;
// their exact signatures/identities are bound by the runtime manifest. A trailing
// semicolon declares an externally supplied implementation, not a stub body.
__g1_abort() -> !;
__g1_memory_size_of<T>() -> usize;
__g1_memory_align_of<T>() -> usize;
unsafe fn __g1_memory_null<T>() -> *mut T;
unsafe fn __g1_memory_dangling<T>() -> *mut T;
unsafe fn __g1_memory_allocate(size: usize, alignment: usize) -> *mut u8;
unsafe fn __g1_memory_reallocate(pointer: *mut u8, old_size: usize, alignment: usize, new_size: usize) -> *mut u8;
unsafe fn __g1_memory_deallocate(pointer: *mut u8, size: usize, alignment: usize) -> ();
unsafe fn __g1_memory_is_null<T>(pointer: *mut T) -> u32;
unsafe fn __g1_memory_offset<T>(pointer: *mut T, count: usize) -> *mut T;
unsafe fn __g1_memory_offset_const<T>(pointer: *const T, count: usize) -> *const T;
unsafe fn __g1_memory_cast<T, U>(pointer: *mut T) -> *mut U;
unsafe fn __g1_memory_as_const<T>(pointer: *mut T) -> *const T;
unsafe fn __g1_memory_read<T>(pointer: *const T) -> T;
unsafe fn __g1_memory_write<T>(pointer: *mut T, value: T) -> ();
unsafe fn __g1_memory_copy<T>(source: *const T, destination: *mut T, count: usize) -> ();
unsafe fn __g1_memory_copy_nonoverlapping<T>(source: *const T, destination: *mut T, count: usize) -> ();
unsafe fn __g1_memory_borrow_shared<'a, T>(pointer: *const T) -> &'a T;
unsafe fn __g1_memory_borrow_unique<'a, T>(pointer: *mut T) -> &'a mut T;
unsafe fn __g1_memory_as_raw_shared<T>(value: &T) -> *const T;
unsafe fn __g1_memory_as_raw_unique<T>(value: &mut T) -> *mut T;
unsafe fn __g1_memory_cast_const<T, U>(pointer: *const T) -> *const U;
unsafe fn __g1_memory_static_utf8_address(value: __StaticData<Utf8Bytes>) -> *const u8;
unsafe fn __g1_memory_static_bytes_address(value: __StaticData<u8>) -> *const u8;
unsafe fn __g1_memory_forget<T>(value: T) -> ();
__g1_memory_static_bytes_len(value: __StaticData<u8>) -> usize;

// Legacy manifest declarations retained for existing artifact compatibility.
// Source collections and hashing do not call these whole-operation leaves.
__g1_array_get_borrow_shared<'a, T>(value: &'a Array<T>, index: usize) -> &'a T;
__g1_array_empty<T>() -> Array<T>;
__g1_array_push_move<T>(value: &mut Array<T>, item: T) -> ();
// Existing deterministic byte mechanisms, admitted by their exact selectors.
__g1_bytes_from_array_move(value: Array<u8>) -> Bytes;
__g1_bytes_to_array(value: Bytes) -> Array<u8>;
__g1_blake3(value: Bytes) -> Bytes;
__g1_static_len(value: __StaticData<Utf8Bytes>) -> usize;
// Scalar leaves are private manifest bindings.  The public character API
// validates before calling the checked conversion, so invalid code points are
// represented as `None` rather than as a VM execution failure.
__g1_char_from_u32_checked(value: u32) -> char;
__g1_char_to_u32(value: char) -> u32;
__g1_int_convert_wrapping_to_u32<T>(value: T) -> u32;
__g1_int_convert_wrapping_to_usize<T>(value: T) -> usize;
__g1_int_convert_checked_to_u8<T>(value: T) -> u8;
__g1_int_convert_checked_to_u16<T>(value: T) -> u16;
__g1_int_convert_checked_to_u32<T>(value: T) -> u32;
__g1_int_convert_checked_to_u64<T>(value: T) -> u64;
__g1_int_convert_checked_to_usize<T>(value: T) -> usize;
__g1_int_convert_checked_to_i8<T>(value: T) -> i8;
__g1_int_convert_checked_to_i16<T>(value: T) -> i16;
__g1_int_convert_checked_to_i32<T>(value: T) -> i32;
__g1_int_convert_checked_to_isize<T>(value: T) -> isize;
__g1_int_convert_checked_to_u128<T>(value: T) -> u128;
__g1_int_convert_checked_to_i128<T>(value: T) -> i128;
__g1_int_convert_wrapping_to_i64<T>(value: T) -> i64;
__g1_int_convert_wrapping_to_u8<T>(value: T) -> u8;
__g1_int_convert_wrapping_to_u16<T>(value: T) -> u16;
__g1_int_convert_wrapping_to_i8<T>(value: T) -> i8;
__g1_int_convert_wrapping_to_i16<T>(value: T) -> i16;
__g1_int_convert_wrapping_to_i32<T>(value: T) -> i32;
__g1_int_convert_wrapping_to_u64<T>(value: T) -> u64;
__g1_int_convert_wrapping_to_isize<T>(value: T) -> isize;
__g1_int_convert_wrapping_to_u128<T>(value: T) -> u128;
__g1_int_convert_wrapping_to_i128<T>(value: T) -> i128;
__g1_int_wrapping_add<T>(left: T, right: T) -> T;
__g1_int_wrapping_sub<T>(left: T, right: T) -> T;
__g1_int_wrapping_mul<T>(left: T, right: T) -> T;
__g1_int_bit_and<T>(left: T, right: T) -> T;
__g1_int_bit_or<T>(left: T, right: T) -> T;
__g1_int_bit_xor<T>(left: T, right: T) -> T;
__g1_int_bit_not<T>(value: T) -> T;
__g1_int_shl<T>(value: T, count: u32) -> T;
__g1_int_shr<T>(value: T, count: u32) -> T;
__g1_f32_add(left: f32, right: f32) -> f32;
__g1_f32_sub(left: f32, right: f32) -> f32;
__g1_f32_mul(left: f32, right: f32) -> f32;
__g1_f32_div(left: f32, right: f32) -> f32;
__g1_f32_rem(left: f32, right: f32) -> f32;
__g1_f32_eq(left: f32, right: f32) -> u32;
__g1_f32_ne(left: f32, right: f32) -> u32;
__g1_f32_lt(left: f32, right: f32) -> u32;
__g1_f32_le(left: f32, right: f32) -> u32;
__g1_f32_gt(left: f32, right: f32) -> u32;
__g1_f32_ge(left: f32, right: f32) -> u32;
__g1_f32_from_bits(value: u32) -> f32;
__g1_i64_to_f32(value: i64) -> f32;
