// Open addressing is entirely library-owned. Buckets contain 0 for empty,
// 1 for deleted, or a dense entry index + 2. Cached hashes and reverse bucket
// positions are separate from residents: rehashing never copies a K or V,
// and swap-removal repairs exactly one relocated entry's bucket.
pub struct HashMap<K, V> {
    private entries: Vec<HashMapEntry<K, V>>,
    private indices: Vec<HashMapIndex>,
    private buckets: Vec<usize>,
    private deleted: usize,
}
pub struct HashMapEntry<K, V> { private key: K, private value: V }
struct HashMapIndex { fingerprint: usize, bucket: usize }

fn hash_key<K>(key: &K) -> usize
    where K: Hash {
    let state = hasher_new();
    Hash::hash(key, &mut state);
    hasher_finish(state)
}
fn hash_bucket(fingerprint: usize, capacity: usize) -> usize {
    bit_and(fingerprint, capacity - 1)
}
fn hash_bucket_set(buckets: &mut Vec<usize>, bucket: usize, slot: usize) -> () {
    __g1_array_set_move(&mut (*buckets).storage, bucket, slot)
}
fn hash_map_matches<K, V>(value: &HashMap<K, V>, key: &K, fingerprint: usize, slot: usize) -> Bool
    where K: Eq {
    handle slot < 2 {
        true => false,
        false => handle vec_get_unchecked(&(*value).indices, slot - 2).fingerprint == fingerprint {
            false => false,
            true => Eq::eq(&vec_get_unchecked(&(*value).entries, slot - 2).key, key),
        },
    }
}
fn hash_map_find_from<K, V>(value: &HashMap<K, V>, key: &K, fingerprint: usize, bucket: usize) -> Option<usize>
    where K: Eq {
    let slot = *vec_get_unchecked(&(*value).buckets, bucket);
    handle slot == 0 {
        true => Result::Err(()),
        false => handle hash_map_matches(value, key, fingerprint, slot) {
            true => Result::Ok(slot - 2),
            false => hash_map_find_from(value, key, fingerprint, hash_bucket(bucket + 1, vec_len(&(*value).buckets))),
        },
    }
}
fn hash_map_find_hashed<K, V>(value: &HashMap<K, V>, key: &K, fingerprint: usize) -> Option<usize>
    where K: Eq {
    handle vec_len(&(*value).buckets) {
        0 => Result::Err(()),
        capacity => hash_map_find_from(value, key, fingerprint, hash_bucket(fingerprint, capacity)),
    }
}
fn hash_map_find<K, V>(value: &HashMap<K, V>, key: &K) -> Option<usize>
    where K: Eq, K: Hash {
    hash_map_find_hashed(value, key, hash_key(key))
}
// At most 7/8 of buckets are occupied or deleted, so every probe terminates
// at an empty bucket. Insertion may also reuse a deleted bucket, but only
// after the complete lookup has established that no equal resident exists.
fn hash_map_vacant(buckets: &Vec<usize>, bucket: usize) -> usize {
    handle *vec_get_unchecked(buckets, bucket) < 2 {
        true => bucket,
        false => hash_map_vacant(buckets, hash_bucket(bucket + 1, vec_len(buckets))),
    }
}
fn hash_map_reindex(buckets: &mut Vec<usize>, indices: &mut Vec<HashMapIndex>, index: usize) -> () {
    handle index < vec_len(& *indices) {
        false => (),
        true => {
            let fingerprint = vec_get_unchecked(& *indices, index).fingerprint;
            let bucket = hash_map_vacant(& *buckets, hash_bucket(fingerprint, vec_len(& *buckets)));
            hash_bucket_set(&mut *buckets, bucket, index + 2);
            let entry = __g1_array_get_borrow_unique(&mut (*indices).storage, index);
            (*entry).bucket = bucket;
            hash_map_reindex(&mut *buckets, &mut *indices, index + 1)
        },
    }
}
fn hash_map_rehash<K, V>(value: &mut HashMap<K, V>, capacity: usize) -> () {
    let buckets = vec_new<usize>();
    vec_resize(&mut buckets, capacity, 0);
    hash_map_reindex(&mut buckets, &mut (*value).indices, 0);
    (*value).buckets = buckets;
    (*value).deleted = as<usize>(0);
}
fn hash_map_prepare_insert<K, V>(value: &mut HashMap<K, V>) -> () {
    let capacity = vec_len(&(*value).buckets);
    handle capacity {
        0 => hash_map_rehash(&mut *value, 8),
        _ => handle vec_len(&(*value).entries) + (*value).deleted >= capacity - bit_shr(capacity, 3) {
            false => (),
            true => handle vec_len(&(*value).entries) < bit_shr(capacity, 1) {
                true => hash_map_rehash(&mut *value, capacity),
                // Overflow is a checked resource failure, never a wrapped
                // zero capacity that could make probing non-terminating.
                false => hash_map_rehash(&mut *value, capacity + capacity),
            },
        },
    }
}
fn hash_map_append<K, V>(value: &mut HashMap<K, V>, key: K, item: V, fingerprint: usize) -> () {
    hash_map_prepare_insert(&mut *value);
    let capacity = vec_len(&(*value).buckets);
    let bucket = hash_map_vacant(&(*value).buckets, hash_bucket(fingerprint, capacity));
    handle *vec_get_unchecked(&(*value).buckets, bucket) == 1 {
        false => (),
        true => { (*value).deleted = (*value).deleted - 1; },
    };
    let index = vec_len(&(*value).entries);
    vec_push(&mut (*value).entries, HashMapEntry { key: key, value: item });
    vec_push(&mut (*value).indices, HashMapIndex { fingerprint: fingerprint, bucket: bucket });
    hash_bucket_set(&mut (*value).buckets, bucket, index + 2)
}
pub fn hash_map_new<K, V>() -> HashMap<K, V> {
    HashMap { entries: vec_new(), indices: vec_new(), buckets: vec_new(), deleted: 0 }
}
pub fn hash_map_len<K, V>(value: &HashMap<K, V>) -> usize { vec_len(&(*value).entries) }
pub fn hash_map_is_empty<K, V>(value: &HashMap<K, V>) -> Bool { vec_is_empty(&(*value).entries) }
// Dense residents can be inspected without copying keys/values or probing
// buckets. Their order is unspecified and may change after any mutation.
// Only shared views are exposed: mutating a resident key would break the index.
pub fn hash_map_entries<'a, K, V>(value: &'a HashMap<K, V>) -> Slice<'a, HashMapEntry<K, V>> {
    vec_as_slice(&value.entries)
}
pub fn hash_map_entry_key<'a, K, V>(value: &'a HashMapEntry<K, V>) -> &'a K { &value.key }
pub fn hash_map_entry_value<'a, K, V>(value: &'a HashMapEntry<K, V>) -> &'a V { &value.value }
pub fn hash_map_contains_key<K, V>(value: &HashMap<K, V>, key: &K) -> Bool
    where K: Eq, K: Hash {
    handle hash_map_find(value, key) {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}
// The result is tied only to `value`; `key` is consulted during lookup and
// cannot be the storage behind the returned reference. Its input lifetime is
// therefore elided, while the output's provenance stays explicit.
pub fn hash_map_get<'a, K, V>(value: &'a HashMap<K, V>, key: &K) -> Option<&'a V>
    where K: Eq, K: Hash {
    handle hash_map_find(value, key) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(index) => {
            let entry = __g1_array_get_borrow_shared(&(*value).entries.storage, index);
            Result::Ok(&(*entry).value)
        },
    }
}
pub fn hash_map_get_mut<'a, K, V>(value: &'a mut HashMap<K, V>, key: &K) -> Option<&'a mut V>
    where K: Eq, K: Hash {
    handle hash_map_find(& *value, key) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(index) => {
            let entry = __g1_array_get_borrow_unique(&mut (*value).entries.storage, index);
            Result::Ok(&mut (*entry).value)
        },
    }
}
pub fn hash_map_insert<K, V>(value: &mut HashMap<K, V>, key: K, item: V) -> Option<V>
    where K: Eq, K: Hash, K: Use<[0, 1]> {
    let fingerprint = hash_key(&key);
    handle hash_map_find_hashed(& *value, &key, fingerprint) {
        Result::Err(_) => {
            hash_map_append(&mut *value, key, item, fingerprint);
            Result::Err(())
        },
        Result::Ok(index) => {
            let entry = __g1_array_get_borrow_unique(&mut (*value).entries.storage, index);
            // Preserve the canonical resident key. Only the value changes;
            // discarding the equal incoming key needs the bound above.
            Result::Ok(replace(&mut (*entry).value, item))
        },
    }
}
fn hash_map_unindex<K, V>(value: &mut HashMap<K, V>, index: usize) -> () {
    let bucket = vec_get_unchecked(&(*value).indices, index).bucket;
    hash_bucket_set(&mut (*value).buckets, bucket, 1);
    (*value).deleted = (*value).deleted + 1;
    vec_swap_remove(&mut (*value).indices, index);
    handle index < vec_len(&(*value).indices) {
        false => (),
        true => {
            let moved_bucket = vec_get_unchecked(&(*value).indices, index).bucket;
            hash_bucket_set(&mut (*value).buckets, moved_bucket, index + 2)
        },
    }
}
fn hash_map_remove_resident<K, V>(value: &mut HashMap<K, V>, key: &K) -> Option<HashMapEntry<K, V>>
    where K: Eq, K: Hash {
    handle hash_map_find(& *value, key) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(index) => {
            hash_map_unindex(&mut *value, index);
            vec_swap_remove(&mut (*value).entries, index)
        },
    }
}
pub fn hash_map_remove<K, V>(value: &mut HashMap<K, V>, key: &K) -> Option<V>
    where K: Eq, K: Hash, K: Use<[0, 1]> {
    handle hash_map_remove_resident(value, key) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(previous) => Result::Ok(previous.value),
    }
}
// Transfer both fields; neither key nor value needs erasure evidence.
pub fn hash_map_remove_entry<K, V>(value: &mut HashMap<K, V>, key: &K) -> Option<(K, V)>
    where K: Eq, K: Hash {
    handle hash_map_remove_resident(value, key) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(previous) => Result::Ok((previous.key, previous.value)),
    }
}
pub let HashMap::new = hash_map_new;
pub let HashMap::len = hash_map_len;
pub let HashMap::is_empty = hash_map_is_empty;
pub let HashMap::entries = hash_map_entries;
pub let HashMapEntry::key = hash_map_entry_key;
pub let HashMapEntry::value = hash_map_entry_value;
pub let HashMap::contains_key = hash_map_contains_key;
pub let HashMap::get = hash_map_get;
pub let HashMap::get_mut = hash_map_get_mut;
pub let HashMap::insert = hash_map_insert;
pub let HashMap::remove = hash_map_remove;
pub let HashMap::remove_entry = hash_map_remove_entry;

// The set shares the map index while retaining the original resident on a
// duplicate insertion and returning ownership of that resident on removal.
pub struct HashSet<T> { private map: HashMap<T, ()> }
pub fn hash_set_new<T>() -> HashSet<T> { HashSet { map: hash_map_new() } }
pub fn hash_set_len<T>(value: &HashSet<T>) -> usize { hash_map_len(&(*value).map) }
pub fn hash_set_is_empty<T>(value: &HashSet<T>) -> Bool { hash_map_is_empty(&(*value).map) }
pub fn hash_set_contains<T>(value: &HashSet<T>, item: &T) -> Bool
    where T: Eq, T: Hash {
    hash_map_contains_key(&(*value).map, item)
}
// A duplicate consumes `item` without storing it, so affine-erasure evidence
// is required. `true` means a new resident was inserted.
pub fn hash_set_insert<T>(value: &mut HashSet<T>, item: T) -> Bool
    where T: Eq, T: Hash, T: Use<[0, 1]> {
    let fingerprint = hash_key(&item);
    handle hash_map_find_hashed(&(*value).map, &item, fingerprint) {
        Result::Ok(_) => false,
        Result::Err(_) => {
            hash_map_append(&mut (*value).map, item, (), fingerprint);
            true
        },
    }
}
// Removal returns the resident, preserving its complete ownership contract.
pub fn hash_set_remove<T>(value: &mut HashSet<T>, item: &T) -> Option<T>
    where T: Eq, T: Hash {
    handle hash_map_remove_resident(&mut (*value).map, item) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(entry) => Result::Ok(entry.key),
    }
}
pub let HashSet::new = hash_set_new;
pub let HashSet::len = hash_set_len;
pub let HashSet::is_empty = hash_set_is_empty;
pub let HashSet::contains = hash_set_contains;
pub let HashSet::insert = hash_set_insert;
pub let HashSet::remove = hash_set_remove;

// Queue and compiler-work-list shapes are ordinary wrappers over `Vec`; no
// separate VM collection representation is needed.
pub struct VecDeque<T> { private storage: Vec<T> }
pub fn vec_deque_new<T>() -> VecDeque<T> { VecDeque { storage: vec_new() } }
pub fn vec_deque_len<T>(value: &VecDeque<T>) -> usize { vec_len(&value.storage) }
pub fn vec_deque_is_empty<T>(value: &VecDeque<T>) -> Bool { vec_is_empty(&value.storage) }
pub fn vec_deque_push_back<T>(value: &mut VecDeque<T>, item: T) -> () {
    vec_push(&mut value.storage, item)
}
pub fn vec_deque_push_front<T>(value: &mut VecDeque<T>, item: T) -> () {
    handle vec_insert(&mut value.storage, 0, item) {
        Result::Ok(_) => (),
        Result::Err(_) => (),
    }
}
pub fn vec_deque_pop_back<T>(value: &mut VecDeque<T>) -> Option<T> {
    vec_pop(&mut value.storage)
}
pub fn vec_deque_pop_front<T>(value: &mut VecDeque<T>) -> Option<T> {
    vec_remove(&mut value.storage, 0)
}
pub fn vec_deque_front<T>(value: &VecDeque<T>) -> Option<&T> { vec_first(&value.storage) }
pub fn vec_deque_back<T>(value: &VecDeque<T>) -> Option<&T> { vec_last(&value.storage) }

pub let VecDeque::new = vec_deque_new;
pub let VecDeque::len = vec_deque_len;
pub let VecDeque::is_empty = vec_deque_is_empty;
pub let VecDeque::push_back = vec_deque_push_back;
pub let VecDeque::push_front = vec_deque_push_front;
pub let VecDeque::pop_back = vec_deque_pop_back;
pub let VecDeque::pop_front = vec_deque_pop_front;
pub let VecDeque::front = vec_deque_front;
pub let VecDeque::back = vec_deque_back;

pub struct Stack<T> { private storage: Vec<T> }
