pub impl Display for String {
    display(value: &String, formatter: &mut Formatter) -> () {
        Formatter::write_str(formatter, String::as_str(value))
    }
}
// At most twenty recursive frames on the current 64-bit usize ABI. The
// quotient/remainder decomposition is total, including zero and usize::MAX;
// no signed narrowing or new formatting primitive is involved.
fn display_usize_decimal(value: usize, formatter: &mut Formatter) -> () {
    let quotient = value / 10;
    handle quotient == 0 {
        true => (), false => display_usize_decimal(quotient, &mut *formatter),
    };
    let digit = value - quotient * 10;
    Vec::push(&mut formatter.output.storage, as<u8>(48 + digit));
}
pub impl Display for usize {
    display(value: &usize, formatter: &mut Formatter) -> () { display_usize_decimal(*value, formatter) }
}
pub impl Debug for String {
    debug(value: &String, formatter: &mut Formatter) -> () {
        Formatter::write_str(formatter, String::as_str(value))
    }
}

pub impl Ord for i64 {
    compare(left: &i64, right: &i64) -> Ordering {
        handle *left < *right {
            true => Ordering::Less,
            false => handle *left == *right {
                true => Ordering::Equal,
                false => Ordering::Greater,
            },
        }
    }
}
