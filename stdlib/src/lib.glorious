// Unicode scalar values exclude both values past the Unicode maximum and the
// UTF-16 surrogate interval.  Keeping this check in source makes the public
// conversion an ordinary Option-returning library operation; the VM only
// supplies the final checked representation conversion.
pub fn char_from_u32(value: u32) -> Option<char> {
    handle value > 1114111 {
        true => None,
        false => handle value < 55296 {
            true => Result::Ok(__g1_char_from_u32_checked(value)),
            false => handle value > 57343 {
                true => Result::Ok(__g1_char_from_u32_checked(value)),
                false => None,
            },
        },
    }
}
pub fn char_to_u32(value: char) -> u32 { __g1_char_to_u32(value) }
pub fn char_utf8_len(value: char) -> usize {
    let scalar = char_to_u32(value);
    handle scalar < 128 {
        true => 1,
        false => handle scalar < 2048 {
            true => 2,
            false => handle scalar < 65536 { true => 3, false => 4 },
        },
    }
}

// Checked conversion is source-defined policy layered over a single wrapping
// machine leaf.  The range test happens first, so the leaf is reached only on
// values that the target representation can contain.
pub fn i64_to_u32_checked(value: i64) -> Option<u32> {
    handle value < 0 {
        true => None,
        false => handle value > 4294967295 {
            true => None,
            false => Result::Ok(__g1_int_convert_checked_to_u32(value)),
        },
    }
}
pub fn i64_to_u32_wrapping(value: i64) -> u32 {
    __g1_int_convert_wrapping_to_u32(value)
}

// Checked narrowing is expressed entirely in source: guards produce the
// public `Option` failure, and the private conversion leaf is invoked only
// after the value is known to fit.  The VM therefore need not expose a public
// overflow representation for each scalar pair.
pub fn i64_to_u8_checked(value: i64) -> Option<u8> {
    handle value < 0 { true => None, false => handle value > 255 { true => None, false => Result::Ok(__g1_int_convert_checked_to_u8(value)) } }
}
pub fn i64_to_u16_checked(value: i64) -> Option<u16> {
    handle value < 0 { true => None, false => handle value > 65535 { true => None, false => Result::Ok(__g1_int_convert_checked_to_u16(value)) } }
}
pub fn i64_to_usize_checked(value: i64) -> Option<usize> {
    handle value < 0 { true => None, false => Result::Ok(__g1_int_convert_checked_to_usize(value)) }
}
pub fn i64_to_u64_checked(value: i64) -> Option<u64> {
    handle value < 0 { true => None, false => Result::Ok(__g1_int_convert_checked_to_u64(value)) }
}
pub fn i64_to_i8_checked(value: i64) -> Option<i8> {
    handle value < -128 { true => None, false => handle value > 127 { true => None, false => Result::Ok(__g1_int_convert_checked_to_i8(value)) } }
}
pub fn i64_to_i16_checked(value: i64) -> Option<i16> {
    handle value < -32768 { true => None, false => handle value > 32767 { true => None, false => Result::Ok(__g1_int_convert_checked_to_i16(value)) } }
}
pub fn i64_to_i32_checked(value: i64) -> Option<i32> {
    handle value < -2147483648 { true => None, false => handle value > 2147483647 { true => None, false => Result::Ok(__g1_int_convert_checked_to_i32(value)) } }
}
pub fn i64_to_isize_checked(value: i64) -> Option<isize> {
    Result::Ok(__g1_int_convert_checked_to_isize(value))
}
