pub fn work_list_len<T>(value: &WorkList<T>) -> usize { vec_len(&value.storage) }
pub fn work_list_is_empty<T>(value: &WorkList<T>) -> Bool { vec_is_empty(&value.storage) }
pub fn work_list_push<T>(value: &mut WorkList<T>, item: T) -> () { vec_push(&mut value.storage, item) }
pub fn work_list_pop<T>(value: &mut WorkList<T>) -> Option<T> { vec_pop(&mut value.storage) }

