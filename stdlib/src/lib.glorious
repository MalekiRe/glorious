pub trait Eq { eq(left: &Self, right: &Self) -> Bool; }
pub trait Ord { compare(left: &Self, right: &Self) -> Ordering; }
pub trait Hash { hash(value: &Self, state: &mut Hasher) -> (); }
pub trait Display { display(value: &Self, formatter: &mut Formatter) -> (); }
pub trait Debug { debug(value: &Self, formatter: &mut Formatter) -> (); }

// Formatting is an ordinary source-owned String buffer. Hashing remains a
// separate deterministic state object because collection lookup will use it
// without exposing VM representation details.
pub struct Hasher { private state: usize }
pub struct Formatter { private output: String }

pub fn hasher_new() -> Hasher { Hasher { state: 5381 } }
pub fn hasher_write_usize(value: &mut Hasher, input: usize) -> () {
    // Hash accumulation is deliberately wrapping.  A deterministic hasher
    // must remain total for every sequence of caller-provided words rather
    // than exposing arithmetic overflow as a collection operation failure.
    (*value).state = __g1_int_wrapping_add((*value).state * 33, input);
}
pub fn hasher_finish(value: Hasher) -> usize { value.state }
pub fn formatter_new() -> Formatter { Formatter { output: string_new() } }
pub fn formatter_write_str(value: &mut Formatter, text: Str) -> () {
    string_push_str(&mut value.output, text)
}
pub fn formatter_into_string(value: Formatter) -> String { value.output }
pub fn format_value<T>(value: &T) -> String where T: Display {
    let formatter = formatter_new();
    Display::display(value, &mut formatter);
    formatter_into_string(formatter)
}
pub fn format_debug_value<T>(value: &T) -> String where T: Debug {
    let formatter = formatter_new();
    Debug::debug(value, &mut formatter);
    formatter_into_string(formatter)
}

pub let Hasher::new = hasher_new;
pub let Hasher::write_usize = hasher_write_usize;
pub let Hasher::finish = hasher_finish;
pub let Formatter::new = formatter_new;
pub let Formatter::write_str = formatter_write_str;
pub let Formatter::into_string = formatter_into_string;
pub let format = format_value;
pub let format_debug = format_debug_value;

pub impl Eq for i64 { eq(left: &i64, right: &i64) -> Bool { *left == *right } }
pub impl Eq for usize { eq(left: &usize, right: &usize) -> Bool { *left == *right } }
pub impl Ord for String {
    compare(left: &String, right: &String) -> Ordering {
        let left_view = string_as_str(left);
        let right_view = string_as_str(right);
        slice_lex_compare(str_as_bytes(left_view), str_as_bytes(right_view))
    }
}
pub impl Eq for String {
    eq(left: &String, right: &String) -> Bool {
        handle Ord::compare(left, right) { Ordering::Equal => true, _ => false }
    }
}
fn hash_string_bytes(bytes: Slice<u8>, state: &mut Hasher, cursor: usize) -> () {
    handle cursor < slice_len(&bytes) {
        false => (),
        true => {
            hasher_write_usize(&mut *state, as<usize>(*slice_get_unchecked(bytes, cursor)));
            hash_string_bytes(bytes, state, cursor + 1)
        },
    }
}
pub impl Hash for String {
    hash(value: &String, state: &mut Hasher) -> () {
        hasher_write_usize(&mut *state, string_len(value));
        let view = string_as_str(value);
        hash_string_bytes(str_as_bytes(view), state, 0)
    }
}
