// `String` owns an ordinary byte vector. Its constructors and mutators are
// responsible for the UTF-8 invariant; `Str` is the immutable borrowed view
// returned from that storage and never exposes mutable bytes.
pub struct String { private storage: Vec<u8> }
pub struct Utf8Error {
    private bytes: Vec<u8>,
    private valid_up_to: usize,
}

pub fn string_new() -> String { String { storage: vec_new() } }
pub fn string_from_utf8(value: Vec<u8>) -> Result<String, Utf8Error> {
    let valid_up_to = __g1_array_utf8_valid_up_to(&value.storage);
    handle valid_up_to == vec_len(&value) {
        true => Result::Ok(String { storage: value }),
        false => Result::Err(Utf8Error {
            bytes: value,
            valid_up_to: valid_up_to,
        }),
    }
}
pub fn string_len(value: &String) -> usize { vec_len(&value.storage) }
pub fn string_is_empty(value: &String) -> Bool {
    handle string_len(value) { 0 => true, _ => false }
}
pub fn string_push(value: &mut String, character: char) -> () {
    vec_push_utf8_char(&mut value.storage, character)
}
pub fn string_push_str(value: &mut String, source: Str) -> () {
    vec_extend_from_slice(&mut value.storage, source.bytes)
}
pub fn string_insert(value: &mut String, index: usize, source: Str) -> Result<(), StringRangeError> {
    handle __g1_array_insert_utf8_from_slice(
        &mut value.storage.storage,
        index,
        source.bytes.storage,
        source.bytes.start,
        source.bytes.length,
    ) {
        0 => Result::Err(StringRangeError::NotCharBoundary),
        _ => Result::Ok(()),
    }
}
pub fn string_pop(value: &mut String) -> Option<char> {
    handle __g1_array_pop_utf8_char(&mut value.storage.storage) {
        (character, 0) => Result::Err(()),
        (character, _) => Result::Ok(character),
    }
}
fn string_remove_character_info(storage: &Vec<u8>, index: usize) -> Result<(char, usize), StringRangeError> {
    let view = Str { bytes: vec_as_slice(storage) };
    handle index > str_len(view) {
        true => Result::Err(StringRangeError::OutOfBounds),
        false => handle str_is_char_boundary(view, index) {
            false => Result::Err(StringRangeError::NotCharBoundary),
            true => handle __g1_array_utf8_char_at(
                &storage.storage,
                0,
                vec_len(storage),
                index,
            ) {
                (character, 0) => Result::Err(StringRangeError::OutOfBounds),
                (character, width) => Result::Ok((character, width)),
            },
        },
    }
}
pub fn string_remove(value: &mut String, index: usize) -> Result<char, StringRangeError> {
    handle string_remove_character_info(&value.storage, index) {
        Result::Err(error) => Result::Err(error),
        Result::Ok((character, width)) => {
            handle width {
                1 => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                    _ => Result::Ok(character),
                },
                2 => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                    _ => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                        _ => Result::Ok(character),
                    },
                },
                3 => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                    _ => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                        _ => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                            _ => Result::Ok(character),
                        },
                    },
                },
                4 => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                    _ => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                        _ => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                            _ => handle __g1_array_remove_move(&mut value.storage.storage, index) {
                                _ => Result::Ok(character),
                            },
                        },
                    },
                },
                _ => Result::Err(StringRangeError::OutOfBounds),
            }
        },
    }
}
pub fn str_to_string(source: Str) -> String {
    let value = string_new();
    string_push_str(&mut value, source);
    value
}
pub fn string_as_str<'a>(value: &'a String) -> Str<'a> {
    Str<'a> { bytes: vec_as_slice(&value.storage) }
}
pub fn utf8_error_valid_up_to(value: &Utf8Error) -> usize { value.valid_up_to }
pub fn utf8_error_into_bytes(value: Utf8Error) -> Vec<u8> { value.bytes }

