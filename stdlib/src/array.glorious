// Fixed arrays are contiguous intrinsic layouts; their ownership algorithms
// are source implementations over general raw-storage leaves (§14).
pub fn array_as_slice<'a,T,const N: usize>(value: &'a [T;N]) -> Slice<'a,T> {
    unsafe {
        Slice { storage: __g1_memory_borrow_shared(__g1_memory_cast_const<[T;N],()>(
            __g1_memory_as_raw_shared(value))), length: N }
    }
}
pub fn array_as_mut_slice<'a,T,const N: usize>(value: &'a mut [T;N]) -> SliceMut<'a,T> {
    unsafe {
        SliceMut { storage: __g1_memory_borrow_unique(__g1_memory_cast<[T;N],()>(
            __g1_memory_as_raw_unique(value))), length: N }
    }
}
// Safety: source holds count initialized T residents, destination has reserved
// capacity, and no caller may read/drop the moved source residents afterward.
unsafe fn array_move_to_vec<T>(source: *mut T, output: &mut Vec<T>, index: usize, count: usize) {
    handle index == count {
        true => (),
        false => {
            let item = unsafe { __g1_memory_read(__g1_memory_as_const(__g1_memory_offset(source, index))) };
            Vec::push(&mut *output, item);
            unsafe { tail array_move_to_vec(source, output, index + 1, count) }
        },
    }
}
pub fn array_into_vec<T,const N: usize>(value: [T;N]) -> Vec<T> {
    let mut value = value;
    let mut output = Vec::with_capacity(N);
    let pointer = unsafe { __g1_memory_cast<[T;N],T>(__g1_memory_as_raw_unique(&mut value)) };
    unsafe {
        array_move_to_vec(pointer, &mut output, 0, N);
        // Every logical resident is now in output, including zero-sized T.
        __g1_memory_forget(value);
    };
    output
}
pub fn array_try_from_vec<T,const N: usize>(value: Vec<T>) -> Result<[T;N],Vec<T>> {
    let mut value = value;
    handle Vec::len(&value) == N {
        false => Result::Err(value),
        true => {
            let pointer = unsafe { __g1_memory_allocate(size_of<[T;N]>(), align_of<[T;N]>()) };
            handle unsafe { __g1_memory_is_null(pointer) } != 0 { true => __g1_abort(), false => () };
            let typed = unsafe { __g1_memory_cast<u8,T>(pointer) };
            unsafe { __g1_memory_copy_nonoverlapping(__g1_memory_as_const(value.pointer), typed, N) };
            (*&mut value).length = 0;
            let array = unsafe { __g1_memory_read(__g1_memory_cast_const<T,[T;N]>(__g1_memory_as_const(typed))) };
            unsafe { __g1_memory_deallocate(pointer, size_of<[T;N]>(), align_of<[T;N]>()) };
            handle Vec::finish_empty(value) { Result::Ok(_) => Result::Ok(array), Result::Err(_) => __g1_abort() }
        },
    }
}
fn array_fill_from<'env,Env,T,F,e: EffectRow>(body: &mut F, output: &mut Vec<T>, index: usize, count: usize) / { | e }
where Env: Environment<'env>,
    for<'call> &'call mut F: Fn<(usize,),Output=T,Effects=e>,
    for<'call> &'call mut F: RunsIn<&'call mut Env,(usize,),After=Env> {
    handle index == count {
        true => (),
        false => { Vec::push(&mut *output, body(index)); tail array_fill_from(body, output, index + 1, count) },
    }
}
pub fn array_from_fn<'env,Env,T,F,const N: usize,e: EffectRow>(body: &mut F) -> [T;N] / { | e }
where Env: Environment<'env>,
    for<'call> &'call mut F: Fn<(usize,),Output=T,Effects=e>,
    for<'call> &'call mut F: RunsIn<&'call mut Env,(usize,),After=Env> {
    let mut output = Vec::with_capacity(N);
    array_fill_from(body, &mut output, 0, N);
    handle array_try_from_vec(output) { Result::Ok(array) => array, Result::Err(_) => __g1_abort() }
}
