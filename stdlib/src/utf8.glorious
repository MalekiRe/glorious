pub mod utf8 {
    use crate::*;
    pub enum Utf8ErrorKind { InvalidLead, InvalidContinuation, Overlong, Surrogate, OutOfRange, Truncated }
    pub struct Utf8Error { pub valid_up_to: usize, pub error_length: Option<usize>, pub kind: Utf8ErrorKind }

    fn tail_bytes(bytes: Slice<u8>, start: usize, width: usize, used: usize, scalar: u32, lead: u8)
        -> Result<(char,usize),Utf8Error> {
        handle used == width {
            true => handle crate::char_from_u32(scalar) {
                Result::Ok(character) => Result::Ok((character, width)), Result::Err(_) => crate::__g1_abort(),
            },
            false => handle used >= Slice::len(&bytes) - start {
                true => Result::Err(Utf8Error { valid_up_to: start, error_length: None, kind: Utf8ErrorKind::Truncated }),
                false => {
                    let byte = *Slice::get_unchecked(bytes, start + used);
                    handle byte < 128 {
                        true => return(Result::Err(Utf8Error { valid_up_to: start, error_length: Some(used), kind: Utf8ErrorKind::InvalidContinuation }), @tail_bytes),
                        false => (),
                    };
                    handle byte >= 192 {
                        true => return(Result::Err(Utf8Error { valid_up_to: start, error_length: Some(used), kind: Utf8ErrorKind::InvalidContinuation }), @tail_bytes),
                        false => (),
                    };
                    handle used == 1 {
                        false => (),
                        true => handle lead {
                            224 => handle byte < 160 {
                                true => return(Result::Err(Utf8Error { valid_up_to: start, error_length: Some(1), kind: Utf8ErrorKind::Overlong }), @tail_bytes), false => (),
                            },
                            237 => handle byte >= 160 {
                                true => return(Result::Err(Utf8Error { valid_up_to: start, error_length: Some(1), kind: Utf8ErrorKind::Surrogate }), @tail_bytes), false => (),
                            },
                            240 => handle byte < 144 {
                                true => return(Result::Err(Utf8Error { valid_up_to: start, error_length: Some(1), kind: Utf8ErrorKind::Overlong }), @tail_bytes), false => (),
                            },
                            244 => handle byte >= 144 {
                                true => return(Result::Err(Utf8Error { valid_up_to: start, error_length: Some(1), kind: Utf8ErrorKind::OutOfRange }), @tail_bytes), false => (),
                            },
                            _ => (),
                        },
                    };
                    tail tail_bytes(bytes, start, width, used + 1, scalar * 64 + as<u32>(byte - 128), lead)
                },
            },
        }
    }
    pub(crate) fn decode_at(bytes: Slice<u8>, start: usize) -> Result<(char,usize),Utf8Error> {
        handle start == Slice::len(&bytes) {
            true => Result::Err(Utf8Error { valid_up_to: start, error_length: None, kind: Utf8ErrorKind::Truncated }),
            false => {
                let lead = *Slice::get_unchecked(bytes, start);
                handle lead < 128 {
                    true => Result::Ok((crate::__g1_char_from_u32_checked(as<u32>(lead)), 1)),
                    false => handle lead < 194 {
                        true => Result::Err(Utf8Error { valid_up_to: start, error_length: Some(1), kind: handle lead >= 192 {
                            true => Utf8ErrorKind::Overlong, false => Utf8ErrorKind::InvalidLead,
                        } }),
                        false => handle lead < 224 {
                            true => tail_bytes(bytes, start, 2, 1, as<u32>(lead - 192), lead),
                            false => handle lead < 240 {
                                true => tail_bytes(bytes, start, 3, 1, as<u32>(lead - 224), lead),
                                false => handle lead < 245 {
                                    true => tail_bytes(bytes, start, 4, 1, as<u32>(lead - 240), lead),
                                    false => Result::Err(Utf8Error { valid_up_to: start, error_length: Some(1), kind: Utf8ErrorKind::OutOfRange }),
                                },
                            },
                        },
                    },
                }
            },
        }
    }
    fn validate_from(bytes: Slice<u8>, index: usize) -> Result<(),Utf8Error> {
        handle index == Slice::len(&bytes) {
            true => Result::Ok(()),
            false => handle decode_at(bytes, index) {
                Result::Err(error) => Result::Err(error),
                Result::Ok((_, width)) => tail validate_from(bytes, index + width),
            },
        }
    }
    pub fn validate_utf8(bytes: Slice<u8>) -> Result<(),Utf8Error> { validate_from(bytes, 0) }
    pub fn utf8_valid_prefix(bytes: Slice<u8>) -> usize {
        handle validate_utf8(bytes) { Result::Ok(_) => Slice::len(&bytes), Result::Err(error) => error.valid_up_to }
    }
    pub fn str_from_utf8<'a>(bytes: Slice<'a,u8>) -> Result<Str<'a>,Utf8Error> {
        handle validate_utf8(bytes) { Result::Ok(_) => Result::Ok(Str { bytes: bytes }), Result::Err(error) => Result::Err(error) }
    }
    fn lower(byte: u8) -> u8 {
        handle byte >= 65 { false => byte, true => handle byte <= 90 { true => byte + 32, false => byte } }
    }
    fn upper(byte: u8) -> u8 {
        handle byte >= 97 { false => byte, true => handle byte <= 122 { true => byte - 32, false => byte } }
    }
    fn ascii_eq_from(left: Slice<u8>, right: Slice<u8>, index: usize) -> Bool {
        handle index == Slice::len(&left) {
            true => true,
            false => handle lower(*Slice::get_unchecked(left, index)) == lower(*Slice::get_unchecked(right, index)) {
                false => false, true => tail ascii_eq_from(left, right, index + 1),
            },
        }
    }
    pub fn ascii_eq_ignore_case(left: Slice<u8>, right: Slice<u8>) -> Bool {
        handle Slice::len(&left) == Slice::len(&right) { false => false, true => ascii_eq_from(left, right, 0) }
    }
    fn ascii_convert(bytes: SliceMut<u8>, uppercase: Bool) {
        handle SliceMut::len(&bytes) == 0 {
            true => (),
            false => handle SliceMut::split_at(bytes, 1) {
                Result::Err(_) => crate::__g1_abort(),
                Result::Ok((first, rest)) => {
                    let resident = SliceMut::get_unchecked(first, 0);
                    *resident = handle uppercase { true => upper(*resident), false => lower(*resident) };
                    tail ascii_convert(rest, uppercase)
                },
            },
        }
    }
    pub fn ascii_lowercase_in_place(bytes: SliceMut<u8>) { ascii_convert(bytes, false) }
    pub fn ascii_uppercase_in_place(bytes: SliceMut<u8>) { ascii_convert(bytes, true) }
}
pub struct ScalarError { pub code_point: u32 }
impl char {
    pub fn from_u32(value: u32) -> Result<char,ScalarError> {
        handle char_from_u32(value) { Result::Ok(value) => Result::Ok(value), Result::Err(_) => Result::Err(ScalarError { code_point: value }) }
    }
    pub fn to_u32(value: char) -> u32 { char_to_u32(value) }
    pub fn is_valid_scalar(value: u32) -> Bool { handle char_from_u32(value) { Result::Ok(_) => true, Result::Err(_) => false } }
    pub fn len_utf8(value: char) -> usize { char_utf8_len(value) }
    pub fn decode_utf8(bytes: Slice<u8>) -> Result<(char,usize),utf8::Utf8Error> { utf8::decode_at(bytes, 0) }
    pub fn is_ascii(value: char) -> Bool { char_to_u32(value) < 128 }
    pub fn is_ascii_lowercase(value: char) -> Bool {
        let scalar = char_to_u32(value);
        handle scalar >= 97 { false => false, true => scalar <= 122 }
    }
    pub fn is_ascii_uppercase(value: char) -> Bool {
        let scalar = char_to_u32(value);
        handle scalar >= 65 { false => false, true => scalar <= 90 }
    }
    pub fn is_ascii_alphabetic(value: char) -> Bool {
        handle Self::is_ascii_lowercase(value) { true => true, false => Self::is_ascii_uppercase(value) }
    }
    pub fn is_ascii_digit(value: char) -> Bool {
        let scalar = char_to_u32(value);
        handle scalar >= 48 { false => false, true => scalar <= 57 }
    }
    pub fn is_ascii_alphanumeric(value: char) -> Bool {
        handle Self::is_ascii_digit(value) { true => true, false => Self::is_ascii_alphabetic(value) }
    }
    pub fn is_ascii_hexdigit(value: char) -> Bool {
        handle Self::to_digit(value, 16) { Result::Ok(_) => true, Result::Err(_) => false }
    }
    pub fn is_ascii_whitespace(value: char) -> Bool {
        handle char_to_u32(value) { 9 => true, 10 => true, 12 => true, 13 => true, 32 => true, _ => false }
    }
    pub fn is_ascii_control(value: char) -> Bool {
        let scalar = char_to_u32(value);
        handle scalar < 32 { true => true, false => scalar == 127 }
    }
    pub fn is_ascii_punctuation(value: char) -> Bool {
        let scalar = char_to_u32(value);
        handle scalar >= 33 {
            false => false,
            true => handle scalar <= 126 { false => false, true => not(Self::is_ascii_alphanumeric(value)) },
        }
    }
    pub fn to_ascii_lowercase(value: char) -> char {
        handle Self::is_ascii_uppercase(value) { true => __g1_char_from_u32_checked(char_to_u32(value) + 32), false => value }
    }
    pub fn to_ascii_uppercase(value: char) -> char {
        handle Self::is_ascii_lowercase(value) { true => __g1_char_from_u32_checked(char_to_u32(value) - 32), false => value }
    }
    pub fn to_digit(value: char, radix: u32) -> Option<u32> {
        handle radix < 2 {
            true => None,
            false => handle radix > 36 {
                true => None,
                false => handle char_to_u32(value) > 127 {
                    true => None,
                    false => handle integer_digit(as<u8>(char_to_u32(value))) {
                        Result::Err(_) => None, Result::Ok(digit) => handle digit < radix { true => Some(digit), false => None },
                    },
                },
            },
        }
    }
    pub fn from_digit(value: u32, radix: u32) -> Option<char> {
        handle radix < 2 { true => None, false => handle radix > 36 { true => None, false => handle value >= radix {
            true => None,
            false => Some(__g1_char_from_u32_checked(handle value < 10 { true => 48 + value, false => 97 + value - 10 })),
        } } }
    }
}
