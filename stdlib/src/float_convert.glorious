// Remaining 52 scalar conversion pairs: integer/float and float/float.
// Range checks use the exact represented value, never a saturating round trip.
fn float_conversion_integer(bits: u64, width: u32, mantissa_bits: u32, bias: i32, target_bits: u32, signed: Bool, exact: Bool)
    -> Result<(),ConversionError> {
    let sign_mask = bit_shl(as<u64>(1), width - 1);
    let magnitude = bit_and(bits, sign_mask - 1);
    let infinity = bit_shl(bit_shl(as<u64>(1), width - mantissa_bits - 1) - 1, mantissa_bits);
    handle magnitude >= infinity { true => return(Result::Err(ConversionError::NonFinite), @float_conversion_integer), false => () };
    let negative = handle magnitude == 0 { true => false, false => bit_and(bits, sign_mask) != 0 };
    handle negative { true => handle signed { false => return(Result::Err(ConversionError::OutOfRange), @float_conversion_integer), true => () }, false => () };
    let (mantissa, exponent) = float_dyadic(magnitude, mantissa_bits, bias);
    let value = FloatDyadic { magnitude: float_big_from(mantissa), exponent: exponent, negative: false };
    let limit_exponent = target_bits - handle signed { true => 1, false => 0 };
    let limit = FloatDyadic { magnitude: float_big_from(1), exponent: as<i128>(limit_exponent), negative: false };
    handle float_math_compare(&value, &limit) {
        Ordering::Greater => return(Result::Err(ConversionError::OutOfRange), @float_conversion_integer),
        Ordering::Equal => handle negative { true => (), false => return(Result::Err(ConversionError::OutOfRange), @float_conversion_integer) },
        Ordering::Less => (),
    };
    handle exact {
        false => (),
        true => handle exponent < 0 {
            false => (),
            true => {
                let fractional = handle exponent <= -64 {
                    true => mantissa != 0,
                    false => bit_and(mantissa, bit_shl(as<u64>(1), as<u32>(0 - exponent)) - 1) != 0,
                };
                handle fractional { true => return(Result::Err(ConversionError::Fractional), @float_conversion_integer), false => () };
            },
        },
    };
    Result::Ok(())
}
fn float_conversion_exact_integer(magnitude: u128, bits: u64, width: u32, mantissa_bits: u32, bias: i32) -> Bool {
    let sign_mask = bit_shl(as<u64>(1), width - 1);
    let (mantissa, exponent) = float_dyadic(bit_and(bits, sign_mask - 1), mantissa_bits, bias);
    let integer = FloatDyadic { magnitude: float_big_from128(magnitude), exponent: 0, negative: false };
    let rounded = FloatDyadic { magnitude: float_big_from(mantissa), exponent: exponent, negative: false };
    handle float_math_compare(&integer, &rounded) { Ordering::Equal => true, _ => false }
}

pub impl TryAs<u8> for f32 {
    type Error = ConversionError;
    fn try_cast(value: f32) -> Result<u8,ConversionError> {
        handle float_conversion_integer(as<u64>(f32::to_bits(value)), 32, 23, 127, 8, false, false) {
            Result::Ok(()) => Result::Ok(as<u8>(value)), Result::Err(error) => Result::Err(error),
        }
    }
}
pub impl ExactAs<u8> for f32 {
    type Error = ConversionError;
    fn exact_cast(value: f32) -> Result<u8,ConversionError> {
        handle float_conversion_integer(as<u64>(f32::to_bits(value)), 32, 23, 127, 8, false, true) {
            Result::Ok(()) => Result::Ok(as<u8>(value)), Result::Err(error) => Result::Err(error),
        }
    }
}
pub impl TryAs<f32> for u8 {
    type Error = ConversionError;
    fn try_cast(value: u8) -> Result<f32,ConversionError> {
        let converted = as<f32>(value);
        handle f32::is_infinite(converted) {
            true => Result::Err(ConversionError::OutOfRange), false => Result::Ok(converted),
        }
    }
}
pub impl ExactAs<f32> for u8 {
    type Error = ConversionError;
    fn exact_cast(value: u8) -> Result<f32,ConversionError> {
        handle TryAs<f32>::try_cast(value) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(converted) => handle float_conversion_exact_integer(as<u128>(num_u8_magnitude(value)), as<u64>(f32::to_bits(converted)), 32, 23, 127) {
                true => Result::Ok(converted), false => Result::Err(ConversionError::PrecisionLoss),
            },
        }
    }
}

