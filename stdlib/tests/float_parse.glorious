fn parsed32(text: Str, bits: u32) {
    assert_true(handle f32::parse(text) { Result::Ok(value) => f32::to_bits(value) == bits, _ => false });
}
fn parsed64(text: Str, bits: u64) {
    assert_true(handle f64::parse(text) { Result::Ok(value) => f64::to_bits(value) == bits, _ => false });
}
pub fn main() -> i64 {
    parsed64("0", 0);
    parsed64("-0.000e99999999999999999999999999999999999999999999999", 9223372036854775808);
    parsed64("+1.5", 4609434218613702656);
    parsed64("12.5E+1", f64::to_bits(125.0));
    parsed64("125e-1", f64::to_bits(12.5));
    parsed64("0.1", 4591870180066957722);
    parsed64("1.00000000000000011102230246251565404236316680908203125", 4607182418800017408);
    parsed64("1.00000000000000011102230246251565404236316680908203125001", 4607182418800017409);
    parsed64("1.7976931348623157e308", 9218868437227405311);
    parsed64("5e-324", 1);
    parsed64("2e-324", 0);
    parsed64("3e-324", 1);
    parsed64("-1e-9999999999999999999999999999999999999999999999", 9223372036854775808);
    parsed32("1.000000059604644775390625", 1065353216);
    // This is above the f32 midpoint by less than an f64 ulp. Parsing through
    // f64 first would incorrectly erase that fact and round down to even.
    parsed32("1.00000005960464477539062500000000000001", 1065353217);
    parsed32("3.4028234663852886e38", 2139095039);
    parsed32("1e-45", 1);
    parsed32("7e-46", 0);
    parsed32("8e-46", 1);
    parsed32("nan", 2143289344);
    parsed64("-inf", 18442240474082181120);
    assert_true(handle f64::parse("1.7976931348623159e308") { Result::Err(error) => handle error.kind { FloatParseErrorKind::Overflow => true, _ => false }, _ => false });
    assert_true(handle f64::parse("1e+") { Result::Err(error) => handle error.kind { FloatParseErrorKind::InvalidExponent => error.offset == 3, _ => false }, _ => false });
    assert_true(handle f64::parse("1e/") { Result::Err(error) => handle error.kind { FloatParseErrorKind::InvalidExponent => error.offset == 2, _ => false }, _ => false });
    assert_true(handle f64::parse("1e:") { Result::Err(error) => handle error.kind { FloatParseErrorKind::InvalidExponent => error.offset == 2, _ => false }, _ => false });
    assert_true(handle f64::parse("1e9x") { Result::Err(error) => handle error.kind { FloatParseErrorKind::InvalidExponent => error.offset == 3, _ => false }, _ => false });
    assert_true(handle f64::parse("x") { Result::Err(error) => handle error.kind { FloatParseErrorKind::InvalidDigit => error.offset == 0, _ => false }, _ => false });
    assert_true(handle f64::parse("1x") { Result::Err(error) => handle error.kind { FloatParseErrorKind::TrailingInput => error.offset == 1, _ => false }, _ => false });
    assert_true(handle f64::parse("1_0") { Result::Err(error) => handle error.kind { FloatParseErrorKind::InvalidSeparator => error.offset == 1, _ => false }, _ => false });
    assert_true(handle f64::parse("1.2.3") { Result::Err(error) => handle error.kind { FloatParseErrorKind::TrailingInput => error.offset == 3, _ => false }, _ => false });
    42
}
