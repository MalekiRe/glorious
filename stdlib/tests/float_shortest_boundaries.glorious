fn boundary64(bits: u64, expected: Str) {
    let text = f64::format_shortest(f64::from_bits(bits));
    assert_true(PartialEq::eq(&String::as_str(&text), &expected));
    assert_true(handle f64::parse(String::as_str(&text)) {
        Result::Ok(value) => f64::to_bits(value) == bits, _ => false,
    });
}
fn boundary32(bits: u32, expected: Str) {
    let text = f32::format_shortest(f32::from_bits(bits));
    assert_true(PartialEq::eq(&String::as_str(&text), &expected));
    assert_true(handle f32::parse(String::as_str(&text)) {
        Result::Ok(value) => f32::to_bits(value) == bits, _ => false,
    });
}
pub fn main() -> i64 {
    // Above 2^54 the f64 spacing is four. Decimal grid points ending in 0
    // can be exact midpoints, admitted only by the even target significand.
    boundary64(4850376798678024192, "1.8014398509481984e+16");
    boundary64(4850376798678024193, "1.8014398509481988e+16");
    boundary64(4850376798678024194, "1.801439850948199e+16");
    boundary64(4850376798678024198, "1.801439850948201e+16");
    boundary64(4850376798678024199, "1.8014398509482012e+16");
    // The same lower/upper endpoint distinction at f32 precision (spacing 8).
    boundary32(1283457028, "6.71089e+7");
    boundary32(1283457029, "6.7108904e+7");
    boundary32(1283457033, "6.7108936e+7");
    boundary32(1283457034, "6.710894e+7");
    // A carried prefix changes the printed exponent, not the candidate ratio.
    boundary64(4950912855330343670, "1e+23");
    boundary64(bit_or(4950912855330343670, 9223372036854775808), "-1e+23");
    boundary64(bit_or(4591870180066957722, 9223372036854775808), "-1e-1");
    boundary64(bit_or(4850376798678024194, 9223372036854775808), "-1.801439850948199e+16");
    42
}
