pub fn main() -> i64 {
    let negative_zero = f64::from_bits(9223372036854775808);
    let positive_zero = f64::zero();
    assert_true(f64::to_bits(negative_zero) == 9223372036854775808);
    assert_true(f64::ieee_eq(negative_zero, f64::zero()));
    assert_true(PartialEq::eq(&negative_zero, &positive_zero));
    assert_true(handle PartialOrd::partial_cmp(&negative_zero, &positive_zero) { Some(Ordering::Equal) => true, _ => false });
    assert_true(handle f64::total_cmp(negative_zero, f64::zero()) { Ordering::Less => true, _ => false });
    let nan = f64::from_bits(18446744073709551615);
    assert_true(f64::to_bits(nan) == 9221120237041090560);
    assert_true(not(PartialEq::eq(&nan, &nan)));
    assert_true(handle PartialOrd::partial_cmp(&nan, &nan) { None => true, _ => false });
    assert_true(handle f64::ieee_partial_cmp(nan, nan) { Result::Err(_) => true, _ => false });
    assert_true(handle f64::total_cmp(f64::infinity(), nan) { Ordering::Less => true, _ => false });
    assert_true(f32::to_bits(f32::from_bits(4294967295)) == 2143289344);
    assert_true(f32::to_bits(f32::next_up(f32::zero())) == 1);
    assert_true(f32::to_bits(f32::next_down(f32::zero())) == 2147483649);
    assert_true(f64::to_bits(f64::next_down(f64::infinity())) == 9218868437227405311);
    assert_true(f64::to_bits(f64::next_up(f64::neg_infinity())) == 18442240474082181119);
    assert_true(f64::ieee_eq(f64::trunc(-1.75), -1.0));
    assert_true(f64::ieee_eq(f64::floor(-1.75), -2.0));
    assert_true(f64::ieee_eq(f64::ceil(-1.75), -1.0));
    assert_true(f64::ieee_eq(f64::round_ties_even(2.5), 2.0));
    assert_true(f64::ieee_eq(f64::round_ties_even(3.5), 4.0));
    assert_true(f64::to_bits(f64::round_ties_even(-0.5)) == 9223372036854775808);
    assert_true(f64::to_bits(f64::min_num(negative_zero, f64::zero())) == 9223372036854775808);
    assert_true(f64::to_bits(f64::max_num(negative_zero, f64::zero())) == 0);
    assert_true(f64::ieee_eq(f64::min_num(nan, f64::one()), f64::one()));
    42
}
