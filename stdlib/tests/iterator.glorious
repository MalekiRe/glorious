struct Pulse { polls: usize }
impl Iterator for Pulse {
    type Item = i64;
    type Effects = {};
    fn next(value: &mut Self) -> Option<i64> {
        let index = value.polls;
        (*value).polls = index + 1;
        handle index { 0 => Some(1), 2 => Some(3), _ => None }
    }
    fn size_hint(value: &Self) -> (usize,Option<usize>) { (0, None) }
}
struct Ticket { number: i64 }
impl Use<[1,1]> for Ticket {}
struct CountSteps { remaining: i64 }
impl Use<[1,1]> for CountSteps {}
impl OwnedStepper for CountSteps {
    type Item = Ticket;
    type Effects = {};
    fn step(value: Self) -> Step<Ticket,Self> {
        let CountSteps { remaining: count } = value;
        handle count == 0 {
            true => Step::Done,
            false => Step::Yield { item: Ticket { number: count }, rest: CountSteps { remaining: count - 1 } },
        }
    }
}
fn sum_tickets(source: VecIntoIter<Ticket>, total: i64) -> i64 {
    handle OwnedStepper::step(source) {
        Step::Done => total,
        Step::Yield { item: Ticket { number: number }, rest: rest } => tail sum_tickets(rest, total + number),
    }
}
fn numbers() -> Vec<i64> {
    let mut values = Vec::new();
    Vec::push(&mut values, 10); Vec::push(&mut values, 20); Vec::push(&mut values, 30);
    values
}
pub fn main() -> i64 {
    let mut source = fuse(Pulse { polls: 0 });
    assert_true(handle Iterator::next(&mut source) { Result::Ok(1) => true, _ => false });
    assert_true(handle Iterator::next(&mut source) { Result::Err(_) => true, _ => false });
    assert_true(handle Iterator::next(&mut source) { Result::Err(_) => true, _ => false });
    let mut original = Fuse::into_inner(source);
    assert_true(original.polls == 2);
    assert_true(handle Iterator::next(&mut original) { Result::Ok(3) => true, _ => false });

    let mut source = peekable(Pulse { polls: 0 });
    assert_true(handle Peekable::peek(&mut source) { Result::Ok(item) => *item == 1, _ => false });
    assert_true(handle Peekable::peek(&mut source) { Result::Ok(item) => *item == 1, _ => false });
    let (original, cached) = Peekable::into_parts(source);
    assert_true(original.polls == 1);
    assert_true(handle cached { Result::Ok(1) => true, _ => false });

    let mut source = take_iter(enumerate(Vec::into_iter(numbers())), 2);
    assert_true(handle Iterator::next(&mut source) { Result::Ok((0,10)) => true, _ => false });
    assert_true(handle Iterator::next(&mut source) { Result::Ok((1,20)) => true, _ => false });
    assert_true(handle Iterator::next(&mut source) { Result::Err(_) => true, _ => false });
    let (numbered, remaining) = Take::into_parts(source);
    assert_true(remaining == 0);
    let (rest, index) = Enumerate::into_parts(numbered);
    let mut rest = rest;
    assert_true(index == 2);
    assert_true(handle Iterator::next(&mut rest) { Result::Ok(30) => true, _ => false });

    let mut right = Vec::new(); Vec::push(&mut right, 1);
    let mut pairs = zip(Vec::into_iter(numbers()), Vec::into_iter(right));
    assert_true(handle Iterator::next(&mut pairs) { Result::Ok((10,1)) => true, _ => false });
    assert_true(handle Iterator::next(&mut pairs) { Result::Err(_) => true, _ => false });
    let (left, right, buffered_left, buffered_right) = Zip::into_parts(pairs);
    let mut left = left;
    assert_true(handle buffered_left { Result::Ok(20) => true, _ => false });
    assert_true(handle buffered_right { Result::Err(_) => true, _ => false });
    assert_true(ExactSizeIterator::len(&right) == 0);
    assert_true(handle Iterator::next(&mut left) { Result::Ok(30) => true, _ => false });

    let data = numbers();
    let mut backwards = rev(Vec::iter(&data));
    assert_true(handle Iterator::next(&mut backwards) { Result::Ok(item) => *item == 30, _ => false });
    assert_true(handle DoubleEndedIterator::next_back(&mut backwards) { Result::Ok(item) => *item == 10, _ => false });
    assert_true(ExactSizeIterator::len(&backwards) == 1);
    assert_true(count_iter(skip_iter(Vec::into_iter(numbers()), 1)) == 2);
    let tickets = collect_vec(CountSteps { remaining: 3 });
    assert_true(sum_tickets(Vec::into_iter(tickets), 0) == 6);
    42
}
