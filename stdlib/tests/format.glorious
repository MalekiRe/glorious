pub fn main() -> i64 {
    let mut out = fmt::Formatter::with_options(fmt::FormatOptions { indent_width: 2, maximum_output_bytes: Some(20) });
    fmt::Formatter::indent(&mut out);
    fmt::Formatter::newline(&mut out);
    fmt::Formatter::write_str(&mut out, "x\ny");
    handle fmt::Formatter::finish(out) { Result::Ok(text) => assert_bytes(Str::as_bytes(String::as_str(&text)), b"\n  x\n  y"), _ => assert_true(false) };
    let mut out = fmt::Formatter::with_options(fmt::FormatOptions { indent_width: 4, maximum_output_bytes: Some(1) });
    fmt::Formatter::write_str(&mut out, "é");
    assert_true(handle fmt::Formatter::finish(out) { Result::Err(fmt::FormatError::OutputLimit) => true, _ => false });
    let mut out = fmt::Formatter::new();
    assert_true(handle fmt::Formatter::dedent(&mut out) { Result::Err(fmt::FormatError::InvalidIndent) => true, _ => false });
    fmt::Formatter::quoted(&mut out, "a\n\"");
    handle fmt::Formatter::finish(out) { Result::Ok(text) => assert_bytes(Str::as_bytes(String::as_str(&text)), b"\"a\\n\\\"\""), _ => assert_true(false) };
    42
}
