// Reduced execution coverage for the parser's mandatory-tail reference
// carriers, local early-return labels, and short-circuit digit callbacks.
pub fn main() -> i64 {
    assert_true(handle f64::parse("1.5") {
        Result::Ok(value) => f64::to_bits(value) == 4609434218613702656,
        _ => false,
    });
    assert_true(handle f64::parse("1x") {
        Result::Err(error) => handle error.kind {
            FloatParseErrorKind::TrailingInput => error.offset == 1,
            _ => false,
        },
        _ => false,
    });
    42
}
