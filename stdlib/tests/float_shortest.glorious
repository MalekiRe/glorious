fn shortest64(bits: u64, expected: Str) {
    let value = f64::from_bits(bits);
    let text = f64::format_shortest(value);
    assert_true(Eq::eq(&String::as_str(&text), &expected));
    let parsed = Result<f64,String>::expect(handle f64::parse(String::as_str(&text)) {
        Result::Ok(value) => Result::Ok(value), Result::Err(_) => Result::Err(String::new()),
    }, "shortest float must parse");
    assert_true(f64::to_bits(parsed) == f64::to_bits(value));
}
pub fn main() -> i64 {
    shortest64(0, "0e+0");
    shortest64(9223372036854775808, "-0e+0");
    shortest64(9218868437227405312, "inf");
    shortest64(18442240474082181120, "-inf");
    shortest64(9221120237041090560, "nan");
    shortest64(4591870180066957722, "1e-1");
    shortest64(1, "5e-324");
    shortest64(4503599627370496, "2.2250738585072014e-308");
    shortest64(9218868437227405311, "1.7976931348623157e+308");
    shortest64(4607182418800017409, "1.0000000000000002e+0");
    let text = f32::format_shortest(f32::from_bits(1036831949));
    assert_true(Eq::eq(&String::as_str(&text), &"1e-1"));
    let text = f32::format_shortest(f32::from_bits(1));
    assert_true(Eq::eq(&String::as_str(&text), &"1e-45"));
    let text = f32::format_shortest(f32::max_finite());
    assert_true(Eq::eq(&String::as_str(&text), &"3.4028235e+38"));
    42
}
