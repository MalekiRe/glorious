fn exact_bits64(bits: u64, expected: Str) {
    let text = f64::format_exact(f64::from_bits(bits));
    assert_true(PartialEq::eq(&String::as_str(&text), &expected));
}
fn exact_bits32(bits: u32, expected: Str) {
    let text = f32::format_exact(f32::from_bits(bits));
    assert_true(PartialEq::eq(&String::as_str(&text), &expected));
}
pub fn main() -> i64 {
    // Independently expanded integer references: 5^1022 / 10^1022 and
    // (2^53-1)*2^971. Check every digit, including the carried low digits.
    exact_bits64(4503599627370496, "2.-308");
    exact_bits64(9218868437227405311, "1.");
    exact_bits64(bit_or(9218868437227405311, 9223372036854775808), "-1.");
    // f32: 5^149 / 10^149, 5^126 / 10^126, and (2^24-1)*2^104.
    exact_bits32(1, "1.40129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125e-45");
    exact_bits32(8388608, "1.1754943508222875079687365372222456778186655567720875215087517062784172594547271728515625e-38");
    exact_bits32(2139095039, "3.4028234663852885981170418348451692544e+38");
    42
}
