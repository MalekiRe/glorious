fn view_hash<'a>(value: &Str<'a>) -> usize {
    let mut state = Hasher::new();
    Hash::hash(value, &mut state);
    Hasher::finish(state)
}
fn string_hash(value: &String) -> usize {
    let mut state = Hasher::new();
    Hash::hash(value, &mut state);
    Hasher::finish(state)
}
pub fn main() -> i64 {
    let empty: Str<'static> = "";
    let left: Str<'static> = "hello";
    let equal: Str<'static> = "hello";
    let later: Str<'static> = "hellp";
    let prefix: Str<'static> = "hell";
    let unicode: Str<'static> = "\u{e9}";
    let decomposed: Str<'static> = "e\u{301}";
    assert_true(PartialEq::eq(&left, &equal));
    assert_true(handle PartialEq::eq(&unicode, &decomposed) { false => true, true => false });
    assert_true(handle Ord::cmp(&left, &later) { Ordering::Less => true, _ => false });
    assert_true(handle Ord::cmp(&left, &prefix) { Ordering::Greater => true, _ => false });
    assert_true(handle Ord::cmp(&empty, &left) { Ordering::Less => true, _ => false });
    assert_true(handle Ord::cmp(&unicode, &decomposed) { Ordering::Greater => true, _ => false });
    let copied = Clone::clone(&left);
    assert_true(PartialEq::eq(&copied, &left));
    let owned_left = owned(left);
    let owned_empty = owned(empty);
    let owned_unicode = owned(unicode);
    assert_true(view_hash(&left) == string_hash(&owned_left));
    assert_true(view_hash(&empty) == string_hash(&owned_empty));
    assert_true(view_hash(&unicode) == string_hash(&owned_unicode));
    let rendered = format_value(&unicode);
    let rendered_view = String::as_str(&rendered);
    assert_true(PartialEq::eq(&rendered_view, &unicode));
    42
}
