fn approx64(a: f64, b: f64, absolute: f64, relative: f64) -> Bool {
    Result<Bool,String>::expect(handle f64::approximately_equal(a, b, Tolerance { absolute: absolute, relative: relative }) {
        Result::Ok(equal) => Result::Ok(equal), Result::Err(_) => Result::Err(String::new()),
    }, "valid tolerance must compare")
}
pub fn main() -> i64 {
    // (1+2^-27)*(1-2^-27)-1 must retain the exact -2^-54 residual.
    let fused = f64::mul_add(f64::from_bits(4607182418833571840), f64::from_bits(4607182418732908544), -1.0);
    assert_true(f64::to_bits(fused) == 13587360075776786432);
    // The single-precision witness retains -2^-24, not a double-rounded zero.
    let fused = f32::mul_add(f32::from_bits(1065355264), f32::from_bits(1065349120), f32::from_bits(3212836864));
    assert_true(f32::to_bits(fused) == 3011510272);
    assert_true(f64::is_nan(f64::mul_add(f64::zero(), f64::infinity(), 1.0)));
    assert_true(f64::is_nan(f64::mul_add(f64::infinity(), 2.0, f64::neg_infinity())));
    assert_true(f64::to_bits(f64::mul_add(f64::max_finite(), 2.0, f64::zero())) == f64::to_bits(f64::infinity()));
    let negative_zero = f64::from_bits(9223372036854775808);
    assert_true(f64::to_bits(f64::mul_add(negative_zero, 1.0, negative_zero)) == 9223372036854775808);
    assert_true(f64::to_bits(f64::mul_add(negative_zero, 1.0, 0.0)) == 0);
    assert_true(approx64(0.0, negative_zero, negative_zero, negative_zero));
    assert_true(approx64(f64::infinity(), f64::infinity(), 0.0, 0.0));
    assert_true(!approx64(f64::nan(), f64::nan(), 1.0, 1.0));
    assert_true(!approx64(f64::infinity(), f64::neg_infinity(), 1.0, 1.0));
    assert_true(approx64(1.0, 1.5, 0.5, 0.0));
    assert_true(!approx64(1.0, 1.5, 0.25, 0.0));
    let maximum = f64::max_finite();
    assert_true(!approx64(maximum, -maximum, 0.0, 1.5));
    assert_true(approx64(maximum, -maximum, 0.0, 2.0));
    handle f64::approximately_equal(1.0, 1.0, Tolerance { absolute: -1.0, relative: 0.0 }) {
        Result::Err(ToleranceError::Negative) => (), _ => assert_true(false),
    };
    handle f64::approximately_equal(1.0, 1.0, Tolerance { absolute: 0.0, relative: f64::infinity() }) {
        Result::Err(ToleranceError::NonFinite) => (), _ => assert_true(false),
    };
    42
}
