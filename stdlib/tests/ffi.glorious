use std::ffi::*;
pub fn main() -> i64 {
    assert_true(handle CStr::from_bytes_with_nul(b"") { Result::Err(CStrError::MissingTerminator) => true, _ => false });
    assert_true(handle CStr::from_bytes_with_nul(b"x") { Result::Err(CStrError::MissingTerminator) => true, _ => false });
    assert_true(handle CStr::from_bytes_with_nul(b"a\x00b\x00") { Result::Err(CStrError::InteriorNul(error)) => error.position == 1, _ => false });
    let empty = handle CStr::from_bytes_with_nul(b"\x00") { Result::Ok(value) => value, _ => return(0, @main) };
    assert_bytes(CStr::bytes(empty), b"");
    let invalid = handle CStr::from_bytes_with_nul(b"\xff\x00") { Result::Ok(value) => value, _ => return(0, @main) };
    assert_true(handle CStr::to_str(invalid) { Result::Err(_) => true, _ => false });
    let mut bytes = Vec::new();
    Vec::extend_from_slice(&mut bytes, b"ab\x00cd");
    let rejected = handle CString::from_vec(bytes) { Result::Err(value) => value, _ => return(0, @main) };
    assert_true(rejected.error.position == 2);
    assert_bytes(Vec::as_slice(&rejected.value), b"ab\x00cd");
    let text = handle CString::from_str("hello") { Result::Ok(value) => value, _ => return(0, @main) };
    assert_bytes(CStr::bytes_with_nul(CString::as_c_str(&text)), b"hello\x00");
    assert_bytes(Vec::as_slice(&CString::into_bytes(text)), b"hello");
    42
}
