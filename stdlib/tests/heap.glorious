pub fn main() -> i64 {
    let mut heap = BinaryHeap<i64>::new();
    Vec::len(&BinaryHeap::into_sorted_vec(BinaryHeap<i64>::new()));
    assert_true(handle BinaryHeap::replace_top(&mut heap, 3) { Result::Err(_) => true, _ => false });
    BinaryHeap::push(&mut heap, 1); BinaryHeap::push(&mut heap, 8); BinaryHeap::push(&mut heap, 8);
    assert_true(handle BinaryHeap::pop(&mut heap) { Result::Ok(8) => true, _ => false });
    assert_true(handle BinaryHeap::replace_top(&mut heap, 2) { Result::Ok(8) => true, _ => false });
    let sorted = BinaryHeap::into_sorted_vec(heap);
    assert_true(Vec::len(&sorted) == 3);
    assert_true(handle Vec::get(&sorted, 0) { Result::Ok(value) => *value == 1, _ => false });
    assert_true(handle Vec::get(&sorted, 1) { Result::Ok(value) => *value == 2, _ => false });
    assert_true(handle Vec::get(&sorted, 2) { Result::Ok(value) => *value == 3, _ => false });
    let mut values = Vec<i64>::new();
    Vec::push(&mut values, 1); Vec::push(&mut values, 1); Vec::push(&mut values, 2); Vec::push(&mut values, 2);
    let removed = dedup_take(&mut values);
    assert_true(Vec::len(&removed) == 2);
    assert_true(Vec::len(&values) == 2);
    assert_true(handle find_subslice(b"ababac", b"abac") { Result::Ok(2) => true, _ => false });
    assert_true(common_suffix_len(b"axbc", b"yzbc") == 2);
    42
}
