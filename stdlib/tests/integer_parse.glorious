pub fn main() -> i64 {
    assert_true(handle i8::parse("-128") { Result::Ok(-128) => true, _ => false });
    assert_true(handle i16::parse("-32768") { Result::Ok(-32768) => true, _ => false });
    assert_true(handle i32::parse("-2147483648") { Result::Ok(-2147483648) => true, _ => false });
    assert_true(handle i64::parse("-9223372036854775808") { Result::Ok(-9223372036854775808) => true, _ => false });
    assert_true(handle isize::parse("-9223372036854775808") { Result::Ok(-9223372036854775808) => true, _ => false });
    assert_true(handle i128::parse("-170141183460469231731687303715884105728") { Result::Ok(-170141183460469231731687303715884105728) => true, _ => false });
    assert_true(handle u8::parse("255") { Result::Ok(255) => true, _ => false });
    assert_true(handle u16::parse("65535") { Result::Ok(65535) => true, _ => false });
    assert_true(handle u32::parse("4294967295") { Result::Ok(4294967295) => true, _ => false });
    assert_true(handle u64::parse("18446744073709551615") { Result::Ok(18446744073709551615) => true, _ => false });
    assert_true(handle usize::parse("18446744073709551615") { Result::Ok(18446744073709551615) => true, _ => false });
    assert_true(handle u128::parse("340282366920938463463374607431768211455") { Result::Ok(340282366920938463463374607431768211455) => true, _ => false });
    assert_true(handle u8::parse("+42") { Result::Ok(42) => true, _ => false });
    assert_true(handle u8::parse_radix("fF", 16) { Result::Ok(255) => true, _ => false });
    assert_true(handle u8::parse_radix("10", 1) { Result::Err(error) => handle error.kind { IntParseErrorKind::InvalidRadix => true, _ => false }, _ => false });
    assert_true(handle u8::parse("-1") { Result::Err(error) => handle error.kind { IntParseErrorKind::InvalidSign => error.offset == 0, _ => false }, _ => false });
    assert_true(handle i8::parse("128") { Result::Err(error) => handle error.kind { IntParseErrorKind::Overflow => error.offset == 2, _ => false }, _ => false });
    assert_true(handle u8::parse("1_0") { Result::Err(error) => handle error.kind { IntParseErrorKind::InvalidSeparator => error.offset == 1, _ => false }, _ => false });
    assert_true(handle u8::parse("+") { Result::Err(error) => handle error.kind { IntParseErrorKind::Empty => error.offset == 1, _ => false }, _ => false });
    42
}
