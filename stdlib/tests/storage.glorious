struct Domain {}
pub fn main() -> i64 {
    let mut bits = BitSet<Domain>::new();
    assert_true(BitSet::insert(&mut bits, Id::from_u32(65)));
    assert_true(BitSet::insert(&mut bits, Id::from_u32(2)));
    assert_true(not(BitSet::insert(&mut bits, Id::from_u32(65))));
    let ids = BitSet::to_vec(&bits);
    assert_true(handle Vec::get(&ids, 0) { Result::Ok(id) => Id::to_u32(*id) == 2, _ => false });
    assert_true(handle Vec::get(&ids, 1) { Result::Ok(id) => Id::to_u32(*id) == 65, _ => false });
    let mut set = SparseSet<Domain>::new();
    SparseSet::insert(&mut set, Id::from_u32(1)); SparseSet::insert(&mut set, Id::from_u32(2)); SparseSet::insert(&mut set, Id::from_u32(3));
    assert_true(SparseSet::remove(&mut set, Id::from_u32(2)));
    assert_true(SparseSet::contains(&set, Id::from_u32(3)));
    assert_true(not(SparseSet::contains(&set, Id::from_u32(2))));
    let mut queue = WorkQueue<Domain>::new();
    assert_true(WorkQueue::push(&mut queue, Id::from_u32(4)));
    assert_true(not(WorkQueue::push(&mut queue, Id::from_u32(4))));
    WorkQueue::push(&mut queue, Id::from_u32(8));
    assert_true(handle WorkQueue::pop(&mut queue) { Result::Ok(id) => Id::to_u32(id) == 4, _ => false });
    assert_true(WorkQueue::push(&mut queue, Id::from_u32(4)));
    assert_true(handle WorkQueue::pop(&mut queue) { Result::Ok(id) => Id::to_u32(id) == 8, _ => false });
    assert_true(handle WorkQueue::pop(&mut queue) { Result::Ok(id) => Id::to_u32(id) == 4, _ => false });
    42
}
