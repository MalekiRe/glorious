pub fn main() -> i64 {
    assert_true(handle utf8::validate_utf8(b"a\xc3\xa9\xf0\x9f\x98\x80") { Result::Ok(_) => true, _ => false });
    assert_true(handle utf8::validate_utf8(b"ok\xc0\x80") {
        Result::Err(error) => handle error.kind { utf8::Utf8ErrorKind::Overlong => error.valid_up_to == 2, _ => false }, _ => false,
    });
    assert_true(handle utf8::validate_utf8(b"\xed\xa0\x80") { Result::Err(error) => handle error.kind { utf8::Utf8ErrorKind::Surrogate => true, _ => false }, _ => false });
    assert_true(handle utf8::validate_utf8(b"\xf0\x9f\x98") { Result::Err(error) => handle error.error_length { Result::Err(_) => true, _ => false }, _ => false });
    assert_true(utf8::ascii_eq_ignore_case(b"AbC", b"aBc"));
    assert_true(not(utf8::ascii_eq_ignore_case(b"a", b"ab")));
    assert_true(not(char::is_valid_scalar(55296)));
    assert_true(char::to_ascii_lowercase('Z') == 'z');
    let mut out = [as<u8>(99), as<u8>(99), as<u8>(99), as<u8>(99)];
    assert_true(char::encode_utf8('é', &mut out) == 2);
    assert_bytes(array_as_slice(&out), b"\xc3\xa9cc");
    42
}
