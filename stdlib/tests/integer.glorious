pub fn main() -> i64 {
    assert_true(handle u8::checked_add(255, 1) { Result::Err(_) => true, _ => false });
    assert_true(handle i8::checked_mul(-128, -1) { Result::Err(_) => true, _ => false });
    assert_true(handle i64::checked_div(i64::min_value(), -1) { Result::Err(_) => true, _ => false });
    assert_true(handle i64::checked_rem(i64::min_value(), -1) { Result::Err(_) => true, _ => false });
    assert_true(u8::wrapping_add(255, 1) == 0);
    assert_true(i8::saturating_add(120, 20) == 127);
    assert_true(i8::saturating_sub(-120, 20) == -128);
    assert_true(i8::saturating_mul(-100, 2) == -128);
    assert_true(handle u8::checked_shl(1, 8) { Result::Err(_) => true, _ => false });
    assert_true(u8::wrapping_shl(1, 8) == 1);
    assert_true(u8::rotate_left(129, 1) == 3);
    assert_true(u8::reverse_bits(1) == 128);
    assert_true(u32::swap_bytes(16909060) == 67305985);
    assert_true(u64::leading_zeros(0) == 64);
    assert_true(u64::trailing_ones(0) == 0);
    assert_true(u8::count_ones(255) == 8);
    assert_true(i8::abs_diff(-128, 127) == 255);
    assert_true(handle u8::checked_next_power_of_two(0) { Result::Ok(1) => true, _ => false });
    assert_true(handle u8::checked_next_power_of_two(129) { Result::Err(_) => true, _ => false });
    assert_true(handle u8::checked_pow(3, 5) { Result::Ok(243) => true, _ => false });
    assert_true(handle u8::checked_pow(3, 6) { Result::Err(_) => true, _ => false });
    42
}
