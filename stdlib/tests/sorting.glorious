struct Resident { key: i64, serial: i64 }
impl Use<[1,1]> for Resident {}
impl Ord for Resident { fn compare(a: &Self, b: &Self) -> Ordering { Ord::compare(&a.key, &b.key) } }
fn residents() -> Vec<Resident> {
    let mut items = Vec::new();
    Vec::push(&mut items, Resident { key: 2, serial: 0 });
    Vec::push(&mut items, Resident { key: 1, serial: 1 });
    Vec::push(&mut items, Resident { key: 2, serial: 2 });
    Vec::push(&mut items, Resident { key: 1, serial: 3 });
    items
}
fn finish_residents(items: Vec<Resident>, total: i64) -> i64 {
    let mut items = items;
    handle Vec::pop(&mut items) {
        Result::Err(_) => { handle Vec::finish_empty(items) { Result::Ok(()) => (), _ => __g1_abort() }; total },
        Result::Ok(Resident { key: key, serial: serial }) => tail finish_residents(items, total + serial),
    }
}
fn descending(a: &i64, b: &i64) -> Ordering { Ord::compare(b, a) }
fn fail_on_two(a: &i64, b: &i64) -> Result<Ordering,i64> {
    handle *b == 2 { true => Result::Err(2), false => Result::Ok(Ord::compare(a, b)) }
}
fn compare_two(value: &i64) -> Ordering { Ord::compare(value, &2) }
fn numbers() -> Vec<i64> {
    let mut items = Vec::new();
    Vec::push(&mut items, 4); Vec::push(&mut items, 1); Vec::push(&mut items, 3); Vec::push(&mut items, 2);
    items
}
pub fn main() -> i64 {
    let mut items = residents();
    let mut scratch = Vec<Resident>::new();
    let mut view = Vec::as_mut_slice(&mut items);
    assert_true(handle sort_stable(&mut view, &mut scratch) { Result::Ok(()) => true, _ => false });
    assert_true(Vec::len(&scratch) == 0);
    assert_true(Vec::get_unchecked(&items, 0).serial == 1);
    assert_true(Vec::get_unchecked(&items, 1).serial == 3);
    assert_true(Vec::get_unchecked(&items, 2).serial == 0);
    assert_true(Vec::get_unchecked(&items, 3).serial == 2);
    assert_true(finish_residents(items, 0) == 6);
    handle Vec::finish_empty(scratch) { Result::Ok(()) => (), _ => __g1_abort() };
    let mut items = numbers();
    let mut view = Vec::as_mut_slice(&mut items);
    sort_unstable(&mut view);
    assert_true(*Vec::get_unchecked(&items, 0) == 1);
    assert_true(*Vec::get_unchecked(&items, 3) == 4);
    let mut compare = compare_two;
    assert_true(handle binary_search_by(Vec::as_slice(&items), &mut compare) { Result::Ok(1) => true, _ => false });
    let mut compare = descending;
    let mut view = Vec::as_mut_slice(&mut items);
    sort_by(&mut view, &mut compare);
    assert_true(*Vec::get_unchecked(&items, 0) == 4);
    let mut items = numbers();
    let mut compare = fail_on_two;
    let mut view = Vec::as_mut_slice(&mut items);
    assert_true(handle try_sort_by(&mut view, &mut compare) { Result::Err(2) => true, _ => false });
    assert_true(Vec::len(&items) == 4);
    let total = *Vec::get_unchecked(&items, 0) + *Vec::get_unchecked(&items, 1) + *Vec::get_unchecked(&items, 2) + *Vec::get_unchecked(&items, 3);
    assert_true(total == 10);
    let mut scratch = Vec::new(); Vec::push(&mut scratch, 9);
    let before = *Vec::get_unchecked(&items, 0);
    let mut view = Vec::as_mut_slice(&mut items);
    assert_true(handle sort_stable(&mut view, &mut scratch) { Result::Err(ScratchError::NonEmpty) => true, _ => false });
    assert_true(*Vec::get_unchecked(&items, 0) == before);
    assert_true(*Vec::get_unchecked(&scratch, 0) == 9);
    42
}
