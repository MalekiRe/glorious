pub fn main() -> i64 {
    let mut reader = ByteReader::new(b"\x34\x12\xff");
    assert_true(handle ByteReader::read_u16_le(&mut reader) { Result::Ok(4660) => true, _ => false });
    assert_true(handle ByteReader::read_u32_le(&mut reader) { Result::Err(error) => handle error.kind { DecodeErrorKind::Truncated => true, _ => false }, _ => false });
    assert_true(ByteReader::position(&reader) == 2);
    assert_true(handle ByteReader::read_u8(&mut reader) { Result::Ok(255) => true, _ => false });
    assert_true(handle ByteReader::finish(reader) { Result::Ok(_) => true, _ => false });
    let mut reader = ByteReader::new(b"\x80\x00");
    assert_true(handle ByteReader::read_var_u64(&mut reader) { Result::Err(error) => handle error.kind { DecodeErrorKind::NonCanonical => true, _ => false }, _ => false });
    assert_true(ByteReader::position(&reader) == 0);
    let mut reader = ByteReader::new(b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01");
    assert_true(handle ByteReader::read_var_u64(&mut reader) { Result::Ok(value) => value == 18446744073709551615, _ => false });
    let mut reader = ByteReader::new(b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x02");
    assert_true(handle ByteReader::read_var_u64(&mut reader) { Result::Err(error) => handle error.kind { DecodeErrorKind::Overflow => true, _ => false }, _ => false });
    assert_true(ByteReader::position(&reader) == 0);
    let mut reader = ByteReader::new(b"\xed\xa0\x80");
    assert_true(handle ByteReader::read_str(&mut reader, 3) { Result::Err(_) => true, _ => false });
    assert_true(ByteReader::position(&reader) == 0);
    42
}
