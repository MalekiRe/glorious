fn exact64(value: f64, expected: Str) {
    let text = f64::format_exact(value);
    assert_true(PartialEq::eq(&String::as_str(&text), &expected));
}
pub fn main() -> i64 {
    exact64(f64::zero(), "0e+0");
    exact64(f64::from_bits(9223372036854775808), "-0e+0");
    exact64(f64::nan(), "nan");
    exact64(f64::infinity(), "inf");
    exact64(f64::neg_infinity(), "-inf");
    exact64(1.5, "1.5e+0");
    exact64(1024.0, "1.024e+3");
    exact64(-0.125, "-1.25e-1");
    exact64(f64::from_bits(4591870180066957722), "1.000000000000000055511151231257827021181583404541015625e-1");
    let text = f32::format_exact(f32::from_bits(1036831949));
    assert_true(PartialEq::eq(&String::as_str(&text), &"1.00000001490116119384765625e-1"));
    42
}
