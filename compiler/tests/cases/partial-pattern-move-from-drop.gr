struct Ticket {}

impl Use<[1,1]> for Ticket {}

enum Packet {
    Empty,
    Full(Ticket),
}

impl Drop for Packet {
    drop(&mut self) -> { () }
}

effect Send {
    [0,1] take(packet: Packet) -> i32;
}

run(packet: Packet) -> i32 / {Send} {
    perform Send::take(packet)
}

main() -> i32 {
    handle (run(Packet::Full(Ticket {}))) {
        Send::take(Packet::Full(ticket)) with k => {
            destroy(ticket);
            cancel(k);
            42
        },
        Send::take(Packet::Empty) with k => {
            cancel(k);
            0
        }
    }
}
