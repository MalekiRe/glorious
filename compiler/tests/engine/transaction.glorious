use std::*;
use kernel::transaction;
use kernel::transaction::create;
use kernel::transaction::UndoLog;
use kernel::transaction::UndoStep;
use kernel::transaction::TransactionError;
use kernel::operation;
pub mod kernel;

pub struct Product { value: i64, journal: Vec<i64> }

fn publication() -> i64 {
    let controls = operation::create(10, 10);
    let journal = Vec::new();
    Vec::push(&mut journal, 77);
    let pending = transaction::stage(Product { value: 42, journal: journal });
    handle transaction::publish(&mut pending, &controls) {
        Result::Err(_) => 1,
        Result::Ok(product) => handle product.value == 42 {
            false => 2,
            true => handle Vec::len(&product.journal) == 1 {
                false => 3,
                true => handle transaction::publish(&mut pending, &controls) {
                    Result::Err(transaction::PublicationError::Closed) => cancelled(),
                    _ => 4,
                },
            },
        },
    }
}

fn cancelled() -> i64 {
    let controls = operation::create(10, 10);
    let pending = transaction::stage(42);
    operation::cancel(&mut controls);
    handle transaction::publish(&mut pending, &controls) {
        Result::Err(transaction::PublicationError::Control(operation::Failure::Cancelled)) => {
            let retry = operation::create(10, 10);
            handle transaction::publish(&mut pending, &retry) {
                Result::Err(transaction::PublicationError::Closed) => 42,
                _ => 5,
            }
        },
        _ => 6,
    }
}

fn finished(log: &mut UndoLog<i64>, outer: transaction::Mark) -> i64 {
    handle transaction::rollback_step(&mut *log) {
        Result::Ok(UndoStep::Done) => handle transaction::scratch_count(& *log) == 0 {
            false => 7,
            true => handle transaction::mark_count(& *log) == 0 {
                false => 8,
                true => handle transaction::commit(&mut *log, outer) {
                    Result::Err(TransactionError::Closed) => publication(),
                    _ => 9,
                },
            },
        },
        _ => 10,
    }
}

fn unwind(log: &mut UndoLog<i64>, outer: transaction::Mark) -> i64 {
    handle transaction::record(&mut *log, 99) {
        Result::Err(TransactionError::Unwinding) =>
            handle transaction::rollback_step(&mut *log) {
                Result::Ok(UndoStep::Apply(20)) => handle transaction::rollback_step(&mut *log) {
                    Result::Ok(UndoStep::Apply(10)) => finished(&mut *log, outer),
                    _ => 11,
                },
                _ => 12,
            },
        _ => 13,
    }
}

fn committed_inner(log: &mut UndoLog<i64>, outer: transaction::Mark) -> i64 {
    handle transaction::scratch_count(& *log) == 2 {
        false => 14,
        true => handle transaction::rollback(&mut *log, outer) {
            Result::Err(_) => 15,
            Result::Ok(_) => unwind(&mut *log, outer),
        },
    }
}

fn inner(log: &mut UndoLog<i64>, outer: transaction::Mark, inner: transaction::Mark) -> i64 {
    handle transaction::record(&mut *log, 20) {
        Result::Err(_) => 16,
        Result::Ok(_) => handle transaction::commit(&mut *log, outer) {
            Result::Err(TransactionError::MarkOrder) => handle transaction::commit(&mut *log, inner) {
                Result::Err(_) => 17,
                Result::Ok(_) => committed_inner(&mut *log, outer),
            },
            _ => 18,
        },
    }
}

fn outer(log: &mut UndoLog<i64>, mark: transaction::Mark) -> i64 {
    handle transaction::record(&mut *log, 10) {
        Result::Err(_) => 19,
        Result::Ok(_) => handle transaction::mark(&mut *log) {
            Result::Err(_) => 20,
            Result::Ok(inner_mark) => inner(&mut *log, mark, inner_mark),
        },
    }
}

pub fn main() -> i64 {
    let log = create<i64>(1, 1, 8);
    handle transaction::record(&mut log, 99) {
        Result::Err(TransactionError::Closed) => handle transaction::mark(&mut log) {
            Result::Err(_) => 21,
            Result::Ok(mark) => outer(&mut log, mark),
        },
        _ => 22,
    }
}
