use std::*;
use kernel::identity::PackageKey;
use kernel::package;
use kernel::package::Action;
use kernel::package::Event;
use kernel::package::Failure;
use kernel::package::Status;
use kernel::storage;
use kernel::storage::Handle;
use kernel::operation;
pub mod kernel;

fn key(name: Str) -> PackageKey { PackageKey { value: Str::to_string(name) } }
fn yes() -> Bool { true }
fn no() -> Bool { false }
fn eq64(left: u64, right: u64) -> Bool { left == right }
fn failure_code(error: Failure) -> u32 {
    handle error {
        Failure::ActiveBodyScratch(_) => 1, Failure::StaleBody => 2,
        Failure::PackageAlreadyActive(_) => 3, Failure::RequestRolledBack => 4,
        Failure::Capacity => 5, _ => 0,
    }
}
fn failed(result: Result<Event, Failure>, code: u32) -> Bool {
    handle result { Result::Err(error) => failure_code(error) == code, _ => no() }
}
fn registry() -> package::Registry { package::create(package::Limits { packages: 4, bodies: 8 }) }
fn drive(registry: &mut package::Registry, owner: Handle, controls: &mut operation::Controls, fuel: usize)
    -> Result<Event, Failure> {
    handle fuel == 0 {
        true => Result::Err(Failure::Invariant),
        false => handle package::apply(&mut *registry, owner, &mut *controls, Action::Step) {
            Result::Ok(Event::Continue) => drive(registry, owner, controls, fuel - 1), other => other,
        },
    }
}
fn zero(registry: &package::Registry) -> Bool {
    let stats = package::stats(registry);
    handle stats.active_packages == 0 {
        false => no(),
        true => handle stats.active_body_scratch == 0 { false => no(), true => stats.staged_body_products == 0 },
    }
}
fn status(registry: &package::Registry, name: Str, expected: u32) -> Bool {
    let package = key(name);
    handle package::metadata(registry, &package) {
        Result::Err(_) => no(),
        Result::Ok(metadata) => handle metadata.status {
            Status::Open => expected == 0, Status::Staged => expected == 1,
            Status::Committed => expected == 2, Status::RolledBack => expected == 3,
        },
    }
}
fn points(value: Bool, score: i64) -> i64 { handle value { true => score, false => 0 } }
fn successful(owner: Handle) -> i64 {
    let entries = registry();
    let controls = operation::create(100, 100);
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("z")));
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("a")));
    handle package::apply(&mut entries, owner, &mut controls, Action::OpenBody(key("z"))) {
        Result::Ok(Event::Body(body)) => finish_body(&mut entries, owner, &mut controls, body), _ => 0,
    }
}
fn finish_body(entries: &mut package::Registry, owner: Handle, controls: &mut operation::Controls, body: package::Body) -> i64 {
    let live = failed(package::apply(&mut *entries, owner, &mut *controls, Action::Stage(key("z"))), 1);
    package::apply(&mut *entries, owner, &mut *controls, Action::PublishBody(body));
    let stale = failed(package::apply(&mut *entries, owner, &mut *controls, Action::PublishBody(body)), 2);
    package::apply(&mut *entries, owner, &mut *controls, Action::Stage(key("z")));
    package::apply(&mut *entries, owner, &mut *controls, Action::Stage(key("a")));
    package::apply(&mut *entries, owner, &mut *controls, Action::Prepare);
    handle drive(&mut *entries, owner, &mut *controls, 20) {
        Result::Ok(Event::Prepared) => {
            let before = points(status(& *entries, "z", 1), 1);
            handle package::commit(&mut *entries, & *controls) {
                Result::Err(_) => 0,
                Result::Ok(_) => {
                    package::rollback_all(&mut *entries);
                    before + points(live, 1) + points(stale, 1) + points(zero(& *entries), 1)
                        + points(status(& *entries, "z", 2), 1) + points(status(& *entries, "a", 2), 1)
                },
            }
        },
        _ => 0,
    }
}
fn missing(owner: Handle) -> i64 {
    let entries = registry();
    let controls = operation::create(100, 100);
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("z")));
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("b")));
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("a")));
    package::apply(&mut entries, owner, &mut controls, Action::Stage(key("b")));
    package::apply(&mut entries, owner, &mut controls, Action::Prepare);
    handle drive(&mut entries, owner, &mut controls, 40) {
        Result::Err(Failure::UnstagedPackages(missing)) => {
            let sorted = missing_order(&missing);
            let staged = status(&entries, "b", 1);
            package::rollback_all(&mut entries);
            points(sorted, 2) + points(staged, 1) + points(zero(&entries), 1) + points(status(&entries, "a", 3), 2)
        },
        _ => 0,
    }
}
fn missing_order(missing: &Vec<PackageKey>) -> Bool {
    handle Vec::len(missing) == 2 {
        false => no(),
        true => {
            let a = key("a");
            let z = key("z");
            handle Eq::eq(Vec::get_unchecked(missing, 0), &a) {
                false => no(), true => Eq::eq(Vec::get_unchecked(missing, 1), &z),
            }
        },
    }
}
fn rolled_back(owner: Handle) -> i64 {
    let entries = registry();
    let controls = operation::create(100, 100);
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("a")));
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("b")));
    let duplicate = failed(package::apply(&mut entries, owner, &mut controls, Action::Open(key("a"))), 3);
    handle package::apply(&mut entries, owner, &mut controls, Action::OpenBody(key("a"))) {
        Result::Ok(Event::Body(body)) => {
            package::apply(&mut entries, owner, &mut controls, Action::Rollback(key("a")));
            let stale = failed(package::apply(&mut entries, owner, &mut controls, Action::AbandonBody(body)), 2);
            let reopen = failed(package::apply(&mut entries, owner, &mut controls, Action::Open(key("c"))), 4);
            points(duplicate, 1) + points(stale, 1) + points(reopen, 1) + points(status(&entries, "a", 3), 1)
                + points(status(&entries, "b", 0), 1) + points(eq64(package::stats(&entries).active_body_scratch, 0), 1)
        },
        _ => 0,
    }
}
fn cancelled(owner: Handle) -> i64 {
    let entries = registry();
    let controls = operation::create(100, 100);
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("a")));
    package::apply(&mut entries, owner, &mut controls, Action::Stage(key("a")));
    package::apply(&mut entries, owner, &mut controls, Action::Prepare);
    handle drive(&mut entries, owner, &mut controls, 20) {
        Result::Ok(Event::Prepared) => {
            let spent = operation::work_spent(&controls);
            operation::cancel(&mut controls);
            handle package::commit(&mut entries, &controls) {
                Result::Err(Failure::Control(operation::Failure::Cancelled)) =>
                    points(zero(&entries), 2) + points(status(&entries, "a", 3), 2)
                        + points(eq64(operation::work_spent(&controls), spent), 2),
                _ => 0,
            }
        },
        _ => 0,
    }
}
fn budget(owner: Handle) -> i64 {
    let entries = registry();
    let controls = operation::create(1, 100);
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("a")));
    handle package::apply(&mut entries, owner, &mut controls, Action::OpenBody(key("a"))) {
        Result::Err(Failure::Control(operation::Failure::ResourceLimit { name: 0, ceiling: 1, requested: 1 })) => {
            package::apply(&mut entries, owner, &mut controls, Action::RollbackAll);
            points(zero(&entries), 2) + points(status(&entries, "a", 3), 2)
                + points(eq64(operation::work_spent(&controls), 1), 2)
        },
        _ => 0,
    }
}
fn capacity(owner: Handle) -> i64 {
    let entries = package::create(package::Limits { packages: 1, bodies: 1 });
    let controls = operation::create(100, 100);
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("a")));
    let full = failed(package::apply(&mut entries, owner, &mut controls, Action::Open(key("b"))), 5);
    handle package::apply(&mut entries, owner, &mut controls, Action::OpenBody(key("a"))) {
        Result::Ok(Event::Body(body)) => {
            package::apply(&mut entries, owner, &mut controls, Action::AbandonBody(body));
            let exhausted = failed(package::apply(&mut entries, owner, &mut controls, Action::OpenBody(key("a"))), 5);
            points(full, 2) + points(exhausted, 2) + points(eq64(package::stats(&entries).active_body_scratch, 0), 2)
        },
        _ => 0,
    }
}
fn foreign(owner: Handle, other: Handle) -> i64 {
    let entries = registry();
    let controls = operation::create(100, 100);
    package::apply(&mut entries, owner, &mut controls, Action::Open(key("a")));
    handle package::apply(&mut entries, owner, &mut controls, Action::OpenBody(key("a"))) {
        Result::Ok(Event::Body(body)) => handle package::apply(&mut entries, other, &mut controls, Action::PublishBody(body)) {
            Result::Err(Failure::ForeignBody) => {
                let retained = points(eq64(package::stats(&entries).active_body_scratch, 1), 3);
                package::apply(&mut entries, owner, &mut controls, Action::AbandonBody(body));
                retained + points(eq64(package::stats(&entries).active_body_scratch, 0), 3)
            },
            _ => 0,
        },
        _ => 0,
    }
}
pub fn main() -> i64 {
    let owners = storage::namespace<u32>(400, 2, 2);
    handle storage::insert(&mut owners, 1) {
        Result::Err(_) => -1,
        Result::Ok(owner) => handle storage::insert(&mut owners, 2) {
            Result::Err(_) => -2,
            Result::Ok(other) => successful(owner) + missing(owner) + rolled_back(owner) + cancelled(owner)
                + budget(owner) + capacity(owner) + foreign(owner, other),
        },
    }
}
