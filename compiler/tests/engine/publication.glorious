use std::*;
use kernel::database;
use kernel::database::Session;
use kernel::database::PackageWorld;
use kernel::database::DiagnosticWorld;
use kernel::identity;
use kernel::identity::Digest;
use kernel::identity::FileKey;
use kernel::identity::PackageKey;
use kernel::publication;
use kernel::diagnostic;
use kernel::dependency;
use kernel::dependency::node::Node;
use kernel::engine;
use kernel::package;
use kernel::query;
use kernel::operation;
pub mod kernel;

pub struct World { package: PackageKey, file: FileKey, length: u32 }
pub impl PackageWorld for World {
    contains_package(world: &World, key: &PackageKey) -> Bool { Eq::eq(&world.package, key) }
}
pub impl DiagnosticWorld for World {
    source_length(world: &World, file: &FileKey) -> Option<u32> {
        handle identity::equal(world.file.digest, file.digest) { true => Result::Ok(world.length), false => None }
    }
}
pub struct Payload { value: i64 }
pub impl Use<[0, 1]> for Payload {}
pub type Db = database::Database<World, i64>;
fn key() -> PackageKey { PackageKey { value: Str::to_string("app") } }
fn limits() -> publication::Limits {
    publication::Limits { packages: package::Limits { packages: 2, bodies: 2 },
        dependencies: dependency::Limits { nodes: 4, edges: 4 },
        diagnostics: diagnostic::Limits { diagnostics: 4, provenance: 8 }, error_limit: None }
}
fn warning(file: FileKey) -> diagnostic::CompileDiagnostic {
    diagnostic::CompileDiagnostic { code: Str::to_string("W1000"), class: diagnostic::Class::Source,
        severity: diagnostic::Severity::Warning, message: Str::to_string("warning"),
        primary: Result::Ok(diagnostic::Span { file: file, start: 1, end: 3 }),
        input_fingerprint: Result::Ok(file.digest), related: Vec::new(), facts: Vec::new(), explanation: Vec::new() }
}
fn yes(value: Bool) -> i64 { handle value { true => 1, false => 0 } }
fn count_equal(left: usize, right: usize) -> i64 { handle left == right { true => 1, false => 0 } }
fn value_equal(left: i64, right: i64) -> i64 { handle left == right { true => 1, false => 0 } }
fn work_equal(left: u64, right: u64) -> i64 { handle left == right { true => 1, false => 0 } }
fn ok<T>(value: Result<T, database::Failure>) -> i64 where T: Use<[0, 1]> { handle value { Result::Ok(_) => 1, _ => 0 } }
fn drive(db: &mut Db, session: Session, fuel: usize) -> Result<(), database::Failure> {
    handle fuel == 0 {
        true => Result::Err(database::Failure::Invariant),
        false => handle database::step_request(&mut *db, session) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(step) => handle step {
                database::PublicationStep::Ready => Result::Ok(()),
                database::PublicationStep::Continue => drive(db, session, fuel - 1),
            },
        },
    }
}
fn prepare(db: &mut Db, session: Session, file: FileKey, fingerprint: Digest) -> Result<database::Staged<Payload>, database::Failure> {
    handle database::begin_request(&mut *db, session, limits()) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => {
            database::package_action(&mut *db, session, package::Action::Open(key()));
            database::package_action(&mut *db, session, package::Action::Stage(key()));
            database::record_dependency(&mut *db, session, Node::Input(file), fingerprint, Vec::new());
            database::record_diagnostic(&mut *db, session, warning(file));
            database::record_diagnostic(&mut *db, session, warning(file));
            database::stage_request(db, session, Payload { value: 42 })
        },
    }
}
fn row(db: &Db, session: Session, fingerprint: Digest, green: Bool) -> i64 {
    handle database::request_traces(db, session) {
        Result::Ok(Result::Ok(values)) => handle Slice::get(values, 0) {
            Result::Err(_) => 0,
            Result::Ok(trace) => yes(identity::equal(trace.fingerprint, fingerprint)) + row_status(trace.status, green),
        },
        _ => 0,
    }
}
fn row_status(status: dependency::Status, green: Bool) -> i64 {
    handle green {
        true => handle status { dependency::Status::Green { parent: _ } => 1, _ => 0 },
        false => handle status { dependency::Status::Cold => 1, _ => 0 },
    }
}
fn absent(db: &Db, session: Session) -> i64 {
    handle database::request_traces(db, session) { Result::Ok(Result::Err(_)) => 1, _ => 0 }
}
fn package_state(db: &Db, session: Session, committed: Bool) -> i64 {
    let name = key();
    handle database::package_metadata(db, session, &name) {
        Result::Err(_) => 0,
        Result::Ok(value) => handle committed {
            true => handle value.status { package::Status::Committed => 1, _ => 0 },
            false => handle value.status { package::Status::RolledBack => 1, _ => 0 },
        },
    }
}
fn batch(batch: &diagnostic::Batch, fingerprint: Digest) -> i64 {
    let values = diagnostic::values(batch);
    let length = count_equal(Slice::len(&values), 1);
    handle Slice::get(values, 0) {
        Result::Err(_) => 0,
        Result::Ok(value) => handle value.input_fingerprint {
            Result::Err(_) => 0,
            Result::Ok(bound) => length + yes(identity::equal(bound, fingerprint)),
        },
    }
}
fn finished(db: &mut Db, staged: database::Staged<Payload>, fingerprint: Digest) -> i64 {
    handle database::finish_request(db, staged) {
        Result::Err(_) => 0,
        Result::Ok(value) => value_equal(value.value.value, 42) + batch(&value.diagnostics, fingerprint),
    }
}
fn no() -> Bool { false }
fn yes_flag() -> Bool { true }
fn closed<T>(result: Result<T, database::Failure>) -> i64 where T: Use<[0, 1]> {
    handle result {
        Result::Err(database::Failure::Engine(engine::Failure::Publication(publication::Failure::Closed))) => 1, _ => 0,
    }
}
fn cancelled<T>(result: Result<T, database::Failure>) -> i64 where T: Use<[0, 1]> {
    handle result {
        Result::Err(database::Failure::Engine(engine::Failure::Control(operation::Failure::Cancelled))) => 1, _ => 0,
    }
}
fn cancel_replacement(db: &mut Db, revision: identity::RevisionId, file: FileKey, old: Digest, changed: Digest) -> i64 {
    handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, 2000, 1000) {
        Result::Err(_) => 0,
        Result::Ok(session) => handle prepare(&mut *db, session, file, changed) {
            Result::Err(_) => 0,
            Result::Ok(staged) => {
                let ready = ok(drive(&mut *db, session, 1000));
                let before = row(& *db, session, old, no());
                database::cancel(&mut *db, session);
                let denied = cancelled(database::finish_request(&mut *db, staged));
                let preserved = row(& *db, session, old, no());
                let rolled = package_state(& *db, session, no());
                database::close(&mut *db, session);
                ready + before + denied + preserved + rolled
            },
        },
    }
}
fn initial(db: &mut Db, session: Session, revision: identity::RevisionId, file: FileKey, fingerprint: Digest, changed: Digest) -> i64 {
    handle prepare(&mut *db, session, file, fingerprint) {
        Result::Err(_) => 0,
        Result::Ok(staged) => {
            let ready = ok(drive(&mut *db, session, 1000));
            let hidden = absent(& *db, session);
            let published = finished(&mut *db, staged, fingerprint);
            let committed = package_state(& *db, session, yes_flag());
            let visible = row(& *db, session, fingerprint, no());
            let consumed = closed(database::begin_request(&mut *db, session, limits()));
            let cancelled = cancel_replacement(&mut *db, revision, file, fingerprint, changed);
            ready + hidden + published + committed + visible + consumed + cancelled
        },
    }
}
fn child(db: &mut Db, parent: identity::RevisionId, file: FileKey, fingerprint: Digest, world: Digest) -> i64 {
    handle database::import(&mut *db, World { package: key(), file: file, length: 8 }, world, Result::Ok(parent)) {
        Result::Err(_) => 0,
        Result::Ok(revision) => handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, 2000, 1000) {
            Result::Err(_) => 0,
            Result::Ok(session) => handle prepare(&mut *db, session, file, fingerprint) {
                Result::Err(_) => 0,
                Result::Ok(staged) => {
                    let ready = ok(drive(&mut *db, session, 1000));
                    let result = finished(&mut *db, staged, world);
                    let inherited = row(& *db, session, fingerprint, yes_flag());
                    database::close(&mut *db, session);
                    ready + result + inherited
                },
            },
        },
    }
}
fn collect(db: &mut Db, fuel: usize) -> i64 {
    handle fuel == 0 {
        true => 0,
        false => handle database::collect_step(&mut *db) {
            Result::Err(_) => 0, Result::Ok(step) => handle step {
                database::CollectionStep::Done(_) => 1,
                database::CollectionStep::Continue => collect(db, fuel - 1),
            },
        },
    }
}
fn run(db: &mut Db, revision: identity::RevisionId, file: FileKey, fingerprint: Digest, changed: Digest) -> i64 {
    handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, 2000, 1000) {
        Result::Err(_) => 0,
        Result::Ok(session) => {
            let first = initial(&mut *db, session, revision, file, fingerprint, changed);
            let inherited = child(&mut *db, revision, file, fingerprint, changed);
            database::retire(&mut *db, revision);
            database::collect(&mut *db);
            let collected = collect(&mut *db, 100);
            let pinned = row(& *db, session, fingerprint, no());
            database::close(&mut *db, session);
            database::collect(&mut *db);
            let unpinned = collect(&mut *db, 100);
            let remaining = remaining(& *db);
            first + inherited + collected + pinned + unpinned + remaining
        },
    }
}
fn remaining(db: &Db) -> i64 {
    handle database::published_revisions(db) { Result::Ok(1) => 1, _ => 0 }
}
fn unstaged_error(result: Result<(), database::Failure>) -> i64 {
    handle result {
        Result::Err(database::Failure::Engine(engine::Failure::Publication(publication::Failure::Package(error)))) =>
            handle error {
                package::Failure::UnstagedPackages(keys) => handle Vec::len(&keys) == 1 {
                    false => 0, true => single_key(&keys),
                },
                _ => 0,
            },
        _ => 0,
    }
}
fn single_key(keys: &Vec<PackageKey>) -> i64 {
    let expected = key();
    yes(Eq::eq(Vec::get_unchecked(keys, 0), &expected))
}
fn unstaged(db: &mut Db, session: Session, file: FileKey, fingerprint: Digest) -> i64 {
    database::begin_request(&mut *db, session, limits());
    database::package_action(&mut *db, session, package::Action::Open(key()));
    database::record_dependency(&mut *db, session, Node::Input(file), fingerprint, Vec::new());
    handle database::stage_request(&mut *db, session, Payload { value: 99 }) {
        Result::Err(_) => 0,
        Result::Ok(staged) => {
            let rejected = unstaged_error(drive(&mut *db, session, 1000));
            let denied = closed(database::finish_request(&mut *db, staged));
            rejected + denied + absent(& *db, session) + package_state(& *db, session, no())
        },
    }
}
fn invalid_fact(batch: &diagnostic::Batch, fingerprint: Digest) -> i64 {
    let values = diagnostic::values(batch);
    handle Slice::get(values, 0) {
        Result::Err(_) => 0,
        Result::Ok(value) => {
            let code = Str::to_string("G7014");
            let invariant = equal_text(&value.code, &code);
            let primary = no_primary(value.primary);
            invariant + primary + batch_bound(batch, fingerprint)
        },
    }
}
fn equal_text(left: &String, right: &String) -> i64 {
    handle identity::compare_text(left, right) { Ordering::Equal => 1, _ => 0 }
}
fn no_primary(value: Option<diagnostic::Span>) -> i64 { handle value { Result::Err(_) => 1, _ => 0 } }
fn batch_bound(value: &diagnostic::Batch, fingerprint: Digest) -> i64 { batch(value, fingerprint) }
fn rejected(result: Result<(), database::Failure>, fingerprint: Digest) -> i64 {
    handle result {
        Result::Err(database::Failure::Engine(engine::Failure::Publication(publication::Failure::Rejected(batch)))) =>
            invalid_fact(&batch, fingerprint),
        _ => 0,
    }
}
fn invalid(db: &mut Db, session: Session, file: FileKey, fingerprint: Digest) -> i64 {
    database::begin_request(&mut *db, session, limits());
    database::package_action(&mut *db, session, package::Action::Open(key()));
    database::package_action(&mut *db, session, package::Action::Stage(key()));
    database::record_dependency(&mut *db, session, Node::Input(file), fingerprint, Vec::new());
    let value = warning(file);
    Vec::push(&mut value.related, diagnostic::Related { label: Str::to_string("bad"),
        span: diagnostic::Span { file: file, start: 1, end: 9 } });
    database::record_diagnostic(&mut *db, session, value);
    handle database::stage_request(&mut *db, session, Payload { value: 99 }) {
        Result::Err(_) => 0,
        Result::Ok(staged) => {
            let rejected = rejected(drive(&mut *db, session, 1000), fingerprint);
            let denied = closed(database::finish_request(&mut *db, staged));
            rejected + denied + absent(& *db, session) + package_state(& *db, session, no())
        },
    }
}
fn resource(result: Result<(), database::Failure>) -> i64 {
    handle result {
        Result::Err(database::Failure::Engine(engine::Failure::Control(operation::Failure::ResourceLimit {
            name: 0, ceiling: 3, requested: 1 }))) => 1, _ => 0,
    }
}
fn spent(db: &Db, session: Session, expected: u64) -> i64 {
    handle database::work_spent(db, session) { Result::Ok(value) => work_equal(value, expected), _ => 0 }
}
fn budget(db: &mut Db, session: Session, file: FileKey, fingerprint: Digest) -> i64 {
    database::begin_request(&mut *db, session, limits());
    database::package_action(&mut *db, session, package::Action::Open(key()));
    database::record_dependency(&mut *db, session, Node::Input(file), fingerprint, Vec::new());
    let failed = resource(database::record_diagnostic(&mut *db, session, warning(file)));
    let consumed = closed(database::begin_request(&mut *db, session, limits()));
    failed + consumed + spent(& *db, session, 3) + absent(& *db, session) + package_state(& *db, session, no())
}
fn busy<T>(result: Result<T, database::Failure>) -> i64 where T: Use<[0, 1]> {
    handle result {
        Result::Err(database::Failure::Engine(engine::Failure::Publication(publication::Failure::Busy))) => 1, _ => 0,
    }
}
fn outstanding(db: &mut Db, session: Session, query_key: database::Key<u32>) -> i64 {
    database::begin_request(&mut *db, session, limits());
    database::package_action(&mut *db, session, package::Action::Open(key()));
    database::package_action(&mut *db, session, package::Action::Stage(key()));
    handle database::start(&mut *db, session, query_key, None) {
        Result::Err(_) => 0,
        Result::Ok(ticket) => {
            let failed = busy(database::stage_request(&mut *db, session, Payload { value: 99 }));
            database::abort(&mut *db, ticket);
            failed + absent(& *db, session) + package_state(& *db, session, no())
        },
    }
}
fn active_query(db: &mut Db, session: Session) -> i64 {
    handle database::family<u32>(&mut *db, 1, query::RecoveryPolicy::Reject, engine::ReusePolicy::Tracked, 4) {
        Result::Err(_) => 0,
        Result::Ok(family) => handle database::intern(&mut family, 1) {
            Result::Err(_) => 0, Result::Ok(key) => outstanding(db, session, key),
        },
    }
}
fn failure_case(db: &mut Db, revision: identity::RevisionId, file: FileKey, fingerprint: Digest, mode: u32, work: u64) -> i64 {
    handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, work, 1000) {
        Result::Err(_) => 0,
        Result::Ok(session) => {
            let score = failed_session(&mut *db, session, file, fingerprint, mode);
            let cleanup = ok(database::close(&mut *db, session));
            score + cleanup
        },
    }
}
fn failed_session(db: &mut Db, session: Session, file: FileKey, fingerprint: Digest, mode: u32) -> i64 {
    handle mode {
        0 => unstaged(db, session, file, fingerprint),
        1 => invalid(db, session, file, fingerprint),
        2 => budget(db, session, file, fingerprint),
        _ => active_query(db, session),
    }
}
fn failures(db: &mut Db, revision: identity::RevisionId, file: FileKey, fingerprint: Digest, changed: Digest) -> i64 {
    // An unrelated world would accept the invalid span. Validation must use
    // the request's original length-eight snapshot, not this latest import.
    database::import(&mut *db, World { package: key(), file: file, length: 100 }, changed, None);
    let unstaged = failure_case(&mut *db, revision, file, fingerprint, 0, 2000);
    let invalid = failure_case(&mut *db, revision, file, fingerprint, 1, 2000);
    let budget = failure_case(&mut *db, revision, file, fingerprint, 2, 3);
    let active = failure_case(&mut *db, revision, file, fingerprint, 3, 2000);
    unstaged + invalid + budget + active
}
fn parent_changed<T>(result: Result<T, database::Failure>) -> i64 where T: Use<[0, 1]> {
    handle result {
        Result::Err(database::Failure::Engine(engine::Failure::Publication(publication::Failure::Dependency(
            dependency::Failure::ParentChanged)))) => 1, _ => 0,
    }
}
fn replace_parent(db: &mut Db, parent: identity::RevisionId, file: FileKey, original: Digest, changed: Digest) -> i64 {
    handle database::open(&mut *db, parent, query::RecoveryPolicy::Reject, 2000, 1000) {
        Result::Err(_) => 0,
        Result::Ok(session) => handle prepare(&mut *db, session, file, changed) {
            Result::Err(_) => 0,
            Result::Ok(staged) => {
                let ready = ok(drive(&mut *db, session, 1000));
                let published = finished(&mut *db, staged, original);
                let updated = row(& *db, session, changed, no());
                database::close(&mut *db, session);
                ready + published + updated
            },
        },
    }
}
fn stale_child(db: &mut Db, parent: identity::RevisionId, session: Session, file: FileKey, original: Digest, changed: Digest) -> i64 {
    handle prepare(&mut *db, session, file, original) {
        Result::Err(_) => 0,
        Result::Ok(staged) => {
            let ready = ok(drive(&mut *db, session, 1000));
            let replacement = replace_parent(&mut *db, parent, file, original, changed);
            let denied = parent_changed(database::finish_request(&mut *db, staged));
            let hidden = absent(& *db, session);
            let rolled = package_state(& *db, session, no());
            let cleanup = ok(database::close(&mut *db, session));
            ready + replacement + denied + hidden + rolled + cleanup
        },
    }
}
fn stale_parent(db: &mut Db, parent: identity::RevisionId, file: FileKey, original: Digest, changed: Digest) -> i64 {
    handle database::import(&mut *db, World { package: key(), file: file, length: 8 }, changed, Result::Ok(parent)) {
        Result::Err(_) => 0,
        Result::Ok(revision) => handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, 2000, 1000) {
            Result::Err(_) => 0, Result::Ok(session) => stale_child(db, parent, session, file, original, changed),
        },
    }
}
fn parent_history(db: &mut Db, parent: identity::RevisionId, file: FileKey, original: Digest, changed: Digest) -> i64 {
    handle database::open(&mut *db, parent, query::RecoveryPolicy::Reject, 2000, 1000) {
        Result::Err(_) => 0,
        Result::Ok(session) => handle prepare(&mut *db, session, file, original) {
            Result::Err(_) => 0,
            Result::Ok(staged) => {
                let ready = ok(drive(&mut *db, session, 1000));
                let published = finished(&mut *db, staged, original);
                let changed = stale_parent(&mut *db, parent, file, original, changed);
                let cleanup = ok(database::close(&mut *db, session));
                ready + published + changed + cleanup
            },
        },
    }
}
fn frozen(db: &mut Db, session: Session) -> i64 {
    handle database::family<u32>(&mut *db, 1, query::RecoveryPolicy::Reject, engine::ReusePolicy::Tracked, 4) {
        Result::Err(_) => 0,
        Result::Ok(family) => handle database::intern(&mut family, 1) {
            Result::Err(_) => 0, Result::Ok(key) => busy(database::start(db, session, key, None)),
        },
    }
}
fn stale_token<T>(result: Result<T, database::Failure>) -> i64 where T: Use<[0, 1]> {
    handle result { Result::Err(database::Failure::Engine(engine::Failure::Closed)) => 1, _ => 0 }
}
fn new_generation(db: &mut Db, session: Session, old: database::Staged<Payload>, file: FileKey, fingerprint: Digest) -> i64 {
    handle prepare(&mut *db, session, file, fingerprint) {
        Result::Err(_) => 0,
        Result::Ok(staged) => {
            let ready = ok(drive(&mut *db, session, 1000));
            let denied = stale_token(database::finish_request(&mut *db, old));
            let frozen = frozen(&mut *db, session);
            let published = finished(&mut *db, staged, fingerprint);
            let visible = row(& *db, session, fingerprint, no());
            let cleanup = ok(database::close(&mut *db, session));
            ready + denied + frozen + published + visible + cleanup
        },
    }
}
fn generation(db: &mut Db, revision: identity::RevisionId, file: FileKey, fingerprint: Digest) -> i64 {
    handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, 2000, 1000) {
        Result::Err(_) => 0,
        Result::Ok(session) => handle prepare(&mut *db, session, file, fingerprint) {
            Result::Err(_) => 0,
            Result::Ok(staged) => {
                let released = ok(database::close(&mut *db, session));
                handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, 2000, 1000) {
                    Result::Err(_) => 0,
                    Result::Ok(session) => released + new_generation(db, session, staged, file, fingerprint),
                }
            },
        },
    }
}
fn authority(db: &mut Db, revision: identity::RevisionId, file: FileKey, fingerprint: Digest, changed: Digest) -> i64 {
    let parent = parent_history(&mut *db, revision, file, fingerprint, changed);
    parent + generation(db, revision, file, fingerprint)
}
fn scenario(db: &mut Db, revision: identity::RevisionId, file: FileKey, fingerprint: Digest, changed: Digest, selected: u32) -> i64 {
    handle selected {
        0 => run(db, revision, file, fingerprint, changed),
        1 => failures(db, revision, file, fingerprint, changed),
        _ => authority(db, revision, file, fingerprint, changed),
    }
}
fn history(selected: u32) -> i64 {
    let db = database::create<World, i64>(7, 4, 8, 8, 8, 1000);
    handle identity::hash(b"file") {
        Result::Err(_) => 0,
        Result::Ok(file) => handle identity::hash(b"world") {
            Result::Err(_) => 0,
            Result::Ok(world) => handle identity::hash(b"changed") {
                Result::Err(_) => 0,
                Result::Ok(changed) => handle database::import(&mut db, World { package: key(), file: FileKey { digest: file }, length: 8 }, world, None) {
                    Result::Err(_) => 0,
                    Result::Ok(revision) => scenario(&mut db, revision, FileKey { digest: file }, world, changed, selected),
                },
            },
        },
    }
}
pub fn main() -> (i64, i64, i64) {
    let lifecycle = history(0);
    let failures = history(1);
    let authority = history(2);
    (lifecycle, failures, authority)
}
