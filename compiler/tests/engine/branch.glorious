use std::*;
use kernel::database;
use kernel::database::create;
use kernel::database::family;
use kernel::engine;
use kernel::identity;
use kernel::query;
use kernel::query::Read;
use kernel::storage;
pub mod kernel;

pub struct World { version: u64 }
pub struct Product { answer: i64 }
pub type Db = database::Database<World, Product>;
pub struct Inputs {
    key: database::Key<u32>, before: Read, after: Read, obsolete: Read, replacement: Read,
    third: identity::Digest,
}

fn twice(db: &mut Db, ticket: engine::Ticket) -> Result<engine::Event, database::Failure> {
    handle database::step(&mut *db, ticket) {
        Result::Ok(engine::Event::Continue) => database::step(&mut *db, ticket), other => other,
    }
}
fn drive(db: &mut Db, ticket: engine::Ticket) -> Result<engine::Event, database::Failure> {
    handle twice(&mut *db, ticket) {
        Result::Ok(engine::Event::Continue) => twice(&mut *db, ticket), other => other,
    }
}

fn replay(db: &mut Db, ticket: engine::Ticket, expected: Read, current: Read) -> Result<(), database::Failure> {
    handle drive(&mut *db, ticket) {
        Result::Ok(engine::Event::Read(read)) => handle query::same(read.identity, expected.identity) {
            false => Result::Err(database::Failure::Invariant),
            true => handle identity::equal(read.fingerprint, expected.fingerprint) {
                false => Result::Err(database::Failure::Invariant),
                true => database::observe(&mut *db, ticket, current),
            },
        },
        _ => Result::Err(database::Failure::Invariant),
    }
}

fn record_publish(db: &mut Db, ticket: engine::Ticket, selector: Read, branch: Read, answer: i64)
    -> Result<(), database::Failure> {
    handle database::observe(&mut *db, ticket, selector) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle database::observe(&mut *db, ticket, branch) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => database::publish(&mut *db, ticket, Product { answer: answer },
                selector.fingerprint, query::Completeness::Complete),
        },
    }
}

fn finished(db: &Db, session: database::Session, outcome: engine::Outcome) -> i64 {
    handle database::stats(db) {
        Result::Err(_) => 1,
        Result::Ok(stats) => handle stats.queries.memos == 3 {
            false => 2,
            true => handle stats.products == 2 {
                false => 3,
                true => handle stats.queries.edges == 6 {
                    false => 4,
                    true => handle database::value(db, session, outcome) { Result::Ok(value) => value.answer, _ => 5 },
                },
            },
        },
    }
}

fn reused(db: &mut Db, revision: identity::RevisionId, session: database::Session, ticket: engine::Ticket) -> i64 {
    handle drive(&mut *db, ticket) {
        Result::Ok(engine::Event::Ready(outcome)) => handle outcome.execution {
            engine::Execution::ReusedFromParent { parent: parent } => handle identity::same_revision(parent, revision) {
                true => finished(& *db, session, outcome), false => 6,
            },
            _ => 7,
        },
        _ => 8,
    }
}

fn replay_fresh(db: &mut Db, inputs: Inputs, revision: identity::RevisionId, session: database::Session) -> i64 {
    handle database::start(&mut *db, session, inputs.key, None) {
        Result::Err(_) => 9,
        Result::Ok(ticket) => handle replay(&mut *db, ticket, inputs.after, inputs.after) {
            Result::Err(_) => 10,
            Result::Ok(_) => handle replay(&mut *db, ticket, inputs.replacement, inputs.replacement) {
                Result::Err(_) => 11, Result::Ok(_) => reused(&mut *db, revision, session, ticket),
            },
        },
    }
}

fn third_revision(db: &mut Db, inputs: Inputs, revision: identity::RevisionId) -> i64 {
    handle database::import(&mut *db, World { version: 3 }, inputs.third, Result::Ok(revision)) {
        Result::Err(_) => 12,
        Result::Ok(third) => handle database::open(&mut *db, third, query::RecoveryPolicy::Reject, 0, 100) {
            Result::Ok(session) => replay_fresh(&mut *db, inputs, revision, session), _ => 13,
        },
    }
}

fn recomputed(db: &mut Db, inputs: Inputs, root: identity::RevisionId, revision: identity::RevisionId,
    session: database::Session, ticket: engine::Ticket) -> i64 {
    handle drive(&mut *db, ticket) {
        Result::Ok(engine::Event::Ready(outcome)) => handle outcome.execution {
            engine::Execution::Recomputed(engine::Reason::ParentReuseRejected { parent: parent }) =>
                handle identity::same_revision(parent, root) {
                    false => 14,
                    true => handle database::close(&mut *db, session) {
                        Result::Ok(_) => third_revision(&mut *db, inputs, revision), _ => 15,
                    },
                },
            _ => 16,
        },
        _ => 17,
    }
}

fn compute_changed(db: &mut Db, inputs: Inputs, root: identity::RevisionId, revision: identity::RevisionId,
    session: database::Session, ticket: engine::Ticket) -> i64 {
    // No request for the obsolete signature is allowed after the selector changes.
    handle drive(&mut *db, ticket) {
        Result::Ok(engine::Event::Compute { key: _ }) => handle record_publish(&mut *db, ticket,
            inputs.after, inputs.replacement, 42) {
            Result::Ok(_) => recomputed(&mut *db, inputs, root, revision, session, ticket), _ => 18,
        },
        _ => 19,
    }
}

fn restart(db: &mut Db, inputs: Inputs, root: identity::RevisionId, revision: identity::RevisionId,
    session: database::Session) -> i64 {
    handle database::start(&mut *db, session, inputs.key, None) {
        Result::Err(_) => 20,
        Result::Ok(ticket) => handle replay(&mut *db, ticket, inputs.before, inputs.after) {
            Result::Ok(_) => compute_changed(&mut *db, inputs, root, revision, session, ticket), _ => 21,
        },
    }
}

fn rejected_cleanly(db: &mut Db, inputs: Inputs, root: identity::RevisionId, revision: identity::RevisionId,
    session: database::Session) -> i64 {
    handle database::stats(& *db) {
        Result::Err(_) => 22,
        Result::Ok(stats) => handle stats.products == 1 {
            false => 23,
            true => handle stats.queries.memos == 1 {
                false => 24,
                true => handle stats.queries.attempts == 0 {
                    false => 25, true => restart(&mut *db, inputs, root, revision, session),
                },
            },
        },
    }
}

fn forbid_forged_reuse(db: &mut Db, inputs: Inputs, root: identity::RevisionId, revision: identity::RevisionId,
    session: database::Session, ticket: engine::Ticket) -> i64 {
    handle drive(&mut *db, ticket) {
        Result::Ok(engine::Event::Read(_)) => handle database::publish(&mut *db, ticket,
            Product { answer: 99 }, inputs.after.fingerprint, query::Completeness::Complete) {
            Result::Err(database::Failure::Engine(engine::Failure::Busy)) =>
                rejected_cleanly(&mut *db, inputs, root, revision, session),
            _ => 26,
        },
        _ => 27,
    }
}

fn second_session(db: &mut Db, inputs: Inputs, root: identity::RevisionId, revision: identity::RevisionId) -> i64 {
    handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, 1, 100) {
        Result::Err(_) => 28,
        Result::Ok(session) => handle database::start(&mut *db, session, inputs.key, None) {
            Result::Ok(ticket) => forbid_forged_reuse(&mut *db, inputs, root, revision, session, ticket), _ => 29,
        },
    }
}

fn root_published(db: &mut Db, inputs: Inputs, revision: identity::RevisionId, session: database::Session,
    ticket: engine::Ticket) -> i64 {
    handle drive(&mut *db, ticket) {
        Result::Ok(engine::Event::Ready(_)) => handle database::close(&mut *db, session) {
            Result::Err(_) => 30,
            Result::Ok(_) => handle database::import(&mut *db, World { version: 2 }, inputs.after.fingerprint, Result::Ok(revision)) {
                Result::Ok(next) => second_session(&mut *db, inputs, revision, next), _ => 31,
            },
        },
        _ => 32,
    }
}

fn root_started(db: &mut Db, inputs: Inputs, revision: identity::RevisionId, session: database::Session,
    ticket: engine::Ticket) -> i64 {
    handle drive(&mut *db, ticket) {
        Result::Ok(engine::Event::Compute { key: _ }) => handle record_publish(&mut *db, ticket, inputs.before, inputs.obsolete, 40) {
            Result::Ok(_) => root_published(&mut *db, inputs, revision, session, ticket), _ => 33,
        },
        _ => 34,
    }
}

fn imported(db: &mut Db, inputs: Inputs) -> i64 {
    handle database::import(&mut *db, World { version: 1 }, inputs.before.fingerprint, None) {
        Result::Err(_) => 35,
        Result::Ok(revision) => handle database::open(&mut *db, revision, query::RecoveryPolicy::Reject, 1, 100) {
            Result::Err(_) => 36,
            Result::Ok(session) => handle database::start(&mut *db, session, inputs.key, None) {
                Result::Ok(ticket) => root_started(&mut *db, inputs, revision, session, ticket), _ => 37,
            },
        },
    }
}

fn initialized(slot: storage::Handle, before: identity::Digest, after: identity::Digest, third: identity::Digest) -> i64 {
    let db = create<World, Product>(77, 8, 8, 16, 16, 16);
    handle family<u32>(&mut db, 1, query::RecoveryPolicy::Reject, engine::ReusePolicy::Tracked, 8) {
        Result::Err(_) => 38,
        Result::Ok(family) => handle database::intern(&mut family, 7) {
            Result::Err(_) => 39,
            Result::Ok(key) => imported(&mut db, Inputs { key: key,
                before: Read { identity: query::read_identity(2, slot, 0), fingerprint: before, completeness: query::Completeness::Complete },
                after: Read { identity: query::read_identity(2, slot, 0), fingerprint: after, completeness: query::Completeness::Complete },
                obsolete: Read { identity: query::read_identity(0, slot, 0), fingerprint: before, completeness: query::Completeness::Complete },
                replacement: Read { identity: query::read_identity(1, slot, 0), fingerprint: after, completeness: query::Completeness::Complete },
                third: third }),
        },
    }
}

fn identified(before: identity::Digest, after: identity::Digest, third: identity::Digest) -> i64 {
    // These are adapter-supplied input observations, not compiler providers.
    let keys = storage::namespace<u32>(77, 100, 4);
    handle storage::insert(&mut keys, 7) { Result::Ok(slot) => initialized(slot, before, after, third), _ => 40 }
}

pub fn main() -> i64 {
    handle identity::hash(b"world-1") {
        Result::Err(_) => 41,
        Result::Ok(before) => handle identity::hash(b"world-2") {
            Result::Err(_) => 43,
            Result::Ok(after) => handle identity::hash(b"world-3") {
                Result::Ok(third) => identified(before, after, third), _ => 44,
            },
        },
    }
}
