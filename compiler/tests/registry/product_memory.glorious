use std::*;
use kernel::identity;
use kernel::engine;
use kernel::operation;
use kernel::operation::budget;
pub mod kernel;
pub mod source;
pub mod registry;

struct Inputs { blob: source::Blob, version: u32 }
impl registry::World for Inputs {
    source<'a>(world: &'a Inputs, file: identity::FileKey) -> Option<&'a source::Blob> {
        handle identity::equal(file.digest, source::file(&world.blob).digest) { true => Result::Ok(&world.blob), false => None }
    }
}
type Db = registry::Registry<Inputs>;
struct Fixture { db: Db, file: identity::FileKey, revision: identity::RevisionId }
impl Use<[0, 1]> for Fixture {}
fn check(value: Bool) -> i64 { handle value { true => 1, false => -1000 } }
fn ok<T>(value: Result<T, registry::Failure>) -> i64 where T: Use<[0, 1]> { handle value { Result::Ok(_) => 1, _ => -1000 } }
fn blob(file: identity::FileKey, text: Slice<u8>) -> Result<source::Blob, registry::Failure> {
    let bytes = Vec<u8>::new();
    Vec::extend_from_slice(&mut bytes, text);
    let controls = operation::create(1000, 1000);
    handle source::create(file, bytes, 128, &mut controls) { Result::Err(error) => Result::Err(registry::Failure::Source(error)), Result::Ok(value) => Result::Ok(value) }
}
fn import(db: &mut Db, file: identity::FileKey, parent: Option<identity::RevisionId>) -> Result<identity::RevisionId, registry::Failure> {
    import_text(db, file, parent, b"a\nb\nc\nd\ne")
}
fn import_text(db: &mut Db, file: identity::FileKey, parent: Option<identity::RevisionId>, text: Slice<u8>) -> Result<identity::RevisionId, registry::Failure> {
    handle blob(file, text) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => {
            let version = handle parent { Result::Err(_) => as<u32>(0), Result::Ok(_) => as<u32>(1) };
            handle world_fingerprint(&value, version) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(fingerprint) => registry::import(db, Inputs { blob: value, version: version }, fingerprint, parent),
            }
        },
    }
}
fn world_fingerprint(value: &source::Blob, version: u32) -> Result<identity::Digest, registry::Failure> {
    let buffer = ByteBuf::new(128);
    handle identity::write_digest(&mut buffer, source::file(value).digest) {
        Result::Err(_) => Result::Err(registry::Failure::Invariant),
        Result::Ok(_) => handle identity::write_digest(&mut buffer, source::fingerprint(value)) {
            Result::Err(_) => Result::Err(registry::Failure::Invariant),
            Result::Ok(_) => handle ByteBuf::push(&mut buffer, as<u8>(version)) {
                Result::Err(_) => Result::Err(registry::Failure::Invariant),
                Result::Ok(_) => handle identity::hash(ByteBuf::view(&buffer)) {
                    Result::Err(_) => Result::Err(registry::Failure::Invariant), Result::Ok(value) => Result::Ok(value),
                },
            },
        },
    }
}
fn fixture(id: u64) -> Result<Fixture, registry::Failure> {
    fixture_text(id, b"a\nb\nc\nd\ne")
}
fn fixture_text(id: u64, text: Slice<u8>) -> Result<Fixture, registry::Failure> {
    let limits = registry::Limits { revisions: 4, sessions: 2, attempts: 4, memos: 8, reads: 8, keys: 4,
        source_products: 4, line_products: 4, lex_products: 4, drivers: 2, frames: 4, source_bytes: 128, lines: 32, tokens: 129 };
    handle registry::create<Inputs>(id, limits) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(db) => handle identity::file(b"app", b"src/memory", 128) {
            Result::Err(_) => Result::Err(registry::Failure::Invariant),
            Result::Ok(file) => handle import_text(&mut db, file, None, text) {
                Result::Err(error) => Result::Err(error), Result::Ok(revision) => Result::Ok(Fixture { db: db, file: file, revision: revision }),
            },
        },
    }
}
fn open(db: &mut Db, revision: identity::RevisionId, root: u64, source: u64, lines: u64, leases: usize) -> Result<registry::Session, registry::Failure> {
    registry::open_with_resources(db, revision, 10000, root, registry::ResourceLimits { source: source, lines: lines, lex: 0, reservations: leases })
}
fn drive<T>(db: &mut Db, session: registry::Session, query: registry::Query<T>, ceiling: u64, fuel: usize)
    -> Result<registry::Value<T>, registry::Failure> {
    handle fuel == 0 {
        true => Result::Err(registry::Failure::Invariant),
        false => handle registry::memory_spent(& *db, session) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(spent) => handle spent <= ceiling {
                false => Result::Err(registry::Failure::Invariant),
                true => handle registry::poll(&mut *db, query) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(event) => handle event {
                        registry::Event::Ready(value) => Result::Ok(value), _ => drive(db, session, query, ceiling, fuel - 1),
                    },
                },
            },
        },
    }
}
fn lines(db: &mut Db, session: registry::Session, file: identity::FileKey, ceiling: u64) -> Result<registry::Value<source::LineIndex>, registry::Failure> {
    handle registry::line_index(&mut *db, session, file) { Result::Err(error) => Result::Err(error), Result::Ok(query) => drive(db, session, query, ceiling, 1000) }
}
fn close(db: &mut Db, session: registry::Session, fuel: usize) -> i64 {
    handle fuel == 0 { true => -1000, false => handle registry::close_step(&mut *db, session) {
        Result::Err(_) => -1000, Result::Ok(registry::CloseStep::Done) => 1, _ => close(db, session, fuel - 1),
    } }
}
fn shut(db: &mut Db, session: registry::Session) -> i64 {
    let started = ok(registry::begin_close(&mut *db, session)); started + close(db, session, 1000)
}
fn sweep(db: &mut Db, fuel: usize) -> Result<kernel::database::Collected, registry::Failure> {
    handle fuel == 0 { true => Result::Err(registry::Failure::Invariant), false => handle registry::collect_step(&mut *db) {
        Result::Err(error) => Result::Err(error), Result::Ok(registry::CollectionStep::Done(report)) => Result::Ok(report), _ => sweep(db, fuel - 1),
    } }
}
fn collect(db: &mut Db, revision: identity::RevisionId, products: usize) -> i64 {
    let retired = ok(registry::retire(&mut *db, revision));
    let started = ok(registry::collect(&mut *db));
    let report = handle sweep(db, 1000) {
        Result::Err(_) => -1000,
        Result::Ok(report) => check(report.revisions == 1) + check(report.products == products),
    };
    retired + started + report
}
fn owners(db: &Db, phases: usize, closed: usize, roots: usize, leases: usize, closed_roots: usize) -> i64 {
    handle registry::ownership_stats(db) {
        Result::Err(_) => -1000,
        Result::Ok(value) => check(value.phase_owners == phases) + check(value.closed_phase_owners == closed)
            + check(value.root_owners == roots) + check(value.root_leases == leases) + check(value.closed_roots == closed_roots),
    }
}
fn resources(value: registry::ResourceStats, total: u64, source: u64, lines: u64, leases: usize) -> i64 {
    check(value.total == total) + check(value.source == source) + check(value.lines == lines) + check(value.reservations == leases)
}
fn memory(db: &Db, session: registry::Session, total: u64, source: u64, lines: u64, leases: usize) -> i64 {
    let root = handle registry::memory_spent(db, session) { Result::Err(_) => -1000, Result::Ok(value) => check(value == total) };
    root + handle registry::resource_stats(db, session) { Result::Err(_) => -1000, Result::Ok(value) => resources(value, total, source, lines, leases) }
}
fn origin(db: &Db, session: registry::Session, value: registry::Value<source::LineIndex>, closed: Bool) -> i64 {
    handle registry::product_resources(db, session, value) {
        Result::Err(_) => -1000,
        Result::Ok(value) => resources(value.resources, 41, 9, 32, 2)
            + handle value.closed { true => check(closed), false => handle closed { true => -1000, false => 1 } },
    }
}
fn child(db: &mut Db, file: identity::FileKey, parent: identity::RevisionId) -> i64 {
    handle import(&mut *db, file, Result::Ok(parent)) {
        Result::Err(_) => -1000,
        Result::Ok(revision) => handle open(&mut *db, revision, 0, 0, 0, 2) {
            Result::Err(_) => -1000,
            Result::Ok(session) => handle lines(&mut *db, session, file, 0) {
                Result::Err(_) => -1000,
                Result::Ok(value) => {
                    let reused = handle registry::execution(value) { engine::Execution::ReusedFromParent { parent: actual } => check(identity::same_revision(actual, parent)), _ => -1000 };
                    let retained = origin(& *db, session, value, true) + memory(& *db, session, 0, 0, 0, 0);
                    let parent = collect(&mut *db, parent, 0) + owners(& *db, 2, 1, 1, 2, 1);
                    let closed = shut(&mut *db, session) + owners(& *db, 1, 1, 1, 2, 1);
                    reused + retained + parent + closed + collect(&mut *db, revision, 2) + owners(& *db, 0, 0, 0, 0, 0)
                },
            },
        },
    }
}
fn consumer(db: &mut Db, file: identity::FileKey, revision: identity::RevisionId) -> i64 {
    handle open(&mut *db, revision, 0, 0, 0, 2) {
        Result::Err(_) => -1000,
        Result::Ok(session) => handle lines(&mut *db, session, file, 0) {
            Result::Err(_) => -1000,
            Result::Ok(value) => {
                let cached = handle registry::execution(value) { engine::Execution::Memoized { revision: _ } => 1, _ => -1000 };
                let held = origin(& *db, session, value, true) + memory(& *db, session, 0, 0, 0, 0) + owners(& *db, 2, 1, 1, 2, 1);
                cached + held + shut(&mut *db, session) + child(db, file, revision)
            },
        },
    }
}
fn lifecycle() -> i64 {
    handle fixture(401) {
        Result::Err(_) => -1000,
        Result::Ok(fixture) => handle open(&mut fixture.db, fixture.revision, 41, 9, 32, 2) {
            Result::Err(_) => -1000,
            Result::Ok(session) => handle lines(&mut fixture.db, session, fixture.file, 41) {
                Result::Err(_) => -1000,
                Result::Ok(value) => {
                    let charged = memory(&fixture.db, session, 41, 9, 32, 2) + owners(&fixture.db, 1, 0, 1, 2, 0) + origin(&fixture.db, session, value, false);
                    let content = handle registry::line_value(&fixture.db, session, value) { Result::Err(_) => -1000, Result::Ok(value) => check(source::line_count(value) == 5) };
                    let closed = shut(&mut fixture.db, session) + owners(&fixture.db, 1, 1, 1, 2, 1);
                    charged + content + closed + consumer(&mut fixture.db, fixture.file, fixture.revision)
                },
            },
        },
    }
}
fn expected(error: registry::Failure, mode: u32) -> i64 {
    handle error {
        registry::Failure::Database(kernel::database::Failure::Engine(engine::Failure::Control(operation::Failure::ResourceLimit { name, ceiling, requested }))) =>
            check(mode == 0) + check(name == 1) + check(ceiling == 40) + check(requested == 16),
        registry::Failure::Budget(budget::Failure::Control(operation::Failure::ResourceLimit { name, ceiling, requested })) =>
            handle mode { 1 => check(name == 3) + check(ceiling == 31) + check(requested == 16) + 1,
                3 => check(name == 2) + check(ceiling == 8) + check(requested == 9) + 1, _ => -1000 },
        registry::Failure::Budget(budget::Failure::Storage(kernel::storage::StorageError::Capacity)) => check(mode == 2) + 3,
        _ => -1000,
    }
}
fn failure_case(mode: u32) -> i64 {
    handle fixture(410 + as<u64>(mode)) {
        Result::Err(_) => -1000,
        Result::Ok(fixture) => {
            let root = as<u64>(handle mode { 0 => 40, _ => 41 });
            let source = as<u64>(handle mode { 3 => 8, _ => 9 });
            let lines_limit = as<u64>(handle mode { 1 => 31, _ => 32 });
            let leases = as<usize>(handle mode { 2 => 1, _ => 2 });
            let maximum = as<u64>(handle mode { 2 => 9, 3 => 0, _ => 25 });
            let retained = as<u64>(handle mode { 3 => 0, _ => 9 });
            let products = as<usize>(handle mode { 3 => 0, _ => 1 });
            handle open(&mut fixture.db, fixture.revision, root, source, lines_limit, leases) {
                Result::Err(_) => -1000,
                Result::Ok(session) => {
                    let rejected = handle lines(&mut fixture.db, session, fixture.file, maximum) { Result::Ok(_) => -1000, Result::Err(error) => expected(error, mode) };
                    let kept = memory(&fixture.db, session, retained, retained, 0, products) + owners(&fixture.db, 1, 0, products, products, 0);
                    rejected + kept + shut(&mut fixture.db, session) + owners(&fixture.db, products, products, products, products, products)
                        + collect(&mut fixture.db, fixture.revision, products) + owners(&fixture.db, 0, 0, 0, 0, 0)
                },
            }
        },
    }
}
fn until_builder(db: &mut Db, session: registry::Session, query: registry::Query<source::LineIndex>, fuel: usize) -> i64 {
    handle fuel == 0 { true => -1000, false => handle registry::memory_spent(& *db, session) {
        Result::Ok(25) => 1,
        _ => handle registry::poll(&mut *db, query) { Result::Ok(registry::Event::Continue) => until_builder(db, session, query, fuel - 1), _ => -1000 },
    } }
}
fn cancellation() -> i64 {
    handle fixture(420) { Result::Err(_) => -1000, Result::Ok(fixture) => handle open(&mut fixture.db, fixture.revision, 41, 9, 32, 2) {
        Result::Err(_) => -1000, Result::Ok(session) => handle registry::line_index(&mut fixture.db, session, fixture.file) {
            Result::Err(_) => -1000,
            Result::Ok(query) => {
                let suspended = until_builder(&mut fixture.db, session, query, 1000) + memory(&fixture.db, session, 25, 9, 16, 2);
                let cancelled = ok(registry::cancel(&mut fixture.db, session));
                let closed = shut(&mut fixture.db, session) + owners(&fixture.db, 1, 1, 1, 1, 1);
                suspended + cancelled + closed + collect(&mut fixture.db, fixture.revision, 1) + owners(&fixture.db, 0, 0, 0, 0, 0)
            },
        },
    } }
}
fn empty_source() -> i64 {
    handle fixture_text(430, b"") { Result::Err(_) => -1000, Result::Ok(fixture) => handle open(&mut fixture.db, fixture.revision, 0, 0, 0, 1) {
        Result::Err(_) => -1000, Result::Ok(session) => handle registry::source_bytes(&mut fixture.db, session, fixture.file) {
            Result::Err(_) => -1000,
            Result::Ok(query) => handle drive(&mut fixture.db, session, query, 0, 1000) {
                Result::Err(_) => -1000,
                Result::Ok(value) => {
                    let empty = handle registry::source_value(&fixture.db, session, value) { Result::Err(_) => -1000, Result::Ok(value) => check(source::length(value) == 0) };
                    let held = memory(&fixture.db, session, 0, 0, 0, 1) + owners(&fixture.db, 1, 0, 1, 1, 0);
                    let closed = shut(&mut fixture.db, session) + owners(&fixture.db, 1, 1, 1, 1, 1);
                    empty + held + closed + collect(&mut fixture.db, fixture.revision, 1) + owners(&fixture.db, 0, 0, 0, 0, 0)
                },
            },
        },
    } }
}
pub fn main() -> (i64, i64, i64, i64, i64, i64, i64) { (lifecycle(), failure_case(0), failure_case(1), failure_case(2), failure_case(3), cancellation(), empty_source()) }
