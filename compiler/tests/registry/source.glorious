use std::*;
use kernel::identity;
use kernel::operation;
use kernel::engine;
pub mod kernel;
pub mod source;
pub mod registry;

pub struct Inputs { first: source::Blob, second: source::Blob }
pub impl registry::World for Inputs {
    source<'a>(world: &'a Inputs, file: identity::FileKey) -> Option<&'a source::Blob> {
        handle identity::equal(source::file(&world.first).digest, file.digest) {
            true => Result::Ok(&world.first),
            false => handle identity::equal(source::file(&world.second).digest, file.digest) {
                true => Result::Ok(&world.second), false => None,
            },
        }
    }
}
pub type Db = registry::Registry<Inputs>;
struct Files { first: identity::FileKey, second: identity::FileKey }
struct Root { revision: identity::RevisionId, session: registry::Session, value: registry::Value<source::LineIndex> }
fn owned(bytes: Slice<u8>) -> Vec<u8> { let value = Vec<u8>::new(); Vec::extend_from_slice(&mut value, bytes); value }
fn limits() -> registry::Limits {
    registry::Limits { revisions: 8, sessions: 8, attempts: 16, memos: 32, reads: 16, keys: 16,
        source_products: 16, line_products: 16, drivers: 8, frames: 8, source_bytes: 1024, lines: 64 }
}
fn world(first: identity::FileKey, second: identity::FileKey, a: Slice<u8>, b: Slice<u8>) -> Result<Inputs, source::Failure> {
    let controls = operation::create(10000, 10000);
    handle source::create(first, owned(a), 1024, &mut controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(first) => handle source::create(second, owned(b), 1024, &mut controls) {
            Result::Err(error) => Result::Err(error), Result::Ok(second) => Result::Ok(Inputs { first: first, second: second }),
        },
    }
}
// This two-source fixture adapter has its own exact content fingerprint. It
// does not stand in for CompilationRequest::normalize or a production world.
fn world_fingerprint(world: &Inputs) -> Result<identity::Digest, identity::IdentityError> {
    let bytes = ByteBuf::new(128);
    identity::write_digest(&mut bytes, source::file(&world.first).digest);
    identity::write_digest(&mut bytes, source::fingerprint(&world.first));
    identity::write_digest(&mut bytes, source::file(&world.second).digest);
    identity::write_digest(&mut bytes, source::fingerprint(&world.second));
    identity::hash(ByteBuf::view(&bytes))
}
fn import(db: &mut Db, first: identity::FileKey, second: identity::FileKey, a: Slice<u8>, b: Slice<u8>, parent: Option<identity::RevisionId>)
    -> Result<identity::RevisionId, registry::Failure> {
    handle world(first, second, a, b) {
        Result::Err(error) => Result::Err(registry::Failure::Source(error)),
        Result::Ok(world) => handle world_fingerprint(&world) {
            Result::Err(_) => Result::Err(registry::Failure::Invariant),
            Result::Ok(fingerprint) => registry::import(db, world, fingerprint, parent),
        },
    }
}
fn drive<T>(db: &mut Db, request: registry::Query<T>, fuel: usize) -> Result<registry::Value<T>, registry::Failure> {
    handle fuel == 0 {
        true => Result::Err(registry::Failure::Invariant),
        false => handle registry::poll(&mut *db, request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(event) => handle event {
                registry::Event::Ready(value) => Result::Ok(value),
                registry::Event::Continue => drive(db, request, fuel - 1),
                registry::Event::Waiting => Result::Err(registry::Failure::Busy),
            },
        },
    }
}
fn lines(db: &mut Db, session: registry::Session, file: identity::FileKey) -> Result<registry::Value<source::LineIndex>, registry::Failure> {
    handle registry::line_index(&mut *db, session, file) { Result::Err(error) => Result::Err(error), Result::Ok(request) => drive(db, request, 1000) }
}
fn bytes(db: &mut Db, session: registry::Session, file: identity::FileKey) -> Result<registry::Value<source::Blob>, registry::Failure> {
    handle registry::source_bytes(&mut *db, session, file) { Result::Err(error) => Result::Err(error), Result::Ok(request) => drive(db, request, 1000) }
}
fn close_steps(db: &mut Db, session: registry::Session, fuel: usize) -> Result<(), registry::Failure> {
    handle fuel == 0 {
        true => Result::Err(registry::Failure::Invariant),
        false => handle registry::close_step(&mut *db, session) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(event) => handle event { registry::CloseStep::Done => Result::Ok(()), _ => close_steps(db, session, fuel - 1) },
        },
    }
}
fn close(db: &mut Db, session: registry::Session) -> Result<(), registry::Failure> {
    handle registry::begin_close(&mut *db, session) { Result::Err(error) => Result::Err(error), Result::Ok(_) => close_steps(db, session, 1000) }
}
fn gc(db: &mut Db, fuel: usize) -> Result<kernel::database::Collected, registry::Failure> {
    handle fuel == 0 {
        true => Result::Err(registry::Failure::Invariant),
        false => handle registry::collect_step(&mut *db) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(event) => handle event { registry::CollectionStep::Done(value) => Result::Ok(value), _ => gc(db, fuel - 1) },
        },
    }
}
fn count(left: usize, right: usize) -> i64 { handle left == right { true => 1, false => 0 } }
fn ok<T>(result: Result<T, registry::Failure>) -> i64 where T: Use<[0, 1]> { handle result { Result::Ok(_) => 1, _ => 0 } }
fn cached<T>(value: registry::Value<T>) -> i64 { handle registry::execution(value) { engine::Execution::Memoized { revision: _ } => 1, _ => 0 } }
fn cold<T>(value: registry::Value<T>) -> i64 { handle registry::execution(value) { engine::Execution::Recomputed(engine::Reason::Cold) => 1, _ => 0 } }
fn retained(db: &Db, sources: usize, lines: usize, memos: usize, edges: usize) -> i64 {
    handle registry::stats(db) {
        Result::Err(_) => -1,
        Result::Ok(stats) => count(stats.sources, sources) + count(stats.lines, lines) + count(stats.core.products, sources + lines)
            + count(stats.core.queries.memos, memos) + count(stats.core.queries.edges, edges)
            + count(stats.drivers, 0) + count(stats.core.queries.attempts, 0),
    }
}
fn inspect(db: &Db, session: registry::Session, value: registry::Value<source::LineIndex>) -> i64 {
    handle registry::line_value(db, session, value) {
        Result::Err(_) => -2,
        Result::Ok(lines) => { let starts = source::line_starts(lines);
            count(as<usize>(source::line_count(lines)), 2)
                + count(as<usize>(*Slice::get_unchecked(starts, 1)), 2) },
    }
}
fn inspect_bytes(db: &Db, session: registry::Session, value: registry::Value<source::Blob>) -> i64 {
    handle registry::source_value(db, session, value) {
        Result::Err(_) => -3,
        Result::Ok(blob) => { let contents = source::bytes(blob);
            count(as<usize>(source::length(blob)), 6)
                + count(as<usize>(*Slice::get_unchecked(contents, 0)), 97) },
    }
}
fn empty(db: &Db, report: kernel::database::Collected) -> i64 {
    let score = count(report.revisions, 1) + count(report.memos, 2) + count(report.products, 2) + count(report.edges, 2);
    handle registry::stats(db) {
        Result::Err(_) => -4,
        Result::Ok(stats) => score + count(stats.sources, 0) + count(stats.lines, 0) + count(stats.sessions, 0)
            + count(stats.core.revisions.retained, 0) + count(stats.core.revisions.snapshot_pins, 0),
    }
}
fn retire(db: &mut Db, revision: identity::RevisionId, session: registry::Session, score: i64) -> i64 {
    let score = score + ok(close(&mut *db, session)) + ok(registry::retire(&mut *db, revision)) + ok(registry::collect(&mut *db));
    handle gc(&mut *db, 1000) {
        Result::Err(_) => -5,
        Result::Ok(report) => {
            score + empty(& *db, report)
        },
    }
}
fn hit(db: &mut Db, revision: identity::RevisionId, session: registry::Session, file: identity::FileKey, score: i64) -> i64 {
    handle bytes(&mut *db, session, file) {
        Result::Err(_) => -6,
        Result::Ok(value) => {
            let score = score + cached(value) + inspect_bytes(& *db, session, value);
            handle lines(&mut *db, session, file) {
                Result::Err(_) => -7,
                Result::Ok(value) => {
                    let score = score + cached(value) + inspect(& *db, session, value) + retained(& *db, 1, 1, 2, 2);
                    retire(db, revision, session, score)
                },
            }
        },
    }
}
fn session(db: &mut Db, revision: identity::RevisionId, file: identity::FileKey) -> i64 {
    handle registry::open(&mut *db, revision, 10000, 10000) {
        Result::Err(_) => -8,
        Result::Ok(session) => handle lines(&mut *db, session, file) {
            Result::Err(_) => -9,
            Result::Ok(value) => {
                let score = cold(value) + inspect(& *db, session, value) + retained(& *db, 1, 1, 2, 2);
                hit(db, revision, session, file, score)
            },
        },
    }
}
fn basic(first: identity::FileKey, second: identity::FileKey) -> i64 {
    handle registry::create<Inputs>(91, limits()) {
        Result::Err(_) => -10,
        Result::Ok(db) => handle import(&mut db, first, second, b"a\n\xf0\x9f\x98\x80", b"z", None) {
            Result::Err(_) => -11, Result::Ok(revision) => session(&mut db, revision, first),
        },
    }
}
fn reused<T>(value: registry::Value<T>, expected: identity::RevisionId) -> i64 {
    handle registry::execution(value) {
        engine::Execution::ReusedFromParent { parent } => handle identity::same_revision(parent, expected) { true => 1, false => 0 },
        _ => 0,
    }
}
fn rejected<T>(value: registry::Value<T>, expected: identity::RevisionId) -> i64 {
    handle registry::execution(value) {
        engine::Execution::Recomputed(reason) => handle reason {
            engine::Reason::ParentReuseRejected { parent } => handle identity::same_revision(parent, expected) { true => 1, false => 0 },
            _ => 0,
        },
        _ => 0,
    }
}
fn same_fingerprint<T>(left: registry::Value<T>, right: registry::Value<T>) -> i64 {
    handle identity::equal(registry::fingerprint(left), registry::fingerprint(right)) { true => 1, false => 0 }
}
fn line_count(db: &Db, root: Root, expected: usize) -> i64 {
    handle registry::line_value(db, root.session, root.value) {
        Result::Err(_) => -20, Result::Ok(value) => count(as<usize>(source::line_count(value)), expected),
    }
}
fn wrong_revision(db: &Db, session: registry::Session, value: registry::Value<source::LineIndex>) -> i64 {
    handle registry::line_value(db, session, value) { Result::Err(_) => 1, Result::Ok(_) => 0 }
}
fn root(db: &mut Db, files: Files, a: Slice<u8>, b: Slice<u8>, parent: Option<identity::RevisionId>) -> Result<Root, registry::Failure> {
    handle import(&mut *db, files.first, files.second, a, b, parent) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(revision) => handle registry::open(&mut *db, revision, 10000, 10000) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(session) => handle lines(db, session, files.first) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(value) => Result::Ok(Root { revision: revision, session: session, value: value }),
            },
        },
    }
}
fn sweep(db: &mut Db) -> Result<kernel::database::Collected, registry::Failure> {
    handle registry::collect(&mut *db) { Result::Err(error) => Result::Err(error), Result::Ok(_) => gc(db, 1000) }
}
fn report(value: kernel::database::Collected, revisions: usize, memos: usize, products: usize, edges: usize) -> i64 {
    count(value.revisions, revisions) + count(value.memos, memos) + count(value.products, products) + count(value.edges, edges)
}
fn no_sessions(db: &Db) -> i64 {
    handle registry::stats(db) {
        Result::Err(_) => -21,
        Result::Ok(stats) => count(stats.sessions, 0) + count(stats.core.revisions.retained, 0) + count(stats.core.revisions.snapshot_pins, 0),
    }
}
fn reuse_last(db: &mut Db, changed: Root, score: i64) -> i64 {
    let score = score + ok(registry::retire(&mut *db, changed.revision)) + ok(close(&mut *db, changed.session));
    handle sweep(&mut *db) {
        Result::Err(_) => -22,
        Result::Ok(value) => score + report(value, 1, 2, 2, 2) + retained(& *db, 0, 0, 0, 0) + no_sessions(& *db),
    }
}
fn reuse_release_child(db: &mut Db, child: Root, changed: Root, score: i64) -> i64 {
    let score = score + ok(registry::retire(&mut *db, child.revision)) + ok(close(&mut *db, child.session));
    handle sweep(&mut *db) {
        Result::Err(_) => -23,
        Result::Ok(value) => {
            let score = score + report(value, 1, 2, 2, 2) + retained(& *db, 1, 1, 2, 2) + line_count(& *db, changed, 3);
            reuse_last(db, changed, score)
        },
    }
}
fn reuse_release_root(db: &mut Db, original: Root, child: Root, changed: Root, score: i64) -> i64 {
    let score = score + ok(close(&mut *db, original.session));
    handle sweep(&mut *db) {
        Result::Err(_) => -24,
        Result::Ok(value) => {
            let score = score + report(value, 1, 2, 0, 2) + retained(& *db, 2, 2, 4, 4)
                + inspect(& *db, child.session, child.value) + wrong_revision(& *db, changed.session, original.value);
            reuse_release_child(db, child, changed, score)
        },
    }
}
fn reuse_pinned(db: &mut Db, original: Root, child: Root, changed: Root, score: i64) -> i64 {
    let score = score + ok(registry::retire(&mut *db, original.revision));
    handle sweep(&mut *db) {
        Result::Err(_) => -25,
        Result::Ok(value) => {
            let score = score + report(value, 0, 0, 0, 0) + retained(& *db, 2, 2, 6, 6) + inspect(& *db, original.session, original.value);
            reuse_release_root(db, original, child, changed, score)
        },
    }
}
fn reuse_changed(db: &mut Db, files: Files, original: Root, child: Root, score: i64) -> i64 {
    handle root(&mut *db, files, b"b\n\n", b"zz", Result::Ok(child.revision)) {
        Result::Err(_) => -26,
        Result::Ok(changed) => {
            let score = score + rejected(changed.value, child.revision) + (1 - same_fingerprint(changed.value, child.value))
                + line_count(& *db, changed, 3) + inspect(& *db, original.session, original.value)
                + inspect(& *db, child.session, child.value) + retained(& *db, 2, 2, 6, 6);
            reuse_pinned(db, original, child, changed, score)
        },
    }
}
fn reuse_child(db: &mut Db, files: Files, original: Root, score: i64) -> i64 {
    handle root(&mut *db, files, b"a\n\xf0\x9f\x98\x80", b"zz", Result::Ok(original.revision)) {
        Result::Err(_) => -27,
        Result::Ok(child) => {
            let score = score + reused(child.value, original.revision) + same_fingerprint(child.value, original.value)
                + inspect(& *db, child.session, child.value) + inspect(& *db, original.session, original.value) + retained(& *db, 1, 1, 4, 4);
            reuse_changed(db, files, original, child, score)
        },
    }
}
fn reuse_history(db: &mut Db, files: Files) -> i64 {
    handle root(&mut *db, files, b"a\n\xf0\x9f\x98\x80", b"z", None) {
        Result::Err(_) => -28,
        Result::Ok(original) => {
            let score = cold(original.value) + inspect(& *db, original.session, original.value) + retained(& *db, 1, 1, 2, 2);
            reuse_child(db, files, original, score)
        },
    }
}
// Pause after the committed child has been delivered, before the line builder
// is created. This observes actual retained products/attempts, not a hard-coded
// scheduler tick count. No second request has been admitted to this key yet.
fn until_child(db: &mut Db, request: registry::Query<source::LineIndex>, sources: usize, fuel: usize) -> Result<(), registry::Failure> {
    handle fuel == 0 {
        true => Result::Err(registry::Failure::Invariant),
        false => handle registry::stats(& *db) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(stats) => handle stats.sources == sources {
                true => handle stats.core.queries.attempts == 1 {
                    true => Result::Ok(()), false => child_progress(db, request, sources, fuel),
                },
                false => child_progress(db, request, sources, fuel),
            },
        },
    }
}
fn child_progress(db: &mut Db, request: registry::Query<source::LineIndex>, sources: usize, fuel: usize) -> Result<(), registry::Failure> {
    handle registry::poll(&mut *db, request) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(event) => handle event {
            registry::Event::Continue => until_child(db, request, sources, fuel - 1),
            _ => Result::Err(registry::Failure::Invariant),
        },
    }
}
fn step_n(db: &mut Db, request: registry::Query<source::LineIndex>, steps: usize) -> Result<(), registry::Failure> {
    handle steps == 0 {
        true => Result::Ok(()),
        false => handle registry::poll(&mut *db, request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(event) => handle event {
                registry::Event::Continue => step_n(db, request, steps - 1),
                _ => Result::Err(registry::Failure::Invariant),
            },
        },
    }
}
fn waiting(db: &mut Db, request: registry::Query<source::LineIndex>, fuel: usize) -> Result<(), registry::Failure> {
    handle fuel == 0 {
        true => Result::Err(registry::Failure::Invariant),
        false => handle registry::poll(&mut *db, request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(event) => handle event {
                registry::Event::Continue => waiting(db, request, fuel - 1),
                registry::Event::Waiting => Result::Ok(()),
                _ => Result::Err(registry::Failure::Invariant),
            },
        },
    }
}
fn cancelled<T>(result: Result<registry::Value<T>, registry::Failure>) -> i64 {
    handle result {
        Result::Err(error) => handle error {
            registry::Failure::Database(error) => handle error {
                kernel::database::Failure::Engine(error) => handle error {
                    engine::Failure::Control(error) => handle error { operation::Failure::Cancelled => 1, _ => 0 }, _ => 0,
                }, _ => 0,
            }, _ => 0,
        }, _ => 0,
    }
}
fn closed_query(db: &mut Db, request: registry::Query<source::LineIndex>) -> i64 {
    handle registry::poll(db, request) {
        Result::Err(error) => handle error { registry::Failure::Closed => 1, _ => 0 }, _ => 0,
    }
}
fn is_closing(db: &mut Db, session: registry::Session, file: identity::FileKey) -> i64 {
    handle registry::line_index(db, session, file) {
        Result::Err(error) => handle error { registry::Failure::Closing => 1, _ => 0 }, _ => 0,
    }
}
fn waiter_only(db: &Db) -> i64 {
    handle registry::stats(db) {
        Result::Err(_) => -31,
        Result::Ok(stats) => count(stats.sources, 1) + count(stats.lines, 0) + count(stats.core.products, 1)
            + count(stats.core.queries.memos, 1) + count(stats.core.queries.edges, 1)
            + count(stats.drivers, 1) + count(stats.core.queries.attempts, 1),
    }
}
fn abandon(db: &mut Db, session: registry::Session, file: identity::FileKey) -> Result<(), registry::Failure> {
    handle registry::line_index(&mut *db, session, file) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(request) => handle until_child(&mut *db, request, 2, 1000) {
            Result::Err(error) => Result::Err(error),
            // Construct the builder, then discard the only public Query handle.
            Result::Ok(_) => step_n(db, request, 1),
        },
    }
}
fn interleave_collect(db: &mut Db, revision: identity::RevisionId, score: i64) -> i64 {
    let score = score + retained(& *db, 2, 1, 3, 3) + ok(registry::retire(&mut *db, revision));
    handle sweep(&mut *db) {
        Result::Err(_) => -32,
        Result::Ok(value) => score + report(value, 1, 3, 3, 3) + retained(& *db, 0, 0, 0, 0) + no_sessions(& *db),
    }
}
fn interleave_abandon(db: &mut Db, revision: identity::RevisionId, session: registry::Session, files: Files, score: i64) -> i64 {
    handle abandon(&mut *db, session, files.second) {
        Result::Err(_) => -33,
        Result::Ok(_) => {
            let score = score + ok(registry::begin_close(&mut *db, session)) + is_closing(&mut *db, session, files.first);
            let score = score + ok(registry::begin_close(&mut *db, session)) + ok(close_steps(&mut *db, session, 1000));
            interleave_collect(db, revision, score)
        },
    }
}
fn takeover(db: &mut Db, revision: identity::RevisionId, first: registry::Session, second: registry::Session,
    waiter: registry::Query<source::LineIndex>, files: Files, score: i64) -> i64 {
    handle drive(&mut *db, waiter, 1000) {
        Result::Err(_) => -34,
        Result::Ok(value) => {
            let score = score + cold(value) + inspect(& *db, second, value) + retained(& *db, 1, 1, 2, 2);
            let score = score + ok(close(&mut *db, first));
            interleave_abandon(db, revision, second, files, score)
        },
    }
}
fn interleave_waiter(db: &mut Db, revision: identity::RevisionId, first: registry::Session, second: registry::Session,
    owner: registry::Query<source::LineIndex>, files: Files) -> i64 {
    handle registry::line_index(&mut *db, second, files.first) {
        Result::Err(_) => -35,
        Result::Ok(waiter) => handle waiting(&mut *db, waiter, 1000) {
            Result::Err(_) => -36,
            Result::Ok(_) => {
                let score = ok(registry::cancel(&mut *db, first)) + cancelled(drive(&mut *db, owner, 1000));
                let score = score + closed_query(&mut *db, owner) + waiter_only(& *db);
                takeover(db, revision, first, second, waiter, files, score)
            },
        },
    }
}
fn interleave_owner(db: &mut Db, revision: identity::RevisionId, first: registry::Session, second: registry::Session, files: Files) -> i64 {
    handle registry::line_index(&mut *db, first, files.first) {
        Result::Err(_) => -37,
        Result::Ok(owner) => handle until_child(&mut *db, owner, 1, 1000) {
            Result::Err(_) => -38,
            Result::Ok(_) => handle step_n(&mut *db, owner, 3) {
                Result::Err(_) => -39, Result::Ok(_) => interleave_waiter(db, revision, first, second, owner, files),
            },
        },
    }
}
fn interleave_open(db: &mut Db, revision: identity::RevisionId, files: Files) -> i64 {
    handle registry::open(&mut *db, revision, 10000, 10000) {
        Result::Err(_) => -40,
        Result::Ok(first) => handle registry::open(&mut *db, revision, 10000, 10000) {
            Result::Err(_) => -41, Result::Ok(second) => interleave_owner(db, revision, first, second, files),
        },
    }
}
fn interleave_history(db: &mut Db, files: Files) -> i64 {
    handle import(&mut *db, files.first, files.second, b"a\n\xf0\x9f\x98\x80", b"z", None) {
        Result::Err(_) => -42, Result::Ok(revision) => interleave_open(db, revision, files),
    }
}
fn equal_code(actual: i64, expected: i64) -> i64 { handle actual == expected { true => 1, false => 0 } }
fn resource_code(error: operation::Failure) -> i64 {
    handle error {
        operation::Failure::ResourceLimit { name: 0, ceiling: 0, requested: _ } => 2,
        _ => -44,
    }
}
fn failure_code(result: Result<registry::Value<source::LineIndex>, registry::Failure>) -> i64 {
    handle result {
        Result::Ok(_) => -45,
        Result::Err(error) => handle error {
            registry::Failure::Capacity => 1,
            registry::Failure::Source(error) => handle error { source::Failure::Capacity => 3, _ => -46 },
            registry::Failure::Database(error) => handle error {
                kernel::database::Failure::Engine(error) => handle error { engine::Failure::Control(error) => resource_code(error), _ => -47 },
                _ => -48,
            },
            _ => -49,
        },
    }
}
fn capacity_limits(case: usize) -> registry::Limits {
    let value = limits();
    handle case {
        0 => { value.source_products = as<usize>(0); value },
        1 => { value.line_products = as<usize>(0); value },
        2 => { value.frames = as<usize>(1); value },
        3 => { value.drivers = as<usize>(0); value },
        4 => { value.source_bytes = as<usize>(5); value },
        5 => { value.lines = as<usize>(1); value },
        _ => value,
    }
}
fn failure_sources(case: usize) -> usize { handle case { 1 => 1, 5 => 1, _ => 0 } }
fn expected_failure(case: usize) -> i64 { handle case { 5 => 3, 6 => 2, _ => 1 } }
fn failure_work(case: usize) -> u64 { handle case { 6 => 0, _ => 10000 } }
fn failure_collect(db: &mut Db, revision: identity::RevisionId, products: usize, score: i64) -> i64 {
    let score = score + ok(registry::retire(&mut *db, revision));
    handle sweep(&mut *db) {
        Result::Err(_) => -50,
        Result::Ok(value) => score + report(value, 1, products, products, products) + retained(& *db, 0, 0, 0, 0) + no_sessions(& *db),
    }
}
fn retry_work(db: &mut Db, revision: identity::RevisionId, file: identity::FileKey, score: i64) -> i64 {
    handle registry::open(&mut *db, revision, 10000, 10000) {
        Result::Err(_) => -51,
        Result::Ok(session) => handle lines(&mut *db, session, file) {
            Result::Err(_) => -52,
            Result::Ok(value) => {
                let score = score + cold(value) + inspect(& *db, session, value) + retained(& *db, 1, 1, 2, 2);
                let score = score + ok(close(&mut *db, session));
                failure_collect(db, revision, 2, score)
            },
        },
    }
}
fn failure_close(db: &mut Db, revision: identity::RevisionId, session: registry::Session, file: identity::FileKey, case: usize, score: i64) -> i64 {
    let score = score + ok(close(&mut *db, session));
    handle case {
        6 => retry_work(db, revision, file, score),
        _ => failure_collect(db, revision, failure_sources(case), score),
    }
}
fn failure_attempts(db: &mut Db, revision: identity::RevisionId, session: registry::Session, file: identity::FileKey, case: usize) -> i64 {
    let sources = failure_sources(case);
    let expected = expected_failure(case);
    let score = equal_code(failure_code(lines(&mut *db, session, file)), expected) + retained(& *db, sources, 0, sources, sources);
    let score = score + equal_code(failure_code(lines(&mut *db, session, file)), expected) + retained(& *db, sources, 0, sources, sources);
    failure_close(db, revision, session, file, case, score)
}
fn failure_open(db: &mut Db, revision: identity::RevisionId, file: identity::FileKey, case: usize) -> i64 {
    handle registry::open(&mut *db, revision, failure_work(case), 10000) {
        Result::Err(_) => -53, Result::Ok(session) => failure_attempts(db, revision, session, file, case),
    }
}
fn failure_case(files: Files, case: usize) -> i64 {
    handle registry::create<Inputs>(wrapping_add(94, as<u64>(case)), capacity_limits(case)) {
        Result::Err(_) => -54,
        Result::Ok(db) => handle import(&mut db, files.first, files.second, b"a\n\xf0\x9f\x98\x80", b"z", None) {
            Result::Err(_) => -55, Result::Ok(revision) => failure_open(&mut db, revision, files.first, case),
        },
    }
}
fn failure_history(files: Files, case: usize, score: i64) -> i64 {
    handle case == 7 {
        true => score,
        false => failure_history(files, case + 1, score + failure_case(files, case)),
    }
}
fn key_counts(db: &Db, sources: usize, lines: usize, source_slots: usize, line_slots: usize) -> i64 {
    handle registry::stats(db) {
        Result::Err(_) => -56,
        Result::Ok(stats) => count(stats.source_keys.live, sources) + count(stats.line_keys.live, lines)
            + count(stats.source_keys.slots, source_slots) + count(stats.line_keys.slots, line_slots),
    }
}
fn limited_keys(count: usize) -> registry::Limits { let value = limits(); value.keys = count; value }
fn file_at(index: usize) -> Result<identity::FileKey, identity::IdentityError> {
    let path = ByteBuf::new(128);
    ByteBuf::append(&mut path, b"src/churn_");
    ByteBuf::push(&mut path, as<u8>(as<usize>(97) + index));
    identity::file(b"app", ByteBuf::view(&path), 128)
}
fn old_values(db: &Db, current: Root, previous: Option<Root>) -> i64 {
    handle previous {
        Result::Err(_) => 0,
        Result::Ok(old) => wrong_revision(db, old.session, old.value) + wrong_revision(db, current.session, old.value),
    }
}
fn churn_final_gc(db: &mut Db, second: identity::FileKey, index: usize, original: Root, score: i64) -> i64 {
    let score = score + ok(close(&mut *db, original.session));
    handle sweep(&mut *db) {
        Result::Err(_) => -57,
        Result::Ok(value) => {
            let score = score + report(value, 1, 2, 2, 2) + key_counts(& *db, 0, 0, 1, 1) + retained(& *db, 0, 0, 0, 0)
                + no_sessions(& *db) + wrong_revision(& *db, original.session, original.value);
            churn_next(db, second, index + 1, Result::Ok(original), score)
        },
    }
}
fn churn_live(db: &mut Db, second: identity::FileKey, index: usize, original: Root, previous: Option<Root>, score: i64) -> i64 {
    let score = score + cold(original.value) + inspect(& *db, original.session, original.value)
        + retained(& *db, 1, 1, 2, 2) + key_counts(& *db, 1, 1, 1, 1) + old_values(& *db, original, previous);
    let score = score + ok(registry::retire(&mut *db, original.revision));
    handle sweep(&mut *db) {
        Result::Err(_) => -58,
        Result::Ok(value) => {
            let score = score + report(value, 0, 0, 0, 0) + key_counts(& *db, 1, 1, 1, 1) + inspect(& *db, original.session, original.value);
            churn_final_gc(db, second, index, original, score)
        },
    }
}
fn churn_next(db: &mut Db, second: identity::FileKey, index: usize, previous: Option<Root>, score: i64) -> i64 {
    handle index == 16 {
        true => score,
        false => handle file_at(index) {
            Result::Err(_) => -59,
            Result::Ok(first) => handle root(&mut *db, Files { first: first, second: second }, b"a\n\xf0\x9f\x98\x80", b"z", None) {
                Result::Err(_) => -60, Result::Ok(original) => churn_live(db, second, index, original, previous, score),
            },
        },
    }
}
fn missing(result: Result<registry::Value<source::LineIndex>, registry::Failure>, expected: identity::FileKey) -> i64 {
    handle result {
        Result::Err(error) => handle error {
            registry::Failure::MissingSource(file) => handle identity::equal(file.digest, expected.digest) { true => 1, false => 0 },
            _ => 0,
        }, _ => 0,
    }
}
fn missing_finished(db: &mut Db, revision: identity::RevisionId, session: registry::Session, files: Files, score: i64) -> i64 {
    handle lines(&mut *db, session, files.first) {
        Result::Err(_) => -61,
        Result::Ok(value) => {
            let score = score + cold(value) + inspect(& *db, session, value) + key_counts(& *db, 1, 1, 1, 1) + retained(& *db, 1, 1, 2, 2);
            let score = score + ok(close(&mut *db, session)) + ok(registry::retire(&mut *db, revision));
            handle sweep(&mut *db) {
                Result::Err(_) => -62,
                Result::Ok(value) => score + report(value, 1, 2, 2, 2) + key_counts(& *db, 0, 0, 1, 1) + no_sessions(& *db) + retained(& *db, 0, 0, 0, 0),
            }
        },
    }
}
fn missing_collected(db: &mut Db, revision: identity::RevisionId, session: registry::Session, files: Files, index: usize, score: i64) -> i64 {
    handle sweep(&mut *db) {
        Result::Err(_) => -63,
        Result::Ok(value) => {
            let score = score + report(value, 0, 0, 0, 0) + key_counts(& *db, 0, 0, 1, 1) + retained(& *db, 0, 0, 0, 0);
            missing_next(db, revision, session, files, index + 1, score)
        },
    }
}
fn missing_next(db: &mut Db, revision: identity::RevisionId, session: registry::Session, files: Files, index: usize, score: i64) -> i64 {
    handle index == 16 {
        true => missing_finished(db, revision, session, files, score),
        false => handle file_at(index) {
            Result::Err(_) => -64,
            Result::Ok(file) => {
                let score = score + missing(lines(&mut *db, session, file), file) + key_counts(& *db, 1, 1, 1, 1) + retained(& *db, 0, 0, 0, 0);
                missing_collected(db, revision, session, files, index, score)
            },
        },
    }
}
fn missing_history(db: &mut Db, files: Files) -> i64 {
    handle import(&mut *db, files.first, files.second, b"a\n\xf0\x9f\x98\x80", b"z", None) {
        Result::Err(_) => -65,
        Result::Ok(revision) => handle registry::open(&mut *db, revision, 10000, 10000) {
            Result::Err(_) => -66, Result::Ok(session) => missing_next(db, revision, session, files, 0, 0),
        },
    }
}
struct Probe { root: Root, source: registry::Value<source::Blob>, request: registry::Query<source::LineIndex>, files: Files }
fn collecting_failure(error: registry::Failure) -> i64 {
    handle error {
        registry::Failure::Database(error) => handle error { kernel::database::Failure::Collecting => 1, _ => 0 }, _ => 0,
    }
}
fn blocked<T>(result: Result<T, registry::Failure>) -> i64 where T: Use<[0, 1]> {
    handle result { Result::Err(error) => collecting_failure(error), _ => 0 }
}
fn blocked_line(db: &Db, original: Root) -> i64 {
    handle registry::line_value(db, original.session, original.value) {
        Result::Err(error) => collecting_failure(error), _ => 0,
    }
}
fn blocked_source(db: &Db, original: Root, value: registry::Value<source::Blob>) -> i64 {
    handle registry::source_value(db, original.session, value) {
        Result::Err(error) => collecting_failure(error), _ => 0,
    }
}
// Run before EVERY collection step, including the key-only phases after the
// core database finishes. Failed admission must not mutate the scanned roots.
fn barrier(db: &mut Db, probe: Probe) -> Result<(), registry::Failure> {
    let first = blocked(registry::stats(& *db)) + blocked(registry::work_spent(& *db, probe.root.session))
        + blocked_line(& *db, probe.root) + blocked_source(& *db, probe.root, probe.source)
        + blocked(registry::poll(&mut *db, probe.request)) + blocked(registry::abort(&mut *db, probe.request))
        + blocked(registry::source_bytes(&mut *db, probe.root.session, probe.files.first));
    let second = blocked(registry::line_index(&mut *db, probe.root.session, probe.files.first))
        + blocked(registry::open(&mut *db, probe.root.revision, 10000, 10000))
        + blocked(registry::retire(&mut *db, probe.root.revision)) + blocked(registry::begin_close(&mut *db, probe.root.session))
        + blocked(registry::close_step(&mut *db, probe.root.session)) + blocked(registry::collect(&mut *db))
        + blocked(import(&mut *db, probe.files.first, probe.files.second, b"a\n\xf0\x9f\x98\x80", b"z", None));
    handle first + second == 14 { true => Result::Ok(()), false => Result::Err(registry::Failure::Invariant) }
}
fn gc_barrier(db: &mut Db, probe: Probe, fuel: usize) -> Result<kernel::database::Collected, registry::Failure> {
    handle fuel == 0 {
        true => Result::Err(registry::Failure::Invariant),
        false => handle barrier(&mut *db, probe) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle registry::collect_step(&mut *db) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(event) => handle event {
                    registry::CollectionStep::Done(report) => Result::Ok(report),
                    _ => gc_barrier(db, probe, fuel - 1),
                },
            },
        },
    }
}
fn sweep_barrier(db: &mut Db, probe: Probe) -> Result<kernel::database::Collected, registry::Failure> {
    handle registry::collect(&mut *db) { Result::Err(error) => Result::Err(error), Result::Ok(_) => gc_barrier(db, probe, 1000) }
}
fn pending(db: &Db, sources: usize, lines: usize) -> i64 {
    handle registry::stats(db) {
        Result::Err(_) => -69,
        Result::Ok(stats) => count(stats.sources, sources) + count(stats.lines, lines) + count(stats.core.products, sources + lines)
            + count(stats.core.queries.memos, sources + lines) + count(stats.core.queries.edges, sources + lines)
            + count(stats.drivers, 1) + count(stats.core.queries.attempts, 1),
    }
}
fn roots_done(db: &mut Db, original: Root, slots: usize, products: usize, score: i64) -> i64 {
    let score = score + ok(close(&mut *db, original.session)) + ok(registry::retire(&mut *db, original.revision));
    handle sweep(&mut *db) {
        Result::Err(_) => -70,
        Result::Ok(value) => score + report(value, 1, products, products, products)
            + key_counts(& *db, 0, 0, slots, slots) + retained(& *db, 0, 0, 0, 0) + no_sessions(& *db),
    }
}
fn pending_deliver(db: &mut Db, probe: Probe, score: i64) -> i64 {
    handle drive(&mut *db, probe.request, 1000) {
        Result::Err(_) => -71,
        Result::Ok(value) => {
            let other = Root { revision: probe.root.revision, session: probe.root.session, value: value };
            let score = score + cold(value) + line_count(& *db, other, 1) + key_counts(& *db, 2, 2, 2, 2) + retained(& *db, 2, 2, 4, 4);
            roots_done(db, probe.root, 2, 4, score)
        },
    }
}
fn pending_builder(db: &mut Db, probe: Probe, score: i64) -> i64 {
    handle step_n(&mut *db, probe.request, 1) {
        Result::Err(_) => -72,
        Result::Ok(_) => handle sweep_barrier(&mut *db, probe) {
            Result::Err(_) => -73,
            Result::Ok(value) => {
                let score = score + report(value, 0, 0, 0, 0) + key_counts(& *db, 2, 2, 2, 2) + pending(& *db, 2, 1)
                    + inspect(& *db, probe.root.session, probe.root.value);
                pending_deliver(db, probe, score)
            },
        },
    }
}
fn pending_admitted(db: &mut Db, probe: Probe, score: i64) -> i64 {
    let score = score + pending(& *db, 1, 1) + key_counts(& *db, 1, 2, 1, 2);
    handle sweep_barrier(&mut *db, probe) {
        Result::Err(_) => -74,
        Result::Ok(value) => {
            let score = score + report(value, 0, 0, 0, 0) + key_counts(& *db, 1, 2, 1, 2) + pending(& *db, 1, 1)
                + inspect(& *db, probe.root.session, probe.root.value);
            handle until_child(&mut *db, probe.request, 2, 1000) {
                Result::Err(_) => -75, Result::Ok(_) => pending_builder(db, probe, score),
            }
        },
    }
}
fn pending_source(db: &mut Db, files: Files, original: Root, score: i64) -> i64 {
    handle bytes(&mut *db, original.session, files.first) {
        Result::Err(_) => -76,
        Result::Ok(source) => {
            let score = score + cached(source) + inspect_bytes(& *db, original.session, source);
            handle registry::line_index(&mut *db, original.session, files.second) {
                Result::Err(_) => -77,
                Result::Ok(request) => pending_admitted(db, Probe { root: original, source: source, request: request, files: files }, score),
            }
        },
    }
}
fn pending_history(db: &mut Db, files: Files) -> i64 {
    handle root(&mut *db, files, b"a\n\xf0\x9f\x98\x80", b"z", None) {
        Result::Err(_) => -78,
        Result::Ok(original) => {
            let score = cold(original.value) + inspect(& *db, original.session, original.value) + retained(& *db, 1, 1, 2, 2);
            pending_source(db, files, original, score)
        },
    }
}
fn parent_missing<T>(value: registry::Value<T>, expected: identity::RevisionId) -> i64 {
    handle registry::execution(value) {
        engine::Execution::Recomputed(reason) => handle reason {
            engine::Reason::ParentMemoMissing { parent } => handle identity::same_revision(parent, expected) { true => 1, false => 0 }, _ => 0,
        }, _ => 0,
    }
}
fn replay_deliver(db: &mut Db, parent: identity::RevisionId, revision: identity::RevisionId, session: registry::Session,
    request: registry::Query<source::LineIndex>, score: i64) -> i64 {
    handle drive(&mut *db, request, 1000) {
        Result::Err(_) => -79,
        Result::Ok(value) => {
            let score = score + parent_missing(value, parent) + inspect(& *db, session, value)
                + retained(& *db, 1, 1, 2, 2) + key_counts(& *db, 1, 1, 1, 1);
            roots_done(db, Root { revision: revision, session: session, value: value }, 1, 2, score)
        },
    }
}
fn replay_dropped(db: &mut Db, parent: identity::RevisionId, revision: identity::RevisionId, session: registry::Session,
    request: registry::Query<source::LineIndex>, score: i64) -> i64 {
    // Checking notices its collected candidate and drops its replay before
    // the provider starts. SourceBytes' key now has no owner and must retire.
    handle step_n(&mut *db, request, 1) {
        Result::Err(_) => -80,
        Result::Ok(_) => handle sweep(&mut *db) {
            Result::Err(_) => -81,
            Result::Ok(value) => {
                let score = score + report(value, 0, 0, 0, 0) + key_counts(& *db, 0, 1, 1, 1) + pending(& *db, 0, 0);
                replay_deliver(db, parent, revision, session, request, score)
            },
        },
    }
}
fn replay_retired(db: &mut Db, parent: identity::RevisionId, revision: identity::RevisionId, session: registry::Session,
    request: registry::Query<source::LineIndex>, score: i64) -> i64 {
    let score = score + pending(& *db, 1, 1) + key_counts(& *db, 1, 1, 1, 1) + ok(registry::retire(&mut *db, parent));
    handle sweep(&mut *db) {
        Result::Err(_) => -82,
        Result::Ok(value) => {
            // No source memo or child attempt remains. The paused parent's
            // replay is the sole root keeping the SourceBytes key alive.
            let score = score + report(value, 1, 2, 2, 2) + key_counts(& *db, 1, 1, 1, 1) + pending(& *db, 0, 0);
            replay_dropped(db, parent, revision, session, request, score)
        },
    }
}
fn replay_start(db: &mut Db, parent: identity::RevisionId, revision: identity::RevisionId, session: registry::Session, files: Files, score: i64) -> i64 {
    handle registry::line_index(&mut *db, session, files.first) {
        Result::Err(_) => -83,
        Result::Ok(request) => {
            // Scheduler boundary: Ancestry -> Lookup -> Checking, before its
            // first replay read can demand a child. Retained counts below
            // assert that no child was computed/admitted at this boundary.
            handle step_n(&mut *db, request, 2) {
                Result::Err(_) => -84, Result::Ok(_) => replay_retired(db, parent, revision, session, request, score),
            }
        },
    }
}
fn replay_child(db: &mut Db, files: Files, original: Root, score: i64) -> i64 {
    let score = score + ok(close(&mut *db, original.session));
    handle import(&mut *db, files.first, files.second, b"a\n\xf0\x9f\x98\x80", b"zz", Result::Ok(original.revision)) {
        Result::Err(_) => -85,
        Result::Ok(revision) => handle registry::open(&mut *db, revision, 10000, 10000) {
            Result::Err(_) => -86, Result::Ok(session) => replay_start(db, original.revision, revision, session, files, score),
        },
    }
}
fn replay_history(db: &mut Db, files: Files) -> i64 {
    handle root(&mut *db, files, b"a\n\xf0\x9f\x98\x80", b"z", None) {
        Result::Err(_) => -87,
        Result::Ok(original) => {
            let score = cold(original.value) + inspect(& *db, original.session, original.value)
                + retained(& *db, 1, 1, 2, 2) + key_counts(& *db, 1, 1, 1, 1);
            replay_child(db, files, original, score)
        },
    }
}
fn run(first: identity::FileKey, second: identity::FileKey, selected: i64) -> i64 {
    handle selected {
        0 => basic(first, second),
        1 => handle registry::create<Inputs>(92, limits()) {
            Result::Err(_) => -29, Result::Ok(db) => reuse_history(&mut db, Files { first: first, second: second }),
        },
        2 => handle registry::create<Inputs>(93, limits()) {
            Result::Err(_) => -43, Result::Ok(db) => interleave_history(&mut db, Files { first: first, second: second }),
        },
        3 => failure_history(Files { first: first, second: second }, 0, 0),
        4 => handle registry::create<Inputs>(101, limited_keys(1)) {
            Result::Err(_) => -67, Result::Ok(db) => churn_next(&mut db, second, 0, None, 0),
        },
        5 => handle registry::create<Inputs>(102, limited_keys(1)) {
            Result::Err(_) => -68, Result::Ok(db) => missing_history(&mut db, Files { first: first, second: second }),
        },
        6 => handle registry::create<Inputs>(103, limited_keys(2)) {
            Result::Err(_) => -88, Result::Ok(db) => pending_history(&mut db, Files { first: first, second: second }),
        },
        7 => handle registry::create<Inputs>(104, limited_keys(1)) {
            Result::Err(_) => -89, Result::Ok(db) => replay_history(&mut db, Files { first: first, second: second }),
        },
        _ => -30,
    }
}
type Results = (i64, i64, i64, i64, i64, i64, i64, i64);
fn batch(first: identity::FileKey, second: identity::FileKey) -> Results {
    // Each history constructs its own database and controls. Keep the full
    // result vector: summing these scores could hide offsetting failures.
    let a = run(first, second, 0);
    let b = run(first, second, 1);
    let c = run(first, second, 2);
    let d = run(first, second, 3);
    let e = run(first, second, 4);
    let f = run(first, second, 5);
    let g = run(first, second, 6);
    let h = run(first, second, 7);
    (a, b, c, d, e, f, g, h)
}
fn batch_failure(code: i64) -> Results { (code, code, code, code, code, code, code, code) }
pub fn main() -> Results {
    handle identity::file(b"app", b"src/a.glorious", 128) {
        Result::Err(_) => batch_failure(-12),
        Result::Ok(first) => handle identity::file(b"app", b"src/b.glorious", 128) {
            Result::Err(_) => batch_failure(-13), Result::Ok(second) => batch(first, second),
        },
    }
}
