@SUPPORT@
use kernel::database;
use kernel::dependency;
use kernel::dependency::node::Node;
use kernel::publication;
use kernel::package;
use kernel::diagnostic;
pub impl database::DiagnosticWorld for Inputs {
    source_length(world: &Inputs, file: &identity::FileKey) -> Option<u32> {
        handle registry::World::source(world, *file) { Result::Err(_) => None, Result::Ok(blob) => Result::Ok(source::length(blob)) }
    }
}
fn publication_limits(nodes: usize) -> publication::Limits {
    publication::Limits { packages: package::Limits { packages: 2, bodies: 2 },
        dependencies: dependency::Limits { nodes: nodes, edges: 4 },
        diagnostics: diagnostic::Limits { diagnostics: 4, provenance: 4 }, error_limit: None }
}
fn digest(bytes: Slice<u8>) -> identity::Digest {
    handle identity::decode(bytes) { Result::Ok(value) => value, Result::Err(_) => digest(bytes) }
}
fn file() -> identity::FileKey { identity::FileKey { digest: @FILE@ } }
fn second() -> identity::FileKey { identity::FileKey { digest: @SECOND@ } }
fn original_digest() -> identity::Digest { @DIGEST0@ }
fn changed_digest() -> identity::Digest { @DIGEST1@ }
fn original_source() -> Slice<'static, u8> { @ORIGINAL@ }
fn changed_source() -> Slice<'static, u8> { @CHANGED@ }
fn yes(value: Bool) -> i64 { handle value { true => 1, false => 0 } }
fn row(db: &Db, session: registry::Session, revision: identity::RevisionId, parent: Option<identity::RevisionId>,
    fingerprint: identity::Digest, status: usize) -> i64 {
    handle registry::request_traces(db, session) {
        Result::Ok(Result::Ok(traces)) => handle Slice::len(&traces) == 1 {
            false => 0, true => {
                let trace = *Slice::get_unchecked(traces, 0);
                yes(identity::same_revision(trace.revision, revision)) * yes(identity::equal(trace.fingerprint, fingerprint))
                    * count(Vec::len(&trace.dependencies), 0) * handle trace.node {
                        Node::Input(key) => yes(identity::equal(key.digest, file().digest)) * trace_status(trace.status, parent, status), _ => 0,
                    }
            },
        }, _ => 0,
    }
}
fn same_parent(actual: identity::RevisionId, parent: Option<identity::RevisionId>) -> i64 {
    handle parent { Result::Err(_) => 0, Result::Ok(parent) => yes(identity::same_revision(actual, parent)) }
}
fn trace_status(value: dependency::Status, parent: Option<identity::RevisionId>, status: usize) -> i64 {
    handle value {
        dependency::Status::Cold => count(status, 0),
        dependency::Status::Green { parent: actual } => count(status, 1) * same_parent(actual, parent),
        dependency::Status::Red { parent: actual, first_changed: changed } => count(status, 2) * same_parent(actual, parent)
            * handle changed { Node::Input(key) => yes(identity::equal(key.digest, file().digest)), _ => 0 },
        _ => 0,
    }
}
fn absent(db: &Db, session: registry::Session) -> i64 {
    handle registry::request_traces(db, session) { Result::Ok(Result::Err(_)) => 1, _ => 0 }
}
fn readable(db: &Db, root: Root) -> i64 {
    handle registry::line_value(db, root.session, root.value) {
        Result::Err(_) => 0, Result::Ok(value) => yes(source::line_count(value) > 0),
    }
}
fn prepare<T>(db: &mut Db, pending: &mut registry::Publication<T>, fuel: usize) -> Result<(), registry::Failure> {
    handle fuel == 0 { true => Result::Err(registry::Failure::Invariant), false =>
        handle registry::step_publication(&mut *db, &mut *pending) { Result::Err(error) => Result::Err(error),
            Result::Ok(database::PublicationStep::Ready) => Result::Ok(()),
            Result::Ok(_) => prepare(db, pending, fuel - 1) } }
}
fn publish<T>(db: &mut Db, session: registry::Session, value: registry::Value<T>, hidden: Bool) -> i64 {
    handle registry::begin_publication(&mut *db, session, value, publication_limits(4)) {
        Result::Err(_) => 0, Result::Ok(pending) => {
            let ready = ok(prepare(&mut *db, &mut pending, 1000));
            let hidden = handle hidden { true => absent(& *db, session), false => 1 };
            ready * hidden * handle registry::finish_publication(db, pending) { Result::Err(_) => 0, Result::Ok(published) => {
                let diagnostics = diagnostic::values(&published.diagnostics);
                yes(identity::equal(registry::fingerprint(published.value), registry::fingerprint(value)))
                    * count(Slice::len(&diagnostics), 0)
            } }
        },
    }
}
fn root(db: &mut Db, a: Slice<u8>, b: Slice<u8>, parent: Option<identity::RevisionId>) -> Result<Root, registry::Failure> {
    handle import(&mut *db, file(), second(), a, b, parent) { Result::Err(error) => Result::Err(error), Result::Ok(revision) =>
        handle registry::open(&mut *db, revision, 100000, 100000) { Result::Err(error) => Result::Err(error), Result::Ok(session) =>
            handle lines(db, session, file()) { Result::Err(error) => Result::Err(error), Result::Ok(value) =>
                Result::Ok(Root { revision: revision, session: session, value: value }) } } }
}
fn lineage(db: &mut Db, first: identity::RevisionId) -> (i64, i64, i64) {
    handle root(&mut *db, original_source(), b"unrelated", Result::Ok(first)) { Result::Err(_) => (0, 0, 0), Result::Ok(child) => {
        let recomputed = handle registry::execution(child.value) {
            engine::Execution::Recomputed(engine::Reason::ParentMemoMissing { parent: parent }) => yes(identity::same_revision(parent, first)), _ => 0 };
        let green = recomputed * publish(&mut *db, child.session, child.value, true)
            * row(& *db, child.session, child.revision, Result::Ok(first), original_digest(), 1);
        handle root(&mut *db, original_source(), b"other", Result::Ok(child.revision)) { Result::Err(_) => (green, 0, 0), Result::Ok(reused) => {
            let same = handle registry::execution(reused.value) {
                engine::Execution::ReusedFromParent { parent: parent } => yes(identity::same_revision(parent, child.revision)), _ => 0 };
            let same = same * publish(&mut *db, reused.session, reused.value, true)
                * row(& *db, reused.session, reused.revision, Result::Ok(child.revision), original_digest(), 1);
            handle root(&mut *db, changed_source(), b"other", Result::Ok(reused.revision)) { Result::Err(_) => (green, same, 0), Result::Ok(changed) => {
                let red = handle registry::execution(changed.value) {
                    engine::Execution::Recomputed(engine::Reason::ParentReuseRejected { parent: parent }) => yes(identity::same_revision(parent, reused.revision)), _ => 0 };
                (green, same, red * publish(&mut *db, changed.session, changed.value, true)
                    * row(& *db, changed.session, changed.revision, Result::Ok(reused.revision), changed_digest(), 2))
            } }
        } }
    } }
}
fn failed_replacement(db: &mut Db, root: Root) -> i64 {
    handle registry::open(&mut *db, root.revision, 100000, 100000) { Result::Err(_) => 0, Result::Ok(session) =>
        handle lines(&mut *db, session, file()) { Result::Err(_) => 0, Result::Ok(value) =>
            handle registry::begin_publication(&mut *db, session, value, publication_limits(0)) { Result::Err(_) => 0, Result::Ok(pending) => {
                let rejected = handle prepare(&mut *db, &mut pending, 1000) {
                    Result::Err(registry::Failure::Database(database::Failure::Engine(engine::Failure::Publication(
                        publication::Failure::Dependency(dependency::Failure::Capacity))))) => 1, _ => 0 };
                let closed = handle registry::step_publication(&mut *db, &mut pending) { Result::Err(registry::Failure::Closed) => 1, _ => 0 };
                let retained = row(& *db, root.session, root.revision, None, original_digest(), 0);
                rejected * closed * retained * ok(close(db, session))
            } } } }
}
fn hit_history(db: &mut Db) -> i64 {
    handle root(&mut *db, original_source(), b"first", None) { Result::Err(_) => 0, Result::Ok(root) => {
        let cold = cold(root.value) * publish(&mut *db, root.session, root.value, true)
            * row(& *db, root.session, root.revision, None, original_digest(), 0);
        handle registry::open(&mut *db, root.revision, 100000, 100000) { Result::Err(_) => 0, Result::Ok(session) =>
            handle lines(&mut *db, session, file()) { Result::Err(_) => 0, Result::Ok(value) => {
                let hit = cached(value) * publish(&mut *db, session, value, false)
                    * row(& *db, session, root.revision, None, original_digest(), 0);
                cold * hit * failed_replacement(db, root)
            } } }
    } }
}
fn initial(db: &mut Db) -> (i64, i64, i64, i64) {
    handle import(&mut *db, file(), second(), original_source(), b"first", None) { Result::Err(_) => (0, 0, 0, 0), Result::Ok(revision) =>
        handle registry::open(&mut *db, revision, 100000, 100000) { Result::Err(_) => (0, 0, 0, 0), Result::Ok(session) =>
            handle bytes(&mut *db, session, file()) { Result::Err(_) => (0, 0, 0, 0), Result::Ok(value) => {
                let first = cold(value) * publish(&mut *db, session, value, true) * row(& *db, session, revision, None, original_digest(), 0);
                handle lineage(db, revision) { (green, reused, red) => (first, green, reused, red) }
            } } } }
}
fn paused<T>(db: &mut Db, pending: &mut registry::Publication<T>, steps: usize) -> Result<(), registry::Failure> {
    handle steps == 0 { true => Result::Ok(()), false => handle registry::step_publication(&mut *db, &mut *pending) {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => paused(db, pending, steps - 1),
    } }
}
fn measured<T>(db: &mut Db, pending: &mut registry::Publication<T>, count: usize) -> Result<usize, registry::Failure> {
    handle count >= 1000 { true => Result::Err(registry::Failure::Invariant), false =>
        handle registry::step_publication(&mut *db, &mut *pending) { Result::Err(error) => Result::Err(error),
            Result::Ok(database::PublicationStep::Ready) => Result::Ok(count + 1),
            Result::Ok(_) => measured(db, pending, count + 1) } }
}
fn cancellation(db: &mut Db, root: Root, steps: usize) -> i64 {
    handle registry::open(&mut *db, root.revision, 100000, 100000) { Result::Err(_) => 0, Result::Ok(session) =>
        handle registry::begin_publication(&mut *db, session, root.value, publication_limits(4)) { Result::Err(_) => 0, Result::Ok(pending) => {
            let score = ok(paused(&mut *db, &mut pending, steps)) * ok(registry::cancel(&mut *db, session));
            let rejected = handle registry::step_publication(&mut *db, &mut pending) {
                Result::Err(registry::Failure::Database(database::Failure::Engine(engine::Failure::Control(operation::Failure::Cancelled)))) => 1, _ => 0 };
            let closed = handle registry::step_publication(&mut *db, &mut pending) { Result::Err(registry::Failure::Closed) => 1, _ => 0 };
            let score = score * rejected * closed * row(& *db, root.session, root.revision, None, original_digest(), 0);
            score * readable(& *db, root) * ok(close(db, session))
        } } }
}
fn every_cancellation(db: &mut Db, root: Root, cursor: usize, steps: usize) -> i64 {
    handle cursor > steps { true => as<i64>(steps + 1), false => handle cancellation(&mut *db, root, cursor) {
        1 => every_cancellation(db, root, cursor + 1, steps), _ => 0,
    } }
}
fn work_limit(db: &mut Db, root: Root) -> i64 {
    handle registry::open(&mut *db, root.revision, 1, 1000) { Result::Err(_) => 0, Result::Ok(session) =>
        handle registry::begin_publication(&mut *db, session, root.value, publication_limits(4)) { Result::Err(_) => 0, Result::Ok(pending) => {
            let rejected = handle registry::step_publication(&mut *db, &mut pending) {
                Result::Err(registry::Failure::Source(source::Failure::Control(
                    operation::Failure::ResourceLimit { name: 0, ceiling: 1, requested: 1 }))) => 1, _ => 0 };
            rejected * row(& *db, root.session, root.revision, None, original_digest(), 0) * ok(close(db, session))
        } } }
}
fn authority(db: &mut Db, root: Root, pending: &mut registry::Publication<source::LineIndex>) -> i64 {
    handle registry::create<Inputs>(143, limits()) { Result::Err(_) => 0, Result::Ok(other) => {
        let foreign = handle registry::step_publication(&mut other, &mut *pending) { Result::Err(registry::Failure::Closed) => 1, _ => 0 };
        // A stopped collection cannot mutate the cursor. Its owner's revision
        // pin keeps every committed journal and interner key reachable.
        let collecting = ok(registry::collect(&mut *db));
        let blocked = handle registry::step_publication(&mut *db, &mut *pending) {
            Result::Err(registry::Failure::Database(database::Failure::Collecting)) => 1, _ => 0 };
        let collected = ok(gc(&mut *db, 1000));
        foreign * collecting * blocked * collected * readable(& *db, root)
    } }
}
fn failure_history(db: &mut Db) -> (i64, i64) {
    handle root(&mut *db, original_source(), b"first", None) { Result::Err(_) => (0, 0), Result::Ok(root) =>
        handle registry::begin_publication(&mut *db, root.session, root.value, publication_limits(4)) { Result::Err(_) => (0, 0), Result::Ok(pending) => {
            let authority = authority(&mut *db, root, &mut pending);
            handle measured(&mut *db, &mut pending, 0) { Result::Err(_) => (0, 0), Result::Ok(steps) => {
                let complete = ok(registry::finish_publication(&mut *db, pending));
                let work = work_limit(&mut *db, root);
                (authority * complete * work, every_cancellation(db, root, 0, steps))
            } }
        } } }
}
fn main() -> (i64, i64, i64, i64, i64, i64, i64) {
    handle registry::create<Inputs>(140, limits()) { Result::Err(_) => (0, 0, 0, 0, 0, 0, 0), Result::Ok(db) =>
        handle initial(&mut db) { (a, b, c, d) => handle registry::create<Inputs>(141, limits()) {
            Result::Err(_) => (a, b, c, d, 0, 0, 0), Result::Ok(other) => {
                let hit = hit_history(&mut other);
                handle registry::create<Inputs>(142, limits()) { Result::Err(_) => (a, b, c, d, hit, 0, 0), Result::Ok(failures) =>
                    handle failure_history(&mut failures) { (f, g) => (a, b, c, d, hit, f, g) } }
            },
        } } }
}
