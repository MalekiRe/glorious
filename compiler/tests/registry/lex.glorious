@SUPPORT@
use source::lex;
use kernel::operation::budget;

struct Fixture { db: Db, file: identity::FileKey, second: identity::FileKey, revision: identity::RevisionId, session: registry::Session }
fn yes(value: Bool) -> i64 { handle value { true => 1, false => 0 } }
fn demand(db: &mut Db, session: registry::Session, file: identity::FileKey) -> Result<registry::Value<lex::LexedFile>, registry::Failure> {
    handle registry::lex(&mut *db, session, file) { Result::Err(error) => Result::Err(error), Result::Ok(query) => drive(db, query, 1000) }
}
fn fixture(id: u64, mode: usize) -> Result<Fixture, registry::Failure> {
    let caps = limits();
    handle mode == 2 { true => { caps.lex_products = as<usize>(0); }, false => () };
    handle mode == 3 { true => { caps.tokens = as<usize>(1); }, false => () };
    handle identity::hash(b"lex-retained-file") { Result::Err(_) => Result::Err(registry::Failure::Invariant), Result::Ok(file) =>
        handle identity::hash(b"lex-unobserved-file") { Result::Err(_) => Result::Err(registry::Failure::Invariant), Result::Ok(second) =>
            handle registry::create<Inputs>(id, caps) { Result::Err(error) => Result::Err(error), Result::Ok(db) => {
                let file = identity::FileKey { digest: file }; let second = identity::FileKey { digest: second };
                handle import(&mut db, file, second, b"(x] /*a*/", b"ignored", None) { Result::Err(error) => Result::Err(error), Result::Ok(revision) => {
                    let root = as<u64>(handle mode { 0 => 9, _ => 100000 });
                    let lex_limit = as<u64>(handle mode { 1 => 0, _ => 100000 });
                    handle registry::open_with_resources(&mut db, revision, 100000, root,
                        registry::ResourceLimits { source: 100000, lines: 100000, lex: lex_limit, reservations: 16 }) {
                        Result::Err(error) => Result::Err(error), Result::Ok(session) =>
                            Result::Ok(Fixture { db: db, file: file, second: second, revision: revision, session: session }) }
                } }
            } } } }
}
fn content(db: &Db, session: registry::Session, value: registry::Value<lex::LexedFile>, original: Bool) -> i64 {
    handle registry::lex_value(db, session, value) { Result::Err(_) => 0, Result::Ok(product) => {
        let tokens = lex::tokens(product);
        handle original {
            false => yes(lex::token_count(product) == 2) * yes(handle Slice::get_unchecked(tokens, 0).kind { lex::TokenKind::Identifier => true, _ => false }),
            true => handle lex::token_count(product) == 6 { false => 0, true => {
                let first = Slice::get_unchecked(tokens, 0); let close = Slice::get_unchecked(tokens, 2); let end = Slice::get_unchecked(tokens, 5);
                yes(first.start == 0) * yes(first.end == 1) * yes(first.delimiter_code == 1007)
                    * yes(close.delimiter_code == 1005) * yes(handle first.matching { Result::Err(_) => true, _ => false })
                    * yes(end.start == 9) * yes(end.end == 9) * yes(handle end.kind { lex::TokenKind::End => true, _ => false })
            } },
        }
    } }
}
fn backing(db: &Db, session: registry::Session, value: registry::Value<lex::LexedFile>) -> u64 {
    handle registry::lex_value(db, session, value) { Result::Err(_) => 0, Result::Ok(value) => lex::product_memory(value) }
}
fn live(db: &Db, sources: usize, lexical: usize, memos: usize, edges: usize) -> i64 {
    handle registry::stats(db) { Result::Err(_) => 0, Result::Ok(value) =>
        count(value.sources, sources) * count(value.lexical, lexical) * count(value.lines, 0)
            * count(value.core.products, sources + lexical) * count(value.core.queries.memos, memos)
            * count(value.core.queries.edges, edges) * count(value.drivers, 0) * count(value.core.queries.attempts, 0) }
}
fn memory(db: &Db, session: registry::Session, source: u64, lexical: u64, leases: usize) -> i64 {
    let root = handle registry::memory_spent(db, session) { Result::Err(_) => 0, Result::Ok(value) => yes(value == source + lexical) };
    root * handle registry::resource_stats(db, session) { Result::Err(_) => 0, Result::Ok(value) =>
        yes(value.total == source + lexical) * yes(value.source == source) * yes(value.lex == lexical)
            * yes(value.lines == 0) * count(value.reservations, leases) }
}
fn origin(db: &Db, session: registry::Session, value: registry::Value<lex::LexedFile>, amount: u64) -> i64 {
    handle registry::product_resources(db, session, value) { Result::Err(_) => 0, Result::Ok(value) =>
        yes(value.closed) * yes(value.resources.source == 9) * yes(value.resources.lex == amount)
            * yes(value.resources.lines == 0) * yes(value.resources.total == amount + 9) * count(value.resources.reservations, 2) }
}
fn sweep(db: &mut Db, revisions: usize, products: usize) -> i64 {
    let started = ok(registry::collect(&mut *db));
    started * handle gc(db, 1000) { Result::Err(_) => 0, Result::Ok(value) => count(value.revisions, revisions) * count(value.products, products) }
}
fn empty(db: &Db) -> i64 {
    live(db, 0, 0, 0, 0) * handle registry::stats(db) { Result::Err(_) => 0, Result::Ok(value) =>
        count(value.lex_keys.live, 0) * count(value.source_keys.live, 0) * count(value.sessions, 0) }
        * handle registry::ownership_stats(db) { Result::Err(_) => 0, Result::Ok(value) =>
            count(value.phase_owners, 0) * count(value.closed_phase_owners, 0) * count(value.root_owners, 0) * count(value.root_leases, 0) * count(value.closed_roots, 0) }
}
fn reused_child(db: &mut Db, file: identity::FileKey, second: identity::FileKey, parent: identity::RevisionId, amount: u64) -> i64 {
    handle import(&mut *db, file, second, b"(x] /*a*/", b"changed unrelated", Result::Ok(parent)) { Result::Err(_) => 0, Result::Ok(revision) =>
        handle registry::open(&mut *db, revision, 100000, 0) { Result::Err(_) => 0, Result::Ok(session) =>
            handle demand(&mut *db, session, file) { Result::Err(_) => 0, Result::Ok(value) => {
                let reused = handle registry::execution(value) { engine::Execution::ReusedFromParent { parent: actual } => yes(identity::same_revision(actual, parent)), _ => 0 };
                let score = reused * content(& *db, session, value, true) * memory(& *db, session, 0, 0, 0) * origin(& *db, session, value, amount);
                let retired = ok(registry::retire(&mut *db, parent)) * sweep(&mut *db, 1, 0);
                let retained = content(& *db, session, value, true) * live(& *db, 1, 1, 2, 2);
                let pinned = ok(registry::retire(&mut *db, revision)) * sweep(&mut *db, 0, 0) * content(& *db, session, value, true);
                let closed = ok(close(&mut *db, session));
                score * retired * retained * pinned * closed * sweep(&mut *db, 1, 2) * empty(& *db)
            } } } }
}
fn lifecycle() -> i64 {
    handle fixture(510, 4) { Result::Err(_) => 0, Result::Ok(fixture) =>
        handle demand(&mut fixture.db, fixture.session, fixture.file) { Result::Err(_) => 0, Result::Ok(value) => {
            let amount = backing(&fixture.db, fixture.session, value);
            let score = yes(amount > 0) * cold(value) * content(&fixture.db, fixture.session, value, true)
                * memory(&fixture.db, fixture.session, 9, amount, 2) * live(&fixture.db, 1, 1, 2, 2);
            let hit = handle demand(&mut fixture.db, fixture.session, fixture.file) { Result::Err(_) => 0, Result::Ok(value) => cached(value) };
            let closed = ok(close(&mut fixture.db, fixture.session));
            score * hit * closed * reused_child(&mut fixture.db, fixture.file, fixture.second, fixture.revision, amount)
        } } }
}
fn changed_child(fixture: &mut Fixture, old: registry::Value<lex::LexedFile>) -> i64 {
    handle import(&mut fixture.db, fixture.file, fixture.second, b"x", b"ignored", Result::Ok(fixture.revision)) {
        Result::Err(_) => 0, Result::Ok(revision) => handle registry::open(&mut fixture.db, revision, 100000, 100000) {
            Result::Err(_) => 0, Result::Ok(session) => handle demand(&mut fixture.db, session, fixture.file) {
                Result::Err(_) => 0, Result::Ok(value) => {
                    let rejected = handle registry::execution(value) { engine::Execution::Recomputed(engine::Reason::ParentReuseRejected { parent }) => yes(identity::same_revision(parent, fixture.revision)), _ => 0 };
                    let content = content(&fixture.db, session, value, false) * content(&fixture.db, fixture.session, old, true)
                        * yes(!identity::equal(registry::fingerprint(old), registry::fingerprint(value)));
                    let foreign = yes(handle registry::lex_value(&fixture.db, session, old) { Result::Err(_) => true, _ => false });
                    let live = live(&fixture.db, 2, 2, 4, 4);
                    let closed = ok(close(&mut fixture.db, session)) * ok(close(&mut fixture.db, fixture.session));
                    let retired = ok(registry::retire(&mut fixture.db, revision)) * ok(registry::retire(&mut fixture.db, fixture.revision));
                    rejected * content * foreign * live * closed * retired * sweep(&mut fixture.db, 2, 4) * empty(&fixture.db)
                },
            },
        },
    }
}
fn changed() -> i64 {
    handle fixture(511, 4) { Result::Err(_) => 0, Result::Ok(fixture) =>
        handle demand(&mut fixture.db, fixture.session, fixture.file) { Result::Err(_) => 0, Result::Ok(value) => changed_child(&mut fixture, value) } }
}
fn expected(error: registry::Failure, mode: usize) -> i64 {
    handle error {
        registry::Failure::Database(kernel::database::Failure::Engine(engine::Failure::Control(operation::Failure::ResourceLimit { name, ceiling, requested }))) =>
            yes(mode == 0) * yes(name == 1) * yes(ceiling == 9) * yes(requested > 0),
        registry::Failure::Budget(budget::Failure::Control(operation::Failure::ResourceLimit { name, ceiling, requested })) =>
            yes(mode == 1) * yes(name == 4) * yes(ceiling == 0) * yes(requested > 0),
        registry::Failure::Capacity => yes(mode == 2),
        registry::Failure::Source(source::Failure::Capacity) => yes(mode == 3),
        _ => 0,
    }
}
fn rejected(fixture: &mut Fixture, mode: usize) -> i64 {
    handle demand(&mut fixture.db, fixture.session, fixture.file) { Result::Ok(_) => 0, Result::Err(error) => expected(error, mode) }
        * live(&fixture.db, 1, 0, 1, 1) * memory(&fixture.db, fixture.session, 9, 0, 1)
}
fn failure(mode: usize) -> i64 {
    handle fixture(520 + as<u64>(mode), mode) { Result::Err(_) => 0, Result::Ok(fixture) => {
        let first = rejected(&mut fixture, mode); let retry = rejected(&mut fixture, mode);
        let closed = ok(close(&mut fixture.db, fixture.session)); let retired = ok(registry::retire(&mut fixture.db, fixture.revision));
        first * retry * closed * retired * sweep(&mut fixture.db, 1, 1) * empty(&fixture.db)
    } }
}
fn partial(db: &mut Db, session: registry::Session, query: registry::Query<lex::LexedFile>, fuel: usize) -> i64 {
    handle fuel == 0 { true => 0, false => handle registry::resource_stats(& *db, session) {
        Result::Err(_) => 0, Result::Ok(resources) => handle resources.lex > 0 {
            true => 1, false => handle registry::poll(&mut *db, query) {
                Result::Ok(registry::Event::Continue) => partial(db, session, query, fuel - 1), _ => 0 } } } }
}
fn await_waiter(db: &mut Db, query: registry::Query<lex::LexedFile>, fuel: usize) -> i64 {
    handle fuel == 0 { true => 0, false => handle registry::poll(&mut *db, query) {
        Result::Ok(registry::Event::Continue) => await_waiter(db, query, fuel - 1),
        Result::Ok(registry::Event::Waiting) => 1,
        _ => 0,
    } }
}
fn takeover(fixture: &mut Fixture, original: registry::Query<lex::LexedFile>) -> i64 {
    handle registry::open(&mut fixture.db, fixture.revision, 100000, 100000) { Result::Err(_) => 0, Result::Ok(session) =>
        handle registry::lex(&mut fixture.db, session, fixture.file) { Result::Err(_) => 0, Result::Ok(waiter) => {
            let waiting = await_waiter(&mut fixture.db, waiter, 1000);
            let closed = ok(close(&mut fixture.db, fixture.session));
            let abandoned = yes(handle registry::poll(&mut fixture.db, original) { Result::Err(registry::Failure::Closed) => true, _ => false });
            handle drive(&mut fixture.db, waiter, 1000) { Result::Err(_) => 0, Result::Ok(value) => {
                let amount = backing(&fixture.db, session, value);
                let ready = content(&fixture.db, session, value, true) * memory(&fixture.db, session, 0, amount, 1) * live(&fixture.db, 1, 1, 2, 2);
                let closed_next = ok(close(&mut fixture.db, session)); let retired = ok(registry::retire(&mut fixture.db, fixture.revision));
                waiting * closed * abandoned * ready * closed_next * retired * sweep(&mut fixture.db, 1, 2) * empty(&fixture.db)
            } }
        } } }
}
fn cancellation() -> i64 {
    handle fixture(530, 4) { Result::Err(_) => 0, Result::Ok(fixture) =>
        handle registry::lex(&mut fixture.db, fixture.session, fixture.file) { Result::Err(_) => 0, Result::Ok(query) => {
            let paused = partial(&mut fixture.db, fixture.session, query, 1000);
            paused * takeover(&mut fixture, query)
        } } }
}
pub fn main() -> (i64, i64, i64, i64, i64, i64, i64) {
    (lifecycle(), changed(), failure(0), failure(1), failure(2), failure(3), cancellation())
}
