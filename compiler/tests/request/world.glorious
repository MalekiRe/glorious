use std::*;
use kernel::identity;
use kernel::operation;
use kernel::database;
use request::world;
use request::names;
use request::options;
use runtime_manifest::RuntimeManifestInput;
use runtime_manifest::PrimitiveSelector;
use runtime_manifest::PrimitiveRole;
use runtime_manifest::FloatPrimitive;
use runtime_manifest::FloatWidth;
use runtime_manifest::FloatBinaryOp;
use runtime_manifest::HostImportSelector;
use types::ScalarType;
pub mod kernel;
pub mod request;
pub mod source;
pub mod registry;
pub mod runtime_manifest;
struct Witness { input: request::CompilationRequest, valid: i64 }
fn eq(a: i64, b: i64) -> i64 { handle a == b { true => 1, false => 0 } }
fn yes(value: Bool) -> i64 { handle value { true => 1, false => 0 } }
fn same(a: Str, b: Str) -> i64 {
    let left = Str::as_bytes(a); let right = Str::as_bytes(b);
    handle Slice::lex_compare(left, right) { Ordering::Equal => 1, _ => 0 }
}
fn strings(a: &String, b: &String) -> i64 { same(String::as_str(a), String::as_str(b)) }
fn text(bytes: Slice<u8>) -> String {
    let values = Vec<u8>::new(); Vec::extend_from_slice(&mut values, bytes);
    handle String::from_utf8(values) { Result::Ok(value) => value, Result::Err(_) => String::new() }
}
fn digest(bytes: Slice<u8>) -> identity::Digest {
    handle identity::decode(bytes) { Result::Ok(value) => value, Result::Err(_) => digest(bytes) }
}
fn path_steps(builder: &mut request::PathBuilder, controls: &mut operation::Controls) -> Result<request::LogicalPath, request::Failure> {
    handle request::step_path(&mut *builder, &mut *controls) {
        Result::Err(error) => Result::Err(error), Result::Ok(event) => handle event {
            request::Event::Continue => path_steps(builder, controls), request::Event::Ready => request::finish_path(builder, & *controls),
        },
    }
}
fn add_source(values: &mut Vec<request::SourceInput>, package: String, path: String, bytes: Slice<u8>, key: identity::Digest, fingerprint: identity::Digest) -> i64 {
    let controls = operation::create(1000000, 1000000); let builder = request::begin_path(path);
    handle path_steps(&mut builder, &mut controls) {
        Result::Err(_) => 0, Result::Ok(path) => {
            let contents = Vec<u8>::new(); Vec::extend_from_slice(&mut contents, bytes);
            Vec::push(values, request::SourceInput { key: identity::FileKey { digest: key }, package: identity::PackageKey { value: package },
                logical_path: path, bytes: contents, digest: fingerprint }); 1
        },
    }
}
fn limits() -> world::Limits {
    world::Limits { sources: request::sources::Limits { source_count: 100, source_bytes: 10000, identity_bytes: 10000 },
        namespace: request::namespace::Limits { packages: 100, alias_bytes: 10000, capabilities: 100, capability_bytes: 10000 },
        options: options::Limits { entries: 100, key_bytes: 10000, value_bytes: 10000 },
        runtime_manifest: runtime_manifest::input::Limits { selectors: 200, host_imports: 100, text_bytes: 10000 }, fingerprint_bytes: 100000 }
}
fn steps(builder: &mut world::Builder, controls: &mut operation::Controls, count: usize) -> Result<usize, request::Failure> {
    handle world::step(&mut *builder, &mut *controls) {
        Result::Err(error) => Result::Err(error), Result::Ok(event) => handle event {
            request::Event::Continue => steps(builder, controls, count + 1), request::Event::Ready => Result::Ok(count + 1),
        },
    }
}
fn run(builder: &mut world::Builder, controls: &mut operation::Controls) -> Result<world::NormalizedWorld, request::Failure> {
    handle steps(&mut *builder, &mut *controls, 0) { Result::Err(error) => Result::Err(error), Result::Ok(_) => world::finish(builder, & *controls) }
}
fn same_digest(a: identity::Digest, b: identity::Digest) -> i64 { yes(identity::equal(a, b)) }
fn optional_digest(a: Option<identity::Digest>, b: Option<identity::Digest>) -> i64 {
    handle a { Result::Err(_) => handle b { Result::Err(_) => 1, _ => 0 },
        Result::Ok(a) => handle b { Result::Err(_) => 0, Result::Ok(b) => same_digest(a, b) } }
}
fn builds(a: &request::CompilerBuildIdentity, b: &request::CompilerBuildIdentity) -> i64 {
    same_digest(a.compiler, b.compiler) * eq(as<i64>(a.language_generation), as<i64>(b.language_generation))
        * eq(as<i64>(a.query_generation), as<i64>(b.query_generation)) * eq(as<i64>(a.interface_generation), as<i64>(b.interface_generation))
        * eq(as<i64>(a.cache_generation), as<i64>(b.cache_generation)) * eq(as<i64>(a.bytecode_generation), as<i64>(b.bytecode_generation))
        * eq(as<i64>(a.verifier_generation), as<i64>(b.verifier_generation))
}
fn stages(a: request::BootstrapStage, b: request::BootstrapStage) -> i64 {
    eq(as<i64>(a.ordinal), as<i64>(b.ordinal)) * same_digest(a.producer, b.producer)
        * eq(as<i64>(a.optimization_level), as<i64>(b.optimization_level)) * eq(as<i64>(a.limits.max_sources), as<i64>(b.limits.max_sources))
        * eq(as<i64>(a.limits.max_total_source_bytes), as<i64>(b.limits.max_total_source_bytes)) * optional_digest(a.expected_artifact, b.expected_artifact)
}
fn modes(a: &request::CompilationMode, b: &request::CompilationMode) -> i64 {
    handle *a {
        request::CompilationMode::Bootstrap(a) => handle *b { request::CompilationMode::Bootstrap(b) => stages(a, b), _ => 0 },
        _ => eq(as<i64>(request::mode_tag(a)), as<i64>(request::mode_tag(b))),
    }
}
fn map_rows(actual: &options::Admitted, expected: Slice<HashMapEntry<String, String>>, index: usize, score: i64) -> i64 {
    handle index == Slice::len(&expected) {
        true => score, false => { let entry = Slice::get_unchecked(expected, index); let key = HashMapEntry::key(entry); let value = HashMapEntry::value(entry);
            handle options::get(actual, key) { Result::Err(_) => 0,
                Result::Ok(found) => map_rows(actual, expected, index + 1, score * strings(found, value)) } },
    }
}
fn maps(actual: &options::Admitted, expected: &HashMap<String, String>) -> i64 {
    let entries = HashMap::entries(expected);
    eq(as<i64>(options::len(actual)), as<i64>(Slice::len(&entries))) * map_rows(actual, entries, 0, 1)
}
fn source_row(actual: &request::AdmittedSource, expected: &request::SourceInput) -> i64 {
    let package = request::package(actual); let path = request::path(actual); let blob = request::blob(actual);
    let bytes = source::bytes(blob); let contents = Vec::as_slice(&expected.bytes); let key = source::file(blob);
    yes(Eq::eq(package, &expected.package)) * same(request::path_text(path), request::path_text(&expected.logical_path))
        * same_digest(source::fingerprint(blob), expected.digest) * yes(Eq::eq(&key, &expected.key))
        * handle Slice::lex_compare(bytes, contents) { Ordering::Equal => 1, _ => 0 }
}
fn source_rows(value: &world::NormalizedWorld, actual: Slice<request::AdmittedSource>, expected: &Vec<request::SourceInput>, index: usize, score: i64) -> i64 {
    handle index == Vec::len(expected) {
        true => score, false => { let wanted = Vec::get_unchecked(expected, index); let row = Slice::get_unchecked(actual, index);
            handle world::source_input(value, wanted.key) { Result::Err(_) => 0, Result::Ok(found) => {
                let fields = source_row(row, wanted) * source_row(found, wanted) * yes(database::PackageWorld::contains_package(value, &wanted.package));
                handle registry::World::source(value, wanted.key) { Result::Err(_) => 0, Result::Ok(blob) => {
                    let fingerprint = same_digest(source::fingerprint(blob), wanted.digest);
                    handle database::DiagnosticWorld::source_length(value, &wanted.key) { Result::Err(_) => 0,
                        Result::Ok(length) => source_rows(value, actual, expected, index + 1, score * fields * fingerprint * eq(as<i64>(length), as<i64>(Vec::len(&wanted.bytes)))) }
                } }
            } }
        },
    }
}
fn sources(value: &world::NormalizedWorld, expected: &Vec<request::SourceInput>) -> i64 {
    let actual = world::sources(value);
    handle Slice::len(&actual) == Vec::len(expected) { false => 0, true => source_rows(value, actual, expected, 0, 1) }
}
fn cap_rows(actual: Slice<names::Capability>, expected: &Vec<String>, index: usize, score: i64) -> i64 {
    handle index == Vec::len(expected) { true => score, false => { let a = Slice::get_unchecked(actual, index); let b = Vec::get_unchecked(expected, index);
        cap_rows(actual, expected, index + 1, score * same(names::capability_text(a), String::as_str(b))) } }
}
fn capabilities(value: &world::NormalizedWorld, expected: &Vec<String>) -> i64 {
    let actual = world::capabilities(value);
    handle Slice::len(&actual) == Vec::len(expected) { false => 0, true => cap_rows(actual, expected, 0, 1) }
}
fn selector_rows(a: &Vec<PrimitiveSelector>, b: &Vec<PrimitiveSelector>, index: usize, score: i64) -> i64 {
    handle index == Vec::len(a) { true => score, false => { let left = Vec::get_unchecked(a, index); let right = Vec::get_unchecked(b, index);
        selector_rows(a, b, index + 1, score * yes(Eq::eq(&left.role, &right.role)) * strings(&left.module_path, &right.module_path) * strings(&left.name, &right.name)) } }
}
fn host_rows(a: &Vec<HostImportSelector>, b: &Vec<HostImportSelector>, index: usize, score: i64) -> i64 {
    handle index == Vec::len(a) { true => score, false => { let left = Vec::get_unchecked(a, index); let right = Vec::get_unchecked(b, index);
        host_rows(a, b, index + 1, score * strings(&left.module_path, &right.module_path) * strings(&left.name, &right.name)
            * strings(&left.capability, &right.capability) * strings(&left.symbol, &right.symbol)) } }
}
fn manifests(a: &RuntimeManifestInput, b: &RuntimeManifestInput) -> i64 {
    handle Vec::len(&a.selectors) == Vec::len(&b.selectors) { false => 0, true => handle Vec::len(&a.host_imports) == Vec::len(&b.host_imports) {
        false => 0, true => yes(Eq::eq(&a.standard_library, &b.standard_library)) * selector_rows(&a.selectors, &b.selectors, 0, 1) * host_rows(&a.host_imports, &b.host_imports, 0, 1),
    } }
}
fn runtime(value: &world::NormalizedWorld, expected: &Option<RuntimeManifestInput>) -> i64 {
    handle world::runtime_manifest(value) { Result::Err(_) => handle Result::as_ref(expected) { Result::Err(_) => 1, _ => 0 },
        Result::Ok(actual) => handle Result::as_ref(expected) { Result::Err(_) => 0, Result::Ok(wanted) => manifests(actual, wanted) } }
}
fn alias_rows(value: &world::NormalizedWorld, aliases: Slice<names::PackageAlias>, index: usize, score: i64) -> i64 {
    handle index == Slice::len(&aliases) { true => score, false => { let row = Slice::get_unchecked(aliases, index); let package = names::package(row);
        let alias = Str::to_string(names::alias_text(row));
        handle world::alias_package(value, &alias) { Result::Err(_) => 0, Result::Ok(found) =>
            alias_rows(value, aliases, index + 1, score * yes(Eq::eq(package, found)) * yes(database::PackageWorld::contains_package(value, package))) } } }
}
fn retained(value: &world::NormalizedWorld, expected: &request::CompilationRequest) -> i64 {
    let aliases = world::aliases(value);
    builds(world::build(value), &expected.build) * modes(world::mode(value), &expected.mode) * yes(Eq::eq(world::root(value), &expected.root_package))
        * same(world::target(value), String::as_str(&expected.target)) * sources(value, &expected.sources)
        * maps(world::semantic_options(value), &expected.semantic_options) * maps(world::codegen_options(value), &expected.codegen_options)
        * capabilities(value, &expected.capability_manifest) * runtime(value, &expected.runtime_manifest) * alias_rows(value, aliases, 0, 1)
        * yes(database::PackageWorld::contains_package(value, &expected.root_package))
}
fn check(raw: Witness, expected: Witness, fingerprint: identity::Digest) -> i64 {
    let valid = raw.valid * expected.valid; let builder = world::begin(raw.input, limits()); let controls = operation::create(1000000, 1000000);
    handle run(&mut builder, &mut controls) { Result::Err(_) => 0, Result::Ok(value) => {
        let score = valid * same_digest(world::fingerprint(&value), fingerprint) * retained(&value, &expected.input);
        handle world::finish(&mut builder, &controls) { Result::Err(request::Failure::Closed) => score, _ => 0 }
    } }
}
@CASES@
fn main() -> i64 { oracles() }
