@SUPPORT@
@SAMPLE@
fn expect<T>(value: Result<T, request::Failure>, code: usize) -> i64 where T: Use<[0, 1]> {
    handle value { Result::Ok(_) => eq(as<i64>(code), 0), Result::Err(error) => handle error {
        request::Failure::Closed => eq(as<i64>(code), 1), request::Failure::Busy => eq(as<i64>(code), 2),
        request::Failure::Control(operation::Failure::Cancelled) => eq(as<i64>(code), 3),
        request::Failure::Control(operation::Failure::ResourceLimit { name: 0, ceiling: _, requested: _ }) => eq(as<i64>(code), 4), _ => 0,
    } }
}
fn new_builder(limits: world::Limits) -> Option<world::Builder> {
    let raw = sample(); handle raw.valid == 1 { false => None, true => Result::Ok(world::begin(raw.input, limits)) }
}
fn advance(builder: &mut world::Builder, controls: &mut operation::Controls, remaining: usize) -> i64 {
    handle remaining == 0 { true => 1, false => handle world::step(&mut *builder, &mut *controls) {
        Result::Err(_) => 0, Result::Ok(_) => advance(builder, controls, remaining - 1),
    } }
}
fn cancel_result(builder: &mut world::Builder, controls: &mut operation::Controls, finishing: Bool) -> i64 {
    handle finishing { true => expect(world::finish(builder, & *controls), 3), false => expect(world::step(builder, controls), 3) }
}
fn cancelled(point: usize, finishing: Bool) -> i64 {
    handle new_builder(limits()) { Result::Err(_) => 0, Result::Ok(builder) => {
        let controls = operation::create(1000000, 1000000); let valid = advance(&mut builder, &mut controls, point);
        let spent = operation::work_spent(&controls); operation::cancel(&mut controls);
        let result = cancel_result(&mut builder, &mut controls, finishing); let fresh = operation::create(1000000, 1000000);
        valid * result * expect(world::finish(&mut builder, &fresh), 1) * eq(as<i64>(spent), as<i64>(operation::work_spent(&controls)))
    } }
}
fn point(ready: usize, index: usize) -> usize {
    handle index { 0 => 0, 1 => 1, 2 => ready / 4, 3 => ready / 2, 4 => (ready / 4) * 3, 5 => ready - 1, _ => ready }
}
fn cancellations(ready: usize, index: usize, score: i64) -> i64 {
    handle index == 7 { true => score, false => { let at = point(ready, index);
        cancellations(ready, index + 1, score + cancelled(at, true) + cancelled(at, false)) } }
}
fn aborted(point: usize) -> i64 {
    handle new_builder(limits()) { Result::Err(_) => 0, Result::Ok(builder) => {
        let controls = operation::create(1000000, 1000000); let valid = advance(&mut builder, &mut controls, point);
        let spent = operation::work_spent(&controls); world::abort(&mut builder); world::abort(&mut builder);
        valid * expect(world::finish(&mut builder, &controls), 1) * eq(as<i64>(spent), as<i64>(operation::work_spent(&controls)))
    } }
}
fn premature(point: usize) -> i64 {
    handle new_builder(limits()) { Result::Err(_) => 0, Result::Ok(builder) => {
        let controls = operation::create(1000000, 1000000); let valid = advance(&mut builder, &mut controls, point);
        let spent = operation::work_spent(&controls);
        valid * expect(world::finish(&mut builder, &controls), 2) * expect(world::finish(&mut builder, &controls), 1)
            * eq(as<i64>(spent), as<i64>(operation::work_spent(&controls)))
    } }
}
fn limited(spent: u64, limit: u64) -> i64 { handle spent <= limit { true => 1, false => 0 } }
fn budget(limit: u64, succeeds: Bool) -> i64 {
    handle new_builder(limits()) { Result::Err(_) => 0, Result::Ok(builder) => {
        let controls = operation::create(limit, 1000000); let result = run(&mut builder, &mut controls); let spent = operation::work_spent(&controls);
        let fresh = operation::create(1000000, 1000000); let closed = expect(world::finish(&mut builder, &fresh), 1);
        handle succeeds {
            true => handle result { Result::Err(_) => 0, Result::Ok(value) => closed * same_digest(world::fingerprint(&value), expected_fingerprint()) * eq(as<i64>(spent), as<i64>(limit)) },
            false => closed * limited(spent, limit) * expect(result, 4) * eq(as<i64>(spent), as<i64>(operation::work_spent(&controls))),
        }
    } }
}
fn capacity(size: usize, succeeds: Bool) -> i64 {
    let ceiling = limits(); ceiling.fingerprint_bytes = size;
    handle new_builder(ceiling) { Result::Err(_) => 0, Result::Ok(builder) => {
        let controls = operation::create(1000000, 1000000); let result = run(&mut builder, &mut controls);
        let closed = expect(world::finish(&mut builder, &controls), 1);
        handle succeeds {
            true => handle result { Result::Err(_) => 0, Result::Ok(value) => closed * same_digest(world::fingerprint(&value), expected_fingerprint()) },
            false => handle result { Result::Err(error) => handle error {
                request::Failure::Capacity { name: 18, limit: limit } => closed * eq(as<i64>(limit), as<i64>(size)), _ => 0,
            }, _ => 0 },
        }
    } }
}
fn positive(value: u64) -> i64 { handle value > 0 { true => 1, false => 0 } }
fn checks(ready: usize, required: u64, valid: i64) -> (i64, i64, i64, i64, i64, i64) {
    let bytes = transcript_bytes();
    (valid * positive(as<u64>(ready)) * positive(required) * positive(as<u64>(bytes)),
        cancellations(ready, 0, 0),
        aborted(0) + aborted(ready / 2) + aborted(ready),
        premature(0) + premature(ready / 2) + premature(ready - 1),
        budget(0, false) + budget(1, false) + budget(bit_shr(required, 1), false) + budget(wrapping_sub(required, 1), false) + budget(required, true),
        capacity(0, false) + capacity(8, false) + capacity(bytes - 1, false) + capacity(bytes, true))
}
fn main() -> (i64, i64, i64, i64, i64, i64) {
    handle new_builder(limits()) { Result::Err(_) => (0, 0, 0, 0, 0, 0), Result::Ok(builder) => {
        let controls = operation::create(1000000, 1000000);
        handle steps(&mut builder, &mut controls, 0) { Result::Err(_) => (0, 0, 0, 0, 0, 0), Result::Ok(ready) => {
            let required = operation::work_spent(&controls);
            handle world::finish(&mut builder, &controls) { Result::Err(_) => (0, 0, 0, 0, 0, 0), Result::Ok(value) =>
                checks(ready, required, same_digest(world::fingerprint(&value), expected_fingerprint()) * expect(world::finish(&mut builder, &controls), 1)) }
        } }
    } }
}
