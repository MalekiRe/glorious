use std::*;
use kernel::identity;
use kernel::identity::Digest;
use kernel::identity::FileKey;
use kernel::operation;
pub mod kernel;
pub mod source;
pub mod registry;
pub mod request;

fn owned(bytes: Slice<u8>) -> Vec<u8> { let value = Vec<u8>::new(); Vec::extend_from_slice(&mut value, bytes); value }
fn equal(a: i64, b: i64) -> i64 { handle a == b { true => 1, false => 0 } }
fn same(a: Slice<u8>, b: Slice<u8>) -> i64 { handle Slice::lex_compare(a, b) { Ordering::Equal => 1, _ => 0 } }
fn digest(a: Digest, b: Digest) -> i64 { handle identity::equal(a, b) { true => 1, false => 0 } }
fn path_steps(builder: &mut request::PathBuilder, controls: &mut operation::Controls) -> Result<(), request::Failure> {
    handle request::step_path(&mut *builder, &mut *controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(event) => handle event {
            request::Event::Ready => Result::Ok(()), request::Event::Continue => path_steps(builder, controls),
        },
    }
}
fn path(value: String) -> Result<request::LogicalPath, request::Failure> {
    let controls = operation::create(10000, 10000);
    let builder = request::begin_path(value);
    handle path_steps(&mut builder, &mut controls) {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => request::finish_path(&mut builder, &controls),
    }
}
fn path_case(bytes: Slice<u8>, expected: i64) -> i64 {
    handle String::from_utf8(owned(bytes)) {
        Result::Err(_) => 0,
        Result::Ok(text) => handle path(text) {
            Result::Ok(value) => {
                let view = request::path_text(&value);
                equal(expected, 0) * same(Str::as_bytes(view), bytes)
            },
            Result::Err(error) => handle error {
                request::Failure::Rejected(request::InputError::InvalidLogicalPath(value)) =>
                    equal(expected, 1) * same(Str::as_bytes(String::as_str(&value)), bytes),
                _ => 0,
            },
        },
    }
}
fn path_cases() -> i64 {
    let score = as<i64>(0);
    @PATHS@
    score
}
fn input(key: FileKey, fingerprint: Digest, bytes: Slice<u8>) -> Result<request::SourceInput, request::Failure> {
    handle path(Str::to_string("src/main.glorious")) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(path) => Result::Ok(request::SourceInput { key: key,
            package: identity::PackageKey { value: Str::to_string("app") },
            logical_path: path, bytes: owned(bytes), digest: fingerprint }),
    }
}
fn source_steps(builder: &mut request::SourceBuilder, controls: &mut operation::Controls) -> Result<(), request::Failure> {
    handle request::step_source(&mut *builder, &mut *controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(event) => handle event {
            request::Event::Ready => Result::Ok(()), request::Event::Continue => source_steps(builder, controls),
        },
    }
}
fn admit(value: request::SourceInput) -> Result<request::AdmittedSource, request::Failure> {
    let controls = operation::create(10000, 10000);
    let builder = request::begin_source(value, 1000, 1000);
    handle source_steps(&mut builder, &mut controls) {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => request::finish_source(&mut builder, &controls),
    }
}
fn rejected(error: request::InputError, key: FileKey, correct: FileKey, supplied: Digest, actual: Digest, expected: i64) -> i64 {
    handle error {
        request::InputError::SourceIdentityMismatch { supplied: observed, expected: wanted } =>
            equal(expected, 1) * digest(observed.digest, key.digest) * digest(wanted.digest, correct.digest),
        request::InputError::DigestMismatch { file: file, expected: wanted, actual: observed } =>
            equal(expected, 2) * digest(file.digest, key.digest) * digest(wanted, supplied) * digest(observed, actual),
        request::InputError::InvalidUtf8(file) => equal(expected, 3) * digest(file.digest, key.digest),
        _ => 0,
    }
}
fn source_case(key: FileKey, correct: FileKey, supplied: Digest, actual: Digest, bytes: Slice<u8>, expected: i64) -> i64 {
    handle input(key, supplied, bytes) {
        Result::Err(_) => 0,
        Result::Ok(value) => handle admit(value) {
            Result::Err(error) => handle error {
                request::Failure::Rejected(error) => rejected(error, key, correct, supplied, actual, expected), _ => 0,
            },
            Result::Ok(value) => {
                let blob = request::blob(&value);
                let data = digest(source::file(blob).digest, correct.digest) * digest(source::fingerprint(blob), actual)
                    * same(source::bytes(blob), bytes);
                let logical_path = request::path(&value);
                let path_view = request::path_text(logical_path);
                let names = same(Str::as_bytes(path_view), b"src/main.glorious")
                    * same(Str::as_bytes(String::as_str(&request::package(&value).value)), b"app");
                equal(expected, 0) * data * names
            },
        },
    }
}
fn decoded_case(key: Slice<u8>, correct: FileKey, supplied: Slice<u8>, actual: Slice<u8>, bytes: Slice<u8>, expected: i64) -> i64 {
    handle identity::decode(key) {
        Result::Err(_) => 0,
        Result::Ok(key) => handle identity::decode(supplied) {
            Result::Err(_) => 0,
            Result::Ok(supplied) => handle identity::decode(actual) {
                Result::Err(_) => 0,
                Result::Ok(actual) => source_case(FileKey { digest: key }, correct, supplied, actual, bytes, expected),
            },
        },
    }
}
fn source_cases(correct: FileKey) -> i64 {
    let score = as<i64>(0);
    @SOURCES@
    score
}
fn expect<T>(result: Result<T, request::Failure>, expected: i64) -> i64 where T: Use<[0, 1]> {
    handle result {
        Result::Ok(_) => equal(expected, 0),
        Result::Err(error) => handle error {
            request::Failure::Closed => equal(expected, 1),
            request::Failure::Busy => equal(expected, 2),
            request::Failure::Control(operation::Failure::Cancelled) => equal(expected, 3),
            request::Failure::Control(operation::Failure::ResourceLimit { name: 0, ceiling: _, requested: _ }) => equal(expected, 4),
            request::Failure::Capacity { name: 0, limit: _ } => equal(expected, 5),
            request::Failure::Capacity { name: 1, limit: _ } => equal(expected, 6),
            _ => 0,
        },
    }
}
fn path_cleanup() -> i64 {
    let controls = operation::create(1000, 1000);
    let builder = request::begin_path(Str::to_string("a/b"));
    let early = expect(request::finish_path(&mut builder, &controls), 2) + expect(request::finish_path(&mut builder, &controls), 1);
    let builder = request::begin_path(Str::to_string("a/b"));
    let started = expect(request::step_path(&mut builder, &mut controls), 0);
    operation::cancel(&mut controls);
    let cancelled = expect(request::step_path(&mut builder, &mut controls), 3);
    let fresh = operation::create(1000, 1000);
    let closed = expect(request::finish_path(&mut builder, &fresh), 1);
    let builder = request::begin_path(Str::to_string("a/b"));
    let empty = operation::create(0, 0);
    let exhausted = expect(request::step_path(&mut builder, &mut empty), 4);
    let discarded = expect(request::finish_path(&mut builder, &fresh), 1);
    let builder = request::begin_path(Str::to_string("a/b"));
    let ready = expect(path_steps(&mut builder, &mut fresh), 0);
    operation::cancel(&mut fresh);
    let late = expect(request::finish_path(&mut builder, &fresh), 3);
    let final_controls = operation::create(1000, 1000);
    early + started + cancelled + closed + exhausted + discarded + ready + late
        + expect(request::finish_path(&mut builder, &final_controls), 1)
}
fn steps(builder: &mut request::SourceBuilder, controls: &mut operation::Controls, count: usize) -> () {
    handle count == 0 {
        true => (), false => { request::step_source(&mut *builder, &mut *controls); steps(builder, controls, count - 1) },
    }
}
fn source_cancel(value: request::SourceInput, phase: usize, finishing: usize) -> i64 {
    let controls = operation::create(1000, 1000);
    let builder = request::begin_source(value, 1000, 1000);
    steps(&mut builder, &mut controls, phase);
    let spent = operation::work_spent(&controls);
    operation::cancel(&mut controls);
    let cancelled = handle finishing {
        0 => expect(request::step_source(&mut builder, &mut controls), 3),
        _ => expect(request::finish_source(&mut builder, &controls), 3),
    };
    let charged = equal(as<i64>(spent), as<i64>(operation::work_spent(&controls)));
    let fresh = operation::create(1000, 1000);
    cancelled + charged + expect(request::step_source(&mut builder, &mut fresh), 1) + expect(request::finish_source(&mut builder, &fresh), 1)
}
fn source_finished(value: request::SourceInput) -> i64 {
    let controls = operation::create(1000, 1000);
    let builder = request::begin_source(value, 1000, 1000);
    let ready = expect(source_steps(&mut builder, &mut controls), 0);
    let published = expect(request::finish_source(&mut builder, &controls), 0);
    ready + published + expect(request::finish_source(&mut builder, &controls), 1)
        + expect(request::step_source(&mut builder, &mut controls), 1)
}
fn source_failure(value: request::SourceInput, mode: usize) -> i64 {
    let byte_limit = handle mode { 0 => as<usize>(0), _ => as<usize>(1000) };
    let identity_limit = handle mode { 1 => as<usize>(0), _ => as<usize>(1000) };
    let work_limit = handle mode { 2 => as<u64>(0), _ => as<u64>(1000) };
    let controls = operation::create(work_limit, 1000);
    let builder = request::begin_source(value, byte_limit, identity_limit);
    let failed = handle mode {
        0 => expect(source_steps(&mut builder, &mut controls), 5),
        1 => expect(source_steps(&mut builder, &mut controls), 6),
        2 => expect(source_steps(&mut builder, &mut controls), 4),
        3 => expect(request::finish_source(&mut builder, &controls), 2),
        _ => { request::abort_source(&mut builder); expect(request::finish_source(&mut builder, &controls), 1) },
    };
    let fresh = operation::create(1000, 1000);
    failed + expect(request::finish_source(&mut builder, &fresh), 1)
}
fn source_cleanup(key: FileKey, fingerprint: Digest) -> i64 {
    handle input(key, fingerprint, b"a\n") {
        Result::Err(_) => 0,
        Result::Ok(value) => {
            let cancelled_steps = source_cancel(value, 0, 0) + source_cancel(value, 1, 0) + source_cancel(value, 2, 0) + source_cancel(value, 3, 0);
            let cancelled_finish = source_cancel(value, 0, 1) + source_cancel(value, 1, 1) + source_cancel(value, 2, 1) + source_cancel(value, 3, 1);
            let failures = source_failure(value, 0) + source_failure(value, 1) + source_failure(value, 2) + source_failure(value, 3) + source_failure(value, 4);
            cancelled_steps + cancelled_finish + failures + source_finished(value)
        },
    }
}
pub struct World { value: request::AdmittedSource }
pub impl registry::World for World {
    source<'a>(world: &'a World, key: FileKey) -> Option<&'a source::Blob> {
        let blob = request::blob(&world.value);
        handle identity::equal(source::file(blob).digest, key.digest) { true => Result::Ok(blob), false => None }
    }
}
fn drive(db: &mut registry::Registry<World>, query: registry::Query<source::LineIndex>) -> Result<registry::Value<source::LineIndex>, registry::Failure> {
    handle registry::poll(&mut *db, query) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(event) => handle event {
            registry::Event::Ready(value) => Result::Ok(value), _ => drive(db, query),
        },
    }
}
fn query(db: &mut registry::Registry<World>, session: registry::Session, file: FileKey) -> i64 {
    handle registry::line_index(&mut *db, session, file) {
        Result::Err(_) => 0,
        Result::Ok(query) => handle drive(&mut *db, query) {
            Result::Err(_) => 0,
            Result::Ok(value) => handle registry::line_value(& *db, session, value) {
                Result::Err(_) => 0, Result::Ok(index) => equal(as<i64>(source::line_count(index)), 2),
            },
        },
    }
}
fn integrated(value: request::AdmittedSource, key: FileKey, fingerprint: Digest) -> i64 {
    let limits = registry::Limits { revisions: 2, sessions: 2, attempts: 4, memos: 4, reads: 4, keys: 4,
        source_products: 2, line_products: 2, drivers: 2, frames: 4, source_bytes: 1000, lines: 100 };
    handle registry::create<World>(9, limits) {
        Result::Err(_) => 0,
        Result::Ok(db) => handle registry::import(&mut db, World { value: value }, fingerprint, None) {
            Result::Err(_) => 0,
            Result::Ok(revision) => handle registry::open(&mut db, revision, 10000, 10000) {
                Result::Err(_) => 0,
                Result::Ok(session) => query(&mut db, session, key) + query(&mut db, session, key),
            },
        },
    }
}
fn registry_case(key: FileKey, fingerprint: Digest) -> i64 {
    handle input(key, fingerprint, b"a\n") {
        Result::Err(_) => 0,
        Result::Ok(value) => handle admit(value) { Result::Err(_) => 0, Result::Ok(value) => integrated(value, key, fingerprint) },
    }
}
fn run(key: FileKey, fingerprint: Digest) -> (i64, i64, i64, i64, i64) {
    let paths = path_cases();
    let sources = source_cases(key);
    let paths_cleanup = path_cleanup();
    let sources_cleanup = source_cleanup(key, fingerprint);
    let registry = registry_case(key, fingerprint);
    (paths, sources, paths_cleanup, sources_cleanup, registry)
}
pub fn main() -> (i64, i64, i64, i64, i64) {
    handle identity::decode(b"@KEY@") {
        Result::Err(_) => (0, 0, 0, 0, 0),
        Result::Ok(key) => handle identity::hash(b"a\n") {
            Result::Err(_) => (0, 0, 0, 0, 0), Result::Ok(fingerprint) => run(FileKey { digest: key }, fingerprint),
        },
    }
}
