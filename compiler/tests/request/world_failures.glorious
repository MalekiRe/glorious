@SUPPORT@
fn file_equal(a: identity::FileKey, b: identity::FileKey) -> i64 { same_digest(a.digest, b.digest) }
fn rejection(actual: request::InputError, expected: request::InputError) -> i64 {
    handle actual {
        request::InputError::EmptySources => handle expected { request::InputError::EmptySources => 1, _ => 0 },
        request::InputError::DuplicateFileKey(a) => handle expected { request::InputError::DuplicateFileKey(b) => file_equal(a, b), _ => 0 },
        request::InputError::SourceIdentityMismatch { supplied: a, expected: b } => handle expected {
            request::InputError::SourceIdentityMismatch { supplied: c, expected: d } => file_equal(a, c) * file_equal(b, d), _ => 0 },
        request::InputError::DigestMismatch { file: a, expected: b, actual: c } => handle expected {
            request::InputError::DigestMismatch { file: d, expected: e, actual: f } => file_equal(a, d) * same_digest(b, e) * same_digest(c, f), _ => 0 },
        request::InputError::InvalidUtf8(a) => handle expected { request::InputError::InvalidUtf8(b) => file_equal(a, b), _ => 0 },
        request::InputError::InvalidPackageModuleAlias(a) => handle expected { request::InputError::InvalidPackageModuleAlias(b) => yes(Eq::eq(&a, &b)), _ => 0 },
        request::InputError::DuplicatePackageModuleAlias { alias: a, first: b, second: c } => handle expected {
            request::InputError::DuplicatePackageModuleAlias { alias: d, first: e, second: f } => strings(&a, &d) * yes(Eq::eq(&b, &e)) * yes(Eq::eq(&c, &f)), _ => 0 },
        request::InputError::InvalidCapability(a) => handle expected { request::InputError::InvalidCapability(b) => strings(&a, &b), _ => 0 },
        request::InputError::DuplicateCapability(a) => handle expected { request::InputError::DuplicateCapability(b) => strings(&a, &b), _ => 0 },
        request::InputError::InvalidRuntimeManifest => handle expected { request::InputError::InvalidRuntimeManifest => 1, _ => 0 },
        request::InputError::InvalidBootstrapStage { reason: a } => handle expected { request::InputError::InvalidBootstrapStage { reason: b } => strings(&a, &b), _ => 0 },
        request::InputError::BootstrapSourceLimit { actual: a, limit: b } => handle expected {
            request::InputError::BootstrapSourceLimit { actual: c, limit: d } => eq(as<i64>(a), as<i64>(c)) * eq(as<i64>(b), as<i64>(d)), _ => 0 },
        _ => 0,
    }
}
fn closed(builder: &mut world::Builder, controls: &operation::Controls) -> i64 {
    handle world::finish(builder, controls) { Result::Err(request::Failure::Closed) => 1, _ => 0 }
}
fn reject(input: Witness, expected: request::InputError) -> i64 {
    let valid = input.valid; let controls = operation::create(1000000, 1000000); let builder = world::begin(input.input, limits());
    let result = run(&mut builder, &mut controls); let spent = operation::work_spent(&controls);
    let sealed = closed(&mut builder, &controls) * closed(&mut builder, &controls) * eq(as<i64>(spent), as<i64>(operation::work_spent(&controls)));
    handle result { Result::Err(error) => handle error { request::Failure::Rejected(actual) => valid * sealed * rejection(actual, expected), _ => 0 }, _ => 0 }
}
@CASES@
fn main() -> i64 { oracles() }
