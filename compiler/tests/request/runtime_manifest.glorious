use std::*;
use kernel::operation;
use kernel::identity::PackageKey;
use runtime_manifest::RuntimeManifestInput;
use runtime_manifest::PrimitiveSelector;
use runtime_manifest::HostImportSelector;
use runtime_manifest::ManifestError;
use runtime_manifest::PrimitiveRole;
use runtime_manifest::FloatPrimitive;
use runtime_manifest::FloatWidth;
use runtime_manifest::FloatBinaryOp;
use runtime_manifest::FloatCompareOp;
use runtime_manifest::input;
use types::ScalarType;

struct Expected { kind: i64, role: PrimitiveRole, a: String, b: String, value: RuntimeManifestInput }
fn eq(a: i64, b: i64) -> i64 { handle a == b { true => 1, false => 0 } }
fn yes(value: Bool) -> i64 { handle value { true => 1, false => 0 } }
fn no(value: Bool) -> i64 { handle value { true => 0, false => 1 } }
// C0 lowers the wide scalar comparison in a tail completion. Keep the
// resource predicate out of an argument's unsupported non-tail completion.
fn positive(value: u64) -> i64 { handle value > 0 { true => 1, false => 0 } }
fn same(a: &String, b: &String) -> i64 { yes(Eq::eq(a, b)) }
fn text(bytes: Slice<u8>) -> String {
    let values = Vec<u8>::new(); Vec::extend_from_slice(&mut values, bytes);
    handle String::from_utf8(values) { Result::Ok(value) => value, Result::Err(_) => String::new() }
}
fn limits() -> input::Limits { input::Limits { selectors: 1000, host_imports: 1000, text_bytes: 1000 } }
fn steps(builder: &mut input::Builder, controls: &mut operation::Controls, count: usize) -> Result<usize, input::Failure> {
    handle input::step(&mut *builder, &mut *controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(event) => handle event {
            input::Event::Continue => steps(builder, controls, count + 1), input::Event::Ready => Result::Ok(count + 1),
        },
    }
}
fn run(builder: &mut input::Builder, controls: &mut operation::Controls) -> Result<input::Admitted, input::Failure> {
    handle steps(&mut *builder, &mut *controls, 0) { Result::Err(error) => Result::Err(error), Result::Ok(_) => input::finish(builder, & *controls) }
}
fn control_expect(error: operation::Failure, code: i64) -> i64 {
    handle error {
        operation::Failure::Cancelled => eq(code, 3),
        operation::Failure::ResourceLimit { name: name, ceiling: _, requested: requested } => eq(code, 4) * eq(as<i64>(name), 0) * positive(requested),
        _ => 0,
    }
}
fn expect<T>(value: Result<T, input::Failure>, code: i64) -> i64 where T: Use<[0, 1]> {
    handle value {
        Result::Ok(_) => eq(code, 0),
        Result::Err(error) => handle error {
            input::Failure::Closed => eq(code, 1), input::Failure::Busy => eq(code, 2),
            input::Failure::Control(error) => control_expect(error, code),
            _ => 0,
        },
    }
}
fn selector_rows(a: &Vec<PrimitiveSelector>, b: &Vec<PrimitiveSelector>, cursor: usize, score: i64) -> i64 {
    handle cursor == Vec::len(a) {
        true => score,
        false => {
            let left = Vec::get_unchecked(a, cursor); let right = Vec::get_unchecked(b, cursor);
            selector_rows(a, b, cursor + 1, score * yes(Eq::eq(&left.role, &right.role)) * same(&left.module_path, &right.module_path) * same(&left.name, &right.name))
        },
    }
}
fn host_rows(a: &Vec<HostImportSelector>, b: &Vec<HostImportSelector>, cursor: usize, score: i64) -> i64 {
    handle cursor == Vec::len(a) {
        true => score,
        false => {
            let left = Vec::get_unchecked(a, cursor); let right = Vec::get_unchecked(b, cursor);
            host_rows(a, b, cursor + 1, score * same(&left.module_path, &right.module_path) * same(&left.name, &right.name)
                * same(&left.capability, &right.capability) * same(&left.symbol, &right.symbol))
        },
    }
}
fn manifests(a: &RuntimeManifestInput, b: &RuntimeManifestInput) -> i64 {
    handle Vec::len(&a.selectors) == Vec::len(&b.selectors) {
        false => 0,
        true => handle Vec::len(&a.host_imports) == Vec::len(&b.host_imports) {
            false => 0,
            true => same(&a.standard_library.value, &b.standard_library.value) * selector_rows(&a.selectors, &b.selectors, 0, 1)
                * host_rows(&a.host_imports, &b.host_imports, 0, 1),
        },
    }
}
fn rejection(error: ManifestError, expected: &Expected) -> i64 {
    handle error {
        ManifestError::InvalidRole(role) => eq(expected.kind, 1) * yes(Eq::eq(&role, &expected.role)),
        ManifestError::DuplicateRole(role) => eq(expected.kind, 2) * yes(Eq::eq(&role, &expected.role)),
        ManifestError::InvalidHostImport { module_path: module, name: name } => eq(expected.kind, 3) * same(&module, &expected.a) * same(&name, &expected.b),
        ManifestError::DuplicateHostImport { module_path: module, name: name } => eq(expected.kind, 4) * same(&module, &expected.a) * same(&name, &expected.b),
        _ => 0,
    }
}
fn check(value: RuntimeManifestInput, expected: Expected) -> i64 {
    let controls = operation::create(1000000, 1000000); let builder = input::begin(value, limits());
    let result = run(&mut builder, &mut controls); let closed = expect(input::finish(&mut builder, &controls), 1);
    handle result {
        Result::Err(error) => handle error { input::Failure::Rejected(error) => closed * rejection(error, &expected), _ => 0 },
        Result::Ok(admitted) => {
            let borrowed = input::value(&admitted); let fields = manifests(borrowed, &expected.value);
            let owned = input::into_input(admitted);
            closed * eq(expected.kind, 0) * fields * manifests(&owned, &expected.value)
        },
    }
}
fn ordering(a: &PrimitiveRole, b: &PrimitiveRole, expected: i64) -> i64 {
    handle Ord::compare(a, b) { Ordering::Less => eq(expected, -1), Ordering::Equal => eq(expected, 0), Ordering::Greater => eq(expected, 1) }
}
fn tag(value: PrimitiveRole) -> i64 { handle runtime_manifest::stable_tag(value) { Result::Err(_) => 0, Result::Ok(value) => 1 + as<i64>(value) } }
fn validity(value: PrimitiveRole, expected: Bool) -> i64 {
    handle runtime_manifest::validate_role(value) {
        Result::Ok(_) => yes(expected),
        Result::Err(error) => handle error { ManifestError::InvalidRole(role) => no(expected) * yes(Eq::eq(&role, &value)), _ => 0 },
    }
}
fn neighbors(previous: PrimitiveRole, value: PrimitiveRole, first: Bool) -> i64 {
    handle first { true => ordering(&previous, &value, 0), false => ordering(&previous, &value, -1) * ordering(&value, &previous, 1) }
}
fn role_case(value: PrimitiveRole, previous: PrimitiveRole, first: Bool, name: Slice<u8>, expected: i64) -> i64 {
    let spelling = runtime_manifest::selector_name(value); let wanted = text(name);
    let between = neighbors(previous, value, first);
    same(&spelling, &wanted) * eq(tag(value), expected + 1) * validity(value, true) * between * ordering(&value, &value, 0)
}
fn scalar(index: usize) -> ScalarType {
    handle index { 0 => ScalarType::Bool, 1 => ScalarType::U8, 2 => ScalarType::U16, 3 => ScalarType::U32,
        4 => ScalarType::U64, 5 => ScalarType::U128, 6 => ScalarType::I8, 7 => ScalarType::I16, 8 => ScalarType::I32,
        9 => ScalarType::I64, 10 => ScalarType::I128, 11 => ScalarType::Usize, 12 => ScalarType::Isize,
        13 => ScalarType::F32, 14 => ScalarType::F64, 15 => ScalarType::Char, 16 => ScalarType::Text, _ => ScalarType::Bytes }
}
fn conversion(index: usize) -> PrimitiveRole {
    PrimitiveRole::Float(FloatPrimitive::Convert { from: scalar(index / 36), to: scalar(index / 2 - (index / 36) * 18), checked: bit_and(index, 1) == 1 })
}
fn conversion_neighbors(index: usize, value: PrimitiveRole) -> i64 {
    handle index == 0 { true => 1, false => { let previous = conversion(index - 1); neighbors(previous, value, false) } }
}
fn expected_validity(value: PrimitiveRole, expected: i64) -> i64 {
    handle expected == 0 { true => validity(value, false), false => validity(value, true) }
}
fn conversions(expected: Slice<u8>, index: usize, score: i64) -> i64 {
    handle index == Slice::len(&expected) {
        true => eq(as<i64>(index), 648) * score,
        false => {
            let value = conversion(index); let wanted = as<i64>(*Slice::get_unchecked(expected, index));
            let ordered = conversion_neighbors(index, value);
            conversions(expected, index + 1, score + eq(tag(value), wanted) * expected_validity(value, wanted) * ordered)
        },
    }
}
fn empty() -> RuntimeManifestInput {
    RuntimeManifestInput { standard_library: PackageKey { value: Str::to_string("std@0.1.0") }, selectors: Vec<PrimitiveSelector>::new(), host_imports: Vec<HostImportSelector>::new() }
}
fn sample() -> RuntimeManifestInput {
    let value = empty();
    Vec::push(&mut value.selectors, PrimitiveSelector { role: PrimitiveRole::BranchBool, module_path: Str::to_string("a"), name: Str::to_string("b") });
    Vec::push(&mut value.selectors, PrimitiveSelector { role: PrimitiveRole::Abort, module_path: Str::to_string("a"), name: Str::to_string("a") });
    Vec::push(&mut value.host_imports, HostImportSelector { module_path: Str::to_string("a"), name: Str::to_string("b"), capability: Str::to_string("r"), symbol: Str::to_string("s") });
    Vec::push(&mut value.host_imports, HostImportSelector { module_path: Str::to_string("a"), name: Str::to_string("a"), capability: Str::to_string("r"), symbol: Str::to_string("s") });
    value
}
fn advance(builder: &mut input::Builder, controls: &mut operation::Controls, count: usize) -> () {
    handle count == 0 { true => (), false => { input::step(&mut *builder, &mut *controls); advance(builder, controls, count - 1) } }
}
fn cancelled(builder: &mut input::Builder, controls: &mut operation::Controls, finishing: Bool) -> i64 {
    handle finishing { false => expect(input::step(builder, controls), 3), true => expect(input::finish(builder, & *controls), 3) }
}
fn cancel_at(point: usize, finishing: Bool) -> i64 {
    let builder = input::begin(sample(), limits()); let controls = operation::create(1000000, 1000000);
    advance(&mut builder, &mut controls, point); let spent = operation::work_spent(&controls); operation::cancel(&mut controls);
    let score = cancelled(&mut builder, &mut controls, finishing); let fresh = operation::create(1000000, 1000000);
    score + expect(input::finish(&mut builder, &fresh), 1) + eq(as<i64>(operation::work_spent(&controls)), as<i64>(spent))
}
fn early_at(point: usize) -> i64 {
    let builder = input::begin(sample(), limits()); let controls = operation::create(1000000, 1000000);
    advance(&mut builder, &mut controls, point);
    expect(input::finish(&mut builder, &controls), 2) + expect(input::finish(&mut builder, &controls), 1)
}
fn abort_at(point: usize) -> i64 {
    let builder = input::begin(sample(), limits()); let controls = operation::create(1000000, 1000000);
    advance(&mut builder, &mut controls, point); input::abort(&mut builder);
    expect(input::step(&mut builder, &mut controls), 1) + expect(input::finish(&mut builder, &controls), 1)
}
fn transitions(point: usize, ready: usize, score: i64) -> i64 {
    handle point == ready {
        true => score + cancel_at(point, false) + cancel_at(point, true) + abort_at(point),
        false => transitions(point + 1, ready, score + cancel_at(point, false) + cancel_at(point, true) + early_at(point) + abort_at(point)),
    }
}
fn budget(limit: u64) -> i64 {
    let builder = input::begin(sample(), limits()); let controls = operation::create(limit, 1000000);
    let score = expect(run(&mut builder, &mut controls), 4); let spent = operation::work_spent(&controls);
    let fresh = operation::create(1000000, 1000000);
    score + expect(input::finish(&mut builder, &fresh), 1) + eq(as<i64>(operation::work_spent(&controls)), as<i64>(spent))
}
fn budgets(limit: u64, required: u64, score: i64) -> i64 {
    handle limit == required { true => score, false => budgets(wrapping_add(limit, 1), required, score + budget(limit)) }
}
fn lifecycle() -> i64 {
    let builder = input::begin(sample(), limits()); let controls = operation::create(1000000, 1000000);
    handle steps(&mut builder, &mut controls, 0) {
        Result::Err(_) => 0,
        Result::Ok(ready) => {
            let required = operation::work_spent(&controls);
            let completed = expect(input::finish(&mut builder, &controls), 0) + expect(input::finish(&mut builder, &controls), 1);
            let exact = input::begin(sample(), limits()); let bounded = operation::create(required, 1000000);
            let exact_score = expect(run(&mut exact, &mut bounded), 0) + expect(input::finish(&mut exact, &bounded), 1);
            eq(completed + exact_score + transitions(0, ready, 0) + budgets(0, required, 0), 12 + 10 * as<i64>(ready) + 3 * as<i64>(required))
                * positive(as<u64>(ready)) * positive(required)
        },
    }
}
fn capacity(value: RuntimeManifestInput, limits: input::Limits, expected: u32, ceiling: usize) -> i64 {
    let builder = input::begin(value, limits); let controls = operation::create(1000000, 1000000);
    let result = run(&mut builder, &mut controls); let closed = expect(input::finish(&mut builder, &controls), 1);
    handle result {
        Result::Err(error) => handle error {
            input::Failure::Capacity { name: name, limit: limit } => closed + eq(as<i64>(name), as<i64>(expected)) * eq(as<i64>(limit), as<i64>(ceiling)), _ => 0,
        },
        _ => 0,
    }
}
fn sized(field: u32, target: u32) -> String { handle field == target { true => Str::to_string("aa"), false => Str::to_string("a") } }
fn text_capacity(field: u32) -> i64 {
    let value = empty();
    Vec::push(&mut value.selectors, PrimitiveSelector { role: PrimitiveRole::Abort, module_path: sized(field, 2), name: sized(field, 3) });
    Vec::push(&mut value.host_imports, HostImportSelector { module_path: sized(field, 4), name: sized(field, 5), capability: sized(field, 6), symbol: sized(field, 7) });
    capacity(value, input::Limits { selectors: 1, host_imports: 1, text_bytes: 1 }, field, 1)
}
fn capacities() -> i64 {
    let controls = operation::create(1000000, 1000000);
    let exact = input::begin(sample(), input::Limits { selectors: 2, host_imports: 2, text_bytes: 1 });
    let zero = input::begin(empty(), input::Limits { selectors: 0, host_imports: 0, text_bytes: 0 });
    expect(run(&mut exact, &mut controls), 0) + expect(input::finish(&mut exact, &controls), 1)
        + expect(run(&mut zero, &mut controls), 0) + expect(input::finish(&mut zero, &controls), 1)
        + capacity(sample(), input::Limits { selectors: 1, host_imports: 2, text_bytes: 1 }, 0, 1)
        + capacity(sample(), input::Limits { selectors: 2, host_imports: 1, text_bytes: 1 }, 1, 1)
        + text_capacity(2) + text_capacity(3) + text_capacity(4) + text_capacity(5) + text_capacity(6) + text_capacity(7)
}
@CASES@
@ROLES@
main() -> (i64, i64, i64, i64, i64) { (oracles(), roles(), conversions(@CONVERSIONS@, 0, 0), lifecycle(), capacities()) }
