use std::*;
use kernel::operation;
use kernel::operation::budget;
pub mod kernel;

fn status(value: Result<(), budget::Failure>) -> i64 {
    handle value {
        Result::Ok(_) => 0,
        Result::Err(budget::Failure::Control(operation::Failure::ResourceLimit { name: name, ceiling: ceiling, requested: requested })) =>
            as<i64>(name) * 10000 + as<i64>(ceiling) * 100 + as<i64>(requested),
        _ => -1000,
    }
}
fn spent(pool: &budget::Pool, value: budget::Budget) -> i64 {
    handle budget::spent(pool, value) { Result::Ok(value) => as<i64>(value), _ => -1000 }
}
fn append(trace: i64, value: i64) -> i64 { wrapping_add(wrapping_mul(trace, 31), value) }
fn run(pool: &mut budget::Pool, controls: &mut operation::Controls,
    root: budget::Budget, child: budget::Budget, leaf: budget::Budget, sibling: budget::Budget) -> i64 {
    let trace = append(1, status(budget::charge(&mut *pool, leaf, 4, &mut *controls)));
    let trace = append(trace, spent(& *pool, root));
    let trace = append(trace, spent(& *pool, child));
    let trace = append(trace, status(budget::charge(&mut *pool, child, 4, &mut *controls)));
    let trace = append(trace, spent(& *pool, root));
    let trace = append(trace, status(budget::charge(&mut *pool, sibling, 7, &mut *controls)));
    let trace = append(trace, spent(& *pool, root));
    let trace = append(trace, status(budget::charge(&mut *pool, sibling, 6, &mut *controls)));
    let trace = append(trace, spent(& *pool, root));
    let trace = append(trace, status(budget::charge(&mut *pool, child, 0, &mut *controls)));
    let trace = append(trace, status(budget::release(&mut *pool, leaf, 4)));
    let trace = append(trace, spent(& *pool, root));
    let trace = append(trace, spent(& *pool, child));
    let trace = append(trace, spent(& *pool, sibling));
    trace
}
pub fn main() -> i64 {
    let pool = budget::create(100, 1, 8, 8);
    let controls = operation::create(1000, 1000);
    handle budget::root(&mut pool, 1, 10) {
        Result::Err(_) => -1,
        Result::Ok(root) => handle budget::child(&mut pool, root, 2, 7) {
            Result::Err(_) => -2,
            Result::Ok(child) => handle budget::child(&mut pool, child, 3, 5) {
                Result::Err(_) => -3,
                Result::Ok(leaf) => handle budget::child(&mut pool, root, 4, 6) {
                    Result::Err(_) => -4,
                    Result::Ok(sibling) => run(&mut pool, &mut controls, root, child, leaf, sibling),
                },
            },
        },
    }
}
