use std::*;
pub mod kernel;

pub fn descend(value: &mut i64, remaining: i64) -> i64 {
    handle remaining == 0 {
        true => { *value = 42; *value },
        false => {
            let child = *value + 1;
            descend(&mut child, remaining - 1)
        },
    }
}

pub fn main() -> i64 {
    let value = 0;
    let result = descend(&mut value, 100);
    handle value == 0 { true => result, false => -1 }
}
