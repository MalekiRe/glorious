use std::*;
pub mod kernel;

pub fn main() -> i64 {
    let buffer = ByteBuf::new(8);
    handle ByteBuf::put_u64(&mut buffer, 18364758544493064720) {
        Result::Ok(_) => handle ByteBuf::len(&buffer) == 8 {
            true => 42,
            false => 1,
        },
        Result::Err(_) => 2,
    }
}
