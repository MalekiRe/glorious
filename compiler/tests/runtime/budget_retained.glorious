use std::*;
use kernel::operation;
use kernel::operation::budget;
use kernel::storage;
pub mod kernel;

fn check(value: Bool) -> i64 { handle value { true => 1, false => -1000 } }
fn ok(value: Result<(), budget::Failure>) -> i64 { handle value { Result::Ok(_) => 1, _ => -1000 } }
fn spent(pool: &budget::Pool, value: budget::Budget, expected: u64) -> i64 {
    handle budget::spent(pool, value) { Result::Ok(value) => check(value == expected), _ => -1000 }
}
fn limit(value: Result<(), budget::Failure>, name: u32, ceiling: u64, requested: u64) -> i64 {
    handle value {
        Result::Err(budget::Failure::Control(operation::Failure::ResourceLimit { name: actual_name, ceiling: actual_ceiling, requested: actual_requested })) =>
            check(actual_name == name) + check(actual_ceiling == ceiling) + check(actual_requested == requested),
        _ => -1000,
    }
}
fn foreign(value: Result<(), budget::Failure>) -> i64 {
    handle value { Result::Err(budget::Failure::Storage(storage::StorageError::ForeignOwner)) => 1, _ => -1000 }
}
fn closed(value: Result<(), budget::Failure>) -> i64 {
    handle value { Result::Err(budget::Failure::Closed) => 1, _ => -1000 }
}
fn close(pool: &mut budget::Pool, fuel: usize) -> i64 {
    handle fuel == 0 {
        true => -1000,
        false => handle budget::close_step(&mut *pool) {
            Result::Err(_) => -1000,
            Result::Ok(done) => handle done { true => 1, false => close(pool, fuel - 1) },
        },
    }
}
fn finish(pool: &mut budget::Pool, controls: &mut operation::Controls, root: budget::Budget,
    child: budget::Budget, lease: &mut budget::Lease, zero: &mut budget::Lease) -> i64 {
    operation::cancel(&mut *controls);
    let denied = handle budget::grow_lease(&mut *pool, & *lease, 0, &mut *controls) {
        Result::Err(budget::Failure::Control(operation::Failure::Cancelled)) => 1, _ => -1000,
    };
    let work = operation::work_spent(& *controls);
    let done = close(&mut *pool, 10);
    let preserved = check(operation::work_spent(& *controls) == work);
    let held = spent(& *pool, root, 3) + spent(& *pool, child, 3)
        + check(budget::reservations(& *pool) == 2) + check(budget::retained_reservations(& *pool) == 2);
    let stopped = closed(budget::grow_lease(&mut *pool, & *lease, 1, &mut *controls))
        + closed(budget::retain_lease(&mut *pool, & *zero));
    let pinned = handle budget::retire(&mut *pool, child) { Result::Err(budget::Failure::Busy) => 1, _ => -1000 };
    let released = ok(budget::release_lease(&mut *pool, &mut *lease)) + spent(& *pool, root, 0)
        + check(budget::reservations(& *pool) == 1) + check(budget::retained_reservations(& *pool) == 1);
    let empty = ok(budget::release_lease(&mut *pool, zero))
        + check(budget::reservations(& *pool) == 0) + check(budget::retained_reservations(& *pool) == 0);
    let stale = handle budget::release_lease(&mut *pool, lease) { Result::Err(budget::Failure::Released) => 1, _ => -1000 };
    denied + done + preserved + held + stopped + pinned + released + empty + stale
        + ok(budget::retire(&mut *pool, child)) + ok(budget::retire(pool, root))
}
fn run(pool: &mut budget::Pool, controls: &mut operation::Controls, root: budget::Budget,
    child: budget::Budget, lease: budget::Lease) -> (i64, i64) {
    let grown = ok(budget::grow_lease(&mut *pool, &lease, 1, &mut *controls))
        + spent(& *pool, root, 6) + spent(& *pool, child, 6) + check(budget::reservations(& *pool) == 2);
    let limits = limit(budget::grow_lease(&mut *pool, &lease, 1, &mut *controls), 2, 6, 1)
        + limit(budget::grow_lease(&mut *pool, &lease, 5, &mut *controls), 1, 10, 5)
        + limit(budget::grow_lease(&mut *pool, &lease, 18446744073709551615, &mut *controls), 1, 10, 18446744073709551615);
    let retained = ok(budget::retain_lease(&mut *pool, &lease)) + ok(budget::retain_lease(&mut *pool, &lease))
        + check(budget::retained_reservations(& *pool) == 1);
    let other = budget::create(302, 1, 2, 3);
    let authority = foreign(budget::retain_lease(&mut other, &lease))
        + foreign(budget::grow_lease(&mut other, &lease, 1, &mut *controls)) + spent(& *pool, root, 6);
    handle budget::lease(&mut *pool, child, 0, &mut *controls) {
        Result::Err(_) => (-1000, -1000),
        Result::Ok(zero) => {
            let pinned = ok(budget::retain_lease(&mut *pool, &zero)) + check(budget::retained_reservations(& *pool) == 2);
            (grown + limits + retained + authority + pinned, finish(pool, controls, root, child, &mut lease, &mut zero))
        },
    }
}
pub fn main() -> (i64, i64) {
    let pool = budget::create(301, 1, 2, 3);
    let controls = operation::create(1000, 1000);
    handle budget::root(&mut pool, 1, 10) {
        Result::Err(_) => (-1, -1),
        Result::Ok(root) => handle budget::child(&mut pool, root, 2, 6) {
            Result::Err(_) => (-2, -2),
            Result::Ok(child) => handle budget::lease(&mut pool, child, 2, &mut controls) {
                Result::Err(_) => (-3, -3),
                Result::Ok(lease) => handle budget::lease(&mut pool, child, 3, &mut controls) {
                    Result::Err(_) => (-4, -4),
                    Result::Ok(_) => run(&mut pool, &mut controls, root, child, lease),
                },
            },
        },
    }
}
