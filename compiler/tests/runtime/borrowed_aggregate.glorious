use std::*;
pub mod kernel;

fn length(bytes: Slice<u8>) -> usize { Slice::len(&bytes) }
fn through_unique(bytes: &mut Vec<u8>) -> usize { length(Vec::as_slice(& *bytes)) }
pub fn main() -> i64 {
    let bytes = Vec<u8>::new();
    Vec::push(&mut bytes, 7);
    handle through_unique(&mut bytes) == 1 { true => 42, false => 0 }
}
