use std::*;
use kernel::storage::create;
use kernel::storage::insert;
use kernel::storage::get;
use kernel::storage::remove;
use kernel::storage::valid;
use kernel::storage::Handle;
use kernel::storage::Arena;
use kernel::storage::StorageError;
pub mod kernel;

pub struct Record { value: i64 }

pub fn read(arena: &Arena<Record>, key: Handle) -> i64 {
    handle get(arena, key) {
        Result::Ok(record) => record.value,
        Result::Err(_) => 0,
    }
}

fn replaced(arena: &Arena<Record>, first: Handle, replacement: Handle, observed: i64) -> i64 {
    let value = read(arena, replacement);
    handle valid(arena, first) {
        Result::Ok(_) => 1,
        Result::Err(StorageError::StaleHandle) => handle value == 99 {
            true => observed,
            false => 2,
        },
        Result::Err(_) => 3,
    }
}

fn exercise(arena: &mut Arena<Record>, first: Handle) -> i64 {
    let second = insert(&mut *arena, Record { value: 17 });
    let observed = read(& *arena, first);
    let removed = remove(&mut *arena, first);
    handle insert(&mut *arena, Record { value: 99 }) {
        Result::Ok(replacement) => replaced(& *arena, first, replacement, observed),
        Result::Err(_) => 4,
    }
}

pub fn main() -> i64 {
    let arena = create<Record>(7);
    handle insert(&mut arena, Record { value: 42 }) {
        Result::Ok(first) => exercise(&mut arena, first),
        Result::Err(_) => 5,
    }
}
