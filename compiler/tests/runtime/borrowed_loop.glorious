use std::*;
pub mod kernel;

pub struct State { count: i64, witness: Vec<i64> }

pub fn advance(state: &mut State, increment: &i64) -> i64 {
    handle state.count == @STEPS@ {
        true => state.count,
        false => {
            (*state).count = state.count + *increment;
            advance(&mut *state, increment)
        },
    }
}

fn checked(state: &State, result: i64) -> i64 {
    handle state.count == result {
        false => -1,
        true => handle Vec::get(&state.witness, 0) {
            Result::Err(_) => -2,
            Result::Ok(value) => handle *value == 42 { false => -3, true => result },
        },
    }
}

pub fn main() -> i64 {
    let witness = Vec::new();
    Vec::push(&mut witness, 42);
    let state = State { count: 0, witness: witness };
    let increment = 1;
    let result = advance(&mut state, &increment);
    checked(&state, result)
}
