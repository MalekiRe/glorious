use std::*;
pub mod kernel;

pub fn walk<'a>(value: &'a mut i64, remaining: i64) -> &'a mut i64 {
    handle remaining == 0 {
        true => move value,
        false => walk(move value, remaining - 1),
    }
}

fn assign(value: &mut i64) -> () { *value = 42; }

pub fn main() -> i64 {
    let value = 0;
    assign(walk(&mut value, 10000));
    value
}
