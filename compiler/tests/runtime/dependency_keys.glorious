use std::*;
use kernel::identity;
use kernel::dependency::node;
use kernel::dependency::node::Node;
pub mod kernel;

fn module(package: Str, path: Str) -> identity::ModuleKey {
    identity::ModuleKey { package: identity::PackageKey { value: Str::to_string(package) }, path: Str::to_string(path) }
}
fn less(a: &Node, b: &Node) -> i64 {
    handle Ord::compare(a, b) { Ordering::Less => 1, _ => 0 }
}
fn variants(digest: identity::Digest) -> Vec<Node> {
    let values = Vec::new();
    Vec::push(&mut values, Node::Input(identity::FileKey { digest: digest }));
    Vec::push(&mut values, Node::Interface(module("p", "m")));
    Vec::push(&mut values, Node::Fixity(module("p", "m")));
    Vec::push(&mut values, Node::Body(identity::DefKey { digest: digest }));
    Vec::push(&mut values, Node::Core(identity::DefKey { digest: digest }));
    Vec::push(&mut values, Node::Instance(instance(digest, b"\x00\x00\x00\x00\x00\x00\x00\x00")));
    Vec::push(&mut values, Node::Mir(identity::DefKey { digest: digest }));
    Vec::push(&mut values, Node::Artifact(identity::PackageKey { value: Str::to_string("p") }));
    values
}
fn ordered(values: &Vec<Node>, cursor: usize) -> i64 {
    handle cursor == Vec::len(values) {
        true => 1,
        false => handle less(Vec::get_unchecked(values, cursor - 1), Vec::get_unchecked(values, cursor)) {
            1 => ordered(values, cursor + 1), _ => 0,
        },
    }
}
fn hashes(values: &Vec<Node>, cursor: usize) -> i64 {
    handle cursor == Vec::len(values) {
        true => 1,
        false => {
            let key = Vec::get_unchecked(values, cursor);
            let copied = Clone::clone(key);
            let a = Hasher::new(); let b = Hasher::new();
            Hash::hash(key, &mut a); Hash::hash(&copied, &mut b);
            handle Hasher::finish(a) == Hasher::finish(b) {
                false => 0, true => handle Eq::eq(key, &copied) { true => hashes(values, cursor + 1), false => 0 },
            }
        },
    }
}
fn edit_text(value: &mut String) -> () {
    String::pop(&mut *value);
    String::push(value, 'x');
}
fn edit_module(value: &mut identity::ModuleKey) -> () {
    edit_text(&mut value.package.value);
    edit_text(&mut value.path);
}
fn edit_instance(value: &mut identity::InstanceKey) -> () {
    handle Vec::get_mut(&mut value.canonical_substitution, 0) {
        Result::Ok(byte) => { *byte = as<u8>(1); },
        Result::Err(_) => (),
    }
}
fn edit_file(value: &mut identity::FileKey, changed: identity::Digest) -> () { (*value).digest = changed; }
fn edit_definition(value: &mut identity::DefKey, changed: identity::Digest) -> () { (*value).digest = changed; }
fn edit_node(value: &mut Node, changed: identity::Digest) -> () {
    handle *value {
        Node::Input(_) => edit_file(&mut value.0, changed),
        Node::Interface(_) => edit_module(&mut value.0),
        Node::Fixity(_) => edit_module(&mut value.0),
        Node::Body(_) => edit_definition(&mut value.0, changed),
        Node::Core(_) => edit_definition(&mut value.0, changed),
        Node::Instance(_) => edit_instance(&mut value.0),
        Node::Mir(_) => edit_definition(&mut value.0, changed),
        Node::Artifact(_) => edit_text(&mut value.0.value),
    }
}
fn hashed(value: &Node) -> usize { let state = Hasher::new(); Hash::hash(value, &mut state); Hasher::finish(state) }
fn independent(values: &Vec<Node>, cursor: usize, changed: identity::Digest) -> i64 {
    handle cursor == Vec::len(values) {
        true => 1,
        false => {
            let original = Vec::get_unchecked(values, cursor);
            let before = hashed(original);
            let copied = Clone::clone(original);
            edit_node(&mut copied, changed);
            handle Eq::eq(original, &copied) {
                true => 0,
                false => handle hashed(original) == before {
                    false => 0, true => independent(values, cursor + 1, changed),
                },
            }
        },
    }
}
fn instance(callable: identity::Digest, substitution: Slice<u8>) -> identity::InstanceKey {
    let bytes = Vec::new();
    Vec::extend_from_slice(&mut bytes, substitution);
    identity::InstanceKey { callable: identity::DefKey { digest: callable }, canonical_substitution: bytes }
}
fn fingerprint(value: &identity::InstanceKey) -> i64 {
    handle identity::decode(b"@INSTANCE_ORACLE@") {
        Result::Err(_) => 0,
        Result::Ok(expected) => handle identity::instance_fingerprint(value, 256) {
            Result::Err(_) => 0,
            Result::Ok(actual) => handle identity::equal(actual, expected) { true => 1, false => 0 },
        },
    }
}
fn instances(a: identity::Digest, b: identity::Digest) -> i64 {
    // One u32 argument: count (u64 LE), kind tag 3, then u32 LE.
    let lower = instance(a, b"\x01\x00\x00\x00\x00\x00\x00\x00\x03\x00\x01\x00\x00");
    let higher = instance(a, b"\x01\x00\x00\x00\x00\x00\x00\x00\x03\x01\x00\x00\x00");
    let other = instance(b, b"\x00\x00\x00\x00\x00\x00\x00\x00");
    let witness = fingerprint(&higher);
    let lower = Node::Instance(lower); let higher = Node::Instance(higher); let other = Node::Instance(other);
    let same_callable = less(&lower, &higher);
    let callable_first = less(&higher, &other);
    handle same_callable + callable_first + witness == 3 { true => 42, false => 5 }
}
fn verify(a: identity::Digest, b: identity::Digest) -> i64 {
    // Canonical byte order is 00 01 ... < 01 00 ..., although LE words are 256 > 1.
    let input_a = Node::Input(identity::FileKey { digest: a }); let input_b = Node::Input(identity::FileKey { digest: b });
    let bytes = less(&input_a, &input_b);
    let package_a = Node::Interface(module("a", "z")); let package_b = Node::Interface(module("b", "a"));
    let packages = less(&package_a, &package_b);
    let path_a = Node::Fixity(module("p", "a")); let path_b = Node::Fixity(module("p", "aa"));
    let paths = less(&path_a, &path_b);
    let values = variants(a);
    let traits = ordered(&values, 1) + hashes(&values, 0) + independent(&values, 0, b);
    handle bytes + packages + paths == 3 { false => 1, true => handle traits == 3 { true => instances(a, b), false => 2 } }
}
pub fn main() -> i64 {
    handle identity::decode(b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00") {
        Result::Err(_) => 3,
        Result::Ok(a) => handle identity::decode(b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00") {
            Result::Err(_) => 4, Result::Ok(b) => verify(a, b),
        },
    }
}
