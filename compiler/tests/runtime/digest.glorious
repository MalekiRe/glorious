use std::*;
pub mod kernel;

pub fn main() -> i64 {
    let digest = blake3(b"abc");
    let cursor = ByteCursor::new();
    handle ByteCursor::u64(&mut cursor, Vec::as_slice(&digest)) {
        Result::Ok(word) => handle word == 3697813978277427044 {
            true => 42,
            false => 1,
        },
        Result::Err(_) => 2,
    }
}
