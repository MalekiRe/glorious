use std::*;

// Scalar identity and declaration order are shared by runtime authority and
// the future term/type layer. These are not runtime conversion opcodes.
pub enum ScalarType { Bool, U8, U16, U32, U64, U128, I8, I16, I32, I64, I128, Usize, Isize, F32, F64, Char, Text, Bytes }
pub fn scalar_order(value: ScalarType) -> usize {
    handle value { ScalarType::Bool => 0, ScalarType::U8 => 1, ScalarType::U16 => 2, ScalarType::U32 => 3, ScalarType::U64 => 4, ScalarType::U128 => 5, ScalarType::I8 => 6, ScalarType::I16 => 7, ScalarType::I32 => 8, ScalarType::I64 => 9, ScalarType::I128 => 10, ScalarType::Usize => 11, ScalarType::Isize => 12, ScalarType::F32 => 13, ScalarType::F64 => 14, ScalarType::Char => 15, ScalarType::Text => 16, ScalarType::Bytes => 17, }
}
pub impl Ord for ScalarType {
    compare(left: &ScalarType, right: &ScalarType) -> Ordering {
        let a = scalar_order(*left); let b = scalar_order(*right); Ord::compare(&a, &b)
    }
}
pub impl Eq for ScalarType {
    eq(left: &ScalarType, right: &ScalarType) -> Bool { scalar_order(*left) == scalar_order(*right) }
}
