set_callable_binding_effect_rest(
    bindings: List<TypeBinding>,
    name: String,
    effectful: Bool,
    index: i64,
    output: List<TypeBinding>,
) -> List<TypeBinding> / {ResultCase, TypeCase} {
    if(index >= core::list_len(bindings)) {
        output
    } else {
        let binding = core::list_get(bindings, index);
        let next = if(binding.name == name) {
            handle perform TypeCase::inspect(binding.value.kind) {
                TypeCase::inspect(SourceType::Callable(result, previous)) =>
                    TypeBinding {
                        name: binding.name,
                        value: TypeRef {
                            kind: SourceType::Callable(
                                result, previous or effectful
                            ),
                            span: binding.value.span,
                        },
                    },
                TypeCase::inspect(_) => binding
            }
        } else {
            binding
        };
        set_callable_binding_effect_rest(
            bindings, name, effectful, index + 1,
            core::list_push(output, next)
        )
    }
}

set_callable_binding_effect(
    bindings: List<TypeBinding>,
    name: String,
    effectful: Bool,
) -> List<TypeBinding> / {ResultCase, TypeCase} {
    if(effectful) {
        set_callable_binding_effect_rest(bindings, name, true, 0, [])
    } else {
        bindings
    }
}

set_type_binding_rest(
    bindings: List<TypeBinding>,
    name: String,
    value: TypeRef,
    index: i64,
    output: List<TypeBinding>,
) -> List<TypeBinding> / {ResultCase} {
    if(index >= core::list_len(bindings)) {
        output
    } else {
        let binding = core::list_get(bindings, index);
        set_type_binding_rest(
            bindings, name, value, index + 1,
            core::list_push(
                output,
                if(binding.name == name) {
                    TypeBinding { name: name, value: value }
                } else {
                    binding
                }
            )
        )
    }
}

set_type_binding(
    bindings: List<TypeBinding>,
    name: String,
    value: TypeRef,
) -> List<TypeBinding> / {ResultCase} {
    set_type_binding_rest(bindings, name, value, 0, [])
}

