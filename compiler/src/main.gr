}

struct OwnershipPlan {
    destroys: List<OwnershipDestroyProjection>,
    releases: List<OwnershipReleaseState>,
}

enum ResumptiveHandlerControlPlan {
    StaticBlock(List<BlockStatement>, SourceSpan),
    RuntimeCall(String, List<Expression>, SourceSpan),
    RuntimeStep(SourceSpan),
}

effect ResumptiveHandlerControlPlanCase {
    inspect(value: ResumptiveHandlerControlPlan) -> !;
}

struct TypedCoreExpression {
    expression: Expression,
    value_type: TypeRef,
    requires_step: Bool,
    place: PlaceProvenance,
}

struct StepCallArguments {
    statements: List<BlockStatement>,
    arguments: List<Expression>,
}

step_call_arguments_value(
    statements: List<BlockStatement>,
    arguments: List<Expression>,
) -> StepCallArguments {
