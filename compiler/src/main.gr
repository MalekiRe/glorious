struct LlvmDefinition {
    key: String,
    text: String,
}

llvm_definition(key: String, definition: String) -> List<LlvmDefinition> {
    [LlvmDefinition { key: key, text: definition }]
}

llvm_definition_is_present(
    definitions: List<LlvmDefinition>,
    key: String,
    index: i64,
) -> Bool / {ResultCase} {
    list_any(definitions, index, { candidate => candidate.key == key })
}

merge_llvm_definitions(
    definitions: List<LlvmDefinition>,
    additions: List<LlvmDefinition>,
    index: i64,
) -> List<LlvmDefinition> / {ResultCase} {
    handle perform ResultCase::inspect(index >= core::list_len(additions)) {
        ResultCase::inspect(Result::Ok(_)) => definitions,
        ResultCase::inspect(Result::Err(_)) => {
            let addition = core::list_get(additions, index);
            let next = handle perform ResultCase::inspect(
                llvm_definition_is_present(definitions, addition.key, 0)
            ) {
                ResultCase::inspect(Result::Ok(_)) => definitions,
                ResultCase::inspect(Result::Err(_)) =>
                    core::list_push(definitions, addition)
            };
            merge_llvm_definitions(next, additions, index + 1)
        }
    }
}

llvm_definitions_text_linear(
    definitions: List<LlvmDefinition>,
    index: i64,
    limit: i64,
    output: String,
) -> String / {ResultCase} {
    if(index >= limit) {
        output
    } else {
        llvm_definitions_text_linear(
            definitions,
            index + 1,
            limit,
            output + optimize_drop_state_cells(
                core::list_get(definitions, index).text, 0
            )
        )
    }
}

llvm_definitions_text_range(
    definitions: List<LlvmDefinition>, from: i64, limit: i64,
) -> String / {ResultCase} {
    if(limit - from <= 4) {
        llvm_definitions_text_linear(definitions, from, limit, "")
    } else {
        let middle = from + (limit - from) / 2;
        llvm_definitions_text_range(definitions, from, middle) +
            llvm_definitions_text_range(definitions, middle, limit)
    }
}

llvm_definitions_text(
    definitions: List<LlvmDefinition>,
    index: i64,
    output: String,
) -> String / {ResultCase} {
    output + llvm_definitions_text_range(
        definitions, index, core::list_len(definitions)
    )
}

optimizer_line_start(text: String, index: i64) -> i64 / {ResultCase} {
    if(index <= 0) {
        0
    } else {
        if(core::str_slice(text, index - 1, index) == "\n") {
            index
        } else {
            optimizer_line_start(text, index - 1)
        }
    }
}

optimizer_spaces_end(text: String, index: i64) -> i64 / {ResultCase} {
    if(index >= core::str_byte_len(text)) {
        index
    } else {
        if(core::str_slice(text, index, index + 1) == " ") {
            optimizer_spaces_end(text, index + 1)
        } else {
            index
        }
    }
}

optimizer_ident_continue_at(text: String, index: i64) -> Bool / {ResultCase} {
    if(index >= core::str_byte_len(text)) {
        false
    } else {
        core::is_ascii_ident_continue(core::str_slice(text, index, index + 1))
    }
}

count_drop_state_name_uses(
    text: String,
    name: String,
    from: i64,
    count: i64,
) -> i64 / {ResultCase} {
    let found = core::str_find(
        core::str_slice(text, from, core::str_byte_len(text)), name
    );
    if(found < 0) {
        count
    } else {
        let after = from + found + core::str_byte_len(name);
        if(optimizer_ident_continue_at(text, after)) {
            count_drop_state_name_uses(text, name, after, count)
        } else {
            count_drop_state_name_uses(text, name, after, count + 1)
        }
    }
}

optimize_drop_state_cells(text: String, from: i64) -> String / {ResultCase} {
    let definition_marker = " = call ptr @grandiose_new_drop_state()\n";
    let found = core::str_find(
        core::str_slice(text, from, core::str_byte_len(text)),
        definition_marker
    );
    if(found < 0) {
        text
    } else {
        let marker_start = from + found;
        let definition_end =
            marker_start + core::str_byte_len(definition_marker);
        let line_start = optimizer_line_start(text, marker_start);
        let name = core::str_slice(
            text, optimizer_spaces_end(text, line_start), marker_start
        );
        optimize_drop_state_cell(text, name, line_start, definition_end)
    }
}

optimize_drop_state_cell(
    text: String,
    name: String,
    line_start: i64,
    definition_end: i64,
) -> String / {ResultCase} {
    let claim_marker =
        " = call i1 @grandiose_claim_drop_state(ptr " + name + ")\n";
    let release_marker =
        "  call void @grandiose_release_drop_state(ptr " + name + ")\n";
    let claim_at = core::str_find(text, claim_marker);
    let release_at = core::str_find(text, release_marker);
    if(
        core::str_find(name, "%") == 0 and { =>
        count_drop_state_name_uses(text, name, 0, 0) == 3 and { =>
        claim_at > definition_end and { =>
        release_at > claim_at + core::str_byte_len(claim_marker) } } }
    ) {
        optimize_drop_state_cells(
            core::str_slice(text, 0, line_start) +
                core::str_slice(text, definition_end, claim_at) +
                " = icmp eq i1 false, false\n" +
                core::str_slice(
                    text,
                    claim_at + core::str_byte_len(claim_marker),
                    release_at
                ) +
                core::str_slice(
                    text,
                    release_at + core::str_byte_len(release_marker),
                    core::str_byte_len(text)
                ),
            line_start
        )
    } else {
        optimize_drop_state_cells(text, definition_end)
    }
}

struct LoweredEffectfulBody {
    definitions: List<LlvmDefinition>,
    instructions: List<MirInstruction>,
    value: String,
    next_temporary: i64,
}

lowered_effectful_body(
    definitions: List<LlvmDefinition>,
    instructions: List<MirInstruction>,
    value: String,
    next_temporary: i64,
) -> LoweredEffectfulBody {
    LoweredEffectfulBody {
        definitions: definitions,
        instructions: instructions,
        value: value,
        next_temporary: next_temporary,
    }
}

struct LoweredRuntimeClauses {
    definitions: List<LlvmDefinition>,
    instructions: String,
    next_temporary: i64,
}

struct OwnershipProjectionStep {
    storage_index: i64,
    result_type: TypeRef,
}

enum OwnershipGuard {
    Always,
    DropState(String),
}

effect OwnershipGuardCase {
    inspect(value: OwnershipGuard) -> !;
}

struct OwnershipDestroyProjection {
    steps: List<OwnershipProjectionStep>,
    value_type: TypeRef,
    guard: OwnershipGuard,
}

struct OwnershipReleaseState {
