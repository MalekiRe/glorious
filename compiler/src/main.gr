enum TokenKind {
    Identifier(String),
    WordOperator(String, i64, Bool, Bool),
    String(String),
    Integer(String),
    LeftParen,
    RightParen,
    LeftBrace,
    RightBrace,
    LeftBracket,
    RightBracket,
    Arrow,
    Plus,
    Minus,
    Star,
    Slash,
    Comma,
    Colon,
    Equal,
    EqualEqual,
    BangEqual,
    FatArrow,
    Bang,
    Ampersand,
    Semicolon,
    Dot,
    DoubleColon,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    End,
}

