    constraints: List<CallableConstraint>,
    name: String,
    index: i64,
) -> CallableConstraintLookup / {ResultCase} {
    if(index >= core::list_len(constraints)) {
        CallableConstraintLookup::Missing
    } else {
        let constraint = core::list_get(constraints, index);
        if(constraint.parameter_name == name) {
            CallableConstraintLookup::Found(constraint)
        } else {
            lookup_callable_constraint(constraints, name, index + 1)
        }
    }
}

lookup_use_constraint(
    constraints: List<UseConstraint>,
    name: String,
    index: i64,
) -> UseIntervalMatch / {ResultCase} {
    if(index >= core::list_len(constraints)) {
        UseIntervalMatch {
            found: false,
            interval: unrestricted_use_interval(),
            span: SourceSpan { start: 0, end: 0 },
        }
    } else {
        let constraint = core::list_get(constraints, index);
        if(constraint.parameter_name == name) {
            UseIntervalMatch {
                found: true,
                interval: ResumptionUseInterval {
                    lower: constraint.lower,
                    upper: constraint.upper,
                },
                span: constraint.span,
            }
        } else {
            lookup_use_constraint(constraints, name, index + 1)
        }
    }
}

validate_use_constraint_bindings(
    source: SourceFile,
    module: Module,
    constraints: List<UseConstraint>,
    bindings: List<TypeBinding>,
    index: i64,
    call_span: SourceSpan,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    TypeBindingLookupCase, Diagnostics
} {
    if(index >= core::list_len(constraints)) {
        ()
    } else {
        let constraint = core::list_get(constraints, index);
        handle perform TypeBindingLookupCase::lookup(
            lookup_type_binding(bindings, constraint.parameter_name, 0)
        ) {
            TypeBindingLookupCase::lookup(TypeBindingLookup::Found(actual)) => {
                let principal = principal_use_interval(
                    source, module, actual, []
                );
                let requested = ResumptionUseInterval {
                    lower: constraint.lower,
                    upper: constraint.upper,
                };
                let intrinsic = constraint.span.start == constraint.span.end and
                    constraint.span.start == core::str_byte_len(source.text);
                require(
                    use_interval_contains(principal, requested),
                    error_diagnostic(
                        source,
                        "GRC1847",
                        "generic `Use` constraint is not satisfied",
                        call_span,
                        "type `" + source_type_name(actual.kind) + "` supports " +
                            use_interval_text(principal) + ", but `" +
                            constraint.parameter_name + "` requires " +
                            use_interval_text(requested),
                        if(intrinsic) {
                            []
                        } else {
                            [DiagnosticLabel {
                                span: constraint.span,
                                message: "the required owned-use evidence is declared here",
                            }]
                        },
                        if(intrinsic) {
                            "the compiler intrinsic `available_to_unit` requires proof that zero use of its environment is legal"
                        } else {
                            "generic `Use<Q>` holds only when Q is contained in the concrete type's principal interval"
                        },
                        "pass a type whose principal interval admits the requested owned-use path"
                    )
                )
            },
            TypeBindingLookupCase::lookup(TypeBindingLookup::Missing) =>
                compiler_error(
                    source,
                    "GRC1848",
                    "cannot resolve generic `Use` evidence",
                    call_span,
                    "type parameter `" + constraint.parameter_name +
                        "` remains unconstrained at this call",
                    [DiagnosticLabel {
                        span: constraint.span,
                        message: "this `Use` requirement originates here",
                    }],
                    "ownership evidence must be concrete before specialization",
                    "pass an argument that determines the constrained type parameter"
                )
        };
        validate_use_constraint_bindings(
            source, module, constraints, bindings, index + 1, call_span
        )
    }
}

validate_use_constraints(
    source: SourceFile,
    constraints: List<UseConstraint>,
    index: i64,
) -> / {ResultCase, Diagnostics} {
    if(index >= core::list_len(constraints)) {
        ()
    } else {
        let constraint = core::list_get(constraints, index);
        require(
            constraint.lower >= 0 and
                (constraint.upper == -1 or constraint.lower <= constraint.upper),
            error_diagnostic(
                source,
                "GRC1845",
                "invalid generic use interval",
                constraint.span,
                "expected `0 <= lower <= upper`",
                [],
                "generic and nominal `Use` evidence obey the same interval algebra",
                "correct the `Use` bounds"
            )
        );
        let duplicate = lookup_use_constraint(
            constraints, constraint.parameter_name, index + 1
        );
        require(
            duplicate.found == false,
            error_diagnostic(
                source,
                "GRC1849",
                "generic `Use` constraint declared more than once",
                duplicate.span,
                "`" + constraint.parameter_name + "` receives another principal-use requirement",
                [DiagnosticLabel {
                    span: constraint.span,
                    message: "the first requirement is here",
                }],
                "one generic parameter has one principal requested interval in this bootstrap solver",
                "remove or combine the duplicate constraint"
            )
        );
        validate_use_constraints(source, constraints, index + 1)
    }
}

has_environment_constraint(
    constraints: List<EnvironmentConstraint>,
    name: String,
    index: i64,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(constraints)) {
        false
    } else {
        if(core::list_get(constraints, index).parameter_name == name) {
            true
        } else {
            has_environment_constraint(constraints, name, index + 1)
        }
    }
}

validate_environment_constraints(
    source: SourceFile,
    constraints: List<EnvironmentConstraint>,
    index: i64,
) -> / {ResultCase, Diagnostics} {
    if(index >= core::list_len(constraints)) {
        ()
    } else {
        let constraint = core::list_get(constraints, index);
        require(
            has_environment_constraint(
                constraints, constraint.parameter_name, index + 1
            ) == false,
            error_diagnostic(
                source,
                "GRC1852",
                "environment constraint declared more than once",
                constraint.span,
                "`" + constraint.parameter_name + "` is already an environment identity",
                [],
                "one generic environment parameter denotes one static ownership state",
                "remove the duplicate `Environment` constraint"
            )
        );
        validate_environment_constraints(source, constraints, index + 1)
    }
}

runs_in_constraint_is_present(
    constraints: List<RunsInConstraint>,
    target: RunsInConstraint,
    index: i64,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(constraints)) {
        false
    } else {
        let candidate = core::list_get(constraints, index);
        if(candidate.callable_parameter_name == target.callable_parameter_name and
            candidate.environment_parameter_name == target.environment_parameter_name and
            candidate.after_parameter_name == target.after_parameter_name) {
            true
        } else {
            runs_in_constraint_is_present(constraints, target, index + 1)
        }
    }
}

validate_runs_in_constraints(
    source: SourceFile,
    callable: CallableDecl,
    index: i64,
) -> / {ResultCase, CallableConstraintLookupCase, Diagnostics} {
    if(index >= core::list_len(callable.runs_in_constraints)) {
        ()
    } else {
        let constraint = core::list_get(callable.runs_in_constraints, index);
        handle perform CallableConstraintLookupCase::lookup(
            lookup_callable_constraint(
                callable.callable_constraints,
                constraint.callable_parameter_name,
                0
            )
        ) {
            CallableConstraintLookupCase::lookup(
                CallableConstraintLookup::Found(_)
            ) => (),
            CallableConstraintLookupCase::lookup(
                CallableConstraintLookup::Missing
            ) => compiler_error(
                source,
                "GRC1853",
                "RunsIn requires callable evidence",
                constraint.callable_parameter_span,
                "`" + constraint.callable_parameter_name +
                    "` has no matching `Fn` constraint",
                [],
                "RunsIn refines the execution environment of an existing callable relation",
                "add an `Fn<(), Output = ...>` constraint for this parameter"
            )
        };
        require(
            has_environment_constraint(
                callable.environment_constraints,
                constraint.environment_parameter_name,
                0
            ),
            error_diagnostic(
                source,
                "GRC1854",
                "RunsIn input is not an environment",
                constraint.environment_parameter_span,
                "`" + constraint.environment_parameter_name +
                    "` lacks an `Environment` constraint",
                [],
                "owned RunsIn transitions begin from a compiler-tracked environment identity",
                "add `" + constraint.environment_parameter_name + ": Environment`"
            )
        );
        require(
            has_environment_constraint(
                callable.environment_constraints,
                constraint.after_parameter_name,
                0
            ),
            error_diagnostic(
                source,
                "GRC1855",
                "RunsIn output is not an environment",
                constraint.after_parameter_span,
                "`" + constraint.after_parameter_name +
                    "` lacks an `Environment` constraint",
                [],
                "normal return from an owned transition produces another environment identity",
                "add `" + constraint.after_parameter_name + ": Environment`"
            )
        );
        require(
            runs_in_constraint_is_present(
                callable.runs_in_constraints, constraint, index + 1
            ) == false,
            error_diagnostic(
                source,
                "GRC1856",
                "RunsIn relation declared more than once",
                constraint.span,
                "this callable/environment/post-environment relation is duplicated",
                [],
                "one relation supplies one coherent environment transition",
                "remove the duplicate RunsIn constraint"
            )
        );
        validate_runs_in_constraints(source, callable, index + 1)
    }
}

environment_parameter_is_incoming(
    constraints: List<RunsInConstraint>,
    name: String,
    index: i64,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(constraints)) {
        false
    } else {
        if(core::list_get(constraints, index).environment_parameter_name == name) {
            true
        } else {
            environment_parameter_is_incoming(constraints, name, index + 1)
        }
    }
}

synthesize_environment_bindings(
    callable: CallableDecl,
    bindings: List<TypeBinding>,
    call_span: SourceSpan,
    index: i64,
) -> List<TypeBinding> / {ResultCase, TypeCase, TypeBindingLookupCase} {
    if(index >= core::list_len(callable.environment_constraints)) {
        bindings
    } else {
        let constraint = core::list_get(callable.environment_constraints, index);
        let fresh = TypeRef {
            kind: SourceType::Environment(
                (if(environment_parameter_is_incoming(
                    callable.runs_in_constraints,
                    constraint.parameter_name,
                    0
                )) {
                    "incoming_"
                } else {
                    "after_"
                }) + callable.name + "_" +
                    core::int_to_string(call_span.start)
            ),
            span: call_span,
        };
        let next = handle perform TypeBindingLookupCase::lookup(
            lookup_type_binding(bindings, constraint.parameter_name, 0)
        ) {
            TypeBindingLookupCase::lookup(TypeBindingLookup::Found(found)) => {
                handle perform TypeCase::inspect(found.kind) {
                    TypeCase::inspect(SourceType::Generic(_)) =>
                        set_type_binding(
                            bindings, constraint.parameter_name, fresh
                        ),
                    TypeCase::inspect(_) => bindings
                }
            },
            TypeBindingLookupCase::lookup(TypeBindingLookup::Missing) =>
                core::list_push(bindings, TypeBinding {
                    name: constraint.parameter_name,
                    value: fresh,
                })
        };
        synthesize_environment_bindings(callable, next, call_span, index + 1)
    }
}

callable_parameter_index_by_type_parameter(
    parameters: List<Parameter>,
    name: String,
    index: i64,
) -> i64 / {ResultCase, TypeCase} {
    if(index >= core::list_len(parameters)) {
        -1
    } else {
        let matches = handle perform TypeCase::inspect(
            core::list_get(parameters, index).parameter_type.kind
        ) {
            TypeCase::inspect(SourceType::Generic(parameter_name)) =>
                parameter_name == name,
            TypeCase::inspect(_) => false
        };
        if(matches) {
            index
        } else {
            callable_parameter_index_by_type_parameter(
                parameters, name, index + 1
            )
        }
    }
}

same_use_interval(
    first: ResumptionUseInterval,
    second: ResumptionUseInterval,
) -> Bool {
    first.lower == second.lower and first.upper == second.upper
}

validate_runs_in_capture_states(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    first: Expression,
    second: Expression,
    first_constraint: RunsInConstraint,
    second_constraint: RunsInConstraint,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase, CallableConstraintLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(lexical_parameters)) {
        ()
    } else {
        let binding = core::list_get(lexical_parameters, index);
        let principal = principal_use_interval(
            source, module, binding.parameter_type, []
        );
        let first_uses = owned_value_uses_expression(
            source, module, first, binding.name
        );
        let second_uses = owned_value_uses_expression(
            source, module, second, binding.name
        );
        require(
            (principal.lower == 0 and principal.upper == -1) or
                same_use_interval(first_uses, second_uses),
            error_diagnostic(
                source,
                "GRC1857",
                "alternative callbacks produce incompatible post-environments",
                expression_span(second),
                "`" + binding.name + "` is used " +
                    use_interval_text(second_uses) + " in `" +
                    second_constraint.callable_parameter_name + "`, but " +
                    use_interval_text(first_uses) + " in `" +
                    first_constraint.callable_parameter_name + "`",
                [DiagnosticLabel {
                    span: expression_span(first),
                    message: "the other callback establishes a different ownership state",
                }, DiagnosticLabel {
                    span: binding.span,
                    message: "this capture has principal interval " +
                        use_interval_text(principal),
                }],
                "callbacks sharing one RunsIn input and one After identity must agree on every ownership-relevant capture after normal return",
                "make both alternatives consume or preserve the capture, or give them distinct After environments"
            )
        );
        validate_runs_in_capture_states(
            source,
            module,
            lexical_parameters,
            first,
            second,
            first_constraint,
            second_constraint,
            index + 1
        )
    }
}

validate_runs_in_constraint_pairs(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    callable: CallableDecl,
    arguments: List<Expression>,
    first_index: i64,
    second_index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase, CallableConstraintLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(first_index >= core::list_len(callable.runs_in_constraints)) {
        ()
    } else {
        if(second_index >= core::list_len(callable.runs_in_constraints)) {
            validate_runs_in_constraint_pairs(
                source, module, lexical_parameters, callable, arguments,
                first_index + 1, first_index + 2
            )
        } else {
            let first_constraint = core::list_get(
                callable.runs_in_constraints, first_index
            );
            let second_constraint = core::list_get(
                callable.runs_in_constraints, second_index
            );
            if(first_constraint.environment_parameter_name ==
                    second_constraint.environment_parameter_name and
                first_constraint.after_parameter_name ==
                    second_constraint.after_parameter_name and
                first_constraint.callable_parameter_name !=
                    second_constraint.callable_parameter_name) {
                let first_argument_index = callable_parameter_index_by_type_parameter(
                    callable.parameters,
                    first_constraint.callable_parameter_name,
                    0
                );
                let second_argument_index = callable_parameter_index_by_type_parameter(
                    callable.parameters,
                    second_constraint.callable_parameter_name,
                    0
                );
                validate_runs_in_capture_states(
                    source,
                    module,
                    lexical_parameters,
                    core::list_get(arguments, first_argument_index),
                    core::list_get(arguments, second_argument_index),
                    first_constraint,
                    second_constraint,
                    0
                )
            } else {
                ()
            };
            validate_runs_in_constraint_pairs(
                source, module, lexical_parameters, callable, arguments,
                first_index, second_index + 1
            )
        }
    }
}

validate_runs_in_post_environments(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    callable: CallableDecl,
    arguments: List<Expression>,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase, CallableConstraintLookupCase,
    BlockStatementCase, Diagnostics
} {
    validate_runs_in_constraint_pairs(
        source, module, lexical_parameters, callable, arguments, 0, 1
    )
}

bind_callable_constraints(
    source: SourceFile,
    module: Module,
    constraints: List<CallableConstraint>,
    index: i64,
    bindings: List<TypeBinding>,
    call_span: SourceSpan,
) -> List<TypeBinding> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    TypeBindingLookupCase, Diagnostics
} {
    if(index >= core::list_len(constraints)) {
        bindings
    } else {
        let constraint = core::list_get(constraints, index);
        let output = resolve_type(
            source,
            module,
            substitute_bindings(constraint.output, bindings)
        );
        bind_callable_constraints(
            source,
            module,
            constraints,
            index + 1,
            unify_types(
                source,
                TypeRef {
                    kind: SourceType::Generic(constraint.parameter_name),
                    span: constraint.parameter_span,
                },
                TypeRef {
                    kind: SourceType::Callable(output, false),
                    span: call_span,
                },
                bindings,
                call_span
            ),
            call_span
        )
    }
}

substitute_bindings_list_seen(
    references: List<TypeRef>,
    bindings: List<TypeBinding>,
    visiting: List<String>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase, TypeCase, TypeBindingLookupCase} {
    if(index >= core::list_len(references)) {
        output
    } else {
        substitute_bindings_list_seen(
            references,
            bindings,
            visiting,
            index + 1,
            core::list_push(
                output,
                substitute_bindings_seen(
                    core::list_get(references, index), bindings, visiting
                )
            )
        )
    }
}

substitute_bindings_list(
    references: List<TypeRef>,
    bindings: List<TypeBinding>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase, TypeCase, TypeBindingLookupCase} {
    substitute_bindings_list_seen(references, bindings, [], index, output)
}

substitute_bindings(
    reference: TypeRef,
    bindings: List<TypeBinding>,
) -> TypeRef / {ResultCase, TypeCase, TypeBindingLookupCase} {
    substitute_bindings_seen(reference, bindings, [])
}

substitute_bindings_seen(
    reference: TypeRef,
    bindings: List<TypeBinding>,
    visiting: List<String>,
) -> TypeRef / {ResultCase, TypeCase, TypeBindingLookupCase} {
    if(core::list_len(bindings) == 0) {
        reference
    } else {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Generic(name)) => {
            if(name_is_present(visiting, name, 0)) {
                reference
            } else {
                handle perform TypeBindingLookupCase::lookup(
                    lookup_type_binding(bindings, name, 0)
                ) {
                    TypeBindingLookupCase::lookup(TypeBindingLookup::Found(value)) => {
                        handle perform TypeCase::inspect(value.kind) {
                            TypeCase::inspect(SourceType::Generic(bound_name)) =>
                                if(bound_name == name) {
                                    value
                                } else {
                                    substitute_bindings_seen(
                                        value, bindings,
                                        core::list_push(visiting, name)
                                    )
                                },
                            TypeCase::inspect(_) => substitute_bindings_seen(
                                value, bindings, core::list_push(visiting, name)
                            )
                        }
                    },
                    TypeBindingLookupCase::lookup(TypeBindingLookup::Missing) => reference
                }
            }
        },
        TypeCase::inspect(SourceType::Callable(output, effectful)) => TypeRef {
            kind: SourceType::Callable(
                substitute_bindings_seen(output, bindings, visiting), effectful
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::List(element)) => TypeRef {
            kind: SourceType::List(substitute_bindings_seen(
                element, bindings, visiting
            )),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Resumption(input, output)) => TypeRef {
            kind: SourceType::Resumption(
                substitute_bindings_seen(input, bindings, visiting),
                substitute_bindings_seen(output, bindings, visiting)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Available(environment)) => TypeRef {
            kind: SourceType::Available(
                substitute_bindings_seen(environment, bindings, visiting)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::SharedReference(target)) => TypeRef {
            kind: SourceType::SharedReference(
                substitute_bindings_seen(target, bindings, visiting)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::UniqueReference(target)) => TypeRef {
            kind: SourceType::UniqueReference(
                substitute_bindings_seen(target, bindings, visiting)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Indirect(storage)) => TypeRef {
            kind: SourceType::Indirect([
                substitute_bindings_seen(
                    indirect_target(storage), bindings, visiting
                )
            ]),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Environment(_)) => reference,
        TypeCase::inspect(SourceType::Applied(name, arguments)) => TypeRef {
            kind: SourceType::Applied(
                name,
                substitute_bindings_list_seen(arguments, bindings, visiting, 0, [])
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Struct(name, arguments)) => TypeRef {
            kind: SourceType::Struct(
                name,
                substitute_bindings_list_seen(arguments, bindings, visiting, 0, [])
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Enum(name, arguments)) => TypeRef {
            kind: SourceType::Enum(
                name,
                substitute_bindings_list_seen(arguments, bindings, visiting, 0, [])
            ),
            span: reference.span,
        },
        TypeCase::inspect(_) => reference
    }
    }
}

remap_generic_name(name: String, prefix: String, reverse: Bool) -> String {
    if(reverse) {
        if(core::str_find(name, prefix) == 0) {
            core::str_slice(
                name, core::str_byte_len(prefix), core::str_byte_len(name)
            )
        } else {
            name
        }
    } else {
        prefix + name
    }
}

remap_type_generics_list(
    references: List<TypeRef>, prefix: String, reverse: Bool,
    index: i64, output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase, TypeCase} {
    if(index >= core::list_len(references)) {
        output
    } else {
        remap_type_generics_list(
            references, prefix, reverse, index + 1,
            core::list_push(output, remap_type_generics(
                core::list_get(references, index), prefix, reverse
            ))
        )
    }
}

remap_type_generics(
    reference: TypeRef, prefix: String, reverse: Bool,
) -> TypeRef / {ResultCase, TypeCase} {
    let kind = handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Generic(name)) => SourceType::Generic(
            remap_generic_name(name, prefix, reverse)
        ),
        TypeCase::inspect(SourceType::List(element)) => SourceType::List(
            remap_type_generics(element, prefix, reverse)
        ),
        TypeCase::inspect(SourceType::Callable(output, effectful)) =>
            SourceType::Callable(
                remap_type_generics(output, prefix, reverse), effectful
            ),
        TypeCase::inspect(SourceType::Resumption(input, output)) =>
            SourceType::Resumption(
                remap_type_generics(input, prefix, reverse),
                remap_type_generics(output, prefix, reverse)
            ),
        TypeCase::inspect(SourceType::Available(environment)) =>
            SourceType::Available(
                remap_type_generics(environment, prefix, reverse)
            ),
        TypeCase::inspect(SourceType::SharedReference(target)) =>
            SourceType::SharedReference(
                remap_type_generics(target, prefix, reverse)
            ),
        TypeCase::inspect(SourceType::UniqueReference(target)) =>
            SourceType::UniqueReference(
                remap_type_generics(target, prefix, reverse)
            ),
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            SourceType::Indirect([
                remap_type_generics(
                    indirect_target(storage), prefix, reverse
                )
            ]),
        TypeCase::inspect(SourceType::Applied(name, arguments)) =>
            SourceType::Applied(name, remap_type_generics_list(
                arguments, prefix, reverse, 0, []
            )),
        TypeCase::inspect(SourceType::Struct(name, arguments)) =>
            SourceType::Struct(name, remap_type_generics_list(
                arguments, prefix, reverse, 0, []
            )),
        TypeCase::inspect(SourceType::Enum(name, arguments)) =>
            SourceType::Enum(name, remap_type_generics_list(
                arguments, prefix, reverse, 0, []
            )),
        TypeCase::inspect(_) => reference.kind
    };
    TypeRef { kind: kind, span: reference.span }
}

substitute_expression_list_bindings(
    expressions: List<Expression>,
    bindings: List<TypeBinding>,
    index: i64,
    output: List<Expression>,
) -> List<Expression> / {
    ResultCase, ExpressionCase, TypeCase, TypeBindingLookupCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        output
    } else {
        substitute_expression_list_bindings(
            expressions, bindings, index + 1,
            core::list_push(
                output,
                substitute_expression_bindings(
                    core::list_get(expressions, index), bindings
                )
            )
        )
    }
}

substitute_named_expression_bindings(
    expressions: List<NamedExpression>,
    bindings: List<TypeBinding>,
    index: i64,
    output: List<NamedExpression>,
) -> List<NamedExpression> / {
    ResultCase, ExpressionCase, TypeCase, TypeBindingLookupCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        output
    } else {
        let expression = core::list_get(expressions, index);
        substitute_named_expression_bindings(
            expressions, bindings, index + 1,
            core::list_push(output, NamedExpression {
                name: expression.name,
                name_span: expression.name_span,
                value: substitute_expression_bindings(
                    expression.value, bindings
                ),
            })
        )
    }
}

substitute_block_bindings(
    statements: List<BlockStatement>,
    bindings: List<TypeBinding>,
    index: i64,
    output: List<BlockStatement>,
) -> List<BlockStatement> / {
    ResultCase, ExpressionCase, TypeCase, TypeBindingLookupCase,
    BlockStatementCase
} {
    if(index >= core::list_len(statements)) {
        output
    } else {
        let statement = handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, name_span, local_type, value, span
            )) => BlockStatement::Let(
                name, name_span,
                substitute_bindings(local_type, bindings),
                substitute_expression_bindings(value, bindings), span
            ),
            BlockStatementCase::inspect(BlockStatement::Value(value)) =>
                BlockStatement::Value(
                    substitute_expression_bindings(value, bindings)
                )
        };
        substitute_block_bindings(
            statements, bindings, index + 1,
            core::list_push(output, statement)
        )
    }
}

substitute_handler_clause_bindings(
    clauses: List<HandlerClause>,
    bindings: List<TypeBinding>,
    index: i64,
    output: List<HandlerClause>,
) -> List<HandlerClause> / {
    ResultCase, ExpressionCase, TypeCase, TypeBindingLookupCase,
    BlockStatementCase
} {
    if(index >= core::list_len(clauses)) {
        output
    } else {
        let clause = core::list_get(clauses, index);
        substitute_handler_clause_bindings(
            clauses, bindings, index + 1,
            core::list_push(output, HandlerClause {
                effect_name: clause.effect_name,
                operation_name: clause.operation_name,
                patterns: clause.patterns,
                resumption_name: clause.resumption_name,
                resumption_span: clause.resumption_span,
                has_resumption: clause.has_resumption,
                body: substitute_expression_bindings(clause.body, bindings),
                span: clause.span,
            })
        )
    }
}

substitute_expression_bindings(
    expression: Expression,
    bindings: List<TypeBinding>,
) -> Expression / {
    ResultCase, ExpressionCase, TypeCase, TypeBindingLookupCase,
    BlockStatementCase
} {
    if(core::list_len(bindings) == 0) {
        expression
    } else {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, span)) =>
            Expression::List(
                substitute_expression_list_bindings(items, bindings, 0, []), span
            ),
        ExpressionCase::expression(Expression::Borrow(value, unique, span)) =>
            Expression::Borrow(
                substitute_expression_bindings(value, bindings), unique, span
            ),
        ExpressionCase::expression(Expression::Dereference(value, span)) =>
            Expression::Dereference(
                substitute_expression_bindings(value, bindings), span
            ),
        ExpressionCase::expression(Expression::Destroy(value, span)) =>
            Expression::Destroy(
                substitute_expression_bindings(value, bindings), span
            ),
        ExpressionCase::expression(Expression::AvailableValue(environment, span)) =>
            Expression::AvailableValue(
                substitute_bindings(environment, bindings), span
            ),
        ExpressionCase::expression(Expression::ConsumeAvailable(available, span)) =>
            Expression::ConsumeAvailable(
                substitute_expression_bindings(available, bindings), span
            ),
        ExpressionCase::expression(Expression::Negate(operand, span)) =>
            Expression::Negate(
                substitute_expression_bindings(operand, bindings), span
            ),
        ExpressionCase::expression(Expression::Binary(
            operator, left, right, span
        )) => Expression::Binary(
            operator,
            substitute_expression_bindings(left, bindings),
            substitute_expression_bindings(right, bindings),
            span
        ),
        ExpressionCase::expression(Expression::Call(name, arguments, span)) =>
            Expression::Call(
                name,
                substitute_expression_list_bindings(
                    arguments, bindings, 0, []
                ),
                span
            ),
        ExpressionCase::expression(Expression::StructValue(
            name, fields, span
        )) => Expression::StructValue(
            name,
            substitute_named_expression_bindings(fields, bindings, 0, []),
            span
        ),
        ExpressionCase::expression(Expression::Field(subject, name, span)) =>
            Expression::Field(
                substitute_expression_bindings(subject, bindings), name, span
            ),
        ExpressionCase::expression(Expression::EnumValue(
            enum_name, variant_name, arguments, span
        )) => Expression::EnumValue(
            enum_name, variant_name,
            substitute_expression_list_bindings(arguments, bindings, 0, []),
            span
        ),
        ExpressionCase::expression(Expression::Block(statements, span)) =>
            Expression::Block(
                substitute_block_bindings(statements, bindings, 0, []), span
            ),
        ExpressionCase::expression(Expression::Perform(
            effect_name, operation_name, arguments, span
        )) => Expression::Perform(
            effect_name, operation_name,
            substitute_expression_list_bindings(arguments, bindings, 0, []),
            span
        ),
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, span
        )) => Expression::Handle(
            substitute_expression_bindings(computation, bindings),
            substitute_handler_clause_bindings(clauses, bindings, 0, []),
            span
        ),
        ExpressionCase::expression(_) => expression
    }
    }
}

name_is_shadowed(names: List<String>, name: String, index: i64) -> Bool / {ResultCase} {
    if(index >= core::list_len(names)) {
        false
    } else {
        if(core::list_get(names, index) == name) {
            true
        } else {
            name_is_shadowed(names, name, index + 1)
        }
    }
}

parameter_names(
    parameters: List<Parameter>, index: i64, output: List<String>,
) -> List<String> / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        parameter_names(
            parameters, index + 1,
            core::list_push(output, core::list_get(parameters, index).name)
        )
    }
}

rewrite_global_expression_list(
    expressions: List<Expression>, globals: List<GlobalDecl>,
    shadowed: List<String>, index: i64, output: List<Expression>,
) -> List<Expression> / {ResultCase, ExpressionCase, GlobalLookupCase, BlockStatementCase} {
    if(index >= core::list_len(expressions)) {
        output
    } else {
        rewrite_global_expression_list(
            expressions, globals, shadowed, index + 1,
            core::list_push(output, rewrite_global_references(
                core::list_get(expressions, index), globals, shadowed
            ))
        )
    }
}

rewrite_global_named_expressions(
    expressions: List<NamedExpression>, globals: List<GlobalDecl>,
    shadowed: List<String>, index: i64, output: List<NamedExpression>,
) -> List<NamedExpression> / {
    ResultCase, ExpressionCase, GlobalLookupCase, BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        output
    } else {
        let found = core::list_get(expressions, index);
        rewrite_global_named_expressions(
            expressions, globals, shadowed, index + 1,
            core::list_push(output, NamedExpression {
                name: found.name,
                name_span: found.name_span,
                value: rewrite_global_references(found.value, globals, shadowed),
            })
        )
    }
}

rewrite_global_block(
    statements: List<BlockStatement>, globals: List<GlobalDecl>,
    shadowed: List<String>, index: i64, output: List<BlockStatement>,
) -> List<BlockStatement> / {
    ResultCase, ExpressionCase, GlobalLookupCase, BlockStatementCase
} {
    if(index >= core::list_len(statements)) {
        output
    } else {
        handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, name_span, local_type, value, span
            )) => rewrite_global_block(
                statements, globals, core::list_push(shadowed, name), index + 1,
                core::list_push(output, BlockStatement::Let(
                    name, name_span, local_type,
                    rewrite_global_references(value, globals, shadowed), span
                ))
            ),
            BlockStatementCase::inspect(BlockStatement::Value(value)) =>
                rewrite_global_block(
                    statements, globals, shadowed, index + 1,
                    core::list_push(output, BlockStatement::Value(
                        rewrite_global_references(value, globals, shadowed)
                    ))
                )
        }
    }
}

rewrite_global_handler_clauses(
    clauses: List<HandlerClause>, globals: List<GlobalDecl>,
    shadowed: List<String>, index: i64, output: List<HandlerClause>,
) -> List<HandlerClause> / {
    ResultCase, ExpressionCase, GlobalLookupCase, BlockStatementCase
} {
    if(index >= core::list_len(clauses)) {
        output
    } else {
        let clause = core::list_get(clauses, index);
        rewrite_global_handler_clauses(
            clauses, globals, shadowed, index + 1,
            core::list_push(output, HandlerClause {
                effect_name: clause.effect_name,
                operation_name: clause.operation_name,
                patterns: clause.patterns,
                resumption_name: clause.resumption_name,
                resumption_span: clause.resumption_span,
                has_resumption: clause.has_resumption,
                body: rewrite_global_references(
                    clause.body, globals,
                    if(clause.has_resumption) {
                        core::list_push(shadowed, clause.resumption_name)
                    } else { shadowed }
                ),
                span: clause.span,
            })
        )
    }
}

rewrite_global_references(
    expression: Expression,
    globals: List<GlobalDecl>,
    shadowed: List<String>,
) -> Expression / {
    ResultCase, ExpressionCase, GlobalLookupCase, BlockStatementCase
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, span)) =>
            Expression::List(
                rewrite_global_expression_list(
                    items, globals, shadowed, 0, []
                ), span
            ),
        ExpressionCase::expression(Expression::Variable(name, span)) => {
            if(name_is_shadowed(shadowed, name, 0)) {
                expression
            } else {
                handle perform GlobalLookupCase::lookup(
                    lookup_global(globals, name, 0)
                ) {
                    GlobalLookupCase::lookup(GlobalLookup::Found(_)) =>
                        Expression::Call(global_callable_name(name), [], span),
                    GlobalLookupCase::lookup(GlobalLookup::Missing) => expression
                }
            }
        },
        ExpressionCase::expression(Expression::Borrow(value, unique, span)) =>
            Expression::Borrow(
                rewrite_global_references(value, globals, shadowed), unique, span
            ),
        ExpressionCase::expression(Expression::Dereference(value, span)) =>
            Expression::Dereference(
                rewrite_global_references(value, globals, shadowed), span
            ),
        ExpressionCase::expression(Expression::Destroy(value, span)) =>
            Expression::Destroy(
                rewrite_global_references(value, globals, shadowed), span
            ),
        ExpressionCase::expression(Expression::ConsumeAvailable(value, span)) =>
            Expression::ConsumeAvailable(
                rewrite_global_references(value, globals, shadowed), span
            ),
        ExpressionCase::expression(Expression::Negate(value, span)) =>
            Expression::Negate(
                rewrite_global_references(value, globals, shadowed), span
            ),
        ExpressionCase::expression(Expression::Binary(operator, left, right, span)) =>
            Expression::Binary(
                operator,
                rewrite_global_references(left, globals, shadowed),
                rewrite_global_references(right, globals, shadowed), span
            ),
        ExpressionCase::expression(Expression::Call(name, arguments, span)) =>
            Expression::Call(
                name,
                rewrite_global_expression_list(
                    arguments, globals, shadowed, 0, []
                ), span
            ),
        ExpressionCase::expression(Expression::StructValue(name, fields, span)) =>
            Expression::StructValue(
                name,
                rewrite_global_named_expressions(
                    fields, globals, shadowed, 0, []
                ), span
            ),
        ExpressionCase::expression(Expression::Field(subject, name, span)) =>
            Expression::Field(
                rewrite_global_references(subject, globals, shadowed), name, span
            ),
        ExpressionCase::expression(Expression::EnumValue(
            enum_name, variant_name, arguments, span
        )) => Expression::EnumValue(
            enum_name, variant_name,
            rewrite_global_expression_list(arguments, globals, shadowed, 0, []),
            span
        ),
        ExpressionCase::expression(Expression::Block(statements, span)) =>
            Expression::Block(
                rewrite_global_block(statements, globals, shadowed, 0, []), span
            ),
        ExpressionCase::expression(Expression::Perform(
            effect_name, operation_name, arguments, span
        )) => Expression::Perform(
            effect_name, operation_name,
            rewrite_global_expression_list(arguments, globals, shadowed, 0, []),
            span
        ),
        ExpressionCase::expression(Expression::Handle(computation, clauses, span)) =>
            Expression::Handle(
                rewrite_global_references(computation, globals, shadowed),
                rewrite_global_handler_clauses(
                    clauses, globals, shadowed, 0, []
                ), span
            ),
        ExpressionCase::expression(_) => expression
    }
}

unify_type_lists(
    source: SourceFile,
    patterns: List<TypeRef>,
    actuals: List<TypeRef>,
    index: i64,
    bindings: List<TypeBinding>,
    context_span: SourceSpan,
) -> List<TypeBinding> / {
    ResultCase, TypeCase, TypeBindingLookupCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        bindings
    } else {
        unify_type_lists(
            source,
            patterns,
            actuals,
            index + 1,
            unify_types(
                source,
                core::list_get(patterns, index),
                core::list_get(actuals, index),
                bindings,
                context_span
            ),
            context_span
        )
    }
}

unify_types(
    source: SourceFile,
    pattern: TypeRef,
    actual: TypeRef,
    bindings: List<TypeBinding>,
    context_span: SourceSpan,
) -> List<TypeBinding> / {
    ResultCase, TypeCase, TypeBindingLookupCase, Diagnostics
} {
    if(pattern.kind == SourceType::Never or actual.kind == SourceType::Never) {
        bindings
    } else {
    handle perform TypeCase::inspect(pattern.kind) {
        TypeCase::inspect(SourceType::Generic(name)) => {
            handle perform TypeBindingLookupCase::lookup(
                lookup_type_binding(bindings, name, 0)
            ) {
                TypeBindingLookupCase::lookup(TypeBindingLookup::Missing) => {
                    let normalized_actual = substitute_bindings(actual, bindings);
                    handle perform TypeCase::inspect(normalized_actual.kind) {
                        TypeCase::inspect(SourceType::Generic(actual_name)) =>
                            if(actual_name == name) {
                                bindings
                            } else {
                                core::list_push(bindings, TypeBinding {
                                    name: name,
                                    value: normalized_actual,
                                })
                            },
                        TypeCase::inspect(_) => core::list_push(
                            bindings,
                            TypeBinding { name: name, value: normalized_actual }
                        )
                    }
                },
                TypeBindingLookupCase::lookup(TypeBindingLookup::Found(previous)) => {
                    let normalized_previous = substitute_bindings(previous, bindings);
                    let normalized_actual = substitute_bindings(actual, bindings);
                    if(same_type(normalized_previous, normalized_actual)) {
                        bindings
                    } else {
                        handle perform TypeCase::inspect(normalized_previous.kind) {
                            TypeCase::inspect(SourceType::Generic(previous_name)) =>
                                if(previous_name == name) {
                                    set_type_binding(
                                        bindings, name, normalized_actual
                                    )
                                } else {
                                    unify_types(
                                        source, normalized_previous,
                                        normalized_actual, bindings, context_span
                                    )
                                },
                            TypeCase::inspect(_) => {
                                handle perform TypeCase::inspect(normalized_actual.kind) {
                                    TypeCase::inspect(SourceType::Generic(_)) => unify_types(
                                        source, normalized_actual,
                                        normalized_previous, bindings, context_span
                                    ),
                                    TypeCase::inspect(_) => {
                                        require(
                                            false,
                                            error_diagnostic(
                                                source,
                                                "GRC1405",
                                                "conflicting generic type inference",
                                                context_span,
                                                "type parameter `" + name +
                                                    "` is inferred as both `" +
                                                    type_name(normalized_previous.kind) +
                                                    "` and `" +
                                                    type_name(normalized_actual.kind) + "`",
                                                [DiagnosticLabel {
                                                    span: pattern.span,
                                                    message: "this generic parameter is used here",
                                                }],
                                                "one generic invocation has one substitution for each type parameter",
                                                "make the result and argument types agree"
                                            )
                                        );
                                        bindings
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        TypeCase::inspect(SourceType::List(pattern_element)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::List(actual_element)) =>
                    unify_types(
                        source, pattern_element, actual_element,
                        bindings, context_span
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC1401", "type mismatch during generic inference",
                    context_span,
                    "expected a list, found `" + type_name(actual.kind) + "`",
                    [], "list element types unify recursively",
                    "pass a `List<T>` value"
                )
            }
        },
        TypeCase::inspect(SourceType::Callable(pattern_output, _)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::Callable(actual_output, _)) => unify_types(
                    source,
                    pattern_output,
                    actual_output,
                    bindings,
                    context_span
                ),
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC1401",
                    "type mismatch during generic inference",
                    context_span,
                    "expected a zero-argument callable value",
                    [],
                    "Fn-constrained parameters receive contextual closure values",
                    "pass a block or callable with the required output type"
                )
            }
        },
        TypeCase::inspect(SourceType::Resumption(pattern_input, pattern_output)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::Resumption(actual_input, actual_output)) =>
                    unify_types(
                        source,
                        pattern_output,
                        actual_output,
                        unify_types(
                            source,
                            pattern_input,
                            actual_input,
                            bindings,
                            context_span
                        ),
                        context_span
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC1401",
                    "type mismatch during generic inference",
                    context_span,
                    "expected a resumption value",
                    [],
                    "resumptions preserve their operation input and handled output types",
                    "use the continuation bound by this handler clause"
                )
            }
        },
        TypeCase::inspect(SourceType::SharedReference(pattern_target)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::SharedReference(actual_target)) =>
                    unify_types(
                        source, pattern_target, actual_target, bindings,
                        context_span
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC1401", "reference mutability mismatch",
                    context_span, "expected a shared reference", [],
                    "shared and unique reference constructors are distinct",
                    "borrow with `&value`"
                )
            }
        },
        TypeCase::inspect(SourceType::UniqueReference(pattern_target)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::UniqueReference(actual_target)) =>
                    unify_types(
                        source, pattern_target, actual_target, bindings,
                        context_span
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC1401", "reference mutability mismatch",
                    context_span, "expected a unique reference", [],
                    "unique references require exclusive borrow evidence",
                    "borrow with `&mut value`"
                )
            }
        },
        TypeCase::inspect(SourceType::Available(pattern_environment)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::Available(actual_environment)) =>
                    unify_types(
                        source,
                        pattern_environment,
                        actual_environment,
                        bindings,
                        context_span
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC1401",
                    "type mismatch during generic inference",
                    context_span,
                    "expected an `Available` environment witness",
                    [],
                    "availability evidence is nominally indexed and cannot be forged from another zero-sized value",
                    "pass the compiler-generated `Available<E>` witness"
                )
            }
        },
        TypeCase::inspect(SourceType::Indirect(pattern_storage)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::Indirect(actual_storage)) =>
                    unify_types(
                        source,
                        indirect_target(pattern_storage),
                        indirect_target(actual_storage),
                        bindings,
                        context_span
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC1401", "indirection mismatch",
                    context_span,
                    "expected an `Indirect` value", [],
                    "owning indirection is part of the source type identity",
                    "use an `Indirect<T>` value"
                )
            }
        },
        TypeCase::inspect(SourceType::Struct(name, pattern_arguments)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::Struct(actual_name, actual_arguments)) => {
                    require(
                        name == actual_name and
                            core::list_len(pattern_arguments) == core::list_len(actual_arguments),
                        error_diagnostic(
                            source,
                            "GRC1401",
                            "type mismatch during generic inference",
                            context_span,
                            "expected `" + type_name(pattern.kind) + "`, found `" +
                                type_name(actual.kind) + "`",
                            [],
                            "nominal generic types unify by constructor and arguments",
                            "make the nominal types agree"
                        )
                    );
                    unify_type_lists(
                        source,
                        pattern_arguments,
                        actual_arguments,
                        0,
                        bindings,
                        context_span
                    )
                },
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC1401",
                    "type mismatch during generic inference",
                    context_span,
                    "expected nominal struct `" + name + "`",
                    [],
                    "generic inference preserves nominal identities",
                    "use a value of the expected struct type"
                )
            }
        },
        TypeCase::inspect(SourceType::Enum(name, pattern_arguments)) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::Enum(actual_name, actual_arguments)) => {
                    require(
                        name == actual_name and
                            core::list_len(pattern_arguments) == core::list_len(actual_arguments),
                        error_diagnostic(
                            source,
                            "GRC1401",
                            "type mismatch during generic inference",
                            context_span,
                            "expected `" + type_name(pattern.kind) + "`, found `" +
                                type_name(actual.kind) + "`",
                            [],
                            "nominal generic types unify by constructor and arguments",
                            "make the nominal types agree"
                        )
                    );
                    unify_type_lists(
                        source,
                        pattern_arguments,
                        actual_arguments,
                        0,
                        bindings,
                        context_span
                    )
                },
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC1401",
                    "type mismatch during generic inference",
                    context_span,
                    "expected nominal enum `" + name + "`",
                    [],
                    "generic inference preserves nominal identities",
                    "use a value of the expected enum type"
                )
            }
        },
        TypeCase::inspect(_) => {
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::Generic(name)) => {
                    handle perform TypeBindingLookupCase::lookup(
                        lookup_type_binding(bindings, name, 0)
                    ) {
                        TypeBindingLookupCase::lookup(TypeBindingLookup::Missing) =>
                            core::list_push(bindings, TypeBinding {
                                name: name,
                                value: pattern,
                            }),
                        TypeBindingLookupCase::lookup(TypeBindingLookup::Found(previous)) => {
                            require(
                                same_type(previous, pattern),
                                error_diagnostic(
                                    source,
                                    "GRC1405",
                                    "conflicting bidirectional generic inference",
                                    context_span,
                                    "type parameter `" + name +
                                        "` receives incompatible constraints",
                                    [],
                                    "expected and argument types constrain one substitution",
                                    "make the nested generic call types agree"
                                )
                            );
                            bindings
                        }
                    }
                },
                TypeCase::inspect(_) => {
                    require(
                        same_type(pattern, actual),
                        error_diagnostic(
                            source,
                            "GRC1401",
                            "type mismatch during generic inference",
                            context_span,
                            "expected `" + type_name(pattern.kind) + "`, found `" +
                                type_name(actual.kind) + "`",
                            [],
                            "concrete types must agree during generic substitution",
                            "make the source types agree"
                        )
                    );
                    bindings
                }
            }
        }
    }
    }
}

type_parameter_argument(
    parameters: List<TypeParameter>,
    arguments: List<TypeRef>,
    name: String,
    index: i64,
    fallback: TypeRef,
) -> TypeRef / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        fallback
    } else {
        if(core::list_get(parameters, index).name == name) {
            core::list_get(arguments, index)
        } else {
            type_parameter_argument(parameters, arguments, name, index + 1, fallback)
        }
    }
}

substitute_types(
    references: List<TypeRef>,
    parameters: List<TypeParameter>,
    arguments: List<TypeRef>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase, TypeCase} {
    if(index >= core::list_len(references)) {
        output
    } else {
        substitute_types(
            references,
            parameters,
            arguments,
            index + 1,
            core::list_push(
                output,
                substitute_type(
                    core::list_get(references, index),
                    parameters,
                    arguments
                )
            )
        )
    }
}

substitute_type(
    reference: TypeRef,
    parameters: List<TypeParameter>,
    arguments: List<TypeRef>,
) -> TypeRef / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Generic(name)) => type_parameter_argument(
            parameters,
            arguments,
            name,
            0,
            reference
        ),
        TypeCase::inspect(SourceType::Callable(output, effectful)) => TypeRef {
            kind: SourceType::Callable(
                substitute_type(output, parameters, arguments), effectful
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::List(element)) => TypeRef {
            kind: SourceType::List(
                substitute_type(element, parameters, arguments)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Resumption(input, output)) => TypeRef {
            kind: SourceType::Resumption(
                substitute_type(input, parameters, arguments),
                substitute_type(output, parameters, arguments)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Available(environment)) => TypeRef {
            kind: SourceType::Available(
                substitute_type(environment, parameters, arguments)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::SharedReference(target)) => TypeRef {
            kind: SourceType::SharedReference(
                substitute_type(target, parameters, arguments)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::UniqueReference(target)) => TypeRef {
            kind: SourceType::UniqueReference(
                substitute_type(target, parameters, arguments)
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Indirect(storage)) => TypeRef {
            kind: SourceType::Indirect([
                substitute_type(
                    indirect_target(storage), parameters, arguments
                )
            ]),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Applied(name, inner)) => TypeRef {
            kind: SourceType::Applied(
                name,
                substitute_types(inner, parameters, arguments, 0, [])
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Struct(name, inner)) => TypeRef {
            kind: SourceType::Struct(
                name,
                substitute_types(inner, parameters, arguments, 0, [])
            ),
            span: reference.span,
        },
        TypeCase::inspect(SourceType::Enum(name, inner)) => TypeRef {
            kind: SourceType::Enum(
                name,
                substitute_types(inner, parameters, arguments, 0, [])
            ),
            span: reference.span,
        },
        TypeCase::inspect(_) => reference
    }
}

resolve_type_arguments(
    source: SourceFile,
    module: Module,
    arguments: List<TypeRef>,
    path: List<String>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        output
    } else {
        let argument = core::list_get(arguments, index);
        resolve_type_arguments(
            source,
            module,
            arguments,
            path,
            index + 1,
            core::list_push(output, TypeRef {
                kind: resolve_type_kind(source, module, argument, path),
                span: argument.span,
            })
        )
    }
}

require_type_arity(
    source: SourceFile,
    name: String,
    declaration_span: SourceSpan,
    parameters: List<TypeParameter>,
    arguments: List<TypeRef>,
    application_span: SourceSpan,
) -> / {ResultCase, Diagnostics} {
    require(
        core::list_len(parameters) == core::list_len(arguments),
        error_diagnostic(
            source,
            "GRC0315",
            "wrong number of type arguments",
            application_span,
            "`" + name + "` expects " +
                core::int_to_string(core::list_len(parameters)) +
                " type argument(s), but receives " +
                core::int_to_string(core::list_len(arguments)),
            [DiagnosticLabel {
                span: declaration_span,
                message: "the generic type is declared here",
            }],
            "generic arity is fixed by the declaration",
            "supply exactly one type argument for each generic parameter"
        )
    )
}

implicit_type_arguments(
    constructor_name: String,
    parameters: List<TypeParameter>,
    span: SourceSpan,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        implicit_type_arguments(
            constructor_name,
            parameters,
            span,
            index + 1,
            core::list_push(output, TypeRef {
                kind: SourceType::Generic(
                    "$implicit@" + constructor_name + "@" +
                        core::int_to_string(span.start) + "@" + parameter.name
                ),
                span: span,
            })
        )
    }
}

resolve_type_kind(
    source: SourceFile,
    module: Module,
    reference: TypeRef,
    path: List<String>,
) -> SourceType / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Inferred) => compiler_error(
            source, "GRC9001", "local inference invariant violated",
            reference.span,
            "an unresolved inferred local type reached semantic validation",
            [],
            "local type elaboration must run before type resolution",
            "report this compiler bug"
        ),
        TypeCase::inspect(SourceType::Unit) => SourceType::Unit,
        TypeCase::inspect(SourceType::Never) => SourceType::Never,
        TypeCase::inspect(SourceType::String) => SourceType::String,
        TypeCase::inspect(SourceType::Str) => SourceType::Str,
        TypeCase::inspect(SourceType::List(element)) => SourceType::List(
            TypeRef {
                kind: resolve_type_kind(source, module, element, path),
                span: element.span,
            }
        ),
        TypeCase::inspect(SourceType::I32) => SourceType::I32,
        TypeCase::inspect(SourceType::I64) => SourceType::I64,
        TypeCase::inspect(SourceType::Struct(name, arguments)) => SourceType::Struct(name, arguments),
        TypeCase::inspect(SourceType::Enum(name, arguments)) => SourceType::Enum(name, arguments),
        TypeCase::inspect(SourceType::Generic(name)) => SourceType::Generic(name),
        TypeCase::inspect(SourceType::Callable(output, effectful)) =>
            SourceType::Callable(TypeRef {
                kind: resolve_type_kind(source, module, output, path),
                span: output.span,
            }, effectful),
        TypeCase::inspect(SourceType::Resumption(input, output)) =>
            SourceType::Resumption(
                TypeRef {
                    kind: resolve_type_kind(source, module, input, path),
                    span: input.span,
                },
                TypeRef {
                    kind: resolve_type_kind(source, module, output, path),
                    span: output.span,
                }
            ),
        TypeCase::inspect(SourceType::Available(environment)) =>
            SourceType::Available(TypeRef {
                kind: resolve_type_kind(source, module, environment, path),
                span: environment.span,
            }),
        TypeCase::inspect(SourceType::SharedReference(target)) =>
            SourceType::SharedReference(TypeRef {
                kind: resolve_type_kind(source, module, target, path),
                span: target.span,
            }),
        TypeCase::inspect(SourceType::UniqueReference(target)) =>
            SourceType::UniqueReference(TypeRef {
                kind: resolve_type_kind(source, module, target, path),
                span: target.span,
            }),
        TypeCase::inspect(SourceType::Indirect(storage)) => {
            let target = indirect_target(storage);
            SourceType::Indirect([TypeRef {
                kind: resolve_type_kind(source, module, target, path),
                span: target.span,
            }])
        },
        TypeCase::inspect(SourceType::Environment(name)) =>
            SourceType::Environment(name),
        TypeCase::inspect(SourceType::Applied(name, arguments)) => {
            let resolved_arguments = resolve_type_arguments(
                source,
                module,
                arguments,
                path,
                0,
                []
            );
            if(name == "Indirect") {
                require(
                    core::list_len(resolved_arguments) == 1,
                    error_diagnostic(
                        source, "GRC0326", "wrong number of `Indirect` arguments",
                        reference.span, "`Indirect` expects one target type", [],
                        "an owning indirection has exactly one pointee type",
                        "write `Indirect<T>`"
                    )
                );
                SourceType::Indirect([core::list_get(resolved_arguments, 0)])
            } else {
            if(name == "List") {
                require(
                    core::list_len(resolved_arguments) == 1,
                    error_diagnostic(
                        source, "GRC0325", "wrong number of `List` arguments",
                        reference.span, "`List` expects one element type", [],
                        "a homogeneous persistent list has one element type",
                        "write `List<T>`"
                    )
                );
                SourceType::List(core::list_get(resolved_arguments, 0))
            } else {
            if(name == "Available") {
                require(
                    core::list_len(resolved_arguments) == 1,
                    error_diagnostic(
                        source,
                        "GRC0319",
                        "wrong number of `Available` arguments",
                        reference.span,
                        "`Available` expects one environment type argument",
                        [],
                        "the intrinsic witness is indexed by exactly one environment identity",
                        "write `Available<E>`"
                    )
                );
                SourceType::Available(core::list_get(resolved_arguments, 0))
            } else {
            handle perform TypeAliasLookupCase::lookup(
                lookup_type_alias(module.type_aliases, name, 0)
            ) {
                TypeAliasLookupCase::lookup(TypeAliasLookup::Found(declaration)) => {
                    require_type_arity(
                        source,
                        name,
                        declaration.name_span,
                        declaration.type_parameters,
                        resolved_arguments,
                        reference.span
                    );
                    resolve_type_kind(
                        source,
                        module,
                        substitute_type(
                            declaration.target,
                            declaration.type_parameters,
                            resolved_arguments
                        ),
                        core::list_push(path, name)
                    )
                },
                TypeAliasLookupCase::lookup(TypeAliasLookup::Missing) => {
                    handle perform StructLookupCase::lookup(
                        lookup_struct(module.structs, name, 0)
                    ) {
                        StructLookupCase::lookup(StructLookup::Found(declaration)) => {
                            require_type_arity(
                                source,
                                name,
                                declaration.name_span,
                                declaration.type_parameters,
                                resolved_arguments,
                                reference.span
                            );
                            SourceType::Struct(name, resolved_arguments)
                        },
                        StructLookupCase::lookup(StructLookup::Missing) => {
                            handle perform EnumLookupCase::lookup(
                                lookup_enum(module.enums, name, 0)
                            ) {
                                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                                    require_type_arity(
                                        source,
                                        name,
                                        declaration.name_span,
                                        declaration.type_parameters,
                                        resolved_arguments,
                                        reference.span
                                    );
                                    SourceType::Enum(name, resolved_arguments)
                                },
                                EnumLookupCase::lookup(EnumLookup::Missing) =>
                                    compiler_error(
                                        source,
                                        "GRC0301",
                                        "unknown generic type",
                                        reference.span,
                                        "`" + name + "` is not a declared type constructor",
                                        [],
                                        "applied types resolve after the complete module is parsed",
                                        "declare a generic struct, enum, or alias, or correct the name"
                                    )
                            }
                        }
                    }
                }
            }
            }
            }
            }
        },
        TypeCase::inspect(SourceType::Named(name)) => {
            require(
                name_is_present(path, name, 0) == false,
                error_diagnostic(
                    source,
                    "GRC0303",
                    "cyclic type alias",
                    reference.span,
                    "resolving `" + name + "` returns to an alias already on this path",
                    [],
                    "type aliases must eventually resolve to a concrete source type",
                    "break the alias cycle by naming `i32`, `i64`, or a non-cyclic type"
                )
            );
            handle perform TypeAliasLookupCase::lookup(
                lookup_type_alias(module.type_aliases, name, 0)
            ) {
                TypeAliasLookupCase::lookup(TypeAliasLookup::Found(declaration)) => {
                    let arguments = implicit_type_arguments(
                        name, declaration.type_parameters, reference.span, 0, []
                    );
                    resolve_type_kind(
                        source,
                        module,
                        substitute_type(
                            declaration.target,
                            declaration.type_parameters,
                            arguments
                        ),
                        core::list_push(path, name)
                    )
                },
                TypeAliasLookupCase::lookup(TypeAliasLookup::Missing) => {
                    handle perform StructLookupCase::lookup(
                        lookup_struct(module.structs, name, 0)
                    ) {
                        StructLookupCase::lookup(StructLookup::Found(declaration)) => {
                            SourceType::Struct(
                                name,
                                implicit_type_arguments(
                                    name, declaration.type_parameters,
                                    reference.span, 0, []
                                )
                            )
                        },
                        StructLookupCase::lookup(StructLookup::Missing) => {
                            handle perform EnumLookupCase::lookup(
                                lookup_enum(module.enums, name, 0)
                            ) {
                                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                                    SourceType::Enum(
                                        name,
                                        implicit_type_arguments(
                                            name, declaration.type_parameters,
                                            reference.span, 0, []
                                        )
                                    )
                                },
                                EnumLookupCase::lookup(EnumLookup::Missing) =>
                                    compiler_error(
                                        source,
                                        "GRC0301",
                                        "unknown type",
                                        reference.span,
                                        "`" + name + "` is not declared as a source type",
                                        [],
                                        "type names resolve after the complete module has been parsed",
                                        "declare a `struct`, `enum`, type alias, or use a known type"
                                    )
                            }
                        }
                    }
                }
            }
        }
    }
}

resolve_type(
    source: SourceFile,
    module: Module,
    reference: TypeRef,
) -> TypeRef / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    TypeRef {
        kind: resolve_type_kind(source, module, reference, []),
        span: reference.span,
    }
}

resolve_parameter(
    source: SourceFile,
    parameters: List<Parameter>,
    name: String,
    span: SourceSpan,
) -> Parameter / {ResultCase, ParameterLookupCase, Diagnostics} {
    handle perform ParameterLookupCase::lookup(lookup_parameter(parameters, name, 0)) {
        ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) => parameter,
        ParameterLookupCase::lookup(ParameterLookup::Missing) => compiler_error(
            source,
            "GRC1304",
            "unknown value",
            span,
            "no parameter named `" + name + "` is in scope",
            [],
            "the bootstrap compiler currently resolves local parameter bindings",
            "declare `" + name + "` as a callable parameter or correct the name"
        )
    }
}

resolve_callable(
    source: SourceFile,
    module: Module,
    name: String,
    span: SourceSpan,
) -> CallableDecl / {ResultCase, LookupCase, Diagnostics} {
    handle perform LookupCase::lookup(lookup_callable(module.callables, name, 0)) {
        LookupCase::lookup(CallableLookup::Found(callable)) => callable,
        LookupCase::lookup(CallableLookup::Missing) => compiler_error(
            source,
            "GRC1301",
            "unknown callable",
            span,
            "no callable named `" + name + "` is declared in this module",
            [],
            "name resolution runs before LLVM symbols are emitted",
            "declare `" + name + "() -> i64 { ... }` or correct the call name"
        )
    }
}

main_callable(
    source: SourceFile,
    module: Module,
) -> CallableDecl / {ResultCase, LookupCase, Diagnostics} {
    handle perform LookupCase::lookup(lookup_callable(module.callables, "main", 0)) {
        LookupCase::lookup(CallableLookup::Found(callable)) => callable,
        LookupCase::lookup(CallableLookup::Missing) => compiler_error(
            source,
            "GRC1302",
            "missing entry callable",
            module.end_span,
            "this module does not declare `main`",
            [],
            "native executable emission requires exactly one entry callable",
            "add `main() -> i64 { 0 }`"
        )
    }
}

validate_entry_signature(
    source: SourceFile,
    module: Module,
    entry: CallableDecl,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let parameter_count = core::list_len(entry.parameters);
    require(
        parameter_count <= 1,
        error_diagnostic(
            source,
            "GRC1306",
            "entry callable accepts too many parameters",
            entry.name_span,
            "`main` may accept either no parameters or one command-line argument list",
            [],
            "the native wrapper converts `argc` and `argv` into one `List<String>`",
            "remove the extra parameters from `main`"
        )
    );
    if(parameter_count == 1) {
        let parameter = core::list_get(entry.parameters, 0);
        let parameter_type = resolve_type(
            source, module, parameter.parameter_type
        );
        handle perform TypeCase::inspect(parameter_type.kind) {
            TypeCase::inspect(SourceType::List(element)) => require(
                element.kind == SourceType::String,
                error_diagnostic(
                    source, "GRC1306", "entry parameter has the wrong type",
                    parameter.span,
                    "the command-line parameter must have type `List<String>`",
                    [],
                    "native `argv` entries become Grandiose strings",
                    "change the parameter type to `List<String>`"
                )
            ),
            TypeCase::inspect(_) => compiler_error(
                source, "GRC1306", "entry parameter has the wrong type",
                parameter.span,
                "the command-line parameter must have type `List<String>`",
                [],
                "the native wrapper converts `argc` and `argv` into a persistent list",
                "change the parameter type to `List<String>`"
            )
        }
    } else {
        ()
    };
    let result_type = resolve_type(source, module, entry.result_type);
    handle perform TypeCase::inspect(result_type.kind) {
        TypeCase::inspect(SourceType::Unit) => (),
        TypeCase::inspect(SourceType::I32) => (),
        TypeCase::inspect(SourceType::I64) => (),
        TypeCase::inspect(_) => compiler_error(
            source,
            "GRC1307",
            "entry callable has an unsupported result type",
            entry.result_type.span,
            "the native wrapper requires `main` to return `()`, `i32`, or `i64`",
            [],
            "aggregate source values have no process exit-code ABI",
            "change the result type of `main` to `()`, `i32`, or `i64`"
        )
    }
}

validate_unique_callables(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {ResultCase, LookupCase, Diagnostics} {
    if(index >= core::list_len(module.callables)) {
        ()
    } else {
            let callable = core::list_get(module.callables, index);
            handle perform LookupCase::lookup(
                lookup_callable(module.callables, callable.name, index + 1)
            ) {
                LookupCase::lookup(CallableLookup::Found(duplicate)) => compiler_error(
                    source,
                    "GRC1303",
                    "callable declared more than once",
                    duplicate.name_span,
                    "`" + callable.name + "` is redeclared here",
                    [DiagnosticLabel {
                        span: callable.name_span,
                        message: "the first declaration is here",
                    }],
                    "LLVM functions require a unique symbol name",
                    "rename or remove one of these declarations"
                ),
                LookupCase::lookup(CallableLookup::Missing) => {
                    validate_unique_callables(source, module, index + 1)
                }
            }
        }
}

validate_type_aliases(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics} {
    if(index >= core::list_len(module.type_aliases)) {
        ()
    } else {
        let declaration = core::list_get(module.type_aliases, index);
        require(
            declaration.name != "Available",
            error_diagnostic(
                source,
                "GRC1851",
                "compiler evidence name is reserved",
                declaration.name_span,
                "`Available` denotes the unforgeable environment witness type",
                [],
                "source declarations cannot replace compiler-owned evidence identities",
                "rename this type alias"
            )
        );
        handle perform TypeAliasLookupCase::lookup(
            lookup_type_alias(module.type_aliases, declaration.name, index + 1)
        ) {
            TypeAliasLookupCase::lookup(TypeAliasLookup::Found(duplicate)) => compiler_error(
                source,
                "GRC0304",
                "type alias declared more than once",
                duplicate.name_span,
                "`" + declaration.name + "` is redeclared here",
                [DiagnosticLabel {
                    span: declaration.name_span,
                    message: "the first alias declaration is here",
                }],
                "type names must resolve to one declaration within a module",
                "rename or remove one of these aliases"
            ),
            TypeAliasLookupCase::lookup(TypeAliasLookup::Missing) => {
                resolve_type(source, module, declaration.target);
                validate_type_aliases(source, module, index + 1)
            }
        }
    }
}

validate_struct_fields(
    source: SourceFile,
    module: Module,
    declaration: StructDecl,
    index: i64,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(declaration.fields)) {
        ()
    } else {
        let field = core::list_get(declaration.fields, index);
        handle perform StructFieldLookupCase::lookup(
            lookup_struct_field(declaration.fields, field.name, index + 1)
        ) {
            StructFieldLookupCase::lookup(StructFieldLookup::Found(duplicate)) => compiler_error(
                source,
                "GRC1504",
                "struct field declared more than once",
                duplicate.name_span,
                "`" + field.name + "` is redeclared here",
                [DiagnosticLabel {
                    span: field.name_span,
                    message: "the first field declaration is here",
                }],
                "nominal struct layouts require unique field names",
                "rename or remove one of these fields"
            ),
            StructFieldLookupCase::lookup(StructFieldLookup::Missing) => {
                resolve_type(source, module, field.field_type);
                validate_struct_fields(source, module, declaration, index + 1)
            }
        }
    }
}

validate_structs(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.structs)) {
        ()
    } else {
        let declaration = core::list_get(module.structs, index);
        require(
            declaration.name != "Available",
            error_diagnostic(
                source,
                "GRC1851",
                "compiler evidence name is reserved",
                declaration.name_span,
                "`Available` denotes the unforgeable environment witness type",
                [],
                "source declarations cannot replace compiler-owned evidence identities",
                "rename this struct"
            )
        );
        handle perform StructLookupCase::lookup(
            lookup_struct(module.structs, declaration.name, index + 1)
        ) {
            StructLookupCase::lookup(StructLookup::Found(duplicate)) => compiler_error(
                source,
                "GRC1505",
                "struct declared more than once",
                duplicate.name_span,
                "`" + declaration.name + "` is redeclared here",
                [DiagnosticLabel {
                    span: declaration.name_span,
                    message: "the first struct declaration is here",
                }],
                "nominal type identities must be unique within a module",
                "rename or remove one of these struct declarations"
            ),
            StructLookupCase::lookup(StructLookup::Missing) => {
                validate_struct_fields(source, module, declaration, 0);
                validate_structs(source, module, index + 1)
            }
        }
    }
}

validate_variant_fields(
    source: SourceFile,
    module: Module,
    fields: List<TypeRef>,
    index: i64,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(fields)) {
        ()
    } else {
        resolve_type(source, module, core::list_get(fields, index));
        validate_variant_fields(source, module, fields, index + 1)
    }
}

validate_variants(
    source: SourceFile,
    module: Module,
    declaration: EnumDecl,
    index: i64,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, Diagnostics
} {
    if(index >= core::list_len(declaration.variants)) {
        ()
    } else {
        let variant = core::list_get(declaration.variants, index);
        handle perform VariantLookupCase::lookup(
            lookup_variant(declaration.variants, variant.name, index + 1)
        ) {
            VariantLookupCase::lookup(VariantLookup::Found(duplicate)) => compiler_error(
                source,
                "GRC1603",
                "enum variant declared more than once",
                duplicate.name_span,
                "`" + variant.name + "` is redeclared here",
                [DiagnosticLabel {
                    span: variant.name_span,
                    message: "the first variant declaration is here",
                }],
                "variant names are unique within their nominal enum",
                "rename or remove one of these variants"
            ),
            VariantLookupCase::lookup(VariantLookup::Missing) => {
                validate_variant_fields(source, module, variant.fields, 0);
                validate_variants(source, module, declaration, index + 1)
            }
        }
    }
}

validate_enums(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, Diagnostics
} {
    if(index >= core::list_len(module.enums)) {
        ()
    } else {
        let declaration = core::list_get(module.enums, index);
        handle perform EnumLookupCase::lookup(
            lookup_enum(module.enums, declaration.name, index + 1)
        ) {
            EnumLookupCase::lookup(EnumLookup::Found(duplicate)) => compiler_error(
                source,
                "GRC1604",
                "enum declared more than once",
                duplicate.name_span,
                "`" + declaration.name + "` is redeclared here",
                [DiagnosticLabel {
                    span: declaration.name_span,
                    message: "the first enum declaration is here",
                }],
                "nominal enum identities must be unique within a module",
                "rename or remove one of these enum declarations"
            ),
            EnumLookupCase::lookup(EnumLookup::Missing) => {
                handle perform StructLookupCase::lookup(
                    lookup_struct(module.structs, declaration.name, 0)
                ) {
                    StructLookupCase::lookup(StructLookup::Found(structure)) =>
                        compiler_error(
                            source,
                            "GRC1605",
                            "nominal type name declared more than once",
                            declaration.name_span,
                            "`" + declaration.name +
                                "` is both a struct and an enum",
                            [DiagnosticLabel {
                                span: structure.name_span,
                                message: "the struct declaration is here",
                            }],
                            "structs and enums share the nominal type namespace",
                            "rename one of these declarations"
                        ),
                    StructLookupCase::lookup(StructLookup::Missing) => {
                        validate_variants(source, module, declaration, 0);
                        validate_enums(source, module, index + 1)
                    }
                }
            }
        }
    }
}

require_type(
    source: SourceFile,
    module: Module,
    found: TypeRef,
    expected: TypeRef,
    expression: SourceSpan,
    context: String,
) -> / {ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics} {
    let resolved_found = resolve_type(source, module, found);
    let resolved_expected = resolve_type(source, module, expected);
    let comparison_expected = handle perform TypeCase::inspect(
        resolved_expected.kind
    ) {
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            indirect_target(storage),
        TypeCase::inspect(_) => resolved_expected
    };
    require(
        resolved_found.kind == SourceType::Never or
            same_type(resolved_found, comparison_expected) or
            string_value_coerces_to_str_reference(
                resolved_found, comparison_expected
            ),
        error_diagnostic(
            source,
            "GRC1401",
            "type mismatch",
            expression,
            context + " has type `" + type_name(resolved_found.kind) +
                "`, but `" + type_name(comparison_expected.kind) + "` is required",
            [DiagnosticLabel {
                span: expected.span,
                message: "the expected type is declared here",
            }],
            "Grandiose does not implicitly narrow or widen integer values",
            "make the source types agree explicitly"
        )
    )
}

string_value_coerces_to_str_reference(
    found: TypeRef,
    expected: TypeRef,
) -> Bool / {TypeCase} {
    if(found.kind == SourceType::String) {
        handle perform TypeCase::inspect(expected.kind) {
            TypeCase::inspect(SourceType::SharedReference(target)) =>
                target.kind == SourceType::Str,
            TypeCase::inspect(_) => false
        }
    } else {
        false
    }
}

require_integer_type(
    source: SourceFile,
    expected: TypeRef,
    span: SourceSpan,
) -> / {TypeCase, Diagnostics} {
    handle perform TypeCase::inspect(expected.kind) {
        TypeCase::inspect(SourceType::I32) => (),
        TypeCase::inspect(SourceType::I64) => (),
        TypeCase::inspect(SourceType::Struct(name, _)) => compiler_error(
            source,
            "GRC1403",
            "operator requires an integer",
            span,
            "this arithmetic expression is being checked as struct `" + name + "`",
            [DiagnosticLabel {
                span: expected.span,
                message: "the nominal result type is required here",
            }],
            "the current arithmetic operators are defined for integer scalar types",
            "use an integer expression or a source-defined operator for this struct"
        ),
        TypeCase::inspect(SourceType::Enum(name, _)) => compiler_error(
            source,
            "GRC1403",
            "operator requires an integer",
            span,
            "this arithmetic expression is being checked as enum `" + name + "`",
            [DiagnosticLabel {
                span: expected.span,
                message: "the nominal result type is required here",
            }],
            "the current arithmetic operators are defined for integer scalar types",
            "use an integer expression or a source-defined operator for this enum"
        ),
        TypeCase::inspect(SourceType::Named(name)) => compiler_error(
            source,
            "GRC9001",
            "type resolution invariant violated",
            span,
            "unresolved type `" + name + "` reached arithmetic validation",
            [],
            "named types must resolve before operator checking",
            "report this compiler bug"
        ),
        TypeCase::inspect(_) => compiler_error(
            source,
            "GRC1403",
            "operator requires an integer",
            span,
            "this arithmetic expression has type `" +
                type_name(expected.kind) + "`",
            [DiagnosticLabel {
                span: expected.span,
                message: "this non-integer type is required here",
            }],
            "subtraction, multiplication, and division are defined only for integer scalar types",
            "use an integer expression"
        )
    }
}

validate_declared_struct_fields(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    declaration: StructDecl,
    type_arguments: List<TypeRef>,
    supplied: List<NamedExpression>,
    index: i64,
    construction_span: SourceSpan,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase,
    TypeAliasLookupCase, StructLookupCase, NamedExpressionLookupCase, Diagnostics
} {
    if(index >= core::list_len(declaration.fields)) {
        ()
    } else {
        let field = core::list_get(declaration.fields, index);
        handle perform NamedExpressionLookupCase::lookup(
            lookup_named_expression(supplied, field.name, 0)
        ) {
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Found(value)) => {
                validate_expression(
                    source,
                    module,
                    parameters,
                    core::list_get(
                        substitute_types(
                            [field.field_type], declaration.type_parameters,
                            type_arguments, 0, []
                        ),
                        0
                    ),
                    value.value
                );
                validate_declared_struct_fields(
                    source,
                    module,
                    parameters,
                    declaration,
                    type_arguments,
                    supplied,
                    index + 1,
                    construction_span
                )
            },
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Missing) => compiler_error(
                source,
                "GRC1501",
                "missing struct field",
                construction_span,
                "construction of `" + declaration.name + "` omits field `" + field.name + "`",
                [DiagnosticLabel {
                    span: field.name_span,
                    message: "the required field is declared here",
                }],
                "nominal construction must initialize every declared field exactly once",
                "add `" + field.name + ": <expression>` to this value"
            )
        }
    }
}

validate_supplied_struct_fields(
    source: SourceFile,
    declaration: StructDecl,
    supplied: List<NamedExpression>,
    index: i64,
) -> / {
    ResultCase, StructFieldLookupCase, NamedExpressionLookupCase, Diagnostics
} {
    if(index >= core::list_len(supplied)) {
        ()
    } else {
        let field = core::list_get(supplied, index);
        handle perform StructFieldLookupCase::lookup(
            lookup_struct_field(declaration.fields, field.name, 0)
        ) {
            StructFieldLookupCase::lookup(StructFieldLookup::Found(_)) => {
                handle perform NamedExpressionLookupCase::lookup(
                    lookup_named_expression(supplied, field.name, index + 1)
                ) {
                    NamedExpressionLookupCase::lookup(NamedExpressionLookup::Found(duplicate)) =>
                        compiler_error(
                            source,
                            "GRC1502",
                            "struct field initialized more than once",
                            duplicate.name_span,
                            "`" + field.name + "` is initialized again here",
                            [DiagnosticLabel {
                                span: field.name_span,
                                message: "the first initializer is here",
                            }],
                            "each nominal field has one storage location",
                            "remove one of these field initializers"
                        ),
                    NamedExpressionLookupCase::lookup(NamedExpressionLookup::Missing) =>
                        validate_supplied_struct_fields(
                            source,
                            declaration,
                            supplied,
                            index + 1
                        )
                }
            },
            StructFieldLookupCase::lookup(StructFieldLookup::Missing) => compiler_error(
                source,
                "GRC1503",
                "unknown struct field",
                field.name_span,
                "`" + declaration.name + "` has no field named `" + field.name + "`",
                [DiagnosticLabel {
                    span: declaration.name_span,
                    message: "the struct is declared here",
                }],
                "field names are resolved nominally, not by layout",
                "remove the field or use one declared by `" + declaration.name + "`"
            )
        }
    }
}

validate_variant_arguments(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    fields: List<TypeRef>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        ()
    } else {
        validate_expression(
            source,
            module,
            parameters,
            core::list_get(fields, index),
            core::list_get(arguments, index)
        );
        validate_variant_arguments(
            source,
            module,
            parameters,
            arguments,
            fields,
            index + 1
        )
    }
}

expected_enum_arguments(
    source: SourceFile,
    expected: TypeRef,
    enum_name: String,
    span: SourceSpan,
) -> List<TypeRef> / {ResultCase, TypeCase, Diagnostics} {
    handle perform TypeCase::inspect(expected.kind) {
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            expected_enum_arguments(
                source, indirect_target(storage), enum_name, span
            ),
        TypeCase::inspect(SourceType::Enum(name, arguments)) => {
            require(
                name == enum_name,
                error_diagnostic(
                    source,
                    "GRC1401",
                    "type mismatch",
                    span,
                    "constructor `" + enum_name + "` cannot produce expected enum `" +
                        name + "`",
                    [DiagnosticLabel {
                        span: expected.span,
                        message: "this enum type is required here",
                    }],
                    "enum construction preserves nominal identity",
                    "use a variant belonging to `" + name + "`"
                )
            );
            arguments
        },
        TypeCase::inspect(_) => compiler_error(
            source,
            "GRC1401",
            "type mismatch",
            span,
            "enum constructor `" + enum_name + "` is used where `" +
                type_name(expected.kind) + "` is required",
            [DiagnosticLabel {
                span: expected.span,
                message: "the expected type originates here",
            }],
            "variant construction produces its nominal enum type",
            "change the expected type or use a matching expression"
        )
    }
}

infer_block_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
) -> TypeRef / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, BlockStatementCase, Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name,
            name_span,
            local_type,
            _,
            _
        )) => infer_block_type(
            source,
            module,
            core::list_push(parameters, Parameter {
                name: name,
                span: name_span,
                parameter_type: local_type,
                is_local: true,
                drop_flag: "",
                llvm_name: "%local_" + name,
            }),
            statements,
            index + 1
        ),
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            if(index + 1 >= core::list_len(statements)) {
                infer_expression_type(source, module, parameters, value)
            } else {
                infer_block_type(source, module, parameters, statements, index + 1)
            }
        }
    }
}

validate_block(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
    expected: TypeRef,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, BlockStatementCase, Diagnostics
} {
    validate_block_with_constraints(
        source, module, parameters, [], statements, index, expected
    )
}

validate_block_with_constraints(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    use_constraints: List<UseConstraint>,
    statements: List<BlockStatement>,
    index: i64,
    expected: TypeRef,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, BlockStatementCase, Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name,
            name_span,
            local_type,
            value,
            span
        )) => {
            handle perform ParameterLookupCase::lookup(
                lookup_parameter(parameters, name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(original)) =>
                    compiler_error(
                        source,
                        "GRC1701",
                        "local binding declared more than once",
                        name_span,
                        "`" + name + "` is already in lexical scope",
                        [DiagnosticLabel {
                            span: original.span,
                            message: "the previous binding is here",
                        }],
                        "this bootstrap scope keeps one SSA identity per source name",
                        "rename this local binding"
                    ),
                ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                    validate_expression_with_constraints(
                        source, module, parameters, use_constraints,
                        local_type, value
                    );
                    validate_block_with_constraints(
                        source,
                        module,
                        core::list_push(parameters, Parameter {
                            name: name,
                            span: name_span,
                            parameter_type: local_type,
                            is_local: true,
                            drop_flag: "",
                            llvm_name: "%local_" + name,
                        }),
                        use_constraints,
                        statements,
                        index + 1,
                        expected
                    )
                }
            }
        },
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            if(index + 1 >= core::list_len(statements)) {
                validate_expression_with_constraints(
                    source, module, parameters, use_constraints, expected, value
                )
            } else {
                let value_type = infer_expression_type(source, module, parameters, value);
                validate_expression_with_constraints(
                    source, module, parameters, use_constraints,
                    value_type, value
                );
                validate_block_with_constraints(
                    source,
                    module,
                    parameters,
                    use_constraints,
                    statements,
                    index + 1,
                    expected
                )
            }
        }
    }
}

first_inferred_type(
    first: TypeInference,
    second: TypeInference,
) -> TypeInference / {TypeInferenceCase} {
    handle perform TypeInferenceCase::inspect(first) {
        TypeInferenceCase::inspect(TypeInference::Found(value)) =>
            TypeInference::Found(value),
        TypeInferenceCase::inspect(TypeInference::Missing) => second
    }
}

try_infer_integer_expression_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
) -> TypeInference / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, BlockStatementCase,
    TypeInferenceCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Variable(_, _)) => TypeInference::Found(
            infer_expression_type(source, module, parameters, expression)
        ),
        ExpressionCase::expression(Expression::Call(_, _, _)) => TypeInference::Found(
            infer_expression_type(source, module, parameters, expression)
        ),
        ExpressionCase::expression(Expression::Field(_, _, _)) => TypeInference::Found(
            infer_expression_type(source, module, parameters, expression)
        ),
        ExpressionCase::expression(Expression::Block(_, _)) => TypeInference::Found(
            infer_expression_type(source, module, parameters, expression)
        ),
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            try_infer_integer_expression_type(source, module, parameters, operand),
        ExpressionCase::expression(Expression::Binary(operator, left, right, _)) => {
            if(operator_is_comparison(operator)) {
                TypeInference::Missing
            } else {
                first_inferred_type(
                    try_infer_integer_expression_type(
                        source, module, parameters, left
                    ),
                    try_infer_integer_expression_type(
                        source, module, parameters, right
                    )
                )
            }
        },
        ExpressionCase::expression(_) => TypeInference::Missing
    }
}

comparison_operand_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    left: Expression,
    right: Expression,
    span: SourceSpan,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, BlockStatementCase,
    TypeInferenceCase, Diagnostics
} {
    handle perform TypeInferenceCase::inspect(
        first_inferred_type(
            try_infer_integer_expression_type(source, module, parameters, left),
            try_infer_integer_expression_type(source, module, parameters, right)
        )
    ) {
        TypeInferenceCase::inspect(TypeInference::Found(reference)) => {
            let resolved = resolve_type(source, module, reference);
            require_integer_type(source, resolved, span);
            resolved
        },
        TypeInferenceCase::inspect(TypeInference::Missing) => compiler_error(
            source,
            "GRC1407",
            "comparison operands need an integer type",
            span,
            "neither operand determines whether this comparison uses `i32` or `i64`",
            [],
            "integer literals receive their source type from surrounding context",
            "compare a typed value or bind one operand to an annotated integer local"
        )
    }
}

equality_operand_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    left: Expression,
    right: Expression,
    span: SourceSpan,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, BlockStatementCase,
    TypeInferenceCase, Diagnostics
} {
    handle perform TypeInferenceCase::inspect(
        first_inferred_type(
            try_infer_standalone_type(source, module, parameters, left),
            try_infer_standalone_type(source, module, parameters, right)
        )
    ) {
        TypeInferenceCase::inspect(TypeInference::Found(reference)) =>
            resolve_type(source, module, reference),
        TypeInferenceCase::inspect(TypeInference::Missing) => compiler_error(
            source,
            "GRC1408",
            "equality operands need a type",
            span,
            "neither operand determines the value type compared by this operator",
            [],
            "equality is structural but still requires one concrete operand type",
            "add a type annotation or compare against a typed value"
        )
    }
}

comparison_expression_operand_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    operator: BinaryOperator,
    left: Expression,
    right: Expression,
    span: SourceSpan,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, BlockStatementCase,
    TypeInferenceCase, Diagnostics
} {
    if(operator_is_equality(operator)) {
        equality_operand_type(
            source, module, parameters, left, right, span
        )
    } else {
        comparison_operand_type(
            source, module, parameters, left, right, span
        )
    }
}

arithmetic_operand_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    operator: BinaryOperator,
    left: Expression,
    right: Expression,
    span: SourceSpan,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, BlockStatementCase,
    TypeInferenceCase, Diagnostics
} {
    handle perform TypeInferenceCase::inspect(
        first_inferred_type(
            try_infer_integer_expression_type(source, module, parameters, left),
            try_infer_integer_expression_type(source, module, parameters, right)
        )
    ) {
        TypeInferenceCase::inspect(TypeInference::Found(reference)) => {
            let resolved = resolve_type(source, module, reference);
            handle perform TypeCase::inspect(resolved.kind) {
                TypeCase::inspect(SourceType::String) => {
                    require(
                        operator_is_add(operator),
                        error_diagnostic(
                            source, "GRC1403", "operator requires an integer",
                            span,
                            "only `+` is defined for `String` operands", [],
                            "string addition concatenates its operands",
                            "use `+` or change both operands to integers"
                        )
                    );
                    resolved
                },
                TypeCase::inspect(_) => {
                    require_integer_type(source, resolved, span);
                    resolved
                }
            }
        },
        TypeInferenceCase::inspect(TypeInference::Missing) => compiler_error(
            source,
            "GRC1404",
            "arithmetic expression type needs context",
            span,
            "neither operand determines whether this arithmetic uses `i32` or `i64`",
            [],
            "integer literals receive their width from a typed operand or surrounding context",
            "add an integer annotation or use a typed value in the expression"
        )
    }
}

infer_operation_argument_bindings(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    arguments: List<Expression>,
    operation_parameters: List<Parameter>,
    index: i64,
    bindings: List<TypeBinding>,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, TypeBindingLookupCase, BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        bindings
    } else {
        let argument = core::list_get(arguments, index);
        let declared = resolve_type(
            source,
            module,
            core::list_get(operation_parameters, index).parameter_type
        );
        let next_bindings = if(type_has_generic(declared)) {
            let actual = infer_expression_type(
                source, module, lexical_parameters, argument
            );
            unify_types(
                source,
                declared,
                actual,
                bindings,
                expression_span(argument)
            )
        } else {
            bindings
        };
        infer_operation_argument_bindings(
            source,
            module,
            lexical_parameters,
            arguments,
            operation_parameters,
            index + 1,
            next_bindings
        )
    }
}

resolve_parameter_types(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        resolve_parameter_types(
            source,
            module,
            parameters,
            index + 1,
            core::list_push(output, Parameter {
                name: parameter.name,
                span: parameter.span,
                parameter_type: resolve_type(
                    source, module, parameter.parameter_type
                ),
                is_local: parameter.is_local,
                drop_flag: parameter.drop_flag,
                llvm_name: parameter.llvm_name,
            })
        )
    }
}

validate_operation_arguments(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    arguments: List<Expression>,
    operation_parameters: List<Parameter>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        ()
    } else {
        validate_expression(
            source,
            module,
            lexical_parameters,
            core::list_get(operation_parameters, index).parameter_type,
            core::list_get(arguments, index)
        );
        validate_operation_arguments(
            source,
            module,
            lexical_parameters,
            arguments,
            operation_parameters,
            index + 1
        )
    }
}

resolve_perform_operation(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    effect_name: String,
    operation_name: String,
    arguments: List<Expression>,
    span: SourceSpan,
) -> ResolvedEffectOperation / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    handle perform EffectLookupCase::lookup(
        lookup_effect(module.effects, effect_name, 0)
    ) {
        EffectLookupCase::lookup(EffectLookup::Missing) => compiler_error(
            source,
            "GRC1800",
            "unknown effect",
            span,
            "effect `" + effect_name + "` is not declared in this module",
            [],
            "performed operations resolve through nominal effect declarations",
            "declare the effect or correct its name"
        ),
        EffectLookupCase::lookup(EffectLookup::Found(effect)) => {
            handle perform EffectOperationLookupCase::lookup(
                lookup_effect_operation(effect.operations, operation_name, 0)
            ) {
                EffectOperationLookupCase::lookup(EffectOperationLookup::Missing) =>
                    compiler_error(
                        source,
                        "GRC1801",
                        "unknown effect operation",
                        span,
                        "effect `" + effect_name + "` has no operation named `" +
                            operation_name + "`",
                        [DiagnosticLabel {
                            span: effect.name_span,
                            message: "the effect is declared here",
                        }],
                        "operation names are resolved within their nominal effect",
                        "use an operation declared by `" + effect_name + "`"
                    ),
                EffectOperationLookupCase::lookup(EffectOperationLookup::Found(operation)) => {
                    require(
                        core::list_len(arguments) == core::list_len(operation.parameters),
                        error_diagnostic(
                            source,
                            "GRC1802",
                            "wrong number of effect arguments",
                            span,
                            "operation `" + effect_name + "::" + operation_name +
                                "` expects " +
                                core::int_to_string(core::list_len(operation.parameters)) +
                                " argument(s), but receives " +
                                core::int_to_string(core::list_len(arguments)),
                            [DiagnosticLabel {
                                span: operation.name_span,
                                message: "the operation is declared here",
                            }],
                            "operation arity is fixed by its declaration",
                            "supply exactly one value for each operation parameter"
                        )
                    );
                    let resolved_parameters = resolve_parameter_types(
                        source, module, operation.parameters, 0, []
                    );
                    let bindings = infer_operation_argument_bindings(
                        source,
                        module,
                        lexical_parameters,
                        arguments,
                        resolved_parameters,
                        0,
                        []
                    );
                    let parameters = specialize_parameters(
                        resolved_parameters,
                        bindings,
                        0,
                        []
                    );
                    validate_operation_arguments(
                        source,
                        module,
                        lexical_parameters,
                        arguments,
                        parameters,
                        0
                    );
                    ResolvedEffectOperation {
                        effect: effect,
                        operation: operation,
                        bindings: bindings,
                        parameters: parameters,
                    }
                }
            }
        }
    }
}

validate_pattern_list(
    source: SourceFile,
    module: Module,
    patterns: List<Pattern>,
    expected: List<TypeRef>,
    index: i64,
    parameters: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, ParameterLookupCase, PatternCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        parameters
    } else {
        validate_pattern_list(
            source,
            module,
            patterns,
            expected,
            index + 1,
            validate_pattern(
                source,
                module,
                core::list_get(patterns, index),
                core::list_get(expected, index),
                parameters
            )
        )
    }
}

validate_pattern(
    source: SourceFile,
    module: Module,
    pattern: Pattern,
    expected: TypeRef,
    parameters: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, ParameterLookupCase, PatternCase, Diagnostics
} {
    let resolved_expected = resolve_type(source, module, expected);
    let expected = handle perform TypeCase::inspect(resolved_expected.kind) {
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            indirect_target(storage),
        TypeCase::inspect(_) => resolved_expected
    };
    handle perform PatternCase::inspect(pattern) {
        PatternCase::inspect(Pattern::Wildcard(_)) => parameters,
        PatternCase::inspect(Pattern::Binding(name, span)) => {
            handle perform ParameterLookupCase::lookup(
                lookup_parameter(parameters, name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(previous)) =>
                    compiler_error(
                        source,
                        "GRC1805",
                        "pattern binding shadows an existing value",
                        span,
                        "`" + name + "` is already available in this lexical scope",
                        [DiagnosticLabel {
                            span: previous.span,
                            message: "the existing binding is here",
                        }],
                        "pattern payloads receive distinct SSA identities",
                        "rename this pattern binding"
                    ),
                ParameterLookupCase::lookup(ParameterLookup::Missing) =>
                    core::list_push(parameters, Parameter {
                        name: name,
                        span: span,
                        parameter_type: expected,
                        is_local: true,
                        drop_flag: "",
                        llvm_name: "%pattern_" + name + "_" +
                            core::int_to_string(span.start),
                    })
            }
        },
        PatternCase::inspect(Pattern::Unit(span)) => {
            require(
                expected.kind == SourceType::Unit,
                error_diagnostic(
                    source,
                    "GRC1806",
                    "unit pattern has the wrong type",
                    span,
                    "unit pattern `()` cannot match `" + type_name(expected.kind) + "`",
                    [DiagnosticLabel {
                        span: expected.span,
                        message: "this operation argument type is required",
                    }],
                    "literal patterns match values of the same source type",
                    "use a pattern compatible with the operation parameter"
                )
            );
            parameters
        },
        PatternCase::inspect(Pattern::Integer(_, span)) => {
            require_integer_type(source, expected, span);
            parameters
        },
        PatternCase::inspect(Pattern::String(_, span)) => {
            require(
                expected.kind == SourceType::String,
                error_diagnostic(
                    source, "GRC1814", "string pattern has the wrong type", span,
                    "a string literal pattern cannot match `" +
                        source_type_name(expected.kind) + "`", [],
                    "literal patterns match values of the same source type",
                    "use this pattern with a `String` operation argument"
                )
            );
            parameters
        },
        PatternCase::inspect(Pattern::Variant(
            enum_name,
            variant_name,
            fields,
            span
        )) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Enum(actual_name, arguments)) => {
                    require(
                        actual_name == enum_name,
                        error_diagnostic(
                            source,
                            "GRC1807",
                            "pattern uses the wrong enum",
                            span,
                            "pattern enum `" + enum_name + "` cannot match `" +
                                actual_name + "`",
                            [DiagnosticLabel {
                                span: expected.span,
                                message: "the operation argument has this enum type",
                            }],
                            "variant patterns preserve nominal enum identity",
                            "use a variant belonging to `" + actual_name + "`"
                        )
                    );
                    handle perform EnumLookupCase::lookup(
                        lookup_enum(module.enums, actual_name, 0)
                    ) {
                        EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                            handle perform VariantLookupCase::lookup(
                                lookup_variant(declaration.variants, variant_name, 0)
                            ) {
                                VariantLookupCase::lookup(VariantLookup::Missing) =>
                                    compiler_error(
                                        source,
                                        "GRC1808",
                                        "unknown pattern variant",
                                        span,
                                        "enum `" + actual_name + "` has no variant `" +
                                            variant_name + "`",
                                        [DiagnosticLabel {
                                            span: declaration.name_span,
                                            message: "the enum is declared here",
                                        }],
                                        "patterns resolve variants nominally",
                                        "use a declared variant"
                                    ),
                                VariantLookupCase::lookup(VariantLookup::Found(variant)) => {
                                    require(
                                        core::list_len(fields) ==
                                            core::list_len(variant.fields),
                                        error_diagnostic(
                                            source,
                                            "GRC1809",
                                            "wrong number of payload patterns",
                                            span,
                                            "variant `" + actual_name + "::" +
                                                variant_name + "` has " +
                                                core::int_to_string(
                                                    core::list_len(variant.fields)
                                                ) + " payload(s), but this pattern has " +
                                                core::int_to_string(core::list_len(fields)),
                                            [DiagnosticLabel {
                                                span: variant.name_span,
                                                message: "the variant is declared here",
                                            }],
                                            "each payload position requires one pattern",
                                            "add or remove payload patterns"
                                        )
                                    );
                                    validate_pattern_list(
                                        source,
                                        module,
                                        fields,
                                        substitute_types(
                                            variant.fields,
                                            declaration.type_parameters,
                                            arguments,
                                            0,
                                            []
                                        ),
                                        0,
                                        parameters
                                    )
                                }
                            }
                        },
                        EnumLookupCase::lookup(EnumLookup::Missing) => parameters
                    }
                },
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC1807",
                    "variant pattern requires an enum",
                    span,
                    "this operation argument has type `" + type_name(expected.kind) + "`",
                    [],
                    "variant patterns eliminate nominal enum values",
                    "use a literal or binding pattern for this type"
                )
            }
        }
    }
}

operation_parameter_types(
    parameters: List<Parameter>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        operation_parameter_types(
            parameters,
            index + 1,
            core::list_push(output, core::list_get(parameters, index).parameter_type)
        )
    }
}

add_resumption_uses(
    first: ResumptionUseInterval,
    second: ResumptionUseInterval,
) -> ResumptionUseInterval {
    ResumptionUseInterval {
        lower: first.lower + second.lower,
        upper: if(first.upper == -1 or second.upper == -1) {
            -1
        } else {
            first.upper + second.upper
        },
    }
}

join_resumption_uses(
    first: ResumptionUseInterval,
    second: ResumptionUseInterval,
) -> ResumptionUseInterval {
    ResumptionUseInterval {
        lower: if(first.lower < second.lower) { first.lower } else { second.lower },
        upper: if(first.upper == -1 or second.upper == -1) {
            -1
        } else {
            if(first.upper > second.upper) { first.upper } else { second.upper }
        },
    }
}

multiply_resumption_uses(
    first: ResumptionUseInterval,
    second: ResumptionUseInterval,
) -> ResumptionUseInterval {
    ResumptionUseInterval {
        lower: first.lower * second.lower,
        upper: if(first.upper == 0 or second.upper == 0) {
            0
        } else {
            if(first.upper == -1 or second.upper == -1) {
                -1
            } else {
                first.upper * second.upper
            }
        },
    }
}

lookup_callback_use(
    bindings: List<CallbackUseBinding>,
    name: String,
    index: i64,
) -> CallbackUseLookup / {ResultCase} {
    if(index >= core::list_len(bindings)) {
        CallbackUseLookup {
            found: false,
            uses: ResumptionUseInterval { lower: 0, upper: 0 },
        }
    } else {
        let binding = core::list_get(bindings, index);
        if(binding.name == name) {
            CallbackUseLookup { found: true, uses: binding.uses }
        } else {
            lookup_callback_use(bindings, name, index + 1)
        }
    }
}

parameter_has_callable_constraint(
    callable: CallableDecl,
    parameter: Parameter,
) -> Bool / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(parameter.parameter_type.kind) {
        TypeCase::inspect(SourceType::Generic(name)) => {
            handle perform CallableConstraintLookupCase::lookup(
                lookup_callable_constraint(
                    callable.callable_constraints, name, 0
                )
            ) {
                CallableConstraintLookupCase::lookup(
                    CallableConstraintLookup::Found(_)
                ) => true,
                CallableConstraintLookupCase::lookup(
                    CallableConstraintLookup::Missing
                ) => false
            }
        },
        TypeCase::inspect(_) => false
    }
}

callable_constraint_parameter_count(
    callable: CallableDecl,
    index: i64,
    count: i64,
) -> i64 / {ResultCase, TypeCase} {
    if(index >= core::list_len(callable.parameters)) {
        count
    } else {
        callable_constraint_parameter_count(
            callable,
            index + 1,
            count + (if(parameter_has_callable_constraint(
                callable, core::list_get(callable.parameters, index)
            )) { 1 } else { 0 })
        )
    }
}

substituted_callback_uses_expressions(
    module: Module,
    expressions: List<Expression>,
    bindings: List<CallbackUseBinding>,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        uses
    } else {
        substituted_callback_uses_expressions(
            module, expressions, bindings, index + 1,
            add_resumption_uses(
                uses,
                substituted_callback_uses_expression(
                    module, core::list_get(expressions, index), bindings
                )
            )
        )
    }
}

substituted_callback_uses_named_expressions(
    module: Module,
    expressions: List<NamedExpression>,
    bindings: List<CallbackUseBinding>,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        uses
    } else {
        substituted_callback_uses_named_expressions(
            module, expressions, bindings, index + 1,
            add_resumption_uses(
                uses,
                substituted_callback_uses_expression(
                    module, core::list_get(expressions, index).value, bindings
                )
            )
        )
    }
}

substituted_callback_uses_block(
    module: Module,
    statements: List<BlockStatement>,
    bindings: List<CallbackUseBinding>,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, BlockStatementCase
} {
    if(index >= core::list_len(statements)) {
        uses
    } else {
        let expression = handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                _, _, _, value, _
            )) => value,
            BlockStatementCase::inspect(BlockStatement::Value(value)) => value
        };
        substituted_callback_uses_block(
            module, statements, bindings, index + 1,
            add_resumption_uses(
                uses,
                substituted_callback_uses_expression(
                    module, expression, bindings
                )
            )
        )
    }
}

substituted_callback_uses_clauses(
    module: Module,
    clauses: List<HandlerClause>,
    bindings: List<CallbackUseBinding>,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, BlockStatementCase
} {
    if(index >= core::list_len(clauses)) {
        uses
    } else {
        let found = substituted_callback_uses_expression(
            module, core::list_get(clauses, index).body, bindings
        );
        substituted_callback_uses_clauses(
            module, clauses, bindings, index + 1,
            if(index == 0) { found } else {
                join_resumption_uses(uses, found)
            }
        )
    }
}

substituted_callback_uses_expression(
    module: Module,
    expression: Expression,
    bindings: List<CallbackUseBinding>,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, BlockStatementCase
} {
    let zero = ResumptionUseInterval { lower: 0, upper: 0 };
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            substituted_callback_uses_expression(module, operand, bindings),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            add_resumption_uses(
                substituted_callback_uses_expression(module, left, bindings),
                substituted_callback_uses_expression(module, right, bindings)
            ),
        ExpressionCase::expression(Expression::Call(name, arguments, _)) => {
            let found = lookup_callback_use(bindings, name, 0);
            add_resumption_uses(
                if(found.found) { found.uses } else { zero },
                substituted_callback_uses_expressions(
                    module, arguments, bindings, 0, zero
                )
            )
        },
        ExpressionCase::expression(Expression::StructValue(_, fields, _)) =>
            substituted_callback_uses_named_expressions(
                module, fields, bindings, 0, zero
            ),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            substituted_callback_uses_expression(module, subject, bindings),
        ExpressionCase::expression(Expression::EnumValue(_, _, arguments, _)) =>
            substituted_callback_uses_expressions(
                module, arguments, bindings, 0, zero
            ),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            substituted_callback_uses_block(
                module, statements, bindings, 0, zero
            ),
        ExpressionCase::expression(Expression::Perform(_, _, arguments, _)) =>
            substituted_callback_uses_expressions(
                module, arguments, bindings, 0, zero
            ),
        ExpressionCase::expression(Expression::Handle(computation, clauses, _)) =>
            add_resumption_uses(
                substituted_callback_uses_expression(
                    module, computation, bindings
                ),
                substituted_callback_uses_clauses(
                    module, clauses, bindings, 0, zero
                )
            ),
        ExpressionCase::expression(_) => zero
    }
}

collect_joint_callback_uses(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    arguments: List<Expression>,
    name: String,
    index: i64,
    bindings: List<CallbackUseBinding>,
    eager: ResumptionUseInterval,
) -> JointCallbackUses / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(arguments)) {
        JointCallbackUses { bindings: bindings, eager: eager }
    } else {
        let direct = resumption_uses_expression(
            source, module, core::list_get(arguments, index), name
        );
        if(index < core::list_len(callable.parameters) and
            parameter_has_callable_constraint(
                callable, core::list_get(callable.parameters, index)
            )) {
            collect_joint_callback_uses(
                source, module, callable, arguments, name, index + 1,
                core::list_push(bindings, CallbackUseBinding {
                    name: core::list_get(callable.parameters, index).name,
                    uses: direct,
                }),
                eager
            )
        } else {
            collect_joint_callback_uses(
                source, module, callable, arguments, name, index + 1,
                bindings, add_resumption_uses(eager, direct)
            )
        }
    }
}

joint_callback_call_uses(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    arguments: List<Expression>,
    name: String,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    let collected = collect_joint_callback_uses(
        source, module, callable, arguments, name, 0, [],
        ResumptionUseInterval { lower: 0, upper: 0 }
    );
    add_resumption_uses(
        collected.eager,
        substituted_callback_uses_expression(
            module, callable.body, collected.bindings
        )
    )
}

callable_parameter_uses_expressions(
    module: Module,
    expressions: List<Expression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
    visiting: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        uses
    } else {
        callable_parameter_uses_expressions(
            module,
            expressions,
            name,
            index + 1,
            add_resumption_uses(
                uses,
                callable_parameter_uses_expression(
                    module, core::list_get(expressions, index), name, visiting
                )
            ),
            visiting
        )
    }
}

callable_parameter_uses_block(
    module: Module,
    statements: List<BlockStatement>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
    visiting: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(statements)) {
        uses
    } else {
        let expression = handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                _, _, _, value, _
            )) => value,
            BlockStatementCase::inspect(BlockStatement::Value(value)) => value
        };
        callable_parameter_uses_block(
            module, statements, name, index + 1,
            add_resumption_uses(
                uses,
                callable_parameter_uses_expression(
                    module, expression, name, visiting
                )
            ),
            visiting
        )
    }
}

callable_parameter_uses_clauses(
    module: Module,
    clauses: List<HandlerClause>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
    visiting: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(clauses)) {
        uses
    } else {
        let found = callable_parameter_uses_expression(
            module, core::list_get(clauses, index).body, name, visiting
        );
        callable_parameter_uses_clauses(
            module,
            clauses,
            name,
            index + 1,
            if(index == 0) { found } else {
                join_resumption_uses(uses, found)
            },
            visiting
        )
    }
}

callable_parameter_uses_named_expressions(
    module: Module,
    expressions: List<NamedExpression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
    visiting: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        uses
    } else {
        callable_parameter_uses_named_expressions(
            module,
            expressions,
            name,
            index + 1,
            add_resumption_uses(
                uses,
                callable_parameter_uses_expression(
                    module, core::list_get(expressions, index).value,
                    name, visiting
                )
            ),
            visiting
        )
    }
}

callable_parameter_invocation_uses(
    module: Module,
    callable: CallableDecl,
    parameter_name: String,
    visiting: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(name_is_present(visiting, callable.name, 0)) {
        ResumptionUseInterval { lower: 0, upper: -1 }
    } else {
        callable_parameter_uses_expression(
            module, callable.body, parameter_name,
            core::list_push(visiting, callable.name)
        )
    }
}

callable_parameter_uses_call_arguments(
    module: Module,
    callable: CallableDecl,
    arguments: List<Expression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
    visiting: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(arguments)) {
        uses
    } else {
        let argument = core::list_get(arguments, index);
        let direct = callable_parameter_uses_expression(
            module, argument, name, visiting
        );
        let composed = if(index >= core::list_len(callable.parameters)) {
            direct
        } else {
            let parameter = core::list_get(callable.parameters, index);
            handle perform TypeCase::inspect(parameter.parameter_type.kind) {
                TypeCase::inspect(SourceType::Generic(type_name)) => {
                    handle perform CallableConstraintLookupCase::lookup(
                        lookup_callable_constraint(
                            callable.callable_constraints, type_name, 0
                        )
                    ) {
                        CallableConstraintLookupCase::lookup(
                            CallableConstraintLookup::Found(_)
                        ) => {
                            let forwarded = handle perform ExpressionCase::expression(
                                argument
                            ) {
                                ExpressionCase::expression(Expression::Variable(
                                    value, _
                                )) => if(value == name) {
                                    ResumptionUseInterval { lower: 1, upper: 1 }
                                } else {
                                    direct
                                },
                                ExpressionCase::expression(_) => direct
                            };
                            multiply_resumption_uses(
                                forwarded,
                                callable_parameter_invocation_uses(
                                    module, callable, parameter.name, visiting
                                )
                            )
                        },
                        CallableConstraintLookupCase::lookup(
                            CallableConstraintLookup::Missing
                        ) => direct
                    }
                },
                TypeCase::inspect(_) => direct
            }
        };
        callable_parameter_uses_call_arguments(
            module, callable, arguments, name, index + 1,
            add_resumption_uses(uses, composed), visiting
        )
    }
}

callable_parameter_uses_expression(
    module: Module,
    expression: Expression,
    name: String,
    visiting: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    let zero = ResumptionUseInterval { lower: 0, upper: 0 };
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            callable_parameter_uses_expression(
                module, operand, name, visiting
            ),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            add_resumption_uses(
                callable_parameter_uses_expression(
                    module, left, name, visiting
                ),
                callable_parameter_uses_expression(
                    module, right, name, visiting
                )
            ),
        ExpressionCase::expression(Expression::Call(call_name, arguments, _)) => {
            let argument_uses = handle perform LookupCase::lookup(
                lookup_callable(module.callables, call_name, 0)
            ) {
                LookupCase::lookup(CallableLookup::Found(callable)) =>
                    callable_parameter_uses_call_arguments(
                        module, callable, arguments, name, 0, zero, visiting
                    ),
                LookupCase::lookup(CallableLookup::Missing) =>
                    callable_parameter_uses_expressions(
                        module, arguments, name, 0, zero, visiting
                    )
            };
            add_resumption_uses(
                if(call_name == name) {
                    ResumptionUseInterval { lower: 1, upper: 1 }
                } else {
                    zero
                },
                argument_uses
            )
        },
        ExpressionCase::expression(Expression::StructValue(_, fields, _)) =>
            callable_parameter_uses_named_expressions(
                module, fields, name, 0, zero, visiting
            ),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            callable_parameter_uses_expression(
                module, subject, name, visiting
            ),
        ExpressionCase::expression(Expression::EnumValue(_, _, arguments, _)) =>
            callable_parameter_uses_expressions(
                module, arguments, name, 0, zero, visiting
            ),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            callable_parameter_uses_block(
                module, statements, name, 0, zero, visiting
            ),
        ExpressionCase::expression(Expression::Perform(_, _, arguments, _)) =>
            callable_parameter_uses_expressions(
                module, arguments, name, 0, zero, visiting
            ),
        ExpressionCase::expression(Expression::Handle(computation, clauses, _)) =>
            add_resumption_uses(
                callable_parameter_uses_expression(
                    module, computation, name, visiting
                ),
                callable_parameter_uses_clauses(
                    module, clauses, name, 0, zero, visiting
                )
            ),
        ExpressionCase::expression(_) => zero
    }
}

resumption_uses_expressions(
    source: SourceFile,
    module: Module,
    expressions: List<Expression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        uses
    } else {
        resumption_uses_expressions(
            source,
            module,
            expressions,
            name,
            index + 1,
            add_resumption_uses(
                uses,
                resumption_uses_expression(
                    source, module, core::list_get(expressions, index), name
                )
            )
        )
    }
}

resumption_uses_named_expressions(
    source: SourceFile,
    module: Module,
    expressions: List<NamedExpression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        uses
    } else {
        resumption_uses_named_expressions(
            source,
            module,
            expressions,
            name,
            index + 1,
            add_resumption_uses(
                uses,
                resumption_uses_expression(
                    source,
                    module,
                    core::list_get(expressions, index).value,
                    name
                )
            )
        )
    }
}

resumption_uses_block(
    source: SourceFile,
    module: Module,
    statements: List<BlockStatement>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(statements)) {
        uses
    } else {
        let statement = core::list_get(statements, index);
        let expression = handle perform BlockStatementCase::inspect(statement) {
            BlockStatementCase::inspect(BlockStatement::Let(_, _, _, value, _)) => value,
            BlockStatementCase::inspect(BlockStatement::Value(value)) => value
        };
        resumption_uses_block(
            source,
            module,
            statements,
            name,
            index + 1,
            add_resumption_uses(
                uses,
                resumption_uses_expression(source, module, expression, name)
            )
        )
    }
}

resumption_uses_clauses(
    source: SourceFile,
    module: Module,
    clauses: List<HandlerClause>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(clauses)) {
        uses
    } else {
        let found = resumption_uses_expression(
            source, module, core::list_get(clauses, index).body, name
        );
        resumption_uses_clauses(
            source,
            module,
            clauses,
            name,
            index + 1,
            if(index == 0) { found } else {
                join_resumption_uses(uses, found)
            }
        )
    }
}

resumption_uses_call_arguments(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    arguments: List<Expression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(arguments)) {
        uses
    } else {
        let direct = resumption_uses_expression(
            source, module, core::list_get(arguments, index), name
        );
        let composed = if(index >= core::list_len(callable.parameters)) {
            direct
        } else {
            let parameter = core::list_get(callable.parameters, index);
            handle perform TypeCase::inspect(parameter.parameter_type.kind) {
                TypeCase::inspect(SourceType::Generic(type_name)) => {
                    handle perform CallableConstraintLookupCase::lookup(
                        lookup_callable_constraint(
                            callable.callable_constraints, type_name, 0
                        )
                    ) {
                        CallableConstraintLookupCase::lookup(
                            CallableConstraintLookup::Found(_)
                        ) => multiply_resumption_uses(
                            direct,
                            callable_parameter_invocation_uses(
                                module, callable, parameter.name, []
                            )
                        ),
                        CallableConstraintLookupCase::lookup(
                            CallableConstraintLookup::Missing
                        ) => direct
                    }
                },
                TypeCase::inspect(_) => direct
            }
        };
        resumption_uses_call_arguments(
            source, module, callable, arguments, name, index + 1,
            add_resumption_uses(uses, composed)
        )
    }
}

resumption_uses_expression(
    source: SourceFile,
    module: Module,
    expression: Expression,
    name: String,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    let zero = ResumptionUseInterval { lower: 0, upper: 0 };
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            resumption_uses_expression(source, module, operand, name),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            add_resumption_uses(
                resumption_uses_expression(source, module, left, name),
                resumption_uses_expression(source, module, right, name)
            ),
        ExpressionCase::expression(Expression::Call(call_name, arguments, _)) => {
            let argument_uses = if(call_name == "resume" or
                call_name == "cancel") {
                resumption_uses_expressions(
                    source, module, arguments, name, 0, zero
                )
            } else {
                handle perform LookupCase::lookup(
                    lookup_callable(module.callables, call_name, 0)
                ) {
                    LookupCase::lookup(CallableLookup::Found(callable)) =>
                        if(callable_constraint_parameter_count(
                            callable, 0, 0
                        ) > 1) {
                            joint_callback_call_uses(
                                source, module, callable, arguments, name
                            )
                        } else {
                            resumption_uses_call_arguments(
                                source, module, callable, arguments, name, 0, zero
                            )
                        },
                    LookupCase::lookup(CallableLookup::Missing) =>
                        resumption_uses_expressions(
                            source, module, arguments, name, 0, zero
                        )
                }
            };
            if(call_name == "resume") {
                handle perform ExpressionCase::expression(core::list_get(arguments, 0)) {
                    ExpressionCase::expression(Expression::Variable(value, _)) => {
                        if(value == name) {
                            add_resumption_uses(
                                ResumptionUseInterval { lower: 1, upper: 1 },
                                argument_uses
                            )
                        } else {
                            argument_uses
                        }
                    },
                    ExpressionCase::expression(_) => argument_uses
                }
            } else {
                argument_uses
            }
        },
        ExpressionCase::expression(Expression::StructValue(_, fields, _)) =>
            resumption_uses_named_expressions(
                source, module, fields, name, 0, zero
            ),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            resumption_uses_expression(source, module, subject, name),
        ExpressionCase::expression(Expression::EnumValue(_, _, arguments, _)) =>
            resumption_uses_expressions(
                source, module, arguments, name, 0, zero
            ),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            resumption_uses_block(
                source, module, statements, name, 0, zero
            ),
        ExpressionCase::expression(Expression::Perform(_, _, arguments, _)) =>
            resumption_uses_expressions(
                source, module, arguments, name, 0, zero
            ),
        ExpressionCase::expression(Expression::Handle(computation, clauses, _)) =>
            add_resumption_uses(
                resumption_uses_expression(
                    source, module, computation, name
                ),
                resumption_uses_clauses(
                    source, module, clauses, name, 0, zero
                )
            ),
        ExpressionCase::expression(_) => zero
    }
}

validate_owned_pattern_list(
    source: SourceFile,
    module: Module,
    patterns: List<Pattern>,
    expected: List<TypeRef>,
    body: Expression,
    use_constraints: List<UseConstraint>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase, VariantLookupCase, PatternCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        ()
    } else {
        validate_owned_pattern(
            source,
            module,
            core::list_get(patterns, index),
            core::list_get(expected, index),
            body,
            use_constraints
        );
        validate_owned_pattern_list(
            source, module, patterns, expected, body, use_constraints, index + 1
        )
    }
}

pattern_list_binds_restricted_value(
    source: SourceFile,
    module: Module,
    patterns: List<Pattern>,
    expected: List<TypeRef>,
    index: i64,
) -> Bool / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, PatternCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        false
    } else {
        pattern_binds_restricted_value(
            source, module, core::list_get(patterns, index),
            core::list_get(expected, index)
        ) or pattern_list_binds_restricted_value(
            source, module, patterns, expected, index + 1
        )
    }
}

pattern_binds_restricted_value(
    source: SourceFile,
    module: Module,
    pattern: Pattern,
    expected: TypeRef,
) -> Bool / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, PatternCase, Diagnostics
} {
    let resolved = resolve_type(source, module, expected);
    handle perform PatternCase::inspect(pattern) {
        PatternCase::inspect(Pattern::Binding(_, _)) =>
            principal_use_interval(source, module, resolved, []).upper != -1,
        PatternCase::inspect(Pattern::Variant(
            enum_name, variant_name, fields, _
        )) => handle perform TypeCase::inspect(resolved.kind) {
            TypeCase::inspect(SourceType::Enum(name, arguments)) =>
                handle perform EnumLookupCase::lookup(
                    lookup_enum(module.enums, name, 0)
                ) {
                    EnumLookupCase::lookup(EnumLookup::Found(declaration)) =>
                        handle perform VariantLookupCase::lookup(
                            lookup_variant(
                                declaration.variants, variant_name, 0
                            )
                        ) {
                            VariantLookupCase::lookup(
                                VariantLookup::Found(variant)
                            ) => pattern_list_binds_restricted_value(
                                source,
                                module,
                                fields,
                                substitute_types(
                                    variant.fields,
                                    declaration.type_parameters,
                                    arguments,
                                    0,
                                    []
                                ),
                                0
                            ),
                            VariantLookupCase::lookup(
                                VariantLookup::Missing
                            ) => false
                        },
                    EnumLookupCase::lookup(EnumLookup::Missing) => false
                },
            TypeCase::inspect(_) => false
        },
        PatternCase::inspect(_) => false
    }
}

validate_owned_pattern(
    source: SourceFile,
    module: Module,
    pattern: Pattern,
    expected: TypeRef,
    body: Expression,
    use_constraints: List<UseConstraint>,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase, VariantLookupCase, PatternCase,
    BlockStatementCase, Diagnostics
} {
    handle perform PatternCase::inspect(pattern) {
        PatternCase::inspect(Pattern::Wildcard(span)) =>
            validate_owned_binding_with_constraints(
                source,
                module,
                "_",
                span,
                expected,
                ResumptionUseInterval { lower: 0, upper: 0 },
                use_constraints
            ),
        PatternCase::inspect(Pattern::Binding(name, span)) =>
            validate_owned_binding_with_constraints(
                source,
                module,
                name,
                span,
                expected,
                owned_value_uses_expression(source, module, body, name),
                use_constraints
            ),
        PatternCase::inspect(Pattern::Variant(
            enum_name, variant_name, fields, span
        )) => {
            let resolved = resolve_type(source, module, expected);
            handle perform TypeCase::inspect(resolved.kind) {
                TypeCase::inspect(SourceType::Enum(name, arguments)) =>
                    handle perform EnumLookupCase::lookup(
                        lookup_enum(module.enums, name, 0)
                    ) {
                        EnumLookupCase::lookup(EnumLookup::Found(declaration)) =>
                            handle perform VariantLookupCase::lookup(
                                lookup_variant(
                                    declaration.variants, variant_name, 0
                                )
                            ) {
                                VariantLookupCase::lookup(
                                    VariantLookup::Found(variant)
                                ) => {
                                    let field_types = substitute_types(
                                        variant.fields,
                                        declaration.type_parameters,
                                        arguments,
                                        0,
                                        []
                                    );
                                    require(
                                        drop_is_present(
                                            source, module, resolved, 0
                                        ) == false or
                                        pattern_list_binds_restricted_value(
                                            source, module, fields,
                                            field_types, 0
                                        ) == false,
                                        error_diagnostic(
                                            source,
                                            "GRC1870",
                                            "cannot partially move from a `Drop` type",
                                            span,
                                            "this variant pattern binds a restricted payload from `" +
                                                source_type_name(resolved.kind) + "`",
                                            [DiagnosticLabel {
                                                span: resolved.span,
                                                message: "this value has a custom `Drop` hook",
                                            }],
                                            "the hook must observe a fully initialized value before structural destruction",
                                            "bind the complete value or borrow its payload instead"
                                        )
                                    );
                                    validate_owned_pattern_list(
                                        source, module, fields, field_types,
                                        body, use_constraints, 0
                                    )
                                },
                                VariantLookupCase::lookup(
                                    VariantLookup::Missing
                                ) => ()
                            },
                        EnumLookupCase::lookup(EnumLookup::Missing) => ()
                    },
                TypeCase::inspect(_) => ()
            }
        },
        PatternCase::inspect(_) => ()
    }
}

validate_handler_clauses(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    use_constraints: List<UseConstraint>,
    resolved: ResolvedEffectOperation,
    clauses: List<HandlerClause>,
    index: i64,
    expected: TypeRef,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase, Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        ()
    } else {
        let clause = core::list_get(clauses, index);
        require(
            clause.effect_name == resolved.effect.name and
                clause.operation_name == resolved.operation.name,
            error_diagnostic(
                source,
                "GRC1803",
                "handler clause targets another operation",
                clause.span,
                "this clause handles `" + clause.effect_name + "::" +
                    clause.operation_name + "`, but the computation performs `" +
                    resolved.effect.name + "::" + resolved.operation.name + "`",
                [DiagnosticLabel {
                    span: resolved.operation.name_span,
                    message: "the performed operation is declared here",
                }],
                "this terminal handler dispatches one performed operation",
                "make the clause effect and operation names agree"
            )
        );
        require(
            core::list_len(clause.patterns) == core::list_len(resolved.parameters),
            error_diagnostic(
                source,
                "GRC1802",
                "wrong number of handler patterns",
                clause.span,
                "this clause provides " +
                    core::int_to_string(core::list_len(clause.patterns)) +
                    " pattern(s), but the operation has " +
                    core::int_to_string(core::list_len(resolved.parameters)) +
                    " argument(s)",
                [],
                "handler patterns correspond positionally to operation arguments",
                "supply one pattern for each operation argument"
            )
        );
        let branch_parameters = validate_pattern_list(
            source,
            module,
            clause.patterns,
            operation_parameter_types(resolved.parameters, 0, []),
            0,
            lexical_parameters
        );
        validate_owned_pattern_list(
            source,
            module,
            clause.patterns,
            operation_parameter_types(resolved.parameters, 0, []),
            clause.body,
            use_constraints,
            0
        );
        let operation_result = resolve_type(
            source,
            module,
            substitute_bindings(
                resolved.operation.result_type,
                resolved.bindings
            )
        );
        let terminal = operation_result.kind == SourceType::Never;
        require(
            clause.has_resumption == (terminal == false),
            error_diagnostic(
                source,
                if(terminal) { "GRC1829" } else { "GRC1830" },
                if(terminal) {
                    "terminal operation has no resumption"
                } else {
                    "resumptive clause must bind its continuation"
                },
                clause.span,
                if(terminal) {
                    "`" + resolved.effect.name + "::" + resolved.operation.name +
                        "` returns `!`"
                } else {
                    "`" + resolved.effect.name + "::" + resolved.operation.name +
                        "` returns normally"
                },
                [DiagnosticLabel {
                    span: resolved.operation.result_type.span,
                    message: "the operation result is declared here",
                }],
                "only resumptive operations capture a delimited continuation",
                if(terminal) {
                    "remove the `with` binding"
                } else {
                    "write `with k => ...` and resume or cancel `k`"
                }
            )
        );
        if(terminal) {
            ()
        } else {
            let uses = resumption_uses_expression(
                source, module, clause.body, clause.resumption_name
            );
            require(
                uses.lower >= resolved.operation.resumption_lower and
                    (resolved.operation.resumption_upper == -1 or
                        (uses.upper != -1 and
                            uses.upper <= resolved.operation.resumption_upper)),
                error_diagnostic(
                    source,
                    "GRC1833",
                    "handler clause violates its resumption quantity",
                    clause.span,
                    "`" + clause.resumption_name + "` is used [" +
                        core::int_to_string(uses.lower) + "," +
                        (if(uses.upper == -1) {
                            "infinity"
                        } else {
                            core::int_to_string(uses.upper)
                        }) + "], but the operation permits [" +
                        core::int_to_string(resolved.operation.resumption_lower) + "," +
                        (if(resolved.operation.resumption_upper == -1) {
                            "infinity"
                        } else {
                            core::int_to_string(resolved.operation.resumption_upper)
                        }) + "]",
                    [DiagnosticLabel {
                        span: resolved.operation.name_span,
                        message: "the operation quantity is declared here",
                    }],
                    "resumption use intervals compose sequential paths, alternatives, and transitive `Fn` callback invocation counts",
                    "resume or cancel the continuation within its declared quantity"
                )
            )
        };
        let clause_parameters = if(terminal) {
            branch_parameters
        } else {
            handle perform ParameterLookupCase::lookup(
                lookup_parameter(branch_parameters, clause.resumption_name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(original)) =>
                    compiler_error(
                        source,
                        "GRC1831",
                        "resumption binding conflicts with a pattern binding",
                        clause.resumption_span,
                        "`" + clause.resumption_name + "` is already bound by this clause",
                        [DiagnosticLabel {
                            span: original.span,
                            message: "the earlier binding is here",
                        }],
                        "one lexical name denotes one typed value",
                        "choose a distinct resumption name"
                    ),
                ParameterLookupCase::lookup(ParameterLookup::Missing) =>
                    core::list_push(branch_parameters, Parameter {
                        name: clause.resumption_name,
                        span: clause.resumption_span,
                        parameter_type: TypeRef {
                            kind: SourceType::Resumption(operation_result, expected),
                            span: clause.resumption_span,
                        },
                        is_local: true,
                        drop_flag: "",
                        llvm_name: "%resumption_" + clause.resumption_name,
                    })
            }
        };
        validate_expression_with_constraints(
            source,
            module,
            clause_parameters,
            use_constraints,
            expected,
            clause.body
        );
        validate_handler_clauses(
            source,
            module,
            lexical_parameters,
            use_constraints,
            resolved,
            clauses,
            index + 1,
            expected
        )
    }
}

pattern_covers_variant(
    pattern: Pattern,
    enum_name: String,
    variant_name: String,
) -> Bool {
    handle perform PatternCase::inspect(pattern) {
        PatternCase::inspect(Pattern::Wildcard(_)) => true,
        PatternCase::inspect(Pattern::Binding(_, _)) => true,
        PatternCase::inspect(Pattern::Variant(name, variant, _, _)) =>
            name == enum_name and variant == variant_name,
        PatternCase::inspect(_) => false
    }
}

patterns_are_irrefutable(
    patterns: List<Pattern>,
    index: i64,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(patterns)) {
        true
    } else {
        handle perform PatternCase::inspect(core::list_get(patterns, index)) {
            PatternCase::inspect(Pattern::Wildcard(_)) =>
                patterns_are_irrefutable(patterns, index + 1),
            PatternCase::inspect(Pattern::Binding(_, _)) =>
                patterns_are_irrefutable(patterns, index + 1),
            PatternCase::inspect(_) => false
        }
    }
}

handler_clauses_are_irrefutable(
    clauses: List<HandlerClause>,
    index: i64,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(clauses)) {
        true
    } else {
        if(patterns_are_irrefutable(
            core::list_get(clauses, index).patterns, 0
        )) {
            handler_clauses_are_irrefutable(clauses, index + 1)
        } else {
            false
        }
    }
}

handler_has_irrefutable_clause(
    clauses: List<HandlerClause>,
    index: i64,
) -> Bool / {ResultCase, PatternCase} {
    if(index >= core::list_len(clauses)) {
        false
    } else {
        if(patterns_are_irrefutable(core::list_get(clauses, index).patterns, 0)) {
            true
        } else {
            handler_has_irrefutable_clause(clauses, index + 1)
        }
    }
}

handler_variant_is_covered(
    clauses: List<HandlerClause>,
    enum_name: String,
    variant_name: String,
    index: i64,
) -> Bool / {ResultCase, PatternCase} {
    if(index >= core::list_len(clauses)) {
        false
    } else {
        let pattern = core::list_get(core::list_get(clauses, index).patterns, 0);
        handle perform PatternCase::inspect(pattern) {
            PatternCase::inspect(Pattern::Wildcard(_)) => true,
            PatternCase::inspect(Pattern::Binding(_, _)) => true,
            PatternCase::inspect(Pattern::Variant(
                name, variant, fields, _
            )) => {
                if(name == enum_name and variant == variant_name and
                    patterns_are_irrefutable(fields, 0)) {
                    true
                } else {
                    handler_variant_is_covered(
                        clauses, enum_name, variant_name, index + 1
                    )
                }
            },
            PatternCase::inspect(_) => handler_variant_is_covered(
                clauses, enum_name, variant_name, index + 1
            )
        }
    }
}

handler_covers_enum_variants(
    clauses: List<HandlerClause>,
    declaration: EnumDecl,
    index: i64,
) -> Bool / {ResultCase, PatternCase} {
    if(index >= core::list_len(declaration.variants)) {
        true
    } else {
        let variant = core::list_get(declaration.variants, index);
        if(handler_variant_is_covered(
            clauses, declaration.name, variant.name, 0
        )) {
            handler_covers_enum_variants(clauses, declaration, index + 1)
        } else {
            false
        }
    }
}

resumptive_handler_is_exhaustive(
    source: SourceFile,
    module: Module,
    resolved: ResolvedEffectOperation,
    clauses: List<HandlerClause>,
) -> Bool / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    PatternCase, Diagnostics
} {
    if(handler_has_irrefutable_clause(clauses, 0)) {
        true
    } else {
        if(core::list_len(resolved.parameters) != 1) {
            false
        } else {
            let parameter_type = resolve_type(
                source, module,
                core::list_get(resolved.parameters, 0).parameter_type
            );
            handle perform TypeCase::inspect(parameter_type.kind) {
                TypeCase::inspect(SourceType::Enum(enum_name, _)) => {
                    handle perform EnumLookupCase::lookup(
                        lookup_enum(module.enums, enum_name, 0)
                    ) {
                        EnumLookupCase::lookup(EnumLookup::Found(declaration)) =>
                            handler_covers_enum_variants(clauses, declaration, 0),
                        EnumLookupCase::lookup(EnumLookup::Missing) => false
                    }
                },
                TypeCase::inspect(_) => false
            }
        }
    }
}

resolve_handler_operation_declaration(
    source: SourceFile,
    module: Module,
    effect_name: String,
    operation_name: String,
    span: SourceSpan,
) -> ResolvedEffectOperation / {
    ResultCase, EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    handle perform EffectLookupCase::lookup(lookup_effect(module.effects, effect_name, 0)) {
        EffectLookupCase::lookup(EffectLookup::Missing) => compiler_error(
            source,
            "GRC1800",
            "unknown effect",
            span,
            "effect `" + effect_name + "` is not declared in this module",
            [],
            "handler clauses resolve through nominal effect declarations",
            "declare the effect or correct its name"
        ),
        EffectLookupCase::lookup(EffectLookup::Found(effect)) => {
            handle perform EffectOperationLookupCase::lookup(
                lookup_effect_operation(effect.operations, operation_name, 0)
            ) {
                EffectOperationLookupCase::lookup(EffectOperationLookup::Missing) =>
                    compiler_error(
                        source,
                        "GRC1801",
                        "unknown effect operation",
                        span,
                        "effect `" + effect_name + "` has no operation named `" +
                            operation_name + "`",
                        [DiagnosticLabel {
                            span: effect.name_span,
                            message: "the effect is declared here",
                        }],
                        "handler operations resolve within their nominal protocol",
                        "use an operation declared by `" + effect_name + "`"
                    ),
                EffectOperationLookupCase::lookup(EffectOperationLookup::Found(operation)) =>
                    ResolvedEffectOperation {
                        effect: effect,
                        operation: operation,
                        bindings: [],
                        parameters: operation.parameters,
                    }
            }
        }
    }
}

variant_coverage_count(
    clauses: List<HandlerClause>,
    enum_name: String,
    variant_name: String,
    index: i64,
    count: i64,
) -> i64 / {ResultCase, PatternCase} {
    if(index >= core::list_len(clauses)) {
        count
    } else {
        let clause = core::list_get(clauses, index);
        let covered = pattern_covers_variant(
            core::list_get(clause.patterns, 0),
            enum_name,
            variant_name
        );
        variant_coverage_count(
            clauses,
            enum_name,
            variant_name,
            index + 1,
            count + (if(covered) { 1 } else { 0 })
        )
    }
}

validate_variant_coverage(
    source: SourceFile,
    declaration: EnumDecl,
    clauses: List<HandlerClause>,
    handler_span: SourceSpan,
    index: i64,
) -> / {ResultCase, PatternCase, Diagnostics} {
    if(index >= core::list_len(declaration.variants)) {
        ()
    } else {
        let variant = core::list_get(declaration.variants, index);
        let count = variant_coverage_count(
            clauses, declaration.name, variant.name, 0, 0
        );
        require(
            count > 0,
            error_diagnostic(
                source,
                "GRC1813",
                "non-exhaustive terminal handler",
                handler_span,
                "enum variant `" + declaration.name + "::" + variant.name +
                    "` is not covered",
                [DiagnosticLabel {
                    span: variant.name_span,
                    message: "the missing variant is declared here",
                }],
                "terminal enum elimination must produce a result for every tag",
                "add a clause for `" + declaration.name + "::" + variant.name + "(...)`"
            )
        );
        require(
            handler_variant_is_covered(
                clauses, declaration.name, variant.name, 0
            ),
            error_diagnostic(
                source,
                "GRC1813",
                "non-exhaustive terminal payload patterns",
                handler_span,
                "ordered clauses for `" + declaration.name + "::" +
                    variant.name + "` do not include a total payload pattern",
                [DiagnosticLabel {
                    span: variant.name_span,
                    message: "this variant's payload must have a fallback path",
                }],
                "nested literal and variant patterns are tested in source order within each outer enum tag",
                "add a final `" + declaration.name + "::" + variant.name +
                    "(...)` clause using bindings or `_` for every payload"
            )
        );
        validate_variant_coverage(
            source, declaration, clauses, handler_span, index + 1
        )
    }
}

validate_handler_exhaustiveness(
    source: SourceFile,
    module: Module,
    resolved: ResolvedEffectOperation,
    clauses: List<HandlerClause>,
    handler_span: SourceSpan,
) -> / {
    ResultCase, TypeCase, EnumLookupCase, TypeAliasLookupCase, StructLookupCase,
    PatternCase, Diagnostics
} {
    require(
        core::list_len(resolved.parameters) == 1,
        error_diagnostic(
            source,
            "GRC1816",
            "terminal enum case operation must accept one argument",
            handler_span,
            "this operation has " +
                core::int_to_string(core::list_len(resolved.parameters)) +
                " parameters",
            [DiagnosticLabel {
                span: resolved.operation.name_span,
                message: "the operation is declared here",
            }],
            "the terminal case effect eliminates one nominal enum subject",
            "declare a single enum-valued operation parameter"
        )
    );
    let subject = resolve_type(
        source,
        module,
        core::list_get(resolved.parameters, 0).parameter_type
    );
    handle perform TypeCase::inspect(subject.kind) {
        TypeCase::inspect(SourceType::Enum(name, _)) => {
            handle perform EnumLookupCase::lookup(lookup_enum(module.enums, name, 0)) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) =>
                    validate_variant_coverage(
                        source, declaration, clauses, handler_span, 0
                    ),
                EnumLookupCase::lookup(EnumLookup::Missing) => ()
            }
        },
        TypeCase::inspect(_) => require(
            handler_has_irrefutable_clause(clauses, 0),
            error_diagnostic(
                source, "GRC1815", "non-exhaustive scalar handler",
                handler_span,
                "patterns over `" + source_type_name(subject.kind) +
                    "` do not include a fallback clause", [],
                "literal scalar patterns cover individual values, so exhaustive dispatch needs a final binding or `_`",
                "add a final `_` clause"
            )
        )
    }
}

validate_resumption_call(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    expected: TypeRef,
    span: SourceSpan,
    cancel: Bool,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, Diagnostics
} {
    let arity = if(cancel) { 1 } else { 2 };
    require(
        core::list_len(arguments) == arity,
        error_diagnostic(
            source,
            "GRC1827",
            "wrong number of resumption arguments",
            span,
            (if(cancel) { "`cancel`" } else { "`resume`" }) + " expects " +
                core::int_to_string(arity) + " argument(s), but receives " +
                core::int_to_string(core::list_len(arguments)),
            [],
            "resumption intrinsics have fixed typed signatures",
            if(cancel) {
                "write `cancel(k)`"
            } else {
                "write `resume(k, operation_result)`"
            }
        )
    );
    let continuation = core::list_get(arguments, 0);
    let continuation_type = resolve_type(
        source,
        module,
        infer_expression_type(source, module, parameters, continuation)
    );
    handle perform TypeCase::inspect(continuation_type.kind) {
        TypeCase::inspect(SourceType::Resumption(input, output)) => {
            if(cancel) {
                require_type(
                    source,
                    module,
                    TypeRef { kind: SourceType::Unit, span: span },
                    expected,
                    span,
                    "cancellation result"
                )
            } else {
                validate_expression(
                    source,
                    module,
                    parameters,
                    input,
                    core::list_get(arguments, 1)
                );
                require_type(
                    source, module, output, expected, span, "resumption result"
                )
            }
        },
        TypeCase::inspect(_) => compiler_error(
            source,
            "GRC1828",
            "resumption intrinsic requires a continuation",
            expression_span(continuation),
            "this argument has type `" + type_name(continuation_type.kind) + "`",
            [],
            "only a compiler-generated handler resumption may be resumed or cancelled",
            "pass the name introduced by `with k`"
        )
    }
}

validate_named_call(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    name: String,
    arguments: List<Expression>,
    expected: TypeRef,
    span: SourceSpan,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    handle perform ParameterLookupCase::lookup(lookup_parameter(parameters, name, 0)) {
        ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) => {
            let parameter_type = resolve_type(source, module, parameter.parameter_type);
            handle perform TypeCase::inspect(parameter_type.kind) {
                TypeCase::inspect(SourceType::Callable(output, _)) => {
                    require(
                        core::list_len(arguments) == 0,
                        error_diagnostic(
                            source,
                            "GRC1305",
                            "wrong number of closure arguments",
                            span,
                            "zero-argument callable `" + name + "` receives " +
                                core::int_to_string(core::list_len(arguments)) +
                                " argument(s)",
                            [DiagnosticLabel {
                                span: parameter.span,
                                message: "the callable parameter is declared here",
                            }],
                            "this Fn constraint uses the `()` argument tuple",
                            "invoke the closure without arguments"
                        )
                    );
                    require_type(
                        source,
                        module,
                        output,
                        expected,
                        span,
                        "closure invocation"
                    )
                },
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC1308",
                    "value is not callable",
                    span,
                    "parameter `" + name + "` does not implement the required `Fn` relation",
                    [DiagnosticLabel {
                        span: parameter.span,
                        message: "this non-callable parameter is declared here",
                    }],
                    "only Fn-constrained values may be invoked",
                    "remove the call or constrain this parameter with `Fn`"
                )
            }
        },
        ParameterLookupCase::lookup(ParameterLookup::Missing) => {
            let callable = resolve_callable(source, module, name, span);
            require(
                core::list_len(arguments) == core::list_len(callable.parameters),
                error_diagnostic(
                    source,
                    "GRC1305",
                    "wrong number of arguments",
                    span,
                    "`" + name + "` expects " +
                        core::int_to_string(core::list_len(callable.parameters)) +
                        " argument(s), but this call supplies " +
                        core::int_to_string(core::list_len(arguments)),
                    [DiagnosticLabel {
                        span: callable.name_span,
                        message: "the callable is declared here",
                    }],
                    "call arity is checked before LLVM lowering",
                    "supply exactly one expression for each declared parameter"
                )
            );
            if(core::list_len(callable.type_parameters) > 0) {
                infer_call_bindings(
                    source,
                    module,
                    parameters,
                    arguments,
                    callable,
                    expected,
                    span
                )
            } else {
                require_type(
                    source,
                    module,
                    callable.result_type,
                    expected,
                    span,
                    "call to `" + name + "`"
                );
                validate_arguments(
                    source,
                    module,
                    parameters,
                    arguments,
                    callable.parameters,
                    0
                )
            }
        }
    }
}

infer_dereference_operand_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    span: SourceSpan,
) -> TypeRef / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(_, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Variable(_, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Call(_, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Field(_, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Dereference(_, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(_) => compiler_error(
            source, "GRC1859", "cannot dereference this value", span,
            "this expression does not produce a reference", [],
            "dereference requires shared or unique reference evidence",
            "borrow a place with `&value` or `&mut value` first"
        )
    }
}

infer_list_element_type(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    items: List<Expression>, index: i64, element: TypeRef,
) -> TypeRef / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, Diagnostics
} {
    if(index >= core::list_len(items)) {
        element
    } else {
        let item = core::list_get(items, index);
        let actual = infer_expression_type(source, module, parameters, item);
        require_type(
            source, module, actual, element, expression_span(item),
            "list element"
        );
        infer_list_element_type(
            source, module, parameters, items, index + 1, element
        )
    }
}

infer_expression_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
) -> TypeRef / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase, StructFieldLookupCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(value, unique, span)) => {
            let target = infer_expression_type(
                source, module, parameters, value
            );
            TypeRef {
                kind: if(unique) {
                    SourceType::UniqueReference(target)
                } else {
                    SourceType::SharedReference(target)
                },
                span: span,
            }
        },
        ExpressionCase::expression(Expression::Dereference(reference, span)) => {
            let reference_type = infer_dereference_operand_type(
                source, module, parameters, reference, span
            );
            handle perform TypeCase::inspect(reference_type.kind) {
                TypeCase::inspect(SourceType::SharedReference(target)) => target,
                TypeCase::inspect(SourceType::UniqueReference(target)) => target,
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC1859", "cannot dereference this value", span,
                    "`" + source_type_name(reference_type.kind) +
                        "` is not a reference type", [],
                    "dereference requires shared or unique reference evidence",
                    "borrow a place with `&value` or `&mut value` first"
                )
            }
        },
        ExpressionCase::expression(Expression::Destroy(_, span)) =>
            TypeRef { kind: SourceType::Unit, span: span },
        ExpressionCase::expression(Expression::AvailableValue(environment, span)) =>
            TypeRef {
                kind: SourceType::Available(environment),
                span: span,
            },
        ExpressionCase::expression(Expression::ConsumeAvailable(_, span)) =>
            TypeRef { kind: SourceType::Unit, span: span },
        ExpressionCase::expression(Expression::Unit(span)) => TypeRef {
            kind: SourceType::Unit,
            span: span,
        },
        ExpressionCase::expression(Expression::String(_, span)) => TypeRef {
            kind: SourceType::String,
            span: span,
        },
        ExpressionCase::expression(Expression::List(items, span)) => {
            require(
                core::list_len(items) > 0,
                error_diagnostic(
                    source, "GRC1410", "empty list type needs context", span,
                    "`[]` does not determine an element type", [],
                    "homogeneous list literals receive their element type from a surrounding declaration or call",
                    "add a `List<T>` annotation"
                )
            );
            let first = infer_expression_type(
                source, module, parameters, core::list_get(items, 0)
            );
            TypeRef {
                kind: SourceType::List(infer_list_element_type(
                    source, module, parameters, items, 1, first
                )),
                span: span,
            }
        },
        ExpressionCase::expression(Expression::Variable(name, span)) => {
            let parameter = resolve_parameter(source, parameters, name, span);
            resolve_type(source, module, parameter.parameter_type)
        },
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            if(name == "cancel") {
                TypeRef { kind: SourceType::Unit, span: span }
            } else {
                if(name == "resume") {
                    let continuation = infer_expression_type(
                        source, module, parameters, core::list_get(arguments, 0)
                    );
                    handle perform TypeCase::inspect(continuation.kind) {
                        TypeCase::inspect(SourceType::Resumption(_, output)) => output,
                        TypeCase::inspect(_) => continuation
                    }
                } else {
                    handle perform ParameterLookupCase::lookup(
                        lookup_parameter(parameters, name, 0)
                    ) {
                        ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) => {
                            let parameter_type = resolve_type(
                                source, module, parameter.parameter_type
                            );
                            handle perform TypeCase::inspect(parameter_type.kind) {
                                TypeCase::inspect(SourceType::Callable(output, _)) => output,
                                TypeCase::inspect(_) => parameter_type
                            }
                        },
                        ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                            let callable = resolve_callable(
                                source, module, name, span
                            );
                            if(core::list_len(callable.type_parameters) > 0) {
                                infer_standalone_generic_call_type(
                                    source, module, parameters, callable,
                                    arguments, span
                                )
                            } else {
                                resolve_type(
                                    source, module, callable.result_type
                                )
                            }
                        }
                    }
                }
            }
        },
        ExpressionCase::expression(Expression::StructValue(name, _, span)) =>
            resolve_type(
                source,
                module,
                TypeRef { kind: SourceType::Named(name), span: span }
            ),
        ExpressionCase::expression(Expression::EnumValue(name, _, _, span)) =>
            resolve_type(
                source,
                module,
                TypeRef { kind: SourceType::Named(name), span: span }
            ),
        ExpressionCase::expression(Expression::Binary(operator, left, right, span)) => {
            if(operator_is_comparison(operator)) {
                resolve_type(
                    source,
                    module,
                    TypeRef { kind: SourceType::Named("Bool"), span: span }
                )
            } else {
                arithmetic_operand_type(
                    source, module, parameters, operator, left, right, span
                )
            }
        },
        ExpressionCase::expression(Expression::Perform(
            effect_name,
            operation_name,
            arguments,
            span
        )) => {
            let resolved = resolve_perform_operation(
                source,
                module,
                parameters,
                effect_name,
                operation_name,
                arguments,
                span
            );
            resolve_type(
                source,
                module,
                substitute_bindings(resolved.operation.result_type, resolved.bindings)
            )
        },
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, span
        )) => {
            handle perform ExpressionCase::expression(computation) {
                ExpressionCase::expression(Expression::Perform(
                    effect_name, operation_name, arguments, perform_span
                )) => {
                    let resolved = resolve_perform_operation(
                        source, module, parameters, effect_name,
                        operation_name, arguments, perform_span
                    );
                    let clause = core::list_get(clauses, 0);
                    let branch_parameters = validate_pattern_list(
                        source, module, clause.patterns,
                        operation_parameter_types(resolved.parameters, 0, []),
                        0, parameters
                    );
                    infer_expression_type(
                        source, module, branch_parameters, clause.body
                    )
                },
                ExpressionCase::expression(_) => compiler_error(
                    source, "GRC1412", "handled expression type needs context",
                    span,
                    "type inference currently requires a direct performed operation", [],
                    "terminal handler branches share one result type",
                    "add a local type annotation"
                )
            }
        },
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            infer_block_type(source, module, parameters, statements, 0),
        ExpressionCase::expression(Expression::Field(subject, field_name, span)) => {
            let subject_type = infer_expression_type(source, module, parameters, subject);
            handle perform TypeCase::inspect(subject_type.kind) {
                TypeCase::inspect(SourceType::Struct(struct_name, _)) => {
                    handle perform StructLookupCase::lookup(
                        lookup_struct(module.structs, struct_name, 0)
                    ) {
                        StructLookupCase::lookup(StructLookup::Found(declaration)) => {
                            handle perform StructFieldLookupCase::lookup(
                                lookup_struct_field(declaration.fields, field_name, 0)
                            ) {
                                StructFieldLookupCase::lookup(StructFieldLookup::Found(field)) =>
                                    resolve_type(source, module, field.field_type),
                                StructFieldLookupCase::lookup(StructFieldLookup::Missing) =>
                                    compiler_error(
                                        source,
                                        "GRC1507",
                                        "unknown projected field",
                                        span,
                                        "struct `" + struct_name +
                                            "` has no field named `" + field_name + "`",
                                        [DiagnosticLabel {
                                            span: declaration.name_span,
                                            message: "the nominal struct is declared here",
                                        }],
                                        "field projection uses nominal declaration fields",
                                        "select a field declared by `" + struct_name + "`"
                                    )
                            }
                        },
                        StructLookupCase::lookup(StructLookup::Missing) => compiler_error(
                            source,
                            "GRC9001",
                            "type resolution invariant violated",
                            span,
                            "resolved struct `" + struct_name + "` has no declaration",
                            [],
                            "nominal types and declarations must remain synchronized",
                            "report this compiler bug"
                        )
                    }
                },
                TypeCase::inspect(SourceType::I32) => compiler_error(
                    source,
                    "GRC1506",
                    "field projection requires a struct",
                    expression_span(subject),
                    "this expression has scalar type `i32`",
                    [],
                    "only nominal product values expose fields",
                    "project from a struct value instead"
                ),
                TypeCase::inspect(SourceType::I64) => compiler_error(
                    source,
                    "GRC1506",
                    "field projection requires a struct",
                    expression_span(subject),
                    "this expression has scalar type `i64`",
                    [],
                    "only nominal product values expose fields",
                    "project from a struct value instead"
                ),
                TypeCase::inspect(SourceType::Enum(name, _)) => compiler_error(
                    source,
                    "GRC1506",
                    "field projection requires a struct",
                    expression_span(subject),
                    "this expression has nominal enum type `" + name + "`",
                    [],
                    "enum payloads are eliminated through variant patterns",
                    "use pattern-driven enum elimination instead of field projection"
                ),
                TypeCase::inspect(SourceType::Named(name)) => compiler_error(
                    source,
                    "GRC9001",
                    "type resolution invariant violated",
                    span,
                    "unresolved type `" + name + "` reached field projection",
                    [],
                    "named types must resolve before projection checking",
                    "report this compiler bug"
                ),
                TypeCase::inspect(SourceType::Generic(name)) => compiler_error(
                    source,
                    "GRC1506",
                    "field projection requires a known struct",
                    expression_span(subject),
                    "generic type `" + name + "` does not determine a field layout",
                    [],
                    "field names are resolved from a concrete nominal struct declaration",
                    "constrain the value to a struct type before projecting `" +
                        field_name + "`"
                )
            }
        },
        ExpressionCase::expression(_) => compiler_error(
            source,
            "GRC1404",
            "expression type needs context",
            expression_span(expression),
            "this expression does not determine a standalone source type",
            [],
            "integer literals and arithmetic are checked from their expected type",
            "introduce a typed parameter, call, constructor, or declaration context"
        )
    }
}

validate_expression(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expected: TypeRef,
    expression: Expression,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    CallableConstraintLookupCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    validate_expression_with_constraints(
        source, module, parameters, [], expected, expression
    )
}

validate_reborrow_permission(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    value: Expression,
    unique: Bool,
    span: SourceSpan,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, Diagnostics
} {
    if(unique == false) {
        ()
    } else {
        handle perform ExpressionCase::expression(value) {
            ExpressionCase::expression(Expression::Dereference(
                reference, _
            )) => {
                let reference_type = infer_dereference_operand_type(
                    source, module, parameters, reference, span
                );
                handle perform TypeCase::inspect(reference_type.kind) {
                    TypeCase::inspect(SourceType::UniqueReference(_)) => (),
                    TypeCase::inspect(SourceType::SharedReference(_)) =>
                        compiler_error(
                            source,
                            "GRC1864",
                            "unique reborrow requires unique access",
                            span,
                            "a shared reference cannot produce `&mut` access",
                            [DiagnosticLabel {
                                span: reference_type.span,
                                message: "this source reference is shared",
                            }],
                            "unique access may be reborrowed only from an existing unique reference",
                            "use `&*value` for a shared reborrow or accept `&mut` input"
                        ),
                    TypeCase::inspect(_) => ()
                }
            },
            ExpressionCase::expression(_) => ()
        }
    }
}

validate_list_items(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    use_constraints: List<UseConstraint>, items: List<Expression>,
    element: TypeRef, index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(items)) {
        ()
    } else {
        validate_expression_with_constraints(
            source, module, parameters, use_constraints, element,
            core::list_get(items, index)
        );
        validate_list_items(
            source, module, parameters, use_constraints, items,
            element, index + 1
        )
    }
}

validate_expression_with_constraints(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    use_constraints: List<UseConstraint>,
    expected: TypeRef,
    expression: Expression,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, TypeInferenceCase,
    Diagnostics
} {
    let resolved_expected = resolve_type(source, module, expected);
    let expected = handle perform TypeCase::inspect(resolved_expected.kind) {
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            indirect_target(storage),
        TypeCase::inspect(_) => resolved_expected
    };
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, span)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::List(element)) =>
                    validate_list_items(
                        source, module, parameters, use_constraints,
                        items, element, 0
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC1411", "list literal has non-list context", span,
                    "expected `" + source_type_name(expected.kind) + "`", [],
                    "a list literal has homogeneous type `List<T>`",
                    "use the literal where a `List<T>` value is expected"
                )
            }
        },
        ExpressionCase::expression(Expression::Borrow(value, unique, span)) => {
            let target = handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::SharedReference(found)) => found,
                TypeCase::inspect(SourceType::UniqueReference(found)) => found,
                TypeCase::inspect(_) => infer_expression_type(
                    source, module, parameters, value
                )
            };
            let typed = typed_core_expression(
                source, module, parameters, value, target
            );
            require(
                typed.place.found,
                error_diagnostic(
                    source, "GRC1860", "borrow requires a place",
                    expression_span(typed.expression),
                    "this temporary has no stable place to borrow", [],
                    "references point to parameters, locals, or their projections",
                    "bind the value to a local before borrowing it"
                )
            );
            validate_reborrow_permission(
                source, module, parameters, typed.expression, unique, span
            );
            require_type(
                source, module,
                TypeRef {
                    kind: if(unique) {
                        SourceType::UniqueReference(typed.value_type)
                    } else {
                        SourceType::SharedReference(typed.value_type)
                    },
                    span: span,
                },
                expected, span, "borrowed place"
            )
        },
        ExpressionCase::expression(Expression::Dereference(reference, span)) => {
            let reference_type = infer_dereference_operand_type(
                source, module, parameters, reference, span
            );
            let target = infer_expression_type(
                source, module, parameters, expression
            );
            validate_expression_with_constraints(
                source, module, parameters, use_constraints,
                reference_type, reference
            );
            require_type(
                source, module, target, expected, span,
                "dereferenced place"
            )
        },
        ExpressionCase::expression(Expression::Destroy(value, span)) => {
            require_type(
                source, module,
                TypeRef { kind: SourceType::Unit, span: span },
                expected, span, "explicit destruction"
            );
            let value_type = infer_expression_type(
                source, module, parameters, value
            );
            validate_expression_with_constraints(
                source, module, parameters, use_constraints, value_type, value
            )
        },
        ExpressionCase::expression(Expression::AvailableValue(environment, span)) =>
            require_type(
                source, module,
                TypeRef {
                    kind: SourceType::Available(environment), span: span,
                },
                expected, span, "compiler-generated availability witness"
            ),
        ExpressionCase::expression(Expression::ConsumeAvailable(available, span)) => {
            require_type(
                source, module,
                TypeRef { kind: SourceType::Unit, span: span },
                expected, span, "consumed availability witness"
            );
            let available_type = infer_expression_type(
                source, module, parameters, available
            );
            handle perform TypeCase::inspect(available_type.kind) {
                TypeCase::inspect(SourceType::Available(_)) =>
                    validate_expression_with_constraints(
                        source, module, parameters, use_constraints,
                        available_type, available
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC9001", "availability intrinsic invariant violated",
                    expression_span(available),
                    "the compiler attempted to consume a non-Available value", [],
                    "only compiler-generated Available<E> evidence may enter this node",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(Expression::Unit(span)) => require_type(
            source,
            module,
            TypeRef { kind: SourceType::Unit, span: span },
            expected,
            span,
            "unit value"
        ),
        ExpressionCase::expression(Expression::String(_, span)) => require_type(
            source, module,
            TypeRef { kind: SourceType::String, span: span },
            expected, span, "string literal"
        ),
        ExpressionCase::expression(Expression::Integer(value, span)) => {
            if(expected.kind == SourceType::I32) {
                require(
                    value <= 2147483647,
                    error_diagnostic(
                        source,
                        "GRC1402",
                        "integer literal is out of range for `i32`",
                        span,
                        "this literal cannot be represented by the expected `i32` type",
                        [DiagnosticLabel {
                            span: expected.span,
                            message: "`i32` is required by this declaration",
                        }],
                        "literal range checking uses the expected source type",
                        "use a value no greater than 2147483647 or change the declaration to `i64`"
                    )
                )
            } else {
                ()
            }
        },
        ExpressionCase::expression(Expression::Negate(operand, _)) => {
            require_integer_type(source, expected, expression_span(expression));
            validate_expression_with_constraints(
                source, module, parameters, use_constraints, expected, operand
            )
        },
        ExpressionCase::expression(Expression::Binary(operator, left, right, span)) => {
            if(operator_is_comparison(operator)) {
                let bool_type = resolve_type(
                    source,
                    module,
                    TypeRef { kind: SourceType::Named("Bool"), span: span }
                );
                require_type(
                    source,
                    module,
                    bool_type,
                    expected,
                    span,
                    "comparison result"
                );
                let operand_type = comparison_expression_operand_type(
                    source,
                    module,
                    parameters,
                    operator,
                    left,
                    right,
                    span
                );
                validate_expression_with_constraints(
                    source, module, parameters, use_constraints, operand_type, left
                );
                validate_expression_with_constraints(
                    source, module, parameters, use_constraints, operand_type, right
                )
            } else {
                let resolved_expected = resolve_type(source, module, expected);
                handle perform TypeCase::inspect(resolved_expected.kind) {
                    TypeCase::inspect(SourceType::String) => require(
                        operator_is_add(operator),
                        error_diagnostic(
                            source, "GRC1403", "operator requires an integer",
                            span,
                            "only `+` is defined for `String` operands", [],
                            "string addition concatenates its operands",
                            "use `+` or change both operands to integers"
                        )
                    ),
                    TypeCase::inspect(_) => require_integer_type(
                        source, resolved_expected, span
                    )
                };
                validate_expression_with_constraints(
                    source, module, parameters, use_constraints, expected, left
                );
                validate_expression_with_constraints(
                    source, module, parameters, use_constraints, expected, right
                );
                handle perform OperatorCase::operator(operator) {
                    OperatorCase::operator(BinaryOperator::Divide) => require(
                        is_zero(right) == false,
                        error_diagnostic(
                            source,
                            "GRC1201",
                            "division by zero",
                            expression_span(right),
                            "this expression is statically known to be zero",
                            [DiagnosticLabel {
                                span: span,
                                message: "in this division expression",
                            }],
                            "LLVM integer division by zero has undefined behavior",
                            "change the divisor to a non-zero expression"
                        )
                    ),
                    OperatorCase::operator(_) => ()
                }
            }
        },
        ExpressionCase::expression(Expression::Variable(name, span)) => {
            let parameter = resolve_parameter(source, parameters, name, span);
            require_type(
                source,
                module,
                parameter.parameter_type,
                expected,
                span,
                "parameter `" + name + "`"
            )
        },
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            if(name == "resume") {
                validate_resumption_call(
                    source, module, parameters, arguments, expected, span, false
                )
            } else {
                if(name == "cancel") {
                    validate_resumption_call(
                        source, module, parameters, arguments, expected, span, true
                    )
                } else {
                    validate_named_call(
                        source, module, parameters, name, arguments, expected, span
                    )
                }
            }
        },
        ExpressionCase::expression(Expression::StructValue(name, fields, span)) => {
            require(
                name != "Available",
                error_diagnostic(
                    source,
                    "GRC1850",
                    "availability evidence cannot be constructed",
                    span,
                    "`Available<E>` witnesses are created only by checked post-environment lowering",
                    [],
                    "the witness proves that an owned environment transition has not occurred on this runtime path",
                    "receive an `Available<E>` from an incremental ownership operation instead of constructing one"
                )
            );
            let constructed = handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Struct(expected_name, _)) => {
                    if(name == expected_name) {
                        expected
                    } else {
                        TypeRef { kind: SourceType::Named(name), span: span }
                    }
                },
                TypeCase::inspect(_) => TypeRef {
                    kind: SourceType::Named(name), span: span,
                }
            };
            require_type(source, module, constructed, expected, span, "constructed value");
            handle perform StructLookupCase::lookup(lookup_struct(module.structs, name, 0)) {
                StructLookupCase::lookup(StructLookup::Found(declaration)) => {
                    let type_arguments = handle perform TypeCase::inspect(
                        expected.kind
                    ) {
                        TypeCase::inspect(SourceType::Struct(_, arguments)) =>
                            arguments,
                        TypeCase::inspect(_) => []
                    };
                    validate_supplied_struct_fields(source, declaration, fields, 0);
                    validate_declared_struct_fields(
                        source,
                        module,
                        parameters,
                        declaration,
                        type_arguments,
                        fields,
                        0,
                        span
                    )
                },
                StructLookupCase::lookup(StructLookup::Missing) => compiler_error(
                    source,
                    "GRC1500",
                    "unknown struct constructor",
                    span,
                    "`" + name + "` is not a declared struct",
                    [],
                    "only nominal struct declarations provide named field construction",
                    "declare `struct " + name + " { ... }` or correct the constructor name"
                )
            }
        },
        ExpressionCase::expression(Expression::Field(subject, field_name, span)) => {
            let subject_type = infer_expression_type(source, module, parameters, subject);
            let field_type = infer_expression_type(source, module, parameters, expression);
            require(
                drop_is_present(source, module, subject_type, 0) == false or
                    principal_use_interval(
                        source, module, field_type, []
                    ).upper == -1,
                error_diagnostic(
                    source, "GRC1870", "cannot partially move from a `Drop` type",
                    span,
                    "field `" + field_name +
                        "` is not unrestricted and would leave the value partially initialized",
                    [DiagnosticLabel {
                        span: expression_span(subject),
                        message: "this value has a custom `Drop` hook",
                    }],
                    "the hook must observe a fully initialized value before structural destruction",
                    "borrow the field or move the complete value instead"
                )
            );
            validate_expression_with_constraints(
                source, module, parameters, use_constraints, subject_type, subject
            );
            require_type(
                source,
                module,
                field_type,
                expected,
                span,
                "projected field `" + field_name + "`"
            )
        },
        ExpressionCase::expression(Expression::EnumValue(
            enum_name,
            variant_name,
            arguments,
            span
        )) => {
            let enum_arguments = expected_enum_arguments(
                source,
                expected,
                enum_name,
                span
            );
            handle perform EnumLookupCase::lookup(lookup_enum(module.enums, enum_name, 0)) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                    handle perform VariantLookupCase::lookup(
                        lookup_variant(declaration.variants, variant_name, 0)
                    ) {
                        VariantLookupCase::lookup(VariantLookup::Found(variant)) => {
                            require(
                                core::list_len(arguments) == core::list_len(variant.fields),
                                error_diagnostic(
                                    source,
                                    "GRC1602",
                                    "wrong number of variant payloads",
                                    span,
                                    "`" + enum_name + "::" + variant_name + "` expects " +
                                        core::int_to_string(core::list_len(variant.fields)) +
                                        " payload value(s), but receives " +
                                        core::int_to_string(core::list_len(arguments)),
                                    [DiagnosticLabel {
                                        span: variant.name_span,
                                        message: "the variant is declared here",
                                    }],
                                    "variant payload arity is fixed by its nominal declaration",
                                    "supply exactly one expression for each payload type"
                                )
                            );
                            validate_variant_arguments(
                                source,
                                module,
                                parameters,
                                arguments,
                                substitute_types(
                                    variant.fields,
                                    declaration.type_parameters,
                                    enum_arguments,
                                    0,
                                    []
                                ),
                                0
                            )
                        },
                        VariantLookupCase::lookup(VariantLookup::Missing) => compiler_error(
                            source,
                            "GRC1601",
                            "unknown enum variant",
                            span,
                            "enum `" + enum_name + "` has no variant named `" +
                                variant_name + "`",
                            [DiagnosticLabel {
                                span: declaration.name_span,
                                message: "the enum is declared here",
                            }],
                            "variants are resolved within their nominal enum",
                            "use a variant declared by `" + enum_name + "`"
                        )
                    }
                },
                EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                    source,
                    "GRC1600",
                    "unknown enum constructor",
                    span,
                    "`" + enum_name + "` is not a declared enum",
                    [],
                    "qualified variant construction requires a nominal enum",
                    "declare `enum " + enum_name + " { ... }` or correct the name"
                )
            }
        },
        ExpressionCase::expression(Expression::Perform(
            effect_name,
            operation_name,
            arguments,
            span
        )) => {
            let resolved = resolve_perform_operation(
                source,
                module,
                parameters,
                effect_name,
                operation_name,
                arguments,
                span
            );
            require_type(
                source,
                module,
                substitute_bindings(resolved.operation.result_type, resolved.bindings),
                expected,
                span,
                "performed operation"
            )
        },
        ExpressionCase::expression(Expression::Handle(computation, clauses, span)) => {
            require(
                core::list_len(clauses) > 0,
                error_diagnostic(
                    source,
                    "GRC1811",
                    "handler has no clauses",
                    span,
                    "a handler must cover at least one operation",
                    [],
                    "handler clauses produce the intercepted computation paths",
                    "add an operation clause"
                )
            );
            handle perform ExpressionCase::expression(computation) {
                ExpressionCase::expression(Expression::Perform(
                    effect_name,
                    operation_name,
                    arguments,
                    perform_span
                )) => {
                    let resolved = resolve_perform_operation(
                        source,
                        module,
                        parameters,
                        effect_name,
                        operation_name,
                        arguments,
                        perform_span
                    );
                    let operation_result = resolve_type(
                        source,
                        module,
                        substitute_bindings(
                            resolved.operation.result_type,
                            resolved.bindings
                        )
                    );
                    validate_handler_clauses(
                        source,
                        module,
                        parameters,
                        use_constraints,
                        resolved,
                        clauses,
                        0,
                        expected
                    );
                    if(operation_result.kind == SourceType::Never) {
                        validate_handler_exhaustiveness(
                            source,
                            module,
                            resolved,
                            clauses,
                            span
                        )
                    } else {
                        require(
                            resumptive_handler_is_exhaustive(
                                source, module, resolved, clauses
                            ),
                            error_diagnostic(
                                source,
                                "GRC1832",
                                "non-exhaustive resumptive handler",
                                span,
                                "no clause accepts every argument of `" + effect_name +
                                    "::" + operation_name + "`",
                                [DiagnosticLabel {
                                    span: resolved.operation.name_span,
                                    message: "the resumptive operation is declared here",
                                }],
                                "an inline handler removes an effect only when its operation coverage is exhaustive",
                                "add a clause using bindings or `_` for every operation argument"
                            )
                        )
                    }
                },
                ExpressionCase::expression(_) => {
                    validate_expression_with_constraints(
                        source, module, parameters, use_constraints,
                        expected, computation
                    );
                    let first = core::list_get(clauses, 0);
                    let resolved = resolve_handler_operation_declaration(
                        source,
                        module,
                        first.effect_name,
                        first.operation_name,
                        first.span
                    );
                    validate_handler_clauses(
                        source, module, parameters, use_constraints,
                        resolved, clauses, 0, expected
                    );
                    ()
                }
            }
        },
        ExpressionCase::expression(Expression::Block(statements, _)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Callable(output, _)) =>
                    validate_block_with_constraints(
                        source, module, parameters, use_constraints,
                        statements, 0, output
                    ),
                TypeCase::inspect(_) =>
                    validate_block_with_constraints(
                        source, module, parameters, use_constraints,
                        statements, 0, expected
                    )
            }
        }
    }
}

validate_arguments(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    expected_parameters: List<Parameter>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, TypeBindingLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        ()
    } else {
        validate_expression(
            source,
            module,
            parameters,
            core::list_get(expected_parameters, index).parameter_type,
            core::list_get(arguments, index)
        );
        validate_arguments(
            source,
            module,
            parameters,
            arguments,
            expected_parameters,
            index + 1
        )
    }
}

type_has_generic(reference: TypeRef) -> Bool / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Generic(_)) => true,
        TypeCase::inspect(SourceType::List(element)) => type_has_generic(element),
        TypeCase::inspect(SourceType::Callable(output, _)) => type_has_generic(output),
        TypeCase::inspect(SourceType::Resumption(input, output)) =>
            type_has_generic(input) or type_has_generic(output),
        TypeCase::inspect(SourceType::Available(environment)) =>
            type_has_generic(environment),
        TypeCase::inspect(SourceType::SharedReference(target)) =>
            type_has_generic(target),
        TypeCase::inspect(SourceType::UniqueReference(target)) =>
            type_has_generic(target),
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            type_has_generic(indirect_target(storage)),
        TypeCase::inspect(SourceType::Environment(_)) => false,
        TypeCase::inspect(SourceType::Applied(_, arguments)) =>
            type_list_has_generic(arguments, 0),
        TypeCase::inspect(SourceType::Struct(_, arguments)) =>
            type_list_has_generic(arguments, 0),
        TypeCase::inspect(SourceType::Enum(_, arguments)) =>
            type_list_has_generic(arguments, 0),
        TypeCase::inspect(_) => false
    }
}

type_list_has_generic(
    references: List<TypeRef>,
    index: i64,
) -> Bool / {ResultCase, TypeCase} {
    if(index >= core::list_len(references)) {
        false
    } else {
        if(type_has_generic(core::list_get(references, index))) {
            true
        } else {
            type_list_has_generic(references, index + 1)
        }
    }
}

infer_generic_argument_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    generic_name: String,
) -> TypeRef / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, BlockStatementCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::String(_, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::List(_, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Binary(_, _, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Borrow(_, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Dereference(_, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::ConsumeAvailable(_, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Unit(_)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Variable(_, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Call(_, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::StructValue(_, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::EnumValue(_, _, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Field(_, _, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Block(_, _)) =>
            infer_expression_type(source, module, parameters, expression),
        ExpressionCase::expression(_) => compiler_error(
            source,
            "GRC1406",
            "cannot infer generic argument type",
            expression_span(expression),
            "this expression has no standalone type from which to infer `" +
                generic_name + "`",
            [],
            "integer literals and arithmetic receive their type from context",
            "constrain the generic through the call result or pass a typed value"
        )
    }
}

first_generic_name(reference: TypeRef) -> String / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Generic(name)) => name,
        TypeCase::inspect(SourceType::Callable(output, _)) => first_generic_name(output),
        TypeCase::inspect(SourceType::Resumption(input, output)) => {
            if(type_has_generic(input)) {
                first_generic_name(input)
            } else {
                first_generic_name(output)
            }
        },
        TypeCase::inspect(SourceType::Available(environment)) =>
            first_generic_name(environment),
        TypeCase::inspect(SourceType::SharedReference(target)) =>
            first_generic_name(target),
        TypeCase::inspect(SourceType::UniqueReference(target)) =>
            first_generic_name(target),
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            first_generic_name(indirect_target(storage)),
        TypeCase::inspect(SourceType::Applied(_, arguments)) =>
            first_generic_name_in_list(arguments, 0),
        TypeCase::inspect(SourceType::Struct(_, arguments)) =>
            first_generic_name_in_list(arguments, 0),
        TypeCase::inspect(SourceType::Enum(_, arguments)) =>
            first_generic_name_in_list(arguments, 0),
        TypeCase::inspect(_) => "unknown"
    }
}

first_generic_name_in_list(
    references: List<TypeRef>,
    index: i64,
) -> String / {ResultCase, TypeCase} {
    let reference = core::list_get(references, index);
    if(type_has_generic(reference)) {
        first_generic_name(reference)
    } else {
        first_generic_name_in_list(references, index + 1)
    }
}

try_infer_standalone_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
) -> TypeInference / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, BlockStatementCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::String(_, _)) =>
            TypeInference::Found(
                infer_expression_type(source, module, parameters, expression)
            ),
        ExpressionCase::expression(Expression::List(_, _)) =>
            TypeInference::Found(
                infer_expression_type(source, module, parameters, expression)
            ),
        ExpressionCase::expression(Expression::StructValue(_, _, _)) =>
            TypeInference::Found(
                infer_expression_type(source, module, parameters, expression)
            ),
        ExpressionCase::expression(Expression::EnumValue(_, _, _, _)) =>
            TypeInference::Found(
                infer_expression_type(source, module, parameters, expression)
            ),
        ExpressionCase::expression(Expression::Borrow(_, _, _)) =>
            TypeInference::Found(
                infer_expression_type(source, module, parameters, expression)
            ),
        ExpressionCase::expression(Expression::Dereference(_, _)) =>
            TypeInference::Found(
                infer_expression_type(source, module, parameters, expression)
            ),
        ExpressionCase::expression(Expression::ConsumeAvailable(_, _)) =>
            TypeInference::Found(
                infer_expression_type(source, module, parameters, expression)
            ),
        ExpressionCase::expression(Expression::Unit(_)) => TypeInference::Found(
            infer_expression_type(source, module, parameters, expression)
        ),
        ExpressionCase::expression(Expression::Variable(_, _)) => TypeInference::Found(
            infer_expression_type(source, module, parameters, expression)
        ),
        ExpressionCase::expression(Expression::Field(_, _, _)) => TypeInference::Found(
            infer_expression_type(source, module, parameters, expression)
        ),
        ExpressionCase::expression(Expression::Binary(operator, _, _, _)) => {
            if(operator_is_comparison(operator)) {
                TypeInference::Found(
                    infer_expression_type(source, module, parameters, expression)
                )
            } else {
                TypeInference::Missing
            }
        },
        ExpressionCase::expression(Expression::Call(name, _, span)) => {
            handle perform ParameterLookupCase::lookup(
                lookup_parameter(parameters, name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) => {
                    let parameter_type = resolve_type(
                        source, module, parameter.parameter_type
                    );
                    handle perform TypeCase::inspect(parameter_type.kind) {
                        TypeCase::inspect(SourceType::Callable(output, _)) =>
                            TypeInference::Found(output),
                        TypeCase::inspect(_) => TypeInference::Missing
                    }
                },
                ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                    let callable = resolve_callable(source, module, name, span);
                    let result_type = resolve_type(
                        source, module, callable.result_type
                    );
                    if(type_has_generic(result_type)) {
                        TypeInference::Missing
                    } else {
                        TypeInference::Found(result_type)
                    }
                }
            }
        },
        ExpressionCase::expression(_) => TypeInference::Missing
    }
}

infer_available_generic_arguments(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    declared_parameters: List<Parameter>,
    callable_constraints: List<CallableConstraint>,
    index: i64,
    bindings: List<TypeBinding>,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, TypeBindingLookupCase,
    BlockStatementCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        bindings
    } else {
        let argument = core::list_get(arguments, index);
        let declared_parameter = core::list_get(declared_parameters, index);
        if(parameter_has_callable_constraint_in_list(
            declared_parameter, callable_constraints, 0
        )) {
            infer_available_generic_arguments(
                source, module, parameters, arguments, declared_parameters,
                callable_constraints, index + 1, bindings
            )
        } else {
        handle perform TypeInferenceCase::inspect(
            try_infer_standalone_type(source, module, parameters, argument)
        ) {
            TypeInferenceCase::inspect(TypeInference::Missing) =>
                infer_available_generic_arguments(
                    source,
                    module,
                    parameters,
                    arguments,
                    declared_parameters,
                    callable_constraints,
                    index + 1,
                    bindings
            ),
            TypeInferenceCase::inspect(TypeInference::Found(actual)) => {
                if(type_has_generic(actual)) {
                    infer_available_generic_arguments(
                        source, module, parameters, arguments,
                        declared_parameters, callable_constraints,
                        index + 1, bindings
                    )
                } else {
                    let declared = resolve_type(
                        source,
                        module,
                        core::list_get(declared_parameters, index).parameter_type
                    );
                    infer_available_generic_arguments(
                        source,
                        module,
                        parameters,
                        arguments,
                        declared_parameters,
                        callable_constraints,
                        index + 1,
                        unify_types(
                            source,
                            substitute_bindings(declared, bindings),
                            actual,
                            bindings,
                            expression_span(argument)
                        )
                    )
                }
            }
        }
        }
    }
}

parameter_has_callable_constraint_in_list(
    parameter: Parameter,
    constraints: List<CallableConstraint>,
    index: i64,
) -> Bool / {ResultCase, TypeCase} {
    if(index >= core::list_len(constraints)) {
        false
    } else {
        let matches = handle perform TypeCase::inspect(parameter.parameter_type.kind) {
            TypeCase::inspect(SourceType::Generic(name)) =>
                core::list_get(constraints, index).parameter_name == name,
            TypeCase::inspect(_) => false
        };
        if(matches) {
            true
        } else {
            parameter_has_callable_constraint_in_list(
                parameter, constraints, index + 1
            )
        }
    }
}

infer_nested_generic_call_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    callable: CallableDecl,
    arguments: List<Expression>,
    expected: TypeRef,
    span: SourceSpan,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    let outer_prefix = "$outer@" + callable.name + "@" +
        core::int_to_string(span.start) + "@";
    let isolated_expected = remap_type_generics(
        expected, outer_prefix, false
    );
    let argument_bindings = infer_available_generic_arguments(
        source,
        module,
        parameters,
        arguments,
        callable.parameters,
        callable.callable_constraints,
        0,
        []
    );
    let declared_result = resolve_type(source, module, callable.result_type);
    let result_bindings = unify_types(
        source,
        substitute_bindings(declared_result, argument_bindings),
        isolated_expected,
        argument_bindings,
        span
    );
    let bindings = bind_callable_constraints(
        source,
        module,
        callable.callable_constraints,
        0,
        result_bindings,
        span
    );
    let final_bindings = infer_generic_arguments_only(
        source,
        module,
        parameters,
        arguments,
        callable.parameters,
        0,
        bindings,
        span
    );
    let environment_bindings = synthesize_environment_bindings(
        callable, final_bindings, span, 0
    );
    remap_type_generics(
        resolve_type(
            source,
            module,
            substitute_bindings(callable.result_type, environment_bindings)
        ),
        outer_prefix,
        true
    )
}

infer_standalone_generic_call_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    callable: CallableDecl,
    arguments: List<Expression>,
    span: SourceSpan,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    let argument_bindings = infer_available_generic_arguments(
        source, module, parameters, arguments, callable.parameters,
        callable.callable_constraints, 0, []
    );
    let constraint_bindings = bind_callable_constraints(
        source, module, callable.callable_constraints, 0,
        argument_bindings, span
    );
    let validated_bindings = infer_generic_arguments_only(
        source, module, parameters, arguments, callable.parameters, 0,
        constraint_bindings, span
    );
    let bindings = synthesize_environment_bindings(
        callable, validated_bindings, span, 0
    );
    resolve_type(
        source, module,
        substitute_bindings(callable.result_type, bindings)
    )
}

infer_struct_constructor_bindings(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    declaration: StructDecl,
    type_arguments: List<TypeRef>,
    fields: List<NamedExpression>,
    index: i64,
    bindings: List<TypeBinding>,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(declaration.fields)) {
        bindings
    } else {
        let field = core::list_get(declaration.fields, index);
        handle perform NamedExpressionLookupCase::lookup(
            lookup_named_expression(fields, field.name, 0)
        ) {
            NamedExpressionLookupCase::lookup(
                NamedExpressionLookup::Found(supplied)
            ) => {
                let expected = substitute_bindings(
                    core::list_get(
                        substitute_types(
                            [field.field_type], declaration.type_parameters,
                            type_arguments, 0, []
                        ),
                        0
                    ),
                    bindings
                );
                let next_bindings = if(type_has_generic(expected)) {
                    let actual = infer_argument_type_against_expected(
                        source, module, parameters, supplied.value, expected
                    );
                    unify_types(
                        source, expected, actual, bindings,
                        expression_span(supplied.value)
                    )
                } else {
                    bindings
                };
                infer_struct_constructor_bindings(
                    source, module, parameters, declaration, type_arguments,
                    fields, index + 1, next_bindings
                )
            },
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Missing) =>
                bindings
        }
    }
}

infer_enum_constructor_bindings(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    declaration: EnumDecl,
    type_arguments: List<TypeRef>,
    variant: VariantDecl,
    arguments: List<Expression>,
    index: i64,
    bindings: List<TypeBinding>,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        bindings
    } else {
        let expected = substitute_bindings(
            core::list_get(
                substitute_types(
                    variant.fields, declaration.type_parameters,
                    type_arguments, 0, []
                ),
                index
            ),
            bindings
        );
        let argument = core::list_get(arguments, index);
        let next_bindings = if(type_has_generic(expected)) {
            let actual = infer_argument_type_against_expected(
                source, module, parameters, argument, expected
            );
            unify_types(
                source, expected, actual, bindings,
                expression_span(argument)
            )
        } else {
            bindings
        };
        infer_enum_constructor_bindings(
            source, module, parameters, declaration, type_arguments,
            variant, arguments, index + 1, next_bindings
        )
    }
}

infer_argument_type_against_expected(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    expected: TypeRef,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::StructValue(name, fields, span)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Struct(
                    expected_name, type_arguments
                )) => {
                    if(name == expected_name) {
                        handle perform StructLookupCase::lookup(
                            lookup_struct(module.structs, name, 0)
                        ) {
                            StructLookupCase::lookup(
                                StructLookup::Found(declaration)
                            ) => substitute_bindings(
                                expected,
                                infer_struct_constructor_bindings(
                                    source, module, parameters, declaration,
                                    type_arguments, fields, 0, []
                                )
                            ),
                            StructLookupCase::lookup(StructLookup::Missing) =>
                                expected
                        }
                    } else {
                        infer_generic_argument_type(
                            source, module, parameters, expression,
                            first_generic_name(expected)
                        )
                    }
                },
                TypeCase::inspect(_) => infer_generic_argument_type(
                    source, module, parameters, expression,
                    first_generic_name(expected)
                )
            }
        },
        ExpressionCase::expression(Expression::EnumValue(
            name, variant_name, arguments, _
        )) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Enum(
                    expected_name, type_arguments
                )) => {
                    if(name == expected_name) {
                        handle perform EnumLookupCase::lookup(
                            lookup_enum(module.enums, name, 0)
                        ) {
                            EnumLookupCase::lookup(
                                EnumLookup::Found(declaration)
                            ) => {
                                handle perform VariantLookupCase::lookup(
                                    lookup_variant(
                                        declaration.variants, variant_name, 0
                                    )
                                ) {
                                    VariantLookupCase::lookup(
                                        VariantLookup::Found(variant)
                                    ) => substitute_bindings(
                                        expected,
                                        infer_enum_constructor_bindings(
                                            source, module, parameters,
                                            declaration, type_arguments,
                                            variant, arguments, 0, []
                                        )
                                    ),
                                    VariantLookupCase::lookup(
                                        VariantLookup::Missing
                                    ) => expected
                                }
                            },
                            EnumLookupCase::lookup(EnumLookup::Missing) => expected
                        }
                    } else {
                        infer_generic_argument_type(
                            source, module, parameters, expression,
                            first_generic_name(expected)
                        )
                    }
                },
                TypeCase::inspect(_) => infer_generic_argument_type(
                    source, module, parameters, expression,
                    first_generic_name(expected)
                )
            }
        },
        ExpressionCase::expression(Expression::Block(statements, span)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Callable(output, _)) => TypeRef {
                    kind: SourceType::Callable(
                        if(type_has_generic(output)) {
                            infer_unannotated_block_type(
                                source, module, parameters, statements, 0
                            )
                        } else {
                            infer_block_type(
                                source, module, parameters, statements, 0
                            )
                        },
                        expression_requires_step(
                            source, module, parameters, expression
                        )
                    ),
                    span: span,
                },
                TypeCase::inspect(_) => infer_generic_argument_type(
                    source, module, parameters, expression,
                    first_generic_name(expected)
                )
            }
        },
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            handle perform ParameterLookupCase::lookup(
                lookup_parameter(parameters, name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(_)) =>
                    infer_generic_argument_type(
                        source,
                        module,
                        parameters,
                        expression,
                        first_generic_name(expected)
                    ),
                ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                    let callable = resolve_callable(source, module, name, span);
                    if(core::list_len(callable.type_parameters) > 0) {
                        infer_nested_generic_call_type(
                            source,
                            module,
                            parameters,
                            callable,
                            arguments,
                            expected,
                            span
                        )
                    } else {
                        resolve_type(source, module, callable.result_type)
                    }
                }
            }
        },
        ExpressionCase::expression(_) => infer_generic_argument_type(
            source,
            module,
            parameters,
            expression,
            first_generic_name(expected)
        )
    }
}

callable_argument_is_effectful(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
) -> Bool / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, BlockStatementCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Block(_, _)) =>
            expression_requires_step(source, module, parameters, expression),
        ExpressionCase::expression(Expression::Variable(_, _)) => {
            let actual = infer_expression_type(
                source, module, parameters, expression
            );
            handle perform TypeCase::inspect(actual.kind) {
                TypeCase::inspect(SourceType::Callable(_, effectful)) =>
                    effectful,
                TypeCase::inspect(_) => false
            }
        },
        ExpressionCase::expression(_) => false
    }
}

refine_callable_argument_effect(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    declared: TypeRef,
    argument: Expression,
    bindings: List<TypeBinding>,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, TypeBindingLookupCase, BlockStatementCase,
    Diagnostics
} {
    handle perform TypeCase::inspect(declared.kind) {
        TypeCase::inspect(SourceType::Generic(name)) => {
            handle perform TypeBindingLookupCase::lookup(
                lookup_type_binding(bindings, name, 0)
            ) {
                TypeBindingLookupCase::lookup(TypeBindingLookup::Found(value)) => {
                    handle perform TypeCase::inspect(value.kind) {
                        TypeCase::inspect(SourceType::Callable(_, _)) =>
                            set_callable_binding_effect(
                                bindings,
                                name,
                                callable_argument_is_effectful(
                                    source, module, parameters, argument
                                )
                            ),
                        TypeCase::inspect(_) => bindings
                    }
                },
                TypeBindingLookupCase::lookup(TypeBindingLookup::Missing) =>
                    bindings
            }
        },
        TypeCase::inspect(_) => bindings
    }
}

infer_generic_arguments_only(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    expected_parameters: List<Parameter>,
    index: i64,
    bindings: List<TypeBinding>,
    call_span: SourceSpan,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        bindings
    } else {
        let declared = resolve_type(
            source, module,
            core::list_get(expected_parameters, index).parameter_type
        );
        let argument = core::list_get(arguments, index);
        let refined = refine_callable_argument_effect(
            source, module, parameters, declared, argument, bindings
        );
        let substituted = substitute_bindings(declared, refined);
        let next = if(type_has_generic(substituted)) {
            unify_types(
                source,
                substituted,
                infer_argument_type_against_expected(
                    source, module, parameters, argument, substituted
                ),
                refined,
                expression_span(argument)
            )
        } else {
            refined
        };
        infer_generic_arguments_only(
            source, module, parameters, arguments, expected_parameters,
            index + 1, next, call_span
        )
    }
}

validate_generic_arguments(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    expected_parameters: List<Parameter>,
    index: i64,
    bindings: List<TypeBinding>,
    call_span: SourceSpan,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        bindings
    } else {
        let declared = resolve_type(
            source,
            module,
            core::list_get(expected_parameters, index).parameter_type
        );
        let argument = core::list_get(arguments, index);
        let refined_bindings = refine_callable_argument_effect(
            source, module, parameters, declared, argument, bindings
        );
        let substituted = substitute_bindings(declared, refined_bindings);
        if(type_has_generic(substituted)) {
            let actual = infer_argument_type_against_expected(
                source,
                module,
                parameters,
                argument,
                substituted
            );
            let next_bindings = unify_types(
                source,
                substituted,
                actual,
                refined_bindings,
                expression_span(argument)
            );
            let expected = substitute_bindings(declared, next_bindings);
            validate_expression(source, module, parameters, expected, argument);
            validate_generic_arguments(
                source,
                module,
                parameters,
                arguments,
                expected_parameters,
                index + 1,
                next_bindings,
                call_span
            )
        } else {
            validate_expression(
                source,
                module,
                parameters,
                substituted,
                argument
            );
            validate_generic_arguments(
                source,
                module,
                parameters,
                arguments,
                expected_parameters,
                index + 1,
                refined_bindings,
                call_span
            )
        }
    }
}

infer_call_bindings(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    callable: CallableDecl,
    expected: TypeRef,
    span: SourceSpan,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let declared_result = resolve_type(source, module, callable.result_type);
    let result_bindings = unify_types(source, declared_result, expected, [], span);
    let bindings = bind_callable_constraints(
        source,
        module,
        callable.callable_constraints,
        0,
        result_bindings,
        span
    );
    let final_bindings = validate_generic_arguments(
        source,
        module,
        parameters,
        arguments,
        callable.parameters,
        0,
        bindings,
        span
    );
    validate_runs_in_post_environments(
        source, module, parameters, callable, arguments
    );
    let environment_bindings = synthesize_environment_bindings(
        callable, final_bindings, span, 0
    );
    validate_use_constraint_bindings(
        source,
        module,
        callable.use_constraints,
        environment_bindings,
        0,
        span
    );
    environment_bindings
}

type_mangle(reference: TypeRef) -> String / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Unit) => "unit",
        TypeCase::inspect(SourceType::Never) => "never",
        TypeCase::inspect(SourceType::String) => "string",
        TypeCase::inspect(SourceType::Str) => "str",
        TypeCase::inspect(SourceType::List(element)) =>
            "list__" + type_mangle(element),
        TypeCase::inspect(SourceType::I32) => "i32",
        TypeCase::inspect(SourceType::I64) => "i64",
        TypeCase::inspect(SourceType::Struct(name, arguments)) =>
            "struct_" + name + type_list_mangle(arguments, 0, ""),
        TypeCase::inspect(SourceType::Enum(name, arguments)) =>
            "enum_" + name + type_list_mangle(arguments, 0, ""),
        TypeCase::inspect(SourceType::Named(name)) => "named_" + name,
        TypeCase::inspect(SourceType::Applied(name, arguments)) =>
            "applied_" + name + type_list_mangle(arguments, 0, ""),
        TypeCase::inspect(SourceType::Generic(name)) => "generic_" + name,
        TypeCase::inspect(SourceType::Callable(output, effectful)) =>
            "fn0_" + (if(effectful) { "step" } else { "value" }) +
                "__" + type_mangle(output),
        TypeCase::inspect(SourceType::Resumption(input, output)) =>
            "resume__" + type_mangle(input) + "__" + type_mangle(output)
        ,
        TypeCase::inspect(SourceType::Available(environment)) =>
            "available__" + type_mangle(environment)
        ,
        TypeCase::inspect(SourceType::SharedReference(target)) =>
            "shared_ref__" + type_mangle(target),
        TypeCase::inspect(SourceType::UniqueReference(target)) =>
            "unique_ref__" + type_mangle(target),
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            "indirect__" + type_mangle(indirect_target(storage)),
        TypeCase::inspect(SourceType::Environment(name)) =>
            "environment__" + name
    }
}

type_list_mangle(
    references: List<TypeRef>,
    index: i64,
    output: String,
) -> String / {ResultCase, TypeCase} {
    if(index >= core::list_len(references)) {
        output
    } else {
        type_list_mangle(
            references,
            index + 1,
            output + "__" + type_mangle(core::list_get(references, index))
        )
    }
}

specialization_suffix(
    parameters: List<TypeParameter>,
    bindings: List<TypeBinding>,
    index: i64,
    output: String,
) -> String / {ResultCase, TypeBindingLookupCase, TypeCase, Diagnostics} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        handle perform TypeBindingLookupCase::lookup(
            lookup_type_binding(bindings, parameter.name, 0)
        ) {
            TypeBindingLookupCase::lookup(TypeBindingLookup::Found(value)) =>
                specialization_suffix(
                    parameters,
                    bindings,
                    index + 1,
                    output + "__" + type_mangle(value)
                ),
            TypeBindingLookupCase::lookup(TypeBindingLookup::Missing) =>
                compiler_error(
                    SourceFile { path: "<compiler>", text: "" },
                    "GRC9001",
                    "generic specialization invariant violated",
                    parameter.span,
                    "type parameter `" + parameter.name + "` has no inferred argument",
                    [],
                    "every emitted generic specialization must be fully concrete",
                    "report this compiler bug"
                )
        }
    }
}

specialize_parameters(
    parameters: List<Parameter>,
    bindings: List<TypeBinding>,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {ResultCase, TypeCase, TypeBindingLookupCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        specialize_parameters(
            parameters,
            bindings,
            index + 1,
            core::list_push(output, Parameter {
                name: parameter.name,
                span: parameter.span,
                parameter_type: substitute_bindings(parameter.parameter_type, bindings),
                is_local: parameter.is_local,
                drop_flag: parameter.drop_flag,
                llvm_name: parameter.llvm_name,
            })
        )
    }
}

effect_reference_name(
    source: SourceFile,
    reference: TypeRef,
) -> String / {ResultCase, TypeCase, Diagnostics} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Named(name)) => name,
        TypeCase::inspect(SourceType::Applied(name, _)) => name,
        TypeCase::inspect(_) => compiler_error(
            source,
            "GRC1820",
            "effect row entry is not an effect protocol",
            reference.span,
            "effect rows contain nominal effect names and applications",
            [],
            "value types and callable types cannot be performed",
            "use a declared effect such as `Console` or `Fail<E>`"
        )
    }
}

effect_reference_arity(reference: TypeRef) -> i64 / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Applied(_, arguments)) => core::list_len(arguments),
        TypeCase::inspect(_) => 0
    }
}

effect_reference_key(reference: TypeRef) -> String / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Named(name)) => name,
        TypeCase::inspect(SourceType::Applied(name, arguments)) =>
            name + type_list_mangle(arguments, 0, ""),
        TypeCase::inspect(_) => "<invalid-effect>"
    }
}

resolved_effect_arguments(
    parameters: List<TypeParameter>,
    bindings: List<TypeBinding>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase, TypeCase, TypeBindingLookupCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        resolved_effect_arguments(
            parameters,
            bindings,
            index + 1,
            core::list_push(output, substitute_bindings(TypeRef {
                kind: SourceType::Generic(parameter.name),
                span: parameter.span,
            }, bindings))
        )
    }
}

resolved_effect_reference(resolved: ResolvedEffectOperation) -> TypeRef / {
    ResultCase, TypeCase, TypeBindingLookupCase
} {
    let arguments = resolved_effect_arguments(
        resolved.effect.type_parameters,
        resolved.bindings,
        0,
        []
    );
    TypeRef {
        kind: if(core::list_len(arguments) == 0) {
            SourceType::Named(resolved.effect.name)
        } else {
            SourceType::Applied(resolved.effect.name, arguments)
        },
        span: resolved.effect.name_span,
    }
}

effect_key_is_present(
    effects: List<TypeRef>,
    key: String,
    index: i64,
) -> Bool / {ResultCase, TypeCase} {
    if(index >= core::list_len(effects)) {
        false
    } else {
        if(effect_reference_key(core::list_get(effects, index)) == key) {
            true
        } else {
            effect_key_is_present(effects, key, index + 1)
        }
    }
}

handled_effect_is_present(
    effects: List<String>,
    key: String,
    index: i64,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(effects)) {
        false
    } else {
        if(core::list_get(effects, index) == key) {
            true
        } else {
            handled_effect_is_present(effects, key, index + 1)
        }
    }
}

require_effect_available(
    source: SourceFile,
    allowed: List<TypeRef>,
    handled: List<String>,
    effect: TypeRef,
    span: SourceSpan,
    context: String,
) -> / {ResultCase, TypeCase, Diagnostics} {
    let key = effect_reference_key(effect);
    require(
        effect_key_is_present(allowed, key, 0) or
            handled_effect_is_present(handled, key, 0),
        error_diagnostic(
            source,
            "GRC1826",
            "effect escapes callable without appearing in its row",
            span,
            context + " requires effect `" + type_name(effect.kind) + "`",
            [],
            "every performed or called outward protocol must be declared or eliminated by an exhaustive handler",
            "add `" + type_name(effect.kind) + "` to the callable effect row or handle it here"
        )
    )
}

substitute_effect_row(
    effects: List<TypeRef>,
    bindings: List<TypeBinding>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase, TypeCase, TypeBindingLookupCase} {
    if(index == 0 and core::list_len(bindings) == 0) {
        effects
    } else {
    if(index >= core::list_len(effects)) {
        output
    } else {
        substitute_effect_row(
            effects,
            bindings,
            index + 1,
            core::list_push(
                output,
                substitute_bindings(core::list_get(effects, index), bindings)
            )
        )
    }
    }
}

validate_required_effects(
    source: SourceFile,
    effects: List<TypeRef>,
    allowed: List<TypeRef>,
    handled: List<String>,
    span: SourceSpan,
    context: String,
    index: i64,
) -> / {ResultCase, TypeCase, Diagnostics} {
    if(index >= core::list_len(effects)) {
        ()
    } else {
        require_effect_available(
            source,
            allowed,
            handled,
            core::list_get(effects, index),
            span,
            context
        );
        validate_required_effects(
            source, effects, allowed, handled, span, context, index + 1
        )
    }
}

effect_row_contains_name(
    source: SourceFile,
    effects: List<TypeRef>,
    limit: i64,
    name: String,
    index: i64,
) -> Bool / {ResultCase, TypeCase, Diagnostics} {
    if(index >= limit) {
        false
    } else {
        if(effect_reference_name(source, core::list_get(effects, index)) == name) {
            true
        } else {
            effect_row_contains_name(source, effects, limit, name, index + 1)
        }
    }
}

validate_effect_row(
    source: SourceFile,
    module: Module,
    effects: List<TypeRef>,
    index: i64,
) -> / {ResultCase, TypeCase, EffectLookupCase, Diagnostics} {
    if(index >= core::list_len(effects)) {
        ()
    } else {
        let reference = core::list_get(effects, index);
        let name = effect_reference_name(source, reference);
        require(
            effect_row_contains_name(source, effects, index, name, 0) == false,
            error_diagnostic(
                source,
                "GRC1821",
                "duplicate effect in callable row",
                reference.span,
                "effect protocol `" + name + "` appears more than once",
                [],
                "effect rows are sets of normalized nominal protocol keys",
                "remove the duplicate effect entry"
            )
        );
        handle perform EffectLookupCase::lookup(lookup_effect(module.effects, name, 0)) {
            EffectLookupCase::lookup(EffectLookup::Missing) => compiler_error(
                source,
                "GRC1822",
                "unknown effect in callable row",
                reference.span,
                "effect `" + name + "` is not declared in this module",
                [],
                "outward effects resolve through nominal effect declarations",
                "declare the effect or correct its name"
            ),
            EffectLookupCase::lookup(EffectLookup::Found(declaration)) => require(
                effect_reference_arity(reference) ==
                    core::list_len(declaration.type_parameters),
                error_diagnostic(
                    source,
                    "GRC1823",
                    "wrong number of effect type arguments",
                    reference.span,
                    "effect `" + name + "` expects " +
                        core::int_to_string(core::list_len(declaration.type_parameters)) +
                        " type argument(s), but receives " +
                        core::int_to_string(effect_reference_arity(reference)),
                    [DiagnosticLabel {
                        span: declaration.name_span,
                        message: "the effect is declared here",
                    }],
                    "effect protocol keys include their generic arguments",
                    "supply exactly one type argument for each effect parameter"
                )
            )
        };
        validate_effect_row(source, module, effects, index + 1)
    }
}

validate_effect_operation_quantities(
    source: SourceFile,
    module: Module,
    operations: List<EffectOperationDecl>,
    index: i64,
) -> / {ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics} {
    if(index >= core::list_len(operations)) {
        ()
    } else {
        let operation = core::list_get(operations, index);
        let result = resolve_type(source, module, operation.result_type);
        let terminal = result.kind == SourceType::Never;
        require(
            terminal == false or operation.has_resumption_quantity == false,
            error_diagnostic(
                source,
                "GRC1824",
                "terminal operation cannot declare a resumption quantity",
                operation.span,
                "operation `" + operation.name + "` returns `!` and has no continuation",
                [DiagnosticLabel {
                    span: operation.result_type.span,
                    message: "the terminal result is declared here",
                }],
                "terminal performance destroys the abandoned continuation before dispatch",
                "remove the `[lower, upper]` quantity"
            )
        );
        require(
            operation.resumption_lower >= 0 and
                (operation.resumption_upper == -1 or
                    operation.resumption_upper >= operation.resumption_lower),
            error_diagnostic(
                source,
                "GRC1825",
                "invalid resumption quantity interval",
                operation.span,
                "the upper bound is smaller than the lower bound",
                [],
                "resumption quantities are non-negative closed intervals; `infinity` is unbounded",
                "increase the upper bound or decrease the lower bound"
            )
        );
        validate_effect_operation_quantities(source, module, operations, index + 1)
    }
}

validate_effect_declarations(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics} {
    if(index >= core::list_len(module.effects)) {
        ()
    } else {
        validate_effect_operation_quantities(
            source,
            module,
            core::list_get(module.effects, index).operations,
            0
        );
        validate_effect_declarations(source, module, index + 1)
    }
}

validate_effect_expression_list(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expressions: List<Expression>,
    expected: List<Parameter>,
    allowed: List<TypeRef>,
    handled: List<String>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        ()
    } else {
        validate_effects_expression(
            source,
            module,
            parameters,
            core::list_get(expressions, index),
            core::list_get(expected, index).parameter_type,
            allowed,
            handled
        );
        validate_effect_expression_list(
            source, module, parameters, expressions, expected,
            allowed, handled, index + 1
        )
    }
}

validate_effect_call_arguments(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expressions: List<Expression>,
    callable: CallableDecl,
    expected: List<Parameter>,
    allowed: List<TypeRef>,
    handled: List<String>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    CallableConstraintLookupCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        ()
    } else {
        let declared = core::list_get(callable.parameters, index);
        let delayed = parameter_has_callable_constraint(callable, declared);
        let invocation_uses = if(delayed) {
            callable_parameter_invocation_uses(
                module, callable, declared.name, []
            )
        } else {
            ResumptionUseInterval { lower: 1, upper: 1 }
        };
        if(delayed and invocation_uses.upper == 0) {
            ()
        } else {
            validate_effects_expression(
                source, module, parameters,
                core::list_get(expressions, index),
                core::list_get(expected, index).parameter_type,
                allowed, handled
            )
        };
        validate_effect_call_arguments(
            source, module, parameters, expressions, callable, expected,
            allowed, handled, index + 1
        )
    }
}

parameters_from_types(
    references: List<TypeRef>,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {ResultCase} {
    if(index >= core::list_len(references)) {
        output
    } else {
        let reference = core::list_get(references, index);
        parameters_from_types(
            references,
            index + 1,
            core::list_push(output, Parameter {
                name: "",
                span: reference.span,
                parameter_type: reference,
                is_local: false,
                drop_flag: "",
                llvm_name: "",
            })
        )
    }
}

validate_effect_struct_fields(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    declaration: StructDecl,
    supplied: List<NamedExpression>,
    allowed: List<TypeRef>,
    handled: List<String>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(declaration.fields)) {
        ()
    } else {
        let field = core::list_get(declaration.fields, index);
        handle perform NamedExpressionLookupCase::lookup(
            lookup_named_expression(supplied, field.name, 0)
        ) {
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Found(value)) =>
                validate_effects_expression(
                    source, module, parameters, value.value, field.field_type,
                    allowed, handled
                ),
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Missing) => ()
        };
        validate_effect_struct_fields(
            source, module, parameters, declaration, supplied,
            allowed, handled, index + 1
        )
    }
}

validate_effect_block(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    expected: TypeRef,
    allowed: List<TypeRef>,
    handled: List<String>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name, name_span, local_type, value, _
        )) => {
            validate_effects_expression(
                source, module, parameters, value, local_type, allowed, handled
            );
            validate_effect_block(
                source,
                module,
                core::list_push(parameters, Parameter {
                    name: name,
                    span: name_span,
                    parameter_type: local_type,
                    is_local: true,
                    drop_flag: "",
                    llvm_name: "%local_" + name,
                }),
                statements,
                expected,
                allowed,
                handled,
                index + 1
            )
        },
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            let value_type = if(index + 1 >= core::list_len(statements)) {
                expected
            } else {
                infer_expression_type(source, module, parameters, value)
            };
            validate_effects_expression(
                source, module, parameters, value, value_type, allowed, handled
            );
            if(index + 1 >= core::list_len(statements)) {
                ()
            } else {
                validate_effect_block(
                    source, module, parameters, statements, expected,
                    allowed, handled, index + 1
                )
            }
        }
    }
}

validate_effect_handler_clauses(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    resolved: ResolvedEffectOperation,
    clauses: List<HandlerClause>,
    expected: TypeRef,
    allowed: List<TypeRef>,
    handled: List<String>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        ()
    } else {
        let clause = core::list_get(clauses, index);
        let branch_parameters = validate_pattern_list(
            source,
            module,
            clause.patterns,
            operation_parameter_types(resolved.parameters, 0, []),
            0,
            parameters
        );
        let operation_result = resolve_type(
            source,
            module,
            substitute_bindings(resolved.operation.result_type, resolved.bindings)
        );
        let clause_parameters = if(operation_result.kind == SourceType::Never) {
            branch_parameters
        } else {
            core::list_push(branch_parameters, Parameter {
                name: clause.resumption_name,
                span: clause.resumption_span,
                parameter_type: TypeRef {
                    kind: SourceType::Resumption(operation_result, expected),
                    span: clause.resumption_span,
                },
                is_local: true,
                drop_flag: "",
                llvm_name: "%resumption_" + clause.resumption_name,
            })
        };
        validate_effects_expression(
            source, module, clause_parameters, clause.body, expected,
            allowed, handled
        );
        validate_effect_handler_clauses(
            source, module, parameters, resolved, clauses, expected,
            allowed, handled, index + 1
        )
    }
}

validate_effects_expression(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    expected: TypeRef,
    allowed: List<TypeRef>,
    handled: List<String>,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    let expected = resolve_type(source, module, expected);
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            validate_effects_expression(
                source, module, parameters, value,
                infer_expression_type(source, module, parameters, value),
                allowed, handled
            ),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            validate_effects_expression(
                source, module, parameters, value,
                infer_expression_type(source, module, parameters, value),
                allowed, handled
            ),
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            validate_effects_expression(
                source, module, parameters, operand, expected, allowed, handled
            ),
        ExpressionCase::expression(Expression::Binary(operator, left, right, span)) => {
            let operand_type = if(operator_is_comparison(operator)) {
                comparison_expression_operand_type(
                    source, module, parameters, operator, left, right, span
                )
            } else {
                expected
            };
            validate_effects_expression(
                source, module, parameters, left, operand_type, allowed, handled
            );
            validate_effects_expression(
                source, module, parameters, right, operand_type, allowed, handled
            )
        },
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            if(name == "resume") {
                let continuation_type = resolve_type(
                    source,
                    module,
                    infer_expression_type(
                        source, module, parameters, core::list_get(arguments, 0)
                    )
                );
                handle perform TypeCase::inspect(continuation_type.kind) {
                    TypeCase::inspect(SourceType::Resumption(input, _)) =>
                        validate_effects_expression(
                            source,
                            module,
                            parameters,
                            core::list_get(arguments, 1),
                            input,
                            allowed,
                            handled
                        ),
                    TypeCase::inspect(_) => ()
                }
            } else {
                if(name == "cancel") {
                    ()
                } else {
                    handle perform ParameterLookupCase::lookup(
                        lookup_parameter(parameters, name, 0)
                    ) {
                        ParameterLookupCase::lookup(ParameterLookup::Found(_)) => (),
                        ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                    let callable = resolve_callable(source, module, name, span);
                    let bindings = if(core::list_len(callable.type_parameters) > 0) {
                        infer_call_bindings(
                            source, module, parameters, arguments, callable, expected, span
                        )
                    } else {
                        []
                    };
                    let call_effects = substitute_effect_row(
                        callable.effects, bindings, 0, []
                    );
                    validate_required_effects(
                        source,
                        call_effects,
                        allowed,
                        handled,
                        span,
                        "call to `" + name + "`",
                        0
                    );
                    validate_effect_call_arguments(
                        source,
                        module,
                        parameters,
                        arguments,
                        callable,
                        specialize_parameters(callable.parameters, bindings, 0, []),
                        allowed,
                        handled,
                        0
                    )
                        }
                    }
                }
            }
        },
        ExpressionCase::expression(Expression::StructValue(name, fields, span)) => {
            handle perform StructLookupCase::lookup(lookup_struct(module.structs, name, 0)) {
                StructLookupCase::lookup(StructLookup::Found(declaration)) =>
                    validate_effect_struct_fields(
                        source, module, parameters, declaration, fields,
                        allowed, handled, 0
                    ),
                StructLookupCase::lookup(StructLookup::Missing) => ()
            }
        },
        ExpressionCase::expression(Expression::Field(subject, _, _)) => {
            let subject_type = infer_expression_type(source, module, parameters, subject);
            validate_effects_expression(
                source, module, parameters, subject, subject_type, allowed, handled
            )
        },
        ExpressionCase::expression(Expression::EnumValue(
            enum_name, variant_name, arguments, span
        )) => {
            let enum_arguments = expected_enum_arguments(
                source, expected, enum_name, span
            );
            handle perform EnumLookupCase::lookup(lookup_enum(module.enums, enum_name, 0)) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                    handle perform VariantLookupCase::lookup(
                        lookup_variant(declaration.variants, variant_name, 0)
                    ) {
                        VariantLookupCase::lookup(VariantLookup::Found(variant)) =>
                            validate_effect_expression_list(
                                source,
                                module,
                                parameters,
                                arguments,
                                specialize_parameters(
                                    parameters_from_types(
                                        substitute_types(
                                            variant.fields,
                                            declaration.type_parameters,
                                            enum_arguments,
                                            0,
                                            []
                                        ),
                                        0,
                                        []
                                    ),
                                    [],
                                    0,
                                    []
                                ),
                                allowed,
                                handled,
                                0
                            ),
                        VariantLookupCase::lookup(VariantLookup::Missing) => ()
                    }
                },
                EnumLookupCase::lookup(EnumLookup::Missing) => ()
            }
        },
        ExpressionCase::expression(Expression::Perform(
            effect_name, operation_name, arguments, span
        )) => {
            let resolved = resolve_perform_operation(
                source, module, parameters, effect_name, operation_name, arguments, span
            );
            require_effect_available(
                source,
                allowed,
                handled,
                resolved_effect_reference(resolved),
                span,
                "performance of `" + effect_name + "::" + operation_name + "`"
            );
            validate_effect_expression_list(
                source, module, parameters, arguments, resolved.parameters,
                allowed, handled, 0
            )
        },
        ExpressionCase::expression(Expression::Handle(computation, clauses, span)) => {
            handle perform ExpressionCase::expression(computation) {
                ExpressionCase::expression(Expression::Perform(
                    effect_name, operation_name, arguments, perform_span
                )) => {
                    let resolved = resolve_perform_operation(
                        source, module, parameters,
                        effect_name, operation_name, arguments, perform_span
                    );
                    let key = effect_reference_key(resolved_effect_reference(resolved));
                    let inner_handled = if(resumptive_handler_is_exhaustive(
                        source, module, resolved, clauses
                    )) {
                        core::list_push(handled, key)
                    } else {
                        handled
                    };
                    validate_effects_expression(
                        source,
                        module,
                        parameters,
                        computation,
                        substitute_bindings(
                            resolved.operation.result_type,
                            resolved.bindings
                        ),
                        allowed,
                        inner_handled
                    );
                    validate_effect_handler_clauses(
                        source, module, parameters, resolved, clauses, expected,
                        allowed, inner_handled, 0
                    )
                },
                ExpressionCase::expression(_) => {
                    let first = core::list_get(clauses, 0);
                    let resolved = resolve_handler_operation_declaration(
                        source,
                        module,
                        first.effect_name,
                        first.operation_name,
                        first.span
                    );
                    let key = effect_reference_key(resolved_effect_reference(resolved));
                    let exhaustive = resumptive_handler_is_exhaustive(
                        source, module, resolved, clauses
                    );
                    require(
                        exhaustive or effect_key_is_present(allowed, key, 0) or
                            handled_effect_is_present(handled, key, 0),
                        error_diagnostic(
                            source,
                            "GRC1832",
                            "non-exhaustive resumptive handler",
                            span,
                            "no clause accepts every operation argument",
                            [DiagnosticLabel {
                                span: resolved.operation.name_span,
                                message: "the handled operation is declared here",
                            }],
                            "partial inline handlers forward uncovered operations and therefore cannot remove the protocol",
                            "add a clause using bindings or `_` for every operation argument"
                        )
                    );
                    let inner_handled = if(exhaustive) {
                        core::list_push(handled, key)
                    } else {
                        handled
                    };
                    validate_effects_expression(
                        source,
                        module,
                        parameters,
                        computation,
                        expected,
                        allowed,
                        inner_handled
                    );
                    validate_effect_handler_clauses(
                        source, module, parameters, resolved, clauses, expected,
                        allowed, inner_handled, 0
                    )
                }
            }
        },
        ExpressionCase::expression(Expression::Block(statements, _)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Callable(output, _)) =>
                    validate_effect_block(
                        source, module, parameters, statements, output,
                        allowed, handled, 0
                    ),
                TypeCase::inspect(_) => validate_effect_block(
                    source, module, parameters, statements, expected,
                    allowed, handled, 0
                )
            }
        },
        ExpressionCase::expression(_) => ()
    }
}

borrowed_place_name(expression: Expression) -> String / {ExpressionCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Variable(name, _)) => name,
        ExpressionCase::expression(Expression::Field(subject, field, _)) =>
            borrowed_place_name(subject) + "." + field,
        ExpressionCase::expression(Expression::Dereference(subject, _)) =>
            "*" + borrowed_place_name(subject),
        ExpressionCase::expression(_) => "<temporary>"
    }
}

borrowed_place_root(expression: Expression) -> String / {ExpressionCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Variable(name, _)) => name,
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            borrowed_place_root(subject),
        ExpressionCase::expression(Expression::Dereference(_, _)) => "",
        ExpressionCase::expression(_) => ""
    }
}

block_statement_expression(statement: BlockStatement) -> Expression / {
    BlockStatementCase
} {
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(_, _, _, value, _)) =>
            value,
        BlockStatementCase::inspect(BlockStatement::Value(value)) => value
    }
}

borrow_origin(expression: Expression) -> BorrowOrigin / {
    ResultCase, ExpressionCase, BlockStatementCase
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(
            place, unique, span
        )) => {
            let provenance = place_provenance(place);
            BorrowOrigin {
                found: provenance.found,
                place: provenance.place,
                root: provenance.root,
                parent_reference: provenance.parent_reference,
                unique: unique,
                span: span,
            }
        },
        ExpressionCase::expression(Expression::Block(statements, span)) => {
            if(core::list_len(statements) == 0) {
                BorrowOrigin {
                    found: false,
                    place: "",
                    root: "",
                    parent_reference: "",
                    unique: false,
                    span: span,
                }
            } else {
                borrow_origin(block_statement_expression(core::list_get(
                    statements, core::list_len(statements) - 1
                )))
            }
        },
        ExpressionCase::expression(_) => BorrowOrigin {
            found: false,
            place: "",
            root: "",
            parent_reference: "",
            unique: false,
            span: expression_span(expression),
        }
    }
}

borrow_origin_for_binding(
    expression: Expression,
    binding_type: TypeRef,
) -> BorrowOrigin / {ResultCase, ExpressionCase, TypeCase, BlockStatementCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Block(_, _)) => {
            handle perform TypeCase::inspect(binding_type.kind) {
                TypeCase::inspect(SourceType::SharedReference(_)) =>
                    borrow_origin(expression),
                TypeCase::inspect(SourceType::UniqueReference(_)) =>
                    borrow_origin(expression),
                TypeCase::inspect(_) => BorrowOrigin {
                    found: false,
                    place: "",
                    root: "",
                    parent_reference: "",
                    unique: false,
                    span: expression_span(expression),
                }
            }
        },
        ExpressionCase::expression(_) => borrow_origin(expression)
    }
}

last_reference_use_index(
    statements: List<BlockStatement>,
    reference_name: String,
    index: i64,
    last: i64,
) -> i64 / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(statements)) {
        last
    } else {
        last_reference_use_index(
            statements, reference_name, index + 1,
            if(expression_mentions_name(
                block_statement_expression(core::list_get(statements, index)),
                reference_name
            )) {
                index
            } else {
                last
            }
        )
    }
}

lookup_borrow_loan_exact_place(
    loans: List<BorrowLoan>,
    reference_name: String,
    index: i64,
) -> String / {ResultCase} {
    if(index >= core::list_len(loans)) {
        ""
    } else {
        let loan = core::list_get(loans, index);
        if(loan.reference_name == reference_name) {
            loan.place
        } else {
            lookup_borrow_loan_exact_place(
                loans, reference_name, index + 1
            )
        }
    }
}

collect_borrow_loans(
    source: SourceFile,
    module: Module,
    statements: List<BlockStatement>,
    index: i64,
    output: List<BorrowLoan>,
) -> List<BorrowLoan> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(statements)) {
        output
    } else {
        let next = handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, _, local_type, value, _
            )) => {
                let origin = borrow_origin_for_binding(value, local_type);
                if(origin.found) {
                    let parent_place = lookup_borrow_loan_exact_place(
                        output, origin.parent_reference, 0
                    );
                    let parent_root = lookup_borrow_loan_place(
                        output, origin.parent_reference, 0
                    );
                    core::list_push(output, BorrowLoan {
                        place: if(parent_place == "") {
                            origin.place
                        } else {
                            parent_place
                        },
                        root: if(parent_root == "") {
                            origin.root
                        } else {
                            parent_root
                        },
                        parent_reference: origin.parent_reference,
                        reference_name: name,
                        unique: origin.unique,
                        start_index: index,
                        last_use_index: last_reference_use_index(
                            statements, name, index + 1, index
                        ),
                        span: origin.span,
                    })
                } else {
                    let call_root = reference_call_result_root(
                        source, module, output, value, []
                    );
                    if(call_root == "") {
                        output
                    } else {
                        let call_unique = handle perform TypeCase::inspect(
                            local_type.kind
                        ) {
                            TypeCase::inspect(SourceType::UniqueReference(_)) => true,
                            TypeCase::inspect(_) => false
                        };
                        core::list_push(output, BorrowLoan {
                            place: call_root,
                            root: call_root,
                            parent_reference: "",
                            reference_name: name,
                            unique: call_unique,
                            start_index: index,
                            last_use_index: last_reference_use_index(
                                statements, name, index + 1, index
                            ),
                            span: expression_span(value),
                        })
                    }
                }
            },
            BlockStatementCase::inspect(BlockStatement::Value(_)) => output
        };
        collect_borrow_loans(
            source, module, statements, index + 1, next
        )
    }
}

validate_borrow_loan_pairs(
    source: SourceFile,
    loans: List<BorrowLoan>,
    first_index: i64,
    second_index: i64,
) -> / {ResultCase, Diagnostics} {
    if(first_index >= core::list_len(loans)) {
        ()
    } else {
        if(second_index >= core::list_len(loans)) {
            validate_borrow_loan_pairs(
                source, loans, first_index + 1, first_index + 2
            )
        } else {
            let first = core::list_get(loans, first_index);
            let second = core::list_get(loans, second_index);
            require(
                borrowed_places_overlap(first, second) == false or
                    second.start_index > first.last_use_index or
                    second.parent_reference == first.reference_name or
                    (first.unique == false and second.unique == false),
                error_diagnostic(
                    source, "GRC1861", "overlapping incompatible borrows",
                    second.span,
                    "this " + (if(second.unique) { "unique" } else { "shared" }) +
                        " borrow overlaps an active borrow of `" +
                        second.place + "`",
                    [DiagnosticLabel {
                        span: first.span,
                        message: "the earlier " +
                            (if(first.unique) { "unique" } else { "shared" }) +
                            " borrow remains live through its last use",
                    }],
                    "nonlexical loans end after the final use of their reference binding",
                    "end the earlier reference use before taking this borrow"
                )
            );
            validate_borrow_loan_pairs(
                source, loans, first_index, second_index + 1
            )
        }
    }
}

place_is_prefix(prefix: String, place: String) -> Bool {
    let prefix_length = core::str_byte_len(prefix);
    prefix == place or
        (core::str_byte_len(place) > prefix_length and
            core::str_find(place, prefix) == 0 and
            core::str_slice(
                place, prefix_length, prefix_length + 1
            ) == ".")
}

borrowed_places_overlap(first: BorrowLoan, second: BorrowLoan) -> Bool {
    first.root != "" and first.root == second.root and
        (place_is_prefix(first.place, second.place) or
            place_is_prefix(second.place, first.place))
}

expression_mentions_place_outside_borrow(
    expression: Expression,
    place: String,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(target, _, _)) =>
            borrowed_place_root(target) != place and
                expression_mentions_name(expression, place),
        ExpressionCase::expression(_) =>
            expression_mentions_name(expression, place)
    }
}

validate_unique_loan_statement_accesses(
    source: SourceFile,
    statements: List<BlockStatement>,
    loan: BorrowLoan,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, BlockStatementCase, Diagnostics
} {
    if(index > loan.last_use_index) {
        ()
    } else {
        let expression = block_statement_expression(
            core::list_get(statements, index)
        );
        require(
            expression_mentions_place_outside_borrow(
                expression, loan.root
            ) == false,
            error_diagnostic(
                source, "GRC1863", "place accessed during unique borrow",
                expression_span(expression),
                "`" + loan.root +
                    "` is accessed directly while uniquely borrowed",
                [DiagnosticLabel {
                    span: loan.span,
                    message: "this unique loan remains live through its last reference use",
                }],
                "a unique borrow excludes every other access to its base place",
                "use the unique reference or end its final use before accessing the place"
            )
        );
        validate_unique_loan_statement_accesses(
            source, statements, loan, index + 1
        )
    }
}

borrow_parent_is_unique(
    loans: List<BorrowLoan>,
    reference_name: String,
    index: i64,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(loans)) {
        false
    } else {
        let loan = core::list_get(loans, index);
        if(loan.reference_name == reference_name) {
            loan.unique
        } else {
            borrow_parent_is_unique(
                loans, reference_name, index + 1
            )
        }
    }
}

validate_reborrow_parent_accesses(
    source: SourceFile,
    statements: List<BlockStatement>,
    loan: BorrowLoan,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, BlockStatementCase, Diagnostics
} {
    if(index > loan.last_use_index) {
        ()
    } else {
        let expression = block_statement_expression(
            core::list_get(statements, index)
        );
        require(
            expression_mentions_name(
                expression, loan.parent_reference
            ) == false,
            error_diagnostic(
                source, "GRC1863", "parent reference used during reborrow",
                expression_span(expression),
                "`" + loan.parent_reference +
                    "` is used while its child reborrow is live",
                [DiagnosticLabel {
                    span: loan.span,
                    message: "this reborrow remains live through its final use",
                }],
                "a unique reborrow temporarily suspends access through its parent reference",
                "use the child reference or end its final use before reusing the parent"
            )
        );
        validate_reborrow_parent_accesses(
            source, statements, loan, index + 1
        )
    }
}

validate_unique_loan_accesses(
    source: SourceFile,
    statements: List<BlockStatement>,
    loans: List<BorrowLoan>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(loans)) {
        ()
    } else {
        let loan = core::list_get(loans, index);
        if(loan.unique and loan.root != "") {
            validate_unique_loan_statement_accesses(
                source, statements, loan, loan.start_index + 1
            )
        } else {
            ()
        };
        if(loan.parent_reference != "" and
            (loan.unique or borrow_parent_is_unique(
                loans, loan.parent_reference, 0
            ))) {
            validate_reborrow_parent_accesses(
                source, statements, loan, loan.start_index + 1
            )
        } else {
            ()
        };
        validate_unique_loan_accesses(
            source, statements, loans, index + 1
        )
    }
}

block_declares_place(
    statements: List<BlockStatement>,
    place: String,
    index: i64,
) -> Bool / {ResultCase, BlockStatementCase} {
    if(index >= core::list_len(statements)) {
        false
    } else {
        handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, _, _, _, _
            )) => place == name or
                block_declares_place(statements, place, index + 1),
            BlockStatementCase::inspect(BlockStatement::Value(_)) =>
                block_declares_place(statements, place, index + 1)
        }
    }
}

lookup_borrow_loan_place(
    loans: List<BorrowLoan>,
    reference_name: String,
    index: i64,
) -> String / {ResultCase} {
    if(index >= core::list_len(loans)) {
        ""
    } else {
        let loan = core::list_get(loans, index);
        if(loan.reference_name == reference_name) {
            loan.root
        } else {
            lookup_borrow_loan_place(loans, reference_name, index + 1)
        }
    }
}

reference_parameter_index(
    parameters: List<Parameter>,
    name: String,
    index: i64,
) -> i64 / {ResultCase, TypeCase} {
    if(index >= core::list_len(parameters)) {
        -1
    } else {
        let parameter = core::list_get(parameters, index);
        if(parameter.name == name) {
            handle perform TypeCase::inspect(parameter.parameter_type.kind) {
                TypeCase::inspect(SourceType::SharedReference(_)) => index,
                TypeCase::inspect(SourceType::UniqueReference(_)) => index,
                TypeCase::inspect(_) => -1
            }
        } else {
            reference_parameter_index(parameters, name, index + 1)
        }
    }
}

reference_return_parameter_expression(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    visiting: List<String>,
) -> i64 / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Variable(name, _)) =>
            reference_parameter_index(parameters, name, 0),
        ExpressionCase::expression(Expression::Block(statements, _)) => {
            if(core::list_len(statements) == 0) {
                -1
            } else {
                reference_return_parameter_expression(
                    source, module, parameters,
                    block_statement_expression(core::list_get(
                        statements, core::list_len(statements) - 1
                    )),
                    visiting
                )
            }
        },
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            handle perform ParameterLookupCase::lookup(
                lookup_parameter(parameters, name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(_)) => -1,
                ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                    let called = resolve_callable(source, module, name, span);
                    if(name_is_present(visiting, called.name, 0)) {
                        -1
                    } else {
                        let returned = reference_return_parameter_expression(
                            source, module, called.parameters, called.body,
                            core::list_push(visiting, called.name)
                        );
                        if(returned < 0 or returned >= core::list_len(arguments)) {
                            -1
                        } else {
                            reference_return_parameter_expression(
                                source, module, parameters,
                                core::list_get(arguments, returned), visiting
                            )
                        }
                    }
                }
            }
        },
        ExpressionCase::expression(_) => -1
    }
}

reference_call_result_root(
    source: SourceFile,
    module: Module,
    loans: List<BorrowLoan>,
    expression: Expression,
    visiting: List<String>,
) -> String / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(place, _, _)) => {
            let provenance = place_provenance(place);
            if(provenance.root != "") {
                provenance.root
            } else {
                lookup_borrow_loan_place(
                    loans, provenance.parent_reference, 0
                )
            }
        },
        ExpressionCase::expression(Expression::Variable(name, _)) =>
            lookup_borrow_loan_place(loans, name, 0),
        ExpressionCase::expression(Expression::Block(statements, _)) => {
            if(core::list_len(statements) == 0) {
                ""
            } else {
                reference_call_result_root(
                    source, module, loans,
                    block_statement_expression(core::list_get(
                        statements, core::list_len(statements) - 1
                    )),
                    visiting
                )
            }
        },
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            if(name_is_present(visiting, name, 0)) {
                ""
            } else {
                handle perform LookupCase::lookup(
                    lookup_callable(module.callables, name, 0)
                ) {
                    LookupCase::lookup(CallableLookup::Missing) => "",
                    LookupCase::lookup(CallableLookup::Found(called)) => {
                        let returned = reference_return_parameter_expression(
                            source, module, called.parameters, called.body,
                            core::list_push(visiting, called.name)
                        );
                        if(returned < 0 or
                            returned >= core::list_len(arguments)) {
                            ""
                        } else {
                            reference_call_result_root(
                                source, module, loans,
                                core::list_get(arguments, returned),
                                core::list_push(visiting, called.name)
                            )
                        }
                    }
                }
            }
        },
        ExpressionCase::expression(_) => ""
    }
}

validate_reference_return(
    source: SourceFile,
    module: Module,
    statements: List<BlockStatement>,
    loans: List<BorrowLoan>,
    reject_outer_places: Bool,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    if(core::list_len(statements) == 0) {
        ()
    } else {
        let final = block_statement_expression(core::list_get(
            statements, core::list_len(statements) - 1
        ));
        let escaping_place = handle perform ExpressionCase::expression(final) {
            ExpressionCase::expression(Expression::Borrow(place, _, _)) =>
                borrowed_place_root(place),
            ExpressionCase::expression(Expression::Variable(name, _)) =>
                lookup_borrow_loan_place(loans, name, 0),
            ExpressionCase::expression(Expression::Call(_, _, _)) =>
                reference_call_result_root(
                    source, module, loans, final, []
                ),
            ExpressionCase::expression(_) => ""
        };
        let scope_name = if(reject_outer_places) {
            "call-local"
        } else {
            "block-local"
        };
        require(
            escaping_place == "" or
                (reject_outer_places == false and
                    block_declares_place(
                        statements, escaping_place, 0
                    ) == false),
            error_diagnostic(
                source, "GRC1862", "borrowed place escapes its lifetime",
                expression_span(final),
                "this returned reference points into " + scope_name + " place `" +
                    escaping_place + "`", [],
                scope_name + " storage ends when its enclosing scope exits",
                "return an incoming reference or an owned value instead"
            )
        )
    }
}

validate_borrow_conflicts_block(
    source: SourceFile,
    module: Module,
    statements: List<BlockStatement>,
    reject_outer_places: Bool,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    let loans = collect_borrow_loans(source, module, statements, 0, []);
    validate_borrow_loan_pairs(source, loans, 0, 1);
    validate_unique_loan_accesses(source, statements, loans, 0);
    validate_reference_return(
        source, module, statements, loans, reject_outer_places
    )
}

validate_borrow_expression_list(
    source: SourceFile,
    module: Module,
    expressions: List<Expression>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        ()
    } else {
        validate_borrow_blocks_expression(
            source, module, core::list_get(expressions, index), false
        );
        validate_borrow_expression_list(
            source, module, expressions, index + 1
        )
    }
}

validate_borrow_named_expression_list(
    source: SourceFile,
    module: Module,
    expressions: List<NamedExpression>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        ()
    } else {
        validate_borrow_blocks_expression(
            source, module, core::list_get(expressions, index).value, false
        );
        validate_borrow_named_expression_list(
            source, module, expressions, index + 1
        )
    }
}

validate_borrow_handler_clause_list(
    source: SourceFile,
    module: Module,
    clauses: List<HandlerClause>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        ()
    } else {
        validate_borrow_blocks_expression(
            source, module, core::list_get(clauses, index).body, false
        );
        validate_borrow_handler_clause_list(
            source, module, clauses, index + 1
        )
    }
}

validate_borrow_block_children(
    source: SourceFile,
    module: Module,
    statements: List<BlockStatement>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(statements)) {
        ()
    } else {
        validate_borrow_blocks_expression(
            source,
            module,
            block_statement_expression(core::list_get(statements, index)),
            false
        );
        validate_borrow_block_children(
            source, module, statements, index + 1
        )
    }
}

validate_borrow_blocks_expression(
    source: SourceFile,
    module: Module,
    expression: Expression,
    callable_root: Bool,
) -> / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, _)) =>
            validate_borrow_expression_list(source, module, items, 0),
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            validate_borrow_blocks_expression(source, module, value, false),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            validate_borrow_blocks_expression(source, module, value, false),
        ExpressionCase::expression(Expression::Destroy(value, _)) =>
            validate_borrow_blocks_expression(source, module, value, false),
        ExpressionCase::expression(Expression::ConsumeAvailable(value, _)) =>
            validate_borrow_blocks_expression(source, module, value, false),
        ExpressionCase::expression(Expression::Negate(value, _)) =>
            validate_borrow_blocks_expression(source, module, value, false),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) => {
            validate_borrow_blocks_expression(source, module, left, false);
            validate_borrow_blocks_expression(source, module, right, false)
        },
        ExpressionCase::expression(Expression::Call(_, arguments, _)) =>
            validate_borrow_expression_list(source, module, arguments, 0),
        ExpressionCase::expression(Expression::StructValue(_, fields, _)) =>
            validate_borrow_named_expression_list(source, module, fields, 0),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            validate_borrow_blocks_expression(source, module, subject, false),
        ExpressionCase::expression(Expression::EnumValue(
            _, _, arguments, _
        )) => validate_borrow_expression_list(source, module, arguments, 0),
        ExpressionCase::expression(Expression::Block(statements, _)) => {
            validate_borrow_conflicts_block(
                source, module, statements, callable_root
            );
            validate_borrow_block_children(source, module, statements, 0)
        },
        ExpressionCase::expression(Expression::Perform(
            _, _, arguments, _
        )) => validate_borrow_expression_list(source, module, arguments, 0),
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, _
        )) => {
            validate_borrow_blocks_expression(
                source, module, computation, false
            );
            validate_borrow_handler_clause_list(source, module, clauses, 0)
        },
        ExpressionCase::expression(_) => ()
    }
}

validate_callable_bodies(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics
} {
    if(index >= core::list_len(module.callables)) {
        ()
    } else {
        let callable = core::list_get(module.callables, index);
        if(compiler_core_intrinsic(callable.name)) {
            validate_callable_bodies(source, module, index + 1)
        } else {
        validate_effect_row(source, module, callable.effects, 0);
        validate_use_constraints(source, callable.use_constraints, 0);
        validate_environment_constraints(
            source, callable.environment_constraints, 0
        );
        validate_runs_in_constraints(source, callable, 0);
        let constraint_bindings = bind_callable_constraints(
            source,
            module,
            callable.callable_constraints,
            0,
            [],
            callable.span
        );
        let has_constraint_bindings =
            core::list_len(constraint_bindings) > 0;
        let constrained_body = if(has_constraint_bindings) {
            substitute_expression_bindings(callable.body, constraint_bindings)
        } else {
            callable.body
        };
        let constrained_result = if(has_constraint_bindings) {
            substitute_bindings(callable.result_type, constraint_bindings)
        } else {
            callable.result_type
        };
        let constrained_parameters = if(has_constraint_bindings) {
            specialize_parameters(
                callable.parameters, constraint_bindings, 0, []
            )
        } else {
            callable.parameters
        };
        let constrained_effects = if(has_constraint_bindings) {
            substitute_effect_row(
                callable.effects, constraint_bindings, 0, []
            )
        } else {
            callable.effects
        };
        validate_expression_with_constraints(
            source,
            module,
            constrained_parameters,
            callable.use_constraints,
            constrained_result,
            constrained_body
        );
        validate_effects_expression(
            source,
            module,
            constrained_parameters,
            constrained_body,
            constrained_result,
            constrained_effects,
            []
        );
        validate_borrow_blocks_expression(
            source, module, constrained_body, true
        );
        validate_callable_bodies(source, module, index + 1)
        }
    }
}

unrestricted_use_interval() -> ResumptionUseInterval {
    ResumptionUseInterval { lower: 0, upper: -1 }
}

use_interval_contains(
    available: ResumptionUseInterval,
    requested: ResumptionUseInterval,
) -> Bool {
    available.lower <= requested.lower and
        (available.upper == -1 or
            (requested.upper != -1 and requested.upper <= available.upper))
}

use_interval_text(interval: ResumptionUseInterval) -> String {
    "[" + core::int_to_string(interval.lower) + "," +
        (if(interval.upper == -1) {
            "infinity"
        } else {
            core::int_to_string(interval.upper)
        }) + "]"
}

lookup_manual_use_interval(
    source: SourceFile,
    module: Module,
    target: TypeRef,
    index: i64,
) -> UseIntervalMatch / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.use_declarations)) {
        UseIntervalMatch {
            found: false,
            interval: unrestricted_use_interval(),
            span: target.span,
        }
    } else {
        let declaration = core::list_get(module.use_declarations, index);
        let declared_target = resolve_type(source, module, declaration.target);
        if(same_type(declared_target, target)) {
            UseIntervalMatch {
                found: true,
                interval: ResumptionUseInterval {
                    lower: declaration.lower,
                    upper: declaration.upper,
                },
                span: declaration.quantity_span,
            }
        } else {
            lookup_manual_use_interval(source, module, target, index + 1)
        }
    }
}

principal_use_interval(
    source: SourceFile,
    module: Module,
    reference: TypeRef,
    path: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let resolved = resolve_type(source, module, reference);
    let manual = lookup_manual_use_interval(source, module, resolved, 0);
    if(manual.found) {
        manual.interval
    } else {
        structural_use_interval(source, module, resolved, path)
    }
}

intersect_use_intervals(
    source: SourceFile,
    first: ResumptionUseInterval,
    second: ResumptionUseInterval,
    span: SourceSpan,
) -> ResumptionUseInterval / {ResultCase, Diagnostics} {
    let lower = if(first.lower > second.lower) { first.lower } else { second.lower };
    let upper = if(first.upper == -1) {
        second.upper
    } else {
        if(second.upper == -1) {
            first.upper
        } else {
            if(first.upper < second.upper) { first.upper } else { second.upper }
        }
    };
    require(
        upper == -1 or lower <= upper,
        error_diagnostic(
            source,
            "GRC1842",
            "nominal fields have incompatible use intervals",
            span,
            "the structural interval intersection is empty",
            [],
            "a nominal value must support one use interval that is safe for every possible field",
            "change the field ownership requirements or separate them into different values"
        )
    );
    ResumptionUseInterval { lower: lower, upper: upper }
}

struct_fields_use_interval(
    source: SourceFile,
    module: Module,
    declaration: StructDecl,
    arguments: List<TypeRef>,
    index: i64,
    path: List<String>,
    interval: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(declaration.fields)) {
        interval
    } else {
        let field = core::list_get(declaration.fields, index);
        let field_type = substitute_type(
            field.field_type,
            declaration.type_parameters,
            arguments
        );
        struct_fields_use_interval(
            source,
            module,
            declaration,
            arguments,
            index + 1,
            path,
            intersect_use_intervals(
                source,
                interval,
                principal_use_interval(source, module, field_type, path),
                field.name_span
            )
        )
    }
}

variant_fields_use_interval(
    source: SourceFile,
    module: Module,
    declaration: EnumDecl,
    arguments: List<TypeRef>,
    variant: VariantDecl,
    index: i64,
    path: List<String>,
    interval: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(variant.fields)) {
        interval
    } else {
        let field_type = substitute_type(
            core::list_get(variant.fields, index),
            declaration.type_parameters,
            arguments
        );
        variant_fields_use_interval(
            source,
            module,
            declaration,
            arguments,
            variant,
            index + 1,
            path,
            intersect_use_intervals(
                source,
                interval,
                principal_use_interval(source, module, field_type, path),
                variant.span
            )
        )
    }
}

enum_variants_use_interval(
    source: SourceFile,
    module: Module,
    declaration: EnumDecl,
    arguments: List<TypeRef>,
    index: i64,
    path: List<String>,
    interval: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(declaration.variants)) {
        interval
    } else {
        let variant = core::list_get(declaration.variants, index);
        let variant_interval = variant_fields_use_interval(
            source,
            module,
            declaration,
            arguments,
            variant,
            0,
            path,
            unrestricted_use_interval()
        );
        enum_variants_use_interval(
            source,
            module,
            declaration,
            arguments,
            index + 1,
            path,
            intersect_use_intervals(
                source, interval, variant_interval, variant.span
            )
        )
    }
}

structural_use_interval(
    source: SourceFile,
    module: Module,
    resolved: TypeRef,
    path: List<String>,
) -> ResumptionUseInterval / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    handle perform TypeCase::inspect(resolved.kind) {
        TypeCase::inspect(SourceType::SharedReference(_)) =>
            unrestricted_use_interval(),
        TypeCase::inspect(SourceType::UniqueReference(_)) =>
            ResumptionUseInterval { lower: 0, upper: 1 },
        TypeCase::inspect(SourceType::Callable(_, _)) =>
            ResumptionUseInterval { lower: 0, upper: 1 },
        TypeCase::inspect(SourceType::Available(environment)) => {
            let environment_interval = principal_use_interval(
                source, module, environment, path
            );
            if(environment_interval.lower == 0) {
                ResumptionUseInterval { lower: 0, upper: 1 }
            } else {
                ResumptionUseInterval { lower: 1, upper: 1 }
            }
        },
        TypeCase::inspect(SourceType::Struct(name, arguments)) => {
            let key = type_name(resolved.kind);
            require(
                name_is_present(path, key, 0) == false,
                error_diagnostic(
                    source,
                    "GRC1843",
                    "recursive ownership layout",
                    resolved.span,
                    "`" + key + "` contains itself by value",
                    [],
                    "principal use derivation follows the same finite field graph as value layout",
                    "introduce an indirection instead of a recursive by-value field"
                )
            );
            handle perform StructLookupCase::lookup(
                lookup_struct(module.structs, name, 0)
            ) {
                StructLookupCase::lookup(StructLookup::Found(declaration)) =>
                    struct_fields_use_interval(
                        source,
                        module,
                        declaration,
                        arguments,
                        0,
                        core::list_push(path, key),
                        unrestricted_use_interval()
                    ),
                StructLookupCase::lookup(StructLookup::Missing) =>
                    unrestricted_use_interval()
            }
        },
        TypeCase::inspect(SourceType::Enum(name, arguments)) => {
            let key = type_name(resolved.kind);
            require(
                name_is_present(path, key, 0) == false,
                error_diagnostic(
                    source,
                    "GRC1843",
                    "recursive ownership layout",
                    resolved.span,
                    "`" + key + "` contains itself by value",
                    [],
                    "principal use derivation follows every possible enum payload",
                    "introduce an indirection instead of a recursive by-value payload"
                )
            );
            handle perform EnumLookupCase::lookup(
                lookup_enum(module.enums, name, 0)
            ) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) =>
                    enum_variants_use_interval(
                        source,
                        module,
                        declaration,
                        arguments,
                        0,
                        core::list_push(path, key),
                        unrestricted_use_interval()
                    ),
                EnumLookupCase::lookup(EnumLookup::Missing) =>
                    unrestricted_use_interval()
            }
        },
        TypeCase::inspect(_) => unrestricted_use_interval()
    }
}

validate_use_declaration_duplicates(
    source: SourceFile,
    module: Module,
    declaration: UseDecl,
    target: TypeRef,
    index: i64,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.use_declarations)) {
        ()
    } else {
        let candidate = core::list_get(module.use_declarations, index);
        let candidate_target = resolve_type(source, module, candidate.target);
        if(same_type(target, candidate_target)) {
            compiler_error(
                source,
                "GRC1841",
                "principal use interval declared more than once",
                candidate.target.span,
                "`" + type_name(target.kind) + "` receives another `Use` implementation",
                [DiagnosticLabel {
                    span: declaration.target.span,
                    message: "the first implementation is here",
                }],
                "each concrete nominal type has exactly one principal interval",
                "remove one of these `Use` implementations"
            )
        } else {
            validate_use_declaration_duplicates(
                source, module, declaration, target, index + 1
            )
        }
    }
}

validate_use_declarations(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.use_declarations)) {
        ()
    } else {
        let declaration = core::list_get(module.use_declarations, index);
        let target = resolve_type(source, module, declaration.target);
        let nominal = handle perform TypeCase::inspect(target.kind) {
            TypeCase::inspect(SourceType::Struct(_, _)) => true,
            TypeCase::inspect(SourceType::Enum(_, _)) => true,
            TypeCase::inspect(_) => false
        };
        require(
            nominal,
            error_diagnostic(
                source,
                "GRC1844",
                "`Use` requires a nominal type",
                declaration.target.span,
                "`" + type_name(target.kind) + "` cannot receive a manual principal interval",
                [],
                "built-ins and aliases retain their canonical ownership behavior",
                "implement `Use` for a struct or enum"
            )
        );
        require(
            declaration.lower >= 0 and
                (declaration.upper == -1 or declaration.lower <= declaration.upper),
            error_diagnostic(
                source,
                "GRC1845",
                "invalid principal use interval",
                declaration.quantity_span,
                "expected `0 <= lower <= upper`, with every finite value below `infinity`",
                [],
                "use intervals describe possible nonnegative owned-use counts",
                "correct the interval bounds"
            )
        );
        validate_use_declaration_duplicates(
            source, module, declaration, target, index + 1
        );
        let structural = structural_use_interval(source, module, target, []);
        let requested = ResumptionUseInterval {
            lower: declaration.lower,
            upper: declaration.upper,
        };
        require(
            use_interval_contains(structural, requested),
            error_diagnostic(
                source,
                "GRC1846",
                "manual `Use` implementation widens structural capability",
                declaration.quantity_span,
                "requested " + use_interval_text(requested) +
                    ", but fields support only " + use_interval_text(structural),
                [DiagnosticLabel {
                    span: declaration.target.span,
                    message: "this nominal type derives its structural capability from its fields",
                }],
                "a manual principal interval may raise the lower bound or lower the upper bound, never widen either side",
                "choose a subset of the structurally derived interval"
            )
        );
        validate_use_declarations(source, module, index + 1)
    }
}

drop_callable(
    source: SourceFile,
    module: Module,
    declaration: DropDecl,
) -> CallableDecl / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let target = resolve_type(source, module, declaration.target);
    CallableDecl {
        name: "drop_hook_" + type_mangle(target),
        name_span: declaration.target_span,
        type_parameters: [],
        callable_constraints: [],
        use_constraints: [],
        environment_constraints: [],
        runs_in_constraints: [],
        parameters: [Parameter {
            name: "self",
            span: declaration.self_span,
            parameter_type: TypeRef {
                kind: SourceType::UniqueReference(target),
                span: declaration.self_span,
            },
            is_local: false,
            drop_flag: "",
            llvm_name: "%arg_self",
        }],
        result_type: TypeRef {
            kind: SourceType::Unit,
            span: declaration.span,
        },
        effects: declaration.effects,
        body: declaration.body,
        span: declaration.span,
    }
}

validate_drop_declaration_duplicates(
    source: SourceFile,
    module: Module,
    declaration: DropDecl,
    target: TypeRef,
    index: i64,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.drop_declarations)) {
        ()
    } else {
        let candidate = core::list_get(module.drop_declarations, index);
        let candidate_target = resolve_type(source, module, candidate.target);
        if(same_type(target, candidate_target)) {
            compiler_error(
                source, "GRC1867", "`Drop` implemented more than once",
                candidate.target_span,
                "`" + source_type_name(target.kind) +
                    "` already has a custom destruction hook",
                [DiagnosticLabel {
                    span: declaration.target_span,
                    message: "the first implementation is here",
                }],
                "custom destruction has one coherent hook for each concrete nominal type",
                "remove one of these `Drop` implementations"
            )
        } else {
            validate_drop_declaration_duplicates(
                source, module, declaration, target, index + 1
            )
        }
    }
}

validate_drop_declarations(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.drop_declarations)) {
        ()
    } else {
        let declaration = core::list_get(module.drop_declarations, index);
        let target = resolve_type(source, module, declaration.target);
        let nominal = handle perform TypeCase::inspect(target.kind) {
            TypeCase::inspect(SourceType::Struct(_, _)) => true,
            TypeCase::inspect(SourceType::Enum(_, _)) => true,
            TypeCase::inspect(_) => false
        };
        require(
            nominal,
            error_diagnostic(
                source, "GRC1866", "`Drop` requires a nominal type",
                declaration.target_span,
                "`" + source_type_name(target.kind) +
                    "` cannot receive a custom destruction hook", [],
                "the intrinsic hook belongs to one concrete struct or enum layout",
                "implement `Drop` for a struct or enum"
            )
        );
        require(
            core::list_len(declaration.effects) == 0,
            error_diagnostic(
                source, "GRC1868", "`Drop` hook exposes effects",
                declaration.span,
                "`Drop::drop` must have an empty outward effect row", [],
                "destruction must complete synchronously on every cleanup edge",
                "handle the effects inside the hook or remove them"
            )
        );
        require(
            use_interval_contains(
                principal_use_interval(source, module, target, []),
                ResumptionUseInterval { lower: 1, upper: 1 }
            ),
            error_diagnostic(
                source, "GRC1869", "`Drop` target cannot be destroyed once",
                declaration.target_span,
                "the target principal interval does not contain `[1,1]`", [],
                "the intrinsic Drop trait requests one consuming destruction operation",
                "choose a target whose `Use` interval permits exactly one use"
            )
        );
        validate_drop_declaration_duplicates(
            source, module, declaration, target, index + 1
        );
        let callable = drop_callable(source, module, declaration);
        handle perform LookupCase::lookup(
            lookup_callable(module.callables, callable.name, 0)
        ) {
            LookupCase::lookup(CallableLookup::Found(conflict)) =>
                compiler_error(
                    source, "GRC1871", "callable collides with generated Drop hook",
                    conflict.name_span,
                    "`" + conflict.name +
                        "` is reserved by this concrete `Drop` implementation",
                    [DiagnosticLabel {
                        span: declaration.target_span,
                        message: "the generated hook originates here",
                    }],
                    "custom hooks receive private compiler-owned LLVM identities",
                    "rename this callable"
                ),
            LookupCase::lookup(CallableLookup::Missing) => ()
        };
        validate_expression_with_constraints(
            source, module, callable.parameters, [],
            callable.result_type, callable.body
        );
        validate_effects_expression(
            source, module, callable.parameters, callable.body,
            callable.result_type, [], []
        );
        validate_borrow_blocks_expression(
            source, module, callable.body, true
        );
        validate_owned_parameters(source, module, callable, 0);
        validate_owned_locals_expression(source, module, callable.body);
        validate_drop_declarations(source, module, index + 1)
    }
}

owned_value_uses_expressions(
    source: SourceFile,
    module: Module,
    expressions: List<Expression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        uses
    } else {
        owned_value_uses_expressions(
            source,
            module,
            expressions,
            name,
            index + 1,
            add_resumption_uses(
                uses,
                owned_value_uses_expression(
                    source, module, core::list_get(expressions, index), name
                )
            )
        )
    }
}

owned_value_uses_named_expressions(
    source: SourceFile,
    module: Module,
    expressions: List<NamedExpression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        uses
    } else {
        owned_value_uses_named_expressions(
            source,
            module,
            expressions,
            name,
            index + 1,
            add_resumption_uses(
                uses,
                owned_value_uses_expression(
                    source,
                    module,
                    core::list_get(expressions, index).value,
                    name
                )
            )
        )
    }
}

owned_value_uses_block(
    source: SourceFile,
    module: Module,
    statements: List<BlockStatement>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(statements)) {
        uses
    } else {
        let expression = handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                _, _, _, value, _
            )) => value,
            BlockStatementCase::inspect(BlockStatement::Value(value)) => value
        };
        owned_value_uses_block(
            source,
            module,
            statements,
            name,
            index + 1,
            add_resumption_uses(
                uses,
                owned_value_uses_expression(source, module, expression, name)
            )
        )
    }
}

owned_value_uses_clauses(
    source: SourceFile,
    module: Module,
    clauses: List<HandlerClause>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(clauses)) {
        uses
    } else {
        let found = owned_value_uses_expression(
            source, module, core::list_get(clauses, index).body, name
        );
        owned_value_uses_clauses(
            source,
            module,
            clauses,
            name,
            index + 1,
            if(index == 0) { found } else {
                join_resumption_uses(uses, found)
            }
        )
    }
}

collect_joint_owned_uses(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    arguments: List<Expression>,
    name: String,
    index: i64,
    bindings: List<CallbackUseBinding>,
    eager: ResumptionUseInterval,
) -> JointCallbackUses / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(arguments)) {
        JointCallbackUses { bindings: bindings, eager: eager }
    } else {
        let direct = owned_value_uses_expression(
            source, module, core::list_get(arguments, index), name
        );
        if(index < core::list_len(callable.parameters) and
            parameter_has_callable_constraint(
                callable, core::list_get(callable.parameters, index)
            )) {
            collect_joint_owned_uses(
                source,
                module,
                callable,
                arguments,
                name,
                index + 1,
                core::list_push(bindings, CallbackUseBinding {
                    name: core::list_get(callable.parameters, index).name,
                    uses: direct,
                }),
                eager
            )
        } else {
            collect_joint_owned_uses(
                source,
                module,
                callable,
                arguments,
                name,
                index + 1,
                bindings,
                add_resumption_uses(eager, direct)
            )
        }
    }
}

joint_owned_call_uses(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    arguments: List<Expression>,
    name: String,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    let collected = collect_joint_owned_uses(
        source,
        module,
        callable,
        arguments,
        name,
        0,
        [],
        ResumptionUseInterval { lower: 0, upper: 0 }
    );
    add_resumption_uses(
        collected.eager,
        substituted_callback_uses_expression(
            module, callable.body, collected.bindings
        )
    )
}

owned_value_uses_call_arguments(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    arguments: List<Expression>,
    name: String,
    index: i64,
    uses: ResumptionUseInterval,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(arguments)) {
        uses
    } else {
        let direct = owned_value_uses_expression(
            source, module, core::list_get(arguments, index), name
        );
        let composed = if(index < core::list_len(callable.parameters) and
            parameter_has_callable_constraint(
                callable, core::list_get(callable.parameters, index)
            )) {
            multiply_resumption_uses(
                direct,
                callable_parameter_invocation_uses(
                    module,
                    callable,
                    core::list_get(callable.parameters, index).name,
                    []
                )
            )
        } else {
            direct
        };
        owned_value_uses_call_arguments(
            source,
            module,
            callable,
            arguments,
            name,
            index + 1,
            add_resumption_uses(uses, composed)
        )
    }
}

owned_value_uses_expression(
    source: SourceFile,
    module: Module,
    expression: Expression,
    name: String,
) -> ResumptionUseInterval / {
    ResultCase, ExpressionCase, LookupCase, TypeCase,
    BlockStatementCase
} {
    let zero = ResumptionUseInterval { lower: 0, upper: 0 };
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Destroy(value, _)) =>
            owned_value_uses_expression(source, module, value, name),
        ExpressionCase::expression(Expression::ConsumeAvailable(available, _)) =>
            owned_value_uses_expression(source, module, available, name),
        ExpressionCase::expression(Expression::Variable(value, _)) =>
            if(value == name) {
                ResumptionUseInterval { lower: 1, upper: 1 }
            } else {
                zero
            },
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            owned_value_uses_expression(source, module, operand, name),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            add_resumption_uses(
                owned_value_uses_expression(source, module, left, name),
                owned_value_uses_expression(source, module, right, name)
            ),
        ExpressionCase::expression(Expression::Call(call_name, arguments, _)) =>
            handle perform LookupCase::lookup(
                lookup_callable(module.callables, call_name, 0)
            ) {
                LookupCase::lookup(CallableLookup::Found(callable)) =>
                    if(callable_constraint_parameter_count(callable, 0, 0) > 1) {
                        joint_owned_call_uses(
                            source, module, callable, arguments, name
                        )
                    } else {
                        owned_value_uses_call_arguments(
                            source,
                            module,
                            callable,
                            arguments,
                            name,
                            0,
                            zero
                        )
                    },
                LookupCase::lookup(CallableLookup::Missing) =>
                    owned_value_uses_expressions(
                        source, module, arguments, name, 0, zero
                    )
            },
        ExpressionCase::expression(Expression::StructValue(_, fields, _)) =>
            owned_value_uses_named_expressions(
                source, module, fields, name, 0, zero
            ),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            owned_value_uses_expression(source, module, subject, name),
        ExpressionCase::expression(Expression::EnumValue(_, _, arguments, _)) =>
            owned_value_uses_expressions(
                source, module, arguments, name, 0, zero
            ),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            owned_value_uses_block(
                source, module, statements, name, 0, zero
            ),
        ExpressionCase::expression(Expression::Perform(_, _, arguments, _)) =>
            owned_value_uses_expressions(
                source, module, arguments, name, 0, zero
            ),
        ExpressionCase::expression(Expression::Handle(computation, clauses, _)) =>
            add_resumption_uses(
                owned_value_uses_expression(
                    source, module, computation, name
                ),
                owned_value_uses_clauses(
                    source, module, clauses, name, 0, zero
                )
            ),
        ExpressionCase::expression(_) => zero
    }
}

validate_owned_binding(
    source: SourceFile,
    module: Module,
    name: String,
    declaration_span: SourceSpan,
    binding_type: TypeRef,
    actual: ResumptionUseInterval,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    validate_owned_binding_with_constraints(
        source, module, name, declaration_span, binding_type, actual, []
    )
}

principal_use_interval_with_constraints(
    source: SourceFile,
    module: Module,
    reference: TypeRef,
    path: List<String>,
    constraints: List<UseConstraint>,
) -> ResumptionUseInterval / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let resolved = resolve_type(source, module, reference);
    handle perform TypeCase::inspect(resolved.kind) {
        TypeCase::inspect(SourceType::Generic(name)) => {
            let constrained = lookup_use_constraint(constraints, name, 0);
            if(constrained.found) {
                constrained.interval
            } else {
                ResumptionUseInterval { lower: 1, upper: 1 }
            }
        },
        TypeCase::inspect(SourceType::Available(environment)) => {
            let environment_interval = principal_use_interval_with_constraints(
                source, module, environment, path, constraints
            );
            if(environment_interval.lower == 0) {
                ResumptionUseInterval { lower: 0, upper: 1 }
            } else {
                ResumptionUseInterval { lower: 1, upper: 1 }
            }
        },
        TypeCase::inspect(_) => principal_use_interval(
            source, module, resolved, path
        )
    }
}

validate_owned_binding_with_constraints(
    source: SourceFile,
    module: Module,
    name: String,
    declaration_span: SourceSpan,
    binding_type: TypeRef,
    actual: ResumptionUseInterval,
    constraints: List<UseConstraint>,
) -> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let principal = principal_use_interval_with_constraints(
        source, module, binding_type, [], constraints
    );
    require(
        use_interval_contains(principal, actual),
        error_diagnostic(
            source,
            "GRC1840",
            if(actual.lower < principal.lower) {
                "owned value may be left unused"
            } else {
                "owned value is used too many times"
            },
            declaration_span,
            "`" + name + "` is used " + use_interval_text(actual) +
                ", but its principal interval is " + use_interval_text(principal),
            [DiagnosticLabel {
                span: binding_type.span,
                message: "this type determines the permitted owned-use interval",
            }],
            "sequential uses add while mutually exclusive branches join their possible counts",
            if(actual.lower < principal.lower) {
                "consume the value on every normal path"
            } else {
                "remove repeated owned uses or borrow the value once borrowing is appropriate"
            }
        )
    )
}

validate_owned_parameters(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(callable.parameters)) {
        ()
    } else {
        let parameter = core::list_get(callable.parameters, index);
        let callable_parameter = parameter_has_callable_constraint(
            callable, parameter
        );
        let explicit_use = handle perform TypeCase::inspect(
            parameter.parameter_type.kind
        ) {
            TypeCase::inspect(SourceType::Generic(name)) =>
                lookup_use_constraint(callable.use_constraints, name, 0).found,
            TypeCase::inspect(_) => false
        };
        if(callable_parameter and explicit_use == false) {
            ()
        } else {
            validate_owned_binding_with_constraints(
                source, module, parameter.name, parameter.span,
                parameter.parameter_type,
                owned_value_uses_expression(
                    source, module, callable.body, parameter.name
                ),
                callable.use_constraints
            )
        };
        validate_owned_parameters(source, module, callable, index + 1)
    }
}

validate_owned_locals_expression(
    source: SourceFile,
    module: Module,
    expression: Expression,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase,
    BlockStatementCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            validate_owned_locals_expression(source, module, value),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            validate_owned_locals_expression(source, module, value),
        ExpressionCase::expression(Expression::Destroy(value, _)) =>
            validate_owned_locals_expression(source, module, value),
        ExpressionCase::expression(Expression::ConsumeAvailable(available, _)) =>
            validate_owned_locals_expression(source, module, available),
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            validate_owned_locals_expression(source, module, operand),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) => {
            validate_owned_locals_expression(source, module, left);
            validate_owned_locals_expression(source, module, right)
        },
        ExpressionCase::expression(Expression::Call(_, arguments, _)) =>
            validate_owned_locals_expressions(source, module, arguments, 0),
        ExpressionCase::expression(Expression::StructValue(_, fields, _)) =>
            validate_owned_locals_named_expressions(source, module, fields, 0),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            validate_owned_locals_expression(source, module, subject),
        ExpressionCase::expression(Expression::EnumValue(_, _, arguments, _)) =>
            validate_owned_locals_expressions(source, module, arguments, 0),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            validate_owned_block_locals(source, module, statements, 0),
        ExpressionCase::expression(Expression::Perform(_, _, arguments, _)) =>
            validate_owned_locals_expressions(source, module, arguments, 0),
        ExpressionCase::expression(Expression::Handle(computation, clauses, _)) => {
            validate_owned_locals_expression(source, module, computation);
            validate_owned_locals_clauses(source, module, clauses, 0)
        },
        ExpressionCase::expression(_) => ()
    }
}

validate_owned_locals_expressions(
    source: SourceFile,
    module: Module,
    expressions: List<Expression>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        ()
    } else {
        validate_owned_locals_expression(
            source, module, core::list_get(expressions, index)
        );
        validate_owned_locals_expressions(source, module, expressions, index + 1)
    }
}

validate_owned_locals_named_expressions(
    source: SourceFile,
    module: Module,
    expressions: List<NamedExpression>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        ()
    } else {
        validate_owned_locals_expression(
            source, module, core::list_get(expressions, index).value
        );
        validate_owned_locals_named_expressions(
            source, module, expressions, index + 1
        )
    }
}

validate_owned_locals_clauses(
    source: SourceFile,
    module: Module,
    clauses: List<HandlerClause>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        ()
    } else {
        validate_owned_locals_expression(
            source, module, core::list_get(clauses, index).body
        );
        validate_owned_locals_clauses(source, module, clauses, index + 1)
    }
}

validate_owned_block_locals(
    source: SourceFile,
    module: Module,
    statements: List<BlockStatement>,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(statements)) {
        ()
    } else {
        handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, name_span, local_type, value, _
            )) => {
                validate_owned_locals_expression(source, module, value);
                validate_owned_binding(
                    source,
                    module,
                    name,
                    name_span,
                    local_type,
                    owned_value_uses_block(
                        source,
                        module,
                        statements,
                        name,
                        index + 1,
                        ResumptionUseInterval { lower: 0, upper: 0 }
                    )
                )
            },
            BlockStatementCase::inspect(BlockStatement::Value(value)) =>
                validate_owned_locals_expression(source, module, value)
        };
        validate_owned_block_locals(source, module, statements, index + 1)
    }
}

validate_owned_callables(
    source: SourceFile,
    module: Module,
    index: i64,
) -> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(module.callables)) {
        ()
    } else {
        let callable = core::list_get(module.callables, index);
        if(compiler_core_intrinsic(callable.name)) {
            validate_owned_callables(source, module, index + 1)
        } else {
        validate_owned_parameters(source, module, callable, 0);
        validate_owned_locals_expression(source, module, callable.body);
        validate_owned_callables(source, module, index + 1)
        }
    }
}

validate_module(
    source: SourceFile,
    module: Module,
) -> CallableDecl / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics
} {
    validate_structs(source, module, 0);
    validate_enums(source, module, 0);
    validate_type_aliases(source, module, 0);
    validate_use_declarations(source, module, 0);
    validate_effect_declarations(source, module, 0);
    validate_unique_callables(source, module, 0);
    validate_drop_declarations(source, module, 0);
    let entry = main_callable(source, module);
    validate_entry_signature(source, module, entry);
    validate_callable_bodies(source, module, 0);
    validate_owned_callables(source, module, 0);
    entry
}

compile(
    path: String,
    source: String,
) -> CompiledModule / {
    ResultCase, CharacterCase, TokenCase, ExpressionCase, OperatorCase,
    LookupCase, ParameterLookupCase, GlobalLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, TypeBindingLookupCase,
    BlockStatementCase, TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, FixityLookupCase, Diagnostics
} {
    let source_file = SourceFile { path: path, text: source };
    let raw_tokens = lex(source_file);
    let module = parse_module_tokens(source_file, raw_tokens);
    let entry = validate_module(source_file, module);
    let entry_type = resolve_type(source_file, module, entry.result_type);
    report_entry_warning(path, source, entry_type, entry.body);
    CompiledModule {
        llvm_ir: llvm_module(
            source_file, module, entry,
            lower_string_literal_definitions(raw_tokens, 0, "")
        ),
        entry_description: expression_description(entry.body),
    }
}

main(args: List<String>) -> / {
    Console, Files, ResultCase, CharacterCase, TokenCase, ExpressionCase,
    OperatorCase, LookupCase, ParameterLookupCase, GlobalLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, TypeBindingLookupCase,
    BlockStatementCase, TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, FixityLookupCase, Diagnostics
} {
    let input_path = core::list_get(args, 0);
    let output_path = core::list_get(args, 1);
    let source = perform Files::read_to_string(input_path);
    let compilation = compile(input_path, source);
    perform Files::write_string(output_path, compilation.llvm_ir);
    perform Console::write_line(
        "glorious: wrote " + compilation.entry_description + " LLVM entry point to " + output_path
    )
}
