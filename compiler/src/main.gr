    Call(String, List<Expression>, SourceSpan),
    StructValue(String, List<NamedExpression>, SourceSpan),
    Field(Indirect<Expression>, String, SourceSpan),
    EnumValue(String, String, List<Expression>, SourceSpan),
    Block(List<BlockStatement>, SourceSpan),
    Perform(String, String, List<Expression>, SourceSpan),
    Handle(Indirect<Expression>, List<HandlerClause>, SourceSpan),
    AvailableValue(TypeRef, SourceSpan),
    ConsumeAvailable(Indirect<Expression>, SourceSpan),
    Destroy(Indirect<Expression>, SourceSpan),
    Borrow(Indirect<Expression>, Bool, SourceSpan),
    Dereference(Indirect<Expression>, SourceSpan),
}

