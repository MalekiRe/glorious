    kind: TokenKind,
    span: SourceSpan,
}

struct ScannedText {
    text: String,
    end: i64,
}

if<A, E, B, F>(condition: Result<A, E>, body: F) -> Result<B, E>
where F: Fn<(), Output = B>, A: Use<[0, 0]> / {ResultCase} {
    handle perform ResultCase::inspect(condition) {
        ResultCase::inspect(Result::Ok(_)) => Result::Ok(body()),
        ResultCase::inspect(Result::Err(error)) => Result::Err(error)
    }
}

else<A, E, F>(value: Result<A, E>, fallback: F) -> A
where F: Fn<(), Output = A>, E: Use<[0, 0]> / {ResultCase} {
    handle perform ResultCase::inspect(value) {
        ResultCase::inspect(Result::Ok(result)) => result,
        ResultCase::inspect(Result::Err(_)) => fallback()
    }
}

and<A, E, B, F>(value: Result<A, E>, next: F) -> Result<B, E>
where F: Fn<(), Output = Result<B, E>>, A: Use<[0, 0]> / {ResultCase} {
    handle perform ResultCase::inspect(value) {
        ResultCase::inspect(Result::Ok(_)) => next(),
        ResultCase::inspect(Result::Err(error)) => Result::Err(error)
    }
}

or<A, E, F>(value: Result<A, E>, next: F) -> Result<A, E>
where F: Fn<(), Output = Result<A, E>>, E: Use<[0, 0]> / {ResultCase} {
    handle perform ResultCase::inspect(value) {
        ResultCase::inspect(Result::Ok(result)) => Result::Ok(result),
        ResultCase::inspect(Result::Err(_)) => next()
    }
}

not<A, E>(value: Result<A, E>) -> Result<E, A> / {ResultCase} {
    handle perform ResultCase::inspect(value) {
        ResultCase::inspect(Result::Ok(result)) => Result::Err(result),
        ResultCase::inspect(Result::Err(error)) => Result::Ok(error)
    }
}

error_diagnostic(
    source: SourceFile,
    code: String,
    title: String,
    primary: SourceSpan,
    message: String,
    secondary: List<DiagnosticLabel>,
    note: String,
    help: String,
) -> CompilerDiagnostic {
    CompilerDiagnostic {
        severity: DiagnosticSeverity::Error,
        code: code,
        title: title,
        source: source,
        primary: primary,
        message: message,
        secondary: secondary,
        note: note,
        help: help,
    }
}

compiler_error(
    source: SourceFile,
    code: String,
    title: String,
    primary: SourceSpan,
    message: String,
    secondary: List<DiagnosticLabel>,
    note: String,
    help: String,
) -> ! / {Diagnostics} {
    perform Diagnostics::abort(
        error_diagnostic(source, code, title, primary, message, secondary, note, help)
    )
}

token(kind: TokenKind, start: i64, end: i64) -> Token {
    Token { kind: kind, span: SourceSpan { start: start, end: end } }
}

scan_identifier(source: String, start: i64, cursor: i64) -> ScannedText / {ResultCase} {
    if(cursor >= core::str_byte_len(source)) {
        ScannedText { text: core::str_slice(source, start, cursor), end: cursor }
    } else {
        let character = core::str_char_at(source, cursor);
        if(core::is_ascii_ident_continue(character)) {
            scan_identifier(source, start, core::str_next_index(source, cursor))
        } else {
            ScannedText { text: core::str_slice(source, start, cursor), end: cursor }
        }
    }
}

scan_digits(source: String, start: i64, cursor: i64) -> ScannedText / {ResultCase} {
    if(cursor >= core::str_byte_len(source)) {
        ScannedText { text: core::str_slice(source, start, cursor), end: cursor }
    } else {
        let character = core::str_char_at(source, cursor);
        if(core::is_ascii_digit(character)) {
            scan_digits(source, start, core::str_next_index(source, cursor))
        } else {
            ScannedText { text: core::str_slice(source, start, cursor), end: cursor }
        }
    }
}

scan_string(
    source: SourceFile,
    start: i64,
    cursor: i64,
    output: String,
) -> ScannedText / {ResultCase, Diagnostics} {
    if(cursor >= core::str_byte_len(source.text)) {
        compiler_error(
            source, "GRC0102", "unfinished string literal",
            SourceSpan { start: start, end: cursor },
            "this string reaches the end of the file without a closing quote",
            [], "string literals delimit their complete UTF-8 contents with `\"`",
            "add a closing `\"`"
        )
    } else {
        let character = core::str_char_at(source.text, cursor);
        let next = core::str_next_index(source.text, cursor);
        if(character == "\"") {
            ScannedText { text: output, end: next }
        } else {
            if(character == "\\") {
                if(next >= core::str_byte_len(source.text)) {
                    compiler_error(
                        source, "GRC0102", "unfinished string escape",
                        SourceSpan { start: cursor, end: next },
                        "this backslash has no following escape character", [],
                        "an escape is part of the surrounding string literal",
                        "add `n`, `r`, `t`, `\"`, or `\\` after the backslash"
                    )
                } else {
                    let escaped = core::str_char_at(source.text, next);
                    let decoded = if(escaped == "n") {
                        "\n"
                    } else {
                        if(escaped == "r") {
                            "\r"
                        } else {
                            if(escaped == "t") {
                                "\t"
                            } else {
                                if(escaped == "\"") {
                                    "\""
                                } else {
                                    if(escaped == "\\") {
                                        "\\"
                                    } else {
                                        compiler_error(
                                            source, "GRC0103", "unknown string escape",
                                            SourceSpan {
                                                start: cursor,
                                                end: core::str_next_index(
                                                    source.text, next
                                                ),
                                            },
                                            "`\\" + escaped +
                                                "` is not a Grandiose string escape",
                                            [],
                                            "valid escapes are `\\n`, `\\r`, `\\t`, `\\\"`, and `\\\\`",
                                            "replace this escape with a supported one"
                                        )
                                    }
                                }
                            }
                        }
                    };
                    scan_string(
                        source, start,
                        core::str_next_index(source.text, next),
                        output + decoded
                    )
                }
            } else {
                scan_string(source, start, next, output + character)
            }
        }
    }
}

lex_string(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    let scanned = scan_string(
        source, cursor,
        core::str_next_index(source.text, cursor), ""
    );
    lex_from(
        source, scanned.end,
        core::list_push(
            tokens,
            token(TokenKind::String(scanned.text), cursor, scanned.end)
        )
    )
}

lex_punctuation(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
    kind: TokenKind,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    let next = core::str_next_index(source.text, cursor);
    lex_from(source, next, core::list_push(tokens, token(kind, cursor, next)))
}

lex_identifier(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    let next = core::str_next_index(source.text, cursor);
    let scanned = scan_identifier(source.text, cursor, next);
    lex_from(
        source,
        scanned.end,
        core::list_push(tokens, token(TokenKind::Identifier(scanned.text), cursor, scanned.end))
    )
}

lex_integer(
    source: SourceFile,
    start: i64,
    cursor: i64,
    tokens: List<Token>,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    let scanned = scan_digits(source.text, start, cursor);
    lex_from(
        source,
        scanned.end,
        core::list_push(tokens, token(TokenKind::Integer(scanned.text), start, scanned.end))
    )
}

lex_minus(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    let next = core::str_next_index(source.text, cursor);
    if(next < core::str_byte_len(source.text)) {
            let following = core::str_char_at(source.text, next);
            if(following == ">") {
                    let end = core::str_next_index(source.text, next);
                    lex_from(
                        source,
                        end,
                        core::list_push(tokens, token(TokenKind::Arrow, cursor, end))
                    )
            } else {
                lex_from(
                    source,
                    next,
                    core::list_push(tokens, token(TokenKind::Minus, cursor, next))
                )
            }
    } else {
        lex_from(
            source,
            next,
            core::list_push(tokens, token(TokenKind::Minus, cursor, next))
        )
    }
}

lex_colon(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    let next = core::str_next_index(source.text, cursor);
    if(next < core::str_byte_len(source.text)) {
        let following = core::str_char_at(source.text, next);
        if(following == ":") {
            let end = core::str_next_index(source.text, next);
            lex_from(
                source,
                end,
                core::list_push(tokens, token(TokenKind::DoubleColon, cursor, end))
            )
        } else {
            lex_from(
                source,
                next,
                core::list_push(tokens, token(TokenKind::Colon, cursor, next))
            )
        }
    } else {
        lex_from(
            source,
            next,
            core::list_push(tokens, token(TokenKind::Colon, cursor, next))
        )
    }
}

lex_equal(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    let next = core::str_next_index(source.text, cursor);
    if(next < core::str_byte_len(source.text)) {
        let following = core::str_char_at(source.text, next);
        if(following == "=") {
            let end = core::str_next_index(source.text, next);
            lex_from(
                source,
                end,
                core::list_push(tokens, token(TokenKind::EqualEqual, cursor, end))
            )
        } else {
            if(following == ">") {
                let end = core::str_next_index(source.text, next);
                lex_from(
                    source,
                    end,
                    core::list_push(tokens, token(TokenKind::FatArrow, cursor, end))
                )
            } else {
            lex_from(
                source,
                next,
                core::list_push(tokens, token(TokenKind::Equal, cursor, next))
            )
            }
        }
    } else {
        lex_from(
            source,
            next,
            core::list_push(tokens, token(TokenKind::Equal, cursor, next))
        )
    }
}

lex_optional_equal(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
    plain: TokenKind,
    combined: TokenKind,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    let next = core::str_next_index(source.text, cursor);
    if(next < core::str_byte_len(source.text) and
        core::str_char_at(source.text, next) == "=") {
        let end = core::str_next_index(source.text, next);
        lex_from(
            source, end,
            core::list_push(tokens, token(combined, cursor, end))
        )
    } else {
        lex_from(
            source, next,
            core::list_push(tokens, token(plain, cursor, next))
        )
    }
}

lex_visible(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
    character: String,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    handle perform CharacterCase::character(character) {
        CharacterCase::character("(") => lex_punctuation(source, cursor, tokens, TokenKind::LeftParen),
        CharacterCase::character(")") => lex_punctuation(source, cursor, tokens, TokenKind::RightParen),
        CharacterCase::character("{") => lex_punctuation(source, cursor, tokens, TokenKind::LeftBrace),
        CharacterCase::character("}") => lex_punctuation(source, cursor, tokens, TokenKind::RightBrace),
        CharacterCase::character("[") => lex_punctuation(source, cursor, tokens, TokenKind::LeftBracket),
        CharacterCase::character("]") => lex_punctuation(source, cursor, tokens, TokenKind::RightBracket),
        CharacterCase::character(":") => lex_colon(source, cursor, tokens),
        CharacterCase::character(",") => lex_punctuation(source, cursor, tokens, TokenKind::Comma),
        CharacterCase::character("=") => lex_equal(source, cursor, tokens),
        CharacterCase::character(";") => lex_punctuation(source, cursor, tokens, TokenKind::Semicolon),
        CharacterCase::character(".") => lex_punctuation(source, cursor, tokens, TokenKind::Dot),
        CharacterCase::character("-") => lex_minus(source, cursor, tokens),
        CharacterCase::character("+") => lex_punctuation(source, cursor, tokens, TokenKind::Plus),
        CharacterCase::character("*") => lex_punctuation(source, cursor, tokens, TokenKind::Star),
        CharacterCase::character("/") => lex_punctuation(source, cursor, tokens, TokenKind::Slash),
        CharacterCase::character("<") => lex_optional_equal(
            source, cursor, tokens, TokenKind::Less, TokenKind::LessEqual
        ),
        CharacterCase::character(">") => lex_optional_equal(
            source, cursor, tokens, TokenKind::Greater, TokenKind::GreaterEqual
        ),
        CharacterCase::character("!") => lex_optional_equal(
            source, cursor, tokens, TokenKind::Bang, TokenKind::BangEqual
        ),
        CharacterCase::character("&") => lex_punctuation(source, cursor, tokens, TokenKind::Ampersand),
        CharacterCase::character("\"") => lex_string(source, cursor, tokens),
        CharacterCase::character(_) => if(core::is_ascii_ident_start(character)) {
            lex_identifier(source, cursor, tokens)
        } else {
            if(core::is_ascii_digit(character)) {
                lex_integer(
                    source,
                    cursor,
                    core::str_next_index(source.text, cursor),
                    tokens
                )
            } else {
                compiler_error(
                    source,
                    "GRC0101",
                    "unexpected character",
                    SourceSpan {
                        start: cursor,
                        end: core::str_next_index(source.text, cursor),
                    },
                    "this character is not valid in the bootstrap grammar",
                    [],
                    "the lexer reports Unicode characters on their complete UTF-8 span",
                    "remove the character or replace it with valid Grandiose syntax"
                )
            }
        }
    }
}

lex_from(
    source: SourceFile,
    cursor: i64,
    tokens: List<Token>,
) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    if(cursor >= core::str_byte_len(source.text)) {
        core::list_push(tokens, token(TokenKind::End, cursor, cursor))
    } else {
            let character = core::str_char_at(source.text, cursor);
            if(core::is_ascii_whitespace(character)) {
                lex_from(source, core::str_next_index(source.text, cursor), tokens)
            } else {
                lex_visible(source, cursor, tokens, character)
            }
        }
}

lex(source: SourceFile) -> List<Token> / {ResultCase, CharacterCase, Diagnostics} {
    lex_from(source, 0, [])
}

lookup_fixity(
    fixities: List<FixityDecl>,
    name: String,
    index: i64,
) -> FixityLookup / {ResultCase} {
    if(index >= core::list_len(fixities)) {
        FixityLookup::Missing
    } else {
        let candidate = core::list_get(fixities, index);
        if(candidate.name == name) {
            FixityLookup::Found(candidate)
        } else {
            lookup_fixity(fixities, name, index + 1)
        }
    }
}

collect_fixities(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    fixities: List<FixityDecl>,
) -> List<FixityDecl> / {ResultCase, TokenCase, Diagnostics} {
    if(index >= core::list_len(tokens)) {
        fixities
    } else {
        let found = core::list_get(tokens, index);
        handle perform TokenCase::token(found.kind) {
            TokenCase::token(TokenKind::Identifier("infixr")) => {
                let precedence_token = token_at(source, tokens, index + 1);
                let name_token = token_at(source, tokens, index + 2);
                handle perform TokenCase::token(precedence_token.kind) {
                    TokenCase::token(TokenKind::Integer(precedence)) => collect_fixities(
                        source,
                        tokens,
                        index + 3,
                        core::list_push(fixities, FixityDecl {
                            name: read_identifier(source, name_token),
                            precedence: core::parse_i64(precedence),
                            right_associative: true,
                            lazy_rhs: token_at(source, tokens, index + 3).kind ==
                                TokenKind::Identifier("lazy"),
                            span: join_span(found.span, name_token.span),
                        })
                    ),
                    TokenCase::token(_) => collect_fixities(
                        source, tokens, index + 1, fixities
                    )
                }
            },
            TokenCase::token(TokenKind::Identifier("infixl")) => {
                let precedence_token = token_at(source, tokens, index + 1);
                let name_token = token_at(source, tokens, index + 2);
                handle perform TokenCase::token(precedence_token.kind) {
                    TokenCase::token(TokenKind::Integer(precedence)) => collect_fixities(
                        source,
                        tokens,
                        index + 3,
                        core::list_push(fixities, FixityDecl {
                            name: read_identifier(source, name_token),
                            precedence: core::parse_i64(precedence),
                            right_associative: false,
                            lazy_rhs: token_at(source, tokens, index + 3).kind ==
                                TokenKind::Identifier("lazy"),
                            span: join_span(found.span, name_token.span),
                        })
                    ),
                    TokenCase::token(_) => collect_fixities(
                        source, tokens, index + 1, fixities
                    )
                }
            },
            TokenCase::token(_) => collect_fixities(
                source, tokens, index + 1, fixities
            )
        }
    }
}

annotate_word_operators(
    tokens: List<Token>,
    fixities: List<FixityDecl>,
    index: i64,
    output: List<Token>,
) -> List<Token> / {ResultCase, TokenCase, FixityLookupCase} {
    if(index >= core::list_len(tokens)) {
        output
    } else {
        let found = core::list_get(tokens, index);
        handle perform TokenCase::token(found.kind) {
            TokenCase::token(TokenKind::Identifier(name)) => {
                handle perform FixityLookupCase::lookup(
                    lookup_fixity(fixities, name, 0)
                ) {
                    FixityLookupCase::lookup(FixityLookup::Found(fixity)) =>
                        annotate_word_operators(
                            tokens,
                            fixities,
                            index + 1,
                            core::list_push(output, Token {
                                kind: TokenKind::WordOperator(
                                    name,
                                    fixity.precedence,
                                    fixity.right_associative,
                                    fixity.lazy_rhs
                                ),
                                span: found.span,
                            })
                        ),
                    FixityLookupCase::lookup(FixityLookup::Missing) =>
                        annotate_word_operators(
                            tokens, fixities, index + 1, core::list_push(output, found)
                        )
                }
            },
            TokenCase::token(_) => annotate_word_operators(
                tokens, fixities, index + 1, core::list_push(output, found)
            )
        }
    }
}

require(
    condition: Bool,
    diagnostic: CompilerDiagnostic,
) -> / {ResultCase, Diagnostics} {
    if(condition) {
        ()
    } else {
        perform Diagnostics::abort(diagnostic)
    }
}

report_if(
    condition: Bool,
    diagnostic: CompilerDiagnostic,
) -> / {ResultCase, Diagnostics} {
    if(condition) {
        perform Diagnostics::report(diagnostic)
    } else {
        ()
    }
}

token_at(source: SourceFile, tokens: List<Token>, index: i64) -> Token / {ResultCase, Diagnostics} {
    let source_end = core::str_byte_len(source.text);
    require(
        index < core::list_len(tokens),
        error_diagnostic(
            source,
            "GRC0201",
            "unexpected end of input",
            SourceSpan { start: source_end, end: source_end },
            "the parser expected another token here",
            [],
            "the source ended before the `main` declaration was complete",
            "complete the declaration as `main() -> i64 { 42 }`"
        )
    );
    core::list_get(tokens, index)
}

expect_kind(
    source: SourceFile,
    found: Token,
    expected: TokenKind,
    expected_name: String,
) -> / {ResultCase, Diagnostics} {
    require(
        found.kind == expected,
        error_diagnostic(
            source,
            "GRC0202",
            "unexpected token",
            found.span,
            "expected " + expected_name + " here",
            [],
            "the bootstrap parser follows the callable grammar, not textual brace searching",
            "write `main() -> i64 { 42 }`"
        )
    )
}

expect_identifier(
    source: SourceFile,
    found: Token,
    expected: String,
) -> / {ResultCase, TokenCase, Diagnostics} {
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Identifier(actual)) => require(
            actual == expected,
            error_diagnostic(
                source,
                "GRC0203",
                "unexpected name",
                found.span,
                "expected `" + expected + "`, found `" + actual + "`",
                [],
                "the executable entry callable has the conventional name `main`",
                "rename this token to `" + expected + "`"
            )
        ),
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0202",
            "expected a name",
            found.span,
            "expected `" + expected + "` here",
            [],
            "names begin with an ASCII letter or underscore in the bootstrap lexer",
            "write `" + expected + "` at this location"
        )
    }
}

read_identifier(
    source: SourceFile,
    found: Token,
) -> String / {TokenCase, Diagnostics} {
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Identifier(name)) => name,
        TokenCase::token(TokenKind::WordOperator(name, _, _, _)) => name,
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0202",
            "expected a callable name",
            found.span,
            "callable declarations begin with an identifier",
            [],
            "names begin with an ASCII letter or underscore in the bootstrap lexer",
            "write a name such as `main` or `answer`"
        )
    }
}

type_parameter_is_present(
    parameters: List<TypeParameter>,
    name: String,
    index: i64,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        false
    } else {
        if(core::list_get(parameters, index).name == name) {
            true
        } else {
            type_parameter_is_present(parameters, name, index + 1)
        }
    }
}

parse_type_parameters_rest(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    parameters: List<TypeParameter>,
) -> ParsedTypeParameters / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Greater) => ParsedTypeParameters {
            parameters: parameters,
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            require(
                type_parameter_is_present(parameters, name, 0) == false,
                error_diagnostic(
                    source,
                    "GRC0310",
                    "generic parameter declared more than once",
                    found.span,
                    "`" + name + "` is repeated in this generic parameter list",
                    [],
                    "generic parameters introduce distinct type identities",
                    "remove or rename the repeated parameter"
                )
            );
            let next_parameters = core::list_push(parameters, TypeParameter {
                name: name,
                span: found.span,
            });
            let delimiter = token_at(source, tokens, index + 1);
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Comma) => parse_type_parameters_rest(
                    source,
                    tokens,
                    index + 2,
                    next_parameters
                ),
                TokenCase::token(TokenKind::Greater) => ParsedTypeParameters {
                    parameters: next_parameters,
                    next: index + 2,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0311",
                    "expected `,` or `>`",
                    delimiter.span,
                    "generic parameters must be separated by commas",
                    [],
                    "a generic declaration uses `<T, U>`",
                    "insert `,` or close the parameter list with `>`"
                )
            }
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0312",
            "expected a generic parameter",
            found.span,
            "expected a type parameter name or `>`",
            [],
            "generic parameter lists contain identifiers",
            "write a parameter such as `T` or close the list"
        )
    }
}

parse_type_parameters(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedTypeParameters / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    if(found.kind == TokenKind::Less) {
        parse_type_parameters_rest(source, tokens, index + 1, [])
    } else {
        ParsedTypeParameters { parameters: [], next: index }
    }
}

parse_type_arguments(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    arguments: List<TypeRef>,
) -> ParsedTypes / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    if(found.kind == TokenKind::Greater) {
        ParsedTypes {
            types: arguments,
            closing_span: found.span,
            next: index + 1,
        }
    } else {
        let argument = parse_type(source, tokens, index, type_parameters);
        let delimiter = token_at(source, tokens, argument.next);
        handle perform TokenCase::token(delimiter.kind) {
            TokenCase::token(TokenKind::Comma) => parse_type_arguments(
                source,
                tokens,
                argument.next + 1,
                type_parameters,
                core::list_push(arguments, argument.reference)
            ),
            TokenCase::token(TokenKind::Greater) => ParsedTypes {
                types: core::list_push(arguments, argument.reference),
                closing_span: delimiter.span,
                next: argument.next + 1,
            },
            TokenCase::token(_) => compiler_error(
                source,
                "GRC0313",
                "expected `,` or `>`",
                delimiter.span,
                "generic type arguments must be separated by commas",
                [],
                "an applied type uses `Name<A, B>`",
                "insert `,` or close the type arguments with `>`"
            )
        }
    }
}

parse_type(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedType / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Ampersand) => {
            let following = token_at(source, tokens, index + 1);
            let unique = following.kind == TokenKind::Identifier("mut");
            let target = parse_type(
                source, tokens, if(unique) { index + 2 } else { index + 1 },
                type_parameters
            );
            ParsedType {
                reference: TypeRef {
                    kind: if(unique) {
                        SourceType::UniqueReference(target.reference)
                    } else {
                        SourceType::SharedReference(target.reference)
                    },
                    span: join_span(found.span, target.reference.span),
                },
                next: target.next,
            }
        },
        TokenCase::token(TokenKind::Bang) => ParsedType {
            reference: TypeRef { kind: SourceType::Never, span: found.span },
            next: index + 1,
        },
        TokenCase::token(TokenKind::LeftParen) => {
            let close = token_at(source, tokens, index + 1);
            expect_kind(source, close, TokenKind::RightParen, "`)` for the unit type");
            ParsedType {
                reference: TypeRef {
                    kind: SourceType::Unit,
                    span: join_span(found.span, close.span),
                },
                next: index + 2,
            }
        },
        TokenCase::token(TokenKind::Identifier("i32")) => ParsedType {
            reference: TypeRef { kind: SourceType::I32, span: found.span },
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier("i64")) => ParsedType {
            reference: TypeRef { kind: SourceType::I64, span: found.span },
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier("String")) => ParsedType {
            reference: TypeRef { kind: SourceType::String, span: found.span },
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier("str")) => ParsedType {
            reference: TypeRef { kind: SourceType::Str, span: found.span },
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            let following = token_at(source, tokens, index + 1);
            if(following.kind == TokenKind::Less) {
                require(
                    type_parameter_is_present(type_parameters, name, 0) == false,
                    error_diagnostic(
                        source,
                        "GRC0314",
                        "type parameter cannot accept arguments",
                        found.span,
                        "generic parameter `" + name + "` is not a type constructor",
                        [],
                        "only declared generic structs, enums, and aliases accept type arguments",
                        "remove the type arguments or name a generic type constructor"
                    )
                );
                let arguments = parse_type_arguments(
                    source,
                    tokens,
                    index + 2,
                    type_parameters,
                    []
                );
                ParsedType {
                    reference: TypeRef {
                        kind: SourceType::Applied(name, arguments.types),
                        span: join_span(found.span, arguments.closing_span),
                    },
                    next: arguments.next,
                }
            } else {
                ParsedType {
                    reference: TypeRef {
                        kind: if(type_parameter_is_present(type_parameters, name, 0)) {
                            SourceType::Generic(name)
                        } else {
                            SourceType::Named(name)
                        },
                        span: found.span,
                    },
                    next: index + 1,
                }
            }
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0302",
            "expected a type",
            found.span,
            "a declaration requires a source type here",
            [],
            "types are parsed recursively before semantic checking",
            "write `()`, `i32`, `i64`, a type parameter, or an applied nominal type"
        )
    }
}

type_argument_names(
    arguments: List<TypeRef>,
    index: i64,
    output: String,
) -> String / {ResultCase, TypeCase} {
    if(index >= core::list_len(arguments)) {
        output
    } else {
        let separator = if(index == 0) { "" } else { ", " };
        type_argument_names(
            arguments,
            index + 1,
            output + separator + type_name(core::list_get(arguments, index).kind)
        )
    }
}

type_name(value: SourceType) -> String / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(value) {
        TypeCase::inspect(SourceType::Inferred) => "$inferred",
        TypeCase::inspect(SourceType::Unit) => "{}",
        TypeCase::inspect(SourceType::Never) => "void",
        TypeCase::inspect(SourceType::String) => "ptr",
        TypeCase::inspect(SourceType::Str) => "ptr",
        TypeCase::inspect(SourceType::List(_)) => "ptr",
        TypeCase::inspect(SourceType::I32) => "i32",
        TypeCase::inspect(SourceType::I64) => "i64",
        TypeCase::inspect(SourceType::Named(name)) => name,
        TypeCase::inspect(SourceType::Applied(name, arguments)) =>
            name + "<" + type_argument_names(arguments, 0, "") + ">",
        TypeCase::inspect(SourceType::Generic(name)) => name,
        TypeCase::inspect(SourceType::Callable(_, _)) => "{ ptr, ptr, ptr }",
        TypeCase::inspect(SourceType::Resumption(_, _)) => "ptr",
        TypeCase::inspect(SourceType::Available(_)) => "{}",
        TypeCase::inspect(SourceType::SharedReference(_)) => "ptr",
        TypeCase::inspect(SourceType::UniqueReference(_)) => "ptr",
        TypeCase::inspect(SourceType::Indirect(_)) => "ptr",
        TypeCase::inspect(SourceType::Environment(_)) => "{}",
        TypeCase::inspect(SourceType::Struct(name, arguments)) =>
            "%struct." + name + type_list_mangle(arguments, 0, ""),
        TypeCase::inspect(SourceType::Enum(name, arguments)) =>
            "%enum." + name + type_list_mangle(arguments, 0, "")
    }
}

source_type_argument_names(
    arguments: List<TypeRef>,
    index: i64,
    output: String,
) -> String / {ResultCase, TypeCase} {
    if(index >= core::list_len(arguments)) {
        output
    } else {
        source_type_argument_names(
            arguments,
            index + 1,
            output + (if(index == 0) { "" } else { ", " }) +
                source_type_name(core::list_get(arguments, index).kind)
        )
    }
}

source_type_name(value: SourceType) -> String / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(value) {
        TypeCase::inspect(SourceType::Inferred) => "inferred type",
        TypeCase::inspect(SourceType::Unit) => "()",
        TypeCase::inspect(SourceType::Never) => "!",
        TypeCase::inspect(SourceType::String) => "String",
        TypeCase::inspect(SourceType::Str) => "str",
        TypeCase::inspect(SourceType::List(element)) =>
            "List<" + source_type_name(element.kind) + ">",
        TypeCase::inspect(SourceType::I32) => "i32",
        TypeCase::inspect(SourceType::I64) => "i64",
        TypeCase::inspect(SourceType::Named(name)) => name,
        TypeCase::inspect(SourceType::Applied(name, arguments)) =>
            name + "<" + source_type_argument_names(arguments, 0, "") + ">",
        TypeCase::inspect(SourceType::Generic(name)) => name,
        TypeCase::inspect(SourceType::Callable(output, _)) =>
            "Fn<(), Output = " + source_type_name(output.kind) + ">",
        TypeCase::inspect(SourceType::Resumption(input, output)) =>
            "Resumption<" + source_type_name(input.kind) + ", " +
                source_type_name(output.kind) + ">",
        TypeCase::inspect(SourceType::Available(environment)) =>
            "Available<" + source_type_name(environment.kind) + ">",
        TypeCase::inspect(SourceType::SharedReference(target)) =>
            "&" + source_type_name(target.kind),
        TypeCase::inspect(SourceType::UniqueReference(target)) =>
            "&mut " + source_type_name(target.kind),
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            "Indirect<" + source_type_name(indirect_target(storage).kind) + ">",
        TypeCase::inspect(SourceType::Environment(name)) =>
            "environment " + name,
        TypeCase::inspect(SourceType::Struct(name, arguments)) =>
            name + (if(core::list_len(arguments) == 0) {
                ""
            } else {
                "<" + source_type_argument_names(arguments, 0, "") + ">"
            }),
        TypeCase::inspect(SourceType::Enum(name, arguments)) =>
            name + (if(core::list_len(arguments) == 0) {
                ""
            } else {
                "<" + source_type_argument_names(arguments, 0, "") + ">"
            })
    }
}

same_type_lists(
    first: List<TypeRef>,
    second: List<TypeRef>,
    index: i64,
) -> Bool / {ResultCase, TypeCase} {
    if(core::list_len(first) != core::list_len(second)) {
        false
    } else {
        if(index >= core::list_len(first)) {
            true
        } else {
            if(same_type(
                core::list_get(first, index), core::list_get(second, index)
            )) {
                same_type_lists(first, second, index + 1)
            } else {
                false
            }
        }
    }
}

type_identity_arguments(
    arguments: List<TypeRef>,
    index: i64,
    output: String,
) -> String / {ResultCase, TypeCase} {
    if(index >= core::list_len(arguments)) {
        output
    } else {
        type_identity_arguments(
            arguments,
            index + 1,
            output + "__" + type_identity(core::list_get(arguments, index).kind)
        )
    }
}

type_identity(value: SourceType) -> String / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(value) {
        TypeCase::inspect(SourceType::Inferred) => "inferred",
        TypeCase::inspect(SourceType::Unit) => "unit",
        TypeCase::inspect(SourceType::Never) => "never",
        TypeCase::inspect(SourceType::String) => "string",
        TypeCase::inspect(SourceType::Str) => "str",
        TypeCase::inspect(SourceType::List(element)) =>
            "list__" + type_identity(element.kind),
        TypeCase::inspect(SourceType::I32) => "i32",
        TypeCase::inspect(SourceType::I64) => "i64",
        TypeCase::inspect(SourceType::Named(name)) => "named__" + name,
        TypeCase::inspect(SourceType::Applied(name, arguments)) =>
            "applied__" + name + type_identity_arguments(arguments, 0, ""),
        TypeCase::inspect(SourceType::Generic(name)) => "generic__" + name,
        TypeCase::inspect(SourceType::Callable(output, effectful)) =>
            "callable__" + (if(effectful) { "step" } else { "value" }) +
                "__" + type_identity(output.kind),
        TypeCase::inspect(SourceType::Resumption(input, output)) =>
            "resumption__" + type_identity(input.kind) + "__" +
                type_identity(output.kind),
        TypeCase::inspect(SourceType::Available(environment)) =>
            "available__" + type_identity(environment.kind),
        TypeCase::inspect(SourceType::SharedReference(target)) =>
            "shared_ref__" + type_identity(target.kind),
        TypeCase::inspect(SourceType::UniqueReference(target)) =>
            "unique_ref__" + type_identity(target.kind),
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            "indirect__" + type_identity(indirect_target(storage).kind),
        TypeCase::inspect(SourceType::Environment(name)) =>
            "environment__" + name,
        TypeCase::inspect(SourceType::Struct(name, arguments)) =>
            "struct__" + name + type_identity_arguments(arguments, 0, ""),
        TypeCase::inspect(SourceType::Enum(name, arguments)) =>
            "enum__" + name + type_identity_arguments(arguments, 0, "")
    }
}

same_type(first: TypeRef, second: TypeRef) -> Bool / {ResultCase, TypeCase} {
    type_identity(first.kind) == type_identity(second.kind)
}

expression_span(expression: Expression) -> SourceSpan / {ExpressionCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Unit(span)) => span,
        ExpressionCase::expression(Expression::String(_, span)) => span,
        ExpressionCase::expression(Expression::List(_, span)) => span,
        ExpressionCase::expression(Expression::Integer(_, span)) => span,
        ExpressionCase::expression(Expression::Negate(_, span)) => span,
        ExpressionCase::expression(Expression::Binary(_, _, _, span)) => span,
        ExpressionCase::expression(Expression::Variable(_, span)) => span,
        ExpressionCase::expression(Expression::Call(_, _, span)) => span,
        ExpressionCase::expression(Expression::StructValue(_, _, span)) => span,
        ExpressionCase::expression(Expression::Field(_, _, span)) => span,
        ExpressionCase::expression(Expression::EnumValue(_, _, _, span)) => span,
        ExpressionCase::expression(Expression::Block(_, span)) => span,
        ExpressionCase::expression(Expression::Perform(_, _, _, span)) => span,
        ExpressionCase::expression(Expression::Handle(_, _, span)) => span,
        ExpressionCase::expression(Expression::AvailableValue(_, span)) => span,
        ExpressionCase::expression(Expression::ConsumeAvailable(_, span)) => span,
        ExpressionCase::expression(Expression::Destroy(_, span)) => span,
        ExpressionCase::expression(Expression::Borrow(_, _, span)) => span,
        ExpressionCase::expression(Expression::Dereference(_, span)) => span
    }
}

place_provenance(
    expression: Expression,
) -> PlaceProvenance / {ExpressionCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Variable(name, _)) =>
            PlaceProvenance {
                found: true,
                place: name,
                root: name,
                parent_reference: "",
            },
        ExpressionCase::expression(Expression::Field(subject, field, _)) => {
            let parent = place_provenance(subject);
            PlaceProvenance {
                found: parent.found,
                place: parent.place + "." + field,
                root: parent.root,
                parent_reference: parent.parent_reference,
            }
        },
        ExpressionCase::expression(Expression::Dereference(subject, _)) => {
            let parent = place_provenance(subject);
            PlaceProvenance {
                found: true,
                place: "*" + parent.place,
                root: "",
                parent_reference: parent.place,
            }
        },
        ExpressionCase::expression(_) => PlaceProvenance {
            found: false,
            place: "<temporary>",
            root: "",
            parent_reference: "",
        }
    }
}

expression_is_place(expression: Expression) -> Bool / {ExpressionCase} {
    place_provenance(expression).found
}

join_span(first: SourceSpan, second: SourceSpan) -> SourceSpan {
    SourceSpan { start: first.start, end: second.end }
}

parse_arguments(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    arguments: List<Expression>,
) -> ParsedArguments / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightParen) => ParsedArguments {
            arguments: arguments,
            closing_span: found.span,
            next: index + 1,
        },
        TokenCase::token(_) => {
            let argument = parse_expression(
                source, tokens, index, type_parameters
            );
            let delimiter = token_at(source, tokens, argument.next);
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Comma) => parse_arguments(
                    source,
                    tokens,
                    argument.next + 1,
                    type_parameters,
                    core::list_push(arguments, argument.expression)
                ),
                TokenCase::token(TokenKind::RightParen) => ParsedArguments {
                    arguments: core::list_push(arguments, argument.expression),
                    closing_span: delimiter.span,
                    next: argument.next + 1,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0205",
                    "expected `,` or `)`",
                    delimiter.span,
                    "call arguments must be separated by commas",
                    [],
                    "argument parsing stops before consuming the unexpected token",
                    "insert `,` between arguments or close the call with `)`"
                )
            }
        }
    }
}

parse_list_items(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    items: List<Expression>,
) -> ParsedArguments / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightBracket) => ParsedArguments {
            arguments: items,
            closing_span: found.span,
            next: index + 1,
        },
        TokenCase::token(_) => {
            let item = parse_expression(source, tokens, index, type_parameters);
            let delimiter = token_at(source, tokens, item.next);
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Comma) => parse_list_items(
                    source, tokens, item.next + 1, type_parameters,
                    core::list_push(items, item.expression)
                ),
                TokenCase::token(TokenKind::RightBracket) => ParsedArguments {
                    arguments: core::list_push(items, item.expression),
                    closing_span: delimiter.span,
                    next: item.next + 1,
                },
                TokenCase::token(_) => compiler_error(
                    source, "GRC0224", "expected `,` or `]`",
                    delimiter.span,
                    "list elements must be separated by commas", [],
                    "list literals preserve element order",
                    "insert `,` or close the list with `]`"
                )
            }
        }
    }
}

parse_named_expressions(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    fields: List<NamedExpression>,
) -> ParsedNamedExpressions / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightBrace) => ParsedNamedExpressions {
            fields: fields,
            closing_span: found.span,
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            let colon = token_at(source, tokens, index + 1);
            expect_kind(source, colon, TokenKind::Colon, "`:` after the field name");
            let value = parse_expression(
                source, tokens, index + 2, type_parameters
            );
            let delimiter = token_at(source, tokens, value.next);
            let next_fields = core::list_push(fields, NamedExpression {
                name: name,
                name_span: found.span,
                value: value.expression,
            });
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Comma) => parse_named_expressions(
                    source,
                    tokens,
                    value.next + 1,
                    type_parameters,
                    next_fields
                ),
                TokenCase::token(TokenKind::RightBrace) => ParsedNamedExpressions {
                    fields: next_fields,
                    closing_span: delimiter.span,
                    next: value.next + 1,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0212",
                    "expected `,` or `}`",
                    delimiter.span,
                    "constructed fields must be separated by commas",
                    [],
                    "named construction records every field expression and its span",
                    "insert `,` or close the value with `}`"
                )
            }
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0213",
            "expected a constructed field",
            found.span,
            "expected a field name or `}`",
            [],
            "struct construction uses `Type { field: value }`",
            "write a named field or close the value"
        )
    }
}

pattern_span(pattern: Pattern) -> SourceSpan {
    handle perform PatternCase::inspect(pattern) {
        PatternCase::inspect(Pattern::Wildcard(span)) => span,
        PatternCase::inspect(Pattern::Binding(_, span)) => span,
        PatternCase::inspect(Pattern::Unit(span)) => span,
        PatternCase::inspect(Pattern::Integer(_, span)) => span,
        PatternCase::inspect(Pattern::String(_, span)) => span,
        PatternCase::inspect(Pattern::Variant(_, _, _, span)) => span
    }
}

parse_pattern(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedPattern / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Identifier("_")) => ParsedPattern {
            pattern: Pattern::Wildcard(found.span),
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            let following = token_at(source, tokens, index + 1);
            if(following.kind == TokenKind::DoubleColon) {
                let variant_token = token_at(source, tokens, index + 2);
                let variant_name = read_identifier(source, variant_token);
                let after_variant = token_at(source, tokens, index + 3);
                if(after_variant.kind == TokenKind::LeftParen) {
                    let fields = parse_patterns(source, tokens, index + 4, []);
                    ParsedPattern {
                        pattern: Pattern::Variant(
                            name,
                            variant_name,
                            fields.patterns,
                            join_span(found.span, fields.closing_span)
                        ),
                        next: fields.next,
                    }
                } else {
                    ParsedPattern {
                        pattern: Pattern::Variant(
                            name,
                            variant_name,
                            [],
                            join_span(found.span, variant_token.span)
                        ),
                        next: index + 3,
                    }
                }
            } else {
                ParsedPattern {
                    pattern: Pattern::Binding(name, found.span),
                    next: index + 1,
                }
            }
        },
        TokenCase::token(TokenKind::Integer(text)) => ParsedPattern {
            pattern: Pattern::Integer(core::parse_i64(text), found.span),
            next: index + 1,
        },
        TokenCase::token(TokenKind::String(value)) => ParsedPattern {
            pattern: Pattern::String(value, found.span),
            next: index + 1,
        },
        TokenCase::token(TokenKind::LeftParen) => {
            let close = token_at(source, tokens, index + 1);
            expect_kind(source, close, TokenKind::RightParen, "`)` in unit pattern");
            ParsedPattern {
                pattern: Pattern::Unit(join_span(found.span, close.span)),
                next: index + 2,
            }
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0221",
            "expected a handler pattern",
            found.span,
            "handler clauses accept bindings, `_`, literals, and enum variants",
            [],
            "patterns eliminate operation arguments structurally",
            "write a pattern such as `Result::Ok(value)`"
        )
    }
}

parse_patterns(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    patterns: List<Pattern>,
) -> ParsedPatterns / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    if(found.kind == TokenKind::RightParen) {
        ParsedPatterns {
            patterns: patterns,
            closing_span: found.span,
            next: index + 1,
        }
    } else {
        let pattern = parse_pattern(source, tokens, index);
        let delimiter = token_at(source, tokens, pattern.next);
        handle perform TokenCase::token(delimiter.kind) {
            TokenCase::token(TokenKind::Comma) => parse_patterns(
                source,
                tokens,
                pattern.next + 1,
                core::list_push(patterns, pattern.pattern)
            ),
            TokenCase::token(TokenKind::RightParen) => ParsedPatterns {
                patterns: core::list_push(patterns, pattern.pattern),
                closing_span: delimiter.span,
                next: pattern.next + 1,
            },
            TokenCase::token(_) => compiler_error(
                source,
                "GRC0222",
                "expected `,` or `)` after pattern",
                delimiter.span,
                "handler operation patterns must be separated by commas",
                [],
                "each operation argument has one corresponding pattern",
                "insert `,` or close the pattern list"
            )
        }
    }
}

parse_handler_clauses(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    clauses: List<HandlerClause>,
) -> ParsedHandlerClauses / {
    ResultCase, TokenCase, ExpressionCase, Diagnostics
} {
    let found = token_at(source, tokens, index);
    if(found.kind == TokenKind::RightBrace) {
        ParsedHandlerClauses {
            clauses: clauses,
            closing_span: found.span,
            next: index + 1,
        }
    } else {
        let effect_name = read_identifier(source, found);
        expect_kind(
            source,
            token_at(source, tokens, index + 1),
            TokenKind::DoubleColon,
            "`::` in handler clause"
        );
        let operation_token = token_at(source, tokens, index + 2);
        let operation_name = read_identifier(source, operation_token);
        expect_kind(
            source,
            token_at(source, tokens, index + 3),
            TokenKind::LeftParen,
            "`(` before handler patterns"
        );
        let patterns = parse_patterns(source, tokens, index + 4, []);
        let maybe_with = token_at(source, tokens, patterns.next);
        let has_resumption = maybe_with.kind == TokenKind::Identifier("with");
        let resumption_token = if(has_resumption) {
            token_at(source, tokens, patterns.next + 1)
        } else {
            maybe_with
        };
        let resumption_name = if(has_resumption) {
            read_identifier(source, resumption_token)
        } else {
            ""
        };
        let arrow_index = if(has_resumption) {
            patterns.next + 2
        } else {
            patterns.next
        };
        let arrow = token_at(source, tokens, arrow_index);
        expect_kind(source, arrow, TokenKind::FatArrow, "`=>`");
        let body = parse_expression(
            source, tokens, arrow_index + 1, type_parameters
        );
        let clause = HandlerClause {
            effect_name: effect_name,
            operation_name: operation_name,
            patterns: patterns.patterns,
            resumption_name: resumption_name,
            resumption_span: resumption_token.span,
            has_resumption: has_resumption,
            body: body.expression,
            span: join_span(found.span, expression_span(body.expression)),
        };
        let delimiter = token_at(source, tokens, body.next);
        handle perform TokenCase::token(delimiter.kind) {
            TokenCase::token(TokenKind::Comma) => parse_handler_clauses(
                source,
                tokens,
                body.next + 1,
                type_parameters,
                core::list_push(clauses, clause)
            ),
            TokenCase::token(TokenKind::RightBrace) => ParsedHandlerClauses {
                clauses: core::list_push(clauses, clause),
                closing_span: delimiter.span,
                next: body.next + 1,
            },
            TokenCase::token(_) => compiler_error(
                source,
                "GRC0223",
                "expected `,` or `}` after handler clause",
                delimiter.span,
                "handler clauses must be separated by commas",
                [],
                "terminal handler clauses each produce the handled expression result",
                "insert `,` or close the handler"
            )
        }
    }
}

parse_atom(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Ampersand) => {
            let following = token_at(source, tokens, index + 1);
            let unique = following.kind == TokenKind::Identifier("mut");
            let operand = parse_primary(
                source, tokens, if(unique) { index + 2 } else { index + 1 },
                type_parameters
            );
            ParsedExpression {
                expression: Expression::Borrow(
                    operand.expression, unique,
                    join_span(found.span, expression_span(operand.expression))
                ),
                next: operand.next,
            }
        },
        TokenCase::token(TokenKind::Star) => {
            let operand = parse_primary(
                source, tokens, index + 1, type_parameters
            );
            ParsedExpression {
                expression: Expression::Dereference(
                    operand.expression,
                    join_span(found.span, expression_span(operand.expression))
                ),
                next: operand.next,
            }
        },
        TokenCase::token(TokenKind::Identifier("perform")) => {
            let effect_token = token_at(source, tokens, index + 1);
            let effect_name = read_identifier(source, effect_token);
            expect_kind(
                source,
                token_at(source, tokens, index + 2),
                TokenKind::DoubleColon,
                "`::` in effect operation"
            );
            let operation_token = token_at(source, tokens, index + 3);
            let operation_name = read_identifier(source, operation_token);
            expect_kind(
                source,
                token_at(source, tokens, index + 4),
                TokenKind::LeftParen,
                "`(` before operation arguments"
            );
            let arguments = parse_arguments(
                source, tokens, index + 5, type_parameters, []
            );
            ParsedExpression {
                expression: Expression::Perform(
                    effect_name,
                    operation_name,
                    arguments.arguments,
                    join_span(found.span, arguments.closing_span)
                ),
                next: arguments.next,
            }
        },
        TokenCase::token(TokenKind::Identifier("handle")) => {
            let computation = parse_expression(
                source, tokens, index + 1, type_parameters
            );
            let left_brace = token_at(source, tokens, computation.next);
            expect_kind(source, left_brace, TokenKind::LeftBrace, "`{` after computation");
            let clauses = parse_handler_clauses(
                source,
                tokens,
                computation.next + 1,
                type_parameters,
                []
            );
            ParsedExpression {
                expression: Expression::Handle(
                    computation.expression,
                    clauses.clauses,
                    join_span(found.span, clauses.closing_span)
                ),
                next: clauses.next,
            }
        },
        TokenCase::token(TokenKind::Integer(text)) => {
            require(
                core::is_i64(text),
                error_diagnostic(
                    source,
                    "GRC1102",
                    "integer literal is out of range",
                    found.span,
                    "this literal does not fit in a signed 64-bit integer",
                    [],
                    "integer range checks happen before LLVM lowering",
                    "use a value from 0 through 9223372036854775807, or negate 9223372036854775808"
                )
            );
            ParsedExpression {
                expression: Expression::Integer(core::parse_i64(text), found.span),
                next: index + 1,
            }
        },
        TokenCase::token(TokenKind::String(value)) => ParsedExpression {
            expression: Expression::String(value, found.span),
            next: index + 1,
        },
        TokenCase::token(TokenKind::LeftBracket) => {
            let items = parse_list_items(
                source, tokens, index + 1, type_parameters, []
            );
            ParsedExpression {
                expression: Expression::List(
                    items.arguments, join_span(found.span, items.closing_span)
                ),
                next: items.next,
            }
        },
        TokenCase::token(TokenKind::Minus) => {
            let operand = parse_primary(
                source, tokens, index + 1, type_parameters
            );
            ParsedExpression {
                expression: Expression::Negate(
                    operand.expression,
                    join_span(found.span, expression_span(operand.expression))
                ),
                next: operand.next,
            }
        },
        TokenCase::token(TokenKind::LeftParen) => {
            let following = token_at(source, tokens, index + 1);
            if(following.kind == TokenKind::RightParen) {
                ParsedExpression {
                    expression: Expression::Unit(join_span(found.span, following.span)),
                    next: index + 2,
                }
            } else {
                let inner = parse_expression(
                    source, tokens, index + 1, type_parameters
                );
                let close = token_at(source, tokens, inner.next);
                expect_kind(source, close, TokenKind::RightParen, "`)`");
                ParsedExpression { expression: inner.expression, next: inner.next + 1 }
            }
        },
        TokenCase::token(TokenKind::LeftBrace) => {
            let block = parse_block(source, tokens, index, type_parameters);
            ParsedExpression {
                expression: block.expression,
                next: block.next,
            }
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            let following = token_at(source, tokens, index + 1);
            if(following.kind == TokenKind::DoubleColon) {
                let variant_token = token_at(source, tokens, index + 2);
                let variant_name = read_identifier(source, variant_token);
                let after_variant = token_at(source, tokens, index + 3);
                if(after_variant.kind == TokenKind::LeftParen) {
                    let parsed = parse_arguments(
                        source, tokens, index + 4, type_parameters, []
                    );
                    ParsedExpression {
                        expression: if(name == "core") {
                            Expression::Call(
                                "core::" + variant_name,
                                parsed.arguments,
                                join_span(found.span, parsed.closing_span)
                            )
                        } else {
                            Expression::EnumValue(
                                name,
                                variant_name,
                                parsed.arguments,
                                join_span(found.span, parsed.closing_span)
                            )
                        },
                        next: parsed.next,
                    }
                } else {
                    ParsedExpression {
                        expression: Expression::EnumValue(
                            name,
                            variant_name,
                            [],
                            join_span(found.span, variant_token.span)
                        ),
                        next: index + 3,
                    }
                }
            } else {
            if(following.kind == TokenKind::LeftParen) {
                    let parsed = parse_arguments(
                        source, tokens, index + 2, type_parameters, []
                    );
                    let after_call = token_at(source, tokens, parsed.next);
                    if(after_call.kind == TokenKind::LeftBrace) {
                        let trailing = parse_block(
                            source, tokens, parsed.next, type_parameters
                        );
                        ParsedExpression {
                            expression: Expression::Call(
                                name,
                                core::list_push(parsed.arguments, trailing.expression),
                                join_span(found.span, expression_span(trailing.expression))
                            ),
                            next: trailing.next,
                        }
                    } else {
                        ParsedExpression {
                            expression: Expression::Call(
                                name,
                                parsed.arguments,
                                join_span(found.span, parsed.closing_span)
                            ),
                            next: parsed.next,
                        }
                    }
            } else {
                if(following.kind == TokenKind::LeftBrace) {
                    let parsed = parse_named_expressions(
                        source, tokens, index + 2, type_parameters, []
                    );
                    ParsedExpression {
                        expression: Expression::StructValue(
                            name,
                            parsed.fields,
                            join_span(found.span, parsed.closing_span)
                        ),
                        next: parsed.next,
                    }
                } else {
                ParsedExpression {
                    expression: Expression::Variable(name, found.span),
                    next: index + 1,
                }
                }
            }
            }
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC1101",
            "expected an expression",
            found.span,
            "expected an integer, call, unary `-`, or parenthesized expression",
            [],
            "the expression parser reports the token at which progress stopped",
            "write an expression such as `42`, `answer()`, or `(20 + 1) * 2`"
        )
    }
}

parse_projection_rest(
    source: SourceFile,
    tokens: List<Token>,
    left: ParsedExpression,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let found = token_at(source, tokens, left.next);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Dot) => {
            let field_token = token_at(source, tokens, left.next + 1);
            let field_name = read_identifier(source, field_token);
            parse_projection_rest(
                source,
                tokens,
                ParsedExpression {
                    expression: Expression::Field(
                        left.expression,
                        field_name,
                        join_span(expression_span(left.expression), field_token.span)
                    ),
                    next: left.next + 2,
                }
            )
        },
        TokenCase::token(_) => left
    }
}

parse_primary(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    parse_projection_rest(
        source, tokens, parse_atom(source, tokens, index, type_parameters)
    )
}

parse_multiplicative_rest(
    source: SourceFile,
    tokens: List<Token>,
    left: ParsedExpression,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let operator = token_at(source, tokens, left.next);
    handle perform TokenCase::token(operator.kind) {
        TokenCase::token(TokenKind::Star) => {
            let right = parse_primary(
                source, tokens, left.next + 1, type_parameters
            );
            parse_multiplicative_rest(
                source,
                tokens,
                ParsedExpression {
                    expression: Expression::Binary(
                        BinaryOperator::Multiply,
                        left.expression,
                        right.expression,
                        join_span(expression_span(left.expression), expression_span(right.expression))
                    ),
                    next: right.next,
                },
                type_parameters
            )
        },
        TokenCase::token(TokenKind::Slash) => {
            let right = parse_primary(
                source, tokens, left.next + 1, type_parameters
            );
            parse_multiplicative_rest(
                source,
                tokens,
                ParsedExpression {
                    expression: Expression::Binary(
                        BinaryOperator::Divide,
                        left.expression,
                        right.expression,
                        join_span(expression_span(left.expression), expression_span(right.expression))
                    ),
                    next: right.next,
                },
                type_parameters
            )
        },
        TokenCase::token(_) => left
    }
}

parse_multiplicative(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    parse_multiplicative_rest(
        source,
        tokens,
        parse_primary(source, tokens, index, type_parameters),
        type_parameters
    )
}

parse_additive_rest(
    source: SourceFile,
    tokens: List<Token>,
    left: ParsedExpression,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let operator = token_at(source, tokens, left.next);
    handle perform TokenCase::token(operator.kind) {
        TokenCase::token(TokenKind::Plus) => {
            let right = parse_multiplicative(
                source, tokens, left.next + 1, type_parameters
            );
            parse_additive_rest(
                source,
                tokens,
                ParsedExpression {
                    expression: Expression::Binary(
                        BinaryOperator::Add,
                        left.expression,
                        right.expression,
                        join_span(expression_span(left.expression), expression_span(right.expression))
                    ),
                    next: right.next,
                },
                type_parameters
            )
        },
        TokenCase::token(TokenKind::Minus) => {
            let right = parse_multiplicative(
                source, tokens, left.next + 1, type_parameters
            );
            parse_additive_rest(
                source,
                tokens,
                ParsedExpression {
                    expression: Expression::Binary(
                        BinaryOperator::Subtract,
                        left.expression,
                        right.expression,
                        join_span(expression_span(left.expression), expression_span(right.expression))
                    ),
                    next: right.next,
                },
                type_parameters
            )
        },
        TokenCase::token(_) => left
    }
}

parse_additive(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    parse_additive_rest(
        source,
        tokens,
        parse_multiplicative(source, tokens, index, type_parameters),
        type_parameters
    )
}

parse_comparison_rest(
    source: SourceFile,
    tokens: List<Token>,
    left: ParsedExpression,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let operator = token_at(source, tokens, left.next);
    handle perform TokenCase::token(operator.kind) {
        TokenCase::token(TokenKind::EqualEqual) => {
            let right = parse_additive(
                source, tokens, left.next + 1, type_parameters
            );
            ParsedExpression {
                expression: Expression::Binary(
                    BinaryOperator::Equal,
                    left.expression,
                    right.expression,
                    join_span(expression_span(left.expression), expression_span(right.expression))
                ),
                next: right.next,
            }
        },
        TokenCase::token(TokenKind::BangEqual) => {
            let right = parse_additive(
                source, tokens, left.next + 1, type_parameters
            );
            ParsedExpression {
                expression: Expression::Binary(
                    BinaryOperator::NotEqual,
                    left.expression, right.expression,
                    join_span(expression_span(left.expression), expression_span(right.expression))
                ),
                next: right.next,
            }
        },
        TokenCase::token(TokenKind::Less) => {
            let right = parse_additive(
                source, tokens, left.next + 1, type_parameters
            );
            ParsedExpression {
                expression: Expression::Binary(
                    BinaryOperator::LessThan,
                    left.expression,
                    right.expression,
                    join_span(expression_span(left.expression), expression_span(right.expression))
                ),
                next: right.next,
            }
        },
        TokenCase::token(TokenKind::LessEqual) => {
            let right = parse_additive(
                source, tokens, left.next + 1, type_parameters
            );
            ParsedExpression {
                expression: Expression::Binary(
                    BinaryOperator::LessThanOrEqual,
                    left.expression, right.expression,
                    join_span(expression_span(left.expression), expression_span(right.expression))
                ),
                next: right.next,
            }
        },
        TokenCase::token(TokenKind::Greater) => {
            let right = parse_additive(
                source, tokens, left.next + 1, type_parameters
            );
            ParsedExpression {
                expression: Expression::Binary(
                    BinaryOperator::GreaterThan,
                    left.expression,
                    right.expression,
                    join_span(expression_span(left.expression), expression_span(right.expression))
                ),
                next: right.next,
            }
        },
        TokenCase::token(TokenKind::GreaterEqual) => {
            let right = parse_additive(
                source, tokens, left.next + 1, type_parameters
            );
            ParsedExpression {
                expression: Expression::Binary(
                    BinaryOperator::GreaterThanOrEqual,
                    left.expression, right.expression,
                    join_span(expression_span(left.expression), expression_span(right.expression))
                ),
                next: right.next,
            }
        },
        TokenCase::token(_) => left
    }
}

parse_comparison(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    parse_comparison_rest(
        source,
        tokens,
        parse_additive(source, tokens, index, type_parameters),
        type_parameters
    )
}

parse_word_expression_rest(
    source: SourceFile,
    tokens: List<Token>,
    left: ParsedExpression,
    minimum_precedence: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let found = token_at(source, tokens, left.next);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::WordOperator(
            name,
            precedence,
            right_associative,
            lazy_rhs
        )) => {
            if(precedence < minimum_precedence) {
                left
            } else {
                let right_minimum = if(right_associative) {
                    precedence
                } else {
                    precedence + 1
                };
                let right = parse_word_expression(
                    source,
                    tokens,
                    left.next + 1,
                    right_minimum,
                    type_parameters
                );
                parse_word_expression_rest(
                    source,
                    tokens,
                    ParsedExpression {
                        expression: Expression::Call(
                            name,
                            [
                                left.expression,
                                if(lazy_rhs) {
                                    Expression::Block([
                                        BlockStatement::Value(right.expression)
                                    ], expression_span(right.expression))
                                } else {
                                    right.expression
                                }
                            ],
                            join_span(
                                expression_span(left.expression),
                                expression_span(right.expression)
                            )
                        ),
                        next: right.next,
                    },
                    minimum_precedence,
                    type_parameters
                )
            }
        },
        TokenCase::token(_) => left
    }
}

parse_word_expression(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    minimum_precedence: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    parse_word_expression_rest(
        source,
        tokens,
        parse_comparison(source, tokens, index, type_parameters),
        minimum_precedence,
        type_parameters
    )
}

parse_expression(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedExpression / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    parse_word_expression(source, tokens, index, 0, type_parameters)
}

parse_parameters(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    parameters: List<Parameter>,
) -> ParsedParameters / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightParen) => ParsedParameters {
            parameters: parameters,
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            let colon = token_at(source, tokens, index + 1);
            expect_kind(source, colon, TokenKind::Colon, "`:` after the parameter name");
            let parameter_type = parse_type(source, tokens, index + 2, type_parameters);
            let delimiter = token_at(source, tokens, parameter_type.next);
            let next_parameters = core::list_push(
                parameters,
                Parameter {
                    name: name,
                    span: found.span,
                    parameter_type: parameter_type.reference,
                    is_local: false,
                    drop_flag: "",
                    llvm_name: "%arg_" + name,
                }
            );
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Comma) => parse_parameters(
                    source,
                    tokens,
                    parameter_type.next + 1,
                    type_parameters,
                    next_parameters
                ),
                TokenCase::token(TokenKind::RightParen) => ParsedParameters {
                    parameters: next_parameters,
                    next: parameter_type.next + 1,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0206",
                    "expected `,` or `)`",
                    delimiter.span,
                    "parameters must be separated by commas",
                    [DiagnosticLabel {
                        span: found.span,
                        message: "after this parameter",
                    }],
                    "each parameter has the form `name: Type`",
                    "insert `,` or close the parameter list with `)`"
                )
            }
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0207",
            "expected a parameter",
            found.span,
            "expected a parameter name or `)`",
            [],
            "each parameter has the form `name: Type`",
            "write `name: i32`, `name: i64`, or close the list"
        )
    }
}

parse_block_statements(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    start: SourceSpan,
    type_parameters: List<TypeParameter>,
    statements: List<BlockStatement>,
) -> ParsedBlock / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Identifier("let")) => {
            let name_token = token_at(source, tokens, index + 1);
            let name = read_identifier(source, name_token);
            let delimiter = token_at(source, tokens, index + 2);
            let local_type = if(delimiter.kind == TokenKind::Colon) {
                parse_type(source, tokens, index + 3, type_parameters)
            } else {
                ParsedType {
                    reference: TypeRef {
                        kind: SourceType::Inferred,
                        span: name_token.span,
                    },
                    next: index + 2,
                }
            };
            let equal = token_at(source, tokens, local_type.next);
            expect_kind(source, equal, TokenKind::Equal, "`=` in the local binding");
            let value = parse_expression(
                source, tokens, local_type.next + 1, type_parameters
            );
            let semicolon = token_at(source, tokens, value.next);
            expect_kind(source, semicolon, TokenKind::Semicolon, "`;` after the local binding");
            parse_block_statements(
                source,
                tokens,
                value.next + 1,
                start,
                type_parameters,
                core::list_push(statements, BlockStatement::Let(
                    name,
                    name_token.span,
                    local_type.reference,
                    value.expression,
                    join_span(found.span, semicolon.span)
                ))
            )
        },
        TokenCase::token(TokenKind::RightBrace) => compiler_error(
            source,
            "GRC0219",
            "block has no final value",
            found.span,
            "a value-yielding block must end with an expression",
            [],
            "callable and nested blocks currently receive their type from the final expression",
            "add a final expression before `}`"
        ),
        TokenCase::token(_) => {
            let value = parse_expression(
                source, tokens, index, type_parameters
            );
            let delimiter = token_at(source, tokens, value.next);
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Semicolon) => parse_block_statements(
                    source,
                    tokens,
                    value.next + 1,
                    start,
                    type_parameters,
                    core::list_push(statements, BlockStatement::Value(value.expression))
                ),
                TokenCase::token(TokenKind::RightBrace) => ParsedBlock {
                    expression: Expression::Block(
                        core::list_push(statements, BlockStatement::Value(value.expression)),
                        join_span(start, delimiter.span)
                    ),
                    next: value.next + 1,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0218",
                    "expected `;` or `}`",
                    delimiter.span,
                    "block expressions must be separated by semicolons",
                    [],
                    "the final expression before `}` supplies the block value",
                    "insert `;` or close the block"
                )
            }
        }
    }
}

parse_block(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedBlock / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let left_brace = token_at(source, tokens, index);
    expect_kind(source, left_brace, TokenKind::LeftBrace, "`{`");
    parse_block_statements(
        source, tokens, index + 1, left_brace.span, type_parameters, []
    )
}

parse_callable_constraints_rest(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    constraints: List<CallableConstraint>,
    use_constraints: List<UseConstraint>,
    environment_constraints: List<EnvironmentConstraint>,
    runs_in_constraints: List<RunsInConstraint>,
) -> ParsedCallableConstraints / {ResultCase, TokenCase, Diagnostics} {
    let parameter_token = token_at(source, tokens, index);
    let parameter_name = read_identifier(source, parameter_token);
    require(
        type_parameter_is_present(type_parameters, parameter_name, 0),
        error_diagnostic(
            source,
            "GRC0316",
            "unknown constrained type parameter",
            parameter_token.span,
            "`" + parameter_name + "` is not declared by this callable",
            [],
            "callable bounds apply to generic parameters introduced after the name",
            "declare `" + parameter_name + "` in the generic parameter list"
        )
    );
    expect_kind(
        source,
        token_at(source, tokens, index + 1),
        TokenKind::Colon,
        "`:` in the callable constraint"
    );
    let constraint_name = read_identifier(
        source, token_at(source, tokens, index + 2)
    );
    let parsed = if(constraint_name == "Fn") {
        expect_kind(source, token_at(source, tokens, index + 3), TokenKind::Less, "`<`");
        expect_kind(
            source,
            token_at(source, tokens, index + 4),
            TokenKind::LeftParen,
            "`()` argument tuple"
        );
        expect_kind(
            source,
            token_at(source, tokens, index + 5),
            TokenKind::RightParen,
            "`()` argument tuple"
        );
        expect_kind(source, token_at(source, tokens, index + 6), TokenKind::Comma, "`,`");
        expect_identifier(source, token_at(source, tokens, index + 7), "Output");
        expect_kind(source, token_at(source, tokens, index + 8), TokenKind::Equal, "`=`");
        let output = parse_type(source, tokens, index + 9, type_parameters);
        let closing = token_at(source, tokens, output.next);
        expect_kind(source, closing, TokenKind::Greater, "`>`");
        ParsedCallableConstraints {
            constraints: core::list_push(constraints, CallableConstraint {
                parameter_name: parameter_name,
                parameter_span: parameter_token.span,
                output: output.reference,
                span: join_span(parameter_token.span, closing.span),
            }),
            use_constraints: use_constraints,
            environment_constraints: environment_constraints,
            runs_in_constraints: runs_in_constraints,
            next: output.next + 1,
        }
    } else {
        if(constraint_name == "Use") {
            expect_kind(source, token_at(source, tokens, index + 3), TokenKind::Less, "`<`");
            let quantity = parse_use_quantity(source, tokens, index + 4);
            let closing = token_at(source, tokens, quantity.next);
            expect_kind(source, closing, TokenKind::Greater, "`>`");
            ParsedCallableConstraints {
                constraints: constraints,
                use_constraints: core::list_push(use_constraints, UseConstraint {
                    parameter_name: parameter_name,
                    parameter_span: parameter_token.span,
                    lower: quantity.lower,
                    upper: quantity.upper,
                    span: join_span(parameter_token.span, closing.span),
                }),
                environment_constraints: environment_constraints,
                runs_in_constraints: runs_in_constraints,
                next: quantity.next + 1,
            }
        } else {
            if(constraint_name == "Environment") {
                ParsedCallableConstraints {
                    constraints: constraints,
                    use_constraints: use_constraints,
                    environment_constraints: core::list_push(
                        environment_constraints,
                        EnvironmentConstraint {
                            parameter_name: parameter_name,
                            parameter_span: parameter_token.span,
                            span: join_span(
                                parameter_token.span,
                                token_at(source, tokens, index + 2).span
                            ),
                        }
                    ),
                    runs_in_constraints: runs_in_constraints,
                    next: index + 3,
                }
            } else {
                if(constraint_name == "RunsIn") {
                    expect_kind(source, token_at(source, tokens, index + 3), TokenKind::Less, "`<`");
                    let environment_token = token_at(source, tokens, index + 4);
                    let environment_name = read_identifier(source, environment_token);
                    require(
                        type_parameter_is_present(type_parameters, environment_name, 0),
                        error_diagnostic(
                            source, "GRC0323", "unknown RunsIn environment",
                            environment_token.span,
                            "`" + environment_name + "` is not a type parameter of this callable",
                            [],
                            "RunsIn environment brands are generic static identities",
                            "declare the environment type parameter before using it"
                        )
                    );
                    expect_kind(source, token_at(source, tokens, index + 5), TokenKind::Comma, "`,`");
                    expect_kind(source, token_at(source, tokens, index + 6), TokenKind::LeftParen, "`()` argument tuple");
                    expect_kind(source, token_at(source, tokens, index + 7), TokenKind::RightParen, "`()` argument tuple");
                    expect_kind(source, token_at(source, tokens, index + 8), TokenKind::Comma, "`,`");
                    expect_identifier(source, token_at(source, tokens, index + 9), "After");
                    expect_kind(source, token_at(source, tokens, index + 10), TokenKind::Equal, "`=`");
                    let after_token = token_at(source, tokens, index + 11);
                    let after_name = read_identifier(source, after_token);
                    require(
                        type_parameter_is_present(type_parameters, after_name, 0),
                        error_diagnostic(
                            source, "GRC0324", "unknown RunsIn post-environment",
                            after_token.span,
                            "`" + after_name + "` is not a type parameter of this callable",
                            [],
                            "the After identity describes ownership state after normal return",
                            "declare the post-environment type parameter before using it"
                        )
                    );
                    let closing = token_at(source, tokens, index + 12);
                    expect_kind(source, closing, TokenKind::Greater, "`>`");
                    ParsedCallableConstraints {
                        constraints: constraints,
                        use_constraints: use_constraints,
                        environment_constraints: environment_constraints,
                        runs_in_constraints: core::list_push(
                            runs_in_constraints,
                            RunsInConstraint {
                                callable_parameter_name: parameter_name,
                                callable_parameter_span: parameter_token.span,
                                environment_parameter_name: environment_name,
                                environment_parameter_span: environment_token.span,
                                after_parameter_name: after_name,
                                after_parameter_span: after_token.span,
                                span: join_span(parameter_token.span, closing.span),
                            }
                        ),
                        next: index + 13,
                    }
                } else {
                    compiler_error(
                        source,
                        "GRC0318",
                        "unsupported generic constraint",
                        token_at(source, tokens, index + 2).span,
                        "expected `Fn`, `Use`, `Environment`, or `RunsIn`",
                        [],
                        "the constraint solver exposes callable, ownership, and environment-transition evidence",
                        "use a supported intrinsic relation"
                    )
                }
            }
        }
    };
    let delimiter = token_at(source, tokens, parsed.next);
    handle perform TokenCase::token(delimiter.kind) {
        TokenCase::token(TokenKind::Comma) => parse_callable_constraints_rest(
            source,
            tokens,
            parsed.next + 1,
            type_parameters,
            parsed.constraints,
            parsed.use_constraints,
            parsed.environment_constraints,
            parsed.runs_in_constraints
        ),
        TokenCase::token(TokenKind::Semicolon) => ParsedCallableConstraints {
            constraints: parsed.constraints,
            use_constraints: parsed.use_constraints,
            environment_constraints: parsed.environment_constraints,
            runs_in_constraints: parsed.runs_in_constraints,
            next: parsed.next + 1,
        },
        TokenCase::token(_) => ParsedCallableConstraints {
            constraints: parsed.constraints,
            use_constraints: parsed.use_constraints,
            environment_constraints: parsed.environment_constraints,
            runs_in_constraints: parsed.runs_in_constraints,
            next: parsed.next,
        }
    }
}

parse_callable_constraints(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedCallableConstraints / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Identifier("where")) =>
            parse_callable_constraints_rest(
                source, tokens, index + 1, type_parameters, [], [], [], []
            ),
        TokenCase::token(_) => ParsedCallableConstraints {
            constraints: [],
            use_constraints: [],
            environment_constraints: [],
            runs_in_constraints: [],
            next: index,
        }
    }
}

parse_effect_row_items(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    effects: List<TypeRef>,
) -> ParsedEffectRow / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightBrace) => ParsedEffectRow {
            effects: effects,
            next: index + 1,
        },
        TokenCase::token(_) => {
            let effect = parse_type(source, tokens, index, type_parameters);
            let delimiter = token_at(source, tokens, effect.next);
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Comma) => parse_effect_row_items(
                    source,
                    tokens,
                    effect.next + 1,
                    type_parameters,
                    core::list_push(effects, effect.reference)
                ),
                TokenCase::token(TokenKind::RightBrace) => ParsedEffectRow {
                    effects: core::list_push(effects, effect.reference),
                    next: effect.next + 1,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0317",
                    "expected `,` or `}` in effect row",
                    delimiter.span,
                    "callable effects must be separated by commas",
                    [],
                    "effect rows contain nominal effect protocol types",
                    "insert `,` or close the effect row"
                )
            }
        }
    }
}

parse_effect_row(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
) -> ParsedEffectRow / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::Slash) => {
            expect_kind(
                source,
                token_at(source, tokens, index + 1),
                TokenKind::LeftBrace,
                "`{` after `/`"
            );
            parse_effect_row_items(source, tokens, index + 2, type_parameters, [])
        },
        TokenCase::token(_) => ParsedEffectRow { effects: [], next: index }
    }
}

parse_callable(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    globals: List<GlobalDecl>,
) -> ParsedCallable / {
    ResultCase, TokenCase, ExpressionCase, GlobalLookupCase, BlockStatementCase,
    Diagnostics
} {
    let name_token = token_at(source, tokens, index);
    let name = read_identifier(source, name_token);
    require(
        name != "destroy" and
            name != "available_to_unit" and
            name != "defer_available" and
            name != "continue_available",
        error_diagnostic(
            source,
            "GRC1858",
            "compiler intrinsic name is reserved",
            name_token.span,
            "`" + name + "` denotes sealed compiler evidence",
            [],
            "intrinsic ownership operations must retain their compiler-defined identity",
            "choose another callable name"
        )
    );
    let type_parameters = parse_type_parameters(source, tokens, index + 1);
    let left_paren = token_at(source, tokens, type_parameters.next);
    expect_kind(source, left_paren, TokenKind::LeftParen, "`(`");
    let parameters = parse_parameters(
        source,
        tokens,
        type_parameters.next + 1,
        type_parameters.parameters,
        []
    );
    let arrow = token_at(source, tokens, parameters.next);
    expect_kind(source, arrow, TokenKind::Arrow, "`->`");
    let result_token = token_at(source, tokens, parameters.next + 1);
    let result_type = handle perform TokenCase::token(result_token.kind) {
        TokenCase::token(TokenKind::Slash) => ParsedType {
            reference: TypeRef {
                kind: SourceType::Unit, span: arrow.span,
            },
            next: parameters.next + 1,
        },
        TokenCase::token(TokenKind::Identifier("where")) => ParsedType {
            reference: TypeRef {
                kind: SourceType::Unit, span: arrow.span,
            },
            next: parameters.next + 1,
        },
        TokenCase::token(TokenKind::LeftBrace) => ParsedType {
            reference: TypeRef {
                kind: SourceType::Unit, span: arrow.span,
            },
            next: parameters.next + 1,
        },
        TokenCase::token(_) => parse_type(
            source, tokens, parameters.next + 1,
            type_parameters.parameters
        )
    };
    let leading_effects = parse_effect_row(
        source,
        tokens,
        result_type.next,
        type_parameters.parameters
    );
    let constraints = parse_callable_constraints(
        source,
        tokens,
        leading_effects.next,
        type_parameters.parameters
    );
    let trailing_effects = parse_effect_row(
        source,
        tokens,
        constraints.next,
        type_parameters.parameters
    );
    let effects = if(core::list_len(leading_effects.effects) > 0) {
        leading_effects.effects
    } else {
        trailing_effects.effects
    };
    let body = parse_block(
        source, tokens, trailing_effects.next, type_parameters.parameters
    );
    ParsedCallable {
        callable: CallableDecl {
            name: name,
            name_span: name_token.span,
            type_parameters: type_parameters.parameters,
            callable_constraints: constraints.constraints,
            use_constraints: constraints.use_constraints,
            environment_constraints: constraints.environment_constraints,
            runs_in_constraints: constraints.runs_in_constraints,
            parameters: parameters.parameters,
            result_type: result_type.reference,
            effects: effects,
            body: rewrite_global_references(
                body.expression,
                globals,
                parameter_names(parameters.parameters, 0, [])
            ),
            span: join_span(name_token.span, expression_span(body.expression)),
        },
        next: body.next,
    }
}

parse_type_alias(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedTypeAlias / {ResultCase, TokenCase, Diagnostics} {
    let keyword = token_at(source, tokens, index);
    let name_token = token_at(source, tokens, index + 1);
    let name = read_identifier(source, name_token);
    let type_parameters = parse_type_parameters(source, tokens, index + 2);
    let equal = token_at(source, tokens, type_parameters.next);
    expect_kind(source, equal, TokenKind::Equal, "`=`");
    let target = parse_type(
        source,
        tokens,
        type_parameters.next + 1,
        type_parameters.parameters
    );
    let semicolon = token_at(source, tokens, target.next);
    expect_kind(source, semicolon, TokenKind::Semicolon, "`;`");
    ParsedTypeAlias {
        declaration: TypeAliasDecl {
            name: name,
            name_span: name_token.span,
            type_parameters: type_parameters.parameters,
            target: target.reference,
            span: join_span(keyword.span, semicolon.span),
        },
        next: target.next + 1,
    }
}

parse_struct_fields(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    fields: List<StructFieldDecl>,
) -> ParsedStructFields / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightBrace) => ParsedStructFields {
            fields: fields,
            closing_span: found.span,
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            let colon = token_at(source, tokens, index + 1);
            expect_kind(source, colon, TokenKind::Colon, "`:` after the field name");
            let field_type = parse_type(source, tokens, index + 2, type_parameters);
            let delimiter = token_at(source, tokens, field_type.next);
            let next_fields = core::list_push(fields, StructFieldDecl {
                name: name,
                name_span: found.span,
                field_type: field_type.reference,
            });
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Comma) =>
                    parse_struct_fields(
                        source,
                        tokens,
                        field_type.next + 1,
                        type_parameters,
                        next_fields
                    ),
                TokenCase::token(TokenKind::RightBrace) => ParsedStructFields {
                    fields: next_fields,
                    closing_span: delimiter.span,
                    next: field_type.next + 1,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0210",
                    "expected `,` or `}`",
                    delimiter.span,
                    "struct fields must be separated by commas",
                    [DiagnosticLabel {
                        span: found.span,
                        message: "after this field",
                    }],
                    "field types are retained for nominal construction and LLVM layout",
                    "insert `,` or close the struct declaration with `}`"
                )
            }
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0211",
            "expected a struct field",
            found.span,
            "expected a field name or `}`",
            [],
            "struct fields use the form `name: Type`",
            "write a field declaration or close the struct"
        )
    }
}

parse_struct(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedStruct / {ResultCase, TokenCase, Diagnostics} {
    let keyword = token_at(source, tokens, index);
    let name_token = token_at(source, tokens, index + 1);
    let name = read_identifier(source, name_token);
    let type_parameters = parse_type_parameters(source, tokens, index + 2);
    let left_brace = token_at(source, tokens, type_parameters.next);
    expect_kind(source, left_brace, TokenKind::LeftBrace, "`{`");
    let fields = parse_struct_fields(
        source,
        tokens,
        type_parameters.next + 1,
        type_parameters.parameters,
        []
    );
    ParsedStruct {
        declaration: StructDecl {
            name: name,
            name_span: name_token.span,
            type_parameters: type_parameters.parameters,
            fields: fields.fields,
            span: join_span(keyword.span, fields.closing_span),
        },
        next: fields.next,
    }
}

parse_variant_types(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    types: List<TypeRef>,
) -> ParsedTypes / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightParen) => ParsedTypes {
            types: types,
            closing_span: found.span,
            next: index + 1,
        },
        TokenCase::token(_) => {
            let field_type = parse_type(source, tokens, index, type_parameters);
            let delimiter = token_at(source, tokens, field_type.next);
            let next_types = core::list_push(types, field_type.reference);
            handle perform TokenCase::token(delimiter.kind) {
                TokenCase::token(TokenKind::Comma) =>
                    parse_variant_types(
                        source,
                        tokens,
                        field_type.next + 1,
                        type_parameters,
                        next_types
                    ),
                TokenCase::token(TokenKind::RightParen) => ParsedTypes {
                    types: next_types,
                    closing_span: delimiter.span,
                    next: field_type.next + 1,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0214",
                    "expected `,` or `)`",
                    delimiter.span,
                    "variant payload types must be separated by commas",
                    [],
                    "payload types are stored in declaration order",
                    "insert `,` or close the variant payload list"
                )
            }
        }
    }
}

parse_variants(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    variants: List<VariantDecl>,
) -> ParsedVariants / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightBrace) => ParsedVariants {
            variants: variants,
            closing_span: found.span,
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            let following = token_at(source, tokens, index + 1);
            handle perform TokenCase::token(following.kind) {
                TokenCase::token(TokenKind::LeftParen) => {
                    let fields = parse_variant_types(
                        source,
                        tokens,
                        index + 2,
                        type_parameters,
                        []
                    );
                    let delimiter = token_at(source, tokens, fields.next);
                    let next_variants = core::list_push(variants, VariantDecl {
                        name: name,
                        name_span: found.span,
                        fields: fields.types,
                        span: join_span(found.span, fields.closing_span),
                    });
                    handle perform TokenCase::token(delimiter.kind) {
                        TokenCase::token(TokenKind::Comma) =>
                            parse_variants(
                                source,
                                tokens,
                                fields.next + 1,
                                type_parameters,
                                next_variants
                            ),
                        TokenCase::token(TokenKind::RightBrace) => ParsedVariants {
                            variants: next_variants,
                            closing_span: delimiter.span,
                            next: fields.next + 1,
                        },
                        TokenCase::token(_) => compiler_error(
                            source,
                            "GRC0216",
                            "expected `,` or `}`",
                            delimiter.span,
                            "enum variants must be separated by commas",
                            [],
                            "variant declarations retain their payload spans",
                            "insert `,` or close the enum"
                        )
                    }
                },
                TokenCase::token(TokenKind::Comma) => parse_variants(
                    source,
                    tokens,
                    index + 2,
                    type_parameters,
                    core::list_push(variants, VariantDecl {
                        name: name,
                        name_span: found.span,
                        fields: [],
                        span: found.span,
                    })
                ),
                TokenCase::token(TokenKind::RightBrace) => ParsedVariants {
                    variants: core::list_push(variants, VariantDecl {
                        name: name,
                        name_span: found.span,
                        fields: [],
                        span: found.span,
                    }),
                    closing_span: following.span,
                    next: index + 2,
                },
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0216",
                    "expected payloads, `,`, or `}`",
                    following.span,
                    "a variant name may be followed by payload types",
                    [],
                    "enum variants are nominal constructors",
                    "write `Variant`, `Variant(Type)`, or close the enum"
                )
            }
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0217",
            "expected an enum variant",
            found.span,
            "expected a variant name or `}`",
            [],
            "enum declarations contain nominal variant constructors",
            "write a variant or close the enum"
        )
    }
}

parse_enum(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedEnum / {ResultCase, TokenCase, Diagnostics} {
    let keyword = token_at(source, tokens, index);
    let name_token = token_at(source, tokens, index + 1);
    let name = read_identifier(source, name_token);
    let type_parameters = parse_type_parameters(source, tokens, index + 2);
    let left_brace = token_at(source, tokens, type_parameters.next);
    expect_kind(source, left_brace, TokenKind::LeftBrace, "`{`");
    let variants = parse_variants(
        source,
        tokens,
        type_parameters.next + 1,
        type_parameters.parameters,
        []
    );
    ParsedEnum {
        declaration: EnumDecl {
            name: name,
            name_span: name_token.span,
            type_parameters: type_parameters.parameters,
            variants: variants.variants,
            span: join_span(keyword.span, variants.closing_span),
        },
        next: variants.next,
    }
}

parse_resumption_quantity(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedResumptionQuantity / {ResultCase, TokenCase, Diagnostics} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::LeftBracket) => {
            let lower_token = token_at(source, tokens, index + 1);
            let lower = handle perform TokenCase::token(lower_token.kind) {
                TokenCase::token(TokenKind::Integer(text)) => core::parse_i64(text),
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0224",
                    "expected resumption lower bound",
                    lower_token.span,
                    "the first quantity bound must be an integer",
                    [],
                    "effect operation quantities are closed intervals",
                    "write a lower bound such as `0` or `1`"
                )
            };
            expect_kind(
                source,
                token_at(source, tokens, index + 2),
                TokenKind::Comma,
                "`,` in resumption quantity"
            );
            let upper_token = token_at(source, tokens, index + 3);
            let upper = handle perform TokenCase::token(upper_token.kind) {
                TokenCase::token(TokenKind::Integer(text)) => core::parse_i64(text),
                TokenCase::token(TokenKind::Star) => -1,
                TokenCase::token(TokenKind::Identifier("infinity")) => -1,
                TokenCase::token(_) => compiler_error(
                    source,
                    "GRC0225",
                    "expected resumption upper bound",
                    upper_token.span,
                    "the second quantity bound must be an integer or `infinity`",
                    [],
                    "`infinity` denotes an unbounded multi-shot resumption",
                    "write an upper bound such as `1` or `infinity`"
                )
            };
            expect_kind(
                source,
                token_at(source, tokens, index + 4),
                TokenKind::RightBracket,
                "`]` after resumption quantity"
            );
            ParsedResumptionQuantity {
                lower: lower,
                upper: upper,
                present: true,
                next: index + 5,
            }
        },
        TokenCase::token(_) => ParsedResumptionQuantity {
            lower: 1,
            upper: 1,
            present: false,
            next: index,
        }
    }
}

parse_effect_operations(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_parameters: List<TypeParameter>,
    operations: List<EffectOperationDecl>,
) -> ParsedEffectOperations / {ResultCase, TokenCase, Diagnostics} {
    let quantity = parse_resumption_quantity(source, tokens, index);
    let found = token_at(source, tokens, quantity.next);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::RightBrace) => ParsedEffectOperations {
            operations: operations,
            closing_span: found.span,
            next: index + 1,
        },
        TokenCase::token(TokenKind::Identifier(name)) => {
            let left_paren = token_at(source, tokens, quantity.next + 1);
            expect_kind(source, left_paren, TokenKind::LeftParen, "`(`");
            let parameters = parse_parameters(
                source,
                tokens,
                quantity.next + 2,
                type_parameters,
                []
            );
            let arrow = token_at(source, tokens, parameters.next);
            expect_kind(source, arrow, TokenKind::Arrow, "`->`");
            let result_token = token_at(
                source, tokens, parameters.next + 1
            );
            let result = if(result_token.kind == TokenKind::Semicolon) {
                ParsedType {
                    reference: TypeRef {
                        kind: SourceType::Unit, span: arrow.span,
                    },
                    next: parameters.next + 1,
                }
            } else {
                parse_type(
                    source, tokens, parameters.next + 1, type_parameters
                )
            };
            let semicolon = token_at(source, tokens, result.next);
            expect_kind(source, semicolon, TokenKind::Semicolon, "`;`");
            parse_effect_operations(
                source,
                tokens,
                result.next + 1,
                type_parameters,
                core::list_push(operations, EffectOperationDecl {
                    name: name,
                    name_span: found.span,
                    parameters: parameters.parameters,
                    result_type: result.reference,
                    resumption_lower: quantity.lower,
                    resumption_upper: quantity.upper,
                    has_resumption_quantity: quantity.present,
                    span: join_span(found.span, semicolon.span),
                })
            )
        },
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0220",
            "expected an effect operation",
            found.span,
            "effect bodies contain operation signatures or `}`",
            [],
            "terminal pattern dispatch operations return `!`",
            "write `inspect(value: T) -> !;` or close the effect"
        )
    }
}

parse_effect(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedEffect / {ResultCase, TokenCase, Diagnostics} {
    let keyword = token_at(source, tokens, index);
    let name_token = token_at(source, tokens, index + 1);
    let name = read_identifier(source, name_token);
    let type_parameters = parse_type_parameters(source, tokens, index + 2);
    let left_brace = token_at(source, tokens, type_parameters.next);
    expect_kind(source, left_brace, TokenKind::LeftBrace, "`{`");
    let operations = parse_effect_operations(
        source,
        tokens,
        type_parameters.next + 1,
        type_parameters.parameters,
        []
    );
    ParsedEffect {
        declaration: EffectDecl {
            name: name,
            name_span: name_token.span,
            type_parameters: type_parameters.parameters,
            operations: operations.operations,
            span: join_span(keyword.span, operations.closing_span),
        },
        next: operations.next,
    }
}

parse_use_quantity(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedResumptionQuantity / {ResultCase, TokenCase, Diagnostics} {
    let opening = token_at(source, tokens, index);
    expect_kind(source, opening, TokenKind::LeftBracket, "`[` in principal use interval");
    let lower_token = token_at(source, tokens, index + 1);
    let lower = handle perform TokenCase::token(lower_token.kind) {
        TokenCase::token(TokenKind::Integer(text)) => core::parse_i64(text),
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0321",
            "expected principal-use lower bound",
            lower_token.span,
            "the first `Use` bound must be a nonnegative integer",
            [],
            "principal owned-use quantities are closed intervals",
            "write a lower bound such as `0` or `1`"
        )
    };
    expect_kind(
        source,
        token_at(source, tokens, index + 2),
        TokenKind::Comma,
        "`,` in principal use interval"
    );
    let upper_token = token_at(source, tokens, index + 3);
    let upper = handle perform TokenCase::token(upper_token.kind) {
        TokenCase::token(TokenKind::Integer(text)) => core::parse_i64(text),
        TokenCase::token(TokenKind::Star) => -1,
        TokenCase::token(TokenKind::Identifier("infinity")) => -1,
        TokenCase::token(_) => compiler_error(
            source,
            "GRC0322",
            "expected principal-use upper bound",
            upper_token.span,
            "the second `Use` bound must be an integer or `infinity`",
            [],
            "`infinity` permits an unbounded number of owned uses",
            "write an upper bound such as `1` or `infinity`"
        )
    };
    let closing = token_at(source, tokens, index + 4);
    expect_kind(source, closing, TokenKind::RightBracket, "`]` after principal use interval");
    ParsedResumptionQuantity {
        lower: lower,
        upper: upper,
        present: true,
        next: index + 5,
    }
}

parse_use_declaration(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedUseDecl / {ResultCase, TokenCase, Diagnostics} {
    let keyword = token_at(source, tokens, index);
    expect_identifier(source, token_at(source, tokens, index + 1), "Use");
    expect_kind(source, token_at(source, tokens, index + 2), TokenKind::Less, "`<`");
    let quantity = parse_use_quantity(source, tokens, index + 3);
    let quantity_span = join_span(
        token_at(source, tokens, index + 3).span,
        token_at(source, tokens, quantity.next - 1).span
    );
    expect_kind(source, token_at(source, tokens, quantity.next), TokenKind::Greater, "`>`");
    expect_identifier(source, token_at(source, tokens, quantity.next + 1), "for");
    let target = parse_type(source, tokens, quantity.next + 2, []);
    let left_brace = token_at(source, tokens, target.next);
    expect_kind(source, left_brace, TokenKind::LeftBrace, "`{`");
    let right_brace = token_at(source, tokens, target.next + 1);
    expect_kind(source, right_brace, TokenKind::RightBrace, "`}`");
    ParsedUseDecl {
        declaration: UseDecl {
            target: target.reference,
            lower: quantity.lower,
            upper: quantity.upper,
            quantity_span: quantity_span,
            span: join_span(keyword.span, right_brace.span),
        },
        next: target.next + 2,
    }
}

parse_drop_declaration(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
) -> ParsedDropDecl / {ResultCase, TokenCase, ExpressionCase, Diagnostics} {
    let keyword = token_at(source, tokens, index);
    expect_identifier(source, token_at(source, tokens, index + 1), "Drop");
    expect_identifier(source, token_at(source, tokens, index + 2), "for");
    let target = parse_type(source, tokens, index + 3, []);
    expect_kind(
        source, token_at(source, tokens, target.next),
        TokenKind::LeftBrace, "`{` after the Drop target"
    );
    let method = token_at(source, tokens, target.next + 1);
    expect_identifier(source, method, "drop");
    expect_kind(
        source, token_at(source, tokens, target.next + 2),
        TokenKind::LeftParen, "`(` after `drop`"
    );
    expect_kind(
        source, token_at(source, tokens, target.next + 3),
        TokenKind::Ampersand, "`&mut self` Drop receiver"
    );
    expect_identifier(
        source, token_at(source, tokens, target.next + 4), "mut"
    );
    let self_token = token_at(source, tokens, target.next + 5);
    expect_identifier(source, self_token, "self");
    expect_kind(
        source, token_at(source, tokens, target.next + 6),
        TokenKind::RightParen, "`)` after the Drop receiver"
    );
    expect_kind(
        source, token_at(source, tokens, target.next + 7),
        TokenKind::Arrow, "`->` in the Drop hook"
    );
    let effects = parse_effect_row(
        source, tokens, target.next + 8, []
    );
    let body = parse_block(source, tokens, effects.next, []);
    let closing = token_at(source, tokens, body.next);
    expect_kind(
        source, closing, TokenKind::RightBrace,
        "`}` after the Drop implementation"
    );
    ParsedDropDecl {
        declaration: DropDecl {
            target: target.reference,
            target_span: target.reference.span,
            self_span: self_token.span,
            effects: effects.effects,
            body: body.expression,
            span: join_span(keyword.span, closing.span),
        },
        next: body.next + 1,
    }
}

parse_global_declaration(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    globals: List<GlobalDecl>,
) -> ParsedGlobal / {
    ResultCase, TokenCase, ExpressionCase, GlobalLookupCase, BlockStatementCase,
    Diagnostics
} {
    let keyword = token_at(source, tokens, index);
    let name_token = token_at(source, tokens, index + 1);
    let name = read_identifier(source, name_token);
    expect_kind(
        source, token_at(source, tokens, index + 2),
        TokenKind::Equal, "`=` in the global binding"
    );
    let value = parse_expression(source, tokens, index + 3, []);
    let semicolon = token_at(source, tokens, value.next);
    expect_kind(source, semicolon, TokenKind::Semicolon, "`;` after the global binding");
    ParsedGlobal {
        declaration: GlobalDecl {
            name: name,
            name_span: name_token.span,
            type_parameters: [],
            value_type: TypeRef { kind: SourceType::Unit, span: name_token.span },
            value: rewrite_global_references(value.expression, globals, []),
            span: join_span(keyword.span, semicolon.span),
        },
        next: value.next + 1,
    }
}

parse_module_rest(
    source: SourceFile,
    tokens: List<Token>,
    index: i64,
    type_aliases: List<TypeAliasDecl>,
    globals: List<GlobalDecl>,
    use_declarations: List<UseDecl>,
    drop_declarations: List<DropDecl>,
    structs: List<StructDecl>,
    enums: List<EnumDecl>,
    effects: List<EffectDecl>,
    callables: List<CallableDecl>,
) -> Module / {
    ResultCase, TokenCase, ExpressionCase, GlobalLookupCase, BlockStatementCase,
    Diagnostics
} {
    let found = token_at(source, tokens, index);
    handle perform TokenCase::token(found.kind) {
        TokenCase::token(TokenKind::End) => Module {
            type_aliases: type_aliases,
            globals: globals,
            use_declarations: use_declarations,
            drop_declarations: drop_declarations,
            structs: structs,
            enums: enums,
            effects: effects,
            callables: compiler_intrinsics(callables, type_aliases, found.span),
            end_span: found.span,
        },
        TokenCase::token(TokenKind::Identifier("type")) => {
            let parsed = parse_type_alias(source, tokens, index);
            parse_module_rest(
                source,
                tokens,
                parsed.next,
                core::list_push(type_aliases, parsed.declaration),
                globals,
                use_declarations,
                drop_declarations,
                structs,
                enums,
                effects,
                callables
            )
        },
        TokenCase::token(TokenKind::Identifier("let")) => {
            let parsed = parse_global_declaration(source, tokens, index, globals);
            parse_module_rest(
                source, tokens, parsed.next, type_aliases,
                core::list_push(globals, parsed.declaration),
                use_declarations, drop_declarations, structs, enums, effects,
                callables
            )
        },
        TokenCase::token(TokenKind::Identifier("impl")) => {
            let trait_token = token_at(source, tokens, index + 1);
            handle perform TokenCase::token(trait_token.kind) {
                TokenCase::token(TokenKind::Identifier("Use")) => {
                    let parsed = parse_use_declaration(source, tokens, index);
                    parse_module_rest(
                        source, tokens, parsed.next, type_aliases,
                        globals,
                        core::list_push(use_declarations, parsed.declaration),
                        drop_declarations, structs, enums, effects, callables
                    )
                },
                TokenCase::token(TokenKind::Identifier("Drop")) => {
                    let parsed = parse_drop_declaration(source, tokens, index);
                    parse_module_rest(
                        source, tokens, parsed.next, type_aliases,
                        globals,
                        use_declarations,
                        core::list_push(drop_declarations, parsed.declaration),
                        structs, enums, effects, callables
                    )
                },
                TokenCase::token(_) => compiler_error(
                    source, "GRC1865", "unsupported intrinsic implementation",
                    trait_token.span,
                    "only the intrinsic `Use` and `Drop` identities are implementable here",
                    [],
                    "these implementations participate in compiler ownership semantics",
                    "implement `Use<[lower, upper]>` or `Drop`"
                )
            }
        },
        TokenCase::token(TokenKind::Identifier("struct")) => {
            let parsed = parse_struct(source, tokens, index);
            parse_module_rest(
                source,
                tokens,
                parsed.next,
                type_aliases,
                globals,
                use_declarations,
                drop_declarations,
                core::list_push(structs, parsed.declaration),
                enums,
                effects,
                callables
            )
        },
        TokenCase::token(TokenKind::Identifier("enum")) => {
            let parsed = parse_enum(source, tokens, index);
            parse_module_rest(
                source,
                tokens,
                parsed.next,
                type_aliases,
                globals,
                use_declarations,
                drop_declarations,
                structs,
                core::list_push(enums, parsed.declaration),
                effects,
                callables
            )
        },
        TokenCase::token(TokenKind::Identifier("effect")) => {
            let parsed = parse_effect(source, tokens, index);
            parse_module_rest(
                source,
                tokens,
                parsed.next,
                type_aliases,
                globals,
                use_declarations,
                drop_declarations,
                structs,
                enums,
                core::list_push(effects, parsed.declaration),
                callables
            )
        },
        TokenCase::token(TokenKind::Identifier("infixr")) => parse_module_rest(
            source, tokens,
            if(token_at(source, tokens, index + 3).kind ==
                TokenKind::Identifier("lazy")) { index + 5 } else { index + 4 },
            type_aliases, globals, use_declarations,
            drop_declarations,
            structs, enums, effects, callables
        ),
        TokenCase::token(TokenKind::Identifier("infixl")) => parse_module_rest(
            source, tokens,
            if(token_at(source, tokens, index + 3).kind ==
                TokenKind::Identifier("lazy")) { index + 5 } else { index + 4 },
            type_aliases, globals, use_declarations,
            drop_declarations,
            structs, enums, effects, callables
        ),
        TokenCase::token(TokenKind::Identifier("prefix")) => parse_module_rest(
            source, tokens, index + 4, type_aliases, globals, use_declarations,
            drop_declarations, structs, enums, effects, callables
        ),
        TokenCase::token(TokenKind::Identifier(_)) => {
            let parsed = parse_callable(source, tokens, index, globals);
            parse_module_rest(
                source, tokens, parsed.next, type_aliases, globals, use_declarations,
                drop_declarations,
                structs, enums, effects,
                core::list_push(callables, parsed.callable)
            )
        },
        TokenCase::token(TokenKind::WordOperator(_, _, _, _)) => {
            let parsed = parse_callable(source, tokens, index, globals);
            parse_module_rest(
                source, tokens, parsed.next, type_aliases, globals, use_declarations,
                drop_declarations,
                structs, enums, effects,
                core::list_push(callables, parsed.callable)
            )
        },
        TokenCase::token(_) => compiler_error(
            source, "GRC0204", "expected a callable declaration", found.span,
            "only callable declarations are accepted at module scope", [],
            "a callable begins with its name and has no `fn` keyword",
            "write a declaration such as `answer() -> i64 { 42 }`"
        )
    }
}

compiler_intrinsics(
    callables: List<CallableDecl>,
    type_aliases: List<TypeAliasDecl>,
    span: SourceSpan,
) -> List<CallableDecl> / {ResultCase} {
    let e = TypeRef { kind: SourceType::Generic("E"), span: span };
    let s = TypeRef { kind: SourceType::Generic("S"), span: span };
    let f = TypeRef { kind: SourceType::Generic("F"), span: span };
    let r = TypeRef { kind: SourceType::Generic("R"), span: span };
    let available_e = TypeRef {
        kind: SourceType::Available(e),
        span: span,
    };
    let environment_constraints = [
        EnvironmentConstraint {
            parameter_name: "E", parameter_span: span, span: span,
        },
        EnvironmentConstraint {
            parameter_name: "S", parameter_span: span, span: span,
        }
    ];
    let runs_in_constraints = [RunsInConstraint {
        callable_parameter_name: "F",
        callable_parameter_span: span,
        environment_parameter_name: "E",
        environment_parameter_span: span,
        after_parameter_name: "S",
        after_parameter_span: span,
        span: span,
    }];
    let callable_constraints = [CallableConstraint {
        parameter_name: "F",
        parameter_span: span,
        output: r,
        span: span,
    }];
    let type_parameters = [
        TypeParameter { name: "E", span: span },
        TypeParameter { name: "S", span: span },
        TypeParameter { name: "F", span: span },
        TypeParameter { name: "R", span: span }
    ];
    let with_unit = core::list_push(
        callables,
                CallableDecl {
                    name: "available_to_unit",
                    name_span: span,
                    type_parameters: [TypeParameter {
                        name: "E",
                        span: span,
                    }],
                    callable_constraints: [],
                    use_constraints: [UseConstraint {
                        parameter_name: "E",
                        parameter_span: span,
                        lower: 0,
                        upper: 0,
                        span: span,
                    }],
                    environment_constraints: [],
                    runs_in_constraints: [],
                    parameters: [Parameter {
                        name: "available",
                        span: span,
                        parameter_type: TypeRef {
                            kind: SourceType::Available(TypeRef {
                                kind: SourceType::Generic("E"),
                                span: span,
                            }),
                            span: span,
                        },
                        is_local: false,
                        drop_flag: "",
                        llvm_name: "%available",
                    }],
                    result_type: TypeRef {
                        kind: SourceType::Unit,
                        span: span,
                    },
                    effects: [],
                    body: Expression::ConsumeAvailable(
                        Expression::Variable("available", span), span
                    ),
                    span: span,
                }
    );
    let with_defer = core::list_push(with_unit, CallableDecl {
        name: "defer_available",
        name_span: span,
        type_parameters: type_parameters,
        callable_constraints: callable_constraints,
        use_constraints: [],
        environment_constraints: environment_constraints,
        runs_in_constraints: runs_in_constraints,
        parameters: [Parameter {
            name: "body", span: span, parameter_type: f,
            is_local: false, drop_flag: "", llvm_name: "%body",
        }],
        result_type: available_e,
        effects: [],
        body: Expression::AvailableValue(e, span),
        span: span,
    });
    let with_continue = core::list_push(with_defer, CallableDecl {
        name: "continue_available",
        name_span: span,
        type_parameters: type_parameters,
        callable_constraints: callable_constraints,
        use_constraints: [],
        environment_constraints: environment_constraints,
        runs_in_constraints: runs_in_constraints,
        parameters: [
            Parameter {
                name: "available", span: span, parameter_type: available_e,
                is_local: false, drop_flag: "", llvm_name: "%available",
            },
            Parameter {
                name: "body", span: span, parameter_type: f,
                is_local: false, drop_flag: "", llvm_name: "%body",
            }
        ],
        result_type: r,
        effects: [],
        body: Expression::Block([
            BlockStatement::Let(
                "consumed", span,
                TypeRef { kind: SourceType::Unit, span: span },
                Expression::ConsumeAvailable(
                    Expression::Variable("available", span), span
                ),
                span
            ),
            BlockStatement::Value(Expression::Call("body", [], span))
        ], span),
        span: span,
    });
    core_intrinsics(core::list_push(with_continue, CallableDecl {
        name: "destroy",
        name_span: span,
        type_parameters: [TypeParameter { name: "T", span: span }],
        callable_constraints: [],
        use_constraints: [],
        environment_constraints: [],
        runs_in_constraints: [],
        parameters: [Parameter {
            name: "value",
            span: span,
            parameter_type: TypeRef {
                kind: SourceType::Generic("T"), span: span,
            },
            is_local: false,
            drop_flag: "",
            llvm_name: "%value",
        }],
        result_type: TypeRef { kind: SourceType::Unit, span: span },
        effects: [],
        body: Expression::Destroy(
            Expression::Variable("value", span), span
        ),
        span: span,
    }), type_aliases, span)
}

compiler_core_intrinsic(name: String) -> Bool {
    core::str_find(name, "core::") == 0
}

core_intrinsic_callable(
    name: String, span: SourceSpan, type_parameters: List<TypeParameter>,
    parameters: List<Parameter>, result_type: TypeRef,
) -> CallableDecl {
    CallableDecl {
        name: name,
        name_span: span,
        type_parameters: type_parameters,
        callable_constraints: [],
        use_constraints: [],
        environment_constraints: [],
        runs_in_constraints: [],
        parameters: parameters,
        result_type: result_type,
        effects: [],
        body: Expression::Unit(span),
        span: span,
    }
}

core_intrinsics(
    callables: List<CallableDecl>, type_aliases: List<TypeAliasDecl>, span: SourceSpan,
) -> List<CallableDecl> / {ResultCase} {
    let t = TypeRef { kind: SourceType::Generic("T"), span: span };
    let list_t = TypeRef { kind: SourceType::List(t), span: span };
    let type_parameters = [TypeParameter { name: "T", span: span }];
    let list_parameter = Parameter {
        name: "list", span: span, parameter_type: list_t,
        is_local: false, drop_flag: "", llvm_name: "%arg_list",
    };
    let item_parameter = Parameter {
        name: "item", span: span, parameter_type: t,
        is_local: false, drop_flag: "", llvm_name: "%arg_item",
    };
    let index_parameter = Parameter {
        name: "index", span: span,
        parameter_type: TypeRef { kind: SourceType::I64, span: span },
        is_local: false, drop_flag: "", llvm_name: "%arg_index",
    };
    let with_len = core::list_push(callables, core_intrinsic_callable(
        "core::list_len", span, type_parameters, [list_parameter],
        TypeRef { kind: SourceType::I64, span: span }
    ));
    let with_get = core::list_push(with_len, core_intrinsic_callable(
        "core::list_get", span, type_parameters,
        [list_parameter, index_parameter], t
    ));
    let with_push = core::list_push(with_get, core_intrinsic_callable(
        "core::list_push", span, type_parameters,
        [list_parameter, item_parameter], list_t
    ));
    let string_type = TypeRef { kind: SourceType::String, span: span };
    let integer_type = TypeRef { kind: SourceType::I64, span: span };
    let bool_type = TypeRef { kind: SourceType::Named("Bool"), span: span };
    let text = Parameter {
        name: "text", span: span, parameter_type: string_type,
        is_local: false, drop_flag: "", llvm_name: "%arg_text",
    };
    let second_text = Parameter {
        name: "needle", span: span, parameter_type: string_type,
        is_local: false, drop_flag: "", llvm_name: "%arg_needle",
    };
    let integer = Parameter {
        name: "value", span: span, parameter_type: integer_type,
        is_local: false, drop_flag: "", llvm_name: "%arg_value",
    };
    let second_integer = Parameter {
        name: "end", span: span, parameter_type: integer_type,
        is_local: false, drop_flag: "", llvm_name: "%arg_end",
    };
    let with_byte_len = core::list_push(with_push, core_intrinsic_callable(
        "core::str_byte_len", span, [], [text], integer_type
    ));
    let with_char_at = core::list_push(with_byte_len, core_intrinsic_callable(
        "core::str_char_at", span, [], [text, integer], string_type
    ));
    let with_byte_at = core::list_push(with_char_at, core_intrinsic_callable(
        "core::str_byte_at", span, [], [text, integer], integer_type
    ));
    let with_next = core::list_push(with_byte_at, core_intrinsic_callable(
        "core::str_next_index", span, [], [text, integer], integer_type
    ));
    let with_slice = core::list_push(with_next, core_intrinsic_callable(
        "core::str_slice", span, [], [text, integer, second_integer], string_type
    ));
    let with_find = core::list_push(with_slice, core_intrinsic_callable(
        "core::str_find", span, [], [text, second_text], integer_type
    ));
    let with_int_string = core::list_push(with_find, core_intrinsic_callable(
        "core::int_to_string", span, [], [integer], string_type
    ));
    let with_parse = core::list_push(with_int_string, core_intrinsic_callable(
        "core::parse_i64", span, [], [text], integer_type
    ));
    if(type_alias_declared(type_aliases, 0, "Bool")) {
        let with_is_i64 = core::list_push(with_parse, core_intrinsic_callable(
            "core::is_i64", span, [], [text], bool_type
        ));
        let with_digit = core::list_push(with_is_i64, core_intrinsic_callable(
            "core::is_ascii_digit", span, [], [text], bool_type
        ));
        let with_start = core::list_push(with_digit, core_intrinsic_callable(
            "core::is_ascii_ident_start", span, [], [text], bool_type
        ));
        let with_continue = core::list_push(with_start, core_intrinsic_callable(
            "core::is_ascii_ident_continue", span, [], [text], bool_type
        ));
        core::list_push(with_continue, core_intrinsic_callable(
            "core::is_ascii_whitespace", span, [], [text], bool_type
        ))
    } else {
        with_parse
    }
}

type_alias_declared(
    aliases: List<TypeAliasDecl>, index: i64, name: String,
) -> Bool / {ResultCase} {
    if(index >= core::list_len(aliases)) {
        false
    } else {
        if(core::list_get(aliases, index).name == name) {
            true
        } else {
            type_alias_declared(aliases, index + 1, name)
        }
    }
}

generic_type_arguments(
    parameters: List<TypeParameter>, index: i64, output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        generic_type_arguments(
            parameters, index + 1,
            core::list_push(output, TypeRef {
                kind: SourceType::Generic(parameter.name),
                span: parameter.span,
            })
        )
    }
}

type_contains_generic(
    reference: TypeRef, name: String,
) -> Bool / {ResultCase, TypeCase} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Inferred) => false,
        TypeCase::inspect(SourceType::Generic(found)) => found == name,
        TypeCase::inspect(SourceType::List(element)) =>
            type_contains_generic(element, name),
        TypeCase::inspect(SourceType::Applied(_, arguments)) =>
            type_list_contains_generic(arguments, name, 0),
        TypeCase::inspect(SourceType::Struct(_, arguments)) =>
            type_list_contains_generic(arguments, name, 0),
        TypeCase::inspect(SourceType::Enum(_, arguments)) =>
            type_list_contains_generic(arguments, name, 0),
        TypeCase::inspect(SourceType::Callable(output, _)) =>
            type_contains_generic(output, name),
        TypeCase::inspect(SourceType::Resumption(input, output)) =>
            type_contains_generic(input, name) or
                type_contains_generic(output, name),
        TypeCase::inspect(SourceType::Available(environment)) =>
            type_contains_generic(environment, name),
        TypeCase::inspect(SourceType::SharedReference(target)) =>
            type_contains_generic(target, name),
        TypeCase::inspect(SourceType::UniqueReference(target)) =>
            type_contains_generic(target, name),
        TypeCase::inspect(_) => false
    }
}

type_list_contains_generic(
    references: List<TypeRef>, name: String, index: i64,
) -> Bool / {ResultCase, TypeCase} {
    if(index >= core::list_len(references)) {
        false
    } else {
        type_contains_generic(core::list_get(references, index), name) or
            type_list_contains_generic(references, name, index + 1)
    }
}

generalized_type_parameters(
    candidates: List<TypeParameter>, value_type: TypeRef,
    index: i64, output: List<TypeParameter>,
) -> List<TypeParameter> / {ResultCase, TypeCase} {
    if(index >= core::list_len(candidates)) {
        output
    } else {
        let candidate = core::list_get(candidates, index);
        generalized_type_parameters(
            candidates, value_type, index + 1,
            if(type_contains_generic(value_type, candidate.name)) {
                core::list_push(output, candidate)
            } else { output }
        )
    }
}

infer_global_enum_arguments(
    source: SourceFile,
    module: Module,
    fields: List<TypeRef>,
    arguments: List<Expression>,
    index: i64,
    bindings: List<TypeBinding>,
) -> List<TypeBinding> / {
    ResultCase, ExpressionCase, LookupCase, GlobalLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    TypeBindingLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        bindings
    } else {
        let expected = substitute_bindings(
            core::list_get(fields, index), bindings
        );
        let argument = core::list_get(arguments, index);
        let actual = infer_global_value_type(source, module, argument);
        infer_global_enum_arguments(
            source, module, fields, arguments, index + 1,
            unify_types(
                source, expected, actual, bindings, expression_span(argument)
            )
        )
    }
}

infer_global_value_type(
    source: SourceFile,
    module: Module,
    expression: Expression,
) -> TypeRef / {
    ResultCase, ExpressionCase, LookupCase, GlobalLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    TypeBindingLookupCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Unit(span)) =>
            TypeRef { kind: SourceType::Unit, span: span },
        ExpressionCase::expression(Expression::String(_, span)) =>
            TypeRef { kind: SourceType::String, span: span },
        ExpressionCase::expression(Expression::List(items, span)) => {
            require(
                core::list_len(items) > 0,
                error_diagnostic(
                    source, "GRC1871", "empty global list needs a type",
                    span, "an empty list does not determine its element type", [],
                    "polymorphic globals generalize constructor values with a principal type",
                    "introduce a typed callable returning `List<T>`"
                )
            );
            TypeRef {
                kind: SourceType::List(infer_global_value_type(
                    source, module, core::list_get(items, 0)
                )),
                span: span,
            }
        },
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            require(
                core::list_len(arguments) == 0,
                error_diagnostic(
                    source, "GRC1870", "global initializer needs an explicit type",
                    span,
                    "a parameterized call does not determine a principal global type",
                    [],
                    "immutable globals use value-restricted let generalization",
                    "bind a constructor value or introduce a typed callable"
                )
            );
            resolve_callable(source, module, name, span).result_type
        },
        ExpressionCase::expression(Expression::EnumValue(
            enum_name, variant_name, arguments, span
        )) => {
            handle perform EnumLookupCase::lookup(
                lookup_enum(module.enums, enum_name, 0)
            ) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                    handle perform VariantLookupCase::lookup(
                        lookup_variant(declaration.variants, variant_name, 0)
                    ) {
                        VariantLookupCase::lookup(VariantLookup::Found(variant)) => {
                            require(
                                core::list_len(arguments) ==
                                    core::list_len(variant.fields),
                                error_diagnostic(
                                    source, "GRC1503", "wrong enum payload arity",
                                    span,
                                    "variant `" + enum_name + "::" + variant_name +
                                        "` receives a different number of payload values",
                                    [DiagnosticLabel {
                                        span: variant.name_span,
                                        message: "the variant is declared here",
                                    }],
                                    "global inference uses the declared constructor fields",
                                    "supply exactly one value for each variant field"
                                )
                            );
                            let type_arguments = generic_type_arguments(
                                declaration.type_parameters, 0, []
                            );
                            let fields = substitute_types(
                                variant.fields, declaration.type_parameters,
                                type_arguments, 0, []
                            );
                            let bindings = infer_global_enum_arguments(
                                source, module, fields, arguments, 0, []
                            );
                            substitute_bindings(TypeRef {
                                kind: SourceType::Applied(enum_name, type_arguments),
                                span: span,
                            }, bindings)
                        },
                        VariantLookupCase::lookup(VariantLookup::Missing) =>
                            compiler_error(
                                source, "GRC1502", "unknown enum variant", span,
                                "enum `" + enum_name + "` has no variant named `" +
                                    variant_name + "`", [],
                                "constructors are resolved from nominal enum declarations",
                                "use a variant declared by `" + enum_name + "`"
                            )
                    }
                },
                EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                    source, "GRC1501", "unknown enum", span,
                    "`" + enum_name + "` is not a declared enum", [],
                    "global constructor inference is nominal",
                    "declare the enum before this global binding"
                )
            }
        },
        ExpressionCase::expression(_) => compiler_error(
            source, "GRC1870", "global initializer needs an explicit type",
            expression_span(expression),
            "this expression has no principal type under value-restricted inference",
            [],
            "polymorphic immutable globals generalize constructor values without evaluating effects",
            "move the computation into a typed callable"
        )
    }
}

module_with_global_state(
    module: Module,
    globals: List<GlobalDecl>,
    callables: List<CallableDecl>,
) -> Module {
    Module {
        type_aliases: module.type_aliases,
        globals: globals,
        use_declarations: module.use_declarations,
        drop_declarations: module.drop_declarations,
        structs: module.structs,
        enums: module.enums,
        effects: module.effects,
        callables: callables,
        end_span: module.end_span,
    }
}

elaborate_module_globals(
    source: SourceFile,
    parsed: Module,
    index: i64,
    globals: List<GlobalDecl>,
    callables: List<CallableDecl>,
) -> Module / {
    ResultCase, ExpressionCase, LookupCase, GlobalLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    TypeBindingLookupCase, Diagnostics
} {
    if(index >= core::list_len(parsed.globals)) {
        module_with_global_state(parsed, globals, callables)
    } else {
        let declaration = core::list_get(parsed.globals, index);
        let working = module_with_global_state(parsed, globals, callables);
        let value_type = infer_global_value_type(
            source, working, declaration.value
        );
        let candidate_parameters = handle perform TypeCase::inspect(value_type.kind) {
            TypeCase::inspect(SourceType::Applied(name, _)) => {
                handle perform EnumLookupCase::lookup(
                    lookup_enum(parsed.enums, name, 0)
                ) {
                    EnumLookupCase::lookup(EnumLookup::Found(found)) =>
                        found.type_parameters,
                    EnumLookupCase::lookup(EnumLookup::Missing) => []
                }
            },
            TypeCase::inspect(_) => []
        };
        let type_parameters = generalized_type_parameters(
            candidate_parameters, value_type, 0, []
        );
        let resolved = GlobalDecl {
            name: declaration.name,
            name_span: declaration.name_span,
            type_parameters: type_parameters,
            value_type: value_type,
            value: declaration.value,
            span: declaration.span,
        };
        let callable = CallableDecl {
            name: global_callable_name(declaration.name),
            name_span: declaration.name_span,
            type_parameters: type_parameters,
            callable_constraints: [],
            use_constraints: [],
            environment_constraints: [],
            runs_in_constraints: [],
            parameters: [],
            result_type: value_type,
            effects: [],
            body: declaration.value,
            span: declaration.span,
        };
        elaborate_module_globals(
            source, parsed, index + 1,
            core::list_push(globals, resolved),
            core::list_push(callables, callable)
        )
    }
}

infer_unannotated_handler_clause_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    operation_parameters: List<TypeRef>,
    clauses: List<HandlerClause>,
    index: i64,
    inferred: TypeRef,
    bindings: List<TypeBinding>,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        substitute_bindings(inferred, bindings)
    } else {
        let clause = core::list_get(clauses, index);
        let branch_parameters = validate_pattern_list(
            source, module, clause.patterns, operation_parameters, 0, parameters
        );
        let expected = substitute_bindings(inferred, bindings);
        let candidate = infer_unannotated_local_type_with_context(
            source, module, branch_parameters, clause.body, expected
        );
        let next_bindings = unify_types(
            source,
            expected,
            candidate,
            bindings,
            clause.span
        );
        infer_unannotated_handler_clause_type(
            source, module, parameters, operation_parameters, clauses,
            index + 1, inferred, next_bindings
        )
    }
}

infer_unannotated_local_type_with_context(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    expected: TypeRef,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, _)) => {
            if(core::list_len(items) == 0) {
                expected
            } else {
                infer_unannotated_local_type(
                    source, module, parameters, expression
                )
            }
        },
        ExpressionCase::expression(_) => infer_unannotated_local_type(
            source, module, parameters, expression
        )
    }
}

infer_unannotated_local_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Integer(_, span)) =>
            TypeRef { kind: SourceType::I64, span: span },
        ExpressionCase::expression(Expression::Negate(_, span)) =>
            TypeRef { kind: SourceType::I64, span: span },
        ExpressionCase::expression(Expression::Binary(
            operator, left, right, span
        )) => {
            if(operator_is_comparison(operator)) {
                resolve_type(
                    source, module,
                    TypeRef { kind: SourceType::Named("Bool"), span: span }
                )
            } else {
                handle perform TypeInferenceCase::inspect(
                    first_inferred_type(
                        try_infer_standalone_type(
                            source, module, parameters, left
                        ),
                        try_infer_standalone_type(
                            source, module, parameters, right
                        )
                    )
                ) {
                    TypeInferenceCase::inspect(
                        TypeInference::Found(reference)
                    ) => resolve_type(source, module, reference),
                    TypeInferenceCase::inspect(TypeInference::Missing) =>
                        TypeRef { kind: SourceType::I64, span: span }
                }
            }
        },
        ExpressionCase::expression(Expression::StructValue(
            name, fields, span
        )) => {
            handle perform StructLookupCase::lookup(
                lookup_struct(module.structs, name, 0)
            ) {
                StructLookupCase::lookup(StructLookup::Found(declaration)) => {
                    let arguments = generic_type_arguments(
                        declaration.type_parameters, 0, []
                    );
                    resolve_type(
                        source,
                        module,
                        substitute_bindings(
                            TypeRef {
                                kind: SourceType::Applied(name, arguments),
                                span: span,
                            },
                            infer_struct_constructor_bindings(
                                source, module, parameters, declaration,
                                arguments, fields, 0, []
                            )
                        )
                    )
                },
                StructLookupCase::lookup(StructLookup::Missing) =>
                    compiler_error(
                        source, "GRC1504", "unknown struct", span,
                        "`" + name + "` is not a declared struct", [],
                        "local constructor inference uses nominal declarations",
                        "declare the struct or correct its name"
                    )
            }
        },
        ExpressionCase::expression(Expression::EnumValue(
            name, variant_name, arguments, span
        )) => {
            handle perform EnumLookupCase::lookup(
                lookup_enum(module.enums, name, 0)
            ) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                    handle perform VariantLookupCase::lookup(
                        lookup_variant(declaration.variants, variant_name, 0)
                    ) {
                        VariantLookupCase::lookup(VariantLookup::Found(variant)) => {
                            let type_arguments = generic_type_arguments(
                                declaration.type_parameters, 0, []
                            );
                            resolve_type(
                                source,
                                module,
                                substitute_bindings(
                                    TypeRef {
                                        kind: SourceType::Applied(
                                            name, type_arguments
                                        ),
                                        span: span,
                                    },
                                    infer_enum_constructor_bindings(
                                        source, module, parameters, declaration,
                                        type_arguments, variant, arguments, 0, []
                                    )
                                )
                            )
                        },
                        VariantLookupCase::lookup(VariantLookup::Missing) =>
                            compiler_error(
                                source, "GRC1502", "unknown enum variant", span,
                                "enum `" + name + "` has no variant named `" +
                                    variant_name + "`", [],
                                "local constructor inference uses nominal declarations",
                                "use a variant declared by `" + name + "`"
                            )
                    }
                },
                EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                    source, "GRC1501", "unknown enum", span,
                    "`" + name + "` is not a declared enum", [],
                    "local constructor inference uses nominal declarations",
                    "declare the enum or correct its name"
                )
            }
        },
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, span
        )) => {
            handle perform ExpressionCase::expression(computation) {
                ExpressionCase::expression(Expression::Perform(
                    effect_name, operation_name, arguments, perform_span
                )) => {
                    let resolved = resolve_perform_operation(
                        source, module, parameters, effect_name,
                        operation_name, arguments, perform_span
                    );
                    let clause = core::list_get(clauses, 0);
                    let branch_parameters = validate_pattern_list(
                        source, module, clause.patterns,
                        operation_parameter_types(resolved.parameters, 0, []),
                        0, parameters
                    );
                    infer_unannotated_handler_clause_type(
                        source,
                        module,
                        parameters,
                        operation_parameter_types(resolved.parameters, 0, []),
                        clauses,
                        1,
                        infer_unannotated_local_type(
                            source, module, branch_parameters, clause.body
                        ),
                        []
                    )
                },
                ExpressionCase::expression(_) => compiler_error(
                    source, "GRC1412", "handled expression type needs context",
                    span,
                    "local inference currently requires a direct performed operation",
                    [],
                    "terminal handler branches share the inferred local type",
                    "add a local type annotation"
                )
            }
        },
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            infer_unannotated_block_type(
                source, module, parameters, statements, 0
            ),
        ExpressionCase::expression(_) =>
            infer_expression_type(source, module, parameters, expression)
    }
}

infer_unannotated_block_type(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
) -> TypeRef / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name, name_span, local_type, _, _
        )) => infer_unannotated_block_type(
            source,
            module,
            core::list_push(parameters, Parameter {
                name: name,
                span: name_span,
                parameter_type: local_type,
                is_local: true,
                drop_flag: "",
                llvm_name: "%local_" + name,
            }),
            statements,
            index + 1
        ),
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            if(index + 1 >= core::list_len(statements)) {
                infer_unannotated_local_type(
                    source, module, parameters, value
                )
            } else {
                infer_unannotated_block_type(
                    source, module, parameters, statements, index + 1
                )
            }
        }
    }
}

elaborate_local_expression_list(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    expressions: List<Expression>, index: i64, output: List<Expression>,
) -> List<Expression> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        output
    } else {
        elaborate_local_expression_list(
            source, module, parameters, expressions, index + 1,
            core::list_push(output, elaborate_local_types_expression(
                source, module, parameters,
                core::list_get(expressions, index)
            ))
        )
    }
}

elaborate_local_named_expressions(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    expressions: List<NamedExpression>, index: i64,
    output: List<NamedExpression>,
) -> List<NamedExpression> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        output
    } else {
        let found = core::list_get(expressions, index);
        elaborate_local_named_expressions(
            source, module, parameters, expressions, index + 1,
            core::list_push(output, NamedExpression {
                name: found.name,
                name_span: found.name_span,
                value: elaborate_local_types_expression(
                    source, module, parameters, found.value
                ),
            })
        )
    }
}

elaborate_local_block(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    statements: List<BlockStatement>, index: i64,
    output: List<BlockStatement>,
) -> List<BlockStatement> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(statements)) {
        output
    } else {
        handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, name_span, declared, value, span
            )) => {
                let elaborated_value = elaborate_local_types_expression(
                    source, module, parameters, value
                );
                let local_type = handle perform TypeCase::inspect(declared.kind) {
                    TypeCase::inspect(SourceType::Inferred) =>
                        infer_unannotated_local_type(
                            source, module, parameters, elaborated_value
                        ),
                    TypeCase::inspect(_) => declared
                };
                elaborate_local_block(
                    source, module,
                    core::list_push(parameters, Parameter {
                        name: name,
                        span: name_span,
                        parameter_type: local_type,
                        is_local: true,
                        drop_flag: "",
                        llvm_name: "%local_" + name,
                    }),
                    statements, index + 1,
                    core::list_push(output, BlockStatement::Let(
                        name, name_span, local_type, elaborated_value, span
                    ))
                )
            },
            BlockStatementCase::inspect(BlockStatement::Value(value)) =>
                elaborate_local_block(
                    source, module, parameters, statements, index + 1,
                    core::list_push(output, BlockStatement::Value(
                        elaborate_local_types_expression(
                            source, module, parameters, value
                        )
                    ))
                )
        }
    }
}

elaborate_local_handler_clauses(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    operation_parameters: List<TypeRef>,
    clauses: List<HandlerClause>, index: i64, output: List<HandlerClause>,
) -> List<HandlerClause> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        output
    } else {
        let clause = core::list_get(clauses, index);
        let branch_parameters = if(core::list_len(operation_parameters) ==
            core::list_len(clause.patterns)) {
            validate_pattern_list(
                source, module, clause.patterns, operation_parameters,
                0, parameters
            )
        } else { parameters };
        elaborate_local_handler_clauses(
            source, module, parameters, operation_parameters,
            clauses, index + 1,
            core::list_push(output, HandlerClause {
                effect_name: clause.effect_name,
                operation_name: clause.operation_name,
                patterns: clause.patterns,
                resumption_name: clause.resumption_name,
                resumption_span: clause.resumption_span,
                has_resumption: clause.has_resumption,
                body: elaborate_local_types_expression(
                    source, module, branch_parameters, clause.body
                ),
                span: clause.span,
            })
        )
    }
}

elaborate_local_types_expression(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
) -> Expression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, span)) =>
            Expression::List(
                elaborate_local_expression_list(
                    source, module, parameters, items, 0, []
                ), span
            ),
        ExpressionCase::expression(Expression::Borrow(value, unique, span)) =>
            Expression::Borrow(
                elaborate_local_types_expression(source, module, parameters, value),
                unique, span
            ),
        ExpressionCase::expression(Expression::Dereference(value, span)) =>
            Expression::Dereference(
                elaborate_local_types_expression(source, module, parameters, value),
                span
            ),
        ExpressionCase::expression(Expression::Destroy(value, span)) =>
            Expression::Destroy(
                elaborate_local_types_expression(source, module, parameters, value),
                span
            ),
        ExpressionCase::expression(Expression::ConsumeAvailable(value, span)) =>
            Expression::ConsumeAvailable(
                elaborate_local_types_expression(source, module, parameters, value),
                span
            ),
        ExpressionCase::expression(Expression::Negate(value, span)) =>
            Expression::Negate(
                elaborate_local_types_expression(source, module, parameters, value),
                span
            ),
        ExpressionCase::expression(Expression::Binary(operator, left, right, span)) =>
            Expression::Binary(
                operator,
                elaborate_local_types_expression(source, module, parameters, left),
                elaborate_local_types_expression(source, module, parameters, right),
                span
            ),
        ExpressionCase::expression(Expression::Call(name, arguments, span)) =>
            Expression::Call(
                name,
                elaborate_local_expression_list(
                    source, module, parameters, arguments, 0, []
                ), span
            ),
        ExpressionCase::expression(Expression::StructValue(name, fields, span)) =>
            Expression::StructValue(
                name,
                elaborate_local_named_expressions(
                    source, module, parameters, fields, 0, []
                ), span
            ),
        ExpressionCase::expression(Expression::Field(subject, name, span)) =>
            Expression::Field(
                elaborate_local_types_expression(
                    source, module, parameters, subject
                ), name, span
            ),
        ExpressionCase::expression(Expression::EnumValue(
            enum_name, variant_name, arguments, span
        )) => Expression::EnumValue(
            enum_name, variant_name,
            elaborate_local_expression_list(
                source, module, parameters, arguments, 0, []
            ), span
        ),
        ExpressionCase::expression(Expression::Block(statements, span)) =>
            Expression::Block(
                elaborate_local_block(
                    source, module, parameters, statements, 0, []
                ), span
            ),
        ExpressionCase::expression(Expression::Perform(
            effect_name, operation_name, arguments, span
        )) => Expression::Perform(
            effect_name, operation_name,
            elaborate_local_expression_list(
                source, module, parameters, arguments, 0, []
            ), span
        ),
        ExpressionCase::expression(Expression::Handle(computation, clauses, span)) => {
            let operation_parameters = handle perform ExpressionCase::expression(
                computation
            ) {
                ExpressionCase::expression(Expression::Perform(
                    effect_name, operation_name, arguments, perform_span
                )) => operation_parameter_types(
                    resolve_perform_operation(
                        source, module, parameters, effect_name,
                        operation_name, arguments, perform_span
                    ).parameters,
                    0, []
                ),
                ExpressionCase::expression(_) => []
            };
            Expression::Handle(
                elaborate_local_types_expression(
                    source, module, parameters, computation
                ),
                elaborate_local_handler_clauses(
                    source, module, parameters, operation_parameters,
                    clauses, 0, []
                ), span
            )
        },
        ExpressionCase::expression(_) => expression
    }
}

elaborate_module_local_types_rest(
    source: SourceFile, module: Module, callables: List<CallableDecl>,
    index: i64, output: List<CallableDecl>,
) -> List<CallableDecl> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(callables)) {
        output
    } else {
        let callable = core::list_get(callables, index);
        elaborate_module_local_types_rest(
            source, module, callables, index + 1,
            core::list_push(output, CallableDecl {
                name: callable.name,
                name_span: callable.name_span,
                type_parameters: callable.type_parameters,
                callable_constraints: callable.callable_constraints,
                use_constraints: callable.use_constraints,
                environment_constraints: callable.environment_constraints,
                runs_in_constraints: callable.runs_in_constraints,
                parameters: callable.parameters,
                result_type: callable.result_type,
                effects: callable.effects,
                body: elaborate_local_types_expression(
                    source, module, callable.parameters, callable.body
                ),
                span: callable.span,
            })
        )
    }
}

elaborate_module_local_types(
    source: SourceFile,
    module: Module,
) -> Module / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    GlobalLookupCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    module_with_global_state(
        module,
        module.globals,
        elaborate_module_local_types_rest(
            source, module, module.callables, 0, []
        )
    )
}

parse_module(
    path: String,
    source_text: String,
) -> Module / {
    ResultCase, CharacterCase, TokenCase, ExpressionCase, OperatorCase,
    LookupCase, ParameterLookupCase, GlobalLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, TypeBindingLookupCase,
    BlockStatementCase, TypeInferenceCase, PatternCase, FixityLookupCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    let source = SourceFile { path: path, text: source_text };
    let raw_tokens = lex(source);
    parse_module_tokens(source, raw_tokens)
}

parse_module_tokens(
    source: SourceFile,
    raw_tokens: List<Token>,
) -> Module / {
    ResultCase, TokenCase, ExpressionCase, OperatorCase, LookupCase,
    ParameterLookupCase, GlobalLookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase, VariantLookupCase, StructFieldLookupCase,
    NamedExpressionLookupCase, TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, PatternCase, EffectLookupCase, EffectOperationLookupCase,
    FixityLookupCase, Diagnostics
} {
    let fixities = collect_fixities(source, raw_tokens, 0, []);
    let tokens = annotate_word_operators(raw_tokens, fixities, 0, []);
    let parsed = parse_module_rest(
        source,
        tokens,
        0,
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        []
    );
    let with_globals = elaborate_module_globals(
        source, parsed, 0, [], parsed.callables
    );
    elaborate_module_local_types(source, with_globals)
}

operator_instruction(operator: BinaryOperator) -> String / {OperatorCase} {
    handle perform OperatorCase::operator(operator) {
        OperatorCase::operator(BinaryOperator::Add) => "add",
        OperatorCase::operator(BinaryOperator::Subtract) => "sub",
        OperatorCase::operator(BinaryOperator::Multiply) => "mul",
        OperatorCase::operator(BinaryOperator::Divide) => "sdiv",
        OperatorCase::operator(_) => ""
    }
}

comparison_instruction(operator: BinaryOperator) -> String / {OperatorCase} {
    handle perform OperatorCase::operator(operator) {
        OperatorCase::operator(BinaryOperator::Equal) => "eq",
        OperatorCase::operator(BinaryOperator::NotEqual) => "ne",
        OperatorCase::operator(BinaryOperator::LessThan) => "slt",
        OperatorCase::operator(BinaryOperator::LessThanOrEqual) => "sle",
        OperatorCase::operator(BinaryOperator::GreaterThan) => "sgt",
        OperatorCase::operator(BinaryOperator::GreaterThanOrEqual) => "sge",
        OperatorCase::operator(_) => ""
    }
}

operator_is_comparison(operator: BinaryOperator) -> Bool / {OperatorCase} {
    handle perform OperatorCase::operator(operator) {
        OperatorCase::operator(BinaryOperator::Equal) => true,
        OperatorCase::operator(BinaryOperator::NotEqual) => true,
        OperatorCase::operator(BinaryOperator::LessThan) => true,
        OperatorCase::operator(BinaryOperator::LessThanOrEqual) => true,
        OperatorCase::operator(BinaryOperator::GreaterThan) => true,
        OperatorCase::operator(BinaryOperator::GreaterThanOrEqual) => true,
        OperatorCase::operator(_) => false
    }
}

operator_is_equality(operator: BinaryOperator) -> Bool / {OperatorCase} {
    handle perform OperatorCase::operator(operator) {
        OperatorCase::operator(BinaryOperator::Equal) => true,
        OperatorCase::operator(BinaryOperator::NotEqual) => true,
        OperatorCase::operator(_) => false
    }
}

operator_is_add(operator: BinaryOperator) -> Bool / {OperatorCase} {
    handle perform OperatorCase::operator(operator) {
        OperatorCase::operator(BinaryOperator::Add) => true,
        OperatorCase::operator(_) => false
    }
}

lower_arguments(
    source: SourceFile,
    module: Module,
    locals: List<Parameter>,
    arguments: List<Expression>,
    parameters: List<Parameter>,
    index: i64,
    next_temporary: i64,
    instructions: String,
    values: String,
) -> LoweredArguments / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        LoweredArguments {
            instructions: instructions,
            values: values,
            next_temporary: next_temporary,
        }
    } else {
            let parameter = core::list_get(parameters, index);
            let parameter_type = resolve_type(source, module, parameter.parameter_type);
            let lowered = lower_expression(
                source,
                module,
                locals,
                core::list_get(arguments, index),
                parameter_type,
                next_temporary
            );
            let separator = if(index == 0) { "" } else { ", " };
            lower_arguments(
                source,
                module,
                locals,
                arguments,
                parameters,
                index + 1,
                lowered.next_temporary,
                instructions + lowered.instructions,
                values + separator + type_name(parameter_type.kind) + " " + lowered.value
            )
        }
}

lower_struct_fields(
    source: SourceFile,
    module: Module,
    locals: List<Parameter>,
    declaration: StructDecl,
    struct_type: TypeRef,
    supplied: List<NamedExpression>,
    index: i64,
    next_temporary: i64,
    instructions: String,
    aggregate: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(declaration.fields)) {
        LoweredExpression {
            instructions: instructions,
            value: aggregate,
            next_temporary: next_temporary,
        }
    } else {
        let field = core::list_get(declaration.fields, index);
        let type_arguments = handle perform TypeCase::inspect(struct_type.kind) {
            TypeCase::inspect(SourceType::Struct(_, arguments)) => arguments,
            TypeCase::inspect(_) => []
        };
        let field_type = resolve_type(
            source, module,
            core::list_get(
                substitute_types(
                    [field.field_type], declaration.type_parameters,
                    type_arguments, 0, []
                ),
                0
            )
        );
        handle perform NamedExpressionLookupCase::lookup(
            lookup_named_expression(supplied, field.name, 0)
        ) {
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Found(value)) => {
                let lowered = lower_expression(
                    source,
                    module,
                    locals,
                    value.value,
                    field_type,
                    next_temporary
                );
                let temporary = "%t" + core::int_to_string(lowered.next_temporary);
                lower_struct_fields(
                    source,
                    module,
                    locals,
                    declaration,
                    struct_type,
                    supplied,
                    index + 1,
                    lowered.next_temporary + 1,
                    instructions + lowered.instructions +
                        "  " + temporary + " = insertvalue " +
                        type_name(struct_type.kind) + " " + aggregate +
                        ", " + type_name(field_type.kind) + " " + lowered.value +
                        ", " + core::int_to_string(index) + "\n",
                    temporary
                )
            },
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Missing) =>
                compiler_error(
                    source,
                    "GRC9001",
                    "backend invariant violated",
                    declaration.name_span,
                    "validated struct field `" + field.name + "` is unavailable during lowering",
                    [],
                    "semantic validation must establish complete construction before LLVM lowering",
                    "report this compiler bug"
                )
        }
    }
}

lower_variant_payloads(
    source: SourceFile,
    module: Module,
    locals: List<Parameter>,
    enum_type: TypeRef,
    arguments: List<Expression>,
    fields: List<TypeRef>,
    index: i64,
    storage_offset: i64,
    next_temporary: i64,
    instructions: String,
    aggregate: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, BlockStatementCase,
    TypeBindingLookupCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        LoweredExpression {
            instructions: instructions,
            value: aggregate,
            next_temporary: next_temporary,
        }
    } else {
        let field_type = resolve_type(source, module, core::list_get(fields, index));
        let lowered = lower_expression(
            source,
            module,
            locals,
            core::list_get(arguments, index),
            field_type,
            next_temporary
        );
        let temporary = "%t" + core::int_to_string(lowered.next_temporary);
        lower_variant_payloads(
            source,
            module,
            locals,
            enum_type,
            arguments,
            fields,
            index + 1,
            storage_offset,
            lowered.next_temporary + 1,
            instructions + lowered.instructions +
                "  " + temporary + " = insertvalue " +
                type_name(enum_type.kind) + " " + aggregate +
                ", " + type_name(field_type.kind) + " " + lowered.value +
                ", " + core::int_to_string(storage_offset + index) + "\n",
            temporary
        )
    }
}

lower_block(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
    expected: TypeRef,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, TypeBindingLookupCase,
    BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name,
            name_span,
            local_type,
            value,
            _
        )) => {
            let resolved_type = resolve_type(source, module, local_type);
            let needs_drop = type_needs_drop_glue(
                source, module, resolved_type, []
            );
            let uses = owned_value_uses_block(
                source, module, statements, name, index + 1,
                ResumptionUseInterval { lower: 0, upper: 0 }
            );
            let drop_flag = if(needs_drop and uses.lower == 0) {
                "%drop_active_" + name + "_" +
                    core::int_to_string(name_span.start)
            } else {
                ""
            };
            let lowered = lower_expression(
                source,
                module,
                parameters,
                value,
                resolved_type,
                next_temporary
            );
            let rest = lower_block(
                source,
                module,
                core::list_push(parameters, Parameter {
                    name: name,
                    span: name_span,
                    parameter_type: resolved_type,
                    is_local: true,
                    drop_flag: drop_flag,
                    llvm_name: "%local_" + name,
                }),
                statements,
                index + 1,
                expected,
                lowered.next_temporary,
                instructions + lowered.instructions +
                    "  %local_" + name + " = select i1 true, " +
                    type_name(resolved_type.kind) + " " + lowered.value + ", " +
                    type_name(resolved_type.kind) + " " + lowered.value + "\n" +
                    (if(drop_flag != "") {
                        "  " + drop_flag +
                            " = call ptr @grandiose_new_drop_state()\n"
                    } else { "" })
            );
            if(drop_flag != "") {
                let cleanup = lower_ownership_plan(
                    source,
                    module,
                    ownership_root_destroy_plan(resolved_type, drop_flag),
                    0,
                    resolved_type,
                    "%local_" + name,
                    rest.next_temporary,
                    ""
                );
                LoweredExpression {
                    instructions: rest.instructions + cleanup.instructions,
                    value: rest.value,
                    next_temporary: cleanup.next_temporary,
                }
            } else {
                rest
            }
        },
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            if(index + 1 >= core::list_len(statements)) {
                let lowered = lower_expression(
                    source,
                    module,
                    parameters,
                    value,
                    expected,
                    next_temporary
                );
                LoweredExpression {
                    instructions: instructions + lowered.instructions,
                    value: lowered.value,
                    next_temporary: lowered.next_temporary,
                }
            } else {
                let value_type = infer_expression_type(source, module, parameters, value);
                let lowered = lower_expression(
                    source,
                    module,
                    parameters,
                    value,
                    value_type,
                    next_temporary
                );
                lower_block(
                    source,
                    module,
                    parameters,
                    statements,
                    index + 1,
                    expected,
                    lowered.next_temporary,
                    instructions + lowered.instructions
                )
            }
        }
    }
}

struct_field_types(
    fields: List<StructFieldDecl>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase} {
    if(index >= core::list_len(fields)) {
        output
    } else {
        struct_field_types(
            fields, index + 1,
            core::list_push(output, core::list_get(fields, index).field_type)
        )
    }
}

type_list_needs_drop_glue(
    source: SourceFile,
    module: Module,
    references: List<TypeRef>,
    index: i64,
    path: List<String>,
) -> Bool / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(references)) {
        false
    } else {
        type_needs_drop_glue(
            source, module, core::list_get(references, index), path
        ) or type_list_needs_drop_glue(
            source, module, references, index + 1, path
        )
    }
}

variant_list_needs_drop_glue(
    source: SourceFile,
    module: Module,
    declaration: EnumDecl,
    arguments: List<TypeRef>,
    index: i64,
    path: List<String>,
) -> Bool / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(declaration.variants)) {
        false
    } else {
        type_list_needs_drop_glue(
            source, module,
            substitute_types(
                core::list_get(declaration.variants, index).fields,
                declaration.type_parameters, arguments, 0, []
            ),
            0, path
        ) or variant_list_needs_drop_glue(
            source, module, declaration, arguments, index + 1, path
        )
    }
}

type_needs_drop_glue(
    source: SourceFile,
    module: Module,
    reference: TypeRef,
    path: List<String>,
) -> Bool / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let resolved = resolve_type(source, module, reference);
    if(drop_is_present(source, module, resolved, 0)) {
        true
    } else {
    handle perform TypeCase::inspect(resolved.kind) {
        TypeCase::inspect(SourceType::Callable(_, _)) => true,
        TypeCase::inspect(SourceType::Struct(name, arguments)) => {
            if(name_is_present(path, name, 0)) {
                false
            } else {
                handle perform StructLookupCase::lookup(
                    lookup_struct(module.structs, name, 0)
                ) {
                    StructLookupCase::lookup(StructLookup::Found(declaration)) =>
                        type_list_needs_drop_glue(
                            source, module,
                            substitute_types(
                                struct_field_types(
                                    declaration.fields, 0, []
                                ),
                                declaration.type_parameters, arguments, 0, []
                            ),
                            0, core::list_push(path, name)
                        ),
                    StructLookupCase::lookup(StructLookup::Missing) => false
                }
            }
        },
        TypeCase::inspect(SourceType::Enum(name, arguments)) => {
            if(name_is_present(path, name, 0)) {
                false
            } else {
                handle perform EnumLookupCase::lookup(
                    lookup_enum(module.enums, name, 0)
                ) {
                    EnumLookupCase::lookup(EnumLookup::Found(declaration)) =>
                        variant_list_needs_drop_glue(
                            source, module, declaration, arguments, 0,
                            core::list_push(path, name)
                        ),
                    EnumLookupCase::lookup(EnumLookup::Missing) => false
                }
            }
        },
        TypeCase::inspect(_) => false
    }
    }
}

lower_core_intrinsic_call(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    name: String, arguments: List<Expression>, expected: TypeRef,
    span: SourceSpan, next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(name == "core::list_len") {
        let list_expression = core::list_get(arguments, 0);
        let list_type = infer_expression_type(
            source, module, parameters, list_expression
        );
        let list = lower_expression(
            source, module, parameters, list_expression, list_type,
            next_temporary
        );
        let length = "%t" + core::int_to_string(list.next_temporary);
        LoweredExpression {
            instructions: list.instructions + "  " + length +
                " = load i64, ptr " + list.value + "\n",
            value: length,
            next_temporary: list.next_temporary + 1,
        }
    } else {
        if(name == "core::list_get") {
            let list_expression = core::list_get(arguments, 0);
            let index_expression = core::list_get(arguments, 1);
            let list_type = infer_expression_type(
                source, module, parameters, list_expression
            );
            let list = lower_expression(
                source, module, parameters, list_expression, list_type,
                next_temporary
            );
            let index = lower_expression(
                source, module, parameters, index_expression,
                TypeRef { kind: SourceType::I64, span: span },
                list.next_temporary
            );
            let data = "%t" + core::int_to_string(index.next_temporary);
            let slot = "%t" + core::int_to_string(index.next_temporary + 1);
            let value = "%t" + core::int_to_string(index.next_temporary + 2);
            LoweredExpression {
                instructions: list.instructions + index.instructions +
                    "  " + data + " = getelementptr i8, ptr " + list.value +
                    ", i64 8\n" +
                    "  " + slot + " = getelementptr " + type_name(expected.kind) +
                    ", ptr " + data + ", i64 " + index.value + "\n" +
                    "  " + value + " = load " + type_name(expected.kind) +
                    ", ptr " + slot + "\n",
                value: value,
                next_temporary: index.next_temporary + 3,
            }
        } else {
            if(name == "core::list_push") {
                let list_expression = core::list_get(arguments, 0);
                let item_expression = core::list_get(arguments, 1);
                let list_type = resolve_type(source, module, expected);
                let element = handle perform TypeCase::inspect(list_type.kind) {
                    TypeCase::inspect(SourceType::List(found)) => found,
                    TypeCase::inspect(_) => compiler_error(
                        source, "GRC9001", "list intrinsic invariant violated",
                        span, "`core::list_push` has a non-list result", [],
                        "generic list intrinsic validation establishes its result type",
                        "report this compiler bug"
                    )
                };
                let list = lower_expression(
                    source, module, parameters, list_expression, list_type,
                    next_temporary
                );
                let item = lower_expression(
                    source, module, parameters, item_expression, element,
                    list.next_temporary
                );
                let length = "%t" + core::int_to_string(item.next_temporary);
                let next_length = "%t" + core::int_to_string(item.next_temporary + 1);
                let element_size_ptr = "%t" + core::int_to_string(item.next_temporary + 2);
                let element_size = "%t" + core::int_to_string(item.next_temporary + 3);
                let old_bytes = "%t" + core::int_to_string(item.next_temporary + 4);
                let new_bytes = "%t" + core::int_to_string(item.next_temporary + 5);
                let allocation_size = "%t" + core::int_to_string(item.next_temporary + 6);
                let allocation = "%t" + core::int_to_string(item.next_temporary + 7);
                let old_data = "%t" + core::int_to_string(item.next_temporary + 8);
                let new_data = "%t" + core::int_to_string(item.next_temporary + 9);
                let slot = "%t" + core::int_to_string(item.next_temporary + 10);
                LoweredExpression {
                    instructions: list.instructions + item.instructions +
                        "  " + length + " = load i64, ptr " + list.value + "\n" +
                        "  " + next_length + " = add i64 " + length + ", 1\n" +
                        "  " + element_size_ptr + " = getelementptr " +
                            type_name(element.kind) + ", ptr null, i64 1\n" +
                        "  " + element_size + " = ptrtoint ptr " + element_size_ptr +
                            " to i64\n" +
                        "  " + old_bytes + " = mul i64 " + length + ", " +
                            element_size + "\n" +
                        "  " + new_bytes + " = mul i64 " + next_length + ", " +
                            element_size + "\n" +
                        "  " + allocation_size + " = add i64 " + new_bytes + ", 8\n" +
                        "  " + allocation + " = call ptr @malloc(i64 " +
                            allocation_size + ")\n" +
                        "  store i64 " + next_length + ", ptr " + allocation + "\n" +
                        "  " + old_data + " = getelementptr i8, ptr " + list.value +
                            ", i64 8\n" +
                        "  " + new_data + " = getelementptr i8, ptr " + allocation +
                            ", i64 8\n" +
                        "  call void @llvm.memcpy.p0.p0.i64(ptr " + new_data +
                            ", ptr " + old_data + ", i64 " + old_bytes +
                            ", i1 false)\n" +
                        "  " + slot + " = getelementptr " + type_name(element.kind) +
                            ", ptr " + new_data + ", i64 " + length + "\n" +
                        "  store " + type_name(element.kind) + " " + item.value +
                            ", ptr " + slot + "\n",
                    value: allocation,
                    next_temporary: item.next_temporary + 11,
                }
            } else {
                compiler_error(
                    source, "GRC1872", "core intrinsic has no LLVM lowering",
                    span, "`" + name + "` is typed but not lowered yet", [],
                    "core intrinsics have explicit compiler/runtime ABI implementations",
                    "implement this intrinsic before using it in native code"
                )
            }
        }
    }
}

lower_named_call(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    name: String,
    arguments: List<Expression>,
    expected: TypeRef,
    span: SourceSpan,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(compiler_core_intrinsic(name)) {
        lower_core_intrinsic_call(
            source, module, parameters, name, arguments, expected,
            span, next_temporary
        )
    } else {
    handle perform ParameterLookupCase::lookup(lookup_parameter(parameters, name, 0)) {
        ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) => {
            let parameter_type = resolve_type(source, module, parameter.parameter_type);
            handle perform TypeCase::inspect(parameter_type.kind) {
                TypeCase::inspect(SourceType::Callable(output, _)) => {
                    let function_temporary = "%t" + core::int_to_string(next_temporary);
                    let environment_temporary = "%t" +
                        core::int_to_string(next_temporary + 1);
                    let result_temporary = "%t" + core::int_to_string(next_temporary + 2);
                    LoweredExpression {
                        instructions: "  " + function_temporary +
                            " = extractvalue { ptr, ptr, ptr } " + parameter.llvm_name + ", 0\n" +
                            "  " + environment_temporary +
                            " = extractvalue { ptr, ptr, ptr } " + parameter.llvm_name + ", 1\n" +
                            "  " + result_temporary + " = call " + type_name(output.kind) +
                            " " + function_temporary + "(ptr " +
                            environment_temporary + ")\n",
                        value: result_temporary,
                        next_temporary: next_temporary + 3,
                    }
                },
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC9001",
                    "backend callable invariant violated",
                    span,
                    "a non-callable parameter reached indirect-call lowering",
                    [],
                    "semantic validation must reject non-callable invocations",
                    "report this compiler bug"
                )
            }
        },
        ParameterLookupCase::lookup(ParameterLookup::Missing) => {
            let callable = resolve_callable(source, module, name, span);
            let bindings = if(core::list_len(callable.type_parameters) > 0) {
                infer_call_bindings(
                    source,
                    module,
                    parameters,
                    arguments,
                    callable,
                    expected,
                    span
                )
            } else {
                []
            };
            let result_type = resolve_type(
                source,
                module,
                substitute_bindings(callable.result_type, bindings)
            );
            let call_parameters = specialize_parameters(
                callable.parameters,
                bindings,
                0,
                []
            );
            let suffix = if(core::list_len(callable.type_parameters) > 0) {
                specialization_suffix(callable.type_parameters, bindings, 0, "")
            } else {
                ""
            };
            let lowered_arguments = lower_arguments(
                source,
                module,
                parameters,
                arguments,
                call_parameters,
                0,
                next_temporary,
                "",
                ""
            );
            let temporary = "%t" + core::int_to_string(lowered_arguments.next_temporary);
            LoweredExpression {
                instructions: lowered_arguments.instructions +
                    "  " + temporary + " = call " + type_name(result_type.kind) +
                    " @grandiose_" + name + suffix +
                    "(" + lowered_arguments.values + ")\n",
                value: temporary,
                next_temporary: lowered_arguments.next_temporary + 1,
            }
        }
    }
    }
}

lower_pattern_fields(
    source: SourceFile,
    module: Module,
    outer_parameters: List<Parameter>,
    patterns: List<Pattern>,
    field_types: List<TypeRef>,
    index: i64,
    subject_type: TypeRef,
    subject_value: String,
    storage_offset: i64,
    instructions: String,
    parameters: List<Parameter>,
) -> LoweredPatternBindings / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        LoweredPatternBindings {
            parameters: parameters,
            instructions: instructions,
        }
    } else {
        let pattern = core::list_get(patterns, index);
        let field_type = resolve_type(source, module, core::list_get(field_types, index));
        handle perform PatternCase::inspect(pattern) {
            PatternCase::inspect(Pattern::Binding(name, span)) => {
                let llvm_name = "%pattern_" + name + "_" +
                    core::int_to_string(span.start);
                let drop_flag = if(type_needs_drop_glue(
                    source, module, field_type, []
                )) {
                    "%drop_active_pattern_" + name + "_" +
                        core::int_to_string(span.start)
                } else {
                    ""
                };
                lower_pattern_fields(
                    source,
                    module,
                    outer_parameters,
                    patterns,
                    field_types,
                    index + 1,
                    subject_type,
                    subject_value,
                    storage_offset,
                    instructions + "  " + llvm_name + " = extractvalue " +
                        type_name(subject_type.kind) + " " + subject_value + ", " +
                        core::int_to_string(storage_offset + index) + "\n" +
                        (if(drop_flag == "") { "" } else {
                            "  " + drop_flag +
                                " = call ptr @grandiose_new_drop_state()\n"
                        }),
                    core::list_push(parameters, Parameter {
                        name: name,
                        span: span,
                        parameter_type: field_type,
                        is_local: true,
                        drop_flag: drop_flag,
                        llvm_name: llvm_name,
                    })
                )
            },
            PatternCase::inspect(Pattern::Wildcard(_)) => lower_pattern_fields(
                source, module, outer_parameters, patterns, field_types, index + 1,
                subject_type, subject_value, storage_offset, instructions, parameters
            ),
            PatternCase::inspect(Pattern::Unit(_)) => lower_pattern_fields(
                source, module, outer_parameters, patterns, field_types, index + 1,
                subject_type, subject_value, storage_offset, instructions, parameters
            ),
            PatternCase::inspect(Pattern::Integer(_, _)) => lower_pattern_fields(
                source, module, outer_parameters, patterns, field_types, index + 1,
                subject_type, subject_value, storage_offset, instructions, parameters
            ),
            PatternCase::inspect(Pattern::String(_, _)) => lower_pattern_fields(
                source, module, outer_parameters, patterns, field_types, index + 1,
                subject_type, subject_value, storage_offset, instructions, parameters
            ),
            PatternCase::inspect(Pattern::Variant(
                enum_name, variant_name, nested_patterns, span
            )) => {
                handle perform TypeCase::inspect(field_type.kind) {
                    TypeCase::inspect(SourceType::Enum(
                        resolved_name, enum_arguments
                    )) => {
                        require(
                            resolved_name == enum_name,
                            error_diagnostic(
                                source, "GRC9001",
                                "nested binding invariant violated", span,
                                "validated nested enum changed identity", [],
                                "pattern validation precedes binding lowering",
                                "report this compiler bug"
                            )
                        );
                        let declaration = handle perform EnumLookupCase::lookup(
                            lookup_enum(module.enums, enum_name, 0)
                        ) {
                            EnumLookupCase::lookup(EnumLookup::Found(found)) => found,
                            EnumLookupCase::lookup(EnumLookup::Missing) =>
                                compiler_error(
                                    source, "GRC9001",
                                    "nested enum invariant violated", span,
                                    "validated nested enum is unavailable", [],
                                    "semantic and backend nominal environments agree",
                                    "report this compiler bug"
                                )
                        };
                        let variant = handle perform VariantLookupCase::lookup(
                            lookup_variant(
                                declaration.variants, variant_name, 0
                            )
                        ) {
                            VariantLookupCase::lookup(
                                VariantLookup::Found(found)
                            ) => found,
                            VariantLookupCase::lookup(
                                VariantLookup::Missing
                            ) => compiler_error(
                                source, "GRC9001",
                                "nested variant invariant violated", span,
                                "validated nested variant is unavailable", [],
                                "semantic and backend nominal environments agree",
                                "report this compiler bug"
                            )
                        };
                        let nested_subject = "%pattern_subject_" +
                            core::int_to_string(span.start);
                        let nested = lower_pattern_fields(
                            source, module, outer_parameters, nested_patterns,
                            substitute_types(
                                variant.fields,
                                declaration.type_parameters,
                                enum_arguments, 0, []
                            ),
                            0, field_type, nested_subject,
                            1 + variant_payload_offset(
                                declaration.variants,
                                variant_index(
                                    declaration.variants, variant_name, 0
                                ),
                                0, 0
                            ),
                            instructions +
                                "  " + nested_subject + " = extractvalue " +
                                    type_name(subject_type.kind) + " " +
                                    subject_value + ", " +
                                    core::int_to_string(storage_offset + index) +
                                    "\n",
                            parameters
                        );
                        lower_pattern_fields(
                            source, module, outer_parameters, patterns,
                            field_types, index + 1, subject_type, subject_value,
                            storage_offset, nested.instructions,
                            nested.parameters
                        )
                    },
                    TypeCase::inspect(_) => compiler_error(
                        source, "GRC9001",
                        "nested binding invariant violated", span,
                        "nested enum pattern reached a non-enum field", [],
                        "semantic pattern validation precedes lowering",
                        "report this compiler bug"
                    )
                }
            }
        }
    }
}

lower_handler_variant_clauses(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    declaration: EnumDecl,
    enum_arguments: List<TypeRef>,
    clauses: List<HandlerClause>,
    clause_index: i64,
    variant: VariantDecl,
    variant_index_value: i64,
    subject_type: TypeRef,
    subject_value: String,
    expected: TypeRef,
    handler_id: i64,
    next_temporary: i64,
    entry_label: String,
    instructions: String,
    incoming: String,
) -> LoweredHandlerClauses / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase,
    Diagnostics
} {
    if(clause_index >= core::list_len(clauses)) {
        LoweredHandlerClauses {
            instructions: instructions + entry_label + ":\n  unreachable\n",
            incoming: incoming,
            switch_cases: "",
            next_temporary: next_temporary,
        }
    } else {
        let clause = core::list_get(clauses, clause_index);
        let outer_pattern = core::list_get(clause.patterns, 0);
        handle perform PatternCase::inspect(outer_pattern) {
            PatternCase::inspect(Pattern::Variant(
                enum_name, variant_name, fields, _
            )) => {
                if(enum_name != declaration.name or
                    variant_name != variant.name) {
                    lower_handler_variant_clauses(
                        source, module, lexical_parameters, declaration,
                        enum_arguments, clauses, clause_index + 1, variant,
                        variant_index_value, subject_type, subject_value,
                        expected, handler_id, next_temporary, entry_label,
                        instructions, incoming
                    )
                } else {
                    let field_types = substitute_types(
                        variant.fields, declaration.type_parameters,
                        enum_arguments, 0, []
                    );
                    let offset = 1 + variant_payload_offset(
                        declaration.variants, variant_index_value, 0, 0
                    );
                    let irrefutable = patterns_are_irrefutable(fields, 0);
                    let condition = if(irrefutable) {
                        LoweredExpression {
                            instructions: "",
                            value: "true",
                            next_temporary: next_temporary,
                        }
                    } else {
                        lower_runtime_nested_pattern_fields(
                            source, module, fields, field_types, 0,
                            subject_type, subject_value, offset, "true",
                            next_temporary, ""
                        )
                    };
                    let body_label = "handler_" +
                        core::int_to_string(handler_id) + "_case_" +
                        core::int_to_string(variant_index_value) + "_body_" +
                        core::int_to_string(clause_index);
                    let next_label = "handler_" +
                        core::int_to_string(handler_id) + "_case_" +
                        core::int_to_string(variant_index_value) + "_pattern_" +
                        core::int_to_string(clause_index + 1);
                    let bindings = lower_pattern_fields(
                        source, module, lexical_parameters, fields, field_types,
                        0, subject_type, subject_value, offset, "",
                        lexical_parameters
                    );
                    let lowered = lower_expression(
                        source, module, bindings.parameters, clause.body,
                        expected, condition.next_temporary
                    );
                    let separator = if(incoming == "") { "" } else { ", " };
                    let branch = if(irrefutable) {
                        "  br label %" + body_label + "\n"
                    } else {
                        "  br i1 " + condition.value + ", label %" +
                            body_label + ", label %" + next_label + "\n"
                    };
                    let with_body = instructions + entry_label + ":\n" +
                        condition.instructions + branch + body_label + ":\n" +
                        bindings.instructions + lowered.instructions +
                        "  br label %handler_" +
                        core::int_to_string(handler_id) + "_merge\n";
                    let with_incoming = incoming + separator + "[ " +
                        lowered.value + ", %" + body_label + " ]";
                    if(irrefutable) {
                        LoweredHandlerClauses {
                            instructions: with_body,
                            incoming: with_incoming,
                            switch_cases: "",
                            next_temporary: lowered.next_temporary,
                        }
                    } else {
                        lower_handler_variant_clauses(
                            source, module, lexical_parameters, declaration,
                            enum_arguments, clauses, clause_index + 1, variant,
                            variant_index_value, subject_type, subject_value,
                            expected, handler_id, lowered.next_temporary,
                            next_label, with_body, with_incoming
                        )
                    }
                }
            },
            PatternCase::inspect(_) => compiler_error(
                source, "GRC1818",
                "terminal enum clause needs an explicit variant pattern",
                clause.span,
                "this clause does not identify the enum tag it handles", [],
                "terminal clauses use ordered patterns within explicit enum tags",
                "replace the outer pattern with a nominal variant pattern"
            )
        }
    }
}

lower_handler_variants(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    declaration: EnumDecl,
    enum_arguments: List<TypeRef>,
    clauses: List<HandlerClause>,
    variant_index_value: i64,
    subject_type: TypeRef,
    subject_value: String,
    expected: TypeRef,
    handler_id: i64,
    next_temporary: i64,
    instructions: String,
    incoming: String,
    switch_cases: String,
) -> LoweredHandlerClauses / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase,
    TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase,
    Diagnostics
} {
    if(variant_index_value >= core::list_len(declaration.variants)) {
        LoweredHandlerClauses {
            instructions: instructions,
            incoming: incoming,
            switch_cases: switch_cases,
            next_temporary: next_temporary,
        }
    } else {
        let variant = core::list_get(declaration.variants, variant_index_value);
        let label = "handler_" + core::int_to_string(handler_id) +
            "_case_" + core::int_to_string(variant_index_value) + "_pattern_0";
        let lowered = lower_handler_variant_clauses(
            source, module, lexical_parameters, declaration, enum_arguments,
            clauses, 0, variant, variant_index_value, subject_type,
            subject_value, expected, handler_id, next_temporary, label,
            instructions, incoming
        );
        lower_handler_variants(
            source, module, lexical_parameters, declaration, enum_arguments,
            clauses, variant_index_value + 1, subject_type, subject_value,
            expected, handler_id, lowered.next_temporary,
            lowered.instructions, lowered.incoming,
            switch_cases + "    i32 " +
                core::int_to_string(variant_index_value) + ", label %" +
                label + "\n"
        )
    }
}

lookup_irrefutable_handler_clause(
    clauses: List<HandlerClause>,
    index: i64,
) -> HandlerClauseLookup / {ResultCase} {
    if(index >= core::list_len(clauses)) {
        HandlerClauseLookup::Missing
    } else {
        let clause = core::list_get(clauses, index);
        if(patterns_are_irrefutable(clause.patterns, 0)) {
            HandlerClauseLookup::Found(clause)
        } else {
            lookup_irrefutable_handler_clause(clauses, index + 1)
        }
    }
}

lower_resumptive_arguments(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    arguments: List<Expression>,
    operation_parameters: List<Parameter>,
    patterns: List<Pattern>,
    index: i64,
    next_temporary: i64,
    instructions: String,
    branch_parameters: List<Parameter>,
) -> LoweredResumptiveArguments / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        LoweredResumptiveArguments {
            parameters: branch_parameters,
            instructions: instructions,
            next_temporary: next_temporary,
        }
    } else {
        let parameter_type = resolve_type(
            source,
            module,
            core::list_get(operation_parameters, index).parameter_type
        );
        let lowered = lower_expression(
            source,
            module,
            lexical_parameters,
            core::list_get(arguments, index),
            parameter_type,
            next_temporary
        );
        handle perform PatternCase::inspect(core::list_get(patterns, index)) {
            PatternCase::inspect(Pattern::Binding(name, span)) =>
                lower_resumptive_arguments(
                    source,
                    module,
                    lexical_parameters,
                    arguments,
                    operation_parameters,
                    patterns,
                    index + 1,
                    lowered.next_temporary,
                    instructions + lowered.instructions,
                    core::list_push(branch_parameters, Parameter {
                        name: name,
                        span: span,
                        parameter_type: parameter_type,
                        is_local: true,
                        drop_flag: "",
                        llvm_name: lowered.value,
                    })
                ),
            PatternCase::inspect(Pattern::Wildcard(_)) =>
                lower_resumptive_arguments(
                    source, module, lexical_parameters, arguments,
                    operation_parameters, patterns, index + 1,
                    lowered.next_temporary, instructions + lowered.instructions,
                    branch_parameters
                ),
            PatternCase::inspect(_) => compiler_error(
                source,
                "GRC9001",
                "static handler dispatch invariant violated",
                pattern_span(core::list_get(patterns, index)),
                "a refutable pattern reached irrefutable static binding",
                [],
                "ordered and refutable clauses must use runtime pattern MIR",
                "report this compiler bug"
            )
        }
    }
}

lower_static_clause_block(
    source: SourceFile,
    module: Module,
    clause_parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
    resumption_name: String,
    continuation_parameters: List<Parameter>,
    continuation_statements: List<BlockStatement>,
    continuation_index: i64,
    continuation_binding_name: String,
    continuation_binding_span: SourceSpan,
    continuation_binding_type: TypeRef,
    clauses: List<HandlerClause>,
    effect_name: String,
    operation_name: String,
    expected: TypeRef,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name, name_span, local_type, value, _
        )) => {
            let lowered = lower_static_clause_expression(
                source, module, clause_parameters, value, local_type,
                resumption_name, continuation_parameters, continuation_statements,
                continuation_index, continuation_binding_name,
                continuation_binding_span, continuation_binding_type,
                clauses, effect_name, operation_name, expected, next_temporary
            );
            lower_static_clause_block(
                source,
                module,
                core::list_push(clause_parameters, Parameter {
                    name: name,
                    span: name_span,
                    parameter_type: local_type,
                    is_local: true,
                    drop_flag: "",
                    llvm_name: lowered.value,
                }),
                statements,
                index + 1,
                resumption_name,
                continuation_parameters,
                continuation_statements,
                continuation_index,
                continuation_binding_name,
                continuation_binding_span,
                continuation_binding_type,
                clauses,
                effect_name,
                operation_name,
                expected,
                lowered.next_temporary,
                instructions + lowered.instructions
            )
        },
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            let value_type = if(index + 1 >= core::list_len(statements)) {
                expected
            } else {
                infer_expression_type(source, module, clause_parameters, value)
            };
            let lowered = lower_static_clause_expression(
                source, module, clause_parameters, value, value_type,
                resumption_name, continuation_parameters, continuation_statements,
                continuation_index, continuation_binding_name,
                continuation_binding_span, continuation_binding_type,
                clauses, effect_name, operation_name, expected, next_temporary
            );
            if(index + 1 >= core::list_len(statements)) {
                LoweredExpression {
                    instructions: instructions + lowered.instructions,
                    value: lowered.value,
                    next_temporary: lowered.next_temporary,
                }
            } else {
                lower_static_clause_block(
                    source, module, clause_parameters, statements, index + 1,
                    resumption_name, continuation_parameters,
                    continuation_statements, continuation_index,
                    continuation_binding_name, continuation_binding_span,
                    continuation_binding_type, clauses, effect_name, operation_name,
                    expected, lowered.next_temporary,
                    instructions + lowered.instructions
                )
            }
        }
    }
}

lower_static_clause_expression(
    source: SourceFile,
    module: Module,
    clause_parameters: List<Parameter>,
    expression: Expression,
    expression_type: TypeRef,
    resumption_name: String,
    continuation_parameters: List<Parameter>,
    continuation_statements: List<BlockStatement>,
    continuation_index: i64,
    continuation_binding_name: String,
    continuation_binding_span: SourceSpan,
    continuation_binding_type: TypeRef,
    clauses: List<HandlerClause>,
    effect_name: String,
    operation_name: String,
    expected: TypeRef,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Call("resume", arguments, span)) => {
            handle perform ExpressionCase::expression(core::list_get(arguments, 0)) {
                ExpressionCase::expression(Expression::Variable(name, _)) => require(
                    name == resumption_name,
                    error_diagnostic(
                        source,
                        "GRC1901",
                        "resumption does not belong to this handler",
                        span,
                        "this static continuation is bound as `" + resumption_name + "`",
                        [],
                        "resumptions carry their exact delimited continuation identity",
                        "resume the continuation introduced by this clause"
                    )
                ),
                ExpressionCase::expression(_) => ()
            };
            let resumed_value = lower_expression(
                source,
                module,
                clause_parameters,
                core::list_get(arguments, 1),
                continuation_binding_type,
                next_temporary
            );
            lower_static_handler_block(
                source,
                module,
                core::list_push(continuation_parameters, Parameter {
                    name: continuation_binding_name,
                    span: continuation_binding_span,
                    parameter_type: continuation_binding_type,
                    is_local: true,
                    drop_flag: "",
                    llvm_name: resumed_value.value,
                }),
                continuation_statements,
                continuation_index,
                clauses,
                effect_name,
                operation_name,
                expected,
                resumed_value.next_temporary,
                resumed_value.instructions
            )
        },
        ExpressionCase::expression(Expression::Call("cancel", _, _)) =>
            LoweredExpression {
                instructions: "",
                value: "{}",
                next_temporary: next_temporary,
            },
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            lower_static_clause_block(
                source, module, clause_parameters, statements, 0,
                resumption_name, continuation_parameters, continuation_statements,
                continuation_index, continuation_binding_name,
                continuation_binding_span, continuation_binding_type,
                clauses, effect_name, operation_name, expected,
                next_temporary, ""
            ),
        ExpressionCase::expression(_) => lower_expression(
            source,
            module,
            clause_parameters,
            expression,
            expression_type,
            next_temporary
        )
    }
}

lower_static_handler_block(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
    clauses: List<HandlerClause>,
    effect_name: String,
    operation_name: String,
    expected: TypeRef,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name, name_span, local_type, value, _
        )) => {
            handle perform ExpressionCase::expression(value) {
                ExpressionCase::expression(Expression::Perform(
                    performed_effect, performed_operation, arguments, perform_span
                )) => {
                    require(
                        performed_effect == effect_name and
                            performed_operation == operation_name,
                        error_diagnostic(
                            source,
                            "GRC1902",
                            "static handler encountered another effect",
                            perform_span,
                            "this continuation handles `" + effect_name + "::" +
                                operation_name + "`, not `" + performed_effect + "::" +
                                performed_operation + "`",
                            [],
                            "unmatched effects must be forwarded through the runtime handler chain",
                            "declare the outward effect while runtime forwarding is completed"
                        )
                    );
                    let resolved = resolve_perform_operation(
                        source, module, parameters, performed_effect,
                        performed_operation, arguments, perform_span
                    );
                    handle perform HandlerClauseLookupCase::lookup(
                        lookup_irrefutable_handler_clause(clauses, 0)
                    ) {
                        HandlerClauseLookupCase::lookup(HandlerClauseLookup::Missing) =>
                            compiler_error(
                                source,
                                "GRC1903",
                                "resumptive handler has no irrefutable native clause",
                                perform_span,
                                "the continuation backend cannot select a total clause",
                                [],
                                "semantic checking preserves partial handlers for outward forwarding",
                                "add a binding or `_` fallback clause"
                            ),
                        HandlerClauseLookupCase::lookup(HandlerClauseLookup::Found(clause)) => {
                            let lowered_arguments = lower_resumptive_arguments(
                                source, module, parameters, arguments,
                                resolved.parameters, clause.patterns, 0,
                                next_temporary, "", parameters
                            );
                            let lowered_clause = lower_static_clause_expression(
                                source,
                                module,
                                lowered_arguments.parameters,
                                clause.body,
                                expected,
                                clause.resumption_name,
                                parameters,
                                statements,
                                index + 1,
                                name,
                                name_span,
                                local_type,
                                clauses,
                                effect_name,
                                operation_name,
                                expected,
                                lowered_arguments.next_temporary
                            );
                            LoweredExpression {
                                instructions: instructions +
                                    lowered_arguments.instructions +
                                    lowered_clause.instructions,
                                value: lowered_clause.value,
                                next_temporary: lowered_clause.next_temporary,
                            }
                        }
                    }
                },
                ExpressionCase::expression(_) => {
                    let resolved_type = resolve_type(source, module, local_type);
                    let lowered = lower_expression(
                        source, module, parameters, value, resolved_type, next_temporary
                    );
                    lower_static_handler_block(
                        source,
                        module,
                        core::list_push(parameters, Parameter {
                            name: name,
                            span: name_span,
                            parameter_type: resolved_type,
                            is_local: true,
                            drop_flag: "",
                            llvm_name: lowered.value,
                        }),
                        statements,
                        index + 1,
                        clauses,
                        effect_name,
                        operation_name,
                        expected,
                        lowered.next_temporary,
                        instructions + lowered.instructions
                    )
                }
            }
        },
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            if(index + 1 >= core::list_len(statements)) {
                let lowered = lower_expression(
                    source, module, parameters, value, expected, next_temporary
                );
                LoweredExpression {
                    instructions: instructions + lowered.instructions,
                    value: lowered.value,
                    next_temporary: lowered.next_temporary,
                }
            } else {
                let value_type = infer_expression_type(source, module, parameters, value);
                let lowered = lower_expression(
                    source, module, parameters, value, value_type, next_temporary
                );
                lower_static_handler_block(
                    source, module, parameters, statements, index + 1,
                    clauses, effect_name, operation_name, expected,
                    lowered.next_temporary, instructions + lowered.instructions
                )
            }
        }
    }
}

lower_runtime_payload_patterns(
    source: SourceFile,
    module: Module,
    outer_parameters: List<Parameter>,
    patterns: List<Pattern>,
    operation_parameters: List<Parameter>,
    index: i64,
    payload_type: String,
    payload_value: String,
    instructions: String,
    parameters: List<Parameter>,
) -> LoweredPatternBindings / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        LoweredPatternBindings {
            parameters: parameters,
            instructions: instructions,
        }
    } else {
        let pattern = core::list_get(patterns, index);
        let parameter_type = resolve_type(
            source, module,
            core::list_get(operation_parameters, index).parameter_type
        );
        handle perform PatternCase::inspect(pattern) {
            PatternCase::inspect(Pattern::Binding(name, span)) => {
                let llvm_name = "%runtime_pattern_" + name + "_" +
                    core::int_to_string(span.start);
                let drop_flag = if(type_needs_drop_glue(
                    source, module, parameter_type, []
                )) {
                    "%drop_active_pattern_" + name + "_" +
                        core::int_to_string(span.start)
                } else {
                    ""
                };
                lower_runtime_payload_patterns(
                    source, module, outer_parameters, patterns,
                    operation_parameters, index + 1, payload_type, payload_value,
                    instructions + "  " + llvm_name + " = extractvalue " +
                        payload_type + " " + payload_value + ", " +
                        core::int_to_string(index) + "\n" +
                        (if(drop_flag == "") { "" } else {
                            "  " + drop_flag +
                                " = call ptr @grandiose_new_drop_state()\n"
                        }),
                    core::list_push(parameters, Parameter {
                        name: name,
                        span: span,
                        parameter_type: parameter_type,
                        is_local: true,
                        drop_flag: drop_flag,
                        llvm_name: llvm_name,
                    })
                )
            },
            PatternCase::inspect(Pattern::Wildcard(_)) =>
                lower_runtime_payload_patterns(
                    source, module, outer_parameters, patterns,
                    operation_parameters, index + 1, payload_type, payload_value,
                    instructions, parameters
                ),
            PatternCase::inspect(Pattern::Unit(_)) =>
                lower_runtime_payload_patterns(
                    source, module, outer_parameters, patterns,
                    operation_parameters, index + 1, payload_type, payload_value,
                    instructions, parameters
                ),
            PatternCase::inspect(Pattern::Integer(_, _)) =>
                lower_runtime_payload_patterns(
                    source, module, outer_parameters, patterns,
                    operation_parameters, index + 1, payload_type, payload_value,
                    instructions, parameters
                ),
            PatternCase::inspect(Pattern::String(_, _)) =>
                lower_runtime_payload_patterns(
                    source, module, outer_parameters, patterns,
                    operation_parameters, index + 1, payload_type, payload_value,
                    instructions, parameters
                ),
            PatternCase::inspect(Pattern::Variant(
                enum_name, variant_name, fields, span
            )) => {
                handle perform TypeCase::inspect(parameter_type.kind) {
                    TypeCase::inspect(SourceType::Enum(
                        resolved_name, enum_arguments
                    )) => {
                        require(
                            resolved_name == enum_name,
                            error_diagnostic(
                                source, "GRC9001", "nominal pattern invariant violated",
                                span, "validated enum pattern changed identity", [],
                                "pattern checking and lowering share nominal identities",
                                "report this compiler bug"
                            )
                        );
                        handle perform EnumLookupCase::lookup(
                            lookup_enum(module.enums, enum_name, 0)
                        ) {
                            EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                                handle perform VariantLookupCase::lookup(
                                    lookup_variant(
                                        declaration.variants, variant_name, 0
                                    )
                                ) {
                                    VariantLookupCase::lookup(
                                        VariantLookup::Found(variant)
                                    ) => {
                                        let tag = variant_index(
                                            declaration.variants, variant_name, 0
                                        );
                                        let offset = 1 + variant_payload_offset(
                                            declaration.variants, tag, 0, 0
                                        );
                                        let subject = "%runtime_pattern_subject_" +
                                            core::int_to_string(span.start);
                                        let bindings = lower_pattern_fields(
                                            source, module, outer_parameters, fields,
                                            substitute_types(
                                                variant.fields,
                                                declaration.type_parameters,
                                                enum_arguments,
                                                0,
                                                []
                                            ),
                                            0, parameter_type, subject, offset,
                                            instructions + "  " + subject +
                                                " = extractvalue " + payload_type +
                                                " " + payload_value + ", " +
                                                core::int_to_string(index) + "\n",
                                            parameters
                                        );
                                        lower_runtime_payload_patterns(
                                            source, module, outer_parameters,
                                            patterns, operation_parameters,
                                            index + 1, payload_type, payload_value,
                                            bindings.instructions,
                                            bindings.parameters
                                        )
                                    },
                                    VariantLookupCase::lookup(
                                        VariantLookup::Missing
                                    ) => compiler_error(
                                        source, "GRC9001",
                                        "variant pattern invariant violated", span,
                                        "validated variant is unavailable", [],
                                        "semantic and backend nominal environments agree",
                                        "report this compiler bug"
                                    )
                                }
                            },
                            EnumLookupCase::lookup(EnumLookup::Missing) =>
                                compiler_error(
                                    source, "GRC9001",
                                    "enum pattern invariant violated", span,
                                    "validated enum is unavailable", [],
                                    "semantic and backend nominal environments agree",
                                    "report this compiler bug"
                                )
                        }
                    },
                    TypeCase::inspect(_) => compiler_error(
                        source, "GRC9001", "nominal pattern invariant violated",
                        span, "enum pattern reached a non-enum payload", [],
                        "semantic pattern validation precedes lowering",
                        "report this compiler bug"
                    )
                }
            },
            PatternCase::inspect(_) => compiler_error(
                source,
                "GRC9001",
                "refutable runtime pattern reached total-clause lowering",
                pattern_span(pattern),
                "this clause was selected as an irrefutable runtime fallback",
                [],
                "runtime fallback selection accepts only bindings and wildcards",
                "report this compiler bug"
            )
        }
    }
}

runtime_handler_symbol(
    call_span: SourceSpan,
    expected: TypeRef,
) -> String / {ResultCase, TypeCase} {
    "@grandiose_runtime_handler_" +
        core::int_to_string(call_span.start) + "__" +
        type_mangle(expected)
}

runtime_value_parameters(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        let parameter_type = resolve_type(
            source, module, parameter.parameter_type
        );
        handle perform TypeCase::inspect(parameter_type.kind) {
            TypeCase::inspect(SourceType::Resumption(_, _)) =>
                runtime_value_parameters(
                    source, module, parameters, index + 1, output
                ),
            TypeCase::inspect(_) => runtime_value_parameters(
                source, module, parameters, index + 1,
                core::list_push(output, parameter)
            )
        }
    }
}

runtime_handler_parameter_values(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        let parameter_type = resolve_type(
            source, module, parameter.parameter_type
        );
        runtime_handler_parameter_values(
            source, module, parameters, index + 1,
            output + ", " + type_name(parameter_type.kind) + " " +
                parameter.llvm_name
        )
    }
}

lower_runtime_clause_block(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    handler_parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
    expected: TypeRef,
    operation_result: TypeRef,
    resumption_name: String,
    resume_function: String,
    resume_environment: String,
    handler_symbol: String,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name, name_span, local_type, value, _
        )) => {
            let resolved_type = resolve_type(source, module, local_type);
            let lowered = lower_runtime_clause_expression(
                source, module, parameters, handler_parameters, value,
                resolved_type, operation_result, resumption_name,
                resume_function, resume_environment, handler_symbol,
                next_temporary
            );
            lower_runtime_clause_block(
                source,
                module,
                core::list_push(parameters, Parameter {
                    name: name,
                    span: name_span,
                    parameter_type: resolved_type,
                    is_local: true,
                    drop_flag: "",
                    llvm_name: lowered.value,
                }),
                handler_parameters,
                statements,
                index + 1,
                expected,
                operation_result,
                resumption_name,
                resume_function,
                resume_environment,
                handler_symbol,
                lowered.next_temporary,
                instructions + lowered.instructions
            )
        },
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            let value_type = if(index + 1 >= core::list_len(statements)) {
                expected
            } else {
                infer_expression_type(source, module, parameters, value)
            };
            let lowered = lower_runtime_clause_expression(
                source, module, parameters, handler_parameters, value,
                value_type, operation_result, resumption_name,
                resume_function, resume_environment, handler_symbol,
                next_temporary
            );
            if(index + 1 >= core::list_len(statements)) {
                LoweredExpression {
                    instructions: instructions + lowered.instructions,
                    value: lowered.value,
                    next_temporary: lowered.next_temporary,
                }
            } else {
                lower_runtime_clause_block(
                    source, module, parameters, handler_parameters, statements,
                    index + 1, expected, operation_result, resumption_name,
                    resume_function, resume_environment, handler_symbol,
                    lowered.next_temporary,
                    instructions + lowered.instructions
                )
            }
        }
    }
}

lower_runtime_clause_arguments(
    source: SourceFile,
    module: Module,
    locals: List<Parameter>,
    handler_parameters: List<Parameter>,
    arguments: List<Expression>,
    call_parameters: List<Parameter>,
    index: i64,
    operation_result: TypeRef,
    resumption_name: String,
    resume_function: String,
    resume_environment: String,
    handler_symbol: String,
    next_temporary: i64,
    instructions: String,
    values: String,
) -> LoweredArguments / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        LoweredArguments {
            instructions: instructions,
            values: values,
            next_temporary: next_temporary,
        }
    } else {
        let parameter_type = resolve_type(
            source, module,
            core::list_get(call_parameters, index).parameter_type
        );
        let lowered = lower_runtime_clause_expression(
            source, module, locals, handler_parameters,
            core::list_get(arguments, index), parameter_type,
            operation_result, resumption_name, resume_function,
            resume_environment, handler_symbol, next_temporary
        );
        let separator = if(index == 0) { "" } else { ", " };
        lower_runtime_clause_arguments(
            source, module, locals, handler_parameters, arguments,
            call_parameters, index + 1, operation_result, resumption_name,
            resume_function, resume_environment, handler_symbol,
            lowered.next_temporary, instructions + lowered.instructions,
            values + separator + type_name(parameter_type.kind) + " " +
                lowered.value
        )
    }
}

lower_runtime_clause_named_call(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    handler_parameters: List<Parameter>,
    name: String,
    arguments: List<Expression>,
    expected: TypeRef,
    span: SourceSpan,
    operation_result: TypeRef,
    resumption_name: String,
    resume_function: String,
    resume_environment: String,
    handler_symbol: String,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    handle perform ParameterLookupCase::lookup(
        lookup_parameter(parameters, name, 0)
    ) {
        ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) => {
            let parameter_type = resolve_type(
                source, module, parameter.parameter_type
            );
            handle perform TypeCase::inspect(parameter_type.kind) {
                TypeCase::inspect(SourceType::Callable(output, _)) => {
                    let function = "%t" + core::int_to_string(next_temporary);
                    let environment = "%t" +
                        core::int_to_string(next_temporary + 1);
                    let result = "%t" + core::int_to_string(next_temporary + 2);
                    LoweredExpression {
                        instructions:
                            "  " + function + " = extractvalue { ptr, ptr, ptr } " +
                                parameter.llvm_name + ", 0\n" +
                            "  " + environment +
                                " = extractvalue { ptr, ptr, ptr } " +
                                parameter.llvm_name + ", 1\n" +
                            "  " + result + " = call " + type_name(output.kind) +
                                " " + function + "(ptr " + environment + ")\n",
                        value: result,
                        next_temporary: next_temporary + 3,
                    }
                },
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC9001", "backend callable invariant violated",
                    span, "a non-callable parameter reached clause call lowering",
                    [], "semantic validation rejects non-callable invocations",
                    "report this compiler bug"
                )
            }
        },
        ParameterLookupCase::lookup(ParameterLookup::Missing) => {
            let callable = resolve_callable(source, module, name, span);
            let bindings = if(core::list_len(callable.type_parameters) > 0) {
                infer_call_bindings(
                    source, module, parameters, arguments, callable, expected, span
                )
            } else {
                []
            };
            let call_parameters = specialize_parameters(
                callable.parameters, bindings, 0, []
            );
            let suffix = if(core::list_len(callable.type_parameters) > 0) {
                specialization_suffix(callable.type_parameters, bindings, 0, "")
            } else {
                ""
            };
            let result_type = resolve_type(
                source, module,
                substitute_bindings(callable.result_type, bindings)
            );
            let lowered_arguments = lower_runtime_clause_arguments(
                source, module, parameters, handler_parameters, arguments,
                call_parameters, 0, operation_result, resumption_name,
                resume_function, resume_environment, handler_symbol,
                next_temporary, "", ""
            );
            let result = "%t" + core::int_to_string(
                lowered_arguments.next_temporary
            );
            LoweredExpression {
                instructions: lowered_arguments.instructions +
                    "  " + result + " = call " + type_name(result_type.kind) +
                    " @grandiose_" + name + suffix + "(" +
                    lowered_arguments.values + ")\n",
                value: result,
                next_temporary: lowered_arguments.next_temporary + 1,
            }
        }
    }
}

lower_runtime_clause_struct_fields(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    handler_parameters: List<Parameter>,
    declaration: StructDecl,
    struct_arguments: List<TypeRef>,
    struct_type: TypeRef,
    supplied: List<NamedExpression>,
    index: i64,
    operation_result: TypeRef,
    resumption_name: String,
    resume_function: String,
    resume_environment: String,
    handler_symbol: String,
    next_temporary: i64,
    instructions: String,
    aggregate: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(declaration.fields)) {
        LoweredExpression {
            instructions: instructions,
            value: aggregate,
            next_temporary: next_temporary,
        }
    } else {
        let field = core::list_get(declaration.fields, index);
        let field_type = resolve_type(
            source,
            module,
            substitute_type(
                field.field_type, declaration.type_parameters, struct_arguments
            )
        );
        handle perform NamedExpressionLookupCase::lookup(
            lookup_named_expression(supplied, field.name, 0)
        ) {
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Found(value)) => {
                let lowered = lower_runtime_clause_expression(
                    source, module, parameters, handler_parameters, value.value,
                    field_type, operation_result, resumption_name,
                    resume_function, resume_environment, handler_symbol,
                    next_temporary
                );
                let result = "%t" + core::int_to_string(
                    lowered.next_temporary
                );
                lower_runtime_clause_struct_fields(
                    source, module, parameters, handler_parameters, declaration,
                    struct_arguments, struct_type, supplied, index + 1,
                    operation_result, resumption_name, resume_function,
                    resume_environment, handler_symbol,
                    lowered.next_temporary + 1,
                    instructions + lowered.instructions +
                        "  " + result + " = insertvalue " +
                        type_name(struct_type.kind) + " " + aggregate + ", " +
                        type_name(field_type.kind) + " " + lowered.value + ", " +
                        core::int_to_string(index) + "\n",
                    result
                )
            },
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Missing) =>
                compiler_error(
                    source, "GRC9001", "backend invariant violated",
                    declaration.name_span,
                    "validated struct field is unavailable during clause lowering",
                    [], "semantic validation establishes complete construction",
                    "report this compiler bug"
                )
        }
    }
}

lower_runtime_clause_variant_payloads(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    handler_parameters: List<Parameter>,
    enum_type: TypeRef,
    arguments: List<Expression>,
    field_types: List<TypeRef>,
    index: i64,
    storage_offset: i64,
    operation_result: TypeRef,
    resumption_name: String,
    resume_function: String,
    resume_environment: String,
    handler_symbol: String,
    next_temporary: i64,
    instructions: String,
    aggregate: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        LoweredExpression {
            instructions: instructions,
            value: aggregate,
            next_temporary: next_temporary,
        }
    } else {
        let field_type = resolve_type(
            source, module, core::list_get(field_types, index)
        );
        let lowered = lower_runtime_clause_expression(
            source, module, parameters, handler_parameters,
            core::list_get(arguments, index), field_type, operation_result,
            resumption_name, resume_function, resume_environment,
            handler_symbol, next_temporary
        );
        let result = "%t" + core::int_to_string(lowered.next_temporary);
        lower_runtime_clause_variant_payloads(
            source, module, parameters, handler_parameters, enum_type,
            arguments, field_types, index + 1, storage_offset,
            operation_result, resumption_name, resume_function,
            resume_environment, handler_symbol,
            lowered.next_temporary + 1,
            instructions + lowered.instructions +
                "  " + result + " = insertvalue " +
                type_name(enum_type.kind) + " " + aggregate + ", " +
                type_name(field_type.kind) + " " + lowered.value + ", " +
                core::int_to_string(storage_offset + index) + "\n",
            result
        )
    }
}

lower_runtime_clause_expression(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    handler_parameters: List<Parameter>,
    expression: Expression,
    expected: TypeRef,
    operation_result: TypeRef,
    resumption_name: String,
    resume_function: String,
    resume_environment: String,
    handler_symbol: String,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let resolved_expected = resolve_type(source, module, expected);
    let effective_expected = handle perform TypeCase::inspect(resolved_expected.kind) {
        TypeCase::inspect(SourceType::Indirect(storage)) =>
            indirect_target(storage),
        TypeCase::inspect(_) => resolved_expected
    };
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Call("resume", arguments, span)) => {
            handle perform ExpressionCase::expression(core::list_get(arguments, 0)) {
                ExpressionCase::expression(Expression::Variable(name, _)) => require(
                    name == resumption_name,
                    error_diagnostic(
                        source,
                        "GRC1901",
                        "resumption does not belong to this handler",
                        span,
                        "this runtime continuation is bound as `" +
                            resumption_name + "`",
                        [],
                        "resumptions carry their delimited continuation identity",
                        "resume the continuation introduced by this clause"
                    )
                ),
                ExpressionCase::expression(_) => ()
            };
            let resumed_value = lower_runtime_clause_expression(
                source, module, parameters, handler_parameters,
                core::list_get(arguments, 1), operation_result,
                operation_result, resumption_name, resume_function,
                resume_environment, handler_symbol, next_temporary
            );
            let size_pointer = "%t" + core::int_to_string(
                resumed_value.next_temporary
            );
            let size = "%t" + core::int_to_string(
                resumed_value.next_temporary + 1
            );
            let box = "%t" + core::int_to_string(
                resumed_value.next_temporary + 2
            );
            let step = "%t" + core::int_to_string(
                resumed_value.next_temporary + 3
            );
            let result = "%t" + core::int_to_string(
                resumed_value.next_temporary + 4
            );
            LoweredExpression {
                instructions: resumed_value.instructions +
                    "  " + size_pointer + " = getelementptr " +
                        type_name(operation_result.kind) +
                        ", ptr null, i32 1\n" +
                    "  " + size + " = ptrtoint ptr " + size_pointer +
                        " to i64\n" +
                    "  " + box + " = call ptr @malloc(i64 " + size + ")\n" +
                    "  store " + type_name(operation_result.kind) + " " +
                        resumed_value.value + ", ptr " + box + "\n" +
                    "  " + step + " = call %grandiose.effect_step " +
                        resume_function + "(ptr " + resume_environment +
                        ", ptr " + box + ")\n" +
                    "  " + result + " = call " + type_name(effective_expected.kind) +
                        " " + handler_symbol +
                        "(%grandiose.effect_step " + step +
                        runtime_handler_parameter_values(
                            source, module, handler_parameters, 0, ""
                        ) + ")\n",
                value: result,
                next_temporary: resumed_value.next_temporary + 5,
            }
        },
        ExpressionCase::expression(Expression::Call("cancel", _, _)) =>
            LoweredExpression {
                instructions:
                    "  call void %t_cancel(ptr " + resume_environment + ")\n",
                value: "{}",
                next_temporary: next_temporary,
            },
        ExpressionCase::expression(Expression::Negate(operand, _)) => {
            let lowered = lower_runtime_clause_expression(
                source, module, parameters, handler_parameters, operand,
                effective_expected, operation_result, resumption_name, resume_function,
                resume_environment, handler_symbol, next_temporary
            );
            let result = "%t" + core::int_to_string(lowered.next_temporary);
            LoweredExpression {
                instructions: lowered.instructions +
                    "  " + result + " = sub " + type_name(effective_expected.kind) +
                    " 0, " + lowered.value + "\n",
                value: result,
                next_temporary: lowered.next_temporary + 1,
            }
        },
        ExpressionCase::expression(Expression::Binary(
            operator, left, right, span
        )) => {
            let operand_type = if(operator_is_comparison(operator)) {
                comparison_expression_operand_type(
                    source, module, parameters, operator, left, right, span
                )
            } else {
                expected
            };
            let lowered_left = lower_runtime_clause_expression(
                source, module, parameters, handler_parameters, left,
                operand_type, operation_result, resumption_name,
                resume_function, resume_environment, handler_symbol,
                next_temporary
            );
            let lowered_right = lower_runtime_clause_expression(
                source, module, parameters, handler_parameters, right,
                operand_type, operation_result, resumption_name,
                resume_function, resume_environment, handler_symbol,
                lowered_left.next_temporary
            );
            let result = "%t" + core::int_to_string(
                lowered_right.next_temporary
            );
            if(operator_is_comparison(operator)) {
                let success = "%t" +
                    core::int_to_string(lowered_right.next_temporary + 1);
                let failure = "%t" +
                    core::int_to_string(lowered_right.next_temporary + 2);
                let selected = "%t" +
                    core::int_to_string(lowered_right.next_temporary + 3);
                LoweredExpression {
                    instructions: lowered_left.instructions +
                        lowered_right.instructions +
                        "  " + result + " = icmp " +
                            comparison_instruction(operator) + " " +
                            type_name(operand_type.kind) + " " +
                            lowered_left.value + ", " + lowered_right.value + "\n" +
                        "  " + success + " = insertvalue " +
                            type_name(expected.kind) + " undef, i32 0, 0\n" +
                        "  " + failure + " = insertvalue " +
                            type_name(expected.kind) + " undef, i32 1, 0\n" +
                        "  " + selected + " = select i1 " + result + ", " +
                            type_name(expected.kind) + " " + success + ", " +
                            type_name(expected.kind) + " " + failure + "\n",
                    value: selected,
                    next_temporary: lowered_right.next_temporary + 4,
                }
            } else {
                LoweredExpression {
                    instructions: lowered_left.instructions +
                        lowered_right.instructions +
                        "  " + result + " = " + operator_instruction(operator) +
                            " " + type_name(expected.kind) + " " +
                            lowered_left.value + ", " + lowered_right.value + "\n",
                    value: result,
                    next_temporary: lowered_right.next_temporary + 1,
                }
            }
        },
        ExpressionCase::expression(Expression::Call(
            name, arguments, span
        )) => lower_runtime_clause_named_call(
            source, module, parameters, handler_parameters, name, arguments,
            expected, span, operation_result, resumption_name, resume_function,
            resume_environment, handler_symbol, next_temporary
        ),
        ExpressionCase::expression(Expression::StructValue(
            name, fields, span
        )) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Struct(_, struct_arguments)) => {
                    handle perform StructLookupCase::lookup(
                        lookup_struct(module.structs, name, 0)
                    ) {
                        StructLookupCase::lookup(StructLookup::Found(declaration)) =>
                            lower_runtime_clause_struct_fields(
                                source, module, parameters, handler_parameters,
                                declaration, struct_arguments, expected, fields, 0,
                                operation_result, resumption_name,
                                resume_function, resume_environment,
                                handler_symbol, next_temporary, "", "undef"
                            ),
                        StructLookupCase::lookup(StructLookup::Missing) =>
                            compiler_error(
                                source, "GRC9001", "backend invariant violated",
                                span,
                                "validated struct is unavailable during clause lowering",
                                [], "semantic and backend nominal environments agree",
                                "report this compiler bug"
                            )
                    }
                },
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC9001", "backend invariant violated", span,
                    "struct construction reached a non-struct clause context", [],
                    "semantic validation determines nominal expected types",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(Expression::Field(
            subject, field_name, span
        )) => {
            let subject_type = infer_expression_type(
                source, module, parameters, subject
            );
            handle perform TypeCase::inspect(subject_type.kind) {
                TypeCase::inspect(SourceType::Struct(struct_name, _)) => {
                    handle perform StructLookupCase::lookup(
                        lookup_struct(module.structs, struct_name, 0)
                    ) {
                        StructLookupCase::lookup(StructLookup::Found(declaration)) => {
                            let index = struct_field_index(
                                declaration.fields, field_name, 0
                            );
                            let lowered = lower_runtime_clause_expression(
                                source, module, parameters, handler_parameters,
                                subject, subject_type, operation_result,
                                resumption_name, resume_function,
                                resume_environment, handler_symbol, next_temporary
                            );
                            let result = "%t" + core::int_to_string(
                                lowered.next_temporary
                            );
                            LoweredExpression {
                                instructions: lowered.instructions +
                                    "  " + result + " = extractvalue " +
                                    type_name(subject_type.kind) + " " +
                                    lowered.value + ", " +
                                    core::int_to_string(index) + "\n",
                                value: result,
                                next_temporary: lowered.next_temporary + 1,
                            }
                        },
                        StructLookupCase::lookup(StructLookup::Missing) =>
                            compiler_error(
                                source, "GRC9001", "backend invariant violated",
                                span,
                                "projected struct is unavailable during clause lowering",
                                [], "semantic and backend nominal environments agree",
                                "report this compiler bug"
                            )
                    }
                },
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC9001", "backend invariant violated", span,
                    "non-struct projection reached clause lowering", [],
                    "semantic validation rejects scalar projection",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(Expression::EnumValue(
            enum_name, variant_name, arguments, span
        )) => {
            let enum_arguments = expected_enum_arguments(
                source, expected, enum_name, span
            );
            handle perform EnumLookupCase::lookup(
                lookup_enum(module.enums, enum_name, 0)
            ) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                    handle perform VariantLookupCase::lookup(
                        lookup_variant(declaration.variants, variant_name, 0)
                    ) {
                        VariantLookupCase::lookup(VariantLookup::Found(variant)) => {
                            let tag = variant_index(
                                declaration.variants, variant_name, 0
                            );
                            let offset = 1 + variant_payload_offset(
                                declaration.variants, tag, 0, 0
                            );
                            let tag_value = "%t" +
                                core::int_to_string(next_temporary);
                            lower_runtime_clause_variant_payloads(
                                source, module, parameters, handler_parameters,
                                expected, arguments,
                                substitute_types(
                                    variant.fields,
                                    declaration.type_parameters,
                                    enum_arguments,
                                    0,
                                    []
                                ),
                                0, offset, operation_result, resumption_name,
                                resume_function, resume_environment,
                                handler_symbol, next_temporary + 1,
                                "  " + tag_value + " = insertvalue " +
                                    type_name(expected.kind) + " undef, i32 " +
                                    core::int_to_string(tag) + ", 0\n",
                                tag_value
                            )
                        },
                        VariantLookupCase::lookup(VariantLookup::Missing) =>
                            compiler_error(
                                source, "GRC9001", "backend invariant violated",
                                span,
                                "validated variant is unavailable during clause lowering",
                                [], "semantic and backend nominal environments agree",
                                "report this compiler bug"
                            )
                    }
                },
                EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                    source, "GRC9001", "backend invariant violated", span,
                    "validated enum is unavailable during clause lowering", [],
                    "semantic and backend nominal environments agree",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            lower_runtime_clause_block(
                source, module, parameters, handler_parameters, statements, 0,
                expected, operation_result, resumption_name, resume_function,
                resume_environment, handler_symbol, next_temporary, ""
            ),
        ExpressionCase::expression(_) => lower_expression(
            source, module, parameters, expression, expected, next_temporary
        )
    }
}

lower_runtime_nested_pattern_fields(
    source: SourceFile,
    module: Module,
    patterns: List<Pattern>,
    field_types: List<TypeRef>,
    index: i64,
    subject_type: TypeRef,
    subject_value: String,
    storage_offset: i64,
    accumulated: String,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        LoweredExpression {
            instructions: instructions,
            value: accumulated,
            next_temporary: next_temporary,
        }
    } else {
        let field_type = resolve_type(
            source, module, core::list_get(field_types, index)
        );
        let extracted = "%t" + core::int_to_string(next_temporary);
        let frozen = "%t" + core::int_to_string(next_temporary + 1);
        let lowered = lower_runtime_nested_pattern_condition(
            source, module, core::list_get(patterns, index), field_type,
            frozen, accumulated, next_temporary + 2,
            instructions +
                "  " + extracted + " = extractvalue " +
                    type_name(subject_type.kind) + " " + subject_value + ", " +
                    core::int_to_string(storage_offset + index) + "\n" +
                "  " + frozen + " = freeze " + type_name(field_type.kind) +
                    " " + extracted + "\n"
        );
        lower_runtime_nested_pattern_fields(
            source, module, patterns, field_types, index + 1,
            subject_type, subject_value, storage_offset, lowered.value,
            lowered.next_temporary, lowered.instructions
        )
    }
}

plan_pattern_field_remainders(
    source: SourceFile,
    module: Module,
    patterns: List<Pattern>,
    field_types: List<TypeRef>,
    storage_offset: i64,
    index: i64,
    steps: List<OwnershipProjectionStep>,
    destroys: List<OwnershipDestroyProjection>,
) -> List<OwnershipDestroyProjection> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, PatternCase, Diagnostics
} {
    if(index < 0) {
        destroys
    } else {
        let field_type = resolve_type(
            source, module, core::list_get(field_types, index)
        );
        let with_field = plan_pattern_remainder(
            source,
            module,
            core::list_get(patterns, index),
            field_type,
            core::list_push(steps, OwnershipProjectionStep {
                storage_index: storage_offset + index,
                result_type: field_type,
            }),
            destroys
        );
        plan_pattern_field_remainders(
            source,
            module,
            patterns,
            field_types,
            storage_offset,
            index - 1,
            steps,
            with_field
        )
    }
}

plan_pattern_remainder(
    source: SourceFile,
    module: Module,
    pattern: Pattern,
    reference: TypeRef,
    steps: List<OwnershipProjectionStep>,
    destroys: List<OwnershipDestroyProjection>,
) -> List<OwnershipDestroyProjection> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, PatternCase, Diagnostics
} {
    let resolved = resolve_type(source, module, reference);
    handle perform PatternCase::inspect(pattern) {
        PatternCase::inspect(Pattern::Binding(_, _)) => destroys,
        PatternCase::inspect(Pattern::Variant(
            enum_name, variant_name, fields, span
        )) => {
            if(drop_is_present(source, module, resolved, 0)) {
                core::list_push(destroys, OwnershipDestroyProjection {
                    steps: steps,
                    value_type: resolved,
                    guard: OwnershipGuard::Always,
                })
            } else {
                handle perform TypeCase::inspect(resolved.kind) {
                    TypeCase::inspect(SourceType::Enum(name, arguments)) => {
                        let declaration = handle perform EnumLookupCase::lookup(
                            lookup_enum(module.enums, name, 0)
                        ) {
                            EnumLookupCase::lookup(
                                EnumLookup::Found(found)
                            ) => found,
                            EnumLookupCase::lookup(
                                EnumLookup::Missing
                            ) => compiler_error(
                                source, "GRC9001",
                                "pattern remainder enum disappeared", span,
                                "validated enum `" + enum_name +
                                    "` is unavailable during cleanup", [],
                                "pattern validation precedes ownership lowering",
                                "report this compiler bug"
                            )
                        };
                        let variant = handle perform VariantLookupCase::lookup(
                            lookup_variant(
                                declaration.variants, variant_name, 0
                            )
                        ) {
                            VariantLookupCase::lookup(
                                VariantLookup::Found(found)
                            ) => found,
                            VariantLookupCase::lookup(
                                VariantLookup::Missing
                            ) => compiler_error(
                                source, "GRC9001",
                                "pattern remainder variant disappeared", span,
                                "validated variant `" + variant_name +
                                    "` is unavailable during cleanup", [],
                                "pattern validation precedes ownership lowering",
                                "report this compiler bug"
                            )
                        };
                        plan_pattern_field_remainders(
                            source,
                            module,
                            fields,
                            substitute_types(
                                variant.fields,
                                declaration.type_parameters,
                                arguments,
                                0,
                                []
                            ),
                            1 + variant_payload_offset(
                                declaration.variants,
                                variant_index(
                                    declaration.variants, variant_name, 0
                                ),
                                0,
                                0
                            ),
                            core::list_len(fields) - 1,
                            steps,
                            destroys
                        )
                    },
                    TypeCase::inspect(_) => compiler_error(
                        source, "GRC9001",
                        "pattern remainder needs an enum", span,
                        "a variant cleanup reached `" +
                            type_name(resolved.kind) + "`", [],
                        "pattern validation preserves nominal types",
                        "report this compiler bug"
                    )
                }
            }
        },
        PatternCase::inspect(_) => if(type_needs_drop_glue(
            source, module, resolved, []
        )) {
            core::list_push(destroys, OwnershipDestroyProjection {
                steps: steps,
                value_type: resolved,
                guard: OwnershipGuard::Always,
            })
        } else {
            destroys
        }
    }
}

lower_ownership_projection(
    steps: List<OwnershipProjectionStep>,
    index: i64,
    current_type: TypeRef,
    current_value: String,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {ResultCase, TypeCase} {
    if(index >= core::list_len(steps)) {
        LoweredExpression {
            instructions: instructions,
            value: current_value,
            next_temporary: next_temporary,
        }
    } else {
        let step = core::list_get(steps, index);
        let extracted = "%t" + core::int_to_string(next_temporary);
        lower_ownership_projection(
            steps,
            index + 1,
            step.result_type,
            extracted,
            next_temporary + 1,
            instructions + "  " + extracted + " = extractvalue " +
                type_name(current_type.kind) + " " + current_value + ", " +
                core::int_to_string(step.storage_index) + "\n"
        )
    }
}

lower_ownership_state_releases(
    releases: List<OwnershipReleaseState>,
    index: i64,
    instructions: String,
) -> String / {ResultCase} {
    if(index >= core::list_len(releases)) {
        instructions
    } else {
        lower_ownership_state_releases(
            releases,
            index + 1,
            instructions +
                "  call void @grandiose_release_drop_state(ptr " +
                core::list_get(releases, index).state + ")\n"
        )
    }
}

lower_ownership_plan(
    source: SourceFile,
    module: Module,
    plan: OwnershipPlan,
    index: i64,
    root_type: TypeRef,
    root_value: String,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(plan.destroys)) {
        LoweredExpression {
            instructions: lower_ownership_state_releases(
                plan.releases, 0, instructions
            ),
            value: "{}",
            next_temporary: next_temporary,
        }
    } else {
        let action = core::list_get(plan.destroys, index);
        let projected = lower_ownership_projection(
            action.steps, 0, root_type, root_value,
            next_temporary, ""
        );
        let destroyed = handle perform OwnershipGuardCase::inspect(
            action.guard
        ) {
            OwnershipGuardCase::inspect(OwnershipGuard::Always) =>
                lower_destroy_value(
                    source, module, action.value_type, projected.value,
                    projected.next_temporary
                ),
            OwnershipGuardCase::inspect(OwnershipGuard::DropState(state)) =>
                lower_destroy_value_if_active(
                    source, module, action.value_type, projected.value,
                    state, projected.next_temporary
                )
        };
        lower_ownership_plan(
            source,
            module,
            plan,
            index + 1,
            root_type,
            root_value,
            destroyed.next_temporary,
            instructions + projected.instructions + destroyed.instructions
        )
    }
}

ownership_root_destroy_plan(
    reference: TypeRef,
    drop_state: String,
) -> OwnershipPlan / {ResultCase} {
    OwnershipPlan {
        destroys: [OwnershipDestroyProjection {
            steps: [],
            value_type: reference,
            guard: if(drop_state == "") {
                OwnershipGuard::Always
            } else {
                OwnershipGuard::DropState(drop_state)
            },
        }],
        releases: [],
    }
}

lower_pattern_remainder(
    source: SourceFile,
    module: Module,
    pattern: Pattern,
    reference: TypeRef,
    value: String,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, PatternCase, Diagnostics
} {
    let resolved = resolve_type(source, module, reference);
    lower_ownership_plan(
        source,
        module,
        OwnershipPlan {
            destroys: plan_pattern_remainder(
                source, module, pattern, resolved, [], []
            ),
            releases: [],
        },
        0,
        resolved,
        value,
        next_temporary,
        ""
    )
}

lower_unbound_payload_values(
    source: SourceFile,
    module: Module,
    patterns: List<Pattern>,
    operation_parameters: List<Parameter>,
    index: i64,
    payload_type: String,
    payload_value: String,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        LoweredExpression {
            instructions: instructions,
            value: "{}",
            next_temporary: next_temporary,
        }
    } else {
        let pattern = core::list_get(patterns, index);
        let bound = handle perform PatternCase::inspect(pattern) {
            PatternCase::inspect(Pattern::Binding(_, _)) => true,
            PatternCase::inspect(_) => false
        };
        let parameter_type = resolve_type(
            source, module,
            core::list_get(operation_parameters, index).parameter_type
        );
        if(bound or type_needs_drop_glue(
            source, module, parameter_type, []
        ) == false) {
            lower_unbound_payload_values(
                source, module, patterns, operation_parameters, index + 1,
                payload_type, payload_value, next_temporary, instructions
            )
        } else {
            let extracted = "%t" + core::int_to_string(next_temporary);
            let destroyed = lower_pattern_remainder(
                source, module, pattern, parameter_type, extracted,
                next_temporary + 1
            );
            lower_unbound_payload_values(
                source, module, patterns, operation_parameters, index + 1,
                payload_type, payload_value, destroyed.next_temporary,
                instructions + "  " + extracted + " = extractvalue " +
                    payload_type + " " + payload_value + ", " +
                    core::int_to_string(index) + "\n" +
                    destroyed.instructions
            )
        }
    }
}

lower_runtime_nested_pattern_condition(
    source: SourceFile,
    module: Module,
    pattern: Pattern,
    pattern_type: TypeRef,
    subject_value: String,
    accumulated: String,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, Diagnostics
} {
    handle perform PatternCase::inspect(pattern) {
        PatternCase::inspect(Pattern::Binding(_, _)) => LoweredExpression {
            instructions: instructions,
            value: accumulated,
            next_temporary: next_temporary,
        },
        PatternCase::inspect(Pattern::Wildcard(_)) => LoweredExpression {
            instructions: instructions,
            value: accumulated,
            next_temporary: next_temporary,
        },
        PatternCase::inspect(Pattern::Unit(_)) => LoweredExpression {
            instructions: instructions,
            value: accumulated,
            next_temporary: next_temporary,
        },
        PatternCase::inspect(Pattern::Integer(value, span)) => {
            require(
                pattern_type.kind == SourceType::I32 or
                    pattern_type.kind == SourceType::I64,
                error_diagnostic(
                    source, "GRC9001", "nested pattern invariant violated",
                    span, "this nested pattern does not inspect an integer", [],
                    "pattern validation preserves each projected payload type",
                    "report this compiler bug"
                )
            );
            let matches = "%t" + core::int_to_string(next_temporary);
            let combined = "%t" + core::int_to_string(next_temporary + 1);
            let needs_combine = accumulated != "true";
            LoweredExpression {
                instructions: instructions +
                    "  " + matches + " = icmp eq " +
                        type_name(pattern_type.kind) + " " + subject_value +
                        ", " + core::int_to_string(value) + "\n" +
                    (if(needs_combine) {
                        "  " + combined + " = and i1 " + accumulated +
                            ", " + matches + "\n"
                    } else {
                        ""
                    }),
                value: if(needs_combine) { combined } else { matches },
                next_temporary: next_temporary +
                    (if(needs_combine) { 2 } else { 1 }),
            }
        },
        PatternCase::inspect(Pattern::String(_, span)) => {
            require(
                pattern_type.kind == SourceType::String,
                error_diagnostic(
                    source, "GRC9001", "nested pattern invariant violated",
                    span, "this nested string pattern has a non-string payload", [],
                    "pattern validation preserves projected payload types",
                    "report this compiler bug"
                )
            );
            let compared = "%t" + core::int_to_string(next_temporary);
            let matches = "%t" + core::int_to_string(next_temporary + 1);
            let combined = "%t" + core::int_to_string(next_temporary + 2);
            let needs_combine = accumulated != "true";
            LoweredExpression {
                instructions: instructions +
                    "  " + compared + " = call i32 @strcmp(ptr " + subject_value +
                        ", ptr @grandiose_string_" + core::int_to_string(span.start) +
                        ")\n" +
                    "  " + matches + " = icmp eq i32 " + compared + ", 0\n" +
                    (if(needs_combine) {
                        "  " + combined + " = and i1 " + accumulated + ", " +
                            matches + "\n"
                    } else { "" }),
                value: if(needs_combine) { combined } else { matches },
                next_temporary: next_temporary +
                    (if(needs_combine) { 3 } else { 2 }),
            }
        },
        PatternCase::inspect(Pattern::Variant(
            enum_name, variant_name, fields, span
        )) => {
            handle perform TypeCase::inspect(pattern_type.kind) {
                TypeCase::inspect(SourceType::Enum(
                    resolved_name, enum_arguments
                )) => {
                    require(
                        resolved_name == enum_name,
                        error_diagnostic(
                            source, "GRC9001", "nested pattern invariant violated",
                            span, "validated nested enum changed identity", [],
                            "semantic and backend nominal identities agree",
                            "report this compiler bug"
                        )
                    );
                    let declaration = handle perform EnumLookupCase::lookup(
                        lookup_enum(module.enums, enum_name, 0)
                    ) {
                        EnumLookupCase::lookup(EnumLookup::Found(found)) => found,
                        EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                            source, "GRC9001", "nested enum invariant violated",
                            span, "validated nested enum is unavailable", [],
                            "semantic and backend nominal environments agree",
                            "report this compiler bug"
                        )
                    };
                    let variant = handle perform VariantLookupCase::lookup(
                        lookup_variant(declaration.variants, variant_name, 0)
                    ) {
                        VariantLookupCase::lookup(VariantLookup::Found(found)) => found,
                        VariantLookupCase::lookup(VariantLookup::Missing) =>
                            compiler_error(
                                source, "GRC9001",
                                "nested variant invariant violated", span,
                                "validated nested variant is unavailable", [],
                                "semantic and backend nominal environments agree",
                                "report this compiler bug"
                            )
                    };
                    let tag = "%t" + core::int_to_string(next_temporary);
                    let matches = "%t" +
                        core::int_to_string(next_temporary + 1);
                    let combined = "%t" +
                        core::int_to_string(next_temporary + 2);
                    let needs_combine = accumulated != "true";
                    let result = if(needs_combine) { combined } else { matches };
                    let after_tag = next_temporary +
                        (if(needs_combine) { 3 } else { 2 });
                    lower_runtime_nested_pattern_fields(
                        source, module, fields,
                        substitute_types(
                            variant.fields, declaration.type_parameters,
                            enum_arguments, 0, []
                        ),
                        0, pattern_type, subject_value,
                        1 + variant_payload_offset(
                            declaration.variants,
                            variant_index(
                                declaration.variants, variant_name, 0
                            ),
                            0, 0
                        ),
                        result, after_tag,
                        instructions +
                            "  " + tag + " = extractvalue " +
                                type_name(pattern_type.kind) + " " +
                                subject_value + ", 0\n" +
                            "  " + matches + " = icmp eq i32 " + tag + ", " +
                                core::int_to_string(variant_index(
                                    declaration.variants, variant_name, 0
                                )) + "\n" +
                            (if(needs_combine) {
                                "  " + combined + " = and i1 " + accumulated +
                                    ", " + matches + "\n"
                            } else {
                                ""
                            })
                    )
                },
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC9001", "nested pattern invariant violated",
                    span, "nested enum pattern reached a non-enum payload", [],
                    "semantic pattern validation precedes lowering",
                    "report this compiler bug"
                )
            }
        }
    }
}

lower_runtime_pattern_conditions(
    source: SourceFile,
    module: Module,
    patterns: List<Pattern>,
    operation_parameters: List<Parameter>,
    index: i64,
    payload_type: String,
    payload_value: String,
    accumulated: String,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, Diagnostics
} {
    if(index >= core::list_len(patterns)) {
        LoweredExpression {
            instructions: instructions,
            value: accumulated,
            next_temporary: next_temporary,
        }
    } else {
        let pattern = core::list_get(patterns, index);
        handle perform PatternCase::inspect(pattern) {
            PatternCase::inspect(Pattern::Binding(_, _)) =>
                lower_runtime_pattern_conditions(
                    source, module, patterns, operation_parameters, index + 1,
                    payload_type, payload_value, accumulated, next_temporary,
                    instructions
                ),
            PatternCase::inspect(Pattern::Wildcard(_)) =>
                lower_runtime_pattern_conditions(
                    source, module, patterns, operation_parameters, index + 1,
                    payload_type, payload_value, accumulated, next_temporary,
                    instructions
                ),
            PatternCase::inspect(Pattern::Unit(_)) =>
                lower_runtime_pattern_conditions(
                    source, module, patterns, operation_parameters, index + 1,
                    payload_type, payload_value, accumulated, next_temporary,
                    instructions
                ),
            PatternCase::inspect(Pattern::Integer(value, span)) => {
                let parameter_type = resolve_type(
                    source, module,
                    core::list_get(operation_parameters, index).parameter_type
                );
                let field = "%t" + core::int_to_string(next_temporary);
                let matches = "%t" + core::int_to_string(next_temporary + 1);
                let combined = "%t" + core::int_to_string(next_temporary + 2);
                let needs_combine = accumulated != "true";
                let combined_instructions = if(needs_combine) {
                    "  " + combined + " = and i1 " + accumulated + ", " +
                        matches + "\n"
                } else {
                    ""
                };
                let result = if(needs_combine) { combined } else { matches };
                let next = if(needs_combine) {
                    next_temporary + 3
                } else {
                    next_temporary + 2
                };
                require(
                    parameter_type.kind == SourceType::I32 or
                        parameter_type.kind == SourceType::I64,
                    error_diagnostic(
                        source, "GRC9001", "runtime pattern invariant violated",
                        span, "this integer pattern does not inspect an integer payload",
                        [], "validated integer patterns compare typed scalar arguments",
                        "report this compiler bug"
                    )
                );
                lower_runtime_pattern_conditions(
                    source, module, patterns, operation_parameters, index + 1,
                    payload_type, payload_value, result, next,
                    instructions +
                        "  " + field + " = extractvalue " + payload_type + " " +
                            payload_value + ", " + core::int_to_string(index) + "\n" +
                        "  " + matches + " = icmp eq " +
                            type_name(parameter_type.kind) + " " + field + ", " +
                            core::int_to_string(value) + "\n" +
                        combined_instructions
                )
            },
            PatternCase::inspect(Pattern::String(_, span)) => {
                let parameter_type = resolve_type(
                    source, module,
                    core::list_get(operation_parameters, index).parameter_type
                );
                require(
                    parameter_type.kind == SourceType::String,
                    error_diagnostic(
                        source, "GRC9001", "runtime pattern invariant violated",
                        span, "this string pattern has a non-string payload", [],
                        "validated string patterns compare string operation arguments",
                        "report this compiler bug"
                    )
                );
                let field = "%t" + core::int_to_string(next_temporary);
                let compared = "%t" + core::int_to_string(next_temporary + 1);
                let matches = "%t" + core::int_to_string(next_temporary + 2);
                let combined = "%t" + core::int_to_string(next_temporary + 3);
                let needs_combine = accumulated != "true";
                let result = if(needs_combine) { combined } else { matches };
                let next = next_temporary + (if(needs_combine) { 4 } else { 3 });
                lower_runtime_pattern_conditions(
                    source, module, patterns, operation_parameters, index + 1,
                    payload_type, payload_value, result, next,
                    instructions +
                        "  " + field + " = extractvalue " + payload_type + " " +
                            payload_value + ", " + core::int_to_string(index) + "\n" +
                        "  " + compared + " = call i32 @strcmp(ptr " + field +
                            ", ptr @grandiose_string_" +
                            core::int_to_string(span.start) + ")\n" +
                        "  " + matches + " = icmp eq i32 " + compared + ", 0\n" +
                        (if(needs_combine) {
                            "  " + combined + " = and i1 " + accumulated +
                                ", " + matches + "\n"
                        } else { "" })
                )
            },
            PatternCase::inspect(Pattern::Variant(
                enum_name, variant_name, fields, span
            )) => {
                let parameter_type = resolve_type(
                    source, module,
                    core::list_get(operation_parameters, index).parameter_type
                );
                handle perform TypeCase::inspect(parameter_type.kind) {
                    TypeCase::inspect(SourceType::Enum(
                        resolved_name, enum_arguments
                    )) => {
                        require(
                            resolved_name == enum_name,
                            error_diagnostic(
                                source, "GRC9001", "nominal pattern invariant violated",
                                span, "validated enum pattern changed identity", [],
                                "pattern checking and lowering share nominal identities",
                                "report this compiler bug"
                            )
                        );
                        handle perform EnumLookupCase::lookup(
                            lookup_enum(module.enums, enum_name, 0)
                        ) {
                            EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                                handle perform VariantLookupCase::lookup(
                                    lookup_variant(
                                        declaration.variants, variant_name, 0
                                    )
                                ) {
                                    VariantLookupCase::lookup(
                                        VariantLookup::Found(variant)
                                    ) => {
                                        let variant_tag = variant_index(
                                            declaration.variants, variant_name, 0
                                        );
                                        let subject = "%t" +
                                            core::int_to_string(next_temporary);
                                        let tag = "%t" +
                                            core::int_to_string(next_temporary + 1);
                                        let matches = "%t" +
                                            core::int_to_string(next_temporary + 2);
                                        let combined = "%t" +
                                            core::int_to_string(next_temporary + 3);
                                        let needs_combine = accumulated != "true";
                                        let combined_instructions = if(needs_combine) {
                                            "  " + combined + " = and i1 " +
                                                accumulated + ", " + matches + "\n"
                                        } else {
                                            ""
                                        };
                                        let result = if(needs_combine) {
                                            combined
                                        } else {
                                            matches
                                        };
                                        let next = if(needs_combine) {
                                            next_temporary + 4
                                        } else {
                                            next_temporary + 3
                                        };
                                        let nested =
                                            lower_runtime_nested_pattern_fields(
                                                source, module, fields,
                                                substitute_types(
                                                    variant.fields,
                                                    declaration.type_parameters,
                                                    enum_arguments, 0, []
                                                ),
                                                0, parameter_type, subject,
                                                1 + variant_payload_offset(
                                                    declaration.variants,
                                                    variant_tag, 0, 0
                                                ),
                                                result, next,
                                                instructions +
                                                "  " + subject + " = extractvalue " +
                                                    payload_type + " " +
                                                    payload_value + ", " +
                                                    core::int_to_string(index) + "\n" +
                                                "  " + tag + " = extractvalue " +
                                                    type_name(parameter_type.kind) +
                                                    " " + subject + ", 0\n" +
                                                "  " + matches + " = icmp eq i32 " +
                                                    tag + ", " +
                                                    core::int_to_string(variant_tag) +
                                                    "\n" + combined_instructions
                                            );
                                        lower_runtime_pattern_conditions(
                                            source, module, patterns,
                                            operation_parameters, index + 1,
                                            payload_type, payload_value,
                                            nested.value,
                                            nested.next_temporary,
                                            nested.instructions
                                        )
                                    },
                                    VariantLookupCase::lookup(
                                        VariantLookup::Missing
                                    ) => compiler_error(
                                        source, "GRC9001",
                                        "variant pattern invariant violated", span,
                                        "validated variant is unavailable", [],
                                        "semantic and backend nominal environments agree",
                                        "report this compiler bug"
                                    )
                                }
                            },
                            EnumLookupCase::lookup(EnumLookup::Missing) =>
                                compiler_error(
                                    source, "GRC9001",
                                    "enum pattern invariant violated", span,
                                    "validated enum is unavailable", [],
                                    "semantic and backend nominal environments agree",
                                    "report this compiler bug"
                                )
                        }
                    },
                    TypeCase::inspect(_) => compiler_error(
                        source, "GRC9001", "nominal pattern invariant violated",
                        span, "enum pattern reached a non-enum payload", [],
                        "semantic pattern validation precedes lowering",
                        "report this compiler bug"
                    )
                }
            }
        }
    }
}

lower_runtime_handler_clauses(
    source: SourceFile,
    module: Module,
    outer_parameters: List<Parameter>,
    clauses: List<HandlerClause>,
    index: i64,
    resolved: ResolvedEffectOperation,
    payload_type: String,
    expected: TypeRef,
    handler_symbol: String,
    next_temporary: i64,
) -> LoweredRuntimeClauses / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        LoweredRuntimeClauses {
            definitions: "",
            instructions: "  unreachable\n",
            next_temporary: next_temporary,
        }
    } else {
        let clause = core::list_get(clauses, index);
        let condition = lower_runtime_pattern_conditions(
            source, module, clause.patterns, resolved.parameters, 0,
            payload_type, "%t11", "true", next_temporary, ""
        );
        let bindings = lower_runtime_payload_patterns(
            source, module, outer_parameters, clause.patterns,
            resolved.parameters, 0, payload_type, "%t11", "",
            outer_parameters
        );
        let unbound_cleanup = lower_unbound_payload_values(
            source,
            module,
            clause.patterns,
            resolved.parameters,
            0,
            payload_type,
            "%t11",
            condition.next_temporary,
            ""
        );
        let operation_result = resolve_type(
            source, module, resolved.operation.result_type
        );
        let lowered_clause = lower_runtime_clause_expression(
            source, module, bindings.parameters, outer_parameters, clause.body,
            expected, operation_result, clause.resumption_name, "%t8", "%t9",
            handler_symbol, unbound_cleanup.next_temporary
        );
        let payload_owners = parameters_with_drop_flags_after(
            bindings.parameters,
            core::list_len(outer_parameters),
            0,
            []
        );
        let cleanup = lower_parameter_cleanups(
            source,
            module,
            payload_owners,
            core::list_len(payload_owners) - 1,
            lowered_clause.next_temporary,
            ""
        );
        let resumption_parameters = core::list_push(
            bindings.parameters,
            Parameter {
                name: clause.resumption_name,
                span: clause.resumption_span,
                parameter_type: TypeRef {
                    kind: SourceType::Resumption(operation_result, expected),
                    span: clause.resumption_span,
                },
                is_local: true,
                drop_flag: "",
                llvm_name: "",
            }
        );
        let nested = lower_closure_definitions_expression(
            source, module, resumption_parameters, clause.body, expected, ""
        );
        let clause_label = "runtime_clause_" +
            core::int_to_string(clause.span.start);
        let next_label = "runtime_clause_next_" +
            core::int_to_string(clause.span.start);
        let irrefutable = patterns_are_irrefutable(clause.patterns, 0);
        let branch = if(irrefutable) {
            "  br label %" + clause_label + "\n"
        } else {
            "  br i1 " + condition.value + ", label %" + clause_label +
                ", label %" + next_label + "\n"
        };
        if(irrefutable) {
            LoweredRuntimeClauses {
                definitions: nested,
                instructions: condition.instructions + branch + clause_label +
                    ":\n" + bindings.instructions +
                    unbound_cleanup.instructions +
                    lowered_clause.instructions + cleanup.instructions + "  ret " +
                    type_name(expected.kind) + " " + lowered_clause.value + "\n",
                next_temporary: cleanup.next_temporary,
            }
        } else {
            let remaining = lower_runtime_handler_clauses(
                source, module, outer_parameters, clauses, index + 1,
                resolved, payload_type, expected, handler_symbol,
                cleanup.next_temporary
            );
            LoweredRuntimeClauses {
                definitions: nested + remaining.definitions,
                instructions: condition.instructions + branch + clause_label +
                    ":\n" + bindings.instructions +
                    unbound_cleanup.instructions +
                    lowered_clause.instructions + cleanup.instructions + "  ret " +
                    type_name(expected.kind) + " " + lowered_clause.value +
                    "\n" + next_label + ":\n" + remaining.instructions,
                next_temporary: remaining.next_temporary,
            }
        }
    }
}

lower_runtime_handler_definition(
    source: SourceFile,
    module: Module,
    outer_parameters: List<Parameter>,
    call_span: SourceSpan,
    clauses: List<HandlerClause>,
    expected: TypeRef,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let parameters = runtime_value_parameters(
        source, module, outer_parameters, 0, []
    );
    let clause = core::list_get(clauses, 0);
    let resolved = resolve_handler_operation_declaration(
        source, module, clause.effect_name, clause.operation_name, clause.span
    );
    let resolved_expected = resolve_type(source, module, expected);
    let symbol = runtime_handler_symbol(call_span, resolved_expected);
    let payload_type = closure_environment_type(
        source, module, resolved.parameters, 0, ""
    );
    let lowered_clauses = lower_runtime_handler_clauses(
        source, module, parameters, clauses, 0, resolved, payload_type,
        resolved_expected, symbol, 12
    );
    let effect_id = effect_declaration_index(
        module.effects, clause.effect_name, 0
    );
    let operation_id = effect_operation_index(
        resolved.effect.operations, clause.operation_name, 0
    );
    let payload_loads = if(core::list_len(resolved.parameters) == 0) {
        ""
    } else {
        "  %t10 = extractvalue %grandiose.effect_step %step, 3\n" +
        "  %t11 = load " + payload_type + ", ptr %t10\n" +
        "  call void @free(ptr %t10)\n"
    };
    let handler_parameter_signature = if(core::list_len(parameters) == 0) {
        ""
    } else {
        ", " + lower_parameters(source, module, parameters, 0, "")
    };
    lowered_clauses.definitions +
    "define " + type_name(resolved_expected.kind) + " " + symbol +
        "(%grandiose.effect_step %step" +
        handler_parameter_signature + ") {\n" +
    "entry:\n" +
    "  %t0 = extractvalue %grandiose.effect_step %step, 0\n" +
    "  br i1 %t0, label %done, label %request\n" +
    "done:\n" +
    "  %t1 = extractvalue %grandiose.effect_step %step, 6\n" +
    "  %t2 = load " + type_name(resolved_expected.kind) + ", ptr %t1\n" +
    "  call void @free(ptr %t1)\n" +
    "  ret " + type_name(resolved_expected.kind) + " %t2\n" +
    "request:\n" +
    "  %t3 = extractvalue %grandiose.effect_step %step, 1\n" +
    "  %t4 = extractvalue %grandiose.effect_step %step, 2\n" +
    "  %t5 = icmp eq i64 %t3, " + core::int_to_string(effect_id) + "\n" +
    "  %t6 = icmp eq i64 %t4, " + core::int_to_string(operation_id) + "\n" +
    "  %t7 = and i1 %t5, %t6\n" +
    "  br i1 %t7, label %matched, label %unmatched\n" +
    "unmatched:\n" +
    "  unreachable\n" +
    "matched:\n" +
    "  %t8 = extractvalue %grandiose.effect_step %step, 4\n" +
    "  %t9 = extractvalue %grandiose.effect_step %step, 5\n" +
    "  %t_cancel = extractvalue %grandiose.effect_step %step, 8\n" +
    payload_loads + lowered_clauses.instructions +
    "}\n\n"
}

lower_runtime_call_handler_v2(
    source: SourceFile,
    module: Module,
    outer_parameters: List<Parameter>,
    name: String,
    arguments: List<Expression>,
    call_span: SourceSpan,
    expected: TypeRef,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let resolved_expected = resolve_type(source, module, expected);
    let parameters = runtime_value_parameters(
        source, module, outer_parameters, 0, []
    );
    let initial = lower_effectful_named_call(
        source, module, parameters, name, arguments, resolved_expected, call_span,
        next_temporary
    );
    let result = "%t" + core::int_to_string(initial.next_temporary);
    LoweredExpression {
        instructions: initial.instructions +
            "  " + result + " = call " + type_name(resolved_expected.kind) + " " +
            runtime_handler_symbol(call_span, resolved_expected) +
            "(%grandiose.effect_step " + initial.value +
            runtime_handler_parameter_values(
                source, module, parameters, 0, ""
            ) + ")\n",
        value: result,
        next_temporary: initial.next_temporary + 1,
    }
}

plan_resumptive_handler_control(
    computation: Expression,
    clauses: List<HandlerClause>,
) -> ResumptiveHandlerControlPlan / {
    ResultCase, ExpressionCase, BlockStatementCase
} {
    handle perform ExpressionCase::expression(computation) {
        ExpressionCase::expression(Expression::Block(statements, span)) => {
            if(handler_clauses_capture_resumption(clauses, 0) or
                handler_clauses_are_irrefutable(clauses, 0) == false) {
                ResumptiveHandlerControlPlan::RuntimeStep(span)
            } else {
                ResumptiveHandlerControlPlan::StaticBlock(statements, span)
            }
        },
        ExpressionCase::expression(Expression::Call(
            name, arguments, span
        )) => ResumptiveHandlerControlPlan::RuntimeCall(
            name, arguments, span
        ),
        ExpressionCase::expression(_) =>
            ResumptiveHandlerControlPlan::RuntimeStep(
                expression_span(computation)
            )
    }
}

lower_resumptive_handler(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    computation: Expression,
    clauses: List<HandlerClause>,
    expected: TypeRef,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    let first = core::list_get(clauses, 0);
    handle perform ResumptiveHandlerControlPlanCase::inspect(
        plan_resumptive_handler_control(computation, clauses)
    ) {
        ResumptiveHandlerControlPlanCase::inspect(
            ResumptiveHandlerControlPlan::StaticBlock(statements, _)
        ) => lower_static_handler_block(
            source, module, parameters, statements, 0, clauses,
            first.effect_name, first.operation_name, expected,
            next_temporary, ""
        ),
        ResumptiveHandlerControlPlanCase::inspect(
            ResumptiveHandlerControlPlan::RuntimeCall(
                name, arguments, span
            )
        ) => lower_runtime_call_handler_v2(
            source, module, parameters, name, arguments, span,
            expected, next_temporary
        ),
        ResumptiveHandlerControlPlanCase::inspect(
            ResumptiveHandlerControlPlan::RuntimeStep(span)
        ) => {
            let handler_callable = CallableDecl {
                name: "handler_" + core::int_to_string(span.start),
                name_span: span,
                type_parameters: [],
                callable_constraints: [],
                use_constraints: [],
                environment_constraints: [],
                runs_in_constraints: [],
                parameters: parameters,
                result_type: expected,
                effects: [],
                body: computation,
                span: span,
            };
            lower_completed_effect_step_value(
                expected,
                lower_effectful_forwarding_handler_step(
                    source, module, handler_callable, parameters,
                    lower_step_expression(
                        source, module, handler_callable, parameters,
                        computation, expected, next_temporary
                    ),
                    span, clauses
                )
            )
        }
    }
}

lower_terminal_handler(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    computation: Expression,
    clauses: List<HandlerClause>,
    expected: TypeRef,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    handle perform ExpressionCase::expression(computation) {
        ExpressionCase::expression(Expression::Perform(
            effect_name,
            operation_name,
            arguments,
            span
        )) => {
            let resolved = resolve_perform_operation(
                source,
                module,
                parameters,
                effect_name,
                operation_name,
                arguments,
                span
            );
            let subject_type = resolve_type(
                source,
                module,
                core::list_get(resolved.parameters, 0).parameter_type
            );
            let subject = lower_expression(
                source,
                module,
                parameters,
                core::list_get(arguments, 0),
                subject_type,
                next_temporary
            );
            handle perform TypeCase::inspect(subject_type.kind) {
                TypeCase::inspect(SourceType::Enum(enum_name, enum_arguments)) => {
                    handle perform EnumLookupCase::lookup(
                        lookup_enum(module.enums, enum_name, 0)
                    ) {
                        EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                            let tag = "%t" + core::int_to_string(subject.next_temporary);
                            let handler_id = subject.next_temporary;
                            let lowered = lower_handler_variants(
                                source,
                                module,
                                parameters,
                                declaration,
                                enum_arguments,
                                clauses,
                                0,
                                subject_type,
                                subject.value,
                                expected,
                                handler_id,
                                subject.next_temporary + 1,
                                "",
                                "",
                                ""
                            );
                            let result = "%t" +
                                core::int_to_string(lowered.next_temporary);
                            LoweredExpression {
                                instructions: subject.instructions + "  " + tag +
                                    " = extractvalue " + type_name(subject_type.kind) +
                                    " " + subject.value + ", 0\n" +
                                    "  switch i32 " + tag + ", label %handler_" +
                                    core::int_to_string(handler_id) + "_invalid [\n" +
                                    lowered.switch_cases + "  ]\n" +
                                    lowered.instructions + "handler_" +
                                    core::int_to_string(handler_id) + "_invalid:\n" +
                                    "  unreachable\nhandler_" +
                                    core::int_to_string(handler_id) + "_merge:\n" +
                                    "  " + result + " = phi " +
                                    type_name(expected.kind) + " " + lowered.incoming + "\n",
                                value: result,
                                next_temporary: lowered.next_temporary + 1,
                            }
                        },
                        EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                            source, "GRC9001", "missing enum during handler lowering", span,
                            "resolved enum `" + enum_name + "` has no declaration", [],
                            "semantic and backend nominal environments must agree",
                            "report this compiler bug"
                        )
                    }
                },
                TypeCase::inspect(_) => {
                    let handler_id = subject.next_temporary;
                    let lowered = lower_scalar_handler_clauses(
                        source, module, parameters, clauses, 0,
                        subject_type, subject.value, expected, handler_id,
                        subject.next_temporary, "", ""
                    );
                    let result = "%t" +
                        core::int_to_string(lowered.next_temporary);
                    LoweredExpression {
                        instructions: subject.instructions +
                            "  br label %handler_" +
                            core::int_to_string(handler_id) + "_scalar_test_0\n" +
                            lowered.instructions + "handler_" +
                            core::int_to_string(handler_id) + "_merge:\n" +
                            "  " + result + " = phi " + type_name(expected.kind) +
                            " " + lowered.incoming + "\n",
                        value: result,
                        next_temporary: lowered.next_temporary + 1,
                    }
                }
            }
        },
        ExpressionCase::expression(_) => compiler_error(
            source, "GRC9001", "non-perform terminal handler reached lowering",
            expression_span(computation),
            "semantic validation accepted a non-perform computation", [],
            "terminal handler validation must precede lowering",
            "report this compiler bug"
        )
    }
}

lower_step_handler_variant_clauses(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    lexical_parameters: List<Parameter>,
    declaration: EnumDecl,
    enum_arguments: List<TypeRef>,
    clauses: List<HandlerClause>,
    clause_index: i64,
    variant: VariantDecl,
    variant_index_value: i64,
    subject_type: TypeRef,
    subject_value: String,
    expected: TypeRef,
    handler_id: i64,
    next_temporary: i64,
    entry_label: String,
    definitions: String,
    instructions: String,
    incoming: String,
) -> LoweredStepHandlerClauses / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    if(clause_index >= core::list_len(clauses)) {
        LoweredStepHandlerClauses {
            definitions: definitions,
            instructions: instructions + entry_label + ":\n  unreachable\n",
            incoming: incoming,
            switch_cases: "",
            next_temporary: next_temporary,
        }
    } else {
        let clause = core::list_get(clauses, clause_index);
        let outer_pattern = core::list_get(clause.patterns, 0);
        handle perform PatternCase::inspect(outer_pattern) {
            PatternCase::inspect(Pattern::Variant(
                enum_name, variant_name, fields, _
            )) => {
                if(enum_name != declaration.name or
                    variant_name != variant.name) {
                    lower_step_handler_variant_clauses(
                        source, module, callable, lexical_parameters,
                        declaration, enum_arguments, clauses,
                        clause_index + 1, variant, variant_index_value,
                        subject_type, subject_value, expected, handler_id,
                        next_temporary, entry_label, definitions,
                        instructions, incoming
                    )
                } else {
                    let field_types = substitute_types(
                        variant.fields, declaration.type_parameters,
                        enum_arguments, 0, []
                    );
                    let offset = 1 + variant_payload_offset(
                        declaration.variants, variant_index_value, 0, 0
                    );
                    let irrefutable = patterns_are_irrefutable(fields, 0);
                    let condition = if(irrefutable) {
                        LoweredExpression {
                            instructions: "",
                            value: "true",
                            next_temporary: next_temporary,
                        }
                    } else {
                        lower_runtime_nested_pattern_fields(
                            source, module, fields, field_types, 0,
                            subject_type, subject_value, offset, "true",
                            next_temporary, ""
                        )
                    };
                    let body_label = "handler_" +
                        core::int_to_string(handler_id) + "_step_case_" +
                        core::int_to_string(variant_index_value) + "_body_" +
                        core::int_to_string(clause_index);
                    let next_label = "handler_" +
                        core::int_to_string(handler_id) + "_step_case_" +
                        core::int_to_string(variant_index_value) + "_pattern_" +
                        core::int_to_string(clause_index + 1);
                    let bindings = lower_pattern_fields(
                        source, module, lexical_parameters, fields, field_types,
                        0, subject_type, subject_value, offset, "",
                        lexical_parameters
                    );
                    let lowered = lower_step_expression(
                        source, module, callable, bindings.parameters,
                        clause.body, expected, condition.next_temporary
                    );
                    let separator = if(incoming == "") { "" } else { ", " };
                    let branch = if(irrefutable) {
                        "  br label %" + body_label + "\n"
                    } else {
                        "  br i1 " + condition.value + ", label %" +
                            body_label + ", label %" + next_label + "\n"
                    };
                    let with_body = instructions + entry_label + ":\n" +
                        condition.instructions + branch + body_label + ":\n" +
                        bindings.instructions + lowered.instructions +
                        "  br label %handler_" +
                        core::int_to_string(handler_id) + "_step_merge\n";
                    let with_incoming = incoming + separator + "[ " +
                        lowered.value + ", %" + body_label + " ]";
                    let with_definitions = definitions + lowered.definitions;
                    if(irrefutable) {
                        LoweredStepHandlerClauses {
                            definitions: with_definitions,
                            instructions: with_body,
                            incoming: with_incoming,
                            switch_cases: "",
                            next_temporary: lowered.next_temporary,
                        }
                    } else {
                        lower_step_handler_variant_clauses(
                            source, module, callable, lexical_parameters,
                            declaration, enum_arguments, clauses,
                            clause_index + 1, variant, variant_index_value,
                            subject_type, subject_value, expected, handler_id,
                            lowered.next_temporary, next_label,
                            with_definitions, with_body, with_incoming
                        )
                    }
                }
            },
            PatternCase::inspect(_) => compiler_error(
                source, "GRC1818",
                "terminal enum clause needs an explicit variant pattern",
                clause.span,
                "this step-valued clause does not identify its enum tag", [],
                "terminal clauses use ordered patterns within explicit enum tags",
                "replace the outer pattern with a nominal variant pattern"
            )
        }
    }
}

lower_step_handler_variants(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    lexical_parameters: List<Parameter>,
    declaration: EnumDecl,
    enum_arguments: List<TypeRef>,
    clauses: List<HandlerClause>,
    variant_index_value: i64,
    subject_type: TypeRef,
    subject_value: String,
    expected: TypeRef,
    handler_id: i64,
    next_temporary: i64,
    definitions: String,
    instructions: String,
    incoming: String,
    switch_cases: String,
) -> LoweredStepHandlerClauses / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    if(variant_index_value >= core::list_len(declaration.variants)) {
        LoweredStepHandlerClauses {
            definitions: definitions,
            instructions: instructions,
            incoming: incoming,
            switch_cases: switch_cases,
            next_temporary: next_temporary,
        }
    } else {
        let variant = core::list_get(
            declaration.variants, variant_index_value
        );
        let label = "handler_" + core::int_to_string(handler_id) +
            "_step_case_" + core::int_to_string(variant_index_value) +
            "_pattern_0";
        let lowered = lower_step_handler_variant_clauses(
            source, module, callable, lexical_parameters, declaration,
            enum_arguments, clauses, 0, variant, variant_index_value,
            subject_type, subject_value, expected, handler_id,
            next_temporary, label, definitions, instructions, incoming
        );
        lower_step_handler_variants(
            source, module, callable, lexical_parameters, declaration,
            enum_arguments, clauses, variant_index_value + 1,
            subject_type, subject_value, expected, handler_id,
            lowered.next_temporary, lowered.definitions,
            lowered.instructions, lowered.incoming,
            switch_cases + "    i32 " +
                core::int_to_string(variant_index_value) + ", label %" +
                label + "\n"
        )
    }
}

lower_step_terminal_handler(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    parameters: List<Parameter>,
    computation: Expression,
    clauses: List<HandlerClause>,
    expected: TypeRef,
    next_temporary: i64,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    handle perform ExpressionCase::expression(computation) {
        ExpressionCase::expression(Expression::Perform(
            effect_name, operation_name, arguments, span
        )) => {
            let resolved = resolve_perform_operation(
                source, module, parameters, effect_name, operation_name,
                arguments, span
            );
            let subject_type = resolve_type(
                source, module,
                core::list_get(resolved.parameters, 0).parameter_type
            );
            let subject = lower_expression(
                source, module, parameters, core::list_get(arguments, 0),
                subject_type, next_temporary
            );
            handle perform TypeCase::inspect(subject_type.kind) {
                TypeCase::inspect(SourceType::Enum(
                    enum_name, enum_arguments
                )) => {
                    let declaration = handle perform EnumLookupCase::lookup(
                        lookup_enum(module.enums, enum_name, 0)
                    ) {
                        EnumLookupCase::lookup(EnumLookup::Found(found)) => found,
                        EnumLookupCase::lookup(EnumLookup::Missing) =>
                            compiler_error(
                                source, "GRC9001",
                                "missing enum during step handler lowering",
                                span, "the resolved terminal subject vanished", [],
                                "semantic and backend nominal environments agree",
                                "report this compiler bug"
                            )
                    };
                    let tag = "%t" +
                        core::int_to_string(subject.next_temporary);
                    let handler_id = subject.next_temporary;
                    let lowered = lower_step_handler_variants(
                        source, module, callable, parameters, declaration,
                        enum_arguments, clauses, 0, subject_type,
                        subject.value, expected, handler_id,
                        subject.next_temporary + 1, "", "", "", ""
                    );
                    let result = "%t" +
                        core::int_to_string(lowered.next_temporary);
                    LoweredEffectfulBody {
                        definitions: lowered.definitions,
                        instructions: subject.instructions +
                            "  " + tag + " = extractvalue " +
                                type_name(subject_type.kind) + " " +
                                subject.value + ", 0\n" +
                            "  switch i32 " + tag +
                                ", label %handler_" +
                                core::int_to_string(handler_id) +
                                "_step_invalid [\n" +
                            lowered.switch_cases + "  ]\n" +
                            lowered.instructions + "handler_" +
                                core::int_to_string(handler_id) +
                                "_step_invalid:\n  unreachable\nhandler_" +
                                core::int_to_string(handler_id) +
                                "_step_merge:\n" +
                            "  " + result +
                                " = phi %grandiose.effect_step " +
                                lowered.incoming + "\n",
                        value: result,
                        next_temporary: lowered.next_temporary + 1,
                    }
                },
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC9001",
                    "non-enum terminal handler reached step lowering", span,
                    "the terminal case subject is not an enum", [],
                    "terminal case effects eliminate nominal enum tags",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(_) => compiler_error(
            source, "GRC9001",
            "non-perform terminal handler reached step lowering",
            expression_span(computation),
            "a terminal source handler must directly perform its case operation",
            [], "terminal handler validation precedes lowering",
            "report this compiler bug"
        )
    }
}

closure_symbol(
    span: SourceSpan,
    output: TypeRef,
    effectful: Bool,
) -> String / {ResultCase, TypeCase} {
    "@grandiose_closure_" + core::int_to_string(span.start) + "_" +
        (if(effectful) { "step" } else { "value" }) + "__" +
        type_mangle(output)
}

closure_drop_symbol(span: SourceSpan) -> String {
    "@grandiose_closure_drop_" + core::int_to_string(span.start)
}

add_capture(
    captures: List<Parameter>,
    parameter: Parameter,
) -> List<Parameter> / {ResultCase, ParameterLookupCase} {
    handle perform ParameterLookupCase::lookup(
        lookup_parameter(captures, parameter.name, 0)
    ) {
        ParameterLookupCase::lookup(ParameterLookup::Found(_)) => captures,
        ParameterLookupCase::lookup(ParameterLookup::Missing) =>
            core::list_push(captures, parameter)
    }
}

collect_expression_list_captures(
    expressions: List<Expression>,
    outer: List<Parameter>,
    locals: List<Parameter>,
    index: i64,
    captures: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, ExpressionCase, ParameterLookupCase, BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        captures
    } else {
        collect_expression_list_captures(
            expressions,
            outer,
            locals,
            index + 1,
            collect_expression_captures(
                core::list_get(expressions, index), outer, locals, captures
            )
        )
    }
}

collect_block_captures(
    statements: List<BlockStatement>,
    outer: List<Parameter>,
    locals: List<Parameter>,
    index: i64,
    captures: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, ExpressionCase, ParameterLookupCase, BlockStatementCase
} {
    if(index >= core::list_len(statements)) {
        captures
    } else {
        let statement = core::list_get(statements, index);
        handle perform BlockStatementCase::inspect(statement) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, name_span, local_type, value, _
            )) => collect_block_captures(
                statements,
                outer,
                core::list_push(locals, Parameter {
                    name: name,
                    span: name_span,
                    parameter_type: local_type,
                    is_local: true,
                    drop_flag: "",
                    llvm_name: "%local_" + name,
                }),
                index + 1,
                collect_expression_captures(value, outer, locals, captures)
            ),
            BlockStatementCase::inspect(BlockStatement::Value(value)) =>
                collect_block_captures(
                    statements,
                    outer,
                    locals,
                    index + 1,
                    collect_expression_captures(value, outer, locals, captures)
                )
        }
    }
}

collect_expression_captures(
    expression: Expression,
    outer: List<Parameter>,
    locals: List<Parameter>,
    captures: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, ExpressionCase, ParameterLookupCase, BlockStatementCase
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, _)) =>
            collect_expression_list_captures(
                items, outer, locals, 0, captures
            ),
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            collect_expression_captures(value, outer, locals, captures),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            collect_expression_captures(value, outer, locals, captures),
        ExpressionCase::expression(Expression::Variable(name, _)) => {
            handle perform ParameterLookupCase::lookup(lookup_parameter(locals, name, 0)) {
                ParameterLookupCase::lookup(ParameterLookup::Found(_)) => captures,
                ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                    handle perform ParameterLookupCase::lookup(
                        lookup_parameter(outer, name, 0)
                    ) {
                        ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) =>
                            add_capture(captures, parameter),
                        ParameterLookupCase::lookup(ParameterLookup::Missing) => captures
                    }
                }
            }
        },
        ExpressionCase::expression(Expression::Call(name, arguments, _)) => {
            let with_callee = handle perform ParameterLookupCase::lookup(
                lookup_parameter(locals, name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(_)) => captures,
                ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                    handle perform ParameterLookupCase::lookup(
                        lookup_parameter(outer, name, 0)
                    ) {
                        ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) =>
                            add_capture(captures, parameter),
                        ParameterLookupCase::lookup(ParameterLookup::Missing) => captures
                    }
                }
            };
            collect_expression_list_captures(
                arguments, outer, locals, 0, with_callee
            )
        },
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            collect_expression_captures(operand, outer, locals, captures),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            collect_expression_captures(
                right,
                outer,
                locals,
                collect_expression_captures(left, outer, locals, captures)
            ),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            collect_expression_captures(subject, outer, locals, captures),
        ExpressionCase::expression(Expression::EnumValue(_, _, arguments, _)) =>
            collect_expression_list_captures(
                arguments, outer, locals, 0, captures
            ),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            collect_block_captures(statements, outer, locals, 0, captures),
        ExpressionCase::expression(_) => captures
    }
}

closure_captures(
    statements: List<BlockStatement>,
    outer: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, ExpressionCase, ParameterLookupCase, BlockStatementCase
} {
    collect_block_captures(statements, outer, [], 0, [])
}

closure_environment_type(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(captures)) {
        "{ " + output + " }"
    } else {
        let capture = core::list_get(captures, index);
        let capture_type = resolve_type(source, module, capture.parameter_type);
        closure_environment_type(
            source,
            module,
            captures,
            index + 1,
            output + (if(index == 0) { "" } else { ", " }) +
                type_name(capture_type.kind) +
                (if(capture.drop_flag == "") { "" } else { ", ptr" })
        )
    }
}

closure_capture_storage_index(
    captures: List<Parameter>,
    capture_index: i64,
    index: i64,
    storage_index: i64,
) -> i64 / {ResultCase} {
    if(index >= capture_index) {
        storage_index
    } else {
        closure_capture_storage_index(
            captures,
            capture_index,
            index + 1,
            storage_index +
                (if(core::list_get(captures, index).drop_flag == "") {
                    1
                } else { 2 })
        )
    }
}

lower_capture_values(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    index: i64,
    environment_type: String,
    next_temporary: i64,
    instructions: String,
    aggregate: String,
) -> LoweredClosureEnvironment / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(captures)) {
        let size_pointer = "%t" + core::int_to_string(next_temporary);
        let size = "%t" + core::int_to_string(next_temporary + 1);
        let pointer = "%t" + core::int_to_string(next_temporary + 2);
        LoweredClosureEnvironment {
            instructions: instructions + "  " + size_pointer +
                " = getelementptr " + environment_type +
                ", ptr null, i32 1\n" +
                "  " + size + " = ptrtoint ptr " + size_pointer +
                " to i64\n" +
                "  " + pointer + " = call ptr @malloc(i64 " + size + ")\n" +
                "  store " + environment_type + " " + aggregate +
                ", ptr " + pointer + "\n",
            pointer: pointer,
            next_temporary: next_temporary + 3,
        }
    } else {
        let capture = core::list_get(captures, index);
        let capture_type = resolve_type(source, module, capture.parameter_type);
        let storage_index = closure_capture_storage_index(
            captures, index, 0, 0
        );
        let temporary = "%t" + core::int_to_string(next_temporary);
        let with_value = instructions + "  " + temporary +
            " = insertvalue " + environment_type + " " + aggregate +
            ", " + type_name(capture_type.kind) + " " + capture.llvm_name +
            ", " + core::int_to_string(storage_index) + "\n";
        if(capture.drop_flag == "") {
            lower_capture_values(
                source, module, captures, index + 1, environment_type,
                next_temporary + 1, with_value, temporary
            )
        } else {
            let with_flag = "%t" + core::int_to_string(next_temporary + 1);
            lower_capture_values(
                source, module, captures, index + 1, environment_type,
                next_temporary + 2,
                with_value +
                    "  call void @grandiose_retain_drop_state(ptr " +
                    capture.drop_flag + ")\n" +
                    "  " + with_flag + " = insertvalue " +
                    environment_type + " " + temporary + ", ptr " +
                    capture.drop_flag + ", " +
                    core::int_to_string(storage_index + 1) + "\n",
                with_flag
            )
        }
    }
}

lower_closure_environment(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    next_temporary: i64,
) -> LoweredClosureEnvironment / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(core::list_len(captures) == 0) {
        LoweredClosureEnvironment {
            instructions: "",
            pointer: "null",
            next_temporary: next_temporary,
        }
    } else {
        lower_capture_values(
            source,
            module,
            captures,
            0,
            closure_environment_type(source, module, captures, 0, ""),
            next_temporary,
            "",
            "undef"
        )
    }
}

closure_capture_loads(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    environment_type: String,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(captures)) {
        output
    } else {
        let capture = core::list_get(captures, index);
        let storage_index = closure_capture_storage_index(
            captures, index, 0, 0
        );
        closure_capture_loads(
            source,
            module,
            captures,
            environment_type,
            index + 1,
            output + "  " + capture.llvm_name + " = extractvalue " +
                environment_type + " %closure_captures, " +
                core::int_to_string(storage_index) + "\n" +
                (if(capture.drop_flag == "") { "" } else {
                    "  " + capture.drop_flag + " = extractvalue " +
                        environment_type + " %closure_captures, " +
                        core::int_to_string(storage_index + 1) + "\n"
                })
        )
    }
}

lower_closure_drop_captures(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    environment_type: String,
    index: i64,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index < 0) {
        LoweredExpression {
            instructions: instructions,
            value: "{}",
            next_temporary: next_temporary,
        }
    } else {
        let capture = core::list_get(captures, index);
        let capture_type = resolve_type(
            source, module, capture.parameter_type
        );
        let storage_index = closure_capture_storage_index(
            captures, index, 0, 0
        );
        let extracted = "%t" + core::int_to_string(next_temporary);
        let flag = if(capture.drop_flag == "") {
            ""
        } else {
            "%t" + core::int_to_string(next_temporary + 1)
        };
        let flag_instruction = if(flag == "") { "" } else {
            "  " + flag + " = extractvalue " + environment_type +
                " %closure_captures, " +
                core::int_to_string(storage_index + 1) + "\n"
        };
        let destroyed = lower_ownership_plan(
            source,
            module,
            ownership_root_destroy_plan(capture_type, flag),
            0,
            capture_type,
            extracted,
            next_temporary + (if(flag == "") { 1 } else { 2 }),
            ""
        );
        lower_closure_drop_captures(
            source, module, captures, environment_type, index - 1,
            destroyed.next_temporary,
            instructions + "  " + extracted + " = extractvalue " +
                environment_type + " %closure_captures, " +
                core::int_to_string(storage_index) + "\n" +
                flag_instruction + destroyed.instructions
        )
    }
}

lower_capture_environment_drop_definition(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    symbol: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(core::list_len(captures) == 0) {
        "define void " + symbol + "(ptr %closure_env) {\n" +
        "entry:\n" +
        "  ret void\n" +
        "}\n\n"
    } else {
        let environment_type = closure_environment_type(
            source, module, captures, 0, ""
        );
        let destroyed = lower_closure_drop_captures(
            source, module, captures, environment_type,
            core::list_len(captures) - 1, 0, ""
        );
        "define void " + symbol +
            "(ptr %closure_env) {\n" +
            "entry:\n" +
            "  %closure_captures = load " + environment_type +
            ", ptr %closure_env\n" + destroyed.instructions +
            "  call void @free(ptr %closure_env)\n" +
            "  ret void\n" +
            "}\n\n"
    }
}

lower_closure_drop_definition(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    span: SourceSpan,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    lower_capture_environment_drop_definition(
        source, module, captures, closure_drop_symbol(span)
    )
}

lower_closure_definition(
    source: SourceFile,
    module: Module,
    outer: List<Parameter>,
    statements: List<BlockStatement>,
    span: SourceSpan,
    output_type: TypeRef,
    effectful: Bool,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let captures = closure_captures(statements, outer);
    let environment_type = closure_environment_type(
        source, module, captures, 0, ""
    );
    let capture_loads = if(core::list_len(captures) == 0) {
        ""
    } else {
        "  %closure_captures = load " + environment_type +
            ", ptr %closure_env\n" +
            closure_capture_loads(
                source, module, captures, environment_type, 0, ""
            )
    };
    if(effectful) {
        let closure_callable = CallableDecl {
            name: "closure_" + core::int_to_string(span.start),
            name_span: span,
            type_parameters: [],
            callable_constraints: [],
            use_constraints: [],
            environment_constraints: [],
            runs_in_constraints: [],
            parameters: captures,
            result_type: output_type,
            effects: [],
            body: Expression::Block(statements, span),
            span: span,
        };
        let lowered = lower_effectful_block(
            source, module, closure_callable, captures, statements, 0,
            output_type, 0
        );
        lowered.definitions + "define %grandiose.effect_step " +
            closure_symbol(span, output_type, true) +
            "(ptr %closure_env) {\n" +
            "entry:\n" + capture_loads + lowered.instructions +
            "  ret %grandiose.effect_step " + lowered.value + "\n" +
            "}\n\n" + lower_closure_drop_definition(
                source, module, captures, span
            )
    } else {
        let lowered = lower_block(
            source, module, captures, statements, 0, output_type, 0, ""
        );
        "define " + type_name(output_type.kind) + " " +
            closure_symbol(span, output_type, false) +
            "(ptr %closure_env) {\n" +
            "entry:\n" + capture_loads + lowered.instructions +
            "  ret " + type_name(output_type.kind) + " " + lowered.value + "\n" +
            "}\n\n" + lower_closure_drop_definition(
                source, module, captures, span
            )
    }
}

lower_list_literal_items(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    items: List<Expression>, element: TypeRef, index: i64,
    current: String, next_temporary: i64, instructions: String,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(items)) {
        LoweredExpression {
            instructions: instructions,
            value: current,
            next_temporary: next_temporary,
        }
    } else {
        let item = lower_expression(
            source, module, parameters, core::list_get(items, index),
            element, next_temporary
        );
        let payload_size_ptr = "%t" + core::int_to_string(item.next_temporary);
        let payload_size = "%t" + core::int_to_string(item.next_temporary + 1);
        let allocation_size = "%t" + core::int_to_string(item.next_temporary + 2);
        let allocation = "%t" + core::int_to_string(item.next_temporary + 3);
        let old_data = "%t" + core::int_to_string(item.next_temporary + 4);
        let new_data = "%t" + core::int_to_string(item.next_temporary + 5);
        let old_size_ptr = "%t" + core::int_to_string(item.next_temporary + 6);
        let old_size = "%t" + core::int_to_string(item.next_temporary + 7);
        let slot = "%t" + core::int_to_string(item.next_temporary + 8);
        let next_length = index + 1;
        let next_instructions = instructions + item.instructions +
            "  " + payload_size_ptr + " = getelementptr " +
                type_name(element.kind) + ", ptr null, i64 " +
                core::int_to_string(next_length) + "\n" +
            "  " + payload_size + " = ptrtoint ptr " + payload_size_ptr +
                " to i64\n" +
            "  " + allocation_size + " = add i64 " + payload_size + ", 8\n" +
            "  " + allocation + " = call ptr @malloc(i64 " +
                allocation_size + ")\n" +
            "  store i64 " + core::int_to_string(next_length) + ", ptr " +
                allocation + "\n" +
            "  " + old_data + " = getelementptr i8, ptr " + current +
                ", i64 8\n" +
            "  " + new_data + " = getelementptr i8, ptr " + allocation +
                ", i64 8\n" +
            "  " + old_size_ptr + " = getelementptr " +
                type_name(element.kind) + ", ptr null, i64 " +
                core::int_to_string(index) + "\n" +
            "  " + old_size + " = ptrtoint ptr " + old_size_ptr + " to i64\n" +
            "  call void @llvm.memcpy.p0.p0.i64(ptr " + new_data +
                ", ptr " + old_data + ", i64 " + old_size + ", i1 false)\n" +
            "  " + slot + " = getelementptr " + type_name(element.kind) +
                ", ptr " + new_data + ", i64 " + core::int_to_string(index) + "\n" +
            "  store " + type_name(element.kind) + " " + item.value +
                ", ptr " + slot + "\n";
        lower_list_literal_items(
            source, module, parameters, items, element, index + 1,
            allocation, item.next_temporary + 9, next_instructions
        )
    }
}

lower_scalar_handler_clauses(
    source: SourceFile, module: Module, lexical_parameters: List<Parameter>,
    clauses: List<HandlerClause>, index: i64, subject_type: TypeRef,
    subject_value: String, expected: TypeRef, handler_id: i64,
    next_temporary: i64, instructions: String, incoming: String,
) -> LoweredHandlerClauses / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        LoweredHandlerClauses {
            instructions: instructions,
            incoming: incoming,
            switch_cases: "",
            next_temporary: next_temporary,
        }
    } else {
        let clause = core::list_get(clauses, index);
        let pattern = core::list_get(clause.patterns, 0);
        let test_label = "handler_" + core::int_to_string(handler_id) +
            "_scalar_test_" + core::int_to_string(index);
        let body_label = "handler_" + core::int_to_string(handler_id) +
            "_scalar_body_" + core::int_to_string(index);
        let next_label = "handler_" + core::int_to_string(handler_id) +
            "_scalar_test_" + core::int_to_string(index + 1);
        let binding_parameters = handle perform PatternCase::inspect(pattern) {
            PatternCase::inspect(Pattern::Binding(name, span)) =>
                core::list_push(lexical_parameters, Parameter {
                    name: name, span: span, parameter_type: subject_type,
                    is_local: true, drop_flag: "", llvm_name: subject_value,
                }),
            PatternCase::inspect(_) => lexical_parameters
        };
        let condition = "%t" + core::int_to_string(next_temporary);
        let compared = "%t" + core::int_to_string(next_temporary + 1);
        let test = handle perform PatternCase::inspect(pattern) {
            PatternCase::inspect(Pattern::String(_, span)) =>
                "  " + compared + " = call i32 @strcmp(ptr " + subject_value +
                    ", ptr @grandiose_string_" + core::int_to_string(span.start) +
                    ")\n" +
                "  " + condition + " = icmp eq i32 " + compared + ", 0\n" +
                "  br i1 " + condition + ", label %" + body_label +
                    ", label %" + next_label + "\n",
            PatternCase::inspect(Pattern::Integer(value, _)) =>
                "  " + condition + " = icmp eq " + type_name(subject_type.kind) +
                    " " + subject_value + ", " + core::int_to_string(value) + "\n" +
                "  br i1 " + condition + ", label %" + body_label +
                    ", label %" + next_label + "\n",
            PatternCase::inspect(Pattern::Unit(_)) =>
                "  br label %" + body_label + "\n",
            PatternCase::inspect(Pattern::Wildcard(_)) =>
                "  br label %" + body_label + "\n",
            PatternCase::inspect(Pattern::Binding(_, _)) =>
                "  br label %" + body_label + "\n",
            PatternCase::inspect(_) => compiler_error(
                source, "GRC9001", "scalar handler pattern invariant violated",
                pattern_span(pattern),
                "a nominal pattern reached scalar terminal lowering", [],
                "semantic handler planning separates scalar and enum dispatch",
                "report this compiler bug"
            )
        };
        let condition_temporaries = handle perform PatternCase::inspect(pattern) {
            PatternCase::inspect(Pattern::String(_, _)) => 2,
            PatternCase::inspect(Pattern::Integer(_, _)) => 1,
            PatternCase::inspect(_) => 0
        };
        let lowered = lower_expression(
            source, module, binding_parameters, clause.body, expected,
            next_temporary + condition_temporaries
        );
        lower_scalar_handler_clauses(
            source, module, lexical_parameters, clauses, index + 1,
            subject_type, subject_value, expected, handler_id,
            lowered.next_temporary,
            instructions + test_label + ":\n" + test + body_label + ":\n" +
                lowered.instructions + "  br label %handler_" +
                core::int_to_string(handler_id) + "_merge\n",
            incoming + (if(index == 0) { "" } else { ", " }) +
                "[ " + lowered.value + ", %" + body_label + " ]"
        )
    }
}

lower_expression(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    unresolved_expected: TypeRef,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase,
    Diagnostics
} {
    let expected = resolve_type(source, module, unresolved_expected);
    handle perform TypeCase::inspect(expected.kind) {
        TypeCase::inspect(SourceType::Indirect(storage)) => {
            let target = indirect_target(storage);
            let lowered = lower_expression(
                source, module, parameters, expression, target,
                next_temporary
            );
            let size_pointer = "%t" +
                core::int_to_string(lowered.next_temporary);
            let size = "%t" +
                core::int_to_string(lowered.next_temporary + 1);
            let allocation = "%t" +
                core::int_to_string(lowered.next_temporary + 2);
            LoweredExpression {
                instructions: lowered.instructions +
                    "  " + size_pointer + " = getelementptr " +
                        type_name(target.kind) + ", ptr null, i64 1\n" +
                    "  " + size + " = ptrtoint ptr " + size_pointer +
                        " to i64\n" +
                    "  " + allocation + " = call ptr @malloc(i64 " +
                        size + ")\n" +
                    "  store " + type_name(target.kind) + " " +
                        lowered.value + ", ptr " + allocation + "\n",
                value: allocation,
                next_temporary: lowered.next_temporary + 3,
            }
        },
        TypeCase::inspect(_) => {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, span)) => {
            let element = handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::List(found)) => found,
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC9001", "list lowering invariant violated", span,
                    "a list literal reached lowering with a non-list type", [],
                    "semantic validation establishes homogeneous list context",
                    "report this compiler bug"
                )
            };
            lower_list_literal_items(
                source, module, parameters, items, element, 0,
                "@grandiose_empty_list", next_temporary, ""
            )
        },
        ExpressionCase::expression(Expression::Borrow(value, _, _)) => {
            let value_type = infer_expression_type(
                source, module, parameters, value
            );
            let typed = typed_core_expression(
                source, module, parameters, value, value_type
            );
            require(
                typed.place.found,
                error_diagnostic(
                    source, "GRC9001", "borrow lowering invariant violated",
                    expression_span(typed.expression),
                    "a non-place expression reached reference lowering", [],
                    "borrow validation records place category in Typed Core",
                    "report this compiler bug"
                )
            );
            handle perform ExpressionCase::expression(typed.expression) {
                ExpressionCase::expression(Expression::Dereference(
                    reference, _
                )) => {
                    let reference_type = infer_dereference_operand_type(
                        source, module, parameters, reference,
                        expression_span(reference)
                    );
                    lower_expression(
                        source, module, parameters, reference, reference_type,
                        next_temporary
                    )
                },
                ExpressionCase::expression(_) => {
                    let lowered = lower_expression(
                        source, module,
                        parameters_without_drop_flags(parameters, 0, []),
                        typed.expression, typed.value_type,
                        next_temporary
                    );
                    let pointer = "%t" + core::int_to_string(
                        lowered.next_temporary
                    );
                    LoweredExpression {
                        instructions: lowered.instructions + "  " + pointer +
                            " = alloca " + type_name(typed.value_type.kind) + "\n" +
                            "  store " + type_name(typed.value_type.kind) + " " +
                            lowered.value + ", ptr " + pointer + "\n",
                        value: pointer,
                        next_temporary: lowered.next_temporary + 1,
                    }
                }
            }
        },
        ExpressionCase::expression(Expression::Dereference(reference, _)) => {
            let reference_type = infer_dereference_operand_type(
                source, module, parameters, reference,
                expression_span(expression)
            );
            let lowered = lower_expression(
                source, module, parameters, reference, reference_type,
                next_temporary
            );
            let loaded = "%t" + core::int_to_string(lowered.next_temporary);
            LoweredExpression {
                instructions: lowered.instructions + "  " + loaded +
                    " = load " + type_name(expected.kind) + ", ptr " +
                    lowered.value + "\n",
                value: loaded,
                next_temporary: lowered.next_temporary + 1,
            }
        },
        ExpressionCase::expression(Expression::Destroy(value, _)) => {
            let value_type = infer_expression_type(
                source, module, parameters, value
            );
            let lowered = lower_expression(
                source, module, parameters, value, value_type, next_temporary
            );
            let destroyed = lower_ownership_plan(
                source,
                module,
                ownership_root_destroy_plan(value_type, ""),
                0,
                value_type,
                lowered.value,
                lowered.next_temporary,
                ""
            );
            LoweredExpression {
                instructions: lowered.instructions + destroyed.instructions,
                value: "{}",
                next_temporary: destroyed.next_temporary,
            }
        },
        ExpressionCase::expression(Expression::AvailableValue(_, _)) =>
            LoweredExpression {
                instructions: "",
                value: "{}",
                next_temporary: next_temporary,
            },
        ExpressionCase::expression(Expression::ConsumeAvailable(available, _)) => {
            let available_type = infer_expression_type(
                source, module, parameters, available
            );
            let lowered = lower_expression(
                source, module, parameters, available, available_type,
                next_temporary
            );
            LoweredExpression {
                instructions: lowered.instructions,
                value: "{}",
                next_temporary: lowered.next_temporary,
            }
        },
        ExpressionCase::expression(Expression::Unit(_)) => LoweredExpression {
            instructions: "",
            value: "{}",
            next_temporary: next_temporary,
        },
        ExpressionCase::expression(Expression::String(_, span)) =>
            LoweredExpression {
                instructions: "",
                value: "@grandiose_string_" +
                    core::int_to_string(span.start),
                next_temporary: next_temporary,
            },
        ExpressionCase::expression(Expression::Integer(value, _)) => LoweredExpression {
            instructions: "",
            value: core::int_to_string(value),
            next_temporary: next_temporary,
        },
        ExpressionCase::expression(Expression::Negate(operand, _)) => {
            let lowered = lower_expression(
                source,
                module,
                parameters,
                operand,
                expected,
                next_temporary
            );
            let temporary = "%t" + core::int_to_string(lowered.next_temporary);
            LoweredExpression {
                instructions: lowered.instructions +
                    "  " + temporary + " = sub " + type_name(expected.kind) +
                    " 0, " + lowered.value + "\n",
                value: temporary,
                next_temporary: lowered.next_temporary + 1,
            }
        },
        ExpressionCase::expression(Expression::Binary(operator, left, right, _)) => {
            let operand_type = if(operator_is_comparison(operator)) {
                comparison_expression_operand_type(
                    source,
                    module,
                    parameters,
                    operator,
                    left,
                    right,
                    expression_span(expression)
                )
            } else {
                expected
            };
            let lowered_left = lower_expression(
                source,
                module,
                parameters,
                left,
                operand_type,
                next_temporary
            );
            let lowered_right = lower_expression(
                source,
                module,
                parameters,
                right,
                operand_type,
                lowered_left.next_temporary
            );
            let temporary = "%t" + core::int_to_string(lowered_right.next_temporary);
            if(operator_is_comparison(operator)) {
                let success = "%t" +
                    core::int_to_string(lowered_right.next_temporary + 1);
                let failure = "%t" +
                    core::int_to_string(lowered_right.next_temporary + 2);
                let selected = "%t" +
                    core::int_to_string(lowered_right.next_temporary + 3);
                LoweredExpression {
                    instructions: lowered_left.instructions + lowered_right.instructions +
                        "  " + temporary + " = icmp " +
                        comparison_instruction(operator) + " " +
                        type_name(operand_type.kind) + " " + lowered_left.value +
                        ", " + lowered_right.value + "\n" +
                        "  " + success + " = insertvalue " + type_name(expected.kind) +
                        " undef, i32 0, 0\n" +
                        "  " + failure + " = insertvalue " + type_name(expected.kind) +
                        " undef, i32 1, 0\n" +
                        "  " + selected + " = select i1 " + temporary + ", " +
                        type_name(expected.kind) + " " + success + ", " +
                        type_name(expected.kind) + " " + failure + "\n",
                    value: selected,
                    next_temporary: lowered_right.next_temporary + 4,
                }
            } else {
                LoweredExpression {
                    instructions: lowered_left.instructions + lowered_right.instructions +
                        "  " + temporary + " = " + operator_instruction(operator) +
                        " " + type_name(expected.kind) + " " +
                        lowered_left.value + ", " + lowered_right.value + "\n",
                    value: temporary,
                    next_temporary: lowered_right.next_temporary + 1,
                }
            }
        },
        ExpressionCase::expression(Expression::Variable(name, span)) => {
            let parameter = resolve_parameter(source, parameters, name, span);
            let clears_drop_flag = parameter.drop_flag != "" and
                principal_use_interval(
                    source, module, parameter.parameter_type, []
                ).upper != -1;
            LoweredExpression {
                instructions: if(clears_drop_flag) {
                    "  %t" + core::int_to_string(next_temporary) +
                        " = call i1 @grandiose_claim_drop_state(ptr " +
                        parameter.drop_flag + ")\n"
                } else { "" },
                value: parameter.llvm_name,
                next_temporary: next_temporary +
                    (if(clears_drop_flag) { 1 } else { 0 }),
            }
        },
        ExpressionCase::expression(Expression::Call(name, arguments, span)) =>
            lower_named_call(
                source,
                module,
                parameters,
                name,
                arguments,
                expected,
                span,
                next_temporary
            ),
        ExpressionCase::expression(Expression::StructValue(name, fields, span)) => {
            handle perform StructLookupCase::lookup(lookup_struct(module.structs, name, 0)) {
                StructLookupCase::lookup(StructLookup::Found(declaration)) =>
                    lower_struct_fields(
                        source,
                        module,
                        parameters,
                        declaration,
                        expected,
                        fields,
                        0,
                        next_temporary,
                        "",
                        "undef"
                    ),
                StructLookupCase::lookup(StructLookup::Missing) => compiler_error(
                    source,
                    "GRC9001",
                    "backend invariant violated",
                    span,
                    "validated struct `" + name + "` is unavailable during lowering",
                    [],
                    "name resolution and lowering must use the same nominal module",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(Expression::Field(subject, field_name, span)) => {
            let subject_type = infer_expression_type(source, module, parameters, subject);
            handle perform TypeCase::inspect(subject_type.kind) {
                TypeCase::inspect(SourceType::Struct(struct_name, _)) => {
                    handle perform StructLookupCase::lookup(
                        lookup_struct(module.structs, struct_name, 0)
                    ) {
                        StructLookupCase::lookup(StructLookup::Found(declaration)) => {
                            let index = struct_field_index(
                                declaration.fields,
                                field_name,
                                0
                            );
                            let lowered = lower_expression(
                                source,
                                module,
                                parameters,
                                subject,
                                subject_type,
                                next_temporary
                            );
                            let temporary = "%t" +
                                core::int_to_string(lowered.next_temporary);
                            LoweredExpression {
                                instructions: lowered.instructions +
                                    "  " + temporary + " = extractvalue " +
                                    type_name(subject_type.kind) + " " + lowered.value +
                                    ", " + core::int_to_string(index) + "\n",
                                value: temporary,
                                next_temporary: lowered.next_temporary + 1,
                            }
                        },
                        StructLookupCase::lookup(StructLookup::Missing) => compiler_error(
                            source,
                            "GRC9001",
                            "backend invariant violated",
                            span,
                            "projected struct declaration is unavailable during lowering",
                            [],
                            "validated nominal types must remain available to the backend",
                            "report this compiler bug"
                        )
                    }
                },
                TypeCase::inspect(_) => compiler_error(
                    source,
                    "GRC9001",
                    "backend invariant violated",
                    span,
                    "non-struct field projection reached LLVM lowering",
                    [],
                    "semantic checking must reject scalar projection before lowering",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(Expression::EnumValue(
            enum_name,
            variant_name,
            arguments,
            span
        )) => {
            let enum_arguments = expected_enum_arguments(
                source,
                expected,
                enum_name,
                span
            );
            handle perform EnumLookupCase::lookup(lookup_enum(module.enums, enum_name, 0)) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                    handle perform VariantLookupCase::lookup(
                        lookup_variant(declaration.variants, variant_name, 0)
                    ) {
                        VariantLookupCase::lookup(VariantLookup::Found(variant)) => {
                            let tag = variant_index(declaration.variants, variant_name, 0);
                            let offset = 1 + variant_payload_offset(
                                declaration.variants,
                                tag,
                                0,
                                0
                            );
                            let tag_temporary = "%t" +
                                core::int_to_string(next_temporary);
                            lower_variant_payloads(
                                source,
                                module,
                                parameters,
                                expected,
                                arguments,
                                substitute_types(
                                    variant.fields,
                                    declaration.type_parameters,
                                    enum_arguments,
                                    0,
                                    []
                                ),
                                0,
                                offset,
                                next_temporary + 1,
                                "  " + tag_temporary + " = insertvalue " +
                                    type_name(expected.kind) +
                                    " undef, i32 " + core::int_to_string(tag) + ", 0\n",
                                tag_temporary
                            )
                        },
                        VariantLookupCase::lookup(VariantLookup::Missing) => compiler_error(
                            source,
                            "GRC9001",
                            "backend invariant violated",
                            span,
                            "validated enum variant is unavailable during lowering",
                            [],
                            "semantic validation and lowering must share variant declarations",
                            "report this compiler bug"
                        )
                    }
                },
                EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                    source,
                    "GRC9001",
                    "backend invariant violated",
                    span,
                    "validated enum is unavailable during lowering",
                    [],
                    "semantic validation and lowering must share enum declarations",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(Expression::Perform(_, _, _, span)) => compiler_error(
            source,
            "GRC9001",
            "unhandled terminal perform reached LLVM lowering",
            span,
            "a terminal operation must be enclosed by its case handler",
            [],
            "validation must reject unhandled terminal effects before lowering",
            "report this compiler bug"
        ),
        ExpressionCase::expression(Expression::Handle(computation, clauses, _)) => {
            let first = core::list_get(clauses, 0);
            let handled = resolve_handler_operation_declaration(
                source,
                module,
                first.effect_name,
                first.operation_name,
                first.span
            );
            let operation_result = resolve_type(
                source, module, handled.operation.result_type
            );
            if(operation_result.kind == SourceType::Never) {
                lower_terminal_handler(
                    source, module, parameters, computation, clauses,
                    expected, next_temporary
                )
            } else {
                lower_resumptive_handler(
                    source, module, parameters, computation, clauses,
                    expected, next_temporary
                )
            }
        },
        ExpressionCase::expression(Expression::Block(statements, span)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Callable(output, effectful)) => {
                    let captures = closure_captures(statements, parameters);
                    let environment = lower_closure_environment(
                        source,
                        module,
                        captures,
                        next_temporary
                    );
                    let function_value = "%t" +
                        core::int_to_string(environment.next_temporary);
                    let closure_value = "%t" +
                        core::int_to_string(environment.next_temporary + 1);
                    let completed_value = "%t" +
                        core::int_to_string(environment.next_temporary + 2);
                    LoweredExpression {
                        instructions: environment.instructions + "  " + function_value +
                            " = insertvalue { ptr, ptr, ptr } undef, ptr " +
                            closure_symbol(span, output, effectful) + ", 0\n" +
                            "  " + closure_value +
                            " = insertvalue { ptr, ptr, ptr } " + function_value +
                            ", ptr " + environment.pointer + ", 1\n" +
                            "  " + completed_value +
                            " = insertvalue { ptr, ptr, ptr } " + closure_value +
                            ", ptr " +
                            (if(core::list_len(captures) == 0) {
                                "@grandiose_closure_drop_noop"
                            } else {
                                closure_drop_symbol(span)
                            }) + ", 2\n",
                        value: completed_value,
                        next_temporary: environment.next_temporary + 3,
                    }
                },
                TypeCase::inspect(_) => lower_block(
                    source,
                    module,
                    parameters,
                    statements,
                    0,
                    expected,
                    next_temporary,
                    ""
                )
            }
        }
    }
        }
    }
}

lower_destroy_value_if_active(
    source: SourceFile,
    module: Module,
    reference: TypeRef,
    value: String,
    drop_flag: String,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let active = "%t" + core::int_to_string(next_temporary);
    let label = "drop_flag_" + core::int_to_string(next_temporary);
    let destroyed = lower_destroy_value(
        source, module, reference, value, next_temporary + 1
    );
    LoweredExpression {
        instructions: "  " + active +
            " = call i1 @grandiose_claim_drop_state(ptr " + drop_flag + ")\n" +
            "  br i1 " + active + ", label %" + label +
            "_active, label %" + label + "_done\n" + label +
            "_active:\n" +
            destroyed.instructions + "  br label %" + label + "_done\n" +
            label + "_done:\n" +
            "  call void @grandiose_release_drop_state(ptr " +
                drop_flag + ")\n",
        value: "{}",
        next_temporary: destroyed.next_temporary,
    }
}

parameters_without_drop_flags(
    parameters: List<Parameter>,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        parameters_without_drop_flags(
            parameters,
            index + 1,
            core::list_push(output, Parameter {
                name: parameter.name,
                span: parameter.span,
                parameter_type: parameter.parameter_type,
                is_local: parameter.is_local,
                drop_flag: "",
                llvm_name: parameter.llvm_name,
            })
        )
    }
}

lower_destroy_value(
    source: SourceFile,
    module: Module,
    reference: TypeRef,
    value: String,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let resolved = resolve_type(source, module, reference);
    if(drop_is_present(source, module, resolved, 0)) {
        let storage = "%t" + core::int_to_string(next_temporary);
        let hook_result = "%t" + core::int_to_string(next_temporary + 1);
        let updated = "%t" + core::int_to_string(next_temporary + 2);
        let structural = lower_destroy_value_structural(
            source, module, resolved, updated, next_temporary + 3
        );
        LoweredExpression {
            instructions: "  " + storage + " = alloca " +
                type_name(resolved.kind) + "\n" +
                "  store " + type_name(resolved.kind) + " " + value +
                ", ptr " + storage + "\n" +
                "  " + hook_result + " = call {} @grandiose_drop_hook_" +
                type_mangle(resolved) + "(ptr " + storage + ")\n" +
                "  " + updated + " = load " + type_name(resolved.kind) +
                ", ptr " + storage + "\n" + structural.instructions,
            value: "{}",
            next_temporary: structural.next_temporary,
        }
    } else {
        lower_destroy_value_structural(
            source, module, resolved, value, next_temporary
        )
    }
}

lower_destroy_value_structural(
    source: SourceFile,
    module: Module,
    resolved: TypeRef,
    value: String,
    next_temporary: i64,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    handle perform TypeCase::inspect(resolved.kind) {
        TypeCase::inspect(SourceType::Callable(_, _)) => {
            let environment = "%t" + core::int_to_string(next_temporary);
            let drop = "%t" + core::int_to_string(next_temporary + 1);
            LoweredExpression {
                instructions: "  " + environment +
                    " = extractvalue { ptr, ptr, ptr } " + value + ", 1\n" +
                    "  " + drop + " = extractvalue { ptr, ptr, ptr } " +
                    value + ", 2\n" +
                    "  call void " + drop + "(ptr " + environment + ")\n",
                value: "{}",
                next_temporary: next_temporary + 2,
            }
        },
        TypeCase::inspect(SourceType::Struct(name, arguments)) => {
            handle perform StructLookupCase::lookup(
                lookup_struct(module.structs, name, 0)
            ) {
                StructLookupCase::lookup(StructLookup::Found(declaration)) =>
                    lower_destroy_struct_fields(
                        source, module, declaration.fields,
                        declaration.type_parameters, arguments,
                        type_name(resolved.kind), value,
                        core::list_len(declaration.fields) - 1,
                        next_temporary, ""
                    ),
                StructLookupCase::lookup(StructLookup::Missing) => compiler_error(
                    source, "GRC9001", "destruction invariant violated",
                    reference.span,
                    "a resolved struct has no declaration during cleanup", [],
                    "structural destruction requires the nominal field layout",
                    "report this compiler bug"
                )
            }
        },
        TypeCase::inspect(SourceType::Enum(name, arguments)) => {
            handle perform EnumLookupCase::lookup(
                lookup_enum(module.enums, name, 0)
            ) {
                EnumLookupCase::lookup(EnumLookup::Found(declaration)) => {
                    let tag = "%t" + core::int_to_string(next_temporary);
                    let label_base = "destroy_enum_" +
                        core::int_to_string(next_temporary);
                    let lowered = lower_destroy_enum_variants(
                        source, module, declaration, arguments,
                        type_name(resolved.kind), value, label_base,
                        0, next_temporary + 1, ""
                    );
                    LoweredExpression {
                        instructions: "  " + tag + " = extractvalue " +
                            type_name(resolved.kind) + " " + value + ", 0\n" +
                            "  switch i32 " + tag + ", label %" + label_base +
                            "_done [\n" + destroy_enum_switch_cases(
                                core::list_len(declaration.variants),
                                label_base, 0, ""
                            ) + "  ]\n" + lowered.instructions +
                            label_base + "_done:\n",
                        value: "{}",
                        next_temporary: lowered.next_temporary,
                    }
                },
                EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                    source, "GRC9001", "destruction invariant violated",
                    reference.span,
                    "a resolved enum has no declaration during cleanup", [],
                    "active-payload destruction requires the nominal variant layout",
                    "report this compiler bug"
                )
            }
        },
        TypeCase::inspect(_) => LoweredExpression {
            instructions: "",
            value: "{}",
            next_temporary: next_temporary,
        }
    }
}

destroy_enum_switch_cases(
    count: i64,
    label_base: String,
    index: i64,
    output: String,
) -> String / {ResultCase} {
    if(index >= count) {
        output
    } else {
        destroy_enum_switch_cases(
            count, label_base, index + 1,
            output + "    i32 " + core::int_to_string(index) +
                ", label %" + label_base + "_" +
                core::int_to_string(index) + "\n"
        )
    }
}

lower_destroy_enum_variant_fields(
    source: SourceFile,
    module: Module,
    declaration: EnumDecl,
    type_arguments: List<TypeRef>,
    variant: VariantDecl,
    aggregate_type: String,
    value: String,
    storage_offset: i64,
    index: i64,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index < 0) {
        LoweredExpression {
            instructions: instructions,
            value: "{}",
            next_temporary: next_temporary,
        }
    } else {
        let field_type = resolve_type(
            source, module,
            core::list_get(
                substitute_types(
                    variant.fields, declaration.type_parameters,
                    type_arguments, 0, []
                ),
                index
            )
        );
        let extracted = "%t" + core::int_to_string(next_temporary);
        let destroyed = lower_destroy_value(
            source, module, field_type, extracted, next_temporary + 1
        );
        lower_destroy_enum_variant_fields(
            source, module, declaration, type_arguments, variant,
            aggregate_type, value, storage_offset, index - 1,
            destroyed.next_temporary,
            instructions + "  " + extracted + " = extractvalue " +
                aggregate_type + " " + value + ", " +
                core::int_to_string(storage_offset + index) + "\n" +
                destroyed.instructions
        )
    }
}

lower_destroy_enum_variants(
    source: SourceFile,
    module: Module,
    declaration: EnumDecl,
    type_arguments: List<TypeRef>,
    aggregate_type: String,
    value: String,
    label_base: String,
    index: i64,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(declaration.variants)) {
        LoweredExpression {
            instructions: instructions,
            value: "{}",
            next_temporary: next_temporary,
        }
    } else {
        let variant = core::list_get(declaration.variants, index);
        let destroyed = lower_destroy_enum_variant_fields(
            source, module, declaration, type_arguments, variant,
            aggregate_type, value,
            1 + variant_payload_offset(declaration.variants, index, 0, 0),
            core::list_len(variant.fields) - 1,
            next_temporary, ""
        );
        lower_destroy_enum_variants(
            source, module, declaration, type_arguments, aggregate_type,
            value, label_base, index + 1, destroyed.next_temporary,
            instructions + label_base + "_" + core::int_to_string(index) +
                ":\n" + destroyed.instructions + "  br label %" +
                label_base + "_done\n"
        )
    }
}

lower_destroy_struct_fields(
    source: SourceFile,
    module: Module,
    fields: List<StructFieldDecl>,
    type_parameters: List<TypeParameter>,
    type_arguments: List<TypeRef>,
    aggregate_type: String,
    value: String,
    index: i64,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index < 0) {
        LoweredExpression {
            instructions: instructions,
            value: "{}",
            next_temporary: next_temporary,
        }
    } else {
        let field = core::list_get(fields, index);
        let field_type = resolve_type(
            source, module,
            core::list_get(
                substitute_types(
                    [field.field_type], type_parameters, type_arguments, 0, []
                ),
                0
            )
        );
        let extracted = "%t" + core::int_to_string(next_temporary);
        let destroyed = lower_destroy_value(
            source, module, field_type, extracted, next_temporary + 1
        );
        lower_destroy_struct_fields(
            source, module, fields, type_parameters, type_arguments,
            aggregate_type, value, index - 1, destroyed.next_temporary,
            instructions + "  " + extracted + " = extractvalue " +
                aggregate_type + " " + value + ", " +
                core::int_to_string(index) + "\n" + destroyed.instructions
        )
    }
}

lower_parameters(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    index: i64,
    output: String,
) -> String / {ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
            let parameter = core::list_get(parameters, index);
            let parameter_type = resolve_type(source, module, parameter.parameter_type);
            let separator = if(index == 0) { "" } else { ", " };
            lower_parameters(
                source,
                module,
                parameters,
                index + 1,
                output + separator + type_name(parameter_type.kind) +
                " " + parameter.llvm_name
            )
        }
}

lookup_specialization(
    specializations: List<CallableSpecialization>,
    name: String,
    suffix: String,
    index: i64,
) -> SpecializationLookup / {ResultCase} {
    if(index >= core::list_len(specializations)) {
        SpecializationLookup::Missing
    } else {
        let candidate = core::list_get(specializations, index);
        if(candidate.callable.name == name and candidate.suffix == suffix) {
            SpecializationLookup::Found
        } else {
            lookup_specialization(specializations, name, suffix, index + 1)
        }
    }
}

collect_argument_specializations(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    expected_parameters: List<Parameter>,
    index: i64,
    specializations: List<CallableSpecialization>,
) -> List<CallableSpecialization> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, SpecializationLookupCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        specializations
    } else {
        collect_argument_specializations(
            source,
            module,
            parameters,
            arguments,
            expected_parameters,
            index + 1,
            collect_expression_specializations(
                source,
                module,
                parameters,
                core::list_get(arguments, index),
                core::list_get(expected_parameters, index).parameter_type,
                specializations
            )
        )
    }
}

collect_block_specializations(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
    expected: TypeRef,
    specializations: List<CallableSpecialization>,
) -> List<CallableSpecialization> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, SpecializationLookupCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name,
            name_span,
            local_type,
            value,
            _
        )) => {
            let collected = collect_expression_specializations(
                source,
                module,
                parameters,
                value,
                local_type,
                specializations
            );
            collect_block_specializations(
                source,
                module,
                core::list_push(parameters, Parameter {
                    name: name,
                    span: name_span,
                    parameter_type: local_type,
                    is_local: true,
                    drop_flag: "",
                    llvm_name: "%local_" + name,
                }),
                statements,
                index + 1,
                expected,
                collected
            )
        },
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            let value_type = if(index + 1 >= core::list_len(statements)) {
                expected
            } else {
                infer_expression_type(source, module, parameters, value)
            };
            let collected = collect_expression_specializations(
                source,
                module,
                parameters,
                value,
                value_type,
                specializations
            );
            if(index + 1 >= core::list_len(statements)) {
                collected
            } else {
                collect_block_specializations(
                    source,
                    module,
                    parameters,
                    statements,
                    index + 1,
                    expected,
                    collected
                )
            }
        }
    }
}

collect_handler_clause_specializations(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    resolved: ResolvedEffectOperation,
    clauses: List<HandlerClause>,
    index: i64,
    expected: TypeRef,
    specializations: List<CallableSpecialization>,
) -> List<CallableSpecialization> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    CallableConstraintLookupCase, SpecializationLookupCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        specializations
    } else {
        let clause = core::list_get(clauses, index);
        let branch_parameters = validate_pattern_list(
            source, module, clause.patterns,
            operation_parameter_types(resolved.parameters, 0, []),
            0, lexical_parameters
        );
        let operation_result = resolve_type(
            source, module,
            substitute_bindings(
                resolved.operation.result_type, resolved.bindings
            )
        );
        let clause_parameters = if(operation_result.kind == SourceType::Never) {
            branch_parameters
        } else {
            core::list_push(branch_parameters, Parameter {
                name: clause.resumption_name,
                span: clause.resumption_span,
                parameter_type: TypeRef {
                    kind: SourceType::Resumption(operation_result, expected),
                    span: clause.resumption_span,
                },
                is_local: true,
                drop_flag: "",
                llvm_name: "%resumption_" + clause.resumption_name,
            })
        };
        collect_handler_clause_specializations(
            source, module, lexical_parameters, resolved, clauses, index + 1,
            expected,
            collect_expression_specializations(
                source, module, clause_parameters, clause.body, expected,
                specializations
            )
        )
    }
}

collect_list_specializations(
    source: SourceFile, module: Module, parameters: List<Parameter>,
    items: List<Expression>, element: TypeRef, index: i64,
    specializations: List<CallableSpecialization>,
) -> List<CallableSpecialization> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, SpecializationLookupCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(items)) {
        specializations
    } else {
        collect_list_specializations(
            source, module, parameters, items, element, index + 1,
            collect_expression_specializations(
                source, module, parameters, core::list_get(items, index),
                element, specializations
            )
        )
    }
}

collect_expression_specializations(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    expected: TypeRef,
    specializations: List<CallableSpecialization>,
) -> List<CallableSpecialization> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    SpecializationLookupCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    let expected = resolve_type(source, module, expected);
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, span)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::List(element)) =>
                    collect_list_specializations(
                        source, module, parameters, items, element, 0,
                        specializations
                    ),
                TypeCase::inspect(_) => compiler_error(
                    source, "GRC9001", "list specialization invariant violated",
                    span, "list literal has a non-list expected type", [],
                    "validated list literals preserve their element context",
                    "report this compiler bug"
                )
            }
        },
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            collect_expression_specializations(
                source, module, parameters, value,
                infer_expression_type(source, module, parameters, value),
                specializations
            ),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            collect_expression_specializations(
                source, module, parameters, value,
                infer_expression_type(source, module, parameters, value),
                specializations
            ),
        ExpressionCase::expression(Expression::Destroy(value, _)) =>
            collect_expression_specializations(
                source, module, parameters, value,
                infer_expression_type(source, module, parameters, value),
                specializations
            ),
        ExpressionCase::expression(Expression::ConsumeAvailable(available, _)) =>
            collect_expression_specializations(
                source, module, parameters, available,
                infer_expression_type(source, module, parameters, available),
                specializations
            ),
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            collect_expression_specializations(
                source, module, parameters, operand, expected, specializations
            ),
        ExpressionCase::expression(Expression::Binary(operator, left, right, span)) => {
            let operand_type = if(operator_is_comparison(operator)) {
                comparison_expression_operand_type(
                    source, module, parameters, operator, left, right, span
                )
            } else {
                expected
            };
            let after_left = collect_expression_specializations(
                source, module, parameters, left, operand_type, specializations
            );
            collect_expression_specializations(
                source, module, parameters, right, operand_type, after_left
            )
        },
        ExpressionCase::expression(Expression::Call("resume", _, _)) =>
            specializations,
        ExpressionCase::expression(Expression::Call("cancel", _, _)) =>
            specializations,
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            handle perform ParameterLookupCase::lookup(
                lookup_parameter(parameters, name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(_)) =>
                    specializations,
                ParameterLookupCase::lookup(ParameterLookup::Missing) => {
            let callable = resolve_callable(source, module, name, span);
            let bindings = if(core::list_len(callable.type_parameters) > 0) {
                infer_call_bindings(
                    source,
                    module,
                    parameters,
                    arguments,
                    callable,
                    expected,
                    span
                )
            } else {
                []
            };
            let call_parameters = specialize_parameters(
                callable.parameters,
                bindings,
                0,
                []
            );
            let after_arguments = collect_argument_specializations(
                source,
                module,
                parameters,
                arguments,
                call_parameters,
                0,
                specializations
            );
            if(compiler_core_intrinsic(name)) {
                after_arguments
            } else {
            if(core::list_len(callable.type_parameters) > 0) {
                let suffix = specialization_suffix(
                    callable.type_parameters,
                    bindings,
                    0,
                    ""
                );
                handle perform SpecializationLookupCase::lookup(
                    lookup_specialization(after_arguments, name, suffix, 0)
                ) {
                    SpecializationLookupCase::lookup(SpecializationLookup::Found) =>
                        after_arguments,
                    SpecializationLookupCase::lookup(SpecializationLookup::Missing) => {
                        let with_specialization = core::list_push(
                            after_arguments,
                            CallableSpecialization {
                                callable: callable,
                                bindings: bindings,
                                suffix: suffix,
                            }
                        );
                        collect_expression_specializations(
                            source,
                            module,
                            call_parameters,
                            callable.body,
                            resolve_type(
                                source,
                                module,
                                substitute_bindings(callable.result_type, bindings)
                            ),
                            with_specialization
                        )
                    }
                }
            } else {
                after_arguments
            }
            }
                }
            }
        },
        ExpressionCase::expression(Expression::Field(subject, _, _)) => {
            let subject_type = infer_expression_type(source, module, parameters, subject);
            collect_expression_specializations(
                source, module, parameters, subject, subject_type, specializations
            )
        },
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, _
        )) => {
            let first = core::list_get(clauses, 0);
            let resolved = resolve_handler_operation_declaration(
                source, module, first.effect_name, first.operation_name,
                first.span
            );
            collect_handler_clause_specializations(
                source, module, parameters, resolved, clauses, 0, expected,
                collect_expression_specializations(
                    source, module, parameters, computation, expected,
                    specializations
                )
            )
        },
        ExpressionCase::expression(Expression::Block(statements, _)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Callable(output, _)) =>
                    collect_block_specializations(
                        source,
                        module,
                        parameters,
                        statements,
                        0,
                        output,
                        specializations
                    ),
                TypeCase::inspect(_) => collect_block_specializations(
                    source,
                    module,
                    parameters,
                    statements,
                    0,
                    expected,
                    specializations
                )
            }
        },
        ExpressionCase::expression(_) => specializations
    }
}

collect_callable_specializations(
    source: SourceFile,
    module: Module,
    index: i64,
    specializations: List<CallableSpecialization>,
) -> List<CallableSpecialization> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, SpecializationLookupCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(module.callables)) {
        specializations
    } else {
        let callable = core::list_get(module.callables, index);
        if(core::list_len(callable.type_parameters) > 0) {
            collect_callable_specializations(source, module, index + 1, specializations)
        } else {
            collect_callable_specializations(
                source,
                module,
                index + 1,
                collect_expression_specializations(
                    source,
                    module,
                    callable.parameters,
                    callable.body,
                    callable.result_type,
                    specializations
                )
            )
        }
    }
}

collect_drop_specializations(
    source: SourceFile,
    module: Module,
    index: i64,
    specializations: List<CallableSpecialization>,
) -> List<CallableSpecialization> / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, SpecializationLookupCase,
    EffectLookupCase, EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(module.drop_declarations)) {
        specializations
    } else {
        let callable = drop_callable(
            source, module, core::list_get(module.drop_declarations, index)
        );
        collect_drop_specializations(
            source,
            module,
            index + 1,
            collect_expression_specializations(
                source,
                module,
                callable.parameters,
                callable.body,
                callable.result_type,
                specializations
            )
        )
    }
}

callable_parameter_drop_flags(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    body: Expression,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, ExpressionCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase, CallableConstraintLookupCase,
    BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        let resolved_type = resolve_type(
            source, module, parameter.parameter_type
        );
        let uses = owned_value_uses_expression(
            source, module, body, parameter.name
        );
        let drop_flag = if(uses.lower == 0 and type_needs_drop_glue(
            source, module, resolved_type, []
        )) {
            "%drop_active_arg_" + parameter.name + "_" +
                core::int_to_string(parameter.span.start)
        } else {
            ""
        };
        callable_parameter_drop_flags(
            source,
            module,
            parameters,
            body,
            index + 1,
            core::list_push(output, Parameter {
                name: parameter.name,
                span: parameter.span,
                parameter_type: resolved_type,
                is_local: parameter.is_local,
                drop_flag: drop_flag,
                llvm_name: parameter.llvm_name,
            })
        )
    }
}

effectful_parameter_drop_flags(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        let resolved_type = resolve_type(
            source, module, parameter.parameter_type
        );
        let drop_flag = if(type_needs_drop_glue(
            source, module, resolved_type, []
        )) {
            "%drop_active_arg_" + parameter.name + "_" +
                core::int_to_string(parameter.span.start)
        } else {
            ""
        };
        effectful_parameter_drop_flags(
            source,
            module,
            parameters,
            index + 1,
            core::list_push(output, Parameter {
                name: parameter.name,
                span: parameter.span,
                parameter_type: resolved_type,
                is_local: parameter.is_local,
                drop_flag: drop_flag,
                llvm_name: parameter.llvm_name,
            })
        )
    }
}

parameters_with_drop_flags(
    parameters: List<Parameter>,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        parameters_with_drop_flags(
            parameters,
            index + 1,
            if(parameter.drop_flag == "") {
                output
            } else {
                core::list_push(output, parameter)
            }
        )
    }
}

parameters_with_drop_flags_after(
    parameters: List<Parameter>,
    minimum_index: i64,
    index: i64,
    output: List<Parameter>,
) -> List<Parameter> / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        parameters_with_drop_flags_after(
            parameters,
            minimum_index,
            index + 1,
            if(index >= minimum_index and parameter.drop_flag != "") {
                core::list_push(output, parameter)
            } else {
                output
            }
        )
    }
}

ownership_release_plan(
    parameters: List<Parameter>,
    index: i64,
    releases: List<OwnershipReleaseState>,
) -> OwnershipPlan / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        OwnershipPlan { destroys: [], releases: releases }
    } else {
        let parameter = core::list_get(parameters, index);
        ownership_release_plan(
            parameters,
            index + 1,
            if(parameter.drop_flag == "") {
                releases
            } else {
                core::list_push(releases, OwnershipReleaseState {
                    state: parameter.drop_flag,
                })
            }
        )
    }
}

lower_effectful_owner_cleanup(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    symbol: String,
    lowered: LoweredEffectfulBody,
) -> LoweredEffectfulBody / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    let captures = parameters_with_drop_flags(parameters, 0, []);
    if(core::list_len(captures) == 0) {
        lowered
    } else {
        let drop_symbol = "@grandiose_effect_owner_drop_" + symbol;
        let environment = lower_heap_continuation_environment(
            source, module, captures, lowered.next_temporary
        );
        let shared = lower_shared_environment(
            environment.pointer, drop_symbol, environment.next_temporary
        );
        let first = core::list_get(captures, 0);
        let released = lower_ownership_plan(
            source,
            module,
            ownership_release_plan(captures, 0, []),
            0,
            first.parameter_type,
            first.llvm_name,
            shared.next_temporary,
            ""
        );
        let cleaned = "%t" + core::int_to_string(shared.next_temporary);
        LoweredEffectfulBody {
            definitions: lowered.definitions +
                lower_capture_environment_drop_definition(
                    source, module, captures, drop_symbol
                ),
            instructions: lowered.instructions + environment.instructions +
                shared.instructions + released.instructions +
                "  " + cleaned +
                    " = call %grandiose.effect_step @grandiose_cleanup_step(" +
                    "%grandiose.effect_step " + lowered.value + ", ptr " +
                    shared.pointer + ")\n",
            value: cleaned,
            next_temporary: shared.next_temporary + 1,
        }
    }
}

lower_parameter_drop_flag_initializers(
    parameters: List<Parameter>,
    index: i64,
    output: String,
) -> String / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        output
    } else {
        let parameter = core::list_get(parameters, index);
        lower_parameter_drop_flag_initializers(
            parameters,
            index + 1,
            output + (if(parameter.drop_flag == "") { "" } else {
                "  " + parameter.drop_flag +
                    " = call ptr @grandiose_new_drop_state()\n"
            })
        )
    }
}

lower_parameter_cleanups(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    index: i64,
    next_temporary: i64,
    instructions: String,
) -> LoweredExpression / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index < 0) {
        LoweredExpression {
            instructions: instructions,
            value: "{}",
            next_temporary: next_temporary,
        }
    } else {
        let parameter = core::list_get(parameters, index);
        if(parameter.drop_flag == "") {
            lower_parameter_cleanups(
                source, module, parameters, index - 1,
                next_temporary, instructions
            )
        } else {
            let destroyed = lower_ownership_plan(
                source,
                module,
                ownership_root_destroy_plan(
                    parameter.parameter_type, parameter.drop_flag
                ),
                0,
                parameter.parameter_type,
                parameter.llvm_name,
                next_temporary,
                ""
            );
            lower_parameter_cleanups(
                source, module, parameters, index - 1,
                destroyed.next_temporary,
                instructions + destroyed.instructions
            )
        }
    }
}

lower_callable(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
) -> String / {
    ExpressionCase, OperatorCase, LookupCase, TypeCase, TypeAliasLookupCase,
    StructLookupCase, EnumLookupCase, CallableConstraintLookupCase,
    BlockStatementCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let result_type = resolve_type(source, module, callable.result_type);
    let parameters = callable_parameter_drop_flags(
        source, module, callable.parameters, callable.body, 0, []
    );
    let lowered = lower_expression(
        source,
        module,
        parameters,
        callable.body,
        result_type,
        0
    );
    let cleaned = lower_parameter_cleanups(
        source,
        module,
        parameters,
        core::list_len(parameters) - 1,
        lowered.next_temporary,
        ""
    );
    "define " + type_name(result_type.kind) + " @grandiose_" + callable.name +
    "(" + lower_parameters(source, module, parameters, 0, "") + ") {\n" +
    "entry:\n" +
    lower_parameter_drop_flag_initializers(parameters, 0, "") +
    lowered.instructions + cleaned.instructions +
    "  ret " + type_name(result_type.kind) + " " + lowered.value + "\n" +
    "}\n\n"
}

effect_declaration_index(
    declarations: List<EffectDecl>,
    name: String,
    index: i64,
) -> i64 / {ResultCase} {
    let declaration = core::list_get(declarations, index);
    if(declaration.name == name) {
        index
    } else {
        effect_declaration_index(declarations, name, index + 1)
    }
}

effect_operation_index(
    operations: List<EffectOperationDecl>,
    name: String,
    index: i64,
) -> i64 / {ResultCase} {
    let operation = core::list_get(operations, index);
    if(operation.name == name) {
        index
    } else {
        effect_operation_index(operations, name, index + 1)
    }
}

lower_done_effect_step(
    result_type: TypeRef,
    lowered: LoweredExpression,
) -> LoweredEffectfulBody / {TypeCase} {
    let size_pointer = "%t" + core::int_to_string(lowered.next_temporary);
    let size = "%t" + core::int_to_string(lowered.next_temporary + 1);
    let box = "%t" + core::int_to_string(lowered.next_temporary + 2);
    let step0 = "%t" + core::int_to_string(lowered.next_temporary + 3);
    let step1 = "%t" + core::int_to_string(lowered.next_temporary + 4);
    let step2 = "%t" + core::int_to_string(lowered.next_temporary + 5);
    let step3 = "%t" + core::int_to_string(lowered.next_temporary + 6);
    let step4 = "%t" + core::int_to_string(lowered.next_temporary + 7);
    let step5 = "%t" + core::int_to_string(lowered.next_temporary + 8);
    let step6 = "%t" + core::int_to_string(lowered.next_temporary + 9);
    let step7 = "%t" + core::int_to_string(lowered.next_temporary + 10);
    let step8 = "%t" + core::int_to_string(lowered.next_temporary + 11);
    LoweredEffectfulBody {
        definitions: "",
        instructions: lowered.instructions +
            "  " + size_pointer + " = getelementptr " +
                type_name(result_type.kind) + ", ptr null, i32 1\n" +
            "  " + size + " = ptrtoint ptr " + size_pointer + " to i64\n" +
            "  " + box + " = call ptr @malloc(i64 " + size + ")\n" +
            "  store " + type_name(result_type.kind) + " " + lowered.value +
                ", ptr " + box + "\n" +
            "  " + step0 + " = insertvalue %grandiose.effect_step undef, i1 true, 0\n" +
            "  " + step1 + " = insertvalue %grandiose.effect_step " + step0 +
                ", i64 0, 1\n" +
            "  " + step2 + " = insertvalue %grandiose.effect_step " + step1 +
                ", i64 0, 2\n" +
            "  " + step3 + " = insertvalue %grandiose.effect_step " + step2 +
                ", ptr null, 3\n" +
            "  " + step4 + " = insertvalue %grandiose.effect_step " + step3 +
                ", ptr null, 4\n" +
            "  " + step5 + " = insertvalue %grandiose.effect_step " + step4 +
                ", ptr null, 5\n" +
            "  " + step6 + " = insertvalue %grandiose.effect_step " + step5 +
                ", ptr " + box + ", 6\n" +
            "  " + step7 + " = insertvalue %grandiose.effect_step " + step6 +
                ", i64 0, 7\n" +
            "  " + step8 + " = insertvalue %grandiose.effect_step " + step7 +
                ", ptr null, 8\n",
        value: step8,
        next_temporary: lowered.next_temporary + 12,
    }
}

lower_completed_effect_step_value(
    result_type: TypeRef,
    lowered: LoweredEffectfulBody,
) -> LoweredExpression / {ResultCase, TypeCase} {
    let completed = "%t" +
        core::int_to_string(lowered.next_temporary);
    let box = "%t" +
        core::int_to_string(lowered.next_temporary + 1);
    let value = "%t" +
        core::int_to_string(lowered.next_temporary + 2);
    LoweredExpression {
        instructions: lowered.instructions +
            "  " + completed +
                " = extractvalue %grandiose.effect_step " + lowered.value +
                ", 0\n" +
            "  " + box +
                " = extractvalue %grandiose.effect_step " + lowered.value +
                ", 6\n" +
            "  " + value + " = load " + type_name(result_type.kind) +
                ", ptr " + box + "\n" +
            "  call void @free(ptr " + box + ")\n",
        value: value,
        next_temporary: lowered.next_temporary + 3,
    }
}

lower_effect_payload_values(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    arguments: List<Expression>,
    operation_parameters: List<Parameter>,
    index: i64,
    payload_type: String,
    next_temporary: i64,
    instructions: String,
    aggregate: String,
) -> LoweredClosureEnvironment / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        let size_pointer = "%t" + core::int_to_string(next_temporary);
        let size = "%t" + core::int_to_string(next_temporary + 1);
        let pointer = "%t" + core::int_to_string(next_temporary + 2);
        LoweredClosureEnvironment {
            instructions: instructions +
                "  " + size_pointer + " = getelementptr " + payload_type +
                    ", ptr null, i32 1\n" +
                "  " + size + " = ptrtoint ptr " + size_pointer + " to i64\n" +
                "  " + pointer + " = call ptr @malloc(i64 " + size + ")\n" +
                "  store " + payload_type + " " + aggregate + ", ptr " +
                    pointer + "\n",
            pointer: pointer,
            next_temporary: next_temporary + 3,
        }
    } else {
        let parameter = core::list_get(operation_parameters, index);
        let parameter_type = resolve_type(
            source, module, parameter.parameter_type
        );
        let lowered = lower_expression(
            source, module, lexical_parameters,
            core::list_get(arguments, index), parameter_type, next_temporary
        );
        let aggregate_value = "%t" + core::int_to_string(
            lowered.next_temporary
        );
        lower_effect_payload_values(
            source, module, lexical_parameters, arguments,
            operation_parameters, index + 1, payload_type,
            lowered.next_temporary + 1,
            instructions + lowered.instructions +
                "  " + aggregate_value + " = insertvalue " + payload_type +
                " " + aggregate + ", " + type_name(parameter_type.kind) +
                " " + lowered.value + ", " + core::int_to_string(index) + "\n",
            aggregate_value
        )
    }
}

lower_effect_payload(
    source: SourceFile,
    module: Module,
    lexical_parameters: List<Parameter>,
    arguments: List<Expression>,
    operation_parameters: List<Parameter>,
    next_temporary: i64,
) -> LoweredClosureEnvironment / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, Diagnostics
} {
    if(core::list_len(arguments) == 0) {
        LoweredClosureEnvironment {
            instructions: "",
            pointer: "null",
            next_temporary: next_temporary,
        }
    } else {
        lower_effect_payload_values(
            source, module, lexical_parameters, arguments,
            operation_parameters, 0,
            closure_environment_type(
                source, module, operation_parameters, 0, ""
            ),
            next_temporary, "", "undef"
        )
    }
}

lower_perform_effect_step(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    resume_symbol: String,
    effect_name: String,
    operation_name: String,
    arguments: List<Expression>,
    span: SourceSpan,
    next_temporary: i64,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let resolved = resolve_perform_operation(
        source, module, parameters, effect_name, operation_name,
        arguments, span
    );
    let payload = lower_effect_payload(
        source, module, parameters, arguments, resolved.parameters,
        next_temporary
    );
    let effect_id = effect_declaration_index(module.effects, effect_name, 0);
    let operation_id = effect_operation_index(
        resolved.effect.operations, operation_name, 0
    );
    let step0 = "%t" + core::int_to_string(payload.next_temporary);
    let step1 = "%t" + core::int_to_string(payload.next_temporary + 1);
    let step2 = "%t" + core::int_to_string(payload.next_temporary + 2);
    let step3 = "%t" + core::int_to_string(payload.next_temporary + 3);
    let step4 = "%t" + core::int_to_string(payload.next_temporary + 4);
    let step5 = "%t" + core::int_to_string(payload.next_temporary + 5);
    let step6 = "%t" + core::int_to_string(payload.next_temporary + 6);
    let step7 = "%t" + core::int_to_string(payload.next_temporary + 7);
    let step8 = "%t" + core::int_to_string(payload.next_temporary + 8);
    LoweredEffectfulBody {
        definitions:
            "define %grandiose.effect_step " + resume_symbol +
                "(ptr %environment, ptr %value) {\n" +
            "entry:\n" +
            "  %r0 = insertvalue %grandiose.effect_step undef, i1 true, 0\n" +
            "  %r1 = insertvalue %grandiose.effect_step %r0, i64 0, 1\n" +
            "  %r2 = insertvalue %grandiose.effect_step %r1, i64 0, 2\n" +
            "  %r3 = insertvalue %grandiose.effect_step %r2, ptr null, 3\n" +
            "  %r4 = insertvalue %grandiose.effect_step %r3, ptr null, 4\n" +
            "  %r5 = insertvalue %grandiose.effect_step %r4, ptr null, 5\n" +
            "  %r6 = insertvalue %grandiose.effect_step %r5, ptr %value, 6\n" +
            "  %r7 = insertvalue %grandiose.effect_step %r6, i64 0, 7\n" +
            "  %r8 = insertvalue %grandiose.effect_step %r7, ptr null, 8\n" +
            "  ret %grandiose.effect_step %r8\n" +
            "}\n\n",
        instructions: payload.instructions +
            "  " + step0 + " = insertvalue %grandiose.effect_step undef, i1 false, 0\n" +
            "  " + step1 + " = insertvalue %grandiose.effect_step " + step0 +
                ", i64 " + core::int_to_string(effect_id) + ", 1\n" +
            "  " + step2 + " = insertvalue %grandiose.effect_step " + step1 +
                ", i64 " + core::int_to_string(operation_id) + ", 2\n" +
            "  " + step3 + " = insertvalue %grandiose.effect_step " + step2 +
                ", ptr " + payload.pointer + ", 3\n" +
            "  " + step4 + " = insertvalue %grandiose.effect_step " + step3 +
                ", ptr " + resume_symbol + ", 4\n" +
            "  " + step5 + " = insertvalue %grandiose.effect_step " + step4 +
                ", ptr null, 5\n" +
            "  " + step6 + " = insertvalue %grandiose.effect_step " + step5 +
                ", ptr null, 6\n" +
            "  " + step7 + " = insertvalue %grandiose.effect_step " + step6 +
                ", i64 " + core::int_to_string(
                    resolved.operation.resumption_upper
                ) + ", 7\n" +
            "  " + step8 + " = insertvalue %grandiose.effect_step " + step7 +
                ", ptr @grandiose_drop_noop, 8\n",
        value: step8,
        next_temporary: payload.next_temporary + 9,
    }
}

lower_final_perform_effect_step(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    effect_name: String,
    operation_name: String,
    arguments: List<Expression>,
    span: SourceSpan,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    lower_perform_effect_step(
        source, module, callable.parameters,
        "@grandiose_resume_" + callable.name + "_final",
        effect_name, operation_name, arguments, span, 0
    )
}

lower_effectful_named_call(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    name: String,
    arguments: List<Expression>,
    expected: TypeRef,
    span: SourceSpan,
    next_temporary: i64,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let callable = resolve_callable(source, module, name, span);
    let bindings = if(core::list_len(callable.type_parameters) > 0) {
        infer_call_bindings(
            source, module, parameters, arguments, callable, expected, span
        )
    } else {
        []
    };
    let call_parameters = specialize_parameters(
        callable.parameters, bindings, 0, []
    );
    let suffix = if(core::list_len(callable.type_parameters) > 0) {
        specialization_suffix(callable.type_parameters, bindings, 0, "")
    } else {
        ""
    };
    let lowered_arguments = lower_arguments(
        source, module, parameters, arguments, call_parameters, 0,
        next_temporary, "", ""
    );
    let temporary = "%t" + core::int_to_string(
        lowered_arguments.next_temporary
    );
    LoweredEffectfulBody {
        definitions: "",
        instructions: lowered_arguments.instructions +
            "  " + temporary + " = call %grandiose.effect_step @grandiose_" +
            name + suffix + "(" + lowered_arguments.values + ")\n",
        value: temporary,
        next_temporary: lowered_arguments.next_temporary + 1,
    }
}

lower_heap_capture_values(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    index: i64,
    environment_type: String,
    next_temporary: i64,
    instructions: String,
    aggregate: String,
) -> LoweredClosureEnvironment / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(captures)) {
        let size_pointer = "%t" + core::int_to_string(next_temporary);
        let size = "%t" + core::int_to_string(next_temporary + 1);
        let pointer = "%t" + core::int_to_string(next_temporary + 2);
        LoweredClosureEnvironment {
            instructions: instructions +
                "  " + size_pointer + " = getelementptr " + environment_type +
                    ", ptr null, i32 1\n" +
                "  " + size + " = ptrtoint ptr " + size_pointer + " to i64\n" +
                "  " + pointer + " = call ptr @malloc(i64 " + size + ")\n" +
                "  store " + environment_type + " " + aggregate +
                    ", ptr " + pointer + "\n",
            pointer: pointer,
            next_temporary: next_temporary + 3,
        }
    } else {
        let capture = core::list_get(captures, index);
        let capture_type = resolve_type(source, module, capture.parameter_type);
        let storage_index = closure_capture_storage_index(
            captures, index, 0, 0
        );
        let temporary = "%t" + core::int_to_string(next_temporary);
        let with_value = instructions + "  " + temporary + " = insertvalue " +
                environment_type + " " + aggregate + ", " +
                type_name(capture_type.kind) + " " + capture.llvm_name + ", " +
                core::int_to_string(storage_index) + "\n";
        if(capture.drop_flag == "") {
            lower_heap_capture_values(
                source, module, captures, index + 1, environment_type,
                next_temporary + 1, with_value, temporary
            )
        } else {
            let with_flag = "%t" + core::int_to_string(next_temporary + 1);
            lower_heap_capture_values(
                source, module, captures, index + 1, environment_type,
                next_temporary + 2,
                with_value +
                    "  call void @grandiose_retain_drop_state(ptr " +
                    capture.drop_flag + ")\n" +
                    "  " + with_flag + " = insertvalue " +
                    environment_type + " " + temporary + ", ptr " +
                    capture.drop_flag + ", " +
                    core::int_to_string(storage_index + 1) + "\n",
                with_flag
            )
        }
    }
}

lower_heap_continuation_environment(
    source: SourceFile,
    module: Module,
    captures: List<Parameter>,
    next_temporary: i64,
) -> LoweredClosureEnvironment / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(core::list_len(captures) == 0) {
        LoweredClosureEnvironment {
            instructions: "",
            pointer: "null",
            next_temporary: next_temporary,
        }
    } else {
        lower_heap_capture_values(
            source, module, captures, 0,
            closure_environment_type(source, module, captures, 0, ""),
            next_temporary, "", "undef"
        )
    }
}

lower_shared_environment(
    payload: String,
    drop: String,
    next_temporary: i64,
) -> LoweredClosureEnvironment / {ResultCase} {
    let size_pointer = "%t" + core::int_to_string(next_temporary);
    let size = "%t" + core::int_to_string(next_temporary + 1);
    let pointer = "%t" + core::int_to_string(next_temporary + 2);
    let with_count = "%t" + core::int_to_string(next_temporary + 3);
    let with_payload = "%t" + core::int_to_string(next_temporary + 4);
    let aggregate = "%t" + core::int_to_string(next_temporary + 5);
    LoweredClosureEnvironment {
        instructions:
            "  " + size_pointer +
                " = getelementptr %grandiose.shared_environment, ptr null, i32 1\n" +
            "  " + size + " = ptrtoint ptr " + size_pointer + " to i64\n" +
            "  " + pointer + " = call ptr @malloc(i64 " + size + ")\n" +
            "  " + with_count +
                " = insertvalue %grandiose.shared_environment undef, i64 1, 0\n" +
            "  " + with_payload +
                " = insertvalue %grandiose.shared_environment " + with_count +
                ", ptr " + payload + ", 1\n" +
            "  " + aggregate +
                " = insertvalue %grandiose.shared_environment " + with_payload +
                ", ptr " + drop + ", 2\n" +
            "  store %grandiose.shared_environment " + aggregate + ", ptr " +
                pointer + "\n",
        pointer: pointer,
        next_temporary: next_temporary + 6,
    }
}

effect_bind_definitions(symbol: String) -> String / {ResultCase} {
    let bind_step = "@grandiose_bind_step_" + symbol;
    let bind_resume = "@grandiose_bind_resume_" + symbol;
    let bind_drop = "@grandiose_bind_drop_" + symbol;
    "define %grandiose.effect_step " + bind_step +
        "(%grandiose.effect_step %step, ptr %suffix_function, ptr %suffix_environment) {\n" +
    "entry:\n" +
    "  %b0 = extractvalue %grandiose.effect_step %step, 0\n" +
    "  br i1 %b0, label %done, label %request\n" +
    "done:\n" +
    "  %b1 = extractvalue %grandiose.effect_step %step, 6\n" +
    "  %b_shared = load %grandiose.shared_environment, ptr %suffix_environment\n" +
    "  %b_payload = extractvalue %grandiose.shared_environment %b_shared, 1\n" +
    "  %b2 = call %grandiose.effect_step %suffix_function(ptr %b_payload, ptr %b1)\n" +
    "  call void @grandiose_release_shared_environment(ptr %suffix_environment)\n" +
    "  ret %grandiose.effect_step %b2\n" +
    "request:\n" +
    "  %b3 = extractvalue %grandiose.effect_step %step, 1\n" +
    "  %b4 = extractvalue %grandiose.effect_step %step, 2\n" +
    "  %b5 = extractvalue %grandiose.effect_step %step, 3\n" +
    "  %b6 = extractvalue %grandiose.effect_step %step, 4\n" +
    "  %b7 = extractvalue %grandiose.effect_step %step, 5\n" +
    "  %b_quantity = extractvalue %grandiose.effect_step %step, 7\n" +
    "  %b_drop = extractvalue %grandiose.effect_step %step, 8\n" +
    "  %b8 = getelementptr %grandiose.bind_environment, ptr null, i32 1\n" +
    "  %b9 = ptrtoint ptr %b8 to i64\n" +
    "  %b10 = call ptr @malloc(i64 %b9)\n" +
    "  %b11 = insertvalue %grandiose.bind_environment undef, ptr %b6, 0\n" +
    "  %b12 = insertvalue %grandiose.bind_environment %b11, ptr %b7, 1\n" +
    "  %b13 = insertvalue %grandiose.bind_environment %b12, ptr %suffix_function, 2\n" +
    "  %b14 = insertvalue %grandiose.bind_environment %b13, ptr %suffix_environment, 3\n" +
    "  %b14_quantity = insertvalue %grandiose.bind_environment %b14, i64 %b_quantity, 4\n" +
    "  %b14_drop = insertvalue %grandiose.bind_environment %b14_quantity, ptr %b_drop, 5\n" +
    "  store %grandiose.bind_environment %b14_drop, ptr %b10\n" +
    "  %b15 = insertvalue %grandiose.effect_step undef, i1 false, 0\n" +
    "  %b16 = insertvalue %grandiose.effect_step %b15, i64 %b3, 1\n" +
    "  %b17 = insertvalue %grandiose.effect_step %b16, i64 %b4, 2\n" +
    "  %b18 = insertvalue %grandiose.effect_step %b17, ptr %b5, 3\n" +
    "  %b19 = insertvalue %grandiose.effect_step %b18, ptr " + bind_resume + ", 4\n" +
    "  %b20 = insertvalue %grandiose.effect_step %b19, ptr %b10, 5\n" +
    "  %b21 = insertvalue %grandiose.effect_step %b20, ptr null, 6\n" +
    "  %b22 = insertvalue %grandiose.effect_step %b21, i64 %b_quantity, 7\n" +
    "  %b23 = insertvalue %grandiose.effect_step %b22, ptr " + bind_drop + ", 8\n" +
    "  ret %grandiose.effect_step %b23\n" +
    "}\n\n" +
    "define %grandiose.effect_step " + bind_resume +
        "(ptr %environment, ptr %value) {\n" +
    "entry:\n" +
    "  %r0 = load %grandiose.bind_environment, ptr %environment\n" +
    "  %r1 = extractvalue %grandiose.bind_environment %r0, 0\n" +
    "  %r2 = extractvalue %grandiose.bind_environment %r0, 1\n" +
    "  %r3 = extractvalue %grandiose.bind_environment %r0, 2\n" +
    "  %r4 = extractvalue %grandiose.bind_environment %r0, 3\n" +
    "  %r_count = getelementptr %grandiose.bind_environment, ptr %environment, i32 0, i32 4\n" +
    "  %r_remaining = load i64, ptr %r_count\n" +
    "  %r_last = icmp eq i64 %r_remaining, 1\n" +
    "  call void @grandiose_retain_shared_environment(ptr %r4)\n" +
    "  call void @grandiose_release_resumption_environment(ptr %environment, ptr %r_count)\n" +
    "  call void @grandiose_release_shared_environment_if(i1 %r_last, ptr %r4)\n" +
    "  %r5 = call %grandiose.effect_step %r1(ptr %r2, ptr %value)\n" +
    "  %r6 = tail call %grandiose.effect_step " + bind_step +
        "(%grandiose.effect_step %r5, ptr %r3, ptr %r4)\n" +
    "  ret %grandiose.effect_step %r6\n" +
    "}\n\n" +
    "define void " + bind_drop + "(ptr %environment) {\n" +
    "entry:\n" +
    "  %d0 = load %grandiose.bind_environment, ptr %environment\n" +
    "  %d1 = extractvalue %grandiose.bind_environment %d0, 1\n" +
    "  %d2 = extractvalue %grandiose.bind_environment %d0, 3\n" +
    "  %d3 = extractvalue %grandiose.bind_environment %d0, 5\n" +
    "  call void %d3(ptr %d1)\n" +
    "  call void @grandiose_release_shared_environment(ptr %d2)\n" +
    "  call void @free(ptr %environment)\n" +
    "  ret void\n" +
    "}\n\n"
}

lower_forwarding_clause_step(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    clause: HandlerClause,
    payload_parameters: List<Parameter>,
    payload_owners: List<Parameter>,
    operation_result: TypeRef,
    resume_symbol: String,
    drop_symbol: String,
    next_temporary: i64,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let result_type = resolve_type(source, module, callable.result_type);
    let environment_size_pointer = "%t" +
        core::int_to_string(next_temporary);
    let environment_size = "%t" +
        core::int_to_string(next_temporary + 1);
    let environment = "%t" +
        core::int_to_string(next_temporary + 2);
    let field0 = "%t" + core::int_to_string(next_temporary + 3);
    let field1 = "%t" + core::int_to_string(next_temporary + 4);
    let field2 = "%t" + core::int_to_string(next_temporary + 5);
    let field3 = "%t" + core::int_to_string(next_temporary + 6);
    let field4 = "%t" + core::int_to_string(next_temporary + 7);
    let resumption_handle = "%t" + core::int_to_string(next_temporary + 8);
    let resumption_type = TypeRef {
        kind: SourceType::Resumption(operation_result, result_type),
        span: clause.resumption_span,
    };
    let clause_parameters = core::list_push(
        payload_parameters,
        Parameter {
            name: clause.resumption_name,
            span: clause.resumption_span,
            parameter_type: resumption_type,
            is_local: true,
            drop_flag: "",
            llvm_name: resumption_handle,
        }
    );
    let lowered = lower_step_expression(
        source, module, callable, clause_parameters, clause.body,
        result_type, next_temporary + 9
    );
    let finalized = "%t" +
        core::int_to_string(lowered.next_temporary);
    let finalized_body = LoweredEffectfulBody {
        definitions: lowered.definitions,
        instructions:
            "  " + environment_size_pointer +
                " = getelementptr %grandiose.forward_environment, ptr null, i32 1\n" +
            "  " + environment_size + " = ptrtoint ptr " +
                environment_size_pointer + " to i64\n" +
            "  " + environment + " = call ptr @malloc(i64 " +
                environment_size + ")\n" +
            "  " + field0 +
                " = insertvalue %grandiose.forward_environment undef, ptr %t12, 0\n" +
            "  " + field1 +
                " = insertvalue %grandiose.forward_environment " + field0 +
                ", ptr %t12_env, 1\n" +
            "  " + field2 +
                " = insertvalue %grandiose.forward_environment " + field1 +
                ", ptr %handler_environment, 2\n" +
            "  " + field3 +
                " = insertvalue %grandiose.forward_environment " + field2 +
                ", i64 %t12_quantity, 3\n" +
            "  " + field4 +
                " = insertvalue %grandiose.forward_environment " + field3 +
                ", ptr %t12_drop, 4\n" +
            "  store %grandiose.forward_environment " + field4 + ", ptr " +
                environment + "\n" +
            "  " + resumption_handle +
                " = call ptr @grandiose_new_resumption(ptr " +
                resume_symbol + ", ptr " + environment + ", ptr " +
                drop_symbol + ", i64 %t12_quantity)\n" +
            lowered.instructions +
            "  " + finalized +
                " = call %grandiose.effect_step @grandiose_finalize_resumption_step(" +
                "%grandiose.effect_step " + lowered.value + ", ptr " +
                resumption_handle + ")\n",
        value: finalized,
        next_temporary: lowered.next_temporary + 1,
    };
    lower_effectful_owner_cleanup(
        source,
        module,
        payload_owners,
        "payload_clause_" + core::int_to_string(clause.span.start),
        finalized_body
    )
}

lower_forwarding_handler_clauses(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    lexical_parameters: List<Parameter>,
    clauses: List<HandlerClause>,
    index: i64,
    resolved: ResolvedEffectOperation,
    payload_type: String,
    operation_result: TypeRef,
    resume_symbol: String,
    drop_symbol: String,
    next_temporary: i64,
) -> LoweredRuntimeClauses / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase,
    EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(clauses)) {
        LoweredRuntimeClauses {
            definitions: "",
            instructions: "  br label %unmatched\n",
            next_temporary: next_temporary,
        }
    } else {
        let clause = core::list_get(clauses, index);
        let condition = lower_runtime_pattern_conditions(
            source, module, clause.patterns, resolved.parameters, 0,
            payload_type, "%t14", "true", next_temporary, ""
        );
        let bindings = lower_runtime_payload_patterns(
            source, module, lexical_parameters, clause.patterns,
            resolved.parameters, 0, payload_type, "%t14", "",
            lexical_parameters
        );
        let unbound_cleanup = lower_unbound_payload_values(
            source,
            module,
            clause.patterns,
            resolved.parameters,
            0,
            payload_type,
            "%t14",
            condition.next_temporary,
            ""
        );
        let payload_owners = parameters_with_drop_flags_after(
            bindings.parameters,
            core::list_len(lexical_parameters),
            0,
            []
        );
        let lowered = lower_forwarding_clause_step(
            source, module, callable, clause, bindings.parameters,
            payload_owners,
            operation_result, resume_symbol, drop_symbol,
            unbound_cleanup.next_temporary
        );
        let result_type = resolve_type(
            source, module, callable.result_type
        );
        let closure_parameters = core::list_push(
            bindings.parameters,
            Parameter {
                name: clause.resumption_name,
                span: clause.resumption_span,
                parameter_type: TypeRef {
                    kind: SourceType::Resumption(
                        operation_result, result_type
                    ),
                    span: clause.resumption_span,
                },
                is_local: true,
                drop_flag: "",
                llvm_name: "%captured_resumption_" +
                    core::int_to_string(clause.resumption_span.start),
            }
        );
        let closure_definitions = lower_closure_definitions_expression(
            source, module, closure_parameters, clause.body,
            result_type, ""
        );
        let clause_label = "forward_runtime_clause_" +
            core::int_to_string(clause.span.start);
        let next_label = "forward_runtime_clause_next_" +
            core::int_to_string(clause.span.start);
        let irrefutable = patterns_are_irrefutable(clause.patterns, 0);
        let branch = if(irrefutable) {
            "  br label %" + clause_label + "\n"
        } else {
            "  br i1 " + condition.value + ", label %" + clause_label +
                ", label %" + next_label + "\n"
        };
        let release_payload = if(core::list_len(resolved.parameters) == 0) {
            ""
        } else {
            "  call void @free(ptr %t13)\n"
        };
        if(irrefutable) {
            LoweredRuntimeClauses {
                definitions: closure_definitions + lowered.definitions,
                instructions: condition.instructions + branch + clause_label +
                    ":\n" + release_payload + bindings.instructions +
                    unbound_cleanup.instructions +
                    lowered.instructions +
                    "  ret %grandiose.effect_step " + lowered.value + "\n",
                next_temporary: lowered.next_temporary,
            }
        } else {
            let remaining = lower_forwarding_handler_clauses(
                source, module, callable, lexical_parameters, clauses,
                index + 1, resolved,
                payload_type, operation_result,
                resume_symbol, drop_symbol,
                lowered.next_temporary
            );
            LoweredRuntimeClauses {
                definitions: closure_definitions + lowered.definitions +
                    remaining.definitions,
                instructions: condition.instructions + branch + clause_label +
                    ":\n" + release_payload + bindings.instructions +
                    unbound_cleanup.instructions +
                    lowered.instructions +
                    "  ret %grandiose.effect_step " + lowered.value + "\n" +
                    next_label + ":\n" + remaining.instructions,
                next_temporary: remaining.next_temporary,
            }
        }
    }
}

lower_effectful_forwarding_handler(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    lexical_parameters: List<Parameter>,
    computation_name: String,
    computation_arguments: List<Expression>,
    call_span: SourceSpan,
    clauses: List<HandlerClause>,
    next_temporary: i64,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase,
    EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    let result_type = resolve_type(source, module, callable.result_type);
    lower_effectful_forwarding_handler_step(
        source, module, callable, lexical_parameters,
        lower_effectful_named_call(
            source, module, lexical_parameters, computation_name,
            computation_arguments, result_type, call_span, next_temporary
        ),
        call_span, clauses
    )
}

lower_effectful_forwarding_handler_step(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    lexical_parameters: List<Parameter>,
    initial: LoweredEffectfulBody,
    handler_span: SourceSpan,
    clauses: List<HandlerClause>,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase,
    EffectLookupCase, EffectOperationLookupCase,
    Diagnostics
} {
    let result_type = resolve_type(source, module, callable.result_type);
    let clause = core::list_get(clauses, 0);
    let resolved = resolve_handler_operation_declaration(
        source, module, clause.effect_name, clause.operation_name, clause.span
    );
    let operation_result = resolve_type(
        source, module, resolved.operation.result_type
    );
    let suffix = core::int_to_string(handler_span.start);
    let handler_environment_drop_symbol =
        "@grandiose_handler_capture_drop_" + suffix;
    let handler_environment = lower_heap_continuation_environment(
        source, module, lexical_parameters, initial.next_temporary
    );
    let shared_handler_environment = lower_shared_environment(
        handler_environment.pointer, handler_environment_drop_symbol,
        handler_environment.next_temporary
    );
    let transform_symbol = "@grandiose_forward_handler_" + suffix;
    let resume_symbol = "@grandiose_forward_resume_" + suffix;
    let drop_symbol = "@grandiose_forward_drop_" + suffix;
    let transformed = "%t" +
        core::int_to_string(shared_handler_environment.next_temporary);
    let environment_type = closure_environment_type(
        source, module, lexical_parameters, 0, ""
    );
    let capture_loads = if(core::list_len(lexical_parameters) == 0) {
        ""
    } else {
        "  %handler_shared = load %grandiose.shared_environment, ptr %handler_environment\n" +
        "  %handler_payload = extractvalue %grandiose.shared_environment %handler_shared, 1\n" +
        "  %closure_captures = load " + environment_type +
            ", ptr %handler_payload\n" +
        closure_capture_loads(
            source, module, lexical_parameters, environment_type, 0, ""
        )
    };
    let payload_type = closure_environment_type(
        source, module, resolved.parameters, 0, ""
    );
    let lowered_clauses = lower_forwarding_handler_clauses(
        source, module, callable, lexical_parameters, clauses, 0, resolved,
        payload_type,
        operation_result, resume_symbol, drop_symbol, 15
    );
    let effect_id = effect_declaration_index(
        module.effects, clause.effect_name, 0
    );
    let operation_id = effect_operation_index(
        resolved.effect.operations, clause.operation_name, 0
    );
    let payload_loads = if(core::list_len(resolved.parameters) == 0) {
        ""
    } else {
        "  %t13 = extractvalue %grandiose.effect_step %step, 3\n" +
        "  %t14 = load " + payload_type + ", ptr %t13\n"
    };
    let definitions = initial.definitions + lowered_clauses.definitions +
        lower_capture_environment_drop_definition(
            source, module, lexical_parameters,
            handler_environment_drop_symbol
        ) +
        "define %grandiose.effect_step " + resume_symbol +
            "(ptr %environment, ptr %value) {\n" +
        "entry:\n" +
        "  %r0 = load %grandiose.forward_environment, ptr %environment\n" +
        "  %r1 = extractvalue %grandiose.forward_environment %r0, 0\n" +
        "  %r2 = extractvalue %grandiose.forward_environment %r0, 1\n" +
        "  %r3 = extractvalue %grandiose.forward_environment %r0, 2\n" +
        "  %r_count = getelementptr %grandiose.forward_environment, ptr %environment, i32 0, i32 3\n" +
        "  %r_remaining = load i64, ptr %r_count\n" +
        "  %r_last = icmp eq i64 %r_remaining, 1\n" +
        "  call void @grandiose_retain_shared_environment(ptr %r3)\n" +
        "  call void @grandiose_release_resumption_environment(ptr %environment, ptr %r_count)\n" +
        "  call void @grandiose_release_shared_environment_if(i1 %r_last, ptr %r3)\n" +
        "  %r4 = call %grandiose.effect_step %r1(ptr %r2, ptr %value)\n" +
        "  %r5 = tail call %grandiose.effect_step " + transform_symbol +
            "(%grandiose.effect_step %r4, ptr %r3)\n" +
        "  ret %grandiose.effect_step %r5\n" +
        "}\n\n" +
        "define void " + drop_symbol + "(ptr %environment) {\n" +
        "entry:\n" +
        "  %d0 = load %grandiose.forward_environment, ptr %environment\n" +
        "  %d1 = extractvalue %grandiose.forward_environment %d0, 1\n" +
        "  %d2 = extractvalue %grandiose.forward_environment %d0, 2\n" +
        "  %d3 = extractvalue %grandiose.forward_environment %d0, 4\n" +
        "  call void %d3(ptr %d1)\n" +
        "  call void @grandiose_release_shared_environment(ptr %d2)\n" +
        "  call void @free(ptr %environment)\n" +
        "  ret void\n" +
        "}\n\n" +
        "define %grandiose.effect_step " + transform_symbol +
            "(%grandiose.effect_step %step, ptr %handler_environment) {\n" +
        "entry:\n" + capture_loads +
        "  %t0 = extractvalue %grandiose.effect_step %step, 0\n" +
        "  br i1 %t0, label %done, label %request\n" +
        "done:\n" +
        "  call void @grandiose_release_shared_environment(ptr %handler_environment)\n" +
        "  ret %grandiose.effect_step %step\n" +
        "request:\n" +
        "  %t1 = extractvalue %grandiose.effect_step %step, 1\n" +
        "  %t2 = extractvalue %grandiose.effect_step %step, 2\n" +
        "  %t3 = icmp eq i64 %t1, " + core::int_to_string(effect_id) + "\n" +
        "  %t4 = icmp eq i64 %t2, " + core::int_to_string(operation_id) + "\n" +
        "  %t5 = and i1 %t3, %t4\n" +
        "  br i1 %t5, label %matched, label %unmatched\n" +
        "unmatched:\n" +
        "  %t6 = extractvalue %grandiose.effect_step %step, 3\n" +
        "  %t7 = extractvalue %grandiose.effect_step %step, 4\n" +
        "  %t8 = extractvalue %grandiose.effect_step %step, 5\n" +
        "  %t_quantity = extractvalue %grandiose.effect_step %step, 7\n" +
        "  %t_drop = extractvalue %grandiose.effect_step %step, 8\n" +
        "  %t9 = getelementptr %grandiose.forward_environment, ptr null, i32 1\n" +
        "  %t10 = ptrtoint ptr %t9 to i64\n" +
        "  %t11 = call ptr @malloc(i64 %t10)\n" +
        "  %f0 = insertvalue %grandiose.forward_environment undef, ptr %t7, 0\n" +
        "  %f1 = insertvalue %grandiose.forward_environment %f0, ptr %t8, 1\n" +
        "  %f2 = insertvalue %grandiose.forward_environment %f1, ptr %handler_environment, 2\n" +
        "  %f3 = insertvalue %grandiose.forward_environment %f2, i64 %t_quantity, 3\n" +
        "  %f4 = insertvalue %grandiose.forward_environment %f3, ptr %t_drop, 4\n" +
        "  store %grandiose.forward_environment %f4, ptr %t11\n" +
        "  %s0 = insertvalue %grandiose.effect_step undef, i1 false, 0\n" +
        "  %s1 = insertvalue %grandiose.effect_step %s0, i64 %t1, 1\n" +
        "  %s2 = insertvalue %grandiose.effect_step %s1, i64 %t2, 2\n" +
        "  %s3 = insertvalue %grandiose.effect_step %s2, ptr %t6, 3\n" +
        "  %s4 = insertvalue %grandiose.effect_step %s3, ptr " + resume_symbol + ", 4\n" +
        "  %s5 = insertvalue %grandiose.effect_step %s4, ptr %t11, 5\n" +
        "  %s6 = insertvalue %grandiose.effect_step %s5, ptr null, 6\n" +
        "  %s7 = insertvalue %grandiose.effect_step %s6, i64 %t_quantity, 7\n" +
        "  %s8 = insertvalue %grandiose.effect_step %s7, ptr " + drop_symbol + ", 8\n" +
        "  ret %grandiose.effect_step %s8\n" +
        "matched:\n" +
        "  %t12 = extractvalue %grandiose.effect_step %step, 4\n" +
        "  %t12_env = extractvalue %grandiose.effect_step %step, 5\n" +
        "  %t12_quantity = extractvalue %grandiose.effect_step %step, 7\n" +
        "  %t12_drop = extractvalue %grandiose.effect_step %step, 8\n" +
        payload_loads + lowered_clauses.instructions +
        "}\n\n";
    LoweredEffectfulBody {
        definitions: definitions,
        instructions: initial.instructions + handler_environment.instructions +
            shared_handler_environment.instructions +
            "  " + transformed + " = call %grandiose.effect_step " +
            transform_symbol + "(%grandiose.effect_step " + initial.value +
            ", ptr " + shared_handler_environment.pointer + ")\n",
        value: transformed,
        next_temporary: shared_handler_environment.next_temporary + 1,
    }
}

block_statement_requires_step(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
) -> Bool / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(statements)) {
        false
    } else {
        handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, name_span, local_type, value, _
            )) => {
                if(expression_requires_step(
                    source, module, parameters, value
                )) {
                    true
                } else {
                    block_statement_requires_step(
                        source,
                        module,
                        core::list_push(parameters, Parameter {
                            name: name,
                            span: name_span,
                            parameter_type: local_type,
                            is_local: true,
                            drop_flag: "",
                            llvm_name: "",
                        }),
                        statements,
                        index + 1
                    )
                }
            },
            BlockStatementCase::inspect(BlockStatement::Value(value)) => {
                if(expression_requires_step(
                    source, module, parameters, value
                )) {
                    true
                } else {
                    block_statement_requires_step(
                        source, module, parameters, statements, index + 1
                    )
                }
            }
        }
    }
}

expression_list_requires_step(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expressions: List<Expression>,
    index: i64,
) -> Bool / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        false
    } else {
        if(expression_requires_step(
            source, module, parameters, core::list_get(expressions, index)
        )) {
            true
        } else {
            expression_list_requires_step(
                source, module, parameters, expressions, index + 1
            )
        }
    }
}

call_arguments_require_step(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expressions: List<Expression>,
    expected: List<Parameter>,
    index: i64,
) -> Bool / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        false
    } else {
        let expression = core::list_get(expressions, index);
        let delayed = handle perform TypeCase::inspect(
            core::list_get(expected, index).parameter_type.kind
        ) {
            TypeCase::inspect(SourceType::Callable(_, _)) => {
                handle perform ExpressionCase::expression(expression) {
                    ExpressionCase::expression(Expression::Block(_, _)) => true,
                    ExpressionCase::expression(_) => false
                }
            },
            TypeCase::inspect(_) => false
        };
        if(delayed == false and expression_requires_step(
            source, module, parameters, expression
        )) {
            true
        } else {
            call_arguments_require_step(
                source, module, parameters, expressions, expected, index + 1
            )
        }
    }
}

named_expression_list_requires_step(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expressions: List<NamedExpression>,
    index: i64,
) -> Bool / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(expressions)) {
        false
    } else {
        if(expression_requires_step(
            source, module, parameters,
            core::list_get(expressions, index).value
        )) {
            true
        } else {
            named_expression_list_requires_step(
                source, module, parameters, expressions, index + 1
            )
        }
    }
}

step_struct_fields(
    source: SourceFile,
    declaration: StructDecl,
    type_arguments: List<TypeRef>,
    supplied: List<NamedExpression>,
    struct_span: SourceSpan,
    index: i64,
    statements: List<BlockStatement>,
    fields: List<NamedExpression>,
) -> StepStructFields / {
    ResultCase, ExpressionCase, TypeCase, StructFieldLookupCase, Diagnostics
} {
    if(index >= core::list_len(supplied)) {
        StepStructFields {
            statements: statements,
            fields: fields,
        }
    } else {
        let supplied_field = core::list_get(supplied, index);
        let declaration_field = handle perform StructFieldLookupCase::lookup(
            lookup_struct_field(
                declaration.fields, supplied_field.name, 0
            )
        ) {
            StructFieldLookupCase::lookup(StructFieldLookup::Found(found)) => found,
            StructFieldLookupCase::lookup(StructFieldLookup::Missing) =>
                compiler_error(
                    source, "GRC9001", "backend invariant violated",
                    supplied_field.name_span,
                    "validated struct field is unavailable during step lowering",
                    [], "semantic validation precedes continuation lowering",
                    "report this compiler bug"
                )
        };
        let value_span = expression_span(supplied_field.value);
        let local_name = "__step_field_" +
            core::int_to_string(struct_span.start) + "_" +
            core::int_to_string(index);
        step_struct_fields(
            source, declaration, type_arguments, supplied, struct_span,
            index + 1,
            core::list_push(
                statements,
                BlockStatement::Let(
                    local_name, value_span,
                    substitute_type(
                        declaration_field.field_type,
                        declaration.type_parameters,
                        type_arguments
                    ),
                    supplied_field.value, value_span
                )
            ),
            core::list_push(
                fields,
                NamedExpression {
                    name: supplied_field.name,
                    name_span: supplied_field.name_span,
                    value: Expression::Variable(local_name, value_span),
                }
            )
        )
    }
}

step_call_arguments(
    arguments: List<Expression>,
    expected: List<Parameter>,
    call_span: SourceSpan,
    index: i64,
    statements: List<BlockStatement>,
    variables: List<Expression>,
) -> StepCallArguments / {ResultCase, ExpressionCase} {
    if(index >= core::list_len(arguments)) {
        StepCallArguments {
            statements: statements,
            arguments: variables,
        }
    } else {
        let argument = core::list_get(arguments, index);
        let span = expression_span(argument);
        let name = "__step_argument_" +
            core::int_to_string(call_span.start) + "_" +
            core::int_to_string(index);
        step_call_arguments(
            arguments,
            expected,
            call_span,
            index + 1,
            core::list_push(
                statements,
                BlockStatement::Let(
                    name, span,
                    core::list_get(expected, index).parameter_type,
                    argument, span
                )
            ),
            core::list_push(
                variables,
                Expression::Variable(name, span)
            )
        )
    }
}

expression_requires_step(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
) -> Bool / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, _)) =>
            expression_list_requires_step(
                source, module, parameters, items, 0
            ),
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            expression_requires_step(source, module, parameters, value),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            expression_requires_step(source, module, parameters, value),
        ExpressionCase::expression(Expression::Destroy(value, _)) =>
            expression_requires_step(source, module, parameters, value),
        ExpressionCase::expression(Expression::ConsumeAvailable(available, _)) =>
            expression_requires_step(source, module, parameters, available),
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            expression_requires_step(source, module, parameters, operand),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            expression_requires_step(source, module, parameters, left) or
                expression_requires_step(source, module, parameters, right),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            expression_requires_step(source, module, parameters, subject),
        ExpressionCase::expression(Expression::StructValue(
            _, fields, _
        )) => named_expression_list_requires_step(
            source, module, parameters, fields, 0
        ),
        ExpressionCase::expression(Expression::EnumValue(
            _, _, arguments, _
        )) => expression_list_requires_step(
            source, module, parameters, arguments, 0
        ),
        ExpressionCase::expression(Expression::Perform(_, _, _, _)) => true,
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            if(name == "resume" or name == "cancel") {
                true
            } else {
                handle perform ParameterLookupCase::lookup(
                    lookup_parameter(parameters, name, 0)
                ) {
                    ParameterLookupCase::lookup(ParameterLookup::Found(parameter)) => {
                        let argument_step = expression_list_requires_step(
                            source, module, parameters, arguments, 0
                        );
                        handle perform TypeCase::inspect(
                            parameter.parameter_type.kind
                        ) {
                            TypeCase::inspect(SourceType::Callable(
                                _, effectful
                            )) => effectful or argument_step,
                            TypeCase::inspect(_) => argument_step
                        }
                    },
                    ParameterLookupCase::lookup(ParameterLookup::Missing) =>
                        core::list_len(resolve_callable(
                            source, module, name, span
                        ).effects) > 0 or expression_list_requires_step(
                            source, module, parameters, arguments, 0
                        )
                }
            }
        },
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, handler_span
        )) => {
            let clause_step = handler_clause_bodies_require_step(
                source, module, parameters, clauses, 0
            );
            handle perform ExpressionCase::expression(computation) {
                ExpressionCase::expression(Expression::Perform(_, _, _, _)) =>
                    clause_step,
                ExpressionCase::expression(_) => clause_step or
                    expression_requires_step(
                        source, module, parameters, computation
                    )
            }
        },
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            block_statement_requires_step(
                source, module, parameters, statements, 0
            ),
        ExpressionCase::expression(_) => false
    }
}

typed_core_expression(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    expected: TypeRef,
) -> TypedCoreExpression / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, BlockStatementCase,
    Diagnostics
} {
    TypedCoreExpression {
        expression: expression,
        value_type: resolve_type(source, module, expected),
        requires_step: expression_requires_step(
            source, module, parameters, expression
        ),
        place: place_provenance(expression),
    }
}

handler_clause_bodies_require_step(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    clauses: List<HandlerClause>,
    index: i64,
) -> Bool / {
    ResultCase, ExpressionCase, LookupCase, ParameterLookupCase, TypeCase,
    BlockStatementCase
} {
    if(index >= core::list_len(clauses)) {
        false
    } else {
        if(expression_requires_step(
            source, module, parameters, core::list_get(clauses, index).body
        )) {
            true
        } else {
            handler_clause_bodies_require_step(
                source, module, parameters, clauses, index + 1
            )
        }
    }
}

expression_list_mentions_name(
    expressions: List<Expression>,
    name: String,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(expressions)) {
        false
    } else {
        expression_mentions_name(core::list_get(expressions, index), name) or
            expression_list_mentions_name(expressions, name, index + 1)
    }
}

named_expression_list_mentions_name(
    expressions: List<NamedExpression>,
    name: String,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(expressions)) {
        false
    } else {
        expression_mentions_name(
            core::list_get(expressions, index).value, name
        ) or named_expression_list_mentions_name(
            expressions, name, index + 1
        )
    }
}

block_mentions_name(
    statements: List<BlockStatement>,
    name: String,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(statements)) {
        false
    } else {
        let expression = handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                _, _, _, value, _
            )) => value,
            BlockStatementCase::inspect(BlockStatement::Value(value)) => value
        };
        expression_mentions_name(expression, name) or
            block_mentions_name(statements, name, index + 1)
    }
}

handler_clause_list_mentions_name(
    clauses: List<HandlerClause>,
    name: String,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(clauses)) {
        false
    } else {
        expression_mentions_name(core::list_get(clauses, index).body, name) or
            handler_clause_list_mentions_name(clauses, name, index + 1)
    }
}

expression_mentions_name(
    expression: Expression,
    name: String,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::List(items, _)) =>
            expression_list_mentions_name(items, name, 0),
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            expression_mentions_name(value, name),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            expression_mentions_name(value, name),
        ExpressionCase::expression(Expression::Destroy(value, _)) =>
            expression_mentions_name(value, name),
        ExpressionCase::expression(Expression::ConsumeAvailable(available, _)) =>
            expression_mentions_name(available, name),
        ExpressionCase::expression(Expression::Variable(found, _)) =>
            found == name,
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            expression_mentions_name(operand, name),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            expression_mentions_name(left, name) or
                expression_mentions_name(right, name),
        ExpressionCase::expression(Expression::Call(
            _, arguments, _
        )) => expression_list_mentions_name(arguments, name, 0),
        ExpressionCase::expression(Expression::StructValue(
            _, fields, _
        )) => named_expression_list_mentions_name(fields, name, 0),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            expression_mentions_name(subject, name),
        ExpressionCase::expression(Expression::EnumValue(
            _, _, arguments, _
        )) => expression_list_mentions_name(arguments, name, 0),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            block_mentions_name(statements, name, 0),
        ExpressionCase::expression(Expression::Perform(
            _, _, arguments, _
        )) => expression_list_mentions_name(arguments, name, 0),
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, _
        )) => expression_mentions_name(computation, name) or
            handler_clause_list_mentions_name(clauses, name, 0),
        ExpressionCase::expression(_) => false
    }
}

expression_has_capturing_block(
    expression: Expression,
    name: String,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            expression_has_capturing_block(value, name),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            expression_has_capturing_block(value, name),
        ExpressionCase::expression(Expression::Destroy(value, _)) =>
            expression_has_capturing_block(value, name),
        ExpressionCase::expression(Expression::AvailableValue(_, _)) => false,
        ExpressionCase::expression(Expression::ConsumeAvailable(available, _)) =>
            expression_has_capturing_block(available, name),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            block_mentions_name(statements, name, 0),
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            expression_has_capturing_block(operand, name),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            expression_has_capturing_block(left, name) or
                expression_has_capturing_block(right, name),
        ExpressionCase::expression(Expression::Call(_, arguments, _)) =>
            expression_list_has_capturing_block(arguments, name, 0),
        ExpressionCase::expression(Expression::StructValue(_, fields, _)) =>
            named_expression_list_has_capturing_block(fields, name, 0),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            expression_has_capturing_block(subject, name),
        ExpressionCase::expression(Expression::EnumValue(
            _, _, arguments, _
        )) => expression_list_has_capturing_block(arguments, name, 0),
        ExpressionCase::expression(Expression::Perform(
            _, _, arguments, _
        )) => expression_list_has_capturing_block(arguments, name, 0),
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, _
        )) => expression_has_capturing_block(computation, name) or
            handler_clause_list_has_capturing_block(clauses, name, 0),
        ExpressionCase::expression(_) => false
    }
}

expression_list_has_capturing_block(
    expressions: List<Expression>,
    name: String,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(expressions)) {
        false
    } else {
        expression_has_capturing_block(
            core::list_get(expressions, index), name
        ) or expression_list_has_capturing_block(
            expressions, name, index + 1
        )
    }
}

named_expression_list_has_capturing_block(
    expressions: List<NamedExpression>,
    name: String,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(expressions)) {
        false
    } else {
        expression_has_capturing_block(
            core::list_get(expressions, index).value, name
        ) or named_expression_list_has_capturing_block(
            expressions, name, index + 1
        )
    }
}

handler_clause_list_has_capturing_block(
    clauses: List<HandlerClause>,
    name: String,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(clauses)) {
        false
    } else {
        expression_has_capturing_block(
            core::list_get(clauses, index).body, name
        ) or handler_clause_list_has_capturing_block(
            clauses, name, index + 1
        )
    }
}

block_has_capturing_block(
    statements: List<BlockStatement>,
    name: String,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(statements)) {
        false
    } else {
        let expression = handle perform BlockStatementCase::inspect(
            core::list_get(statements, index)
        ) {
            BlockStatementCase::inspect(BlockStatement::Let(
                _, _, _, value, _
            )) => value,
            BlockStatementCase::inspect(BlockStatement::Value(value)) => value
        };
        expression_has_capturing_block(expression, name) or
            block_has_capturing_block(statements, name, index + 1)
    }
}

handler_clauses_capture_resumption(
    clauses: List<HandlerClause>,
    index: i64,
) -> Bool / {ResultCase, ExpressionCase, BlockStatementCase} {
    if(index >= core::list_len(clauses)) {
        false
    } else {
        let clause = core::list_get(clauses, index);
        let captured = handle perform ExpressionCase::expression(clause.body) {
            ExpressionCase::expression(Expression::Block(statements, _)) =>
                block_has_capturing_block(
                    statements, clause.resumption_name, 0
                ),
            ExpressionCase::expression(_) => expression_has_capturing_block(
                clause.body, clause.resumption_name
            )
        };
        captured or handler_clauses_capture_resumption(clauses, index + 1)
    }
}

lower_resumption_step(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    expected: TypeRef,
    cancel: Bool,
    next_temporary: i64,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let continuation_expression = core::list_get(arguments, 0);
    let continuation_type = resolve_type(
        source, module,
        infer_expression_type(
            source, module, parameters, continuation_expression
        )
    );
    let continuation = lower_expression(
        source, module, parameters, continuation_expression,
        continuation_type, next_temporary
    );
    if(cancel) {
        lower_done_effect_step(
            expected,
            LoweredExpression {
                instructions: continuation.instructions +
                    "  call void @grandiose_cancel_resumption(ptr " +
                        continuation.value + ")\n",
                value: "{}",
                next_temporary: continuation.next_temporary,
            }
        )
    } else {
        let input = handle perform TypeCase::inspect(continuation_type.kind) {
            TypeCase::inspect(SourceType::Resumption(found, _)) => found,
            TypeCase::inspect(_) => compiler_error(
                source, "GRC9001", "backend invariant violated",
                expression_span(continuation_expression),
                "validated resume operand lost its resumption type", [],
                "resumption typing precedes continuation lowering",
                "report this compiler bug"
            )
        };
        let value = lower_expression(
            source, module, parameters, core::list_get(arguments, 1),
            input, continuation.next_temporary
        );
        let size_pointer = "%t" +
            core::int_to_string(value.next_temporary);
        let size = "%t" +
            core::int_to_string(value.next_temporary + 1);
        let box = "%t" +
            core::int_to_string(value.next_temporary + 2);
        let step = "%t" +
            core::int_to_string(value.next_temporary + 3);
        LoweredEffectfulBody {
            definitions: "",
            instructions: continuation.instructions + value.instructions +
                "  " + size_pointer + " = getelementptr " +
                    type_name(input.kind) + ", ptr null, i32 1\n" +
                "  " + size + " = ptrtoint ptr " + size_pointer +
                    " to i64\n" +
                "  " + box + " = call ptr @malloc(i64 " + size + ")\n" +
                "  store " + type_name(input.kind) + " " + value.value +
                    ", ptr " + box + "\n" +
                "  " + step +
                    " = call %grandiose.effect_step " +
                    "@grandiose_resume_resumption(ptr " +
                    continuation.value + ", ptr " + box + ")\n",
            value: step,
            next_temporary: value.next_temporary + 4,
        }
    }
}

lower_effectful_indirect_call(
    parameter: Parameter,
    next_temporary: i64,
) -> LoweredEffectfulBody / {ResultCase} {
    let function = "%t" + core::int_to_string(next_temporary);
    let environment = "%t" + core::int_to_string(next_temporary + 1);
    let step = "%t" + core::int_to_string(next_temporary + 2);
    LoweredEffectfulBody {
        definitions: "",
        instructions:
            "  " + function + " = extractvalue { ptr, ptr, ptr } " +
                parameter.llvm_name + ", 0\n" +
            "  " + environment + " = extractvalue { ptr, ptr, ptr } " +
                parameter.llvm_name + ", 1\n" +
            "  " + step + " = call %grandiose.effect_step " + function +
                "(ptr " + environment + ")\n",
        value: step,
        next_temporary: next_temporary + 3,
    }
}

lower_step_expression(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    parameters: List<Parameter>,
    expression: Expression,
    expected: TypeRef,
    next_temporary: i64,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let expected = resolve_type(source, module, expected);
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Negate(operand, span)) => {
            if(expression_requires_step(source, module, parameters, operand)) {
                let name = "__step_operand_" +
                    core::int_to_string(span.start);
                lower_effectful_block(
                    source, module, callable, parameters,
                    [
                        BlockStatement::Let(
                            name, span, expected, operand, span
                        ),
                        BlockStatement::Value(Expression::Negate(
                            Expression::Variable(name, span), span
                        ))
                    ],
                    0, expected, next_temporary
                )
            } else {
                lower_done_effect_step(
                    expected,
                    lower_expression(
                        source, module, parameters, expression,
                        expected, next_temporary
                    )
                )
            }
        },
        ExpressionCase::expression(Expression::Binary(
            operator, left, right, span
        )) => {
            if(expression_requires_step(
                source, module, parameters, left
            ) or expression_requires_step(
                source, module, parameters, right
            )) {
                let operand_type = if(operator_is_comparison(operator)) {
                    comparison_expression_operand_type(
                        source, module, parameters, operator, left, right, span
                    )
                } else {
                    expected
                };
                let left_name = "__step_left_" +
                    core::int_to_string(span.start);
                let right_name = "__step_right_" +
                    core::int_to_string(span.start);
                lower_effectful_block(
                    source, module, callable, parameters,
                    [
                        BlockStatement::Let(
                            left_name, expression_span(left), operand_type,
                            left, expression_span(left)
                        ),
                        BlockStatement::Let(
                            right_name, expression_span(right), operand_type,
                            right, expression_span(right)
                        ),
                        BlockStatement::Value(Expression::Binary(
                            operator,
                            Expression::Variable(left_name, span),
                            Expression::Variable(right_name, span),
                            span
                        ))
                    ],
                    0, expected, next_temporary
                )
            } else {
                lower_done_effect_step(
                    expected,
                    lower_expression(
                        source, module, parameters, expression,
                        expected, next_temporary
                    )
                )
            }
        },
        ExpressionCase::expression(Expression::Field(subject, name, span)) => {
            if(expression_requires_step(
                source, module, parameters, subject
            )) {
                let subject_type = infer_expression_type(
                    source, module, parameters, subject
                );
                let subject_name = "__step_subject_" +
                    core::int_to_string(span.start);
                lower_effectful_block(
                    source, module, callable, parameters,
                    [
                        BlockStatement::Let(
                            subject_name, expression_span(subject),
                            subject_type, subject, expression_span(subject)
                        ),
                        BlockStatement::Value(Expression::Field(
                            Expression::Variable(subject_name, span), name, span
                        ))
                    ],
                    0, expected, next_temporary
                )
            } else {
                lower_done_effect_step(
                    expected,
                    lower_expression(
                        source, module, parameters, expression,
                        expected, next_temporary
                    )
                )
            }
        },
        ExpressionCase::expression(Expression::StructValue(
            name, fields, span
        )) => {
            if(named_expression_list_requires_step(
                source, module, parameters, fields, 0
            )) {
                let declaration = handle perform StructLookupCase::lookup(
                    lookup_struct(module.structs, name, 0)
                ) {
                    StructLookupCase::lookup(StructLookup::Found(found)) => found,
                    StructLookupCase::lookup(StructLookup::Missing) =>
                        compiler_error(
                            source, "GRC9001", "backend invariant violated", span,
                            "validated struct is unavailable during step lowering",
                            [], "semantic validation precedes continuation lowering",
                            "report this compiler bug"
                        )
                };
                let type_arguments = handle perform TypeCase::inspect(
                    expected.kind
                ) {
                    TypeCase::inspect(SourceType::Struct(
                        resolved_name, arguments
                    )) => {
                        require(
                            resolved_name == name,
                            error_diagnostic(
                                source, "GRC9001", "backend invariant violated",
                                span, "validated struct changed identity", [],
                                "semantic and backend nominal identities agree",
                                "report this compiler bug"
                            )
                        );
                        arguments
                    },
                    TypeCase::inspect(_) => compiler_error(
                        source, "GRC9001", "backend invariant violated", span,
                        "struct construction reached a non-struct step context",
                        [], "semantic validation determines expected types",
                        "report this compiler bug"
                    )
                };
                let staged = step_struct_fields(
                    source, declaration, type_arguments, fields, span,
                    0, [], []
                );
                lower_effectful_block(
                    source, module, callable, parameters,
                    core::list_push(
                        staged.statements,
                        BlockStatement::Value(Expression::StructValue(
                            name, staged.fields, span
                        ))
                    ),
                    0, expected, next_temporary
                )
            } else {
                lower_done_effect_step(
                    expected,
                    lower_expression(
                        source, module, parameters, expression,
                        expected, next_temporary
                    )
                )
            }
        },
        ExpressionCase::expression(Expression::EnumValue(
            enum_name, variant_name, arguments, span
        )) => {
            if(expression_list_requires_step(
                source, module, parameters, arguments, 0
            )) {
                let enum_arguments = expected_enum_arguments(
                    source, expected, enum_name, span
                );
                let declaration = handle perform EnumLookupCase::lookup(
                    lookup_enum(module.enums, enum_name, 0)
                ) {
                    EnumLookupCase::lookup(EnumLookup::Found(found)) => found,
                    EnumLookupCase::lookup(EnumLookup::Missing) => compiler_error(
                        source, "GRC9001", "backend invariant violated", span,
                        "validated enum is unavailable during step lowering", [],
                        "semantic validation precedes continuation lowering",
                        "report this compiler bug"
                    )
                };
                let variant = handle perform VariantLookupCase::lookup(
                    lookup_variant(declaration.variants, variant_name, 0)
                ) {
                    VariantLookupCase::lookup(VariantLookup::Found(found)) => found,
                    VariantLookupCase::lookup(VariantLookup::Missing) =>
                        compiler_error(
                            source, "GRC9001", "backend invariant violated", span,
                            "validated enum variant is unavailable during step lowering",
                            [], "semantic validation precedes continuation lowering",
                            "report this compiler bug"
                        )
                };
                let staged = step_call_arguments(
                    arguments,
                    parameters_from_types(
                        substitute_types(
                            variant.fields, declaration.type_parameters,
                            enum_arguments, 0, []
                        ),
                        0, []
                    ),
                    span, 0, [], []
                );
                lower_effectful_block(
                    source, module, callable, parameters,
                    core::list_push(
                        staged.statements,
                        BlockStatement::Value(Expression::EnumValue(
                            enum_name, variant_name, staged.arguments, span
                        ))
                    ),
                    0, expected, next_temporary
                )
            } else {
                lower_done_effect_step(
                    expected,
                    lower_expression(
                        source, module, parameters, expression,
                        expected, next_temporary
                    )
                )
            }
        },
        ExpressionCase::expression(Expression::Perform(
            effect_name, operation_name, arguments, span
        )) => {
            if(expression_list_requires_step(
                source, module, parameters, arguments, 0
            )) {
                let resolved = resolve_perform_operation(
                    source, module, parameters, effect_name, operation_name,
                    arguments, span
                );
                let staged = step_call_arguments(
                    arguments, resolved.parameters, span, 0, [], []
                );
                lower_effectful_block(
                    source, module, callable, parameters,
                    core::list_push(
                        staged.statements,
                        BlockStatement::Value(Expression::Perform(
                            effect_name, operation_name, staged.arguments, span
                        ))
                    ),
                    0, expected, next_temporary
                )
            } else {
                lower_perform_effect_step(
                    source, module, parameters,
                    "@grandiose_resume_" + callable.name + "_" +
                        core::int_to_string(span.start),
                    effect_name, operation_name, arguments, span,
                    next_temporary
                )
            }
        },
        ExpressionCase::expression(Expression::Call(
            name, arguments, span
        )) => {
            if(name == "resume" or name == "cancel") {
                let continuation_type = resolve_type(
                    source, module,
                    infer_expression_type(
                        source, module, parameters,
                        core::list_get(arguments, 0)
                    )
                );
                let argument_parameters = if(name == "cancel") {
                    [Parameter {
                        name: "continuation",
                        span: span,
                        parameter_type: continuation_type,
                        is_local: true,
                        drop_flag: "",
                        llvm_name: "",
                    }]
                } else {
                    let input = handle perform TypeCase::inspect(
                        continuation_type.kind
                    ) {
                        TypeCase::inspect(SourceType::Resumption(found, _)) => found,
                        TypeCase::inspect(_) => continuation_type
                    };
                    [
                        Parameter {
                            name: "continuation",
                            span: span,
                            parameter_type: continuation_type,
                            is_local: true,
                            drop_flag: "",
                            llvm_name: "",
                        },
                        Parameter {
                            name: "value",
                            span: span,
                            parameter_type: input,
                            is_local: true,
                            drop_flag: "",
                            llvm_name: "",
                        }
                    ]
                };
                if(expression_list_requires_step(
                    source, module, parameters, arguments, 0
                )) {
                    let staged = step_call_arguments(
                        arguments, argument_parameters, span, 0, [], []
                    );
                    lower_effectful_block(
                        source, module, callable, parameters,
                        core::list_push(
                            staged.statements,
                            BlockStatement::Value(Expression::Call(
                                name, staged.arguments, span
                            ))
                        ),
                        0, expected, next_temporary
                    )
                } else {
                    lower_resumption_step(
                        source, module, parameters, arguments, expected,
                        name == "cancel", next_temporary
                    )
                }
            } else {
                handle perform ParameterLookupCase::lookup(
                    lookup_parameter(parameters, name, 0)
                ) {
                    ParameterLookupCase::lookup(
                        ParameterLookup::Found(parameter)
                    ) => lower_effectful_indirect_call(
                        parameter, next_temporary
                    ),
                    ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                        let called = resolve_callable(
                            source, module, name, span
                        );
                        let bindings = if(core::list_len(
                            called.type_parameters
                        ) > 0) {
                            infer_call_bindings(
                                source, module, parameters, arguments,
                                called, expected, span
                            )
                        } else {
                            []
                        };
                        let call_parameters = specialize_parameters(
                            called.parameters, bindings, 0, []
                        );
                        if(call_arguments_require_step(
                            source, module, parameters, arguments,
                            call_parameters, 0
                        )) {
                            let staged = step_call_arguments(
                                arguments,
                                call_parameters,
                                span, 0, [], []
                            );
                            lower_effectful_block(
                                source, module, callable, parameters,
                                core::list_push(
                                    staged.statements,
                                    BlockStatement::Value(Expression::Call(
                                        name, staged.arguments, span
                                    ))
                                ),
                                0, expected, next_temporary
                            )
                        } else {
                            if(core::list_len(called.effects) > 0 or
                                expression_requires_step(
                                    source, module, call_parameters,
                                    substitute_expression_bindings(
                                        called.body, bindings
                                    )
                                )) {
                                lower_effectful_named_call(
                                    source, module, parameters, name,
                                    arguments, expected, span, next_temporary
                                )
                            } else {
                                lower_done_effect_step(
                                    expected,
                                    lower_expression(
                                        source, module, parameters, expression,
                                        expected, next_temporary
                                    )
                                )
                            }
                        }
                    }
                }
            }
        },
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, handler_span
        )) => {
            let first = core::list_get(clauses, 0);
            let handled = resolve_handler_operation_declaration(
                source, module, first.effect_name, first.operation_name,
                first.span
            );
            let operation_result = resolve_type(
                source, module, handled.operation.result_type
            );
            if(operation_result.kind == SourceType::Never) {
                lower_step_terminal_handler(
                    source, module, callable, parameters, computation,
                    clauses, expected, next_temporary
                )
            } else {
                handle perform ExpressionCase::expression(computation) {
                    ExpressionCase::expression(Expression::Call(
                        name, arguments, span
                    )) => lower_effectful_forwarding_handler(
                        source, module, callable, parameters, name, arguments,
                        span, clauses, next_temporary
                    ),
                    ExpressionCase::expression(Expression::Block(
                        statements, span
                    )) => lower_effectful_forwarding_handler_step(
                        source, module, callable, parameters,
                        lower_effectful_block(
                            source, module, callable, parameters, statements,
                            0, expected, next_temporary
                        ),
                        span, clauses
                    ),
                    ExpressionCase::expression(_) =>
                        lower_effectful_forwarding_handler_step(
                            source, module, callable, parameters,
                            lower_step_expression(
                                source, module, callable, parameters,
                                computation, expected, next_temporary
                            ),
                            handler_span, clauses
                        )
                }
            }
        },
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            lower_effectful_block(
                source, module, callable, parameters, statements, 0,
                expected, next_temporary
            ),
        ExpressionCase::expression(_) => lower_done_effect_step(
            expected,
            lower_expression(
                source, module, parameters, expression,
                expected, next_temporary
            )
        )
    }
}

lower_step_continuation(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    captures: List<Parameter>,
    statements: List<BlockStatement>,
    continuation_index: i64,
    binding_name: String,
    binding_span: SourceSpan,
    binding_type: TypeRef,
    result_type: TypeRef,
    initial: LoweredEffectfulBody,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let resolved_binding = resolve_type(source, module, binding_type);
    let symbol = callable.name + "_step_" +
        core::int_to_string(binding_span.start);
    let continuation_symbol = "@grandiose_effect_continuation_" + symbol;
    let environment_drop_symbol = "@grandiose_capture_drop_" + symbol;
    let continuation_value = "%continuation_" + binding_name + "_" +
        core::int_to_string(binding_span.start);
    let binding_drop_flag = if(type_needs_drop_glue(
        source, module, resolved_binding, []
    )) {
        "%drop_active_" + binding_name + "_" +
            core::int_to_string(binding_span.start)
    } else {
        ""
    };
    let binding_parameter = Parameter {
        name: binding_name,
        span: binding_span,
        parameter_type: resolved_binding,
        is_local: true,
        drop_flag: binding_drop_flag,
        llvm_name: continuation_value,
    };
    let continuation_parameters = core::list_push(
        captures,
        binding_parameter
    );
    let uncleaned_continuation = lower_effectful_block(
        source, module, callable, continuation_parameters, statements,
        continuation_index, result_type, 0
    );
    let continuation = if(binding_drop_flag == "") {
        uncleaned_continuation
    } else {
        lower_effectful_owner_cleanup(
            source,
            module,
            [binding_parameter],
            symbol + "_binding",
            uncleaned_continuation
        )
    };
    let environment_type = closure_environment_type(
        source, module, captures, 0, ""
    );
    let capture_loads = if(core::list_len(captures) == 0) {
        ""
    } else {
        "  %closure_captures = load " + environment_type +
            ", ptr %environment\n" +
        closure_capture_loads(
            source, module, captures, environment_type, 0, ""
        )
    };
    let environment = lower_heap_continuation_environment(
        source, module, captures, initial.next_temporary
    );
    let shared_environment = lower_shared_environment(
        environment.pointer, environment_drop_symbol,
        environment.next_temporary
    );
    let composed = "%t" +
        core::int_to_string(shared_environment.next_temporary);
    LoweredEffectfulBody {
        definitions: initial.definitions + continuation.definitions +
            lower_capture_environment_drop_definition(
                source, module, captures, environment_drop_symbol
            ) +
            effect_bind_definitions(symbol) +
            "define %grandiose.effect_step " + continuation_symbol +
                "(ptr %environment, ptr %value) {\n" +
            "entry:\n" + capture_loads +
            "  " + continuation_value + " = load " +
                type_name(resolved_binding.kind) + ", ptr %value\n" +
            "  call void @free(ptr %value)\n" +
            (if(binding_drop_flag == "") { "" } else {
                "  " + binding_drop_flag +
                    " = call ptr @grandiose_new_drop_state()\n"
            }) +
            continuation.instructions +
            "  ret %grandiose.effect_step " + continuation.value + "\n" +
            "}\n\n",
        instructions: initial.instructions + environment.instructions +
            shared_environment.instructions +
            "  " + composed + " = call %grandiose.effect_step " +
                "@grandiose_bind_step_" + symbol +
                "(%grandiose.effect_step " + initial.value + ", ptr " +
                continuation_symbol + ", ptr " +
                shared_environment.pointer + ")\n",
        value: composed,
        next_temporary: shared_environment.next_temporary + 1,
    }
}

lower_effectful_block(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
    result_type: TypeRef,
    next_temporary: i64,
) -> LoweredEffectfulBody / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let statement = core::list_get(statements, index);
    handle perform BlockStatementCase::inspect(statement) {
        BlockStatementCase::inspect(BlockStatement::Let(
            name, name_span, local_type, value, _
        )) => {
            let typed = typed_core_expression(
                source, module, parameters, value, local_type
            );
            let resolved_type = typed.value_type;
            if(typed.requires_step) {
                lower_step_continuation(
                    source, module, callable, parameters, statements, index + 1,
                    name, name_span, resolved_type, result_type,
                    lower_step_expression(
                        source, module, callable, parameters, typed.expression,
                        resolved_type, next_temporary
                    )
                )
            } else {
                let lowered = lower_expression(
                    source, module, parameters, typed.expression, resolved_type,
                    next_temporary
                );
                let local_name = "%local_" + name + "_" +
                    core::int_to_string(name_span.start);
                let drop_flag = if(type_needs_drop_glue(
                    source, module, resolved_type, []
                )) {
                    "%drop_active_" + name + "_" +
                        core::int_to_string(name_span.start)
                } else {
                    ""
                };
                let local_parameter = Parameter {
                    name: name,
                    span: name_span,
                    parameter_type: resolved_type,
                    is_local: true,
                    drop_flag: drop_flag,
                    llvm_name: local_name,
                };
                let remaining = lower_effectful_block(
                    source,
                    module,
                    callable,
                    core::list_push(parameters, local_parameter),
                    statements,
                    index + 1,
                    result_type,
                    lowered.next_temporary + 1
                );
                let cleaned = if(drop_flag == "") {
                    remaining
                } else {
                    lower_effectful_owner_cleanup(
                        source,
                        module,
                        [local_parameter],
                        callable.name + "_local_" +
                            core::int_to_string(name_span.start),
                        remaining
                    )
                };
                LoweredEffectfulBody {
                    definitions: cleaned.definitions,
                    instructions: lowered.instructions +
                        "  " + local_name + " = select i1 true, " +
                        type_name(resolved_type.kind) + " " + lowered.value +
                        ", " + type_name(resolved_type.kind) + " " +
                        lowered.value + "\n" +
                        (if(drop_flag == "") { "" } else {
                            "  " + drop_flag +
                                " = call ptr @grandiose_new_drop_state()\n"
                        }) + cleaned.instructions,
                    value: cleaned.value,
                    next_temporary: cleaned.next_temporary,
                }
            }
        },
        BlockStatementCase::inspect(BlockStatement::Value(value)) => {
            let final_value = index + 1 >= core::list_len(statements);
            let value_type = if(final_value) {
                result_type
            } else {
                infer_expression_type(source, module, parameters, value)
            };
            let typed = typed_core_expression(
                source, module, parameters, value, value_type
            );
            if(final_value) {
                lower_step_expression(
                    source, module, callable, parameters, typed.expression,
                    typed.value_type, next_temporary
                )
            } else {
                if(typed.requires_step) {
                    let span = expression_span(typed.expression);
                    lower_step_continuation(
                        source, module, callable, parameters, statements,
                        index + 1, "discard", span, typed.value_type, result_type,
                        lower_step_expression(
                            source, module, callable, parameters,
                            typed.expression, typed.value_type, next_temporary
                        )
                    )
                } else {
                    let lowered = lower_expression(
                        source, module, parameters, typed.expression,
                        typed.value_type,
                        next_temporary
                    );
                    let remaining = lower_effectful_block(
                        source, module, callable, parameters, statements,
                        index + 1, result_type, lowered.next_temporary
                    );
                    LoweredEffectfulBody {
                        definitions: remaining.definitions,
                        instructions: lowered.instructions +
                            remaining.instructions,
                        value: remaining.value,
                        next_temporary: remaining.next_temporary,
                    }
                }
            }
        }
    }
}

lower_effectful_callable(
    source: SourceFile,
    module: Module,
    callable: CallableDecl,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let result_type = resolve_type(source, module, callable.result_type);
    let parameters = effectful_parameter_drop_flags(
        source, module, callable.parameters, 0, []
    );
    let owned_callable = CallableDecl {
        name: callable.name,
        name_span: callable.name_span,
        type_parameters: callable.type_parameters,
        callable_constraints: callable.callable_constraints,
        use_constraints: callable.use_constraints,
        environment_constraints: callable.environment_constraints,
        runs_in_constraints: callable.runs_in_constraints,
        parameters: parameters,
        result_type: result_type,
        effects: callable.effects,
        body: callable.body,
        span: callable.span,
    };
    let typed = typed_core_expression(
        source, module, parameters, callable.body, result_type
    );
    let lowered = handle perform ExpressionCase::expression(typed.expression) {
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            lower_effectful_block(
                source, module, owned_callable, parameters, statements, 0,
                typed.value_type, 0
            ),
        ExpressionCase::expression(_) => lower_step_expression(
            source, module, owned_callable, parameters, typed.expression,
            typed.value_type, 0
        )
    };
    let cleaned = lower_effectful_owner_cleanup(
        source, module, parameters, callable.name, lowered
    );
    cleaned.definitions +
    "define %grandiose.effect_step @grandiose_" + callable.name +
    "(" + lower_parameters(source, module, parameters, 0, "") + ") {\n" +
    "entry:\n" + lower_parameter_drop_flag_initializers(parameters, 0, "") +
    cleaned.instructions +
    "  ret %grandiose.effect_step " + cleaned.value + "\n" +
    "}\n\n"
}

lower_callable_specialization(
    source: SourceFile,
    module: Module,
    specialization: CallableSpecialization,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let callable = specialization.callable;
    let parameters = specialize_parameters(
        callable.parameters,
        specialization.bindings,
        0,
        []
    );
    let result_type = resolve_type(
        source,
        module,
        substitute_bindings(callable.result_type, specialization.bindings)
    );
    let body = substitute_expression_bindings(
        callable.body, specialization.bindings
    );
    let typed = typed_core_expression(
        source, module, parameters, body, result_type
    );
    if(typed.requires_step) {
        lower_effectful_callable(
            source,
            module,
            CallableDecl {
                name: callable.name + specialization.suffix,
                name_span: callable.name_span,
                type_parameters: [],
                callable_constraints: [],
                use_constraints: [],
                environment_constraints: [],
                runs_in_constraints: [],
                parameters: parameters,
                result_type: result_type,
                effects: callable.effects,
                body: typed.expression,
                span: callable.span,
            }
        )
    } else {
        lower_callable(
            source,
            module,
            CallableDecl {
                name: callable.name + specialization.suffix,
                name_span: callable.name_span,
                type_parameters: [],
                callable_constraints: [],
                use_constraints: [],
                environment_constraints: [],
                runs_in_constraints: [],
                parameters: parameters,
                result_type: result_type,
                effects: callable.effects,
                body: typed.expression,
                span: callable.span,
            }
        )
    }
}

lower_specializations(
    source: SourceFile,
    module: Module,
    specializations: List<CallableSpecialization>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, Diagnostics
} {
    if(index >= core::list_len(specializations)) {
        output
    } else {
        lower_specializations(
            source,
            module,
            specializations,
            index + 1,
            output + lower_callable_specialization(
                source,
                module,
                core::list_get(specializations, index)
            )
        )
    }
}

lower_closure_definitions_arguments(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    arguments: List<Expression>,
    expected_parameters: List<Parameter>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        output
    } else {
        lower_closure_definitions_arguments(
            source,
            module,
            parameters,
            arguments,
            expected_parameters,
            index + 1,
            lower_closure_definitions_expression(
                source,
                module,
                parameters,
                core::list_get(arguments, index),
                core::list_get(expected_parameters, index).parameter_type,
                output
            )
        )
    }
}

lower_closure_definitions_block(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    statements: List<BlockStatement>,
    index: i64,
    expected: TypeRef,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(statements)) {
        output
    } else {
        let statement = core::list_get(statements, index);
        handle perform BlockStatementCase::inspect(statement) {
            BlockStatementCase::inspect(BlockStatement::Let(
                name, name_span, local_type, value, _
            )) => {
                let next_output = lower_closure_definitions_expression(
                    source, module, parameters, value, local_type, output
                );
                lower_closure_definitions_block(
                    source,
                    module,
                    core::list_push(parameters, Parameter {
                        name: name,
                        span: name_span,
                        parameter_type: local_type,
                        is_local: true,
                        drop_flag: "",
                        llvm_name: "%local_" + name,
                    }),
                    statements,
                    index + 1,
                    expected,
                    next_output
                )
            },
            BlockStatementCase::inspect(BlockStatement::Value(value)) => {
                let value_type = if(index + 1 >= core::list_len(statements)) {
                    expected
                } else {
                    infer_expression_type(source, module, parameters, value)
                };
                lower_closure_definitions_block(
                    source,
                    module,
                    parameters,
                    statements,
                    index + 1,
                    expected,
                    lower_closure_definitions_expression(
                        source, module, parameters, value, value_type, output
                    )
                )
            }
        }
    }
}

lower_closure_definitions_struct_fields(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    declaration: StructDecl,
    type_arguments: List<TypeRef>,
    fields: List<NamedExpression>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(declaration.fields)) {
        output
    } else {
        let field = core::list_get(declaration.fields, index);
        handle perform NamedExpressionLookupCase::lookup(
            lookup_named_expression(fields, field.name, 0)
        ) {
            NamedExpressionLookupCase::lookup(
                NamedExpressionLookup::Found(value)
            ) => lower_closure_definitions_struct_fields(
                source, module, parameters, declaration, type_arguments,
                fields, index + 1,
                lower_closure_definitions_expression(
                    source, module, parameters, value.value,
                    core::list_get(
                        substitute_types(
                            [field.field_type], declaration.type_parameters,
                            type_arguments, 0, []
                        ),
                        0
                    ),
                    output
                )
            ),
            NamedExpressionLookupCase::lookup(NamedExpressionLookup::Missing) =>
                output
        }
    }
}

lower_closure_definitions_enum_arguments(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    declaration: EnumDecl,
    type_arguments: List<TypeRef>,
    variant: VariantDecl,
    arguments: List<Expression>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(arguments)) {
        output
    } else {
        lower_closure_definitions_enum_arguments(
            source, module, parameters, declaration, type_arguments, variant,
            arguments, index + 1,
            lower_closure_definitions_expression(
                source, module, parameters,
                core::list_get(arguments, index),
                core::list_get(
                    substitute_types(
                        variant.fields, declaration.type_parameters,
                        type_arguments, 0, []
                    ),
                    index
                ),
                output
            )
        )
    }
}

lower_closure_definitions_expression(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    expression: Expression,
    expected: TypeRef,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    let expected = resolve_type(source, module, expected);
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Borrow(value, _, _)) =>
            lower_closure_definitions_expression(
                source, module, parameters, value,
                infer_expression_type(source, module, parameters, value),
                output
            ),
        ExpressionCase::expression(Expression::Dereference(value, _)) =>
            lower_closure_definitions_expression(
                source, module, parameters, value,
                infer_expression_type(source, module, parameters, value),
                output
            ),
        ExpressionCase::expression(Expression::StructValue(name, fields, _)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Struct(_, type_arguments)) => {
                    handle perform StructLookupCase::lookup(
                        lookup_struct(module.structs, name, 0)
                    ) {
                        StructLookupCase::lookup(
                            StructLookup::Found(declaration)
                        ) => lower_closure_definitions_struct_fields(
                            source, module, parameters, declaration,
                            type_arguments, fields, 0, output
                        ),
                        StructLookupCase::lookup(StructLookup::Missing) => output
                    }
                },
                TypeCase::inspect(_) => output
            }
        },
        ExpressionCase::expression(Expression::EnumValue(
            name, variant_name, arguments, _
        )) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Enum(_, type_arguments)) => {
                    handle perform EnumLookupCase::lookup(
                        lookup_enum(module.enums, name, 0)
                    ) {
                        EnumLookupCase::lookup(
                            EnumLookup::Found(declaration)
                        ) => {
                            handle perform VariantLookupCase::lookup(
                                lookup_variant(
                                    declaration.variants, variant_name, 0
                                )
                            ) {
                                VariantLookupCase::lookup(
                                    VariantLookup::Found(variant)
                                ) => lower_closure_definitions_enum_arguments(
                                    source, module, parameters, declaration,
                                    type_arguments, variant, arguments, 0, output
                                ),
                                VariantLookupCase::lookup(
                                    VariantLookup::Missing
                                ) => output
                            }
                        },
                        EnumLookupCase::lookup(EnumLookup::Missing) => output
                    }
                },
                TypeCase::inspect(_) => output
            }
        },
        ExpressionCase::expression(Expression::Destroy(value, _)) =>
            lower_closure_definitions_expression(
                source, module, parameters, value,
                infer_expression_type(source, module, parameters, value),
                output
            ),
        ExpressionCase::expression(Expression::ConsumeAvailable(available, _)) =>
            lower_closure_definitions_expression(
                source, module, parameters, available,
                infer_expression_type(source, module, parameters, available),
                output
            ),
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            lower_closure_definitions_expression(
                source, module, parameters, operand, expected, output
            ),
        ExpressionCase::expression(Expression::Binary(operator, left, right, span)) => {
            let operand_type = if(operator_is_comparison(operator)) {
                comparison_expression_operand_type(
                    source, module, parameters, operator, left, right, span
                )
            } else {
                expected
            };
            lower_closure_definitions_expression(
                source,
                module,
                parameters,
                right,
                operand_type,
                lower_closure_definitions_expression(
                    source, module, parameters, left, operand_type, output
                )
            )
        },
        ExpressionCase::expression(Expression::Call("resume", _, _)) => output,
        ExpressionCase::expression(Expression::Call("cancel", _, _)) => output,
        ExpressionCase::expression(Expression::Call(name, arguments, span)) => {
            handle perform ParameterLookupCase::lookup(
                lookup_parameter(parameters, name, 0)
            ) {
                ParameterLookupCase::lookup(ParameterLookup::Found(_)) => output,
                ParameterLookupCase::lookup(ParameterLookup::Missing) => {
                    let callable = resolve_callable(source, module, name, span);
                    let bindings = if(core::list_len(callable.type_parameters) > 0) {
                        infer_call_bindings(
                            source,
                            module,
                            parameters,
                            arguments,
                            callable,
                            expected,
                            span
                        )
                    } else {
                        []
                    };
                    lower_closure_definitions_arguments(
                        source,
                        module,
                        parameters,
                        arguments,
                        specialize_parameters(callable.parameters, bindings, 0, []),
                        0,
                        output
                    )
                }
            }
        },
        ExpressionCase::expression(Expression::Handle(
            computation, clauses, handler_span
        )) => {
            let first = core::list_get(clauses, 0);
            let handled = resolve_handler_operation_declaration(
                source, module, first.effect_name, first.operation_name,
                first.span
            );
            let operation_result = resolve_type(
                source, module, handled.operation.result_type
            );
            handle perform TypeCase::inspect(operation_result.kind) {
                TypeCase::inspect(SourceType::Never) => output,
                TypeCase::inspect(_) => {
                    handle perform ResumptiveHandlerControlPlanCase::inspect(
                        plan_resumptive_handler_control(computation, clauses)
                    ) {
                        ResumptiveHandlerControlPlanCase::inspect(
                            ResumptiveHandlerControlPlan::StaticBlock(_, _)
                        ) => output,
                        ResumptiveHandlerControlPlanCase::inspect(
                            ResumptiveHandlerControlPlan::RuntimeCall(
                                _, _, call_span
                            )
                        ) => output + lower_runtime_handler_definition(
                            source, module, parameters, call_span, clauses,
                            expected
                        ),
                        ResumptiveHandlerControlPlanCase::inspect(
                            ResumptiveHandlerControlPlan::RuntimeStep(span)
                        ) => {
                            let handler_callable = CallableDecl {
                                name: "handler_" +
                                    core::int_to_string(span.start),
                                name_span: span,
                                type_parameters: [],
                                callable_constraints: [],
                                use_constraints: [],
                                environment_constraints: [],
                                runs_in_constraints: [],
                                parameters: parameters,
                                result_type: expected,
                                effects: [],
                                body: computation,
                                span: span,
                            };
                            let lowered =
                                lower_effectful_forwarding_handler_step(
                                    source, module, handler_callable,
                                    parameters,
                                    lower_step_expression(
                                        source, module, handler_callable,
                                        parameters, computation, expected, 0
                                    ),
                                    span, clauses
                                );
                            output + lowered.definitions
                        }
                    }
                }
            }
        },
        ExpressionCase::expression(Expression::Block(statements, span)) => {
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Callable(result, effectful)) => {
                    let definition = lower_closure_definition(
                        source, module, parameters, statements, span, result,
                        effectful
                    );
                    lower_closure_definitions_block(
                        source,
                        module,
                        parameters,
                        statements,
                        0,
                        result,
                        output + definition
                    )
                },
                TypeCase::inspect(_) => lower_closure_definitions_block(
                    source,
                    module,
                    parameters,
                    statements,
                    0,
                    expected,
                    output
                )
            }
        },
        ExpressionCase::expression(_) => output
    }
}

lower_all_closure_definitions(
    source: SourceFile,
    module: Module,
    specializations: List<CallableSpecialization>,
    callable_index: i64,
    specialization_index: i64,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    if(callable_index < core::list_len(module.callables)) {
        let callable = core::list_get(module.callables, callable_index);
        if(core::list_len(callable.type_parameters) > 0) {
            lower_all_closure_definitions(
                source, module, specializations, callable_index + 1,
                specialization_index, output
            )
        } else {
            let typed = typed_core_expression(
                source, module, callable.parameters, callable.body,
                callable.result_type
            );
            let parameters = if(core::list_len(callable.effects) > 0 or
                typed.requires_step) {
                effectful_parameter_drop_flags(
                    source, module, callable.parameters, 0, []
                )
            } else {
                callable_parameter_drop_flags(
                    source, module, callable.parameters, callable.body, 0, []
                )
            };
            lower_all_closure_definitions(
                source,
                module,
                specializations,
                callable_index + 1,
                specialization_index,
                lower_closure_definitions_expression(
                    source,
                    module,
                    parameters,
                    typed.expression,
                    typed.value_type,
                    output
                )
            )
        }
    } else {
        if(specialization_index >= core::list_len(specializations)) {
            output
        } else {
            let specialization = core::list_get(specializations, specialization_index);
            let callable = specialization.callable;
            let specialized_parameters = specialize_parameters(
                callable.parameters, specialization.bindings, 0, []
            );
            let result = substitute_bindings(
                callable.result_type, specialization.bindings
            );
            let body = substitute_expression_bindings(
                callable.body, specialization.bindings
            );
            let typed = typed_core_expression(
                source, module, specialized_parameters, body, result
            );
            let parameters = if(typed.requires_step) {
                effectful_parameter_drop_flags(
                    source, module, specialized_parameters, 0, []
                )
            } else {
                callable_parameter_drop_flags(
                    source, module, specialized_parameters, body, 0, []
                )
            };
            lower_all_closure_definitions(
                source,
                module,
                specializations,
                callable_index,
                specialization_index + 1,
                lower_closure_definitions_expression(
                    source,
                    module,
                    parameters,
                    typed.expression,
                    typed.value_type,
                    output
                )
            )
        }
    }
}

lower_drop_closure_definitions(
    source: SourceFile,
    module: Module,
    index: i64,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, PatternCase,
    EffectLookupCase, EffectOperationLookupCase, HandlerClauseLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.drop_declarations)) {
        output
    } else {
        let callable = drop_callable(
            source, module, core::list_get(module.drop_declarations, index)
        );
        lower_drop_closure_definitions(
            source,
            module,
            index + 1,
            lower_closure_definitions_expression(
                source,
                module,
                callable.parameters,
                callable.body,
                callable.result_type,
                output
            )
        )
    }
}

lower_callables(
    source: SourceFile,
    module: Module,
    callables: List<CallableDecl>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, TypeInferenceCase,
    EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(callables)) {
        output
    } else {
        let callable = core::list_get(callables, index);
        if(compiler_core_intrinsic(callable.name) or
            core::list_len(callable.type_parameters) > 0) {
            lower_callables(source, module, callables, index + 1, output)
        } else {
            let lowered_callable = if(core::list_len(callable.effects) > 0) {
                lower_effectful_callable(source, module, callable)
            } else {
                lower_callable(source, module, callable)
            };
            lower_callables(
                source,
                module,
                callables,
                index + 1,
                output + lowered_callable
            )
        }
    }
}

lower_drop_callables(
    source: SourceFile,
    module: Module,
    index: i64,
    output: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, TypeCase,
    TypeAliasLookupCase, StructLookupCase, EnumLookupCase, VariantLookupCase,
    StructFieldLookupCase, NamedExpressionLookupCase, TypeBindingLookupCase,
    BlockStatementCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    if(index >= core::list_len(module.drop_declarations)) {
        output
    } else {
        lower_drop_callables(
            source,
            module,
            index + 1,
            output + lower_callable(
                source,
                module,
                drop_callable(
                    source,
                    module,
                    core::list_get(module.drop_declarations, index)
                )
            )
        )
    }
}

lower_struct_field_types(
    source: SourceFile,
    module: Module,
    fields: List<StructFieldDecl>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics
} {
    if(index >= core::list_len(fields)) {
        output
    } else {
        let field = core::list_get(fields, index);
        let field_type = resolve_type(source, module, field.field_type);
        let separator = if(index == 0) { "" } else { ", " };
        lower_struct_field_types(
            source,
            module,
            fields,
            index + 1,
            output + separator + type_name(field_type.kind)
        )
    }
}

lower_struct_declarations(
    source: SourceFile,
    module: Module,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics
} {
    if(index >= core::list_len(module.structs)) {
        output
    } else {
        let declaration = core::list_get(module.structs, index);
        if(core::list_len(declaration.type_parameters) > 0) {
            lower_struct_declarations(source, module, index + 1, output)
        } else {
            lower_struct_declarations(
                source,
                module,
                index + 1,
                output + type_name(SourceType::Struct(declaration.name, [])) + " = type { " +
                    lower_struct_field_types(source, module, declaration.fields, 0, "") +
                    " }\n"
            )
        }
    }
}

lower_enum_field_types(
    source: SourceFile,
    module: Module,
    fields: List<TypeRef>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(fields)) {
        output
    } else {
        let field_type = resolve_type(source, module, core::list_get(fields, index));
        lower_enum_field_types(
            source,
            module,
            fields,
            index + 1,
            output + ", " + type_name(field_type.kind)
        )
    }
}

lower_enum_variants_layout(
    source: SourceFile,
    module: Module,
    variants: List<VariantDecl>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(variants)) {
        output
    } else {
        let variant = core::list_get(variants, index);
        lower_enum_variants_layout(
            source,
            module,
            variants,
            index + 1,
            lower_enum_field_types(source, module, variant.fields, 0, output)
        )
    }
}

lower_enum_declarations(
    source: SourceFile,
    module: Module,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.enums)) {
        output
    } else {
        let declaration = core::list_get(module.enums, index);
        require(
            declaration.name != "Available",
            error_diagnostic(
                source,
                "GRC1851",
                "compiler evidence name is reserved",
                declaration.name_span,
                "`Available` denotes the unforgeable environment witness type",
                [],
                "source declarations cannot replace compiler-owned evidence identities",
                "rename this enum"
            )
        );
        if(core::list_len(declaration.type_parameters) > 0) {
            lower_enum_declarations(source, module, index + 1, output)
        } else {
            lower_enum_declarations(
                source,
                module,
                index + 1,
                output + type_name(SourceType::Enum(declaration.name, [])) + " = type { " +
                    lower_enum_variants_layout(
                        source,
                        module,
                        declaration.variants,
                        0,
                        "i32"
                    ) + " }\n"
            )
        }
    }
}

lookup_nominal_instantiation(
    instantiations: List<NominalInstantiation>,
    key: String,
    index: i64,
) -> NominalInstantiationLookup / {ResultCase} {
    if(index >= core::list_len(instantiations)) {
        NominalInstantiationLookup::Missing
    } else {
        if(core::list_get(instantiations, index).key == key) {
            NominalInstantiationLookup::Found
        } else {
            lookup_nominal_instantiation(instantiations, key, index + 1)
        }
    }
}

collect_type_list_instantiations(
    source: SourceFile,
    module: Module,
    references: List<TypeRef>,
    index: i64,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    NominalInstantiationLookupCase, Diagnostics
} {
    if(index >= core::list_len(references)) {
        instantiations
    } else {
        collect_type_list_instantiations(
            source,
            module,
            references,
            index + 1,
            collect_type_instantiations(
                source,
                module,
                core::list_get(references, index),
                instantiations
            )
        )
    }
}

collect_type_instantiations(
    source: SourceFile,
    module: Module,
    reference: TypeRef,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    NominalInstantiationLookupCase, Diagnostics
} {
    let resolved = resolve_type(source, module, reference);
    handle perform TypeCase::inspect(resolved.kind) {
        TypeCase::inspect(SourceType::Struct(_, arguments)) => {
            let nested = collect_type_list_instantiations(
                source, module, arguments, 0, instantiations
            );
            if(core::list_len(arguments) == 0 or type_has_generic(resolved)) {
                nested
            } else {
                let key = type_name(resolved.kind);
                handle perform NominalInstantiationLookupCase::lookup(
                    lookup_nominal_instantiation(nested, key, 0)
                ) {
                    NominalInstantiationLookupCase::lookup(
                        NominalInstantiationLookup::Found
                    ) => nested,
                    NominalInstantiationLookupCase::lookup(
                        NominalInstantiationLookup::Missing
                    ) => core::list_push(nested, NominalInstantiation {
                        reference: resolved,
                        key: key,
                    })
                }
            }
        },
        TypeCase::inspect(SourceType::Enum(_, arguments)) => {
            let nested = collect_type_list_instantiations(
                source, module, arguments, 0, instantiations
            );
            if(core::list_len(arguments) == 0 or type_has_generic(resolved)) {
                nested
            } else {
                let key = type_name(resolved.kind);
                handle perform NominalInstantiationLookupCase::lookup(
                    lookup_nominal_instantiation(nested, key, 0)
                ) {
                    NominalInstantiationLookupCase::lookup(
                        NominalInstantiationLookup::Found
                    ) => nested,
                    NominalInstantiationLookupCase::lookup(
                        NominalInstantiationLookup::Missing
                    ) => core::list_push(nested, NominalInstantiation {
                        reference: resolved,
                        key: key,
                    })
                }
            }
        },
        TypeCase::inspect(SourceType::Callable(output, _)) =>
            collect_type_instantiations(source, module, output, instantiations),
        TypeCase::inspect(SourceType::Resumption(input, output)) =>
            collect_type_instantiations(
                source,
                module,
                output,
                collect_type_instantiations(source, module, input, instantiations)
            ),
        TypeCase::inspect(_) => instantiations
    }
}

collect_parameter_type_instantiations(
    source: SourceFile,
    module: Module,
    parameters: List<Parameter>,
    index: i64,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    NominalInstantiationLookupCase, Diagnostics
} {
    if(index >= core::list_len(parameters)) {
        instantiations
    } else {
        collect_parameter_type_instantiations(
            source,
            module,
            parameters,
            index + 1,
            collect_type_instantiations(
                source,
                module,
                core::list_get(parameters, index).parameter_type,
                instantiations
            )
        )
    }
}

collect_block_type_instantiations(
    source: SourceFile,
    module: Module,
    statements: List<BlockStatement>,
    index: i64,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, ExpressionCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, BlockStatementCase, NominalInstantiationLookupCase, Diagnostics
} {
    if(index >= core::list_len(statements)) {
        instantiations
    } else {
        let statement = core::list_get(statements, index);
        handle perform BlockStatementCase::inspect(statement) {
            BlockStatementCase::inspect(BlockStatement::Let(_, _, local_type, value, _)) =>
                collect_block_type_instantiations(
                    source,
                    module,
                    statements,
                    index + 1,
                    collect_expression_type_instantiations(
                        source,
                        module,
                        value,
                        collect_type_instantiations(
                            source,
                            module,
                            local_type,
                            instantiations
                        )
                    )
                ),
            BlockStatementCase::inspect(BlockStatement::Value(value)) =>
                collect_block_type_instantiations(
                    source,
                    module,
                    statements,
                    index + 1,
                    collect_expression_type_instantiations(
                        source, module, value, instantiations
                    )
                )
        }
    }
}

collect_expression_list_type_instantiations(
    source: SourceFile,
    module: Module,
    expressions: List<Expression>,
    index: i64,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, ExpressionCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, BlockStatementCase, NominalInstantiationLookupCase, Diagnostics
} {
    if(index >= core::list_len(expressions)) {
        instantiations
    } else {
        collect_expression_list_type_instantiations(
            source,
            module,
            expressions,
            index + 1,
            collect_expression_type_instantiations(
                source,
                module,
                core::list_get(expressions, index),
                instantiations
            )
        )
    }
}

collect_expression_type_instantiations(
    source: SourceFile,
    module: Module,
    expression: Expression,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, ExpressionCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, BlockStatementCase, NominalInstantiationLookupCase, Diagnostics
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Negate(operand, _)) =>
            collect_expression_type_instantiations(
                source, module, operand, instantiations
            ),
        ExpressionCase::expression(Expression::Binary(_, left, right, _)) =>
            collect_expression_type_instantiations(
                source,
                module,
                right,
                collect_expression_type_instantiations(
                    source, module, left, instantiations
                )
            ),
        ExpressionCase::expression(Expression::Call(_, arguments, _)) =>
            collect_expression_list_type_instantiations(
                source, module, arguments, 0, instantiations
            ),
        ExpressionCase::expression(Expression::Field(subject, _, _)) =>
            collect_expression_type_instantiations(
                source, module, subject, instantiations
            ),
        ExpressionCase::expression(Expression::EnumValue(_, _, arguments, _)) =>
            collect_expression_list_type_instantiations(
                source, module, arguments, 0, instantiations
            ),
        ExpressionCase::expression(Expression::Block(statements, _)) =>
            collect_block_type_instantiations(
                source, module, statements, 0, instantiations
            ),
        ExpressionCase::expression(_) => instantiations
    }
}

collect_module_type_instantiations(
    source: SourceFile,
    module: Module,
    index: i64,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, ExpressionCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, BlockStatementCase, NominalInstantiationLookupCase, Diagnostics
} {
    if(index >= core::list_len(module.callables)) {
        instantiations
    } else {
        let callable = core::list_get(module.callables, index);
        let with_result = collect_type_instantiations(
            source, module, callable.result_type, instantiations
        );
        let with_parameters = collect_parameter_type_instantiations(
            source, module, callable.parameters, 0, with_result
        );
        collect_module_type_instantiations(
            source,
            module,
            index + 1,
            collect_expression_type_instantiations(
                source, module, callable.body, with_parameters
            )
        )
    }
}

collect_drop_type_instantiations(
    source: SourceFile,
    module: Module,
    index: i64,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, ExpressionCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, BlockStatementCase, NominalInstantiationLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.drop_declarations)) {
        instantiations
    } else {
        let callable = drop_callable(
            source, module, core::list_get(module.drop_declarations, index)
        );
        let with_result = collect_type_instantiations(
            source, module, callable.result_type, instantiations
        );
        let with_parameters = collect_parameter_type_instantiations(
            source, module, callable.parameters, 0, with_result
        );
        collect_drop_type_instantiations(
            source,
            module,
            index + 1,
            collect_expression_type_instantiations(
                source, module, callable.body, with_parameters
            )
        )
    }
}

collect_specialization_type_instantiations(
    source: SourceFile,
    module: Module,
    specializations: List<CallableSpecialization>,
    index: i64,
    instantiations: List<NominalInstantiation>,
) -> List<NominalInstantiation> / {
    ResultCase, ExpressionCase, TypeCase, TypeAliasLookupCase, StructLookupCase,
    EnumLookupCase, TypeBindingLookupCase, BlockStatementCase,
    NominalInstantiationLookupCase, Diagnostics
} {
    if(index >= core::list_len(specializations)) {
        instantiations
    } else {
        let specialization = core::list_get(specializations, index);
        let callable = specialization.callable;
        let parameters = specialize_parameters(
            callable.parameters,
            specialization.bindings,
            0,
            []
        );
        let with_result = collect_type_instantiations(
            source,
            module,
            substitute_bindings(callable.result_type, specialization.bindings),
            instantiations
        );
        let with_parameters = collect_parameter_type_instantiations(
            source, module, parameters, 0, with_result
        );
        collect_specialization_type_instantiations(
            source,
            module,
            specializations,
            index + 1,
            collect_expression_type_instantiations(
                source, module, callable.body, with_parameters
            )
        )
    }
}

lower_instantiated_field_types(
    source: SourceFile,
    module: Module,
    fields: List<TypeRef>,
    parameters: List<TypeParameter>,
    arguments: List<TypeRef>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(fields)) {
        output
    } else {
        let field = resolve_type(
            source,
            module,
            substitute_type(core::list_get(fields, index), parameters, arguments)
        );
        lower_instantiated_field_types(
            source,
            module,
            fields,
            parameters,
            arguments,
            index + 1,
            output + (if(output == "") { "" } else { ", " }) + type_name(field.kind)
        )
    }
}

struct_field_type_refs(
    fields: List<StructFieldDecl>,
    index: i64,
    output: List<TypeRef>,
) -> List<TypeRef> / {ResultCase} {
    if(index >= core::list_len(fields)) {
        output
    } else {
        struct_field_type_refs(
            fields,
            index + 1,
            core::list_push(output, core::list_get(fields, index).field_type)
        )
    }
}

lower_instantiated_variants(
    source: SourceFile,
    module: Module,
    variants: List<VariantDecl>,
    parameters: List<TypeParameter>,
    arguments: List<TypeRef>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(variants)) {
        output
    } else {
        lower_instantiated_variants(
            source,
            module,
            variants,
            parameters,
            arguments,
            index + 1,
            lower_instantiated_field_types(
                source,
                module,
                core::list_get(variants, index).fields,
                parameters,
                arguments,
                0,
                output
            )
        )
    }
}

lower_nominal_instantiations(
    source: SourceFile,
    module: Module,
    instantiations: List<NominalInstantiation>,
    index: i64,
    output: String,
) -> String / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(instantiations)) {
        output
    } else {
        let instantiation = core::list_get(instantiations, index);
        handle perform TypeCase::inspect(instantiation.reference.kind) {
            TypeCase::inspect(SourceType::Enum(name, arguments)) => {
                handle perform EnumLookupCase::lookup(lookup_enum(module.enums, name, 0)) {
                    EnumLookupCase::lookup(EnumLookup::Found(declaration)) =>
                        lower_nominal_instantiations(
                            source,
                            module,
                            instantiations,
                            index + 1,
                            output + type_name(instantiation.reference.kind) +
                                " = type { " + lower_instantiated_variants(
                                    source,
                                    module,
                                    declaration.variants,
                                    declaration.type_parameters,
                                    arguments,
                                    0,
                                    "i32"
                                ) + " }\n"
                        ),
                    EnumLookupCase::lookup(EnumLookup::Missing) => output
                }
            },
            TypeCase::inspect(SourceType::Struct(name, arguments)) => {
                handle perform StructLookupCase::lookup(
                    lookup_struct(module.structs, name, 0)
                ) {
                    StructLookupCase::lookup(StructLookup::Found(declaration)) => {
                        let field_types = struct_field_type_refs(
                            declaration.fields,
                            0,
                            []
                        );
                        lower_nominal_instantiations(
                            source,
                            module,
                            instantiations,
                            index + 1,
                            output + type_name(instantiation.reference.kind) +
                                " = type {" + lower_instantiated_field_types(
                                    source,
                                    module,
                                    field_types,
                                    declaration.type_parameters,
                                    arguments,
                                    0,
                                    ""
                                ) + " }\n"
                        )
                    },
                    StructLookupCase::lookup(StructLookup::Missing) => output
                }
            },
            TypeCase::inspect(_) => lower_nominal_instantiations(
                source, module, instantiations, index + 1, output
            )
        }
    }
}

llvm_entry_wrapper(
    source: SourceFile,
    module: Module,
    entry: CallableDecl,
) -> String / {ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase, Diagnostics} {
    let result_type = resolve_type(source, module, entry.result_type);
    let accepts_arguments = core::list_len(entry.parameters) == 1;
    let signature = if(accepts_arguments) {
        "i32 %argc, ptr %argv"
    } else {
        ""
    };
    let argument_setup = if(accepts_arguments) {
        "  %args_count_i32 = sub i32 %argc, 1\n" +
        "  %args_count = sext i32 %args_count_i32 to i64\n" +
        "  %args_present = icmp sgt i64 %args_count, 0\n" +
        "  br i1 %args_present, label %args_allocate, label %args_empty\n" +
        "args_empty:\n" +
        "  br label %args_ready\n" +
        "args_allocate:\n" +
        "  %args_data_bytes = mul i64 %args_count, 8\n" +
        "  %args_allocation_bytes = add i64 %args_data_bytes, 8\n" +
        "  %args_allocation = call ptr @malloc(i64 %args_allocation_bytes)\n" +
        "  store i64 %args_count, ptr %args_allocation\n" +
        "  %args_data = getelementptr i8, ptr %args_allocation, i64 8\n" +
        "  br label %args_copy\n" +
        "args_copy:\n" +
        "  %args_index = phi i64 [ 0, %args_allocate ], [ %args_next, %args_copy ]\n" +
        "  %argv_index = add i64 %args_index, 1\n" +
        "  %argv_slot = getelementptr ptr, ptr %argv, i64 %argv_index\n" +
        "  %argument = load ptr, ptr %argv_slot\n" +
        "  %args_slot = getelementptr ptr, ptr %args_data, i64 %args_index\n" +
        "  store ptr %argument, ptr %args_slot\n" +
        "  %args_next = add i64 %args_index, 1\n" +
        "  %args_finished = icmp eq i64 %args_next, %args_count\n" +
        "  br i1 %args_finished, label %args_ready, label %args_copy\n" +
        "args_ready:\n" +
        "  %grandiose_args = phi ptr [ @grandiose_empty_list, %args_empty ], " +
            "[ %args_allocation, %args_copy ]\n"
    } else {
        ""
    };
    let call_arguments = if(accepts_arguments) {
        "ptr %grandiose_args"
    } else {
        ""
    };
    handle perform TypeCase::inspect(result_type.kind) {
        TypeCase::inspect(SourceType::Unit) =>
            "define i32 @main(" + signature + ") {\n" +
            "entry:\n" +
            argument_setup +
            "  %result = call {} @grandiose_main(" + call_arguments + ")\n" +
            "  ret i32 0\n" +
            "}\n",
        TypeCase::inspect(SourceType::I32) =>
            "define i32 @main(" + signature + ") {\n" +
            "entry:\n" +
            argument_setup +
            "  %result = call i32 @grandiose_main(" + call_arguments + ")\n" +
            "  ret i32 %result\n" +
            "}\n",
        TypeCase::inspect(SourceType::I64) =>
            "define i32 @main(" + signature + ") {\n" +
            "entry:\n" +
            argument_setup +
            "  %result = call i64 @grandiose_main(" + call_arguments + ")\n" +
            "  %exit = trunc i64 %result to i32\n" +
            "  ret i32 %exit\n" +
            "}\n"
    }
}

hex_digit(value: i64) -> String {
    if(value < 10) {
        core::int_to_string(value)
    } else {
        if(value == 10) { "A" } else {
        if(value == 11) { "B" } else {
        if(value == 12) { "C" } else {
        if(value == 13) { "D" } else {
        if(value == 14) { "E" } else { "F" }
        } } } }
    }
}

llvm_string_bytes(
    value: String,
    index: i64,
    output: String,
) -> String / {ResultCase} {
    if(index >= core::str_byte_len(value)) {
        output
    } else {
        let byte = core::str_byte_at(value, index);
        llvm_string_bytes(
            value, index + 1,
            output + "\\" + hex_digit(byte / 16) +
                hex_digit(byte - (byte / 16) * 16)
        )
    }
}

lower_string_literal_definitions(
    tokens: List<Token>,
    index: i64,
    output: String,
) -> String / {ResultCase, TokenCase} {
    if(index >= core::list_len(tokens)) {
        output
    } else {
        let found = core::list_get(tokens, index);
        let next = handle perform TokenCase::token(found.kind) {
            TokenCase::token(TokenKind::String(value)) =>
                output + "@grandiose_string_" +
                    core::int_to_string(found.span.start) +
                    " = private unnamed_addr constant [" +
                    core::int_to_string(core::str_byte_len(value) + 1) +
                    " x i8] c\"" + llvm_string_bytes(value, 0, "") +
                    "\\00\"\n",
            TokenCase::token(_) => output
        };
        lower_string_literal_definitions(tokens, index + 1, next)
    }
}

llvm_module(
    source: SourceFile,
    module: Module,
    entry: CallableDecl,
    string_definitions: String,
) -> String / {
    ResultCase, ExpressionCase, OperatorCase, LookupCase, ParameterLookupCase,
    TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    VariantLookupCase, StructFieldLookupCase, NamedExpressionLookupCase,
    TypeBindingLookupCase, BlockStatementCase, SpecializationLookupCase,
    NominalInstantiationLookupCase, TypeInferenceCase, EffectLookupCase,
    EffectOperationLookupCase, Diagnostics
} {
    let specializations = collect_drop_specializations(
        source,
        module,
        0,
        collect_callable_specializations(source, module, 0, [])
    );
    let instantiations = collect_specialization_type_instantiations(
        source,
        module,
        specializations,
        0,
        collect_drop_type_instantiations(
            source, module, 0,
            collect_module_type_instantiations(source, module, 0, [])
        )
    );
    let closure_definitions = lower_drop_closure_definitions(
        source, module, 0,
        lower_all_closure_definitions(
            source, module, specializations, 0, 0, ""
        )
    );
    "; Grandiose LLVM bootstrap output\n" +
    "source_filename = \"grandiose-module\"\n\n" +
    "%grandiose.effect_step = type { i1, i64, i64, ptr, ptr, ptr, ptr, i64, ptr }\n" +
    "%grandiose.bind_environment = type { ptr, ptr, ptr, ptr, i64, ptr }\n" +
    "%grandiose.forward_environment = type { ptr, ptr, ptr, i64, ptr }\n" +
    "%grandiose.shared_environment = type { i64, ptr, ptr }\n" +
    "%grandiose.drop_state = type { i64, i1 }\n" +
    "%grandiose.cleanup_environment = type { ptr, ptr, ptr, ptr, i64 }\n" +
    "%grandiose.resumption = type { i64, ptr, ptr, ptr, i64, i1 }\n" +
    "%grandiose.finalize_environment = type { ptr, ptr, ptr, i64, ptr }\n" +
    "@grandiose_empty_list = private constant i64 0\n" +
    string_definitions + "\n" +
    "declare ptr @malloc(i64)\n\n" +
    "declare i32 @strcmp(ptr, ptr)\n\n" +
    "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n\n" +
    "declare void @free(ptr)\n\n" +
    "define void @grandiose_closure_drop_noop(ptr %environment) {\n" +
    "entry:\n" +
    "  ret void\n" +
    "}\n\n" +
    "define void @grandiose_drop_noop(ptr %environment) {\n" +
    "entry:\n" +
    "  ret void\n" +
    "}\n\n" +
    "define ptr @grandiose_new_drop_state() {\n" +
    "entry:\n" +
    "  %size_pointer = getelementptr %grandiose.drop_state, ptr null, i32 1\n" +
    "  %size = ptrtoint ptr %size_pointer to i64\n" +
    "  %state = call ptr @malloc(i64 %size)\n" +
    "  %s0 = insertvalue %grandiose.drop_state undef, i64 1, 0\n" +
    "  %s1 = insertvalue %grandiose.drop_state %s0, i1 true, 1\n" +
    "  store %grandiose.drop_state %s1, ptr %state\n" +
    "  ret ptr %state\n" +
    "}\n\n" +
    "define void @grandiose_retain_drop_state(ptr %state) {\n" +
    "entry:\n" +
    "  %counter = getelementptr %grandiose.drop_state, ptr %state, i32 0, i32 0\n" +
    "  %count = load i64, ptr %counter\n" +
    "  %next = add i64 %count, 1\n" +
    "  store i64 %next, ptr %counter\n" +
    "  ret void\n" +
    "}\n\n" +
    "define i1 @grandiose_claim_drop_state(ptr %state) {\n" +
    "entry:\n" +
    "  %active_pointer = getelementptr %grandiose.drop_state, ptr %state, i32 0, i32 1\n" +
    "  %active = load i1, ptr %active_pointer\n" +
    "  store i1 false, ptr %active_pointer\n" +
    "  ret i1 %active\n" +
    "}\n\n" +
    "define void @grandiose_release_drop_state(ptr %state) {\n" +
    "entry:\n" +
    "  %counter = getelementptr %grandiose.drop_state, ptr %state, i32 0, i32 0\n" +
    "  %count = load i64, ptr %counter\n" +
    "  %next = sub i64 %count, 1\n" +
    "  store i64 %next, ptr %counter\n" +
    "  %last = icmp eq i64 %next, 0\n" +
    "  br i1 %last, label %release, label %finished\n" +
    "release:\n" +
    "  call void @free(ptr %state)\n" +
    "  br label %finished\n" +
    "finished:\n" +
    "  ret void\n" +
    "}\n\n" +
    "define %grandiose.effect_step @grandiose_cleanup_step(%grandiose.effect_step %step, ptr %shared) {\n" +
    "entry:\n" +
    "  %done = extractvalue %grandiose.effect_step %step, 0\n" +
    "  br i1 %done, label %finished, label %request\n" +
    "finished:\n" +
    "  call void @grandiose_release_shared_environment(ptr %shared)\n" +
    "  ret %grandiose.effect_step %step\n" +
    "request:\n" +
    "  %effect = extractvalue %grandiose.effect_step %step, 1\n" +
    "  %operation = extractvalue %grandiose.effect_step %step, 2\n" +
    "  %payload = extractvalue %grandiose.effect_step %step, 3\n" +
    "  %resume = extractvalue %grandiose.effect_step %step, 4\n" +
    "  %environment = extractvalue %grandiose.effect_step %step, 5\n" +
    "  %quantity = extractvalue %grandiose.effect_step %step, 7\n" +
    "  %drop = extractvalue %grandiose.effect_step %step, 8\n" +
    "  %size_pointer = getelementptr %grandiose.cleanup_environment, ptr null, i32 1\n" +
    "  %size = ptrtoint ptr %size_pointer to i64\n" +
    "  %wrapper = call ptr @malloc(i64 %size)\n" +
    "  %e0 = insertvalue %grandiose.cleanup_environment undef, ptr %resume, 0\n" +
    "  %e1 = insertvalue %grandiose.cleanup_environment %e0, ptr %environment, 1\n" +
    "  %e2 = insertvalue %grandiose.cleanup_environment %e1, ptr %drop, 2\n" +
    "  %e3 = insertvalue %grandiose.cleanup_environment %e2, ptr %shared, 3\n" +
    "  %e4 = insertvalue %grandiose.cleanup_environment %e3, i64 %quantity, 4\n" +
    "  store %grandiose.cleanup_environment %e4, ptr %wrapper\n" +
    "  %s0 = insertvalue %grandiose.effect_step undef, i1 false, 0\n" +
    "  %s1 = insertvalue %grandiose.effect_step %s0, i64 %effect, 1\n" +
    "  %s2 = insertvalue %grandiose.effect_step %s1, i64 %operation, 2\n" +
    "  %s3 = insertvalue %grandiose.effect_step %s2, ptr %payload, 3\n" +
    "  %s4 = insertvalue %grandiose.effect_step %s3, ptr @grandiose_cleanup_resume, 4\n" +
    "  %s5 = insertvalue %grandiose.effect_step %s4, ptr %wrapper, 5\n" +
    "  %s6 = insertvalue %grandiose.effect_step %s5, ptr null, 6\n" +
    "  %s7 = insertvalue %grandiose.effect_step %s6, i64 %quantity, 7\n" +
    "  %s8 = insertvalue %grandiose.effect_step %s7, ptr @grandiose_cleanup_drop, 8\n" +
    "  ret %grandiose.effect_step %s8\n" +
    "}\n\n" +
    "define %grandiose.effect_step @grandiose_cleanup_resume(ptr %wrapper, ptr %boxed_value) {\n" +
    "entry:\n" +
    "  %value = load %grandiose.cleanup_environment, ptr %wrapper\n" +
    "  %resume = extractvalue %grandiose.cleanup_environment %value, 0\n" +
    "  %environment = extractvalue %grandiose.cleanup_environment %value, 1\n" +
    "  %shared = extractvalue %grandiose.cleanup_environment %value, 3\n" +
    "  %counter = getelementptr %grandiose.cleanup_environment, ptr %wrapper, i32 0, i32 4\n" +
    "  %remaining = load i64, ptr %counter\n" +
    "  %last = icmp eq i64 %remaining, 1\n" +
    "  call void @grandiose_retain_shared_environment(ptr %shared)\n" +
    "  call void @grandiose_release_resumption_environment(ptr %wrapper, ptr %counter)\n" +
    "  call void @grandiose_release_shared_environment_if(i1 %last, ptr %shared)\n" +
    "  %step = call %grandiose.effect_step %resume(ptr %environment, ptr %boxed_value)\n" +
    "  %cleaned = tail call %grandiose.effect_step @grandiose_cleanup_step(%grandiose.effect_step %step, ptr %shared)\n" +
    "  ret %grandiose.effect_step %cleaned\n" +
    "}\n\n" +
    "define void @grandiose_cleanup_drop(ptr %wrapper) {\n" +
    "entry:\n" +
    "  %value = load %grandiose.cleanup_environment, ptr %wrapper\n" +
    "  %environment = extractvalue %grandiose.cleanup_environment %value, 1\n" +
    "  %drop = extractvalue %grandiose.cleanup_environment %value, 2\n" +
    "  %shared = extractvalue %grandiose.cleanup_environment %value, 3\n" +
    "  call void %drop(ptr %environment)\n" +
    "  call void @grandiose_release_shared_environment(ptr %shared)\n" +
    "  call void @free(ptr %wrapper)\n" +
    "  ret void\n" +
    "}\n\n" +
    "define ptr @grandiose_new_resumption(ptr %function, ptr %environment, ptr %drop, i64 %quantity) {\n" +
    "entry:\n" +
    "  %size_pointer = getelementptr %grandiose.resumption, ptr null, i32 1\n" +
    "  %size = ptrtoint ptr %size_pointer to i64\n" +
    "  %handle = call ptr @malloc(i64 %size)\n" +
    "  %r0 = insertvalue %grandiose.resumption undef, i64 1, 0\n" +
    "  %r1 = insertvalue %grandiose.resumption %r0, ptr %function, 1\n" +
    "  %r2 = insertvalue %grandiose.resumption %r1, ptr %environment, 2\n" +
    "  %r3 = insertvalue %grandiose.resumption %r2, ptr %drop, 3\n" +
    "  %r4 = insertvalue %grandiose.resumption %r3, i64 %quantity, 4\n" +
    "  %r5 = insertvalue %grandiose.resumption %r4, i1 true, 5\n" +
    "  store %grandiose.resumption %r5, ptr %handle\n" +
    "  ret ptr %handle\n" +
    "}\n\n" +
    "define void @grandiose_retain_resumption(ptr %handle) {\n" +
    "entry:\n" +
    "  %counter = getelementptr %grandiose.resumption, ptr %handle, i32 0, i32 0\n" +
    "  %count = load i64, ptr %counter\n" +
    "  %next = add i64 %count, 1\n" +
    "  store i64 %next, ptr %counter\n" +
    "  ret void\n" +
    "}\n\n" +
    "define void @grandiose_cancel_resumption(ptr %handle) {\n" +
    "entry:\n" +
    "  %active_pointer = getelementptr %grandiose.resumption, ptr %handle, i32 0, i32 5\n" +
    "  %active = load i1, ptr %active_pointer\n" +
    "  br i1 %active, label %cancel, label %finished\n" +
    "cancel:\n" +
    "  %value = load %grandiose.resumption, ptr %handle\n" +
    "  %environment = extractvalue %grandiose.resumption %value, 2\n" +
    "  %drop = extractvalue %grandiose.resumption %value, 3\n" +
    "  call void %drop(ptr %environment)\n" +
    "  store i1 false, ptr %active_pointer\n" +
    "  br label %finished\n" +
    "finished:\n" +
    "  ret void\n" +
    "}\n\n" +
    "define void @grandiose_release_resumption(ptr %handle) {\n" +
    "entry:\n" +
    "  %counter = getelementptr %grandiose.resumption, ptr %handle, i32 0, i32 0\n" +
    "  %count = load i64, ptr %counter\n" +
    "  %next = sub i64 %count, 1\n" +
    "  store i64 %next, ptr %counter\n" +
    "  %last = icmp eq i64 %next, 0\n" +
    "  br i1 %last, label %release, label %finished\n" +
    "release:\n" +
    "  call void @grandiose_cancel_resumption(ptr %handle)\n" +
    "  call void @free(ptr %handle)\n" +
    "  br label %finished\n" +
    "finished:\n" +
    "  ret void\n" +
    "}\n\n" +
    "define void @grandiose_release_resumption_if(i1 %condition, ptr %handle) {\n" +
    "entry:\n" +
    "  br i1 %condition, label %release, label %finished\n" +
    "release:\n" +
    "  call void @grandiose_release_resumption(ptr %handle)\n" +
    "  br label %finished\n" +
    "finished:\n" +
    "  ret void\n" +
    "}\n\n" +
    "define %grandiose.effect_step @grandiose_resume_resumption(ptr %handle, ptr %boxed_value) {\n" +
    "entry:\n" +
    "  %value = load %grandiose.resumption, ptr %handle\n" +
    "  %function = extractvalue %grandiose.resumption %value, 1\n" +
    "  %environment = extractvalue %grandiose.resumption %value, 2\n" +
    "  %remaining_pointer = getelementptr %grandiose.resumption, ptr %handle, i32 0, i32 4\n" +
    "  %remaining = load i64, ptr %remaining_pointer\n" +
    "  %bounded = icmp ne i64 %remaining, -1\n" +
    "  %decremented = sub i64 %remaining, 1\n" +
    "  %next = select i1 %bounded, i64 %decremented, i64 %remaining\n" +
    "  store i64 %next, ptr %remaining_pointer\n" +
    "  %zero = icmp eq i64 %next, 0\n" +
    "  %last = and i1 %bounded, %zero\n" +
    "  %active_pointer = getelementptr %grandiose.resumption, ptr %handle, i32 0, i32 5\n" +
    "  %active = xor i1 %last, true\n" +
    "  store i1 %active, ptr %active_pointer\n" +
    "  %step = call %grandiose.effect_step %function(ptr %environment, ptr %boxed_value)\n" +
    "  ret %grandiose.effect_step %step\n" +
    "}\n\n" +
    "define %grandiose.effect_step @grandiose_finalize_resumption_step(%grandiose.effect_step %step, ptr %handle) {\n" +
    "entry:\n" +
    "  %done = extractvalue %grandiose.effect_step %step, 0\n" +
    "  br i1 %done, label %finished, label %request\n" +
    "finished:\n" +
    "  call void @grandiose_release_resumption(ptr %handle)\n" +
    "  ret %grandiose.effect_step %step\n" +
    "request:\n" +
    "  %effect = extractvalue %grandiose.effect_step %step, 1\n" +
    "  %operation = extractvalue %grandiose.effect_step %step, 2\n" +
    "  %payload = extractvalue %grandiose.effect_step %step, 3\n" +
    "  %resume = extractvalue %grandiose.effect_step %step, 4\n" +
    "  %environment = extractvalue %grandiose.effect_step %step, 5\n" +
    "  %quantity = extractvalue %grandiose.effect_step %step, 7\n" +
    "  %drop = extractvalue %grandiose.effect_step %step, 8\n" +
    "  %size_pointer = getelementptr %grandiose.finalize_environment, ptr null, i32 1\n" +
    "  %size = ptrtoint ptr %size_pointer to i64\n" +
    "  %wrapper = call ptr @malloc(i64 %size)\n" +
    "  %e0 = insertvalue %grandiose.finalize_environment undef, ptr %resume, 0\n" +
    "  %e1 = insertvalue %grandiose.finalize_environment %e0, ptr %environment, 1\n" +
    "  %e2 = insertvalue %grandiose.finalize_environment %e1, ptr %handle, 2\n" +
    "  %e3 = insertvalue %grandiose.finalize_environment %e2, i64 %quantity, 3\n" +
    "  %e4 = insertvalue %grandiose.finalize_environment %e3, ptr %drop, 4\n" +
    "  store %grandiose.finalize_environment %e4, ptr %wrapper\n" +
    "  %s0 = insertvalue %grandiose.effect_step undef, i1 false, 0\n" +
    "  %s1 = insertvalue %grandiose.effect_step %s0, i64 %effect, 1\n" +
    "  %s2 = insertvalue %grandiose.effect_step %s1, i64 %operation, 2\n" +
    "  %s3 = insertvalue %grandiose.effect_step %s2, ptr %payload, 3\n" +
    "  %s4 = insertvalue %grandiose.effect_step %s3, ptr @grandiose_finalize_resumption_resume, 4\n" +
    "  %s5 = insertvalue %grandiose.effect_step %s4, ptr %wrapper, 5\n" +
    "  %s6 = insertvalue %grandiose.effect_step %s5, ptr null, 6\n" +
    "  %s7 = insertvalue %grandiose.effect_step %s6, i64 %quantity, 7\n" +
    "  %s8 = insertvalue %grandiose.effect_step %s7, ptr @grandiose_finalize_resumption_drop, 8\n" +
    "  ret %grandiose.effect_step %s8\n" +
    "}\n\n" +
    "define %grandiose.effect_step @grandiose_finalize_resumption_resume(ptr %wrapper, ptr %boxed_value) {\n" +
    "entry:\n" +
    "  %value = load %grandiose.finalize_environment, ptr %wrapper\n" +
    "  %resume = extractvalue %grandiose.finalize_environment %value, 0\n" +
    "  %environment = extractvalue %grandiose.finalize_environment %value, 1\n" +
    "  %handle = extractvalue %grandiose.finalize_environment %value, 2\n" +
    "  %counter = getelementptr %grandiose.finalize_environment, ptr %wrapper, i32 0, i32 3\n" +
    "  %remaining = load i64, ptr %counter\n" +
    "  %last = icmp eq i64 %remaining, 1\n" +
    "  call void @grandiose_retain_resumption(ptr %handle)\n" +
    "  call void @grandiose_release_resumption_environment(ptr %wrapper, ptr %counter)\n" +
    "  call void @grandiose_release_resumption_if(i1 %last, ptr %handle)\n" +
    "  %step = call %grandiose.effect_step %resume(ptr %environment, ptr %boxed_value)\n" +
    "  %finalized = tail call %grandiose.effect_step @grandiose_finalize_resumption_step(%grandiose.effect_step %step, ptr %handle)\n" +
    "  ret %grandiose.effect_step %finalized\n" +
    "}\n\n" +
    "define void @grandiose_finalize_resumption_drop(ptr %wrapper) {\n" +
    "entry:\n" +
    "  %value = load %grandiose.finalize_environment, ptr %wrapper\n" +
    "  %environment = extractvalue %grandiose.finalize_environment %value, 1\n" +
    "  %handle = extractvalue %grandiose.finalize_environment %value, 2\n" +
    "  %drop = extractvalue %grandiose.finalize_environment %value, 4\n" +
    "  call void %drop(ptr %environment)\n" +
    "  call void @grandiose_release_resumption(ptr %handle)\n" +
    "  call void @free(ptr %wrapper)\n" +
    "  ret void\n" +
    "}\n\n" +
    "define void @grandiose_release_resumption_environment(ptr %environment, ptr %counter) {\n" +
    "entry:\n" +
    "  %count = load i64, ptr %counter\n" +
    "  %unbounded = icmp eq i64 %count, -1\n" +
    "  br i1 %unbounded, label %finished, label %bounded\n" +
    "bounded:\n" +
    "  %next = sub i64 %count, 1\n" +
    "  store i64 %next, ptr %counter\n" +
    "  %last = icmp eq i64 %next, 0\n" +
    "  br i1 %last, label %release, label %finished\n" +
    "release:\n" +
    "  call void @free(ptr %environment)\n" +
    "  br label %finished\n" +
    "finished:\n" +
    "  ret void\n" +
    "}\n\n" +
    "define void @grandiose_retain_shared_environment(ptr %environment) {\n" +
    "entry:\n" +
    "  %counter = getelementptr %grandiose.shared_environment, ptr %environment, i32 0, i32 0\n" +
    "  %count = load i64, ptr %counter\n" +
    "  %next = add i64 %count, 1\n" +
    "  store i64 %next, ptr %counter\n" +
    "  ret void\n" +
    "}\n\n" +
    "define void @grandiose_release_shared_environment(ptr %environment) {\n" +
    "entry:\n" +
    "  %counter = getelementptr %grandiose.shared_environment, ptr %environment, i32 0, i32 0\n" +
    "  %count = load i64, ptr %counter\n" +
    "  %next = sub i64 %count, 1\n" +
    "  store i64 %next, ptr %counter\n" +
    "  %last = icmp eq i64 %next, 0\n" +
    "  br i1 %last, label %release, label %finished\n" +
    "release:\n" +
    "  %shared = load %grandiose.shared_environment, ptr %environment\n" +
    "  %payload = extractvalue %grandiose.shared_environment %shared, 1\n" +
    "  %drop = extractvalue %grandiose.shared_environment %shared, 2\n" +
    "  call void %drop(ptr %payload)\n" +
    "  call void @free(ptr %environment)\n" +
    "  br label %finished\n" +
    "finished:\n" +
    "  ret void\n" +
    "}\n\n" +
    "define void @grandiose_release_shared_environment_if(i1 %condition, ptr %environment) {\n" +
    "entry:\n" +
    "  br i1 %condition, label %release, label %finished\n" +
    "release:\n" +
    "  call void @grandiose_release_shared_environment(ptr %environment)\n" +
    "  br label %finished\n" +
    "finished:\n" +
    "  ret void\n" +
    "}\n\n" +
    lower_struct_declarations(source, module, 0, "") + "\n" +
    lower_enum_declarations(source, module, 0, "") + "\n" +
    lower_nominal_instantiations(source, module, instantiations, 0, "") + "\n" +
    closure_definitions +
    lower_specializations(source, module, specializations, 0, "") +
    lower_drop_callables(source, module, 0, "") +
    lower_callables(source, module, module.callables, 0, "") +
    llvm_entry_wrapper(source, module, entry)
}

report_entry_warning(
    path: String,
    source: String,
    result_type: TypeRef,
    expression: Expression,
) -> / {ResultCase, ExpressionCase, TypeCase, BlockStatementCase, Diagnostics} {
    handle perform TypeCase::inspect(result_type.kind) {
        TypeCase::inspect(SourceType::I32) => (),
        TypeCase::inspect(SourceType::I64) => {
            handle perform ExpressionCase::expression(expression) {
                ExpressionCase::expression(Expression::Integer(value, span)) => {
                    report_if(
                        value > 2147483647,
                        CompilerDiagnostic {
                            severity: DiagnosticSeverity::Warning,
                            code: "GRC2001",
                            title: "exit value will be truncated",
                            source: SourceFile { path: path, text: source },
                            primary: span,
                            message: "this i64 value does not fit in the native i32 `main` result",
                            secondary: [],
                            note: "`grandiose_main` still returns the complete i64 value",
                            help: "use a value no greater than 2147483647 to preserve the native exit value",
                        }
                    )
                },
                ExpressionCase::expression(Expression::Block(statements, _)) => {
                    let final_statement = core::list_get(
                        statements,
                        core::list_len(statements) - 1
                    );
                    handle perform BlockStatementCase::inspect(final_statement) {
                        BlockStatementCase::inspect(BlockStatement::Value(value)) =>
                            report_entry_warning(path, source, result_type, value),
                        BlockStatementCase::inspect(_) => ()
                    }
                },
                ExpressionCase::expression(_) => ()
            }
        }
    }
}

expression_description(expression: Expression) -> String / {
    ResultCase, ExpressionCase, BlockStatementCase
} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Integer(value, _)) => if(value == 0) {
            "successful"
        } else {
            "non-zero"
        },
        ExpressionCase::expression(Expression::Block(statements, _)) => {
            let final_statement = core::list_get(
                statements,
                core::list_len(statements) - 1
            );
            handle perform BlockStatementCase::inspect(final_statement) {
                BlockStatementCase::inspect(BlockStatement::Value(value)) =>
                    expression_description(value),
                BlockStatementCase::inspect(_) => "computed"
            }
        },
        ExpressionCase::expression(_) => "computed"
    }
}

is_zero(expression: Expression) -> Bool / {ExpressionCase, BlockStatementCase} {
    handle perform ExpressionCase::expression(expression) {
        ExpressionCase::expression(Expression::Integer(value, _)) => value == 0,
        ExpressionCase::expression(Expression::Negate(operand, _)) => is_zero(operand),
        ExpressionCase::expression(Expression::Block(statements, _)) => {
            let final_statement = core::list_get(
                statements,
                core::list_len(statements) - 1
            );
            handle perform BlockStatementCase::inspect(final_statement) {
                BlockStatementCase::inspect(BlockStatement::Value(value)) => is_zero(value),
                BlockStatementCase::inspect(_) => false
            }
        },
        ExpressionCase::expression(_) => false
    }
}

lookup_callable(
    callables: List<CallableDecl>,
    name: String,
    index: i64,
) -> CallableLookup / {ResultCase} {
    if(index >= core::list_len(callables)) {
        CallableLookup::Missing
    } else {
            let candidate = core::list_get(callables, index);
            if(candidate.name == name) {
                CallableLookup::Found(candidate)
            } else {
                lookup_callable(callables, name, index + 1)
            }
        }
}

