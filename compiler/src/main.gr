    index: i64,
) -> GlobalLookup / {ResultCase} {
    handle perform ResultCase::inspect(
        list_find(globals, index, { candidate => candidate.name == name })
    ) {
        ResultCase::inspect(Result::Ok(found)) => GlobalLookup::Found(found),
        ResultCase::inspect(Result::Err(_)) => GlobalLookup::Missing
    }
}

global_callable_name(name: String) -> String {
    "$grandiose.global$" + name
}

