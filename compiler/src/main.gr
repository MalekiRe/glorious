lambda_parameter_binds_name(
    parameters: List<LambdaParameter>, name: String, index: i64,
) -> Bool / {ResultCase} {
    list_any(parameters, index, { candidate => candidate.name == name })
}

shadowed_with_lambda_parameters(
    shadowed: List<String>, parameters: List<LambdaParameter>, index: i64,
) -> List<String> / {ResultCase} {
    if(index >= core::list_len(parameters)) {
        shadowed
    } else {
        shadowed_with_lambda_parameters(
            core::list_push(shadowed, core::list_get(parameters, index).name),
            parameters,
            index + 1
        )
    }
}

