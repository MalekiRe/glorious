type MirInstruction = Result<String, String>;

struct MirExpression {
    instructions: List<MirInstruction>,
    value: String,
    next_temporary: i64,
}

mir_simple(line: String) -> MirInstruction {
    Result::Ok(line)
}

mir_raw(text: String) -> MirInstruction {
    Result::Err(text)
}

mir_instruction_text(instruction: MirInstruction) -> String {
    handle perform ResultCase::inspect(instruction) {
        ResultCase::inspect(Result::Ok(line)) => "  " + line + "\n",
        ResultCase::inspect(Result::Err(text)) => text
    }
}

mir_text_linear(
    instructions: List<MirInstruction>, index: i64, limit: i64, output: String,
) -> String / {ResultCase} {
    if(index >= limit) {
        output
    } else {
        mir_text_linear(
            instructions, index + 1, limit,
            output + mir_instruction_text(core::list_get(instructions, index))
        )
    }
}

mir_text_range(
    instructions: List<MirInstruction>, from: i64, limit: i64,
) -> String / {ResultCase} {
    if(limit - from <= 8) {
        mir_text_linear(instructions, from, limit, "")
    } else {
        let middle = from + (limit - from) / 2;
        mir_text_range(instructions, from, middle) +
            mir_text_range(instructions, middle, limit)
    }
}

mir_text(
    instructions: List<MirInstruction>, index: i64, output: String,
) -> String / {ResultCase} {
    output + mir_text_range(instructions, index, core::list_len(instructions))
}

mir_instruction_byte_len(instruction: MirInstruction) -> i64 / {ResultCase} {
    handle perform ResultCase::inspect(instruction) {
        ResultCase::inspect(Result::Ok(line)) => 3 + core::str_byte_len(line),
        ResultCase::inspect(Result::Err(text)) => core::str_byte_len(text)
    }
}

mir_instructions_byte_len(
    instructions: List<MirInstruction>, index: i64, total: i64,
) -> i64 / {ResultCase} {
    if(index >= core::list_len(instructions)) {
        total
    } else {
        mir_instructions_byte_len(
            instructions, index + 1,
            total + mir_instruction_byte_len(core::list_get(instructions, index))
        )
    }
}

mir_append(
    front: List<MirInstruction>, back: List<MirInstruction>, index: i64,
) -> List<MirInstruction> / {ResultCase} {
    core::list_concat(front, back)
}

mir_expression(
    instructions: List<MirInstruction>, value: String, next_temporary: i64,
) -> MirExpression {
    MirExpression {
        instructions: instructions,
        value: value,
        next_temporary: next_temporary,
    }
}

mir_printed(lowered: MirExpression) -> LoweredExpression / {ResultCase} {
    LoweredExpression {
        instructions: mir_text(lowered.instructions, 0, ""),
        value: lowered.value,
        next_temporary: lowered.next_temporary,
    }
}

struct MirBlock {
    label: String,
    instructions: List<MirInstruction>,
    terminator: String,
}

mir_of_blocks(
    blocks: List<MirBlock>, index: i64, output: List<MirInstruction>,
) -> List<MirInstruction> / {ResultCase} {
    if(index >= core::list_len(blocks)) {
        output
    } else {
        let block = core::list_get(blocks, index);
        mir_of_blocks(
            blocks, index + 1,
            mir_append(mir_append(
                (if(block.label != "") {
                    mir_append(output, [mir_raw(block.label + ":\n")], 0)
                } else {
                    output
                }),
                block.instructions, 0
            ), (if(block.terminator != "") {
                [mir_raw(block.terminator)]
            } else { [] }), 0)
        )
    }
}

struct MirArguments {
    instructions: List<MirInstruction>,
    values: String,
    next_temporary: i64,
}

