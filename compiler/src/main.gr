drop_is_present(
    source: SourceFile,
    module: Module,
    target: TypeRef,
    index: i64,
) -> Bool / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.drop_declarations)) {
        false
    } else {
        same_type(
            resolve_type(
                source, module,
                core::list_get(module.drop_declarations, index).target
            ),
            target
        ) or { => drop_is_present(source, module, target, index + 1)
     }}
}

