drop_is_present(
    source: SourceFile,
    module: Module,
    target: TypeRef,
    index: i64,
) -> Bool / {
    ResultCase, TypeCase, TypeAliasLookupCase, StructLookupCase, EnumLookupCase,
    Diagnostics
} {
    if(index >= core::list_len(module.drop_declarations)) {
        false
    } else {
        let declaration = core::list_get(module.drop_declarations, index);
        if(same_type(
            resolve_type(source, module, declaration.target), target
        )) {
            true
        } else {
            drop_is_present(source, module, target, index + 1)
        }
    }
}

