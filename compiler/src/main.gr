effect Console {
    [1,1] write_line(text: &str) ->;
    [1,1] error_line(text: &str) ->;
}

effect Files {
    [1,1] read_to_string(path: &str) -> String;
    [1,1] write_string(path: &str, contents: &str) ->;
    [1,1] append_string(path: &str, contents: &str) ->;
}

effect ResultCase {
    inspect(value: Result) -> !;
}

effect CharacterCase {
    character(value: String) -> !;
}

effect TokenCase {
    token(kind: TokenKind) -> !;
}

effect ExpressionCase {
    expression(value: Expression) -> !;
}

effect OperatorCase {
    operator(value: BinaryOperator) -> !;
}

effect LookupCase {
    lookup(value: CallableLookup) -> !;
}

effect ParameterLookupCase {
    lookup(value: ParameterLookup) -> !;
}

effect TypeCase {
    inspect(value: SourceType) -> !;
}

effect TypeAliasLookupCase {
    lookup(value: TypeAliasLookup) -> !;
}

effect StructLookupCase {
    lookup(value: StructLookup) -> !;
}

effect StructFieldLookupCase {
    lookup(value: StructFieldLookup) -> !;
}

effect EnumLookupCase {
    lookup(value: EnumLookup) -> !;
}

effect VariantLookupCase {
    lookup(value: VariantLookup) -> !;
}

effect BlockStatementCase {
    inspect(value: BlockStatement) -> !;
}

effect PatternCase {
    inspect(value: Pattern) -> !;
}

effect Diagnostics {
    abort(diagnostic: CompilerDiagnostic) -> !;
}

effect Reporting {
    [0,infinity] report(diagnostic: CompilerDiagnostic) ->;
}

cases TypeCases = {ResultCase, TypeCase};
cases ParseCases = {ResultCase, TokenCase, Diagnostics};
cases ExpressionWalkCases = {
    ResultCase, ExpressionCase, BlockStatementCase
};

enum DiagnosticSeverity {
    Error,
    Warning,
    Advice,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

type Option<T> = Result<T, ()>;
type Bool = Option<()>;

let None = Result::Err(());
let true = Result::Ok(());
let false = None;

bool_value(value: Bool) -> Bool { value }

infixr 1 else;
infixr 2 or;
infixr 3 and;
prefix 10 not;

struct SourceFile {
    path: String,
    text: String,
}

struct SourceSpan {
    start: i64,
    end: i64,
}

struct DiagnosticLabel {
    span: SourceSpan,
    message: String,
}

struct CompilerDiagnostic {
    severity: DiagnosticSeverity,
    code: String,
    title: String,
    source: SourceFile,
    primary: SourceSpan,
    message: String,
    secondary: List<DiagnosticLabel>,
    note: String,
    help: String,
}

struct CallableDecl {
    name: String,
    name_span: SourceSpan,
    type_parameters: List<TypeParameter>,
    callable_constraints: List<CallableConstraint>,
    use_constraints: List<UseConstraint>,
    environment_constraints: List<EnvironmentConstraint>,
    runs_in_constraints: List<RunsInConstraint>,
    parameters: List<Parameter>,
    result_type: TypeRef,
    effects: List<TypeRef>,
    body: Expression,
    span: SourceSpan,
}

struct Parameter {
    name: String,
    span: SourceSpan,
    parameter_type: TypeRef,
    is_local: Bool,
    drop_flag: String,
    llvm_name: String,
}

push_parameter(
    parameters: List<Parameter>,
    parameter: Parameter,
) -> List<Parameter> {
    core::list_push(parameters, parameter)
}

enum SourceType {
    Inferred,
    Unit,
    Never,
    String,
    Str,
    List(Indirect<TypeRef>),
    I32,
    I64,
    Named(String),
    Applied(String, List<TypeRef>),
    Generic(String),
    Callable(List<TypeRef>, Indirect<TypeRef>, Bool),
    Resumption(Indirect<TypeRef>, Indirect<TypeRef>),
    Available(Indirect<TypeRef>),
    SharedReference(Indirect<TypeRef>),
    UniqueReference(Indirect<TypeRef>),
    Indirect(List<TypeRef>),
    Environment(String),
    Struct(String, List<TypeRef>),
    Enum(String, List<TypeRef>),
}

struct TypeRef {
    kind: SourceType,
    span: SourceSpan,
}

type_reference(kind: SourceType, span: SourceSpan) -> TypeRef {
    TypeRef { kind: kind, span: span }
}

push_type_reference(
    references: List<TypeRef>, reference: TypeRef,
) -> List<TypeRef> {
    core::list_push(references, reference)
}

indirect_target(storage: List<TypeRef>) -> TypeRef / {ResultCase} {
    core::list_get(storage, 0)
}

type_ref_kind(reference: TypeRef) -> SourceType {
    reference.kind
}

closure_body_expected(expected: TypeRef) -> TypeRef / {TypeCase} {
    handle perform TypeCase::inspect(expected.kind) {
        TypeCase::inspect(SourceType::Callable(_, output, _)) => output,
        TypeCase::inspect(_) => expected
    }
}

pattern_binding_type(reference: TypeRef) -> TypeRef / {TypeCases} {
    handle perform TypeCase::inspect(reference.kind) {
        TypeCase::inspect(SourceType::Indirect(storage)) => indirect_target(storage),
        TypeCase::inspect(_) => reference
    }
}

lower_parameter_value(
    parameter: Parameter,
    expected: TypeRef,
    clears_drop_flag: Bool,
    next_temporary: i64,
) -> MirExpression / {TypeCases} {
    let after_claim = next_temporary + (if(clears_drop_flag) { 1 } else { 0 });
    let loaded = handle perform TypeCase::inspect(parameter.parameter_type.kind) {
        TypeCase::inspect(SourceType::Indirect(storage)) => {
            let target = indirect_target(storage);
            handle perform TypeCase::inspect(expected.kind) {
                TypeCase::inspect(SourceType::Indirect(_)) => mir_expression(
                    [], parameter.llvm_name, after_claim
                ),
                TypeCase::inspect(_) => mir_expression(
                    [
                        mir_simple("%t" +
                            core::int_to_string(after_claim) + " = load " +
                            type_name(type_ref_kind(target)) + ", ptr " +
                            parameter.llvm_name),
                    ],
                    "%t" + core::int_to_string(after_claim),
                    after_claim + 1
                )
            }
        },
        TypeCase::inspect(_) => mir_expression(
            [], parameter.llvm_name, after_claim
        )
    };
    MirExpression {
        instructions: mir_append(
            (if(clears_drop_flag) {
                [mir_simple("%t" + core::int_to_string(next_temporary) +
                    " = call i1 @grandiose_claim_drop_state(ptr " +
                    parameter.drop_flag + ")")]
            } else { [] }),
            loaded.instructions, 0
        ),
        value: loaded.value,
        next_temporary: loaded.next_temporary,
    }
}

