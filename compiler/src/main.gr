variant_payload_offset(
    variants: List<VariantDecl>,
    target: i64,
    index: i64,
    offset: i64,
) -> i64 / {ResultCase} {
    if(index >= target) {
        offset
    } else {
        variant_payload_offset(
            variants,
            target,
            index + 1,
            offset + core::list_len(core::list_get(variants, index).fields)
        )
    }
