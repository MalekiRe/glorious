use std::*;
use super::Event;
use super::Failure;
use super::super::kernel::operation;
use super::super::kernel::order;

// An option set is an ordinary map: replacing a key before admission keeps
// its last value. Empty and arbitrary UTF-8 keys/values are permitted. Only
// the sealed index order, never bucket/resident order, is canonical input.
pub struct Limits { entries: usize, key_bytes: usize, value_bytes: usize }
pub struct Builder { private work: Option<Work>, private limits: Limits }
pub impl Use<[0, 1]> for Builder {}
pub struct Admitted { private values: HashMap<String, String>, private indices: Vec<usize> }
struct Work {
    values: HashMap<String, String>, sorter: order::Builder, indices: Vec<usize>,
    comparison: Option<Comparison>, cursor: usize, phase: Phase,
}
struct Comparison { left: usize, right: usize, byte: usize }
enum Phase { Sort, Validate, Ready }

pub fn begin(values: HashMap<String, String>, limits: Limits) -> Builder {
    let count = HashMap::len(&values);
    Builder { work: Result::Ok(Work { values: values, sorter: order::begin(count, limits.entries),
        indices: Vec<usize>::new(), comparison: None, cursor: 0, phase: Phase::Sort }), limits: limits }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
pub fn len(value: &Admitted) -> usize { Vec::len(&value.indices) }
pub fn get<'a>(value: &'a Admitted, key: &String) -> Option<&'a String> { HashMap::get(&value.values, key) }
pub fn entry<'a>(value: &'a Admitted, index: usize) -> Option<&'a HashMapEntry<String, String>> {
    handle index < Vec::len(&value.indices) {
        false => None,
        true => {
            let resident = *Vec::get_unchecked(&value.indices, index);
            let entries = HashMap::entries(&value.values);
            Result::Ok(Slice::get_unchecked(entries, resident))
        },
    }
}
pub fn into_map(value: Admitted) -> HashMap<String, String> {
    handle value { Admitted { values: values, indices: _ } => values }
}
fn order_error(error: order::Failure) -> Failure {
    handle error {
        order::Failure::Control(error) => Failure::Control(error),
        order::Failure::Capacity { actual: _, limit: limit } => Failure::Capacity { name: 7, limit: limit },
        _ => Failure::Invariant,
    }
}
fn compare(work: &Work, state: &Comparison) -> Option<Ordering> {
    let entries = HashMap::entries(&work.values);
    let left = Slice::get_unchecked(entries, state.left);
    let right = Slice::get_unchecked(entries, state.right);
    let a = HashMapEntry::key(left); let b = HashMapEntry::key(right);
    let left_text = String::as_str(a); let right_text = String::as_str(b);
    order::byte_order(left_text, right_text, state.byte)
}
fn sort_step(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle Option::take(&mut work.comparison) {
        Result::Ok(state) => handle compare(& *work, &state) {
            Result::Err(_) => {
                (*work).comparison = Result::Ok(Comparison { left: state.left, right: state.right, byte: state.byte + 1 });
                Result::Ok(Event::Continue)
            },
            Result::Ok(answer) => handle order::compared(&mut work.sorter, controls, answer) {
                Result::Err(error) => Result::Err(order_error(error)), Result::Ok(_) => Result::Ok(Event::Continue),
            },
        },
        Result::Err(_) => handle order::step(&mut work.sorter, &mut *controls) {
            Result::Err(error) => Result::Err(order_error(error)),
            Result::Ok(event) => handle event {
                order::Event::Continue => Result::Ok(Event::Continue),
                order::Event::Compare { left: left, right: right } => {
                    (*work).comparison = Result::Ok(Comparison { left: left, right: right, byte: 0 });
                    Result::Ok(Event::Continue)
                },
                order::Event::Ready => handle order::finish(&mut work.sorter, & *controls) {
                    Result::Err(error) => Result::Err(order_error(error)),
                    Result::Ok(indices) => { (*work).indices = indices; (*work).phase = Phase::Validate; Result::Ok(Event::Continue) },
                },
            },
        },
    }
}
fn validate(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle work.cursor == Vec::len(&work.indices) {
        true => { (*work).phase = Phase::Ready; Result::Ok(Event::Ready) },
        false => {
            let entries = HashMap::entries(&work.values);
            let index = *Vec::get_unchecked(&work.indices, work.cursor);
            let entry = Slice::get_unchecked(entries, index);
            let key = HashMapEntry::key(entry); let value = HashMapEntry::value(entry);
            handle String::len(key) > limits.key_bytes {
                true => Result::Err(Failure::Capacity { name: 8, limit: limits.key_bytes }),
                false => handle String::len(value) > limits.value_bytes {
                    true => Result::Err(Failure::Capacity { name: 9, limit: limits.value_bytes }),
                    false => { (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
                },
            }
        },
    }
}
fn checked(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle operation::charge(&mut *controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle HashMap::len(&work.values) > builder.limits.entries {
                true => Result::Err(Failure::Capacity { name: 7, limit: builder.limits.entries }),
                false => handle work.phase {
                    Phase::Sort => sort_step(work, controls), Phase::Validate => validate(work, builder.limits), Phase::Ready => Result::Ok(Event::Ready),
                },
            },
        },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = checked(&mut *builder, controls);
    handle result { Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<Admitted, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase {
                Phase::Ready => Result::Ok(Admitted { values: work.values, indices: work.indices }), _ => Result::Err(Failure::Busy),
            },
        },
    }
}
