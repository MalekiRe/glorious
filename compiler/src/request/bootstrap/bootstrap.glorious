use std::*;
use super::AdmittedSource;
use super::BootstrapStage;
use super::Event;
use super::Failure;
use super::InputError;
use super::super::kernel::identity;
use super::super::kernel::identity::Digest;
use super::super::kernel::operation;
use super::super::source;

// This builder consumes real admitted sources, never caller-asserted lengths.
// The complete normalizer must run its cross-input admission before this stage.
pub struct Builder { private work: Option<Work> }
pub impl Use<[0, 1]> for Builder {}
pub struct AdmittedStage { private stage: BootstrapStage, private sources: Vec<AdmittedSource> }
struct Work {
    stage: BootstrapStage, compiler: Digest, sources: Vec<AdmittedSource>,
    optimization: Option<String>, cursor: usize, total: u64, phase: Phase,
}
enum Phase { Header, Count, Bytes, Options, Ready }

pub fn begin(stage: BootstrapStage, compiler: Digest, sources: Vec<AdmittedSource>, optimization: Option<String>) -> Builder {
    Builder { work: Result::Ok(Work { stage: stage, compiler: compiler, sources: sources,
        optimization: optimization, cursor: 0, total: 0, phase: Phase::Header }) }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
pub fn stage<'a>(value: &'a AdmittedStage) -> &'a BootstrapStage { &value.stage }
pub fn sources<'a>(value: &'a AdmittedStage) -> Slice<'a, AdmittedSource> { Vec::as_slice(&value.sources) }
pub fn into_parts(value: AdmittedStage) -> (BootstrapStage, Vec<AdmittedSource>) {
    handle value { AdmittedStage { stage: stage, sources: sources } => (stage, sources) }
}

fn invalid(reason: Str<'static>) -> InputError { InputError::InvalidBootstrapStage { reason: Str::to_string(reason) } }
fn predecessor(stage: &BootstrapStage) -> Result<(), InputError> {
    handle stage.ordinal == 1 {
        true => handle stage.expected_artifact {
            Result::Ok(_) => Result::Err(invalid("seed stage must not pin a predecessor artifact")),
            Result::Err(_) => Result::Ok(()),
        },
        false => handle stage.expected_artifact {
            Result::Err(_) => Result::Err(invalid("non-seed stages must pin their predecessor artifact")),
            Result::Ok(expected) => handle identity::equal(expected, stage.producer) {
                false => Result::Err(invalid("non-seed producer must equal the pinned predecessor artifact")),
                true => Result::Ok(()),
            },
        },
    }
}
fn positive_limits(stage: &BootstrapStage, compiler: Digest) -> Result<(), InputError> {
    handle stage.limits.max_sources == 0 {
        true => Result::Err(invalid("source limits must be positive")),
        false => handle stage.limits.max_total_source_bytes == 0 {
            true => Result::Err(invalid("source limits must be positive")),
            false => handle identity::equal(stage.producer, compiler) {
                false => Result::Err(invalid("bootstrap producer must match compiler build identity")),
                true => predecessor(stage),
            },
        },
    }
}
fn header(stage: &BootstrapStage, compiler: Digest) -> Result<(), InputError> {
    handle stage.ordinal == 0 {
        true => Result::Err(invalid("stage ordinal must be positive")),
        false => handle stage.optimization_level > 3 {
            true => Result::Err(invalid("optimization level must be in the range 0..=3")),
            false => positive_limits(stage, compiler),
        },
    }
}
fn byte_step(work: &mut Work) -> Result<Event, InputError> {
    handle work.cursor == Vec::len(&work.sources) {
        true => handle work.total > work.stage.limits.max_total_source_bytes {
            true => Result::Err(InputError::BootstrapSourceLimit { actual: work.total, limit: work.stage.limits.max_total_source_bytes }),
            false => { (*work).phase = Phase::Options; Result::Ok(Event::Continue) },
        },
        false => {
            let input = Vec::get_unchecked(&work.sources, work.cursor);
            let blob = super::blob(input);
            let length = as<u64>(source::length(blob));
            handle length <= wrapping_sub<u64>(18446744073709551615, work.total) {
                false => Result::Err(invalid("total source byte count overflows u64")),
                true => {
                    (*work).total = wrapping_add(work.total, length);
                    (*work).cursor = work.cursor + 1;
                    Result::Ok(Event::Continue)
                },
            }
        },
    }
}
fn option_matches(value: &String, level: u8) -> Bool {
    handle String::len(value) == 1 {
        false => false,
        true => *Slice::get_unchecked(Str::as_bytes(String::as_str(value)), 0) == wrapping_add<u8>(48, level),
    }
}
fn options(work: &Work) -> Result<(), InputError> {
    handle Result::as_ref(&work.optimization) {
        Result::Err(_) => Result::Ok(()),
        Result::Ok(value) => handle option_matches(value, work.stage.optimization_level) {
            false => Result::Err(invalid("codegen optimization-level disagrees with the bootstrap stage")),
            true => Result::Ok(()),
        },
    }
}
fn transition(work: &mut Work) -> Result<Event, InputError> {
    handle work.phase {
        Phase::Header => handle header(&work.stage, work.compiler) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => { (*work).phase = Phase::Count; Result::Ok(Event::Continue) },
        },
        Phase::Count => handle Vec::len(&work.sources) > as<usize>(work.stage.limits.max_sources) {
            true => Result::Err(invalid("source count exceeds bootstrap source limit")),
            false => { (*work).phase = Phase::Bytes; Result::Ok(Event::Continue) },
        },
        Phase::Bytes => byte_step(work),
        Phase::Options => handle options(& *work) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => { (*work).phase = Phase::Ready; Result::Ok(Event::Ready) },
        },
        Phase::Ready => Result::Ok(Event::Ready),
    }
}
fn checked(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle operation::charge(controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle transition(work) {
                Result::Err(error) => Result::Err(Failure::Rejected(error)),
                Result::Ok(event) => Result::Ok(event),
            },
        },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = checked(&mut *builder, controls);
    handle result {
        Result::Ok(event) => Result::Ok(event),
        Result::Err(error) => { abort(builder); Result::Err(error) },
    }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<AdmittedStage, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase {
                Phase::Ready => Result::Ok(AdmittedStage { stage: work.stage, sources: work.sources }),
                _ => Result::Err(Failure::Busy),
            },
        },
    }
}
