use std::*;
use super::Data;
use super::super::BootstrapStage;
use super::super::CompilationMode;
use super::super::Event;
use super::super::Failure;
use super::super::options;
use super::super::names;
use super::super::super::request;
use super::super::super::runtime_manifest;
use super::super::super::runtime_manifest::RuntimeManifestInput;
use super::super::super::runtime_manifest::input;
use super::super::super::kernel::identity;
use super::super::super::kernel::identity::Digest;
use super::super::super::kernel::operation;
use super::super::super::source;

// This builder owns the complete input for the entire encoding attempt.
// It cannot accept a different world halfway through its transcript, and its
// output does not by itself grant the enclosing module's NormalizedWorld seal.
pub struct Builder { private work: Option<Work> }
pub impl Use<[0, 1]> for Builder {}
struct Work { data: Data, writer: Writer }
struct Writer { buffer: ByteBuf, limit: usize, cursor: Cursor, digest: Option<Digest> }
struct Cursor { phase: Phase, row: usize, column: usize, position: usize, header: Bool }
enum Phase {
    Domain, Compiler, Generations, Mode, BootstrapDomain, Ordinal, Producer, Optimization,
    MaxSources, MaxBytes, ExpectedPresence, ExpectedDigest, Root, Target, SourceCount, Sources,
    SemanticCount, SemanticRows, CodegenCount, CodegenRows, CapabilityCount, Capabilities,
    RuntimePresence, RuntimePackage, SelectorCount, Selectors, HostCount, Hosts, Hash, Ready,
}
enum Field { Text, Word { value: u64, width: usize }, Digest(Digest) }

pub fn begin(data: Data, limit: usize) -> Builder {
    Builder { work: Result::Ok(Work { data: data, writer: Writer { buffer: ByteBuf::new(limit), limit: limit,
        cursor: Cursor { phase: Phase::Domain, row: 0, column: 0, position: 0, header: true }, digest: None } }) }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
fn charge(controls: &mut operation::Controls, amount: usize) -> Result<(), Failure> {
    handle operation::charge(controls, as<u64>(amount)) {
        Result::Err(error) => Result::Err(Failure::Control(error)), Result::Ok(_) => Result::Ok(()),
    }
}
fn capacity(limit: usize) -> Failure { Failure::Capacity { name: 18, limit: limit } }
fn stage(data: &Data) -> Result<BootstrapStage, Failure> {
    handle data.mode { CompilationMode::Bootstrap(value) => Result::Ok(value), _ => Result::Err(Failure::Invariant) }
}
fn manifest<'a>(data: &'a Data) -> Result<&'a RuntimeManifestInput, Failure> {
    handle Result::as_ref(&data.runtime_manifest) {
        Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => Result::Ok(input::value(value)),
    }
}
fn option_text<'a>(values: &'a options::Admitted, cursor: &Cursor) -> Result<Str<'a>, Failure> {
    handle options::entry(values, cursor.row) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(entry) => handle cursor.column {
            0 => { let key = HashMapEntry::key(entry); Result::Ok(String::as_str(key)) },
            1 => { let value = HashMapEntry::value(entry); Result::Ok(String::as_str(value)) },
            _ => Result::Err(Failure::Invariant),
        },
    }
}
fn text<'a>(data: &'a Data, cursor: &Cursor) -> Result<Str<'a>, Failure> {
    handle cursor.phase {
        Phase::Domain => Result::Ok("grandiose-stage0-world-v2"),
        Phase::BootstrapDomain => Result::Ok("bootstrap-stage-v2"),
        Phase::Root => Result::Ok(String::as_str(&data.root_package.value)),
        Phase::Target => Result::Ok(String::as_str(&data.target)),
        Phase::Sources => handle Vec::get(&data.sources, cursor.row) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(value) => handle cursor.column {
                0 => { let package = request::package(value); Result::Ok(String::as_str(&package.value)) },
                1 => { let path = request::path(value); Result::Ok(request::path_text(path)) },
                _ => Result::Err(Failure::Invariant),
            },
        },
        Phase::SemanticRows => option_text(&data.semantic_options, cursor),
        Phase::CodegenRows => option_text(&data.codegen_options, cursor),
        Phase::Capabilities => handle Vec::get(&data.capabilities, cursor.row) {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => Result::Ok(names::capability_text(value)),
        },
        Phase::RuntimePackage => handle manifest(data) {
            Result::Err(error) => Result::Err(error), Result::Ok(value) => Result::Ok(String::as_str(&value.standard_library.value)),
        },
        Phase::Selectors => handle manifest(data) {
            Result::Err(error) => Result::Err(error), Result::Ok(value) => handle Vec::get(&value.selectors, cursor.row) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(selector) => handle cursor.column {
                    1 => Result::Ok(String::as_str(&selector.module_path)), 2 => Result::Ok(String::as_str(&selector.name)),
                    _ => Result::Err(Failure::Invariant),
                },
            },
        },
        Phase::Hosts => handle manifest(data) {
            Result::Err(error) => Result::Err(error), Result::Ok(value) => handle Vec::get(&value.host_imports, cursor.row) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(host) => handle cursor.column {
                    0 => Result::Ok(String::as_str(&host.module_path)), 1 => Result::Ok(String::as_str(&host.name)),
                    2 => Result::Ok(String::as_str(&host.capability)), 3 => Result::Ok(String::as_str(&host.symbol)),
                    _ => Result::Err(Failure::Invariant),
                },
            },
        },
        _ => Result::Err(Failure::Invariant),
    }
}
fn word(value: u64, width: usize) -> Result<Field, Failure> { Result::Ok(Field::Word { value: value, width: width }) }
fn generation(data: &Data, column: usize) -> Result<Field, Failure> {
    handle column {
        0 => word(as<u64>(data.build.language_generation), 4), 1 => word(as<u64>(data.build.query_generation), 4),
        2 => word(as<u64>(data.build.interface_generation), 4), 3 => word(as<u64>(data.build.cache_generation), 4),
        4 => word(as<u64>(data.build.bytecode_generation), 4), 5 => word(as<u64>(data.build.verifier_generation), 4),
        _ => Result::Err(Failure::Invariant),
    }
}
fn bootstrap_field(data: &Data, phase: Phase) -> Result<Field, Failure> {
    handle stage(data) {
        Result::Err(error) => Result::Err(error), Result::Ok(value) => handle phase {
            Phase::Ordinal => word(as<u64>(value.ordinal), 4), Phase::Producer => Result::Ok(Field::Digest(value.producer)),
            Phase::Optimization => word(as<u64>(value.optimization_level), 1), Phase::MaxSources => word(as<u64>(value.limits.max_sources), 4),
            Phase::MaxBytes => word(value.limits.max_total_source_bytes, 8),
            Phase::ExpectedPresence => handle value.expected_artifact { Result::Err(_) => word(0, 1), Result::Ok(_) => word(1, 1) },
            Phase::ExpectedDigest => handle value.expected_artifact { Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(digest) => Result::Ok(Field::Digest(digest)) },
            _ => Result::Err(Failure::Invariant),
        },
    }
}
fn field(data: &Data, cursor: &Cursor) -> Result<Field, Failure> {
    handle cursor.phase {
        Phase::Compiler => Result::Ok(Field::Digest(data.build.compiler)),
        Phase::Generations => generation(data, cursor.column), Phase::Mode => word(as<u64>(request::mode_tag(&data.mode)), 1),
        Phase::Ordinal => bootstrap_field(data, cursor.phase), Phase::Producer => bootstrap_field(data, cursor.phase),
        Phase::Optimization => bootstrap_field(data, cursor.phase), Phase::MaxSources => bootstrap_field(data, cursor.phase),
        Phase::MaxBytes => bootstrap_field(data, cursor.phase), Phase::ExpectedPresence => bootstrap_field(data, cursor.phase),
        Phase::ExpectedDigest => bootstrap_field(data, cursor.phase),
        Phase::SourceCount => word(as<u64>(Vec::len(&data.sources)), 8),
        Phase::Sources => handle cursor.column < 2 {
            true => Result::Ok(Field::Text), false => handle Vec::get(&data.sources, cursor.row) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => {
                    let blob = request::blob(value);
                    handle cursor.column { 2 => { let key = source::file(blob); Result::Ok(Field::Digest(key.digest)) },
                        3 => Result::Ok(Field::Digest(source::fingerprint(blob))), _ => Result::Err(Failure::Invariant) }
                },
            },
        },
        Phase::SemanticCount => word(as<u64>(options::len(&data.semantic_options)), 8),
        Phase::CodegenCount => word(as<u64>(options::len(&data.codegen_options)), 8),
        Phase::CapabilityCount => word(as<u64>(Vec::len(&data.capabilities)), 8),
        Phase::RuntimePresence => handle Result::as_ref(&data.runtime_manifest) { Result::Err(_) => word(0, 1), Result::Ok(_) => word(1, 1) },
        Phase::SelectorCount => handle manifest(data) { Result::Err(error) => Result::Err(error), Result::Ok(value) => word(as<u64>(Vec::len(&value.selectors)), 8) },
        Phase::HostCount => handle manifest(data) { Result::Err(error) => Result::Err(error), Result::Ok(value) => word(as<u64>(Vec::len(&value.host_imports)), 8) },
        Phase::Selectors => handle cursor.column == 0 {
            false => Result::Ok(Field::Text), true => handle manifest(data) {
                Result::Err(error) => Result::Err(error), Result::Ok(value) => handle Vec::get(&value.selectors, cursor.row) {
                    Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(selector) => handle runtime_manifest::stable_tag(selector.role) {
                        Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(tag) => word(as<u64>(tag), 1),
                    },
                },
            },
        },
        Phase::Hash => Result::Err(Failure::Invariant), Phase::Ready => Result::Err(Failure::Invariant),
        _ => Result::Ok(Field::Text),
    }
}
fn next(cursor: &mut Cursor, phase: Phase) -> Result<Event, Failure> {
    (*cursor).phase = phase; (*cursor).row = as<usize>(0); (*cursor).column = as<usize>(0); Result::Ok(Event::Continue)
}
fn rows(cursor: &mut Cursor, width: usize, count: usize, after: Phase) -> Result<Event, Failure> {
    (*cursor).column = cursor.column + 1;
    handle cursor.column == width {
        false => Result::Ok(Event::Continue), true => { (*cursor).column = as<usize>(0); (*cursor).row = cursor.row + 1;
            handle cursor.row == count { false => Result::Ok(Event::Continue), true => next(cursor, after) } },
    }
}
fn list(cursor: &mut Cursor, count: usize, items: Phase, after: Phase) -> Result<Event, Failure> {
    handle count == 0 { true => next(cursor, after), false => next(cursor, items) }
}
fn advance(data: &Data, cursor: &mut Cursor) -> Result<Event, Failure> {
    (*cursor).header = Result<(), ()>::Ok(()); (*cursor).position = as<usize>(0);
    handle cursor.phase {
        Phase::Domain => next(cursor, Phase::Compiler), Phase::Compiler => next(cursor, Phase::Generations),
        Phase::Generations => rows(cursor, 6, 1, Phase::Mode),
        Phase::Mode => handle data.mode { CompilationMode::Bootstrap(_) => next(cursor, Phase::BootstrapDomain), _ => next(cursor, Phase::Root) },
        Phase::BootstrapDomain => next(cursor, Phase::Ordinal), Phase::Ordinal => next(cursor, Phase::Producer),
        Phase::Producer => next(cursor, Phase::Optimization), Phase::Optimization => next(cursor, Phase::MaxSources),
        Phase::MaxSources => next(cursor, Phase::MaxBytes), Phase::MaxBytes => next(cursor, Phase::ExpectedPresence),
        Phase::ExpectedPresence => handle stage(data) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(value) => handle value.expected_artifact { Result::Err(_) => next(cursor, Phase::Root), Result::Ok(_) => next(cursor, Phase::ExpectedDigest) },
        },
        Phase::ExpectedDigest => next(cursor, Phase::Root), Phase::Root => next(cursor, Phase::Target), Phase::Target => next(cursor, Phase::SourceCount),
        Phase::SourceCount => list(cursor, Vec::len(&data.sources), Phase::Sources, Phase::SemanticCount),
        Phase::Sources => rows(cursor, 4, Vec::len(&data.sources), Phase::SemanticCount),
        Phase::SemanticCount => list(cursor, options::len(&data.semantic_options), Phase::SemanticRows, Phase::CodegenCount),
        Phase::SemanticRows => rows(cursor, 2, options::len(&data.semantic_options), Phase::CodegenCount),
        Phase::CodegenCount => list(cursor, options::len(&data.codegen_options), Phase::CodegenRows, Phase::CapabilityCount),
        Phase::CodegenRows => rows(cursor, 2, options::len(&data.codegen_options), Phase::CapabilityCount),
        Phase::CapabilityCount => list(cursor, Vec::len(&data.capabilities), Phase::Capabilities, Phase::RuntimePresence),
        Phase::Capabilities => rows(cursor, 1, Vec::len(&data.capabilities), Phase::RuntimePresence),
        Phase::RuntimePresence => handle Result::as_ref(&data.runtime_manifest) { Result::Err(_) => next(cursor, Phase::Hash), Result::Ok(_) => next(cursor, Phase::RuntimePackage) },
        Phase::RuntimePackage => next(cursor, Phase::SelectorCount),
        Phase::SelectorCount => handle manifest(data) { Result::Err(error) => Result::Err(error), Result::Ok(value) => list(cursor, Vec::len(&value.selectors), Phase::Selectors, Phase::HostCount) },
        Phase::Selectors => handle manifest(data) { Result::Err(error) => Result::Err(error), Result::Ok(value) => rows(cursor, 3, Vec::len(&value.selectors), Phase::HostCount) },
        Phase::HostCount => handle manifest(data) { Result::Err(error) => Result::Err(error), Result::Ok(value) => list(cursor, Vec::len(&value.host_imports), Phase::Hosts, Phase::Hash) },
        Phase::Hosts => handle manifest(data) { Result::Err(error) => Result::Err(error), Result::Ok(value) => rows(cursor, 4, Vec::len(&value.host_imports), Phase::Hash) },
        _ => Result::Err(Failure::Invariant),
    }
}
fn length(data: &Data, cursor: &Cursor, item: Field) -> Result<usize, Failure> {
    handle item {
        Field::Text => handle text(data, cursor) { Result::Err(error) => Result::Err(error), Result::Ok(value) => Result::Ok(Str::len(value)) },
        Field::Word { value: _, width: width } => Result::Ok(width), Field::Digest(_) => Result::Ok(32),
    }
}
fn header(data: &Data, writer: &mut Writer, count: usize, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle charge(controls, 8) {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => handle ByteBuf::put_u64(&mut writer.buffer, as<u64>(count)) {
            Result::Err(_) => Result::Err(capacity(writer.limit)), Result::Ok(_) => {
                (*writer).cursor.header = Result<(), ()>::Err(());
                handle count == 0 { true => advance(data, &mut writer.cursor), false => Result::Ok(Event::Continue) }
            },
        },
    }
}
fn word_bytes(buffer: &mut ByteBuf, value: u64, width: usize, index: usize) -> Result<(), ByteError> {
    handle index == width {
        true => Result::Ok(()), false => handle ByteBuf::push(&mut *buffer, as<u8>(bit_shr(value, as<u32>(index * 8)))) {
            Result::Err(error) => Result::Err(error), Result::Ok(_) => word_bytes(buffer, value, width, index + 1),
        },
    }
}
fn payload(data: &Data, writer: &mut Writer, item: Field, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle item {
        Field::Word { value: value, width: width } => handle charge(controls, width) {
            Result::Err(error) => Result::Err(error), Result::Ok(_) => handle word_bytes(&mut writer.buffer, value, width, 0) {
                Result::Err(_) => Result::Err(capacity(writer.limit)), Result::Ok(_) => advance(data, &mut writer.cursor),
            },
        },
        Field::Digest(value) => handle charge(controls, 32) {
            Result::Err(error) => Result::Err(error), Result::Ok(_) => handle identity::write_digest(&mut writer.buffer, value) {
                Result::Err(_) => Result::Err(capacity(writer.limit)), Result::Ok(_) => advance(data, &mut writer.cursor),
            },
        },
        Field::Text => handle text(data, &writer.cursor) {
            Result::Err(error) => Result::Err(error), Result::Ok(value) => text_payload(value, &mut *writer, controls, data),
        },
    }
}
fn chunk_size(remaining: usize) -> usize { handle remaining < 32 { true => remaining, false => 32 } }
fn text_payload(value: Str, writer: &mut Writer, controls: &mut operation::Controls, data: &Data) -> Result<Event, Failure> {
    let bytes = Str::as_bytes(value); let size = Slice::len(&bytes); let start = writer.cursor.position;
    handle start <= size {
        false => Result::Err(Failure::Invariant), true => {
            let count = chunk_size(size - start); let end = start + count;
            handle charge(controls, count) {
                Result::Err(error) => Result::Err(error), Result::Ok(_) => handle Slice::slice(bytes, Range { start: start, end: end }) {
                    Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(chunk) => handle ByteBuf::append(&mut writer.buffer, chunk) {
                        Result::Err(_) => Result::Err(capacity(writer.limit)), Result::Ok(_) => {
                            (*writer).cursor.position = end;
                            handle end == size { true => advance(data, &mut writer.cursor), false => Result::Ok(Event::Continue) }
                        },
                    },
                },
            }
        },
    }
}
fn hash(writer: &mut Writer, controls: &mut operation::Controls) -> Result<Event, Failure> {
    // The existing BLAKE3 leaf is synchronous. Charge its entire bounded input
    // before calling it; this is not a claim of streaming hash/poll certification.
    handle charge(controls, ByteBuf::len(&writer.buffer)) {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => {
            let bytes = ByteBuf::view(&writer.buffer);
            handle identity::hash(bytes) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(digest) => {
                    (*writer).digest = Result::Ok(digest); (*writer).cursor.phase = Phase::Ready; Result::Ok(Event::Ready)
                },
            }
        },
    }
}
fn transition(data: &Data, writer: &mut Writer, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle writer.cursor.phase {
        Phase::Ready => Result::Ok(Event::Ready), Phase::Hash => hash(writer, controls),
        _ => handle field(data, &writer.cursor) {
            Result::Err(error) => Result::Err(error), Result::Ok(item) => handle writer.cursor.header {
                false => payload(data, writer, item, controls), true => handle length(data, &writer.cursor, item) {
                    Result::Err(error) => Result::Err(error), Result::Ok(count) => header(data, writer, count, controls),
                },
            },
        },
    }
}
fn checked(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle charge(&mut *controls, 1) {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(work) => transition(&work.data, &mut work.writer, controls),
        },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = checked(&mut *builder, controls);
    handle result { Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<(Data, Digest), Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(work) => handle work.writer.cursor.phase {
                Phase::Ready => handle work.writer.digest { Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(digest) => Result::Ok((work.data, digest)) },
                _ => Result::Err(Failure::Busy),
            },
        },
    }
}
