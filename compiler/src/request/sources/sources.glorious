use std::*;
use super::SourceInput;
use super::SourceBuilder;
use super::AdmittedSource;
use super::Event;
use super::Failure;
use super::InputError;
use super::super::kernel::identity;
use super::super::kernel::operation;
use super::super::kernel::order;
use super::super::source;

pub struct Limits { source_count: usize, source_bytes: usize, identity_bytes: usize }
pub struct Builder { private work: Option<Work>, private limits: Limits }
pub impl Use<[0, 1]> for Builder {}
pub struct AdmittedSources { private values: Vec<AdmittedSource> }
struct Work {
    raw: Vec<SourceInput>, slots: Vec<Option<SourceInput>>, sorted: order::Builder,
    indices: Vec<usize>, values: Vec<AdmittedSource>, pending: Option<SourceBuilder>,
    comparison: Option<Comparison>, cursor: usize, phase: Phase,
}
enum Phase { Check, Gather, Reverse, Sort, Admit, Duplicates, Ready }
struct Comparison { left: usize, right: usize, field: usize, cursor: usize }
enum Compared { Continue(Comparison), Done(Ordering) }

pub fn begin(inputs: Vec<SourceInput>, limits: Limits) -> Builder {
    let count = Vec::len(&inputs);
    Builder { work: Result::Ok(Work { raw: inputs, slots: Vec<Option<SourceInput>>::new(),
        sorted: order::begin(count, limits.source_count), indices: Vec<usize>::new(), values: Vec<AdmittedSource>::new(),
        pending: None, comparison: None, cursor: 0, phase: Phase::Check }), limits: limits }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
pub fn values<'a>(value: &'a AdmittedSources) -> Slice<'a, AdmittedSource> { Vec::as_slice(&value.values) }
pub fn into_values(value: AdmittedSources) -> Vec<AdmittedSource> { value.values }

fn order_error(error: order::Failure) -> Failure {
    handle error {
        order::Failure::Control(error) => Failure::Control(error),
        order::Failure::Capacity { actual: _, limit: limit } => Failure::Capacity { name: 4, limit: limit },
        _ => Failure::Invariant,
    }
}
fn text_step(left: Str, right: Str, state: Comparison) -> Compared {
    handle state.cursor < min(Str::len(left), Str::len(right)) {
        true => {
            let a = *Slice::get_unchecked(Str::as_bytes(left), state.cursor);
            let b = *Slice::get_unchecked(Str::as_bytes(right), state.cursor);
            handle Ord::compare(&a, &b) {
                Ordering::Equal => Compared::Continue(Comparison { left: state.left, right: state.right, field: state.field, cursor: state.cursor + 1 }),
                result => Compared::Done(result),
            }
        },
        false => {
            let a = Str::len(left);
            let b = Str::len(right);
            handle Ord::compare(&a, &b) {
                Ordering::Equal => Compared::Continue(Comparison { left: state.left, right: state.right, field: state.field + 1, cursor: 0 }),
                result => Compared::Done(result),
            }
        },
    }
}
fn input_step(left: &SourceInput, right: &SourceInput, state: Comparison) -> Compared {
    handle state.field {
        0 => {
            let a = String::as_str(&left.package.value);
            let b = String::as_str(&right.package.value);
            text_step(a, b, state)
        },
        1 => {
            let a = super::path_text(&left.logical_path);
            let b = super::path_text(&right.logical_path);
            text_step(a, b, state)
        },
        _ => Compared::Done(identity::compare_digest(left.key.digest, right.key.digest)),
    }
}
fn comparison_step(work: &Work, state: Comparison) -> Result<Compared, Failure> {
    handle Result::as_ref(Vec::get_unchecked(&work.slots, state.left)) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(left) => handle Result::as_ref(Vec::get_unchecked(&work.slots, state.right)) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(right) => Result::Ok(input_step(left, right, state)),
        },
    }
}
fn sort_step(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle Option::take(&mut work.comparison) {
        Result::Ok(state) => handle comparison_step(& *work, state) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(value) => handle value {
                Compared::Continue(state) => { (*work).comparison = Result::Ok(state); Result::Ok(Event::Continue) },
                Compared::Done(answer) => handle order::compared(&mut work.sorted, controls, answer) {
                    Result::Err(error) => Result::Err(order_error(error)),
                    Result::Ok(event) => handle event { order::Event::Continue => Result::Ok(Event::Continue), _ => Result::Err(Failure::Invariant) },
                },
            },
        },
        Result::Err(_) => handle order::step(&mut work.sorted, &mut *controls) {
            Result::Err(error) => Result::Err(order_error(error)),
            Result::Ok(event) => handle event {
                order::Event::Continue => Result::Ok(Event::Continue),
                order::Event::Compare { left: left, right: right } => {
                    (*work).comparison = Result::Ok(Comparison { left: left, right: right, field: 0, cursor: 0 });
                    Result::Ok(Event::Continue)
                },
                order::Event::Ready => handle order::finish(&mut work.sorted, & *controls) {
                    Result::Err(error) => Result::Err(order_error(error)),
                    Result::Ok(indices) => {
                        (*work).indices = indices;
                        (*work).cursor = as<usize>(0);
                        (*work).phase = Phase::Admit;
                        Result::Ok(Event::Continue)
                    },
                },
            },
        },
    }
}
fn start_source(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle work.cursor == Vec::len(&work.indices) {
        true => { (*work).cursor = as<usize>(1); (*work).phase = Phase::Duplicates; Result::Ok(Event::Continue) },
        false => {
            let index = *Vec::get_unchecked(&work.indices, work.cursor);
            handle Vec::get_mut(&mut work.slots, index) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(slot) => handle Option::take(slot) {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(input) => {
                        (*work).pending = Result::Ok(super::begin_source(input, limits.source_bytes, limits.identity_bytes));
                        Result::Ok(Event::Continue)
                    },
                },
            }
        },
    }
}
fn admit_step(work: &mut Work, limits: Limits, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle Result::as_mut(&mut work.pending) {
        Result::Err(_) => start_source(work, limits),
        Result::Ok(pending) => handle super::step_source(&mut *pending, &mut *controls) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(event) => handle event {
                Event::Continue => Result::Ok(Event::Continue),
                Event::Ready => handle super::finish_source(pending, & *controls) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(value) => {
                        (*work).pending = None;
                        Vec::push(&mut work.values, value);
                        (*work).cursor = work.cursor + 1;
                        Result::Ok(Event::Continue)
                    },
                },
            },
        },
    }
}
fn duplicate_step(work: &mut Work) -> Result<Event, Failure> {
    handle work.cursor == Vec::len(&work.values) {
        true => { (*work).phase = Phase::Ready; Result::Ok(Event::Ready) },
        false => {
            let a = super::blob(Vec::get_unchecked(&work.values, work.cursor - 1));
            let b = super::blob(Vec::get_unchecked(&work.values, work.cursor));
            let first = source::file(a);
            let second = source::file(b);
            handle identity::equal(first.digest, second.digest) {
                true => Result::Err(Failure::Rejected(InputError::DuplicateFileKey(first))),
                false => { (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
            }
        },
    }
}
fn transition(work: &mut Work, limits: Limits, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle work.phase {
        Phase::Check => handle Vec::len(&work.raw) == 0 {
            true => Result::Err(Failure::Rejected(InputError::EmptySources)),
            false => handle Vec::len(&work.raw) > limits.source_count {
                true => Result::Err(Failure::Capacity { name: 4, limit: limits.source_count }),
                false => { (*work).phase = Phase::Gather; Result::Ok(Event::Continue) },
            },
        },
        Phase::Gather => handle Vec::pop(&mut work.raw) {
            Result::Ok(input) => { Vec::push(&mut work.slots, Result::Ok(input)); Result::Ok(Event::Continue) },
            Result::Err(_) => { (*work).phase = Phase::Reverse; Result::Ok(Event::Continue) },
        },
        Phase::Reverse => handle work.cursor < Vec::len(&work.slots) / 2 {
            false => { (*work).phase = Phase::Sort; Result::Ok(Event::Continue) },
            true => {
                let last = Vec::len(&work.slots) - 1 - work.cursor;
                Vec::swap(&mut work.slots, work.cursor, last);
                (*work).cursor = work.cursor + 1;
                Result::Ok(Event::Continue)
            },
        },
        Phase::Sort => sort_step(work, controls),
        Phase::Admit => admit_step(work, limits, controls),
        Phase::Duplicates => duplicate_step(work),
        Phase::Ready => Result::Ok(Event::Ready),
    }
}
fn checked(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle operation::charge(&mut *controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => transition(work, builder.limits, controls),
        },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = checked(&mut *builder, controls);
    handle result {
        Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) },
    }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<AdmittedSources, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase {
                Phase::Ready => Result::Ok(AdmittedSources { values: work.values }), _ => Result::Err(Failure::Busy),
            },
        },
    }
}
