use std::*;
use super::kernel::identity;
use super::kernel::identity::Digest;
use super::kernel::identity::FileKey;
use super::kernel::identity::PackageKey;
use super::kernel::operation;
use super::source;
use super::runtime_manifest::RuntimeManifestInput;
pub mod names;
pub mod bootstrap;
pub mod sources;
pub mod namespace;
pub mod options;
pub mod world;

pub struct CompilerBuildIdentity {
    compiler: Digest, language_generation: u32, query_generation: u32,
    interface_generation: u32, cache_generation: u32,
    bytecode_generation: u32, verifier_generation: u32,
}
pub struct BootstrapLimits { max_sources: u32, max_total_source_bytes: u64 }
pub struct BootstrapStage {
    ordinal: u32, producer: Digest, optimization_level: u8,
    limits: BootstrapLimits, expected_artifact: Option<Digest>,
}
pub enum CompilationMode { Check, Build, Test, Inspect, Ide, Bootstrap(BootstrapStage) }
pub struct CompilationRequest {
    build: CompilerBuildIdentity, mode: CompilationMode, root_package: PackageKey,
    sources: Vec<SourceInput>, target: String, semantic_options: HashMap<String, String>,
    codegen_options: HashMap<String, String>, capability_manifest: Vec<String>, runtime_manifest: Option<RuntimeManifestInput>,
}

// The authoring constructor uses the current native generations. A request
// from an independently versioned compiler retains its explicit build fields.
pub fn stage0_identity(compiler: Digest) -> CompilerBuildIdentity {
    CompilerBuildIdentity { compiler: compiler, language_generation: 1, query_generation: 1,
        interface_generation: 1, cache_generation: 4, bytecode_generation: 48, verifier_generation: 6 }
}
pub fn mode_tag(mode: &CompilationMode) -> u8 {
    handle *mode {
        CompilationMode::Check => 0, CompilationMode::Build => 1, CompilationMode::Test => 2,
        CompilationMode::Inspect => 3, CompilationMode::Ide => 4, CompilationMode::Bootstrap(_) => 5,
    }
}

// Admission is source-owned. Only a successfully finished builder can create
// these wrappers; they do not yet certify a complete normalized request world.
pub struct LogicalPath { private value: String }
pub struct SourceInput { key: FileKey, package: PackageKey, logical_path: LogicalPath, bytes: Vec<u8>, digest: Digest }
pub struct AdmittedSource { private package: PackageKey, private logical_path: LogicalPath, private blob: source::Blob }
pub enum InputError {
    EmptySources,
    DuplicateFileKey(FileKey),
    InvalidLogicalPath(String),
    SourceIdentityMismatch { supplied: FileKey, expected: FileKey },
    DigestMismatch { file: FileKey, expected: Digest, actual: Digest },
    InvalidUtf8(FileKey),
    InvalidPackageModuleAlias(PackageKey),
    DuplicatePackageModuleAlias { alias: String, first: PackageKey, second: PackageKey },
    InvalidCapability(String),
    DuplicateCapability(String),
    InvalidRuntimeManifest,
    InvalidBootstrapStage { reason: String },
    BootstrapSourceLimit { actual: u64, limit: u64 },
}
pub enum Failure {
    Rejected(InputError), Control(operation::Failure),
    // 0: source bytes; 1: identity encoding; 2: alias bytes; 3: capability bytes;
    // 4: source count; 5: capability count; 6: distinct package count;
    // 7: option count; 8: option key bytes; 9: option value bytes;
    // 10..17: runtime-manifest input limits; 18: world fingerprint bytes.
    Capacity { name: u32, limit: usize }, Closed, Busy, Invariant,
}
pub enum Event { Continue, Ready }
pub struct PathBuilder { private work: Option<PathWork> }
pub impl Use<[0, 1]> for PathBuilder {}
struct PathWork { value: String, cursor: usize, segment: usize, ready: Bool }
pub struct SourceBuilder { private work: Option<SourceWork>, private byte_limit: usize, private identity_limit: usize }
pub impl Use<[0, 1]> for SourceBuilder {}
enum SourceWork { Identity(SourceInput), Digest(SourceInput), Utf8(SourceInput), Ready(AdmittedSource) }

pub fn path_text<'a>(path: &'a LogicalPath) -> Str<'a> { String::as_str(&path.value) }
pub fn package<'a>(value: &'a AdmittedSource) -> &'a PackageKey { &value.package }
pub fn path<'a>(value: &'a AdmittedSource) -> &'a LogicalPath { &value.logical_path }
pub fn blob<'a>(value: &'a AdmittedSource) -> &'a source::Blob { &value.blob }

fn charge(controls: &mut operation::Controls, amount: u64) -> Result<(), Failure> {
    handle operation::charge(controls, amount) {
        Result::Err(error) => Result::Err(Failure::Control(error)), Result::Ok(_) => Result::Ok(()),
    }
}
pub fn begin_path(value: String) -> PathBuilder {
    PathBuilder { work: Result::Ok(PathWork { value: value, cursor: 0, segment: 0, ready: false }) }
}
pub fn abort_path(builder: &mut PathBuilder) -> () { (*builder).work = None; }
fn valid_segment(work: &PathWork) -> Bool {
    let length = work.cursor - work.segment;
    let bytes = Str::as_bytes(String::as_str(&work.value));
    handle length {
        0 => false,
        1 => *Slice::get_unchecked(bytes, work.segment) != 46,
        2 => handle *Slice::get_unchecked(bytes, work.segment) == 46 {
            false => true, true => *Slice::get_unchecked(bytes, work.segment + 1) != 46,
        },
        _ => true,
    }
}
fn path_byte(work: &mut PathWork) -> Result<Event, ()> {
    handle work.ready {
        true => Result::Ok(Event::Ready),
        false => handle work.cursor == String::len(&work.value) {
            true => handle valid_segment(& *work) {
                false => Result::Err(()),
                true => { (*work).ready = Result<(), ()>::Ok(()); Result::Ok(Event::Ready) },
            },
            false => handle *Slice::get_unchecked(Str::as_bytes(String::as_str(&work.value)), work.cursor) {
                92 => Result::Err(()),
                47 => handle valid_segment(& *work) {
                    false => Result::Err(()),
                    true => {
                        (*work).cursor = work.cursor + 1;
                        (*work).segment = work.cursor;
                        Result::Ok(Event::Continue)
                    },
                },
                _ => { (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
            },
        },
    }
}
fn invalid_path(builder: &mut PathBuilder) -> Result<Event, Failure> {
    handle Option::take(&mut builder.work) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(work) => Result::Err(Failure::Rejected(InputError::InvalidLogicalPath(work.value))),
    }
}
fn path_checked(builder: &mut PathBuilder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle charge(controls, 1) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle path_byte(work) {
                Result::Ok(event) => Result::Ok(event), Result::Err(_) => invalid_path(builder),
            },
        },
    }
}
pub fn step_path(builder: &mut PathBuilder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = path_checked(&mut *builder, controls);
    handle result {
        Result::Ok(event) => Result::Ok(event),
        Result::Err(error) => { abort_path(builder); Result::Err(error) },
    }
}
pub fn finish_path(builder: &mut PathBuilder, controls: &operation::Controls) -> Result<LogicalPath, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort_path(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.ready {
                false => Result::Err(Failure::Busy), true => Result::Ok(LogicalPath { value: work.value }),
            },
        },
    }
}

pub fn begin_source(input: SourceInput, byte_limit: usize, identity_limit: usize) -> SourceBuilder {
    SourceBuilder { work: Result::Ok(SourceWork::Identity(input)), byte_limit: byte_limit, identity_limit: identity_limit }
}
pub fn abort_source(builder: &mut SourceBuilder) -> () { (*builder).work = None; }
fn identity_charge(input: &SourceInput, controls: &mut operation::Controls) -> Result<(), Failure> {
    // Charge each extent separately: neither length addition nor budget
    // arithmetic can wrap. Hash/UTF-8 leaves remain synchronous as in Blob.
    handle charge(&mut *controls, as<u64>(String::len(&input.package.value))) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => charge(controls, as<u64>(String::len(&input.logical_path.value))),
    }
}
fn check_identity(input: SourceInput, limit: usize, controls: &mut operation::Controls) -> Result<SourceWork, Failure> {
    handle identity_charge(&input, controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle identity::file(Str::as_bytes(String::as_str(&input.package.value)),
            Str::as_bytes(String::as_str(&input.logical_path.value)), limit) {
            Result::Err(_) => Result::Err(Failure::Capacity { name: 1, limit: limit }),
            Result::Ok(expected) => handle identity::equal(input.key.digest, expected.digest) {
                false => Result::Err(Failure::Rejected(InputError::SourceIdentityMismatch { supplied: input.key, expected: expected })),
                true => Result::Ok(SourceWork::Digest(input)),
            },
        },
    }
}
fn digest_sized(input: SourceInput, controls: &mut operation::Controls) -> Result<SourceWork, Failure> {
    handle charge(controls, as<u64>(Vec::len(&input.bytes))) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle identity::hash(Vec::as_slice(&input.bytes)) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(actual) => handle identity::equal(input.digest, actual) {
                false => Result::Err(Failure::Rejected(InputError::DigestMismatch { file: input.key, expected: input.digest, actual: actual })),
                true => Result::Ok(SourceWork::Utf8(input)),
            },
        },
    }
}
fn check_digest(input: SourceInput, limit: usize, controls: &mut operation::Controls) -> Result<SourceWork, Failure> {
    handle Vec::len(&input.bytes) <= limit {
        false => Result::Err(Failure::Capacity { name: 0, limit: limit }),
        true => handle Vec::len(&input.bytes) <= 4294967295 {
            false => Result::Err(Failure::Capacity { name: 0, limit: 4294967295 }),
            true => digest_sized(input, controls),
        },
    }
}
fn decode(input: SourceInput, limit: usize, controls: &mut operation::Controls) -> Result<SourceWork, Failure> {
    // Preserve normalization's identity -> digest -> UTF-8 failure precedence.
    // The existing sealed Blob constructor rechecks/hashes its owned bytes;
    // both passes are charged, not advertised as a physical-copy optimization.
    handle input {
        SourceInput { key: key, package: package, logical_path: logical_path, bytes: bytes, digest: _ } =>
            decode_parts(key, package, logical_path, bytes, limit, controls),
    }
}
fn decode_parts(key: FileKey, package: PackageKey, logical_path: LogicalPath, bytes: Vec<u8>, limit: usize,
    controls: &mut operation::Controls) -> Result<SourceWork, Failure> {
    handle source::create(key, bytes, limit, controls) {
        Result::Err(error) => handle error {
            source::Failure::InvalidUtf8 { valid_up_to: _ } => Result::Err(Failure::Rejected(InputError::InvalidUtf8(key))),
            source::Failure::Control(error) => Result::Err(Failure::Control(error)),
            source::Failure::Capacity => Result::Err(Failure::Capacity { name: 0, limit: limit }),
            _ => Result::Err(Failure::Invariant),
        },
        Result::Ok(blob) => Result::Ok(SourceWork::Ready(AdmittedSource { package: package, logical_path: logical_path, blob: blob })),
    }
}
fn transition(work: SourceWork, byte_limit: usize, identity_limit: usize, controls: &mut operation::Controls) -> Result<SourceWork, Failure> {
    handle work {
        SourceWork::Identity(input) => check_identity(input, identity_limit, controls),
        SourceWork::Digest(input) => check_digest(input, byte_limit, controls),
        SourceWork::Utf8(input) => decode(input, byte_limit, controls),
        SourceWork::Ready(value) => Result::Ok(SourceWork::Ready(value)),
    }
}
fn work_event(work: &SourceWork) -> Event {
    handle *work { SourceWork::Ready(_) => Event::Ready, _ => Event::Continue }
}
fn source_checked(builder: &mut SourceBuilder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle charge(&mut *controls, 1) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle transition(work, builder.byte_limit, builder.identity_limit, controls) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(work) => {
                    let event = work_event(&work);
                    (*builder).work = Result::Ok(work);
                    Result::Ok(event)
                },
            },
        },
    }
}
pub fn step_source(builder: &mut SourceBuilder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = source_checked(&mut *builder, controls);
    handle result {
        Result::Ok(event) => Result::Ok(event),
        Result::Err(error) => { abort_source(builder); Result::Err(error) },
    }
}
pub fn finish_source(builder: &mut SourceBuilder, controls: &operation::Controls) -> Result<AdmittedSource, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort_source(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work {
                SourceWork::Ready(value) => Result::Ok(value), _ => Result::Err(Failure::Busy),
            },
        },
    }
}
