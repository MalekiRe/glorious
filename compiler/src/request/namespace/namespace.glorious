use std::*;
use super::Event;
use super::Failure;
use super::InputError;
use super::names;
use super::sources;
use super::super::kernel::identity::PackageKey;
use super::super::kernel::operation;
use super::super::kernel::order;
use super::super::kernel::text_order;

pub struct Limits { packages: usize, alias_bytes: usize, capabilities: usize, capability_bytes: usize }
pub struct Builder { private work: Option<Work>, private limits: Limits }
pub impl Use<[0, 1]> for Builder {}
pub struct Admitted {
    private root: PackageKey, private sources: sources::AdmittedSources,
    private aliases: Vec<names::PackageAlias>, private capabilities: Vec<names::Capability>,
    private alias_index: HashMap<String, usize>,
}
struct Work {
    root: PackageKey, sources: sources::AdmittedSources, candidates: Vec<String>,
    raw_capabilities: Vec<String>, sorter: Option<text_order::Builder>, sorted: Option<text_order::Sorted>,
    aliases: Vec<names::PackageAlias>, alias_index: HashMap<String, usize>, capabilities: Vec<names::Capability>,
    candidate: Option<String>, alias: Option<names::AliasBuilder>, capability: Option<names::CapabilityBuilder>,
    cursor: usize, byte: usize, phase: Phase,
}
enum Phase { Root, Harvest, PackageSort, PackageNext, PackageUnique, Alias, CapabilitySort, CapabilityNext, Capability, Duplicates, Ready }

pub fn begin(root: PackageKey, sources: sources::AdmittedSources, capabilities: Vec<String>, limits: Limits) -> Builder {
    Builder { work: Result::Ok(Work { root: root, sources: sources, candidates: Vec<String>::new(),
        raw_capabilities: capabilities, sorter: None, sorted: None, aliases: Vec<names::PackageAlias>::new(),
        alias_index: HashMap<String, usize>::new(), capabilities: Vec<names::Capability>::new(),
        candidate: None, alias: None, capability: None, cursor: 0, byte: 0, phase: Phase::Root }), limits: limits }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
pub fn root<'a>(value: &'a Admitted) -> &'a PackageKey { &value.root }
pub fn sources<'a>(value: &'a Admitted) -> &'a sources::AdmittedSources { &value.sources }
pub fn aliases<'a>(value: &'a Admitted) -> Slice<'a, names::PackageAlias> { Vec::as_slice(&value.aliases) }
pub fn capabilities<'a>(value: &'a Admitted) -> Slice<'a, names::Capability> { Vec::as_slice(&value.capabilities) }
pub fn into_parts(value: Admitted) -> (PackageKey, sources::AdmittedSources, Vec<names::PackageAlias>, Vec<names::Capability>) {
    handle value { Admitted { root: root, sources: sources, aliases: aliases, capabilities: capabilities, alias_index: _ } =>
        (root, sources, aliases, capabilities) }
}
// Preserve the already-validated alias index when the full normalizer takes
// ownership. This relinquishes the namespace wrapper, not its retained data.
pub fn into_indexed_parts(value: Admitted) -> (PackageKey, sources::AdmittedSources, Vec<names::PackageAlias>, Vec<names::Capability>, HashMap<String, usize>) {
    handle value { Admitted { root: root, sources: sources, aliases: aliases, capabilities: capabilities, alias_index: index } =>
        (root, sources, aliases, capabilities, index) }
}
pub fn alias_package<'a>(value: &'a Admitted, key: &String) -> Option<&'a PackageKey> {
    handle HashMap::get(&value.alias_index, key) {
        Result::Err(_) => None,
        Result::Ok(index) => Result::Ok(names::package(Vec::get_unchecked(&value.aliases, *index))),
    }
}
fn charge(controls: &mut operation::Controls, amount: usize) -> Result<(), Failure> {
    handle operation::charge(controls, as<u64>(amount)) { Result::Ok(_) => Result::Ok(()), Result::Err(error) => Result::Err(Failure::Control(error)) }
}
fn copy(value: &String, controls: &mut operation::Controls) -> Result<String, Failure> {
    handle charge(controls, String::len(value)) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => { let view = String::as_str(value); Result::Ok(Str::to_string(view)) },
    }
}
fn text_error(error: text_order::Failure, name: u32) -> Failure {
    handle error {
        text_order::Failure::Control(error) => Failure::Control(error),
        text_order::Failure::Capacity { actual: _, limit: limit } => Failure::Capacity { name: name, limit: limit },
        _ => Failure::Invariant,
    }
}
fn harvest_order(work: &Work) -> Option<Ordering> {
    let values = sources::values(&work.sources);
    let a = super::package(Slice::get_unchecked(values, work.cursor - 1));
    let b = super::package(Slice::get_unchecked(values, work.cursor));
    let left = String::as_str(&a.value);
    let right = String::as_str(&b.value);
    order::byte_order(left, right, work.byte)
}
fn harvest_add(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let values = sources::values(&work.sources);
    let package = super::package(Slice::get_unchecked(values, work.cursor));
    handle copy(&package.value, controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => {
            Vec::push(&mut work.candidates, value); (*work).cursor = work.cursor + 1; (*work).byte = as<usize>(0);
            Result::Ok(Event::Continue)
        },
    }
}
fn harvest(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let values = sources::values(&work.sources);
    handle work.cursor == Slice::len(&values) {
        true => {
            // Candidates are bounded by the already-admitted source extent
            // plus the root, and repeated adjacent source packages are skipped.
            let count = Vec::len(&work.candidates);
            let candidates = replace(&mut work.candidates, Vec<String>::new());
            (*work).sorter = Result::Ok(text_order::begin(candidates, count));
            (*work).phase = Phase::PackageSort;
            Result::Ok(Event::Continue)
        },
        false => handle work.cursor == 0 {
            true => harvest_add(work, controls),
            false => handle harvest_order(& *work) {
                Result::Err(_) => { (*work).byte = work.byte + 1; Result::Ok(Event::Continue) },
                Result::Ok(order) => handle order {
                    Ordering::Greater => Result::Err(Failure::Invariant),
                    Ordering::Less => harvest_add(work, controls),
                    Ordering::Equal => { (*work).cursor = work.cursor + 1; (*work).byte = as<usize>(0); Result::Ok(Event::Continue) },
                },
            },
        },
    }
}
fn sort_step(work: &mut Work, controls: &mut operation::Controls, next: Phase, name: u32) -> Result<Event, Failure> {
    handle Result::as_mut(&mut work.sorter) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(sorter) => handle text_order::step(&mut *sorter, &mut *controls) {
            Result::Err(error) => Result::Err(text_error(error, name)),
            Result::Ok(event) => handle event {
                text_order::Event::Continue => Result::Ok(Event::Continue),
                text_order::Event::Ready => handle text_order::finish(sorter, & *controls) {
                    Result::Err(error) => Result::Err(text_error(error, name)),
                    Result::Ok(sorted) => {
                        (*work).sorter = None; (*work).sorted = Result::Ok(sorted);
                        (*work).cursor = as<usize>(0); (*work).byte = as<usize>(0); (*work).phase = next;
                        Result::Ok(Event::Continue)
                    },
                },
            },
        },
    }
}
fn capability_start(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle Vec::len(&work.raw_capabilities) > limits.capabilities {
        true => Result::Err(Failure::Capacity { name: 5, limit: limits.capabilities }),
        false => {
            let values = replace(&mut work.raw_capabilities, Vec<String>::new());
            (*work).sorter = Result::Ok(text_order::begin(values, limits.capabilities));
            (*work).sorted = None; (*work).phase = Phase::CapabilitySort;
            Result::Ok(Event::Continue)
        },
    }
}
fn package_next(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle Result::as_mut(&mut work.sorted) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(sorted) => handle work.cursor == text_order::extent(& *sorted) {
            true => capability_start(work, limits),
            false => handle text_order::take(sorted, work.cursor) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(value) => {
                    (*work).candidate = Result::Ok(value); (*work).cursor = work.cursor + 1;
                    (*work).byte = as<usize>(0); (*work).phase = Phase::PackageUnique;
                    Result::Ok(Event::Continue)
                },
            },
        },
    }
}
fn package_order(work: &Work) -> Result<Option<Ordering>, Failure> {
    handle Result::as_ref(&work.candidate) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(candidate) => handle Vec::last(&work.aliases) {
            Result::Err(_) => Result::Ok(Result::Ok(Ordering::Less)),
            Result::Ok(previous) => {
                let package = names::package(previous);
                let a = String::as_str(&package.value);
                let b = String::as_str(candidate);
                Result::Ok(order::byte_order(a, b, work.byte))
            },
        },
    }
}
fn alias_start(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle Vec::len(&work.aliases) >= limits.packages {
        true => Result::Err(Failure::Capacity { name: 6, limit: limits.packages }),
        false => handle Option::take(&mut work.candidate) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(value) => {
                (*work).alias = Result::Ok(names::begin_alias(PackageKey { value: value }, limits.alias_bytes));
                (*work).phase = Phase::Alias; Result::Ok(Event::Continue)
            },
        },
    }
}
fn package_unique(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle package_order(& *work) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(order) => handle order {
            Result::Err(_) => { (*work).byte = work.byte + 1; Result::Ok(Event::Continue) },
            Result::Ok(order) => handle order {
                Ordering::Greater => Result::Err(Failure::Invariant),
                Ordering::Equal => { (*work).candidate = None; (*work).phase = Phase::PackageNext; Result::Ok(Event::Continue) },
                Ordering::Less => alias_start(work, limits),
            },
        },
    }
}
fn collision(work: &Work, value: names::PackageAlias, index: usize, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let previous = Vec::get_unchecked(&work.aliases, index);
    let package = names::package(previous);
    handle copy(&package.value, controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(first) => handle names::alias_parts(value) {
            (second, alias) => Result::Err(Failure::Rejected(InputError::DuplicatePackageModuleAlias {
                alias: alias, first: PackageKey { value: first }, second: second })),
        },
    }
}
fn index_alias(work: &mut Work, value: names::PackageAlias, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let alias = names::alias_text(&value);
    handle charge(&mut *controls, Str::len(alias)) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle charge(&mut *controls, Str::len(alias)) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => {
                let key = Str::to_string(alias);
                let index = Vec::len(&work.aliases);
                // Hash/lookup use the canonical library, with exact String
                // equality after hashing. Physical/probe polling costs remain
                // part of the substrate certification, not this logical charge.
                handle HashMap::insert(&mut work.alias_index, key, index) {
                    Result::Ok(previous) => collision(& *work, value, previous, controls),
                    Result::Err(_) => {
                        Vec::push(&mut work.aliases, value); (*work).phase = Phase::PackageNext;
                        Result::Ok(Event::Continue)
                    },
                }
            },
        },
    }
}
fn alias_step(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle Result::as_mut(&mut work.alias) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(builder) => handle names::step_alias(&mut *builder, &mut *controls) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(event) => handle event {
                Event::Continue => Result::Ok(Event::Continue),
                Event::Ready => handle names::finish_alias(builder, & *controls) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(value) => { (*work).alias = None; index_alias(work, value, controls) },
                },
            },
        },
    }
}
fn capability_next(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle Result::as_mut(&mut work.sorted) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(sorted) => handle work.cursor == text_order::extent(& *sorted) {
            true => { (*work).sorted = None; (*work).cursor = as<usize>(1); (*work).byte = as<usize>(0); (*work).phase = Phase::Duplicates; Result::Ok(Event::Continue) },
            false => handle text_order::take(sorted, work.cursor) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(value) => {
                    (*work).cursor = work.cursor + 1; (*work).capability = Result::Ok(names::begin_capability(value, limits.capability_bytes));
                    (*work).phase = Phase::Capability; Result::Ok(Event::Continue)
                },
            },
        },
    }
}
fn capability_step(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle Result::as_mut(&mut work.capability) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(builder) => handle names::step_capability(&mut *builder, &mut *controls) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(event) => handle event {
                Event::Continue => Result::Ok(Event::Continue),
                Event::Ready => handle names::finish_capability(builder, & *controls) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(value) => {
                        (*work).capability = None; Vec::push(&mut work.capabilities, value); (*work).phase = Phase::CapabilityNext;
                        Result::Ok(Event::Continue)
                    },
                },
            },
        },
    }
}
fn duplicate_order(work: &Work) -> Option<Ordering> {
    let a = names::capability_text(Vec::get_unchecked(&work.capabilities, work.cursor - 1));
    let b = names::capability_text(Vec::get_unchecked(&work.capabilities, work.cursor));
    order::byte_order(a, b, work.byte)
}
fn duplicates(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle work.cursor >= Vec::len(&work.capabilities) {
        true => { (*work).phase = Phase::Ready; Result::Ok(Event::Ready) },
        false => handle duplicate_order(& *work) {
            Result::Err(_) => { (*work).byte = work.byte + 1; Result::Ok(Event::Continue) },
            Result::Ok(order) => handle order {
                Ordering::Greater => Result::Err(Failure::Invariant),
                Ordering::Less => { (*work).cursor = work.cursor + 1; (*work).byte = as<usize>(0); Result::Ok(Event::Continue) },
                Ordering::Equal => {
                    let value = names::capability_text(Vec::get_unchecked(&work.capabilities, work.cursor));
                    handle charge(controls, Str::len(value)) {
                        Result::Err(error) => Result::Err(error),
                        Result::Ok(_) => Result::Err(Failure::Rejected(InputError::DuplicateCapability(Str::to_string(value)))),
                    }
                },
            },
        },
    }
}
fn transition(work: &mut Work, limits: Limits, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle work.phase {
        Phase::Root => handle copy(&work.root.value, controls) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(root) => { Vec::push(&mut work.candidates, root); (*work).phase = Phase::Harvest; Result::Ok(Event::Continue) },
        },
        Phase::Harvest => harvest(work, controls),
        Phase::PackageSort => sort_step(work, controls, Phase::PackageNext, 6),
        Phase::PackageNext => package_next(work, limits),
        Phase::PackageUnique => package_unique(work, limits),
        Phase::Alias => alias_step(work, controls),
        Phase::CapabilitySort => sort_step(work, controls, Phase::CapabilityNext, 5),
        Phase::CapabilityNext => capability_next(work, limits),
        Phase::Capability => capability_step(work, controls),
        Phase::Duplicates => duplicates(work, controls),
        Phase::Ready => Result::Ok(Event::Ready),
    }
}
fn checked(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle operation::charge(&mut *controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(work) => transition(work, builder.limits, controls),
        },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = checked(&mut *builder, controls);
    handle result { Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<Admitted, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase {
                Phase::Ready => Result::Ok(Admitted { root: work.root, sources: work.sources, aliases: work.aliases,
                    capabilities: work.capabilities, alias_index: work.alias_index }),
                _ => Result::Err(Failure::Busy),
            },
        },
    }
}
