use std::*;
use super::kernel::database;
use super::kernel::engine;
use super::kernel::identity;
use super::kernel::identity::Digest;
use super::kernel::identity::FileKey;
use super::kernel::identity::RevisionId;
use super::kernel::operation;
use super::kernel::operation::budget;
use super::kernel::query;
use super::kernel::dependency;
use super::kernel::publication;
use super::kernel::storage;
use super::kernel::storage::Handle;
use super::kernel::storage::Arena;
use super::source;

// Implemented by the immutable admitted world, not by individual providers.
// Full request normalization and its public facade remain separate work.
pub trait World { source<'a>(world: &'a Self, file: FileKey) -> Option<&'a source::Blob>; }
pub enum Family { SourceBytes, LineIndex, Lex }
struct Key { family: Family, file: FileKey }
pub struct Limits {
    revisions: usize, sessions: usize, attempts: usize, memos: usize, reads: usize, keys: usize,
    source_products: usize, line_products: usize, lex_products: usize, drivers: usize, frames: usize, source_bytes: usize, lines: usize, tokens: usize,
}
pub enum Failure { Database(database::Failure), Source(source::Failure), Budget(budget::Failure), MissingSource(FileKey), Closed, Closing, Busy, Capacity, Invariant, Cancelled }
pub impl Clone for Failure {
    clone(value: &Failure) -> Failure {
        handle *value {
            Failure::Database(_) => Failure::Database(Clone::clone(&value.0)),
            Failure::Source(error) => Failure::Source(error),
            Failure::Budget(_) => Failure::Budget(Clone::clone(&value.0)),
            Failure::MissingSource(file) => Failure::MissingSource(file),
            Failure::Closed => Failure::Closed,
            Failure::Closing => Failure::Closing,
            Failure::Busy => Failure::Busy,
            Failure::Capacity => Failure::Capacity,
            Failure::Invariant => Failure::Invariant,
            Failure::Cancelled => Failure::Cancelled,
        }
    }
}
pub struct Session { private handle: Handle }
pub struct ResourceLimits { source: u64, lines: u64, lex: u64, reservations: usize }
pub struct ResourceStats { total: u64, source: u64, lines: u64, lex: u64, reservations: usize }
pub struct OwnershipStats { phase_owners: usize, closed_phase_owners: usize, root_owners: usize, root_leases: usize, closed_roots: usize }
pub struct ProductResources { resources: ResourceStats, closed: Bool }
pub struct Reservation { private session: Session, private lease: budget::Lease, private amount: u64 }
pub impl Use<[0, 1]> for Reservation {}
pub struct Query<T> { private handle: Handle }
pub struct Value<T> { private outcome: engine::Outcome }
struct Visit { outcome: engine::Outcome, cursor: usize }
struct Projection { stack: Vec<Visit>, seen: HashSet<query::ReadIdentity> }
impl Use<[0, 1]> for Projection {}
// The result and all derived facts stay private until the shared request
// transaction commits. No provider/caller supplies a fact or fingerprint.
pub struct Publication<T> { private session: Session, private value: Value<T>,
    private projection: Option<Projection>, private staged: Option<database::Staged<Value<T>>>, private closed: Bool }
pub impl<T> Use<[0, 1]> for Publication<T> {}
pub enum Event<T> { Continue, Waiting, Ready(Value<T>) }
pub enum CloseStep { Continue, Done }
pub enum CollectionStep { Continue, Done(database::Collected) }
pub struct Stats { core: database::Stats, sources: usize, lines: usize, lexical: usize, drivers: usize, sessions: usize,
    source_keys: database::KeyStats, line_keys: database::KeyStats, lex_keys: database::KeyStats }

// Neither the product tag nor its typed-store handle can be supplied by a
// provider or a public caller. Only publication below constructs these refs.
enum ProductKind { Source(Handle), Lines(Handle), Lexical(Handle) }
struct Product { kind: ProductKind }
struct PhaseReservation { owner: Handle, lease: budget::Lease }
impl Use<[0, 1]> for PhaseReservation {}
struct Owned<T> { value: T, phase: Option<PhaseReservation> }
impl<T> Use<[0, 1]> for Owned<T> where T: Use<[0, 1]> {}
struct Stores { sources: Arena<Owned<source::Blob>>, lines: Arena<Owned<source::LineIndex>>, lexical: Arena<Owned<source::lex::LexedFile>> }
enum SessionPhase { Active, Closing { cursor: usize } }
struct Resources { pool: budget::Pool, root: budget::Budget, source: budget::Budget, lines: budget::Budget, lex: budget::Budget, closed: Bool }
impl Use<[0, 1]> for Resources {}
struct ResourceOwners { values: Arena<Resources>, closed: usize }
impl Use<[0, 1]> for ResourceOwners {}
struct Request { core: database::Session, phase: SessionPhase, resources: Handle }
impl Use<[0, 1]> for Request {}
enum Phase { Engine, SourceInput, SourceCopy, NeedSource, AwaitSource, AwaitReplay, BeginLines, Lines, BeginLex, Lex }
struct Frame { key: Key, interned: database::Key<FileKey>, ticket: engine::Ticket,
    phase: Phase, source: Option<engine::Outcome>, builder: Option<source::LineBuilder>, memory: Option<PhaseReservation>, copier: Option<source::CopyBuilder>, lexer: Option<source::lex::Builder> }
impl Use<[0, 1]> for Frame {}
enum Mode { Running, Failed(Failure) }
struct Driver { session: Session, frames: Vec<Frame>, mode: Mode }
impl Use<[0, 1]> for Driver {}
enum Step { Continue, Waiting, Child(Key), Done(engine::Outcome) }
struct Disposal { token: database::Released<Product>, removed: Bool, phase: Option<PhaseReservation> }
impl Use<[0, 1]> for Disposal {}
enum Collection {
    Idle, Core, BeginRoots { report: database::Collected },
    Roots { cursor: engine::RootCursor, report: database::Collected },
    SourceKeys { cursor: usize, report: database::Collected },
    LineKeys { cursor: usize, report: database::Collected },
    LexKeys { cursor: usize, report: database::Collected },
}
pub struct Registry<W> {
    private core: database::Database<W, Product>, private sources: database::Family<FileKey>, private lines: database::Family<FileKey>, private lexical: database::Family<FileKey>,
    private stores: Stores, private requests: Arena<Request>, private drivers: Arena<Driver>,
    private limits: Limits, private disposal: Option<Disposal>, private collection: Collection,
    private id: u64, private next_resource_owner: u64,
    private resource_owners: ResourceOwners,
}
pub impl<W> Use<[0, 1]> for Registry<W> where W: Use<[0, 1]> {}

pub fn create<W>(id: u64, limits: Limits) -> Result<Registry<W>, Failure> {
    handle limits.sessions <= 18446744073709551615 - limits.memos {
        false => Result::Err(Failure::Capacity),
        true => create_sized(id, limits, limits.sessions + limits.memos),
    }
}
fn create_sized<W>(id: u64, limits: Limits, owners: usize) -> Result<Registry<W>, Failure> {
    let core = database::create<W, Product>(id, limits.revisions, limits.sessions, limits.attempts, limits.memos, limits.reads);
    handle database::family<FileKey, W, Product>(&mut core, 1, query::RecoveryPolicy::Reject, engine::ReusePolicy::Tracked, limits.keys) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(sources) => handle database::family<FileKey, W, Product>(&mut core, 1, query::RecoveryPolicy::Reject, engine::ReusePolicy::Tracked, limits.keys) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(lines) => handle database::family<FileKey, W, Product>(&mut core, 1, query::RecoveryPolicy::Reject, engine::ReusePolicy::Tracked, limits.keys) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(lexical) => Result::Ok(Registry { core: core, sources: sources, lines: lines, lexical: lexical,
                stores: Stores { sources: storage::namespace(id, 1099511627776, limits.source_products),
                    lines: storage::namespace(id, 1099511627777, limits.line_products),
                    lexical: storage::namespace(id, 1099511627781, limits.lex_products) },
                drivers: storage::namespace(id, 1099511627778, limits.drivers),
                requests: storage::namespace(id, 1099511627779, limits.sessions), limits: limits, disposal: None, collection: Collection::Idle,
                id: id, next_resource_owner: 2199023255552,
                resource_owners: ResourceOwners { values: storage::namespace(id, 1099511627780, owners), closed: 0 } }),
            },
        },
    }
}
pub fn import<W>(registry: &mut Registry<W>, world: W, fingerprint: Digest, parent: Option<RevisionId>) -> Result<RevisionId, Failure>
    where W: Use<[0, 1]> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle database::import(&mut registry.core, world, fingerprint, parent) {
            Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(revision) => Result::Ok(revision),
        },
    }
}
pub fn open<W>(registry: &mut Registry<W>, revision: RevisionId, work: u64, memory: u64) -> Result<Session, Failure> {
    let limits = ResourceLimits { source: memory, lines: memory, lex: memory, reservations: registry.limits.memos };
    open_with_resources(registry, revision, work, memory, limits)
}
pub fn open_with_resources<W>(registry: &mut Registry<W>, revision: RevisionId, work: u64, memory: u64,
    limits: ResourceLimits) -> Result<Session, Failure> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => open_ready(registry, revision, work, memory, limits),
    }
}
fn resources(id: u64, owner: u64, memory: u64, limits: ResourceLimits) -> Result<Resources, Failure> {
    let pool = budget::create(id, owner, 4, limits.reservations);
    handle budget::root(&mut pool, 1, memory) {
        Result::Err(error) => Result::Err(Failure::Budget(error)),
        Result::Ok(root) => handle budget::child(&mut pool, root, 2, limits.source) {
            Result::Err(error) => Result::Err(Failure::Budget(error)),
            Result::Ok(source) => handle budget::child(&mut pool, root, 3, limits.lines) {
                Result::Err(error) => Result::Err(Failure::Budget(error)),
                Result::Ok(lines) => handle budget::child(&mut pool, root, 4, limits.lex) {
                    Result::Err(error) => Result::Err(Failure::Budget(error)),
                    Result::Ok(lex) => Result::Ok(Resources { pool: pool, root: root, source: source, lines: lines, lex: lex, closed: false }),
                },
            },
        },
    }
}
fn open_ready<W>(registry: &mut Registry<W>, revision: RevisionId, work: u64, memory: u64, limits: ResourceLimits) -> Result<Session, Failure> {
    handle registry.next_resource_owner == 18446744073709551615 {
        true => Result::Err(Failure::Capacity),
        false => {
            let owner = registry.next_resource_owner;
            (*registry).next_resource_owner = owner + 1;
            handle resources(registry.id, owner, memory, limits) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(resources) => open_owned(registry, revision, work, memory, resources),
            }
        },
    }
}
fn open_owned<W>(registry: &mut Registry<W>, revision: RevisionId, work: u64, memory: u64, resources: Resources) -> Result<Session, Failure> {
    handle database::open(&mut registry.core, revision, query::RecoveryPolicy::Reject, work, memory) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(core) => handle storage::insert(&mut registry.resource_owners.values, resources) {
            Result::Err(_) => { database::close(&mut registry.core, core); Result::Err(Failure::Capacity) },
            Result::Ok(owner) => handle storage::insert(&mut registry.requests, Request { core: core, phase: SessionPhase::Active, resources: owner }) {
                Result::Err(_) => {
                    storage::remove(&mut registry.resource_owners.values, owner);
                    database::close(&mut registry.core, core);
                    Result::Err(Failure::Capacity)
                },
                Result::Ok(slot) => Result::Ok(Session { handle: slot }),
            },
        },
    }
}
pub fn reserve<W>(registry: &mut Registry<W>, session: Session, family: Family, amount: u64) -> Result<Reservation, Failure> {
    handle admitted(& *registry, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(core) => handle request_resource(&registry.requests, session) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(owner) => handle storage::get_mut(&mut registry.resource_owners.values, owner) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(resources) => handle database::request_controls(&mut registry.core, core) {
                Result::Err(error) => Result::Err(Failure::Database(error)),
                Result::Ok(controls) => {
                    let selected = handle family { Family::SourceBytes => resources.source, Family::LineIndex => resources.lines, Family::Lex => resources.lex };
                    handle reserve_owned(&mut resources.pool, selected, amount, controls) {
                        Result::Err(error) => Result::Err(error),
                        Result::Ok(lease) => Result::Ok(Reservation { session: session, lease: lease, amount: amount }),
                    }
                },
            },
            },
        },
    }
}
fn request_resource(requests: &Arena<Request>, session: Session) -> Result<Handle, Failure> {
    handle storage::get(requests, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(request) => Result::Ok(request.resources),
    }
}
fn release_phase(owners: &mut ResourceOwners, memory: &mut Option<PhaseReservation>) -> Result<(), Failure> {
    let released = handle Result::as_mut(&mut *memory) {
        Result::Err(_) => Result::Ok(None),
        Result::Ok(reservation) => handle storage::get_mut(&mut owners.values, reservation.owner) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(resources) => handle budget::release_lease(&mut resources.pool, &mut reservation.lease) {
                Result::Err(error) => Result::Err(Failure::Budget(error)),
                Result::Ok(_) => Result::Ok(Result::Ok((reservation.owner, resources.closed, budget::retained_reservations(&resources.pool)))),
            },
        },
    };
    handle released {
        Result::Err(error) => Result::Err(error),
        Result::Ok(released) => {
            (*memory) = None;
            handle released {
                Result::Err(_) => (),
                Result::Ok((owner, closed, remaining)) => handle closed {
                    false => (),
                    true => handle remaining == 0 {
                        false => (),
                        true => { storage::remove(&mut owners.values, owner); (*owners).closed = owners.closed - 1; },
                    },
                },
            };
            Result::Ok(())
        },
    }
}
fn reserve_phase<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners,
    owner: Handle, session: database::Session, frame: &mut Frame, amount: u64) -> Result<(), Failure> {
    handle database::reserve_product_memory(&mut *core, frame.ticket, amount) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(_) => handle admit_phase(&mut *core, owners, owner, session, frame.key.family, &mut frame.memory, amount) {
            Result::Ok(_) => Result::Ok(()),
            Result::Err(error) => {
                let rollback = handle Result::as_ref(&frame.memory) {
                    Result::Err(_) => database::discard_product_memory(core, frame.ticket),
                    Result::Ok(_) => database::shrink_product_memory(core, frame.ticket, amount),
                };
                handle rollback { Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Err(error) }
            },
        },
    }
}
fn admit_phase<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners,
    owner: Handle, session: database::Session, family: Family, memory: &mut Option<PhaseReservation>, amount: u64) -> Result<(), Failure> {
    handle storage::get_mut(&mut owners.values, owner) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(resources) => handle database::request_controls(core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(controls) => phase_lease(resources, owner, family, memory, amount, controls),
        },
    }
}
fn phase_lease(resources: &mut Resources, owner: Handle, family: Family, memory: &mut Option<PhaseReservation>,
    amount: u64, controls: &mut operation::Controls) -> Result<(), Failure> {
    handle Result::as_ref(& *memory) {
        Result::Ok(reservation) => handle storage::equal(reservation.owner, owner) {
            false => Result::Err(Failure::Invariant),
            true => handle budget::grow_lease(&mut resources.pool, &reservation.lease, amount, controls) {
                Result::Err(error) => Result::Err(Failure::Budget(error)), Result::Ok(_) => Result::Ok(()),
            },
        },
        Result::Err(_) => {
            let selected = handle family { Family::SourceBytes => resources.source, Family::LineIndex => resources.lines, Family::Lex => resources.lex };
            handle budget::lease(&mut resources.pool, selected, amount, controls) {
                Result::Err(error) => Result::Err(Failure::Budget(error)),
                Result::Ok(lease) => handle budget::retain_lease(&mut resources.pool, &lease) {
                    Result::Err(error) => {
                        budget::release_lease(&mut resources.pool, &mut lease);
                        Result::Err(Failure::Budget(error))
                    },
                    Result::Ok(_) => { (*memory) = Result::Ok(PhaseReservation { owner: owner, lease: lease }); Result::Ok(()) },
                },
            }
        },
    }
}
fn reserve_owned(pool: &mut budget::Pool, selected: budget::Budget, amount: u64,
    controls: &mut operation::Controls) -> Result<budget::Lease, Failure> {
    // Charge the real shared request root first. A later phase/capacity/work
    // rejection rolls back this reservation, never the path's spent work.
    handle operation::reserve(&mut *controls, amount) {
        Result::Err(error) => Result::Err(Failure::Budget(budget::Failure::Control(error))),
        Result::Ok(_) => handle budget::lease(pool, selected, amount, &mut *controls) {
            Result::Ok(lease) => Result::Ok(lease),
            Result::Err(error) => handle operation::release(controls, amount) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(_) => Result::Err(Failure::Budget(error)),
            },
        },
    }
}
pub fn release_reservation<W>(registry: &mut Registry<W>, reservation: &mut Reservation) -> Result<(), Failure> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle storage::get_mut(&mut registry.requests, reservation.session.handle) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(request) => handle storage::get_mut(&mut registry.resource_owners.values, request.resources) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(resources) => handle budget::release_lease(&mut resources.pool, &mut reservation.lease) {
                Result::Err(error) => Result::Err(Failure::Budget(error)),
                Result::Ok(_) => handle database::release_memory(&mut registry.core, request.core, reservation.amount) {
                    Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(()),
                },
                },
            },
        },
    }
}
pub fn memory_spent<W>(registry: &Registry<W>, session: Session) -> Result<u64, Failure> {
    handle available(registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle storage::get(&registry.requests, session.handle) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(request) => handle database::memory_spent(&registry.core, request.core) {
                Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(spent) => Result::Ok(spent),
            },
        },
    }
}
pub fn resource_stats<W>(registry: &Registry<W>, session: Session) -> Result<ResourceStats, Failure> {
    handle available(registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle storage::get(&registry.requests, session.handle) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(request) => handle storage::get(&registry.resource_owners.values, request.resources) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(resources) => resource_values(resources),
            },
        },
    }
}
fn resource_values(resources: &Resources) -> Result<ResourceStats, Failure> {
    handle budget::spent(&resources.pool, resources.root) {
        Result::Err(error) => Result::Err(Failure::Budget(error)),
        Result::Ok(total) => handle budget::spent(&resources.pool, resources.source) {
            Result::Err(error) => Result::Err(Failure::Budget(error)),
            Result::Ok(source) => handle budget::spent(&resources.pool, resources.lines) {
                Result::Err(error) => Result::Err(Failure::Budget(error)),
                Result::Ok(lines) => handle budget::spent(&resources.pool, resources.lex) {
                    Result::Err(error) => Result::Err(Failure::Budget(error)),
                    Result::Ok(lex) => Result::Ok(ResourceStats { total: total, source: source, lines: lines, lex: lex,
                        reservations: budget::reservations(&resources.pool) }),
                },
            },
        },
    }
}
pub fn ownership_stats<W>(registry: &Registry<W>) -> Result<OwnershipStats, Failure> {
    handle available(registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle database::memory_stats(&registry.core) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(root) => Result::Ok(OwnershipStats { phase_owners: storage::count(&registry.resource_owners.values),
                closed_phase_owners: registry.resource_owners.closed, root_owners: root.owners, root_leases: root.leases, closed_roots: root.closed_owners }),
        },
    }
}
fn phase_of<'a, T>(value: &'a Owned<T>) -> Result<&'a PhaseReservation, Failure> {
    handle Result::as_ref(&value.phase) { Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(phase) => Result::Ok(phase) }
}
fn product_phase<'a>(stores: &'a Stores, kind: ProductKind) -> Result<&'a PhaseReservation, Failure> {
    handle kind {
        ProductKind::Source(key) => handle storage::get(&stores.sources, key) {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => phase_of(value),
        },
        ProductKind::Lines(key) => handle storage::get(&stores.lines, key) {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => phase_of(value),
        },
        ProductKind::Lexical(key) => handle storage::get(&stores.lexical, key) {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => phase_of(value),
        },
    }
}
pub fn product_resources<T, W>(registry: &Registry<W>, session: Session, value: Value<T>) -> Result<ProductResources, Failure> {
    handle admitted(registry, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(core) => handle product(&registry.core, core, value.outcome) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(kind) => handle product_phase(&registry.stores, kind) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(phase) => handle storage::get(&registry.resource_owners.values, phase.owner) {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(resources) => handle resource_values(resources) {
                        Result::Err(error) => Result::Err(error),
                        Result::Ok(values) => Result::Ok(ProductResources { resources: values, closed: resources.closed }),
                    },
                },
            },
        },
    }
}
fn active(requests: &Arena<Request>, session: Session) -> Result<database::Session, Failure> {
    handle storage::get(requests, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => handle request.phase { SessionPhase::Active => Result::Ok(request.core), _ => Result::Err(Failure::Closing) },
    }
}
fn available<W>(registry: &Registry<W>) -> Result<(), Failure> {
    handle registry.collection {
        Collection::Idle => handle database::available(&registry.core) {
            Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(()),
        },
        _ => Result::Err(Failure::Database(database::Failure::Collecting)),
    }
}
fn admitted<W>(registry: &Registry<W>, session: Session) -> Result<database::Session, Failure> {
    handle available(registry) { Result::Err(error) => Result::Err(error), Result::Ok(_) => active(&registry.requests, session) }
}
fn intern(sources: &mut database::Family<FileKey>, lines: &mut database::Family<FileKey>, lexical: &mut database::Family<FileKey>, key: Key)
    -> Result<database::Key<FileKey>, Failure> {
    handle key.family { Family::SourceBytes => intern_one(sources, key.file), Family::LineIndex => intern_one(lines, key.file), Family::Lex => intern_one(lexical, key.file) }
}
fn intern_one(family: &mut database::Family<FileKey>, file: FileKey) -> Result<database::Key<FileKey>, Failure> {
    handle database::intern(family, file) { Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(key) => Result::Ok(key) }
}
fn frame<W>(core: &mut database::Database<W, Product>, sources: &mut database::Family<FileKey>, lines: &mut database::Family<FileKey>, lexical: &mut database::Family<FileKey>,
    session: database::Session, key: Key, parent: Option<engine::Ticket>) -> Result<Frame, Failure> {
    handle intern(sources, lines, lexical, key) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(interned) => handle database::start(core, session, interned, parent) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(ticket) => Result::Ok(Frame { key: key, interned: interned, ticket: ticket,
                phase: Phase::Engine, source: None, builder: None, memory: None, copier: None, lexer: None }),
        },
    }
}
fn start<T, W>(registry: &mut Registry<W>, session: Session, key: Key) -> Result<Query<T>, Failure> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle active(&registry.requests, session) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(core) => handle registry.limits.frames == 0 {
                true => Result::Err(Failure::Capacity),
                false => handle frame(&mut registry.core, &mut registry.sources, &mut registry.lines, &mut registry.lexical, core, key, None) {
                    Result::Err(error) => Result::Err(error), Result::Ok(frame) => install(registry, session, frame),
                },
            },
        },
    }
}
fn install<T, W>(registry: &mut Registry<W>, session: Session, frame: Frame) -> Result<Query<T>, Failure> {
    let ticket = frame.ticket;
    let frames = Vec<Frame>::new();
    Vec::push(&mut frames, frame);
    handle storage::insert(&mut registry.drivers, Driver { session: session, frames: frames, mode: Mode::Running }) {
        Result::Err(_) => { database::abort(&mut registry.core, ticket); Result::Err(Failure::Capacity) },
        Result::Ok(slot) => Result::Ok(Query { handle: slot }),
    }
}
pub fn source_bytes<W>(registry: &mut Registry<W>, session: Session, file: FileKey) -> Result<Query<source::Blob>, Failure> {
    start(registry, session, Key { family: Family::SourceBytes, file: file })
}
pub fn line_index<W>(registry: &mut Registry<W>, session: Session, file: FileKey) -> Result<Query<source::LineIndex>, Failure> {
    start(registry, session, Key { family: Family::LineIndex, file: file })
}
pub fn lex<W>(registry: &mut Registry<W>, session: Session, file: FileKey) -> Result<Query<source::lex::LexedFile>, Failure> {
    start(registry, session, Key { family: Family::Lex, file: file })
}
pub fn execution<T>(value: Value<T>) -> engine::Execution { value.outcome.execution }
pub fn fingerprint<T>(value: Value<T>) -> Digest { value.outcome.fingerprint }

pub fn begin_publication<T, W>(registry: &mut Registry<W>, session: Session, value: Value<T>, limits: publication::Limits)
    -> Result<Publication<T>, Failure> {
    handle admitted(& *registry, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(core) => handle product(&registry.core, core, value.outcome) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle database::begin_request(&mut registry.core, core, limits) {
                Result::Err(error) => Result::Err(Failure::Database(error)),
                Result::Ok(_) => {
                    let stack = Vec<Visit>::new();
                    Vec::push(&mut stack, Visit { outcome: value.outcome, cursor: 0 });
                    Result::Ok(Publication { session: session, value: value,
                        projection: Result::Ok(Projection { stack: stack, seen: HashSet::new() }), staged: None, closed: false })
                },
            },
        },
    }
}
fn project_input<W>(core: &mut database::Database<W, Product>, sources: &database::Family<FileKey>,
    session: database::Session, read: query::Read) -> Result<(), Failure> {
    // The legacy ledger has no LineIndex/Lex node. These transparent queries
    // contributes the exact Input leaf, not a made-up semantic node/self-edge.
    handle query::family(read.identity) == 0 {
        false => Result::Err(Failure::Invariant),
        true => handle read_file(sources, read.identity) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(file) => handle database::record_dependency(core, session,
                dependency::node::Node::Input(file), read.fingerprint, Vec::new()) {
                Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(()),
            },
        },
    }
}
fn project_child<W>(core: &database::Database<W, Product>, sources: &database::Family<FileKey>, lines: &database::Family<FileKey>, lexical: &database::Family<FileKey>,
    session: database::Session, projection: &mut Projection, visit: Visit, read: query::Read, limit: usize) -> Result<(), Failure> {
    handle read_key(sources, lines, lexical, read.identity) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle database::observed_query(core, session, visit.outcome, visit.cursor) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(child) => handle HashSet::contains(&projection.seen, &read.identity) {
                true => Result::Ok(()),
                false => handle HashSet::len(&projection.seen) < limit {
                    false => Result::Err(Failure::Capacity),
                    true => { HashSet::insert(&mut projection.seen, read.identity);
                        Vec::push(&mut projection.stack, Visit { outcome: child, cursor: 0 }); Result::Ok(()) },
                },
            },
        },
    }
}
fn project_read<W>(core: &mut database::Database<W, Product>, sources: &database::Family<FileKey>, lines: &database::Family<FileKey>, lexical: &database::Family<FileKey>,
    session: database::Session, projection: &mut Projection, visit: Visit, read: query::Read, limit: usize) -> Result<(), Failure> {
    handle read.completeness {
        query::Completeness::Recovered => Result::Err(Failure::Invariant),
        query::Completeness::Complete => handle query::projection(read.identity) {
            0 => project_child(& *core, sources, lines, lexical, session, projection, visit, read, limit),
            1 => project_input(core, sources, session, read),
            _ => Result::Err(Failure::Invariant),
        },
    }
}
fn projection_step<W>(core: &mut database::Database<W, Product>, sources: &database::Family<FileKey>, lines: &database::Family<FileKey>, lexical: &database::Family<FileKey>,
    session: database::Session, projection: &mut Projection, limit: usize) -> Result<Bool, Failure> {
    handle charge(&mut *core, session, 1) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle Vec::pop(&mut projection.stack) {
            Result::Err(_) => Result::Ok(true),
            Result::Ok(visit) => handle database::observation(& *core, session, visit.outcome, visit.cursor) {
                Result::Err(error) => Result::Err(Failure::Database(error)),
                Result::Ok(read) => handle read {
                    Result::Err(_) => Result::Ok(false),
                    Result::Ok(read) => {
                        Vec::push(&mut projection.stack, Visit { outcome: visit.outcome, cursor: visit.cursor + 1 });
                        handle project_read(core, sources, lines, lexical, session, projection, visit, read, limit) {
                            Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(false),
                        }
                    },
                },
            },
        },
    }
}
fn publication_step<T, W>(registry: &mut Registry<W>, session: database::Session, pending: &mut Publication<T>)
    -> Result<database::PublicationStep, Failure> where W: database::DiagnosticWorld {
    handle Result::as_mut(&mut pending.projection) {
        Result::Err(_) => handle database::step_request(&mut registry.core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(step) => Result::Ok(step),
        },
        Result::Ok(projection) => handle projection_step(&mut registry.core, &registry.sources, &registry.lines, &registry.lexical,
            session, projection, registry.limits.memos) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(done) => handle done {
              false => Result::Ok(database::PublicationStep::Continue),
              true => {
                (*pending).projection = None;
                handle database::stage_request(&mut registry.core, session, pending.value) {
                    Result::Err(error) => Result::Err(Failure::Database(error)),
                    Result::Ok(staged) => { (*pending).staged = Result::Ok(staged); Result::Ok(database::PublicationStep::Continue) },
                }
              },
            },
        },
    }
}
pub fn step_publication<T, W>(registry: &mut Registry<W>, pending: &mut Publication<T>)
    -> Result<database::PublicationStep, Failure> where W: database::DiagnosticWorld {
    handle admitted(& *registry, pending.session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(session) => handle pending.closed {
            true => Result::Err(Failure::Closed),
            false => {
                let result = publication_step(&mut *registry, session, &mut *pending);
                handle result {
                    Result::Ok(step) => Result::Ok(step),
                    Result::Err(error) => { database::abort_request(&mut registry.core, session);
                        (*pending).projection = None; (*pending).staged = None;
                        (*pending).closed = Result<(), ()>::Ok(()); Result::Err(error) },
                }
            },
        },
    }
}
pub fn finish_publication<T, W>(registry: &mut Registry<W>, pending: Publication<T>)
    -> Result<database::Published<Value<T>>, Failure> {
    handle admitted(& *registry, pending.session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(session) => handle pending.staged {
            Result::Err(_) => { database::abort_request(&mut registry.core, session); Result::Err(Failure::Closed) },
            Result::Ok(staged) => handle database::finish_request(&mut registry.core, staged) {
                Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(value) => Result::Ok(value),
            },
        },
    }
}
pub fn request_traces<'a, W>(registry: &'a Registry<W>, session: Session)
    -> Result<Option<Slice<'a, dependency::Trace>>, Failure> {
    handle admitted(registry, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(session) => handle database::request_traces(&registry.core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(traces) => Result::Ok(traces),
        },
    }
}

fn product<W>(core: &database::Database<W, Product>, session: database::Session, outcome: engine::Outcome) -> Result<ProductKind, Failure> {
    handle database::value(core, session, outcome) {
        Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(value) => Result::Ok(value.kind),
    }
}
fn blob<'a, W>(core: &database::Database<W, Product>, stores: &'a Stores, session: database::Session, outcome: engine::Outcome)
    -> Result<&'a source::Blob, Failure> {
    handle product(core, session, outcome) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(kind) => handle kind {
            ProductKind::Source(key) => handle storage::get(&stores.sources, key) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => Result::Ok(&value.value),
            },
            _ => Result::Err(Failure::Invariant),
        },
    }
}
pub fn source_value<'a, W>(registry: &'a Registry<W>, session: Session, value: Value<source::Blob>) -> Result<&'a source::Blob, Failure> {
    handle admitted(registry, session) {
        Result::Err(error) => Result::Err(error), Result::Ok(core) => blob(&registry.core, &registry.stores, core, value.outcome),
    }
}
pub fn line_value<'a, W>(registry: &'a Registry<W>, session: Session, value: Value<source::LineIndex>) -> Result<&'a source::LineIndex, Failure> {
    handle admitted(registry, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(core) => handle product(&registry.core, core, value.outcome) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(kind) => handle kind {
                ProductKind::Lines(key) => handle storage::get(&registry.stores.lines, key) {
                    Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => Result::Ok(&value.value),
                },
                _ => Result::Err(Failure::Invariant),
            },
        },
    }
}
pub fn lex_value<'a, W>(registry: &'a Registry<W>, session: Session, value: Value<source::lex::LexedFile>) -> Result<&'a source::lex::LexedFile, Failure> {
    handle admitted(registry, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(core) => handle product(&registry.core, core, value.outcome) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(kind) => handle kind {
                ProductKind::Lexical(key) => handle storage::get(&registry.stores.lexical, key) {
                    Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(value) => Result::Ok(&value.value),
                },
                _ => Result::Err(Failure::Invariant),
            },
        },
    }
}
pub fn stats<W>(registry: &Registry<W>) -> Result<Stats, Failure> {
    handle available(registry) { Result::Err(error) => Result::Err(error), Result::Ok(_) => idle_stats(registry) }
}
fn idle_stats<W>(registry: &Registry<W>) -> Result<Stats, Failure> {
    handle database::stats(&registry.core) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(core) => Result::Ok(Stats { core: core, sources: storage::count(&registry.stores.sources),
            lines: storage::count(&registry.stores.lines), lexical: storage::count(&registry.stores.lexical), drivers: storage::count(&registry.drivers), sessions: storage::count(&registry.requests),
            source_keys: database::key_stats(&registry.sources), line_keys: database::key_stats(&registry.lines), lex_keys: database::key_stats(&registry.lexical) }),
    }
}
pub fn work_spent<W>(registry: &Registry<W>, session: Session) -> Result<u64, Failure> {
    handle admitted(registry, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(core) => handle database::work_spent(&registry.core, core) {
            Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(spent) => Result::Ok(spent),
        },
    }
}

fn charge<W>(core: &mut database::Database<W, Product>, session: database::Session, amount: u64) -> Result<(), Failure> {
    handle database::request_controls(core, session) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(controls) => handle operation::charge(controls, amount) {
            Result::Err(error) => Result::Err(Failure::Source(source::Failure::Control(error))), Result::Ok(_) => Result::Ok(()),
        },
    }
}
// This is the only world access in the driver. The provider algorithm below
// receives a checked immutable blob, never the world or a database reference.
fn pinned_source<'a, W>(core: &'a database::Database<W, Product>, session: database::Session, file: FileKey)
    -> Result<&'a source::Blob, Failure> where W: World {
    handle database::world(core, session) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(world) => handle World::source(world, file) {
            Result::Err(_) => Result::Err(Failure::MissingSource(file)),
            Result::Ok(value) => handle identity::equal(source::file(value).digest, file.digest) {
                false => Result::Err(Failure::Invariant),
                true => Result::Ok(value),
            },
        },
    }
}
fn input_size<W>(core: &database::Database<W, Product>, session: database::Session, file: FileKey, limit: usize)
    -> Result<u32, Failure> where W: World {
    handle pinned_source(core, session, file) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => handle as<usize>(source::length(value)) <= limit {
            false => Result::Err(Failure::Capacity), true => Result::Ok(source::length(value)),
        },
    }
}
fn input_fingerprint<W>(core: &database::Database<W, Product>, session: database::Session, file: FileKey)
    -> Result<Digest, Failure> where W: World {
    handle pinned_source(core, session, file) { Result::Err(error) => Result::Err(error), Result::Ok(value) => Result::Ok(source::fingerprint(value)) }
}
fn observe<W>(core: &mut database::Database<W, Product>, ticket: engine::Ticket, identity: query::ReadIdentity, fingerprint: Digest) -> Result<(), Failure> {
    handle database::observe_staged(core, ticket, query::Read { identity: identity, fingerprint: fingerprint, completeness: query::Completeness::Complete }) {
        Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(()),
    }
}
fn next(frame: &mut Frame, phase: Phase) -> Result<Step, Failure> { (*frame).phase = phase; Result::Ok(Step::Continue) }
fn stage<T>(store: &mut Arena<Owned<T>>, value: T, memory: &mut Option<PhaseReservation>) -> Result<Handle, Failure>
    where T: Use<[0, 1]> {
    handle storage::insert(&mut *store, Owned { value: value, phase: None }) {
        Result::Err(_) => Result::Err(Failure::Capacity),
        Result::Ok(key) => handle storage::get_mut(store, key) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(stored) => { (*stored).phase = Option::take(memory); Result::Ok(key) },
        },
    }
}
fn destroy<T>(value: T) -> () where T: Use<[0, 1]> { () }
fn unstage<T>(store: &mut Arena<Owned<T>>, key: Handle) -> Result<Option<PhaseReservation>, Failure> where T: Use<[0, 1]> {
    handle storage::remove(store, key) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(stored) => { destroy(stored.value); Result::Ok(stored.phase) },
    }
}
fn publication_failed<T, W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners,
    store: &mut Arena<Owned<T>>, key: Handle, frame: &mut Frame, error: database::Failure) -> Result<(), Failure>
    where T: Use<[0, 1]> {
    handle unstage(store, key) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(memory) => {
            (*frame).memory = memory;
            handle release_phase(owners, &mut frame.memory) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => { database::abort(core, frame.ticket); Result::Err(Failure::Database(error)) },
            }
        },
    }
}
fn publish_source<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, stores: &mut Stores,
    frame: &mut Frame, value: source::Blob) -> Result<(), Failure> {
    let fingerprint = source::fingerprint(&value);
    handle stage(&mut stores.sources, value, &mut frame.memory) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(key) => handle database::publish_staged(&mut *core, frame.ticket, Product { kind: ProductKind::Source(key) }, fingerprint, query::Completeness::Complete) {
            Result::Err(error) => publication_failed(core, owners, &mut stores.sources, key, frame, error),
            Result::Ok(_) => Result::Ok(()),
        },
    }
}
fn publish_lines<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, stores: &mut Stores,
    frame: &mut Frame, value: source::LineIndex) -> Result<(), Failure> {
    let fingerprint = source::line_fingerprint(&value);
    handle stage(&mut stores.lines, value, &mut frame.memory) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(key) => handle database::publish_staged(&mut *core, frame.ticket, Product { kind: ProductKind::Lines(key) }, fingerprint, query::Completeness::Complete) {
            Result::Err(error) => publication_failed(core, owners, &mut stores.lines, key, frame, error),
            Result::Ok(_) => Result::Ok(()),
        },
    }
}
fn publish_lex<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, stores: &mut Stores,
    frame: &mut Frame, value: source::lex::LexedFile) -> Result<(), Failure> {
    handle source::lex::product_fingerprint(&value) {
        Result::Err(error) => Result::Err(Failure::Source(error)),
        Result::Ok(fingerprint) => handle stage(&mut stores.lexical, value, &mut frame.memory) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(key) => handle database::publish_staged(&mut *core, frame.ticket, Product { kind: ProductKind::Lexical(key) }, fingerprint, query::Completeness::Complete) {
                Result::Err(error) => publication_failed(core, owners, &mut stores.lexical, key, frame, error),
                Result::Ok(_) => Result::Ok(()),
            },
        },
    }
}
fn source_input<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, owner: Handle,
    stores: &mut Stores, session: database::Session, frame: &mut Frame, limits: Limits)
    -> Result<Step, Failure> where W: World {
    handle input_size(& *core, session, frame.key.file, limits.source_bytes) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(length) => handle charge(&mut *core, session, wrapping_add(as<u64>(length), 1)) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle input_memory(& *core, session, frame.key.file) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(amount) => handle reserve_phase(&mut *core, &mut *owners, owner, session, &mut *frame, amount) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(_) => source_copy_start(core, owners, stores, session, frame),
                },
            },
        },
    }
}
fn input_memory<W>(core: &database::Database<W, Product>, session: database::Session, file: FileKey) -> Result<u64, Failure> where W: World {
    handle pinned_source(core, session, file) { Result::Err(error) => Result::Err(error), Result::Ok(value) => Result::Ok(source::copy_memory(value)) }
}
fn source_copy_start<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners,
    stores: &mut Stores, session: database::Session, frame: &mut Frame) -> Result<Step, Failure> where W: World {
    let copier = handle pinned_source(& *core, session, frame.key.file) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => handle database::request_controls_shared(& *core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(controls) => handle source::begin_copy(value, controls) {
                Result::Err(error) => Result::Err(Failure::Source(error)), Result::Ok(copier) => Result::Ok(copier),
            },
        },
    };
    handle copier {
        Result::Err(error) => Result::Err(error),
        Result::Ok(copier) => { (*frame).copier = Result::Ok(copier); source_copy_step(core, owners, stores, session, frame) },
    }
}
fn source_copy_work<W>(core: &database::Database<W, Product>, session: database::Session, frame: &mut Frame)
    -> Result<Option<source::Blob>, Failure> where W: World {
    handle pinned_source(core, session, frame.key.file) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => handle database::request_controls_shared(core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(controls) => handle Result::as_mut(&mut frame.copier) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(copier) => handle source::step_copy(&mut *copier, value, controls) {
                    Result::Err(error) => Result::Err(Failure::Source(error)),
                    Result::Ok(source::Event::Continue) => Result::Ok(None),
                    Result::Ok(source::Event::Ready) => handle source::finish_copy(copier, controls) {
                        Result::Err(error) => Result::Err(Failure::Source(error)), Result::Ok(value) => Result::Ok(Result::Ok(value)),
                    },
                },
            },
        },
    }
}
fn source_copy_step<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners,
    stores: &mut Stores, session: database::Session, frame: &mut Frame) -> Result<Step, Failure> where W: World {
    handle source_copy_work(& *core, session, &mut *frame) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => handle value {
            Result::Err(_) => next(frame, Phase::SourceCopy),
            Result::Ok(value) => { (*frame).copier = None; record_source(core, owners, stores, frame, value) },
        },
    }
}
fn record_source<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, stores: &mut Stores, frame: &mut Frame, value: source::Blob) -> Result<Step, Failure> {
    let identity = database::key_identity(frame.interned);
    let input = query::read_identity(query::family(identity), query::key(identity), 1);
    handle observe(&mut *core, frame.ticket, input, source::fingerprint(&value)) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle publish_source(core, owners, stores, &mut *frame, value) {
            Result::Err(error) => Result::Err(error), Result::Ok(_) => next(frame, Phase::Engine),
        },
    }
}
fn read_file(family: &database::Family<FileKey>, read: query::ReadIdentity) -> Result<FileKey, Failure> {
    handle database::key_value(family, read) { Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(file) => Result::Ok(*file) }
}
fn read_key(sources: &database::Family<FileKey>, lines: &database::Family<FileKey>, lexical: &database::Family<FileKey>, read: query::ReadIdentity) -> Result<Key, Failure> {
    handle query::family(read) {
        0 => handle read_file(sources, read) { Result::Err(error) => Result::Err(error), Result::Ok(file) => Result::Ok(Key { family: Family::SourceBytes, file: file }) },
        1 => handle read_file(lines, read) { Result::Err(error) => Result::Err(error), Result::Ok(file) => Result::Ok(Key { family: Family::LineIndex, file: file }) },
        2 => handle read_file(lexical, read) { Result::Err(error) => Result::Err(error), Result::Ok(file) => Result::Ok(Key { family: Family::Lex, file: file }) },
        _ => Result::Err(Failure::Invariant),
    }
}
fn replay_input<W>(core: &mut database::Database<W, Product>, sources: &database::Family<FileKey>, session: database::Session,
    frame: &mut Frame, read: query::ReadIdentity) -> Result<Step, Failure> where W: World {
    handle read_file(sources, read) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(file) => handle input_fingerprint(& *core, session, file) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(fingerprint) => handle charge(&mut *core, session, 1) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => handle observe(core, frame.ticket, read, fingerprint) {
                    Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(Step::Continue),
                },
            },
        },
    }
}
fn replay<W>(core: &mut database::Database<W, Product>, sources: &database::Family<FileKey>, lines: &database::Family<FileKey>, lexical: &database::Family<FileKey>,
    session: database::Session, frame: &mut Frame, read: query::ReadIdentity) -> Result<Step, Failure> where W: World {
    handle query::projection(read) {
        1 => replay_input(core, sources, session, frame, read),
        0 => handle read_key(sources, lines, lexical, read) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(key) => { (*frame).phase = Phase::AwaitReplay; Result::Ok(Step::Child(key)) },
        },
        _ => Result::Err(Failure::Invariant),
    }
}
fn computed(frame: &mut Frame, key: engine::Key) -> Result<Step, Failure> {
    handle query::same(database::key_identity(frame.interned), engine::key_identity(key)) {
        false => Result::Err(Failure::Invariant),
        true => handle frame.key.family { Family::SourceBytes => next(frame, Phase::SourceInput), Family::LineIndex => next(frame, Phase::NeedSource), Family::Lex => next(frame, Phase::NeedSource) },
    }
}
fn checked_outcome<W>(core: &database::Database<W, Product>, session: database::Session, frame: &Frame, outcome: engine::Outcome) -> Result<Step, Failure> {
    handle product(core, session, outcome) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(kind) => handle frame.key.family {
            Family::SourceBytes => handle kind { ProductKind::Source(_) => Result::Ok(Step::Done(outcome)), _ => Result::Err(Failure::Invariant) },
            Family::LineIndex => handle kind { ProductKind::Lines(_) => Result::Ok(Step::Done(outcome)), _ => Result::Err(Failure::Invariant) },
            Family::Lex => handle kind { ProductKind::Lexical(_) => Result::Ok(Step::Done(outcome)), _ => Result::Err(Failure::Invariant) },
        },
    }
}
fn engine_step<W>(core: &mut database::Database<W, Product>, sources: &database::Family<FileKey>, lines: &database::Family<FileKey>, lexical: &database::Family<FileKey>,
    session: database::Session, frame: &mut Frame) -> Result<Step, Failure> where W: World {
    handle database::step(&mut *core, frame.ticket) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(event) => handle event {
            engine::Event::Continue => Result::Ok(Step::Continue), engine::Event::Waiting => Result::Ok(Step::Waiting),
            engine::Event::Compute { key } => computed(frame, key),
            engine::Event::Read(read) => replay(core, sources, lines, lexical, session, frame, read.identity),
            engine::Event::Ready(outcome) => checked_outcome(& *core, session, & *frame, outcome),
            engine::Event::Reuse { product: _ } => Result::Err(Failure::Invariant),
        },
    }
}
fn begin_lines<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, owner: Handle, stores: &Stores, session: database::Session,
    frame: &mut Frame, outcome: engine::Outcome, limit: usize) -> Result<Step, Failure> {
    handle blob(& *core, stores, session, outcome) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => {
            let reserved = handle limit == 0 {
                true => Result::Ok(()), false => reserve_phase(&mut *core, owners, owner, session, &mut *frame, source::initial_line_memory()),
            };
            handle reserved {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle database::request_controls(core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(controls) => handle source::begin_lines(value, limit, controls) {
                Result::Err(error) => Result::Err(Failure::Source(error)),
                Result::Ok(builder) => { (*frame).builder = Result::Ok(builder); next(frame, Phase::Lines) },
            },
            },
            }
        },
    }
}
fn line_algorithm(builder: &mut source::LineBuilder, value: &source::Blob, controls: &mut operation::Controls) -> Result<Option<source::LineIndex>, Failure> {
    handle source::step_lines(&mut *builder, value, &mut *controls) {
        Result::Err(error) => Result::Err(Failure::Source(error)),
        Result::Ok(event) => handle event {
            source::Event::Continue => Result::Ok(None),
            source::Event::Ready => handle source::finish_lines(builder, & *controls) {
                Result::Err(error) => Result::Err(Failure::Source(error)), Result::Ok(value) => Result::Ok(Result::Ok(value)),
            },
        },
    }
}
fn line_work<W>(core: &mut database::Database<W, Product>, stores: &Stores, session: database::Session,
    frame: &mut Frame, outcome: engine::Outcome) -> Result<Option<source::LineIndex>, Failure> {
    handle blob(& *core, stores, session, outcome) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => handle database::request_controls(core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(controls) => handle Result::as_mut(&mut frame.builder) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(builder) => line_algorithm(builder, value, controls),
            },
        },
    }
}
fn line_memory<W>(core: &database::Database<W, Product>, stores: &Stores, session: database::Session,
    frame: &Frame, outcome: engine::Outcome) -> u64 {
    handle blob(core, stores, session, outcome) {
        Result::Err(_) => 0,
        Result::Ok(value) => handle Result::as_ref(&frame.builder) {
            Result::Err(_) => 0,
            Result::Ok(builder) => handle source::next_line_memory(builder, value) {
                Result::Err(_) => 0, Result::Ok(amount) => amount,
            },
        },
    }
}
fn lines_step<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, owner: Handle, stores: &mut Stores, session: database::Session,
    frame: &mut Frame, outcome: engine::Outcome) -> Result<Step, Failure> {
    let amount = line_memory(& *core, & *stores, session, & *frame, outcome);
    let reserved = handle amount == 0 {
        true => Result::Ok(()), false => reserve_phase(&mut *core, &mut *owners, owner, session, &mut *frame, amount),
    };
    handle reserved {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => lines_reserved(core, owners, stores, session, frame, outcome),
    }
}
fn lines_reserved<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, stores: &mut Stores, session: database::Session,
    frame: &mut Frame, outcome: engine::Outcome) -> Result<Step, Failure> {
    handle line_work(&mut *core, & *stores, session, &mut *frame, outcome) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(ready) => handle ready {
            Result::Err(_) => Result::Ok(Step::Continue),
            Result::Ok(value) => {
                (*frame).builder = None;
                handle publish_lines(core, owners, stores, &mut *frame, value) {
                    Result::Err(error) => Result::Err(error), Result::Ok(_) => next(frame, Phase::Engine),
                }
            },
        },
    }
}
fn begin_lex<W>(core: &mut database::Database<W, Product>, stores: &Stores, session: database::Session,
    frame: &mut Frame, outcome: engine::Outcome, limit: usize) -> Result<Step, Failure> {
    handle blob(& *core, stores, session, outcome) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => handle database::request_controls(core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(controls) => handle source::lex::begin(value, limit, controls) {
                Result::Err(error) => Result::Err(Failure::Source(error)),
                Result::Ok(builder) => { (*frame).lexer = Result::Ok(builder); next(frame, Phase::Lex) },
            },
        },
    }
}
fn lex_memory(frame: &Frame) -> Result<u64, Failure> {
    handle Result::as_ref(&frame.lexer) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(builder) => handle source::lex::next_memory(builder) {
            Result::Err(error) => Result::Err(Failure::Source(error)), Result::Ok(amount) => Result::Ok(amount),
        },
    }
}
fn lex_algorithm(builder: &mut source::lex::Builder, value: &source::Blob, controls: &mut operation::Controls)
    -> Result<Option<source::lex::LexedFile>, Failure> {
    handle source::lex::step(&mut *builder, value, &mut *controls) {
        Result::Err(error) => Result::Err(Failure::Source(error)),
        Result::Ok(event) => handle event {
            source::Event::Continue => Result::Ok(None),
            source::Event::Ready => handle source::lex::finish(builder, & *controls) {
                Result::Err(error) => Result::Err(Failure::Source(error)), Result::Ok(value) => Result::Ok(Result::Ok(value)),
            },
        },
    }
}
fn lex_work<W>(core: &mut database::Database<W, Product>, stores: &Stores, session: database::Session,
    frame: &mut Frame, outcome: engine::Outcome) -> Result<Option<source::lex::LexedFile>, Failure> {
    handle blob(& *core, stores, session, outcome) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(value) => handle database::request_controls(core, session) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(controls) => handle Result::as_mut(&mut frame.lexer) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(builder) => lex_algorithm(builder, value, controls),
            },
        },
    }
}
fn lex_reserved<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, stores: &mut Stores, session: database::Session,
    frame: &mut Frame, outcome: engine::Outcome) -> Result<Step, Failure> {
    handle lex_work(&mut *core, & *stores, session, &mut *frame, outcome) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(ready) => handle ready {
            Result::Err(_) => Result::Ok(Step::Continue),
            Result::Ok(value) => {
                (*frame).lexer = None;
                handle publish_lex(core, owners, stores, &mut *frame, value) {
                    Result::Err(error) => Result::Err(error), Result::Ok(_) => next(frame, Phase::Engine),
                }
            },
        },
    }
}
fn lex_step<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, owner: Handle, stores: &mut Stores, session: database::Session,
    frame: &mut Frame, outcome: engine::Outcome) -> Result<Step, Failure> {
    handle lex_memory(& *frame) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(amount) => {
            let reserved = handle amount == 0 {
                true => Result::Ok(()), false => reserve_phase(&mut *core, &mut *owners, owner, session, &mut *frame, amount),
            };
            handle reserved { Result::Err(error) => Result::Err(error), Result::Ok(_) => lex_reserved(core, owners, stores, session, frame, outcome) }
        },
    }
}
fn advance<W>(core: &mut database::Database<W, Product>, sources: &database::Family<FileKey>, lines: &database::Family<FileKey>, lexical: &database::Family<FileKey>,
    stores: &mut Stores, owners: &mut ResourceOwners, owner: Handle, session: database::Session, frame: &mut Frame, limits: Limits) -> Result<Step, Failure> where W: World {
    handle frame.phase {
        Phase::Engine => engine_step(core, sources, lines, lexical, session, frame),
        Phase::SourceInput => source_input(core, owners, owner, stores, session, frame, limits),
        Phase::SourceCopy => source_copy_step(core, owners, stores, session, frame),
        Phase::NeedSource => {
            (*frame).phase = Phase::AwaitSource;
            Result::Ok(Step::Child(Key { family: Family::SourceBytes, file: frame.key.file }))
        },
        Phase::BeginLines => handle frame.source {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(outcome) => begin_lines(core, owners, owner, & *stores, session, frame, outcome, limits.lines),
        },
        Phase::Lines => handle frame.source {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(outcome) => lines_step(core, owners, owner, stores, session, frame, outcome),
        },
        Phase::BeginLex => handle frame.source {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(outcome) => begin_lex(core, & *stores, session, frame, outcome, limits.tokens),
        },
        Phase::Lex => handle frame.source {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(outcome) => lex_step(core, owners, owner, stores, session, frame, outcome),
        },
        _ => Result::Err(Failure::Invariant),
    }
}

fn cleanup<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, driver: &mut Driver) -> Bool {
    handle Vec::pop(&mut driver.frames) {
        Result::Err(_) => true,
        Result::Ok(frame) => {
            frame.copier = None;
            frame.builder = None;
            frame.lexer = None;
            handle release_phase(owners, &mut frame.memory) {
                Result::Err(_) => { Vec::push(&mut driver.frames, frame); false },
                Result::Ok(_) => { database::abort(core, frame.ticket); Vec::is_empty(&driver.frames) },
            }
        },
    }
}
fn failed(driver: &mut Driver, error: Failure) -> Result<Step, Failure> {
    (*driver).mode = Mode::Failed(error);
    Result::Ok(Step::Continue)
}
fn child<W>(core: &mut database::Database<W, Product>, sources: &mut database::Family<FileKey>, lines: &mut database::Family<FileKey>, lexical: &mut database::Family<FileKey>,
    session: database::Session, driver: &mut Driver, parent: engine::Ticket, key: Key, limit: usize) -> Result<Step, Failure> {
    handle Vec::len(&driver.frames) < limit {
        false => failed(driver, Failure::Capacity),
        true => handle frame(core, sources, lines, lexical, session, key, Result::Ok(parent)) {
            Result::Err(error) => failed(driver, error),
            Result::Ok(frame) => { Vec::push(&mut driver.frames, frame); Result::Ok(Step::Continue) },
        },
    }
}
fn delivered(driver: &mut Driver, outcome: engine::Outcome) -> Result<Step, Failure> {
    Vec::pop(&mut driver.frames);
    handle Vec::len(&driver.frames) {
        0 => Result::Ok(Step::Done(outcome)),
        length => handle Vec::get_mut(&mut driver.frames, length - 1) {
            Result::Err(_) => failed(driver, Failure::Invariant),
            Result::Ok(parent) => handle parent.phase {
                Phase::AwaitReplay => next(parent, Phase::Engine),
                Phase::AwaitSource => {
                    (*parent).source = Result::Ok(outcome);
                    handle parent.key.family { Family::LineIndex => next(parent, Phase::BeginLines), Family::Lex => next(parent, Phase::BeginLex), _ => Result::Err(Failure::Invariant) }
                },
                _ => Result::Err(Failure::Invariant),
            },
        },
    }
}
fn advanced<W>(core: &mut database::Database<W, Product>, sources: &mut database::Family<FileKey>, lines: &mut database::Family<FileKey>, lexical: &mut database::Family<FileKey>,
    session: database::Session, driver: &mut Driver, parent: engine::Ticket, result: Result<Step, Failure>, limit: usize) -> Result<Step, Failure> {
    handle result {
        Result::Err(error) => failed(driver, error),
        Result::Ok(event) => handle event {
            Step::Child(key) => child(core, sources, lines, lexical, session, driver, parent, key, limit),
            Step::Done(outcome) => delivered(driver, outcome), other => Result::Ok(other),
        },
    }
}
fn running<W>(core: &mut database::Database<W, Product>, sources: &mut database::Family<FileKey>, lines: &mut database::Family<FileKey>, lexical: &mut database::Family<FileKey>,
    stores: &mut Stores, owners: &mut ResourceOwners, owner: Handle, session: database::Session, driver: &mut Driver, limits: Limits) -> Result<Step, Failure> where W: World {
    handle Vec::len(&driver.frames) {
        0 => Result::Err(Failure::Invariant),
        length => handle Vec::get_mut(&mut driver.frames, length - 1) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(frame) => {
                let ticket = frame.ticket;
                let result = advance(&mut *core, & *sources, & *lines, & *lexical, stores, owners, owner, session, frame, limits);
                advanced(core, sources, lines, lexical, session, driver, ticket, result, limits.frames)
            },
        },
    }
}
fn tick<W>(core: &mut database::Database<W, Product>, sources: &mut database::Family<FileKey>, lines: &mut database::Family<FileKey>, lexical: &mut database::Family<FileKey>,
    stores: &mut Stores, owners: &mut ResourceOwners, requests: &Arena<Request>, driver: &mut Driver, limits: Limits) -> Result<Step, Failure> where W: World {
    handle driver.mode {
        Mode::Failed(_) => handle cleanup(core, owners, &mut *driver) {
            false => Result::Ok(Step::Continue),
            true => handle driver.mode {
                Mode::Failed(_) => Result::Err(Clone::clone(&driver.mode.0)),
                Mode::Running => Result::Err(Failure::Invariant),
            },
        },
        Mode::Running => handle active(requests, driver.session) {
            Result::Err(error) => failed(driver, error),
            Result::Ok(session) => handle database::check(& *core, session) {
                Result::Err(error) => failed(driver, Failure::Database(error)),
                Result::Ok(_) => handle request_resource(requests, driver.session) {
                    Result::Err(error) => failed(driver, error),
                    Result::Ok(owner) => {
                    let result = running(core, sources, lines, lexical, stores, owners, owner, session, &mut *driver, limits);
                    handle result { Result::Err(error) => failed(driver, error), other => other }
                    },
                },
            },
        },
    }
}
fn poll_checked<T, W>(registry: &mut Registry<W>, query: Query<T>) -> Result<Step, Failure> where W: World {
    handle storage::get_mut(&mut registry.drivers, query.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(driver) => tick(&mut registry.core, &mut registry.sources, &mut registry.lines, &mut registry.lexical, &mut registry.stores,
            &mut registry.resource_owners, &registry.requests, driver, registry.limits),
    }
}
fn poll_result<T, W>(registry: &mut Registry<W>, query: Query<T>, result: Result<Step, Failure>) -> Result<Event<T>, Failure> {
    handle result {
        Result::Err(error) => { storage::remove(&mut registry.drivers, query.handle); Result::Err(error) },
        Result::Ok(event) => handle event {
            Step::Continue => Result::Ok(Event::Continue), Step::Waiting => Result::Ok(Event::Waiting),
            Step::Done(outcome) => {
                storage::remove(&mut registry.drivers, query.handle);
                Result::Ok(Event::Ready(Value { outcome: outcome }))
            },
            Step::Child(_) => Result::Err(Failure::Invariant),
        },
    }
}
pub fn poll<T, W>(registry: &mut Registry<W>, query: Query<T>) -> Result<Event<T>, Failure> where W: World {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => {
            let result = poll_checked(&mut *registry, query);
            poll_result(registry, query, result)
        },
    }
}
pub fn abort<T, W>(registry: &mut Registry<W>, query: Query<T>) -> Result<(), Failure> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle storage::get_mut(&mut registry.drivers, query.handle) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(driver) => { (*driver).mode = Mode::Failed(Failure::Cancelled); Result::Ok(()) },
        },
    }
}
pub fn cancel<W>(registry: &mut Registry<W>, session: Session) -> Result<(), Failure> {
    handle storage::get(&registry.requests, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => handle database::cancel(&mut registry.core, request.core) {
            Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}

// Closing owns cleanup even when the caller has discarded every Query handle.
// A step visits one driver slot or discards one provider frame. Only after all
// attempts are gone may the core session release its revision pin.
pub fn begin_close<W>(registry: &mut Registry<W>, session: Session) -> Result<(), Failure> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle storage::get_mut(&mut registry.requests, session.handle) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(request) => handle request.phase {
                SessionPhase::Closing { cursor: _ } => Result::Ok(()),
                SessionPhase::Active => handle database::cancel(&mut registry.core, request.core) {
                    Result::Err(error) => Result::Err(Failure::Database(error)),
                    Result::Ok(_) => { (*request).phase = SessionPhase::Closing { cursor: 0 }; Result::Ok(()) },
                },
            },
        },
    }
}
fn closing(requests: &Arena<Request>, session: Session) -> Result<(database::Session, usize), Failure> {
    handle storage::get(requests, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => handle request.phase {
            SessionPhase::Active => Result::Err(Failure::Busy), SessionPhase::Closing { cursor } => Result::Ok((request.core, cursor)),
        },
    }
}
fn close_next(requests: &mut Arena<Request>, session: Session, cursor: usize) -> Result<CloseStep, Failure> {
    handle storage::get_mut(requests, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => { (*request).phase = SessionPhase::Closing { cursor: cursor }; Result::Ok(CloseStep::Continue) },
    }
}
fn close_driver<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, drivers: &mut Arena<Driver>, key: Handle, session: Session) -> Bool {
    handle storage::get_mut(drivers, key) {
        Result::Err(_) => true,
        Result::Ok(driver) => handle storage::equal(driver.session.handle, session.handle) { false => true, true => cleanup(core, owners, driver) },
    }
}
fn belongs(drivers: &Arena<Driver>, key: Handle, session: Session) -> Bool {
    handle storage::get(drivers, key) { Result::Err(_) => false, Result::Ok(driver) => storage::equal(driver.session.handle, session.handle) }
}
fn close_slot<W>(registry: &mut Registry<W>, session: Session, cursor: usize, key: Handle) -> Result<CloseStep, Failure> {
    handle belongs(&registry.drivers, key, session) {
        false => close_next(&mut registry.requests, session, cursor + 1),
        true => handle close_driver(&mut registry.core, &mut registry.resource_owners, &mut registry.drivers, key, session) {
            false => Result::Ok(CloseStep::Continue),
            true => { storage::remove(&mut registry.drivers, key); close_next(&mut registry.requests, session, cursor + 1) },
        },
    }
}
fn close_scan<W>(registry: &mut Registry<W>, session: Session, core: database::Session, cursor: usize) -> Result<CloseStep, Failure> {
    handle cursor == storage::slot_count(&registry.drivers) {
        true => finish_close(registry, session, core),
        false => handle storage::key_at(&registry.drivers, cursor) {
            Result::Err(_) => close_next(&mut registry.requests, session, cursor + 1),
            Result::Ok(key) => close_slot(registry, session, cursor, key),
        },
    }
}
fn close_resources<W>(core: &mut database::Database<W, Product>, requests: &mut Arena<Request>, owners: &mut Arena<Resources>, session: Session) -> Result<Bool, Failure> {
    handle storage::get_mut(requests, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => handle storage::get_mut(owners, request.resources) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(resources) => handle close_resource_delta(resources) {
            Result::Err(error) => Result::Err(error),
            Result::Ok((done, released)) => handle database::release_memory(core, request.core, released) {
                Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(done),
            },
            },
        },
    }
}
fn close_resource_delta(resources: &mut Resources) -> Result<(Bool, u64), Failure> {
    handle budget::spent(&resources.pool, resources.root) {
        Result::Err(error) => Result::Err(Failure::Budget(error)),
        Result::Ok(before) => handle budget::close_step(&mut resources.pool) {
            Result::Err(error) => Result::Err(Failure::Budget(error)),
            Result::Ok(done) => handle budget::spent(&resources.pool, resources.root) {
                Result::Err(error) => Result::Err(Failure::Budget(error)),
                Result::Ok(after) => Result::Ok((done, wrapping_sub(before, after))),
            },
        },
    }
}
fn close_resource_owner<W>(registry: &mut Registry<W>, session: Session) -> Result<(), Failure> {
    handle request_resource(&registry.requests, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(owner) => {
            let retained = handle storage::get(&registry.resource_owners.values, owner) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(resources) => Result::Ok(budget::retained_reservations(&resources.pool)),
            };
            handle retained {
                Result::Err(error) => Result::Err(error),
                Result::Ok(0) => { storage::remove(&mut registry.resource_owners.values, owner); Result::Ok(()) },
                Result::Ok(_) => handle storage::get_mut(&mut registry.resource_owners.values, owner) {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(resources) => {
                        (*resources).closed = true;
                        (*registry).resource_owners.closed = registry.resource_owners.closed + 1;
                        Result::Ok(())
                    },
                },
            }
        },
    }
}
fn finish_close<W>(registry: &mut Registry<W>, session: Session, core: database::Session) -> Result<CloseStep, Failure> {
    handle close_resources(&mut registry.core, &mut registry.requests, &mut registry.resource_owners.values, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(done) => handle done {
            false => Result::Ok(CloseStep::Continue),
            true => handle database::close(&mut registry.core, core) {
                Result::Err(error) => Result::Err(Failure::Database(error)),
                Result::Ok(_) => handle close_resource_owner(&mut *registry, session) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(_) => { storage::remove(&mut registry.requests, session.handle); Result::Ok(CloseStep::Done) },
                },
            },
        },
    }
}
pub fn close_step<W>(registry: &mut Registry<W>, session: Session) -> Result<CloseStep, Failure> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle closing(&registry.requests, session) {
            Result::Err(error) => Result::Err(error), Result::Ok((core, cursor)) => close_scan(registry, session, core, cursor),
        },
    }
}

pub fn retire<W>(registry: &mut Registry<W>, revision: RevisionId) -> Result<(), Failure> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle database::retire(&mut registry.core, revision) {
            Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}
pub fn collect<W>(registry: &mut Registry<W>) -> Result<(), Failure> {
    handle available(& *registry) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle database::collect(&mut registry.core) {
            Result::Err(error) => Result::Err(Failure::Database(error)),
            Result::Ok(_) => { (*registry).collection = Collection::Core; Result::Ok(()) },
        },
    }
}
fn remove_product(stores: &mut Stores, product: ProductKind) -> Result<Option<PhaseReservation>, Failure> {
    handle product {
        ProductKind::Source(key) => unstage(&mut stores.sources, key),
        ProductKind::Lines(key) => unstage(&mut stores.lines, key),
        ProductKind::Lexical(key) => unstage(&mut stores.lexical, key),
    }
}
fn remove_released(stores: &mut Stores, disposal: &mut Disposal) -> Result<Bool, Failure> {
    handle database::released_value(&disposal.token) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(product) => handle remove_product(stores, product.kind) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(phase) => {
                (*disposal).phase = phase;
                (*disposal).removed = true;
                Result::Ok(false)
            },
        },
    }
}
fn dispose<W>(core: &mut database::Database<W, Product>, owners: &mut ResourceOwners, stores: &mut Stores, disposal: &mut Disposal) -> Result<Bool, Failure> {
    handle disposal.removed {
        false => remove_released(stores, disposal),
        true => handle release_phase(owners, &mut disposal.phase) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle database::finish_release(core, &mut disposal.token) {
            Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(Result<(), ()>::Ok(())),
            },
        },
    }
}
fn collection<W>(registry: &mut Registry<W>) -> Result<CollectionStep, Failure> where W: Use<[0, 1]> {
    handle database::collect_step_with_products(&mut registry.core) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(event) => handle event {
            database::ProductCollectionStep::Continue => Result::Ok(CollectionStep::Continue),
            database::ProductCollectionStep::Done(report) => collect_next(registry, Collection::BeginRoots { report: report }),
            database::ProductCollectionStep::Release(token) => {
                (*registry).disposal = Result::Ok(Disposal { token: token, removed: false, phase: None });
                Result::Ok(CollectionStep::Continue)
            },
        },
    }
}
fn collect_products<W>(registry: &mut Registry<W>) -> Result<CollectionStep, Failure> where W: Use<[0, 1]> {
    handle Result::as_mut(&mut registry.disposal) {
        Result::Err(_) => collection(registry),
        Result::Ok(disposal) => handle dispose(&mut registry.core, &mut registry.resource_owners, &mut registry.stores, disposal) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(done) => handle done {
                false => Result::Ok(CollectionStep::Continue),
                true => { (*registry).disposal = None; Result::Ok(CollectionStep::Continue) },
            },
        },
    }
}

fn collect_next<W>(registry: &mut Registry<W>, phase: Collection) -> Result<CollectionStep, Failure> {
    (*registry).collection = phase;
    Result::Ok(CollectionStep::Continue)
}
fn begin_roots<W>(registry: &mut Registry<W>, report: database::Collected) -> Result<CollectionStep, Failure> {
    handle database::key_roots(&registry.core) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(cursor) => collect_next(registry, Collection::Roots { cursor: cursor, report: report }),
    }
}
fn mark_root<W>(registry: &mut Registry<W>, identity: query::ReadIdentity) -> Result<(), Failure> {
    handle query::family(identity) {
        0 => mark_key(&mut registry.sources, identity),
        1 => mark_key(&mut registry.lines, identity),
        2 => mark_key(&mut registry.lexical, identity),
        _ => Result::Err(Failure::Invariant),
    }
}
fn mark_key(family: &mut database::Family<FileKey>, identity: query::ReadIdentity) -> Result<(), Failure> {
    handle database::mark_key(family, identity) {
        Result::Err(error) => Result::Err(Failure::Database(error)), Result::Ok(_) => Result::Ok(()),
    }
}
fn collect_roots<W>(registry: &mut Registry<W>, cursor: engine::RootCursor, report: database::Collected) -> Result<CollectionStep, Failure> {
    handle database::key_root_step(&registry.core, cursor) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(step) => handle step {
            engine::RootStep::Done => collect_next(registry, Collection::SourceKeys { cursor: 0, report: report }),
            engine::RootStep::Continue(next) => collect_next(registry, Collection::Roots { cursor: next, report: report }),
            engine::RootStep::Key { identity, next } => handle mark_root(&mut *registry, identity) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => collect_next(registry, Collection::Roots { cursor: next, report: report }),
            },
        },
    }
}
fn collect_source_keys<W>(registry: &mut Registry<W>, cursor: usize, report: database::Collected) -> Result<CollectionStep, Failure> {
    handle database::sweep_key_step(&mut registry.sources, cursor) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(step) => handle step {
            database::KeySweepStep::Done => collect_next(registry, Collection::LineKeys { cursor: 0, report: report }),
            database::KeySweepStep::Continue { next } => collect_next(registry, Collection::SourceKeys { cursor: next, report: report }),
        },
    }
}
fn collect_line_keys<W>(registry: &mut Registry<W>, cursor: usize, report: database::Collected) -> Result<CollectionStep, Failure> {
    handle database::sweep_key_step(&mut registry.lines, cursor) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(step) => handle step {
            database::KeySweepStep::Done => collect_next(registry, Collection::LexKeys { cursor: 0, report: report }),
            database::KeySweepStep::Continue { next } => collect_next(registry, Collection::LineKeys { cursor: next, report: report }),
        },
    }
}
fn collect_lex_keys<W>(registry: &mut Registry<W>, cursor: usize, report: database::Collected) -> Result<CollectionStep, Failure> {
    handle database::sweep_key_step(&mut registry.lexical, cursor) {
        Result::Err(error) => Result::Err(Failure::Database(error)),
        Result::Ok(step) => handle step {
            database::KeySweepStep::Done => { (*registry).collection = Collection::Idle; Result::Ok(CollectionStep::Done(report)) },
            database::KeySweepStep::Continue { next } => collect_next(registry, Collection::LexKeys { cursor: next, report: report }),
        },
    }
}
pub fn collect_step<W>(registry: &mut Registry<W>) -> Result<CollectionStep, Failure> where W: Use<[0, 1]> {
    handle registry.collection {
        Collection::Idle => Result::Err(Failure::Invariant),
        Collection::Core => collect_products(registry),
        Collection::BeginRoots { report } => begin_roots(registry, report),
        Collection::Roots { cursor, report } => collect_roots(registry, cursor, report),
        Collection::SourceKeys { cursor, report } => collect_source_keys(registry, cursor, report),
        Collection::LineKeys { cursor, report } => collect_line_keys(registry, cursor, report),
        Collection::LexKeys { cursor, report } => collect_lex_keys(registry, cursor, report),
    }
}
