use std::*;
use super::operation;
use super::order;

// String payload adapter over the shared index scheduler. Every lexical
// comparison is byte-stepped; extraction moves each owned string once.
pub struct Builder { private work: Option<Work>, private limit: usize }
pub impl Use<[0, 1]> for Builder {}
pub struct Sorted { private values: Vec<Option<String>> }
pub impl Use<[0, 1]> for Sorted {}
pub enum Event { Continue, Ready }
pub enum Failure { Control(operation::Failure), Capacity { actual: usize, limit: usize }, Closed, Busy, Invariant }
struct Work {
    count: usize, input: Vec<String>, slots: Vec<Option<String>>, sorter: order::Builder,
    indices: Vec<usize>, output: Vec<Option<String>>, comparison: Option<Comparison>, cursor: usize, phase: Phase,
}
struct Comparison { left: usize, right: usize, cursor: usize }
enum Phase { Gather, Reverse, Sort, Output, Ready }
pub fn begin(input: Vec<String>, limit: usize) -> Builder {
    let count = Vec::len(&input);
    Builder { work: Result::Ok(Work { count: count, input: input, slots: Vec<Option<String>>::new(),
        sorter: order::begin(count, limit), indices: Vec<usize>::new(), output: Vec<Option<String>>::new(),
        comparison: None, cursor: 0, phase: Phase::Gather }), limit: limit }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
// Extent is stable after extraction; a taken slot becomes a hole. Consumers
// can advance in sorted order without repeated front removal or cloning.
pub fn extent(value: &Sorted) -> usize { Vec::len(&value.values) }
pub fn take(value: &mut Sorted, index: usize) -> Option<String> {
    handle Vec::get_mut(&mut value.values, index) { Result::Err(_) => None, Result::Ok(slot) => Option::take(slot) }
}
fn order_error(error: order::Failure) -> Failure {
    handle error {
        order::Failure::Control(error) => Failure::Control(error),
        order::Failure::Capacity { actual: actual, limit: limit } => Failure::Capacity { actual: actual, limit: limit },
        _ => Failure::Invariant,
    }
}
fn compare(work: &Work, state: &Comparison) -> Result<Option<Ordering>, Failure> {
    handle Result::as_ref(Vec::get_unchecked(&work.slots, state.left)) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(left) => handle Result::as_ref(Vec::get_unchecked(&work.slots, state.right)) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(right) => {
                let a = String::as_str(left);
                let b = String::as_str(right);
                Result::Ok(order::byte_order(a, b, state.cursor))
            },
        },
    }
}
fn sort_step(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle Option::take(&mut work.comparison) {
        Result::Ok(state) => handle compare(& *work, &state) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(answer) => handle answer {
                Result::Err(_) => {
                    (*work).comparison = Result::Ok(Comparison { left: state.left, right: state.right, cursor: state.cursor + 1 });
                    Result::Ok(Event::Continue)
                },
                Result::Ok(answer) => handle order::compared(&mut work.sorter, controls, answer) {
                    Result::Err(error) => Result::Err(order_error(error)),
                    Result::Ok(_) => Result::Ok(Event::Continue),
                },
            },
        },
        Result::Err(_) => handle order::step(&mut work.sorter, &mut *controls) {
            Result::Err(error) => Result::Err(order_error(error)),
            Result::Ok(event) => handle event {
                order::Event::Continue => Result::Ok(Event::Continue),
                order::Event::Compare { left: left, right: right } => {
                    (*work).comparison = Result::Ok(Comparison { left: left, right: right, cursor: 0 });
                    Result::Ok(Event::Continue)
                },
                order::Event::Ready => handle order::finish(&mut work.sorter, & *controls) {
                    Result::Err(error) => Result::Err(order_error(error)),
                    Result::Ok(indices) => {
                        (*work).indices = indices; (*work).cursor = as<usize>(0); (*work).phase = Phase::Output;
                        Result::Ok(Event::Continue)
                    },
                },
            },
        },
    }
}
fn output_step(work: &mut Work) -> Result<Event, Failure> {
    handle work.cursor == work.count {
        true => { (*work).phase = Phase::Ready; Result::Ok(Event::Ready) },
        false => {
            let index = *Vec::get_unchecked(&work.indices, work.cursor);
            handle Vec::get_mut(&mut work.slots, index) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(slot) => handle Option::take(slot) {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(value) => { Vec::push(&mut work.output, Result::Ok(value)); (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
                },
            }
        },
    }
}
fn transition(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle work.phase {
        Phase::Gather => handle Vec::pop(&mut work.input) {
            Result::Ok(value) => { Vec::push(&mut work.slots, Result::Ok(value)); Result::Ok(Event::Continue) },
            Result::Err(_) => { (*work).phase = Phase::Reverse; Result::Ok(Event::Continue) },
        },
        Phase::Reverse => handle work.cursor < work.count / 2 {
            true => {
                let end = work.count - 1 - work.cursor;
                Vec::swap(&mut work.slots, work.cursor, end); (*work).cursor = work.cursor + 1;
                Result::Ok(Event::Continue)
            },
            false => { (*work).phase = Phase::Sort; Result::Ok(Event::Continue) },
        },
        Phase::Sort => sort_step(work, controls),
        Phase::Output => output_step(work),
        Phase::Ready => Result::Ok(Event::Ready),
    }
}
fn checked(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle operation::charge(&mut *controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.count > builder.limit {
                true => Result::Err(Failure::Capacity { actual: work.count, limit: builder.limit }),
                false => transition(work, controls),
            },
        },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = checked(&mut *builder, controls);
    handle result { Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<Sorted, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase { Phase::Ready => Result::Ok(Sorted { values: work.output }), _ => Result::Err(Failure::Busy) },
        },
    }
}
