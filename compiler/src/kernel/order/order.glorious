use std::*;
use super::operation;

// Stable bottom-up mergesort of indices, with a suspended comparison protocol.
// Payload owners compare their actual values; no payload is cloned or moved
// by this scheduler. Comparisons themselves can be stepped by the caller.
pub struct Builder { private work: Option<Work>, private limit: usize }
pub impl Use<[0, 1]> for Builder {}
pub enum Event { Continue, Compare { left: usize, right: usize }, Ready }
pub enum Failure { Control(operation::Failure), Capacity { actual: usize, limit: usize }, Closed, Busy, Invariant }
struct Work {
    count: usize, order: Vec<usize>, scratch: Vec<usize>, width: usize,
    start: usize, middle: usize, end: usize, left: usize, right: usize,
    output: usize, phase: Phase,
}
enum Phase { Seed, Merge, Compare, Pass, Ready }

pub fn begin(count: usize, limit: usize) -> Builder {
    Builder { work: Result::Ok(Work { count: count, order: Vec<usize>::new(), scratch: Vec<usize>::new(),
        width: 1, start: 0, middle: 0, end: 0, left: 0, right: 0, output: 0, phase: Phase::Seed }), limit: limit }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
// One lexical comparison quantum. None consumes one equal byte; a result
// decides the ordering (including equal strings). The caller owns the cursor
// and charges/checks its real controls before calling this fixed-size leaf.
pub fn byte_order(left: Str, right: Str, cursor: usize) -> Option<Ordering> {
    handle cursor < min(Str::len(left), Str::len(right)) {
        true => {
            let a = *Slice::get_unchecked(Str::as_bytes(left), cursor);
            let b = *Slice::get_unchecked(Str::as_bytes(right), cursor);
            handle Ord::compare(&a, &b) { Ordering::Equal => None, result => Result::Ok(result) }
        },
        false => {
            let a = Str::len(left);
            let b = Str::len(right);
            Result::Ok(Ord::compare(&a, &b))
        },
    }
}
fn set_run(work: &mut Work) -> () {
    // The subtractions precede additions, so arbitrary input counts cannot
    // overflow the run boundaries or the final doubling operation.
    (*work).middle = work.start + min(work.width, work.count - work.start);
    (*work).end = work.middle + min(work.width, work.count - work.middle);
    (*work).left = work.start;
    (*work).right = work.middle;
    (*work).output = work.start;
    (*work).phase = Phase::Merge;
}
fn write(work: &mut Work, selected: usize) -> Result<Event, Failure> {
    let index = *Vec::get_unchecked(&work.order, selected);
    handle Vec::get_mut(&mut work.scratch, work.output) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(slot) => {
            *slot = index;
            (*work).output = work.output + 1;
            (*work).phase = Phase::Merge;
            Result::Ok(Event::Continue)
        },
    }
}
fn left(work: &mut Work) -> Result<Event, Failure> {
    let selected = work.left;
    (*work).left = work.left + 1;
    write(work, selected)
}
fn right(work: &mut Work) -> Result<Event, Failure> {
    let selected = work.right;
    (*work).right = work.right + 1;
    write(work, selected)
}
fn comparison(work: &Work) -> Event {
    Event::Compare { left: *Vec::get_unchecked(&work.order, work.left), right: *Vec::get_unchecked(&work.order, work.right) }
}
fn merge(work: &mut Work) -> Result<Event, Failure> {
    handle work.output == work.end {
        true => {
            (*work).start = work.end;
            handle work.start == work.count {
                true => { (*work).phase = Phase::Pass; Result::Ok(Event::Continue) },
                false => { set_run(work); Result::Ok(Event::Continue) },
            }
        },
        false => handle work.left == work.middle {
            true => right(work),
            false => handle work.right == work.end {
                true => left(work),
                false => { (*work).phase = Phase::Compare; Result::Ok(comparison(& *work)) },
            },
        },
    }
}
fn transition(work: &mut Work) -> Result<Event, Failure> {
    handle work.phase {
        Phase::Seed => handle Vec::len(&work.order) == work.count {
            false => {
                let index = Vec::len(&work.order);
                Vec::push(&mut work.order, index);
                Vec::push(&mut work.scratch, as<usize>(0));
                Result::Ok(Event::Continue)
            },
            true => handle work.count < 2 {
                true => { (*work).phase = Phase::Ready; Result::Ok(Event::Ready) },
                false => { set_run(work); Result::Ok(Event::Continue) },
            },
        },
        Phase::Merge => merge(work),
        Phase::Compare => Result::Ok(comparison(& *work)),
        Phase::Pass => {
            swap(&mut work.order, &mut work.scratch);
            handle work.width >= work.count - work.width {
                true => { (*work).phase = Phase::Ready; Result::Ok(Event::Ready) },
                false => {
                    (*work).width = work.width + work.width;
                    (*work).start = as<usize>(0);
                    set_run(work);
                    Result::Ok(Event::Continue)
                },
            }
        },
        Phase::Ready => Result::Ok(Event::Ready),
    }
}
fn checked(builder: &mut Builder, controls: &mut operation::Controls, answer: Option<Ordering>) -> Result<Event, Failure> {
    handle operation::charge(controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.count > builder.limit {
                true => Result::Err(Failure::Capacity { actual: work.count, limit: builder.limit }),
                false => handle answer {
                    Result::Err(_) => transition(work),
                    Result::Ok(order) => handle work.phase {
                        Phase::Compare => handle order { Ordering::Greater => right(work), _ => left(work) },
                        _ => Result::Err(Failure::Busy),
                    },
                },
            },
        },
    }
}
fn advance(builder: &mut Builder, controls: &mut operation::Controls, answer: Option<Ordering>) -> Result<Event, Failure> {
    let result = checked(&mut *builder, controls, answer);
    handle result {
        Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> { advance(builder, controls, None) }
pub fn compared(builder: &mut Builder, controls: &mut operation::Controls, answer: Ordering) -> Result<Event, Failure> {
    advance(builder, controls, Result::Ok(answer))
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<Vec<usize>, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase { Phase::Ready => Result::Ok(work.order), _ => Result::Err(Failure::Busy) },
        },
    }
}
