use std::*;
use super::identity::Digest;
use super::identity::RevisionId;
use super::storage::Handle;
use super::operation;
use super::package;
use super::diagnostic;
use super::dependency;
use super::dependency::node::Node;

pub struct Limits { packages: package::Limits, dependencies: dependency::Limits,
    diagnostics: diagnostic::Limits, error_limit: Option<usize> }
pub enum Failure { Closed, Busy, Invariant, Control(operation::Failure), Package(package::Failure),
    Diagnostic(diagnostic::Failure), Dependency(dependency::Failure), Rejected(diagnostic::Batch) }
pub impl Clone for Failure {
    clone(value: &Failure) -> Failure {
        handle *value {
            Failure::Closed => Failure::Closed,
            Failure::Busy => Failure::Busy,
            Failure::Invariant => Failure::Invariant,
            Failure::Control(error) => Failure::Control(error),
            Failure::Package(_) => Failure::Package(Clone::clone(&value.0)),
            Failure::Diagnostic(error) => Failure::Diagnostic(error),
            Failure::Dependency(error) => Failure::Dependency(error),
            Failure::Rejected(_) => Failure::Rejected(Clone::clone(&value.0)),
        }
    }
}
pub enum Event { Continue, Validate(diagnostic::Span), Ready }
enum Phase { Unused, Recording, Packages, Diagnostics, Checking { cursor: usize }, Dependencies, Ready, Committed, Aborted }
pub struct Frame { private phase: Phase, private dependencies: Option<dependency::Transaction>,
    private diagnostics: Option<diagnostic::Builder>, private batch: Option<diagnostic::Batch> }
pub impl Use<[0, 1]> for Frame {}

pub fn create() -> Frame { Frame { phase: Phase::Unused, dependencies: None, diagnostics: None, batch: None } }
pub fn abort(frame: &mut Frame, packages: &mut package::Registry) -> () {
    handle frame.phase {
        Phase::Committed => (),
        Phase::Unused => package::rollback_all(packages),
        _ => { (*frame).phase = Phase::Aborted; (*frame).dependencies = None;
            (*frame).diagnostics = None; (*frame).batch = None; package::rollback_all(packages); },
    }
}
pub fn query_allowed(frame: &Frame) -> Result<(), Failure> {
    handle frame.phase { Phase::Unused => Result::Ok(()), Phase::Recording => Result::Ok(()),
        Phase::Committed => Result::Err(Failure::Closed), Phase::Aborted => Result::Err(Failure::Closed),
        _ => Result::Err(Failure::Busy) }
}
pub fn recording(frame: &Frame) -> Result<(), Failure> {
    handle frame.phase { Phase::Recording => Result::Ok(()), Phase::Unused => Result::Err(Failure::Closed),
        Phase::Committed => Result::Err(Failure::Closed), Phase::Aborted => Result::Err(Failure::Closed),
        _ => Result::Err(Failure::Busy) }
}
pub fn package_failed(frame: &mut Frame, packages: &mut package::Registry) -> () {
    // Legacy low-level query/package sessions have not claimed an execution.
    handle frame.phase { Phase::Unused => (), _ => abort(frame, packages) }
}
pub fn begin(frame: &mut Frame, ledger: &dependency::Ledger, packages: &mut package::Registry,
    controls: &mut operation::Controls, revision: RevisionId, parent: Option<RevisionId>,
    fingerprint: Digest, limits: Limits) -> Result<(), Failure> {
    handle frame.phase {
        Phase::Unused => begin_unused(frame, ledger, packages, controls, revision, parent, fingerprint, limits),
        _ => Result::Err(Failure::Closed),
    }
}
fn begin_unused(frame: &mut Frame, ledger: &dependency::Ledger, packages: &mut package::Registry,
    controls: &mut operation::Controls, revision: RevisionId, parent: Option<RevisionId>,
    fingerprint: Digest, limits: Limits) -> Result<(), Failure> {
    // Claim first: failure cannot be retried with fresh controls in this session.
    (*frame).phase = Phase::Aborted;
    handle operation::charge(controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle package::configure(packages, limits.packages) {
            Result::Err(error) => Result::Err(Failure::Package(error)),
            Result::Ok(_) => handle dependency::begin(ledger, revision, parent, limits.dependencies) {
                Result::Err(error) => Result::Err(Failure::Dependency(error)),
                Result::Ok(transaction) => {
                    (*frame).dependencies = Result::Ok(transaction);
                    (*frame).diagnostics = Result::Ok(diagnostic::begin(limits.diagnostics,
                        diagnostic::Policy { validate_spans: true, error_limit: limits.error_limit,
                            input_fingerprint: Result::Ok(fingerprint) }));
                    (*frame).phase = Phase::Recording; Result::Ok(())
                },
            },
        },
    }
}
pub fn record_dependency(frame: &mut Frame, controls: &mut operation::Controls, node: Node,
    fingerprint: Digest, edges: Vec<Node>) -> Result<(), Failure> {
    handle recording_checked(& *frame, & *controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle Result::as_mut(&mut frame.dependencies) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(transaction) => handle dependency::record(transaction, controls, node, fingerprint, edges) {
                Result::Err(error) => Result::Err(Failure::Dependency(error)), Result::Ok(_) => Result::Ok(()),
            },
        },
    }
}
pub fn record_diagnostic(frame: &mut Frame, controls: &mut operation::Controls, value: diagnostic::CompileDiagnostic)
    -> Result<(), Failure> {
    handle recording_checked(& *frame, & *controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle Result::as_mut(&mut frame.diagnostics) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(builder) => handle diagnostic::record(builder, controls, value) {
                Result::Err(error) => Result::Err(Failure::Diagnostic(error)), Result::Ok(_) => Result::Ok(()),
            },
        },
    }
}
pub fn seal(frame: &mut Frame, packages: &mut package::Registry, owner: Handle,
    controls: &mut operation::Controls, attempts: usize) -> Result<(), Failure> {
    handle recording_checked(& *frame, & *controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle attempts == 0 {
            false => Result::Err(Failure::Busy),
            true => handle package::apply(packages, owner, controls, package::Action::Prepare) {
                Result::Err(error) => Result::Err(Failure::Package(error)),
                Result::Ok(_) => { (*frame).phase = Phase::Packages; Result::Ok(()) },
            },
        },
    }
}
pub fn step(frame: &mut Frame, ledger: &dependency::Ledger, packages: &mut package::Registry,
    owner: Handle, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle operation::check(& *controls) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => step_open(frame, ledger, packages, owner, controls),
    }
}
fn recording_checked(frame: &Frame, controls: &operation::Controls) -> Result<(), Failure> {
    handle operation::check(controls) {
        Result::Err(error) => Result::Err(Failure::Control(error)), Result::Ok(_) => recording(frame),
    }
}
fn step_open(frame: &mut Frame, ledger: &dependency::Ledger, packages: &mut package::Registry,
    owner: Handle, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle frame.phase {
        Phase::Packages => step_packages(frame, packages, owner, controls),
        Phase::Diagnostics => step_diagnostics(frame, controls),
        Phase::Checking { cursor: cursor } => check_diagnostics(frame, controls, cursor),
        Phase::Dependencies => step_dependencies(frame, ledger, controls),
        Phase::Ready => handle operation::check(& *controls) {
            Result::Err(error) => Result::Err(Failure::Control(error)), Result::Ok(_) => Result::Ok(Event::Ready),
        },
        Phase::Recording => Result::Err(Failure::Busy), _ => Result::Err(Failure::Closed),
    }
}
fn step_packages(frame: &mut Frame, packages: &mut package::Registry, owner: Handle,
    controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle package::apply(packages, owner, controls, package::Action::Step) {
        Result::Err(error) => Result::Err(Failure::Package(error)),
        Result::Ok(package::Event::Prepared) => handle Result::as_mut(&mut frame.diagnostics) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(builder) => handle diagnostic::seal(builder) {
                Result::Err(error) => Result::Err(Failure::Diagnostic(error)),
                Result::Ok(_) => { (*frame).phase = Phase::Diagnostics; Result::Ok(Event::Continue) },
            },
        },
        Result::Ok(_) => Result::Ok(Event::Continue),
    }
}
fn step_diagnostics(frame: &mut Frame, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle Result::as_mut(&mut frame.diagnostics) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(builder) => handle diagnostic::step(&mut *builder, &mut *controls) {
            Result::Err(error) => Result::Err(Failure::Diagnostic(error)),
            Result::Ok(event) => handle event {
                diagnostic::Event::Continue => Result::Ok(Event::Continue),
                diagnostic::Event::Validate(span) => Result::Ok(Event::Validate(span)),
                diagnostic::Event::Ready => handle diagnostic::finish(builder, & *controls) {
                    Result::Err(error) => Result::Err(Failure::Diagnostic(error)),
                    Result::Ok(batch) => { (*frame).batch = Result::Ok(batch);
                        (*frame).phase = Phase::Checking { cursor: 0 }; Result::Ok(Event::Continue) },
                },
            },
        },
    }
}
pub fn answer(frame: &mut Frame, controls: &mut operation::Controls, length: Option<u32>) -> Result<(), Failure> {
    handle frame.phase {
        Phase::Diagnostics => handle Result::as_mut(&mut frame.diagnostics) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(builder) => handle diagnostic::answer(builder, controls, length) {
                Result::Err(error) => Result::Err(Failure::Diagnostic(error)), Result::Ok(_) => Result::Ok(()),
            },
        },
        _ => Result::Err(Failure::Busy),
    }
}
fn batch_error(batch: &diagnostic::Batch, cursor: usize) -> Option<Bool> {
    let values = diagnostic::values(batch);
    handle Slice::get(values, cursor) {
        Result::Err(_) => None,
        Result::Ok(value) => handle value.severity {
            diagnostic::Severity::Error => Result::Ok(true), _ => Result::Ok(false),
        },
    }
}
fn check_diagnostics(frame: &mut Frame, controls: &mut operation::Controls, cursor: usize) -> Result<Event, Failure> {
    handle operation::charge(controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle current_diagnostic(& *frame, cursor) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(error) => next_diagnostic(frame, cursor, error),
        },
    }
}
fn current_diagnostic(frame: &Frame, cursor: usize) -> Result<Option<Bool>, Failure> {
    handle Result::as_ref(&frame.batch) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(batch) => Result::Ok(batch_error(batch, cursor)),
    }
}
fn next_diagnostic(frame: &mut Frame, cursor: usize, error: Option<Bool>) -> Result<Event, Failure> {
    handle error {
        Result::Ok(false) => { (*frame).phase = Phase::Checking { cursor: cursor + 1 }; Result::Ok(Event::Continue) },
        Result::Ok(true) => handle Option::take(&mut frame.batch) {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(batch) => Result::Err(Failure::Rejected(batch)),
        },
        Result::Err(_) => handle Result::as_mut(&mut frame.dependencies) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(transaction) => handle dependency::seal(transaction) {
                Result::Err(error) => Result::Err(Failure::Dependency(error)),
                Result::Ok(_) => { (*frame).phase = Phase::Dependencies; Result::Ok(Event::Continue) },
            },
        },
    }
}
fn step_dependencies(frame: &mut Frame, ledger: &dependency::Ledger, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle Result::as_mut(&mut frame.dependencies) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(transaction) => handle dependency::step(ledger, transaction, controls) {
            Result::Err(error) => Result::Err(Failure::Dependency(error)),
            Result::Ok(progress) => handle progress {
                dependency::Progress::Continue => Result::Ok(Event::Continue),
                dependency::Progress::Ready => { (*frame).phase = Phase::Ready; Result::Ok(Event::Ready) },
            },
        },
    }
}
pub fn finish(frame: &mut Frame, ledger: &mut dependency::Ledger, packages: &mut package::Registry,
    controls: &operation::Controls) -> Result<diagnostic::Batch, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => finish_open(frame, ledger, packages, controls),
    }
}
fn finish_open(frame: &mut Frame, ledger: &mut dependency::Ledger, packages: &mut package::Registry,
    controls: &operation::Controls) -> Result<diagnostic::Batch, Failure> {
    handle frame.phase {
        Phase::Ready => handle Option::take(&mut frame.batch) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(batch) => finish_ready(frame, ledger, packages, controls, batch),
        },
        Phase::Committed => Result::Err(Failure::Closed), Phase::Aborted => Result::Err(Failure::Closed),
        _ => Result::Err(Failure::Busy),
    }
}
fn finish_ready(frame: &mut Frame, ledger: &mut dependency::Ledger, packages: &mut package::Registry,
    controls: &operation::Controls, batch: diagnostic::Batch) -> Result<diagnostic::Batch, Failure> {
    handle Result::as_mut(&mut frame.dependencies) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(transaction) => handle package::prepare_commit(packages) {
            Result::Err(error) => Result::Err(Failure::Package(error)),
            Result::Ok(permit) => handle dependency::commit(ledger, transaction, controls) {
                Result::Err(error) => Result::Err(Failure::Dependency(error)),
                Result::Ok(_) => {
                    // No fallible operations, polling, or directory allocation
                    // after the ledger's final check and visible slot swap.
                    package::publish(permit); (*frame).phase = Phase::Committed;
                    Result::Ok(batch)
                },
            },
        },
    }
}
