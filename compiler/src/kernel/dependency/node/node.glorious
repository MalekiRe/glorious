use std::*;
use super::super::identity;
use super::super::identity::FileKey;
use super::super::identity::DefKey;
use super::super::identity::InstanceKey;
use super::super::identity::ModuleKey;
use super::super::identity::PackageKey;

// The variant order and payload order match the public Rust ledger exactly.
// A query's execution journal is a separate, first-observation-ordered product.
pub enum Node {
    Input(FileKey), Interface(ModuleKey), Fixity(ModuleKey), Body(DefKey),
    Core(DefKey), Instance(InstanceKey), Mir(DefKey), Artifact(PackageKey),
}
pub impl Clone for Node {
    clone(value: &Node) -> Node {
        handle *value {
            Node::Input(_) => Node::Input(value.0),
            Node::Interface(_) => Node::Interface(Clone::clone(&value.0)),
            Node::Fixity(_) => Node::Fixity(Clone::clone(&value.0)),
            Node::Body(_) => Node::Body(value.0),
            Node::Core(_) => Node::Core(value.0),
            Node::Instance(_) => Node::Instance(Clone::clone(&value.0)),
            Node::Mir(_) => Node::Mir(value.0),
            Node::Artifact(_) => Node::Artifact(Clone::clone(&value.0)),
        }
    }
}
pub fn kind(value: &Node) -> usize {
    handle *value {
        Node::Input(_) => 0, Node::Interface(_) => 1, Node::Fixity(_) => 2,
        Node::Body(_) => 3, Node::Core(_) => 4, Node::Instance(_) => 5,
        Node::Mir(_) => 6, Node::Artifact(_) => 7,
    }
}
fn payload_order(left: &Node, right: &Node) -> Ordering {
    // Nonmatching arms cannot be reached after compare's discriminator check.
    handle *left {
        Node::Input(_) => handle *right { Node::Input(_) => identity::compare_digest(left.0.digest, right.0.digest), _ => Ordering::Less },
        Node::Interface(_) => handle *right { Node::Interface(_) => identity::compare_module(&left.0, &right.0), _ => Ordering::Less },
        Node::Fixity(_) => handle *right { Node::Fixity(_) => identity::compare_module(&left.0, &right.0), _ => Ordering::Less },
        Node::Body(_) => handle *right { Node::Body(_) => identity::compare_digest(left.0.digest, right.0.digest), _ => Ordering::Less },
        Node::Core(_) => handle *right { Node::Core(_) => identity::compare_digest(left.0.digest, right.0.digest), _ => Ordering::Less },
        Node::Instance(_) => handle *right { Node::Instance(_) => identity::compare_instance(&left.0, &right.0), _ => Ordering::Less },
        Node::Mir(_) => handle *right { Node::Mir(_) => identity::compare_digest(left.0.digest, right.0.digest), _ => Ordering::Less },
        Node::Artifact(_) => handle *right { Node::Artifact(_) => identity::compare_package(&left.0, &right.0), _ => Ordering::Less },
    }
}
pub fn compare(left: &Node, right: &Node) -> Ordering {
    let a = kind(left);
    let b = kind(right);
    handle Ord::cmp(&a, &b) { Ordering::Equal => payload_order(left, right), order => order }
}
pub fn same(left: &Node, right: &Node) -> Bool {
    handle compare(left, right) { Ordering::Equal => true, _ => false }
}
pub impl PartialEq for Node { eq(left: &Node, right: &Node) -> Bool { same(left, right) } }
pub impl Eq for Node {}
pub impl Ord for Node { cmp(left: &Node, right: &Node) -> Ordering { compare(left, right) } }
pub impl PartialOrd for Node {
    fn partial_cmp(left: &Self, right: &Self) -> Option<Ordering> { Some(Ord::cmp(left, right)) }
}
pub impl Hash for Node {
    hash(value: &Node, state: &mut Hasher) -> () {
        Hasher::write_usize(&mut *state, kind(value));
        handle *value {
            Node::Input(_) => Hash::hash(&value.0.digest, state),
            Node::Interface(_) => identity::hash_module(&value.0, state),
            Node::Fixity(_) => identity::hash_module(&value.0, state),
            Node::Body(_) => Hash::hash(&value.0.digest, state),
            Node::Core(_) => Hash::hash(&value.0.digest, state),
            Node::Instance(_) => identity::hash_instance(&value.0, state),
            Node::Mir(_) => Hash::hash(&value.0.digest, state),
            Node::Artifact(_) => identity::hash_package(&value.0, state),
        }
    }
}
