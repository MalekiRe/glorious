use std::*;
use super::identity;
use super::identity::Digest;
use super::identity::RevisionId;
use super::storage;
use super::storage::Arena;
use super::storage::Handle;
use super::operation;
use super::query;
use super::query::Read;
use super::query::ReadIdentity;
use super::query::RecoveryPolicy;
use super::query::Completeness;
use super::transaction;
use super::package;
use super::dependency;
use super::diagnostic;
use super::publication;
use super::identity::PackageKey;

pub enum Failure {
    Foreign, Closed, Busy, Capacity, Invariant, Cycle { family: u32 },
    Query(query::Failure), Control(operation::Failure), Package(package::Failure), Publication(publication::Failure),
}
pub enum ReusePolicy { Never, Tracked }
enum PublicationMode { Fresh, Reused }
pub struct Family { private database: u64, private index: u32 }
struct Contract { schema: u64, recovery: RecoveryPolicy, reuse: ReusePolicy }
pub struct Key { private identity: ReadIdentity }
pub struct Session { private handle: Handle }
pub struct Ticket { private handle: Handle }
struct Request {
    revision: RevisionId, parent: Option<RevisionId>, recovery: RecoveryPolicy,
    controls: operation::Controls, attempts: usize, packages: package::Registry, publication: publication::Frame,
}
impl Use<[0, 1]> for Request {}
struct MemoKey { revision: RevisionId, identity: ReadIdentity }
pub enum Reason { Cold, ParentMemoMissing { parent: RevisionId }, ParentReuseRejected { parent: RevisionId } }
pub enum Execution { Recomputed(Reason), ReusedFromParent { parent: RevisionId }, Memoized { revision: RevisionId } }
enum Phase { Ancestry { cursor: Option<Ticket> }, Lookup, Waiting, Checking, Computing, Deliver }
struct Attempt {
    request: Session, key: MemoKey, parent: Option<Ticket>, phase: Phase,
    cell: Option<Handle>, candidate: Option<Handle>, replay: Option<query::Replay>,
    frame: query::Frame, execution: Execution,
}
enum CellState { Pending { owner: Ticket }, Ready { memo: query::Memo<Handle>, execution: Execution } }
struct Cell { key: MemoKey, schema: u64, state: CellState }
pub struct Outcome {
    private cell: Handle, private revision: RevisionId, private identity: ReadIdentity,
    private product: Handle, fingerprint: Digest, completeness: Completeness, execution: Execution,
}
pub enum Event { Continue, Waiting, Compute { key: Key }, Read(Read), Reuse { product: Handle }, Ready(Outcome) }
pub struct Stats { sessions: usize, attempts: usize, memos: usize, edges: usize, explanations: usize }
pub enum Discard { Done, Next { cursor: usize, product: Option<Handle>, edges: usize } }

enum RootPhase { Attempts { slot: usize, part: u32, read: usize }, Cells { slot: usize, read: Option<usize> } }
pub struct RootCursor { private database: u64, private phase: RootPhase }
pub enum RootStep { Continue(RootCursor), Key { identity: ReadIdentity, next: RootCursor }, Done }

// This machine contains no family-specific key or product type. The database
// owns typed product storage; source family adapters own exact key interners.
pub struct Engine {
    private database: u64, private families: Vec<Contract>, private sessions: Arena<Request>,
    private attempts: Arena<Attempt>, private cells: Arena<Cell>,
    private index: HashMap<MemoKey, Handle>, private reads: usize, private stats: Stats, private ledger: dependency::Ledger,
}

pub impl Eq for MemoKey {
    eq(left: &MemoKey, right: &MemoKey) -> Bool { same_key(*left, *right) }
}
pub impl Hash for MemoKey {
    hash(value: &MemoKey, state: &mut Hasher) -> () {
        Hasher::write_usize(&mut *state, as<usize>(value.revision.database));
        Hasher::write_usize(&mut *state, as<usize>(value.revision.ordinal));
        Hasher::write_usize(&mut *state, as<usize>(query::family(value.identity)));
        storage::hash(query::key(value.identity), &mut *state);
    }
}

fn same_key(left: MemoKey, right: MemoKey) -> Bool {
    handle identity::same_revision(left.revision, right.revision) {
        false => false, true => query::same(left.identity, right.identity),
    }
}

pub fn create(database: u64, revisions: usize, sessions: usize, attempts: usize, memos: usize, reads: usize) -> Engine {
    Engine { database: database, families: Vec::new(), sessions: storage::namespace(database, 2, sessions),
        attempts: storage::namespace(database, 3, attempts), cells: storage::namespace(database, 4, memos),
        index: HashMap::new(), reads: reads, ledger: dependency::create(database, revisions),
        stats: Stats { sessions: 0, attempts: 0, memos: 0, edges: 0, explanations: 0 } }
}

pub fn register(engine: &mut Engine, schema: u64, recovery: RecoveryPolicy, reuse: ReusePolicy) -> Result<Family, Failure> {
    handle Vec::len(&engine.families) < 4294967295 {
        false => Result::Err(Failure::Capacity),
        true => {
            let index = as<u32>(Vec::len(&engine.families));
            Vec::push(&mut engine.families, Contract { schema: schema, recovery: recovery, reuse: reuse });
            Result::Ok(Family { database: engine.database, index: index })
        },
    }
}

pub fn key_namespace(family: Family) -> u64 { wrapping_add(16, as<u64>(family.index)) }
pub fn family_database(family: Family) -> u64 { family.database }
pub fn family_index(family: Family) -> u32 { family.index }
pub fn key_identity(key: Key) -> ReadIdentity { key.identity }

// The owning registry keeps admission/stepping/cleanup stopped throughout
// this scan and the subsequent typed sweeps. Cancellation flags may change.
// Every call visits one arena slot, phase boundary, or retained read identity.
pub fn key_roots(engine: &Engine) -> RootCursor {
    RootCursor { database: engine.database, phase: RootPhase::Attempts { slot: 0, part: 0, read: 0 } }
}
pub fn key_root_step(engine: &Engine, cursor: RootCursor) -> Result<RootStep, Failure> {
    handle cursor.database == engine.database {
        false => Result::Err(Failure::Foreign),
        true => handle cursor.phase {
            RootPhase::Attempts { slot, part, read } => attempt_roots(engine, slot, part, read),
            RootPhase::Cells { slot, read } => cell_roots(engine, slot, read),
        },
    }
}
fn root_cursor(database: u64, phase: RootPhase) -> RootCursor { RootCursor { database: database, phase: phase } }
fn root_next(database: u64, phase: RootPhase) -> Result<RootStep, Failure> {
    Result::Ok(RootStep::Continue(root_cursor(database, phase)))
}
fn root_key(database: u64, identity: ReadIdentity, phase: RootPhase) -> Result<RootStep, Failure> {
    Result::Ok(RootStep::Key { identity: identity, next: root_cursor(database, phase) })
}
fn attempt_roots(engine: &Engine, slot: usize, part: u32, read: usize) -> Result<RootStep, Failure> {
    handle slot < storage::slot_count(&engine.attempts) {
        false => root_next(engine.database, RootPhase::Cells { slot: 0, read: None }),
        true => handle storage::key_at(&engine.attempts, slot) {
            Result::Err(_) => root_next(engine.database, RootPhase::Attempts { slot: slot + 1, part: 0, read: 0 }),
            Result::Ok(key) => handle storage::get(&engine.attempts, key) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(attempt) => attempt_root(engine.database, attempt, slot, part, read),
            },
        },
    }
}
fn attempt_root(database: u64, attempt: &Attempt, slot: usize, part: u32, read: usize) -> Result<RootStep, Failure> {
    handle part {
        0 => root_key(database, attempt.key.identity, RootPhase::Attempts { slot: slot, part: 1, read: 0 }),
        1 => handle query::frame_read(&attempt.frame, read) {
            Result::Err(_) => root_next(database, RootPhase::Attempts { slot: slot, part: 2, read: 0 }),
            Result::Ok(identity) => root_key(database, identity, RootPhase::Attempts { slot: slot, part: 1, read: read + 1 }),
        },
        2 => replay_roots(database, attempt, slot, read),
        _ => Result::Err(Failure::Invariant),
    }
}
fn replay_roots(database: u64, attempt: &Attempt, slot: usize, read: usize) -> Result<RootStep, Failure> {
    handle Result::as_ref(&attempt.replay) {
        Result::Err(_) => root_next(database, RootPhase::Attempts { slot: slot + 1, part: 0, read: 0 }),
        Result::Ok(replay) => handle query::replay_read(replay, read) {
            Result::Err(_) => root_next(database, RootPhase::Attempts { slot: slot + 1, part: 0, read: 0 }),
            Result::Ok(identity) => root_key(database, identity, RootPhase::Attempts { slot: slot, part: 2, read: read + 1 }),
        },
    }
}
fn cell_roots(engine: &Engine, slot: usize, read: Option<usize>) -> Result<RootStep, Failure> {
    handle slot < storage::slot_count(&engine.cells) {
        false => Result::Ok(RootStep::Done),
        true => handle storage::key_at(&engine.cells, slot) {
            Result::Err(_) => root_next(engine.database, RootPhase::Cells { slot: slot + 1, read: None }),
            Result::Ok(key) => handle storage::get(&engine.cells, key) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(cell) => cell_root(engine.database, cell, slot, read),
            },
        },
    }
}
fn cell_root(database: u64, cell: &Cell, slot: usize, read: Option<usize>) -> Result<RootStep, Failure> {
    handle read {
        Result::Err(_) => root_key(database, cell.key.identity, RootPhase::Cells { slot: slot, read: Result::Ok(0) }),
        Result::Ok(read) => handle cell.state {
            CellState::Pending { owner: _ } => root_next(database, RootPhase::Cells { slot: slot + 1, read: None }),
            CellState::Ready { memo, execution: _ } => handle query::memo_read(&memo, read) {
                Result::Err(_) => root_next(database, RootPhase::Cells { slot: slot + 1, read: None }),
                Result::Ok(identity) => root_key(database, identity, RootPhase::Cells { slot: slot, read: Result::Ok(read + 1) }),
            },
        },
    }
}

pub fn key(family: Family, slot: Handle) -> Result<Key, Failure> {
    handle storage::belongs_to(slot, family.database, key_namespace(family)) {
        false => Result::Err(Failure::Foreign),
        true => Result::Ok(Key { identity: query::read_identity(family.index, slot, 0) }),
    }
}

fn contract(engine: &Engine, key: Key) -> Result<Contract, Failure> {
    handle Vec::get(&engine.families, as<usize>(query::family(key.identity))) {
        Result::Err(_) => Result::Err(Failure::Foreign),
        Result::Ok(value) => handle storage::belongs_to(query::key(key.identity), engine.database,
            wrapping_add(16, as<u64>(query::family(key.identity)))) {
            false => Result::Err(Failure::Foreign), true => Result::Ok(*value),
        },
    }
}

// Only the database facade calls admission, after acquiring a real world pin.
pub fn admit(engine: &mut Engine, revision: RevisionId, parent: Option<RevisionId>,
    recovery: RecoveryPolicy, controls: operation::Controls) -> Result<Session, Failure> {
    handle revision.database == engine.database {
        false => Result::Err(Failure::Foreign),
        true => handle storage::insert(&mut engine.sessions, Request { revision: revision, parent: parent,
            recovery: recovery, controls: controls, attempts: 0, publication: publication::create(),
            packages: package::create(package::Limits { packages: engine.reads, bodies: engine.reads }) }) {
            Result::Err(_) => Result::Err(Failure::Capacity),
            Result::Ok(slot) => {
                (*engine).stats.sessions = engine.stats.sessions + 1;
                Result::Ok(Session { handle: slot })
            },
        },
    }
}

pub fn check(engine: &Engine, session: Session) -> Result<(), Failure> {
    handle storage::get(&engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => handle operation::check(&request.controls) {
            Result::Err(error) => Result::Err(Failure::Control(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}

// Only the trusted driver borrows this actual request-owned budget. Providers
// cannot receive an Engine or replace the counters with a detached copy.
pub fn request_controls<'a>(engine: &'a mut Engine, session: Session) -> Result<&'a mut operation::Controls, Failure> {
    handle check(& *engine, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle storage::get_mut(&mut engine.sessions, session.handle) {
            Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(request) => Result::Ok(&mut request.controls),
        },
    }
}

pub fn cancel(engine: &mut Engine, session: Session) -> Result<(), Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => {
            operation::cancel(&mut request.controls);
            publication::abort(&mut request.publication, &mut request.packages);
            package::rollback_all(&mut request.packages);
            Result::Ok(())
        },
    }
}

pub fn close(engine: &mut Engine, session: Session) -> Result<(), Failure> {
    handle request_attempts(& *engine, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(0) => {
            storage::remove(&mut engine.sessions, session.handle);
            (*engine).stats.sessions = engine.stats.sessions - 1;
            Result::Ok(())
        },
        Result::Ok(_) => Result::Err(Failure::Busy),
    }
}

fn request_attempts(engine: &Engine, session: Session) -> Result<usize, Failure> {
    handle storage::get(&engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(request) => Result::Ok(request.attempts),
    }
}

// Package operations use the same session-owned work/cancellation counters
// as query evaluation. Inspection and cleanup remain available after cancel.
pub fn package_action(engine: &mut Engine, session: Session, action: package::Action) -> Result<package::Event, Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => request_package_action(request, session.handle, action),
    }
}
fn request_package_action(request: &mut Request, owner: Handle, action: package::Action) -> Result<package::Event, Failure> {
    handle publication::query_allowed(&request.publication) {
        Result::Err(error) => publication_result(request, Result::Err(error)),
        Result::Ok(_) => {
            let result = package::apply(&mut request.packages, owner, &mut request.controls, action);
            handle result {
                Result::Ok(event) => Result::Ok(event),
                Result::Err(error) => {
                    publication::package_failed(&mut request.publication, &mut request.packages);
                    handle error { package::Failure::Control(error) => Result::Err(Failure::Control(error)),
                        error => Result::Err(Failure::Package(error)) }
                },
            }
        },
    }
}
pub fn request_failed(engine: &mut Engine, session: Session) -> () {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => (),
        Result::Ok(request) => publication::package_failed(&mut request.publication, &mut request.packages),
    }
}
fn publication_result<T>(request: &mut Request, result: Result<T, publication::Failure>) -> Result<T, Failure>
    where T: Use<[0, 1]> {
    handle result {
        Result::Ok(value) => Result::Ok(value),
        Result::Err(error) => {
            publication::abort(&mut request.publication, &mut request.packages);
            publication_error(error)
        },
    }
}
fn publication_error<T>(error: publication::Failure) -> Result<T, Failure> {
    handle error {
        publication::Failure::Control(error) => Result::Err(Failure::Control(error)),
        publication::Failure::Diagnostic(diagnostic::Failure::Control(error)) => Result::Err(Failure::Control(error)),
        publication::Failure::Dependency(dependency::Failure::Control(error)) => Result::Err(Failure::Control(error)),
        publication::Failure::Package(package::Failure::Control(error)) => Result::Err(Failure::Control(error)),
        error => Result::Err(Failure::Publication(error)),
    }
}
pub fn begin_request(engine: &mut Engine, session: Session, fingerprint: Digest, limits: publication::Limits) -> Result<(), Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => {
            let result = publication::begin(&mut request.publication, &engine.ledger, &mut request.packages,
                &mut request.controls, request.revision, request.parent, fingerprint, limits);
            publication_result(request, result)
        },
    }
}
pub fn record_dependency(engine: &mut Engine, session: Session, node: dependency::node::Node,
    fingerprint: Digest, edges: Vec<dependency::node::Node>) -> Result<(), Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => {
            let result = publication::record_dependency(&mut request.publication, &mut request.controls, node, fingerprint, edges);
            publication_result(request, result)
        },
    }
}
pub fn record_diagnostic(engine: &mut Engine, session: Session, value: diagnostic::CompileDiagnostic) -> Result<(), Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => {
            let result = publication::record_diagnostic(&mut request.publication, &mut request.controls, value);
            publication_result(request, result)
        },
    }
}
pub fn seal_request(engine: &mut Engine, session: Session) -> Result<(), Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => {
            let result = publication::seal(&mut request.publication, &mut request.packages, session.handle,
                &mut request.controls, request.attempts);
            publication_result(request, result)
        },
    }
}
pub fn step_request(engine: &mut Engine, session: Session) -> Result<publication::Event, Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => {
            let result = publication::step(&mut request.publication, &engine.ledger, &mut request.packages,
                session.handle, &mut request.controls);
            publication_result(request, result)
        },
    }
}
// Only the pinned-world facade supplies this answer; providers see no length
// injection method on the Database API.
pub fn answer_span(engine: &mut Engine, session: Session, length: Option<u32>) -> Result<(), Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => {
            let result = publication::answer(&mut request.publication, &mut request.controls, length);
            publication_result(request, result)
        },
    }
}
pub fn finish_request(engine: &mut Engine, session: Session) -> Result<diagnostic::Batch, Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => {
            let result = publication::finish(&mut request.publication, &mut engine.ledger, &mut request.packages, &request.controls);
            publication_result(request, result)
        },
    }
}
pub fn request_traces<'a>(engine: &'a Engine, session: Session) -> Result<Option<Slice<'a, dependency::Trace>>, Failure> {
    handle storage::get(&engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => Result::Ok(dependency::traces(&engine.ledger, request.revision)),
    }
}
pub fn published_revisions(engine: &Engine) -> usize { dependency::revision_count(&engine.ledger) }
pub fn package_metadata(engine: &Engine, session: Session, key: &PackageKey) -> Result<package::Metadata, Failure> {
    handle storage::get(&engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => handle package::metadata(&request.packages, key) {
            Result::Err(error) => Result::Err(Failure::Package(error)), Result::Ok(metadata) => Result::Ok(metadata),
        },
    }
}
pub fn package_stats(engine: &Engine, session: Session) -> Result<package::Stats, Failure> {
    handle storage::get(&engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(request) => Result::Ok(package::stats(&request.packages)),
    }
}
pub fn work_spent(engine: &Engine, session: Session) -> Result<u64, Failure> {
    handle storage::get(&engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(request) => Result::Ok(operation::work_spent(&request.controls)),
    }
}

fn request_info(engine: &Engine, session: Session) -> Result<(RevisionId, Option<RevisionId>), Failure> {
    handle storage::get(&engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(request) => Result::Ok((request.revision, request.parent)),
    }
}

fn parent_allowed(engine: &Engine, session: Session, parent: Option<Ticket>) -> Result<(), Failure> {
    handle parent {
        Result::Err(_) => Result::Ok(()),
        Result::Ok(ticket) => handle storage::get(&engine.attempts, ticket.handle) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(attempt) => handle storage::equal(attempt.request.handle, session.handle) {
                false => Result::Err(Failure::Foreign),
                true => handle attempt.phase {
                    Phase::Computing => Result::Ok(()), Phase::Checking => Result::Ok(()),
                    _ => Result::Err(Failure::Busy),
                },
            },
        },
    }
}

pub fn start(engine: &mut Engine, session: Session, key: Key, parent: Option<Ticket>) -> Result<Ticket, Failure> {
    handle query_admission(& *engine, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle parent_allowed(& *engine, session, parent) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle contract(& *engine, key) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(contract) => handle request_info(& *engine, session) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok((revision, _)) => start_attempt(&mut *engine, session, key, parent, revision, contract),
                },
            },
        },
    }
}
fn query_admission(engine: &Engine, session: Session) -> Result<(), Failure> {
    handle check(engine, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle storage::get(&engine.sessions, session.handle) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(request) => handle publication::query_allowed(&request.publication) {
                Result::Err(error) => publication_error(error), Result::Ok(_) => Result::Ok(()),
            },
        },
    }
}

fn start_attempt(engine: &mut Engine, session: Session, key: Key, parent: Option<Ticket>,
    revision: RevisionId, contract: Contract) -> Result<Ticket, Failure> {
    handle storage::insert(&mut engine.attempts, Attempt { request: session,
        key: MemoKey { revision: revision, identity: key.identity }, parent: parent,
        phase: Phase::Ancestry { cursor: parent }, cell: None, candidate: None, replay: None,
        frame: query::frame(contract.recovery, engine.reads), execution: Execution::Recomputed(Reason::Cold) }) {
        Result::Err(_) => Result::Err(Failure::Capacity),
        Result::Ok(slot) => {
            let request = storage::get_mut(&mut engine.sessions, session.handle);
            handle request {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(request) => {
                    (*request).attempts = request.attempts + 1;
                    (*engine).stats.attempts = engine.stats.attempts + 1;
                    Result::Ok(Ticket { handle: slot })
                },
            }
        },
    }
}

struct Info { request: Session, key: MemoKey, parent: Option<Ticket>, phase: Phase, cell: Option<Handle>, candidate: Option<Handle> }
fn info(engine: &Engine, ticket: Ticket) -> Result<Info, Failure> {
    handle storage::get(&engine.attempts, ticket.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(attempt) => Result::Ok(Info { request: attempt.request, key: attempt.key,
            parent: attempt.parent, phase: attempt.phase, cell: attempt.cell, candidate: attempt.candidate }),
    }
}

fn indexed(engine: &Engine, key: MemoKey) -> Option<Handle> {
    handle HashMap::get(&engine.index, &key) { Result::Err(_) => None, Result::Ok(slot) => Result::Ok(*slot) }
}

fn transition(engine: &mut Engine, ticket: Ticket, phase: Phase) -> Result<Event, Failure> {
    handle storage::get_mut(&mut engine.attempts, ticket.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(attempt) => { (*attempt).phase = phase; Result::Ok(Event::Continue) },
    }
}

pub fn poll(engine: &mut Engine, ticket: Ticket) -> Result<Event, Failure> {
    let result = poll_checked(&mut *engine, ticket);
    handle result {
        Result::Ok(event) => Result::Ok(event),
        Result::Err(error) => { abort(&mut *engine, ticket); Result::Err(error) },
    }
}

fn poll_checked(engine: &mut Engine, ticket: Ticket) -> Result<Event, Failure> {
    handle info(& *engine, ticket) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(info) => handle check(& *engine, info.request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle info.phase {
                Phase::Ancestry { cursor: cursor } => ancestry(&mut *engine, ticket, info, cursor),
                Phase::Lookup => lookup(&mut *engine, ticket, info),
                Phase::Waiting => lookup(&mut *engine, ticket, info),
                Phase::Checking => checking(&mut *engine, ticket, info),
                Phase::Computing => Result::Ok(Event::Compute { key: Key { identity: info.key.identity } }),
                Phase::Deliver => handle info.cell {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(cell) => deliver(&mut *engine, ticket, info, cell, None),
                },
            },
        },
    }
}

fn ancestry(engine: &mut Engine, ticket: Ticket, current: Info, cursor: Option<Ticket>) -> Result<Event, Failure> {
    handle cursor {
        Result::Err(_) => transition(&mut *engine, ticket, Phase::Lookup),
        Result::Ok(ancestor) => handle info(& *engine, ancestor) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(parent) => handle same_key(current.key, parent.key) {
                true => Result::Err(Failure::Cycle { family: query::family(current.key.identity) }),
                false => transition(&mut *engine, ticket, Phase::Ancestry { cursor: parent.parent }),
            },
        },
    }
}

enum Located { Pending, Ready }
fn location(engine: &Engine, cell: Handle) -> Result<Located, Failure> {
    handle storage::get(&engine.cells, cell) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(cell) => handle cell.state { CellState::Pending { owner: _ } => Result::Ok(Located::Pending),
            CellState::Ready { memo: _, execution: _ } => Result::Ok(Located::Ready) },
    }
}

fn lookup(engine: &mut Engine, ticket: Ticket, info: Info) -> Result<Event, Failure> {
    handle indexed(& *engine, info.key) {
        Result::Err(_) => claim(&mut *engine, ticket, info),
        Result::Ok(cell) => handle location(& *engine, cell) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(located) => handle located {
            Located::Ready => deliver(&mut *engine, ticket, info, cell,
                Result::Ok(Execution::Memoized { revision: info.key.revision })),
            Located::Pending => {
                transition(&mut *engine, ticket, Phase::Waiting);
                Result::Ok(Event::Waiting)
            },
            },
        },
    }
}

fn claim(engine: &mut Engine, ticket: Ticket, info: Info) -> Result<Event, Failure> {
    handle contract(& *engine, Key { identity: info.key.identity }) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(contract) => handle storage::insert(&mut engine.cells, Cell { key: info.key,
            schema: contract.schema, state: CellState::Pending { owner: ticket } }) {
            Result::Err(_) => Result::Err(Failure::Capacity),
            Result::Ok(cell) => {
                HashMap::insert(&mut engine.index, info.key, cell);
                own_cell(&mut *engine, ticket, cell);
                consider_parent(&mut *engine, ticket, info, contract)
            },
        },
    }
}

fn own_cell(engine: &mut Engine, ticket: Ticket, cell: Handle) -> () {
    handle storage::get_mut(&mut engine.attempts, ticket.handle) {
        Result::Err(_) => (), Result::Ok(attempt) => { (*attempt).cell = Result::Ok(cell); },
    }
}

fn consider_parent(engine: &mut Engine, ticket: Ticket, info: Info, contract: Contract) -> Result<Event, Failure> {
    handle request_info(& *engine, info.request) {
        Result::Err(error) => Result::Err(error),
        Result::Ok((_, parent)) => handle parent {
            Result::Err(_) => compute(&mut *engine, ticket, Reason::Cold),
            Result::Ok(parent) => handle indexed(& *engine, MemoKey { revision: parent, identity: info.key.identity }) {
                Result::Err(_) => compute(&mut *engine, ticket, Reason::ParentMemoMissing { parent: parent }),
                Result::Ok(cell) => handle reusable(& *engine, cell, contract) {
                    false => compute(&mut *engine, ticket, Reason::ParentReuseRejected { parent: parent }),
                    true => prepare_replay(&mut *engine, ticket, cell, parent),
                },
            },
        },
    }
}

fn reusable(engine: &Engine, cell: Handle, contract: Contract) -> Bool {
    handle contract.reuse {
        ReusePolicy::Never => false,
        ReusePolicy::Tracked => handle storage::get(&engine.cells, cell) {
            Result::Err(_) => false,
            Result::Ok(cell) => handle cell.schema == contract.schema {
                false => false,
                true => handle cell.state { CellState::Pending { owner: _ } => false,
                    CellState::Ready { memo: _, execution: _ } => true },
            },
        },
    }
}

fn parent_replay(engine: &Engine, cell: Handle) -> Result<query::Replay, Failure> {
    handle storage::get(&engine.cells, cell) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(cell) => handle cell.state {
            CellState::Pending { owner: _ } => Result::Err(Failure::Busy),
            CellState::Ready { memo: memo, execution: _ } => Result::Ok(query::replay(&memo)),
        },
    }
}

fn prepare_replay(engine: &mut Engine, ticket: Ticket, cell: Handle, parent: RevisionId) -> Result<Event, Failure> {
    handle parent_replay(& *engine, cell) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(replay) => handle storage::get_mut(&mut engine.attempts, ticket.handle) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(attempt) => {
                (*attempt).candidate = Result::Ok(cell);
                (*attempt).replay = Result::Ok(replay);
                (*attempt).phase = Phase::Checking;
                (*attempt).execution = Execution::ReusedFromParent { parent: parent };
                Result::Ok(Event::Continue)
            },
        },
    }
}

fn compute(engine: &mut Engine, ticket: Ticket, reason: Reason) -> Result<Event, Failure> {
    handle info(& *engine, ticket) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(info) => handle charge(&mut *engine, info.request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle contract(& *engine, Key { identity: info.key.identity }) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(contract) => handle storage::get_mut(&mut engine.attempts, ticket.handle) {
                    Result::Err(_) => Result::Err(Failure::Closed),
                    Result::Ok(attempt) => {
                        (*attempt).phase = Phase::Computing;
                        (*attempt).replay = None;
                        (*attempt).frame = query::frame(contract.recovery, engine.reads);
                        (*attempt).execution = Execution::Recomputed(reason);
                        Result::Ok(Event::Continue)
                    },
                },
            },
        },
    }
}

fn charge(engine: &mut Engine, session: Session) -> Result<(), Failure> {
    handle storage::get_mut(&mut engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(request) => handle operation::charge(&mut request.controls, 1) {
            Result::Err(error) => Result::Err(Failure::Control(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}

fn controls(engine: &Engine, session: Session) -> Result<operation::Controls, Failure> {
    handle storage::get(&engine.sessions, session.handle) {
        Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(request) => Result::Ok(request.controls),
    }
}

fn expected(engine: &Engine, ticket: Ticket, controls: &operation::Controls) -> Result<Option<Read>, Failure> {
    handle storage::get(&engine.attempts, ticket.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(attempt) => handle Result::as_ref(&attempt.replay) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(replay) => handle query::next(replay, controls) {
                Result::Err(error) => Result::Err(Failure::Query(error)), Result::Ok(read) => Result::Ok(read),
            },
        },
    }
}

fn checking(engine: &mut Engine, ticket: Ticket, info: Info) -> Result<Event, Failure> {
    handle info.candidate {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(cell) => handle ready(& *engine, cell) {
            Result::Err(_) => missing_parent(&mut *engine, ticket, info.request),
            Result::Ok(candidate) => handle controls(& *engine, info.request) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(controls) => handle expected(& *engine, ticket, &controls) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(read) => handle read {
                        Result::Err(_) => Result::Ok(Event::Reuse { product: candidate.product }),
                        Result::Ok(read) => Result::Ok(Event::Read(read)),
                    },
                },
            },
        },
    }
}

fn missing_parent(engine: &mut Engine, ticket: Ticket, session: Session) -> Result<Event, Failure> {
    handle request_info(& *engine, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok((_, parent)) => handle parent {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(parent) => compute(&mut *engine, ticket, Reason::ParentMemoMissing { parent: parent }),
        },
    }
}

fn ready(engine: &Engine, key: Handle) -> Result<Outcome, Failure> {
    handle storage::get(&engine.cells, key) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(cell) => handle cell.state {
            CellState::Pending { owner: _ } => Result::Err(Failure::Busy),
            CellState::Ready { memo: memo, execution: execution } => Result::Ok(Outcome { cell: key,
                revision: cell.key.revision, identity: cell.key.identity, product: memo.value,
                fingerprint: memo.fingerprint, completeness: memo.completeness, execution: execution }),
        },
    }
}

fn recovery(engine: &Engine, session: Session, key: Key, completeness: Completeness) -> Result<(), Failure> {
    handle contract(engine, key) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(contract) => handle query::permits(contract.recovery, completeness) {
            false => Result::Err(Failure::Query(query::Failure::RecoveredProduct)),
            true => handle storage::get(&engine.sessions, session.handle) {
                Result::Err(_) => Result::Err(Failure::Closed),
                Result::Ok(request) => handle query::permits(request.recovery, completeness) {
                    false => Result::Err(Failure::Query(query::Failure::RecoveredProduct)), true => Result::Ok(()),
                },
            },
        },
    }
}

fn deliver(engine: &mut Engine, ticket: Ticket, info: Info, cell: Handle, execution: Option<Execution>) -> Result<Event, Failure> {
    handle ready(& *engine, cell) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(outcome) => handle recovery(& *engine, info.request, Key { identity: info.key.identity }, outcome.completeness) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => deliver_tracked(&mut *engine, ticket, info, outcome, execution),
        },
    }
}

fn deliver_tracked(engine: &mut Engine, ticket: Ticket, info: Info, outcome: Outcome, execution: Option<Execution>) -> Result<Event, Failure> {
    handle track_parent(&mut *engine, info.parent, Read { identity: info.key.identity,
        fingerprint: outcome.fingerprint, completeness: outcome.completeness }) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => {
            let outcome = with_execution(outcome, execution);
            record_execution(&mut *engine, outcome.cell, outcome.execution);
            release_attempt(&mut *engine, ticket);
            Result::Ok(Event::Ready(outcome))
        },
    }
}

fn with_execution(outcome: Outcome, execution: Option<Execution>) -> Outcome {
    handle execution { Result::Err(_) => outcome, Result::Ok(execution) => Outcome {
        cell: outcome.cell, revision: outcome.revision, identity: outcome.identity, product: outcome.product,
        fingerprint: outcome.fingerprint, completeness: outcome.completeness, execution: execution } }
}

fn record_execution(engine: &mut Engine, key: Handle, execution: Execution) -> () {
    handle storage::get_mut(&mut engine.cells, key) {
        Result::Err(_) => (),
        Result::Ok(cell) => handle cell.state {
            CellState::Pending { owner: _ } => (),
            CellState::Ready { memo: memo, execution: _ } => {
                (*cell).state = CellState::Ready { memo: memo, execution: execution };
            },
        },
    }
}

fn track_parent(engine: &mut Engine, parent: Option<Ticket>, read: Read) -> Result<(), Failure> {
    handle parent { Result::Err(_) => Result::Ok(()), Result::Ok(parent) => observe(&mut *engine, parent, read) }
}

pub fn observe(engine: &mut Engine, ticket: Ticket, read: Read) -> Result<(), Failure> {
    let result = observe_checked(&mut *engine, ticket, read);
    handle result { Result::Ok(_) => Result::Ok(()),
        Result::Err(error) => { abort(&mut *engine, ticket); Result::Err(error) } }
}

fn observe_checked(engine: &mut Engine, ticket: Ticket, read: Read) -> Result<(), Failure> {
    handle info(& *engine, ticket) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(info) => handle check(& *engine, info.request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle recovery(& *engine, info.request, Key { identity: info.key.identity }, read.completeness) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => observe_allowed(&mut *engine, ticket, info, read),
            },
        },
    }
}

fn observe_allowed(engine: &mut Engine, ticket: Ticket, info: Info, read: Read) -> Result<(), Failure> {
    handle controls(& *engine, info.request) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(controls) => handle info.phase {
                Phase::Checking => validate_read(&mut *engine, ticket, info, &controls, read),
                Phase::Computing => record_read(&mut *engine, ticket, &controls, read),
                _ => Result::Err(Failure::Invariant),
        },
    }
}

fn record_read(engine: &mut Engine, ticket: Ticket, controls: &operation::Controls, read: Read) -> Result<(), Failure> {
    handle storage::get_mut(&mut engine.attempts, ticket.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(attempt) => handle query::record(&mut attempt.frame, controls, read) {
            Result::Err(error) => Result::Err(Failure::Query(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}

fn validate_only(engine: &mut Engine, ticket: Ticket, controls: &operation::Controls, read: Read) -> Result<query::Validation, Failure> {
    handle storage::get_mut(&mut engine.attempts, ticket.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(attempt) => handle Result::as_mut(&mut attempt.replay) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(replay) => handle query::validate(replay, controls, read) {
                Result::Err(error) => Result::Err(Failure::Query(error)), Result::Ok(value) => Result::Ok(value),
            },
        },
    }
}

fn validate_read(engine: &mut Engine, ticket: Ticket, info: Info, controls: &operation::Controls, read: Read) -> Result<(), Failure> {
    handle validate_only(&mut *engine, ticket, controls, read) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(query::Validation::Changed { index: _ }) => handle request_info(& *engine, info.request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok((_, parent)) => handle parent {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(parent) => handle compute(&mut *engine, ticket, Reason::ParentReuseRejected { parent: parent }) {
                    Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(()),
                },
            },
        },
        Result::Ok(_) => record_read(&mut *engine, ticket, controls, read),
    }
}

// Commit and delivery are separate steps. A parent rejecting a child's
// recovery, or a cancellation after commit, cannot erase that valid child.
pub fn publish(engine: &mut Engine, ticket: Ticket, product: Handle, fingerprint: Digest, completeness: Completeness)
    -> Result<(), Failure> {
    let result = publish_checked(&mut *engine, ticket, product, fingerprint, completeness, PublicationMode::Fresh);
    handle result { Result::Ok(_) => Result::Ok(()),
        Result::Err(error) => { abort(&mut *engine, ticket); Result::Err(error) } }
}

// Only validated reuse may publish an existing product. A provider cannot
// substitute a fresh value/fingerprint while retaining reuse provenance.
pub fn publish_reused(engine: &mut Engine, ticket: Ticket, product: Handle) -> Result<(), Failure> {
    let result = reuse_checked(&mut *engine, ticket, product);
    handle result { Result::Ok(_) => Result::Ok(()),
        Result::Err(error) => { abort(&mut *engine, ticket); Result::Err(error) } }
}

fn reuse_checked(engine: &mut Engine, ticket: Ticket, product: Handle) -> Result<(), Failure> {
    handle candidate(& *engine, ticket) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(candidate) => handle storage::equal(product, candidate.product) {
            false => Result::Err(Failure::Foreign),
            true => publish_checked(&mut *engine, ticket, product, candidate.fingerprint,
                candidate.completeness, PublicationMode::Reused),
        },
    }
}

fn publish_checked(engine: &mut Engine, ticket: Ticket, product: Handle, fingerprint: Digest, completeness: Completeness,
    mode: PublicationMode)
    -> Result<(), Failure> {
    handle info(& *engine, ticket) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(info) => handle check(& *engine, info.request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => handle publish_phase(& *engine, ticket, info, mode) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => handle freeze(&mut *engine, ticket, product, fingerprint, completeness) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(pending) => install(&mut *engine, ticket, info, pending),
                },
            },
        },
    }
}

fn publish_phase(engine: &Engine, ticket: Ticket, info: Info, mode: PublicationMode) -> Result<(), Failure> {
    handle mode {
        PublicationMode::Fresh => handle info.phase { Phase::Computing => Result::Ok(()), _ => Result::Err(Failure::Busy) },
        PublicationMode::Reused => handle info.phase {
        Phase::Checking => handle controls(engine, info.request) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(controls) => handle expected(engine, ticket, &controls) {
                Result::Ok(Result::Err(_)) => Result::Ok(()), _ => Result::Err(Failure::Busy),
            },
        },
        _ => Result::Err(Failure::Busy),
        },
    }
}

fn freeze(engine: &mut Engine, ticket: Ticket, product: Handle, fingerprint: Digest, completeness: Completeness)
    -> Result<transaction::Publication<query::Memo<Handle>>, Failure> {
    handle storage::get_mut(&mut engine.attempts, ticket.handle) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(attempt) => handle query::freeze(&mut attempt.frame, product, fingerprint, completeness) {
            Result::Err(error) => Result::Err(Failure::Query(error)), Result::Ok(pending) => Result::Ok(pending),
        },
    }
}

fn install(engine: &mut Engine, ticket: Ticket, info: Info, pending: transaction::Publication<query::Memo<Handle>>) -> Result<(), Failure> {
    handle controls(& *engine, info.request) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(controls) => handle transaction::publish(&mut pending, &controls) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(memo) => handle recovery(& *engine, info.request, Key { identity: info.key.identity }, memo.completeness) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => commit_cell(&mut *engine, ticket, info, memo),
            },
        },
    }
}

fn commit_cell(engine: &mut Engine, ticket: Ticket, info: Info, memo: query::Memo<Handle>) -> Result<(), Failure> {
    handle info.cell {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(key) => handle execution(& *engine, ticket) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(execution) => {
                let edges = query::read_count(&memo);
                handle storage::get_mut(&mut engine.cells, key) {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(cell) => {
                        (*cell).state = CellState::Ready { memo: memo, execution: execution };
                        (*engine).stats.memos = engine.stats.memos + 1;
                        (*engine).stats.edges = engine.stats.edges + edges;
                        (*engine).stats.explanations = engine.stats.explanations + 1;
                        transition(&mut *engine, ticket, Phase::Deliver);
                        Result::Ok(())
                    },
                }
            },
        },
    }
}

fn execution(engine: &Engine, ticket: Ticket) -> Result<Execution, Failure> {
    handle storage::get(&engine.attempts, ticket.handle) {
        Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(attempt) => Result::Ok(attempt.execution),
    }
}

pub fn candidate(engine: &Engine, ticket: Ticket) -> Result<Outcome, Failure> {
    handle info(engine, ticket) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(info) => handle info.candidate { Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(cell) => ready(engine, cell) },
    }
}

pub fn product(engine: &Engine, session: Session, outcome: Outcome) -> Result<Handle, Failure> {
    handle check(engine, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle request_info(engine, session) {
            Result::Err(error) => Result::Err(error),
            Result::Ok((revision, _)) => handle identity::same_revision(revision, outcome.revision) {
                false => Result::Err(Failure::Foreign),
                true => handle ready(engine, outcome.cell) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(current) => handle recovery(engine, session, Key { identity: current.identity }, current.completeness) {
                        Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(current.product),
                    },
                },
            },
        },
    }
}

pub fn abort(engine: &mut Engine, ticket: Ticket) -> () {
    handle info(& *engine, ticket) {
        Result::Err(_) => (),
        Result::Ok(info) => {
            discard_pending(&mut *engine, ticket, info.cell);
            release_attempt(&mut *engine, ticket);
        },
    }
}

fn discard_pending(engine: &mut Engine, ticket: Ticket, cell: Option<Handle>) -> () {
    handle cell {
        Result::Err(_) => (),
        Result::Ok(key) => handle pending_owned(& *engine, key, ticket) {
            false => (),
            true => handle storage::remove(&mut engine.cells, key) {
                Result::Err(_) => (), Result::Ok(cell) => { HashMap::remove(&mut engine.index, &cell.key); () },
            },
        },
    }
}

fn pending_owned(engine: &Engine, key: Handle, ticket: Ticket) -> Bool {
    handle storage::get(&engine.cells, key) {
        Result::Err(_) => false,
        Result::Ok(cell) => handle cell.state {
            CellState::Ready { memo: _, execution: _ } => false,
            CellState::Pending { owner: owner } => storage::equal(owner.handle, ticket.handle),
        },
    }
}

fn release_attempt(engine: &mut Engine, ticket: Ticket) -> () {
    handle storage::remove(&mut engine.attempts, ticket.handle) {
        Result::Err(_) => (),
        Result::Ok(attempt) => handle storage::get_mut(&mut engine.sessions, attempt.request.handle) {
            Result::Err(_) => (),
            Result::Ok(request) => {
                (*request).attempts = request.attempts - 1;
                (*engine).stats.attempts = engine.stats.attempts - 1;
            },
        },
    }
}

pub fn stats(engine: &Engine) -> Stats { engine.stats }

// Called only after the history proves that the retired revision has no pins.
// The facade releases each returned typed product owner before the next step.
pub fn discard_step(engine: &mut Engine, revision: RevisionId, cursor: usize) -> Result<Discard, Failure> {
    handle cursor < storage::slot_count(&engine.cells) {
        false => { dependency::remove_revision(&mut engine.ledger, revision); Result::Ok(Discard::Done) },
        true => handle storage::key_at(&engine.cells, cursor) {
            Result::Err(_) => Result::Ok(Discard::Next { cursor: cursor + 1, product: None, edges: 0 }),
            Result::Ok(key) => handle discardable(& *engine, key, revision) {
                false => Result::Ok(Discard::Next { cursor: cursor + 1, product: None, edges: 0 }),
                true => discard_cell(&mut *engine, key, cursor + 1),
            },
        },
    }
}

fn discardable(engine: &Engine, key: Handle, revision: RevisionId) -> Bool {
    handle storage::get(&engine.cells, key) {
        Result::Err(_) => false,
        Result::Ok(cell) => handle identity::same_revision(cell.key.revision, revision) {
            false => false,
            true => handle cell.state { CellState::Ready { memo: _, execution: _ } => true,
                CellState::Pending { owner: _ } => false },
        },
    }
}

fn discard_cell(engine: &mut Engine, key: Handle, cursor: usize) -> Result<Discard, Failure> {
    handle storage::remove(&mut engine.cells, key) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(cell) => {
            HashMap::remove(&mut engine.index, &cell.key);
            handle cell.state {
                CellState::Pending { owner: _ } => Result::Err(Failure::Invariant),
                CellState::Ready { memo: memo, execution: _ } => {
                    let edges = query::read_count(&memo);
                    (*engine).stats.memos = engine.stats.memos - 1;
                    (*engine).stats.edges = engine.stats.edges - edges;
                    (*engine).stats.explanations = engine.stats.explanations - 1;
                    Result::Ok(Discard::Next { cursor: cursor, product: Result::Ok(memo.value), edges: edges })
                },
            }
        },
    }
}
