use std::*;
use super::identity;
use super::identity::Digest;
use super::storage;
use super::storage::Handle;
use super::operation;
use super::transaction;

pub enum Completeness { Complete, Recovered }
pub enum RecoveryPolicy { Reject, Allow }
pub enum Failure {
    Closed, Capacity, ChangedRead, Invariant, RecoveredProduct, Control(operation::Failure),
}

// The family adapter interns its exact typed key, not just its fingerprint.
// A read carries that checked owner/generation-qualified identity. Projection
// names are assigned by the source registry, never by native callbacks.
pub struct ReadIdentity { private family: u32, private key: Handle, private projection: u32 }
pub struct Read { identity: ReadIdentity, fingerprint: Digest, completeness: Completeness }
pub struct Frame {
    private journal: Option<Journal>, private policy: RecoveryPolicy, private limit: usize,
}
struct Journal {
    reads: Vec<Read>, seen: HashMap<ReadIdentity, usize>, completeness: Completeness,
}
pub struct Memo<V> {
    value: V, fingerprint: Digest, completeness: Completeness, private reads: Vec<Read>,
}
impl<V> Use<[0, 1]> for Memo<V> where V: Use<[0, 1]> {}

pub impl Eq for ReadIdentity {
    eq(left: &ReadIdentity, right: &ReadIdentity) -> Bool { same(*left, *right) }
}
pub impl Hash for ReadIdentity {
    hash(value: &ReadIdentity, state: &mut Hasher) -> () {
        Hasher::write_usize(&mut *state, as<usize>(value.family));
        storage::hash(value.key, &mut *state);
        Hasher::write_usize(&mut *state, as<usize>(value.projection));
    }
}

pub fn read_identity(family: u32, key: Handle, projection: u32) -> ReadIdentity {
    ReadIdentity { family: family, key: key, projection: projection }
}

pub fn same(left: ReadIdentity, right: ReadIdentity) -> Bool {
    handle left.family == right.family {
        false => false,
        true => handle left.projection == right.projection {
            false => false,
            true => storage::equal(left.key, right.key),
        },
    }
}

pub fn permits(policy: RecoveryPolicy, completeness: Completeness) -> Bool {
    handle completeness {
        Completeness::Complete => true,
        Completeness::Recovered => handle policy { RecoveryPolicy::Allow => true, RecoveryPolicy::Reject => false },
    }
}

fn join(left: Completeness, right: Completeness) -> Completeness {
    handle left { Completeness::Recovered => Completeness::Recovered, Completeness::Complete => right }
}

pub fn equally_complete(left: Completeness, right: Completeness) -> Bool {
    handle left {
        Completeness::Complete => handle right { Completeness::Complete => true, Completeness::Recovered => false },
        Completeness::Recovered => handle right { Completeness::Complete => false, Completeness::Recovered => true },
    }
}

pub fn frame(policy: RecoveryPolicy, limit: usize) -> Frame {
    Frame { journal: Result::Ok(Journal { reads: Vec::new(), seen: HashMap::new(),
        completeness: Completeness::Complete }), policy: policy, limit: limit }
}

pub fn abort(frame: &mut Frame) -> () { (*frame).journal = None; }

pub fn record(frame: &mut Frame, controls: &operation::Controls, read: Read) -> Result<(), Failure> {
    let result = record_checked(&mut *frame, controls, read);
    handle result {
        Result::Ok(_) => Result::Ok(()),
        Result::Err(error) => { abort(&mut *frame); Result::Err(error) },
    }
}

fn record_checked(frame: &mut Frame, controls: &operation::Controls, read: Read) -> Result<(), Failure> {
    handle operation::check(controls) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle permits(frame.policy, read.completeness) {
            false => Result::Err(Failure::RecoveredProduct),
            true => handle Result::as_mut(&mut frame.journal) {
                Result::Err(_) => Result::Err(Failure::Closed),
                Result::Ok(journal) => record_open(journal, read, frame.limit),
            },
        },
    }
}

fn previous(journal: &Journal, key: ReadIdentity) -> Option<usize> {
    handle HashMap::get(&journal.seen, &key) {
        Result::Err(_) => None,
        Result::Ok(index) => Result::Ok(*index),
    }
}

fn consistent(old: &Read, current: &Read) -> Bool {
    handle identity::equal(old.fingerprint, current.fingerprint) {
        false => false,
        true => equally_complete(old.completeness, current.completeness),
    }
}

fn record_open(journal: &mut Journal, read: Read, limit: usize) -> Result<(), Failure> {
    handle previous(& *journal, read.identity) {
        Result::Ok(index) => handle consistent(Vec::get_unchecked(&journal.reads, index), &read) {
            false => Result::Err(Failure::Invariant),
            true => Result::Ok(()),
        },
        Result::Err(_) => handle Vec::len(&journal.reads) < limit {
            false => Result::Err(Failure::Capacity),
            true => {
                HashMap::insert(&mut journal.seen, read.identity, Vec::len(&journal.reads));
                (*journal).completeness = join(journal.completeness, read.completeness);
                Vec::push(&mut journal.reads, read);
                Result::Ok(())
            },
        },
    }
}

// Freeze consumes the frame once. Publication holds the complete payload and
// ordered journal together; a late cancellation discards both via Transaction.
pub fn freeze<V>(frame: &mut Frame, value: V, fingerprint: Digest, declared: Completeness)
    -> Result<transaction::Publication<Memo<V>>, Failure> where V: Use<[0, 1]> {
    handle Option::take(&mut frame.journal) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(journal) => prepare(frame.policy, journal, value, fingerprint, declared),
    }
}

fn prepare<V>(policy: RecoveryPolicy, journal: Journal, value: V, fingerprint: Digest, declared: Completeness)
    -> Result<transaction::Publication<Memo<V>>, Failure> where V: Use<[0, 1]> {
    let completeness = join(journal.completeness, declared);
    handle permits(policy, completeness) {
        false => Result::Err(Failure::RecoveredProduct),
        true => Result::Ok(transaction::stage(Memo { value: value, fingerprint: fingerprint,
            completeness: completeness, reads: journal.reads })),
    }
}

pub fn read_count<V>(memo: &Memo<V>) -> usize { Vec::len(&memo.reads) }

// Read-only roots for the registry's stopped-world interner collection. Read
// identities are small checked values; no journal vector is materialized.
pub fn frame_read(frame: &Frame, index: usize) -> Option<ReadIdentity> {
    handle Result::as_ref(&frame.journal) {
        Result::Err(_) => None,
        Result::Ok(journal) => read_at(&journal.reads, index),
    }
}
pub fn memo_read<V>(memo: &Memo<V>, index: usize) -> Option<ReadIdentity> { read_at(&memo.reads, index) }
pub fn observation<V>(memo: &Memo<V>, index: usize) -> Option<Read> {
    handle Vec::get(&memo.reads, index) { Result::Err(_) => None, Result::Ok(read) => Result::Ok(*read) }
}
fn read_at(reads: &Vec<Read>, index: usize) -> Option<ReadIdentity> {
    handle Vec::get(reads, index) { Result::Err(_) => None, Result::Ok(read) => Result::Ok(read.identity) }
}

pub fn family(read: ReadIdentity) -> u32 { read.family }
pub fn key(read: ReadIdentity) -> Handle { read.key }
pub fn projection(read: ReadIdentity) -> u32 { read.projection }

enum ReplayState { Checking, Changed }
pub struct Replay { private reads: Vec<Read>, private cursor: usize, private state: ReplayState }
pub fn replay_read(replay: &Replay, index: usize) -> Option<ReadIdentity> { read_at(&replay.reads, index) }
pub enum Validation { Continue, Complete, Changed { index: usize } }

// Replay owns immutable reads, not a borrowed database view. The scheduler
// must separately prove immediate-parent ownership and family generations.
pub fn replay<V>(memo: &Memo<V>) -> Replay {
    Replay { reads: memo.reads, cursor: 0, state: ReplayState::Checking }
}

pub fn next(replay: &Replay, controls: &operation::Controls) -> Result<Option<Read>, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle replay.state {
            ReplayState::Changed => Result::Err(Failure::ChangedRead),
            ReplayState::Checking => handle Vec::get(&replay.reads, replay.cursor) {
                Result::Err(_) => Result::Ok(None),
                Result::Ok(read) => Result::Ok(Result::Ok(*read)),
            },
        },
    }
}

pub fn validate(replay: &mut Replay, controls: &operation::Controls, observed: Read) -> Result<Validation, Failure> {
    handle next(& *replay, controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(read) => handle read {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(expected) => handle same(expected.identity, observed.identity) {
                false => Result::Err(Failure::Invariant),
                true => handle consistent(&expected, &observed) {
                    false => {
                        (*replay).state = ReplayState::Changed;
                        Result::Ok(Validation::Changed { index: replay.cursor })
                    },
                    true => {
                        (*replay).cursor = replay.cursor + 1;
                        Result::Ok(validation_status(& *replay))
                    },
                },
            },
        },
    }
}

fn validation_status(replay: &Replay) -> Validation {
    handle replay.cursor == Vec::len(&replay.reads) {
        true => Validation::Complete,
        false => Validation::Continue,
    }
}
