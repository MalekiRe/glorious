use std::*;

// Handles are local to one owning store. A slot's generation changes before
// it is reused, so releasing a value cannot make an old handle valid again.
pub struct Handle { private database: u64, private owner: u64, private slot: usize, private generation: u64 }
pub struct Slot<T> { private generation: u64, private value: Option<T> }
pub struct Arena<T> {
    private database: u64,
    private owner: u64,
    private slots: Vec<Slot<T>>,
    private free: Vec<usize>,
    private live: usize,
    private limit: usize,
}
// Copying an owning arena would duplicate its namespace and generation table,
// allowing the same handle to identify two independently mutated stores.
// Handles are duplicable; the storage owner itself is affine.
pub impl<T> Use<[0, 1]> for Arena<T> where T: Use<[0, 1]> {}
pub enum StorageError { ForeignOwner, StaleHandle, Capacity }

pub fn belongs_to(key: Handle, database: u64, owner: u64) -> Bool {
    handle key.database == database { false => false, true => key.owner == owner }
}

pub fn equal(left: Handle, right: Handle) -> Bool {
    handle left.database == right.database {
        false => false,
        true => handle left.owner == right.owner {
            false => false,
            true => handle left.slot == right.slot {
                false => false,
                true => left.generation == right.generation,
            },
        },
    }
}

pub fn hash(key: Handle, state: &mut Hasher) -> () {
    Hasher::write_usize(&mut *state, as<usize>(key.database));
    Hasher::write_usize(&mut *state, as<usize>(key.owner));
    Hasher::write_usize(&mut *state, key.slot);
    Hasher::write_usize(&mut *state, as<usize>(key.generation));
}

pub fn create<T>(owner: u64) -> Arena<T> {
    bounded(owner, 4294967295)
}

pub fn bounded<T>(owner: u64, limit: usize) -> Arena<T> {
    namespace(0, owner, limit)
}

pub fn namespace<T>(database: u64, owner: u64, limit: usize) -> Arena<T> {
    Arena { database: database, owner: owner, slots: Vec::new(), free: Vec::new(), live: 0, limit: limit }
}

pub fn count<T>(arena: &Arena<T>) -> usize { arena.live }

pub fn insert<T>(arena: &mut Arena<T>, value: T) -> Result<Handle, StorageError>
    where T: Use<[0, 1]> {
    handle Vec::pop(&mut arena.free) {
        Result::Ok(index) => {
            let entry = Vec::get_mut(&mut arena.slots, index);
            handle entry {
                Result::Ok(entry) => {
                    let generation = entry.generation;
                    (*entry).value = Result::Ok(value);
                    (*arena).live = arena.live + 1;
                    Result::Ok(Handle { database: arena.database, owner: arena.owner, slot: index, generation: generation })
                },
                Result::Err(_) => Result::Err(StorageError::StaleHandle),
            }
        },
        Result::Err(_) => {
            let index = Vec::len(&arena.slots);
            handle index < arena.limit {
                false => Result::Err(StorageError::Capacity),
                true => {
                    Vec::push(&mut arena.slots, Slot { generation: 0, value: Result::Ok(value) });
                    (*arena).live = arena.live + 1;
                    Result::Ok(Handle { database: arena.database, owner: arena.owner, slot: index, generation: 0 })
                },
            }
        },
    }
}

pub fn get_mut<'a, T>(arena: &'a mut Arena<T>, key: Handle) -> Result<&'a mut T, StorageError> {
    handle valid(& *arena, key) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(index) => handle Vec::get_mut(&mut arena.slots, index) {
            Result::Err(_) => Result::Err(StorageError::StaleHandle),
            Result::Ok(entry) => handle Result::as_mut(&mut entry.value) {
                Result::Ok(value) => Result::Ok(value),
                Result::Err(_) => Result::Err(StorageError::StaleHandle),
            },
        },
    }
}

pub fn slot_count<T>(arena: &Arena<T>) -> usize { Vec::len(&arena.slots) }

pub fn key_at<T>(arena: &Arena<T>, index: usize) -> Option<Handle> {
    handle Vec::get(&arena.slots, index) {
        Result::Err(_) => None,
        Result::Ok(entry) => handle Result::as_ref(&entry.value) {
            Result::Err(_) => None,
            Result::Ok(_) => Result::Ok(Handle { database: arena.database, owner: arena.owner, slot: index, generation: entry.generation }),
        },
    }
}

pub fn valid<T>(arena: &Arena<T>, key: Handle) -> Result<usize, StorageError> {
    handle key.database == arena.database {
        false => Result::Err(StorageError::ForeignOwner),
        true => valid_owner(arena, key),
    }
}

fn valid_owner<T>(arena: &Arena<T>, key: Handle) -> Result<usize, StorageError> {
    handle key.owner == arena.owner {
        false => Result::Err(StorageError::ForeignOwner),
        true => handle Vec::get(&arena.slots, key.slot) {
            Result::Err(_) => Result::Err(StorageError::StaleHandle),
            Result::Ok(entry) => handle entry.generation == key.generation {
                false => Result::Err(StorageError::StaleHandle),
                true => handle Result::as_ref(&entry.value) {
                    Result::Err(_) => Result::Err(StorageError::StaleHandle),
                    Result::Ok(_) => Result::Ok(key.slot),
                },
            },
        },
    }
}

pub fn get<'a, T>(arena: &'a Arena<T>, key: Handle) -> Result<&'a T, StorageError> {
    handle valid(arena, key) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(index) => {
            let entry = Vec::get_unchecked(&arena.slots, index);
            handle Result::as_ref(&entry.value) {
                Result::Ok(value) => Result::Ok(value),
                Result::Err(_) => Result::Err(StorageError::StaleHandle),
            }
        },
    }
}

pub fn remove<T>(arena: &mut Arena<T>, key: Handle) -> Result<T, StorageError> {
    handle valid(& *arena, key) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(index) => handle Vec::get_mut(&mut arena.slots, index) {
            Result::Err(_) => Result::Err(StorageError::StaleHandle),
            Result::Ok(entry) => {
                let value = Option::take(&mut entry.value);
                let reusable = advance_generation(&mut entry.generation);
                recycle(&mut arena.free, index, reusable);
                (*arena).live = arena.live - 1;
                handle value {
                    Result::Ok(value) => Result::Ok(value),
                    Result::Err(_) => Result::Err(StorageError::StaleHandle),
                }
            },
        },
    }
}

fn advance_generation(generation: &mut u64) -> Bool {
    handle *generation == 18446744073709551615 {
        true => false,
        false => { *generation = wrapping_add(*generation, 1); true },
    }
}

fn recycle(free: &mut Vec<usize>, index: usize, reusable: Bool) -> () {
    handle reusable {
        true => Vec::push(&mut *free, index),
        false => (),
    }
}
