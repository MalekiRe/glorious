use std::*;
use super::identity;
use super::identity::Digest;
use super::identity::FileKey;
use super::operation;

pub enum Severity { Error, Warning, Note }
pub enum Class { Request, InputCorruption, Source, Recovery, Resource, Cancellation, Cache, Invariant, Verification, Runtime }
pub struct Span { file: FileKey, start: u32, end: u32 }
pub struct Related { label: String, span: Span }
pub struct Fact { name: String, value: String }
pub struct Explanation { kind: String, message: String }
pub struct CompileDiagnostic {
    code: String, class: Class, severity: Severity, message: String, primary: Option<Span>,
    input_fingerprint: Option<Digest>, related: Vec<Related>, facts: Vec<Fact>, explanation: Vec<Explanation>,
}
pub struct Limits { diagnostics: usize, provenance: usize }
pub struct Policy { validate_spans: Bool, error_limit: Option<usize>, input_fingerprint: Option<Digest> }
pub enum Failure { Closed, Busy, Capacity, Invariant, Control(operation::Failure) }
pub enum Event { Continue, Validate(Span), Ready }
pub struct Batch { private values: Vec<CompileDiagnostic> }
pub struct Builder { private limits: Limits, private work: Option<Work> }
pub impl Use<[0, 1]> for Builder {}
enum Order { Identity, Presentation }
enum Cursor { Sort { outer: usize, inner: usize }, Dedup { read: usize, write: usize }, Trim { length: usize }, Done, Invalid }
enum Phase {
    Recording, Primary { item: usize }, Related { item: usize, edge: usize },
    Awaiting { item: usize, next_edge: usize, span: Span },
    Sorting { order: Order, outer: usize, inner: usize }, Merge { item: usize },
    Appending { item: usize, part: usize, edge: usize },
    Provenance { item: usize, part: usize, cursor: Cursor },
    Count { item: usize, errors: usize }, Limit { item: usize, kept: usize, suppressed: usize }, Done,
}
struct Work {
    values: Vec<CompileDiagnostic>, output: Vec<CompileDiagnostic>, phase: Phase,
    policy: Policy, provenance: usize, limited: Bool,
}

pub fn severity(value: Severity) -> u32 { handle value { Severity::Error => 0, Severity::Warning => 1, Severity::Note => 2 } }
pub fn class(value: Class) -> u32 {
    handle value {
        Class::Request => 0, Class::InputCorruption => 1, Class::Source => 2, Class::Recovery => 3,
        Class::Resource => 4, Class::Cancellation => 5, Class::Cache => 6, Class::Invariant => 7,
        Class::Verification => 8, Class::Runtime => 9,
    }
}
pub fn compare_span(left: &Span, right: &Span) -> Ordering {
    handle identity::compare_digest(left.file.digest, right.file.digest) {
        Ordering::Equal => handle Ord::compare(&left.start, &right.start) {
            Ordering::Equal => Ord::compare(&left.end, &right.end), order => order,
        },
        order => order,
    }
}
fn compare_primary(left: Option<Span>, right: Option<Span>) -> Ordering {
    handle left {
        Result::Err(_) => handle right { Result::Err(_) => Ordering::Equal, _ => Ordering::Less },
        Result::Ok(left) => handle right { Result::Err(_) => Ordering::Greater, Result::Ok(right) => compare_span(&left, &right) },
    }
}
pub fn compare_fact(left: &CompileDiagnostic, right: &CompileDiagnostic) -> Ordering {
    handle identity::compare_text(&left.code, &right.code) {
        Ordering::Equal => fact_class(left, right), order => order,
    }
}
fn fact_class(left: &CompileDiagnostic, right: &CompileDiagnostic) -> Ordering {
    let a = class(left.class);
    let b = class(right.class);
    handle Ord::compare(&a, &b) {
        Ordering::Equal => handle compare_severity(left.severity, right.severity) {
            Ordering::Equal => handle compare_primary(left.primary, right.primary) {
                Ordering::Equal => identity::compare_text(&left.message, &right.message), order => order,
            },
            order => order,
        },
        order => order,
    }
}
fn compare_severity(left: Severity, right: Severity) -> Ordering {
    let a = severity(left);
    let b = severity(right);
    Ord::compare(&a, &b)
}
fn absent(primary: Option<Span>) -> u32 { handle primary { Result::Err(_) => 1, Result::Ok(_) => 0 } }
pub fn compare_presentation(left: &CompileDiagnostic, right: &CompileDiagnostic) -> Ordering {
    let a = absent(left.primary);
    let b = absent(right.primary);
    handle Ord::compare(&a, &b) {
        Ordering::Equal => handle compare_primary(left.primary, right.primary) {
            Ordering::Equal => handle compare_severity(left.severity, right.severity) {
                Ordering::Equal => compare_fact(left, right), order => order,
            },
            order => order,
        },
        order => order,
    }
}
pub impl Ord for Related {
    compare(left: &Related, right: &Related) -> Ordering {
        handle identity::compare_text(&left.label, &right.label) { Ordering::Equal => compare_span(&left.span, &right.span), order => order }
    }
}
pub impl Ord for Fact {
    compare(left: &Fact, right: &Fact) -> Ordering {
        handle identity::compare_text(&left.name, &right.name) { Ordering::Equal => identity::compare_text(&left.value, &right.value), order => order }
    }
}
pub impl Ord for Explanation {
    compare(left: &Explanation, right: &Explanation) -> Ordering {
        handle identity::compare_text(&left.kind, &right.kind) { Ordering::Equal => identity::compare_text(&left.message, &right.message), order => order }
    }
}

pub fn begin(limits: Limits, policy: Policy) -> Builder {
    Builder { limits: limits, work: Result::Ok(Work { values: Vec::new(), output: Vec::new(), phase: Phase::Recording,
        policy: policy, provenance: 0, limited: false }) }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
fn charge(builder: &mut Builder, controls: &mut operation::Controls) -> Result<(), Failure> {
    handle operation::charge(controls, 1) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) }, Result::Ok(_) => Result::Ok(()),
    }
}
fn add(count: usize, amount: usize, limit: usize) -> Result<usize, Failure> {
    handle count <= limit {
        false => Result::Err(Failure::Capacity),
        true => handle amount <= limit - count { false => Result::Err(Failure::Capacity), true => Result::Ok(count + amount) },
    }
}
fn provenance_count(work: &Work, value: &CompileDiagnostic, limit: usize) -> Result<usize, Failure> {
    handle add(work.provenance, Vec::len(&value.related), limit) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(count) => handle add(count, Vec::len(&value.facts), limit) {
            Result::Err(error) => Result::Err(error), Result::Ok(count) => add(count, Vec::len(&value.explanation), limit),
        },
    }
}
pub fn record(builder: &mut Builder, controls: &mut operation::Controls, value: CompileDiagnostic) -> Result<(), Failure> {
    let result = record_checked(&mut *builder, controls, value);
    handle result { Result::Ok(_) => Result::Ok(()), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
fn record_checked(builder: &mut Builder, controls: &mut operation::Controls, value: CompileDiagnostic) -> Result<(), Failure> {
    handle charge(&mut *builder, controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase {
                Phase::Recording => record_open(work, builder.limits, value), _ => Result::Err(Failure::Busy),
            },
        },
    }
}
fn record_open(work: &mut Work, limits: Limits, value: CompileDiagnostic) -> Result<(), Failure> {
    handle Vec::len(&work.values) < limits.diagnostics {
        false => Result::Err(Failure::Capacity),
        true => handle provenance_count(& *work, &value, limits.provenance) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(count) => {
                (*work).provenance = count;
                Vec::push(&mut work.values, value);
                Result::Ok(())
            },
        },
    }
}
pub fn seal(builder: &mut Builder) -> Result<(), Failure> {
    let result = seal_checked(&mut *builder);
    handle result { Result::Ok(_) => Result::Ok(()), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
fn seal_checked(builder: &mut Builder) -> Result<(), Failure> {
    handle Result::as_mut(&mut builder.work) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(work) => handle work.phase {
            Phase::Recording => { (*work).phase = Phase::Primary { item: 0 }; Result::Ok(()) },
            _ => Result::Err(Failure::Busy),
        },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = step_checked(&mut *builder, controls);
    handle result { Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
fn step_checked(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle charge(&mut *builder, controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(work) => advance(work),
        },
    }
}
fn sorting(order: Order) -> Phase { Phase::Sorting { order: order, outer: 1, inner: 1 } }
fn cursor() -> Cursor { Cursor::Sort { outer: 1, inner: 1 } }
fn next(work: &mut Work, phase: Phase) -> Result<Event, Failure> { (*work).phase = phase; Result::Ok(Event::Continue) }
fn advance(work: &mut Work) -> Result<Event, Failure> {
    handle work.phase {
        Phase::Recording => Result::Err(Failure::Busy),
        Phase::Primary { item: item } => primary(work, item),
        Phase::Related { item: item, edge: edge } => related(work, item, edge),
        Phase::Awaiting { item: _, next_edge: _, span: span } => Result::Ok(Event::Validate(span)),
        Phase::Sorting { order: order, outer: outer, inner: inner } => sort_values(work, order, outer, inner),
        Phase::Merge { item: item } => merge(work, item),
        Phase::Appending { item: item, part: part, edge: edge } => append_provenance(work, item, part, edge),
        Phase::Provenance { item: item, part: part, cursor: cursor } => provenance(work, item, part, cursor),
        Phase::Count { item: item, errors: errors } => count_errors(work, item, errors),
        Phase::Limit { item: item, kept: kept, suppressed: suppressed } => limit_errors(work, item, kept, suppressed),
        Phase::Done => Result::Ok(Event::Ready),
    }
}
fn primary(work: &mut Work, item: usize) -> Result<Event, Failure> {
    handle Vec::get_mut(&mut work.values, item) {
        Result::Err(_) => next(work, sorting(Order::Identity)),
        Result::Ok(value) => {
            bind_fingerprint(&mut *value, work.policy.input_fingerprint);
            handle work.policy.validate_spans {
                false => next(work, Phase::Primary { item: item + 1 }),
                true => handle value.primary {
                    Result::Err(_) => next(work, Phase::Related { item: item, edge: 0 }),
                    Result::Ok(span) => await_span(work, item, 0, span),
                },
            }
        },
    }
}
fn bind_fingerprint(value: &mut CompileDiagnostic, fingerprint: Option<Digest>) -> () {
    handle fingerprint { Result::Err(_) => (), Result::Ok(digest) => { (*value).input_fingerprint = Result::Ok(digest); } }
}
fn await_span(work: &mut Work, item: usize, edge: usize, span: Span) -> Result<Event, Failure> {
    (*work).phase = Phase::Awaiting { item: item, next_edge: edge, span: span };
    Result::Ok(Event::Validate(span))
}
fn related(work: &mut Work, item: usize, edge: usize) -> Result<Event, Failure> {
    let value = Vec::get_unchecked(&work.values, item);
    handle Vec::get(&value.related, edge) {
        Result::Err(_) => next(work, Phase::Primary { item: item + 1 }),
        Result::Ok(related) => await_span(work, item, edge + 1, related.span),
    }
}
fn valid_span(span: Span, length: Option<u32>) -> Bool {
    handle length {
        Result::Err(_) => false,
        Result::Ok(length) => handle span.start <= span.end { false => false, true => span.end <= length },
    }
}
fn bare(code: Str, message: String, class: Class, fingerprint: Option<Digest>) -> CompileDiagnostic {
    CompileDiagnostic { code: Str::to_string(code), message: message, class: class, severity: Severity::Error,
        primary: None, input_fingerprint: fingerprint, related: Vec::new(), facts: Vec::new(), explanation: Vec::new() }
}
fn invalid(value: &CompileDiagnostic) -> CompileDiagnostic {
    let message = Str::to_string("compiler produced diagnostic ");
    String::push_str(&mut message, String::as_str(&value.code));
    String::push_str(&mut message, " with an invalid source provenance span");
    bare("G7014", message, Class::Invariant, value.input_fingerprint)
}
// The request adapter resolves this file in its pinned source world. The
// builder itself checks both endpoints and never accepts a caller's validity
// boolean. An absent source length denotes a file not in that world.
pub fn answer(builder: &mut Builder, controls: &mut operation::Controls, length: Option<u32>) -> Result<(), Failure> {
    let result = answer_checked(&mut *builder, controls, length);
    handle result { Result::Ok(_) => Result::Ok(()), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
fn answer_checked(builder: &mut Builder, controls: &mut operation::Controls, length: Option<u32>) -> Result<(), Failure> {
    handle charge(&mut *builder, controls) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase {
                Phase::Awaiting { item: item, next_edge: edge, span: span } => answer_span(work, item, edge, span, length),
                _ => Result::Err(Failure::Busy),
            },
        },
    }
}
fn answer_span(work: &mut Work, item: usize, edge: usize, span: Span, length: Option<u32>) -> Result<(), Failure> {
    handle valid_span(span, length) {
        true => { (*work).phase = Phase::Related { item: item, edge: edge }; Result::Ok(()) },
        false => handle Vec::get_mut(&mut work.values, item) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(value) => {
                let replacement = invalid(& *value);
                *value = replacement;
                (*work).phase = Phase::Primary { item: item + 1 };
                Result::Ok(())
            },
        },
    }
}
fn compare(order: Order, left: &CompileDiagnostic, right: &CompileDiagnostic) -> Ordering {
    handle order { Order::Identity => compare_fact(left, right), Order::Presentation => compare_presentation(left, right) }
}
fn sort_values(work: &mut Work, order: Order, outer: usize, inner: usize) -> Result<Event, Failure> {
    handle outer >= Vec::len(&work.values) {
        true => handle order {
            Order::Identity => next(work, Phase::Merge { item: 0 }),
            Order::Presentation => next(work, Phase::Count { item: 0, errors: 0 }),
        },
        false => handle inner == 0 {
            true => next(work, Phase::Sorting { order: order, outer: outer + 1, inner: outer + 1 }),
            false => handle compare(order, Vec::get_unchecked(&work.values, inner - 1), Vec::get_unchecked(&work.values, inner)) {
                Ordering::Greater => {
                    Vec::swap(&mut work.values, inner - 1, inner);
                    next(work, Phase::Sorting { order: order, outer: outer, inner: inner - 1 })
                },
                _ => next(work, Phase::Sorting { order: order, outer: outer + 1, inner: outer + 1 }),
            },
        },
    }
}
fn replace_output(work: &mut Work) -> () {
    let output = work.output;
    (*work).output = Vec::new();
    (*work).values = output;
}
fn same_last(output: &Vec<CompileDiagnostic>, value: &CompileDiagnostic) -> Bool {
    handle Vec::last(output) {
        Result::Err(_) => false,
        Result::Ok(previous) => handle compare_fact(previous, value) { Ordering::Equal => true, _ => false },
    }
}
fn merge(work: &mut Work, item: usize) -> Result<Event, Failure> {
    handle Vec::get(&work.values, item) {
        Result::Err(_) => {
            replace_output(&mut *work);
            next(work, Phase::Provenance { item: 0, part: 0, cursor: cursor() })
        },
        Result::Ok(value) => handle same_last(&work.output, value) {
            true => next(work, Phase::Appending { item: item, part: 0, edge: 0 }),
            false => {
                Vec::push(&mut work.output, *value);
                next(work, Phase::Merge { item: item + 1 })
            },
        },
    }
}
fn append_one<T>(source: &Vec<T>, target: &mut Vec<T>, edge: usize) -> Bool where T: Use<[0, *]> {
    handle Vec::get(source, edge) { Result::Err(_) => false, Result::Ok(value) => { Vec::push(target, *value); true } }
}
fn append_part(source: &CompileDiagnostic, target: &mut CompileDiagnostic, part: usize, edge: usize) -> Bool {
    handle part {
        0 => append_one(&source.related, &mut target.related, edge),
        1 => append_one(&source.facts, &mut target.facts, edge),
        _ => append_one(&source.explanation, &mut target.explanation, edge),
    }
}
fn append_provenance(work: &mut Work, item: usize, part: usize, edge: usize) -> Result<Event, Failure> {
    let count = Vec::len(&work.output);
    handle part == 3 {
        true => next(work, Phase::Merge { item: item + 1 }),
        false => handle Vec::get_mut(&mut work.output, count - 1) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(target) => handle append_part(Vec::get_unchecked(&work.values, item), target, part, edge) {
                true => next(work, Phase::Appending { item: item, part: part, edge: edge + 1 }),
                false => next(work, Phase::Appending { item: item, part: part + 1, edge: 0 }),
            },
        },
    }
}

// The three typed provenance arrays share this bounded sorting/dedup cursor.
// They never become an untyped payload array or a string-encoded semantic key.
fn sort_step<T>(values: &mut Vec<T>, outer: usize, inner: usize) -> Cursor where T: Ord, T: Use<[0, *]> {
    handle outer >= Vec::len(& *values) {
        true => handle Vec::len(& *values) { 0 => Cursor::Done, _ => Cursor::Dedup { read: 1, write: 1 } },
        false => handle inner == 0 {
            true => Cursor::Sort { outer: outer + 1, inner: outer + 1 },
            false => handle Ord::compare(Vec::get_unchecked(& *values, inner - 1), Vec::get_unchecked(& *values, inner)) {
                Ordering::Greater => { Vec::swap(values, inner - 1, inner); Cursor::Sort { outer: outer, inner: inner - 1 } },
                _ => Cursor::Sort { outer: outer + 1, inner: outer + 1 },
            },
        },
    }
}
fn dedup_step<T>(values: &mut Vec<T>, read: usize, write: usize) -> Cursor where T: Ord, T: Use<[0, *]> {
    handle read == Vec::len(& *values) {
        true => Cursor::Trim { length: write },
        false => handle Ord::compare(Vec::get_unchecked(& *values, read), Vec::get_unchecked(& *values, write - 1)) {
            Ordering::Equal => Cursor::Dedup { read: read + 1, write: write },
            _ => {
                let value = *Vec::get_unchecked(& *values, read);
                handle Vec::get_mut(values, write) {
                    Result::Err(_) => Cursor::Invalid,
                    Result::Ok(target) => { *target = value; Cursor::Dedup { read: read + 1, write: write + 1 } },
                }
            },
        },
    }
}
fn canonical_step<T>(values: &mut Vec<T>, cursor: Cursor) -> Cursor where T: Ord, T: Use<[0, *]> {
    handle cursor {
        Cursor::Sort { outer: outer, inner: inner } => sort_step(values, outer, inner),
        Cursor::Dedup { read: read, write: write } => dedup_step(values, read, write),
        Cursor::Trim { length: length } => handle Vec::len(& *values) > length {
            true => { Vec::pop(values); Cursor::Trim { length: length } }, false => Cursor::Done,
        },
        Cursor::Done => Cursor::Done,
        Cursor::Invalid => Cursor::Invalid,
    }
}
fn canonical_part(value: &mut CompileDiagnostic, part: usize, cursor: Cursor) -> Cursor {
    handle part {
        0 => canonical_step(&mut value.related, cursor),
        1 => canonical_step(&mut value.facts, cursor),
        _ => canonical_step(&mut value.explanation, cursor),
    }
}
fn provenance(work: &mut Work, item: usize, part: usize, state: Cursor) -> Result<Event, Failure> {
    handle part == 3 {
        true => next(work, Phase::Provenance { item: item + 1, part: 0, cursor: cursor() }),
        false => handle Vec::get_mut(&mut work.values, item) {
            Result::Err(_) => next(work, sorting(Order::Presentation)),
            Result::Ok(value) => handle canonical_part(value, part, state) {
                Cursor::Invalid => Result::Err(Failure::Invariant),
                Cursor::Done => next(work, Phase::Provenance { item: item, part: part + 1, cursor: cursor() }),
                cursor => next(work, Phase::Provenance { item: item, part: part, cursor: cursor }),
            },
        },
    }
}
fn error_limit(policy: Policy) -> usize {
    handle policy.error_limit { Result::Err(_) => 18446744073709551615, Result::Ok(0) => 1, Result::Ok(limit) => limit }
}
fn count_errors(work: &mut Work, item: usize, errors: usize) -> Result<Event, Failure> {
    handle Vec::get(&work.values, item) {
        Result::Err(_) => handle work.limited {
            true => next(work, Phase::Done),
            false => handle errors > error_limit(work.policy) {
                false => next(work, Phase::Done), true => next(work, Phase::Limit { item: 0, kept: 0, suppressed: 0 }),
            },
        },
        Result::Ok(value) => handle value.severity {
            Severity::Error => next(work, Phase::Count { item: item + 1, errors: errors + 1 }),
            _ => next(work, Phase::Count { item: item + 1, errors: errors }),
        },
    }
}
fn suppression(limit: usize, suppressed: usize, fingerprint: Option<Digest>) -> CompileDiagnostic {
    let message = Str::to_string("diagnostic error limit of ");
    let limit_text = format(&limit);
    let suppressed_text = format(&suppressed);
    String::push_str(&mut message, String::as_str(&limit_text));
    String::push_str(&mut message, " reached; ");
    String::push_str(&mut message, String::as_str(&suppressed_text));
    String::push_str(&mut message, " additional error(s) suppressed");
    bare("G7013", message, Class::Resource, fingerprint)
}
fn limit_errors(work: &mut Work, item: usize, kept: usize, suppressed: usize) -> Result<Event, Failure> {
    handle Vec::get(&work.values, item) {
        Result::Err(_) => {
            Vec::push(&mut work.output, suppression(error_limit(work.policy), suppressed, work.policy.input_fingerprint));
            replace_output(&mut *work);
            (*work).limited = Result<(), ()>::Ok(());
            next(work, sorting(Order::Identity))
        },
        Result::Ok(value) => handle value.severity {
            Severity::Error => handle kept < error_limit(work.policy) - 1 {
                true => {
                    Vec::push(&mut work.output, *value);
                    next(work, Phase::Limit { item: item + 1, kept: kept + 1, suppressed: suppressed })
                },
                false => next(work, Phase::Limit { item: item + 1, kept: kept, suppressed: suppressed + 1 }),
            },
            _ => {
                Vec::push(&mut work.output, *value);
                next(work, Phase::Limit { item: item + 1, kept: kept, suppressed: suppressed })
            },
        },
    }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<Batch, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase { Phase::Done => Result::Ok(Batch { values: work.values }), _ => Result::Err(Failure::Busy) },
        },
    }
}
pub fn values<'a>(batch: &'a Batch) -> Slice<'a, CompileDiagnostic> { Vec::as_slice(&batch.values) }
