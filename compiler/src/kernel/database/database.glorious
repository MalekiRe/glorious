use std::*;
use super::identity;
use super::identity::Digest;
use super::identity::RevisionId;
use super::storage;
use super::storage::Handle;
use super::storage::Arena;
use super::revision;
use super::engine;
use super::query;
use super::operation;
use super::package;
use super::publication;
use super::diagnostic;
use super::dependency;
use super::identity::PackageKey;

// Implemented by the compiler's immutable normalized world. Package admission
// consults only its pinned snapshot, never a provider-supplied membership bit.
pub trait PackageWorld { contains_package(world: &Self, package: &PackageKey) -> Bool; }
pub trait DiagnosticWorld { source_length(world: &Self, file: &identity::FileKey) -> Option<u32>; }

pub enum Failure { Engine(engine::Failure), Revision(revision::RevisionError), Collecting, Invariant }
pub impl Clone for Failure {
    clone(value: &Failure) -> Failure {
        handle *value {
            Failure::Engine(_) => Failure::Engine(Clone::clone(&value.0)),
            Failure::Revision(error) => Failure::Revision(error),
            Failure::Collecting => Failure::Collecting,
            Failure::Invariant => Failure::Invariant,
        }
    }
}
pub struct Session { private core: engine::Session, private snapshot: revision::Snapshot }
pub struct Staged<T> { private session: Session, private revision: RevisionId, private value: T }
pub impl<T> Use<[0, 1]> for Staged<T> where T: Use<[0, 1]> {}
pub struct Published<T> { revision: RevisionId, value: T, diagnostics: diagnostic::Batch }
pub impl<T> Use<[0, 1]> for Published<T> where T: Use<[0, 1]> {}
pub enum PublicationStep { Continue, Ready }
struct KeySlot<K> { value: K, marked: Bool }
impl<K> Use<[0, 1]> for KeySlot<K> where K: Use<[0, 1]> {}
pub struct Family<K> { private core: engine::Family, private keys: HashMap<K, Handle>, private values: Arena<KeySlot<K>> }
pub struct Key<K> { private core: engine::Key }
pub struct KeyStats { live: usize, slots: usize }
pub enum KeySweepStep { Continue { next: usize }, Done }
struct Product<V> { value: V, owners: usize }
impl<V> Use<[0, 1]> for Product<V> where V: Use<[0, 1]> {}
pub struct Stats { revisions: revision::Stats, queries: engine::Stats, products: usize }
pub struct Collected { revisions: usize, memos: usize, edges: usize, products: usize, explanations: usize }
enum Collection {
    Idle,
    Revisions { cursor: usize, collected: Collected },
    Memos { revision: RevisionId, next_revision: usize, cursor: usize, collected: Collected },
    Releasing { product: Handle, revision: RevisionId, next_revision: usize, cursor: usize, collected: Collected },
}
pub enum CollectionStep { Continue, Done(Collected) }
pub struct Released<V> { private product: Handle, private value: Option<V> }
pub impl<V> Use<[0, 1]> for Released<V> where V: Use<[0, 1]> {}
pub enum ProductCollectionStep<V> { Continue, Release(Released<V>), Done(Collected) }
pub impl<V> Use<[0, 1]> for ProductCollectionStep<V> where V: Use<[0, 1]> {}

// Only storage adapters are generic. Query scheduling, waiting, validation,
// publication, and failure cleanup execute in the one non-generic Engine.
pub struct Database<W, V> {
    private history: revision::History<W>, private engine: engine::Engine,
    private products: Arena<Product<V>>, private collection: Collection,
}

pub fn create<W, V>(database: u64, revisions: usize, sessions: usize, attempts: usize, memos: usize, reads: usize)
    -> Database<W, V> {
    Database { history: revision::create(database, revisions, sessions),
        engine: engine::create(database, revisions, sessions, attempts, memos, reads),
        products: storage::namespace(database, 5, memos), collection: Collection::Idle }
}

pub fn available<W, V>(database: &Database<W, V>) -> Result<(), Failure> {
    handle database.collection { Collection::Idle => Result::Ok(()), _ => Result::Err(Failure::Collecting) }
}

pub fn check<W, V>(database: &Database<W, V>, session: Session) -> Result<(), Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::check(&database.engine, session.core) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}
pub fn world<'a, W, V>(database: &'a Database<W, V>, session: Session) -> Result<&'a W, Failure> {
    handle check(database, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle revision::world(&database.history, session.snapshot) {
            Result::Err(error) => Result::Err(Failure::Revision(error)), Result::Ok(world) => Result::Ok(world),
        },
    }
}
pub fn request_controls<'a, W, V>(database: &'a mut Database<W, V>, session: Session) -> Result<&'a mut operation::Controls, Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::request_controls(&mut database.engine, session.core) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(controls) => Result::Ok(controls),
        },
    }
}
pub fn key_identity<K>(key: Key<K>) -> query::ReadIdentity { engine::key_identity(key.core) }
pub fn key_value<'a, K>(family: &'a Family<K>, identity: query::ReadIdentity) -> Result<&'a K, Failure> {
    handle query::family(identity) == engine::family_index(family.core) {
        false => Result::Err(Failure::Engine(engine::Failure::Foreign)),
        true => handle storage::get(&family.values, query::key(identity)) {
            Result::Err(_) => Result::Err(Failure::Engine(engine::Failure::Foreign)), Result::Ok(value) => Result::Ok(&value.value),
        },
    }
}

pub fn import<W, V>(database: &mut Database<W, V>, world: W, fingerprint: Digest, parent: Option<RevisionId>)
    -> Result<RevisionId, Failure> where W: Use<[0, 1]> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle revision::import(&mut database.history, world, fingerprint, parent) {
            Result::Err(error) => Result::Err(Failure::Revision(error)), Result::Ok(id) => Result::Ok(id),
        },
    }
}

pub fn family<K, W, V>(database: &mut Database<W, V>, schema: u64, recovery: query::RecoveryPolicy,
    reuse: engine::ReusePolicy, keys: usize) -> Result<Family<K>, Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::register(&mut database.engine, schema, recovery, reuse) {
            Result::Err(error) => Result::Err(Failure::Engine(error)),
            Result::Ok(family) => Result::Ok(Family { core: family, keys: HashMap::new(),
                values: storage::namespace(engine::family_database(family), engine::key_namespace(family), keys) }),
        },
    }
}

pub fn intern<K>(family: &mut Family<K>, value: K) -> Result<Key<K>, Failure>
    where K: Eq, K: Hash, K: Use<[0, *]> {
    handle existing_key(& *family, &value) {
        Result::Ok(key) => wrap_key(family.core, key),
        Result::Err(_) => handle storage::insert(&mut family.values, KeySlot { value: value, marked: false }) {
            Result::Err(_) => Result::Err(Failure::Engine(engine::Failure::Capacity)),
            Result::Ok(key) => {
                HashMap::insert(&mut family.keys, value, key);
                wrap_key(family.core, key)
            },
        },
    }
}

fn existing_key<K>(family: &Family<K>, value: &K) -> Option<Handle> where K: Eq, K: Hash {
    handle HashMap::get(&family.keys, value) { Result::Err(_) => None, Result::Ok(key) => Result::Ok(*key) }
}

// These small typed adapters are used only by a registry owning all of its
// Family tables. It must hold one collection safe point through root scanning
// and every family sweep; a standalone family is not itself a roots proof.
pub fn key_stats<K>(family: &Family<K>) -> KeyStats {
    KeyStats { live: storage::count(&family.values), slots: storage::slot_count(&family.values) }
}
pub fn key_roots<W, V>(database: &Database<W, V>) -> Result<engine::RootCursor, Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(engine::key_roots(&database.engine)),
    }
}
pub fn key_root_step<W, V>(database: &Database<W, V>, cursor: engine::RootCursor) -> Result<engine::RootStep, Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::key_root_step(&database.engine, cursor) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(step) => Result::Ok(step),
        },
    }
}
pub fn mark_key<K>(family: &mut Family<K>, identity: query::ReadIdentity) -> Result<(), Failure> {
    handle query::family(identity) == engine::family_index(family.core) {
        false => Result::Err(Failure::Engine(engine::Failure::Foreign)),
        true => handle storage::get_mut(&mut family.values, query::key(identity)) {
            Result::Err(_) => Result::Err(Failure::Engine(engine::Failure::Foreign)),
            Result::Ok(entry) => { (*entry).marked = Result<(), ()>::Ok(()); Result::Ok(()) },
        },
    }
}
fn sweep_choice<K>(values: &mut Arena<KeySlot<K>>, key: Handle) -> Result<Option<K>, Failure> where K: Use<[0, *]> {
    handle storage::get_mut(values, key) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(entry) => handle entry.marked {
            true => { (*entry).marked = Result<(), ()>::Err(()); Result::Ok(None) },
            false => Result::Ok(Result::Ok(entry.value)),
        },
    }
}
fn remove_key<K>(family: &mut Family<K>, key: Handle, value: K) -> Result<(), Failure>
    where K: Eq, K: Hash, K: Use<[0, *]> {
    handle existing_key(& *family, &value) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(indexed) => handle storage::equal(indexed, key) {
            false => Result::Err(Failure::Invariant),
            true => {
                HashMap::remove(&mut family.keys, &value);
                handle storage::remove(&mut family.values, key) {
                    Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(_) => Result::Ok(()),
                }
            },
        },
    }
}
fn sweep_key<K>(family: &mut Family<K>, key: Handle) -> Result<(), Failure>
    where K: Eq, K: Hash, K: Use<[0, *]> {
    handle sweep_choice(&mut family.values, key) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(choice) => handle choice {
            Result::Err(_) => Result::Ok(()), Result::Ok(value) => remove_key(family, key, value),
        },
    }
}
pub fn sweep_key_step<K>(family: &mut Family<K>, cursor: usize) -> Result<KeySweepStep, Failure>
    where K: Eq, K: Hash, K: Use<[0, *]> {
    handle cursor == storage::slot_count(&family.values) {
        true => Result::Ok(KeySweepStep::Done),
        false => handle cursor < storage::slot_count(&family.values) {
            false => Result::Err(Failure::Invariant),
            true => handle storage::key_at(&family.values, cursor) {
                Result::Err(_) => Result::Ok(KeySweepStep::Continue { next: cursor + 1 }),
                Result::Ok(key) => handle sweep_key(family, key) {
                    Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(KeySweepStep::Continue { next: cursor + 1 }),
                },
            },
        },
    }
}

fn wrap_key<K>(family: engine::Family, key: Handle) -> Result<Key<K>, Failure> {
    handle engine::key(family, key) {
        Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(key) => Result::Ok(Key { core: key }),
    }
}

pub fn open<W, V>(database: &mut Database<W, V>, revision: RevisionId, recovery: query::RecoveryPolicy,
    work: u64, memory: u64) -> Result<Session, Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle revision::open(&mut database.history, revision) {
            Result::Err(error) => Result::Err(Failure::Revision(error)),
            Result::Ok(snapshot) => open_pinned(&mut *database, snapshot, revision, recovery, work, memory),
        },
    }
}

fn open_pinned<W, V>(database: &mut Database<W, V>, snapshot: revision::Snapshot, revision: RevisionId,
    recovery: query::RecoveryPolicy, work: u64, memory: u64) -> Result<Session, Failure> {
    handle revision::parent(&database.history, snapshot) {
        Result::Err(error) => {
            revision::close(&mut database.history, snapshot);
            Result::Err(Failure::Revision(error))
        },
        Result::Ok(parent) => handle engine::admit(&mut database.engine, revision, parent, recovery, operation::create(work, memory)) {
            Result::Err(error) => {
                revision::close(&mut database.history, snapshot);
                Result::Err(Failure::Engine(error))
            },
            Result::Ok(session) => Result::Ok(Session { core: session, snapshot: snapshot }),
        },
    }
}

pub fn close<W, V>(database: &mut Database<W, V>, session: Session) -> Result<(), Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::close(&mut database.engine, session.core) {
            Result::Err(error) => Result::Err(Failure::Engine(error)),
            Result::Ok(_) => handle revision::close(&mut database.history, session.snapshot) {
                Result::Err(error) => Result::Err(Failure::Revision(error)), Result::Ok(_) => Result::Ok(()),
            },
        },
    }
}

pub fn cancel<W, V>(database: &mut Database<W, V>, session: Session) -> Result<(), Failure> {
    handle engine::cancel(&mut database.engine, session.core) {
        Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(_) => Result::Ok(()),
    }
}

pub fn package_action<W, V>(database: &mut Database<W, V>, session: Session, action: package::Action)
    -> Result<package::Event, Failure> where W: PackageWorld {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle package_admission(& *database, session, &action) {
            Result::Err(error) => { engine::request_failed(&mut database.engine, session.core); Result::Err(error) },
            Result::Ok(_) => handle engine::package_action(&mut database.engine, session.core, action) {
                Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(event) => Result::Ok(event),
            },
        },
    }
}
fn package_admission<W, V>(database: &Database<W, V>, session: Session, action: &package::Action)
    -> Result<(), Failure> where W: PackageWorld {
    handle *action {
        package::Action::Open(_) => handle engine::check(&database.engine, session.core) {
            Result::Err(error) => Result::Err(Failure::Engine(error)),
            Result::Ok(_) => package_in_world(database, session, &action.0),
        },
        _ => Result::Ok(()),
    }
}
fn package_in_world<W, V>(database: &Database<W, V>, session: Session, key: &PackageKey)
    -> Result<(), Failure> where W: PackageWorld {
    handle revision::world(&database.history, session.snapshot) {
        Result::Err(error) => Result::Err(Failure::Revision(error)),
        Result::Ok(world) => handle PackageWorld::contains_package(world, key) {
            true => Result::Ok(()),
            false => Result::Err(Failure::Engine(engine::Failure::Package(package::Failure::PackageNotInRequest(Clone::clone(key))))),
        },
    }
}
pub fn package_metadata<W, V>(database: &Database<W, V>, session: Session, key: &PackageKey)
    -> Result<package::Metadata, Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::package_metadata(&database.engine, session.core, key) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(metadata) => Result::Ok(metadata),
        },
    }
}
pub fn package_stats<W, V>(database: &Database<W, V>, session: Session) -> Result<package::Stats, Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::package_stats(&database.engine, session.core) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(stats) => Result::Ok(stats),
        },
    }
}
pub fn work_spent<W, V>(database: &Database<W, V>, session: Session) -> Result<u64, Failure> {
    handle engine::work_spent(&database.engine, session.core) {
        Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(spent) => Result::Ok(spent),
    }
}

pub fn begin_request<W, V>(database: &mut Database<W, V>, session: Session, limits: publication::Limits) -> Result<(), Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle revision::fingerprint(&database.history, session.snapshot) {
            Result::Err(error) => Result::Err(Failure::Revision(error)),
            Result::Ok(fingerprint) => handle engine::begin_request(&mut database.engine, session.core, fingerprint, limits) {
                Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(_) => Result::Ok(()),
            },
        },
    }
}
pub fn record_dependency<W, V>(database: &mut Database<W, V>, session: Session, node: dependency::node::Node,
    fingerprint: Digest, edges: Vec<dependency::node::Node>) -> Result<(), Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::record_dependency(&mut database.engine, session.core, node, fingerprint, edges) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}
pub fn abort_request<W, V>(database: &mut Database<W, V>, session: Session) -> () {
    engine::request_failed(&mut database.engine, session.core);
}
pub fn observation<W, V>(database: &Database<W, V>, session: Session, outcome: engine::Outcome, index: usize)
    -> Result<Option<query::Read>, Failure> {
    handle check(database, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::observation(&database.engine, session.core, outcome, index) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(read) => Result::Ok(read),
        },
    }
}
pub fn observed_query<W, V>(database: &Database<W, V>, session: Session, outcome: engine::Outcome, index: usize)
    -> Result<engine::Outcome, Failure> {
    handle check(database, session) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::observed_query(&database.engine, session.core, outcome, index) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(child) => Result::Ok(child),
        },
    }
}
pub fn record_diagnostic<W, V>(database: &mut Database<W, V>, session: Session, value: diagnostic::CompileDiagnostic)
    -> Result<(), Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::record_diagnostic(&mut database.engine, session.core, value) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}
// The generic adapter owns the actual result while the shared non-generic
// state machine prepares its publication. No payload accessor exists here.
pub fn stage_request<T, W, V>(database: &mut Database<W, V>, session: Session, value: T)
    -> Result<Staged<T>, Failure> where T: Use<[0, 1]> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle revision::identity(&database.history, session.snapshot) {
            Result::Err(error) => Result::Err(Failure::Revision(error)),
            Result::Ok(revision) => handle engine::seal_request(&mut database.engine, session.core) {
                Result::Err(error) => Result::Err(Failure::Engine(error)),
                Result::Ok(_) => Result::Ok(Staged { session: session, revision: revision, value: value }),
            },
        },
    }
}
pub fn step_request<W, V>(database: &mut Database<W, V>, session: Session) -> Result<PublicationStep, Failure>
    where W: DiagnosticWorld {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::step_request(&mut database.engine, session.core) {
            Result::Err(error) => Result::Err(Failure::Engine(error)),
            Result::Ok(event) => handle event {
                publication::Event::Continue => Result::Ok(PublicationStep::Continue),
                publication::Event::Ready => Result::Ok(PublicationStep::Ready),
                publication::Event::Validate(span) => validate_request_span(database, session, span),
            },
        },
    }
}
fn validate_request_span<W, V>(database: &mut Database<W, V>, session: Session, span: diagnostic::Span)
    -> Result<PublicationStep, Failure> where W: DiagnosticWorld {
    let length = pinned_length(& *database, session, &span.file);
    handle length {
        Result::Err(error) => { engine::request_failed(&mut database.engine, session.core); Result::Err(error) },
        Result::Ok(length) => handle engine::answer_span(&mut database.engine, session.core, length) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(_) => Result::Ok(PublicationStep::Continue),
        },
    }
}
fn pinned_length<W, V>(database: &Database<W, V>, session: Session, file: &identity::FileKey)
    -> Result<Option<u32>, Failure> where W: DiagnosticWorld {
    handle revision::world(&database.history, session.snapshot) {
        Result::Err(error) => Result::Err(Failure::Revision(error)),
        Result::Ok(world) => Result::Ok(DiagnosticWorld::source_length(world, file)),
    }
}
pub fn finish_request<T, W, V>(database: &mut Database<W, V>, staged: Staged<T>) -> Result<Published<T>, Failure>
    where T: Use<[0, 1]> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::finish_request(&mut database.engine, staged.session.core) {
            Result::Err(error) => Result::Err(Failure::Engine(error)),
            Result::Ok(batch) => Result::Ok(Published { revision: staged.revision, value: staged.value, diagnostics: batch }),
        },
    }
}
pub fn request_traces<'a, W, V>(database: &'a Database<W, V>, session: Session)
    -> Result<Option<Slice<'a, dependency::Trace>>, Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::request_traces(&database.engine, session.core) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(values) => Result::Ok(values),
        },
    }
}
pub fn published_revisions<W, V>(database: &Database<W, V>) -> Result<usize, Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => Result::Ok(engine::published_revisions(&database.engine)),
    }
}

pub fn start<K, W, V>(database: &mut Database<W, V>, session: Session, key: Key<K>, parent: Option<engine::Ticket>)
    -> Result<engine::Ticket, Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::start(&mut database.engine, session.core, key.core, parent) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(ticket) => Result::Ok(ticket),
        },
    }
}

pub fn step<W, V>(database: &mut Database<W, V>, ticket: engine::Ticket) -> Result<engine::Event, Failure>
    where V: Use<[0, 1]> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::poll(&mut database.engine, ticket) {
            Result::Err(error) => Result::Err(Failure::Engine(error)),
            Result::Ok(engine::Event::Reuse { product: product }) => reuse(&mut *database, ticket, product),
            Result::Ok(event) => Result::Ok(event),
        },
    }
}

pub fn observe<W, V>(database: &mut Database<W, V>, ticket: engine::Ticket, read: query::Read) -> Result<(), Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::observe(&mut database.engine, ticket, read) {
            Result::Err(error) => Result::Err(Failure::Engine(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}

pub fn abort<W, V>(database: &mut Database<W, V>, ticket: engine::Ticket) -> () { engine::abort(&mut database.engine, ticket); }

pub fn publish<W, V>(database: &mut Database<W, V>, ticket: engine::Ticket, value: V, fingerprint: Digest,
    completeness: query::Completeness) -> Result<(), Failure> where V: Use<[0, 1]> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle storage::insert(&mut database.products, Product { value: value, owners: 1 }) {
            Result::Err(_) => {
                engine::abort(&mut database.engine, ticket);
                Result::Err(Failure::Engine(engine::Failure::Capacity))
            },
            Result::Ok(product) => handle engine::publish(&mut database.engine, ticket, product, fingerprint, completeness) {
                Result::Err(error) => {
                    storage::remove(&mut database.products, product);
                    Result::Err(Failure::Engine(error))
                },
                Result::Ok(_) => Result::Ok(()),
            },
        },
    }
}

fn retain<V>(products: &mut Arena<Product<V>>, key: Handle) -> Result<(), Failure> {
    handle storage::get_mut(&mut *products, key) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(product) => handle product.owners == 18446744073709551615 {
            true => Result::Err(Failure::Engine(engine::Failure::Capacity)),
            false => { (*product).owners = product.owners + 1; Result::Ok(()) },
        },
    }
}

fn remaining<V>(products: &mut Arena<Product<V>>, key: Handle) -> Result<usize, Failure> {
    handle storage::get_mut(&mut *products, key) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(product) => handle product.owners == 0 {
            true => Result::Err(Failure::Invariant),
            false => { (*product).owners = product.owners - 1; Result::Ok(product.owners) },
        },
    }
}

fn release<V>(products: &mut Arena<Product<V>>, key: Handle) -> Result<Option<V>, Failure> where V: Use<[0, 1]> {
    handle remaining(&mut *products, key) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(0) => handle storage::remove(&mut *products, key) {
            Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(product) => Result::Ok(Result::Ok(product.value)),
        },
        Result::Ok(_) => Result::Ok(None),
    }
}

fn reuse<W, V>(database: &mut Database<W, V>, ticket: engine::Ticket, product: Handle) -> Result<engine::Event, Failure>
    where V: Use<[0, 1]> {
    handle retain(&mut database.products, product) {
        Result::Err(error) => { engine::abort(&mut database.engine, ticket); Result::Err(error) },
        Result::Ok(_) => handle engine::publish_reused(&mut database.engine, ticket, product) {
            Result::Err(error) => {
                release(&mut database.products, product);
                Result::Err(Failure::Engine(error))
            },
            Result::Ok(_) => Result::Ok(engine::Event::Continue),
        },
    }
}

pub fn value<'a, W, V>(database: &'a Database<W, V>, session: Session, outcome: engine::Outcome) -> Result<&'a V, Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle engine::product(&database.engine, session.core, outcome) {
            Result::Err(error) => Result::Err(Failure::Engine(error)),
            Result::Ok(product) => handle storage::get(&database.products, product) {
                Result::Err(_) => Result::Err(Failure::Invariant), Result::Ok(product) => Result::Ok(&product.value),
            },
        },
    }
}

pub fn stats<W, V>(database: &Database<W, V>) -> Result<Stats, Failure> {
    handle available(database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => Result::Ok(Stats { revisions: revision::stats(&database.history),
            queries: engine::stats(&database.engine), products: storage::count(&database.products) }),
    }
}

pub fn retire<W, V>(database: &mut Database<W, V>, id: RevisionId) -> Result<(), Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle revision::retire(&mut database.history, id) {
            Result::Err(error) => Result::Err(Failure::Revision(error)), Result::Ok(_) => Result::Ok(()),
        },
    }
}

pub fn collect<W, V>(database: &mut Database<W, V>) -> Result<(), Failure> {
    handle available(& *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => {
            (*database).collection = Collection::Revisions { cursor: 0,
                collected: Collected { revisions: 0, memos: 0, edges: 0, products: 0, explanations: 0 } };
            Result::Ok(())
        },
    }
}

pub fn collect_step<W, V>(database: &mut Database<W, V>) -> Result<CollectionStep, Failure>
    where W: Use<[0, 1]>, V: Use<[0, 1]> {
    handle collect_step_with_products(&mut *database) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(event) => handle event {
            ProductCollectionStep::Continue => Result::Ok(CollectionStep::Continue),
            ProductCollectionStep::Done(collected) => Result::Ok(CollectionStep::Done(collected)),
            ProductCollectionStep::Release(released) => handle finish_release(database, &mut released) {
                Result::Err(error) => Result::Err(error), Result::Ok(_) => Result::Ok(CollectionStep::Continue),
            },
        },
    }
}

// A compiler registry that stores checked typed-product references uses this
// variant. It releases its concrete store entry, then explicitly acknowledges
// the token. Ordinary owned values use collect_step's self-contained disposal.
pub fn collect_step_with_products<W, V>(database: &mut Database<W, V>) -> Result<ProductCollectionStep<V>, Failure>
    where W: Use<[0, 1]>, V: Use<[0, 1]> {
    handle database.collection {
        Collection::Idle => Result::Err(Failure::Invariant),
        Collection::Releasing { product: _, revision: _, next_revision: _, cursor: _, collected: _ } => Result::Err(Failure::Collecting),
        Collection::Revisions { cursor: cursor, collected: collected } => collect_revision(&mut *database, cursor, collected),
        Collection::Memos { revision: revision, next_revision: next, cursor: cursor, collected: collected } =>
            collect_memo(&mut *database, revision, next, cursor, collected),
    }
}

pub fn released_value<'a, V>(released: &'a Released<V>) -> Result<&'a V, Failure> {
    handle Result::as_ref(&released.value) {
        Result::Err(_) => Result::Err(Failure::Engine(engine::Failure::Closed)), Result::Ok(value) => Result::Ok(value),
    }
}
pub fn finish_release<W, V>(database: &mut Database<W, V>, released: &mut Released<V>) -> Result<(), Failure>
    where V: Use<[0, 1]> {
    handle released_value(& *released) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => finish_live_release(database, released),
    }
}
fn finish_live_release<W, V>(database: &mut Database<W, V>, released: &mut Released<V>) -> Result<(), Failure>
    where V: Use<[0, 1]> {
    handle database.collection {
        Collection::Releasing { product: product, revision: revision, next_revision: next, cursor: cursor, collected: collected } =>
            handle storage::equal(product, released.product) {
                false => Result::Err(Failure::Engine(engine::Failure::Foreign)),
                true => {
                    (*released).value = None;
                    (*database).collection = Collection::Memos { revision: revision, next_revision: next, cursor: cursor, collected: collected };
                    Result::Ok(())
                },
            },
        _ => Result::Err(Failure::Engine(engine::Failure::Closed)),
    }
}

fn collect_revision<W, V>(database: &mut Database<W, V>, cursor: usize, collected: Collected) -> Result<ProductCollectionStep<V>, Failure>
    where W: Use<[0, 1]> {
    handle revision::collect_step(&mut database.history, cursor) {
        Result::Err(error) => Result::Err(Failure::Revision(error)),
        Result::Ok(step) => handle step {
        revision::CollectionStep::Done => {
            (*database).collection = Collection::Idle;
            Result::Ok(ProductCollectionStep::Done(collected))
        },
        revision::CollectionStep::Next { cursor: next, collected: revision } => {
            (*database).collection = next_collection(next, revision, collected);
            Result::Ok(ProductCollectionStep::Continue)
        },
        },
    }
}

fn next_collection(cursor: usize, revision: Option<RevisionId>, collected: Collected) -> Collection {
    handle revision {
        Result::Err(_) => Collection::Revisions { cursor: cursor, collected: collected },
        Result::Ok(revision) => Collection::Memos { revision: revision, next_revision: cursor, cursor: 0,
            collected: Collected { revisions: collected.revisions + 1, memos: collected.memos, edges: collected.edges,
                products: collected.products, explanations: collected.explanations } },
    }
}

fn collect_memo<W, V>(database: &mut Database<W, V>, revision: RevisionId, next: usize, cursor: usize, collected: Collected)
    -> Result<ProductCollectionStep<V>, Failure> where V: Use<[0, 1]> {
    handle engine::discard_step(&mut database.engine, revision, cursor) {
        Result::Err(error) => Result::Err(Failure::Engine(error)),
        Result::Ok(step) => handle step {
        engine::Discard::Done => {
            (*database).collection = Collection::Revisions { cursor: next, collected: collected };
            Result::Ok(ProductCollectionStep::Continue)
        },
        engine::Discard::Next { cursor: cursor, product: product, edges: edges } =>
            collect_product(&mut *database, revision, next, cursor, collected, product, edges),
        },
    }
}

fn collect_product<W, V>(database: &mut Database<W, V>, revision: RevisionId, next: usize, cursor: usize,
    collected: Collected, product: Option<Handle>, edges: usize) -> Result<ProductCollectionStep<V>, Failure> where V: Use<[0, 1]> {
    handle product {
        Result::Err(_) => {
            (*database).collection = Collection::Memos { revision: revision, next_revision: next, cursor: cursor, collected: collected };
            Result::Ok(ProductCollectionStep::Continue)
        },
        Result::Ok(product) => handle release(&mut database.products, product) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(released) => collect_released(database, revision, next, cursor, collected, product, edges, released),
        },
    }
}
fn collect_released<W, V>(database: &mut Database<W, V>, revision: RevisionId, next: usize, cursor: usize,
    collected: Collected, product: Handle, edges: usize, released: Option<V>) -> Result<ProductCollectionStep<V>, Failure>
    where V: Use<[0, 1]> {
    let counted = Collected { revisions: collected.revisions, memos: collected.memos + 1,
        edges: collected.edges + edges, products: collected.products, explanations: collected.explanations + 1 };
    handle released {
        Result::Err(_) => {
            (*database).collection = Collection::Memos { revision: revision, next_revision: next, cursor: cursor, collected: counted };
            Result::Ok(ProductCollectionStep::Continue)
        },
        Result::Ok(value) => {
            (*database).collection = Collection::Releasing { product: product, revision: revision, next_revision: next, cursor: cursor,
                collected: Collected { revisions: counted.revisions, memos: counted.memos, edges: counted.edges,
                    products: counted.products + 1, explanations: counted.explanations } };
            Result::Ok(ProductCollectionStep::Release(Released { product: product, value: Result::Ok(value) }))
        },
    }
}
