        PrimitiveRole::IntConvertWrappingToIsize => Result::Ok(as<u8>(64)),
        PrimitiveRole::IntConvertCheckedToU128 => Result::Ok(as<u8>(65)),
        PrimitiveRole::IntConvertWrappingToU128 => Result::Ok(as<u8>(66)),
        PrimitiveRole::IntConvertCheckedToI128 => Result::Ok(as<u8>(67)),
        PrimitiveRole::IntConvertWrappingToI128 => Result::Ok(as<u8>(68)),
        PrimitiveRole::ArrayGetBorrowShared => Result::Ok(as<u8>(152)),
        PrimitiveRole::ArrayEmpty => Result::Ok(as<u8>(155)),
        PrimitiveRole::ArrayPushMove => Result::Ok(as<u8>(156)),
        PrimitiveRole::StaticLen => Result::Ok(as<u8>(163)),
    }
}
pub fn validate_role(value: PrimitiveRole) -> Result<(), ManifestError> {
    handle stable_tag(value) { Result::Err(_) => Result::Err(ManifestError::InvalidRole(value)), Result::Ok(_) => Result::Ok(()) }
}
fn static_name(value: PrimitiveRole) -> Str<'static> {
    handle value {
        PrimitiveRole::Memory(primitive) => memory_name(primitive),
        PrimitiveRole::Float(_) => "",
        PrimitiveRole::Abort => "abort",
        PrimitiveRole::BranchBool => "branch-bool",
        PrimitiveRole::TextByteLen => "text-byte-len",
        PrimitiveRole::TextConcat => "text-concat",
        PrimitiveRole::TextEq => "text-eq",
        PrimitiveRole::TextFromUtf8Checked => "text-from-utf8-checked",
        PrimitiveRole::TextAsBytes => "text-as-bytes",
        PrimitiveRole::CharFromU32Checked => "char-from-u32-checked",
        PrimitiveRole::CharToU32 => "char-to-u32",
        PrimitiveRole::BytesLen => "bytes-len",
        PrimitiveRole::BytesConcat => "bytes-concat",
        PrimitiveRole::BytesGet => "bytes-get",
        PrimitiveRole::BytesSlice => "bytes-slice",
        PrimitiveRole::BytesFromArrayMove => "bytes-from-array-move",
        PrimitiveRole::BytesToArray => "bytes-to-array",
        PrimitiveRole::BytesUtf8ValidUpTo => "bytes-utf8-valid-up-to",
        PrimitiveRole::Blake3 => "blake3",
        PrimitiveRole::U32CheckedAdd => "u32-checked-add",
        PrimitiveRole::U32CheckedSub => "u32-checked-sub",
        PrimitiveRole::U32CheckedMul => "u32-checked-mul",
        PrimitiveRole::U32CheckedDiv => "u32-checked-div",
        PrimitiveRole::U32CheckedRem => "u32-checked-rem",
        PrimitiveRole::U32WrappingAdd => "u32-wrapping-add",
        PrimitiveRole::U32WrappingSub => "u32-wrapping-sub",
        PrimitiveRole::U32WrappingMul => "u32-wrapping-mul",
        PrimitiveRole::U32WrappingShl => "u32-wrapping-shl",
        PrimitiveRole::U32WrappingShr => "u32-wrapping-shr",
        PrimitiveRole::U32CheckedShl => "u32-checked-shl",
        PrimitiveRole::U32CheckedShr => "u32-checked-shr",
        PrimitiveRole::U32Eq => "u32-eq",
        PrimitiveRole::U32Lt => "u32-lt",
        PrimitiveRole::U32Le => "u32-le",
        PrimitiveRole::U32ToUsize => "u32-to-usize",
        PrimitiveRole::UsizeToU32Checked => "usize-to-u32-checked",
        PrimitiveRole::IntCheckedAdd => "int-checked-add",
        PrimitiveRole::IntCheckedDiv => "int-checked-div",
        PrimitiveRole::IntWrappingAdd => "int-wrapping-add",
        PrimitiveRole::IntConvertCheckedToI64 => "int-convert-checked-to-i64",
        PrimitiveRole::IntConvertWrappingToI64 => "int-convert-wrapping-to-i64",
        PrimitiveRole::IntConvertWrappingToU32 => "int-convert-wrapping-to-u32",
        PrimitiveRole::IntConvertWrappingToUsize => "int-convert-wrapping-to-usize",
        PrimitiveRole::IntConvertWrappingToU8 => "int-convert-wrapping-to-u8",
        PrimitiveRole::IntConvertWrappingToU16 => "int-convert-wrapping-to-u16",
        PrimitiveRole::IntConvertWrappingToI16 => "int-convert-wrapping-to-i16",
        PrimitiveRole::IntWrappingSub => "int-wrapping-sub",
        PrimitiveRole::IntWrappingMul => "int-wrapping-mul",
        PrimitiveRole::IntWrappingNeg => "int-wrapping-neg",
        PrimitiveRole::IntEqual => "int-equal",
        PrimitiveRole::IntLess => "int-less",
        PrimitiveRole::IntGreater => "int-greater",
        PrimitiveRole::IntBitAnd => "int-bit-and",
        PrimitiveRole::IntBitOr => "int-bit-or",
        PrimitiveRole::IntBitXor => "int-bit-xor",
        PrimitiveRole::IntBitNot => "int-bit-not",
        PrimitiveRole::IntShr => "int-shr",
        PrimitiveRole::IntShl => "int-shl",
        PrimitiveRole::IntConvertCheckedToU32 => "int-convert-checked-to-u32",
        PrimitiveRole::IntConvertCheckedToUsize => "int-convert-checked-to-usize",
        PrimitiveRole::IntConvertCheckedToU8 => "int-convert-checked-to-u8",
        PrimitiveRole::IntConvertCheckedToU16 => "int-convert-checked-to-u16",
        PrimitiveRole::IntConvertCheckedToI16 => "int-convert-checked-to-i16",
        PrimitiveRole::IntConvertCheckedToI32 => "int-convert-checked-to-i32",
        PrimitiveRole::IntConvertWrappingToI32 => "int-convert-wrapping-to-i32",
        PrimitiveRole::IntConvertCheckedToI8 => "int-convert-checked-to-i8",
        PrimitiveRole::IntConvertWrappingToI8 => "int-convert-wrapping-to-i8",
        PrimitiveRole::IntConvertCheckedToU64 => "int-convert-checked-to-u64",
        PrimitiveRole::IntConvertWrappingToU64 => "int-convert-wrapping-to-u64",
        PrimitiveRole::IntConvertCheckedToIsize => "int-convert-checked-to-isize",
        PrimitiveRole::IntConvertWrappingToIsize => "int-convert-wrapping-to-isize",
        PrimitiveRole::IntConvertCheckedToU128 => "int-convert-checked-to-u128",
        PrimitiveRole::IntConvertWrappingToU128 => "int-convert-wrapping-to-u128",
        PrimitiveRole::IntConvertCheckedToI128 => "int-convert-checked-to-i128",
        PrimitiveRole::IntConvertWrappingToI128 => "int-convert-wrapping-to-i128",
        PrimitiveRole::ArrayGetBorrowShared => "array-get-borrow-shared",
        PrimitiveRole::ArrayEmpty => "array-empty",
        PrimitiveRole::ArrayPushMove => "array-push-move",
        PrimitiveRole::StaticLen => "static-len",
    }
}
fn width_name(value: FloatWidth) -> Str<'static> { handle value { FloatWidth::F32 => "f32", FloatWidth::F64 => "f64" } }
fn binary_name(value: FloatBinaryOp) -> Str<'static> {
    handle value { FloatBinaryOp::Add => "add", FloatBinaryOp::Sub => "sub", FloatBinaryOp::Mul => "mul", FloatBinaryOp::Div => "div", FloatBinaryOp::Rem => "rem" }
}
fn comparison_name(value: FloatCompareOp) -> Str<'static> {
    handle value { FloatCompareOp::Eq => "eq", FloatCompareOp::Ne => "ne", FloatCompareOp::Lt => "lt", FloatCompareOp::Le => "le", FloatCompareOp::Gt => "gt", FloatCompareOp::Ge => "ge" }
}
fn scalar_name(value: ScalarType) -> Str<'static> {
    handle value {
        ScalarType::U8 => "u8",
        ScalarType::U16 => "u16",
        ScalarType::U32 => "u32",
        ScalarType::U64 => "u64",
        ScalarType::U128 => "u128",
        ScalarType::Usize => "usize",
        ScalarType::I8 => "i8",
        ScalarType::I16 => "i16",
        ScalarType::I32 => "i32",
        ScalarType::I64 => "i64",
        ScalarType::I128 => "i128",
        ScalarType::Isize => "isize",
        ScalarType::F32 => "f32",
        ScalarType::F64 => "f64",
        _ => "non-runtime-scalar",
    }
}
fn named(width: FloatWidth, operation: Str<'static>) -> String {
    let result = Str::to_string(width_name(width)); String::push_str(&mut result, "-"); String::push_str(&mut result, operation); result
}
fn conversion_name(from: ScalarType, to: ScalarType, checked: Bool) -> String {
    let result = Str::to_string(scalar_name(from)); String::push_str(&mut result, "-to-"); String::push_str(&mut result, scalar_name(to));
    handle checked { true => { String::push_str(&mut result, "-checked"); result }, false => result }
}
pub fn selector_name(value: PrimitiveRole) -> String {
    handle value {
        PrimitiveRole::Float(primitive) => handle primitive {
            FloatPrimitive::Binary { width: width, operation: op } => named(width, binary_name(op)),
            FloatPrimitive::Neg { width: width } => named(width, "neg"),
            FloatPrimitive::Compare { width: width, operation: op } => named(width, comparison_name(op)),
            FloatPrimitive::Convert { from: from, to: to, checked: checked } => conversion_name(from, to, checked),
            FloatPrimitive::ToBits { width: width } => named(width, "to-bits"),
            FloatPrimitive::FromBits { width: width } => named(width, "from-bits"),
        },
        _ => Str::to_string(static_name(value)),
    }
}
