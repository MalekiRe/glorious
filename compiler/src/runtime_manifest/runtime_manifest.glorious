    IntLess,
    IntGreater,
    IntBitAnd,
    IntBitOr,
    IntBitXor,
    IntBitNot,
    IntShr,
    IntShl,
    IntConvertCheckedToU32,
    IntConvertCheckedToUsize,
    IntConvertCheckedToU8,
    IntConvertCheckedToU16,
    IntConvertCheckedToI16,
    IntConvertCheckedToI32,
    IntConvertWrappingToI32,
    IntConvertCheckedToI8,
    IntConvertWrappingToI8,
    IntConvertCheckedToU64,
    IntConvertWrappingToU64,
    IntConvertCheckedToIsize,
    IntConvertWrappingToIsize,
    IntConvertCheckedToU128,
    IntConvertWrappingToU128,
    IntConvertCheckedToI128,
    IntConvertWrappingToI128,
    ArrayGetBorrowShared,
    ArrayEmpty,
    ArrayPushMove,
    StaticLen,
    Memory(MemoryPrimitive),
}
pub struct PrimitiveSelector { pub(crate) role: PrimitiveRole, pub(crate) module_path: String, pub(crate) name: String }
pub struct HostImportSelector { pub(crate) module_path: String, pub(crate) name: String, pub(crate) capability: String, pub(crate) symbol: String }
pub enum LiteralViewKind { Utf8, Octets }
pub struct LiteralViewSelector { pub(crate) kind: LiteralViewKind, pub(crate) module_path: String, pub(crate) name: String }
pub fn literal_view_tag(kind: LiteralViewKind) -> u8 { handle kind { LiteralViewKind::Utf8 => 0, LiteralViewKind::Octets => 1 } }
pub struct RuntimeManifestInput { pub(crate) standard_library: PackageKey, pub(crate) selectors: Vec<PrimitiveSelector>, pub(crate) host_imports: Vec<HostImportSelector>, pub(crate) literal_views: Vec<LiteralViewSelector> }
pub enum ManifestError {
    DuplicateLiteralView(LiteralViewKind),
    IncompatibleLiteralView { kind: LiteralViewKind, definition: DefKey },
    InvalidRole(PrimitiveRole), DuplicateRole(PrimitiveRole),
    MissingDeclaration { module_path: String, name: String },
    AmbiguousDeclaration { module_path: String, name: String },
    DuplicateHostImport { module_path: String, name: String },
    InvalidHostImport { module_path: String, name: String },
    ConflictingRuntimeBinding { definition: DefKey },
    IncompatibleSignature { role: PrimitiveRole, definition: DefKey },
    IncompatibleHostImport { definition: DefKey },
}
fn width_order(value: FloatWidth) -> usize { handle value { FloatWidth::F32 => 0, FloatWidth::F64 => 1 } }
fn binary_order(value: FloatBinaryOp) -> usize {
    handle value { FloatBinaryOp::Add => 0, FloatBinaryOp::Sub => 1, FloatBinaryOp::Mul => 2, FloatBinaryOp::Div => 3, FloatBinaryOp::Rem => 4 }
}
fn comparison_order(value: FloatCompareOp) -> usize {
    handle value { FloatCompareOp::Eq => 0, FloatCompareOp::Ne => 1, FloatCompareOp::Lt => 2, FloatCompareOp::Le => 3, FloatCompareOp::Gt => 4, FloatCompareOp::Ge => 5 }
}
fn flag(value: Bool) -> usize { handle value { true => 1, false => 0 } }
fn float_order(value: FloatPrimitive) -> usize {
    // Fixed digit ranges encode native (variant, fields...) ordering even for
    // malformed Convert values. No encoded field can overlap another digit.
    // Conversion comparisons do not need the other variants' call-frame
    // temporaries; retain their finite ordering in a separate source branch.
    handle value {
        FloatPrimitive::Convert { from: from, to: to, checked: checked } =>
            30000 + types::scalar_order(from) * 100 + types::scalar_order(to) * 2 + flag(checked),
        _ => non_conversion_float_order(value),
    }
}
fn non_conversion_float_order(value: FloatPrimitive) -> usize {
    handle value {
        FloatPrimitive::Binary { width: width, operation: op } => width_order(width) * 100 + binary_order(op) * 2,
        FloatPrimitive::Neg { width: width } => 10000 + width_order(width) * 100,
        FloatPrimitive::Compare { width: width, operation: op } => 20000 + width_order(width) * 100 + comparison_order(op) * 2,
        FloatPrimitive::Convert { from: from, to: to, checked: checked } =>
            30000 + types::scalar_order(from) * 100 + types::scalar_order(to) * 2 + flag(checked),
        FloatPrimitive::ToBits { width: width } => 40000 + width_order(width) * 100,
        FloatPrimitive::FromBits { width: width } => 50000 + width_order(width) * 100,
    }
}
fn role_order(value: PrimitiveRole) -> usize {
    handle value {
        PrimitiveRole::Float(_) => 1,
        PrimitiveRole::Abort => 0,
        PrimitiveRole::BranchBool => 2,
        PrimitiveRole::TextByteLen => 3,
        PrimitiveRole::TextConcat => 4,
        PrimitiveRole::TextEq => 5,
        PrimitiveRole::TextFromUtf8Checked => 6,
        PrimitiveRole::TextAsBytes => 7,
        PrimitiveRole::CharFromU32Checked => 8,
        PrimitiveRole::CharToU32 => 9,
        PrimitiveRole::BytesLen => 10,
        PrimitiveRole::BytesConcat => 11,
        PrimitiveRole::BytesGet => 12,
        PrimitiveRole::BytesSlice => 13,
        PrimitiveRole::BytesFromArrayMove => 14,
        PrimitiveRole::BytesToArray => 15,
        PrimitiveRole::BytesUtf8ValidUpTo => 16,
        PrimitiveRole::Blake3 => 17,
        PrimitiveRole::U32CheckedAdd => 18,
        PrimitiveRole::U32CheckedSub => 19,
        PrimitiveRole::U32CheckedMul => 20,
        PrimitiveRole::U32CheckedDiv => 21,
        PrimitiveRole::U32CheckedRem => 22,
        PrimitiveRole::U32WrappingAdd => 23,
        PrimitiveRole::U32WrappingSub => 24,
        PrimitiveRole::U32WrappingMul => 25,
        PrimitiveRole::U32WrappingShl => 26,
        PrimitiveRole::U32WrappingShr => 27,
        PrimitiveRole::U32CheckedShl => 28,
        PrimitiveRole::U32CheckedShr => 29,
        PrimitiveRole::U32Eq => 30,
        PrimitiveRole::U32Lt => 31,
        PrimitiveRole::U32Le => 32,
        PrimitiveRole::U32ToUsize => 33,
        PrimitiveRole::UsizeToU32Checked => 34,
        PrimitiveRole::IntCheckedAdd => 35,
        PrimitiveRole::IntCheckedDiv => 36,
        PrimitiveRole::IntWrappingAdd => 37,
        PrimitiveRole::IntConvertCheckedToI64 => 38,
        PrimitiveRole::IntConvertWrappingToI64 => 39,
        PrimitiveRole::IntConvertWrappingToU32 => 40,
        PrimitiveRole::IntConvertWrappingToUsize => 41,
        PrimitiveRole::IntConvertWrappingToU8 => 42,
        PrimitiveRole::IntConvertWrappingToU16 => 43,
        PrimitiveRole::IntConvertWrappingToI16 => 44,
        PrimitiveRole::IntWrappingSub => 45,
        PrimitiveRole::IntWrappingMul => 46,
        PrimitiveRole::IntWrappingNeg => 47,
        PrimitiveRole::IntEqual => 48,
        PrimitiveRole::IntLess => 49,
        PrimitiveRole::IntGreater => 50,
        PrimitiveRole::IntBitAnd => 51,
        PrimitiveRole::IntBitOr => 52,
        PrimitiveRole::IntBitXor => 53,
        PrimitiveRole::IntBitNot => 54,
        PrimitiveRole::IntShr => 55,
        PrimitiveRole::IntShl => 56,
        PrimitiveRole::IntConvertCheckedToU32 => 57,
        PrimitiveRole::IntConvertCheckedToUsize => 58,
        PrimitiveRole::IntConvertCheckedToU8 => 59,
        PrimitiveRole::IntConvertCheckedToU16 => 60,
        PrimitiveRole::IntConvertCheckedToI16 => 61,
        PrimitiveRole::IntConvertCheckedToI32 => 62,
        PrimitiveRole::IntConvertWrappingToI32 => 63,
        PrimitiveRole::IntConvertCheckedToI8 => 64,
        PrimitiveRole::IntConvertWrappingToI8 => 65,
        PrimitiveRole::IntConvertCheckedToU64 => 66,
        PrimitiveRole::IntConvertWrappingToU64 => 67,
        PrimitiveRole::IntConvertCheckedToIsize => 68,
        PrimitiveRole::IntConvertWrappingToIsize => 69,
        PrimitiveRole::IntConvertCheckedToU128 => 70,
        PrimitiveRole::IntConvertWrappingToU128 => 71,
        PrimitiveRole::IntConvertCheckedToI128 => 72,
        PrimitiveRole::IntConvertWrappingToI128 => 73,
        PrimitiveRole::ArrayGetBorrowShared => 92,
        PrimitiveRole::ArrayEmpty => 95,
        PrimitiveRole::ArrayPushMove => 96,
        PrimitiveRole::StaticLen => 101,
        PrimitiveRole::Memory(_) => 106,
    }
}
pub fn compare(left: &PrimitiveRole, right: &PrimitiveRole) -> Ordering {
    // Equal parameterized variants already prove equal outer discriminants.
    // Comparing their payloads directly avoids constructing both wide outer
    // ordinal dispatch frames on every conversion comparison.
    handle (*left, *right) {
        (PrimitiveRole::Float(a), PrimitiveRole::Float(b)) => { let a_key = float_order(a); let b_key = float_order(b); Ord::cmp(&a_key, &b_key) },
        (PrimitiveRole::Memory(a), PrimitiveRole::Memory(b)) => { let a_key = memory_ordinal(a); let b_key = memory_ordinal(b); Ord::cmp(&a_key, &b_key) },
        _ => {
            let a = role_order(*left); let b = role_order(*right);
            Ord::cmp(&a, &b)
        },
    }
}
pub impl Ord for PrimitiveRole { cmp(left: &PrimitiveRole, right: &PrimitiveRole) -> Ordering { compare(left, right) } }
pub impl PartialOrd for PrimitiveRole {
    fn partial_cmp(left: &Self, right: &Self) -> Option<Ordering> { Some(Ord::cmp(left, right)) }
}
pub impl PartialEq for PrimitiveRole {
    eq(left: &PrimitiveRole, right: &PrimitiveRole) -> Bool { handle compare(left, right) { Ordering::Equal => true, _ => false } }
}
pub impl Eq for PrimitiveRole {}
pub impl Hash for PrimitiveRole {
    hash(value: &PrimitiveRole, state: &mut Hasher) -> () {
        Hasher::write_usize(&mut *state, role_order(*value));
        handle *value {
            PrimitiveRole::Float(primitive) => Hasher::write_usize(state, float_order(primitive)),
            PrimitiveRole::Memory(primitive) => Hasher::write_usize(state, memory_ordinal(primitive)),
            _ => (),
        }
    }
}
fn float_width(value: ScalarType) -> Option<usize> {
    handle value { ScalarType::F32 => Result::Ok(as<usize>(0)), ScalarType::F64 => Result::Ok(as<usize>(1)), _ => None }
}
fn integer_order(value: ScalarType) -> Option<usize> {
    handle value {
        ScalarType::U8 => Result::Ok(as<usize>(0)),
        ScalarType::U16 => Result::Ok(as<usize>(1)),
        ScalarType::U32 => Result::Ok(as<usize>(2)),
        ScalarType::U64 => Result::Ok(as<usize>(3)),
        ScalarType::U128 => Result::Ok(as<usize>(4)),
        ScalarType::Usize => Result::Ok(as<usize>(5)),
        ScalarType::I8 => Result::Ok(as<usize>(6)),
        ScalarType::I16 => Result::Ok(as<usize>(7)),
        ScalarType::I32 => Result::Ok(as<usize>(8)),
        ScalarType::I64 => Result::Ok(as<usize>(9)),
        ScalarType::I128 => Result::Ok(as<usize>(10)),
        ScalarType::Isize => Result::Ok(as<usize>(11)),
        _ => None,
    }
}
fn unchecked_conversion(from: ScalarType, to: ScalarType) -> Option<usize> {
    handle float_width(to) {
        Result::Err(_) => None,
        Result::Ok(target) => handle integer_order(from) {
            Result::Ok(integer) => Result::Ok(26 + integer * 2 + target),
            Result::Err(_) => handle float_width(from) {
                Result::Err(_) => None,
                Result::Ok(source) => handle source == target { true => None, false => Result::Ok(24 + source) },
            },
        },
    }
}
fn checked_conversion(from: ScalarType, to: ScalarType) -> Option<usize> {
    handle float_width(from) {
        Result::Err(_) => None,
        Result::Ok(source) => handle integer_order(to) {
            Result::Err(_) => None, Result::Ok(integer) => Result::Ok(50 + source * 12 + integer),
        },
    }
}
fn float_ordinal(value: FloatPrimitive) -> Option<usize> {
    handle value {
        FloatPrimitive::Binary { width: width, operation: op } => Result::Ok(width_order(width) * 5 + binary_order(op)),
        FloatPrimitive::Neg { width: width } => Result::Ok(10 + width_order(width)),
        FloatPrimitive::Compare { width: width, operation: op } => Result::Ok(12 + width_order(width) * 6 + comparison_order(op)),
        FloatPrimitive::Convert { from: from, to: to, checked: checked } => handle checked {
            true => checked_conversion(from, to), false => unchecked_conversion(from, to),
        },
        FloatPrimitive::ToBits { width: width } => Result::Ok(74 + width_order(width)),
        FloatPrimitive::FromBits { width: width } => Result::Ok(76 + width_order(width)),
    }
}
pub fn stable_tag(value: PrimitiveRole) -> Option<u8> {
    // Keep the parameterized families out of the wide leaf-tag frame. These
    // are the same frozen authority formulas, not additional runtime grants.
    handle value {
        PrimitiveRole::Memory(primitive) => Result::Ok(as<u8>(183 + memory_ordinal(primitive))),
        PrimitiveRole::Float(primitive) => handle float_ordinal(primitive) {
            Result::Err(_) => None, Result::Ok(ordinal) => Result::Ok(as<u8>(69 + ordinal)),
        },
        _ => leaf_stable_tag(value),
    }
}
fn leaf_stable_tag(value: PrimitiveRole) -> Option<u8> {
    handle value {
        PrimitiveRole::Memory(primitive) => Result::Ok(as<u8>(183 + memory_ordinal(primitive))),
        PrimitiveRole::Float(primitive) => handle float_ordinal(primitive) {
            Result::Err(_) => None, Result::Ok(ordinal) => Result::Ok(as<u8>(69 + ordinal)),
        },
        PrimitiveRole::Abort => Result::Ok(as<u8>(147)),
        PrimitiveRole::BranchBool => Result::Ok(as<u8>(0)),
        PrimitiveRole::TextByteLen => Result::Ok(as<u8>(1)),
        PrimitiveRole::TextConcat => Result::Ok(as<u8>(2)),
        PrimitiveRole::TextEq => Result::Ok(as<u8>(3)),
        PrimitiveRole::TextFromUtf8Checked => Result::Ok(as<u8>(4)),
        PrimitiveRole::TextAsBytes => Result::Ok(as<u8>(5)),
        PrimitiveRole::CharFromU32Checked => Result::Ok(as<u8>(6)),
        PrimitiveRole::CharToU32 => Result::Ok(as<u8>(7)),
        PrimitiveRole::BytesLen => Result::Ok(as<u8>(8)),
        PrimitiveRole::BytesConcat => Result::Ok(as<u8>(9)),
        PrimitiveRole::BytesGet => Result::Ok(as<u8>(10)),
        PrimitiveRole::BytesSlice => Result::Ok(as<u8>(11)),
        PrimitiveRole::BytesFromArrayMove => Result::Ok(as<u8>(12)),
        PrimitiveRole::BytesToArray => Result::Ok(as<u8>(13)),
        PrimitiveRole::BytesUtf8ValidUpTo => Result::Ok(as<u8>(14)),
        PrimitiveRole::Blake3 => Result::Ok(as<u8>(162)),
        PrimitiveRole::U32CheckedAdd => Result::Ok(as<u8>(15)),
        PrimitiveRole::U32CheckedSub => Result::Ok(as<u8>(16)),
        PrimitiveRole::U32CheckedMul => Result::Ok(as<u8>(17)),
        PrimitiveRole::U32CheckedDiv => Result::Ok(as<u8>(18)),
        PrimitiveRole::U32CheckedRem => Result::Ok(as<u8>(19)),
        PrimitiveRole::U32WrappingAdd => Result::Ok(as<u8>(20)),
        PrimitiveRole::U32WrappingSub => Result::Ok(as<u8>(21)),
        PrimitiveRole::U32WrappingMul => Result::Ok(as<u8>(22)),
        PrimitiveRole::U32WrappingShl => Result::Ok(as<u8>(23)),
        PrimitiveRole::U32WrappingShr => Result::Ok(as<u8>(24)),
        PrimitiveRole::U32CheckedShl => Result::Ok(as<u8>(25)),
        PrimitiveRole::U32CheckedShr => Result::Ok(as<u8>(26)),
        PrimitiveRole::U32Eq => Result::Ok(as<u8>(27)),
        PrimitiveRole::U32Lt => Result::Ok(as<u8>(28)),
        PrimitiveRole::U32Le => Result::Ok(as<u8>(29)),
        PrimitiveRole::U32ToUsize => Result::Ok(as<u8>(30)),
        PrimitiveRole::UsizeToU32Checked => Result::Ok(as<u8>(31)),
        PrimitiveRole::IntCheckedAdd => Result::Ok(as<u8>(32)),
        PrimitiveRole::IntCheckedDiv => Result::Ok(as<u8>(182)),
        PrimitiveRole::IntWrappingAdd => Result::Ok(as<u8>(33)),
        PrimitiveRole::IntConvertCheckedToI64 => Result::Ok(as<u8>(45)),
        PrimitiveRole::IntConvertWrappingToI64 => Result::Ok(as<u8>(46)),
        PrimitiveRole::IntConvertWrappingToU32 => Result::Ok(as<u8>(48)),
        PrimitiveRole::IntConvertWrappingToUsize => Result::Ok(as<u8>(50)),
        PrimitiveRole::IntConvertWrappingToU8 => Result::Ok(as<u8>(52)),
        PrimitiveRole::IntConvertWrappingToU16 => Result::Ok(as<u8>(54)),
        PrimitiveRole::IntConvertWrappingToI16 => Result::Ok(as<u8>(56)),
        PrimitiveRole::IntWrappingSub => Result::Ok(as<u8>(35)),
        PrimitiveRole::IntWrappingMul => Result::Ok(as<u8>(36)),
        PrimitiveRole::IntWrappingNeg => Result::Ok(as<u8>(161)),
        PrimitiveRole::IntEqual => Result::Ok(as<u8>(34)),
        PrimitiveRole::IntLess => Result::Ok(as<u8>(38)),
        PrimitiveRole::IntGreater => Result::Ok(as<u8>(39)),
        PrimitiveRole::IntBitAnd => Result::Ok(as<u8>(37)),
        PrimitiveRole::IntBitOr => Result::Ok(as<u8>(40)),
        PrimitiveRole::IntBitXor => Result::Ok(as<u8>(41)),
        PrimitiveRole::IntBitNot => Result::Ok(as<u8>(42)),
        PrimitiveRole::IntShr => Result::Ok(as<u8>(44)),
        PrimitiveRole::IntShl => Result::Ok(as<u8>(43)),
        PrimitiveRole::IntConvertCheckedToU32 => Result::Ok(as<u8>(47)),
        PrimitiveRole::IntConvertCheckedToUsize => Result::Ok(as<u8>(49)),
        PrimitiveRole::IntConvertCheckedToU8 => Result::Ok(as<u8>(51)),
        PrimitiveRole::IntConvertCheckedToU16 => Result::Ok(as<u8>(53)),
        PrimitiveRole::IntConvertCheckedToI16 => Result::Ok(as<u8>(55)),
        PrimitiveRole::IntConvertCheckedToI32 => Result::Ok(as<u8>(57)),
        PrimitiveRole::IntConvertWrappingToI32 => Result::Ok(as<u8>(58)),
