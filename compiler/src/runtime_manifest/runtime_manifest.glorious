use std::*;
use super::types;
use super::types::ScalarType;
use super::kernel::identity::PackageKey;
use super::kernel::identity::DefKey;
pub mod input;

// The finite authority protocol. New machine roles append stable tags; enum ordering
// and wire tags are distinct contracts; invalid public conversion shapes have
// no wire tag and must be rejected before a world can be fingerprinted.
pub enum FloatWidth { F32, F64 }
pub enum FloatBinaryOp { Add, Sub, Mul, Div, Rem }
pub enum FloatCompareOp { Eq, Ne, Lt, Le, Gt, Ge }
pub enum FloatPrimitive {
    Binary { width: FloatWidth, operation: FloatBinaryOp },
    Neg { width: FloatWidth },
    Compare { width: FloatWidth, operation: FloatCompareOp },
    Convert { from: ScalarType, to: ScalarType, checked: Bool },
    ToBits { width: FloatWidth }, FromBits { width: FloatWidth },
}
pub enum MemoryPrimitive {
    SizeOf, AlignOf, Null, Dangling, Allocate, Reallocate, Deallocate, IsNull,
    Offset, OffsetConst, Cast, AsConst, Read, Write, Copy, CopyNonoverlapping,
    BorrowShared, BorrowUnique,
    AsRawShared, AsRawUnique, CastConst, StaticUtf8Address, StaticBytesAddress,
    Forget, StaticBytesLen, PointerEq, PointerAddress,
}
fn memory_ordinal(value: MemoryPrimitive) -> usize {
    handle value {
        MemoryPrimitive::SizeOf => 0, MemoryPrimitive::AlignOf => 1,
        MemoryPrimitive::Null => 2, MemoryPrimitive::Dangling => 3,
        MemoryPrimitive::Allocate => 4, MemoryPrimitive::Reallocate => 5,
        MemoryPrimitive::Deallocate => 6, MemoryPrimitive::IsNull => 7,
        MemoryPrimitive::Offset => 8, MemoryPrimitive::OffsetConst => 9,
        MemoryPrimitive::Cast => 10, MemoryPrimitive::AsConst => 11,
        MemoryPrimitive::Read => 12, MemoryPrimitive::Write => 13,
        MemoryPrimitive::Copy => 14, MemoryPrimitive::CopyNonoverlapping => 15,
        MemoryPrimitive::BorrowShared => 16, MemoryPrimitive::BorrowUnique => 17,
        MemoryPrimitive::AsRawShared => 18, MemoryPrimitive::AsRawUnique => 19,
        MemoryPrimitive::CastConst => 20, MemoryPrimitive::StaticUtf8Address => 21,
        MemoryPrimitive::StaticBytesAddress => 22,
        MemoryPrimitive::Forget => 23, MemoryPrimitive::StaticBytesLen => 24,
        MemoryPrimitive::PointerEq => 25, MemoryPrimitive::PointerAddress => 26,
    }
}
fn memory_name(value: MemoryPrimitive) -> Str<'static> {
    handle value {
        MemoryPrimitive::SizeOf => "memory-size-of", MemoryPrimitive::AlignOf => "memory-align-of",
        MemoryPrimitive::Null => "memory-null", MemoryPrimitive::Dangling => "memory-dangling",
        MemoryPrimitive::Allocate => "memory-allocate", MemoryPrimitive::Reallocate => "memory-reallocate",
        MemoryPrimitive::Deallocate => "memory-deallocate", MemoryPrimitive::IsNull => "memory-is-null",
        MemoryPrimitive::Offset => "memory-offset", MemoryPrimitive::OffsetConst => "memory-offset-const",
        MemoryPrimitive::Cast => "memory-cast", MemoryPrimitive::AsConst => "memory-as-const",
        MemoryPrimitive::Read => "memory-read", MemoryPrimitive::Write => "memory-write",
        MemoryPrimitive::Copy => "memory-copy", MemoryPrimitive::CopyNonoverlapping => "memory-copy-nonoverlapping",
        MemoryPrimitive::BorrowShared => "memory-borrow-shared", MemoryPrimitive::BorrowUnique => "memory-borrow-unique",
        MemoryPrimitive::AsRawShared => "memory-as-raw-shared", MemoryPrimitive::AsRawUnique => "memory-as-raw-unique",
        MemoryPrimitive::CastConst => "memory-cast-const", MemoryPrimitive::StaticUtf8Address => "memory-static-utf8-address",
        MemoryPrimitive::StaticBytesAddress => "memory-static-bytes-address",
        MemoryPrimitive::Forget => "memory-forget", MemoryPrimitive::StaticBytesLen => "memory-static-bytes-len",
        MemoryPrimitive::PointerEq => "memory-pointer-eq", MemoryPrimitive::PointerAddress => "memory-pointer-address",
    }
}
