    Blake3,
    U32CheckedAdd,
    U32CheckedSub,
    U32CheckedMul,
    U32CheckedDiv,
    U32CheckedRem,
    U32WrappingAdd,
    U32WrappingSub,
    U32WrappingMul,
    U32WrappingShl,
    U32WrappingShr,
    U32CheckedShl,
    U32CheckedShr,
    U32Eq,
    U32Lt,
    U32Le,
    U32ToUsize,
    UsizeToU32Checked,
    IntCheckedAdd,
    IntCheckedDiv,
    IntWrappingAdd,
    IntConvertCheckedToI64,
    IntConvertWrappingToI64,
    IntConvertWrappingToU32,
    IntConvertWrappingToUsize,
    IntConvertWrappingToU8,
    IntConvertWrappingToU16,
    IntConvertWrappingToI16,
    IntWrappingSub,
