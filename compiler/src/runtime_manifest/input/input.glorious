use std::*;
use super::RuntimeManifestInput;
use super::PrimitiveSelector;
use super::HostImportSelector;
use super::LiteralViewSelector;
use super::LiteralViewKind;
use super::ManifestError;
use super::super::kernel::operation;
use super::super::kernel::order;
use super::super::request::names;

pub struct Limits { pub selectors: usize, pub host_imports: usize, pub literal_views: usize, pub text_bytes: usize }
pub enum Event { Continue, Ready }
pub enum Failure { Rejected(ManifestError), Control(operation::Failure), Capacity { name: u32, limit: usize }, Closed, Busy, Invariant }
pub struct Builder { private work: Option<Work>, private limits: Limits }
pub impl Use<[0, 1]> for Builder {}
pub struct Admitted { private value: RuntimeManifestInput }
struct Work {
    input: RuntimeManifestInput, selector_slots: Vec<Option<PrimitiveSelector>>, host_slots: Vec<Option<HostImportSelector>>,
    selectors: Vec<PrimitiveSelector>, hosts: Vec<HostImportSelector>, sorter: Option<order::Builder>, indices: Vec<usize>,
    comparison: Option<Comparison>, cursor: usize, byte: usize, field: usize, phase: Phase,
    utf8: Option<LiteralViewSelector>, octets: Option<LiteralViewSelector>, views: Vec<LiteralViewSelector>,
    duplicate_utf8: Bool, duplicate_octets: Bool,
}
struct Comparison { left: usize, right: usize, field: usize, byte: usize }
enum Decision { Continue(Comparison), Done(Ordering) }
enum Phase { Selectors, SelectorReverse, SelectorSort, SelectorOutput, SelectorValid, SelectorDuplicates,
    Hosts, HostReverse, HostSort, HostOutput, HostValid, HostDuplicates, Views, ViewUtf8, ViewOctets, Ready }

pub fn begin(value: RuntimeManifestInput, limits: Limits) -> Builder {
    Builder { work: Result::Ok(Work { input: value, selector_slots: Vec<Option<PrimitiveSelector>>::new(), host_slots: Vec<Option<HostImportSelector>>::new(),
        selectors: Vec<PrimitiveSelector>::new(), hosts: Vec<HostImportSelector>::new(), sorter: None, indices: Vec<usize>::new(), comparison: None,
        cursor: 0, byte: 0, field: 0, phase: Phase::Selectors, utf8: None, octets: None, views: Vec<LiteralViewSelector>::new(), duplicate_utf8: false, duplicate_octets: false }), limits: limits }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
pub fn value<'a>(admitted: &'a Admitted) -> &'a RuntimeManifestInput { &admitted.value }
pub fn into_input(admitted: Admitted) -> RuntimeManifestInput { handle admitted { Admitted { value: value } => value } }
fn control(result: Result<(), operation::Failure>) -> Result<(), Failure> {
    handle result { Result::Ok(_) => Result::Ok(()), Result::Err(error) => Result::Err(Failure::Control(error)) }
}
fn order_error(error: order::Failure) -> Failure {
    handle error { order::Failure::Control(error) => Failure::Control(error), _ => Failure::Invariant }
}
fn reset(work: &mut Work, next: Phase) -> Result<Event, Failure> {
    (*work).cursor = as<usize>(0); (*work).byte = as<usize>(0); (*work).field = as<usize>(0); (*work).phase = next;
    Result::Ok(Event::Continue)
}
fn gather_selectors(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle Vec::len(&work.input.selectors) > limits.selectors {
        true => Result::Err(Failure::Capacity { name: 0, limit: limits.selectors }),
        false => handle Vec::pop(&mut work.input.selectors) {
            Result::Err(_) => reset(work, Phase::SelectorReverse),
            Result::Ok(value) => { Vec::push(&mut work.selector_slots, Result::Ok(value)); Result::Ok(Event::Continue) },
        },
    }
}
fn gather_hosts(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle Vec::len(&work.input.host_imports) > limits.host_imports {
        true => Result::Err(Failure::Capacity { name: 1, limit: limits.host_imports }),
        false => handle Vec::pop(&mut work.input.host_imports) {
            Result::Err(_) => reset(work, Phase::HostReverse),
            Result::Ok(value) => { Vec::push(&mut work.host_slots, Result::Ok(value)); Result::Ok(Event::Continue) },
        },
    }
}
fn reverse_selectors(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    let count = Vec::len(&work.selector_slots);
    handle work.cursor < count / 2 {
        true => { Vec::swap(&mut work.selector_slots, work.cursor, count - 1 - work.cursor); (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
        false => { (*work).sorter = Result::Ok(order::begin(count, limits.selectors)); reset(work, Phase::SelectorSort) },
    }
}
fn reverse_hosts(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    let count = Vec::len(&work.host_slots);
    handle work.cursor < count / 2 {
        true => { Vec::swap(&mut work.host_slots, work.cursor, count - 1 - work.cursor); (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
        false => { (*work).sorter = Result::Ok(order::begin(count, limits.host_imports)); reset(work, Phase::HostSort) },
    }
}
fn selector_text<'a>(value: &'a PrimitiveSelector, field: usize) -> Str<'a> {
    handle field { 1 => String::as_str(&value.module_path), _ => String::as_str(&value.name) }
}
fn host_text<'a>(value: &'a HostImportSelector, field: usize) -> Str<'a> {
    handle field { 0 => String::as_str(&value.module_path), 1 => String::as_str(&value.name), 2 => String::as_str(&value.capability), _ => String::as_str(&value.symbol) }
}
fn decision(state: Comparison, answer: Option<Ordering>, last: usize) -> Decision {
    handle answer {
        Result::Err(_) => Decision::Continue(Comparison { left: state.left, right: state.right, field: state.field, byte: state.byte + 1 }),
        Result::Ok(order) => handle order {
            Ordering::Equal => handle state.field == last {
                true => Decision::Done(Ordering::Equal),
                false => Decision::Continue(Comparison { left: state.left, right: state.right, field: state.field + 1, byte: 0 }),
            },
            _ => Decision::Done(order),
        },
    }
}
fn compare_selectors(work: &Work, state: Comparison) -> Result<Decision, Failure> {
    handle Result::as_ref(Vec::get_unchecked(&work.selector_slots, state.left)) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(left) => handle Result::as_ref(Vec::get_unchecked(&work.selector_slots, state.right)) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(right) => handle state.field == 0 {
                true => Result::Ok(decision(state, Result::Ok(super::compare(&left.role, &right.role)), 2)),
                false => { let a = selector_text(left, state.field); let b = selector_text(right, state.field);
                    Result::Ok(decision(state, order::byte_order(a, b, state.byte), 2)) },
            },
        },
    }
}
fn compare_hosts(work: &Work, state: Comparison) -> Result<Decision, Failure> {
    handle Result::as_ref(Vec::get_unchecked(&work.host_slots, state.left)) {
        Result::Err(_) => Result::Err(Failure::Invariant),
        Result::Ok(left) => handle Result::as_ref(Vec::get_unchecked(&work.host_slots, state.right)) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(right) => { let a = host_text(left, state.field); let b = host_text(right, state.field);
                Result::Ok(decision(state, order::byte_order(a, b, state.byte), 3)) },
        },
    }
}
fn compare(work: &Work, state: Comparison, hosts: Bool) -> Result<Decision, Failure> {
    handle hosts { false => compare_selectors(work, state), true => compare_hosts(work, state) }
}
fn answer(work: &mut Work, result: Decision, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle result {
        Decision::Continue(state) => { (*work).comparison = Result::Ok(state); Result::Ok(Event::Continue) },
        Decision::Done(order) => handle Result::as_mut(&mut work.sorter) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(sorter) => handle order::compared(sorter, controls, order) {
                Result::Err(error) => Result::Err(order_error(error)), Result::Ok(_) => Result::Ok(Event::Continue),
            },
        },
    }
}
fn sort_step(work: &mut Work, controls: &mut operation::Controls, hosts: Bool, next: Phase) -> Result<Event, Failure> {
    handle Option::take(&mut work.comparison) {
        Result::Ok(state) => handle compare(& *work, state, hosts) {
            Result::Err(error) => Result::Err(error), Result::Ok(result) => answer(work, result, controls),
        },
        Result::Err(_) => handle Result::as_mut(&mut work.sorter) {
            Result::Err(_) => Result::Err(Failure::Invariant),
            Result::Ok(sorter) => handle order::step(&mut *sorter, &mut *controls) {
                Result::Err(error) => Result::Err(order_error(error)),
                Result::Ok(event) => handle event {
                    order::Event::Continue => Result::Ok(Event::Continue),
                    order::Event::Compare { left: left, right: right } => {
                        (*work).comparison = Result::Ok(Comparison { left: left, right: right, field: 0, byte: 0 }); Result::Ok(Event::Continue)
                    },
                    order::Event::Ready => handle order::finish(sorter, & *controls) {
                        Result::Err(error) => Result::Err(order_error(error)),
                        Result::Ok(indices) => { (*work).sorter = None; (*work).indices = indices; reset(work, next) },
                    },
                },
            },
        },
    }
}
fn output_selector(work: &mut Work) -> Result<Event, Failure> {
    handle work.cursor == Vec::len(&work.indices) {
        true => { (*work).selector_slots = Vec<Option<PrimitiveSelector>>::new(); (*work).indices = Vec<usize>::new(); reset(work, Phase::SelectorValid) },
        false => {
            let index = *Vec::get_unchecked(&work.indices, work.cursor);
            handle Vec::get_mut(&mut work.selector_slots, index) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(slot) => handle Option::take(slot) {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(value) => { Vec::push(&mut work.selectors, value); (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
                },
            }
        },
    }
}
fn output_host(work: &mut Work) -> Result<Event, Failure> {
    handle work.cursor == Vec::len(&work.indices) {
        true => { (*work).host_slots = Vec<Option<HostImportSelector>>::new(); (*work).indices = Vec<usize>::new(); reset(work, Phase::HostValid) },
        false => {
            let index = *Vec::get_unchecked(&work.indices, work.cursor);
            handle Vec::get_mut(&mut work.host_slots, index) {
                Result::Err(_) => Result::Err(Failure::Invariant),
                Result::Ok(slot) => handle Option::take(slot) {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(value) => { Vec::push(&mut work.hosts, value); (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
                },
            }
        },
    }
}
fn text_limit(value: &String, limit: usize, field: u32) -> Result<(), Failure> {
    handle String::len(value) > limit { true => Result::Err(Failure::Capacity { name: field, limit: limit }), false => Result::Ok(()) }
}
fn selector_limits(value: &PrimitiveSelector, limit: usize) -> Result<(), Failure> {
    handle text_limit(&value.module_path, limit, 2) { Result::Err(error) => Result::Err(error), Result::Ok(_) => text_limit(&value.name, limit, 3) }
}
fn validate_selector(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle work.cursor == Vec::len(&work.selectors) {
        true => { (*work).cursor = as<usize>(1); (*work).phase = Phase::SelectorDuplicates; Result::Ok(Event::Continue) },
        false => {
            let value = Vec::get_unchecked(&work.selectors, work.cursor);
            handle selector_limits(value, limits.text_bytes) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => handle super::validate_role(value.role) {
                    Result::Err(error) => Result::Err(Failure::Rejected(error)),
                    Result::Ok(_) => { (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
                },
            }
        },
    }
}
fn duplicate_selector(work: &mut Work) -> Result<Event, Failure> {
    handle work.cursor >= Vec::len(&work.selectors) {
        true => reset(work, Phase::Hosts),
        false => {
            let left = Vec::get_unchecked(&work.selectors, work.cursor - 1); let right = Vec::get_unchecked(&work.selectors, work.cursor);
            handle super::compare(&left.role, &right.role) {
                Ordering::Equal => Result::Err(Failure::Rejected(ManifestError::DuplicateRole(left.role))),
                Ordering::Greater => Result::Err(Failure::Invariant),
                Ordering::Less => { (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
            }
        },
    }
}
fn host_limits(value: &HostImportSelector, limit: usize, field: usize) -> Result<(), Failure> {
    handle field == 4 {
        true => Result::Ok(()),
        false => { let text = host_text(value, field);
            handle Str::len(text) > limit {
                true => Result::Err(Failure::Capacity { name: as<u32>(4 + field), limit: limit }), false => host_limits(value, limit, field + 1),
            }
        },
    }
}
fn host_empty(value: &HostImportSelector) -> Bool {
    handle String::is_empty(&value.module_path) { true => true, false => handle String::is_empty(&value.name) { true => true,
        false => handle String::is_empty(&value.capability) { true => true, false => String::is_empty(&value.symbol) } } }
}
fn host_error(value: &HostImportSelector, duplicate: Bool, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle control(operation::charge(&mut *controls, as<u64>(String::len(&value.module_path)))) {
        Result::Err(error) => Result::Err(error),
        Result::Ok(_) => handle control(operation::charge(controls, as<u64>(String::len(&value.name)))) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => {
                let module = String::as_str(&value.module_path); let name = String::as_str(&value.name);
                handle duplicate {
                    true => Result::Err(Failure::Rejected(ManifestError::DuplicateHostImport { module_path: Str::to_string(module), name: Str::to_string(name) })),
                    false => Result::Err(Failure::Rejected(ManifestError::InvalidHostImport { module_path: Str::to_string(module), name: Str::to_string(name) })),
                }
            },
        },
    }
}
fn host_character(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let value = Vec::get_unchecked(&work.hosts, work.cursor);
    handle host_empty(value) {
        true => host_error(value, false, controls),
        false => handle work.byte == String::len(&value.capability) {
            true => { (*work).cursor = work.cursor + 1; (*work).byte = as<usize>(0); Result::Ok(Event::Continue) },
            false => {
                let text = String::as_str(&value.capability);
                handle Str::char_at(text, work.byte) {
                    Result::Err(_) => Result::Err(Failure::Invariant),
                    Result::Ok(character) => handle as<u32>(character) == 42 {
                        true => host_error(value, false, controls),
                        false => handle names::whitespace(character) {
                            true => host_error(value, false, controls),
                            false => { (*work).byte = work.byte + char_utf8_len(character); Result::Ok(Event::Continue) },
                        },
                    },
                }
            },
        },
    }
}
fn validate_host(work: &mut Work, limits: Limits, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle work.cursor == Vec::len(&work.hosts) {
        true => { (*work).cursor = as<usize>(1); (*work).field = as<usize>(0); (*work).byte = as<usize>(0); (*work).phase = Phase::HostDuplicates; Result::Ok(Event::Continue) },
        false => handle host_limits(Vec::get_unchecked(&work.hosts, work.cursor), limits.text_bytes, 0) {
            Result::Err(error) => Result::Err(error), Result::Ok(_) => host_character(work, controls),
        },
    }
}
fn duplicate_host(work: &mut Work, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle work.cursor >= Vec::len(&work.hosts) {
        true => reset(work, Phase::Views),
        false => {
            let left = Vec::get_unchecked(&work.hosts, work.cursor - 1); let right = Vec::get_unchecked(&work.hosts, work.cursor);
            let a = host_text(left, work.field); let b = host_text(right, work.field);
            handle order::byte_order(a, b, work.byte) {
                Result::Err(_) => { (*work).byte = work.byte + 1; Result::Ok(Event::Continue) },
                Result::Ok(order) => handle order {
                    Ordering::Greater => Result::Err(Failure::Invariant),
                    Ordering::Less => { (*work).cursor = work.cursor + 1; (*work).field = as<usize>(0); (*work).byte = as<usize>(0); Result::Ok(Event::Continue) },
                    Ordering::Equal => handle work.field == 1 {
                        true => host_error(left, true, controls),
                        false => { (*work).field = as<usize>(1); (*work).byte = as<usize>(0); Result::Ok(Event::Continue) },
                    },
                },
            }
        },
    }
}
// There are exactly two data classes. Admit into disjoint slots and emit in
// kind order; no string comparison or unbounded sorting is required. Every
// admission and emission is still a charged, cancellable builder transition.
fn store_view(slot: &mut Option<LiteralViewSelector>, duplicate: &mut Bool, value: LiteralViewSelector) -> Result<Event, Failure> {
    handle Result::as_ref(& *slot) {
        Result::Ok(_) => { (*duplicate) = true; Result::Ok(Event::Continue) },
        Result::Err(_) => { (*slot) = Result::Ok(value); Result::Ok(Event::Continue) },
    }
}
fn gather_views(work: &mut Work, limits: Limits) -> Result<Event, Failure> {
    handle Vec::len(&work.input.literal_views) > limits.literal_views {
        true => Result::Err(Failure::Capacity { name: 8, limit: limits.literal_views }),
        false => handle Vec::pop(&mut work.input.literal_views) {
            Result::Err(_) => reset(work, Phase::ViewUtf8),
            Result::Ok(value) => handle text_limit(&value.module_path, limits.text_bytes, 9) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(_) => handle text_limit(&value.name, limits.text_bytes, 10) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(_) => handle value.kind {
                        LiteralViewKind::Utf8 => store_view(&mut work.utf8, &mut work.duplicate_utf8, value),
                        LiteralViewKind::Octets => store_view(&mut work.octets, &mut work.duplicate_octets, value),
                    },
                },
            },
        },
    }
}
fn output_view(work: &mut Work, utf8: Bool) -> Result<Event, Failure> {
    let duplicate = handle utf8 { true => work.duplicate_utf8, false => work.duplicate_octets };
    handle duplicate {
        true => { let kind = handle utf8 { true => LiteralViewKind::Utf8, false => LiteralViewKind::Octets };
            Result::Err(Failure::Rejected(ManifestError::DuplicateLiteralView(kind))) },
        false => emit_view(work, utf8),
    }
}
fn emit_view(work: &mut Work, utf8: Bool) -> Result<Event, Failure> {
    let value = handle utf8 { true => Option::take(&mut work.utf8), false => Option::take(&mut work.octets) };
    handle value { Result::Err(_) => (), Result::Ok(value) => Vec::push(&mut work.views, value) };
    handle utf8 { true => reset(work, Phase::ViewOctets), false => { (*work).phase = Phase::Ready; Result::Ok(Event::Ready) } }
}
fn transition(work: &mut Work, limits: Limits, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle work.phase {
        Phase::Selectors => gather_selectors(work, limits), Phase::SelectorReverse => reverse_selectors(work, limits),
        Phase::SelectorSort => sort_step(work, controls, false, Phase::SelectorOutput), Phase::SelectorOutput => output_selector(work),
        Phase::SelectorValid => validate_selector(work, limits), Phase::SelectorDuplicates => duplicate_selector(work),
        Phase::Hosts => gather_hosts(work, limits), Phase::HostReverse => reverse_hosts(work, limits),
        Phase::HostSort => sort_step(work, controls, true, Phase::HostOutput), Phase::HostOutput => output_host(work),
        Phase::HostValid => validate_host(work, limits, controls), Phase::HostDuplicates => duplicate_host(work, controls),
        Phase::Views => gather_views(work, limits), Phase::ViewUtf8 => output_view(work, true), Phase::ViewOctets => output_view(work, false),
        Phase::Ready => Result::Ok(Event::Ready),
    }
}
fn checked(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    // Charge before inspecting the builder as before, but construct the
    // public failure only on rejection. A successful tick needs no temporary
    // Result carrying the owning ManifestError variant and its cleanup.
    handle operation::charge(&mut *controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(work) => transition(work, builder.limits, controls),
        },
    }
}
pub fn step(builder: &mut Builder, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = checked(&mut *builder, controls);
    handle result { Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<Admitted, Failure> {
    handle control(operation::check(controls)) {
        Result::Err(error) => { abort(builder); Result::Err(error) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.phase {
                Phase::Ready => Result::Ok(Admitted { value: RuntimeManifestInput { standard_library: work.input.standard_library, selectors: work.selectors, host_imports: work.hosts, literal_views: work.views } }),
                _ => Result::Err(Failure::Busy),
            },
        },
    }
}
