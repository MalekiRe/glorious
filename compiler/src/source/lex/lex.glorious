use std::*;
use super::{Blob, Failure, Event};
use super::super::kernel::identity;
use super::super::kernel::operation;

// A single lossless token arena, shared by syntax and inspection consumers.
// Punctuation stores its ASCII byte; all offsets address the original Blob.
pub enum TokenKind { Identifier, Integer, Float, String, ByteString, Character,
    Operator, Punctuation(u8), Whitespace, LineComment, BlockComment, Invalid, End }
pub struct Token { kind: TokenKind, start: u32, end: u32,
    lexical_code: u32, delimiter_code: u32, matching: Option<usize> }
pub struct LexedFile { private file: identity::FileKey, private fingerprint: identity::Digest,
    private length: u32, private tokens: Vec<Token> }
pub struct Builder { private work: Option<Work> }
pub impl Use<[0, 1]> for Builder {}
struct Work { file: identity::FileKey, fingerprint: identity::Digest, length: u32,
    cursor: u32, start: u32, limit: usize, tokens: Vec<Token>, top: Option<usize>, state: State }
enum State { Start, Emit { kind: TokenKind, code: u32 }, Run(TokenKind), Lifetime, Block(u32),
    Digits(Number), AfterDigits(Number), NumberTail(Number),
    Quote(Quoted), Escape(Quoted), Unicode { quote: Quoted, scalar: u32, digits: u32 },
    Unclosed, Done }
struct Number { base: u32, prefixed: Bool, float: Bool, valid: Bool, saw: Bool, separator: Bool, part: u32 }
// kind: 0 string, 1 byte string, 2 character. The count is saturated at two.
struct Quoted { kind: u32, count: u32, valid: Bool }

pub fn begin(blob: &Blob, limit: usize, controls: &mut operation::Controls) -> Result<Builder, Failure> {
    handle operation::charge(controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle limit == 0 {
            true => Result::Err(Failure::Capacity),
            false => Result::Ok(Builder { work: Result::Ok(Work { file: super::file(blob),
                fingerprint: super::fingerprint(blob), length: super::length(blob), cursor: 0, start: 0,
                limit: limit, tokens: Vec<Token>::new(), top: None, state: State::Start }) }),
        },
    }
}
pub fn abort(builder: &mut Builder) -> () { (*builder).work = None; }
pub fn progress(builder: &Builder) -> Result<u32, Failure> {
    handle Result::as_ref(&builder.work) { Result::Err(_) => Result::Err(Failure::Closed), Result::Ok(work) => Result::Ok(work.cursor) }
}
// The driver reserves this exact next capacity delta before step(). Scanning
// never allocates: token publication is a separate, inspectable transition.
// Unresolved opener links temporarily use the private token matching slots;
// every link becomes a real pair or None before the product is published.
pub fn next_memory(builder: &Builder) -> Result<u64, Failure> {
    handle Result::as_ref(&builder.work) {
        Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(work) => handle work.state {
            State::Emit { kind: _, code: _ } => handle Vec::len(&work.tokens) < work.limit {
                false => Result::Err(Failure::Capacity),
                true => Result::Ok(as<u64>(Vec::reserved_backing_bytes(&work.tokens, 1) - Vec::backing_bytes(&work.tokens))),
            },
            _ => Result::Ok(0),
        },
    }
}
pub fn builder_memory(builder: &Builder) -> Result<u64, Failure> {
    handle Result::as_ref(&builder.work) { Result::Err(_) => Result::Err(Failure::Closed),
        Result::Ok(work) => Result::Ok(as<u64>(Vec::backing_bytes(&work.tokens))) }
}
pub fn product_memory(value: &LexedFile) -> u64 { as<u64>(Vec::backing_bytes(&value.tokens)) }
pub fn step(builder: &mut Builder, blob: &Blob, controls: &mut operation::Controls) -> Result<Event, Failure> {
    let result = checked(&mut *builder, blob, controls);
    handle result { Result::Ok(event) => Result::Ok(event), Result::Err(error) => { abort(builder); Result::Err(error) } }
}
fn checked(builder: &mut Builder, blob: &Blob, controls: &mut operation::Controls) -> Result<Event, Failure> {
    handle operation::charge(controls, 1) {
        Result::Err(error) => Result::Err(Failure::Control(error)),
        Result::Ok(_) => handle Result::as_mut(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle identity::equal(work.file.digest, super::file(blob).digest)
                and { identity::equal(work.fingerprint, super::fingerprint(blob)) } and { work.length == super::length(blob) } {
                false => Result::Err(Failure::SourceMismatch), true => advance(work, super::bytes(blob)),
            },
        },
    }
}
pub fn finish(builder: &mut Builder, controls: &operation::Controls) -> Result<LexedFile, Failure> {
    handle operation::check(controls) {
        Result::Err(error) => { abort(builder); Result::Err(Failure::Control(error)) },
        Result::Ok(_) => handle Option::take(&mut builder.work) {
            Result::Err(_) => Result::Err(Failure::Closed),
            Result::Ok(work) => handle work.state {
                State::Done => Result::Ok(LexedFile { file: work.file, fingerprint: work.fingerprint,
                    length: work.length, tokens: work.tokens }),
                _ => Result::Err(Failure::Busy),
            },
        },
    }
}
pub fn file(value: &LexedFile) -> identity::FileKey { value.file }
pub fn fingerprint(value: &LexedFile) -> identity::Digest { value.fingerprint }
pub fn product_fingerprint(value: &LexedFile) -> Result<identity::Digest, Failure> {
    let buffer = ByteBuf::new(128);
    handle identity::part(&mut buffer, b"grandiose-lex-v1") {
        Result::Err(_) => Result::Err(Failure::Identity), Result::Ok(_) =>
            handle identity::write_digest(&mut buffer, value.file.digest) {
                Result::Err(_) => Result::Err(Failure::Identity), Result::Ok(_) =>
                    handle identity::write_digest(&mut buffer, value.fingerprint) {
                        Result::Err(_) => Result::Err(Failure::Identity), Result::Ok(_) =>
                            handle identity::hash(ByteBuf::view(&buffer)) {
                                Result::Err(_) => Result::Err(Failure::Identity), Result::Ok(fingerprint) => Result::Ok(fingerprint) } } } }
}
pub fn tokens<'a>(value: &'a LexedFile) -> Slice<'a, Token> { Vec::as_slice(&value.tokens) }
pub fn token_count(value: &LexedFile) -> usize { Vec::len(&value.tokens) }
// Diagnostics are stored on their source-ordered token, so lexical and
// delimiter clients can enumerate independently without a recovery sort.
pub fn diagnostic_message(code: u32) -> Option<Str<'static>> {
    handle code {
        1001 => Result::Ok("invalid source character"),
        1002 => Result::Ok("unterminated string literal"),
        1003 => Result::Ok("unterminated character literal"),
        1004 => Result::Ok("unterminated block comment"),
        1005 => Result::Ok("mismatched closing delimiter"),
        1006 => Result::Ok("closing delimiter has no opener"),
        1007 => Result::Ok("unclosed delimiter"),
        1008 => Result::Ok("malformed numeric literal"),
        1009 => Result::Ok("invalid escape sequence in string literal"),
        1010 => Result::Ok("character literal must contain exactly one scalar value"),
        1011 => Result::Ok("invalid escape sequence in byte string literal"),
        1012 => Result::Ok("unterminated byte string literal"),
        _ => None,
    }
}
pub fn text<'a>(value: &LexedFile, blob: &'a Blob, index: usize) -> Result<Str<'a>, Failure> {
    handle identity::equal(value.file.digest, super::file(blob).digest)
        and { identity::equal(value.fingerprint, super::fingerprint(blob)) } and { value.length == super::length(blob) } {
        false => Result::Err(Failure::SourceMismatch),
        true => handle Vec::get(&value.tokens, index) {
            Result::Err(_) => Result::Err(Failure::Offset),
            Result::Ok(token) => handle Str<'a>::subslice(super::text(blob), as<usize>(token.start), as<usize>(token.end - token.start)) {
                Result::Err(_) => Result::Err(Failure::Offset), Result::Ok(text) => Result::Ok(text),
            },
        },
    }
}
// EOF is outside the byte range, so no unchecked access can observe it.
fn byte(bytes: Slice<u8>, offset: u32) -> u32 {
    handle as<usize>(offset) < Slice::len(&bytes) { false => 256, true => as<u32>(*Slice::get_unchecked(bytes, as<usize>(offset))) }
}
fn digit(value: u32) -> u32 {
    handle value >= 48 and { value <= 57 } { true => value - 48,
        false => handle value >= 97 and { value <= 102 } { true => value - 87,
            false => handle value >= 65 and { value <= 70 } { true => value - 55, false => 256 } } }
}
fn identifier_start(value: u32) -> Bool { (value >= 65 and { value <= 90 }) or { value >= 97 and { value <= 122 } } or { value == 95 } }
fn identifier(value: u32) -> Bool { identifier_start(value) or { value >= 48 and { value <= 57 } } }
fn whitespace(value: u32) -> Bool { value == 32 or { value == 9 } or { value == 10 } or { value == 13 } }
fn punctuation(value: u32) -> Bool { handle value { 40 => true, 41 => true, 91 => true, 93 => true, 123 => true,
    125 => true, 44 => true, 59 => true, 58 => true, 46 => true, _ => false } }
fn operator(value: u32) -> Bool { handle value { 43 => true, 45 => true, 42 => true, 47 => true, 37 => true, 61 => true,
    33 => true, 60 => true, 62 => true, 38 => true, 124 => true, 94 => true, 126 => true, 63 => true, 64 => true, _ => false } }
fn width(value: u32) -> u32 {
    handle value >= 192 and { value <= 223 } { true => 2, false => handle value >= 224 and { value <= 239 } {
        true => 3, false => handle value >= 240 and { value <= 247 } { true => 4, false => 1 } } }
}
fn state(work: &mut Work, next: State) -> Result<Event, Failure> { (*work).state = next; Result::Ok(Event::Continue) }
fn token_mut<'a>(tokens: &'a mut Vec<Token>, index: usize) -> &'a mut Token {
    SliceMut<'a, Token>::get_unchecked(Vec::as_mut_slice(tokens), index)
}
fn emit(work: &mut Work, kind: TokenKind, code: u32) -> Result<Event, Failure> {
    state(work, State::Emit { kind: kind, code: code })
}
fn push_token(work: &mut Work, kind: TokenKind, code: u32) -> Result<Event, Failure> {
    handle Vec::len(&work.tokens) < work.limit {
        false => Result::Err(Failure::Capacity),
        true => {
            let index = Vec::len(&work.tokens);
            Vec::push(&mut work.tokens, Token { kind: kind, start: work.start, end: work.cursor,
                lexical_code: code, delimiter_code: 0, matching: None });
            handle kind {
                TokenKind::Punctuation(value) => pair(&mut *work, index, value),
                _ => (),
            };
            state(work, handle kind { TokenKind::End => State::Unclosed, _ => State::Start })
        },
    }
}
fn pair(work: &mut Work, index: usize, value: u8) -> () {
    handle value == 40 or { value == 91 } or { value == 123 } {
        true => { (*token_mut(&mut work.tokens, index)).matching = work.top; (*work).top = Result::Ok(index); },
        false => handle value == 41 or { value == 93 } or { value == 125 } {
        true => handle work.top {
            Result::Err(_) => { (*token_mut(&mut work.tokens, index)).delimiter_code = as<u32>(1006); },
            Result::Ok(open_index) => {
                let open = Vec::get_unchecked(&work.tokens, open_index).kind;
                let matches = handle open { TokenKind::Punctuation(40) => value == 41,
                    TokenKind::Punctuation(91) => value == 93, TokenKind::Punctuation(123) => value == 125, _ => false };
                handle matches {
                    false => { (*token_mut(&mut work.tokens, index)).delimiter_code = as<u32>(1005); },
                    true => {
                        (*work).top = Vec::get_unchecked(&work.tokens, open_index).matching;
                        (*token_mut(&mut work.tokens, index)).matching = Result::Ok(open_index);
                        (*token_mut(&mut work.tokens, open_index)).matching = Result::Ok(index);
                    },
                }
            },
        },
        false => (),
        },
    }
}
fn advance(work: &mut Work, bytes: Slice<u8>) -> Result<Event, Failure> {
    handle work.state {
        State::Start => start(work, bytes),
        State::Emit { kind, code } => push_token(work, kind, code),
        State::Run(kind) => run(work, bytes, kind),
        State::Lifetime => lifetime(work, bytes),
        State::Block(depth) => block(work, bytes, depth),
        State::Digits(number) => digits(work, bytes, number),
        State::AfterDigits(number) => after_digits(work, bytes, number),
        State::NumberTail(number) => number_tail(work, bytes, number),
        State::Quote(quote) => quoted(work, bytes, quote),
        State::Escape(quote) => escape(work, bytes, quote),
        State::Unicode { quote, scalar, digits } => unicode(work, bytes, quote, scalar, digits),
        State::Unclosed => handle work.top {
            Result::Ok(index) => {
                (*work).top = Vec::get_unchecked(&work.tokens, index).matching;
                let token = token_mut(&mut work.tokens, index);
                (*token).delimiter_code = as<u32>(1007); (*token).matching = None;
                Result::Ok(Event::Continue)
            },
            Result::Err(_) => { (*work).state = State::Done; Result::Ok(Event::Ready) },
        },
        State::Done => Result::Ok(Event::Ready),
    }
}
fn start(work: &mut Work, bytes: Slice<u8>) -> Result<Event, Failure> {
    (*work).start = work.cursor;
    let first = byte(bytes, work.cursor);
    let second = handle work.cursor < work.length { true => byte(bytes, work.cursor + 1), false => 256 };
    handle first {
        256 => emit(work, TokenKind::End, 0),
        32 => start_space(work), 9 => start_space(work), 10 => start_space(work), 13 => start_space(work),
        47 => handle second {
            47 => { (*work).cursor = work.cursor + 2; state(work, State::Run(TokenKind::LineComment)) },
            42 => { (*work).cursor = work.cursor + 2; state(work, State::Block(1)) },
            _ => start_operator(work, first, second),
        },
        34 => { (*work).cursor = work.cursor + 1; state(work, State::Quote(Quoted { kind: 0, count: 0, valid: true })) },
        98 => handle second == 34 {
            true => { (*work).cursor = work.cursor + 2; state(work, State::Quote(Quoted { kind: 1, count: 0, valid: true })) },
            false => { (*work).cursor = work.cursor + 1; state(work, State::Run(TokenKind::Identifier)) },
        },
        39 => { (*work).cursor = work.cursor + 1;
            handle identifier_start(second) { true => state(work, State::Lifetime),
                false => state(work, State::Quote(Quoted { kind: 2, count: 0, valid: true })) } },
        _ => handle first >= 48 and { first <= 57 } {
            true => start_number(work, bytes, first, second),
            false => handle identifier_start(first) {
                true => { (*work).cursor = work.cursor + 1; state(work, State::Run(TokenKind::Identifier)) },
                false => handle punctuation(first) {
                    true => { (*work).cursor = work.cursor + 1; emit(work, TokenKind::Punctuation(as<u8>(first)), 0) },
                    false => handle operator(first) { true => start_operator(work, first, second),
                        false => { (*work).cursor = work.cursor + width(first); emit(work, TokenKind::Invalid, 1001) } },
                },
            },
        },
    }
}
fn start_operator(work: &mut Work, first: u32, second: u32) -> Result<Event, Failure> {
    (*work).cursor = work.cursor + 1;
    handle (first == 33 and { second == 47 }) or { (first == 60 or { first == 62 }) and { second == first } }
        or { first == 60 and { second == 38 or { second == 33 } or { second == 42 } } } {
        true => emit(work, TokenKind::Operator, 0), false => state(work, State::Run(TokenKind::Operator)),
    }
}
fn start_space(work: &mut Work) -> Result<Event, Failure> {
    (*work).cursor = work.cursor + 1; state(work, State::Run(TokenKind::Whitespace))
}
fn run(work: &mut Work, bytes: Slice<u8>, kind: TokenKind) -> Result<Event, Failure> {
    let next = byte(bytes, work.cursor);
    let continues = handle kind { TokenKind::Whitespace => whitespace(next), TokenKind::Identifier => identifier(next),
        TokenKind::LineComment => next != 10 and { next != 256 }, TokenKind::Operator => operator(next), _ => false };
    handle continues { true => { (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) }, false => emit(work, kind, 0) }
}
fn lifetime(work: &mut Work, bytes: Slice<u8>) -> Result<Event, Failure> {
    let next = byte(bytes, work.cursor);
    handle identifier(next) {
        true => { (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
        false => handle next == 39 {
            false => emit(work, TokenKind::Identifier, 0),
            true => {
                // Identifier payloads are ASCII: no rescanning or rollback is needed.
                let valid = work.cursor - work.start == 2;
                (*work).cursor = work.cursor + 1;
                handle valid { true => emit(work, TokenKind::Character, 0), false => emit(work, TokenKind::Invalid, 1010) }
            },
        },
    }
}
fn block(work: &mut Work, bytes: Slice<u8>, depth: u32) -> Result<Event, Failure> {
    handle work.cursor == work.length {
        true => emit(work, TokenKind::Invalid, 1004),
        false => {
            let first = byte(bytes, work.cursor); let second = byte(bytes, work.cursor + 1);
            handle first == 47 and { second == 42 } {
                true => { (*work).cursor = work.cursor + 2; state(work, State::Block(depth + 1)) },
                false => handle first == 42 and { second == 47 } {
                    true => { (*work).cursor = work.cursor + 2; handle depth == 1 {
                        true => emit(work, TokenKind::BlockComment, 0), false => state(work, State::Block(depth - 1)) } },
                    false => { (*work).cursor = work.cursor + 1; Result::Ok(Event::Continue) },
                },
            }
        },
    }
}
fn start_number(work: &mut Work, bytes: Slice<u8>, first: u32, second: u32) -> Result<Event, Failure> {
    let base = as<u32>(handle first == 48 { false => 10, true => handle second { 98 => 2, 111 => 8, 120 => 16, _ => 10 } });
    let prefixed = base != 10;
    handle prefixed { false => (), true => { (*work).cursor = work.cursor + 2;
        handle byte(bytes, work.cursor) == 95 { false => (), true => { (*work).cursor = work.cursor + 1; } } } };
    state(work, State::Digits(Number { base: base, prefixed: prefixed, float: false, valid: true, saw: false, separator: false, part: 0 }))
}
fn digits(work: &mut Work, bytes: Slice<u8>, number: Number) -> Result<Event, Failure> {
    let next = byte(bytes, work.cursor);
    handle digit(next) < number.base {
        true => { (*work).cursor = work.cursor + 1; number.saw = true; number.separator = false; state(work, State::Digits(number)) },
        false => handle next == 95 {
            true => { (*work).cursor = work.cursor + 1; number.valid = number.valid and { number.saw } and { !number.separator };
                number.separator = true; state(work, State::Digits(number)) },
            false => { number.valid = number.valid and { number.saw } and { !number.separator }; state(work, State::AfterDigits(number)) },
        },
    }
}
fn after_digits(work: &mut Work, bytes: Slice<u8>, number: Number) -> Result<Event, Failure> {
    let next = byte(bytes, work.cursor);
    let fraction = handle work.cursor < work.length { false => false,
        true => next == 46 and { byte(bytes, work.cursor + 1) >= 48 } and { byte(bytes, work.cursor + 1) <= 57 } };
    handle !number.prefixed and { number.part == 0 } and { fraction } {
        true => { (*work).cursor = work.cursor + 1; number.float = true; number.part = as<u32>(1);
            number.saw = false; number.separator = false; state(work, State::Digits(number)) },
        false => handle !number.prefixed and { number.part < 2 } and { next == 101 or { next == 69 } } {
            true => { (*work).cursor = work.cursor + 1; let sign = byte(bytes, work.cursor);
                handle sign == 43 or { sign == 45 } { false => (), true => { (*work).cursor = work.cursor + 1; } };
                number.float = true; number.part = as<u32>(2); number.saw = false; number.separator = false;
                state(work, State::Digits(number)) },
            false => state(work, State::NumberTail(number)),
        },
    }
}
fn number_tail(work: &mut Work, bytes: Slice<u8>, number: Number) -> Result<Event, Failure> {
    handle identifier(byte(bytes, work.cursor)) {
        true => { (*work).cursor = work.cursor + 1; number.valid = false; state(work, State::NumberTail(number)) },
        false => handle number.valid { false => emit(work, TokenKind::Invalid, 1008),
            true => handle number.float { true => emit(work, TokenKind::Float, 0), false => emit(work, TokenKind::Integer, 0) } },
    }
}
fn quoted(work: &mut Work, bytes: Slice<u8>, quote: Quoted) -> Result<Event, Failure> {
    let next = byte(bytes, work.cursor);
    let closing = handle quote.kind == 2 { true => as<u32>(39), false => as<u32>(34) };
    handle next == closing {
        true => {
            (*work).cursor = work.cursor + 1;
            handle quote.valid and { quote.kind != 2 or { quote.count == 1 } } {
                true => emit(work, handle quote.kind { 0 => TokenKind::String, 1 => TokenKind::ByteString, _ => TokenKind::Character }, 0),
                false => emit(work, TokenKind::Invalid, handle quote.kind { 0 => 1009, 1 => 1011, _ => 1010 }),
            }
        },
        false => handle next == 10 or { next == 256 } {
            true => emit(work, TokenKind::Invalid, handle quote.kind { 0 => 1002, 1 => 1012, _ => 1003 }),
            false => handle next == 92 {
                true => { (*work).cursor = work.cursor + 1; state(work, State::Escape(quote)) },
                false => { (*work).cursor = work.cursor + width(next); quote_end(work, quote, true) },
            },
        },
    }
}
fn quote_end(work: &mut Work, quote: Quoted, valid: Bool) -> Result<Event, Failure> {
    quote.valid = quote.valid and { valid };
    handle quote.count < 2 { true => { quote.count = quote.count + 1; }, false => () };
    state(work, State::Quote(quote))
}
fn escape(work: &mut Work, bytes: Slice<u8>, quote: Quoted) -> Result<Event, Failure> {
    let selector = byte(bytes, work.cursor);
    handle selector == 256 {
        true => quote_end(work, quote, false),
        false => {
            (*work).cursor = work.cursor + 1;
            handle selector {
                110 => quote_end(work, quote, true), 114 => quote_end(work, quote, true),
                116 => quote_end(work, quote, true), 48 => quote_end(work, quote, true),
                34 => quote_end(work, quote, true), 39 => quote_end(work, quote, true), 92 => quote_end(work, quote, true),
                120 => hex_escape(work, bytes, quote),
                117 => handle byte(bytes, work.cursor) == 123 {
                    false => quote_end(work, quote, false),
                    true => { (*work).cursor = work.cursor + 1; state(work, State::Unicode { quote: quote, scalar: 0, digits: 0 }) },
                },
                _ => quote_end(work, quote, false),
            }
        },
    }
}
fn hex_escape(work: &mut Work, bytes: Slice<u8>, quote: Quoted) -> Result<Event, Failure> {
    let first = byte(bytes, work.cursor);
    handle first == 256 { true => quote_end(work, quote, false), false => {
        let second = byte(bytes, work.cursor + 1);
        // Scalar and byte escapes intentionally differ on a truncated first octet.
        handle second == 256 and { quote.kind != 1 } {
            true => { (*work).cursor = work.cursor + 1; quote_end(work, quote, false) },
            false => handle digit(first) < 16 and { digit(second) < 16 } {
                false => quote_end(work, quote, false),
                true => { (*work).cursor = work.cursor + 2; quote_end(work, quote, quote.kind == 1 or { digit(first) * 16 + digit(second) < 128 }) },
            },
        }
    } }
}
fn unicode(work: &mut Work, bytes: Slice<u8>, quote: Quoted, scalar: u32, digits: u32) -> Result<Event, Failure> {
    let next = byte(bytes, work.cursor);
    handle next == 125 {
        true => { (*work).cursor = work.cursor + 1;
            quote_end(work, quote, digits > 0 and { scalar <= 1114111 } and { !(scalar >= 55296 and { scalar <= 57343 }) }) },
        false => handle digit(next) < 16 and { digits < 6 } {
            false => quote_end(work, quote, false),
            true => { (*work).cursor = work.cursor + 1;
                state(work, State::Unicode { quote: quote, scalar: scalar * 16 + digit(next), digits: digits + 1 }) },
        },
    }
}
