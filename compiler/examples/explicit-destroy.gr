struct Ticket {
    value: i32,
}

struct Affine {
    value: i32,
}

struct Holder<F> {
    callback: F,
}

enum Resource<F> {
    Empty,
    Full(F),
}

impl Use<[1,1]> for Ticket {}
impl Use<[0,1]> for Affine {}

discard<F, R>(body: F) -> ()
    where F: Fn<(), Output = R> {
    destroy(body)
}

discard_holder<F, R>(holder: Holder<F>) -> ()
    where F: Fn<(), Output = R> {
    destroy(holder)
}

discard_resource<F, R>(resource: Resource<F>) -> ()
    where F: Fn<(), Output = R> {
    destroy(resource)
}

make_and_ignore<F, R>(body: F) -> i32
    where F: Fn<(), Output = R> {
    let holder: Holder<F> = Holder { callback: body };
    42
}

main() -> i32 {
    let ticket: Ticket = Ticket { value: 7 };
    let affine: Affine = Affine { value: 42 };
    destroy(ticket);
    discard({
        let value: i32 = 40 + 2;
        value
    });
    discard_holder(Holder { callback: {
        let value: i32 = 42;
        value
    } });
    discard_resource(Resource::Full({
        let value: i32 = 42;
        value
    }));
    make_and_ignore({ affine.value });
    42
}
