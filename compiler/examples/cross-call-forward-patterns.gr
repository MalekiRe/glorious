enum Choice {
    First(i32),
    Second(i32)
}

effect Outer {
    [1, 1] ask() -> i32;
}

effect Select {
    [1, 1] select(choice: Choice) -> i32;
}

selected(choice: Choice) -> i32 / {Outer, Select} {
    perform Select::select(choice)
}

run(choice: Choice) -> i32 / {Outer} {
    handle (selected(choice)) {
        Select::select(Choice::First(value)) with k => resume(k, value),
        Select::select(Choice::Second(value)) with k => resume(k, value)
    }
}

main() -> i32 {
    handle (run(Choice::First(42))) {
        Outer::ask() with k => resume(k, 0)
    }
}
