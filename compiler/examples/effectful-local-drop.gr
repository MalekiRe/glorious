struct Resource {
    value: i32,
}

impl Use<[0,1]> for Resource {}

impl Drop for Resource {
    drop(&mut self) -> { () }
}

effect Stop {
    [0,1] stop() -> i32;
}

run() -> i32 / {Stop} {
    let resource: Resource = Resource { value: 42 };
    let ignored: i32 = perform Stop::stop();
    destroy(resource);
    ignored + 1000
}

cancelled() -> i32 {
    handle (run()) {
        Stop::stop() with k => {
            cancel(k);
            42
        }
    }
}

resumed() -> i32 {
    handle (run()) {
        Stop::stop() with k => resume(k, -958)
    }
}

main() -> i32 {
    cancelled() + resumed() - 42
}
