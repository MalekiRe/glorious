enum Bool {
    True,
    False,
}

effect BoolCase {
    inspect(value: Bool) -> !;
}

effect Choose {
    [1, 1] choose() -> i32;
}

choose<F, G, R>(condition: Bool, first: F, second: G) -> R
where F: Fn<(), Output = R>, G: Fn<(), Output = R> {
    handle perform BoolCase::inspect(condition) {
        BoolCase::inspect(Bool::True) => first(),
        BoolCase::inspect(Bool::False) => second()
    }
}

run(condition: Bool) -> i32 {
    handle {
        let selected: i32 = perform Choose::choose();
        selected + 1
    } {
        Choose::choose() with k => choose(
            condition,
            { resume(k, 40) },
            { resume(k, 41) }
        )
    }
}

main() -> i32 {
    run(Bool::True) + run(Bool::False)
}
