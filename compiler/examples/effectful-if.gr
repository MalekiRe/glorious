enum Result<T, E> {
    Ok(T),
    Err(E),
}

type Option<T> = Result<T, ()>;
type Bool = Option<()>;

infixr 1 else;

effect ResultCase<T, E> {
    inspect(value: Result<T, E>) -> !;
}

effect Ask {
    [1, 1] value() -> i32;
}

if<A, E, B, F>(condition: Result<A, E>, body: F) -> Result<B, E>
where F: Fn<(), Output = B>, A: Use<[0, 0]> {
    handle perform ResultCase::inspect(condition) {
        ResultCase::inspect(Result::Ok(_)) => Result::Ok(body()),
        ResultCase::inspect(Result::Err(error)) => Result::Err(error)
    }
}

else<A, E, F>(value: Result<A, E>, fallback: F) -> A
where F: Fn<(), Output = A>, E: Use<[0, 0]> {
    handle perform ResultCase::inspect(value) {
        ResultCase::inspect(Result::Ok(result)) => result,
        ResultCase::inspect(Result::Err(_)) => fallback()
    }
}

program() -> i32 / {Ask} {
    let one: i32 = 1;
    let condition: Bool = one > 0;
    if(condition) {
        perform Ask::value()
    } else {
        0
    }
}

fallback_program() -> i32 / {Ask} {
    let one: i32 = 1;
    let condition: Bool = one < 0;
    if(condition) {
        0
    } else {
        perform Ask::value()
    }
}

main() -> i32 {
    let first: i32 = handle (program()) {
        Ask::value() with k => resume(k, 42)
    };
    let second: i32 = handle (fallback_program()) {
        Ask::value() with k => resume(k, 42)
    };
    first + second
}
