struct Pair {
    left: i32,
    right: i32
}

effect Ask {
    [1, 1] ask(value: i32) -> i32;
}

ask(value: i32) -> i32 / {Ask} {
    perform Ask::ask(value)
}

make() -> Pair / {Ask} {
    Pair {
        left: ask(20),
        right: ask(22)
    }
}

answer() -> i32 / {Ask} {
    let pair: Pair = make();
    pair.left + pair.right
}

main() -> i32 {
    handle (answer()) {
        Ask::ask(value) with k => resume(k, value)
    }
}
