struct Pair {
    left: i32,
    right: i32
}

enum Wrapped {
    Empty,
    Pair(Pair)
}

effect WrappedCase {
    inspect(value: Wrapped) -> !;
}

effect Ask {
    [1, 1] ask() -> i32;
}

consume(value: Wrapped) -> i32 {
    handle perform WrappedCase::inspect(value) {
        WrappedCase::inspect(Wrapped::Empty) => 0,
        WrappedCase::inspect(Wrapped::Pair(pair)) => pair.left + pair.right
    }
}

ask_value() -> i32 / {Ask} {
    perform Ask::ask()
}

main() -> i32 {
    handle (ask_value()) {
        Ask::ask() with k => consume(Wrapped::Pair(Pair {
            left: resume(k, 40),
            right: 2
        }))
    }
}
