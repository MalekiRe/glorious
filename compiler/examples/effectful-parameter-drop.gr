struct Resource {
    value: i32,
}

impl Use<[0,1]> for Resource {}

impl Drop for Resource {
    drop(&mut self) -> { () }
}

effect Stop {
    [0,1] stop() -> i32;
}

run(resource: Resource) -> i32 / {Stop} {
    let ignored: i32 = perform Stop::stop();
    destroy(resource);
    ignored + 1000
}

main() -> i32 {
    handle (run(Resource { value: 42 })) {
        Stop::stop() with k => {
            cancel(k);
            42
        }
    }
}
