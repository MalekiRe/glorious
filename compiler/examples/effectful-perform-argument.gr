effect Ask {
    [1, 1] ask() -> i32;
}

effect Echo {
    [1, 1] echo(value: i32) -> i32;
}

pipeline() -> i32 / {Ask, Echo} {
    perform Echo::echo(perform Ask::ask())
}

answer() -> i32 / {Echo} {
    handle (pipeline()) {
        Ask::ask() with k => resume(k, 40)
    }
}

main() -> i32 {
    handle (answer()) {
        Echo::echo(value) with k => resume(k, value + 2)
    }
}
