effect Outer {
    [1, 1] ask() -> i32;
}

effect Stop {
    [0, 1] stop() -> i32;
}

stopped_value() -> i32 / {Outer, Stop} {
    let ignored: i32 = perform Stop::stop();
    ignored + 1000
}

cancel_inside_outward_handler() -> i32 / {Outer} {
    handle (stopped_value()) {
        Stop::stop() with k => {
            cancel(k);
            42
        }
    }
}

main() -> i32 {
    handle (cancel_inside_outward_handler()) {
        Outer::ask() with k => resume(k, 0)
    }
}
