struct Pair {
    left: i32,
    right: i32,
}

read_shared(value: &i32) -> i32 {
    *value
}

read_unique(value: &mut i32) -> i32 {
    *value
}

borrow_identity<T>(value: &T) -> &T {
    value
}

forward_shared(value: &i32) -> &i32 {
    borrow_identity(value)
}

reborrow_shared(value: &mut i32) -> i32 {
    let shared: &i32 = &*value;
    *shared
}

reborrow_unique(value: &mut i32) -> i32 {
    let unique: &mut i32 = &mut *value;
    *unique
}

reuse_parent_after_reborrow() -> i32 {
    let value: i32 = 42;
    let parent: &mut i32 = &mut value;
    let child: &mut i32 = &mut *parent;
    let through_child: i32 = *child;
    let through_parent: i32 = *parent;
    through_child + through_parent - 42
}

borrow_disjoint_fields() -> i32 {
    let pair: Pair = Pair { left: 20, right: 22 };
    let left: &mut i32 = &mut pair.left;
    let right: &mut i32 = &mut pair.right;
    *left + *right
}

main() -> i32 {
    let answer: i32 = 42;
    let nested_borrowed: &i32 = {
        &answer
    };
    let nested: i32 = *nested_borrowed;
    let borrowed: &i32 = forward_shared(&answer);
    let shared: i32 = read_shared(borrowed);
    let unique: i32 = read_unique(&mut answer);
    nested + shared + unique + reborrow_shared(&mut answer) +
        reborrow_unique(&mut answer) + reuse_parent_after_reborrow() +
        borrow_disjoint_fields() - 252
}
