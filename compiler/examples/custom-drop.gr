struct Inner {}

struct Outer {
    inner: Inner,
}

impl Use<[0,1]> for Inner {}

run_once<F, R>(body: F) -> R
where F: Fn<(), Output = R> {
    body()
}

impl Drop for Inner {
    drop(&mut self) -> { run_once({ () }) }
}

impl Drop for Outer {
    drop(&mut self) -> { run_once({ () }) }
}

make_and_ignore() -> i32 {
    let value: Outer = Outer { inner: Inner {} };
    42
}

main() -> i32 {
    let value: Outer = Outer { inner: Inner {} };
    let borrowed: &Inner = &value.inner;
    destroy(value);
    make_and_ignore()
}
