enum Bool {
    True,
    False,
}

struct Ticket {
    value: i32,
}

impl Use<[1, 1]> for Ticket {}

effect BoolCase {
    inspect(value: Bool) -> !;
}

choose<E, S, F, G, R>(condition: Bool, first: F, second: G) -> R
where F: Fn<(), Output = R>,
      G: Fn<(), Output = R>,
      E: Environment,
      S: Environment,
      F: RunsIn<E, (), After = S>,
      G: RunsIn<E, (), After = S> {
    handle perform BoolCase::inspect(condition) {
        BoolCase::inspect(Bool::True) => first(),
        BoolCase::inspect(Bool::False) => second()
    }
}

select(condition: Bool) -> i32 {
    let ticket: Ticket = Ticket { value: 42 };
    choose(
        condition,
        { ticket.value },
        { ticket.value }
    )
}

main() -> i32 {
    select(Bool::False)
}
