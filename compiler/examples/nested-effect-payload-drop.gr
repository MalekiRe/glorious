struct Resource {
    value: i32,
}

impl Use<[0,1]> for Resource {}

impl Drop for Resource {
    drop(&mut self) -> { () }
}

enum Packet {
    Empty,
    Pair(Resource, Resource),
}

effect Send {
    [0,1] take(packet: Packet) -> i32;
}

run(packet: Packet) -> i32 / {Send} {
    let answer: i32 = perform Send::take(packet);
    answer + 1000
}

main() -> i32 {
    handle (run(Packet::Pair(
        Resource { value: 1 },
        Resource { value: 2 }
    ))) {
        Send::take(Packet::Pair(first, _)) with k => {
            destroy(first);
            cancel(k);
            42
        },
        Send::take(Packet::Empty) with k => {
            cancel(k);
            0
        }
    }
}
