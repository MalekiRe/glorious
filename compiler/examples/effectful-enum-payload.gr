enum Wrapped {
    Value(i32)
}

effect Ask {
    [1, 1] ask() -> i32;
}

effect WrappedCase {
    inspect(value: Wrapped) -> !;
}

ask() -> i32 / {Ask} {
    perform Ask::ask()
}

make() -> Wrapped / {Ask} {
    Wrapped::Value(ask())
}

consume(value: Wrapped) -> i32 {
    handle perform WrappedCase::inspect(value) {
        WrappedCase::inspect(Wrapped::Value(inner)) => inner
    }
}

answer() -> i32 / {Ask} {
    let wrapped: Wrapped = make();
    consume(wrapped)
}

main() -> i32 {
    handle (answer()) {
        Ask::ask() with k => resume(k, 42)
    }
}
