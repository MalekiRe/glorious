effect Outer {
    [1, 1] ask() -> i32;
}

effect Inner {
    [1, 1] ping(value: i32) -> i32;
}

overdeclared(value: i32) -> i32 / {Outer, Inner} {
    perform Inner::ping(value)
}

run(seed: i32) -> i32 / {Outer} {
    let adjusted: i32 = seed + 1;
    handle (overdeclared(20)) {
        Inner::ping(value) with k => resume(k, value + adjusted)
    }
}

main() -> i32 {
    handle (run(21)) {
        Outer::ask() with k => resume(k, 0)
    }
}
