struct Ticket {
    value: i32,
}

impl Use<[1, 1]> for Ticket {}

enum Bool {
    True,
    False,
}

effect BoolCase {
    inspect(value: Bool) -> !;
}

choose<F, G, R>(condition: Bool, first: F, second: G) -> R
where F: Fn<(), Output = R>, G: Fn<(), Output = R> {
    handle perform BoolCase::inspect(condition) {
        BoolCase::inspect(Bool::True) => first(),
        BoolCase::inspect(Bool::False) => second()
    }
}

select(condition: Bool) -> i32 {
    let ticket: Ticket = Ticket { value: 42 };
    choose(
        condition,
        { ticket.value },
        { ticket.value }
    )
}

main() -> i32 {
    select(Bool::True)
}
