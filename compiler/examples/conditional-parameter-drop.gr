struct Resource {
    value: i32,
}

impl Use<[0,1]> for Resource {}

impl Drop for Resource {
    drop(&mut self) -> { () }
}

enum Bool {
    True,
    False,
}

effect BoolCase {
    inspect(value: Bool) -> !;
}

choose<F, G, R>(condition: Bool, first: F, second: G) -> R
where F: Fn<(), Output = R>, G: Fn<(), Output = R> {
    handle perform BoolCase::inspect(condition) {
        BoolCase::inspect(Bool::True) => first(),
        BoolCase::inspect(Bool::False) => second()
    }
}

select(resource: Resource, condition: Bool) -> i32 {
    choose(
        condition,
        {
            destroy(resource);
            42
        },
        { 42 }
    )
}

main() -> i32 {
    select(Resource { value: 1 }, Bool::True) +
        select(Resource { value: 2 }, Bool::False) - 42
}
