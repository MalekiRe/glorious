struct Request {
//     ^ type
  value: i64,
//^ property
//       ^ type
}

enum Reply {
//   ^ type
  Accepted,
//^ constructor
}

effect Exchange {
//     ^ tag
  send(request: Request, reply: Reply) -> Reply;
//^ variant
//     ^ variable.parameter
//              ^ type
//                       ^ variable.parameter
//                              ^ type
//                                        ^ type
}

serve(request: Request) -> Reply {
// <- function
//    ^ variable.parameter
//             ^ type
//                         ^ type
  handle perform Exchange::send(request, Reply::Accepted()) {
//               ^ tag
//                         ^ variant
    Exchange::send(Request { value: 1 }, Reply::Accepted()) => Reply::Accepted(),
//  ^ tag
//            ^ variant
//                 ^ type
//                           ^ property
//                                        ^ type
//                                               ^ constructor
  }
}
