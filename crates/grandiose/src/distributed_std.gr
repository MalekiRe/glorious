struct IndexVec<I, T> {
    private values: Vec<T>,
    private length: usize
}

__g1_index_vec_new<I, T>() -> IndexVec<I, T> {
    IndexVec { values: Vec::new(), length: 0 }
}

__g1_index_vec_len<I, T>(value: &IndexVec<I, T>) -> usize {
    value.length
}

__g1_index_vec_is_empty<I, T>(value: &IndexVec<I, T>) -> Bool {
    value.length == 0
}

__g1_index_vec_make_id<I, T>(value: &IndexVec<I, T>, raw: u32) -> Id<I> {
    value;
    Id { raw: move raw }
}

__g1_index_vec_push<I, T>(value: &mut IndexVec<I, T>, item: T)
    -> Result<Id<I>, T> {
    let length = value.length;
    let converted = checked_usize_to_u32(length);
    handle perform __ResultCase<u32, ()>::inspect(move converted) {
        __ResultCase<u32, ()>::inspect(Result::Ok(raw)) => {
            let id = __g1_index_vec_make_id(&*value, move raw);
            Vec::push(&mut value.values, move item);
            (*value).length = length + 1;
            Result::Ok(move id)
        },
        __ResultCase<u32, ()>::inspect(Result::Err(_)) =>
            Result::Err(move item)
    }
}

__g1_index_vec_get<'a, I, T>(value: &'a IndexVec<I, T>, id: Id<I>)
    -> Option<&'a T> {
    Vec::get(&value.values, Id::to_usize(move id))
}

__g1_index_vec_get_mut<'a, I, T>(value: &'a mut IndexVec<I, T>, id: Id<I>)
    -> Option<&'a mut T> {
    Vec::get_mut(&mut value.values, Id::to_usize(move id))
}

__g1_index_vec_pop<I, T>(value: &mut IndexVec<I, T>) -> Option<T> {
    let length = value.length;
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => None,
        __VecBoolCase::inspect(Result::Err(_)) => {
            let item = __g1_array_pop_move(&mut value.values.storage);
            (*value).length = length - 1;
            Option::Some(move item)
        }
    }
}

__g1_index_vec_get_copy<I, T>(value: &IndexVec<I, T>, id: Id<I>)
    -> Option<T> where T: Use<[0,infinity]> {
    let raw = wrapping_convert_to_usize(id.raw);
    handle perform __VecBoolCase::inspect(raw < value.length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Option::Some(__g1_array_get_copy(&value.values.storage, raw)),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_index_vec_replace<I, T>(
    value: &mut IndexVec<I, T>,
    id: Id<I>,
    incoming: T
) -> Result<T, T> {
    let raw = wrapping_convert_to_usize(id.raw);
    let length = value.length;
    handle perform __VecBoolCase::inspect(raw < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let previous = __g1_array_get_move(&mut value.values.storage, raw);
            __g1_array_set_move(
                &mut value.values.storage,
                raw,
                move incoming
            );
            Result::Ok(move previous)
        },
        __VecBoolCase::inspect(Result::Err(_)) => Result::Err(move incoming)
    }
}

