__g1_sparse_set_insert<I>(value: &mut SparseSet<I>, id: Id<I>) -> Bool {
    let present = SparseSet::contains(&*value, id);
    handle perform __VecBoolCase::inspect(move present) {
        __VecBoolCase::inspect(Result::Ok(_)) => false,
        __VecBoolCase::inspect(Result::Err(_)) => {
            let raw = wrapping_convert_to_usize(id.raw);
            __g1_sparse_set_ensure(&mut *value, raw);
            let dense_index = value.dense_length;
