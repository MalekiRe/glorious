struct BitSet<I> {
    private words: Vec<u64>,
    private length: usize
}

__g1_toolkit_u64_zero() -> u64 { 0 }
__g1_toolkit_u64_one() -> u64 { 1 }
__g1_toolkit_u64_and(left: u64, right: u64) -> u64 {
    bit_and(move left, move right)
}
__g1_toolkit_u64_or(left: u64, right: u64) -> u64 {
    bit_or(move left, move right)
}
__g1_toolkit_u64_not(value: u64) -> u64 { bit_not(move value) }
__g1_toolkit_u64_shl(value: u64, count: u32) -> u64 {
    shift_left(move value, move count)
}
__g1_toolkit_u32_rem(left: u32, right: u32) -> u32 {
    move left % move right
}
__g1_toolkit_u64_has(bits: u64, mask: u64) -> Bool {
    __g1_toolkit_u64_and(move bits, move mask) != 0
}
__g1_toolkit_u64_at(words: &Vec<u64>, index: usize) -> u64 {
    __g1_array_get_copy(&words.storage, move index)
}
__g1_toolkit_u64_set(words: &mut Vec<u64>, index: usize, value: u64) -> () {
    let previous = __g1_array_get_move(&mut words.storage, index);
    previous;
    __g1_array_set_move(&mut words.storage, move index, move value)
}

__g1_bit_set_new<I>() -> BitSet<I> {
    BitSet { words: Vec::new(), length: 0 }
}

__g1_bit_set_word_count<I>(value: &BitSet<I>) -> usize {
    value.length
}

__g1_bit_set_ensure_word<I>(value: &mut BitSet<I>, word: usize) -> () {
    let length = value.length;
    handle perform __VecBoolCase::inspect(length <= word) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            Vec::push(&mut value.words, __g1_toolkit_u64_zero());
            (*value).length = length + 1;
            __g1_bit_set_ensure_word(move value, word)
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_bit_set_word(raw: u32) -> usize {
    wrapping_convert_to_usize(move raw) / 64
}

__g1_bit_set_mask(raw: u32) -> u64 {
    let bit = __g1_toolkit_u32_rem(move raw, 64);
    __g1_toolkit_u64_shl(__g1_toolkit_u64_one(), move bit)
}

__g1_bit_set_contains<I>(value: &BitSet<I>, id: Id<I>) -> Bool {
    let word = __g1_bit_set_word(id.raw);
    handle perform __VecBoolCase::inspect(word < value.length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_toolkit_u64_has(
                __g1_toolkit_u64_at(&value.words, word),
                __g1_bit_set_mask(id.raw)
            ),
        __VecBoolCase::inspect(Result::Err(_)) => false
    }
}

__g1_bit_set_insert<I>(value: &mut BitSet<I>, id: Id<I>) -> Bool {
    let word = __g1_bit_set_word(id.raw);
    let mask = __g1_bit_set_mask(id.raw);
    __g1_bit_set_ensure_word(&mut *value, word);
    let previous = __g1_toolkit_u64_at(&value.words, word);
    __g1_toolkit_u64_set(
        &mut value.words,
        word,
        __g1_toolkit_u64_or(previous, mask)
    );
    not(__g1_toolkit_u64_has(previous, mask))
}

__g1_bit_set_remove<I>(value: &mut BitSet<I>, id: Id<I>) -> Bool {
    let present = BitSet::contains(&*value, id);
    handle perform __VecBoolCase::inspect(move present) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let word = __g1_bit_set_word(id.raw);
            let mask = __g1_bit_set_mask(id.raw);
            let previous = __g1_toolkit_u64_at(&value.words, word);
            __g1_toolkit_u64_set(
                &mut value.words,
                word,
                __g1_toolkit_u64_and(
                    previous,
                    __g1_toolkit_u64_not(mask)
                )
            );
            true
        },
        __VecBoolCase::inspect(Result::Err(_)) => false
    }
}

__g1_bit_set_clear<I>(value: &mut BitSet<I>) -> () {
    Vec::clear(&mut value.words);
    (*value).length = 0;
    ()
}

__g1_bit_set_union_step<I>(
    value: &mut BitSet<I>,
    other: &BitSet<I>,
    cursor: usize,
    length: usize
) -> () {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let incoming = __g1_toolkit_u64_at(&other.words, cursor);
            __g1_bit_set_ensure_word(&mut *value, cursor);
            let previous = __g1_toolkit_u64_at(&value.words, cursor);
            __g1_toolkit_u64_set(
                &mut value.words,
                cursor,
                __g1_toolkit_u64_or(previous, incoming)
            );
            __g1_bit_set_union_step(move value, other, cursor + 1, length)
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_bit_set_union_with<I>(value: &mut BitSet<I>, other: &BitSet<I>) -> () {
    __g1_bit_set_union_step(move value, other, 0, other.length)
}

__g1_bit_set_word_or_zero<I>(other: &BitSet<I>, cursor: usize) -> u64 {
    handle perform __VecBoolCase::inspect(cursor < other.length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_toolkit_u64_at(&other.words, cursor),
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_toolkit_u64_zero()
    }
}

__g1_bit_set_intersect_step<I>(
    value: &mut BitSet<I>,
    other: &BitSet<I>,
    cursor: usize,
    length: usize
) -> () {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let incoming = __g1_bit_set_word_or_zero(other, cursor);
            let previous = __g1_toolkit_u64_at(&value.words, cursor);
            __g1_toolkit_u64_set(
                &mut value.words,
                cursor,
                __g1_toolkit_u64_and(previous, incoming)
            );
            __g1_bit_set_intersect_step(
                move value,
                other,
                cursor + 1,
                length
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

