// Deterministic collection evidence. Equality is result-based and hashing
// appends to a caller-owned versioned stream, so neither operation allocates
// or consults host state.
enum Ordering { Less, Equal, Greater }

trait Eq { eq(self: &Self, other: &Self) -> Bool; }
trait Ord { cmp(self: &Self, other: &Self) -> Ordering; }
trait Hash { hash(self: &Self, state: &mut Hasher) -> (); }
trait Default { default() -> Self; }
trait Display { fmt(self: &Self, formatter: &mut Formatter) -> (); }
trait Debug { fmt(self: &Self, formatter: &mut Formatter) -> (); }

impl Default for i8 { default() -> i8 { 0 } }
impl Default for i16 { default() -> i16 { 0 } }
