        __ResultCase<Vec<V>, ()>::inspect(Result::Err(_)) => {
            let created = __g1_multi_map_empty_bucket(&*value);
            Vec::push(&mut created, move item);
            HashMap::insert(&mut value.buckets, move key, move created);
            ()
        }
    }
}

