}

__g1_sparse_set_write_sparse<I>(
    value: &mut SparseSet<I>,
    raw: usize,
    dense_index: usize
) -> () {
    let previous = __g1_array_get_move(&mut value.sparse.storage, raw);
    previous;
    __g1_array_set_move(
        &mut value.sparse.storage,
        move raw,
        move dense_index
    );
    ()
}

__g1_sparse_set_contains<I>(value: &SparseSet<I>, id: Id<I>) -> Bool {
    let raw = wrapping_convert_to_usize(id.raw);
    handle perform __VecBoolCase::inspect(raw < value.sparse_length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let dense_index = __g1_sparse_set_sparse_at(value, raw);
