    tag;
    Id { raw: move raw }
}

__g1_id_from_usize<Tag>(raw: usize) -> Option<Id<Tag>> {
    handle perform __ResultCase<u32, ()>::inspect(checked_usize_to_u32(raw)) {
        __ResultCase<u32, ()>::inspect(Result::Ok(value)) =>
            Option::Some(__g1_id_from_u32(move value)),
        __ResultCase<u32, ()>::inspect(Result::Err(_)) => None
    }
}

__g1_id_to_u32<Tag>(value: Id<Tag>) -> u32 { value.raw }

__g1_id_to_usize<Tag>(value: Id<Tag>) -> usize {
    wrapping_convert_to_usize(value.raw)
}

id_fits_usize(raw: usize) -> Bool {
    handle perform __ResultCase<u32, ()>::inspect(checked_usize_to_u32(raw)) {
        __ResultCase<u32, ()>::inspect(Result::Ok(_)) => true,
        __ResultCase<u32, ()>::inspect(Result::Err(_)) => false
    }
}

