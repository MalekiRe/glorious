                                __BytesBoolCase::inspect(Result::Ok(_)) =>
                                    __g1_utf8_second(
                                        move value, index, 128, 191,
                                        __g1_usize_add(index, 2)
                                    ),
                                __BytesBoolCase::inspect(Result::Err(_)) =>
                                    handle perform __BytesBoolCase::inspect(
                                        lead == 224
                                    ) {
