struct Arena<I, T> {
    private values: IndexVec<I, T>,
    private length: usize
}

__g1_arena_new<I, T>() -> Arena<I, T> {
    Arena { values: IndexVec::new(), length: 0 }
}

__g1_arena_len<I, T>(value: &Arena<I, T>) -> usize {
    value.length
}

__g1_arena_mark<I, T>(value: &Arena<I, T>) -> usize {
    Arena::len(value)
}

__g1_arena_alloc<I, T>(value: &mut Arena<I, T>, item: T)
    -> Result<Id<I>, T> {
    let length = value.length;
    let converted = checked_usize_to_u32(length);
    handle perform __ResultCase<u32, ()>::inspect(move converted) {
        __ResultCase<u32, ()>::inspect(Result::Ok(raw)) => {
            Vec::push(&mut value.values.values, move item);
            (*value).length = length + 1;
            (*value).values.length = length + 1;
            Result::Ok(Id { raw: move raw })
        },
        __ResultCase<u32, ()>::inspect(Result::Err(_)) =>
            Result::Err(move item)
    }
}

__g1_arena_get<'a, I, T>(value: &'a Arena<I, T>, id: Id<I>)
    -> Option<&'a T> {
    IndexVec::get(&value.values, move id)
}

__g1_arena_get_mut<'a, I, T>(value: &'a mut Arena<I, T>, id: Id<I>)
    -> Option<&'a mut T> {
    IndexVec::get_mut(&mut value.values, move id)
}

__g1_arena_get_copy<I, T>(value: &Arena<I, T>, id: Id<I>) -> Option<T>
    where T: Use<[0,infinity]> {
    IndexVec::get_copy(&value.values, move id)
}

__g1_arena_truncate<I, T>(value: &mut Arena<I, T>, mark: usize) -> ()
    where T: Use<[0,0]> {
    let length = Arena::len(&*value);
    handle perform __VecBoolCase::inspect(mark < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let removed = __g1_array_pop_move(&mut value.values.values.storage);
            (*value).length = length - 1;
            (*value).values.length = length - 1;
            removed;
            __g1_arena_truncate(move value, mark)
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_arena_drain_rollback<I, T>(value: &mut Arena<I, T>, mark: usize)
    -> Vec<T> {
    let removed = __g1_arena_empty_rollback(&*value);
    __g1_arena_drain_rollback_step(move value, mark, move removed)
}

__g1_arena_empty_rollback<I, T>(value: &Arena<I, T>) -> Vec<T> {
    value;
    Vec::new()
}

__g1_arena_drain_rollback_step<I, T>(
    value: &mut Arena<I, T>,
    mark: usize,
    removed: Vec<T>
) -> Vec<T> {
    let length = Arena::len(&*value);
    handle perform __VecBoolCase::inspect(mark < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let item = __g1_array_pop_move(&mut value.values.values.storage);
            (*value).length = length - 1;
            (*value).values.length = length - 1;
            Vec::push(&mut removed, move item);
            __g1_arena_drain_rollback_step(
                move value,
                mark,
                move removed
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) => {
            Vec::reverse(&mut removed);
            move removed
        }
    }
}

