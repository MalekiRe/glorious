struct SourceFileTag {}
struct SourceFile {
    private name: String,
    private source: String,
    private start: usize,
    private end: usize,
    private line_starts: Vec<usize>
}
struct SourceLocation {
    file: Id<SourceFileTag>,
    line: usize,
    column: usize
}
enum SourceMapAddResult {
    Added(Id<SourceFileTag>),
    Capacity(ToolkitCapacityError)
}
enum __SourceFileIdResult { Fits(Id<SourceFileTag>), Overflow }
effect __SourceFileIdCase { inspect(value: __SourceFileIdResult) -> !; }
struct SourceMap {
    private files: Vec<SourceFile>,
    private total_length: usize
}

__g1_source_map_maybe_line(
    starts: Vec<usize>,
    next: usize,
    newline: Bool
) -> Vec<usize> {
    handle perform __VecBoolCase::inspect(move newline) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            Vec::push(&mut starts, move next);
            move starts
        },
        __VecBoolCase::inspect(Result::Err(_)) => move starts
    }
}

__g1_source_map_new() -> SourceMap {
    SourceMap { files: Vec::new(), total_length: 0 }
}

__g1_source_map_scan_lines(
    bytes: Bytes,
    cursor: usize,
    length: usize,
    starts: Vec<usize>
) -> Vec<usize> {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let newline = __g1_bytes_get(bytes, cursor) == 10;
            let starts = __g1_source_map_maybe_line(
                move starts,
                cursor + 1,
                move newline
            );
            __g1_source_map_scan_lines(
                move bytes,
                cursor + 1,
                length,
                move starts
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) => move starts
    }
}

__g1_source_map_empty_lines() -> Vec<usize> { Vec::new() }

__g1_source_map_line_starts(source: &String) -> Vec<usize> {
    let starts = __g1_source_map_empty_lines();
    Vec::push(&mut starts, __g1_toolkit_usize_zero());
    let bytes = String::as_bytes(source);
    let length = Bytes::len(&bytes);
    __g1_source_map_scan_lines(move bytes, 0, length, move starts)
}

__g1_source_map_push(
    value: &mut SourceMap,
    id: Id<SourceFileTag>,
    name: String,
    source: String,
    end: usize
) -> SourceMapAddResult {
    let start = value.total_length;
    let line_starts = __g1_source_map_line_starts(&source);
    Vec::push(
        &mut value.files,
        SourceFile {
            name: move name,
            source: move source,
            start: start,
            end: end,
            line_starts: move line_starts
        }
    );
    (*value).total_length = move end;
    SourceMapAddResult::Added(move id)
}

__g1_source_map_add(
    value: &mut SourceMap,
    name: String,
    source: String
) -> SourceMapAddResult {
    let length = String::byte_len(&source);
    let start = value.total_length;
    let file_count = Vec::len(&value.files);
    let tag = SourceFileTag {};
    let id_result = handle perform __ResultCase<u32, ()>::inspect(
        checked_usize_to_u32(file_count)
    ) {
        __ResultCase<u32, ()>::inspect(Result::Ok(raw)) =>
            __SourceFileIdResult::Fits(Id::with_tag(move raw, &tag)),
        __ResultCase<u32, ()>::inspect(Result::Err(_)) =>
            __SourceFileIdResult::Overflow
    };
    handle perform __ResultCase<usize, ()>::inspect(
        checked_usize_add(start, length)
    ) {
        __ResultCase<usize, ()>::inspect(Result::Ok(end)) => {
            handle perform __SourceFileIdCase::inspect(
                move id_result
            ) {
                __SourceFileIdCase::inspect(__SourceFileIdResult::Fits(id)) =>
                    __g1_source_map_push(
                        move value,
                        move id,
                        move name,
                        move source,
                        move end
                    ),
                __SourceFileIdCase::inspect(__SourceFileIdResult::Overflow) =>
                    SourceMapAddResult::Capacity(
                    ToolkitCapacityError::IdSpaceExhausted
                )
            }
        },
        __ResultCase<usize, ()>::inspect(Result::Err(_)) =>
            SourceMapAddResult::Capacity(ToolkitCapacityError::CounterOverflow)
    }
}

__g1_source_map_file_count(value: &SourceMap) -> usize {
    Vec::len(&value.files)
}

__g1_source_map_total_length(value: &SourceMap) -> usize {
    value.total_length
}

__g1_source_map_file<'a>(value: &'a SourceMap, id: Id<SourceFileTag>)
    -> Option<&'a SourceFile> {
    Vec::get(&value.files, Id::to_usize(move id))
}

__g1_source_file_name<'a>(value: &'a SourceFile) -> &'a String { &value.name }
__g1_source_file_source<'a>(value: &'a SourceFile) -> &'a String { &value.source }
__g1_source_file_start(value: &SourceFile) -> usize { value.start }
__g1_source_file_end(value: &SourceFile) -> usize { value.end }

__g1_source_line_start(starts: &Vec<usize>, index: usize) -> usize {
    __g1_array_get_copy(&starts.storage, move index)
}

__g1_source_line_count(starts: &Vec<usize>) -> usize {
    __g1_array_len(&starts.storage)
}

__g1_source_map_line_index(
    starts: &Vec<usize>,
    offset: usize,
    cursor: usize,
    best: usize
) -> usize {
    handle perform __VecBoolCase::inspect(cursor < __g1_source_line_count(starts)) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let start = __g1_source_line_start(starts, cursor);
            handle perform __VecBoolCase::inspect(start <= offset) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_source_map_line_index(
                        starts,
                        offset,
                        cursor + 1,
                        cursor
                    ),
                __VecBoolCase::inspect(Result::Err(_)) => move best
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) => move best
    }
}

__g1_source_map_location_for(
    file: &SourceFile,
    file_index: usize,
    offset: usize
) -> Option<SourceLocation> {
    let local = __g1_vec_deque_usize_sub(offset, file.start);
    let line = __g1_source_map_line_index(&file.line_starts, local, 0, 0);
    let line_start = __g1_source_line_start(&file.line_starts, line);
    Option::Some(SourceLocation {
        file: Id { raw: wrapping_convert_to_u32(file_index) },
        line: move line,
        column: __g1_vec_deque_usize_sub(move local, move line_start)
    })
}

__g1_source_map_file_at<'a>(value: &'a SourceMap, cursor: usize)
    -> &'a SourceFile {
    Vec::index(&value.files, move cursor)
}

__g1_source_map_contains_offset(
    value: &SourceMap,
    cursor: usize,
    offset: usize
) -> Bool {
    let file = __g1_source_map_file_at(value, cursor);
    let start = file.start;
    let end = file.end;
    handle perform __VecBoolCase::inspect(start <= offset) {
        __VecBoolCase::inspect(Result::Ok(_)) => offset < end,
        __VecBoolCase::inspect(Result::Err(_)) => false
    }
}

__g1_source_map_location_at(
    value: &SourceMap,
    cursor: usize,
    offset: usize
) -> Option<SourceLocation> {
    __g1_source_map_location_for(
        __g1_source_map_file_at(value, cursor),
        cursor,
        offset
    )
}

__g1_source_map_lookup_at(
    value: &SourceMap,
    offset: usize,
    cursor: usize,
    length: usize
) -> Option<SourceLocation> {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let contains = __g1_source_map_contains_offset(value, cursor, offset);
            handle perform __VecBoolCase::inspect(move contains) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_source_map_location_at(value, cursor, offset),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_source_map_lookup_at(
                        value,
                        offset,
                        cursor + 1,
                        length
                    )
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_source_map_lookup(value: &SourceMap, offset: usize)
    -> Option<SourceLocation> {
    __g1_source_map_lookup_at(value, offset, 0, SourceMap::file_count(value))
}

__g1_source_map_line_at(value: &SourceMap, offset: usize) -> Option<usize> {
    handle perform __ResultCase<SourceLocation, ()>::inspect(
        __g1_source_map_lookup(value, offset)
    ) {
        __ResultCase<SourceLocation, ()>::inspect(Result::Ok(location)) =>
            Option::Some(move location.line),
        __ResultCase<SourceLocation, ()>::inspect(Result::Err(_)) => None
    }
}

__g1_source_map_column_at(value: &SourceMap, offset: usize) -> Option<usize> {
    handle perform __ResultCase<SourceLocation, ()>::inspect(
        __g1_source_map_lookup(value, offset)
    ) {
        __ResultCase<SourceLocation, ()>::inspect(Result::Ok(location)) =>
            Option::Some(move location.column),
        __ResultCase<SourceLocation, ()>::inspect(Result::Err(_)) => None
    }
}

let SourceMap::new = __g1_source_map_new;
let SourceMap::add = __g1_source_map_add;
let SourceMap::file_count = __g1_source_map_file_count;
let SourceMap::total_length = __g1_source_map_total_length;
let SourceMap::file = __g1_source_map_file;
let SourceMap::lookup = __g1_source_map_lookup;
let SourceMap::line_at = __g1_source_map_line_at;
let SourceMap::column_at = __g1_source_map_column_at;
let SourceFile::name = __g1_source_file_name;
let SourceFile::source = __g1_source_file_source;
let SourceFile::start = __g1_source_file_start;
let SourceFile::end = __g1_source_file_end;

// Generic interners keep each canonical T exactly once. A deterministic hash
// selects one of 64 ID buckets; equality is checked only within that bucket,
// so collisions cannot change canonical identity and no T must be cloned into
// a secondary map key. This is hash-backed rather than the former full linear
// scan, while retaining insertion-order IDs and private representation.
struct Interner<T> {
    private values: Vec<T>,
    private buckets: Vec<Vec<Id<T>>>
}
enum __InternerProbe<T> { Found(Id<T>), Missing }
effect __InternerProbeCase<T> {
    inspect(value: __InternerProbe<T>) -> !;
}

__g1_interner_empty_bucket<T>(buckets: &Vec<Vec<Id<T>>>) -> Vec<Id<T>> {
    buckets;
    Vec::new()
}

__g1_interner_fill_buckets<T>(
    buckets: &mut Vec<Vec<Id<T>>>,
    capacity: usize
) -> () {
    let current = Vec::len(&*buckets);
    handle perform __VecBoolCase::inspect(current < capacity) {
        __VecBoolCase::inspect(Result::Err(_)) => (),
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let bucket = __g1_interner_empty_bucket(&*buckets);
            Vec::push(&mut *buckets, move bucket);
            __g1_interner_fill_buckets(
                move buckets,
                move capacity
            )
        }
    }
}

__g1_interner_new<T>() -> Interner<T> {
    Interner { values: Vec::new(), buckets: Vec::new() }
}

__g1_interner_prepare<T>(value: &mut Interner<T>) -> () {
    __g1_interner_fill_buckets(&mut value.buckets, 64)
}

__g1_interner_len<T>(value: &Interner<T>) -> usize {
    Vec::len(&value.values)
}

__g1_interner_get<'a, T>(value: &'a Interner<T>, id: Id<T>)
    -> Option<&'a T> {
    Vec::get(&value.values, Id::to_usize(move id))
}

__g1_interner_bucket<T>(value: &Interner<T>, candidate: &T) -> usize
    where T: Hash {
    wrapping_convert_to_usize(__g1_u64_rem(
        __g1_hash_map_hash(candidate),
        wrapping_convert_to_u64(Vec::len(&value.buckets))
    ))
}

__g1_interner_id_at<T>(
    bucket: &Vec<Id<T>>,
    cursor: usize,
    candidate: &T
) -> Id<T> {
    candidate;
    __g1_array_get_copy(&bucket.storage, cursor)
}

__g1_interner_find<T>(
    value: &Interner<T>,
    candidate: &T,
    bucket: &Vec<Id<T>>,
    cursor: usize,
    length: usize
) -> __InternerProbe<T> where T: Eq {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let id = __g1_interner_id_at(bucket, cursor, candidate);
            let resident = __g1_vec_index(
                &value.values,
                Id::to_usize(id)
            );
            handle perform __VecBoolCase::inspect(
                __g1_hash_map_keys_equal(resident, candidate)
            ) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __InternerProbe::Found(move id),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_interner_find(
                        value,
                        candidate,
                        bucket,
                        cursor + 1,
                        length
                    )
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            __InternerProbe::Missing
    }
}

__g1_interner_probe<T>(
    value: &Interner<T>,
    candidate: &T,
    bucket_index: usize
) -> __InternerProbe<T> where T: Eq {
    let bucket = __g1_vec_index(&value.buckets, bucket_index);
    __g1_interner_find(
        value,
        candidate,
        bucket,
        0,
        Vec::len(bucket)
    )
}

__g1_interner_insert<T>(
    value: &mut Interner<T>,
    candidate: T,
    bucket: usize
) -> Result<Id<T>, T> {
    let length = Vec::len(&value.values);
    let converted = checked_usize_to_u32(length);
    handle perform __ResultCase<u32, ()>::inspect(move converted) {
        __ResultCase<u32, ()>::inspect(Result::Ok(raw)) => {
            let id = __g1_id_with_tag(move raw, &candidate);
            Vec::push(&mut value.values, move candidate);
            Vec::push(
                __g1_vec_index_mut(&mut value.buckets, move bucket),
                id
            );
            Result::Ok(move id)
        },
        __ResultCase<u32, ()>::inspect(Result::Err(_)) =>
            Result::Err(move candidate)
    }
}

__g1_interner_found<T>(id: Id<T>, candidate: T) -> Result<Id<T>, T>
    where T: Use<[0,infinity]> {
    candidate;
    Result::Ok(move id)
}

__g1_interner_intern<T>(value: &mut Interner<T>, candidate: T)
    -> Result<Id<T>, T> where T: Eq, T: Hash, T: Use<[0,infinity]> {
    __g1_interner_prepare(&mut *value);
    let bucket_index = __g1_interner_bucket(&*value, &candidate);
    let probe = __g1_interner_probe(
        &*value,
        &candidate,
        bucket_index
    );
    handle perform __InternerProbeCase<T>::inspect(move probe) {
        __InternerProbeCase<T>::inspect(__InternerProbe::Found(id)) =>
            __g1_interner_found(move id, move candidate),
        __InternerProbeCase<T>::inspect(__InternerProbe::Missing) =>
            __g1_interner_insert(move value, move candidate, move bucket_index)
    }
}

__g1_interner_index_or_len<T>(value: &Interner<T>, candidate: &T) -> usize
    where T: Eq, T: Hash {
    let length = Interner::len(value);
    let bucket_index = __g1_interner_bucket(value, candidate);
    let probe = __g1_interner_probe(
        value,
        candidate,
        bucket_index
    );
    handle perform __InternerProbeCase<T>::inspect(move probe) {
        __InternerProbeCase<T>::inspect(__InternerProbe::Found(id)) =>
            Id::to_usize(move id),
        __InternerProbeCase<T>::inspect(__InternerProbe::Missing) =>
            move length
    }
}

__g1_string_interner_intern(
    value: &mut Interner<String>,
    candidate: String
) -> Result<Id<String>, String> {
    __g1_interner_intern(move value, move candidate)
}

__g1_string_interner_index_or_len(
    value: &Interner<String>,
    candidate: &String
) -> usize {
    __g1_interner_index_or_len(value, candidate)
}

let Interner::new = __g1_interner_new;
let Interner::len = __g1_interner_len;
let Interner::get = __g1_interner_get;
let Interner::intern = __g1_interner_intern;
let Interner::index_or_len = __g1_interner_index_or_len;
let Interner::intern_string = __g1_string_interner_intern;
let Interner::string_index_or_len = __g1_string_interner_index_or_len;

// Layer 3c: compiler resource accounting. StepBudget is deliberately based on
// deterministic logical work rather than wall time. Its state is private so a
// compiler phase can spend or inspect a budget but cannot replenish it.
struct StepBudget { private remaining: usize }

__g1_step_budget_new(limit: usize) -> StepBudget {
    StepBudget { remaining: move limit }
}

__g1_step_budget_remaining(value: &StepBudget) -> usize {
    value.remaining
}

__g1_step_budget_is_exhausted(value: &StepBudget) -> Bool {
    value.remaining == 0
}

__g1_step_budget_spend(value: &mut StepBudget, steps: usize) -> Bool {
    let remaining = __g1_step_budget_remaining(&*value);
    (*value).remaining = move remaining - move steps;
    true
}

__g1_step_budget_try_take(value: &mut StepBudget, steps: usize) -> Bool {
    let available = __g1_step_budget_remaining(&*value);
    handle perform __VecBoolCase::inspect(steps <= available) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_step_budget_spend(move value, move steps),
        __VecBoolCase::inspect(Result::Err(_)) => false
    }
}

let StepBudget::new = __g1_step_budget_new;
let StepBudget::remaining = __g1_step_budget_remaining;
let StepBudget::is_exhausted = __g1_step_budget_is_exhausted;
let StepBudget::try_take = __g1_step_budget_try_take;

// Layer 4: compiler-host protocols. String remains an ordinary source alias;
// only this standard-library source entry has the authority to seal the host's
// initialized Array<Text> result inside Vec's private representation.
effect ProcessArgs { [1,1] get() -> Vec<String>; }
effect FileRead { [1,1] read(path: String) -> Bytes; }
effect FileWrite { [1,1] write(path: String, bytes: Bytes) -> (); }
effect Diagnostic { [1,1] write(text: String) -> (); }

process_args() -> Vec<String> / {ProcessArgs} {
    perform ProcessArgs::get()
}

read_file(path: String) -> Bytes / {FileRead} {
    perform FileRead::read(move path)
}

write_file(path: String, bytes: Bytes) -> () / {FileWrite} {
    perform FileWrite::write(move path, move bytes)
}

write_diagnostic(text: String) -> () / {Diagnostic} {
    perform Diagnostic::write(move text)
}

__g1_vec_from_array<T>(storage: Array<T>) -> Vec<T> {
    Vec { storage: move storage }
}

run_compiler_host<F, R>(main: F) -> R
    where F: Fn<
        (),
        Output=R,
        Effects={ProcessArgs, FileRead, FileWrite, Diagnostic}
    > {
    handle { main() } {
        ProcessArgs::get() with continuation => {
            resume(
                move continuation,
                __g1_vec_from_array(__g1_process_args_get())
            )
        },
        FileRead::read(path) with continuation => {
            resume(move continuation, __g1_fs_read(move path))
        },
        FileWrite::write(path, bytes) with continuation => {
            __g1_fs_write(move path, move bytes);
            resume(move continuation, ())
        },
        Diagnostic::write(text) with continuation => {
            __g1_diagnostic_write(move text);
            resume(move continuation, ())
        }
    }
}
