            handle perform __BytesBoolCase::inspect(lead <= 127) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __g1_utf8_validate_at(
                        move value,
                        __g1_usize_successor(move index)
                    ),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    handle perform __BytesBoolCase::inspect(194 <= lead) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
