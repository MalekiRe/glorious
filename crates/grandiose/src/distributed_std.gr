// Float evidence is defined by canonical IEEE bits.  The VM canonicalizes all
// NaNs before exposing bits, so NaN is reflexive and hashable; signed zeroes
// remain distinct and total ordering follows IEEE total-order key layout.
__g1_f32_order_key(value: f32) -> u32 {
    let bits = f32_to_bits(move value);
    handle perform __VecBoolCase::inspect(bit_and(bits, 2147483648) == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            bit_xor(move bits, 2147483648),
        __VecBoolCase::inspect(Result::Err(_)) => bit_not(move bits)
    }
}

__g1_f64_order_key(value: f64) -> u64 {
    let bits = f64_to_bits(move value);
    handle perform __VecBoolCase::inspect(
        bit_and(bits, 9223372036854775808) == 0
    ) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            bit_xor(move bits, 9223372036854775808),
        __VecBoolCase::inspect(Result::Err(_)) => bit_not(move bits)
    }
}

impl Eq for f32 {
    eq(self: &f32, other: &f32) -> Bool {
        f32_to_bits(*self) == f32_to_bits(*other)
    }
}
impl Ord for f32 {
    cmp(self: &f32, other: &f32) -> Ordering {
        let left = __g1_f32_order_key(*self);
        let right = __g1_f32_order_key(*other);
        __g1_ordering_from_flags(left < right, left == right)
    }
}
