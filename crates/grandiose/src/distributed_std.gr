let Option::unwrap_or = __g1_result_unwrap_or;

// Layer 3a: non-trapping public Text/Bytes operations. These are ordinary
// source functions so public call sites never acquire manifest authority.
// Frozen comparison primitives return the canonical u32 discriminator 0 or 1.
// Translate it to the result-based Bool through ordinary exhaustive handling;
// this helper carries no manifest authority of its own.
effect __U32BooleanCase { inspect(value: u32) -> !; }

__g1_bool_from_u32(value: u32) -> Bool {
    handle perform __U32BooleanCase::inspect(value) {
        __U32BooleanCase::inspect(0) => false,
        __U32BooleanCase::inspect(_) => true
    }
}

effect __ScalarBoolCase { inspect(value: Bool) -> !; }

__g1_checked_conversion_valid<T, U>(
    value: T,
    candidate: U,
    roundtrip: T
) -> Bool
    where T: Use<[0,infinity]>, U: Use<[0,infinity]> {
    handle perform __ScalarBoolCase::inspect(value == roundtrip) {
        __ScalarBoolCase::inspect(Result::Ok(_)) =>
            handle perform __ScalarBoolCase::inspect(value < 0) {
                __ScalarBoolCase::inspect(Result::Ok(_)) => candidate < 0,
                __ScalarBoolCase::inspect(Result::Err(_)) =>
                    handle perform __ScalarBoolCase::inspect(candidate < 0) {
                        __ScalarBoolCase::inspect(Result::Ok(_)) => false,
                        __ScalarBoolCase::inspect(Result::Err(_)) => true
                    }
            },
        __ScalarBoolCase::inspect(Result::Err(_)) => false
    }
}

__g1_usize_successor(value: usize) -> usize { move value + 1 }

checked_u8_to_u8(value: u8) -> Option<u8> {
    let candidate = __g1_int_convert_wrapping_to_u8(value);
    let roundtrip = __g1_int_convert_wrapping_to_u8(candidate);
    handle perform __ScalarBoolCase::inspect(__g1_checked_conversion_valid(value, candidate, roundtrip)) {
        __ScalarBoolCase::inspect(Result::Ok(_)) => Option::Some(__g1_int_convert_checked_to_u8(value)),
        __ScalarBoolCase::inspect(Result::Err(_)) => None
    }
}

