// Validated immutable views retain the cheap Text/Bytes handle and a half-open
// byte range. Private fields are the authority boundary: user source can move
// or borrow a view, but cannot forge a range that reaches the trapping slice
// leaves below.
struct TextView {
    private text: String,
    private start: usize,
    private end: usize
}

struct ByteView {
    private bytes: Bytes,
    private start: usize,
    private end: usize
}

__g1_text_view_ok(value: TextView) -> Result<TextView, TextRangeError> {
    Result::Ok(move value)
}

__g1_text_view_err(error: TextRangeError) -> Result<TextView, TextRangeError> {
    Result::Err(move error)
}

__g1_text_view_new_owned(
    text: String,
    range: Range<usize>
) -> Result<TextView, TextRangeError> {
    let start = range.start;
    let end = range.end;
    let bytes = __g1_text_as_bytes(text);
    let candidate = TextView {
        text: move text,
        start: start,
        end: end
    };
    handle perform __BytesBoolCase::inspect(start <= end) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(
                end <= __g1_bytes_len(bytes)
            ) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __BytesBoolCase::inspect(
                        __g1_utf8_boundary(bytes, start)
                    ) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            handle perform __BytesBoolCase::inspect(
                                __g1_utf8_boundary(bytes, end)
                            ) {
                                __BytesBoolCase::inspect(Result::Ok(_)) =>
                                    __g1_text_view_ok(move candidate),
                                __BytesBoolCase::inspect(Result::Err(_)) =>
                                    __g1_text_view_err(
                                        TextRangeError::NotCharBoundary
                                    )
                            },
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            __g1_text_view_err(
                                TextRangeError::NotCharBoundary
                            )
                    },
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_text_view_err(TextRangeError::OutOfBounds)
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            __g1_text_view_err(TextRangeError::Reversed)
    }
}

__g1_text_view_new(
    text: &String,
    range: Range<usize>
) -> Result<TextView, TextRangeError> {
    __g1_text_view_new_owned(*text, move range)
}

__g1_text_view_all(text: &String) -> TextView {
    TextView {
        text: *text,
        start: 0,
        end: __g1_string_byte_len(text)
    }
}

__g1_text_view_byte_len(value: &TextView) -> usize {
    value.end - value.start
}

__g1_text_view_is_empty(value: &TextView) -> Bool {
    value.start == value.end
}

__g1_text_view_as_bytes(value: &TextView) -> Bytes {
    __g1_bytes_slice(
        __g1_text_as_bytes(value.text),
        value.start,
        value.end
    )
}

__g1_text_view_to_string(value: &TextView) -> String {
    // Construction proved both UTF-8 boundaries, so this private conversion
    // cannot fault and need not validate the complete parent text again.
    __g1_text_from_utf8_checked(__g1_text_view_as_bytes(value))
}

__g1_text_view_eq(left: &TextView, right: &TextView) -> Bool {
    let left_bytes = __g1_text_view_as_bytes(left);
    let right_bytes = __g1_text_view_as_bytes(right);
    __g1_bytes_eq(&left_bytes, &right_bytes)
}

__g1_byte_view_ok(value: ByteView) -> Result<ByteView, BytesRangeError> {
    Result::Ok(move value)
}

__g1_byte_view_err(error: BytesRangeError) -> Result<ByteView, BytesRangeError> {
    Result::Err(move error)
}

__g1_byte_view_new_owned(
    bytes: Bytes,
    range: Range<usize>
) -> Result<ByteView, BytesRangeError> {
    let start = range.start;
    let end = range.end;
    let parent_length = __g1_bytes_len(bytes);
    let candidate = ByteView {
        bytes: move bytes,
        start: start,
        end: end
    };
    handle perform __BytesBoolCase::inspect(start <= end) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(end <= parent_length) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __g1_byte_view_ok(move candidate),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_byte_view_err(BytesRangeError::OutOfBounds)
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            __g1_byte_view_err(BytesRangeError::Reversed)
    }
}

__g1_byte_view_new(
    bytes: &Bytes,
    range: Range<usize>
) -> Result<ByteView, BytesRangeError> {
    __g1_byte_view_new_owned(*bytes, move range)
}

__g1_byte_view_all(bytes: &Bytes) -> ByteView {
    ByteView { bytes: *bytes, start: 0, end: __g1_bytes_len(*bytes) }
}

__g1_byte_view_len(value: &ByteView) -> usize {
    value.end - value.start
}

__g1_byte_view_is_empty(value: &ByteView) -> Bool {
    value.start == value.end
}

__g1_byte_view_to_bytes(value: &ByteView) -> Bytes {
    __g1_bytes_slice(value.bytes, value.start, value.end)
}

__g1_byte_view_eq(left: &ByteView, right: &ByteView) -> Bool {
    let left_bytes = __g1_byte_view_to_bytes(left);
    let right_bytes = __g1_byte_view_to_bytes(right);
    __g1_bytes_eq(&left_bytes, &right_bytes)
}

__g1_byte_view_get(value: &ByteView, index: usize) -> Result<u8, BytesIndexError> {
    let length = __g1_byte_view_len(value);
    handle perform __BytesBoolCase::inspect(index < length) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            Result::Ok(__g1_bytes_get(value.bytes, value.start + move index)),
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(BytesIndexError::OutOfBounds)
    }
}

