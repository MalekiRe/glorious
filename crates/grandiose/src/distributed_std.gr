effect __ScalarBoolCase { inspect(value: Bool) -> !; }

// Numeric selection stays in ordinary source code: comparison lowering is the
// only scalar-specific mechanism involved. The unrestricted-use bound is the
// precise ownership contract for inspecting candidates and discarding the
// values which are not selected.
min<T>(left: T, right: T) -> T where T: Use<[0,infinity]> {
    handle perform __ScalarBoolCase::inspect(left < right) {
        __ScalarBoolCase::inspect(Result::Ok(_)) => left,
        __ScalarBoolCase::inspect(Result::Err(_)) => right
    }
}

max<T>(left: T, right: T) -> T where T: Use<[0,infinity]> {
    handle perform __ScalarBoolCase::inspect(left < right) {
        __ScalarBoolCase::inspect(Result::Ok(_)) => right,
        __ScalarBoolCase::inspect(Result::Err(_)) => left
    }
}

clamp<T>(value: T, lower: T, upper: T) -> T where T: Use<[0,infinity]> {
    handle perform __ScalarBoolCase::inspect(value < lower) {
        __ScalarBoolCase::inspect(Result::Ok(_)) => lower,
        __ScalarBoolCase::inspect(Result::Err(_)) =>
            handle perform __ScalarBoolCase::inspect(upper < value) {
                __ScalarBoolCase::inspect(Result::Ok(_)) => upper,
                __ScalarBoolCase::inspect(Result::Err(_)) => value
            }
    }
}

__g1_checked_conversion_valid<T, U>(
    value: T,
    candidate: U,
    roundtrip: T
) -> Bool
    where T: Use<[0,infinity]>, U: Use<[0,infinity]> {
    handle perform __ScalarBoolCase::inspect(value == roundtrip) {
        __ScalarBoolCase::inspect(Result::Ok(_)) =>
            handle perform __ScalarBoolCase::inspect(value < 0) {
                __ScalarBoolCase::inspect(Result::Ok(_)) => candidate < 0,
                __ScalarBoolCase::inspect(Result::Err(_)) =>
                    handle perform __ScalarBoolCase::inspect(candidate < 0) {
                        __ScalarBoolCase::inspect(Result::Ok(_)) => false,
                        __ScalarBoolCase::inspect(Result::Err(_)) => true
                    }
            },
        __ScalarBoolCase::inspect(Result::Err(_)) => false
    }
}

__g1_usize_successor(value: usize) -> usize { move value + 1 }

