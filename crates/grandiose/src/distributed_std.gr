    } else {
        Result::Err(&mut value.0)
    }
}

__g1_option_as_ref<'a, A>(value: &'a Option<A>) -> Option<&'a A> {
    if(*value is Option::Some(_)) {
        Option::Some(&value.0)
    } else {
