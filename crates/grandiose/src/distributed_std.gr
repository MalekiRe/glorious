__g1_debug_bytes_at(
    formatter: &mut Formatter,
    value: &Bytes,
    index: usize,
    length: usize
) -> () {
    handle perform __VecBoolCase::inspect(index < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            handle perform __VecBoolCase::inspect(index == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) => (),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_debug_literal(&mut *formatter, ", ")
            };
            Formatter::append_u64(
                &mut *formatter,
                wrapping_convert_to_u64(__g1_bytes_get(*value, index))
            );
            __g1_debug_bytes_at(
                move formatter,
                value,
                __g1_usize_successor(move index),
                move length
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_debug_bytes(formatter: &mut Formatter, value: &Bytes) -> () {
    __g1_debug_literal(&mut *formatter, "b[");
    __g1_debug_bytes_at(
        &mut *formatter,
        value,
        0,
        Bytes::len(value)
    );
    __g1_debug_literal(move formatter, "]")
}

