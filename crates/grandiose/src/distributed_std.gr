__g1_sparse_set_remove<I>(value: &mut SparseSet<I>, id: Id<I>) -> Bool {
    let present = SparseSet::contains(&*value, id);
    handle perform __VecBoolCase::inspect(move present) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let raw = wrapping_convert_to_usize(id.raw);
            let dense_index = __g1_sparse_set_sparse_at(&*value, raw);
