effect __FloatBoolCase { inspect(value: Bool) -> !; }

__g1_f32_in_range(value: f32, lower: f32, upper: f32) -> Bool {
    handle perform __FloatBoolCase::inspect(
        __g1_bool_from_u32(__g1_f32_ge(value, move lower))
    ) {
        __FloatBoolCase::inspect(Result::Ok(_)) =>
            __g1_bool_from_u32(__g1_f32_lt(move value, move upper)),
        __FloatBoolCase::inspect(Result::Err(_)) => false
    }
}

__g1_f64_in_range(value: f64, lower: f64, upper: f64) -> Bool {
    handle perform __FloatBoolCase::inspect(
        __g1_bool_from_u32(__g1_f64_ge(value, move lower))
    ) {
        __FloatBoolCase::inspect(Result::Ok(_)) =>
            __g1_bool_from_u32(__g1_f64_lt(move value, move upper)),
        __FloatBoolCase::inspect(Result::Err(_)) => false
    }
}

