// Manifest-bound host leaves. Their declaration identities, not these source
// spellings, select the four frozen Host ABI G1 imports.
__g1_process_args_get() -> Array<Text> { () }
__g1_fs_read(path: Text) -> Bytes { () }
__g1_fs_write(path: Text, bytes: Bytes) -> () { () }
__g1_diagnostic_write(text: Text) -> () { () }

// Whole-value ownership utilities. `replace` and `swap` are deliberately
// expressed through unique-reference move-out plus exact reinitialization, so
// they work for values whose principal Use interval forbids implicit destroy.
identity<T>(value: T) -> T { move value }

replace<T>(target: &mut T, incoming: T) -> T {
    let previous = move *target;
    *target = move incoming;
    move previous
}

swap<T>(left: &mut T, right: &mut T) -> () {
    let left_value = move *left;
    let right_value = move *right;
    *left = move right_value;
    *right = move left_value;
}

enum Result<T, E> { Ok(T), Err(E) }

type Option<T> = Result<T, ()>;
let Option::Some = Result::Ok;
let None = Result::Err(());

type Bool = Option<()>;
__g1_bool(value: Bool) -> Bool { value }
let true = __g1_bool(Option::Some(()));
let false = __g1_bool(None);
type String = Text;
struct Range<T> { start: T, end: T }
impl<T> Use<[0,infinity]> for Range<T> where T: Use<[0,infinity]> {}
struct Utf8Error { valid_up_to: usize }
enum TextRangeError { Reversed, OutOfBounds, NotCharBoundary }

// Layer 2: result-based control. These are ordinary source declarations: the
// fixities determine grouping, and the Fn constraints are the only source of
// right-hand laziness.
infixr 1 else;
infixl 2 or;
infixl 3 and;
prefix 4 not;

effect __ResultCase<A, E> { inspect(value: Result<A, E>) -> !; }

if<A, E, B, F>(condition: Result<A, E>, body: F) -> Result<B, E>
    where F: Fn<(), Output=B>, A: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(condition) {
        __ResultCase<A, E>::inspect(Result::Ok(_)) => Result::Ok(body()),
        __ResultCase<A, E>::inspect(Result::Err(error)) => Result::Err(error)
    }
}

else<A, E, F>(value: Result<A, E>, fallback: F) -> A
    where F: Fn<(), Output=A>, E: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(result)) => result,
        __ResultCase<A, E>::inspect(Result::Err(_)) => fallback()
    }
}

and<A, E, B, F>(value: Result<A, E>, next: F) -> Result<B, E>
    where F: Fn<(), Output=Result<B, E>>, A: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(_)) => next(),
        __ResultCase<A, E>::inspect(Result::Err(error)) => Result::Err(error)
    }
}

or<A, E, E2, F>(value: Result<A, E>, alternative: F) -> Result<A, E2>
    where F: Fn<(), Output=Result<A, E2>>, E: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(result)) => Result::Ok(result),
        __ResultCase<A, E>::inspect(Result::Err(_)) => alternative()
    }
}

not<A, E>(value: Result<A, E>) -> Result<E, A> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(result)) => Result::Err(result),
        __ResultCase<A, E>::inspect(Result::Err(error)) => Result::Ok(error)
    }
}

// Result/Option ownership combinators. These are free source callables bound
// into the nominal namespaces below; callbacks receive payloads by move, and
// only predicates/defaulting operations require zero-use evidence for values
// they intentionally discard.
__g1_result_is_ok<A, E>(value: Result<A, E>) -> Bool
    where A: Use<[0,0]>, E: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(_)) => true,
        __ResultCase<A, E>::inspect(Result::Err(_)) => false
    }
}

__g1_result_is_err<A, E>(value: Result<A, E>) -> Bool
    where A: Use<[0,0]>, E: Use<[0,0]> {
    not(__g1_result_is_ok(move value))
}

__g1_result_map<A, E, B, F>(value: Result<A, E>, transform: F) -> Result<B, E>
    where F: Fn<(A), Output=B>, F: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(result)) =>
            Result::Ok(transform(move result)),
        __ResultCase<A, E>::inspect(Result::Err(error)) => Result::Err(error)
    }
}

__g1_result_map_err<A, E, E2, F>(value: Result<A, E>, transform: F) -> Result<A, E2>
    where F: Fn<(E), Output=E2>, F: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(result)) => Result::Ok(result),
        __ResultCase<A, E>::inspect(Result::Err(error)) =>
            Result::Err(transform(move error))
    }
}

__g1_result_and_then<A, E, B, F>(
    value: Result<A, E>,
    transform: F
) -> Result<B, E> where F: Fn<(A), Output=Result<B, E>>, F: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(result)) => transform(move result),
        __ResultCase<A, E>::inspect(Result::Err(error)) => Result::Err(error)
    }
}

__g1_result_or_else<A, E, E2, F>(
    value: Result<A, E>,
    transform: F
) -> Result<A, E2> where F: Fn<(E), Output=Result<A, E2>>, F: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(result)) => Result::Ok(result),
        __ResultCase<A, E>::inspect(Result::Err(error)) => transform(move error)
    }
}

__g1_result_unwrap_or<A, E>(value: Result<A, E>, fallback: A) -> A
    where A: Use<[0,0]>, E: Use<[0,0]> {
    handle perform __ResultCase<A, E>::inspect(value) {
        __ResultCase<A, E>::inspect(Result::Ok(result)) => result,
        __ResultCase<A, E>::inspect(Result::Err(_)) => fallback
    }
}

__g1_option_map<A, B, F>(value: Option<A>, transform: F) -> Option<B>
    where F: Fn<(A), Output=B>, F: Use<[0,0]> {
    handle perform __ResultCase<A, ()>::inspect(value) {
        __ResultCase<A, ()>::inspect(Result::Ok(result)) =>
            Option::Some(transform(move result)),
        __ResultCase<A, ()>::inspect(Result::Err(_)) => None
    }
}

__g1_option_and_then<A, B, F>(value: Option<A>, transform: F) -> Option<B>
    where F: Fn<(A), Output=Option<B>>, F: Use<[0,0]> {
    handle perform __ResultCase<A, ()>::inspect(value) {
        __ResultCase<A, ()>::inspect(Result::Ok(result)) => transform(move result),
        __ResultCase<A, ()>::inspect(Result::Err(_)) => None
    }
}

__g1_option_or_else<A, F>(value: Option<A>, fallback: F) -> Option<A>
    where F: Fn<(), Output=Option<A>>, F: Use<[0,0]> {
    handle perform __ResultCase<A, ()>::inspect(value) {
        __ResultCase<A, ()>::inspect(Result::Ok(result)) => Option::Some(result),
        __ResultCase<A, ()>::inspect(Result::Err(_)) => fallback()
    }
}

__g1_option_unwrap_or<A>(value: Option<A>, fallback: A) -> A
    where A: Use<[0,0]> {
    handle perform __ResultCase<A, ()>::inspect(value) {
        __ResultCase<A, ()>::inspect(Result::Ok(result)) => result,
        __ResultCase<A, ()>::inspect(Result::Err(_)) => fallback
    }
}

let Result::is_ok = __g1_result_is_ok;
let Result::is_err = __g1_result_is_err;
let Result::map = __g1_result_map;
let Result::map_err = __g1_result_map_err;
let Result::and_then = __g1_result_and_then;
let Result::or_else = __g1_result_or_else;
