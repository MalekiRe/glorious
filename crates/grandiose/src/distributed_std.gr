    length: usize
) -> Hasher {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_hasher_write_bytes_step(
                move value,
                move bytes,
                cursor,
                length
            ),
        __VecBoolCase::inspect(Result::Err(_)) => move value
    }
}

__g1_hasher_write_bytes(value: &mut Hasher, bytes: &Bytes) -> () {
    let updated = __g1_hasher_write_bytes_at(
        *value,
        *bytes,
        0,
        __g1_bytes_len(*bytes)
    );
    (*value).state = updated.state;
    ()
}

__g1_hasher_finish(value: &Hasher) -> u64 { value.state }

let Hasher::new = __g1_hasher_new;
let Hasher::write_u8 = __g1_hasher_write_u8;
let Hasher::write_u16 = __g1_hasher_write_u16;
let Hasher::write_u32 = __g1_hasher_write_u32;
let Hasher::write_u64 = __g1_hasher_write_u64;
let Hasher::write_u128 = __g1_hasher_write_u128;
let Hasher::write_usize = __g1_hasher_write_usize;
let Hasher::write_bytes = __g1_hasher_write_bytes;
let Hasher::finish = __g1_hasher_finish;

// Layer 3c: compiler resource accounting. StepBudget is deliberately based on
// deterministic logical work rather than wall time. Its state is private so a
// compiler phase can spend or inspect a budget but cannot replenish it.
struct StepBudget { private remaining: usize }

__g1_step_budget_new(limit: usize) -> StepBudget {
    StepBudget { remaining: move limit }
}

__g1_step_budget_remaining(value: &StepBudget) -> usize {
    value.remaining
}

__g1_step_budget_is_exhausted(value: &StepBudget) -> Bool {
    value.remaining == 0
}

__g1_step_budget_spend(value: &mut StepBudget, steps: usize) -> Bool {
    let remaining = __g1_step_budget_remaining(&*value);
    (*value).remaining = move remaining - move steps;
    true
}

__g1_step_budget_try_take(value: &mut StepBudget, steps: usize) -> Bool {
    let available = __g1_step_budget_remaining(&*value);
    handle perform __VecBoolCase::inspect(steps <= available) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_step_budget_spend(move value, move steps),
        __VecBoolCase::inspect(Result::Err(_)) => false
    }
}

let StepBudget::new = __g1_step_budget_new;
let StepBudget::remaining = __g1_step_budget_remaining;
let StepBudget::is_exhausted = __g1_step_budget_is_exhausted;
let StepBudget::try_take = __g1_step_budget_try_take;

// Layer 4: compiler-host protocols. String remains an ordinary source alias;
// only this standard-library source entry has the authority to seal the host's
// initialized Array<Text> result inside Vec's private representation.
effect ProcessArgs { [1,1] get() -> Vec<String>; }
effect FileRead { [1,1] read(path: String) -> Bytes; }
effect FileWrite { [1,1] write(path: String, bytes: Bytes) -> (); }
effect Diagnostic { [1,1] write(text: String) -> (); }

process_args() -> Vec<String> / {ProcessArgs} {
    perform ProcessArgs::get()
}

read_file(path: String) -> Bytes / {FileRead} {
    perform FileRead::read(move path)
}

write_file(path: String, bytes: Bytes) -> () / {FileWrite} {
    perform FileWrite::write(move path, move bytes)
}

write_diagnostic(text: String) -> () / {Diagnostic} {
    perform Diagnostic::write(move text)
}

__g1_vec_from_array<T>(storage: Array<T>) -> Vec<T> {
    Vec { storage: move storage }
}

run_compiler_host<F, R>(main: F) -> R
    where F: Fn<
        (),
        Output=R,
        Effects={ProcessArgs, FileRead, FileWrite, Diagnostic}
    > {
    handle { main() } {
        ProcessArgs::get() with continuation => {
            resume(
                move continuation,
                __g1_vec_from_array(__g1_process_args_get())
            )
        },
        FileRead::read(path) with continuation => {
            resume(move continuation, __g1_fs_read(move path))
        },
        FileWrite::write(path, bytes) with continuation => {
            __g1_fs_write(move path, move bytes);
            resume(move continuation, ())
        },
        Diagnostic::write(text) with continuation => {
            __g1_diagnostic_write(move text);
            resume(move continuation, ())
        }
    }
}
