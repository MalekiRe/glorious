    let length = value.dense_length;
    handle perform __VecBoolCase::inspect(dense_index < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let moved = __g1_sparse_set_dense_at(&*value, dense_index);
            let moved_raw = wrapping_convert_to_usize(moved.raw);
            __g1_sparse_set_write_sparse(&mut *value, moved_raw, dense_index);
            __g1_sparse_set_write_sparse(&mut *value, raw, 0);
