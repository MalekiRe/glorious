// Structural fundamental traits. Option<T> is the transparent Result<T, ()>
// alias, so the Result implementations below are also its coherent evidence.
impl<T, E> Default for Result<T, E> where T: Default {
    default() -> Result<T, E> { Result::Ok(Default::default()) }
}
impl<T, E> Eq for Result<T, E> where T: Eq, E: Eq {
    eq(self: &Result<T, E>, other: &Result<T, E>) -> Bool {
        if(*self is Result::Ok(left)) {
            if(*other is Result::Ok(right)) { Eq::eq(left, right) } else { false }
        } else {
            if(*other is Result::Err(right)) {
                if(*self is Result::Err(left)) { Eq::eq(left, right) } else { false }
            } else { false }
        }
    }
}
impl<T, E> Ord for Result<T, E> where T: Ord, E: Ord {
    cmp(self: &Result<T, E>, other: &Result<T, E>) -> Ordering {
        if(*self is Result::Ok(left)) {
            if(*other is Result::Ok(right)) { Ord::cmp(left, right) }
            else { Ordering::Less }
        } else {
            if(*other is Result::Err(right)) {
                if(*self is Result::Err(left)) { Ord::cmp(left, right) }
                else { Ordering::Equal }
            } else { Ordering::Greater }
        }
    }
}
impl<T, E> Hash for Result<T, E> where T: Hash, E: Hash {
    hash(self: &Result<T, E>, state: &mut Hasher) -> () {
        if(*self is Result::Ok(value)) {
            Hasher::write_u8(&mut *state, 0);
            Hash::hash(value, move state)
        } else {
            if(*self is Result::Err(value)) {
                Hasher::write_u8(&mut *state, 1);
                Hash::hash(value, move state)
            } else { state; () }
        }
    }
}
impl<T, E> Display for Result<T, E> where T: Display, E: Display {
    fmt(self: &Result<T, E>, formatter: &mut Formatter) -> () {
        if(*self is Result::Ok(value)) {
            __g1_debug_literal(&mut *formatter, "Ok(");
            Display::fmt(value, &mut *formatter);
            __g1_debug_literal(move formatter, ")")
        } else {
            if(*self is Result::Err(value)) {
                __g1_debug_literal(&mut *formatter, "Err(");
                Display::fmt(value, &mut *formatter);
                __g1_debug_literal(move formatter, ")")
            } else { formatter; () }
        }
    }
}
impl<T, E> Debug for Result<T, E> where T: Debug, E: Debug {
    fmt(self: &Result<T, E>, formatter: &mut Formatter) -> () {
        if(*self is Result::Ok(value)) {
            __g1_debug_literal(&mut *formatter, "Ok(");
            Debug::fmt(value, &mut *formatter);
            __g1_debug_literal(move formatter, ")")
        } else {
            if(*self is Result::Err(value)) {
                __g1_debug_literal(&mut *formatter, "Err(");
                Debug::fmt(value, &mut *formatter);
                __g1_debug_literal(move formatter, ")")
            } else { formatter; () }
        }
    }
}

