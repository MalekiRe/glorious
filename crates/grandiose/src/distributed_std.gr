impl<A, B, C> Eq for (A, B, C) where A: Eq, B: Eq, C: Eq {
    eq(self: &(A, B, C), other: &(A, B, C)) -> Bool {
        Eq::eq(&self.0, &other.0)
            && Eq::eq(&self.1, &other.1)
            && Eq::eq(&self.2, &other.2)
    }
}
impl<A, B, C> Ord for (A, B, C) where A: Ord, B: Ord, C: Ord {
    cmp(self: &(A, B, C), other: &(A, B, C)) -> Ordering {
        let first = Ord::cmp(&self.0, &other.0);
        let second = Ord::cmp(&self.1, &other.1);
        let third = Ord::cmp(&self.2, &other.2);
        if(first is Ordering::Equal) {
            if(second is Ordering::Equal) { third } else { second }
        } else { first }
    }
}
impl<A, B, C> Hash for (A, B, C) where A: Hash, B: Hash, C: Hash {
    hash(self: &(A, B, C), state: &mut Hasher) -> () {
        Hash::hash(&self.0, &mut *state);
        Hash::hash(&self.1, &mut *state);
        Hash::hash(&self.2, move state)
    }
}
impl<A, B, C> Display for (A, B, C) where A: Display, B: Display, C: Display {
    fmt(self: &(A, B, C), formatter: &mut Formatter) -> () {
        __g1_debug_literal(&mut *formatter, "(");
        Display::fmt(&self.0, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Display::fmt(&self.1, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Display::fmt(&self.2, &mut *formatter);
        __g1_debug_literal(move formatter, ")")
    }
}
impl<A, B, C> Debug for (A, B, C) where A: Debug, B: Debug, C: Debug {
    fmt(self: &(A, B, C), formatter: &mut Formatter) -> () {
        __g1_debug_literal(&mut *formatter, "(");
        Debug::fmt(&self.0, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Debug::fmt(&self.1, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Debug::fmt(&self.2, &mut *formatter);
        __g1_debug_literal(move formatter, ")")
    }
}

impl<A, B, C, D> Default for (A, B, C, D)
    where A: Default, B: Default, C: Default, D: Default {
    default() -> (A, B, C, D) {
        (
            Default::default(), Default::default(),
            Default::default(), Default::default()
        )
    }
}
impl<A, B, C, D> Eq for (A, B, C, D) where A: Eq, B: Eq, C: Eq, D: Eq {
    eq(self: &(A, B, C, D), other: &(A, B, C, D)) -> Bool {
        Eq::eq(&self.0, &other.0)
            && Eq::eq(&self.1, &other.1)
            && Eq::eq(&self.2, &other.2)
            && Eq::eq(&self.3, &other.3)
    }
}
impl<A, B, C, D> Ord for (A, B, C, D) where A: Ord, B: Ord, C: Ord, D: Ord {
    cmp(self: &(A, B, C, D), other: &(A, B, C, D)) -> Ordering {
        let first = Ord::cmp(&self.0, &other.0);
        let second = Ord::cmp(&self.1, &other.1);
        let third = Ord::cmp(&self.2, &other.2);
        let fourth = Ord::cmp(&self.3, &other.3);
        if(first is Ordering::Equal) {
            if(second is Ordering::Equal) {
                if(third is Ordering::Equal) { fourth } else { third }
            } else { second }
        } else { first }
    }
}
impl<A, B, C, D> Hash for (A, B, C, D)
    where A: Hash, B: Hash, C: Hash, D: Hash {
    hash(self: &(A, B, C, D), state: &mut Hasher) -> () {
        Hash::hash(&self.0, &mut *state);
        Hash::hash(&self.1, &mut *state);
        Hash::hash(&self.2, &mut *state);
        Hash::hash(&self.3, move state)
    }
}
impl<A, B, C, D> Display for (A, B, C, D)
    where A: Display, B: Display, C: Display, D: Display {
    fmt(self: &(A, B, C, D), formatter: &mut Formatter) -> () {
        __g1_debug_literal(&mut *formatter, "(");
        Display::fmt(&self.0, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Display::fmt(&self.1, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Display::fmt(&self.2, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Display::fmt(&self.3, &mut *formatter);
        __g1_debug_literal(move formatter, ")")
    }
}
impl<A, B, C, D> Debug for (A, B, C, D)
    where A: Debug, B: Debug, C: Debug, D: Debug {
    fmt(self: &(A, B, C, D), formatter: &mut Formatter) -> () {
        __g1_debug_literal(&mut *formatter, "(");
        Debug::fmt(&self.0, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Debug::fmt(&self.1, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Debug::fmt(&self.2, &mut *formatter);
        __g1_debug_literal(&mut *formatter, ", ");
        Debug::fmt(&self.3, &mut *formatter);
        __g1_debug_literal(move formatter, ")")
    }
}

// Ordinary ordering algorithms.  Every recursive edge shrinks an index range;
// introsort additionally carries the conventional `2 * floor(log2(n))` depth
// budget and switches to heapsort when hostile partitions exhaust it.  Thus no
// input can turn quicksort's recursion into an unbounded source-level call
// chain, and all operation counts depend only on the input and its ordering.
effect __AlgorithmOrderingCase { inspect(value: Ordering) -> !; }

__g1_algorithm_cmp<T>(left: &T, right: &T) -> Ordering where T: Ord {
    Ord::cmp(left, right)
}

__g1_algorithm_eq<T>(left: &T, right: &T) -> Bool where T: Eq {
    Eq::eq(left, right)
}

__g1_vec_cmp_at<T>(value: &Vec<T>, left: usize, right: usize) -> Ordering
    where T: Ord {
    __g1_algorithm_cmp(
        __g1_vec_index(value, left),
        __g1_vec_index(value, right)
    )
}

__g1_vec_eq_at<T>(value: &Vec<T>, left: usize, right: usize) -> Bool
    where T: Eq {
    __g1_algorithm_eq(
        __g1_vec_index(value, left),
        __g1_vec_index(value, right)
    )
}

__g1_vec_largest_child<T>(
    value: &Vec<T>, start: usize, child: usize, right: usize, length: usize
) -> usize where T: Ord {
    handle perform __VecBoolCase::inspect(right < length) {
        __VecBoolCase::inspect(Result::Err(_)) => child,
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let order = __g1_vec_cmp_at(value, start + child, start + right);
            if(order is Ordering::Less) { right } else { child }
        }
    }
}

__g1_algorithm_floor_log2(value: usize, result: usize) -> usize {
    handle perform __VecBoolCase::inspect(value < 2) {
        __VecBoolCase::inspect(Result::Ok(_)) => move result,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_algorithm_floor_log2(value / 2, result + 1)
    }
}

__g1_algorithm_min_usize(left: usize, right: usize) -> usize {
    handle perform __VecBoolCase::inspect(left < right) {
        __VecBoolCase::inspect(Result::Ok(_)) => left,
        __VecBoolCase::inspect(Result::Err(_)) => right
    }
}

__g1_vec_sift_down<T>(
    value: &mut Vec<T>,
    start: usize,
    length: usize,
    root: usize
) -> () where T: Ord {
    let child = root + root + 1;
    handle perform __VecBoolCase::inspect(child < length) {
        __VecBoolCase::inspect(Result::Err(_)) => { value; () },
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let right = child + 1;
            let largest = __g1_vec_largest_child(
                &*value, start, child, right, length
            );
            let order = __g1_vec_cmp_at(
                &*value, start + root, start + largest
            );
            if(order is Ordering::Less) {
                __g1_vec_swap(&mut *value, start + root, start + largest);
                __g1_vec_sift_down(move value, start, length, largest)
            } else {
                value;
                ()
            }
        }
    }
}

__g1_vec_heap_build<T>(value: &mut Vec<T>, start: usize, length: usize, node: usize)
    -> () where T: Ord {
    handle perform __VecBoolCase::inspect(node == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => { value; () },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let next = node - 1;
            __g1_vec_sift_down(&mut *value, start, length, next);
            __g1_vec_heap_build(move value, start, length, next)
        }
    }
}

__g1_vec_heap_extract<T>(
    value: &mut Vec<T>, start: usize, length: usize, remaining: usize
) -> () where T: Ord {
    handle perform __VecBoolCase::inspect(remaining <= 1) {
        __VecBoolCase::inspect(Result::Ok(_)) => { value; () },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let next = remaining - 1;
            __g1_vec_swap(&mut *value, start, start + next);
            __g1_vec_sift_down(&mut *value, start, next, 0);
            __g1_vec_heap_extract(move value, start, length, next)
        }
    }
}

__g1_vec_heap_sort_range<T>(value: &mut Vec<T>, start: usize, end: usize) -> ()
    where T: Ord {
    let length = end - start;
    __g1_vec_heap_build(&mut *value, start, length, length / 2);
    __g1_vec_heap_extract(move value, start, length, length)
}

__g1_vec_partition_pivot<T>(
    value: &mut Vec<T>, low: usize, pivot: usize, cursor: usize, store: usize
) -> usize where T: Ord {
    handle perform __VecBoolCase::inspect(cursor < pivot) {
        __VecBoolCase::inspect(Result::Err(_)) => {
            __g1_vec_swap(move value, store, pivot);
            store
        },
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let order = __g1_vec_cmp_at(&*value, cursor, pivot);
            if(order is Ordering::Less) {
                __g1_vec_swap(&mut *value, cursor, store);
                __g1_vec_partition_pivot(
                    move value, low, pivot, cursor + 1, store + 1
                )
            } else {
                __g1_vec_partition_pivot(
                    move value, low, pivot, cursor + 1, store
                )
            }
        }
    }
}

__g1_vec_intro_sort_range<T>(
    value: &mut Vec<T>, low: usize, high: usize, depth: usize
) -> () where T: Ord {
    let length = high - low;
    handle perform __VecBoolCase::inspect(length <= 1) {
        __VecBoolCase::inspect(Result::Ok(_)) => { value; () },
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(depth == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_vec_heap_sort_range(move value, low, high),
                __VecBoolCase::inspect(Result::Err(_)) => {
                    let pivot = high - 1;
                    __g1_vec_swap(&mut *value, low + length / 2, pivot);
                    let split = __g1_vec_partition_pivot(
                        &mut *value, low, pivot, low, low
                    );
                    let next_depth = depth - 1;
                    __g1_vec_intro_sort_range(
                        &mut *value, low, split, next_depth
                    );
                    __g1_vec_intro_sort_range(
                        move value, split + 1, high, next_depth
                    )
                }
            }
    }
}

__g1_vec_sort<T>(value: &mut Vec<T>) -> () where T: Ord {
    let length = Vec::len(&*value);
    let depth = __g1_algorithm_floor_log2(length, 0);
    __g1_vec_intro_sort_range(move value, 0, length, depth + depth)
}

// The merge pass is stable: an element from the right half moves only when it
// is strictly less than the current left element.  Rotation uses swaps, so it
// works for must-move elements without fabricating a temporary T or abandoning
// one. Comparisons remain O(n log n); the in-place rotations trade storage for
// a deterministic O(n^2) worst-case move bound.
__g1_vec_merge_rotate<T>(value: &mut Vec<T>, cursor: usize, destination: usize)
    -> () {
    handle perform __VecBoolCase::inspect(destination < cursor) {
        __VecBoolCase::inspect(Result::Err(_)) => { value; () },
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_vec_swap(&mut *value, cursor - 1, cursor);
            __g1_vec_merge_rotate(move value, cursor - 1, move destination)
        }
    }
}

__g1_vec_merge<T>(
    value: &mut Vec<T>, left: usize, middle: usize, right: usize, cursor: usize
) -> () where T: Ord {
    handle perform __VecBoolCase::inspect(cursor < middle) {
        __VecBoolCase::inspect(Result::Err(_)) => { value; () },
        __VecBoolCase::inspect(Result::Ok(_)) =>
            handle perform __VecBoolCase::inspect(middle < right) {
                __VecBoolCase::inspect(Result::Err(_)) => { value; () },
                __VecBoolCase::inspect(Result::Ok(_)) => {
                    let order = __g1_vec_cmp_at(&*value, middle, cursor);
                    if(order is Ordering::Less) {
                        __g1_vec_merge_rotate(&mut *value, middle, cursor);
                        __g1_vec_merge(
                            move value, left, middle + 1, right, cursor + 1
                        )
                    } else {
                        __g1_vec_merge(
                            move value, left, middle, right, cursor + 1
                        )
                    }
                }
            }
    }
}

__g1_vec_stable_sort_range<T>(value: &mut Vec<T>, low: usize, high: usize) -> ()
    where T: Ord {
    let length = high - low;
    handle perform __VecBoolCase::inspect(length <= 1) {
        __VecBoolCase::inspect(Result::Ok(_)) => { value; () },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let middle = low + length / 2;
            __g1_vec_stable_sort_range(&mut *value, low, middle);
            __g1_vec_stable_sort_range(&mut *value, middle, high);
            __g1_vec_merge(move value, low, middle, high, low)
        }
    }
}

__g1_vec_sort_stable<T>(value: &mut Vec<T>) -> () where T: Ord {
    let length = Vec::len(&*value);
    __g1_vec_stable_sort_range(move value, 0, length)
}

__g1_vec_lower_bound_range<T>(
    value: &Vec<T>, target: &T, low: usize, high: usize
) -> usize where T: Ord {
    handle perform __VecBoolCase::inspect(low < high) {
        __VecBoolCase::inspect(Result::Err(_)) => move low,
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let middle = low + (high - low) / 2;
            let order = __g1_algorithm_cmp(__g1_vec_index(value, middle), target);
            if(order is Ordering::Less) {
                __g1_vec_lower_bound_range(value, target, middle + 1, high)
            } else {
                __g1_vec_lower_bound_range(value, target, low, middle)
            }
        }
    }
}

__g1_vec_lower_bound<T>(value: &Vec<T>, target: &T) -> usize where T: Ord {
    __g1_vec_lower_bound_range(value, target, 0, Vec::len(value))
}

__g1_vec_upper_bound_range<T>(
    value: &Vec<T>, target: &T, low: usize, high: usize
) -> usize where T: Ord {
    handle perform __VecBoolCase::inspect(low < high) {
        __VecBoolCase::inspect(Result::Err(_)) => move low,
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let middle = low + (high - low) / 2;
            let order = __g1_algorithm_cmp(target, __g1_vec_index(value, middle));
            if(order is Ordering::Less) {
                __g1_vec_upper_bound_range(value, target, low, middle)
            } else {
                __g1_vec_upper_bound_range(value, target, middle + 1, high)
            }
        }
    }
}

__g1_vec_upper_bound<T>(value: &Vec<T>, target: &T) -> usize where T: Ord {
    __g1_vec_upper_bound_range(value, target, 0, Vec::len(value))
}

__g1_vec_binary_search<T>(value: &Vec<T>, target: &T) -> Option<usize>
    where T: Ord {
    let lower = __g1_vec_lower_bound(value, target);
    let upper = __g1_vec_upper_bound(value, target);
    value;
    target;
    handle perform __VecBoolCase::inspect(lower < upper) {
        __VecBoolCase::inspect(Result::Ok(_)) => Option::Some(lower),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

// Partition around a borrowed ordering key. Elements strictly below the key
// precede the returned boundary; all others follow it. The key is external to
// the Vec, so swaps cannot invalidate the borrow.
__g1_vec_partition_boundary<T>(
    value: &mut Vec<T>, cursor: usize, boundary: usize, selected: Bool
) -> usize {
    handle perform __VecBoolCase::inspect(move selected) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_vec_swap(move value, cursor, boundary);
            boundary + 1
        },
        __VecBoolCase::inspect(Result::Err(_)) => { value; boundary }
    }
}

__g1_vec_partition_at<T>(
    value: &mut Vec<T>, pivot: &T, cursor: usize, boundary: usize, length: usize
) -> usize where T: Ord {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Err(_)) => move boundary,
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let order = __g1_algorithm_cmp(
                __g1_vec_index(&*value, cursor), pivot
            );
            let selected = order is Ordering::Less;
            let next = __g1_vec_partition_boundary(
                &mut *value, cursor, boundary, move selected
            );
            __g1_vec_partition_at(
                move value, move pivot, cursor + 1, move next, length
            )
        }
    }
}

__g1_vec_partition<T>(value: &mut Vec<T>, pivot: &T) -> usize
    where T: Ord {
    let length = Vec::len(&*value);
    __g1_vec_partition_at(value, pivot, 0, 0, length)
}

__g1_vec_dedup_from<T>(
    value: &mut Vec<T>, cursor: usize, write: usize, length: usize
) -> ()
    where T: Eq, T: Use<[0,0]> {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Err(_)) =>
            Vec::truncate(move value, write),
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let duplicate = __g1_vec_eq_at(&*value, write - 1, cursor);
            handle perform __VecBoolCase::inspect(move duplicate) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_vec_dedup_from(
                        move value, cursor + 1, write, length
                    ),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    {
                        __g1_vec_swap(&mut *value, cursor, write);
                        __g1_vec_dedup_from(
                            move value, cursor + 1, write + 1, length
                        )
                    }
            }
        }
    }
}

__g1_vec_dedup<T>(value: &mut Vec<T>) -> () where T: Eq, T: Use<[0,0]> {
    let length = Vec::len(&*value);
    handle perform __VecBoolCase::inspect(length < 2) {
        __VecBoolCase::inspect(Result::Ok(_)) => { value; () },
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_dedup_from(move value, 1, 1, length)
    }
}

__g1_vec_lexicographic_at<T>(
    left: &Vec<T>, right: &Vec<T>, cursor: usize, common: usize
) -> Ordering where T: Ord {
    handle perform __VecBoolCase::inspect(cursor < common) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let order = __g1_algorithm_cmp(
                __g1_vec_index(left, cursor), __g1_vec_index(right, cursor)
            );
            handle perform __AlgorithmOrderingCase::inspect(move order) {
                __AlgorithmOrderingCase::inspect(Ordering::Less) => {
                    left; right; Ordering::Less
                },
                __AlgorithmOrderingCase::inspect(Ordering::Greater) => {
                    left; right; Ordering::Greater
                },
                __AlgorithmOrderingCase::inspect(Ordering::Equal) =>
                    __g1_vec_lexicographic_at(
                        left, right, cursor + 1, common
                    )
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_ordering_from_flags(
                Vec::len(left) < Vec::len(right),
                Vec::len(left) == Vec::len(right)
            )
    }
}

__g1_vec_lexicographic_cmp<T>(left: &Vec<T>, right: &Vec<T>) -> Ordering
    where T: Ord {
    let left_length = Vec::len(left);
    let right_length = Vec::len(right);
    let common = __g1_algorithm_min_usize(left_length, right_length);
    __g1_vec_lexicographic_at(left, right, 0, common)
}

let Vec::sort = __g1_vec_sort;
let Vec::sort_stable = __g1_vec_sort_stable;
let Vec::binary_search = __g1_vec_binary_search;
let Vec::lower_bound = __g1_vec_lower_bound;
let Vec::upper_bound = __g1_vec_upper_bound;
let Vec::partition = __g1_vec_partition;
let Vec::dedup = __g1_vec_dedup;
let Vec::lexicographic_cmp = __g1_vec_lexicographic_cmp;

// Deterministic open-addressed compiler collections. Empty buckets use the
// payload-free `Result::Err(())` state;
// every occupied bucket owns exactly one `(K, V)` pair. Capacity is always a
// power of two and growth happens before the table reaches three quarters
// full, leaving every bounded probe with an empty stopping bucket.
struct HashMap<K, V> {
    private buckets: Vec<Result<(K, V), ()>>,
    private length: usize
}

struct __HashProbe { index: usize, found: Bool }

__g1_hash_map_new<K, V>() -> HashMap<K, V> {
    HashMap { buckets: Vec::new(), length: 0 }
}

__g1_hash_map_fresh<K, V>(value: &HashMap<K, V>) -> HashMap<K, V> {
    value;
    __g1_hash_map_new()
}

__g1_hash_map_capacity_for(requested: usize, candidate: usize) -> usize {
    handle perform __VecBoolCase::inspect(candidate >= requested) {
        __VecBoolCase::inspect(Result::Ok(_)) => move candidate,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_hash_map_capacity_for(requested, candidate + candidate)
    }
}

__g1_hash_map_len<K, V>(value: &HashMap<K, V>) -> usize { value.length }

__g1_hash_map_capacity<K, V>(value: &HashMap<K, V>) -> usize {
    Vec::len(&value.buckets)
}

__g1_hash_map_is_empty<K, V>(value: &HashMap<K, V>) -> Bool {
    value.length == 0
}

__g1_hash_map_empty<K, V>(value: &HashMap<K, V>) -> Result<(K, V), ()> {
    value;
    Result::Err(())
}

__g1_hash_map_fill_empty<K, V>(
    value: &mut HashMap<K, V>,
    capacity: usize
) -> () {
    let current = Vec::len(&value.buckets);
    handle perform __VecBoolCase::inspect(current < capacity) {
        __VecBoolCase::inspect(Result::Err(_)) => (),
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let empty = __g1_hash_map_empty(&*value);
            Vec::push(&mut value.buckets, move empty);
            __g1_hash_map_fill_empty(move value, move capacity)
        }
    }
}

// The ownership-general reserve primitive operates on an empty table.  The
// map argument supplies generic evidence without inventing a K or V, and no
// resident entry is copied or discarded.  A nonempty table reports `false`;
// the ordinary `insert` path performs ownership-permitting rehash growth.
__g1_hash_map_reserve<K, V>(value: &mut HashMap<K, V>, requested: usize)
    -> Bool {
    handle perform __VecBoolCase::inspect(value.length == 0) {
        __VecBoolCase::inspect(Result::Err(_)) => false,
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let current = Vec::len(&value.buckets);
            handle perform __VecBoolCase::inspect(current >= requested) {
                __VecBoolCase::inspect(Result::Ok(_)) => true,
                __VecBoolCase::inspect(Result::Err(_)) => {
                    let capacity = __g1_hash_map_capacity_for(requested, 8);
                    __g1_hash_map_fill_empty(move value, move capacity);
                    true
                }
            }
        }
    }
}

__g1_hash_map_occupied<K, V>(key: K, item: V) -> Result<(K, V), ()> {
    Result::Ok((move key, move item))
}

__g1_hash_map_hash<K>(key: &K) -> u64 where K: Hash {
    let state = Hasher::new();
    Hash::hash(key, &mut state);
    Hasher::finish(&state)
}

__g1_hash_map_start<K>(key: &K, capacity: usize) -> usize where K: Hash {
    wrapping_convert_to_usize(__g1_u64_rem(
        __g1_hash_map_hash(key),
        wrapping_convert_to_u64(move capacity)
    ))
}

__g1_hash_map_next(index: usize, capacity: usize) -> usize {
    let next = __g1_usize_successor(index);
    handle perform __VecBoolCase::inspect(next == capacity) {
        __VecBoolCase::inspect(Result::Ok(_)) => 0,
        __VecBoolCase::inspect(Result::Err(_)) => move next
    }
}

__g1_hash_map_keys_equal<K>(left: &K, right: &K) -> Bool where K: Eq {
    Eq::eq(left, right)
}

__g1_hash_map_bucket_key<'a, K, V>(
    bucket: &'a Result<(K, V), ()>
) -> Option<&'a K> {
    if(*bucket is Result::Ok(_)) {
        Option::Some(&bucket.0.0)
    } else {
        None
    }
}

__g1_hash_map_probe<K, V>(
    value: &HashMap<K, V>,
    key: &K,
    index: usize,
    remaining: usize
) -> __HashProbe where K: Eq {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __HashProbe { index: move index, found: false },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let bucket = __g1_vec_index(&value.buckets, index);
            handle perform __ResultCase<&K, ()>::inspect(
                __g1_hash_map_bucket_key(bucket)
            ) {
                __ResultCase<&K, ()>::inspect(Result::Ok(found)) =>
                    handle perform __VecBoolCase::inspect(
                        __g1_hash_map_keys_equal(move found, key)
                    ) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            __HashProbe { index: move index, found: true },
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            __g1_hash_map_probe(
                                value,
                                key,
                                __g1_hash_map_next(
                                    move index,
                                    Vec::len(&value.buckets)
                                ),
                                __g1_parse_usize_predecessor(move remaining)
                            )
                    },
                __ResultCase<&K, ()>::inspect(Result::Err(_)) =>
                    __HashProbe { index: move index, found: false }
            }
        }
    }
}

__g1_hash_map_find<K, V>(value: &HashMap<K, V>, key: &K) -> __HashProbe
    where K: Eq, K: Hash {
    let capacity = Vec::len(&value.buckets);
    __g1_hash_map_probe(
        value,
        key,
        __g1_hash_map_start(key, capacity),
        move capacity
    )
}

__g1_hash_map_get<'a, K, V>(
    value: &'a HashMap<K, V>,
    key: &K
) -> Option<&'a V> where K: Eq, K: Hash {
    let capacity = Vec::len(&value.buckets);
    handle perform __VecBoolCase::inspect(capacity == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => None,
        __VecBoolCase::inspect(Result::Err(_)) => {
            let probe = __g1_hash_map_find(value, key);
            handle perform __VecBoolCase::inspect(move probe.found) {
                __VecBoolCase::inspect(Result::Ok(_)) => {
                    let bucket = __g1_vec_index(
                        &value.buckets,
                        probe.index
                    );
                    if(*bucket is Result::Ok(_)) {
                        __g1_hash_map_borrowed(&(*bucket).0.1)
                    } else {
                        None
                    }
                },
                __VecBoolCase::inspect(Result::Err(_)) => None
            }
        }
    }
}

__g1_hash_map_get_mut<'a, K, V>(
    value: &'a mut HashMap<K, V>,
    key: &K
) -> Option<&'a mut V> where K: Eq, K: Hash {
    let capacity = Vec::len(&value.buckets);
    handle perform __VecBoolCase::inspect(capacity == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => None,
        __VecBoolCase::inspect(Result::Err(_)) => {
            let probe = __g1_hash_map_find(&*value, key);
            handle perform __VecBoolCase::inspect(move probe.found) {
                __VecBoolCase::inspect(Result::Err(_)) => None,
                __VecBoolCase::inspect(Result::Ok(_)) => {
                    let bucket = __g1_vec_index_mut(
                        &mut value.buckets,
                        probe.index
                    );
                    if(*bucket is Result::Ok(_)) {
                        Option::Some(&mut bucket.0.1)
                    } else {
                        None
                    }
                }
            }
        }
    }
}

__g1_hash_map_contains_key<K, V>(value: &HashMap<K, V>, key: &K) -> Bool
    where K: Eq, K: Hash {
    let capacity = Vec::len(&value.buckets);
    handle perform __VecBoolCase::inspect(capacity == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => false,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_hash_map_find(value, key).found
    }
}

__g1_hash_map_borrowed<'a, V>(value: &'a V) -> Option<&'a V> {
    Option::Some(move value)
}

__g1_hash_map_insert_at<K, V>(
    value: &mut HashMap<K, V>,
    key: K,
    item: V,
    probe: __HashProbe
) -> Option<V> where K: Use<[0,0]> {
    let replacement = __g1_hash_map_occupied(move key, move item);
    let previous = replace(
        __g1_vec_index_mut(&mut value.buckets, probe.index),
        move replacement
    );
    handle perform __ResultCase<(K, V), ()>::inspect(move previous) {
        __ResultCase<(K, V), ()>::inspect(Result::Ok(pair)) => {
            let (previous_key, previous_value) = move pair;
            previous_key;
            Option::Some(move previous_value)
        },
        __ResultCase<(K, V), ()>::inspect(Result::Err(_)) => {
            (*value).length = __g1_usize_successor(value.length);
            None
        }
    }
}

// The ownership-general insertion path never discards an incoming key or
// value. It expects spare capacity; a full/threshold table returns ownership
// to the caller, as does an occupied key. This lets restricted values use a
// table after an explicit `with_capacity`/`reserve` decision.
__g1_hash_map_try_insert_ok<K, V>() -> Result<(), (K, V)> {
    Result::Ok(())
}

__g1_hash_map_try_insert_error<K, V>(pair: (K, V)) -> Result<(), (K, V)> {
    Result::Err(move pair)
}

__g1_hash_map_try_insert_at<K, V>(
    value: &mut HashMap<K, V>,
    key: K,
    item: V,
    probe: __HashProbe
) -> Result<(), (K, V)> {
    handle perform __VecBoolCase::inspect(move probe.found) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_hash_map_try_insert_error((move key, move item)),
        __VecBoolCase::inspect(Result::Err(_)) => {
            let replacement = __g1_hash_map_occupied(move key, move item);
            let previous = replace(
                __g1_vec_index_mut(&mut value.buckets, probe.index),
                move replacement
            );
            handle perform __ResultCase<(K, V), ()>::inspect(move previous) {
                __ResultCase<(K, V), ()>::inspect(Result::Err(_)) => {
                    (*value).length = __g1_usize_successor(value.length);
                    __g1_hash_map_try_insert_ok()
                },
                __ResultCase<(K, V), ()>::inspect(Result::Ok(previous_pair)) => {
                    let (previous_key, previous_item) = move previous_pair;
                    let displaced = replace(
                        __g1_vec_index_mut(&mut value.buckets, probe.index),
                        __g1_hash_map_occupied(
                            move previous_key,
                            move previous_item
                        )
                    );
                    handle perform __ResultCase<(K, V), ()>::inspect(
                        move displaced
                    ) {
                        __ResultCase<(K, V), ()>::inspect(
                            Result::Ok(incoming)
                        ) => __g1_hash_map_try_insert_error(move incoming),
                        __ResultCase<(K, V), ()>::inspect(Result::Err(_)) =>
                            __g1_hash_map_try_insert_ok()
                    }
                }
            }
        }
    }
}

__g1_hash_map_try_insert<K, V>(
    value: &mut HashMap<K, V>,
    key: K,
    item: V
) -> Result<(), (K, V)> where K: Eq, K: Hash {
    let should_grow = __g1_hash_map_should_grow(&*value);
    handle perform __VecBoolCase::inspect(move should_grow) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_hash_map_try_insert_error((move key, move item)),
        __VecBoolCase::inspect(Result::Err(_)) => {
            let probe = __g1_hash_map_find(&*value, &key);
            __g1_hash_map_try_insert_at(move value, move key, move item, move probe)
        }
    }
}

// Entry owns the incoming key together with the table's unique loan and the
// one completed probe. No public field can be forged or inspected, so callers
// cannot reuse a stale probe after mutating the map.
struct HashMapEntry<'a, K, V> {
    private value: &'a mut HashMap<K, V>,
    private key: K,
    private probe: __HashProbe
}

__g1_hash_map_entry<'a, K, V>(
    value: &'a mut HashMap<K, V>,
    key: K
) -> HashMapEntry<'a, K, V> where K: Eq, K: Hash,
        K: Use<[0,0]>, V: Use<[0,0]> {
    let should_grow = __g1_hash_map_should_grow(&*value);
    let grew = handle perform __VecBoolCase::inspect(move should_grow) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_hash_map_grow(&mut *value);
            true
        },
        __VecBoolCase::inspect(Result::Err(_)) => false
    };
    grew;
    let probe = __g1_hash_map_find(&*value, &key);
    HashMapEntry { value: move value, key: move key, probe: move probe }
}

__g1_hash_map_entry_is_occupied<'a, K, V>(
    value: &HashMapEntry<'a, K, V>
) -> Bool {
    value.probe.found
}

__g1_hash_map_entry_insert<'a, K, V>(
    entry: HashMapEntry<'a, K, V>,
    item: V
) -> Option<V> where K: Use<[0,0]> {
    let HashMapEntry { value, key, probe } = move entry;
    __g1_hash_map_insert_at(move value, move key, move item, move probe)
}

__g1_hash_map_entry_value_mut<'a, K, V>(
    value: &'a mut HashMap<K, V>,
    index: usize
) -> Option<&'a mut V> {
    let bucket = __g1_vec_index_mut(&mut value.buckets, index);
    if(*bucket is Result::Ok(_)) {
        Option::Some(&mut bucket.0.1)
    } else {
        None
    }
}

__g1_hash_map_entry_or_insert<'a, K, V>(
    entry: HashMapEntry<'a, K, V>,
    item: V
) -> Option<&'a mut V> where K: Use<[0,0]>,
        V: Use<[0,0]> {
    let HashMapEntry { value, key, probe } = move entry;
    let index = probe.index;
    handle perform __VecBoolCase::inspect(move probe.found) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            key;
            item;
            __g1_hash_map_entry_value_mut(move value, move index)
        },
        __VecBoolCase::inspect(Result::Err(_)) => {
            __g1_hash_map_insert_at(
                &mut *value,
                move key,
                move item,
                __HashProbe { index: index, found: false }
            );
            __g1_hash_map_entry_value_mut(move value, move index)
        }
    }
}

__g1_hash_map_insert_without_growth<K, V>(
    value: &mut HashMap<K, V>,
    key: K,
    item: V
) -> Option<V> where K: Eq, K: Hash, K: Use<[0,0]> {
    let probe = __g1_hash_map_find(&*value, &key);
    __g1_hash_map_insert_at(move value, move key, move item, move probe)
}

__g1_hash_map_rehash<K, V>(
    old: VecIntoIter<Result<(K, V), ()>>,
    fresh: &mut HashMap<K, V>
) -> () where K: Eq, K: Hash, K: Use<[0,0]>, V: Use<[0,0]> {
    handle perform __ResultCase<
        (Result<(K, V), ()>, VecIntoIter<Result<(K, V), ()>>),
        ()
    >::inspect(VecIntoIter::next(move old)) {
        __ResultCase<
            (Result<(K, V), ()>, VecIntoIter<Result<(K, V), ()>>),
            ()
        >::inspect(Result::Ok(step)) => {
            let (bucket, remaining) = move step;
            handle perform __ResultCase<(K, V), ()>::inspect(move bucket) {
                __ResultCase<(K, V), ()>::inspect(Result::Ok(pair)) => {
                    let (key, item) = move pair;
                    __g1_hash_map_insert_without_growth(
                        &mut *fresh,
                        move key,
                        move item
                    )
                },
                __ResultCase<(K, V), ()>::inspect(Result::Err(_)) => None
            };
            __g1_hash_map_rehash(move remaining, move fresh)
        },
        __ResultCase<
            (Result<(K, V), ()>, VecIntoIter<Result<(K, V), ()>>),
            ()
        >::inspect(Result::Err(_)) => ()
    }
}

__g1_hash_map_initial_capacity() -> usize { 8 }
__g1_hash_map_double_capacity(value: usize) -> usize { value + value }

__g1_hash_map_next_capacity(old_capacity: usize) -> usize {
    handle perform __VecBoolCase::inspect(old_capacity == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_hash_map_initial_capacity(),
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_hash_map_double_capacity(move old_capacity)
    }
}

__g1_hash_map_grow<K, V>(value: &mut HashMap<K, V>) -> ()
    where K: Eq, K: Hash, K: Use<[0,0]>, V: Use<[0,0]> {
    let old_capacity = Vec::len(&value.buckets);
    let new_capacity = __g1_hash_map_next_capacity(old_capacity);
    let fresh = __g1_hash_map_fresh(&*value);
    __g1_hash_map_fill_empty(&mut fresh, move new_capacity);
    let old = replace(&mut value.buckets, Vec::new());
    (*value).length = 0;
    __g1_hash_map_rehash(Vec::into_iter(move old), &mut fresh);
    (*value).buckets = move fresh.buckets;
    (*value).length = fresh.length;
    ()
}

__g1_hash_map_quarter(value: usize) -> usize { move value / 4 }
__g1_hash_map_sub(left: usize, right: usize) -> usize { move left - move right }

__g1_hash_map_should_grow<K, V>(value: &HashMap<K, V>) -> Bool {
    let capacity = Vec::len(&value.buckets);
    handle perform __VecBoolCase::inspect(capacity == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => true,
        __VecBoolCase::inspect(Result::Err(_)) => {
            let quarter = __g1_hash_map_quarter(capacity);
            let threshold = __g1_hash_map_sub(capacity, quarter);
            value.length >= move threshold
        }
    }
}

__g1_hash_map_insert<K, V>(value: &mut HashMap<K, V>, key: K, item: V)
    -> Option<V> where K: Eq, K: Hash, K: Use<[0,0]>,
        V: Use<[0,0]> {
    let should_grow = __g1_hash_map_should_grow(&*value);
    let grew = handle perform __VecBoolCase::inspect(move should_grow) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_hash_map_grow(&mut *value);
            true
        },
        __VecBoolCase::inspect(Result::Err(_)) => false
    };
    grew;
    __g1_hash_map_insert_without_growth(move value, move key, move item)
}

// Removing an occupied bucket creates a hole in the linear-probe chain.  Move
// every following occupied bucket back through ordinary insertion until the
// first genuinely empty bucket; otherwise a lookup could stop at the new hole
// before reaching a colliding key.  `remaining` makes corrupted/full-table
// behavior bounded even though healthy tables always retain an empty bucket.
__g1_hash_map_repair_after_remove<K, V>(
    value: &mut HashMap<K, V>,
    index: usize,
    remaining: usize
) -> () where K: Eq, K: Hash, K: Use<[0,0]>,
        V: Use<[0,0]> {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) => {
            let empty = __g1_hash_map_empty(&*value);
            let bucket = replace(
                __g1_vec_index_mut(&mut value.buckets, index),
                move empty
            );
            handle perform __ResultCase<(K, V), ()>::inspect(move bucket) {
                __ResultCase<(K, V), ()>::inspect(Result::Err(_)) => (),
                __ResultCase<(K, V), ()>::inspect(Result::Ok(pair)) => {
                    (*value).length =
                        __g1_parse_usize_predecessor(value.length);
                    let (key, item) = move pair;
                    // The bucket was just removed from this table, so this
                    // insertion cannot replace a logically equal resident.
                    __g1_hash_map_insert_without_growth(
                        &mut *value,
                        move key,
                        move item
                    );
                    let capacity = Vec::len(&value.buckets);
                    __g1_hash_map_repair_after_remove(
                        move value,
                        __g1_hash_map_next(
                            move index,
                            move capacity
                        ),
                        __g1_parse_usize_predecessor(move remaining)
                    )
                }
            }
        }
    }
}

__g1_hash_map_remove<K, V>(value: &mut HashMap<K, V>, key: &K) -> Option<V>
    where K: Eq, K: Hash, K: Use<[0,0]>,
        V: Use<[0,0]> {
    let capacity = Vec::len(&value.buckets);
    handle perform __VecBoolCase::inspect(capacity == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => None,
        __VecBoolCase::inspect(Result::Err(_)) => {
            let probe = __g1_hash_map_find(&*value, key);
            handle perform __VecBoolCase::inspect(move probe.found) {
                __VecBoolCase::inspect(Result::Err(_)) => None,
                __VecBoolCase::inspect(Result::Ok(_)) => {
                    let empty = __g1_hash_map_empty(&*value);
                    let removed = replace(
                        __g1_vec_index_mut(&mut value.buckets, probe.index),
                        move empty
                    );
                    (*value).length =
                        __g1_parse_usize_predecessor(value.length);
                    __g1_hash_map_repair_after_remove(
                        move value,
                        __g1_hash_map_next(move probe.index, capacity),
                        __g1_parse_usize_predecessor(move capacity)
                    );
                    handle perform __ResultCase<(K, V), ()>::inspect(
                        move removed
                    ) {
                        __ResultCase<(K, V), ()>::inspect(Result::Ok(pair)) => {
                            let (removed_key, removed_value) = move pair;
                            removed_key;
                            Option::Some(move removed_value)
                        },
                        __ResultCase<(K, V), ()>::inspect(Result::Err(_)) =>
                            None
                    }
                }
            }
        }
    }
}

// Borrowed iteration walks physical buckets from low to high.  Hashing and
// growth are deterministic, so a fixed table state has a fixed iteration
// order; externally visible compiler output must still sort explicitly.
struct HashMapIter<'a, K, V> {
    private value: &'a HashMap<K, V>,
    private index: usize
}

struct HashMapKeys<'a, K, V> {
    private value: &'a HashMap<K, V>,
    private index: usize
}

struct HashMapValues<'a, K, V> {
    private value: &'a HashMap<K, V>,
    private index: usize
}

struct HashMapIntoIter<K, V> {
    private buckets: VecIntoIter<Result<(K, V), ()>>
}

impl<K, V> Use<[0,1]> for HashMapIntoIter<K, V>
    where VecIntoIter<Result<(K, V), ()>>: Use<[0,1]>,
        K: Use<[0,0]>, V: Use<[0,0]> {}

__g1_hash_map_next_occupied<K, V>(
    value: &HashMap<K, V>,
    index: usize,
    capacity: usize
) -> usize {
    handle perform __VecBoolCase::inspect(index < capacity) {
        __VecBoolCase::inspect(Result::Err(_)) => move capacity,
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let bucket = __g1_vec_index(&value.buckets, index);
            handle perform __VecBoolCase::inspect(*bucket is Result::Ok(_)) {
                __VecBoolCase::inspect(Result::Ok(_)) => move index,
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_hash_map_next_occupied(
                        value,
                        index + 1,
                        move capacity
                    )
            }
        }
    }
}

__g1_hash_map_iter_bucket<'a, K, V>(
    value: &'a HashMap<K, V>,
    index: usize
) -> Option<((&'a K, &'a V), HashMapIter<'a, K, V>)> {
    let bucket = __g1_vec_index(&value.buckets, index);
    if(*bucket is Result::Ok(_)) {
        Option::Some((
            ((&bucket.0.0), (&bucket.0.1)),
            HashMapIter { value: move value, index: index + 1 }
        ))
    } else {
        None
    }
}

__g1_hash_map_keys_bucket<'a, K, V>(
    value: &'a HashMap<K, V>,
    index: usize
) -> Option<(&'a K, HashMapKeys<'a, K, V>)> {
    let bucket = __g1_vec_index(&value.buckets, index);
    if(*bucket is Result::Ok(_)) {
        Option::Some((
            &bucket.0.0,
            HashMapKeys { value: move value, index: index + 1 }
        ))
    } else {
        None
    }
}

__g1_hash_map_values_bucket<'a, K, V>(
    value: &'a HashMap<K, V>,
    index: usize
) -> Option<(&'a V, HashMapValues<'a, K, V>)> {
    let bucket = __g1_vec_index(&value.buckets, index);
    if(*bucket is Result::Ok(_)) {
        Option::Some((
            &bucket.0.1,
            HashMapValues { value: move value, index: index + 1 }
        ))
    } else {
        None
    }
}

__g1_hash_map_iter<'a, K, V>(value: &'a HashMap<K, V>)
    -> HashMapIter<'a, K, V> {
    HashMapIter { value: move value, index: 0 }
}

__g1_hash_map_keys<'a, K, V>(value: &'a HashMap<K, V>)
    -> HashMapKeys<'a, K, V> {
    HashMapKeys { value: move value, index: 0 }
}

__g1_hash_map_values<'a, K, V>(value: &'a HashMap<K, V>)
    -> HashMapValues<'a, K, V> {
    HashMapValues { value: move value, index: 0 }
}

__g1_hash_map_iter_next<'a, K, V>(iterator: HashMapIter<'a, K, V>)
    -> Option<((&'a K, &'a V), HashMapIter<'a, K, V>)> {
    let HashMapIter { value, index } = move iterator;
    let capacity = Vec::len(&value.buckets);
    let occupied = __g1_hash_map_next_occupied(value, index, capacity);
    handle perform __VecBoolCase::inspect(occupied < capacity) {
        __VecBoolCase::inspect(Result::Err(_)) => { value; None },
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_hash_map_iter_bucket(move value, move occupied)
    }
}

__g1_hash_map_keys_next<'a, K, V>(iterator: HashMapKeys<'a, K, V>)
    -> Option<(&'a K, HashMapKeys<'a, K, V>)> {
    let HashMapKeys { value, index } = move iterator;
    let capacity = Vec::len(&value.buckets);
    let occupied = __g1_hash_map_next_occupied(value, index, capacity);
    handle perform __VecBoolCase::inspect(occupied < capacity) {
        __VecBoolCase::inspect(Result::Err(_)) => { value; None },
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_hash_map_keys_bucket(move value, move occupied)
    }
}

__g1_hash_map_values_next<'a, K, V>(iterator: HashMapValues<'a, K, V>)
    -> Option<(&'a V, HashMapValues<'a, K, V>)> {
    let HashMapValues { value, index } = move iterator;
