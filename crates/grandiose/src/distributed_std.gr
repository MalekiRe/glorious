// Layer 1: manifest-bound immutable Text/Bytes leaves. Their bodies are never
// executed by a compiled program; exact declaration identity lowers each call
// to its frozen bytecode primitive. Checked UTF-8 remains internal until an
// ordinary source validator can prove validity; indexed access and slicing are
// exposed only through the bounds-checking wrappers below.
__g1_text_byte_len(value: Text) -> usize { () }
__g1_text_concat(left: Text, right: Text) -> Text { () }
__g1_text_eq(left: Text, right: Text) -> u32 { () }
__g1_text_from_utf8_checked(value: Bytes) -> Text { () }
__g1_text_as_bytes(value: Text) -> Bytes { () }
__g1_bytes_len(value: Bytes) -> usize { () }
__g1_bytes_concat(left: Bytes, right: Bytes) -> Bytes { () }
__g1_bytes_get(value: Bytes, index: usize) -> u8 { () }
__g1_bytes_slice(value: Bytes, start: usize, end: usize) -> Bytes { () }
__g1_bytes_from_array_move(value: Array<u8>) -> Bytes { () }
__g1_bytes_to_array(value: Bytes) -> Array<u8> { () }

// Manifest-bound Array leaves. Their bodies are never executed by a
// compiled program; exact declaration identity lowers each call to its frozen
// bytecode primitive. User source cannot invoke these leaves directly.
__g1_array_new<T>(length: usize, fill: T) -> Array<T>
    where T: Use<[0,infinity]> { () }
__g1_array_len<T>(value: &Array<T>) -> usize { () }
__g1_array_get_copy<T>(value: &Array<T>, index: usize) -> T
    where T: Use<[0,infinity]> { () }
__g1_array_get_move<T>(value: &mut Array<T>, index: usize) -> T { () }
__g1_array_get_borrow_shared<T>(value: &Array<T>, index: usize) -> &T { () }
__g1_array_get_borrow_unique<T>(value: &mut Array<T>, index: usize) -> &mut T { () }
__g1_array_set_move<T>(value: &mut Array<T>, index: usize, item: T) -> () { () }
__g1_array_empty<T>() -> Array<T> { () }
__g1_array_push_move<T>(value: &mut Array<T>, item: T) -> () { () }
__g1_array_pop_move<T>(value: &mut Array<T>) -> T { () }
__g1_array_capacity<T>(value: &Array<T>) -> usize { () }
__g1_array_reserve<T>(value: &mut Array<T>, additional: usize) -> () { () }
__g1_array_finish_drained<T>(value: Array<T>) -> () { () }

