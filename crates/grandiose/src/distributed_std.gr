    -> usize where K: Eq, K: Hash {
    handle perform __ResultCase<&Vec<V>, ()>::inspect(
        HashMap::get(&value.buckets, move key)
    ) {
        __ResultCase<&Vec<V>, ()>::inspect(Result::Ok(bucket)) => Vec::len(move bucket),
        __ResultCase<&Vec<V>, ()>::inspect(Result::Err(_)) => 0
    }
}

