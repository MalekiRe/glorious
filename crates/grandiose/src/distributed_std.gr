// Exact deterministic decimal rendering for IEEE values.  A finite binary
// value is an integer times a power of two.  For negative powers we multiply
// the significand by the matching power of five and emit a decimal exponent;
// consequently every rendered digit is exact and reparsing is lossless.
__g1_float_decimal_from_u64_step(value: u64, digits: &mut Vec<u8>) -> () {
    handle perform __VecBoolCase::inspect(value == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) => {
            Vec::push(
                &mut *digits,
                wrapping_convert_to_u8(value % 10)
            );
            __g1_float_decimal_from_u64_step(value / 10, move digits)
        }
    }
}

__g1_float_digit_vec() -> Vec<u8> { __g1_vec_new() }

__g1_float_decimal_from_u64(value: u64) -> Vec<u8> {
    let digits = __g1_float_digit_vec();
    Vec::push(
        &mut digits,
        wrapping_convert_to_u8(value % 10)
    );
    __g1_float_decimal_from_u64_step(value / 10, &mut digits);
    move digits
}

__g1_float_decimal_multiply_at(
    digits: &mut Vec<u8>,
    factor: u64,
    cursor: usize,
    length: usize,
    carry: u64
) -> () {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let product =
                wrapping_convert_to_u64(
                    __g1_array_get_copy(&digits.storage, cursor)
                ) * factor
                + carry;
            *__g1_array_get_borrow_unique(&mut digits.storage, cursor) =
                wrapping_convert_to_u8(product % 10);
            __g1_float_decimal_multiply_at(
                move digits,
                move factor,
                cursor + 1,
                move length,
                product / 10
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(carry == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) => (),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    Vec::push(move digits, wrapping_convert_to_u8(move carry))
            }
    }
}

__g1_float_decimal_multiply_power(
    digits: &mut Vec<u8>, factor: u64, remaining: usize
) -> () {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) => {
            let length = Vec::len(&*digits);
            __g1_float_decimal_multiply_at(
                &mut *digits, factor, 0, move length, 0
            );
            __g1_float_decimal_multiply_power(
                move digits, move factor, remaining - 1
            )
        }
    }
}

__g1_float_append_decimal_digit(formatter: &mut Formatter, digit: u8) -> () {
    Formatter::append_char(
        move formatter,
        __g1_char_from_u32_checked(
            wrapping_convert_to_u32(move digit) + 48
        )
    )
}

__g1_float_append_decimal_tail(
    formatter: &mut Formatter, digits: &Vec<u8>, remaining: usize
) -> () {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) => {
            __g1_float_append_decimal_digit(
                &mut *formatter,
                __g1_array_get_copy(&digits.storage, remaining - 1)
            );
            __g1_float_append_decimal_tail(
                move formatter, digits, remaining - 1
            )
        }
    }
}

struct __FloatDecimalScale {
    factor: u64,
    remaining: usize,
    decimal_shift: i64
}

__g1_float_literal(formatter: &mut Formatter, text: String) -> () {
    Formatter::literal(move formatter, &text)
}

__g1_float_append_exact_decimal(
    formatter: &mut Formatter,
    significand: u64,
    binary_exponent: i64
) -> () {
    let digits = __g1_float_decimal_from_u64(move significand);
    let scale = handle perform __VecBoolCase::inspect(
        binary_exponent < 0
    ) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let magnitude = wrapping_neg(binary_exponent);
            __FloatDecimalScale {
                factor: 5,
                remaining: wrapping_convert_to_usize(magnitude),
                decimal_shift: move magnitude
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) => __FloatDecimalScale {
            factor: 2,
            remaining: wrapping_convert_to_usize(binary_exponent),
            decimal_shift: 0
        }
    };
    let __FloatDecimalScale { factor, remaining, decimal_shift } = move scale;
    __g1_float_decimal_multiply_power(
        &mut digits, move factor, move remaining
    );
    let length = Vec::len(&digits);
    __g1_float_append_decimal_digit(
        &mut *formatter,
        __g1_array_get_copy(&digits.storage, length - 1)
    );
    handle perform __VecBoolCase::inspect(length == 1) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_float_literal(&mut *formatter, ".0"),
        __VecBoolCase::inspect(Result::Err(_)) => {
            __g1_float_literal(&mut *formatter, ".");
            __g1_float_append_decimal_tail(
                &mut *formatter, &digits, length - 1
            )
        }
    };
    __g1_float_literal(&mut *formatter, "e");
    Formatter::append_i64(
        move formatter,
        wrapping_convert_to_i64(length - 1) - move decimal_shift
    )
}

__g1_format_f32(formatter: &mut Formatter, value: f32) -> () {
    let bits = f32_to_bits(move value);
    let negative = bit_and(bits, 2147483648) != 0;
    let exponent = shift_right(bit_and(bits, 2139095040), 23);
    let fraction = bit_and(bits, 8388607);
    handle perform __VecBoolCase::inspect(move negative) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_float_literal(&mut *formatter, "-"),
        __VecBoolCase::inspect(Result::Err(_)) => ()
    };
    handle perform __VecBoolCase::inspect(exponent == 255) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            handle perform __VecBoolCase::inspect(fraction == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_float_literal(move formatter, "inf"),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_float_literal(move formatter, "NaN")
            },
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(exponent == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __VecBoolCase::inspect(fraction == 0) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            __g1_float_literal(move formatter, "0.0"),
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            __g1_float_append_exact_decimal(
                                move formatter,
                                wrapping_convert_to_u64(move fraction),
                                -149
                            )
                    },
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_float_append_exact_decimal(
                        move formatter,
                        wrapping_convert_to_u64(bit_or(fraction, 8388608)),
                        wrapping_convert_to_i64(exponent) - 150
                    )
            }
    }
}

__g1_format_f64(formatter: &mut Formatter, value: f64) -> () {
    let bits = f64_to_bits(move value);
    let negative = bit_and(bits, 9223372036854775808) != 0;
    let exponent = shift_right(bit_and(bits, 9218868437227405312), 52);
    let fraction = bit_and(bits, 4503599627370495);
    handle perform __VecBoolCase::inspect(move negative) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_float_literal(&mut *formatter, "-"),
        __VecBoolCase::inspect(Result::Err(_)) => ()
    };
    handle perform __VecBoolCase::inspect(exponent == 2047) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            handle perform __VecBoolCase::inspect(fraction == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_float_literal(move formatter, "inf"),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_float_literal(move formatter, "NaN")
            },
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(exponent == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __VecBoolCase::inspect(fraction == 0) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            __g1_float_literal(move formatter, "0.0"),
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            __g1_float_append_exact_decimal(
                                move formatter, move fraction, -1074
                            )
                    },
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_float_append_exact_decimal(
                        move formatter,
                        bit_or(fraction, 4503599627370496),
                        wrapping_convert_to_i64(exponent) - 1075
                    )
            }
    }
}

effect __FloatFormatFinishCase {
    inspect(value: Result<String, Utf8Error>) -> !;
}

f32_format(value: f32) -> String {
    let formatter = Formatter::new();
    __g1_format_f32(&mut formatter, move value);
    handle perform __FloatFormatFinishCase::inspect(
        Formatter::finish(move formatter)
    ) {
        __FloatFormatFinishCase::inspect(Result::Ok(text)) => move text,
        __FloatFormatFinishCase::inspect(Result::Err(_)) => ""
    }
}

f64_format(value: f64) -> String {
    let formatter = Formatter::new();
    __g1_format_f64(&mut formatter, move value);
    handle perform __FloatFormatFinishCase::inspect(
        Formatter::finish(move formatter)
    ) {
        __FloatFormatFinishCase::inspect(Result::Ok(text)) => move text,
        __FloatFormatFinishCase::inspect(Result::Err(_)) => ""
    }
}

// Exact decimal-to-binary parsing. This deliberately uses an integer rational
// rather than a floating accumulator: the final division retains a remainder,
// so midpoint decisions are made directly at the requested IEEE width.
enum FloatParseError {
    Empty,
    MissingDigits(usize),
    InvalidDigit(usize),
    MisplacedSeparator(usize),
    Overflow(usize)
}

struct __FloatBig { words: ByteBuf }

__g1_float_big_zero() -> __FloatBig {
    __FloatBig { words: __g1_byte_buf_new() }
}

__g1_float_big_word(value: &__FloatBig, index: usize) -> u32 {
    wrapping_convert_to_u32(
        __g1_array_get_copy(&value.words.bytes.storage, index)
    )
}

__g1_float_big_set(value: &mut __FloatBig, index: usize, word: u32) -> () {
    *__g1_array_get_borrow_unique(&mut value.words.bytes.storage, index) =
        wrapping_convert_to_u8(move word);
    ()
}

__g1_float_big_effective_len_from(
    value: &__FloatBig,
    length: usize
) -> usize {
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => 0,
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(
                __g1_float_big_word(value, length - 1) == 0
            ) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_float_big_effective_len_from(value, length - 1),
                __VecBoolCase::inspect(Result::Err(_)) => length
            }
    }
}

__g1_float_big_len(value: &__FloatBig) -> usize {
    __g1_float_big_effective_len_from(value, __g1_byte_buf_len(&value.words))
}

__g1_float_big_is_zero(value: &__FloatBig) -> Bool {
    __g1_float_big_len(value) == 0
}

__g1_float_big_mul_small_step(
    value: &mut __FloatBig,
    multiplier: u32,
    cursor: usize,
    length: usize,
    carry: u64
) -> () {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let product = wrapping_convert_to_u64(
                __g1_float_big_word(&*value, cursor)
            ) * wrapping_convert_to_u64(multiplier) + carry;
            __g1_float_big_set(
                &mut *value, cursor, wrapping_convert_to_u32(product)
            );
            __g1_float_big_mul_small_step(
                move value,
                multiplier,
                cursor + 1,
                length,
                shift_right(product, 8)
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(carry == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) => (),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_byte_buf_push(
                        &mut value.words,
                        wrapping_convert_to_u8(move carry)
                    )
            }
    }
}

__g1_float_big_mul_small(value: &mut __FloatBig, multiplier: u32) -> () {
    let length = __g1_byte_buf_len(&value.words);
    __g1_float_big_mul_small_step(
        move value, move multiplier, 0, move length, 0
    )
}

__g1_float_big_add_small(value: &mut __FloatBig, addend: u32) -> () {
    handle perform __VecBoolCase::inspect(__g1_byte_buf_len(&value.words) == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            handle perform __VecBoolCase::inspect(addend == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) => (),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_byte_buf_push(
                        &mut value.words, wrapping_convert_to_u8(move addend)
                    )
            },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let old = __g1_float_big_word(&*value, 0);
            let sum = wrapping_convert_to_u64(old) + wrapping_convert_to_u64(addend);
            __g1_float_big_set(
                &mut *value, 0, wrapping_convert_to_u32(sum)
            );
            handle perform __VecBoolCase::inspect(shift_right(sum, 8) == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) => (),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_float_big_add_carry(move value, 1)
            }
        }
    }
}

__g1_float_big_add_carry(value: &mut __FloatBig, cursor: usize) -> () {
    let length = __g1_byte_buf_len(&value.words);
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let old = __g1_float_big_word(&*value, cursor);
            let next = old + 1;
            __g1_float_big_set(&mut *value, cursor, next);
            handle perform __VecBoolCase::inspect(next == 256) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_float_big_add_carry(move value, cursor + 1),
                __VecBoolCase::inspect(Result::Err(_)) => ()
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_byte_buf_push(&mut value.words, 1)
    }
}

__g1_float_big_mul_pow10(value: &mut __FloatBig, remaining: usize) -> () {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) => {
            __g1_float_big_mul_small(&mut *value, 10);
            __g1_float_big_mul_pow10(move value, remaining - 1)
        }
    }
}

__g1_float_big_clone_step(
    source: &__FloatBig,
    target: &mut __FloatBig,
    cursor: usize,
    length: usize
) -> () {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_byte_buf_push(
                &mut target.words,
                wrapping_convert_to_u8(__g1_float_big_word(source, cursor))
            );
            __g1_float_big_clone_step(
                source, move target, cursor + 1, length
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_float_big_clone(source: &__FloatBig) -> __FloatBig {
    let target = __g1_float_big_zero();
    __g1_float_big_clone_step(
        source, &mut target, 0, __g1_float_big_len(source)
    );
    move target
}

__g1_float_big_shift_left_one(value: &mut __FloatBig) -> () {
    __g1_float_big_mul_small(move value, 2)
}

__g1_float_big_shift_left(value: &mut __FloatBig, count: usize) -> () {
    handle perform __VecBoolCase::inspect(count == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) => {
            __g1_float_big_shift_left_one(&mut *value);
            __g1_float_big_shift_left(move value, count - 1)
        }
    }
}

__g1_float_u32_bit_len(value: u32, count: usize) -> usize {
    handle perform __VecBoolCase::inspect(value == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => count,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_float_u32_bit_len(shift_right(value, 1), count + 1)
    }
}

__g1_float_big_bit_len(value: &__FloatBig) -> usize {
    let length = __g1_float_big_len(value);
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => 0,
        __VecBoolCase::inspect(Result::Err(_)) =>
            (length - 1) * 8 + __g1_float_u32_bit_len(
                __g1_float_big_word(value, length - 1), 0
            )
    }
}

__g1_float_big_compare_words(
    left: &__FloatBig,
    right: &__FloatBig,
    remaining: usize
) -> i32 {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => 0,
        __VecBoolCase::inspect(Result::Err(_)) => {
            let index = remaining - 1;
            let a = __g1_float_big_word(left, index);
            let b = __g1_float_big_word(right, index);
            handle perform __VecBoolCase::inspect(a < b) {
                __VecBoolCase::inspect(Result::Ok(_)) => -1,
                __VecBoolCase::inspect(Result::Err(_)) =>
                    handle perform __VecBoolCase::inspect(b < a) {
                        __VecBoolCase::inspect(Result::Ok(_)) => 1,
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            __g1_float_big_compare_words(
                                left, right, index
                            )
                    }
            }
        }
    }
}

__g1_float_big_compare(left: &__FloatBig, right: &__FloatBig) -> i32 {
    let a = __g1_float_big_len(left);
    let b = __g1_float_big_len(right);
    handle perform __VecBoolCase::inspect(a < b) {
        __VecBoolCase::inspect(Result::Ok(_)) => -1,
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(b < a) {
                __VecBoolCase::inspect(Result::Ok(_)) => 1,
                __VecBoolCase::inspect(Result::Err(_)) =>
                    __g1_float_big_compare_words(left, right, a)
            }
    }
}

__g1_float_big_sub_step(
    left: &mut __FloatBig,
    right: &__FloatBig,
    cursor: usize,
    length: usize,
    borrow: u64
) -> () {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let a = wrapping_convert_to_u64(
                __g1_float_big_word(&*left, cursor)
            );
            let b = handle perform __VecBoolCase::inspect(
                cursor < __g1_float_big_len(right)
            ) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    wrapping_convert_to_u64(
                        __g1_float_big_word(right, cursor)
                    ),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    wrapping_convert_to_u64(0)
            };
            let subtrahend = b + borrow;
            let next_borrow = handle perform __VecBoolCase::inspect(
                a < subtrahend
            ) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    wrapping_convert_to_u64(1),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    wrapping_convert_to_u64(0)
            };
            __g1_float_big_set(
                &mut *left,
                cursor,
                wrapping_convert_to_u32(wrapping_sub(a, subtrahend))
            );
            __g1_float_big_sub_step(
                move left, right, cursor + 1, length, move next_borrow
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_float_big_sub(left: &mut __FloatBig, right: &__FloatBig) -> () {
    let length = __g1_float_big_len(&*left);
    __g1_float_big_sub_step(
        move left, right, 0, move length, 0
    )
}

__g1_float_big_shift_right_one_step(
    value: &mut __FloatBig,
    remaining: usize,
    carry: u32
) -> () {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) => {
            let index = remaining - 1;
            let word = __g1_float_big_word(&*value, index);
            __g1_float_big_set(
                &mut *value,
                index,
                bit_or(shift_right(word, 1), shift_left(carry, 7))
            );
            __g1_float_big_shift_right_one_step(
                move value, index, bit_and(word, 1)
            )
        }
    }
}

__g1_float_big_shift_right_one(value: &mut __FloatBig) -> () {
    let length = __g1_float_big_len(&*value);
    __g1_float_big_shift_right_one_step(
        move value, move length, 0
    )
}

struct __FloatIntegerEnd {
    magnitude: __FloatBig,
    cursor: usize,
    digit_count: usize
}

struct __FloatFractionEnd {
    magnitude: __FloatBig,
    cursor: usize,
    digit_count: usize,
    fraction_digits: usize
}

struct __FloatParsed {
    magnitude: __FloatBig,
    negative: Bool,
    fraction_digits: usize,
    exponent_negative: Bool,
    exponent: usize,
    end: usize
}

effect __FloatIntegerCase {
    inspect(value: Result<__FloatIntegerEnd, FloatParseError>) -> !;
}
effect __FloatFractionCase {
    inspect(value: Result<__FloatFractionEnd, FloatParseError>) -> !;
}
effect __FloatParsedCase {
    inspect(value: Result<__FloatParsed, FloatParseError>) -> !;
}

__g1_float_push_decimal_digit(
    magnitude: &mut __FloatBig,
    byte: u8
) -> () {
    __g1_float_big_mul_small(&mut *magnitude, 10);
    __g1_float_big_add_small(
        move magnitude,
        wrapping_convert_to_u32(byte) - 48
    )
}

__g1_float_scan_integer(
    bytes: Bytes,
    cursor: usize,
    length: usize,
    magnitude: __FloatBig,
    digits: usize,
    separator: usize,
    after_separator: Bool
) -> Result<__FloatIntegerEnd, FloatParseError> {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle perform __VecBoolCase::inspect(48 <= byte) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __VecBoolCase::inspect(byte <= 57) {
                        __VecBoolCase::inspect(Result::Ok(_)) => {
                            __g1_float_push_decimal_digit(
                                &mut magnitude, move byte
                            );
                            __g1_float_scan_integer(
                                move bytes,
                                cursor + 1,
                                length,
                                move magnitude,
                                digits + 1,
                                separator,
                                false
                            )
                        },
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            __g1_float_finish_integer(
                                move magnitude,
                                cursor,
                                digits,
                                separator,
                                move after_separator
                            )
                    },
                __VecBoolCase::inspect(Result::Err(_)) =>
                    handle perform __VecBoolCase::inspect(byte == 95) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            handle perform __VecBoolCase::inspect(digits == 0) {
                                __VecBoolCase::inspect(Result::Ok(_)) =>
                                    Result::Err(
                                        FloatParseError::MisplacedSeparator(cursor)
                                    ),
                                __VecBoolCase::inspect(Result::Err(_)) =>
                                    __g1_float_scan_integer(
                                        move bytes,
                                        cursor + 1,
                                        length,
                                        move magnitude,
                                        digits,
                                        cursor,
                                        true
                                    )
                            },
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            __g1_float_finish_integer(
                                move magnitude,
                                cursor,
                                digits,
                                separator,
                                move after_separator
                            )
                    }
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_float_finish_integer(
                move magnitude,
                cursor,
                digits,
                separator,
                move after_separator
            )
    }
}

__g1_float_finish_integer(
    magnitude: __FloatBig,
    cursor: usize,
    digits: usize,
    separator: usize,
    after_separator: Bool
) -> Result<__FloatIntegerEnd, FloatParseError> {
    handle perform __VecBoolCase::inspect(digits == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Result::Err(FloatParseError::MissingDigits(move cursor)),
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(move after_separator) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    Result::Err(
                        FloatParseError::MisplacedSeparator(move separator)
                    ),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    Result::Ok(__FloatIntegerEnd {
                        magnitude: move magnitude,
                        cursor: move cursor,
                        digit_count: move digits
                    })
            }
    }
}

__g1_float_scan_fraction(
    bytes: Bytes,
    cursor: usize,
    length: usize,
    magnitude: __FloatBig,
    total_digits: usize,
    fraction_digits: usize,
    separator: usize,
    after_separator: Bool
) -> Result<__FloatFractionEnd, FloatParseError> {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle perform __VecBoolCase::inspect(48 <= byte) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __VecBoolCase::inspect(byte <= 57) {
                        __VecBoolCase::inspect(Result::Ok(_)) => {
                            __g1_float_push_decimal_digit(
                                &mut magnitude, move byte
                            );
                            __g1_float_scan_fraction(
                                move bytes,
                                cursor + 1,
                                length,
                                move magnitude,
                                total_digits + 1,
                                fraction_digits + 1,
                                separator,
                                false
                            )
                        },
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            __g1_float_finish_fraction(
                                move magnitude,
                                cursor,
                                total_digits,
                                fraction_digits,
                                separator,
                                move after_separator
                            )
                    },
                __VecBoolCase::inspect(Result::Err(_)) =>
                    handle perform __VecBoolCase::inspect(byte == 95) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            handle perform __VecBoolCase::inspect(
                                fraction_digits == 0
                            ) {
                                __VecBoolCase::inspect(Result::Ok(_)) =>
                                    Result::Err(
                                        FloatParseError::MisplacedSeparator(cursor)
                                    ),
                                __VecBoolCase::inspect(Result::Err(_)) =>
                                    __g1_float_scan_fraction(
                                        move bytes,
                                        cursor + 1,
                                        length,
                                        move magnitude,
                                        total_digits,
                                        fraction_digits,
                                        cursor,
                                        true
                                    )
                            },
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            __g1_float_finish_fraction(
                                move magnitude,
                                cursor,
                                total_digits,
                                fraction_digits,
                                separator,
                                move after_separator
                            )
                    }
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_float_finish_fraction(
                move magnitude,
                cursor,
                total_digits,
                fraction_digits,
                separator,
                move after_separator
            )
    }
}

__g1_float_finish_fraction(
    magnitude: __FloatBig,
    cursor: usize,
    total_digits: usize,
    fraction_digits: usize,
    separator: usize,
    after_separator: Bool
) -> Result<__FloatFractionEnd, FloatParseError> {
    handle perform __VecBoolCase::inspect(fraction_digits == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Result::Err(FloatParseError::MissingDigits(move cursor)),
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(move after_separator) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    Result::Err(
                        FloatParseError::MisplacedSeparator(move separator)
                    ),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    Result::Ok(__FloatFractionEnd {
                        magnitude: move magnitude,
                        cursor: move cursor,
                        digit_count: move total_digits,
                        fraction_digits: move fraction_digits
                    })
            }
    }
}

struct __FloatExponentScan {
    cursor: usize,
    exponent_magnitude: usize,
    digits: usize,
    separator: usize,
    after_separator: Bool,
    allow_sign: Bool,
    cap: usize,
    value_magnitude: __FloatBig,
    negative: Bool,
    fraction_digits: usize,
    exponent_negative: Bool
}

__g1_float_exponent_push(
    magnitude: usize,
    digit: usize,
    cap: usize
) -> usize {
    handle perform __VecBoolCase::inspect(magnitude < cap) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            magnitude * wrapping_convert_to_usize(10) + digit,
        __VecBoolCase::inspect(Result::Err(_)) => move cap
    }
}

__g1_float_scan_exponent(
    bytes: Bytes,
    length: usize,
    scan: __FloatExponentScan
) -> Result<__FloatParsed, FloatParseError> {
    let __FloatExponentScan {
        cursor,
        exponent_magnitude,
        digits,
        separator,
        after_separator,
        allow_sign,
        cap,
        value_magnitude,
        negative,
        fraction_digits,
        exponent_negative
    } = move scan;
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle perform __VecBoolCase::inspect(48 <= byte) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __VecBoolCase::inspect(byte <= 57) {
                        __VecBoolCase::inspect(Result::Ok(_)) => {
                            let digit = wrapping_convert_to_usize(byte - 48);
                            let next = __g1_float_exponent_push(
                                exponent_magnitude, move digit, cap
                            );
                            __g1_float_scan_exponent(
                                move bytes,
                                length,
                                __FloatExponentScan {
                                    cursor: cursor + 1,
                                    exponent_magnitude: move next,
                                    digits: digits + 1,
                                    separator: move separator,
                                    after_separator: false,
                                    allow_sign: false,
                                    cap: move cap,
                                    value_magnitude: move value_magnitude,
                                    negative: move negative,
                                    fraction_digits: move fraction_digits,
                                    exponent_negative: move exponent_negative
                                }
                            )
                        },
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            {
                                value_magnitude;
                                Result::Err(FloatParseError::InvalidDigit(cursor))
                            }
                    },
                __VecBoolCase::inspect(Result::Err(_)) =>
                    handle perform __VecBoolCase::inspect(byte == 43) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            handle perform __VecBoolCase::inspect(move allow_sign) {
                                __VecBoolCase::inspect(Result::Ok(_)) =>
                                    __g1_float_scan_exponent(
                                        move bytes,
                                        length,
                                        __FloatExponentScan {
                                            cursor: cursor + 1,
                                            exponent_magnitude: move exponent_magnitude,
                                            digits: move digits,
                                            separator: move separator,
                                            after_separator: false,
                                            allow_sign: false,
                                            cap: move cap,
                                            value_magnitude: move value_magnitude,
                                            negative: move negative,
                                            fraction_digits: move fraction_digits,
                                            exponent_negative: false
                                        }
                                    ),
                                __VecBoolCase::inspect(Result::Err(_)) => {
                                    value_magnitude;
                                    Result::Err(FloatParseError::InvalidDigit(cursor))
                                }
                            },
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            handle perform __VecBoolCase::inspect(byte == 45) {
                                __VecBoolCase::inspect(Result::Ok(_)) =>
                                    handle perform __VecBoolCase::inspect(move allow_sign) {
                                        __VecBoolCase::inspect(Result::Ok(_)) =>
                                            __g1_float_scan_exponent(
                                                move bytes,
                                                length,
                                                __FloatExponentScan {
                                                    cursor: cursor + 1,
                                                    exponent_magnitude: move exponent_magnitude,
                                                    digits: move digits,
                                                    separator: move separator,
                                                    after_separator: false,
                                                    allow_sign: false,
                                                    cap: move cap,
                                                    value_magnitude: move value_magnitude,
                                                    negative: move negative,
                                                    fraction_digits: move fraction_digits,
                                                    exponent_negative: true
                                                }
                                            ),
                                        __VecBoolCase::inspect(Result::Err(_)) => {
                                            value_magnitude;
                                            Result::Err(FloatParseError::InvalidDigit(cursor))
                                        }
                                    },
                                __VecBoolCase::inspect(Result::Err(_)) =>
                                    handle perform __VecBoolCase::inspect(byte == 95) {
                                        __VecBoolCase::inspect(Result::Ok(_)) =>
                                            __g1_float_scan_exponent(
                                                move bytes,
                                                length,
                                                __FloatExponentScan {
                                                    cursor: cursor + 1,
                                                    exponent_magnitude: move exponent_magnitude,
                                                    digits: move digits,
                                                    separator: move cursor,
                                                    after_separator: true,
                                                    allow_sign: false,
                                                    cap: move cap,
                                                    value_magnitude: move value_magnitude,
                                                    negative: move negative,
                                                    fraction_digits: move fraction_digits,
                                                    exponent_negative: move exponent_negative
                                                }
                                            ),
                                        __VecBoolCase::inspect(Result::Err(_)) => {
                                            value_magnitude;
                                            Result::Err(FloatParseError::InvalidDigit(cursor))
                                        }
                                    }
                            }
                    }
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(move after_separator) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    {
                        value_magnitude;
                        Result::Err(
                            FloatParseError::MisplacedSeparator(separator)
                        )
                    },
                __VecBoolCase::inspect(Result::Err(_)) =>
                    handle perform __VecBoolCase::inspect(digits == 0) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            {
                                value_magnitude;
                                Result::Err(FloatParseError::MissingDigits(cursor))
                            },
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            Result::Ok(__FloatParsed {
                                magnitude: move value_magnitude,
                                negative: move negative,
                                fraction_digits: move fraction_digits,
                                exponent_negative: move exponent_negative,
                                exponent: move exponent_magnitude,
                                end: move cursor
                            })
                    }
            }
    }
}

__g1_float_exponent_initial_state(
    length: usize,
    magnitude: __FloatBig,
    negative: Bool,
    fraction_digits: usize,
    marker: usize
) -> __FloatExponentScan {
    __FloatExponentScan {
        cursor: marker + 1,
        exponent_magnitude: 0,
        digits: 0,
        separator: marker + 1,
        after_separator: false,
        allow_sign: true,
        cap: length + 5000,
        value_magnitude: move magnitude,
        negative: move negative,
        fraction_digits: move fraction_digits,
        exponent_negative: false
    }
}

// Packs `2 * cursor + negative`; keeping this copy-only scan in one call also
// leaves the owned decimal magnitude wholly in the caller until conversion.
__g1_float_exponent_start(
    bytes: Bytes,
    cursor: usize,
    length: usize
) -> usize {
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle perform __VecBoolCase::inspect(byte == 43) {
                __VecBoolCase::inspect(Result::Ok(_)) => (cursor + 1) * 2,
                __VecBoolCase::inspect(Result::Err(_)) =>
                    handle perform __VecBoolCase::inspect(byte == 45) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            (cursor + 1) * 2 + 1,
                        __VecBoolCase::inspect(Result::Err(_)) => cursor * 2
                    }
            }
        },
        __VecBoolCase::inspect(Result::Err(_)) => cursor * 2
    }
}

__g1_float_finish_components(
    bytes: Bytes,
    length: usize,
    magnitude: __FloatBig,
    negative: Bool,
    fraction_digits: usize,
    cursor: usize
) -> Result<__FloatParsed, FloatParseError> {
    handle perform __VecBoolCase::inspect(cursor == length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Result::Ok(__FloatParsed {
                magnitude: move magnitude,
                negative: move negative,
                fraction_digits: move fraction_digits,
                exponent_negative: false,
                exponent: 0,
                end: move cursor
            }),
        __VecBoolCase::inspect(Result::Err(_)) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle perform __VecBoolCase::inspect(byte == 101) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_float_scan_exponent(
                        move bytes,
                        length,
                        __g1_float_exponent_initial_state(
                            length,
                            move magnitude,
                            move negative,
                            move fraction_digits,
                            cursor
                        )
                    ),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    handle perform __VecBoolCase::inspect(byte == 69) {
                        __VecBoolCase::inspect(Result::Ok(_)) =>
                            __g1_float_scan_exponent(
                                move bytes,
                                length,
                                __g1_float_exponent_initial_state(
                                    length,
                                    move magnitude,
                                    move negative,
                                    move fraction_digits,
                                    cursor
                                )
                            ),
                        __VecBoolCase::inspect(Result::Err(_)) =>
                            Result::Err(
                                FloatParseError::InvalidDigit(move cursor)
                            )
                    }
            }
        }
    }
}

__g1_float_parse_fraction_from(
    bytes: Bytes,
    length: usize,
    integer: __FloatIntegerEnd,
    negative: Bool
) -> Result<__FloatParsed, FloatParseError> {
    let __FloatIntegerEnd {
        magnitude,
        cursor: dot,
        digit_count
    } = move integer;
    handle perform __FloatFractionCase::inspect(
        __g1_float_scan_fraction(
            move bytes,
            dot + 1,
            length,
            move magnitude,
            digit_count,
            0,
            dot + 1,
            false
        )
    ) {
        __FloatFractionCase::inspect(Result::Ok(fraction)) => {
            let __FloatFractionEnd {
                magnitude: combined,
                cursor,
                digit_count: _,
                fraction_digits
            } = move fraction;
            __g1_float_finish_components(
                move bytes,
                length,
                move combined,
                move negative,
                move fraction_digits,
                move cursor
            )
        },
        __FloatFractionCase::inspect(Result::Err(error)) =>
            Result::Err(move error)
    }
}

__g1_float_finish_integer_component(
    bytes: Bytes,
    length: usize,
    integer: __FloatIntegerEnd,
    negative: Bool
) -> Result<__FloatParsed, FloatParseError> {
    let cursor = integer.cursor;
    handle perform __VecBoolCase::inspect(cursor < length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            handle perform __VecBoolCase::inspect(
                __g1_bytes_get(bytes, cursor) == 46
            ) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    __g1_float_parse_fraction_from(
                        move bytes, length, move integer, move negative
                    ),
                __VecBoolCase::inspect(Result::Err(_)) => {
                    let __FloatIntegerEnd {
                        magnitude,
                        cursor: end,
                        digit_count: _
                    } = move integer;
                    __g1_float_finish_components(
                        move bytes,
                        length,
                        move magnitude,
                        move negative,
                        0,
                        move end
                    )
                }
            },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let __FloatIntegerEnd {
                magnitude,
                cursor: end,
                digit_count: _
            } = move integer;
            __g1_float_finish_components(
                move bytes,
                length,
                move magnitude,
                move negative,
                0,
                move end
            )
        }
    }
}

__g1_float_parse_syntax(value: &String) -> Result<__FloatParsed, FloatParseError> {
    let bytes = String::as_bytes(value);
    let length = Bytes::len(&bytes);
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Result::Err(FloatParseError::Empty),
        __VecBoolCase::inspect(Result::Err(_)) => {
            let first = __g1_bytes_get(bytes, 0);
            let negative = first == 45;
            let signed = handle perform __VecBoolCase::inspect(first == 43) {
                __VecBoolCase::inspect(Result::Ok(_)) => true,
                __VecBoolCase::inspect(Result::Err(_)) => move negative
            };
            let start = handle perform __VecBoolCase::inspect(move signed) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    wrapping_convert_to_usize(1),
                __VecBoolCase::inspect(Result::Err(_)) =>
                    wrapping_convert_to_usize(0)
            };
            handle perform __FloatIntegerCase::inspect(
                __g1_float_scan_integer(
                    move bytes,
                    start,
                    length,
                    __g1_float_big_zero(),
                    0,
                    start,
                    false
                )
            ) {
                __FloatIntegerCase::inspect(Result::Ok(integer)) =>
                    __g1_float_finish_integer_component(
                        move bytes,
                        length,
                        move integer,
                        move negative
                    ),
                __FloatIntegerCase::inspect(Result::Err(error)) =>
                    Result::Err(move error)
            }
        }
    }
}

struct __FloatRatio {
    numerator: __FloatBig,
    denominator: __FloatBig,
    negative: Bool,
    end: usize
}

__g1_float_numerator_decimal_power(
    fraction_digits: usize,
    exponent_negative: Bool,
    exponent: usize
) -> usize {
    handle perform __VecBoolCase::inspect(move exponent_negative) {
        __VecBoolCase::inspect(Result::Ok(_)) => 0,
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(fraction_digits <= exponent) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    exponent - fraction_digits,
                __VecBoolCase::inspect(Result::Err(_)) => 0
            }
    }
}

__g1_float_denominator_decimal_power(
    fraction_digits: usize,
    exponent_negative: Bool,
    exponent: usize
) -> usize {
    handle perform __VecBoolCase::inspect(move exponent_negative) {
        __VecBoolCase::inspect(Result::Ok(_)) => fraction_digits + exponent,
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(exponent < fraction_digits) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    fraction_digits - exponent,
                __VecBoolCase::inspect(Result::Err(_)) => 0
            }
    }
}

__g1_float_ratio(parsed: __FloatParsed) -> __FloatRatio {
    let __FloatParsed {
        magnitude,
        negative,
        fraction_digits,
        exponent_negative,
        exponent,
        end
    } = move parsed;
    let numerator = move magnitude;
    let denominator = __g1_float_big_zero();
    __g1_float_big_add_small(&mut denominator, 1);
    let numerator_power = __g1_float_numerator_decimal_power(
        fraction_digits, exponent_negative, exponent
    );
    let denominator_power = __g1_float_denominator_decimal_power(
        fraction_digits, exponent_negative, exponent
    );
    __g1_float_big_mul_pow10(&mut numerator, move numerator_power);
    __g1_float_big_mul_pow10(&mut denominator, move denominator_power);
    __FloatRatio {
        numerator: move numerator,
        denominator: move denominator,
        negative: move negative,
        end: move end
    }
}

__g1_float_compare_ratio_power(
    numerator: &__FloatBig,
    denominator: &__FloatBig,
    exponent: i64
) -> i32 {
    handle perform __VecBoolCase::inspect(exponent < 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let shifted = __g1_float_big_clone(numerator);
            __g1_float_big_shift_left(
                &mut shifted, wrapping_convert_to_usize(0 - exponent)
            );
            __g1_float_big_compare(&shifted, denominator)
        },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let shifted = __g1_float_big_clone(denominator);
            __g1_float_big_shift_left(
                &mut shifted, wrapping_convert_to_usize(exponent)
            );
            __g1_float_big_compare(numerator, &shifted)
        }
    }
}

__g1_float_floor_binary_exponent(
    numerator: &__FloatBig,
    denominator: &__FloatBig
) -> i64 {
    let nbits = __g1_float_big_bit_len(numerator);
    let dbits = __g1_float_big_bit_len(denominator);
    let candidate = handle perform __VecBoolCase::inspect(dbits <= nbits) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            wrapping_convert_to_i64(nbits - dbits),
        __VecBoolCase::inspect(Result::Err(_)) =>
            0 - wrapping_convert_to_i64(dbits - nbits)
    };
    handle perform __VecBoolCase::inspect(
        __g1_float_compare_ratio_power(
            numerator, denominator, candidate
        ) < 0
    ) {
        __VecBoolCase::inspect(Result::Ok(_)) => candidate - 1,
        __VecBoolCase::inspect(Result::Err(_)) => move candidate
    }
}

struct __FloatDivision {
    quotient: u64,
    remainder: __FloatBig
}

effect __FloatBigBranch {
    inspect(value: Result<__FloatBig, __FloatBig>) -> !;
}

__g1_float_big_branch(
    value: __FloatBig,
    select_ok: Bool
) -> Result<__FloatBig, __FloatBig> {
    handle perform __VecBoolCase::inspect(move select_ok) {
        __VecBoolCase::inspect(Result::Ok(_)) => Result::Ok(move value),
        __VecBoolCase::inspect(Result::Err(_)) => Result::Err(move value)
    }
}

__g1_float_divide_bits_step(
    remainder: __FloatBig,
    divisor: __FloatBig,
    remaining: usize,
    quotient: u64
) -> __FloatDivision {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => __FloatDivision {
            quotient: move quotient,
            remainder: move remainder
        },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let bit = remaining - 1;
            let smaller = __g1_float_big_compare(&remainder, &divisor) < 0;
            handle perform __FloatBigBranch::inspect(
                __g1_float_big_branch(move remainder, move smaller)
            ) {
                __FloatBigBranch::inspect(Result::Ok(unchanged)) => {
                    __g1_float_big_shift_right_one(&mut divisor);
                    __g1_float_divide_bits_step(
                        move unchanged,
                        move divisor,
                        bit,
                        move quotient
                    )
                },
                __FloatBigBranch::inspect(Result::Err(reduced)) => {
                    __g1_float_big_sub(&mut reduced, &divisor);
                    let next_quotient = bit_or(
                        move quotient,
                        shift_left(1, wrapping_convert_to_u32(bit))
                    );
                    __g1_float_big_shift_right_one(&mut divisor);
                    __g1_float_divide_bits_step(
                        move reduced,
                        move divisor,
                        bit,
                        move next_quotient
                    )
                }
            }
        }
    }
}

__g1_float_divide_bits(
    numerator: __FloatBig,
    denominator: &__FloatBig
) -> __FloatDivision {
    let smaller = __g1_float_big_compare(&numerator, denominator) < 0;
    handle perform __FloatBigBranch::inspect(
        __g1_float_big_branch(move numerator, move smaller)
    ) {
        __FloatBigBranch::inspect(Result::Ok(remainder)) => __FloatDivision {
            quotient: 0,
            remainder: move remainder
        },
        __FloatBigBranch::inspect(Result::Err(remainder)) => {
            let shift = __g1_float_big_bit_len(&remainder)
                - __g1_float_big_bit_len(denominator);
            let divisor = __g1_float_big_clone(denominator);
            __g1_float_big_shift_left(&mut divisor, shift);
            __g1_float_divide_bits_step(
                move remainder, move divisor, shift + 1, 0
            )
        }
    }
}

__g1_float_scaled_division(
    numerator: &__FloatBig,
    denominator: &__FloatBig,
    shift: i64
) -> (__FloatDivision, __FloatBig) {
    handle perform __VecBoolCase::inspect(shift < 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let scaled_denominator = __g1_float_big_clone(denominator);
            __g1_float_big_shift_left(
                &mut scaled_denominator,
                wrapping_convert_to_usize(0 - shift)
            );
            (
                __g1_float_divide_bits(
                    __g1_float_big_clone(numerator), &scaled_denominator
                ),
                move scaled_denominator
            )
        },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let scaled_numerator = __g1_float_big_clone(numerator);
            __g1_float_big_shift_left(
                &mut scaled_numerator,
                wrapping_convert_to_usize(shift)
            );
            (
                __g1_float_divide_bits(
                    move scaled_numerator, denominator
                ),
                __g1_float_big_clone(denominator)
            )
        }
    }
}

__g1_float_round_division(
    division: __FloatDivision,
    denominator: &__FloatBig
) -> u64 {
    let __FloatDivision { quotient, remainder } = move division;
    __g1_float_big_shift_left_one(&mut remainder);
    let comparison = __g1_float_big_compare(&remainder, denominator);
    handle perform __VecBoolCase::inspect(comparison < 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => move quotient,
        __VecBoolCase::inspect(Result::Err(_)) =>
            handle perform __VecBoolCase::inspect(comparison == 0) {
                __VecBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __VecBoolCase::inspect(
                        bit_and(quotient, 1) == 0
                    ) {
                        __VecBoolCase::inspect(Result::Ok(_)) => move quotient,
                        __VecBoolCase::inspect(Result::Err(_)) => quotient + 1
                    },
                __VecBoolCase::inspect(Result::Err(_)) => quotient + 1
            }
    }
}

__g1_float_encode_nonzero(
    ratio: __FloatRatio,
    precision: usize,
