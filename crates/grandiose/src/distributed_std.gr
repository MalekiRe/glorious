// Checked compiler-facing integer parsing. Explicit-radix separators occur
// only between digits; source-prefixed forms additionally accept separators
// immediately after the prefix, matching the lexer. All indexing is checked,
// and overflow is rejected before multiplication or addition can wrap.
enum IntParseError {
    Empty,
    InvalidBase,
    InvalidDigit(usize),
    Overflow(usize)
}
enum __ParsedDigit { Value(u32), Invalid }
effect __ParsedDigitCase { inspect(value: __ParsedDigit) -> !; }

__g1_parse_u32_sub(left: u32, right: u32) -> u32 { move left - move right }
__g1_parse_usize_predecessor(value: usize) -> usize { move value - 1 }

__g1_parse_digit(byte: u8) -> __ParsedDigit {
    handle perform __BytesBoolCase::inspect(48 <= byte) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(byte <= 57) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __ParsedDigit::Value(
                        __g1_parse_u32_sub(wrapping_convert_to_u32(byte), 48)
                    ),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    handle perform __BytesBoolCase::inspect(65 <= byte) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            handle perform __BytesBoolCase::inspect(byte <= 90) {
                                __BytesBoolCase::inspect(Result::Ok(_)) =>
                                    __ParsedDigit::Value(
                                        __g1_parse_u32_sub(
                                            wrapping_convert_to_u32(byte),
                                            55
                                        )
                                    ),
                                __BytesBoolCase::inspect(Result::Err(_)) =>
                                    __g1_parse_lower_digit(move byte)
                            },
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            __g1_parse_lower_digit(move byte)
                    }
            },
        __BytesBoolCase::inspect(Result::Err(_)) => __ParsedDigit::Invalid
    }
}

__g1_parse_lower_digit(byte: u8) -> __ParsedDigit {
    handle perform __BytesBoolCase::inspect(97 <= byte) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(byte <= 122) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __ParsedDigit::Value(
                        __g1_parse_u32_sub(wrapping_convert_to_u32(byte), 87)
                    ),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __ParsedDigit::Invalid
            },
        __BytesBoolCase::inspect(Result::Err(_)) => __ParsedDigit::Invalid
    }
}

__g1_parse_u64_zero() -> u64 { 0 }
__g1_parse_u64_max() -> u64 { bit_not(__g1_parse_u64_zero()) }
__g1_parse_u64_sub(left: u64, right: u64) -> u64 { move left - move right }
__g1_parse_u64_mul(left: u64, right: u64) -> u64 { move left * move right }

__g1_parse_u64_push(accumulator: u64, base: u32, digit: u32) -> Option<u64> {
    let wide_base = wrapping_convert_to_u64(base);
    let wide_digit = wrapping_convert_to_u64(digit);
    let threshold = __g1_u64_div(
        __g1_parse_u64_sub(__g1_parse_u64_max(), wide_digit),
        wide_base
    );
    handle perform __BytesBoolCase::inspect(accumulator <= threshold) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            Option::Some(__g1_u64_add(
                __g1_parse_u64_mul(move accumulator, move wide_base),
                move wide_digit
            )),
        __BytesBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_parse_u64_digit(
    bytes: Bytes,
    base: u32,
    cursor: usize,
    length: usize,
    accumulator: u64,
    digit: u32
) -> Result<u64, IntParseError> {
    handle perform __BytesBoolCase::inspect(digit < base) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __ResultCase<u64, ()>::inspect(
                __g1_parse_u64_push(accumulator, base, digit)
            ) {
                __ResultCase<u64, ()>::inspect(Result::Ok(next)) =>
                    __g1_parse_u64_step(
                        move bytes,
                        base,
                        __g1_usize_successor(move cursor),
                        length,
                        move next
                    ),
                __ResultCase<u64, ()>::inspect(Result::Err(_)) =>
                    Result::Err(IntParseError::Overflow(move cursor))
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(IntParseError::InvalidDigit(move cursor))
    }
}

__g1_parse_separator(
    bytes: Bytes,
    base: u32,
    cursor: usize,
    length: usize,
    accumulator: u64
) -> Result<u64, IntParseError> {
    let next = __g1_usize_successor(cursor);
    handle perform __BytesBoolCase::inspect(next < length) {
        __BytesBoolCase::inspect(Result::Ok(_)) => {
            let parsed = __g1_parse_digit(__g1_bytes_get(bytes, next));
            handle perform __ParsedDigitCase::inspect(move parsed) {
                __ParsedDigitCase::inspect(__ParsedDigit::Value(digit)) =>
                    handle perform __BytesBoolCase::inspect(digit < base) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            __g1_parse_u64_step(
                                move bytes,
                                base,
                                move next,
                                length,
                                move accumulator
                            ),
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            Result::Err(IntParseError::InvalidDigit(cursor))
                    },
                __ParsedDigitCase::inspect(__ParsedDigit::Invalid) =>
                    Result::Err(IntParseError::InvalidDigit(move cursor))
            }
        },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(IntParseError::InvalidDigit(move cursor))
    }
}

__g1_parse_u64_step(
    bytes: Bytes,
    base: u32,
    cursor: usize,
    length: usize,
    accumulator: u64
) -> Result<u64, IntParseError> {
    handle perform __BytesBoolCase::inspect(cursor < length) {
        __BytesBoolCase::inspect(Result::Ok(_)) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle perform __BytesBoolCase::inspect(byte == 95) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __BytesBoolCase::inspect(cursor == 0) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            Result::Err(IntParseError::InvalidDigit(cursor)),
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            __g1_parse_separator(
                                move bytes,
                                base,
                                cursor,
                                length,
                                move accumulator
                            )
                    },
                __BytesBoolCase::inspect(Result::Err(_)) => {
                    let parsed = __g1_parse_digit(move byte);
                    handle perform __ParsedDigitCase::inspect(move parsed) {
                        __ParsedDigitCase::inspect(__ParsedDigit::Value(digit)) =>
                            __g1_parse_u64_digit(
                                move bytes,
                                base,
                                cursor,
                                length,
                                move accumulator,
                                move digit
                            ),
                        __ParsedDigitCase::inspect(__ParsedDigit::Invalid) =>
                            Result::Err(IntParseError::InvalidDigit(move cursor))
                    }
                }
            }
        },
        __BytesBoolCase::inspect(Result::Err(_)) => Result::Ok(move accumulator)
    }
}

parse_u64_radix(value: &String, base: u32) -> Result<u64, IntParseError> {
    handle perform __BytesBoolCase::inspect(2 <= base) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(base <= 36) {
                __BytesBoolCase::inspect(Result::Ok(_)) => {
                    let bytes = String::as_bytes(value);
                    let length = Bytes::len(&bytes);
                    handle perform __BytesBoolCase::inspect(length == 0) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            Result::Err(IntParseError::Empty),
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            __g1_parse_u64_step(
                                move bytes,
                                base,
                                0,
                                length,
                                __g1_parse_u64_zero()
                            )
                    }
                },
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    Result::Err(IntParseError::InvalidBase)
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(IntParseError::InvalidBase)
    }
}

__g1_parse_u64_unprefixed(
    bytes: Bytes,
    base: u32,
    start: usize,
    length: usize
) -> Result<u64, IntParseError> {
    handle perform __BytesBoolCase::inspect(start < length) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(
                __g1_bytes_get(bytes, start) == 95
            ) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    Result::Err(IntParseError::InvalidDigit(move start)),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_parse_u64_step(
                        move bytes,
                        move base,
                        move start,
                        move length,
                        __g1_parse_u64_zero()
                    )
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(IntParseError::Empty)
    }
}

// Source-prefixed integers permit separators immediately after the prefix,
// matching the lexer grammar (`0x_ff` and `0x__ff`). At least one actual digit
// is still required.
__g1_parse_u64_prefixed(
    bytes: Bytes,
    base: u32,
    cursor: usize,
    length: usize
) -> Result<u64, IntParseError> {
    handle perform __BytesBoolCase::inspect(cursor < length) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(
                __g1_bytes_get(bytes, cursor) == 95
            ) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __g1_parse_u64_prefixed(
                        move bytes,
                        move base,
                        __g1_usize_successor(move cursor),
                        move length
                    ),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_parse_u64_step(
                        move bytes,
                        move base,
                        move cursor,
                        move length,
                        __g1_parse_u64_zero()
                    )
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(IntParseError::Empty)
    }
}

__g1_parse_u64_source_prefix(
    bytes: Bytes,
    marker: u8,
    offset: usize,
    length: usize
) -> Result<u64, IntParseError> {
    handle perform __BytesBoolCase::inspect(marker == 98) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            __g1_parse_u64_prefixed(
                move bytes,
                2,
                __g1_usize_add(offset, 2),
                move length
            ),
        __BytesBoolCase::inspect(Result::Err(_)) =>
            handle perform __BytesBoolCase::inspect(marker == 111) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __g1_parse_u64_prefixed(
                        move bytes,
                        8,
                        __g1_usize_add(offset, 2),
                        move length
                    ),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    handle perform __BytesBoolCase::inspect(marker == 120) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            __g1_parse_u64_prefixed(
                                move bytes,
                                16,
                                __g1_usize_add(offset, 2),
                                move length
                            ),
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            __g1_parse_u64_unprefixed(
                                move bytes,
                                10,
                                move offset,
                                move length
                            )
                    }
            }
    }
}

__g1_parse_u64_source_from(
    bytes: Bytes,
    offset: usize,
    length: usize
) -> Result<u64, IntParseError> {
    handle perform __BytesBoolCase::inspect(offset < length) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(
                __g1_usize_successor(offset) < length
            ) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __BytesBoolCase::inspect(
                        __g1_bytes_get(bytes, offset) == 48
                    ) {
                        __BytesBoolCase::inspect(Result::Ok(_)) => {
                            let marker = __g1_bytes_get(
                                bytes,
                                __g1_usize_successor(offset)
                            );
                            __g1_parse_u64_source_prefix(
                                move bytes,
                                move marker,
                                move offset,
                                move length
                            )
                        },
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            __g1_parse_u64_unprefixed(
                                move bytes,
                                10,
                                move offset,
                                move length
                            )
                    },
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_parse_u64_unprefixed(
                        move bytes,
                        10,
                        move offset,
                        move length
                    )
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(IntParseError::Empty)
    }
}

parse_u64(value: &String) -> Result<u64, IntParseError> {
    let bytes = String::as_bytes(value);
    let length = Bytes::len(&bytes);
    __g1_parse_u64_source_from(move bytes, 0, move length)
}

__g1_parse_i64_max_magnitude() -> u64 {
    shift_right(__g1_parse_u64_max(), 1)
}

__g1_parse_i64_negative_limit() -> u64 {
    __g1_u64_add(__g1_parse_i64_max_magnitude(), 1)
}

__g1_parse_i64_negate(value: i64) -> i64 { 0 - move value }

__g1_parse_i64_negative_value(
    magnitude: u64,
    overflow_at: usize
) -> Result<i64, IntParseError> {
    let limit = __g1_parse_i64_negative_limit();
    handle perform __BytesBoolCase::inspect(magnitude <= limit) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(magnitude == limit) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    Result::Ok(wrapping_convert_to_i64(move magnitude)),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    Result::Ok(__g1_parse_i64_negate(
                        wrapping_convert_to_i64(move magnitude)
                    ))
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(IntParseError::Overflow(move overflow_at))
    }
}

__g1_parse_i64_positive_value(
    magnitude: u64,
    overflow_at: usize
) -> Result<i64, IntParseError> {
    handle perform __BytesBoolCase::inspect(
        magnitude <= __g1_parse_i64_max_magnitude()
    ) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            Result::Ok(wrapping_convert_to_i64(move magnitude)),
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(IntParseError::Overflow(move overflow_at))
    }
}

__g1_parse_i64_finish(
    parsed: Result<u64, IntParseError>,
    negative: Bool,
    overflow_at: usize
) -> Result<i64, IntParseError> {
    handle perform __ResultCase<u64, IntParseError>::inspect(move parsed) {
        __ResultCase<u64, IntParseError>::inspect(Result::Ok(magnitude)) =>
            handle perform __BytesBoolCase::inspect(move negative) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __g1_parse_i64_negative_value(
                        move magnitude,
                        move overflow_at
                    ),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_parse_i64_positive_value(
                        move magnitude,
                        move overflow_at
                    )
            },
        __ResultCase<u64, IntParseError>::inspect(Result::Err(error)) =>
            Result::Err(move error)
    }
}

parse_i64(value: &String) -> Result<i64, IntParseError> {
    let bytes = String::as_bytes(value);
    let length = Bytes::len(&bytes);
    handle perform __BytesBoolCase::inspect(length == 0) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            Result::Err(IntParseError::Empty),
        __BytesBoolCase::inspect(Result::Err(_)) => {
            let last = __g1_parse_usize_predecessor(length);
            handle perform __BytesBoolCase::inspect(
                __g1_bytes_get(bytes, 0) == 45
            ) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __g1_parse_i64_finish(
                        __g1_parse_u64_source_from(
                            move bytes,
                            1,
                            length
                        ),
                        true,
                        move last
                    ),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_parse_i64_finish(
                        __g1_parse_u64_source_from(
                            move bytes,
                            0,
                            length
                        ),
                        false,
                        move last
                    )
            }
        }
    }
}

// Layer 3: the public dense collection is an ordinary private-field wrapper.
// Every public return boundary preserves Array's initialized-prefix invariant;
// the drained-shell leaf deliberately has no public Vec alias.
struct Vec<T> { private storage: Array<T> }

// A shared slice is a checked, non-owning window into Vec's dense Array.
// All representation fields are private: only this defining source segment
// can establish the start/length invariant or recover the backing Array.
struct Slice<'a, T> {
    private base: &'a Array<T>,
    private start: usize,
    private length: usize
}

// Shared iteration threads its checked cursor through an owned state value.
// `next` yields a relative index rather than a reference so its result carries
// only the iterator's one backing reference; callers retain the duplicable
// Slice and obtain the element through Slice::get.
struct SliceIter<'a, T> {
    private base: &'a Array<T>,
    private start: usize,
    private length: usize,
    private index: usize
}

// By-value iteration owns every element not yet yielded. The backing Array is
// private so only `next` can move an element out or finish the drained shell.
struct VecIntoIter<T> { private remaining: Vec<T> }

// Iterator state is affine only when abandoning its resident elements is
// legal. It is never duplicable because that would duplicate the Array owner.
impl<T> Use<[0,1]> for VecIntoIter<T>
    where Vec<T>: Use<[0,1]>, T: Use<[0,0]> {}

enum __VecDequeSlot<T> { Empty, Full(T) }

impl<T> Use<[0,1]> for __VecDequeSlot<T> where T: Use<[0,1]> {}

// Every slot below `slots.len` is initialized. `head` is zero when capacity is
// zero and otherwise remains in range; `length <= capacity`.
struct VecDeque<T> {
    private slots: Vec<__VecDequeSlot<T>>,
    private head: usize,
    private length: usize
}

impl<T> Use<[0,1]> for VecDeque<T>
    where Vec<__VecDequeSlot<T>>: Use<[0,1]>, T: Use<[0,0]> {}

// Mutable views carry the unique Array loan itself and are therefore linear:
// they cannot be copied or forged outside this authority domain.
struct SliceMut<'a, T> {
    private base: &'a mut Array<T>,
    private start: usize,
    private length: usize
}

// Vec's checked operations guard the frozen trapping Array leaves in ordinary
// source. `true` is Result::Ok and `false` is Result::Err in the public Bool
// encoding, so the terminal handler selects exactly one access path.
effect __VecBoolCase { inspect(value: Bool) -> !; }
effect __VecDequeSlotCase<T> { inspect(value: __VecDequeSlot<T>) -> !; }

__g1_vec_new<T>() -> Vec<T> {
    Vec { storage: __g1_array_empty() }
}

__g1_vec_reserve_owned<T>(value: Vec<T>, additional: usize) -> Vec<T> {
    __g1_vec_reserve(&mut value, additional);
    value
}

__g1_vec_with_capacity<T>(capacity: usize) -> Vec<T> {
    __g1_vec_reserve_owned(
        Vec { storage: __g1_array_empty() },
        capacity
    )
}

__g1_vec_len<T>(value: &Vec<T>) -> usize {
    __g1_array_len(&value.storage)
}

__g1_vec_capacity<T>(value: &Vec<T>) -> usize {
    __g1_array_capacity(&value.storage)
}

__g1_vec_reserve<T>(value: &mut Vec<T>, additional: usize) -> () {
    __g1_array_reserve(&mut value.storage, additional)
}

__g1_vec_push<T>(value: &mut Vec<T>, item: T) -> () {
    __g1_array_push_move(&mut value.storage, move item)
}

__g1_vec_is_empty<T>(value: &Vec<T>) -> Bool {
    let length = __g1_vec_len(value);
    length == 0
}

__g1_vec_pop<'a, T>(value: &'a mut Vec<T>) -> Option<T> {
    let length = __g1_array_len(&value.storage);
    let empty = length == 0;
    handle perform __VecBoolCase::inspect(empty) {
        __VecBoolCase::inspect(Result::Ok(_)) => None,
        __VecBoolCase::inspect(Result::Err(_)) =>
            Option::Some(__g1_array_pop_move(&mut value.storage))
    }
}

__g1_vec_get<'a, T>(value: &'a Vec<T>, index: usize) -> Option<&'a T> {
    let length = __g1_array_len(&value.storage);
    let in_bounds = index < length;
    handle perform __VecBoolCase::inspect(in_bounds) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Option::Some(__g1_array_get_borrow_shared(&value.storage, index)),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_vec_get_mut<'a, T>(
    value: &'a mut Vec<T>,
    index: usize
) -> Option<&'a mut T> {
    let length = __g1_array_len(&value.storage);
    let in_bounds = index < length;
    handle perform __VecBoolCase::inspect(in_bounds) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Option::Some(__g1_array_get_borrow_unique(&mut value.storage, index)),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_vec_first<'a, T>(value: &'a Vec<T>) -> Option<&'a T> {
    __g1_vec_get(value, 0)
}

__g1_vec_last<'a, T>(value: &'a Vec<T>) -> Option<&'a T> {
    let length = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => None,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_get(value, move length - 1)
    }
}

__g1_vec_as_slice<'a, T>(value: &'a Vec<T>) -> Slice<'a, T> {
    Slice {
        base: &value.storage,
        start: 0,
        length: __g1_array_len(&value.storage)
    }
}

__g1_vec_as_mut_slice<'a, T>(value: &'a mut Vec<T>) -> SliceMut<'a, T> {
    let length = __g1_array_len(&value.storage);
    SliceMut {
        base: &mut value.storage,
        start: 0,
        length: length
    }
}

__g1_slice_len<'a, T>(value: Slice<'a, T>) -> usize {
    value.length
}

__g1_slice_is_empty<'a, T>(value: Slice<'a, T>) -> Bool {
    let length = __g1_slice_len(value);
    length == 0
}

__g1_slice_get<'a, T>(
    value: Slice<'a, T>,
    index: usize
) -> Option<&'a T> {
    let Slice { base, start, length } = value;
    handle perform __VecBoolCase::inspect(index < length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Option::Some(__g1_array_get_borrow_shared(
                base,
                start + index
            )),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_first<'a, T>(value: Slice<'a, T>) -> Option<&'a T> {
    __g1_slice_get(value, 0)
}

__g1_slice_subslice_length<'a, T>(
    base: &'a Array<T>,
    base_start: usize,
    available: usize,
    start: usize,
    length: usize
) -> Option<Slice<'a, T>> {
    handle perform __VecBoolCase::inspect(length <= available - start) {
        __VecBoolCase::inspect(Result::Ok(_)) => Option::Some(Slice {
            base: base,
            start: base_start + start,
            length: length
        }),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_subslice<'a, T>(
    value: Slice<'a, T>,
    start: usize,
    length: usize
) -> Option<Slice<'a, T>> {
    let Slice { base, start: base_start, length: available } = value;
    handle perform __VecBoolCase::inspect(start <= available) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_slice_subslice_length(
                base,
                base_start,
                available,
                start,
                length
            ),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_iter<'a, T>(value: Slice<'a, T>) -> SliceIter<'a, T> {
    let Slice { base, start, length } = value;
    SliceIter {
        base: base,
        start: start,
        length: length,
        index: 0
    }
}

__g1_slice_iter_len<'a, T>(value: &SliceIter<'a, T>) -> usize {
    value.length - value.index
}

__g1_slice_iter_is_empty<'a, T>(value: &SliceIter<'a, T>) -> Bool {
    let remaining = __g1_slice_iter_len(value);
    remaining == 0
}

__g1_slice_iter_next<'a, T>(
    value: SliceIter<'a, T>
) -> Option<(usize, SliceIter<'a, T>)> {
    let SliceIter { base, start, length, index } = value;
    handle perform __VecBoolCase::inspect(index < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => Option::Some((
            index,
            SliceIter {
                base: base,
                start: start,
                length: length,
                index: index + 1
            }
        )),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_mut_len<'a, T>(value: &SliceMut<'a, T>) -> usize {
    value.length
}

__g1_slice_mut_is_empty<'a, T>(value: &SliceMut<'a, T>) -> Bool {
    let length = __g1_slice_mut_len(value);
    length == 0
}

__g1_slice_mut_get_mut<'a, T>(
    value: SliceMut<'a, T>,
    index: usize
) -> Option<&'a mut T> {
    let SliceMut { base, start, length } = move value;
    handle perform __VecBoolCase::inspect(index < length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Option::Some(__g1_array_get_borrow_unique(
                base,
                start + index
            )),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_mut_first_mut<'a, T>(
    value: SliceMut<'a, T>
) -> Option<&'a mut T> {
    __g1_slice_mut_get_mut(move value, 0)
}

__g1_slice_mut_get<'a, T>(
    value: SliceMut<'a, T>,
    index: usize
) -> Option<&'a T> {
    let SliceMut { base, start, length } = move value;
    handle perform __VecBoolCase::inspect(index < length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            Option::Some(__g1_array_get_borrow_shared(
                &*base,
                start + index
            )),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_mut_first<'a, T>(value: SliceMut<'a, T>) -> Option<&'a T> {
    __g1_slice_mut_get(move value, 0)
}

__g1_slice_mut_subslice_mut_length<'a, T>(
    base: &'a mut Array<T>,
    base_start: usize,
    available: usize,
    start: usize,
    length: usize
) -> Option<SliceMut<'a, T>> {
    handle perform __VecBoolCase::inspect(length <= available - start) {
        __VecBoolCase::inspect(Result::Ok(_)) => Option::Some(SliceMut {
            base: base,
            start: base_start + start,
            length: length
        }),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_mut_subslice_mut<'a, T>(
    value: SliceMut<'a, T>,
    start: usize,
    length: usize
) -> Option<SliceMut<'a, T>> {
    let SliceMut { base, start: base_start, length: available } = move value;
    handle perform __VecBoolCase::inspect(start <= available) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_slice_mut_subslice_mut_length(
                base,
                base_start,
                available,
                start,
                length
            ),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_mut_subslice_length<'a, T>(
    base: &'a mut Array<T>,
    base_start: usize,
    available: usize,
    start: usize,
    length: usize
) -> Option<Slice<'a, T>> {
    handle perform __VecBoolCase::inspect(length <= available - start) {
        __VecBoolCase::inspect(Result::Ok(_)) => Option::Some(Slice {
            base: &*base,
            start: base_start + start,
            length: length
        }),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_slice_mut_subslice<'a, T>(
    value: SliceMut<'a, T>,
    start: usize,
    length: usize
) -> Option<Slice<'a, T>> {
    let SliceMut { base, start: base_start, length: available } = move value;
    handle perform __VecBoolCase::inspect(start <= available) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_slice_mut_subslice_length(
                base,
                base_start,
                available,
                start,
                length
            ),
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

// Destructive shrinking is available only when the element's declared use
// interval includes zero. The private Array pop transfers each removed value
// into this function, where the bound permits that obligation to end.
__g1_vec_truncate<T>(value: &mut Vec<T>, length: usize) -> ()
    where T: Use<[0,0]> {
    let current = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(length < current) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let removed = __g1_array_pop_move(&mut value.storage);
            removed;
            __g1_vec_truncate(move value, length)
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_vec_clear<T>(value: &mut Vec<T>) -> ()
    where T: Use<[0,0]> {
    let current = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(0 < current) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let removed = __g1_array_pop_move(&mut value.storage);
            removed;
            __g1_vec_clear(move value)
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

// Resize's fill value may be unused, used once per new slot, or copied an
// unbounded number of times. The same bound also admits zero-use disposal when
// shrinking, so no Clone or Default contract is implied by this operation.
__g1_vec_resize_shrink<T>(
    value: &mut Vec<T>,
    length: usize,
    fill: T,
    current: usize
) -> ()
    where T: Use<[0,infinity]> {
    handle perform __VecBoolCase::inspect(length < current) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let removed = __g1_array_pop_move(&mut value.storage);
            removed;
            __g1_vec_resize(move value, length, fill)
        },
        __VecBoolCase::inspect(Result::Err(_)) => {
            fill;
            ()
        }
    }
}

__g1_vec_resize<T>(value: &mut Vec<T>, length: usize, fill: T) -> ()
    where T: Use<[0,infinity]> {
    let current = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(current < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_array_push_move(&mut value.storage, fill);
            __g1_vec_resize(move value, length, fill)
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_resize_shrink(move value, length, fill, current)
    }
}

__g1_vec_copy_from_array_step<T>(
    output: Vec<T>,
    source: &Array<T>,
    cursor: usize,
    end: usize
) -> Vec<T>
    where T: Use<[0,infinity]> {
    let item = __g1_array_get_copy(source, cursor);
    __g1_array_push_move(&mut output.storage, move item);
    __g1_vec_copy_from_array(move output, source, cursor + 1, end)
}

__g1_vec_copy_from_array<T>(
    output: Vec<T>,
    source: &Array<T>,
    cursor: usize,
    end: usize
) -> Vec<T>
    where T: Use<[0,infinity]> {
    handle perform __VecBoolCase::inspect(cursor < end) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_vec_copy_from_array_step(
                move output,
                source,
                cursor,
                end
            ),
        __VecBoolCase::inspect(Result::Err(_)) => move output
    }
}

// Extending from a shared slice copies its initialized window in order. The
// source remains borrowed and retains all of its ownership obligations.
__g1_vec_extend_from_slice<'a, T>(
    value: &mut Vec<T>,
    source: Slice<'a, T>
) -> ()
    where T: Use<[0,infinity]> {
    let Slice { base, start, length } = source;
    let copied = __g1_vec_copy_from_array(
        __g1_vec_new(),
        base,
        start,
        start + length
    );
    __g1_vec_append(move value, move copied)
}

// Checked whole-element rearrangement never exposes Array's temporary empty
// slots across a function call. Both indices are proven first; the two moves
// and two writes then form one uninterrupted ownership transaction. Each
// bounds decision has its own terminal helper so no outer handler retains a
// unique loan while an inner handler executes.
__g1_vec_swap_distinct<T>(
    value: &mut Vec<T>,
    left: usize,
    right: usize
) -> Bool {
    let left_item = __g1_array_get_move(&mut value.storage, left);
    let right_item = __g1_array_get_move(&mut value.storage, right);
    __g1_array_set_move(&mut value.storage, left, move right_item);
    __g1_array_set_move(&mut value.storage, right, move left_item);
    true
}

__g1_vec_swap_equal<T>(
    value: &mut Vec<T>,
    left: usize,
    right: usize
) -> Bool {
    handle perform __VecBoolCase::inspect(left == right) {
        __VecBoolCase::inspect(Result::Ok(_)) => true,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_swap_distinct(&mut *value, left, right)
    }
}

__g1_vec_swap_right<T>(
    value: &mut Vec<T>,
    left: usize,
    right: usize,
    length: usize
) -> Bool {
    handle perform __VecBoolCase::inspect(right < length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_vec_swap_equal(&mut *value, left, right),
        __VecBoolCase::inspect(Result::Err(_)) => false
    }
}

__g1_vec_swap<T>(value: &mut Vec<T>, left: usize, right: usize) -> Bool {
    let length = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(left < length) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_vec_swap_right(&mut *value, left, right, length),
        __VecBoolCase::inspect(Result::Err(_)) => false
    }
}

__g1_vec_reverse_between<T>(
    value: &mut Vec<T>,
    left: usize,
    right: usize
) -> () {
    handle perform __VecBoolCase::inspect(left < right) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_vec_swap(&mut *value, left, right);
            __g1_vec_reverse_between(move value, left + 1, right - 1)
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_vec_reverse<T>(value: &mut Vec<T>) -> () {
    let length = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_reverse_between(move value, 0, length - 1)
    }
}

// Reversing once lets the private iterator transfer elements through the
// Array's initialized-suffix pop primitive in original insertion order.
__g1_vec_into_iter<T>(value: Vec<T>) -> VecIntoIter<T> {
    __g1_vec_reverse(&mut value);
    VecIntoIter { remaining: move value }
}

__g1_vec_into_iter_next<T>(
    value: VecIntoIter<T>
) -> Option<(T, VecIntoIter<T>)> {
    let VecIntoIter { remaining } = move value;
    let length = __g1_array_len(&remaining.storage);
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let Vec { storage } = move remaining;
            __g1_array_finish_drained(move storage);
            None
        },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let item = __g1_array_pop_move(&mut remaining.storage);
            Option::Some((
                move item,
                VecIntoIter { remaining: move remaining }
            ))
        }
    }
}

__g1_vec_deque_new<T>() -> VecDeque<T> {
    VecDeque {
        slots: __g1_vec_new(),
        head: 0,
        length: 0
    }
}

__g1_vec_deque_empty_slot<T>() -> __VecDequeSlot<T> {
    __VecDequeSlot::Empty
}

__g1_vec_deque_empty_slots<T>(
    like: &Vec<__VecDequeSlot<T>>
) -> Vec<__VecDequeSlot<T>> {
    like;
    __g1_vec_new()
}

__g1_vec_deque_len<T>(value: &VecDeque<T>) -> usize { value.length }

__g1_vec_deque_capacity<T>(value: &VecDeque<T>) -> usize {
    __g1_vec_len(&value.slots)
}

__g1_vec_deque_is_empty<T>(value: &VecDeque<T>) -> Bool {
    value.length == 0
}

__g1_vec_deque_usize_sub(left: usize, right: usize) -> usize {
    move left - move right
}

// `offset < capacity` and `base < capacity`; subtraction before addition
// keeps the non-wrapping branch within usize without computing base+offset.
__g1_vec_deque_wrap_add(
    base: usize,
    offset: usize,
    capacity: usize
) -> usize {
    let until_end = __g1_vec_deque_usize_sub(capacity, base);
    handle perform __VecBoolCase::inspect(offset < until_end) {
        __VecBoolCase::inspect(Result::Ok(_)) => base + offset,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_deque_usize_sub(offset, until_end)
    }
}

__g1_vec_deque_wrap_previous(head: usize, capacity: usize) -> usize {
    handle perform __VecBoolCase::inspect(head == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_vec_deque_usize_sub(capacity, 1),
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_deque_usize_sub(head, 1)
    }
}

__g1_vec_deque_fill_empty<T>(
    slots: Vec<__VecDequeSlot<T>>,
    remaining: usize
) -> Vec<__VecDequeSlot<T>> {
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => move slots,
        __VecBoolCase::inspect(Result::Err(_)) => {
            __g1_array_push_move(
                &mut slots.storage,
                __g1_vec_deque_empty_slot()
            );
            __g1_vec_deque_fill_empty(
                move slots,
                __g1_vec_deque_usize_sub(remaining, 1)
            )
        }
    }
}

// Replacing through the unique slot borrow moves the old Slot and installs the
// new one without exposing an empty Array cell across a call or handler.
__g1_vec_deque_place<T>(
    slots: &mut Vec<__VecDequeSlot<T>>,
    index: usize,
    capacity: usize,
    item: T
) -> () {
    let previous = replace(
        __g1_array_get_borrow_unique(&mut slots.storage, index),
        __VecDequeSlot::Full(move item)
    );
    handle perform __VecDequeSlotCase<T>::inspect(move previous) {
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Empty) => (),
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Full(displaced)) => {
            let next = __g1_vec_deque_wrap_add(index, 1, capacity);
            __g1_vec_deque_place(
                move slots,
                next,
                capacity,
                move displaced
            )
        }
    }
}

__g1_vec_deque_take<T>(
    slots: &mut Vec<__VecDequeSlot<T>>,
    index: usize
) -> __VecDequeSlot<T> {
    replace(
        __g1_array_get_borrow_unique(&mut slots.storage, index),
        __g1_vec_deque_empty_slot()
    )
}

__g1_vec_deque_relocate_one<T>(
    old: Vec<__VecDequeSlot<T>>,
    fresh: Vec<__VecDequeSlot<T>>,
    head: usize,
    offset: usize,
    old_capacity: usize,
    moved: usize
) -> (Vec<__VecDequeSlot<T>>, Vec<__VecDequeSlot<T>>, usize) {
    let index = __g1_vec_deque_wrap_add(head, offset, old_capacity);
    let previous = replace(
        __g1_array_get_borrow_unique(&mut old.storage, index),
        __g1_vec_deque_empty_slot()
    );
    handle perform __VecDequeSlotCase<T>::inspect(move previous) {
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Empty) =>
            __g1_vec_deque_relocate(
                move old,
                move fresh,
                head,
                __g1_usize_add(offset, 1),
                old_capacity,
                moved
            ),
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Full(item)) => {
            let fresh_capacity = __g1_vec_len(&fresh);
            __g1_vec_deque_place(
                &mut fresh,
                moved,
                fresh_capacity,
                move item
            );
            __g1_vec_deque_relocate(
                move old,
                move fresh,
                head,
                offset + 1,
                old_capacity,
                moved + 1
            )
        }
    }
}

__g1_vec_deque_relocate<T>(
    old: Vec<__VecDequeSlot<T>>,
    fresh: Vec<__VecDequeSlot<T>>,
    head: usize,
    offset: usize,
    old_capacity: usize,
    moved: usize
) -> (Vec<__VecDequeSlot<T>>, Vec<__VecDequeSlot<T>>, usize) {
    handle perform __VecBoolCase::inspect(offset < old_capacity) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_vec_deque_relocate_one(
                move old,
                move fresh,
                head,
                offset,
                old_capacity,
                moved
            ),
        __VecBoolCase::inspect(Result::Err(_)) =>
            (move old, move fresh, moved)
    }
}

__g1_vec_deque_drain_old_step<T>(
    old: Vec<__VecDequeSlot<T>>,
    fresh: Vec<__VecDequeSlot<T>>,
    moved: usize
) -> (Vec<__VecDequeSlot<T>>, usize) {
    let slot = __g1_array_pop_move(&mut old.storage);
    handle perform __VecDequeSlotCase<T>::inspect(move slot) {
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Empty) =>
            __g1_vec_deque_drain_old(move old, move fresh, moved),
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Full(item)) => {
            let fresh_capacity = __g1_vec_len(&fresh);
            __g1_vec_deque_place(
                &mut fresh,
                moved,
                fresh_capacity,
                move item
            );
            __g1_vec_deque_drain_old(move old, move fresh, moved + 1)
        }
    }
}

__g1_vec_deque_drain_old<T>(
    old: Vec<__VecDequeSlot<T>>,
    fresh: Vec<__VecDequeSlot<T>>,
    moved: usize
) -> (Vec<__VecDequeSlot<T>>, usize) {
    let remaining = __g1_vec_len(&old);
    handle perform __VecBoolCase::inspect(remaining == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let Vec { storage } = move old;
            __g1_array_finish_drained(move storage);
            (move fresh, moved)
        },
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_deque_drain_old_step(move old, move fresh, moved)
    }
}

__g1_vec_deque_grow<T>(
    value: VecDeque<T>,
    new_capacity: usize
) -> VecDeque<T> {
    let VecDeque { slots, head, length: _ } = move value;
    let old_capacity = __g1_vec_len(&slots);
    let fresh = __g1_vec_deque_fill_empty(
        __g1_vec_deque_empty_slots(&slots),
        new_capacity
    );
    let relocated = __g1_vec_deque_relocate(
        move slots,
        move fresh,
        head,
        0,
        old_capacity,
        0
    );
    let (old, fresh, moved) = move relocated;
    let drained = __g1_vec_deque_drain_old(
        move old,
        move fresh,
        moved
    );
    let (fresh, moved) = move drained;
    VecDeque { slots: move fresh, head: 0, length: moved }
}

__g1_vec_deque_grow_once<T>(value: VecDeque<T>) -> VecDeque<T> {
    let capacity = __g1_vec_deque_capacity(&value);
    handle perform __VecBoolCase::inspect(capacity == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_vec_deque_grow(move value, 1),
        // Ordinary usize addition is checked; overflow terminates before any
        // owned state is lost rather than producing a wrapped capacity.
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_deque_grow(move value, capacity + capacity)
    }
}

__g1_vec_deque_reserve_owned<T>(
    value: VecDeque<T>,
    additional: usize
) -> VecDeque<T> {
    let capacity = __g1_vec_deque_capacity(&value);
    let available = __g1_vec_deque_usize_sub(capacity, value.length);
    handle perform __VecBoolCase::inspect(additional <= available) {
        __VecBoolCase::inspect(Result::Ok(_)) => move value,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_deque_reserve_owned(
                __g1_vec_deque_grow_once(move value),
                additional
            )
    }
}

__g1_vec_deque_finish_empty<T>(value: VecDeque<T>) -> () {
    let VecDeque { slots, head: _, length: _ } = move value;
    let Vec { storage } = move slots;
    __g1_array_finish_drained(move storage)
}

__g1_vec_deque_reserve<T>(
    value: &mut VecDeque<T>,
    additional: usize
) -> () {
    let old = replace(&mut *value, __g1_vec_deque_new());
    let grown = __g1_vec_deque_reserve_owned(move old, additional);
    let placeholder = replace(&mut *value, move grown);
    __g1_vec_deque_finish_empty(move placeholder)
}

__g1_vec_deque_push_back<T>(value: &mut VecDeque<T>, item: T) -> () {
    __g1_vec_deque_reserve(&mut *value, 1);
    let capacity = __g1_vec_deque_capacity(&*value);
    let index = __g1_vec_deque_wrap_add(
        value.head,
        value.length,
        capacity
    );
    __g1_vec_deque_place(
        &mut value.slots,
        index,
        capacity,
        move item
    );
    (*value).length = value.length + 1;
    ()
}

__g1_vec_deque_push_front<T>(value: &mut VecDeque<T>, item: T) -> () {
    __g1_vec_deque_reserve(&mut *value, 1);
    let capacity = __g1_vec_deque_capacity(&*value);
    let head = __g1_vec_deque_wrap_previous(value.head, capacity);
    __g1_vec_deque_place(
        &mut value.slots,
        head,
        capacity,
        move item
    );
    (*value).head = head;
    (*value).length = value.length + 1;
    ()
}

__g1_vec_deque_pop_back_step<T>(value: &mut VecDeque<T>) -> Option<T> {
    let capacity = __g1_vec_deque_capacity(&*value);
    let index = __g1_vec_deque_wrap_add(
        value.head,
        __g1_vec_deque_usize_sub(value.length, 1),
        capacity
    );
    let previous = __g1_vec_deque_take(&mut value.slots, index);
    (*value).length = __g1_vec_deque_usize_sub(value.length, 1);
    handle perform __VecDequeSlotCase<T>::inspect(move previous) {
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Empty) => None,
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Full(item)) =>
            Option::Some(move item)
    }
}

__g1_vec_deque_pop_back<T>(value: &mut VecDeque<T>) -> Option<T> {
    let length = value.length;
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => None,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_deque_pop_back_step(move value)
    }
}

__g1_vec_deque_pop_front_step<T>(value: &mut VecDeque<T>) -> Option<T> {
    let capacity = __g1_vec_deque_capacity(&*value);
    let head = value.head;
    let previous = __g1_vec_deque_take(&mut value.slots, head);
    (*value).head = __g1_vec_deque_wrap_add(head, 1, capacity);
    (*value).length = __g1_vec_deque_usize_sub(value.length, 1);
    handle perform __VecDequeSlotCase<T>::inspect(move previous) {
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Empty) => None,
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Full(item)) =>
            Option::Some(move item)
    }
}

__g1_vec_deque_pop_front<T>(value: &mut VecDeque<T>) -> Option<T> {
    let length = value.length;
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => None,
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_deque_pop_front_step(move value)
    }
}

__g1_vec_deque_clear_step<T>(value: &mut VecDeque<T>) -> ()
    where T: Use<[0,0]> {
    let capacity = __g1_vec_deque_capacity(&*value);
    let index = __g1_vec_deque_wrap_add(
        value.head,
        __g1_vec_deque_usize_sub(value.length, 1),
        capacity
    );
    let previous = __g1_vec_deque_take(&mut value.slots, index);
    (*value).length = __g1_vec_deque_usize_sub(value.length, 1);
    handle perform __VecDequeSlotCase<T>::inspect(move previous) {
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Empty) =>
            __g1_vec_deque_clear(move value),
        __VecDequeSlotCase<T>::inspect(__VecDequeSlot::Full(item)) => {
            item;
            __g1_vec_deque_clear(move value)
        }
    }
}

__g1_vec_deque_clear<T>(value: &mut VecDeque<T>) -> ()
    where T: Use<[0,0]> {
    let length = value.length;
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => (),
        __VecBoolCase::inspect(Result::Err(_)) =>
            __g1_vec_deque_clear_step(move value)
    }
}

// Rotating the requested element to the initialized suffix and popping that
// suffix implements stable removal without carrying an empty Array slot over a
// recursive edge.
__g1_vec_rotate_to_end<T>(
    value: &mut Vec<T>,
    cursor: usize,
    last: usize
) -> () {
    handle perform __VecBoolCase::inspect(cursor < last) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_vec_swap(&mut *value, cursor, cursor + 1);
            __g1_vec_rotate_to_end(move value, cursor + 1, last)
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

__g1_vec_remove<T>(value: &mut Vec<T>, index: usize) -> Option<T> {
    let length = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(index < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_vec_rotate_to_end(&mut *value, index, length - 1);
            Option::Some(__g1_array_pop_move(&mut value.storage))
        },
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_vec_swap_remove<T>(value: &mut Vec<T>, index: usize) -> Option<T> {
    let length = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(index < length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_vec_swap(&mut *value, index, length - 1);
            Option::Some(__g1_array_pop_move(&mut value.storage))
        },
        __VecBoolCase::inspect(Result::Err(_)) => None
    }
}

__g1_vec_rotate_inserted<T>(
    value: &mut Vec<T>,
    cursor: usize,
    destination: usize
) -> () {
    handle perform __VecBoolCase::inspect(destination < cursor) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_vec_swap(&mut *value, cursor, cursor - 1);
            __g1_vec_rotate_inserted(move value, cursor - 1, destination)
        },
        __VecBoolCase::inspect(Result::Err(_)) => ()
    }
}

// A failed insertion returns the item, preserving its use obligation.
__g1_vec_insert<T>(
    value: &mut Vec<T>,
    index: usize,
    item: T
) -> Result<(), T> {
    let length = __g1_array_len(&value.storage);
    handle perform __VecBoolCase::inspect(index <= length) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            __g1_array_push_move(&mut value.storage, move item);
            __g1_vec_rotate_inserted(&mut *value, length, index);
            Result::Ok(())
        },
        __VecBoolCase::inspect(Result::Err(_)) => Result::Err(move item)
    }
}

__g1_vec_append_drain<T>(target: &mut Vec<T>, source: Vec<T>) -> () {
    let length = __g1_array_len(&source.storage);
    handle perform __VecBoolCase::inspect(length == 0) {
        __VecBoolCase::inspect(Result::Ok(_)) => {
            let Vec { storage } = move source;
            __g1_array_finish_drained(move storage)
        },
        __VecBoolCase::inspect(Result::Err(_)) => {
            let item = __g1_array_pop_move(&mut source.storage);
            __g1_array_push_move(&mut target.storage, move item);
            __g1_vec_append_drain(move target, move source)
        }
    }
}

// Reverse once so the tail-draining loop appends in the source's original
// order. The exhausted private shell is then consumed by finish_drained.
__g1_vec_append<T>(target: &mut Vec<T>, source: Vec<T>) -> () {
    __g1_vec_reverse(&mut source);
    __g1_vec_append_drain(target, move source)
}

__g1_vec_index<'a, T>(value: &'a Vec<T>, index: usize) -> &'a T {
    __g1_array_get_borrow_shared(&value.storage, index)
}

__g1_vec_index_mut<'a, T>(value: &'a mut Vec<T>, index: usize) -> &'a mut T {
    __g1_array_get_borrow_unique(&mut value.storage, index)
}

