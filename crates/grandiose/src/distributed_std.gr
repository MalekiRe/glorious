// Layer 3a: non-trapping public Text/Bytes operations. These are ordinary
// source functions so public call sites never acquire manifest authority.
// Frozen comparison primitives return the canonical u32 discriminator 0 or 1.
// Translate it to the result-based Bool through ordinary exhaustive handling;
// this helper carries no manifest authority of its own.
effect __U32BooleanCase { inspect(value: u32) -> !; }

__g1_bool_from_u32(value: u32) -> Bool {
    handle perform __U32BooleanCase::inspect(value) {
        __U32BooleanCase::inspect(0) => false,
        __U32BooleanCase::inspect(_) => true
    }
}

