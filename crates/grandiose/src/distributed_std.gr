impl Default for u8 { default() -> u8 { 0 } }
impl Default for u16 { default() -> u16 { 0 } }
impl Default for u32 { default() -> u32 { 0 } }
impl Default for u64 { default() -> u64 { 0 } }
impl Default for u128 { default() -> u128 { 0 } }
impl Default for usize { default() -> usize { 0 } }
impl Default for f32 { default() -> f32 { 0.0 } }
impl Default for f64 { default() -> f64 { 0.0 } }
impl Default for char { default() -> char { '\0' } }
impl Default for String { default() -> String { String::empty() } }
impl Default for Bytes { default() -> Bytes { b"" } }

