// Whole-shell byte conversion is the only public bridge to the internal
// Array<u8> primitives. Vec's private-field authority is exercised here, and
// the moved dense shell cannot be observed or reused by the caller.
__g1_vec_u8_into_array(value: Vec<u8>) -> Array<u8> {
    let Vec { storage } = move value;
    storage
}

__g1_bytes_from_vec(value: Vec<u8>) -> Bytes {
    __g1_bytes_from_array_move(__g1_vec_u8_into_array(move value))
}

__g1_bytes_to_vec(value: Bytes) -> Vec<u8> {
    __g1_vec_from_array(__g1_bytes_to_array(move value))
}

let Bytes::from_vec = __g1_bytes_from_vec;
let Bytes::to_vec = __g1_bytes_to_vec;

// Character encoding and decoding are ordinary source. The only trusted
// operations are the frozen scalar conversion leaves at the top of this file.
// Decoding first validates an exact one-scalar slice, so the checked conversion
// leaf can never receive a surrogate or an out-of-range scalar.
effect __CharUtf8ValidationCase {
    inspect(value: Result<(), Utf8Error>) -> !;
}

__g1_char_utf8_part(byte: u8, mask: u8) -> u32 {
    wrapping_convert_to_u32(bit_and(move byte, move mask))
}

__g1_char_utf8_continuation(scalar: u32, shift: u32) -> u8 {
    wrapping_convert_to_u8(bit_or(
        bit_and(shift_right(move scalar, move shift), 63),
        128
    ))
}

__g1_char_utf8_lead(scalar: u32, shift: u32, prefix: u32) -> u8 {
    wrapping_convert_to_u8(bit_or(
        shift_right(move scalar, move shift),
        move prefix
    ))
}

__g1_char_byte_vec() -> Vec<u8> { __g1_vec_new() }

__g1_char_encode_scalar(bytes: Vec<u8>, scalar: u32) -> Vec<u8> {
    handle perform __BytesBoolCase::inspect(scalar <= 127) {
        __BytesBoolCase::inspect(Result::Ok(_)) => {
            __g1_vec_push(
                &mut bytes,
                wrapping_convert_to_u8(move scalar)
            );
            bytes
        },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            handle perform __BytesBoolCase::inspect(scalar <= 2047) {
                __BytesBoolCase::inspect(Result::Ok(_)) => {
                    __g1_vec_push(
                        &mut bytes,
                        __g1_char_utf8_lead(scalar, 6, 192)
                    );
                    __g1_vec_push(
                        &mut bytes,
                        __g1_char_utf8_continuation(move scalar, 0)
                    );
                    bytes
                },
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    handle perform __BytesBoolCase::inspect(scalar <= 65535) {
                        __BytesBoolCase::inspect(Result::Ok(_)) => {
                            __g1_vec_push(
                                &mut bytes,
                                __g1_char_utf8_lead(scalar, 12, 224)
                            );
                            __g1_vec_push(
                                &mut bytes,
                                __g1_char_utf8_continuation(scalar, 6)
                            );
                            __g1_vec_push(
                                &mut bytes,
                                __g1_char_utf8_continuation(move scalar, 0)
                            );
                            bytes
                        },
                        __BytesBoolCase::inspect(Result::Err(_)) => {
                            __g1_vec_push(
                                &mut bytes,
                                __g1_char_utf8_lead(scalar, 18, 240)
                            );
                            __g1_vec_push(
                                &mut bytes,
                                __g1_char_utf8_continuation(scalar, 12)
                            );
                            __g1_vec_push(
                                &mut bytes,
                                __g1_char_utf8_continuation(scalar, 6)
                            );
                            __g1_vec_push(
                                &mut bytes,
                                __g1_char_utf8_continuation(move scalar, 0)
                            );
                            bytes
                        }
                    }
            }
    }
}

__g1_char_encode_utf8(value: char) -> Bytes {
    let scalar = __g1_char_to_u32(move value);
    let bytes = __g1_char_encode_scalar(__g1_char_byte_vec(), move scalar);
    __g1_bytes_from_vec(move bytes)
}

__g1_char_decode_scalar_two(value: Bytes) -> u32 {
    bit_or(
        shift_left(
            __g1_char_utf8_part(__g1_bytes_get(value, 0), 31),
            6
        ),
        __g1_char_utf8_part(__g1_bytes_get(value, 1), 63)
    )
}

__g1_char_decode_scalar_three(value: Bytes) -> u32 {
    bit_or(
        bit_or(
            shift_left(
                __g1_char_utf8_part(__g1_bytes_get(value, 0), 15),
                12
            ),
            shift_left(
                __g1_char_utf8_part(__g1_bytes_get(value, 1), 63),
                6
            )
        ),
        __g1_char_utf8_part(__g1_bytes_get(value, 2), 63)
    )
}

__g1_char_decode_scalar_four(value: Bytes) -> u32 {
    bit_or(
        bit_or(
            shift_left(
                __g1_char_utf8_part(__g1_bytes_get(value, 0), 7),
                18
            ),
            shift_left(
                __g1_char_utf8_part(__g1_bytes_get(value, 1), 63),
                12
            )
        ),
        bit_or(
            shift_left(
                __g1_char_utf8_part(__g1_bytes_get(value, 2), 63),
                6
            ),
            __g1_char_utf8_part(__g1_bytes_get(value, 3), 63)
        )
    )
}

__g1_char_decode_scalar(value: Bytes, width: usize) -> u32 {
    handle perform __BytesBoolCase::inspect(width == 1) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            wrapping_convert_to_u32(__g1_bytes_get(value, 0)),
        __BytesBoolCase::inspect(Result::Err(_)) =>
            handle perform __BytesBoolCase::inspect(width == 2) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __g1_char_decode_scalar_two(move value),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    handle perform __BytesBoolCase::inspect(width == 3) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            __g1_char_decode_scalar_three(move value),
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            __g1_char_decode_scalar_four(move value)
                    }
            }
    }
}

__g1_char_decode_invalid(index: usize) -> Result<DecodedChar, Utf8Error> {
    Result::Err(Utf8Error { valid_up_to: move index })
}

__g1_char_decode_known(
    value: Bytes,
    index: usize,
    width: usize,
    length: usize
) -> Result<DecodedChar, Utf8Error> {
    let end = __g1_usize_add(index, width);
    handle perform __BytesBoolCase::inspect(end <= length) {
        __BytesBoolCase::inspect(Result::Ok(_)) => {
            let scalar_bytes = __g1_bytes_slice(value, index, end);
            handle perform __CharUtf8ValidationCase::inspect(
                __g1_utf8_validate_at(scalar_bytes, 0)
            ) {
                __CharUtf8ValidationCase::inspect(Result::Ok(_)) => {
                    let scalar = __g1_char_decode_scalar(
                        move scalar_bytes,
                        move width
                    );
                    Result::Ok(DecodedChar {
                        value: __g1_char_from_u32_checked(move scalar),
                        next: move end
                    })
                },
                __CharUtf8ValidationCase::inspect(Result::Err(_)) =>
                    __g1_char_decode_invalid(move index)
            }
        },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            __g1_char_decode_invalid(move index)
    }
}

__g1_char_decode_lead(
    value: Bytes,
    index: usize,
    lead: u8,
    length: usize
) -> Result<DecodedChar, Utf8Error> {
    handle perform __BytesBoolCase::inspect(lead <= 127) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            __g1_char_decode_known(move value, move index, 1, move length),
        __BytesBoolCase::inspect(Result::Err(_)) =>
            handle perform __BytesBoolCase::inspect(194 <= lead) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __BytesBoolCase::inspect(lead <= 223) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            __g1_char_decode_known(
                                move value,
                                move index,
                                2,
                                move length
                            ),
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            handle perform __BytesBoolCase::inspect(lead <= 239) {
                                __BytesBoolCase::inspect(Result::Ok(_)) =>
                                    __g1_char_decode_known(
                                        move value,
                                        move index,
                                        3,
                                        move length
                                    ),
                                __BytesBoolCase::inspect(Result::Err(_)) =>
                                    handle perform __BytesBoolCase::inspect(
                                        lead <= 244
                                    ) {
                                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                                            __g1_char_decode_known(
                                                move value,
                                                move index,
                                                4,
                                                move length
                                            ),
                                        __BytesBoolCase::inspect(Result::Err(_)) =>
                                            __g1_char_decode_invalid(move index)
                                    }
                            }
                    },
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_char_decode_invalid(move index)
            }
    }
}

__g1_char_decode_utf8(
    value: &Bytes,
    index: usize
) -> Result<DecodedChar, Utf8Error> {
    let owned = *value;
    let length = __g1_bytes_len(owned);
    handle perform __BytesBoolCase::inspect(index < length) {
        __BytesBoolCase::inspect(Result::Ok(_)) => {
            let lead = __g1_bytes_get(owned, index);
            __g1_char_decode_lead(
                move owned,
                move index,
                move lead,
                move length
            )
        },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            __g1_char_decode_invalid(move index)
    }
}

char_encode_utf8(value: char) -> Bytes {
    __g1_char_encode_utf8(move value)
}

char_decode_utf8(
    value: &Bytes,
    index: usize
) -> Result<DecodedChar, Utf8Error> {
    __g1_char_decode_utf8(move value, move index)
}

// Validated immutable views retain the cheap Text/Bytes handle and a half-open
// byte range. Private fields are the authority boundary: user source can move
// or borrow a view, but cannot forge a range that reaches the trapping slice
// leaves below.
struct TextView {
    private text: String,
    private start: usize,
    private end: usize
}

struct ByteView {
    private bytes: Bytes,
    private start: usize,
    private end: usize
}

__g1_text_view_ok(value: TextView) -> Result<TextView, TextRangeError> {
    Result::Ok(move value)
}

__g1_text_view_err(error: TextRangeError) -> Result<TextView, TextRangeError> {
    Result::Err(move error)
}

__g1_text_view_new_owned(
    text: String,
    range: Range<usize>
) -> Result<TextView, TextRangeError> {
    let start = range.start;
    let end = range.end;
    let bytes = __g1_text_as_bytes(text);
    let candidate = TextView {
        text: move text,
        start: start,
        end: end
    };
    handle perform __BytesBoolCase::inspect(start <= end) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(
                end <= __g1_bytes_len(bytes)
            ) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    handle perform __BytesBoolCase::inspect(
                        __g1_utf8_boundary(bytes, start)
                    ) {
                        __BytesBoolCase::inspect(Result::Ok(_)) =>
                            handle perform __BytesBoolCase::inspect(
                                __g1_utf8_boundary(bytes, end)
                            ) {
                                __BytesBoolCase::inspect(Result::Ok(_)) =>
                                    __g1_text_view_ok(move candidate),
                                __BytesBoolCase::inspect(Result::Err(_)) =>
                                    __g1_text_view_err(
                                        TextRangeError::NotCharBoundary
                                    )
                            },
                        __BytesBoolCase::inspect(Result::Err(_)) =>
                            __g1_text_view_err(
                                TextRangeError::NotCharBoundary
                            )
                    },
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_text_view_err(TextRangeError::OutOfBounds)
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            __g1_text_view_err(TextRangeError::Reversed)
    }
}

__g1_text_view_new(
    text: &String,
    range: Range<usize>
) -> Result<TextView, TextRangeError> {
    __g1_text_view_new_owned(*text, move range)
}

__g1_text_view_all(text: &String) -> TextView {
    TextView {
        text: *text,
        start: 0,
        end: __g1_string_byte_len(text)
    }
}

__g1_text_view_byte_len(value: &TextView) -> usize {
    value.end - value.start
}

__g1_text_view_is_empty(value: &TextView) -> Bool {
    value.start == value.end
}

__g1_text_view_as_bytes(value: &TextView) -> Bytes {
    __g1_bytes_slice(
        __g1_text_as_bytes(value.text),
        value.start,
        value.end
    )
}

__g1_text_view_to_string(value: &TextView) -> String {
    // Construction proved both UTF-8 boundaries, so this private conversion
    // cannot fault and need not validate the complete parent text again.
    __g1_text_from_utf8_checked(__g1_text_view_as_bytes(value))
}

__g1_text_view_eq(left: &TextView, right: &TextView) -> Bool {
    let left_bytes = __g1_text_view_as_bytes(left);
    let right_bytes = __g1_text_view_as_bytes(right);
    __g1_bytes_eq(&left_bytes, &right_bytes)
}

__g1_byte_view_ok(value: ByteView) -> Result<ByteView, BytesRangeError> {
    Result::Ok(move value)
}

__g1_byte_view_err(error: BytesRangeError) -> Result<ByteView, BytesRangeError> {
    Result::Err(move error)
}

__g1_byte_view_new_owned(
    bytes: Bytes,
    range: Range<usize>
) -> Result<ByteView, BytesRangeError> {
    let start = range.start;
    let end = range.end;
    let parent_length = __g1_bytes_len(bytes);
    let candidate = ByteView {
        bytes: move bytes,
        start: start,
        end: end
    };
    handle perform __BytesBoolCase::inspect(start <= end) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            handle perform __BytesBoolCase::inspect(end <= parent_length) {
                __BytesBoolCase::inspect(Result::Ok(_)) =>
                    __g1_byte_view_ok(move candidate),
                __BytesBoolCase::inspect(Result::Err(_)) =>
                    __g1_byte_view_err(BytesRangeError::OutOfBounds)
            },
        __BytesBoolCase::inspect(Result::Err(_)) =>
            __g1_byte_view_err(BytesRangeError::Reversed)
    }
}

__g1_byte_view_new(
    bytes: &Bytes,
    range: Range<usize>
) -> Result<ByteView, BytesRangeError> {
    __g1_byte_view_new_owned(*bytes, move range)
}

__g1_byte_view_all(bytes: &Bytes) -> ByteView {
    ByteView { bytes: *bytes, start: 0, end: __g1_bytes_len(*bytes) }
}

__g1_byte_view_len(value: &ByteView) -> usize {
    value.end - value.start
}

__g1_byte_view_is_empty(value: &ByteView) -> Bool {
    value.start == value.end
}

__g1_byte_view_to_bytes(value: &ByteView) -> Bytes {
    __g1_bytes_slice(value.bytes, value.start, value.end)
}

__g1_byte_view_eq(left: &ByteView, right: &ByteView) -> Bool {
    let left_bytes = __g1_byte_view_to_bytes(left);
    let right_bytes = __g1_byte_view_to_bytes(right);
    __g1_bytes_eq(&left_bytes, &right_bytes)
}

__g1_byte_view_get(value: &ByteView, index: usize) -> Result<u8, BytesIndexError> {
    let length = __g1_byte_view_len(value);
    handle perform __BytesBoolCase::inspect(index < length) {
        __BytesBoolCase::inspect(Result::Ok(_)) =>
            Result::Ok(__g1_bytes_get(value.bytes, value.start + move index)),
        __BytesBoolCase::inspect(Result::Err(_)) =>
            Result::Err(BytesIndexError::OutOfBounds)
    }
}

let TextView::new = __g1_text_view_new;
let TextView::all = __g1_text_view_all;
let TextView::byte_len = __g1_text_view_byte_len;
let TextView::is_empty = __g1_text_view_is_empty;
let TextView::as_bytes = __g1_text_view_as_bytes;
let TextView::to_string = __g1_text_view_to_string;
let TextView::eq = __g1_text_view_eq;
let ByteView::new = __g1_byte_view_new;
let ByteView::all = __g1_byte_view_all;
let ByteView::len = __g1_byte_view_len;
let ByteView::is_empty = __g1_byte_view_is_empty;
let ByteView::get = __g1_byte_view_get;
let ByteView::to_bytes = __g1_byte_view_to_bytes;
let ByteView::eq = __g1_byte_view_eq;


// The two compiler-facing builders own their byte vectors. Appending deep-copies
// the immutable byte handle through the public Bytes/Vec bridge and then uses
// Vec's ownership-moving append; no VM-only bulk-copy convenience is required.
struct StringBuilder { private bytes: Vec<u8> }
struct ByteBuf { private bytes: Vec<u8> }
struct Formatter {
    private builder: StringBuilder,
    private indentation: usize,
    private line_start: Bool
}

__g1_vec_append_bytes(
    target: &mut Vec<u8>,
    bytes: Bytes
) -> () {
    let copied = __g1_bytes_to_vec(move bytes);
    __g1_vec_append(move target, move copied)
}

__g1_string_builder_new() -> StringBuilder {
    StringBuilder { bytes: __g1_vec_new() }
}

__g1_string_builder_with_capacity(capacity: usize) -> StringBuilder {
    StringBuilder { bytes: __g1_vec_with_capacity(move capacity) }
}

__g1_string_builder_len(value: &StringBuilder) -> usize {
    __g1_vec_len(&value.bytes)
}

__g1_string_builder_is_empty(value: &StringBuilder) -> Bool {
    __g1_vec_is_empty(&value.bytes)
}

__g1_string_builder_reserve(value: &mut StringBuilder, additional: usize) -> () {
    __g1_vec_reserve(&mut value.bytes, move additional)
}

__g1_string_builder_push_byte(value: &mut StringBuilder, byte: u8) -> () {
    __g1_vec_push(&mut value.bytes, move byte)
}

__g1_string_builder_append_bytes(value: &mut StringBuilder, bytes: &Bytes) -> () {
    __g1_vec_append_bytes(&mut value.bytes, *bytes)
}

__g1_string_builder_append_string(value: &mut StringBuilder, text: &String) -> () {
    __g1_vec_append_bytes(
        &mut value.bytes,
        __g1_text_as_bytes(*text)
    )
}

__g1_string_builder_append_view(value: &mut StringBuilder, view: &TextView) -> () {
    __g1_vec_append_bytes(
        &mut value.bytes,
        __g1_text_view_as_bytes(view)
    )
}

__g1_string_builder_append_char(value: &mut StringBuilder, character: char) -> () {
    let encoded = char_encode_utf8(move character);
    __g1_string_builder_append_bytes(move value, &encoded)
}

__g1_u64_add(left: u64, right: u64) -> u64 { move left + move right }
__g1_u64_div(left: u64, right: u64) -> u64 { move left / move right }
__g1_u64_rem(left: u64, right: u64) -> u64 { move left % move right }
__g1_u128_div(left: u128, right: u128) -> u128 { move left / move right }
__g1_u128_rem(left: u128, right: u128) -> u128 { move left % move right }
__g1_i64_div(left: i64, right: i64) -> i64 { move left / move right }
__g1_i64_rem(left: i64, right: i64) -> i64 { move left % move right }
__g1_i128_div(left: i128, right: i128) -> i128 { move left / move right }
__g1_i128_rem(left: i128, right: i128) -> i128 { move left % move right }
__g1_i64_negate_digit(value: i64) -> i64 { 0 - move value }

__g1_string_builder_push_digit(
    value: &mut StringBuilder,
    digit: u64
) -> () {
    __g1_string_builder_push_byte(
        move value,
        wrapping_convert_to_u8(__g1_u64_add(move digit, 48))
    )
}

__g1_string_builder_append_u64_digits(
    builder: &mut StringBuilder,
    value: u64
) -> () {
    handle perform __VecBoolCase::inspect(value < 10) {
        __VecBoolCase::inspect(Result::Ok(_)) =>
            __g1_string_builder_push_digit(move builder, move value),
        __VecBoolCase::inspect(Result::Err(_)) => {
            let quotient = __g1_u64_div(value, 10);
            let remainder = __g1_u64_rem(value, 10);
            __g1_string_builder_append_u64_digits(
                &mut *builder,
                move quotient
            );
            __g1_string_builder_push_digit(move builder, move remainder)
        }
    }
}

__g1_string_builder_append_u64(
    value: &mut StringBuilder,
