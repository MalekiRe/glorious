// Whole-shell byte conversion is the only public bridge to the internal
// Array<u8> primitives. Vec's private-field authority is exercised here, and
// the moved dense shell cannot be observed or reused by the caller.
__g1_vec_u8_into_array(value: Vec<u8>) -> Array<u8> {
    let Vec { storage } = move value;
    storage
}

__g1_bytes_from_vec(value: Vec<u8>) -> Bytes {
    __g1_bytes_from_array_move(__g1_vec_u8_into_array(move value))
}

__g1_bytes_to_vec(value: Bytes) -> Vec<u8> {
    __g1_vec_from_array(__g1_bytes_to_array(move value))
}

