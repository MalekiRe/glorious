// Layer 3c: compiler construction toolkit. These are ordinary source types.
// Their private fields centralize representation access here; public raw-ID
// constructors remain explicit for serialization and trusted table plumbing.
enum ToolkitCapacityError { IdSpaceExhausted, CounterOverflow }

struct Id<Tag> { private raw: u32 }

impl < Tag > Use<[0, *]> for Id<Tag> {}

impl < Tag > Equal for Id<Tag> {
    ==(self: Id<Tag>, other: Id<Tag>) -> Bool {
        __g1_bool_from_u32(__g1_int_equal(self.raw, other.raw))
    }
}

impl < Tag > Eq for Id<Tag> {
    eq(self: &Id<Tag>, other: &Id<Tag>) -> Bool {
        __g1_bool_from_u32(__g1_int_equal(self.raw, other.raw))
    }
}

impl < Tag > Hash for Id<Tag> {
    hash(self: &Id<Tag>, state: &mut Hasher) {
        __g1_hasher_write_u32(move state, self.raw)
    }
}

__g1_id_from_u32<Tag>(raw: u32) -> Id<Tag> { Id { raw: move raw } }

// The witness-bearing form is useful in generic source when the tag appears
// only in the result and therefore cannot be inferred from a call argument.
__g1_id_with_tag<Tag>(raw: u32, tag: &Tag) -> Id<Tag> {
    tag;
    Id { raw: move raw }
}

__g1_id_from_usize<Tag>(raw: usize) -> Option<Id<Tag>> {
    handle checked_usize_to_u32(raw) {
        Result::Ok(value) => Option::Some(__g1_id_from_u32(move value)),
        Result::Err(_) => None
    }
}

__g1_id_to_u32<Tag>(value: Id<Tag>) -> u32 { value.raw }

__g1_id_to_usize<Tag>(value: Id<Tag>) -> usize { wrapping_convert_to_usize(value.raw) }

id_fits_usize(raw: usize) -> Bool {
    handle checked_usize_to_u32(raw) { Result::Ok(_) => true, Result::Err(_) => false }
}

let Id::from_u32 = __g1_id_from_u32;
let Id::with_tag = __g1_id_with_tag;
let Id::from_usize = __g1_id_from_usize;
let Id::to_u32 = __g1_id_to_u32;
let Id::to_usize = __g1_id_to_usize;
struct IndexVec<I, T> { private values: Vec<T>, private length: usize }

__g1_index_vec_new<I, T>() -> IndexVec<I, T> { IndexVec { values: Vec::new(), length: 0 } }

__g1_index_vec_len<I, T>(value: &IndexVec<I, T>) -> usize { value.length }

__g1_index_vec_is_empty<I, T>(value: &IndexVec<I, T>) -> Bool { value.length == 0 }

__g1_index_vec_make_id<I, T>(value: &IndexVec<I, T>, raw: u32) -> Id<I> {
    value;
    Id { raw: move raw }
}

__g1_index_vec_push<I, T>(value: &mut IndexVec<I, T>, item: T) -> Result<Id<I>, T> {
    let length = value.length;
    let converted = checked_usize_to_u32(length);
    handle move converted {
        Result::Ok(raw) => {
            let id = __g1_index_vec_make_id(&*value, move raw);
            Vec::push(&mut value.values, move item);
            (*value).length = length + 1;
            Result::Ok(move id)
        },
        Result::Err(_) => Result::Err(move item)
    }
}

__g1_index_vec_get<'a, I, T>(value: &'a IndexVec<I, T>, id: Id<I>) -> Option<& 'a T> {
    Vec::get(&value.values, Id::to_usize(move id))
}

__g1_index_vec_get_mut<'a, I, T>(value: &'a mut IndexVec<I, T>, id: Id<I>) -> Option<& 'a mut T> {
    Vec::get_mut(&mut value.values, Id::to_usize(move id))
}

__g1_index_vec_index<'a, I, T>(value: &'a IndexVec<I, T>, id: Id<I>) -> &'a T {
    Vec::index(&value.values, Id::to_usize(move id))
}

__g1_index_vec_index_mut<'a, I, T>(value: &'a mut IndexVec<I, T>, id: Id<I>) -> &'a mut T {
    Vec::index_mut(&mut value.values, Id::to_usize(move id))
}

__g1_index_vec_pop<I, T>(value: &mut IndexVec<I, T>) -> Option<T> {
    let length = value.length;
    handle length == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => {
            let item = __g1_array_pop_move(&mut value.values.storage);
            (*value).length = length - 1;
            Option::Some(move item)
        }
    }
}

__g1_index_vec_truncate<I, T>(value: &mut IndexVec<I, T>, length: usize)
where T: Use<[0, 0]> {
    let current = value.length;
    if(length < current) {
        let removed = __g1_array_pop_move(&mut value.values.storage);
        (*value).length = current - 1;
        removed;
        __g1_index_vec_truncate(move value, length)
    } else {
        ()
    }
}

struct IndexVecCheckpoint<'a, I, T> {
    private value: &'a mut IndexVec<I, T>,
    private length: usize,
    private armed: Bool
}

impl<'a, I, T> Drop for IndexVecCheckpoint<'a, I, T> where T: Use<[0, 0]> {
    drop(&mut self) -> {
        if(self.armed) {
            __g1_index_vec_truncate(&mut *self.value, self.length)
        } else {
            ()
        }
    }
}

__g1_index_vec_checkpoint<'a, I, T>(
    value: &'a mut IndexVec<I, T>
) -> IndexVecCheckpoint<'a, I, T>
where T: Use<[0, 0]> {
    let length = __g1_index_vec_len(&*value);
    IndexVecCheckpoint { value: move value, length: move length, armed: true }
}

__g1_index_vec_checkpoint_commit<'a, I, T>(
    checkpoint: &mut IndexVecCheckpoint<'a, I, T>
) {
    (*checkpoint).armed = false;
    ()
}

__g1_index_vec_with_range<I, T, F, e: EffectRow>(
    value: &mut IndexVec<I, T>,
    body: F
) -> Range<usize>
where T: Use<[0, 0]>,
F: Fn<(&mut IndexVec<I, T>,), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    let checkpoint = __g1_index_vec_checkpoint(move value);
    let start = checkpoint.length;
    body(&mut *checkpoint.value);
    let end = __g1_index_vec_len(&*checkpoint.value);
    __g1_index_vec_checkpoint_commit(&mut checkpoint);
    Range { start: move start, end: move end }
}

__g1_index_vec_try_with_range<I, T, E, F, e: EffectRow>(
    value: &mut IndexVec<I, T>,
    body: F
) -> Result<Range<usize>, E>
where T: Use<[0, 0]>,
F: Fn<(&mut IndexVec<I, T>,), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    @failed: Result<Range<usize>, E> {
        let checkpoint = __g1_index_vec_checkpoint(move value);
        let start = checkpoint.length;
        try(body(&mut *checkpoint.value), @failed);
        let end = __g1_index_vec_len(&*checkpoint.value);
        __g1_index_vec_checkpoint_commit(&mut checkpoint);
        Result::Ok(Range { start: move start, end: move end })
    }
}

__g1_index_vec_get_copy<I, T>(value: &IndexVec<I, T>, id: Id<I>) -> Option<T> where T: Use<[0, *]> {
    let raw = wrapping_convert_to_usize(id.raw);
    handle raw < value.length {
        Result::Ok(_) => Option::Some(__g1_array_get_copy(&value.values.storage, raw)),
        Result::Err(_) => None
    }
}

__g1_index_vec_replace<I, T>(value: &mut IndexVec<I, T>, id: Id<I>, incoming: T) -> Result<T, T> {
    let raw = wrapping_convert_to_usize(id.raw);
    let length = value.length;
    handle raw < length {
        Result::Ok(_) => {
            let previous = __g1_array_get_move(&mut value.values.storage, raw);
            __g1_array_set_move(&mut value.values.storage, raw, move incoming);
            Result::Ok(move previous)
        },
        Result::Err(_) => Result::Err(move incoming)
    }
}

// IndexVec traversal exposes the canonical branded ID beside each borrowed
// element. The collection invariant established by push means every visited
// ordinal has an exact u32 representation; callers never need to reconstruct
// that relationship through integer conversions and a second lookup.
__g1_index_vec_for_each_step<'a, I, T, F, e: EffectRow>(
    base: &'a Array<T>,
    index: usize,
    length: usize,
    body: F
)
where F: Fn<(Id<I>, &'a T), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        body(
            Id { raw: wrapping_convert_to_u32(index) },
            __g1_array_get_borrow_shared(base, index)
        );
        __g1_index_vec_for_each_step(base, index + 1, length, body)
    } else {
        ()
    }
}

__g1_index_vec_for_each<'a, I, T, F, e: EffectRow>(
    value: &'a IndexVec<I, T>,
    body: F
)
where F: Fn<(Id<I>, &'a T), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    __g1_index_vec_for_each_step(&value.values.storage, 0, value.length, body)
}

__g1_index_vec_try_for_each_step<'a, I, T, E, F, e: EffectRow>(
    base: &'a Array<T>,
    index: usize,
    length: usize,
    body: F
) -> Result<(), E>
where F: Fn<(Id<I>, &'a T), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        handle body(
            Id { raw: wrapping_convert_to_u32(index) },
            __g1_array_get_borrow_shared(base, index)
        ) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => __g1_index_vec_try_for_each_step(
                base,
                index + 1,
                length,
                body
            )
        }
    } else {
        Result::Ok(())
    }
}

__g1_index_vec_try_for_each<'a, I, T, E, F, e: EffectRow>(
    value: &'a IndexVec<I, T>,
    body: F
) -> Result<(), E>
where F: Fn<(Id<I>, &'a T), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_index_vec_try_for_each_step(&value.values.storage, 0, value.length, body)
}

__g1_index_vec_fold_step<'a, I, T, A, F, e: EffectRow>(
    base: &'a Array<T>,
    index: usize,
    length: usize,
    accumulator: A,
    body: F
) -> A
where F: Fn<(A, Id<I>, &'a T), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        __g1_index_vec_fold_step(
            base,
            index + 1,
            length,
            body(
                accumulator,
                Id { raw: wrapping_convert_to_u32(index) },
                __g1_array_get_borrow_shared(base, index)
            ),
            body
        )
    } else {
        accumulator
    }
}

__g1_index_vec_fold<'a, I, T, A, F, e: EffectRow>(
    value: &'a IndexVec<I, T>,
    seed: A,
    body: F
) -> A
where F: Fn<(A, Id<I>, &'a T), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_index_vec_fold_step(&value.values.storage, 0, value.length, seed, body)
}

__g1_index_vec_try_fold_step<'a, I, T, A, E, F, e: EffectRow>(
    base: &'a Array<T>,
    index: usize,
    length: usize,
    accumulator: A,
    body: F
) -> Result<A, E>
where F: Fn<(A, Id<I>, &'a T), Output=Result<A, E>, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        handle body(
            accumulator,
            Id { raw: wrapping_convert_to_u32(index) },
            __g1_array_get_borrow_shared(base, index)
        ) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(next) => __g1_index_vec_try_fold_step(
                base,
                index + 1,
                length,
                next,
                body
            )
        }
    } else {
        Result::Ok(accumulator)
    }
}

__g1_index_vec_try_fold<'a, I, T, A, E, F, e: EffectRow>(
    value: &'a IndexVec<I, T>,
    seed: A,
    body: F
) -> Result<A, E>
where F: Fn<(A, Id<I>, &'a T), Output=Result<A, E>, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_index_vec_try_fold_step(&value.values.storage, 0, value.length, seed, body)
}

