    handle shift < 0 {
        Result::Ok(_) => {
            let scaled_denominator = __g1_float_big_clone(denominator);
            __g1_float_big_shift_left(&mut scaled_denominator, wrapping_convert_to_usize(0 - shift));
            (
                __g1_float_divide_bits(__g1_float_big_clone(numerator), &scaled_denominator),
                move scaled_denominator
            )
        },
        Result::Err(_) => {
            let scaled_numerator = __g1_float_big_clone(numerator);
            __g1_float_big_shift_left(&mut scaled_numerator, wrapping_convert_to_usize(shift));
            (
                __g1_float_divide_bits(move scaled_numerator, denominator),
                __g1_float_big_clone(denominator)
            )
        }
    }
}

__g1_float_round_division(division: __FloatDivision, denominator: &__FloatBig) -> u64 {
    let __FloatDivision { quotient, remainder } = move division;
    __g1_float_big_shift_left_one(&mut remainder);
    let comparison = __g1_float_big_compare(&remainder, denominator);
    handle comparison < 0 {
        Result::Ok(_) => move quotient,
        Result::Err(_) => handle comparison == 0 {
            Result::Ok(_) => handle __g1_integer_equal(bit_and(quotient, 1), 0) {
                Result::Ok(_) => move quotient,
                Result::Err(_) => quotient + 1
            },
            Result::Err(_) => quotient + 1
        }
    }
}

__g1_float_encode_nonzero(
    ratio: __FloatRatio,
    precision: usize,
    fraction_bits: u32,
    minimum_exponent: i64,
    maximum_exponent: i64,
    bias: i64,
    sign_mask: u64
) -> Result<u64, FloatParseError> {
    let __FloatRatio { numerator, denominator, negative, end } = move ratio;
    let actual_exponent = __g1_float_floor_binary_exponent(&numerator, &denominator);
    let target_exponent = handle actual_exponent < minimum_exponent {
        Result::Ok(_) => move minimum_exponent,
        Result::Err(_) => move actual_exponent
    };
    let shift = wrapping_convert_to_i64(precision - 1) - target_exponent;
    let scaled = __g1_float_scaled_division(&numerator, &denominator, move shift);
    let(division, scaled_denominator) = move scaled;
    let significand = __g1_float_round_division(move division, &scaled_denominator);
    let carry = shift_left(wrapping_convert_to_u64(1), wrapping_convert_to_u32(precision));
    let rounded_exponent = handle __g1_integer_equal(significand, carry) {
        Result::Ok(_) => target_exponent + 1,
        Result::Err(_) => move target_exponent
    };
    let rounded_significand = handle __g1_integer_equal(significand, carry) {
        Result::Ok(_) => shift_right(significand, 1),
        Result::Err(_) => move significand
    };
    handle maximum_exponent < rounded_exponent {
        Result::Ok(_) => Result::Err(FloatParseError::Overflow(end - 1)),
        Result::Err(_) => {
            let hidden = shift_left(wrapping_convert_to_u64(1), fraction_bits);
            let magnitude_bits = handle __g1_integer_less(rounded_significand, hidden) {
                Result::Ok(_) => move rounded_significand,
                Result::Err(_) => {
                    let exponent_field = wrapping_convert_to_u64(rounded_exponent + bias);
                    bit_or(shift_left(exponent_field, fraction_bits), rounded_significand - hidden)
                }
            };
            let bits = handle move negative {
                Result::Ok(_) => bit_or(move magnitude_bits, move sign_mask),
                Result::Err(_) => move magnitude_bits
            };
            Result::Ok(move bits)
        }
    }
}

__g1_float_definitely_overflows_decimal(
    fraction_digits: usize,
    exponent_negative: Bool,
    exponent: usize
) -> Bool {
    handle move exponent_negative {
        Result::Ok(_) => false,
        Result::Err(_) => fraction_digits + 400 < exponent
    }
}

__g1_float_definitely_underflows_decimal(
    fraction_digits: usize,
    exponent_negative: Bool,
    exponent: usize,
    source_end: usize
) -> Bool {
    handle move exponent_negative {
        Result::Ok(_) => source_end + 400 < fraction_digits + exponent,
        Result::Err(_) => handle exponent < fraction_digits {
            Result::Ok(_) => source_end + 400 < fraction_digits - exponent,
            Result::Err(_) => false
        }
    }
}

__g1_float_signed_zero_bits(negative: Bool, sign_mask: u64) -> u64 {
    handle move negative {
        Result::Ok(_) => move sign_mask,
        Result::Err(_) => wrapping_convert_to_u64(0)
    }
}

__g1_float_encode(
    parsed: __FloatParsed,
    precision: usize,
    fraction_bits: u32,
    minimum_exponent: i64,
    maximum_exponent: i64,
    bias: i64,
    sign_mask: u64
) -> Result<u64, FloatParseError> {
    let __FloatParsed { magnitude, negative, fraction_digits, exponent_negative, exponent, end } = move parsed;
    let zero = __g1_float_big_is_zero(&magnitude);
    handle __g1_float_big_branch(move magnitude, move zero) {
        Result::Ok(zero_magnitude) => {
            let bits = handle move negative {
                Result::Ok(_) => move sign_mask,
                Result::Err(_) => wrapping_convert_to_u64(0)
            };
            zero_magnitude;
            Result::Ok(move bits)
        },
        Result::Err(nonzero_magnitude) => {
            let overflow = __g1_float_definitely_overflows_decimal(
                fraction_digits,
                exponent_negative,
                exponent
            );
            handle __g1_float_big_branch(move nonzero_magnitude, move overflow) {
                Result::Ok(too_large) => {
                    too_large;
                    Result::Err(FloatParseError::Overflow(end - 1))
                },
                Result::Err(not_large) => {
                    let underflow = __g1_float_definitely_underflows_decimal(
                        fraction_digits,
                        exponent_negative,
                        exponent,
                        end
                    );
                    handle __g1_float_big_branch(move not_large, move underflow) {
                        Result::Ok(too_small) => {
                            too_small;
                            Result::Ok(__g1_float_signed_zero_bits(move negative, move sign_mask))
                        },
                        Result::Err(exact) => __g1_float_encode_nonzero(
                            __g1_float_ratio(
                                __FloatParsed {
                                    magnitude: move exact,
                                    negative: move negative,
                                    fraction_digits: move fraction_digits,
                                    exponent_negative: move exponent_negative,
                                    exponent: move exponent,
                                    end: move end
                                }
                            ),
                            move precision,
                            move fraction_bits,
                            move minimum_exponent,
                            move maximum_exponent,
                            move bias,
                            move sign_mask
                        )
                    }
                }
            }
        }
    }
}

parse_f32(value: &String) -> Result<f32, FloatParseError> {
    handle __g1_float_parse_syntax(value) {
        Result::Ok(parsed) => handle __g1_float_encode(
            move parsed,
            24,
            23,
            -126,
            127,
            127,
            2147483648
        ) {
            Result::Ok(bits) => Result::Ok(f32_from_bits(wrapping_convert_to_u32(bits))),
            Result::Err(error) => Result::Err(move error)
        },
        Result::Err(error) => Result::Err(move error)
    }
}

parse_f64(value: &String) -> Result<f64, FloatParseError> {
    handle __g1_float_parse_syntax(value) {
        Result::Ok(parsed) => handle __g1_float_encode(
            move parsed,
            53,
