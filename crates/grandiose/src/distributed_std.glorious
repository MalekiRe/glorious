__g1_chars_next(value: &mut Chars) -> Option<char> {
    let index = value.index;
    let end = value.end;
    let bytes = value.bytes;
    handle index < end {
        Result::Ok(_) => handle __g1_char_decode_utf8(&bytes, move index) {
            Result::Ok(decoded) => {
