impl Eq for String { eq(self: &String, other: &String) -> Bool { String::eq(self, other) } }

impl Equal for String {
    ==(self: String, other: String) -> Bool { String::eq(&self, &other) }
}

impl Ord for String {
    cmp(self: &String, other: &String) -> Ordering {
        let left = String::as_bytes(self);
        let right = String::as_bytes(other);
        __g1_bytes_cmp(&left, &right)
    }
}

impl Hash for String {
    hash(self: &String, state: &mut Hasher) {
        let bytes = String::as_bytes(self);
        Hasher::write_bytes(move state, &bytes)
    }
}

impl Eq for Bytes { eq(self: &Bytes, other: &Bytes) -> Bool { Bytes::eq(self, other) } }

impl Ord for Bytes { cmp(self: &Bytes, other: &Bytes) -> Ordering { __g1_bytes_cmp(self, other) } }

impl Hash for Bytes {
    hash(self: &Bytes, state: &mut Hasher) { Hasher::write_bytes(move state, self) }
}

