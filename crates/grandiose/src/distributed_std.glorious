    handle raw < value.sparse_length {
        Result::Ok(_) => {
            let dense_index = __g1_sparse_set_sparse_at(value, raw);
            handle dense_index < value.dense_length {
                Result::Ok(_) => __g1_sparse_set_dense_at(value, dense_index).raw == id.raw,
                Result::Err(_) => false
            }
        },
        Result::Err(_) => false
    }
