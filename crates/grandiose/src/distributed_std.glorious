}

__g1_integer_less<T>(left: T, right: T) -> Bool {
    __g1_bool_from_u32(__g1_int_less(move left, move right))
}

__g1_integer_add<T>(left: T, right: T) -> T {
    __g1_int_checked_add(move left, move right)
}

