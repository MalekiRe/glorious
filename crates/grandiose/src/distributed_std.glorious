}

__g1_sparse_set_dense_at<I>(value: &SparseSet<I>, index: usize) -> Id<I> {
    __g1_array_get_copy(&value.dense.storage, move index)
}

__g1_sparse_set_write_sparse<I>(value: &mut SparseSet<I>, raw: usize, dense_index: usize) {
