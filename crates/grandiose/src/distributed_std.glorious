impl Default for String { default() -> String { String::empty() } }

impl Default for Bytes { default() -> Bytes { b"" } }

__g1_default<T>() -> T where T: Default { Default::default() }

// Move the current value out while immediately restoring a valid default.
// `replace` keeps the unique place initialized even when `T` itself cannot be
// implicitly discarded.
take<T>(target: &mut T) -> T where T: Default { replace(move target, __g1_default()) }

__g1_ordering_from_flags(less: Bool, equal: Bool) -> Ordering {
    handle move less {
        Result::Ok(_) => Ordering::Less,
        Result::Err(_) => handle move equal {
            Result::Ok(_) => Ordering::Equal,
            Result::Err(_) => Ordering::Greater
        }
    }
}

__g1_bytes_cmp_at(left: &Bytes, right: &Bytes, index: usize, shared: usize) -> Ordering {
    handle index < shared {
        Result::Ok(_) => {
            let left_byte = __g1_bytes_get(*left, index);
            let right_byte = __g1_bytes_get(*right, index);
            handle __g1_integer_equal(left_byte, right_byte) {
                Result::Ok(_) => __g1_bytes_cmp_at(
                    left,
                    right,
                    __g1_usize_successor(move index),
                    move shared
                ),
                Result::Err(_) => __g1_ordering_from_flags(
                    __g1_integer_less(left_byte, right_byte),
                    false
                )
            }
        },
        Result::Err(_) => {
            let left_length = __g1_bytes_len(*left);
            let right_length = __g1_bytes_len(*right);
            __g1_ordering_from_flags(
                __g1_integer_less(left_length, right_length),
                __g1_integer_equal(left_length, right_length)
            )
        }
    }
}

__g1_bytes_cmp(left: &Bytes, right: &Bytes) -> Ordering {
    let left_length = __g1_bytes_len(*left);
    let right_length = __g1_bytes_len(*right);
    let shared = handle __g1_integer_less(left_length, right_length) {
        Result::Ok(_) => move left_length,
        Result::Err(_) => move right_length
    };
    __g1_bytes_cmp_at(left, right, 0, move shared)
}

__g1_debug_literal(formatter: &mut Formatter, text: String) {
    Formatter::literal(move formatter, &text)
}

__g1_debug_string_character(formatter: &mut Formatter, value: char) {
    let scalar = __g1_char_to_u32(move value);
    handle scalar == 34 {
        Result::Ok(_) => __g1_debug_literal(move formatter, "\\\""),
        Result::Err(_) => handle scalar == 92 {
            Result::Ok(_) => __g1_debug_literal(move formatter, "\\\\"),
            Result::Err(_) => handle scalar == 10 {
                Result::Ok(_) => __g1_debug_literal(move formatter, "\\n"),
                Result::Err(_) => handle scalar == 13 {
                    Result::Ok(_) => __g1_debug_literal(move formatter, "\\r"),
                    Result::Err(_) => handle scalar == 9 {
                        Result::Ok(_) => __g1_debug_literal(move formatter, "\\t"),
                        Result::Err(_) => handle scalar == 0 {
                            Result::Ok(_) => __g1_debug_literal(move formatter, "\\0"),
                            Result::Err(_) => Formatter::append_char(
                                move formatter,
                                __g1_char_from_u32_checked(move scalar)
                            )
                        }
                    }
                }
            }
        }
    }
}

__g1_debug_char_character(formatter: &mut Formatter, value: char) {
    let scalar = char_to_u32(move value);
    handle scalar == 39 {
        Result::Ok(_) => __g1_debug_literal(move formatter, "\\'"),
        Result::Err(_) => __g1_debug_string_character(
            move formatter,
            __g1_char_from_u32_checked(move scalar)
        )
    }
}

__g1_debug_char(formatter: &mut Formatter, value: char) {
    __g1_debug_literal(&mut *formatter, "'");
    __g1_debug_char_character(&mut *formatter, move value);
    __g1_debug_literal(move formatter, "'")
}

__g1_debug_string_at(formatter: &mut Formatter, bytes: &Bytes, index: usize, length: usize) {
    handle index < length {
        Result::Ok(_) => handle char_decode_utf8(bytes, index) {
            Result::Ok(decoded) => {
                let DecodedChar { value, next } = move decoded;
                __g1_debug_string_character(&mut *formatter, move value);
                __g1_debug_string_at(move formatter, bytes, move next, move length)
            },
            Result::Err(error) => {
                let Utf8Error { valid_up_to: _ } = move error;
                ()
            }
        },
        Result::Err(_) => ()
    }
}

__g1_debug_string(formatter: &mut Formatter, value: &String) {
    __g1_debug_literal(&mut *formatter, "\"");
    let bytes = String::as_bytes(value);
    let length = Bytes::len(&bytes);
    __g1_debug_string_at(&mut *formatter, &bytes, 0, move length);
    __g1_debug_literal(move formatter, "\"")
}

__g1_debug_bytes_at(formatter: &mut Formatter, value: &Bytes, index: usize, length: usize) {
    handle index < length {
        Result::Ok(_) => {
            handle index == 0 {
                Result::Ok(_) => (),
                Result::Err(_) => __g1_debug_literal(&mut *formatter, ", ")
            };
            Formatter::append_u64(
                &mut *formatter,
                wrapping_convert_to_u64(__g1_bytes_get(*value, index))
            );
            __g1_debug_bytes_at(
                move formatter,
                value,
                __g1_usize_successor(move index),
                move length
            )
        },
        Result::Err(_) => ()
    }
}

__g1_debug_bytes(formatter: &mut Formatter, value: &Bytes) {
    __g1_debug_literal(&mut *formatter, "b[");
    __g1_debug_bytes_at(&mut *formatter, value, 0, Bytes::len(value));
    __g1_debug_literal(move formatter, "]")
}

