struct __DrainStackState<T, A> { work: Stack<T>, accumulator: A }

drain_stack<T, A, F, e: EffectRow>(work: Stack<T>, seed: A, body: F) -> A
where T: Use<[0, 0]>,
F: Fn<(A, T), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    loop_state(
        __DrainStackState { work: move work, accumulator: move seed },
        @drain_stack,
        { state, destination => {
            let __DrainStackState { work, accumulator } = move state;
            handle Stack::pop(&mut work) {
                Result::Err(_) => {
                    work;
                    move accumulator
                },
                Result::Ok(item) => loop_continue(
                    __DrainStackState {
                        work: move work,
                        accumulator: body(move accumulator, move item)
                    },
                    destination
                )
            }
        }}
    )
}

struct __DrainQueueState<T, A> { work: WorkList<T>, accumulator: A }

drain_queue<T, A, F, e: EffectRow>(work: WorkList<T>, seed: A, body: F) -> A
where T: Use<[0, 0]>,
F: Fn<(A, T), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    loop_state(
        __DrainQueueState { work: move work, accumulator: move seed },
        @drain_queue,
        { state, destination => {
            let __DrainQueueState { work, accumulator } = move state;
            handle WorkList::pop(&mut work) {
                Result::Err(_) => {
                    work;
                    move accumulator
                },
                Result::Ok(item) => loop_continue(
                    __DrainQueueState {
                        work: move work,
                        accumulator: body(move accumulator, move item)
                    },
                    destination
                )
            }
        }}
    )
}

pub struct WorklistUpdate<T, A> { work: WorkList<T>, accumulator: A }

pub worklist_update<T, A>(work: WorkList<T>, accumulator: A) -> WorklistUpdate<T, A> {
    WorklistUpdate { work: move work, accumulator: move accumulator }
}

struct __DrainWorklistState<T, A> { work: WorkList<T>, accumulator: A }

drain_worklist<T, A, F, e: EffectRow>(
    work: WorkList<T>,
    seed: A,
    body: F
) -> A
where T: Use<[0, 0]>,
F: Fn<(A, T, WorkList<T>), Output=WorklistUpdate<T, A>, Effects={| e}>,
F: Use<[0, 0]> {
    loop_state(
        __DrainWorklistState { work: move work, accumulator: move seed },
        @drain_worklist,
        { state, destination => {
            let __DrainWorklistState { work, accumulator } = move state;
            handle WorkList::pop(&mut work) {
                Result::Err(_) => {
                    work;
                    move accumulator
                },
                Result::Ok(item) => {
                    let WorklistUpdate { work: next_work, accumulator: next } =
                        body(move accumulator, move item, move work);
                    loop_continue(
                        __DrainWorklistState {
                            work: move next_work,
                            accumulator: move next
                        },
                        destination
                    )
                }
            }
        }}
    )
}

solve_worklist<T, A, F, e: EffectRow>(work: WorkList<T>, seed: A, body: F) -> A
where T: Use<[0, 0]>,
F: Fn<(A, T, WorkList<T>), Output=WorklistUpdate<T, A>, Effects={| e}>,
F: Use<[0, 0]> {
    drain_worklist(work, seed, body)
}

propagate_graph<T, A, F, e: EffectRow>(work: WorkList<T>, seed: A, body: F) -> A
where T: Use<[0, 0]>,
F: Fn<(A, T, WorkList<T>), Output=WorklistUpdate<T, A>, Effects={| e}>,
F: Use<[0, 0]> {
    drain_worklist(work, seed, body)
}

pub enum WorklistFailure { StepLimitExceeded }

// Queue policy belongs to the engine, while the callback owns the analysis
// domain and merge rule. The append-only queue prefix is the visited set and
// its suffix is the enqueued set. Linear membership is deliberate here: it
// keeps label-capable callbacks independent of HashMap's generic probe engine,
// and compiler clients can choose compact integer work keys.
pub struct WorklistSolver<T> {
    private work: Vec<T>,
    private pending: Vec<T>,
    private pending_cursor: usize,
    private scan_cursor: usize,
    private cursor: usize,
    private remaining: usize
}

pub struct WorklistStep<T, A> {
    private dependents: Vec<T>,
    private accumulator: A
}

worklist_step<T, A>(
    dependents: Vec<T>,
    accumulator: A
) -> WorklistStep<T, A> {
    WorklistStep {
        dependents: move dependents,
        accumulator: move accumulator
    }
}

__g1_worklist_solver_new<T>(limit: usize) -> WorklistSolver<T> {
    WorklistSolver {
        work: Vec::new(),
        pending: Vec::new(),
        pending_cursor: 0,
        scan_cursor: 0,
        cursor: 0,
        remaining: move limit
    }
}

__g1_worklist_solver_contains<T>(
    value: &WorklistSolver<T>,
    item: &T,
    index: usize,
    end: usize
) -> Bool
where T: Eq {
    if(index < end) {
        if(*Vec::index(&value.work, index) == *item) {
            true
        } else {
            __g1_worklist_solver_contains(move value, move item, index + 1, end)
        }
    } else { false }
}

__g1_worklist_solver_enqueue<T>(value: &mut WorklistSolver<T>, item: T) -> Bool
where T: Eq,
T: Use<[0, *]> {
    let cursor = value.cursor;
    let end = Vec::len(&value.work);
    let duplicate = __g1_worklist_solver_contains(&*value, &item, cursor, end);
    handle duplicate {
        Result::Ok(_) => false,
        Result::Err(_) => {
            Vec::push(&mut value.work, item);
            true
        }
    }
}

__g1_worklist_solver_visited<T>(value: &WorklistSolver<T>, item: &T) -> Bool
where T: Eq,
T: Use<[0, *]> {
    __g1_worklist_solver_contains(value, item, 0, value.cursor)
}

__g1_worklist_solver_work_at<T>(value: &WorklistSolver<T>, index: usize) -> T
where T: Use<[0, *]> {
    *Vec::index(&value.work, index)
}

__g1_worklist_solver_pending_at<T>(value: &WorklistSolver<T>, index: usize) -> T
where T: Use<[0, *]> {
    *Vec::index(&value.pending, index)
}

__g1_solve_worklist_bounded_step<T, A, F, e: EffectRow>(
    value: WorklistSolver<T>,
    accumulator: A,
    body: F
) -> Result<A, WorklistFailure>
where T: Eq,
T: Use<[0, *]>,
F: Fn<(A, T), Output=WorklistStep<T, A>, Effects={| e}>,
F: Use<[0, 0]> {
    if(value.pending_cursor < Vec::len(&value.pending)) {
        if(value.scan_cursor < Vec::len(&value.work)) {
            let dependent = __g1_worklist_solver_pending_at(&value, value.pending_cursor);
            let existing = __g1_worklist_solver_work_at(&value, value.scan_cursor);
            if(existing == dependent) {
                value.pending_cursor = value.pending_cursor + 1;
                value.scan_cursor = value.cursor;
                __g1_solve_worklist_bounded_step(move value, move accumulator, body)
            } else {
                value.scan_cursor = value.scan_cursor + 1;
                __g1_solve_worklist_bounded_step(move value, move accumulator, body)
            }
        } else {
            let dependent = __g1_worklist_solver_pending_at(&value, value.pending_cursor);
            Vec::push(&mut value.work, move dependent);
            value.pending_cursor = value.pending_cursor + 1;
            value.scan_cursor = value.cursor;
            __g1_solve_worklist_bounded_step(move value, move accumulator, body)
        }
    } else {
        if(value.cursor < Vec::len(&value.work)) {
            if(value.remaining == 0) {
                value;
                accumulator;
                Result::Err(WorklistFailure::StepLimitExceeded)
            } else {
                let item = __g1_worklist_solver_work_at(&value, value.cursor);
                value.cursor = value.cursor + 1;
                value.remaining = value.remaining - 1;
                let WorklistStep {
                    dependents,
                    accumulator: next
                } = body(move accumulator, item);
                value.pending = move dependents;
                value.pending_cursor = 0;
                value.scan_cursor = value.cursor;
                __g1_solve_worklist_bounded_step(
                    move value,
                    move next,
                    body
                )
            }
        } else {
            value;
            Result::Ok(move accumulator)
        }
    }
}

solve_worklist_bounded<T, A, F, e: EffectRow>(
    value: WorklistSolver<T>,
    seed: A,
    body: F
) -> Result<A, WorklistFailure>
where T: Eq,
T: Use<[0, *]>,
F: Fn<(A, T), Output=WorklistStep<T, A>, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_solve_worklist_bounded_step(move value, move seed, body)
}

let WorklistSolver::new = __g1_worklist_solver_new;
let WorklistSolver::enqueue = __g1_worklist_solver_enqueue;
let WorklistSolver::visited = __g1_worklist_solver_visited;

pub enum Stability<S> {
    Changed(S)
    Stable(S)
}

pub changed<S>(value: S) -> Stability<S> {
    Stability::Changed(move value)
}

pub stable<S>(value: S) -> Stability<S> {
    Stability::Stable(move value)
}

__g1_repeat_until_stable_step<S, F, e: EffectRow>(state: S, body: F) -> S
where F: Fn<(S), Output=Stability<S>, Effects={| e}>,
F: Use<[0, 0]> {
    handle body(state) {
        Stability::Changed(value) => __g1_repeat_until_stable_step(value, body),
        Stability::Stable(value) => value
    }
}

repeat_until_stable<S, F, e: EffectRow>(state: S, body: F) -> S
where F: Fn<(S), Output=Stability<S>, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_repeat_until_stable_step(state, body)
}

fixed_point<S, F, e: EffectRow>(state: S, body: F) -> S
where F: Fn<(S), Output=Stability<S>, Effects={| e}>,
F: Use<[0, 0]> {
    repeat_until_stable(state, body)
}
// Whole-shell byte conversion is the only public bridge to the internal
// Array<u8> primitives. Vec's private-field authority is exercised here, and
// the moved dense shell cannot be observed or reused by the caller.
__g1_vec_u8_into_array(value: Vec<u8>) -> Array<u8> {
    let Vec { storage } = move value;
    storage
}

__g1_bytes_from_vec(value: Vec<u8>) -> Bytes {
    __g1_bytes_from_array_move(__g1_vec_u8_into_array(move value))
}

__g1_bytes_to_vec(value: Bytes) -> Vec<u8> { __g1_vec_from_array(__g1_bytes_to_array(move value)) }

let Bytes::from_vec = __g1_bytes_from_vec;
let Bytes::to_vec = __g1_bytes_to_vec;
// Character encoding and decoding are ordinary source. The only trusted
// operations are the frozen scalar conversion leaves at the top of this file.
// Decoding first validates an exact one-scalar slice, so the checked conversion
// leaf can never receive a surrogate or an out-of-range scalar.
__g1_char_utf8_part(byte: u8, mask: u8) -> u32 {
    wrapping_convert_to_u32(bit_and(move byte, move mask))
}

__g1_char_utf8_continuation(scalar: u32, shift: u32) -> u8 {
    wrapping_convert_to_u8(bit_or(bit_and(shift_right(move scalar, move shift), 63), 128))
}

__g1_char_utf8_lead(scalar: u32, shift: u32, prefix: u32) -> u8 {
    wrapping_convert_to_u8(bit_or(shift_right(move scalar, move shift), move prefix))
}

__g1_char_byte_vec() -> Vec<u8> { __g1_vec_new() }

__g1_char_encode_scalar(bytes: Vec<u8>, scalar: u32) -> Vec<u8> {
    handle scalar <= 127 {
        Result::Ok(_) => {
            __g1_vec_push(&mut bytes, wrapping_convert_to_u8(move scalar));
            bytes
        },
        Result::Err(_) => handle scalar <= 2047 {
            Result::Ok(_) => {
                __g1_vec_push(&mut bytes, __g1_char_utf8_lead(scalar, 6, 192));
                __g1_vec_push(&mut bytes, __g1_char_utf8_continuation(move scalar, 0));
                bytes
            },
            Result::Err(_) => handle scalar <= 65535 {
                Result::Ok(_) => {
                    __g1_vec_push(&mut bytes, __g1_char_utf8_lead(scalar, 12, 224));
                    __g1_vec_push(&mut bytes, __g1_char_utf8_continuation(scalar, 6));
                    __g1_vec_push(&mut bytes, __g1_char_utf8_continuation(move scalar, 0));
                    bytes
                },
                Result::Err(_) => {
                    __g1_vec_push(&mut bytes, __g1_char_utf8_lead(scalar, 18, 240));
                    __g1_vec_push(&mut bytes, __g1_char_utf8_continuation(scalar, 12));
                    __g1_vec_push(&mut bytes, __g1_char_utf8_continuation(scalar, 6));
                    __g1_vec_push(&mut bytes, __g1_char_utf8_continuation(move scalar, 0));
                    bytes
                }
            }
        }
    }
}

__g1_char_encode_utf8(value: char) -> Bytes {
    let scalar = __g1_char_to_u32(move value);
    let bytes = __g1_char_encode_scalar(__g1_char_byte_vec(), move scalar);
    __g1_bytes_from_vec(move bytes)
}

__g1_char_decode_scalar_two(value: Bytes) -> u32 {
    bit_or(
        shift_left(__g1_char_utf8_part(__g1_bytes_get(value, 0), 31), 6),
        __g1_char_utf8_part(__g1_bytes_get(value, 1), 63)
    )
}

__g1_char_decode_scalar_three(value: Bytes) -> u32 {
    bit_or(
        bit_or(
            shift_left(__g1_char_utf8_part(__g1_bytes_get(value, 0), 15), 12),
            shift_left(__g1_char_utf8_part(__g1_bytes_get(value, 1), 63), 6)
        ),
        __g1_char_utf8_part(__g1_bytes_get(value, 2), 63)
    )
}

__g1_char_decode_scalar_four(value: Bytes) -> u32 {
    bit_or(
        bit_or(
            shift_left(__g1_char_utf8_part(__g1_bytes_get(value, 0), 7), 18),
            shift_left(__g1_char_utf8_part(__g1_bytes_get(value, 1), 63), 12)
        ),
        bit_or(
            shift_left(__g1_char_utf8_part(__g1_bytes_get(value, 2), 63), 6),
            __g1_char_utf8_part(__g1_bytes_get(value, 3), 63)
        )
    )
}

__g1_char_decode_scalar(value: Bytes, width: usize) -> u32 {
    handle width == 1 {
        Result::Ok(_) => wrapping_convert_to_u32(__g1_bytes_get(value, 0)),
        Result::Err(_) => handle width == 2 {
            Result::Ok(_) => __g1_char_decode_scalar_two(move value),
            Result::Err(_) => handle width == 3 {
                Result::Ok(_) => __g1_char_decode_scalar_three(move value),
                Result::Err(_) => __g1_char_decode_scalar_four(move value)
            }
        }
    }
}

__g1_char_decode_invalid(index: usize) -> Result<DecodedChar, Utf8Error> {
    Result::Err(Utf8Error { valid_up_to: move index })
}

__g1_char_decode_known(value: Bytes, index: usize, width: usize, length: usize) -> Result<
    DecodedChar,
    Utf8Error
> {
    let end = __g1_usize_add(index, width);
    handle end <= length {
        Result::Ok(_) => {
            let scalar_bytes = __g1_bytes_slice(value, index, end);
            handle __g1_utf8_validate_at(scalar_bytes, 0) {
                Result::Ok(_) => {
                    let scalar = __g1_char_decode_scalar(move scalar_bytes, move width);
                    Result::Ok(
                        DecodedChar {
                            value: __g1_char_from_u32_checked(move scalar),
                            next: move end
                        }
                    )
                },
                Result::Err(_) => __g1_char_decode_invalid(move index)
            }
        },
        Result::Err(_) => __g1_char_decode_invalid(move index)
    }
}

__g1_char_decode_lead(value: Bytes, index: usize, lead: u8, length: usize) -> Result<
    DecodedChar,
    Utf8Error
> {
    handle lead <= 127 {
        Result::Ok(_) => __g1_char_decode_known(move value, move index, 1, move length),
        Result::Err(_) => handle 194 <= lead {
            Result::Ok(_) => handle lead <= 223 {
                Result::Ok(_) => __g1_char_decode_known(move value, move index, 2, move length),
                Result::Err(_) => handle lead <= 239 {
                    Result::Ok(_) => __g1_char_decode_known(move value, move index, 3, move length),
                    Result::Err(_) => handle lead <= 244 {
                        Result::Ok(_) => __g1_char_decode_known(
                            move value,
                            move index,
                            4,
                            move length
                        ),
                        Result::Err(_) => __g1_char_decode_invalid(move index)
                    }
                }
            },
            Result::Err(_) => __g1_char_decode_invalid(move index)
        }
    }
}

__g1_char_decode_utf8(value: &Bytes, index: usize) -> Result<DecodedChar, Utf8Error> {
    let owned = *value;
    let length = __g1_bytes_len(owned);
    handle index < length {
        Result::Ok(_) => {
            let lead = __g1_bytes_get(owned, index);
            __g1_char_decode_lead(move owned, move index, move lead, move length)
        },
        Result::Err(_) => __g1_char_decode_invalid(move index)
    }
}

char_encode_utf8(value: char) -> Bytes { __g1_char_encode_utf8(move value) }

char_decode_utf8(value: &Bytes, index: usize) -> Result<DecodedChar, Utf8Error> {
    __g1_char_decode_utf8(move value, move index)
}

// Validated immutable views retain the cheap Text/Bytes handle and a half-open
// byte range. Private fields are the authority boundary: user source can move
// or borrow a view, but cannot forge a range that reaches the trapping slice
// leaves below.
struct TextView { private text: String, private start: usize, private end: usize }

struct ByteView { private bytes: Bytes, private start: usize, private end: usize }

// Small index-based iterators deliberately retain immutable handles rather
// than materializing slices.  Their private cursors can only advance and every
// read is preceded by a bound check in ordinary source.
struct BytesIter { private bytes: Bytes, private index: usize, private end: usize }

struct Chars { private bytes: Bytes, private index: usize, private end: usize }

struct CharIndices { private bytes: Bytes, private index: usize, private end: usize }

__g1_text_view_ok(value: TextView) -> Result<TextView, TextRangeError> { Result::Ok(move value) }

__g1_text_view_err(error: TextRangeError) -> Result<TextView, TextRangeError> {
    Result::Err(move error)
}

__g1_text_view_new_owned(text: String, range: Range<usize>) -> Result<TextView, TextRangeError> {
    let start = range.start;
    let end = range.end;
    let bytes = __g1_text_as_bytes(text);
    let candidate = TextView { text: move text, start: start, end: end };
    handle start <= end {
        Result::Ok(_) => handle end <= __g1_bytes_len(bytes) {
            Result::Ok(_) => handle __g1_utf8_boundary(bytes, start) {
