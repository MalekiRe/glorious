                    Result::Err(_) => __g1_text_view_err(TextRangeError::NotCharBoundary)
                },
                Result::Err(_) => __g1_text_view_err(TextRangeError::NotCharBoundary)
            },
            Result::Err(_) => __g1_text_view_err(TextRangeError::OutOfBounds)
        },
        Result::Err(_) => __g1_text_view_err(TextRangeError::Reversed)
    }
