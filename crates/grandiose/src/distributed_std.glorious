wrapping_neg<T>(value: T) -> T { wrapping_add(bit_not(move value), 1) }

bit_and<T>(left: T, right: T) -> T { __g1_int_bit_and(move left, move right) }

bit_or<T>(left: T, right: T) -> T { __g1_int_bit_or(move left, move right) }

