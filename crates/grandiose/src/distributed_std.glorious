            -1022,
            1023,
            1023,
            9223372036854775808
        ) {
            Result::Ok(bits) => Result::Ok(f64_from_bits(move bits)),
            Result::Err(error) => Result::Err(move error)
        },
        Result::Err(error) => Result::Err(move error)
    }
}

