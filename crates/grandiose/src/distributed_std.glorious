            let moved_raw = wrapping_convert_to_usize(moved.raw);
            __g1_sparse_set_write_sparse(&mut *value, moved_raw, dense_index);
            __g1_sparse_set_write_sparse(&mut *value, raw, 0);
            true
        },
        Result::Err(_) => {
            __g1_sparse_set_write_sparse(&mut *value, raw, 0);
            true
        }
    }
}

__g1_sparse_set_remove<I>(value: &mut SparseSet<I>, id: Id<I>) -> Bool {
