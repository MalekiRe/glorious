// Float evidence is defined by canonical IEEE bits.  The VM canonicalizes all
// NaNs before exposing bits, so NaN is reflexive and hashable; signed zeroes
// remain distinct and total ordering follows IEEE total-order key layout.
__g1_f32_order_key(value: f32) -> u32 {
    let bits = f32_to_bits(move value);
    handle __g1_integer_equal(bit_and(bits, 2147483648), 0) {
        Result::Ok(_) => bit_xor(move bits, 2147483648),
        Result::Err(_) => bit_not(move bits)
    }
}

__g1_f64_order_key(value: f64) -> u64 {
    let bits = f64_to_bits(move value);
    handle __g1_integer_equal(bit_and(bits, 9223372036854775808), 0) {
        Result::Ok(_) => bit_xor(move bits, 9223372036854775808),
        Result::Err(_) => bit_not(move bits)
    }
}

