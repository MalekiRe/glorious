struct MultiMap<K, V> { private buckets: HashMap<K, Vec<V>> }

__g1_multi_map_new<K, V>() -> MultiMap<K, V> { MultiMap { buckets: HashMap::new() } }

__g1_multi_map_empty_bucket<K, V>(value: &MultiMap<K, V>) -> Vec<V> {
    value;
    Vec::new()
}

__g1_multi_map_key_count<K, V>(value: &MultiMap<K, V>) -> usize { HashMap::len(&value.buckets) }

__g1_multi_map_add<K, V>(value: &mut MultiMap<K, V>, key: K, item: V) where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    let bucket = HashMap::remove(&mut value.buckets, &key);
    handle move bucket {
        Result::Ok(bucket) => {
            Vec::push(&mut bucket, move item);
            HashMap::insert(&mut value.buckets, move key, move bucket);
            ()
        },
        Result::Err(_) => {
            let created = __g1_multi_map_empty_bucket(&*value);
            Vec::push(&mut created, move item);
            HashMap::insert(&mut value.buckets, move key, move created);
            ()
        }
    }
}

__g1_multi_map_get<'a, K, V>(value: &'a MultiMap<K, V>, key: &K) -> Option<& 'a Vec<V>> where K: Eq,
K: Hash { HashMap::get(&value.buckets, move key) }

__g1_multi_map_value_count<K, V>(value: &MultiMap<K, V>, key: &K) -> usize where K: Eq,
K: Hash {
    handle HashMap::get(&value.buckets, move key) {
        Result::Ok(bucket) => Vec::len(move bucket),
        Result::Err(_) => 0
    }
}

