// A private-field ownership cell backed by a zero-or-one element Vec. External
// code cannot destructure `Slot<T>`; it must use these transfers, so a moved
// value is never hidden behind an opaque shell and there is no destroy escape.
struct Slot<T> { private values: Vec<T> }

slot_empty<T>() -> Slot<T> {
    let values = Vec::new();
    Slot { values: move values }
}

slot_filled<T>(value: T) -> Slot<T> {
    let values = Vec::new();
    Vec::push(&mut values, move value);
    Slot { values: move values }
}

slot_take<T>(value: &mut Slot<T>) -> Option<T> {
    let result = Vec::pop(&mut(*value).values);
    move result
}

slot_replace<T>(value: &mut Slot<T>, incoming: T) -> Option<T> {
    let previous = Vec::pop(&mut(*value).values);
    Vec::push(&mut(*value).values, move incoming);
    move previous
}

slot_into_option<T>(value: Slot<T>) -> Option<T> {
    let Slot { values } = move value;
    let result = Vec::pop(&mut values);
    let Vec { storage } = move values;
    __g1_array_finish_drained(move storage);
    move result
}

