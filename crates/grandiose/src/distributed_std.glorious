// gets the familiar LIFO vocabulary without introducing another nominal or VM
// type. Pop transfers its element obligation exactly as Vec::pop does.
type Stack<T> = Vec<T>;
let Stack::new = __g1_vec_new;
let Stack::with_capacity = __g1_vec_with_capacity;
let Stack::len = __g1_vec_len;
let Stack::capacity = __g1_vec_capacity;
let Stack::is_empty = __g1_vec_is_empty;
