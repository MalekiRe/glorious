    handle cursor < length {
        Result::Ok(_) => {
            let contains = __g1_source_map_contains_offset(value, cursor, offset);
            handle move contains {
                Result::Ok(_) => __g1_source_map_location_at(value, cursor, offset),
                Result::Err(_) => __g1_source_map_lookup_at(value, offset, cursor + 1, length)
            }
        },
        Result::Err(_) => None
    }
}

__g1_source_map_lookup(value: &SourceMap, offset: usize) -> Option<SourceLocation> {
    __g1_source_map_lookup_at(value, offset, 0, SourceMap::file_count(value))
}

__g1_source_map_line_at(value: &SourceMap, offset: usize) -> Option<usize> {
    handle __g1_source_map_lookup(value, offset) {
        Result::Ok(location) => Option::Some(move location.line),
        Result::Err(_) => None
    }
}

__g1_source_map_column_at(value: &SourceMap, offset: usize) -> Option<usize> {
    handle __g1_source_map_lookup(value, offset) {
        Result::Ok(location) => Option::Some(move location.column),
        Result::Err(_) => None
    }
}

