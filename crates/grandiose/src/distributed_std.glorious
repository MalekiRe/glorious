// byte order of every integer writer is explicitly little endian, so hashes do
// not depend on the host running the VM.  Hash values are table-local details;
// they are never used as stable artifact identifiers.
struct Hasher { private state: u64 }

__g1_hasher_new() -> Hasher { Hasher { state: wrapping_convert_to_u64(-3750763034362895579) } }

__g1_hasher_write_u8(value: &mut Hasher, byte: u8) {
