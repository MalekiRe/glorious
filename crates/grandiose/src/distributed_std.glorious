__g1_usize_add(left: usize, right: usize) -> usize { move left + move right }

checked_usize_add(left: usize, right: usize) -> Option<usize> {
    let candidate = wrapping_add(left, right);
    handle candidate < left { Result::Ok(_) => None, Result::Err(_) => Option::Some(candidate) }
}

checked_usize_sub(left: usize, right: usize) -> Option<usize> {
    handle left < right { Result::Ok(_) => None, Result::Err(_) => Option::Some(left - right) }
}

checked_usize_mul(left: usize, right: usize) -> Option<usize> {
    handle left == 0 {
        Result::Ok(_) => Option::Some(0),
        Result::Err(_) => {
            let candidate = wrapping_mul(left, right);
            handle candidate / left == right {
                Result::Ok(_) => Option::Some(candidate),
                Result::Err(_) => None
            }
        }
    }
}

// Total queries over half-open usize ranges. Reversed ranges are empty, so
// `len` is saturating. Intersection excludes empty/touching overlap. A checked
// offset is relative to `start` and returns the absolute in-range position.
__g1_range_len(value: &Range<usize>) -> usize {
    handle value.start <= value.end {
        Result::Ok(_) => value.end - value.start,
        Result::Err(_) => 0
    }
}

__g1_range_is_empty(value: &Range<usize>) -> Bool { value.end <= value.start }

__g1_range_contains(value: &Range<usize>, candidate: usize) -> Bool {
    handle value.start <= candidate {
        Result::Ok(_) => candidate < value.end,
        Result::Err(_) => false
    }
}

__g1_range_usize(start: usize, end: usize) -> Range<usize> {
    Range { start: move start, end: move end }
}

__g1_range_some(value: Range<usize>) -> Option<Range<usize>> { Option::Some(move value) }

__g1_range_none() -> Option<Range<usize>> { None }

__g1_range_offset_some(value: usize) -> Option<usize> { Option::Some(move value) }

__g1_range_offset_none() -> Option<usize> { None }

__g1_range_max(left: usize, right: usize) -> usize {
    handle left < right { Result::Ok(_) => right, Result::Err(_) => left }
}

__g1_range_min(left: usize, right: usize) -> usize {
    handle left < right { Result::Ok(_) => left, Result::Err(_) => right }
}

__g1_range_intersection(left: &Range<usize>, right: &Range<usize>) -> Option<Range<usize>> {
    let start = __g1_range_max(left.start, right.start);
    let end = __g1_range_min(left.end, right.end);
    handle __g1_integer_less(start, end) {
        Result::Ok(_) => __g1_range_some(__g1_range_usize(move start, move end)),
        Result::Err(_) => __g1_range_none()
    }
}

__g1_range_checked_offset(value: &Range<usize>, offset: usize) -> Option<usize> {
    handle checked_usize_add(value.start, move offset) {
        Result::Ok(candidate) => handle candidate < value.end {
            Result::Ok(_) => __g1_range_offset_some(move candidate),
            Result::Err(_) => __g1_range_offset_none()
        },
        Result::Err(_) => __g1_range_offset_none()
    }
}

let Range::len = __g1_range_len;
let Range::is_empty = __g1_range_is_empty;
let Range::contains = __g1_range_contains;
let Range::intersection = __g1_range_intersection;
let Range::checked_offset = __g1_range_checked_offset;
let Range::new = __g1_range_usize;

// The range traversal kernel. `exit` is proof-only: a callback invocation of
// it is control-inlined into the concrete destination and becomes cleanup plus
// a direct LEAVE. The open callback effect row is forwarded exactly.
__g1_fold_until_step<L, A, B, F, e: EffectRow>(
    current: usize,
    end: usize,
    accumulator: A,
    exit: L,
    body: F
) -> A
where L: Label<B>,
F: Fn<(A, usize, L), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    if(current < end) {
        __g1_fold_until_step(
            current + 1,
            end,
            body(accumulator, current, exit),
            exit,
            body
        )
    } else {
        accumulator
    }
}

fold_until<L, A, B, F, e: EffectRow>(
    range: Range<usize>,
    seed: A,
    exit: L,
    body: F
) -> A
where L: Label<B>,
F: Fn<(A, usize, L), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_fold_until_step(range.start, range.end, seed, exit, body)
}

scan_until<L, A, B, F, e: EffectRow>(
    range: Range<usize>,
    seed: A,
    exit: L,
    body: F
) -> A
where L: Label<B>,
F: Fn<(A, usize, L), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    fold_until(range, seed, exit, body)
}

fold_control<L, A, B, F, e: EffectRow>(
    range: Range<usize>,
    seed: A,
    exit: L,
    body: F
) -> A
where L: Label<B>,
F: Fn<(A, usize, L), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    fold_until(range, seed, exit, body)
}

for_range_control<L, B, F, e: EffectRow>(
    range: Range<usize>,
    exit: L,
    body: F
)
where L: Label<B>,
F: Fn<(usize, L), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    fold_until(range, (), exit, { accumulator, index, destination => {
        body(index, destination);
        accumulator
    }})
}

// Stateful nonlocal loop control. The label parameter brands both operations,
// so a nested loop's requests are a different protocol instance even when its
// break value and state happen to have the same representation.
effect LoopControl<L, B, S>
where L: Label<B> {
    break(value: B) -> !
    continue(state: S) -> !
}

loop_break<L, B, S>(state: S, value: B, exit: L) -> ! / {LoopControl<L, B, S>}
where L: Label<B>,
S: Use<[0, 0]> {
    state;
    perform LoopControl<L, B, S>::break(value)
}

loop_continue<L, B, S>(state: S, exit: L) -> ! / {LoopControl<L, B, S>}
where L: Label<B> {
    perform LoopControl<L, B, S>::continue(state)
}

enum LoopStateStep<B, S> {
    Break(B)
    Continue(S)
}

__g1_loop_state_decide<L, B, S, F, e: EffectRow>(
    state: S,
    exit: L,
    body: F
) -> LoopStateStep<B, S>
where L: Label<B>,
F: Fn<(S, L), Output=B, Effects={LoopControl<L, B, S> | e}>,
F: Use<[0, 0]> {
    handle LoopStateStep::Break(body(state, exit)) {
        LoopControl<L, B, S>::break(value) => LoopStateStep::Break(value),
        LoopControl<L, B, S>::continue(next) => LoopStateStep::Continue(next)
    }
}

__g1_loop_state_step<L, B, S, F, e: EffectRow>(
    state: S,
    exit: L,
    body: F
) -> B
where L: Label<B>,
F: Fn<(S, L), Output=B, Effects={LoopControl<L, B, S> | e}>,
F: Use<[0, 0]> {
    handle __g1_loop_state_decide(state, exit, body) {
        LoopStateStep::Break(value) => value,
        LoopStateStep::Continue(next) => __g1_loop_state_step(next, exit, body)
    }
}

loop_state<L, B, S, F, e: EffectRow>(state: S, exit: L, body: F) -> B
where L: Label<B>,
F: Fn<(S, L), Output=B, Effects={LoopControl<L, B, S> | e}>,
F: Use<[0, 0]> {
    __g1_loop_state_step(state, exit, body)
}

repeat<L, B, S, F, e: EffectRow>(state: S, exit: L, body: F) -> B
where L: Label<B>,
F: Fn<(S, L), Output=B, Effects={LoopControl<L, B, S> | e}>,
F: Use<[0, 0]> {
    loop_state(state, exit, body)
}

__g1_while_state_step<S, P, F, e: EffectRow>(state: S, predicate: P, body: F) -> S
where P: Fn<(&S,), Output=Bool, Effects={| e}>,
P: Use<[0, 0]>,
F: Fn<(S,), Output=S, Effects={| e}>,
F: Use<[0, 0]> {
    let keep_going = predicate(&state);
    if(keep_going) {
        __g1_while_state_step(body(state), predicate, body)
    } else {
        state
    }
}

while_state<S, P, F, e: EffectRow>(state: S, predicate: P, body: F) -> S
where P: Fn<(&S,), Output=Bool, Effects={| e}>,
P: Use<[0, 0]>,
F: Fn<(S,), Output=S, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_while_state_step(state, predicate, body)
}

for_range<F, e: EffectRow>(range: Range<usize>, body: F)
where F: Fn<(usize), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    @done: () {
        fold_until(range, (), @done, { accumulator, index, exit => {
            body(index);
            accumulator
        }})
    }
}

try_for_range<E, F, e: EffectRow>(
    range: Range<usize>,
    body: F
) -> Result<(), E>
where F: Fn<(usize), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    @done: Result<(), E> {
        fold_until(range, (), @done, { accumulator, index, exit =>
            handle body(index) {
                Result::Err(error) => exit(Result::Err(error)),
                Result::Ok(_) => accumulator
            }
        });
        Result::Ok(())
    }
}

fold_range<A, F, e: EffectRow>(
    range: Range<usize>,
    seed: A,
    body: F
) -> A
where F: Fn<(A, usize), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    @done: A {
        fold_until(range, seed, @done, { accumulator, index, exit =>
            body(accumulator, index)
        })
    }
}

try_fold_range<A, E, F, e: EffectRow>(
    range: Range<usize>,
    seed: A,
    body: F
) -> Result<A, E>
where F: Fn<(A, usize), Output=Result<A, E>, Effects={| e}>,
F: Use<[0, 0]> {
    @done: Result<A, E> {
        let accumulator = fold_until(range, seed, @done, {
            accumulator, index, exit => handle body(accumulator, index) {
                Result::Err(error) => exit(Result::Err(error)),
                Result::Ok(next) => next
            }
        });
        Result::Ok(accumulator)
    }
}

find_range<F, e: EffectRow>(
    range: Range<usize>,
    predicate: F
) -> Option<usize>
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    @found: Option<usize> {
        fold_until(range, (), @found, { accumulator, index, exit =>
            if(predicate(index)) {
                exit(Option::Some(index))
            } else {
                accumulator
            }
        });
        None
    }
}

enum UniqueMatch<T> {
    Missing
    Unique(T)
    Ambiguous(T, T)
}

__g1_unique_usize_none() -> Option<usize> { None }

find_map_range<T, F, e: EffectRow>(
    range: Range<usize>,
    body: F
) -> Option<T>
where F: Fn<(usize), Output=Option<T>, Effects={| e}>,
F: Use<[0, 0]> {
    @found: Option<T> {
        fold_until(range, (), @found, { accumulator, index, exit =>
            handle body(index) {
                Option::Some(value) => exit(Option::Some(value)),
                None => accumulator
            }
        });
        None
    }
}

find_map<T, F, e: EffectRow>(range: Range<usize>, body: F) -> Option<T>
where F: Fn<(usize), Output=Option<T>, Effects={| e}>,
F: Use<[0, 0]> {
    find_map_range(range, body)
}

position_range<F, e: EffectRow>(range: Range<usize>, predicate: F) -> Option<usize>
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    find_range(range, predicate)
}

position<F, e: EffectRow>(range: Range<usize>, predicate: F) -> Option<usize>
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    position_range(range, predicate)
}

any_range<F, e: EffectRow>(range: Range<usize>, predicate: F) -> Bool
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    Option::is_some(find_range(range, predicate))
}

any<F, e: EffectRow>(range: Range<usize>, predicate: F) -> Bool
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    any_range(range, predicate)
}

all_range<F, e: EffectRow>(range: Range<usize>, predicate: F) -> Bool
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    let failed = @failed: Option<usize> {
        fold_until(range, (), @failed, { accumulator, index, exit =>
            if(predicate(index)) { accumulator }
            else { exit(Option::Some(index)) }
        });
        None
    };
    Option::is_none(move failed)
}

all<F, e: EffectRow>(range: Range<usize>, predicate: F) -> Bool
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    all_range(range, predicate)
}

first_error_range<E, F, e: EffectRow>(
    range: Range<usize>,
    body: F
) -> Option<E>
where F: Fn<(usize), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    handle try_for_range(range, body) {
        Result::Err(error) => Option::Some(error),
        Result::Ok(_) => None
    }
}

first_error<E, F, e: EffectRow>(
    range: Range<usize>,
    body: F
) -> Option<E>
where F: Fn<(usize), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    first_error_range(range, body)
}

find_unique_by<F, e: EffectRow>(
    range: Range<usize>,
    predicate: F
) -> UniqueMatch<usize>
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    @ambiguous: UniqueMatch<usize> {
        let first = fold_until(range, __g1_unique_usize_none(), @ambiguous, {
            found, index, exit => if(predicate(index)) {
                handle move found {
                    None => Option::Some(index),
                    Option::Some(previous) =>
                        exit(UniqueMatch::Ambiguous(move previous, index))
                }
            } else {
                found
            }
        });
        handle move first {
            None => UniqueMatch::Missing,
            Option::Some(value) => UniqueMatch::Unique(move value)
        }
    }
}

find_unique<F, e: EffectRow>(
    range: Range<usize>,
    predicate: F
) -> UniqueMatch<usize>
where F: Fn<(usize), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    find_unique_by(range, predicate)
}

__g1_collect_until_empty<T>() -> Vec<T> { Vec::new() }

collect_until<L, T, B, F, e: EffectRow>(
    range: Range<usize>,
    exit: L,
    body: F
) -> Vec<T>
where L: Label<B>,
T: Use<[0, 0]>,
F: Fn<(usize, L), Output=T, Effects={| e}>,
F: Use<[0, 0]> {
    fold_until(range, __g1_collect_until_empty(), exit, { output, index, destination => {
        // Evaluate label-capable work before borrowing the accumulator. If the
        // callback leaves, cleanup may then drop `output` without crossing a
        // still-live unique reborrow.
        let item = body(index, destination);
        Vec::push(&mut output, move item);
        move output
    }})
}

__g1_utf8_valid() -> Result<(), Utf8Error> { Result::Ok(()) }

__g1_utf8_invalid(valid_up_to: usize) -> Result<(), Utf8Error> {
    Result::Err(Utf8Error { valid_up_to: move valid_up_to })
}

__g1_utf8_string_ok(value: String) -> Result<String, Utf8Error> { Result::Ok(move value) }

__g1_utf8_string_err(error: Utf8Error) -> Result<String, Utf8Error> { Result::Err(move error) }

__g1_string_byte_len(value: &String) -> usize { __g1_text_byte_len(*value) }

__g1_string_empty() -> String { "" }

__g1_string_is_empty(value: &String) -> Bool { __g1_string_byte_len(value) == 0 }

__g1_string_concat(left: String, right: String) -> String {
    __g1_text_concat(move left, move right)
}

__g1_string_as_bytes(value: &String) -> Bytes { __g1_text_as_bytes(*value) }

__g1_string_eq(left: &String, right: &String) -> Bool {
    __g1_bool_from_u32(__g1_text_eq(*left, *right))
}

__g1_bytes_len_public(value: &Bytes) -> usize { __g1_bytes_len(*value) }

__g1_bytes_concat_public(left: Bytes, right: Bytes) -> Bytes {
    __g1_bytes_concat(move left, move right)
}

__g1_bytes_is_empty(value: &Bytes) -> Bool { __g1_bytes_len_public(value) == 0 }

// The raw byte operations below trap on invalid indices. Their public wrappers
// validate every bound in ordinary source before reaching those leaves.
enum BytesIndexError { OutOfBounds }

enum BytesRangeError { Reversed, OutOfBounds }

__g1_bytes_get_public(value: &Bytes, index: usize) -> Result<u8, BytesIndexError> {
    let owned = *value;
    handle index < __g1_bytes_len(owned) {
        Result::Ok(_) => Result::Ok(__g1_bytes_get(owned, index)),
        Result::Err(_) => Result::Err(BytesIndexError::OutOfBounds)
    }
}

__g1_bytes_slice_public(value: &Bytes, start: usize, end: usize) -> Result<Bytes, BytesRangeError> {
    let owned = *value;
    handle start <= end {
        Result::Ok(_) => handle end <= __g1_bytes_len(owned) {
            Result::Ok(_) => Result::Ok(__g1_bytes_slice(owned, start, end)),
            Result::Err(_) => Result::Err(BytesRangeError::OutOfBounds)
        },
        Result::Err(_) => Result::Err(BytesRangeError::Reversed)
    }
}

__g1_bytes_eq_at(left: Bytes, right: Bytes, index: usize, length: usize) -> Bool {
    handle __Branch::select(index == length) {
        __Branch::select(true) => true,
        __Branch::select(false) => handle __Branch::select(
            __g1_integer_equal(__g1_bytes_get(left, index), __g1_bytes_get(right, index))
        ) {
            __Branch::select(true) => __g1_bytes_eq_at(
                move left,
                move right,
                move index + 1,
                move length
            ),
            __Branch::select(false) => false
        }
    }
}

__g1_bytes_eq(left: &Bytes, right: &Bytes) -> Bool {
    let left_owned = *left;
    let right_owned = *right;
    let left_length = __g1_bytes_len(left_owned);
    let right_length = __g1_bytes_len(right_owned);
    handle __Branch::select(__g1_integer_equal(left_length, right_length)) {
        __Branch::select(true) => __g1_bytes_eq_at(left_owned, right_owned, 0, left_length),
        __Branch::select(false) => false
    }
}

// Validate one UTF-8 sequence's unconstrained continuation tail. `cursor` is
// always checked before the private trapping byte leaf. Invalid and truncated
// sequences report the byte offset of their lead byte, matching `valid_up_to`.
__g1_utf8_continuations(value: Bytes, sequence_start: usize, cursor: usize, sequence_end: usize) -> Result<
    (),
    Utf8Error
> {
    let length = __g1_bytes_len(value);
    handle __Branch::select(cursor == sequence_end) {
        __Branch::select(true) => __g1_utf8_validate_at(move value, move cursor),
        __Branch::select(false) => handle __Branch::select(cursor < length) {
            __Branch::select(true) => {
                let byte = __g1_bytes_get(value, cursor);
                handle __Branch::select(128 <= byte) {
                    __Branch::select(true) => handle __Branch::select(byte <= 191) {
                        __Branch::select(true) => __g1_utf8_continuations(
                            move value,
                            move sequence_start,
                            __g1_usize_successor(move cursor),
                            move sequence_end
                        ),
                        __Branch::select(false) => __g1_utf8_invalid(move sequence_start)
                    },
                    __Branch::select(false) => __g1_utf8_invalid(move sequence_start)
                }
            },
            __Branch::select(false) => __g1_utf8_invalid(move sequence_start)
        }
    }
}

// Validate the specially constrained second byte of a multibyte sequence.
// The remaining continuation bytes all use the ordinary 0x80..=0xbf range.
__g1_utf8_second(value: Bytes, sequence_start: usize, minimum: u8, maximum: u8, sequence_end: usize) -> Result<
    (),
    Utf8Error
> {
    let length = __g1_bytes_len(value);
    handle __Branch::select(sequence_start < length) {
        __Branch::select(true) => {
            let second_index = __g1_usize_successor(sequence_start);
            handle __Branch::select(__g1_integer_less(second_index, length)) {
                __Branch::select(true) => {
                    let second = __g1_bytes_get(value, second_index);
                    handle __Branch::select(minimum <= second) {
                        __Branch::select(true) => handle __Branch::select(second <= maximum) {
                            __Branch::select(true) => {
                                __g1_utf8_continuations(
                                    move value,
                                    move sequence_start,
                                    __g1_usize_successor(move second_index),
                                    move sequence_end
                                )
                            },
                            __Branch::select(false) => __g1_utf8_invalid(move sequence_start)
                        },
                        __Branch::select(false) => __g1_utf8_invalid(move sequence_start)
                    }
                },
                __Branch::select(false) => __g1_utf8_invalid(move sequence_start)
            }
        },
        __Branch::select(false) => __g1_utf8_invalid(move sequence_start)
    }
}

__g1_utf8_validate_at(value: Bytes, index: usize) -> Result<(), Utf8Error> {
    let length = __g1_bytes_len(value);
    handle __Branch::select(index <= length) {
        __Branch::select(true) => handle __Branch::select(index == length) {
            __Branch::select(true) => __g1_utf8_valid(),
            __Branch::select(false) => {
                // `index` begins at zero and advances only within `length`, so this
                // read is safe after the equality test above.
                let lead = __g1_bytes_get(value, index);
                handle __Branch::select(lead <= 127) {
                    __Branch::select(true) => __g1_utf8_validate_at(
                        move value,
                        __g1_usize_successor(move index)
                    ),
                    __Branch::select(false) => handle __Branch::select(194 <= lead) {
                        __Branch::select(true) => handle __Branch::select(lead <= 223) {
                            __Branch::select(true) => __g1_utf8_second(
                                move value,
                                index,
                                128,
                                191,
                                __g1_usize_add(index, 2)
                            ),
                            __Branch::select(false) => handle __Branch::select(lead == 224) {
                                __Branch::select(true) => __g1_utf8_second(
                                    move value,
                                    index,
                                    160,
                                    191,
                                    __g1_usize_add(index, 3)
                                ),
                                __Branch::select(false) => handle __Branch::select(lead == 237) {
                                    __Branch::select(true) => __g1_utf8_second(
                                        move value,
                                        index,
                                        128,
                                        159,
                                        __g1_usize_add(index, 3)
                                    ),
                                    __Branch::select(false) => handle __Branch::select(225 <= lead) {
                                        __Branch::select(true) => handle __Branch::select(
                                            lead <= 239
                                        ) {
                                            __Branch::select(true) => __g1_utf8_second(
                                                move value,
                                                index,
                                                128,
                                                191,
                                                __g1_usize_add(index, 3)
                                            ),
                                            __Branch::select(false) => __g1_utf8_validate_four(
                                                move value,
                                                move index,
                                                move lead
                                            )
                                        },
                                        __Branch::select(false) => __g1_utf8_invalid(move index)
                                    }
                                }
                            }
                        },
                        __Branch::select(false) => __g1_utf8_invalid(move index)
                    }
                }
            },
        },
        __Branch::select(false) => __g1_utf8_invalid(move length)
    }
}

__g1_utf8_validate_four(value: Bytes, index: usize, lead: u8) -> Result<(), Utf8Error> {
    let length = __g1_bytes_len(value);
    handle __Branch::select(index < length) {
        __Branch::select(true) => handle __Branch::select(lead == 240) {
            __Branch::select(true) => __g1_utf8_second(
                move value,
                index,
                144,
                191,
                __g1_usize_add(index, 4)
            ),
            __Branch::select(false) => handle __Branch::select(lead == 244) {
                __Branch::select(true) => __g1_utf8_second(
                    move value,
                    index,
                    128,
                    143,
                    __g1_usize_add(index, 4)
                ),
                __Branch::select(false) => handle __Branch::select(241 <= lead) {
                    __Branch::select(true) => handle __Branch::select(lead <= 243) {
                        __Branch::select(true) => __g1_utf8_second(
                            move value,
                            index,
                            128,
                            191,
                            __g1_usize_add(index, 4)
                        ),
                        __Branch::select(false) => __g1_utf8_invalid(move index)
                    },
                    __Branch::select(false) => __g1_utf8_invalid(move index)
                }
            }
        },
        __Branch::select(false) => __g1_utf8_invalid(move length)
    }
}

__g1_string_from_utf8(value: Bytes) -> Result<String, Utf8Error> {
    let valid_up_to = __g1_bytes_utf8_valid_up_to(value);
    handle valid_up_to == __g1_bytes_len(value) {
        Result::Ok(_) => __g1_utf8_string_ok(__g1_text_from_utf8_checked(move value)),
        Result::Err(_) => __g1_utf8_string_err(Utf8Error { valid_up_to: move valid_up_to })
    }
}

__g1_utf8_boundary(value: Bytes, offset: usize) -> Bool {
    let length = __g1_bytes_len(value);
    handle offset == length {
        Result::Ok(_) => true,
        Result::Err(_) => handle offset < length {
            Result::Ok(_) => {
                let byte = __g1_bytes_get(value, offset);
                handle byte < 128 { Result::Ok(_) => true, Result::Err(_) => 192 <= byte }
            },
            Result::Err(_) => false
        }
    }
}

__g1_text_slice_ok(value: String) -> Result<String, TextRangeError> { Result::Ok(move value) }

__g1_text_slice_err(error: TextRangeError) -> Result<String, TextRangeError> {
    Result::Err(move error)
}

__g1_text_slice_from_bytes(bytes: Bytes) -> Result<String, TextRangeError> {
    handle __g1_string_from_utf8(move bytes) {
        Result::Ok(text) => __g1_text_slice_ok(move text),
        Result::Err(_) => __g1_text_slice_err(TextRangeError::NotCharBoundary)
    }
}

__g1_string_slice_bounds(bytes: Bytes, start: usize, end: usize) -> Result<String, TextRangeError> {
    let length = __g1_bytes_len(bytes);
    handle start <= end {
        Result::Ok(_) => handle end <= length {
            Result::Ok(_) => handle __g1_utf8_boundary(bytes, start) {
                Result::Ok(_) => handle __g1_utf8_boundary(bytes, end) {
                    Result::Ok(_) => __g1_text_slice_from_bytes(
                        __g1_bytes_slice(move bytes, move start, move end)
                    ),
                    Result::Err(_) => __g1_text_slice_err(TextRangeError::NotCharBoundary)
                },
                Result::Err(_) => __g1_text_slice_err(TextRangeError::NotCharBoundary)
            },
            Result::Err(_) => __g1_text_slice_err(TextRangeError::OutOfBounds)
        },
        Result::Err(_) => __g1_text_slice_err(TextRangeError::Reversed)
    }
}

__g1_string_slice(value: &String, range: Range<usize>) -> Result<String, TextRangeError> {
    let start = range.start;
    let end = range.end;
    let bytes = __g1_text_as_bytes(*value);
    handle start <= end {
        Result::Ok(_) => __g1_string_slice_bounds(move bytes, move start, move end),
        Result::Err(_) => __g1_text_slice_err(TextRangeError::Reversed)
    }
}

let String::empty = __g1_string_empty;
let String::byte_len = __g1_string_byte_len;
let String::is_empty = __g1_string_is_empty;
let String::concat = __g1_string_concat;
let String::as_bytes = __g1_string_as_bytes;
let String::from_utf8 = __g1_string_from_utf8;
let String::eq = __g1_string_eq;
let String::slice = __g1_string_slice;
let Bytes::len = __g1_bytes_len_public;
let Bytes::is_empty = __g1_bytes_is_empty;
let Bytes::eq = __g1_bytes_eq;
let Bytes::get = __g1_bytes_get_public;
let Bytes::slice = __g1_bytes_slice_public;
let Bytes::concat = __g1_bytes_concat_public;
// Checked compiler-facing integer parsing. Explicit-radix separators occur
// only between digits; source-prefixed forms additionally accept separators
// immediately after the prefix, matching the lexer. All indexing is checked,
// and overflow is rejected before multiplication or addition can wrap.
enum IntParseError { Empty, InvalidBase, InvalidDigit(usize), Overflow(usize) }

enum __ParsedDigit { Value(u32), Invalid }

__g1_parse_u32_sub(left: u32, right: u32) -> u32 { move left - move right }

__g1_parse_usize_predecessor(value: usize) -> usize { move value - 1 }

__g1_parse_digit(byte: u8) -> __ParsedDigit {
    handle 48 <= byte {
        Result::Ok(_) => handle byte <= 57 {
            Result::Ok(_) => __ParsedDigit::Value(
                __g1_parse_u32_sub(wrapping_convert_to_u32(byte), 48)
            ),
            Result::Err(_) => handle 65 <= byte {
                Result::Ok(_) => handle byte <= 90 {
                    Result::Ok(_) => __ParsedDigit::Value(
                        __g1_parse_u32_sub(wrapping_convert_to_u32(byte), 55)
                    ),
                    Result::Err(_) => __g1_parse_lower_digit(move byte)
                },
                Result::Err(_) => __g1_parse_lower_digit(move byte)
            }
        },
        Result::Err(_) => __ParsedDigit::Invalid
    }
}

__g1_parse_lower_digit(byte: u8) -> __ParsedDigit {
    handle 97 <= byte {
        Result::Ok(_) => handle byte <= 122 {
            Result::Ok(_) => __ParsedDigit::Value(
                __g1_parse_u32_sub(wrapping_convert_to_u32(byte), 87)
            ),
            Result::Err(_) => __ParsedDigit::Invalid
        },
        Result::Err(_) => __ParsedDigit::Invalid
    }
}

__g1_parse_u64_zero() -> u64 { 0 }

__g1_parse_u64_max() -> u64 { bit_not(__g1_parse_u64_zero()) }

__g1_parse_u64_sub(left: u64, right: u64) -> u64 { move left - move right }

__g1_parse_u64_mul(left: u64, right: u64) -> u64 { move left * move right }

__g1_parse_u64_push(accumulator: u64, base: u32, digit: u32) -> Option<u64> {
    let wide_base = wrapping_convert_to_u64(base);
    let wide_digit = wrapping_convert_to_u64(digit);
    let threshold = __g1_u64_div(__g1_parse_u64_sub(__g1_parse_u64_max(), wide_digit), wide_base);
    handle accumulator <= threshold {
        Result::Ok(_) => Option::Some(
            __g1_u64_add(__g1_parse_u64_mul(move accumulator, move wide_base), move wide_digit)
        ),
        Result::Err(_) => None
    }
}

__g1_parse_u64_digit(
    bytes: Bytes,
    base: u32,
    cursor: usize,
    length: usize,
    accumulator: u64,
    digit: u32
) -> Result<u64, IntParseError> {
    handle digit < base {
        Result::Ok(_) => handle __g1_parse_u64_push(accumulator, base, digit) {
            Result::Ok(next) => __g1_parse_u64_step(
                move bytes,
                base,
                __g1_usize_successor(move cursor),
                length,
                move next
            ),
            Result::Err(_) => Result::Err(IntParseError::Overflow(move cursor))
        },
        Result::Err(_) => Result::Err(IntParseError::InvalidDigit(move cursor))
    }
}

__g1_parse_separator(bytes: Bytes, base: u32, cursor: usize, length: usize, accumulator: u64) -> Result<
    u64,
    IntParseError
> {
    let next = __g1_usize_successor(cursor);
    handle next < length {
        Result::Ok(_) => {
            let parsed = __g1_parse_digit(__g1_bytes_get(bytes, next));
            handle move parsed {
                __ParsedDigit::Value(digit) => handle digit < base {
                    Result::Ok(_) => __g1_parse_u64_step(
                        move bytes,
                        base,
                        move next,
                        length,
                        move accumulator
                    ),
                    Result::Err(_) => Result::Err(IntParseError::InvalidDigit(cursor))
                },
                __ParsedDigit::Invalid => Result::Err(IntParseError::InvalidDigit(move cursor))
            }
        },
        Result::Err(_) => Result::Err(IntParseError::InvalidDigit(move cursor))
    }
}

__g1_parse_u64_step(bytes: Bytes, base: u32, cursor: usize, length: usize, accumulator: u64) -> Result<
    u64,
    IntParseError
> {
    handle cursor < length {
        Result::Ok(_) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle byte == 95 {
                Result::Ok(_) => handle cursor == 0 {
                    Result::Ok(_) => Result::Err(IntParseError::InvalidDigit(cursor)),
                    Result::Err(_) => __g1_parse_separator(
                        move bytes,
                        base,
                        cursor,
                        length,
                        move accumulator
                    )
                },
                Result::Err(_) => {
                    let parsed = __g1_parse_digit(move byte);
                    handle move parsed {
                        __ParsedDigit::Value(digit) => __g1_parse_u64_digit(
                            move bytes,
                            base,
                            cursor,
                            length,
                            move accumulator,
                            move digit
                        ),
                        __ParsedDigit::Invalid => Result::Err(
                            IntParseError::InvalidDigit(move cursor)
                        )
                    }
                }
            }
        },
        Result::Err(_) => Result::Ok(move accumulator)
    }
}

parse_u64_radix(value: &String, base: u32) -> Result<u64, IntParseError> {
    handle 2 <= base {
        Result::Ok(_) => handle base <= 36 {
            Result::Ok(_) => {
                let bytes = String::as_bytes(value);
                let length = Bytes::len(&bytes);
                handle length == 0 {
                    Result::Ok(_) => Result::Err(IntParseError::Empty),
                    Result::Err(_) => __g1_parse_u64_step(
                        move bytes,
                        base,
                        0,
                        length,
                        __g1_parse_u64_zero()
                    )
                }
            },
            Result::Err(_) => Result::Err(IntParseError::InvalidBase)
        },
        Result::Err(_) => Result::Err(IntParseError::InvalidBase)
    }
}

__g1_parse_u64_unprefixed(bytes: Bytes, base: u32, start: usize, length: usize) -> Result<
    u64,
    IntParseError
> {
    handle start < length {
        Result::Ok(_) => handle __g1_bytes_get(bytes, start) == 95 {
            Result::Ok(_) => Result::Err(IntParseError::InvalidDigit(move start)),
            Result::Err(_) => __g1_parse_u64_step(
                move bytes,
                move base,
                move start,
                move length,
                __g1_parse_u64_zero()
            )
        },
        Result::Err(_) => Result::Err(IntParseError::Empty)
    }
}

// Source-prefixed integers permit separators immediately after the prefix,
// matching the lexer grammar (`0x_ff` and `0x__ff`). At least one actual digit
// is still required.
__g1_parse_u64_prefixed(bytes: Bytes, base: u32, cursor: usize, length: usize) -> Result<
    u64,
    IntParseError
> {
    handle cursor < length {
        Result::Ok(_) => handle __g1_bytes_get(bytes, cursor) == 95 {
            Result::Ok(_) => __g1_parse_u64_prefixed(
                move bytes,
                move base,
                __g1_usize_successor(move cursor),
                move length
            ),
            Result::Err(_) => __g1_parse_u64_step(
                move bytes,
                move base,
                move cursor,
                move length,
                __g1_parse_u64_zero()
            )
        },
        Result::Err(_) => Result::Err(IntParseError::Empty)
    }
}

__g1_parse_u64_source_prefix(bytes: Bytes, marker: u8, offset: usize, length: usize) -> Result<
    u64,
    IntParseError
> {
    handle marker == 98 {
        Result::Ok(_) => __g1_parse_u64_prefixed(
            move bytes,
            2,
            __g1_usize_add(offset, 2),
            move length
        ),
        Result::Err(_) => handle marker == 111 {
            Result::Ok(_) => __g1_parse_u64_prefixed(
                move bytes,
                8,
                __g1_usize_add(offset, 2),
                move length
            ),
            Result::Err(_) => handle marker == 120 {
                Result::Ok(_) => __g1_parse_u64_prefixed(
                    move bytes,
                    16,
                    __g1_usize_add(offset, 2),
                    move length
                ),
                Result::Err(_) => __g1_parse_u64_unprefixed(
                    move bytes,
                    10,
                    move offset,
                    move length
                )
            }
        }
    }
}

__g1_parse_u64_source_from(bytes: Bytes, offset: usize, length: usize) -> Result<u64, IntParseError> {
    handle offset < length {
        Result::Ok(_) => handle __g1_usize_successor(offset) < length {
            Result::Ok(_) => handle __g1_bytes_get(bytes, offset) == 48 {
                Result::Ok(_) => {
                    let marker = __g1_bytes_get(bytes, __g1_usize_successor(offset));
                    __g1_parse_u64_source_prefix(move bytes, move marker, move offset, move length)
                },
                Result::Err(_) => __g1_parse_u64_unprefixed(
                    move bytes,
                    10,
                    move offset,
                    move length
                )
            },
            Result::Err(_) => __g1_parse_u64_unprefixed(move bytes, 10, move offset, move length)
        },
        Result::Err(_) => Result::Err(IntParseError::Empty)
    }
}

parse_u64(value: &String) -> Result<u64, IntParseError> {
    let bytes = String::as_bytes(value);
    let length = Bytes::len(&bytes);
    __g1_parse_u64_source_from(move bytes, 0, move length)
}

__g1_parse_i64_max_magnitude() -> u64 { shift_right(__g1_parse_u64_max(), 1) }

__g1_parse_i64_negative_limit() -> u64 { __g1_u64_add(__g1_parse_i64_max_magnitude(), 1) }

__g1_parse_i64_negate(value: i64) -> i64 { 0 - move value }

__g1_parse_i64_negative_value(magnitude: u64, overflow_at: usize) -> Result<i64, IntParseError> {
    let limit = __g1_parse_i64_negative_limit();
    handle magnitude <= limit {
        Result::Ok(_) => handle magnitude == limit {
            Result::Ok(_) => Result::Ok(wrapping_convert_to_i64(move magnitude)),
            Result::Err(_) => Result::Ok(
                __g1_parse_i64_negate(wrapping_convert_to_i64(move magnitude))
            )
        },
        Result::Err(_) => Result::Err(IntParseError::Overflow(move overflow_at))
    }
}

__g1_parse_i64_positive_value(magnitude: u64, overflow_at: usize) -> Result<i64, IntParseError> {
    handle magnitude <= __g1_parse_i64_max_magnitude() {
        Result::Ok(_) => Result::Ok(wrapping_convert_to_i64(move magnitude)),
        Result::Err(_) => Result::Err(IntParseError::Overflow(move overflow_at))
    }
}

__g1_parse_i64_finish(parsed: Result<u64, IntParseError>, negative: Bool, overflow_at: usize) -> Result<
    i64,
    IntParseError
> {
    handle move parsed {
        Result::Ok(magnitude) => handle move negative {
            Result::Ok(_) => __g1_parse_i64_negative_value(move magnitude, move overflow_at),
            Result::Err(_) => __g1_parse_i64_positive_value(move magnitude, move overflow_at)
        },
        Result::Err(error) => Result::Err(move error)
    }
}

parse_i64(value: &String) -> Result<i64, IntParseError> {
    let bytes = String::as_bytes(value);
    let length = Bytes::len(&bytes);
    handle length == 0 {
        Result::Ok(_) => Result::Err(IntParseError::Empty),
        Result::Err(_) => {
            let last = __g1_parse_usize_predecessor(length);
            handle __g1_bytes_get(bytes, 0) == 45 {
                Result::Ok(_) => __g1_parse_i64_finish(
                    __g1_parse_u64_source_from(move bytes, 1, length),
                    true,
                    move last
                ),
                Result::Err(_) => __g1_parse_i64_finish(
                    __g1_parse_u64_source_from(move bytes, 0, length),
                    false,
                    move last
                )
            }
        }
    }
}

// Layer 3: the public dense collection is an ordinary private-field wrapper.
// Every public return boundary preserves Array's initialized-prefix invariant;
// the drained-shell leaf deliberately has no public Vec alias.
struct Vec<T> { private storage: Array<T> }

// A shared slice is a checked, non-owning window into Vec's dense Array.
// All representation fields are private: only this defining source segment
// can establish the start/length invariant or recover the backing Array.
struct Slice<'a, T> { private base: &'a Array<T>, private start: usize, private length: usize }

// Shared iteration threads its checked cursor through an owned state value.
// `next` yields a relative index rather than a reference so its result carries
// only the iterator's one backing reference; callers retain the duplicable
// Slice and obtain the element through Slice::get.
struct SliceIter<'a, T> {
    private base: &'a Array<T>,
    private start: usize,
    private length: usize,
    private index: usize
}

// By-value iteration owns every element not yet yielded. The backing Array is
// private so only `next` can move an element out or finish the drained shell.
struct VecIntoIter<T> { private remaining: Vec<T> }
// Iterator state is affine only when abandoning its resident elements is
// legal. It is never duplicable because that would duplicate the Array owner.
impl < T > Use<[0, 1]> for VecIntoIter<T> where Vec<T>: Use<[0, 1]>,
T: Use<[0, 0]> {}

enum __VecDequeSlot < T > { Empty, Full(T) }

impl < T > Use<[0, 1]> for __VecDequeSlot<T> where T: Use<[0, 1]> {}

// Every slot below `slots.len` is initialized. `head` is zero when capacity is
// zero and otherwise remains in range; `length <= capacity`.
struct VecDeque<T> {
    private slots: Vec<__VecDequeSlot<T>>,
    private head: usize,
    private length: usize
}

impl < T > Use<[0, 1]> for VecDeque<T> where Vec<__VecDequeSlot<T>>: Use<[0, 1]>,
T: Use<[0, 0]> {}

// Mutable views carry the unique Array loan itself and are therefore linear:
// they cannot be copied or forged outside this authority domain.
struct SliceMut<'a, T> {
    private base: &'a mut Array<T>,
    private start: usize,
    private length: usize
}

// Vec's checked operations guard the frozen trapping Array leaves in ordinary
// source. `true` is Result::Ok and `false` is Result::Err in the public Bool
// encoding, so the terminal handler selects exactly one access path.
__g1_vec_new<T>() -> Vec<T> { Vec { storage: __g1_array_empty() } }

__g1_vec_reserve_owned<T>(value: Vec<T>, additional: usize) -> Vec<T> {
    __g1_vec_reserve(&mut value, additional);
    value
}

__g1_vec_with_capacity<T>(capacity: usize) -> Vec<T> {
    __g1_vec_reserve_owned(Vec { storage: __g1_array_empty() }, capacity)
}

__g1_vec_len<T>(value: &Vec<T>) -> usize { __g1_array_len(&value.storage) }

__g1_vec_capacity<T>(value: &Vec<T>) -> usize { __g1_array_capacity(&value.storage) }

__g1_vec_reserve<T>(value: &mut Vec<T>, additional: usize) {
    __g1_array_reserve(&mut value.storage, additional)
}

__g1_vec_push<T>(value: &mut Vec<T>, item: T) {
    __g1_array_push_move(&mut value.storage, move item)
}

__g1_vec_is_empty<T>(value: &Vec<T>) -> Bool {
    let length = __g1_vec_len(value);
    length == 0
}

__g1_vec_pop<'a, T>(value: &'a mut Vec<T>) -> Option<T> {
    let length = __g1_array_len(&value.storage);
    let empty = length == 0;
    handle empty {
        Result::Ok(_) => None,
        Result::Err(_) => Option::Some(__g1_array_pop_move(&mut value.storage))
    }
}

__g1_vec_get<'a, T>(value: &'a Vec<T>, index: usize) -> Option<& 'a T> {
    let length = __g1_array_len(&value.storage);
    let in_bounds = index < length;
    handle in_bounds {
        Result::Ok(_) => Option::Some(__g1_array_get_borrow_shared(&value.storage, index)),
        Result::Err(_) => None
    }
}

__g1_vec_get_mut<'a, T>(value: &'a mut Vec<T>, index: usize) -> Option<& 'a mut T> {
    let length = __g1_array_len(&value.storage);
    let in_bounds = index < length;
    handle in_bounds {
        Result::Ok(_) => Option::Some(__g1_array_get_borrow_unique(&mut value.storage, index)),
        Result::Err(_) => None
    }
}

__g1_vec_first<'a, T>(value: &'a Vec<T>) -> Option<& 'a T> { __g1_vec_get(value, 0) }

__g1_vec_last<'a, T>(value: &'a Vec<T>) -> Option<& 'a T> {
    let length = __g1_array_len(&value.storage);
    handle length == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => __g1_vec_get(value, move length - 1)
    }
}

__g1_vec_as_slice<'a, T>(value: &'a Vec<T>) -> Slice<'a, T> {
    Slice { base: &value.storage, start: 0, length: __g1_array_len(&value.storage) }
}

__g1_vec_as_mut_slice<'a, T>(value: &'a mut Vec<T>) -> SliceMut<'a, T> {
    let length = __g1_array_len(&value.storage);
    SliceMut { base: &mut value.storage, start: 0, length: length }
}

__g1_slice_len<'a, T>(value: Slice<'a, T>) -> usize { value.length }

__g1_slice_is_empty<'a, T>(value: Slice<'a, T>) -> Bool {
    let length = __g1_slice_len(value);
    length == 0
}

__g1_slice_get<'a, T>(value: Slice<'a, T>, index: usize) -> Option<& 'a T> {
    let Slice { base, start, length } = value;
    handle index < length {
        Result::Ok(_) => Option::Some(__g1_array_get_borrow_shared(base, start + index)),
        Result::Err(_) => None
    }
}

__g1_slice_index<'a, T>(value: Slice<'a, T>, index: usize) -> T
where T: Use<[0, *]>
{
    let Slice { base, start, length: _ } = value;
    __g1_array_get_copy(base, start + index)
}

__g1_slice_first<'a, T>(value: Slice<'a, T>) -> Option<& 'a T> { __g1_slice_get(value, 0) }

__g1_slice_subslice_length<'a, T>(
    base: &'a Array<T>,
    base_start: usize,
    available: usize,
    start: usize,
    length: usize
) -> Option<Slice<'a, T>> {
    handle length <= available - start {
        Result::Ok(_) => Option::Some(
            Slice { base: base, start: base_start + start, length: length }
        ),
        Result::Err(_) => None
    }
}

__g1_slice_subslice<'a, T>(value: Slice<'a, T>, start: usize, length: usize) -> Option<Slice<'a, T>> {
    let Slice { base, start: base_start, length: available } = value;
    handle start <= available {
        Result::Ok(_) => __g1_slice_subslice_length(base, base_start, available, start, length),
        Result::Err(_) => None
    }
}

__g1_slice_iter<'a, T>(value: Slice<'a, T>) -> SliceIter<'a, T> {
    let Slice { base, start, length } = value;
    SliceIter { base: base, start: start, length: length, index: 0 }
}

// The direct Vec entry point retains exactly the same checked Array window as
// `Vec::as_slice` followed by `Slice::iter`; it merely avoids requiring callers
// to name and retain the intermediate Slice value.
__g1_vec_iter<'a, T>(value: &'a Vec<T>) -> SliceIter<'a, T> {
    SliceIter { base: &value.storage, start: 0, length: __g1_array_len(&value.storage), index: 0 }
}

__g1_slice_iter_len<'a, T>(value: &SliceIter<'a, T>) -> usize { value.length - value.index }

__g1_slice_iter_is_empty<'a, T>(value: &SliceIter<'a, T>) -> Bool {
    let remaining = __g1_slice_iter_len(value);
    remaining == 0
}

__g1_slice_iter_next<'a, T>(value: &mut SliceIter<'a, T>) -> Option<usize> {
    let length = value.length;
    let index = value.index;
    handle index < length {
        Result::Ok(_) => {
            (*value).index = index + 1;
            Option::Some(move index)
        },
        Result::Err(_) => None
    }
}

// Borrowed traversal mirrors the range family without manufacturing reference
// carrying iterator states. Each helper keeps the one backing Array loan and
// derives an element reference only after its scalar cursor proves in-bounds.
__g1_slice_for_each_step<'a, T, F, e: EffectRow>(
    base: &'a Array<T>,
    start: usize,
    index: usize,
    length: usize,
    body: F
)
where F: Fn<(&'a T), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        body(__g1_array_get_borrow_shared(base, start + index));
        __g1_slice_for_each_step(base, start, index + 1, length, body)
    } else {
        ()
    }
}

__g1_slice_for_each<'a, T, F, e: EffectRow>(value: Slice<'a, T>, body: F)
where F: Fn<(&'a T), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    let Slice { base, start, length } = value;
    __g1_slice_for_each_step(base, start, 0, length, body)
}

__g1_slice_try_for_each_step<'a, T, E, F, e: EffectRow>(
    base: &'a Array<T>,
    start: usize,
    index: usize,
    length: usize,
    body: F
) -> Result<(), E>
where F: Fn<(&'a T), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        handle body(__g1_array_get_borrow_shared(base, start + index)) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(_) => __g1_slice_try_for_each_step(
                base,
                start,
                index + 1,
                length,
                body
            )
        }
    } else {
        Result::Ok(())
    }
}

__g1_slice_try_for_each<'a, T, E, F, e: EffectRow>(
    value: Slice<'a, T>,
    body: F
) -> Result<(), E>
where F: Fn<(&'a T), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    let Slice { base, start, length } = value;
    __g1_slice_try_for_each_step(base, start, 0, length, body)
}

__g1_slice_fold_step<'a, T, A, F, e: EffectRow>(
    base: &'a Array<T>,
    start: usize,
    index: usize,
    length: usize,
    accumulator: A,
    body: F
) -> A
where F: Fn<(A, &'a T), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        __g1_slice_fold_step(
            base,
            start,
            index + 1,
            length,
            body(accumulator, __g1_array_get_borrow_shared(base, start + index)),
            body
        )
    } else {
        accumulator
    }
}

__g1_slice_fold<'a, T, A, F, e: EffectRow>(
    value: Slice<'a, T>,
    seed: A,
    body: F
) -> A
where F: Fn<(A, &'a T), Output=A, Effects={| e}>,
F: Use<[0, 0]> {
    let Slice { base, start, length } = value;
    __g1_slice_fold_step(base, start, 0, length, seed, body)
}

__g1_slice_try_fold_step<'a, T, A, E, F, e: EffectRow>(
    base: &'a Array<T>,
    start: usize,
    index: usize,
    length: usize,
    accumulator: A,
    body: F
) -> Result<A, E>
where F: Fn<(A, &'a T), Output=Result<A, E>, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        handle body(accumulator, __g1_array_get_borrow_shared(base, start + index)) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(next) => __g1_slice_try_fold_step(
                base,
                start,
                index + 1,
                length,
                next,
                body
            )
        }
    } else {
        Result::Ok(accumulator)
    }
}

__g1_slice_try_fold<'a, T, A, E, F, e: EffectRow>(
    value: Slice<'a, T>,
    seed: A,
    body: F
) -> Result<A, E>
where F: Fn<(A, &'a T), Output=Result<A, E>, Effects={| e}>,
F: Use<[0, 0]> {
    let Slice { base, start, length } = value;
    __g1_slice_try_fold_step(base, start, 0, length, seed, body)
}

__g1_slice_find_index_step<'a, T, F, e: EffectRow>(
    base: &'a Array<T>,
    start: usize,
    index: usize,
    length: usize,
    predicate: F
) -> Option<usize>
where F: Fn<(&'a T), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        if(predicate(__g1_array_get_borrow_shared(base, start + index))) {
            Option::Some(index)
        } else {
            __g1_slice_find_index_step(base, start, index + 1, length, predicate)
        }
    } else {
        None
    }
}

__g1_slice_find_index<'a, T, F, e: EffectRow>(
    value: Slice<'a, T>,
    predicate: F
) -> Option<usize>
where F: Fn<(&'a T), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    let Slice { base, start, length } = value;
    __g1_slice_find_index_step(base, start, 0, length, predicate)
}

__g1_slice_find_step<'a, T, F, e: EffectRow>(
    base: &'a Array<T>,
    start: usize,
    index: usize,
    length: usize,
    predicate: F
) -> Option<&'a T>
where F: Fn<(&'a T), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < length) {
        let item = __g1_array_get_borrow_shared(base, start + index);
        if(predicate(item)) {
            Option::Some(item)
        } else {
            __g1_slice_find_step(base, start, index + 1, length, predicate)
        }
    } else {
        None
    }
}

__g1_slice_find<'a, T, F, e: EffectRow>(
    value: Slice<'a, T>,
    predicate: F
) -> Option<&'a T>
where F: Fn<(&'a T), Output=Bool, Effects={| e}>,
F: Use<[0, 0]> {
    let Slice { base, start, length } = value;
    __g1_slice_find_step(base, start, 0, length, predicate)
}

__g1_slice_mut_len<'a, T>(value: &SliceMut<'a, T>) -> usize { value.length }

__g1_slice_mut_is_empty<'a, T>(value: &SliceMut<'a, T>) -> Bool {
    let length = __g1_slice_mut_len(value);
    length == 0
}

__g1_slice_mut_get_mut<'a, T>(value: SliceMut<'a, T>, index: usize) -> Option<& 'a mut T> {
    let SliceMut { base, start, length } = move value;
    handle index < length {
        Result::Ok(_) => Option::Some(__g1_array_get_borrow_unique(base, start + index)),
        Result::Err(_) => None
    }
}

__g1_slice_mut_first_mut<'a, T>(value: SliceMut<'a, T>) -> Option<& 'a mut T> {
    __g1_slice_mut_get_mut(move value, 0)
}

__g1_slice_mut_get<'a, T>(value: SliceMut<'a, T>, index: usize) -> Option<& 'a T> {
    let SliceMut { base, start, length } = move value;
    handle index < length {
        Result::Ok(_) => Option::Some(__g1_array_get_borrow_shared(&*base, start + index)),
        Result::Err(_) => None
    }
}

__g1_slice_mut_first<'a, T>(value: SliceMut<'a, T>) -> Option<& 'a T> {
    __g1_slice_mut_get(move value, 0)
}

__g1_slice_mut_subslice_mut_length<'a, T>(
    base: &'a mut Array<T>,
    base_start: usize,
    available: usize,
    start: usize,
    length: usize
) -> Option<SliceMut<'a, T>> {
    handle length <= available - start {
        Result::Ok(_) => Option::Some(
            SliceMut { base: base, start: base_start + start, length: length }
        ),
        Result::Err(_) => None
    }
}

__g1_slice_mut_subslice_mut<'a, T>(value: SliceMut<'a, T>, start: usize, length: usize) -> Option<
    SliceMut<'a, T>
> {
    let SliceMut { base, start: base_start, length: available } = move value;
    handle start <= available {
        Result::Ok(_) => __g1_slice_mut_subslice_mut_length(
            base,
            base_start,
            available,
            start,
            length
        ),
        Result::Err(_) => None
    }
}

__g1_slice_mut_subslice_length<'a, T>(
    base: &'a mut Array<T>,
    base_start: usize,
    available: usize,
    start: usize,
    length: usize
) -> Option<Slice<'a, T>> {
    handle length <= available - start {
        Result::Ok(_) => Option::Some(
            Slice { base: &*base, start: base_start + start, length: length }
        ),
        Result::Err(_) => None
    }
}

__g1_slice_mut_subslice<'a, T>(value: SliceMut<'a, T>, start: usize, length: usize) -> Option<
    Slice<'a, T>
> {
    let SliceMut { base, start: base_start, length: available } = move value;
    handle start <= available {
        Result::Ok(_) => __g1_slice_mut_subslice_length(base, base_start, available, start, length),
        Result::Err(_) => None
    }
}

// Destructive shrinking is available only when the element's declared use
// interval includes zero. The private Array pop transfers each removed value
// into this function, where the bound permits that obligation to end.
__g1_vec_truncate<T>(value: &mut Vec<T>, length: usize) where T: Use<[0, 0]> {
    let current = __g1_array_len(&value.storage);
    handle length < current {
        Result::Ok(_) => {
            let removed = __g1_array_pop_move(&mut value.storage);
            removed;
            __g1_vec_truncate(move value, length)
        },
        Result::Err(_) => ()
    }
}

// Transactional append guard. The stored unique reference is reborrowed for
// the callback and for rollback; invoking any label out of the surrounding
// scope runs Drop before the resulting LEAVE, restoring the original length.
struct VecCheckpoint<'a, T> {
    private value: &'a mut Vec<T>,
    private length: usize,
    private armed: Bool
}

impl<'a, T> Drop for VecCheckpoint<'a, T> where T: Use<[0, 0]> {
    drop(&mut self) -> {
        if(self.armed) {
            __g1_vec_truncate(&mut *self.value, self.length)
        } else {
            ()
        }
    }
}

__g1_vec_checkpoint<'a, T>(value: &'a mut Vec<T>) -> VecCheckpoint<'a, T>
where T: Use<[0, 0]> {
    let length = __g1_vec_len(&*value);
    VecCheckpoint { value: move value, length: move length, armed: true }
}

__g1_vec_checkpoint_commit<'a, T>(checkpoint: &mut VecCheckpoint<'a, T>) {
    (*checkpoint).armed = false;
    ()
}

// Execute a scoped mutation and always restore the original vector length.
// The armed checkpoint is deliberately not committed: normal return and every
// labeled transfer runs the same Drop cleanup before leaving.
with_vec_rollback<'a, T, R, F>(value: &'a mut Vec<T>, body: F) -> R
where T: Use<[0, 0]>,
F: Fn<(&mut Vec<T>,), Output=R>,
F: Use<[0, 0]> {
    let checkpoint = __g1_vec_checkpoint(move value);
    body(&mut *checkpoint.value)
}

// Compiler diagnostic-context stacks use the same length transaction as any
// other append-only context. The semantic name keeps call sites explicit while
// sharing the proven cleanup implementation.
type DiagnosticContextFrame<'a, T> = VecCheckpoint<'a, T>;

diagnostic_context_frame<'a, T>(
    value: &'a mut Vec<T>
) -> DiagnosticContextFrame<'a, T>
where T: Use<[0, 0]> {
    __g1_vec_checkpoint(move value)
}

diagnostic_context_frame_commit<'a, T>(
    value: &mut DiagnosticContextFrame<'a, T>
) {
    __g1_vec_checkpoint_commit(move value)
}

with_diagnostic_context<'a, T, R, F>(value: &'a mut Vec<T>, body: F) -> R
where T: Use<[0, 0]>,
F: Fn<(&mut Vec<T>,), Output=R>,
F: Use<[0, 0]> {
    with_vec_rollback(move value, body)
}

with_range<T, F, e: EffectRow>(value: &mut Vec<T>, body: F) -> Range<usize>
where T: Use<[0, 0]>,
F: Fn<(&mut Vec<T>,), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    let checkpoint = __g1_vec_checkpoint(move value);
    let start = checkpoint.length;
    body(&mut *checkpoint.value);
    let end = __g1_vec_len(&*checkpoint.value);
    __g1_vec_checkpoint_commit(&mut checkpoint);
    Range { start: move start, end: move end }
}

try_with_range<T, E, F, e: EffectRow>(
    value: &mut Vec<T>,
    body: F
) -> Result<Range<usize>, E>
where T: Use<[0, 0]>,
F: Fn<(&mut Vec<T>,), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    @failed: Result<Range<usize>, E> {
        let checkpoint = __g1_vec_checkpoint(move value);
        let start = checkpoint.length;
        try(body(&mut *checkpoint.value), @failed);
        let end = __g1_vec_len(&*checkpoint.value);
        __g1_vec_checkpoint_commit(&mut checkpoint);
        Result::Ok(Range { start: move start, end: move end })
    }
}

__g1_append_range_control<T, L, F, e: EffectRow>(
    value: &mut Vec<T>,
    range: Range<usize>,
    exit: L,
    body: F
) -> usize
where L: Label<usize>,
F: Fn<(usize), Output=T, Effects={| e}>,
F: Use<[0, 0]> {
    fold_until(range, 0, exit, { count, index, done => {
        Vec::push(&mut *value, body(index));
        count + 1
    }})
}

append_range<T, F, e: EffectRow>(
    value: &mut Vec<T>,
    range: Range<usize>,
    body: F
) -> Range<usize>
where F: Fn<(usize), Output=T, Effects={| e}>,
F: Use<[0, 0]> {
    let start = Vec::len(&*value);
    let count = @done: usize {
        __g1_append_range_control(&mut *value, range, @done, body)
    };
    let end = start + count;
    Range { start: move start, end: move end }
}

__g1_map_range_into<T, F, e: EffectRow>(
    range: Range<usize>,
    body: F,
    output: Vec<T>
) -> Vec<T>
where F: Fn<(usize), Output=T, Effects={| e}>,
F: Use<[0, 0]> {
    append_range(&mut output, range, body);
    move output
}

map_range<T, F, e: EffectRow>(range: Range<usize>, body: F) -> Vec<T>
where F: Fn<(usize), Output=T, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_map_range_into(range, body, Vec::new())
}

collect_range<T, F, e: EffectRow>(range: Range<usize>, body: F) -> Vec<T>
where F: Fn<(usize), Output=T, Effects={| e}>,
F: Use<[0, 0]> {
    map_range(range, body)
}

__g1_try_map_range_into<T, E, F, e: EffectRow>(
    range: Range<usize>,
    body: F,
    output: Vec<T>
) -> Result<Vec<T>, E>
where T: Use<[0, 0]>,
F: Fn<(usize), Output=Result<T, E>, Effects={| e}>,
F: Use<[0, 0]> {
    @failed: Result<Vec<T>, E> {
        let output = fold_until(range, output, @failed, {
            output, index, exit => handle body(index) {
                Result::Err(error) => exit(Result::Err(error)),
                Result::Ok(item) => {
                    Vec::push(&mut output, move item);
                    move output
                }
            }
        });
        Result::Ok(move output)
    }
}

try_map_range<T, E, F, e: EffectRow>(
    range: Range<usize>,
    body: F
) -> Result<Vec<T>, E>
where T: Use<[0, 0]>,
F: Fn<(usize), Output=Result<T, E>, Effects={| e}>,
F: Use<[0, 0]> {
    __g1_try_map_range_into(range, body, Vec::new())
}

__g1_vec_clear<T>(value: &mut Vec<T>) where T: Use<[0, 0]> {
    let current = __g1_array_len(&value.storage);
    handle 0 < current {
        Result::Ok(_) => {
            let removed = __g1_array_pop_move(&mut value.storage);
            removed;
            __g1_vec_clear(move value)
        },
        Result::Err(_) => ()
    }
}

// Resize's fill value may be unused, used once per new slot, or copied an
// unbounded number of times. The same bound also admits zero-use disposal when
// shrinking, so no Clone or Default contract is implied by this operation.
__g1_vec_resize_shrink<T>(value: &mut Vec<T>, length: usize, fill: T, current: usize) where T: Use<
    [0, *]
> {
    handle length < current {
        Result::Ok(_) => {
            let removed = __g1_array_pop_move(&mut value.storage);
            removed;
            __g1_vec_resize(move value, length, fill)
        },
        Result::Err(_) => {
            fill;
            ()
        }
    }
}

__g1_vec_resize<T>(value: &mut Vec<T>, length: usize, fill: T) where T: Use<[0, *]> {
    let current = __g1_array_len(&value.storage);
    handle current < length {
        Result::Ok(_) => {
            __g1_array_push_move(&mut value.storage, fill);
            __g1_vec_resize(move value, length, fill)
        },
        Result::Err(_) => __g1_vec_resize_shrink(move value, length, fill, current)
    }
}

__g1_vec_copy_from_array_step<T>(output: Vec<T>, source: &Array<T>, cursor: usize, end: usize) -> Vec<
    T
> where T: Use<[0, *]> {
    let item = __g1_array_get_copy(source, cursor);
    __g1_array_push_move(&mut output.storage, move item);
    __g1_vec_copy_from_array(move output, source, cursor + 1, end)
}

__g1_vec_copy_from_array<T>(output: Vec<T>, source: &Array<T>, cursor: usize, end: usize) -> Vec<T> where T: Use<
    [0, *]
> {
    handle cursor < end {
        Result::Ok(_) => __g1_vec_copy_from_array_step(move output, source, cursor, end),
        Result::Err(_) => move output
    }
}

// Extending from a shared slice copies its initialized window in order. The
// source remains borrowed and retains all of its ownership obligations.
__g1_vec_extend_from_slice<'a, T>(value: &mut Vec<T>, source: Slice<'a, T>) where T: Use<[0, *]> {
    let Slice { base, start, length } = source;
    let copied = __g1_vec_copy_from_array(__g1_vec_new(), base, start, start + length);
    __g1_vec_append(move value, move copied)
}

// Checked whole-element rearrangement never exposes Array's temporary empty
// slots across a function call. Both indices are proven first; the two moves
// and two writes then form one uninterrupted ownership transaction. Each
// bounds decision has its own terminal helper so no outer handler retains a
// unique loan while an inner handler executes.
__g1_vec_swap_distinct<T>(value: &mut Vec<T>, left: usize, right: usize) -> Bool {
    let left_item = __g1_array_get_move(&mut value.storage, left);
    let right_item = __g1_array_get_move(&mut value.storage, right);
    __g1_array_set_move(&mut value.storage, left, move right_item);
    __g1_array_set_move(&mut value.storage, right, move left_item);
    true
}

__g1_vec_swap_equal<T>(value: &mut Vec<T>, left: usize, right: usize) -> Bool {
    handle left == right {
        Result::Ok(_) => true,
        Result::Err(_) => __g1_vec_swap_distinct(&mut *value, left, right)
    }
}

__g1_vec_swap_right<T>(value: &mut Vec<T>, left: usize, right: usize, length: usize) -> Bool {
    handle right < length {
        Result::Ok(_) => __g1_vec_swap_equal(&mut *value, left, right),
        Result::Err(_) => false
    }
}

__g1_vec_swap<T>(value: &mut Vec<T>, left: usize, right: usize) -> Bool {
    let length = __g1_array_len(&value.storage);
    handle left < length {
        Result::Ok(_) => __g1_vec_swap_right(&mut *value, left, right, length),
        Result::Err(_) => false
    }
}

__g1_vec_reverse_between<T>(value: &mut Vec<T>, left: usize, right: usize) {
    handle __Branch::select(left < right) {
        __Branch::select(true) => {
            __g1_vec_swap(&mut *value, left, right);
            __g1_vec_reverse_between(move value, left + 1, right - 1)
        },
        __Branch::select(false) => ()
    }
}

__g1_vec_reverse<T>(value: &mut Vec<T>) {
    let length = __g1_array_len(&value.storage);
    handle length == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => __g1_vec_reverse_between(move value, 0, length - 1)
    }
}

// Reversing once lets the private iterator transfer elements through the
// Array's initialized-suffix pop primitive in original insertion order.
__g1_vec_into_iter<T>(value: Vec<T>) -> VecIntoIter<T> {
    __g1_vec_reverse(&mut value);
    VecIntoIter { remaining: move value }
}

__g1_vec_into_iter_next<T>(value: VecIntoIter<T>) -> Option<(T, VecIntoIter<T>)> {
    let VecIntoIter { remaining } = move value;
    let length = __g1_array_len(&remaining.storage);
    handle length == 0 {
        Result::Ok(_) => {
            let Vec { storage } = move remaining;
            __g1_array_finish_drained(move storage);
            None
        },
        Result::Err(_) => {
            let item = __g1_array_pop_move(&mut remaining.storage);
            Option::Some((move item, VecIntoIter { remaining: move remaining }))
        }
    }
}

__g1_vec_deque_new<T>() -> VecDeque<T> { VecDeque { slots: __g1_vec_new(), head: 0, length: 0 } }

__g1_vec_deque_empty_slot<T>() -> __VecDequeSlot<T> { __VecDequeSlot::Empty }

__g1_vec_deque_empty_slots<T>(like: &Vec<__VecDequeSlot<T>>) -> Vec<__VecDequeSlot<T>> {
    like;
    __g1_vec_new()
}

__g1_vec_deque_len<T>(value: &VecDeque<T>) -> usize { value.length }

__g1_vec_deque_capacity<T>(value: &VecDeque<T>) -> usize { __g1_vec_len(&value.slots) }

__g1_vec_deque_is_empty<T>(value: &VecDeque<T>) -> Bool { value.length == 0 }

__g1_vec_deque_usize_sub(left: usize, right: usize) -> usize { move left - move right }

// `offset < capacity` and `base < capacity`; subtraction before addition
// keeps the non-wrapping branch within usize without computing base+offset.
__g1_vec_deque_wrap_add(base: usize, offset: usize, capacity: usize) -> usize {
    let until_end = __g1_vec_deque_usize_sub(capacity, base);
    handle offset < until_end {
        Result::Ok(_) => base + offset,
        Result::Err(_) => __g1_vec_deque_usize_sub(offset, until_end)
    }
}

__g1_vec_deque_wrap_previous(head: usize, capacity: usize) -> usize {
    handle head == 0 {
        Result::Ok(_) => __g1_vec_deque_usize_sub(capacity, 1),
        Result::Err(_) => __g1_vec_deque_usize_sub(head, 1)
    }
}

__g1_vec_deque_fill_empty<T>(slots: Vec<__VecDequeSlot<T>>, remaining: usize) -> Vec<
    __VecDequeSlot<T>
> {
    handle remaining == 0 {
        Result::Ok(_) => move slots,
        Result::Err(_) => {
            __g1_array_push_move(&mut slots.storage, __g1_vec_deque_empty_slot());
            __g1_vec_deque_fill_empty(move slots, __g1_vec_deque_usize_sub(remaining, 1))
        }
    }
}

// Replacing through the unique slot borrow moves the old Slot and installs the
// new one without exposing an empty Array cell across a call or handler.
__g1_vec_deque_place<T>(slots: &mut Vec<__VecDequeSlot<T>>, index: usize, capacity: usize, item: T) {
    let previous = replace(
        __g1_array_get_borrow_unique(&mut slots.storage, index),
        __VecDequeSlot::Full(move item)
    );
    handle move previous {
        __VecDequeSlot::Empty => (),
        __VecDequeSlot::Full(displaced) => {
            let next = __g1_vec_deque_wrap_add(index, 1, capacity);
            __g1_vec_deque_place(move slots, next, capacity, move displaced)
        }
    }
}

__g1_vec_deque_take<T>(slots: &mut Vec<__VecDequeSlot<T>>, index: usize) -> __VecDequeSlot<T> {
    replace(__g1_array_get_borrow_unique(&mut slots.storage, index), __g1_vec_deque_empty_slot())
}

__g1_vec_deque_relocate_one<T>(
    old: Vec<__VecDequeSlot<T>>,
    fresh: Vec<__VecDequeSlot<T>>,
    head: usize,
    offset: usize,
    old_capacity: usize,
    moved: usize
) -> (Vec<__VecDequeSlot<T>>, Vec<__VecDequeSlot<T>>, usize) {
    let index = __g1_vec_deque_wrap_add(head, offset, old_capacity);
    let previous = replace(
        __g1_array_get_borrow_unique(&mut old.storage, index),
        __g1_vec_deque_empty_slot()
    );
    handle move previous {
        __VecDequeSlot::Empty => __g1_vec_deque_relocate(
            move old,
            move fresh,
            head,
            __g1_usize_add(offset, 1),
            old_capacity,
            moved
        ),
        __VecDequeSlot::Full(item) => {
            let fresh_capacity = __g1_vec_len(&fresh);
            __g1_vec_deque_place(&mut fresh, moved, fresh_capacity, move item);
            __g1_vec_deque_relocate(move old, move fresh, head, offset + 1, old_capacity, moved + 1)
        }
    }
}

__g1_vec_deque_relocate<T>(
    old: Vec<__VecDequeSlot<T>>,
    fresh: Vec<__VecDequeSlot<T>>,
    head: usize,
    offset: usize,
    old_capacity: usize,
    moved: usize
) -> (Vec<__VecDequeSlot<T>>, Vec<__VecDequeSlot<T>>, usize) {
    handle offset < old_capacity {
        Result::Ok(_) => __g1_vec_deque_relocate_one(
            move old,
            move fresh,
            head,
            offset,
            old_capacity,
            moved
        ),
        Result::Err(_) => (move old, move fresh, moved)
    }
}

__g1_vec_deque_drain_old_step<T>(
    old: Vec<__VecDequeSlot<T>>,
    fresh: Vec<__VecDequeSlot<T>>,
    moved: usize
) -> (Vec<__VecDequeSlot<T>>, usize) {
    let slot = __g1_array_pop_move(&mut old.storage);
    handle move slot {
        __VecDequeSlot::Empty => __g1_vec_deque_drain_old(move old, move fresh, moved),
        __VecDequeSlot::Full(item) => {
            let fresh_capacity = __g1_vec_len(&fresh);
            __g1_vec_deque_place(&mut fresh, moved, fresh_capacity, move item);
            __g1_vec_deque_drain_old(move old, move fresh, moved + 1)
        }
    }
}

__g1_vec_deque_drain_old<T>(
    old: Vec<__VecDequeSlot<T>>,
    fresh: Vec<__VecDequeSlot<T>>,
    moved: usize
) -> (Vec<__VecDequeSlot<T>>, usize) {
    let remaining = __g1_vec_len(&old);
    handle remaining == 0 {
        Result::Ok(_) => {
            let Vec { storage } = move old;
            __g1_array_finish_drained(move storage);
            (move fresh, moved)
        },
        Result::Err(_) => __g1_vec_deque_drain_old_step(move old, move fresh, moved)
    }
}

__g1_vec_deque_grow<T>(value: VecDeque<T>, new_capacity: usize) -> VecDeque<T> {
    let VecDeque { slots, head, length: _ } = move value;
    let old_capacity = __g1_vec_len(&slots);
    let fresh = __g1_vec_deque_fill_empty(__g1_vec_deque_empty_slots(&slots), new_capacity);
    let relocated = __g1_vec_deque_relocate(move slots, move fresh, head, 0, old_capacity, 0);
    let(old, fresh, moved) = move relocated;
    let drained = __g1_vec_deque_drain_old(move old, move fresh, moved);
    let(fresh, moved) = move drained;
    VecDeque { slots: move fresh, head: 0, length: moved }
}

__g1_vec_deque_grow_once<T>(value: VecDeque<T>) -> VecDeque<T> {
    let capacity = __g1_vec_deque_capacity(&value);
    handle capacity == 0 {
        Result::Ok(_) => __g1_vec_deque_grow(move value, 1),
        // Ordinary usize addition is checked; overflow terminates before any
        // owned state is lost rather than producing a wrapped capacity.
        Result::Err(_) => __g1_vec_deque_grow(
            move value,
            __g1_integer_add(capacity, capacity)
        )
    }
}

__g1_vec_deque_reserve_owned<T>(value: VecDeque<T>, additional: usize) -> VecDeque<T> {
    let capacity = __g1_vec_deque_capacity(&value);
    let available = __g1_vec_deque_usize_sub(capacity, value.length);
    handle additional <= available {
        Result::Ok(_) => move value,
        Result::Err(_) => __g1_vec_deque_reserve_owned(
            __g1_vec_deque_grow_once(move value),
            additional
        )
    }
}

__g1_vec_deque_finish_empty<T>(value: VecDeque<T>) {
    let VecDeque { slots, head: _, length: _ } = move value;
    let Vec { storage } = move slots;
    __g1_array_finish_drained(move storage)
}

__g1_vec_deque_reserve<T>(value: &mut VecDeque<T>, additional: usize) {
    let old = replace(&mut *value, __g1_vec_deque_new());
    let grown = __g1_vec_deque_reserve_owned(move old, additional);
    let placeholder = replace(&mut *value, move grown);
    __g1_vec_deque_finish_empty(move placeholder)
}

__g1_vec_deque_push_back<T>(value: &mut VecDeque<T>, item: T) {
    __g1_vec_deque_reserve(&mut *value, 1);
    let capacity = __g1_vec_deque_capacity(&*value);
    let index = __g1_vec_deque_wrap_add(value.head, value.length, capacity);
    __g1_vec_deque_place(&mut value.slots, index, capacity, move item);
    (*value).length = value.length + 1;
    ()
}

__g1_vec_deque_push_front<T>(value: &mut VecDeque<T>, item: T) {
    __g1_vec_deque_reserve(&mut *value, 1);
    let capacity = __g1_vec_deque_capacity(&*value);
    let head = __g1_vec_deque_wrap_previous(value.head, capacity);
    __g1_vec_deque_place(&mut value.slots, head, capacity, move item);
    (*value).head = head;
    (*value).length = value.length + 1;
    ()
}

__g1_vec_deque_pop_back_step<T>(value: &mut VecDeque<T>) -> Option<T> {
    let capacity = __g1_vec_deque_capacity(&*value);
    let index = __g1_vec_deque_wrap_add(
        value.head,
        __g1_vec_deque_usize_sub(value.length, 1),
        capacity
    );
    let previous = __g1_vec_deque_take(&mut value.slots, index);
    (*value).length = __g1_vec_deque_usize_sub(value.length, 1);
    handle move previous {
        __VecDequeSlot::Empty => None,
        __VecDequeSlot::Full(item) => Option::Some(move item)
    }
}

__g1_vec_deque_pop_back<T>(value: &mut VecDeque<T>) -> Option<T> {
    let length = value.length;
    handle length == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => __g1_vec_deque_pop_back_step(move value)
    }
}

__g1_vec_deque_pop_front_step<T>(value: &mut VecDeque<T>) -> Option<T> {
    let capacity = __g1_vec_deque_capacity(&*value);
    let head = value.head;
    let previous = __g1_vec_deque_take(&mut value.slots, head);
    (*value).head = __g1_vec_deque_wrap_add(head, 1, capacity);
    (*value).length = __g1_vec_deque_usize_sub(value.length, 1);
    handle move previous {
        __VecDequeSlot::Empty => None,
        __VecDequeSlot::Full(item) => Option::Some(move item)
    }
}

__g1_vec_deque_pop_front<T>(value: &mut VecDeque<T>) -> Option<T> {
    let length = value.length;
    handle length == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => __g1_vec_deque_pop_front_step(move value)
    }
}

__g1_vec_deque_clear_step<T>(value: &mut VecDeque<T>) where T: Use<[0, 0]> {
    let capacity = __g1_vec_deque_capacity(&*value);
    let index = __g1_vec_deque_wrap_add(
        value.head,
        __g1_vec_deque_usize_sub(value.length, 1),
        capacity
    );
    let previous = __g1_vec_deque_take(&mut value.slots, index);
    (*value).length = __g1_vec_deque_usize_sub(value.length, 1);
    handle move previous {
        __VecDequeSlot::Empty => __g1_vec_deque_clear(move value),
        __VecDequeSlot::Full(item) => {
            item;
            __g1_vec_deque_clear(move value)
        }
    }
}

__g1_vec_deque_clear<T>(value: &mut VecDeque<T>) where T: Use<[0, 0]> {
    let length = value.length;
    handle length == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => __g1_vec_deque_clear_step(move value)
    }
}

// Rotating the requested element to the initialized suffix and popping that
// suffix implements stable removal without carrying an empty Array slot over a
// recursive edge.
__g1_vec_rotate_to_end<T>(value: &mut Vec<T>, cursor: usize, last: usize) {
    handle __Branch::select(cursor < last) {
        __Branch::select(true) => {
            __g1_vec_swap(&mut *value, cursor, cursor + 1);
            __g1_vec_rotate_to_end(move value, cursor + 1, last)
        },
        __Branch::select(false) => ()
    }
}

__g1_vec_remove<T>(value: &mut Vec<T>, index: usize) -> Option<T> {
    let length = __g1_array_len(&value.storage);
    handle index < length {
        Result::Ok(_) => {
            __g1_vec_rotate_to_end(&mut *value, index, length - 1);
            Option::Some(__g1_array_pop_move(&mut value.storage))
        },
        Result::Err(_) => None
    }
}

__g1_vec_swap_remove<T>(value: &mut Vec<T>, index: usize) -> Option<T> {
    let length = __g1_array_len(&value.storage);
    handle index < length {
        Result::Ok(_) => {
            __g1_vec_swap(&mut *value, index, length - 1);
            Option::Some(__g1_array_pop_move(&mut value.storage))
        },
        Result::Err(_) => None
    }
}

__g1_vec_rotate_inserted<T>(value: &mut Vec<T>, cursor: usize, destination: usize) {
    handle __Branch::select(destination < cursor) {
        __Branch::select(true) => {
            __g1_vec_swap(&mut *value, cursor, cursor - 1);
            __g1_vec_rotate_inserted(move value, cursor - 1, destination)
        },
        __Branch::select(false) => ()
    }
}

// A failed insertion returns the item, preserving its use obligation.
__g1_vec_insert<T>(value: &mut Vec<T>, index: usize, item: T) -> Result<(), T> {
    let length = __g1_array_len(&value.storage);
    handle __Branch::select(index <= length) {
        __Branch::select(true) => {
            __g1_array_push_move(&mut value.storage, move item);
            __g1_vec_rotate_inserted(&mut *value, length, index);
            Result::Ok(())
        },
        __Branch::select(false) => Result::Err(move item)
    }
}

__g1_vec_append_drain<T>(target: &mut Vec<T>, source: Vec<T>) {
    let length = __g1_array_len(&source.storage);
    handle __Branch::select(length == 0) {
        __Branch::select(true) => {
            let Vec { storage } = move source;
            __g1_array_finish_drained(move storage)
        },
        __Branch::select(false) => {
            let item = __g1_array_pop_move(&mut source.storage);
            __g1_array_push_move(&mut target.storage, move item);
            __g1_vec_append_drain(move target, move source)
        }
    }
}

// Reverse once so the tail-draining loop appends in the source's original
// order. The exhausted private shell is then consumed by finish_drained.
__g1_vec_append<T>(target: &mut Vec<T>, source: Vec<T>) {
    __g1_vec_reverse(&mut source);
    __g1_vec_append_drain(target, move source)
}

__g1_vec_split_pop<T>(value: &mut Vec<T>, output: &mut Vec<T>, remaining: usize) {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            Vec::push(&mut *output, __g1_array_pop_move(&mut value.storage));
            __g1_vec_split_pop(
                move value,
                move output,
                __g1_parse_usize_predecessor(move remaining)
            )
        }
    }
}

__g1_vec_split_off_unchecked<T>(value: &mut Vec<T>, at: usize) -> Vec<T> {
    let output = Vec::new();
    let length = Vec::len(&*value);
    __g1_vec_split_pop(move value, &mut output, length - move at);
    __g1_vec_reverse(&mut output);
    move output
}

__g1_vec_split_off<T>(value: &mut Vec<T>, at: usize) -> Result<Vec<T>, ()> {
    let length = Vec::len(&*value);
    handle at <= length {
        Result::Ok(_) => Result::Ok(__g1_vec_split_off_unchecked(move value, move at)),
        Result::Err(_) => Result::Err(())
    }
}

__g1_vec_drain<T>(value: &mut Vec<T>, range: Range<usize>) -> Result<Vec<T>, ()> {
    let start = range.start;
    let end = range.end;
    let length = Vec::len(&*value);
    handle start <= end {
        Result::Err(_) => Result::Err(()),
        Result::Ok(_) => handle end <= length {
            Result::Err(_) => Result::Err(()),
            Result::Ok(_) => {
                let drained_and_after = __g1_vec_split_off_unchecked(&mut *value, start);
                let after = __g1_vec_split_off_unchecked(&mut drained_and_after, end - start);
                Vec::append(move value, move after);
                Result::Ok(move drained_and_after)
            }
        }
    }
}

__g1_vec_index<'a, T>(value: &'a Vec<T>, index: usize) -> &'a T {
    __g1_array_get_borrow_shared(&value.storage, index)
}

__g1_vec_index_mut<'a, T>(value: &'a mut Vec<T>, index: usize) -> &'a mut T {
    __g1_array_get_borrow_unique(&mut value.storage, index)
}

let Vec::new = __g1_vec_new;
let Vec::with_capacity = __g1_vec_with_capacity;
let Vec::len = __g1_vec_len;
let Vec::capacity = __g1_vec_capacity;
let Vec::reserve = __g1_vec_reserve;
let Vec::push = __g1_vec_push;
let Vec::is_empty = __g1_vec_is_empty;
let Vec::pop = __g1_vec_pop;
let Vec::truncate = __g1_vec_truncate;
let Vec::checkpoint = __g1_vec_checkpoint;
let VecCheckpoint::commit = __g1_vec_checkpoint_commit;
let Vec::with_range = with_range;
let Vec::try_with_range = try_with_range;
let Vec::clear = __g1_vec_clear;
let Vec::split_off = __g1_vec_split_off;
let Vec::drain = __g1_vec_drain;
let Vec::resize = __g1_vec_resize;
let Vec::get = __g1_vec_get;
let Vec::get_mut = __g1_vec_get_mut;
let Vec::first = __g1_vec_first;
let Vec::last = __g1_vec_last;
