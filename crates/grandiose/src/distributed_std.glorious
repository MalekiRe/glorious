assert_eq<T>(left: &T, right: &T) where T: Eq { assert(Eq::eq(left, right)) }

// Formatting remains an ordinary generic library callable.  It dispatches
// through Display, writes directly into the policy formatter, and validates
// UTF-8 exactly once when the builder is finished.
format<T>(value: &T) -> Result<String, Utf8Error> where T: Display {
    let formatter = Formatter::new();
    Display::fmt(value, &mut formatter);
    Formatter::finish(move formatter)
}

format_debug<T>(value: &T) -> Result<String, Utf8Error> where T: Debug {
    let formatter = Formatter::new();
    Debug::fmt(value, &mut formatter);
    Formatter::finish(move formatter)
}

__g1_formatter_display<T>(value: &mut Formatter, item: &T) where T: Display {
    Display::fmt(item, move value)
}

__g1_formatter_debug<T>(value: &mut Formatter, item: &T) where T: Debug {
    Debug::fmt(item, move value)
}

let Formatter::display = __g1_formatter_display;
let Formatter::debug = __g1_formatter_debug;
