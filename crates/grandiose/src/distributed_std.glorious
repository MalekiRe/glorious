// Numeric selection stays in ordinary source code: comparison lowering is the
// only scalar-specific mechanism involved. The unrestricted-use bound is the
// precise ownership contract for inspecting candidates and discarding the
// values which are not selected.
min<T>(left: T, right: T) -> T where T: Use<[0, *]>,
T: Less {
    handle left < right { Result::Ok(_) => left, Result::Err(_) => right }
}

max<T>(left: T, right: T) -> T where T: Use<[0, *]>,
T: Less {
    handle left < right { Result::Ok(_) => right, Result::Err(_) => left }
}

clamp<T>(value: T, lower: T, upper: T) -> T where T: Use<[0, *]>,
T: Less {
    handle value < lower {
        Result::Ok(_) => lower,
        Result::Err(_) => handle upper < value { Result::Ok(_) => upper, Result::Err(_) => value }
    }
}

__g1_checked_conversion_valid<T, U>(value: T, candidate: U, roundtrip: T) -> Bool where T: Use<
    [0, *]
>,
T: Equal,
T: Less,
U: Use<[0, *]>,
U: Less {
    handle value == roundtrip {
        Result::Ok(_) => handle value < 0 {
            Result::Ok(_) => candidate < 0,
            Result::Err(_) => handle candidate < 0 {
                Result::Ok(_) => false,
                Result::Err(_) => true
            }
        },
        Result::Err(_) => false
    }
}

__g1_usize_successor(value: usize) -> usize { move value + 1 }

