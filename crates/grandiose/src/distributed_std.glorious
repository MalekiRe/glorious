// Structural fundamental traits. Option<T> is the transparent Result<T, ()>
// alias, so the Result implementations below are also its coherent evidence.
__g1_structural_eq<T>(left: &T, right: &T) -> Bool where T: Eq { Eq::eq(left, right) }

__g1_structural_cmp<T>(left: &T, right: &T) -> Ordering where T: Ord { Ord::cmp(left, right) }

