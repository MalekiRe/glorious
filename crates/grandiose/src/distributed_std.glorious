__g1_byte_reader_is_empty(value: &ByteReader) -> Bool { __g1_byte_reader_remaining(value) == 0 }

__g1_byte_reader_word_at(bytes: Bytes, cursor: usize, remaining: usize, shift: u32, result: u128) -> u128 {
