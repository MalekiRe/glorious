    let candidate = __g1_int_convert_wrapping_to_i32(value);
    let roundtrip = __g1_int_convert_wrapping_to_i128(candidate);
    handle __g1_checked_conversion_valid(value, candidate, roundtrip) {
        Result::Ok(_) => Option::Some(__g1_int_convert_checked_to_i32(value)),
        Result::Err(_) => None
    }
}

checked_i128_to_i64(value: i128) -> Option<i64> {
    let candidate = __g1_int_convert_wrapping_to_i64(value);
    let roundtrip = __g1_int_convert_wrapping_to_i128(candidate);
