// Manifest-bound host leaves. Their declaration identities, not these source
// spellings, select the four frozen Host ABI G1 imports.
__g1_process_args_get() -> Array<Text> { () }

__g1_fs_read(path: Text) -> Bytes { () }

__g1_fs_write(path: Text, bytes: Bytes) { () }

__g1_diagnostic_write(text: Text) { () }

// Whole-value ownership utilities. `replace` and `swap` are deliberately
// expressed through unique-reference move-out plus exact reinitialization, so
// they work for values whose principal Use interval forbids implicit destroy.
identity<T>(value: T) -> T { move value }

// Explicitly consume a value whose quantitative contract permits destruction.
// Continuations with a zero lower bound use this same ordinary operation.
discard<T>(value: T) where T: Use<[0, 0]> {
    value;
    ()
}

replace<T>(target: &mut T, incoming: T) -> T {
    let previous = move *target;
    *target = move incoming;
    move previous
}

swap<T>(left: &mut T, right: &mut T) {
    let left_value = move *left;
    let right_value = move *right;
    *left = move right_value;
    *right = move left_value;
}

enum Result<T, E> { Ok(T), Err(E) }

// The one inspection protocol used by source-defined control flow.  Pattern
// elimination remains an ordinary terminal effect; callers no longer need to
// mint a nominal protocol for every inspected payload type.
type Option<T> = Result<T, ()>;
let Option::Some = Result::Ok;
let None = Result::Err(());
type Bool = Option<()>;
__g1_bool(value: Bool) -> Bool { value }

__g1_bool_true() -> Bool { Result::Ok(()) }

__g1_bool_false() -> Bool { Result::Err(()) }

let true = __g1_bool_true();
let false = __g1_bool_false();
effect __Branch { select(condition: Bool) -> ! }
effect __U32Branch { select(value: u32) -> ! }

type String = Text;
struct Range<T> { start: T, end: T }

impl < T > Use<[0, *]> for Range<T> where T: Use<[0, *]> {}

struct Utf8Error { valid_up_to: usize }

enum TextRangeError { Reversed, OutOfBounds, NotCharBoundary }

enum CharFromU32Error { InvalidScalar }

struct DecodedChar { value: char, next: usize }

abort() -> !{ __g1_abort() }

unreachable() -> !{ __g1_abort() }

assert(condition: Bool) { handle move condition { true => (), false => abort() } }

__g1_char_scalar_valid(value: u32) -> Bool {
    handle value <= 1114111 {
        true => { handle value < 55296 { true => true, false => 57343 < value } },
        false => false
    }
}

__g1_char_from_u32(value: u32) -> Result<char, CharFromU32Error> {
    handle __g1_char_scalar_valid(value) {
        true => Result::Ok(__g1_char_from_u32_checked(move value)),
        false => Result::Err(CharFromU32Error::InvalidScalar)
    }
}

__g1_char_to_u32_public(value: char) -> u32 { __g1_char_to_u32(move value) }

__g1_char_utf8_len(value: char) -> usize {
    let scalar = __g1_char_to_u32(move value);
    handle scalar <= 127 {
        true => 1,
        false => handle scalar <= 2047 {
            true => 2,
            false => handle scalar <= 65535 { true => 3, false => 4 }
        }
    }
}

// Public character scalar surface.  The checked constructor is deliberately
// result-returning; only the private manifest leaf may trap on a non-scalar.
char_is_valid_scalar(value: u32) -> Bool { __g1_char_scalar_valid(move value) }

char_from_u32(value: u32) -> Result<char, CharFromU32Error> { __g1_char_from_u32(move value) }

char_to_u32(value: char) -> u32 { __g1_char_to_u32_public(move value) }

char_utf8_len(value: char) -> usize { __g1_char_utf8_len(move value) }

// Layer 2: result-based control. These are ordinary source declarations: the
// fixities determine grouping, and the Fn constraints are the only source of
// right-hand laziness.
infixl 20 ==;
infixl 20 !=;
infixl 20 <;
infixl 20 <=;
infixl 20 >;
infixl 20 >=;
infixl 30 +;
infixl 30 -;
infixl 40 *;
infixl 40 /;
infixl 40 %;
infixr 1 else;
infixl 2 or;
infixl 3 and;
prefix 4 not;
if<A, E, B, F>(condition: Result<A, E>, body: F) -> Result<B, E> where F: Fn<(), Output = B>,
A: Use<[0, 0]> {
    handle condition {
        Result::Ok(_) => Result::Ok(body()),
        Result::Err(error) => Result::Err(error)
    }
}

else<A, E, F>(value: Result<A, E>, fallback: F) -> A where F: Fn<(), Output = A>,
E: Use<[0, 0]> { handle value { Result::Ok(result) => result, Result::Err(_) => fallback() } }

and<A, E, B, F>(value: Result<A, E>, next: F) -> Result<B, E> where F: Fn<(), Output = Result<B, E>>,
A: Use<[0, 0]> {
    handle value { Result::Ok(_) => next(), Result::Err(error) => Result::Err(error) }
}

or<A, E, E2, F>(value: Result<A, E>, alternative: F) -> Result<A, E2> where F: Fn<
    (),
    Output = Result<A, E2>
>,
E: Use<[0, 0]> {
    handle value { Result::Ok(result) => Result::Ok(result), Result::Err(_) => alternative() }
}

not<A, E>(value: Result<A, E>) -> Result<E, A> {
    handle value {
        Result::Ok(result) => Result::Err(result),
        Result::Err(error) => Result::Ok(error)
    }
}

// Result/Option ownership combinators. These are free source callables bound
// into the nominal namespaces below; callbacks receive payloads by move, and
// only predicates/defaulting operations require zero-use evidence for values
// they intentionally discard.
__g1_result_is_ok<A, E>(value: Result<A, E>) -> Bool where A: Use<[0, 0]>,
E: Use<[0, 0]> { handle value { Result::Ok(_) => true, Result::Err(_) => false } }

__g1_result_is_err<A, E>(value: Result<A, E>) -> Bool where A: Use<[0, 0]>,
E: Use<[0, 0]> { not(__g1_result_is_ok(move value)) }

__g1_result_map<A, E, B, F>(value: Result<A, E>, transform: F) -> Result<B, E> where F: Fn<
    (A),
    Output = B
>,
F: Use<[0, 0]> {
    handle value {
        Result::Ok(result) => Result::Ok(transform(move result)),
        Result::Err(error) => Result::Err(error)
    }
}

__g1_result_map_err<A, E, E2, F>(value: Result<A, E>, transform: F) -> Result<A, E2> where F: Fn<
    (E),
    Output = E2
>,
F: Use<[0, 0]> {
    handle value {
        Result::Ok(result) => Result::Ok(result),
        Result::Err(error) => Result::Err(transform(move error))
    }
}

__g1_result_and_then<A, E, B, F>(value: Result<A, E>, transform: F) -> Result<B, E> where F: Fn<
    (A),
    Output = Result<B, E>
>,
F: Use<[0, 0]> {
    handle value {
        Result::Ok(result) => transform(move result),
        Result::Err(error) => Result::Err(error)
    }
}

__g1_result_or_else<A, E, E2, F>(value: Result<A, E>, transform: F) -> Result<A, E2> where F: Fn<
    (E),
    Output = Result<A, E2>
>,
F: Use<[0, 0]> {
    handle value {
        Result::Ok(result) => Result::Ok(result),
        Result::Err(error) => transform(move error)
    }
}

__g1_result_unwrap_or<A, E>(value: Result<A, E>, fallback: A) -> A where A: Use<[0, 0]>,
E: Use<[0, 0]> { handle value { Result::Ok(result) => result, Result::Err(_) => fallback } }

__g1_option_map<A, B, F>(value: Option<A>, transform: F) -> Option<B> where F: Fn<(A), Output = B>,
F: Use<[0, 0]> {
    handle value {
        Result::Ok(result) => Option::Some(transform(move result)),
        Result::Err(_) => None
    }
}

__g1_option_and_then<A, B, F>(value: Option<A>, transform: F) -> Option<B> where F: Fn<
    (A),
    Output = Option<B>
>,
F: Use<[0, 0]> {
    handle value { Result::Ok(result) => transform(move result), Result::Err(_) => None }
}

__g1_option_or_else<A, F>(value: Option<A>, fallback: F) -> Option<A> where F: Fn<
    (),
    Output = Option<A>
>,
F: Use<[0, 0]> {
    handle value { Result::Ok(result) => Option::Some(result), Result::Err(_) => fallback() }
}

__g1_option_unwrap_or<A>(value: Option<A>, fallback: A) -> A where A: Use<[0, 0]> {
    handle value { Result::Ok(result) => result, Result::Err(_) => fallback }
}

__g1_result_as_ref<'a, A, E>(value: &'a Result<A, E>) -> Result<& 'a A, &'a E> {
    if(*value is Result::Ok(_)) {
        Result::Ok(&value.0)
    } else { Result::Err(&value.0) }
}

__g1_result_as_mut<'a, A, E>(value: &'a mut Result<A, E>) -> Result<& 'a mut A, &'a mut E> {
    if(*value is Result::Ok(_)) {
        Result::Ok(&mut value.0)
    } else { Result::Err(&mut value.0) }
}

