struct WorkQueue<I> { private queued: BitSet<I>, private items: Vec<Id<I>>, private length: usize }

__g1_work_queue_new<I>() -> WorkQueue<I> {
    WorkQueue { queued: BitSet::new(), items: Vec::new(), length: 0 }
}

__g1_work_queue_len<I>(value: &WorkQueue<I>) -> usize { value.length }

__g1_work_queue_push<I>(value: &mut WorkQueue<I>, id: Id<I>) -> Bool {
    let length = value.length;
    let inserted = BitSet::insert(&mut value.queued, id);
    handle move inserted {
        Result::Ok(_) => {
            Vec::push(&mut value.items, move id);
            (*value).length = length + 1;
            true
        },
        Result::Err(_) => false
    }
}

__g1_work_queue_pop<I>(value: &mut WorkQueue<I>) -> Option<Id<I>> {
    let length = value.length;
    handle length == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => {
            let id = __g1_array_get_copy(&value.items.storage, 0);
            Vec::remove(&mut value.items, 0);
            (*value).length = length - 1;
            BitSet::remove(&mut value.queued, id);
            Option::Some(move id)
        }
    }
}

