// Ordinary ordering algorithms.  Every recursive edge shrinks an index range;
// introsort additionally carries the conventional `2 * floor(log2(n))` depth
// budget and switches to heapsort when hostile partitions exhaust it.  Thus no
// input can turn quicksort's recursion into an unbounded source-level call
// chain, and all operation counts depend only on the input and its ordering.
__g1_algorithm_cmp<T>(left: &T, right: &T) -> Ordering where T: Ord { Ord::cmp(left, right) }

__g1_algorithm_eq<T>(left: &T, right: &T) -> Bool where T: Eq { Eq::eq(left, right) }

__g1_vec_cmp_at<T>(value: &Vec<T>, left: usize, right: usize) -> Ordering where T: Ord {
    __g1_algorithm_cmp(__g1_vec_index(value, left), __g1_vec_index(value, right))
}

__g1_vec_eq_at<T>(value: &Vec<T>, left: usize, right: usize) -> Bool where T: Eq {
    __g1_algorithm_eq(__g1_vec_index(value, left), __g1_vec_index(value, right))
}

__g1_vec_largest_child<T>(value: &Vec<T>, start: usize, child: usize, right: usize, length: usize) -> usize where T: Ord {
    handle right < length {
        Result::Err(_) => child,
        Result::Ok(_) => {
            let order = __g1_vec_cmp_at(value, start + child, start + right);
            if(order is Ordering::Less) {
                right
            } else { child }
        }
    }
}

__g1_algorithm_floor_log2(value: usize, result: usize) -> usize {
    handle value < 2 {
        Result::Ok(_) => move result,
        Result::Err(_) => __g1_algorithm_floor_log2(value / 2, result + 1)
    }
}

__g1_algorithm_min_usize(left: usize, right: usize) -> usize {
    handle left < right { Result::Ok(_) => left, Result::Err(_) => right }
}

__g1_vec_sift_down<T>(value: &mut Vec<T>, start: usize, length: usize, root: usize) where T: Ord {
    let child = root + root + 1;
    handle child < length {
        Result::Err(_) => {
            value;
            ()
        },
        Result::Ok(_) => {
            let right = child + 1;
            let largest = __g1_vec_largest_child(&*value, start, child, right, length);
            let order = __g1_vec_cmp_at(&*value, start + root, start + largest);
            if(order is Ordering::Less) {
                __g1_vec_swap(&mut *value, start + root, start + largest);
                __g1_vec_sift_down(move value, start, length, largest)
            } else {
                value;
                ()
            }
        }
    }
}

__g1_vec_heap_build<T>(value: &mut Vec<T>, start: usize, length: usize, node: usize) where T: Ord {
    handle node == 0 {
        Result::Ok(_) => {
            value;
            ()
        },
        Result::Err(_) => {
            let next = node - 1;
            __g1_vec_sift_down(&mut *value, start, length, next);
            __g1_vec_heap_build(move value, start, length, next)
        }
    }
}

__g1_vec_heap_extract<T>(value: &mut Vec<T>, start: usize, length: usize, remaining: usize) where T: Ord {
    handle remaining <= 1 {
        Result::Ok(_) => {
            value;
            ()
        },
        Result::Err(_) => {
            let next = remaining - 1;
            __g1_vec_swap(&mut *value, start, start + next);
            __g1_vec_sift_down(&mut *value, start, next, 0);
            __g1_vec_heap_extract(move value, start, length, next)
        }
    }
}

__g1_vec_heap_sort_range<T>(value: &mut Vec<T>, start: usize, end: usize) where T: Ord {
    let length = end - start;
    __g1_vec_heap_build(&mut *value, start, length, length / 2);
    __g1_vec_heap_extract(move value, start, length, length)
}

__g1_vec_partition_pivot<T>(
    value: &mut Vec<T>,
    low: usize,
    pivot: usize,
    cursor: usize,
    store: usize
) -> usize where T: Ord {
    handle cursor < pivot {
        Result::Err(_) => {
            __g1_vec_swap(move value, store, pivot);
            store
        },
        Result::Ok(_) => {
            let order = __g1_vec_cmp_at(&*value, cursor, pivot);
            if(order is Ordering::Less) {
                __g1_vec_swap(&mut *value, cursor, store);
                __g1_vec_partition_pivot(move value, low, pivot, cursor + 1, store + 1)
            } else { __g1_vec_partition_pivot(move value, low, pivot, cursor + 1, store) }
        }
    }
}

__g1_vec_intro_sort_range<T>(value: &mut Vec<T>, low: usize, high: usize, depth: usize) where T: Ord {
    let length = high - low;
    handle length <= 1 {
        Result::Ok(_) => {
            value;
            ()
        },
        Result::Err(_) => handle depth == 0 {
            Result::Ok(_) => __g1_vec_heap_sort_range(move value, low, high),
            Result::Err(_) => {
                let pivot = high - 1;
                __g1_vec_swap(&mut *value, low + length / 2, pivot);
                let split = __g1_vec_partition_pivot(&mut *value, low, pivot, low, low);
                let next_depth = depth - 1;
                __g1_vec_intro_sort_range(&mut *value, low, split, next_depth);
                __g1_vec_intro_sort_range(move value, split + 1, high, next_depth)
            }
        }
    }
}

__g1_vec_sort<T>(value: &mut Vec<T>) where T: Ord {
    let length = Vec::len(&*value);
    let depth = __g1_algorithm_floor_log2(length, 0);
    __g1_vec_intro_sort_range(move value, 0, length, __g1_integer_add(depth, depth))
}

// The merge pass is stable: an element from the right half moves only when it
// is strictly less than the current left element.  Rotation uses swaps, so it
// works for must-move elements without fabricating a temporary T or abandoning
// one. Comparisons remain O(n log n); the in-place rotations trade storage for
// a deterministic O(n^2) worst-case move bound.
__g1_vec_merge_rotate<T>(value: &mut Vec<T>, cursor: usize, destination: usize) {
    handle destination < cursor {
        Result::Err(_) => {
            value;
            ()
        },
        Result::Ok(_) => {
            __g1_vec_swap(&mut *value, cursor - 1, cursor);
            __g1_vec_merge_rotate(move value, cursor - 1, move destination)
        }
    }
}

__g1_vec_merge<T>(value: &mut Vec<T>, left: usize, middle: usize, right: usize, cursor: usize) where T: Ord {
    handle cursor < middle {
        Result::Err(_) => {
            value;
            ()
        },
        Result::Ok(_) => handle middle < right {
            Result::Err(_) => {
                value;
                ()
            },
            Result::Ok(_) => {
                let order = __g1_vec_cmp_at(&*value, middle, cursor);
                if(order is Ordering::Less) {
                    __g1_vec_merge_rotate(&mut *value, middle, cursor);
                    __g1_vec_merge(move value, left, middle + 1, right, cursor + 1)
                } else { __g1_vec_merge(move value, left, middle, right, cursor + 1) }
            }
        }
    }
}

__g1_vec_stable_sort_range<T>(value: &mut Vec<T>, low: usize, high: usize) where T: Ord {
    let length = high - low;
    handle length <= 1 {
        Result::Ok(_) => {
            value;
            ()
        },
        Result::Err(_) => {
            let middle = low + length / 2;
            __g1_vec_stable_sort_range(&mut *value, low, middle);
            __g1_vec_stable_sort_range(&mut *value, middle, high);
            __g1_vec_merge(move value, low, middle, high, low)
        }
    }
}

__g1_vec_sort_stable<T>(value: &mut Vec<T>) where T: Ord {
    let length = Vec::len(&*value);
    __g1_vec_stable_sort_range(move value, 0, length)
}

__g1_vec_lower_bound_range<T>(value: &Vec<T>, target: &T, low: usize, high: usize) -> usize where T: Ord {
    handle low < high {
        Result::Err(_) => move low,
        Result::Ok(_) => {
            let middle = low + (high - low) / 2;
            let order = __g1_algorithm_cmp(__g1_vec_index(value, middle), target);
            if(order is Ordering::Less) {
                __g1_vec_lower_bound_range(value, target, middle + 1, high)
            } else { __g1_vec_lower_bound_range(value, target, low, middle) }
        }
    }
}

__g1_vec_lower_bound<T>(value: &Vec<T>, target: &T) -> usize where T: Ord {
    __g1_vec_lower_bound_range(value, target, 0, Vec::len(value))
}

__g1_vec_upper_bound_range<T>(value: &Vec<T>, target: &T, low: usize, high: usize) -> usize where T: Ord {
    handle low < high {
        Result::Err(_) => move low,
        Result::Ok(_) => {
            let middle = low + (high - low) / 2;
            let order = __g1_algorithm_cmp(target, __g1_vec_index(value, middle));
            if(order is Ordering::Less) {
                __g1_vec_upper_bound_range(value, target, low, middle)
            } else { __g1_vec_upper_bound_range(value, target, middle + 1, high) }
        }
    }
}

__g1_vec_upper_bound<T>(value: &Vec<T>, target: &T) -> usize where T: Ord {
    __g1_vec_upper_bound_range(value, target, 0, Vec::len(value))
}

__g1_vec_binary_search<T>(value: &Vec<T>, target: &T) -> Option<usize> where T: Ord {
    let lower = __g1_vec_lower_bound(value, target);
    let upper = __g1_vec_upper_bound(value, target);
    value;
    target;
    handle __g1_integer_less(lower, upper) {
        Result::Ok(_) => Option::Some(lower),
        Result::Err(_) => None
    }
}

// Partition around a borrowed ordering key. Elements strictly below the key
// precede the returned boundary; all others follow it. The key is external to
// the Vec, so swaps cannot invalidate the borrow.
__g1_vec_partition_boundary<T>(value: &mut Vec<T>, cursor: usize, boundary: usize, selected: Bool) -> usize {
    handle move selected {
        Result::Ok(_) => {
            __g1_vec_swap(move value, cursor, boundary);
            boundary + 1
        },
        Result::Err(_) => {
            value;
            boundary
        }
    }
}

__g1_vec_partition_at<T>(
    value: &mut Vec<T>,
    pivot: &T,
    cursor: usize,
    boundary: usize,
    length: usize
) -> usize where T: Ord {
    handle cursor < length {
        Result::Err(_) => move boundary,
        Result::Ok(_) => {
            let order = __g1_algorithm_cmp(__g1_vec_index(&*value, cursor), pivot);
            let selected = order is Ordering::Less;
            let next = __g1_vec_partition_boundary(&mut *value, cursor, boundary, move selected);
            __g1_vec_partition_at(move value, move pivot, cursor + 1, move next, length)
        }
    }
}

__g1_vec_partition<T>(value: &mut Vec<T>, pivot: &T) -> usize where T: Ord {
    let length = Vec::len(&*value);
    __g1_vec_partition_at(value, pivot, 0, 0, length)
}

__g1_vec_dedup_from<T>(value: &mut Vec<T>, cursor: usize, write: usize, length: usize) where T: Eq,
T: Use<[0, 0]> {
    handle cursor < length {
        Result::Err(_) => Vec::truncate(move value, write),
        Result::Ok(_) => {
            let duplicate = __g1_vec_eq_at(&*value, write - 1, cursor);
            handle move duplicate {
                Result::Ok(_) => __g1_vec_dedup_from(move value, cursor + 1, write, length),
                Result::Err(_) => {
                    __g1_vec_swap(&mut *value, cursor, write);
                    __g1_vec_dedup_from(move value, cursor + 1, write + 1, length)
                }
            }
        }
    }
}

__g1_vec_dedup<T>(value: &mut Vec<T>) where T: Eq,
T: Use<[0, 0]> {
    let length = Vec::len(&*value);
    handle length < 2 {
        Result::Ok(_) => {
            value;
            ()
        },
        Result::Err(_) => __g1_vec_dedup_from(move value, 1, 1, length)
    }
}

__g1_vec_lexicographic_at<T>(left: &Vec<T>, right: &Vec<T>, cursor: usize, common: usize) -> Ordering where T: Ord {
    handle cursor < common {
        Result::Ok(_) => {
            let order = __g1_algorithm_cmp(
                __g1_vec_index(left, cursor),
                __g1_vec_index(right, cursor)
            );
            handle move order {
                Ordering::Less => {
                    left;
                    right;
                    Ordering::Less
                },
                Ordering::Greater => {
                    left;
                    right;
                    Ordering::Greater
                },
                Ordering::Equal => __g1_vec_lexicographic_at(left, right, cursor + 1, common)
            }
        },
        Result::Err(_) => {
            let left_length = Vec::len(left);
            let right_length = Vec::len(right);
            __g1_ordering_from_flags(
                __g1_integer_less(left_length, right_length),
                __g1_integer_equal(left_length, right_length)
            )
        }
    }
}

__g1_vec_lexicographic_cmp<T>(left: &Vec<T>, right: &Vec<T>) -> Ordering where T: Ord {
    let left_length = Vec::len(left);
    let right_length = Vec::len(right);
    let common = __g1_algorithm_min_usize(left_length, right_length);
    __g1_vec_lexicographic_at(left, right, 0, common)
}

__g1_vec_structural_eq_at<T>(
    left: &Vec<T>,
    right: &Vec<T>,
    index: usize,
    length: usize
) -> Bool where T: Eq {
    if(index < length) {
        if(__g1_algorithm_eq(
            Vec::index(left, index),
            Vec::index(right, index)
        )) {
            __g1_vec_structural_eq_at(
                left,
                right,
                index + 1,
                length
            )
        } else { false }
    } else { true }
}

impl < T > Eq for Vec<T> where T: Eq {
    eq(self: &Vec<T>, other: &Vec<T>) -> Bool {
        let length = Vec::len(self);
        if(length == Vec::len(other)) {
            __g1_vec_structural_eq_at(self, other, 0, length)
        } else { false }
    }
}

impl < T > Ord for Vec<T> where T: Ord {
    cmp(self: &Vec<T>, other: &Vec<T>) -> Ordering {
        __g1_vec_lexicographic_cmp(self, other)
    }
}

let Vec::sort = __g1_vec_sort;
let Vec::sort_stable = __g1_vec_sort_stable;
let Vec::binary_search = __g1_vec_binary_search;
let Vec::lower_bound = __g1_vec_lower_bound;
let Vec::upper_bound = __g1_vec_upper_bound;
let Vec::partition = __g1_vec_partition;
let Vec::dedup = __g1_vec_dedup;
let Vec::lexicographic_cmp = __g1_vec_lexicographic_cmp;
// Deterministic open-addressed compiler collections. Empty buckets use the
// payload-free `Result::Err(())` state;
// every occupied bucket owns exactly one `(K, V)` pair. Capacity is always a
// power of two and growth happens before the table reaches three quarters
// full, leaving every bounded probe with an empty stopping bucket.
struct HashMap<K, V> { private buckets: Vec<Result<(K, V), ()>>, private length: usize }

struct __HashProbe { index: usize, found: Bool }

__g1_hash_map_new<K, V>() -> HashMap<K, V> { HashMap { buckets: Vec::new(), length: 0 } }

__g1_hash_map_fresh<K, V>(value: &HashMap<K, V>) -> HashMap<K, V> {
    value;
    __g1_hash_map_new()
}

__g1_hash_map_capacity_for(requested: usize, candidate: usize) -> usize {
    handle candidate >= requested {
        Result::Ok(_) => move candidate,
        Result::Err(_) => __g1_hash_map_capacity_for(requested, candidate + candidate)
    }
}

__g1_hash_map_len<K, V>(value: &HashMap<K, V>) -> usize { value.length }

__g1_hash_map_capacity<K, V>(value: &HashMap<K, V>) -> usize { Vec::len(&value.buckets) }

__g1_hash_map_is_empty<K, V>(value: &HashMap<K, V>) -> Bool { value.length == 0 }

__g1_hash_map_empty<K, V>(value: &HashMap<K, V>) -> Result<(K, V), ()> {
    value;
    Result::Err(())
}

__g1_hash_map_fill_empty<K, V>(value: &mut HashMap<K, V>, capacity: usize) {
    let current = Vec::len(&value.buckets);
    handle current < capacity {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let empty = __g1_hash_map_empty(&*value);
            Vec::push(&mut value.buckets, move empty);
            __g1_hash_map_fill_empty(move value, move capacity)
        }
    }
}

// The ownership-general reserve primitive operates on an empty table.  The
// map argument supplies generic evidence without inventing a K or V, and no
// resident entry is copied or discarded.  A nonempty table reports `false`;
// the ordinary `insert` path performs ownership-permitting rehash growth.
__g1_hash_map_reserve<K, V>(value: &mut HashMap<K, V>, requested: usize) -> Bool {
    handle value.length == 0 {
        Result::Err(_) => false,
        Result::Ok(_) => {
            let current = Vec::len(&value.buckets);
            handle current >= requested {
                Result::Ok(_) => true,
                Result::Err(_) => {
                    let capacity = __g1_hash_map_capacity_for(requested, 8);
                    __g1_hash_map_fill_empty(move value, move capacity);
                    true
                }
            }
        }
    }
}

__g1_hash_map_occupied<K, V>(key: K, item: V) -> Result<(K, V), ()> {
    Result::Ok((move key, move item))
}

__g1_hash_map_hash<K>(key: &K) -> u64 where K: Hash {
    let state = Hasher::new();
    Hash::hash(key, &mut state);
    Hasher::finish(&state)
}

__g1_hash_map_start<K>(key: &K, capacity: usize) -> usize where K: Hash {
    wrapping_convert_to_usize(
        __g1_u64_rem(__g1_hash_map_hash(key), wrapping_convert_to_u64(move capacity))
    )
}

__g1_hash_map_next(index: usize, capacity: usize) -> usize {
    let next = __g1_usize_successor(index);
    handle next == capacity { Result::Ok(_) => 0, Result::Err(_) => move next }
}

__g1_hash_map_keys_equal<K>(left: &K, right: &K) -> Bool where K: Eq { Eq::eq(left, right) }

__g1_hash_map_bucket_key<'a, K, V>(bucket: &'a Result<(K, V), ()>) -> Option<& 'a K> {
    if(*bucket is Result::Ok(_)) {
        Option::Some(&bucket.0.0)
    } else { None }
}

__g1_hash_map_probe<K, V>(value: &HashMap<K, V>, key: &K, index: usize, remaining: usize) -> __HashProbe where K: Eq {
    handle remaining == 0 {
        Result::Ok(_) => __HashProbe { index: move index, found: false },
        Result::Err(_) => {
            let bucket = __g1_vec_index(&value.buckets, index);
            handle __g1_hash_map_bucket_key(bucket) {
                Result::Ok(found) => handle __g1_hash_map_keys_equal(move found, key) {
                    Result::Ok(_) => __HashProbe { index: move index, found: true },
                    Result::Err(_) => __g1_hash_map_probe(
                        value,
                        key,
                        __g1_hash_map_next(move index, Vec::len(&value.buckets)),
                        __g1_parse_usize_predecessor(move remaining)
                    )
                },
                Result::Err(_) => __HashProbe { index: move index, found: false }
            }
        }
    }
}

__g1_hash_map_find<K, V>(value: &HashMap<K, V>, key: &K) -> __HashProbe where K: Eq,
K: Hash {
    let capacity = Vec::len(&value.buckets);
    __g1_hash_map_probe(value, key, __g1_hash_map_start(key, capacity), move capacity)
}

__g1_hash_map_get<'a, K, V>(value: &'a HashMap<K, V>, key: &K) -> Option<& 'a V> where K: Eq,
K: Hash {
    let capacity = Vec::len(&value.buckets);
    handle capacity == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => {
            let probe = __g1_hash_map_find(value, key);
            handle move probe.found {
                Result::Ok(_) => {
                    let bucket = __g1_vec_index(&value.buckets, probe.index);
                    if(*bucket is Result::Ok(_)) {
                        __g1_hash_map_borrowed(& (*bucket).0.1)
                    } else { None }
                },
                Result::Err(_) => None
            }
        }
    }
}

__g1_hash_map_get_mut<'a, K, V>(value: &'a mut HashMap<K, V>, key: &K) -> Option<& 'a mut V> where K: Eq,
K: Hash {
    let capacity = Vec::len(&value.buckets);
    handle capacity == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => {
            let probe = __g1_hash_map_find(&*value, key);
            handle move probe.found {
                Result::Err(_) => None,
                Result::Ok(_) => {
                    let bucket = __g1_vec_index_mut(&mut value.buckets, probe.index);
                    if(*bucket is Result::Ok(_)) {
                        Option::Some(&mut bucket.0.1)
                    } else { None }
                }
            }
        }
    }
}

__g1_hash_map_contains_key<K, V>(value: &HashMap<K, V>, key: &K) -> Bool where K: Eq,
K: Hash {
    let capacity = Vec::len(&value.buckets);
    handle capacity == 0 {
        Result::Ok(_) => false,
        Result::Err(_) => __g1_hash_map_find(value, key).found
    }
}

__g1_hash_map_borrowed<'a, V>(value: &'a V) -> Option<& 'a V> { Option::Some(move value) }

__g1_hash_map_insert_at<K, V>(value: &mut HashMap<K, V>, key: K, item: V, probe: __HashProbe) -> Option<
    V
> where K: Use<[0, 0]> {
    let replacement = __g1_hash_map_occupied(move key, move item);
    let previous = replace(__g1_vec_index_mut(&mut value.buckets, probe.index), move replacement);
    handle move previous {
        Result::Ok(pair) => {
            let(previous_key, previous_value) = move pair;
            previous_key;
            Option::Some(move previous_value)
        },
        Result::Err(_) => {
            (*value).length = __g1_usize_successor(value.length);
            None
        }
    }
}

// The ownership-general insertion path never discards an incoming key or
// value. It expects spare capacity; a full/threshold table returns ownership
// to the caller, as does an occupied key. This lets restricted values use a
// table after an explicit `with_capacity`/`reserve` decision.
__g1_hash_map_try_insert_ok<K, V>() -> Result<(), (K, V)> { Result::Ok(()) }

__g1_hash_map_try_insert_error<K, V>(pair: (K, V)) -> Result<(), (K, V)> { Result::Err(move pair) }

__g1_hash_map_try_insert_at<K, V>(value: &mut HashMap<K, V>, key: K, item: V, probe: __HashProbe) -> Result<
    (), (K, V)
> {
    handle move probe.found {
        Result::Ok(_) => __g1_hash_map_try_insert_error((move key, move item)),
        Result::Err(_) => {
            let replacement = __g1_hash_map_occupied(move key, move item);
            let previous = replace(
                __g1_vec_index_mut(&mut value.buckets, probe.index),
                move replacement
            );
            handle move previous {
                Result::Err(_) => {
                    (*value).length = __g1_usize_successor(value.length);
                    __g1_hash_map_try_insert_ok()
                },
                Result::Ok(previous_pair) => {
                    let(previous_key, previous_item) = move previous_pair;
                    let displaced = replace(
                        __g1_vec_index_mut(&mut value.buckets, probe.index),
                        __g1_hash_map_occupied(move previous_key, move previous_item)
                    );
                    handle move displaced {
                        Result::Ok(incoming) => __g1_hash_map_try_insert_error(move incoming),
                        Result::Err(_) => __g1_hash_map_try_insert_ok()
                    }
                }
            }
        }
    }
}

__g1_hash_map_try_insert<K, V>(value: &mut HashMap<K, V>, key: K, item: V) -> Result<(), (K, V)> where K: Eq,
K: Hash {
    let should_grow = __g1_hash_map_should_grow(&*value);
    handle move should_grow {
        Result::Ok(_) => __g1_hash_map_try_insert_error((move key, move item)),
        Result::Err(_) => {
            let probe = __g1_hash_map_find(&*value, &key);
            __g1_hash_map_try_insert_at(move value, move key, move item, move probe)
        }
    }
}

// Entry owns the incoming key together with the table's unique loan and the
// one completed probe. No public field can be forged or inspected, so callers
// cannot reuse a stale probe after mutating the map.
struct HashMapEntry<'a, K, V> {
    private value: &'a mut HashMap<K, V>,
    private key: K,
    private probe: __HashProbe
}

__g1_hash_map_entry<'a, K, V>(value: &'a mut HashMap<K, V>, key: K) -> HashMapEntry<'a, K, V> where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    let should_grow = __g1_hash_map_should_grow(&*value);
    let grew = handle move should_grow {
        Result::Ok(_) => {
            __g1_hash_map_grow(&mut *value);
            __g1_bool_from_u32(1)
        },
        Result::Err(_) => __g1_bool_from_u32(0)
    };
    grew;
    let probe = __g1_hash_map_find(&*value, &key);
    HashMapEntry { value: move value, key: move key, probe: move probe }
}

__g1_hash_map_entry_is_occupied<'a, K, V>(value: &HashMapEntry<'a, K, V>) -> Bool {
    value.probe.found
}

__g1_hash_map_entry_insert<'a, K, V>(entry: HashMapEntry<'a, K, V>, item: V) -> Option<V> where K: Use<
    [0, 0]
> {
    let HashMapEntry { value, key, probe } = move entry;
    __g1_hash_map_insert_at(move value, move key, move item, move probe)
}

__g1_hash_map_entry_value_mut<'a, K, V>(value: &'a mut HashMap<K, V>, index: usize) -> &'a mut V {
    let bucket = __g1_vec_index_mut(&mut value.buckets, index);
    if(*bucket is Result::Ok(_)) {
        &mut bucket.0.1
    } else {
        // Entry's private completed probe is either already occupied or was
        // populated immediately before this lookup. Reaching an empty bucket
        // therefore signals a violated standard-library invariant.
        abort()
    }
}

__g1_hash_map_entry_or_insert<'a, K, V>(entry: HashMapEntry<'a, K, V>, item: V) -> &'a mut V where K: Use<
    [0, 0]
>,
V: Use<[0, 0]> {
    let HashMapEntry { value, key, probe } = move entry;
    let index = probe.index;
    handle move probe.found {
        Result::Ok(_) => {
            key;
            item;
            __g1_hash_map_entry_value_mut(move value, move index)
        },
        Result::Err(_) => {
            __g1_hash_map_insert_at(
                &mut *value,
                move key,
                move item,
                __HashProbe { index: index, found: false }
            );
            __g1_hash_map_entry_value_mut(move value, move index)
        }
    }
}

__g1_hash_map_insert_without_growth<K, V>(value: &mut HashMap<K, V>, key: K, item: V) -> Option<V> where K: Eq,
K: Hash,
K: Use<[0, 0]> {
    let probe = __g1_hash_map_find(&*value, &key);
    __g1_hash_map_insert_at(move value, move key, move item, move probe)
}

__g1_hash_map_rehash<K, V>(old: VecIntoIter<Result<(K, V), ()>>, fresh: &mut HashMap<K, V>) where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    handle VecIntoIter::next(move old) {
        Result::Ok(step) => {
            let(bucket, remaining) = move step;
            handle move bucket {
                Result::Ok(pair) => {
                    let(key, item) = move pair;
                    __g1_hash_map_insert_without_growth(&mut *fresh, move key, move item)
                },
                Result::Err(_) => None
            };
            __g1_hash_map_rehash(move remaining, move fresh)
        },
        Result::Err(_) => ()
    }
}

__g1_hash_map_initial_capacity() -> usize { 8 }

__g1_hash_map_double_capacity(value: usize) -> usize { value + value }

__g1_hash_map_next_capacity(old_capacity: usize) -> usize {
    handle old_capacity == 0 {
        Result::Ok(_) => __g1_hash_map_initial_capacity(),
        Result::Err(_) => __g1_hash_map_double_capacity(move old_capacity)
    }
}

__g1_hash_map_grow<K, V>(value: &mut HashMap<K, V>) where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    let old_capacity = Vec::len(&value.buckets);
    let new_capacity = __g1_hash_map_next_capacity(old_capacity);
    let fresh = __g1_hash_map_fresh(&*value);
    __g1_hash_map_fill_empty(&mut fresh, move new_capacity);
    let old = replace(&mut value.buckets, Vec::new());
    (*value).length = 0;
    __g1_hash_map_rehash(Vec::into_iter(move old), &mut fresh);
    (*value).buckets = move fresh.buckets;
    (*value).length = fresh.length;
    ()
}

__g1_hash_map_quarter(value: usize) -> usize { move value / 4 }

__g1_hash_map_sub(left: usize, right: usize) -> usize { move left - move right }

__g1_hash_map_should_grow<K, V>(value: &HashMap<K, V>) -> Bool {
    let capacity = Vec::len(&value.buckets);
    handle capacity == 0 {
        Result::Ok(_) => true,
        Result::Err(_) => {
            let quarter = __g1_hash_map_quarter(capacity);
            let threshold = __g1_hash_map_sub(capacity, quarter);
            value.length >= move threshold
        }
    }
}

__g1_hash_map_insert<K, V>(value: &mut HashMap<K, V>, key: K, item: V) -> Option<V> where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    let should_grow = __g1_hash_map_should_grow(&*value);
    let grew = handle move should_grow {
        Result::Ok(_) => {
            __g1_hash_map_grow(&mut *value);
            __g1_bool_from_u32(1)
        },
        Result::Err(_) => __g1_bool_from_u32(0)
    };
    grew;
    __g1_hash_map_insert_without_growth(move value, move key, move item)
}

// Removing an occupied bucket creates a hole in the linear-probe chain.  Move
// every following occupied bucket back through ordinary insertion until the
// first genuinely empty bucket; otherwise a lookup could stop at the new hole
// before reaching a colliding key.  `remaining` makes corrupted/full-table
// behavior bounded even though healthy tables always retain an empty bucket.
__g1_hash_map_repair_after_remove<K, V>(value: &mut HashMap<K, V>, index: usize, remaining: usize) where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            let empty = __g1_hash_map_empty(&*value);
            let bucket = replace(__g1_vec_index_mut(&mut value.buckets, index), move empty);
            handle move bucket {
                Result::Err(_) => (),
                Result::Ok(pair) => {
                    (*value).length = __g1_parse_usize_predecessor(value.length);
                    let(key, item) = move pair;
                    // The bucket was just removed from this table, so this
                    // insertion cannot replace a logically equal resident.
                    __g1_hash_map_insert_without_growth(&mut *value, move key, move item);
                    let capacity = Vec::len(&value.buckets);
                    __g1_hash_map_repair_after_remove(
                        move value,
                        __g1_hash_map_next(move index, move capacity),
                        __g1_parse_usize_predecessor(move remaining)
                    )
                }
            }
        }
    }
}

__g1_hash_map_remove_entry<K, V>(value: &mut HashMap<K, V>, key: &K) -> Option<(K, V)> where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    let capacity = Vec::len(&value.buckets);
    handle capacity == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => {
            let probe = __g1_hash_map_find(&*value, key);
            handle move probe.found {
                Result::Err(_) => None,
                Result::Ok(_) => {
                    let empty = __g1_hash_map_empty(&*value);
                    let removed = replace(
                        __g1_vec_index_mut(&mut value.buckets, probe.index),
                        move empty
                    );
                    (*value).length = __g1_parse_usize_predecessor(value.length);
                    __g1_hash_map_repair_after_remove(
                        move value,
                        __g1_hash_map_next(move probe.index, capacity),
                        __g1_parse_usize_predecessor(move capacity)
                    );
                    handle move removed {
                        Result::Ok(pair) => Option::Some(move pair),
                        Result::Err(_) => None
                    }
                }
            }
        }
    }
}

__g1_hash_map_remove<K, V>(value: &mut HashMap<K, V>, key: &K) -> Option<V> where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    handle __g1_hash_map_remove_entry(move value, key) {
        Result::Ok(pair) => {
            let(removed_key, removed_value) = move pair;
            removed_key;
            Option::Some(move removed_value)
        },
        Result::Err(_) => None
    }
}

__g1_hash_map_clear<K, V>(value: &mut HashMap<K, V>) where K: Use<[0, 0]>,
V: Use<[0, 0]> {
    let old = replace(move value, HashMap::new());
    let HashMap { buckets, length } = move old;
    buckets;
    length;
    ()
}

// A checked raw lookup accepts a caller-cached hash only when it matches the
// canonical Hash stream for the borrowed key. A stale or forged hash returns
// None without probing an unrelated cluster.
__g1_hash_map_raw_get<'a, K, V>(value: &'a HashMap<K, V>, key: &K, hash: u64) -> Option<& 'a V> where K: Eq,
K: Hash {
    let capacity = Vec::len(&value.buckets);
    handle capacity == 0 {
        Result::Ok(_) => None,
        Result::Err(_) => handle move hash == __g1_hash_map_hash(key) {
            Result::Err(_) => None,
            Result::Ok(_) => __g1_hash_map_get(value, key)
        }
    }
}

__g1_hash_map_reserve_additional_to<K, V>(value: &mut HashMap<K, V>, required: usize) -> Bool where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    let capacity = Vec::len(&value.buckets);
    let threshold = capacity - capacity / 4;
    handle required <= threshold {
        Result::Ok(_) => true,
        Result::Err(_) => {
            __g1_hash_map_grow(&mut *value);
            __g1_hash_map_reserve_additional_to(move value, move required)
        }
    }
}

__g1_hash_map_reserve_additional<K, V>(value: &mut HashMap<K, V>, additional: usize) -> Bool where K: Eq,
K: Hash,
K: Use<[0, 0]>,
V: Use<[0, 0]> {
    let length = value.length;
    let checked = checked_usize_add(move length, move additional);
    handle move checked {
        Result::Ok(required) => __g1_hash_map_reserve_additional_to(move value, move required),
        Result::Err(_) => false
    }
}

// Borrowed iteration walks physical buckets from low to high.  Hashing and
// growth are deterministic, so a fixed table state has a fixed iteration
// order; externally visible compiler output must still sort explicitly.
struct HashMapIter<'a, K, V> { private value: &'a HashMap<K, V>, private index: usize }

struct HashMapKeys<'a, K, V> { private value: &'a HashMap<K, V>, private index: usize }

struct HashMapValues<'a, K, V> { private value: &'a HashMap<K, V>, private index: usize }

struct HashMapIntoIter<K, V> { private buckets: VecIntoIter<Result<(K, V), ()>> }

impl < K,
V > Use<[0, 1]> for HashMapIntoIter<K, V> where VecIntoIter<Result<(K, V), ()>>: Use<[0, 1]>,
K: Use<[0, 0]>,
V: Use<[0, 0]> {}

__g1_hash_iter_selected(index: usize) -> Option<usize> { Option::Some(move index) }

__g1_hash_iter_exhausted() -> Option<usize> { None }

__g1_hash_map_next_occupied<K, V>(value: &HashMap<K, V>, index: usize, capacity: usize) -> usize {
    handle index < capacity {
        Result::Err(_) => move capacity,
        Result::Ok(_) => {
            let bucket = __g1_vec_index(&value.buckets, index);
            handle *bucket is Result::Ok(_) {
                Result::Ok(_) => move index,
                Result::Err(_) => __g1_hash_map_next_occupied(value, index + 1, move capacity)
            }
        }
    }
}

__g1_hash_map_iter_bucket<'a, K, V>(value: &'a HashMap<K, V>, index: usize) -> Option<
    (&'a K, &'a V)
> {
    let bucket = __g1_vec_index(&value.buckets, index);
    if(*bucket is Result::Ok(_)) {
        Option::Some(((&bucket.0.0), (&bucket.0.1)))
    } else { None }
}

__g1_hash_map_keys_bucket<'a, K, V>(value: &'a HashMap<K, V>, index: usize) -> Option<& 'a K> {
    let bucket = __g1_vec_index(&value.buckets, index);
    if(*bucket is Result::Ok(_)) {
        Option::Some(&bucket.0.0)
    } else { None }
}

__g1_hash_map_values_bucket<'a, K, V>(value: &'a HashMap<K, V>, index: usize) -> Option<& 'a V> {
    let bucket = __g1_vec_index(&value.buckets, index);
    if(*bucket is Result::Ok(_)) {
        Option::Some(&bucket.0.1)
    } else { None }
}

__g1_hash_map_iter_none<'a, K, V>(value: &'a HashMap<K, V>) -> Option<(&'a K, &'a V)> {
    value;
    None
}

__g1_hash_map_keys_none<'a, K, V>(value: &'a HashMap<K, V>) -> Option<& 'a K> {
    value;
    None
}

__g1_hash_map_values_none<'a, K, V>(value: &'a HashMap<K, V>) -> Option<& 'a V> {
    value;
    None
}

__g1_hash_map_iter<'a, K, V>(value: &'a HashMap<K, V>) -> HashMapIter<'a, K, V> {
    HashMapIter { value: move value, index: 0 }
}

__g1_hash_map_keys<'a, K, V>(value: &'a HashMap<K, V>) -> HashMapKeys<'a, K, V> {
    HashMapKeys { value: move value, index: 0 }
}

__g1_hash_map_values<'a, K, V>(value: &'a HashMap<K, V>) -> HashMapValues<'a, K, V> {
    HashMapValues { value: move value, index: 0 }
}

__g1_hash_map_iter_next<'a, K, V>(iterator: &mut HashMapIter<'a, K, V>) -> Option<(&'a K, &'a V)> {
    let value = iterator.value;
    let index = iterator.index;
    let capacity = Vec::len(&value.buckets);
    let occupied = __g1_hash_map_next_occupied(value, index, capacity);
    let selected = handle __g1_integer_less(occupied, capacity) {
        Result::Ok(_) => __g1_hash_iter_selected(move occupied),
        Result::Err(_) => __g1_hash_iter_exhausted()
    };
    if(selected is Result::Ok(selected_index)) {
        (*iterator).index = __g1_integer_add(selected_index, 1);
        __g1_hash_map_iter_bucket(move value, move selected_index)
    } else { __g1_hash_map_iter_none(move value) }
}

__g1_hash_map_keys_next<'a, K, V>(iterator: &mut HashMapKeys<'a, K, V>) -> Option<& 'a K> {
    let value = iterator.value;
    let index = iterator.index;
    let capacity = Vec::len(&value.buckets);
    let occupied = __g1_hash_map_next_occupied(value, index, capacity);
    let selected = handle __g1_integer_less(occupied, capacity) {
        Result::Ok(_) => __g1_hash_iter_selected(move occupied),
        Result::Err(_) => __g1_hash_iter_exhausted()
    };
    if(selected is Result::Ok(selected_index)) {
        (*iterator).index = __g1_integer_add(selected_index, 1);
        __g1_hash_map_keys_bucket(move value, move selected_index)
    } else { __g1_hash_map_keys_none(move value) }
}

__g1_hash_map_values_next<'a, K, V>(iterator: &mut HashMapValues<'a, K, V>) -> Option<& 'a V> {
    let value = iterator.value;
    let index = iterator.index;
    let capacity = Vec::len(&value.buckets);
    let occupied = __g1_hash_map_next_occupied(value, index, capacity);
    let selected = handle __g1_integer_less(occupied, capacity) {
        Result::Ok(_) => __g1_hash_iter_selected(move occupied),
        Result::Err(_) => __g1_hash_iter_exhausted()
    };
    if(selected is Result::Ok(selected_index)) {
        (*iterator).index = __g1_integer_add(selected_index, 1);
        __g1_hash_map_values_bucket(move value, move selected_index)
    } else { __g1_hash_map_values_none(move value) }
}

__g1_hash_map_into_iter<K, V>(value: HashMap<K, V>) -> HashMapIntoIter<K, V> {
    let HashMap { buckets, length } = move value;
    length;
    HashMapIntoIter { buckets: Vec::into_iter(move buckets) }
}

__g1_hash_map_into_iter_next<K, V>(iterator: HashMapIntoIter<K, V>) -> Option<
    ((K, V), HashMapIntoIter<K, V>)
> {
    let HashMapIntoIter { buckets } = move iterator;
    handle VecIntoIter::next(move buckets) {
        Result::Err(_) => None,
        Result::Ok(step) => {
            let(bucket, remaining) = move step;
            handle move bucket {
                Result::Ok(pair) => Option::Some(
                    (move pair, HashMapIntoIter { buckets: move remaining })
                ),
                Result::Err(_) => __g1_hash_map_into_iter_next(
                    HashMapIntoIter { buckets: move remaining }
                )
            }
        }
    }
}

struct HashSet<K> { private values: HashMap<K, ()> }

struct HashSetIter<'a, K> { private value: &'a HashSet<K>, private index: usize }

struct HashSetIntoIter<K> { private entries: HashMapIntoIter<K, ()> }

impl < K > Use<[0, 1]> for HashSetIntoIter<K> where HashMapIntoIter<K, ()>: Use<[0, 1]>,
K: Use<[0, 0]> {}

__g1_hash_set_iter_bucket<'a, K>(value: &'a HashSet<K>, index: usize) -> Option<& 'a K> {
    let bucket = __g1_vec_index(&value.values.buckets, index);
    if(*bucket is Result::Ok(_)) {
        Option::Some(&bucket.0.0)
    } else { None }
}

__g1_hash_set_iter_none<'a, K>(value: &'a HashSet<K>) -> Option<& 'a K> {
    value;
    None
}

__g1_hash_set_new<K>() -> HashSet<K> { HashSet { values: HashMap::new() } }

__g1_hash_set_len<K>(value: &HashSet<K>) -> usize { HashMap::len(&value.values) }

__g1_hash_set_capacity<K>(value: &HashSet<K>) -> usize { HashMap::capacity(&value.values) }

__g1_hash_set_is_empty<K>(value: &HashSet<K>) -> Bool { HashMap::is_empty(&value.values) }

__g1_hash_set_contains<K>(value: &HashSet<K>, key: &K) -> Bool where K: Eq,
K: Hash { HashMap::contains_key(&value.values, key) }

__g1_hash_set_insert<K>(value: &mut HashSet<K>, key: K) -> Bool where K: Eq,
K: Hash,
K: Use<[0, 0]> {
    handle HashMap::insert(&mut value.values, move key, ()) {
        Result::Ok(_) => false,
        Result::Err(_) => true
    }
}

__g1_hash_set_remove<K>(value: &mut HashSet<K>, key: &K) -> Bool where K: Eq,
K: Hash,
K: Use<[0, 0]> {
    handle HashMap::remove(&mut value.values, key) {
        Result::Ok(_) => true,
        Result::Err(_) => false
    }
}

__g1_hash_set_union_step<K>(
    value: &mut HashSet<K>,
    other: &HashSet<K>,
    index: usize,
    capacity: usize
) where K: Eq,
K: Hash,
K: Use<[0, *]> {
    handle index < capacity {
        Result::Err(_) => (),
        Result::Ok(_) => {
            // The loop guard proves `index < capacity`, and `capacity` is the
            // exact backing length captured by union_with before recursion.
            let bucket = __g1_array_get_borrow_shared(&other.values.buckets.storage, index);
            __g1_hash_set_union_bucket(&mut *value, bucket);
            __g1_hash_set_union_step(move value, other, index + 1, move capacity)
        }
    }
}

__g1_hash_set_union_bucket<K>(value: &mut HashSet<K>, bucket: &Result<(K, ()), ()>) where K: Eq,
K: Hash,
K: Use<[0, *]> {
    if(*bucket is Result::Ok(_)) {
        let key = *(&bucket.0.0);
        HashSet::insert(&mut *value, move key);
        ()
    } else { () }
}

__g1_hash_set_union_with<K>(value: &mut HashSet<K>, other: &HashSet<K>) where K: Eq,
K: Hash,
K: Use<[0, *]> { __g1_hash_set_union_step(move value, other, 0, Vec::len(&other.values.buckets)) }

__g1_hash_set_intersection_insert<K>(fresh: &mut HashSet<K>, right: &HashSet<K>, key: &K) where K: Eq,
K: Hash,
K: Use<[0, *]> {
    let owned = *key;
    handle HashSet::contains(right, &owned) {
        Result::Ok(_) => {
            HashSet::insert(&mut *fresh, move owned);
            ()
        },
        Result::Err(_) => ()
    }
}

__g1_hash_set_intersection_step<K>(
    fresh: &mut HashSet<K>,
    left: &HashSet<K>,
    right: &HashSet<K>,
    index: usize,
    capacity: usize
) where K: Eq,
K: Hash,
K: Use<[0, *]> {
    handle index < capacity {
        Result::Err(_) => (),
        Result::Ok(_) => {
            // As above, the loop guard and exact backing length prove this
            // trusted read in bounds. The copied key ends the bucket loan
            // before the distinct result set is mutated.
            let bucket = __g1_array_get_borrow_shared(&left.values.buckets.storage, index);
            if(*bucket is Result::Ok(_)) {
                __g1_hash_set_intersection_insert(&mut *fresh, right, &bucket.0.0)
            } else { () };
            __g1_hash_set_intersection_step(move fresh, left, right, index + 1, move capacity)
        }
    }
}

__g1_hash_set_intersection<K>(left: &HashSet<K>, right: &HashSet<K>) -> HashSet<K> where K: Eq,
K: Hash,
K: Use<[0, *]> {
    let result = HashSet::new();
    __g1_hash_set_intersection_step(&mut result, left, right, 0, Vec::len(&left.values.buckets));
    move result
}

__g1_hash_set_iter<'a, K>(value: &'a HashSet<K>) -> HashSetIter<'a, K> {
    HashSetIter { value: move value, index: 0 }
}

__g1_hash_set_iter_next<'a, K>(iterator: &mut HashSetIter<'a, K>) -> Option<& 'a K> {
    let value = iterator.value;
    let index = iterator.index;
    let capacity = Vec::len(&value.values.buckets);
    let occupied = __g1_hash_map_next_occupied(&value.values, index, capacity);
    let selected = handle __g1_integer_less(occupied, capacity) {
        Result::Ok(_) => __g1_hash_iter_selected(move occupied),
        Result::Err(_) => __g1_hash_iter_exhausted()
    };
    if(selected is Result::Ok(selected_index)) {
        (*iterator).index = __g1_integer_add(selected_index, 1);
        __g1_hash_set_iter_bucket(move value, move selected_index)
    } else { __g1_hash_set_iter_none(move value) }
}

__g1_hash_set_into_iter<K>(value: HashSet<K>) -> HashSetIntoIter<K> {
    let HashSet { values } = move value;
    HashSetIntoIter { entries: HashMap::into_iter(move values) }
}

__g1_hash_set_into_iter_next<K>(iterator: HashSetIntoIter<K>) -> Option<(K, HashSetIntoIter<K>)> {
    let HashSetIntoIter { entries } = move iterator;
    handle HashMapIntoIter::next(move entries) {
        Result::Err(_) => None,
        Result::Ok(step) => {
            let(pair, remaining) = move step;
            let(key, unit) = move pair;
            unit;
            Option::Some((move key, HashSetIntoIter { entries: move remaining }))
        }
    }
}

