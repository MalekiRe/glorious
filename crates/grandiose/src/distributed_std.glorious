struct Arena<I, T> { private values: IndexVec<I, T>, private length: usize }

__g1_arena_new<I, T>() -> Arena<I, T> { Arena { values: IndexVec::new(), length: 0 } }

__g1_arena_len<I, T>(value: &Arena<I, T>) -> usize { value.length }

__g1_arena_mark<I, T>(value: &Arena<I, T>) -> usize { Arena::len(value) }

__g1_arena_alloc<I, T>(value: &mut Arena<I, T>, item: T) -> Result<Id<I>, T> {
    let length = value.length;
    let converted = checked_usize_to_u32(length);
    handle move converted {
        Result::Ok(raw) => {
            Vec::push(&mut value.values.values, move item);
            (*value).length = length + 1;
            (*value).values.length = length + 1;
            Result::Ok(Id { raw: move raw })
        },
        Result::Err(_) => Result::Err(move item)
    }
}

__g1_arena_get<'a, I, T>(value: &'a Arena<I, T>, id: Id<I>) -> Option<& 'a T> {
    IndexVec::get(&value.values, move id)
}

__g1_arena_get_mut<'a, I, T>(value: &'a mut Arena<I, T>, id: Id<I>) -> Option<& 'a mut T> {
    IndexVec::get_mut(&mut value.values, move id)
}

__g1_arena_index<'a, I, T>(value: &'a Arena<I, T>, id: Id<I>) -> &'a T {
    IndexVec::index(&value.values, move id)
}

__g1_arena_index_mut<'a, I, T>(value: &'a mut Arena<I, T>, id: Id<I>) -> &'a mut T {
    IndexVec::index_mut(&mut value.values, move id)
}

__g1_arena_get_copy<I, T>(value: &Arena<I, T>, id: Id<I>) -> Option<T> where T: Use<[0, *]> {
    IndexVec::get_copy(&value.values, move id)
}

__g1_arena_truncate<I, T>(value: &mut Arena<I, T>, mark: usize) where T: Use<[0, 0]> {
    let length = Arena::len(&*value);
    handle mark < length {
        Result::Ok(_) => {
            let removed = __g1_array_pop_move(&mut value.values.values.storage);
            (*value).length = length - 1;
            (*value).values.length = length - 1;
            removed;
            __g1_arena_truncate(move value, mark)
        },
        Result::Err(_) => ()
    }
}

struct ArenaCheckpoint<'a, I, T> {
    private value: &'a mut Arena<I, T>,
    private mark: usize,
    private armed: Bool
}

impl<'a, I, T> Drop for ArenaCheckpoint<'a, I, T> where T: Use<[0, 0]> {
    drop(&mut self) -> {
        if(self.armed) {
            __g1_arena_truncate(&mut *self.value, self.mark)
        } else {
            ()
        }
    }
}

__g1_arena_checkpoint<'a, I, T>(value: &'a mut Arena<I, T>) -> ArenaCheckpoint<'a, I, T>
where T: Use<[0, 0]> {
    let mark = __g1_arena_mark(&*value);
    ArenaCheckpoint { value: move value, mark: move mark, armed: true }
}

__g1_arena_checkpoint_commit<'a, I, T>(checkpoint: &mut ArenaCheckpoint<'a, I, T>) {
    (*checkpoint).armed = false;
    ()
}

__g1_arena_with_range<I, T, F, e: EffectRow>(
    value: &mut Arena<I, T>,
    body: F
) -> Range<usize>
where T: Use<[0, 0]>,
F: Fn<(&mut Arena<I, T>,), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    let checkpoint = __g1_arena_checkpoint(move value);
    let start = checkpoint.mark;
    body(&mut *checkpoint.value);
    let end = __g1_arena_len(&*checkpoint.value);
    __g1_arena_checkpoint_commit(&mut checkpoint);
    Range { start: move start, end: move end }
}

__g1_arena_try_with_range<I, T, E, F, e: EffectRow>(
    value: &mut Arena<I, T>,
    body: F
) -> Result<Range<usize>, E>
where T: Use<[0, 0]>,
F: Fn<(&mut Arena<I, T>,), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    @failed: Result<Range<usize>, E> {
        let checkpoint = __g1_arena_checkpoint(move value);
        let start = checkpoint.mark;
        try(body(&mut *checkpoint.value), @failed);
        let end = __g1_arena_len(&*checkpoint.value);
        __g1_arena_checkpoint_commit(&mut checkpoint);
        Result::Ok(Range { start: move start, end: move end })
    }
}

__g1_arena_drain_rollback<I, T>(value: &mut Arena<I, T>, mark: usize) -> Vec<T> {
    let removed = __g1_arena_empty_rollback(&*value);
    __g1_arena_drain_rollback_step(move value, mark, move removed)
}

__g1_arena_empty_rollback<I, T>(value: &Arena<I, T>) -> Vec<T> {
    value;
    Vec::new()
}

__g1_arena_drain_rollback_step<I, T>(value: &mut Arena<I, T>, mark: usize, removed: Vec<T>) -> Vec<
    T
> {
    let length = Arena::len(&*value);
    handle mark < length {
        Result::Ok(_) => {
            let item = __g1_array_pop_move(&mut value.values.values.storage);
            (*value).length = length - 1;
            (*value).values.length = length - 1;
            Vec::push(&mut removed, move item);
            __g1_arena_drain_rollback_step(move value, mark, move removed)
        },
        Result::Err(_) => {
            Vec::reverse(&mut removed);
            move removed
        }
    }
}

