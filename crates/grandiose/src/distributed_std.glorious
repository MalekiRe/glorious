__g1_byte_buf_resize_shrink(value: &mut ByteBuf, length: usize, current: usize) {
    handle length < current {
        Result::Ok(_) => {
            let removed = __g1_byte_buf_pop_byte(&mut value.bytes);
            removed;
            __g1_byte_buf_resize_zeroed(move value, move length)
        },
        Result::Err(_) => ()
    }
}

__g1_byte_buf_resize_zeroed(value: &mut ByteBuf, length: usize) {
    let current = __g1_byte_buf_len(&*value);
    handle current < length {
        Result::Ok(_) => {
            __g1_byte_buf_push(&mut *value, 0);
            __g1_byte_buf_resize_zeroed(move value, move length)
        },
        Result::Err(_) => __g1_byte_buf_resize_shrink(move value, move length, move current)
    }
}

struct ByteBufCheckpoint<'a> {
    private value: &'a mut ByteBuf,
    private length: usize,
    private armed: Bool
}

impl<'a> Drop for ByteBufCheckpoint<'a> {
    drop(&mut self) -> {
        if(self.armed) {
            __g1_byte_buf_resize_zeroed(&mut *self.value, self.length)
        } else {
            ()
        }
    }
}

__g1_byte_buf_checkpoint<'a>(value: &'a mut ByteBuf) -> ByteBufCheckpoint<'a> {
    let length = __g1_byte_buf_len(&*value);
    ByteBufCheckpoint { value: move value, length: move length, armed: true }
}

__g1_byte_buf_checkpoint_commit<'a>(checkpoint: &mut ByteBufCheckpoint<'a>) {
    (*checkpoint).armed = false;
    ()
}

__g1_byte_buf_with_record<F, e: EffectRow>(value: &mut ByteBuf, body: F) -> Range<usize>
where F: Fn<(&mut ByteBuf,), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    let checkpoint = __g1_byte_buf_checkpoint(move value);
    let start = checkpoint.length;
    body(&mut *checkpoint.value);
    let end = __g1_byte_buf_len(&*checkpoint.value);
    __g1_byte_buf_checkpoint_commit(&mut checkpoint);
    Range { start: move start, end: move end }
}

__g1_byte_buf_try_with_record<E, F, e: EffectRow>(
    value: &mut ByteBuf,
    body: F
) -> Result<Range<usize>, E>
where F: Fn<(&mut ByteBuf,), Output=Result<(), E>, Effects={| e}>,
F: Use<[0, 0]> {
    @failed: Result<Range<usize>, E> {
        let checkpoint = __g1_byte_buf_checkpoint(move value);
        let start = checkpoint.length;
        try(body(&mut *checkpoint.value), @failed);
        let end = __g1_byte_buf_len(&*checkpoint.value);
        __g1_byte_buf_checkpoint_commit(&mut checkpoint);
        Result::Ok(Range { start: move start, end: move end })
    }
}

__g1_byte_buf_write_word_le(value: &mut ByteBuf, word: u128, remaining: usize) {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            __g1_byte_buf_push(&mut *value, wrapping_convert_to_u8(word));
            __g1_byte_buf_write_word_le(
                move value,
                shift_right(word, 8),
                __g1_vec_deque_usize_sub(remaining, 1)
            )
        }
    }
}

__g1_byte_buf_write_u16_le(value: &mut ByteBuf, word: u16) {
    __g1_byte_buf_write_word_le(move value, wrapping_convert_to_u128(move word), 2)
}

__g1_byte_buf_write_u32_le(value: &mut ByteBuf, word: u32) {
    __g1_byte_buf_write_word_le(move value, wrapping_convert_to_u128(move word), 4)
}

__g1_byte_buf_write_u64_le(value: &mut ByteBuf, word: u64) {
    __g1_byte_buf_write_word_le(move value, wrapping_convert_to_u128(move word), 8)
}

__g1_byte_buf_write_u128_le(value: &mut ByteBuf, word: u128) {
    __g1_byte_buf_write_word_le(move value, move word, 16)
}

__g1_byte_buf_replace_byte(bytes: &mut Vec<u8>, offset: usize, incoming: u8) {
    let previous = replace(__g1_array_get_borrow_unique(&mut bytes.storage, offset), move incoming);
    previous;
    ()
}

__g1_byte_buf_patch_word_le(value: &mut ByteBuf, offset: usize, word: u128, remaining: usize) {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            __g1_byte_buf_replace_byte(&mut value.bytes, offset, wrapping_convert_to_u8(word));
            __g1_byte_buf_patch_word_le(move value, offset + 1, shift_right(word, 8), remaining - 1)
        }
    }
}

__g1_byte_buf_patch_valid(value: &mut ByteBuf, offset: usize, word: u128, width: usize) -> Bool {
    __g1_byte_buf_patch_word_le(move value, move offset, move word, move width);
    true
}

__g1_byte_buf_patch_after_offset(
    value: &mut ByteBuf,
    offset: usize,
    word: u128,
    width: usize,
    length: usize
) -> Bool {
    handle width <= length - offset {
        Result::Ok(_) => __g1_byte_buf_patch_valid(move value, move offset, move word, move width),
        Result::Err(_) => false
    }
}

__g1_byte_buf_patch(value: &mut ByteBuf, offset: usize, word: u128, width: usize) -> Bool {
    let length = __g1_byte_buf_len(&*value);
    handle offset <= length {
        Result::Ok(_) => __g1_byte_buf_patch_after_offset(
            move value,
            move offset,
            move word,
            move width,
            move length
        ),
        Result::Err(_) => false
    }
}

__g1_byte_buf_patch_u16_le(value: &mut ByteBuf, offset: usize, word: u16) -> Bool {
    __g1_byte_buf_patch(move value, move offset, wrapping_convert_to_u128(move word), 2)
}

__g1_byte_buf_patch_u32_le(value: &mut ByteBuf, offset: usize, word: u32) -> Bool {
    __g1_byte_buf_patch(move value, move offset, wrapping_convert_to_u128(move word), 4)
}

__g1_byte_buf_patch_u64_le(value: &mut ByteBuf, offset: usize, word: u64) -> Bool {
    __g1_byte_buf_patch(move value, move offset, wrapping_convert_to_u128(move word), 8)
}

__g1_byte_buf_align_padding(value: &mut ByteBuf, alignment: usize, remainder: usize, length: usize) -> Bool {
    let padding = __g1_vec_deque_usize_sub(alignment, remainder);
    handle checked_usize_add(length, padding) {
        Result::Ok(aligned) => {
            __g1_byte_buf_resize_zeroed(move value, move aligned);
            true
        },
        Result::Err(_) => false
    }
}

__g1_byte_buf_usize_remainder(left: usize, right: usize) -> usize { move left % move right }

__g1_byte_buf_align_power_of_two(value: &mut ByteBuf, alignment: usize) -> Bool {
    let length = __g1_byte_buf_len(&*value);
    let remainder = __g1_byte_buf_usize_remainder(length, alignment);
    handle remainder == 0 {
        Result::Ok(_) => true,
        Result::Err(_) => __g1_byte_buf_align_padding(
            move value,
            move alignment,
            move remainder,
            move length
        )
    }
}

__g1_byte_buf_power_of_two_next(candidate: usize, current: usize) -> Bool {
    handle checked_usize_add(current, current) {
        Result::Ok(next) => __g1_byte_buf_is_power_of_two(move candidate, move next),
        Result::Err(_) => false
    }
}

__g1_byte_buf_power_of_two_greater(candidate: usize, current: usize) -> Bool {
    handle current < candidate {
        Result::Ok(_) => __g1_byte_buf_power_of_two_next(move candidate, move current),
        Result::Err(_) => false
    }
}

__g1_byte_buf_is_power_of_two(candidate: usize, current: usize) -> Bool {
    handle current == candidate {
        Result::Ok(_) => true,
        Result::Err(_) => __g1_byte_buf_power_of_two_greater(move candidate, move current)
    }
}

__g1_byte_buf_align_nonzero(value: &mut ByteBuf, alignment: usize) -> Bool {
    handle __g1_byte_buf_is_power_of_two(alignment, 1) {
        Result::Ok(_) => __g1_byte_buf_align_power_of_two(move value, move alignment),
        Result::Err(_) => false
    }
}

__g1_byte_buf_align_zeroed(value: &mut ByteBuf, alignment: usize) -> Bool {
    handle alignment == 0 {
        Result::Ok(_) => false,
        Result::Err(_) => __g1_byte_buf_align_nonzero(move value, move alignment)
    }
}

__g1_byte_buf_with_alignment(value: &mut ByteBuf, alignment: usize) -> Option<Range<usize>> {
    let start = __g1_byte_buf_len(&*value);
    if(__g1_byte_buf_align_zeroed(&mut *value, move alignment)) {
        Option::Some(Range { start: move start, end: __g1_byte_buf_len(&*value) })
    } else {
        None
    }
}

__g1_byte_buf_with_length_prefix<F, e: EffectRow>(
    value: &mut ByteBuf,
    body: F
) -> Result<Range<usize>, ToolkitCapacityError>
where F: Fn<(&mut ByteBuf,), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    @failed: Result<Range<usize>, ToolkitCapacityError> {
        let checkpoint = __g1_byte_buf_checkpoint(move value);
        let prefix = checkpoint.length;
        __g1_byte_buf_write_u32_le(&mut *checkpoint.value, 0);
        let start = __g1_byte_buf_len(&*checkpoint.value);
        body(&mut *checkpoint.value);
        let end = __g1_byte_buf_len(&*checkpoint.value);
        handle checked_usize_to_u32(end - start) {
            Result::Ok(length) => {
                __g1_byte_buf_patch_u32_le(&mut *checkpoint.value, move prefix, move length);
                __g1_byte_buf_checkpoint_commit(&mut checkpoint);
                Result::Ok(Range { start: move start, end: move end })
            },
            Result::Err(_) => @failed(Result::Err(ToolkitCapacityError::CounterOverflow))
        }
    }
}

__g1_byte_buf_offset_records<F, e: EffectRow>(
    value: &mut ByteBuf,
    table: usize,
    payload: usize,
    index: usize,
    count: usize,
    body: F
) -> Result<(), ToolkitCapacityError>
where F: Fn<(&mut ByteBuf, usize), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    if(index < count) {
        handle checked_usize_to_u32(ByteBuf::len(&*value) - payload) {
            Result::Err(_) => Result::Err(ToolkitCapacityError::CounterOverflow),
            Result::Ok(offset) => {
                ByteBuf::patch_u32_le(&mut *value, table + index * 4, offset);
                body(&mut *value, index);
                __g1_byte_buf_offset_records(
                    move value,
                    table,
                    payload,
                    index + 1,
                    count,
                    body
                )
            }
        }
    } else { Result::Ok(()) }
}

// Reserve a dense u32 offset table, then emit each record in order. Offsets are
// relative to the returned payload range. The checkpoint makes both capacity
// failure and any labeled callback exit transactional.
__g1_byte_buf_with_offset_table<F, e: EffectRow>(
    value: &mut ByteBuf,
    count: usize,
    body: F
) -> Result<Range<usize>, ToolkitCapacityError>
where F: Fn<(&mut ByteBuf, usize), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    @failed: Result<Range<usize>, ToolkitCapacityError> {
        let checkpoint = __g1_byte_buf_checkpoint(move value);
        let table = checkpoint.length;
        let table_bytes = handle checked_usize_mul(count, 4) {
            Result::Err(_) => @failed(Result::Err(
                ToolkitCapacityError::CounterOverflow
            )),
            Result::Ok(found) => found
        };
        let payload = handle checked_usize_add(table, table_bytes) {
            Result::Err(_) => @failed(Result::Err(
                ToolkitCapacityError::CounterOverflow
            )),
            Result::Ok(found) => found
        };
        __g1_byte_buf_resize_zeroed(&mut *checkpoint.value, payload);
        handle __g1_byte_buf_offset_records(
            &mut *checkpoint.value,
            table,
            payload,
            0,
            count,
            body
        ) {
            Result::Err(error) => @failed(Result::Err(error)),
            Result::Ok(_) => ()
        };
        let end = __g1_byte_buf_len(&*checkpoint.value);
        __g1_byte_buf_checkpoint_commit(&mut checkpoint);
        Result::Ok(Range { start: move payload, end: move end })
    }
}

__g1_byte_buf_append_bytes(value: &mut ByteBuf, bytes: &Bytes) {
    __g1_vec_append_bytes(&mut value.bytes, *bytes)
}

__g1_byte_buf_append_view(value: &mut ByteBuf, view: &ByteView) {
    __g1_vec_append_bytes(&mut value.bytes, __g1_byte_view_to_bytes(view))
}

__g1_byte_buf_finish(value: ByteBuf) -> Bytes {
    let ByteBuf { bytes } = move value;
    __g1_bytes_from_vec(move bytes)
}

let StringBuilder::new = __g1_string_builder_new;
let StringBuilder::with_capacity = __g1_string_builder_with_capacity;
let StringBuilder::len = __g1_string_builder_len;
let StringBuilder::is_empty = __g1_string_builder_is_empty;
let StringBuilder::reserve = __g1_string_builder_reserve;
let StringBuilder::push_byte = __g1_string_builder_push_byte;
let StringBuilder::append_bytes = __g1_string_builder_append_bytes;
let StringBuilder::append_string = __g1_string_builder_append_string;
let StringBuilder::append_view = __g1_string_builder_append_view;
let StringBuilder::append_char = __g1_string_builder_append_char;
let StringBuilder::append_u64 = __g1_string_builder_append_u64;
let StringBuilder::append_i64 = __g1_string_builder_append_i64;
let StringBuilder::append_u128 = __g1_string_builder_append_u128;
let StringBuilder::append_i128 = __g1_string_builder_append_i128;
let StringBuilder::append_hex_u64 = __g1_string_builder_append_hex_u64;
let StringBuilder::append_hex_u128 = __g1_string_builder_append_hex_u128;
let StringBuilder::finish = __g1_string_builder_finish;
let Formatter::new = __g1_formatter_new;
let Formatter::literal = __g1_formatter_literal;
let Formatter::append_u64 = __g1_formatter_append_u64;
let Formatter::append_i64 = __g1_formatter_append_i64;
let Formatter::append_u128 = __g1_formatter_append_u128;
let Formatter::append_i128 = __g1_formatter_append_i128;
let Formatter::append_hex_u64 = __g1_formatter_append_hex_u64;
let Formatter::append_hex_u128 = __g1_formatter_append_hex_u128;
let Formatter::append_char = __g1_formatter_append_char;
let Formatter::newline = __g1_formatter_newline;
let Formatter::indent = __g1_formatter_indent;
let Formatter::dedent = __g1_formatter_dedent;
let Formatter::finish = __g1_formatter_finish;
// Exact deterministic decimal rendering for IEEE values.  A finite binary
// value is an integer times a power of two.  For negative powers we multiply
// the significand by the matching power of five and emit a decimal exponent;
// consequently every rendered digit is exact and reparsing is lossless.
__g1_float_decimal_from_u64_step(value: u64, digits: &mut Vec<u8>) {
    handle value == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            Vec::push(&mut *digits, wrapping_convert_to_u8(value % 10));
            __g1_float_decimal_from_u64_step(value / 10, move digits)
        }
    }
}

__g1_float_digit_vec() -> Vec<u8> { __g1_vec_new() }

__g1_float_decimal_from_u64(value: u64) -> Vec<u8> {
    let digits = __g1_float_digit_vec();
    Vec::push(&mut digits, wrapping_convert_to_u8(value % 10));
    __g1_float_decimal_from_u64_step(value / 10, &mut digits);
    move digits
}

__g1_float_decimal_multiply_at(
    digits: &mut Vec<u8>,
    factor: u64,
    cursor: usize,
    length: usize,
    carry: u64
) {
    handle cursor < length {
        Result::Ok(_) => {
            let product = wrapping_convert_to_u64(__g1_array_get_copy(&digits.storage, cursor)) * factor + carry;
            *__g1_array_get_borrow_unique(&mut digits.storage, cursor) = wrapping_convert_to_u8(
                product % 10
            );
            __g1_float_decimal_multiply_at(
                move digits,
                move factor,
                cursor + 1,
                move length,
                product / 10
            )
        },
        Result::Err(_) => handle carry == 0 {
            Result::Ok(_) => (),
            Result::Err(_) => Vec::push(move digits, wrapping_convert_to_u8(move carry))
        }
    }
}

__g1_float_decimal_multiply_power(digits: &mut Vec<u8>, factor: u64, remaining: usize) {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            let length = Vec::len(&*digits);
            __g1_float_decimal_multiply_at(&mut *digits, factor, 0, move length, 0);
            __g1_float_decimal_multiply_power(move digits, move factor, remaining - 1)
        }
    }
}

__g1_float_append_decimal_digit(formatter: &mut Formatter, digit: u8) {
    Formatter::append_char(
        move formatter,
        __g1_char_from_u32_checked(wrapping_convert_to_u32(move digit) + 48)
    )
}

__g1_float_append_decimal_tail(formatter: &mut Formatter, digits: &Vec<u8>, remaining: usize) {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            __g1_float_append_decimal_digit(
                &mut *formatter,
                __g1_array_get_copy(&digits.storage, remaining - 1)
            );
            __g1_float_append_decimal_tail(move formatter, digits, remaining - 1)
        }
    }
}

struct __FloatDecimalScale { factor: u64, remaining: usize, decimal_shift: i64 }

__g1_float_literal(formatter: &mut Formatter, text: String) {
    Formatter::literal(move formatter, &text)
}

__g1_float_append_exact_decimal(formatter: &mut Formatter, significand: u64, binary_exponent: i64) {
    let digits = __g1_float_decimal_from_u64(move significand);
    let scale = handle binary_exponent < 0 {
        Result::Ok(_) => {
            let magnitude = wrapping_neg(binary_exponent);
            __FloatDecimalScale {
                factor: 5,
                remaining: wrapping_convert_to_usize(magnitude),
                decimal_shift: move magnitude
            }
        },
        Result::Err(_) => __FloatDecimalScale {
            factor: 2,
            remaining: wrapping_convert_to_usize(binary_exponent),
            decimal_shift: 0
        }
    };
    let __FloatDecimalScale { factor, remaining, decimal_shift } = move scale;
    __g1_float_decimal_multiply_power(&mut digits, move factor, move remaining);
    let length = Vec::len(&digits);
    __g1_float_append_decimal_digit(
        &mut *formatter,
        __g1_array_get_copy(&digits.storage, length - 1)
    );
    handle length == 1 {
        Result::Ok(_) => __g1_float_literal(&mut *formatter, ".0"),
        Result::Err(_) => {
            __g1_float_literal(&mut *formatter, ".");
            __g1_float_append_decimal_tail(&mut *formatter, &digits, length - 1)
        }
    };
    __g1_float_literal(&mut *formatter, "e");
    Formatter::append_i64(move formatter, wrapping_convert_to_i64(length - 1) - move decimal_shift)
}

__g1_format_f32(formatter: &mut Formatter, value: f32) {
    let bits = f32_to_bits(move value);
    let negative = bit_and(bits, 2147483648) != 0;
    let exponent = shift_right(bit_and(bits, 2139095040), 23);
    let fraction = bit_and(bits, 8388607);
    handle move negative {
        Result::Ok(_) => __g1_float_literal(&mut *formatter, "-"),
        Result::Err(_) => ()
    };
    handle __g1_integer_equal(exponent, 255) {
        Result::Ok(_) => handle __g1_integer_equal(fraction, 0) {
            Result::Ok(_) => __g1_float_literal(move formatter, "inf"),
            Result::Err(_) => __g1_float_literal(move formatter, "NaN")
        },
        Result::Err(_) => handle __g1_integer_equal(exponent, 0) {
            Result::Ok(_) => handle __g1_integer_equal(fraction, 0) {
                Result::Ok(_) => __g1_float_literal(move formatter, "0.0"),
                Result::Err(_) => __g1_float_append_exact_decimal(
                    move formatter,
                    wrapping_convert_to_u64(move fraction),
                    -149
                )
            },
            Result::Err(_) => __g1_float_append_exact_decimal(
                move formatter,
                wrapping_convert_to_u64(bit_or(fraction, 8388608)),
                wrapping_convert_to_i64(exponent) - 150
            )
        }
    }
}

__g1_format_f64(formatter: &mut Formatter, value: f64) {
    let bits = f64_to_bits(move value);
    let negative = bit_and(bits, 9223372036854775808) != 0;
    let exponent = shift_right(bit_and(bits, 9218868437227405312), 52);
    let fraction = bit_and(bits, 4503599627370495);
    handle move negative {
        Result::Ok(_) => __g1_float_literal(&mut *formatter, "-"),
        Result::Err(_) => ()
    };
    handle __g1_integer_equal(exponent, 2047) {
        Result::Ok(_) => handle __g1_integer_equal(fraction, 0) {
            Result::Ok(_) => __g1_float_literal(move formatter, "inf"),
            Result::Err(_) => __g1_float_literal(move formatter, "NaN")
        },
        Result::Err(_) => handle __g1_integer_equal(exponent, 0) {
            Result::Ok(_) => handle __g1_integer_equal(fraction, 0) {
                Result::Ok(_) => __g1_float_literal(move formatter, "0.0"),
                Result::Err(_) => __g1_float_append_exact_decimal(
                    move formatter,
                    move fraction,
                    -1074
                )
            },
            Result::Err(_) => __g1_float_append_exact_decimal(
                move formatter,
                bit_or(fraction, 4503599627370496),
                wrapping_convert_to_i64(exponent) - 1075
            )
        }
    }
}

f32_format(value: f32) -> String {
    let formatter = Formatter::new();
    __g1_format_f32(&mut formatter, move value);
    handle Formatter::finish(move formatter) { Result::Ok(text) => move text, Result::Err(_) => "" }
}

f64_format(value: f64) -> String {
    let formatter = Formatter::new();
    __g1_format_f64(&mut formatter, move value);
    handle Formatter::finish(move formatter) { Result::Ok(text) => move text, Result::Err(_) => "" }
}

// Exact decimal-to-binary parsing. This deliberately uses an integer rational
// rather than a floating accumulator: the final division retains a remainder,
// so midpoint decisions are made directly at the requested IEEE width.
enum FloatParseError {
    Empty,
    MissingDigits(usize),
    InvalidDigit(usize),
    MisplacedSeparator(usize),
    Overflow(usize)
}

struct __FloatBig { words: ByteBuf }

__g1_float_big_zero() -> __FloatBig { __FloatBig { words: __g1_byte_buf_new() } }

__g1_float_big_word(value: &__FloatBig, index: usize) -> u32 {
    wrapping_convert_to_u32(__g1_array_get_copy(&value.words.bytes.storage, index))
}

__g1_float_big_set(value: &mut __FloatBig, index: usize, word: u32) {
    __g1_byte_buf_replace_byte(
        &mut value.words.bytes,
        move index,
        wrapping_convert_to_u8(move word)
    )
}

__g1_float_big_effective_len_from(value: &__FloatBig, length: usize) -> usize {
    handle length == 0 {
        Result::Ok(_) => 0,
        Result::Err(_) => handle __g1_float_big_word(value, length - 1) == 0 {
            Result::Ok(_) => __g1_float_big_effective_len_from(value, length - 1),
            Result::Err(_) => length
        }
    }
}

__g1_float_big_len(value: &__FloatBig) -> usize {
    __g1_float_big_effective_len_from(value, __g1_byte_buf_len(&value.words))
}

__g1_float_big_is_zero(value: &__FloatBig) -> Bool { __g1_float_big_len(value) == 0 }

__g1_float_big_append_carry(value: &mut __FloatBig, carry: u64) {
    handle carry == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            __g1_byte_buf_push(&mut value.words, wrapping_convert_to_u8(carry));
            __g1_float_big_append_carry(move value, shift_right(carry, 8))
        }
    }
}

__g1_float_big_mul_small_step(
    value: &mut __FloatBig,
    multiplier: u32,
    cursor: usize,
    length: usize,
    carry: u64
) {
    handle cursor < length {
        Result::Ok(_) => {
            let product = wrapping_convert_to_u64(__g1_float_big_word(&*value, cursor)) * wrapping_convert_to_u64(
                multiplier
            ) + carry;
            __g1_float_big_set(&mut *value, cursor, wrapping_convert_to_u32(product));
            __g1_float_big_mul_small_step(
                move value,
                multiplier,
                cursor + 1,
                length,
                shift_right(product, 8)
            )
        },
        Result::Err(_) => __g1_float_big_append_carry(move value, move carry)
    }
}

__g1_float_big_mul_small(value: &mut __FloatBig, multiplier: u32) {
    let length = __g1_byte_buf_len(&value.words);
    __g1_float_big_mul_small_step(move value, move multiplier, 0, move length, 0)
}

__g1_float_big_mul_pow10(value: &mut __FloatBig, remaining: usize) {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => handle 9 <= remaining {
            Result::Ok(_) => {
                __g1_float_big_mul_small(&mut *value, 1000000000);
                __g1_float_big_mul_pow10(move value, remaining - 9)
            },
            Result::Err(_) => {
                __g1_float_big_mul_small(&mut *value, 10);
                __g1_float_big_mul_pow10(move value, remaining - 1)
            }
        }
    }
}

__g1_float_big_clone_step(
    source: &__FloatBig,
    target: &mut __FloatBig,
    cursor: usize,
    length: usize
) {
    handle cursor < length {
        Result::Ok(_) => {
            __g1_byte_buf_push(
                &mut target.words,
                wrapping_convert_to_u8(__g1_float_big_word(source, cursor))
            );
            __g1_float_big_clone_step(source, move target, cursor + 1, length)
        },
        Result::Err(_) => ()
    }
}

__g1_float_big_clone(source: &__FloatBig) -> __FloatBig {
    let target = __g1_float_big_zero();
    __g1_float_big_clone_step(source, &mut target, 0, __g1_float_big_len(source));
    move target
}

__g1_float_big_shift_left_one(value: &mut __FloatBig) { __g1_float_big_mul_small(move value, 2) }

__g1_float_big_shift_left(value: &mut __FloatBig, count: usize) {
    handle count == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            __g1_float_big_shift_left_one(&mut *value);
            __g1_float_big_shift_left(move value, count - 1)
        }
    }
}

__g1_float_u32_bit_len(value: u32, count: usize) -> usize {
    handle value == 0 {
        Result::Ok(_) => count,
        Result::Err(_) => __g1_float_u32_bit_len(shift_right(value, 1), count + 1)
    }
}

__g1_float_big_bit_len(value: &__FloatBig) -> usize {
    let length = __g1_float_big_len(value);
    handle length == 0 {
        Result::Ok(_) => 0,
        Result::Err(_) => (length - 1) * 8 + __g1_float_u32_bit_len(
            __g1_float_big_word(value, length - 1),
            0
        )
    }
}

__g1_float_big_compare_words(left: &__FloatBig, right: &__FloatBig, remaining: usize) -> i32 {
    handle remaining == 0 {
        Result::Ok(_) => 0,
        Result::Err(_) => {
            let index = remaining - 1;
            let a = __g1_float_big_word(left, index);
            let b = __g1_float_big_word(right, index);
            handle __g1_integer_less(a, b) {
                Result::Ok(_) => -1,
                Result::Err(_) => handle __g1_integer_less(b, a) {
                    Result::Ok(_) => 1,
                    Result::Err(_) => __g1_float_big_compare_words(left, right, index)
                }
            }
        }
    }
}

__g1_float_big_compare(left: &__FloatBig, right: &__FloatBig) -> i32 {
    let a = __g1_float_big_len(left);
    let b = __g1_float_big_len(right);
    handle __g1_integer_less(a, b) {
        Result::Ok(_) => -1,
        Result::Err(_) => handle __g1_integer_less(b, a) {
            Result::Ok(_) => 1,
            Result::Err(_) => __g1_float_big_compare_words(left, right, a)
        }
    }
}

__g1_float_big_sub_step(
    left: &mut __FloatBig,
    right: &__FloatBig,
    cursor: usize,
    length: usize,
    borrow: u64
) {
    handle cursor < length {
        Result::Ok(_) => {
            let a = wrapping_convert_to_u64(__g1_float_big_word(&*left, cursor));
            let b = handle cursor < __g1_float_big_len(right) {
                Result::Ok(_) => wrapping_convert_to_u64(__g1_float_big_word(right, cursor)),
                Result::Err(_) => wrapping_convert_to_u64(0)
            };
            let subtrahend = b + borrow;
            let next_borrow = handle a < subtrahend {
                Result::Ok(_) => wrapping_convert_to_u64(1),
                Result::Err(_) => wrapping_convert_to_u64(0)
            };
            __g1_float_big_set(
                &mut *left,
                cursor,
                wrapping_convert_to_u32(wrapping_sub(a, subtrahend))
            );
            __g1_float_big_sub_step(move left, right, cursor + 1, length, move next_borrow)
        },
        Result::Err(_) => ()
    }
}

__g1_float_big_sub(left: &mut __FloatBig, right: &__FloatBig) {
    let length = __g1_float_big_len(&*left);
    __g1_float_big_sub_step(move left, right, 0, move length, 0)
}

__g1_float_big_shift_right_one_step(value: &mut __FloatBig, remaining: usize, carry: u32) {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            let index = remaining - 1;
            let word = __g1_float_big_word(&*value, index);
            __g1_float_big_set(
                &mut *value,
                index,
                bit_or(shift_right(word, 1), shift_left(carry, 7))
            );
            __g1_float_big_shift_right_one_step(move value, index, bit_and(word, 1))
        }
    }
}

__g1_float_big_shift_right_one(value: &mut __FloatBig) {
    let length = __g1_float_big_len(&*value);
    __g1_float_big_shift_right_one_step(move value, move length, 0)
}

struct __FloatIntegerEnd { magnitude: __FloatBig, cursor: usize, digit_count: usize }

struct __FloatFractionEnd {
    magnitude: __FloatBig,
    cursor: usize,
    digit_count: usize,
    fraction_digits: usize
}

struct __FloatParsed {
    magnitude: __FloatBig,
    negative: Bool,
    fraction_digits: usize,
    exponent_negative: Bool,
    exponent: usize,
    end: usize
}

__g1_float_push_decimal_digit(magnitude: &mut __FloatBig, byte: u8) {
    let length = __g1_float_big_len(&*magnitude);
    __g1_float_big_mul_small_step(
        move magnitude,
        10,
        0,
        move length,
        wrapping_convert_to_u64(byte - 48)
    )
}

__g1_float_scan_integer(
    bytes: Bytes,
    cursor: usize,
    length: usize,
    magnitude: __FloatBig,
    digits: usize,
    separator: usize,
    after_separator: Bool
) -> Result<__FloatIntegerEnd, FloatParseError> {
    handle cursor < length {
        Result::Ok(_) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle byte <= 57 {
                Result::Ok(_) => handle 48 <= byte {
                    Result::Ok(_) => {
                        __g1_float_push_decimal_digit(&mut magnitude, move byte);
                        __g1_float_scan_integer(
                            move bytes,
                            cursor + 1,
                            length,
                            move magnitude,
                            digits + 1,
                            separator,
                            false
                        )
                    },
                    Result::Err(_) => __g1_float_finish_integer(
                        move magnitude,
                        cursor,
                        digits,
                        separator,
                        move after_separator
                    )
                },
                Result::Err(_) => handle byte == 95 {
                    Result::Ok(_) => handle digits == 0 {
                        Result::Ok(_) => Result::Err(FloatParseError::MisplacedSeparator(cursor)),
                        Result::Err(_) => __g1_float_scan_integer(
                            move bytes,
                            cursor + 1,
                            length,
                            move magnitude,
                            digits,
                            cursor,
                            true
                        )
                    },
                    Result::Err(_) => __g1_float_finish_integer(
                        move magnitude,
                        cursor,
                        digits,
                        separator,
                        move after_separator
                    )
                }
            }
        },
        Result::Err(_) => __g1_float_finish_integer(
            move magnitude,
            cursor,
            digits,
            separator,
            move after_separator
        )
    }
}

__g1_float_finish_integer(
    magnitude: __FloatBig,
    cursor: usize,
    digits: usize,
    separator: usize,
    after_separator: Bool
) -> Result<__FloatIntegerEnd, FloatParseError> {
    handle digits == 0 {
        Result::Ok(_) => Result::Err(FloatParseError::MissingDigits(move cursor)),
        Result::Err(_) => handle move after_separator {
            Result::Ok(_) => Result::Err(FloatParseError::MisplacedSeparator(move separator)),
            Result::Err(_) => Result::Ok(
                __FloatIntegerEnd {
                    magnitude: move magnitude,
                    cursor: move cursor,
                    digit_count: move digits
                }
            )
        }
    }
}

__g1_float_scan_fraction(
    bytes: Bytes,
    cursor: usize,
    length: usize,
    magnitude: __FloatBig,
    total_digits: usize,
    fraction_digits: usize,
    separator: usize,
    after_separator: Bool
) -> Result<__FloatFractionEnd, FloatParseError> {
    handle cursor < length {
        Result::Ok(_) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle byte <= 57 {
                Result::Ok(_) => handle 48 <= byte {
                    Result::Ok(_) => {
                        __g1_float_push_decimal_digit(&mut magnitude, move byte);
                        __g1_float_scan_fraction(
                            move bytes,
                            cursor + 1,
                            length,
                            move magnitude,
                            total_digits + 1,
                            fraction_digits + 1,
                            separator,
                            false
                        )
                    },
                    Result::Err(_) => __g1_float_finish_fraction(
                        move magnitude,
                        cursor,
                        total_digits,
                        fraction_digits,
                        separator,
                        move after_separator
                    )
                },
                Result::Err(_) => handle byte == 95 {
                    Result::Ok(_) => handle fraction_digits == 0 {
                        Result::Ok(_) => Result::Err(FloatParseError::MisplacedSeparator(cursor)),
                        Result::Err(_) => __g1_float_scan_fraction(
                            move bytes,
                            cursor + 1,
                            length,
                            move magnitude,
                            total_digits,
                            fraction_digits,
                            cursor,
                            true
                        )
                    },
                    Result::Err(_) => __g1_float_finish_fraction(
                        move magnitude,
                        cursor,
                        total_digits,
                        fraction_digits,
                        separator,
                        move after_separator
                    )
                }
            }
        },
        Result::Err(_) => __g1_float_finish_fraction(
            move magnitude,
            cursor,
            total_digits,
            fraction_digits,
            separator,
            move after_separator
        )
    }
}

__g1_float_finish_fraction(
    magnitude: __FloatBig,
    cursor: usize,
    total_digits: usize,
    fraction_digits: usize,
    separator: usize,
    after_separator: Bool
) -> Result<__FloatFractionEnd, FloatParseError> {
    handle fraction_digits == 0 {
        Result::Ok(_) => Result::Err(FloatParseError::MissingDigits(move cursor)),
        Result::Err(_) => handle move after_separator {
            Result::Ok(_) => Result::Err(FloatParseError::MisplacedSeparator(move separator)),
            Result::Err(_) => Result::Ok(
                __FloatFractionEnd {
                    magnitude: move magnitude,
                    cursor: move cursor,
                    digit_count: move total_digits,
                    fraction_digits: move fraction_digits
                }
            )
        }
    }
}

struct __FloatExponentScan {
    cursor: usize,
    exponent_magnitude: usize,
    digits: usize,
    separator: usize,
    after_separator: Bool,
    allow_sign: Bool,
    cap: usize,
    value_magnitude: __FloatBig,
    negative: Bool,
    fraction_digits: usize,
    exponent_negative: Bool
}

__g1_float_exponent_push(magnitude: usize, digit: usize, cap: usize) -> usize {
    handle magnitude < cap {
        Result::Ok(_) => magnitude * wrapping_convert_to_usize(10) + digit,
        Result::Err(_) => move cap
    }
}

__g1_float_is_decimal_digit(byte: u8) -> Bool {
    handle 48 <= byte { Result::Ok(_) => byte <= 57, Result::Err(_) => false }
}

__g1_float_scan_exponent(bytes: Bytes, length: usize, scan: __FloatExponentScan) -> Result<
    __FloatParsed,
    FloatParseError
> {
    let __FloatExponentScan {
        cursor,
        exponent_magnitude,
        digits,
        separator,
        after_separator,
        allow_sign,
        cap,
        value_magnitude,
        negative,
        fraction_digits,
        exponent_negative
    } = move scan;
    handle cursor < length {
        Result::Ok(_) => {
            let byte = __g1_bytes_get(bytes, cursor);
            handle __g1_float_is_decimal_digit(byte) {
                Result::Ok(_) => {
                    let digit = wrapping_convert_to_usize(byte - 48);
                    let next = __g1_float_exponent_push(exponent_magnitude, move digit, cap);
                    __g1_float_scan_exponent(
                        move bytes,
                        length,
                        __FloatExponentScan {
                            cursor: cursor + 1,
                            exponent_magnitude: move next,
                            digits: digits + 1,
                            separator: move separator,
                            after_separator: false,
                            allow_sign: false,
                            cap: move cap,
                            value_magnitude: move value_magnitude,
                            negative: move negative,
                            fraction_digits: move fraction_digits,
                            exponent_negative: move exponent_negative
                        }
                    )
                },
                Result::Err(_) => handle byte == 43 {
                    Result::Ok(_) => handle move allow_sign {
                        Result::Ok(_) => __g1_float_scan_exponent(
                            move bytes,
                            length,
                            __FloatExponentScan {
                                cursor: cursor + 1,
                                exponent_magnitude: move exponent_magnitude,
                                digits: move digits,
                                separator: move separator,
                                after_separator: false,
                                allow_sign: false,
                                cap: move cap,
                                value_magnitude: move value_magnitude,
                                negative: move negative,
                                fraction_digits: move fraction_digits,
                                exponent_negative: false
                            }
                        ),
                        Result::Err(_) => {
                            value_magnitude;
                            Result::Err(FloatParseError::InvalidDigit(cursor))
                        }
                    },
                    Result::Err(_) => handle byte == 45 {
                        Result::Ok(_) => handle move allow_sign {
                            Result::Ok(_) => __g1_float_scan_exponent(
                                move bytes,
                                length,
                                __FloatExponentScan {
                                    cursor: cursor + 1,
                                    exponent_magnitude: move exponent_magnitude,
                                    digits: move digits,
                                    separator: move separator,
                                    after_separator: false,
                                    allow_sign: false,
                                    cap: move cap,
                                    value_magnitude: move value_magnitude,
                                    negative: move negative,
                                    fraction_digits: move fraction_digits,
                                    exponent_negative: true
                                }
                            ),
                            Result::Err(_) => {
                                value_magnitude;
                                Result::Err(FloatParseError::InvalidDigit(cursor))
                            }
                        },
                        Result::Err(_) => handle byte == 95 {
                            Result::Ok(_) => __g1_float_scan_exponent(
                                move bytes,
                                length,
                                __FloatExponentScan {
                                    cursor: cursor + 1,
                                    exponent_magnitude: move exponent_magnitude,
                                    digits: move digits,
                                    separator: move cursor,
                                    after_separator: true,
                                    allow_sign: false,
                                    cap: move cap,
                                    value_magnitude: move value_magnitude,
                                    negative: move negative,
                                    fraction_digits: move fraction_digits,
                                    exponent_negative: move exponent_negative
                                }
                            ),
                            Result::Err(_) => {
                                value_magnitude;
                                Result::Err(FloatParseError::InvalidDigit(cursor))
                            }
                        }
                    }
                }
            }
        },
        Result::Err(_) => handle move after_separator {
            Result::Ok(_) => {
                value_magnitude;
                Result::Err(FloatParseError::MisplacedSeparator(separator))
            },
            Result::Err(_) => handle digits == 0 {
                Result::Ok(_) => {
                    value_magnitude;
                    Result::Err(FloatParseError::MissingDigits(cursor))
                },
                Result::Err(_) => Result::Ok(
                    __FloatParsed {
                        magnitude: move value_magnitude,
                        negative: move negative,
                        fraction_digits: move fraction_digits,
                        exponent_negative: move exponent_negative,
                        exponent: move exponent_magnitude,
                        end: move cursor
                    }
                )
            }
        }
    }
}

__g1_float_exponent_initial_state(
    length: usize,
    magnitude: __FloatBig,
    negative: Bool,
    fraction_digits: usize,
    marker: usize
) -> __FloatExponentScan {
    __FloatExponentScan {
        cursor: marker + 1,
        exponent_magnitude: 0,
        digits: 0,
        separator: marker + 1,
        after_separator: false,
        allow_sign: true,
        cap: length + 5000,
        value_magnitude: move magnitude,
        negative: move negative,
        fraction_digits: move fraction_digits,
        exponent_negative: false
    }
}

__g1_float_finish_components(
    source: &String,
    length: usize,
    magnitude: __FloatBig,
    negative: Bool,
    fraction_digits: usize,
    cursor: usize
) -> Result<__FloatParsed, FloatParseError> {
    handle cursor == length {
        Result::Ok(_) => Result::Ok(
            __FloatParsed {
                magnitude: move magnitude,
                negative: move negative,
                fraction_digits: move fraction_digits,
                exponent_negative: false,
                exponent: 0,
                end: move cursor
            }
        ),
        Result::Err(_) => {
            let byte = __g1_bytes_get(String::as_bytes(source), cursor);
            handle byte == 101 {
                Result::Ok(_) => __g1_float_scan_exponent(
                    String::as_bytes(source),
                    length,
                    __g1_float_exponent_initial_state(
                        length,
                        move magnitude,
                        move negative,
                        move fraction_digits,
                        cursor
                    )
                ),
                Result::Err(_) => handle byte == 69 {
                    Result::Ok(_) => __g1_float_scan_exponent(
                        String::as_bytes(source),
                        length,
                        __g1_float_exponent_initial_state(
                            length,
                            move magnitude,
                            move negative,
                            move fraction_digits,
                            cursor
                        )
                    ),
                    Result::Err(_) => Result::Err(FloatParseError::InvalidDigit(move cursor))
                }
            }
        }
    }
}

__g1_float_parse_fraction_from(
    source: &String,
    length: usize,
    integer: __FloatIntegerEnd,
    negative: Bool
) -> Result<__FloatParsed, FloatParseError> {
    let __FloatIntegerEnd { magnitude, cursor: dot, digit_count } = move integer;
    let bytes = String::as_bytes(source);
    handle __g1_float_scan_fraction(
        move bytes,
        dot + 1,
        length,
        move magnitude,
        digit_count,
        0,
        dot + 1,
        false
    ) {
        Result::Ok(fraction) => {
            let __FloatFractionEnd { magnitude: combined, cursor, digit_count: _, fraction_digits } = move fraction;
            __g1_float_finish_components(
                source,
                length,
                move combined,
                move negative,
                move fraction_digits,
                move cursor
            )
        },
        Result::Err(error) => Result::Err(move error)
    }
}

__g1_float_finish_integer_component(
    source: &String,
    length: usize,
    integer: __FloatIntegerEnd,
    negative: Bool
) -> Result<__FloatParsed, FloatParseError> {
    let cursor = integer.cursor;
    handle cursor < length {
        Result::Ok(_) => handle __g1_bytes_get(String::as_bytes(source), cursor) == 46 {
            Result::Ok(_) => __g1_float_parse_fraction_from(
                source,
                length,
                move integer,
                move negative
            ),
            Result::Err(_) => {
                let __FloatIntegerEnd { magnitude, cursor: end, digit_count: _ } = move integer;
                __g1_float_finish_components(
                    source,
                    length,
                    move magnitude,
                    move negative,
                    0,
                    move end
                )
            }
        },
        Result::Err(_) => {
            let __FloatIntegerEnd { magnitude, cursor: end, digit_count: _ } = move integer;
            __g1_float_finish_components(source, length, move magnitude, move negative, 0, move end)
        }
    }
}

__g1_float_parse_syntax(value: &String) -> Result<__FloatParsed, FloatParseError> {
    let bytes = String::as_bytes(value);
    let length = Bytes::len(&bytes);
    handle length == 0 {
        Result::Ok(_) => Result::Err(FloatParseError::Empty),
        Result::Err(_) => {
            let first = __g1_bytes_get(String::as_bytes(value), 0);
            let start = handle first == 43 {
                Result::Ok(_) => wrapping_convert_to_usize(1),
                Result::Err(_) => handle first == 45 {
                    Result::Ok(_) => wrapping_convert_to_usize(1),
                    Result::Err(_) => wrapping_convert_to_usize(0)
                }
            };
            let negative = __g1_bytes_get(String::as_bytes(value), 0) == 45;
            handle __g1_float_scan_integer(
                String::as_bytes(value),
                start,
                length,
                __g1_float_big_zero(),
                0,
                start,
                false
            ) {
                Result::Ok(integer) => __g1_float_finish_integer_component(
                    value,
                    length,
                    move integer,
                    move negative
                ),
                Result::Err(error) => Result::Err(move error)
            }
        }
    }
}

struct __FloatRatio { numerator: __FloatBig, denominator: __FloatBig, negative: Bool, end: usize }

__g1_float_numerator_decimal_power(fraction_digits: usize, exponent_negative: Bool, exponent: usize) -> usize {
    handle move exponent_negative {
        Result::Ok(_) => 0,
        Result::Err(_) => handle fraction_digits <= exponent {
            Result::Ok(_) => exponent - fraction_digits,
            Result::Err(_) => 0
        }
    }
}

__g1_float_denominator_decimal_power(
    fraction_digits: usize,
    exponent_negative: Bool,
    exponent: usize
) -> usize {
    handle move exponent_negative {
        Result::Ok(_) => fraction_digits + exponent,
        Result::Err(_) => handle exponent < fraction_digits {
            Result::Ok(_) => fraction_digits - exponent,
            Result::Err(_) => 0
        }
    }
}

__g1_float_ratio(parsed: __FloatParsed) -> __FloatRatio {
    let __FloatParsed { magnitude, negative, fraction_digits, exponent_negative, exponent, end } = move parsed;
    let numerator = move magnitude;
    let denominator = __g1_float_big_zero();
    __g1_byte_buf_push(&mut denominator.words, 1);
    let numerator_power = __g1_float_numerator_decimal_power(
        fraction_digits,
        exponent_negative,
        exponent
    );
    let denominator_power = __g1_float_denominator_decimal_power(
        fraction_digits,
        exponent_negative,
        exponent
    );
    __g1_float_big_mul_pow10(&mut numerator, move numerator_power);
    __g1_float_big_mul_pow10(&mut denominator, move denominator_power);
    __FloatRatio {
        numerator: move numerator,
        denominator: move denominator,
        negative: move negative,
        end: move end
    }
}

__g1_float_compare_ratio_power(numerator: &__FloatBig, denominator: &__FloatBig, exponent: i64) -> i32 {
    handle exponent < 0 {
        Result::Ok(_) => {
            let shifted = __g1_float_big_clone(numerator);
            __g1_float_big_shift_left(&mut shifted, wrapping_convert_to_usize(0 - exponent));
            __g1_float_big_compare(&shifted, denominator)
        },
        Result::Err(_) => {
            let shifted = __g1_float_big_clone(denominator);
            __g1_float_big_shift_left(&mut shifted, wrapping_convert_to_usize(exponent));
            __g1_float_big_compare(numerator, &shifted)
        }
    }
}

__g1_float_floor_binary_exponent(numerator: &__FloatBig, denominator: &__FloatBig) -> i64 {
    let nbits = __g1_float_big_bit_len(numerator);
    let dbits = __g1_float_big_bit_len(denominator);
    let candidate = handle dbits <= nbits {
        Result::Ok(_) => wrapping_convert_to_i64(nbits - dbits),
        Result::Err(_) => 0 - wrapping_convert_to_i64(dbits - nbits)
    };
    handle __g1_float_compare_ratio_power(numerator, denominator, candidate) < 0 {
        Result::Ok(_) => candidate - 1,
        Result::Err(_) => move candidate
    }
}

struct __FloatDivision { quotient: u64, remainder: __FloatBig }

__g1_float_big_branch(value: __FloatBig, select_ok: Bool) -> Result<__FloatBig, __FloatBig> {
    handle move select_ok {
        Result::Ok(_) => Result::Ok(move value),
        Result::Err(_) => Result::Err(move value)
    }
}

__g1_float_divide_bits_step(
    remainder: __FloatBig,
    divisor: __FloatBig,
    remaining: usize,
    quotient: u64
) -> __FloatDivision {
    handle remaining == 0 {
        Result::Ok(_) => __FloatDivision { quotient: move quotient, remainder: move remainder },
        Result::Err(_) => {
            let bit = remaining - 1;
            let smaller = __g1_float_big_compare(&remainder, &divisor) < 0;
            handle __g1_float_big_branch(move remainder, move smaller) {
                Result::Ok(unchanged) => {
                    __g1_float_big_shift_right_one(&mut divisor);
                    __g1_float_divide_bits_step(move unchanged, move divisor, bit, move quotient)
                },
                Result::Err(reduced) => {
                    __g1_float_big_sub(&mut reduced, &divisor);
                    let next_quotient = bit_or(
                        move quotient,
                        shift_left(wrapping_convert_to_u64(1), wrapping_convert_to_u32(bit))
                    );
                    __g1_float_big_shift_right_one(&mut divisor);
                    __g1_float_divide_bits_step(move reduced, move divisor, bit, move next_quotient)
                }
            }
        }
    }
}

__g1_float_divide_bits(numerator: __FloatBig, denominator: &__FloatBig) -> __FloatDivision {
    let smaller = __g1_float_big_compare(&numerator, denominator) < 0;
    handle __g1_float_big_branch(move numerator, move smaller) {
        Result::Ok(remainder) => __FloatDivision { quotient: 0, remainder: move remainder },
        Result::Err(remainder) => {
            let shift = __g1_float_big_bit_len(&remainder) - __g1_float_big_bit_len(denominator);
            let divisor = __g1_float_big_clone(denominator);
            __g1_float_big_shift_left(&mut divisor, shift);
            __g1_float_divide_bits_step(move remainder, move divisor, shift + 1, 0)
        }
    }
}

__g1_float_scaled_division(numerator: &__FloatBig, denominator: &__FloatBig, shift: i64) -> (
    __FloatDivision,
    __FloatBig
