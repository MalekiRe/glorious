                (*value).index = move next;
                Option::Some(__g1_char_to_u32(move character))
            },
            Result::Err(_) => {
                (*value).index = move end;
                None
            }
        },
        Result::Err(_) => None
    }
}

__g1_char_indices_next_offset(value: &mut CharIndices) -> Option<usize> {
    let index = value.index;
    let end = value.end;
    let bytes = value.bytes;
