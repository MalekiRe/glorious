enum DiagnosticSeverity { Error, Warning, Note, Help }

struct SourceDiagnosticLabel {
    // Generation 1 locates the annotation by `span.start`; `span.end` remains
    // metadata for a richer future underline renderer and is never indexed.
    private span: Range<usize>,
    private message: String,
    private primary: Bool
}

struct SourceDiagnostic {
    private severity: DiagnosticSeverity,
    private message: String,
    private labels: Vec<SourceDiagnosticLabel>,
    private notes: Vec<String>
}

__g1_source_diagnostic_new(severity: DiagnosticSeverity, message: String) -> SourceDiagnostic {
    SourceDiagnostic {
        severity: move severity,
        message: move message,
        labels: Vec::new(),
        notes: Vec::new()
    }
}

__g1_source_diagnostic_label(
    value: &mut SourceDiagnostic,
    span: Range<usize>,
    message: String,
    primary: Bool
) {
    Vec::push(
        &mut value.labels,
        SourceDiagnosticLabel { span: move span, message: move message, primary: move primary }
    )
}

__g1_source_diagnostic_note(value: &mut SourceDiagnostic, note: String) {
    Vec::push(&mut value.notes, move note)
}

__g1_diagnostic_severity_text(value: &DiagnosticSeverity) -> String {
    if(*value is DiagnosticSeverity::Error) {
        "error"
    } else(
        if(*value is DiagnosticSeverity::Warning) {
            "warning"
        } else(
            if(*value is DiagnosticSeverity::Note) {
                "note"
            } else { "help" }
        )
    )
}

__g1_source_diagnostic_location(formatter: &mut Formatter, sources: &SourceMap, offset: usize) {
    handle SourceMap::lookup(sources, move offset) {
        Result::Ok(location) => {
            let file = __g1_source_map_file_at(
                sources,
                wrapping_convert_to_usize(location.file.raw)
            );
            Formatter::literal(&mut *formatter, &file.name);
            __g1_debug_literal(&mut *formatter, ":");
            Formatter::append_u64(
                &mut *formatter,
                wrapping_convert_to_u64(
                    __g1_integer_add(location.line, wrapping_convert_to_usize(1))
                )
            );
            __g1_debug_literal(&mut *formatter, ":");
            Formatter::append_u64(
                move formatter,
                wrapping_convert_to_u64(
                    __g1_integer_add(location.column, wrapping_convert_to_usize(1))
                )
            )
        },
        Result::Err(_) => __g1_debug_literal(move formatter, "<unknown>:0:0")
    }
}

__g1_source_diagnostic_labels(
    formatter: &mut Formatter,
    sources: &SourceMap,
    labels: &Vec<SourceDiagnosticLabel>,
    index: usize
) {
    handle index < Vec::len(labels) {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let annotation = Vec::index(labels, index);
            Formatter::newline(&mut *formatter);
            __g1_debug_literal(&mut *formatter, " --> ");
            __g1_source_diagnostic_location(&mut *formatter, sources, annotation.span.start);
            Formatter::newline(&mut *formatter);
            handle annotation.primary {
                Result::Ok(_) => __g1_debug_literal(&mut *formatter, "  = primary: "),
                Result::Err(_) => __g1_debug_literal(&mut *formatter, "  = label: ")
            };
            Formatter::literal(&mut *formatter, &annotation.message);
            __g1_source_diagnostic_labels(move formatter, sources, labels, index + 1)
        }
    }
}

__g1_source_diagnostic_notes(formatter: &mut Formatter, notes: &Vec<String>, index: usize) {
    handle index < Vec::len(notes) {
        Result::Err(_) => (),
        Result::Ok(_) => {
            Formatter::newline(&mut *formatter);
            __g1_debug_literal(&mut *formatter, "  = note: ");
            Formatter::literal(&mut *formatter, Vec::index(notes, index));
            __g1_source_diagnostic_notes(move formatter, notes, index + 1)
        }
    }
}

__g1_source_diagnostic_render(value: &SourceDiagnostic, sources: &SourceMap) -> Result<
    String,
    Utf8Error
> {
    let formatter = Formatter::new();
    let severity = __g1_diagnostic_severity_text(&value.severity);
    Formatter::literal(&mut formatter, &severity);
    __g1_debug_literal(&mut formatter, ": ");
    Formatter::literal(&mut formatter, &value.message);
    __g1_source_diagnostic_labels(&mut formatter, sources, &value.labels, 0);
    __g1_source_diagnostic_notes(&mut formatter, &value.notes, 0);
    Formatter::finish(move formatter)
}

let SourceDiagnostic::new = __g1_source_diagnostic_new;
let SourceDiagnostic::annotate = __g1_source_diagnostic_label;
let SourceDiagnostic::note = __g1_source_diagnostic_note;
let SourceDiagnostic::render = __g1_source_diagnostic_render;
// Generic interners keep each canonical T exactly once. A deterministic hash
// selects one of 4,096 ID buckets; equality is checked only within that bucket,
// so collisions cannot change canonical identity and no T must be cloned into
// a secondary map key. The larger direct table avoids both long collision
// chains and the cost of hashing an already-computed hash through HashMap.
struct Interner<T> { private values: Vec<T>, private buckets: Vec<Vec<Id<T>>> }

enum __InternerProbe < T > { Found(Id<T>), Missing }

__g1_interner_empty_bucket<T>(buckets: &Vec<Vec<Id<T>>>) -> Vec<Id<T>> {
    buckets;
    Vec::new()
}

__g1_interner_fill_buckets<T>(buckets: &mut Vec<Vec<Id<T>>>, capacity: usize) {
    let current = Vec::len(&*buckets);
    handle current < capacity {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let bucket = __g1_interner_empty_bucket(&*buckets);
            Vec::push(&mut *buckets, move bucket);
            __g1_interner_fill_buckets(move buckets, move capacity)
        }
    }
}

__g1_interner_new<T>() -> Interner<T> { Interner { values: Vec::new(), buckets: Vec::new() } }

__g1_interner_prepare<T>(value: &mut Interner<T>) {
    __g1_interner_fill_buckets(&mut value.buckets, 1024)
}

__g1_interner_len<T>(value: &Interner<T>) -> usize { Vec::len(&value.values) }

__g1_interner_get<'a, T>(value: &'a Interner<T>, id: Id<T>) -> Option<& 'a T> {
    Vec::get(&value.values, Id::to_usize(move id))
}

__g1_interner_bucket<T>(value: &Interner<T>, candidate: &T) -> usize where T: Hash {
    wrapping_convert_to_usize(
        __g1_u64_rem(
            __g1_hash_map_hash(candidate),
            wrapping_convert_to_u64(Vec::len(&value.buckets))
        )
    )
}

__g1_interner_id_at<T>(bucket: &Vec<Id<T>>, cursor: usize, candidate: &T) -> Id<T> {
    candidate;
    __g1_array_get_copy(&bucket.storage, cursor)
}

__g1_interner_find<T>(
    value: &Interner<T>,
    candidate: &T,
    bucket: &Vec<Id<T>>,
    cursor: usize,
    length: usize
) -> __InternerProbe<T> where T: Eq {
    handle cursor < length {
        Result::Ok(_) => {
            let id = __g1_interner_id_at(bucket, cursor, candidate);
            let resident = __g1_vec_index(&value.values, Id::to_usize(id));
            handle __g1_hash_map_keys_equal(resident, candidate) {
                Result::Ok(_) => __InternerProbe::Found(move id),
                Result::Err(_) => __g1_interner_find(value, candidate, bucket, cursor + 1, length)
            }
        },
        Result::Err(_) => __InternerProbe::Missing
    }
}

__g1_interner_probe<T>(value: &Interner<T>, candidate: &T, bucket_index: usize) -> __InternerProbe<
    T
> where T: Eq {
    let bucket = __g1_vec_index(&value.buckets, bucket_index);
    __g1_interner_find(value, candidate, bucket, 0, Vec::len(bucket))
}

__g1_interner_insert<T>(value: &mut Interner<T>, candidate: T, bucket: usize) -> Result<Id<T>, T> {
    let length = Vec::len(&value.values);
    let converted = checked_usize_to_u32(length);
    handle move converted {
        Result::Ok(raw) => {
            let id = __g1_id_with_tag(move raw, &candidate);
            Vec::push(&mut value.values, move candidate);
            Vec::push(__g1_vec_index_mut(&mut value.buckets, move bucket), id);
            Result::Ok(move id)
        },
        Result::Err(_) => Result::Err(move candidate)
    }
}

__g1_interner_found<T>(id: Id<T>, candidate: T) -> Result<Id<T>, T> where T: Use<[0, *]> {
    candidate;
    Result::Ok(move id)
}

__g1_interner_intern<T>(value: &mut Interner<T>, candidate: T) -> Result<Id<T>, T> where T: Eq,
T: Hash,
T: Use<[0, *]> {
    __g1_interner_prepare(&mut *value);
    let bucket_index = __g1_interner_bucket(&*value, &candidate);
    let probe = __g1_interner_probe(&*value, &candidate, bucket_index);
    handle move probe {
        __InternerProbe::Found(id) => __g1_interner_found(move id, move candidate),
        __InternerProbe::Missing => __g1_interner_insert(
            move value,
            move candidate,
            move bucket_index
        )
    }
}

__g1_interner_index_or_len<T>(value: &Interner<T>, candidate: &T) -> usize where T: Eq,
T: Hash {
    let length = Interner::len(value);
    let bucket_index = __g1_interner_bucket(value, candidate);
    let probe = __g1_interner_probe(value, candidate, bucket_index);
    handle move probe {
        __InternerProbe::Found(id) => Id::to_usize(move id),
        __InternerProbe::Missing => move length
    }
}

__g1_string_interner_intern(value: &mut Interner<String>, candidate: String) -> Result<
    Id<String>,
    String
> { __g1_interner_intern(move value, move candidate) }

__g1_string_interner_index_or_len(value: &Interner<String>, candidate: &String) -> usize {
    __g1_interner_index_or_len(value, candidate)
}

let Interner::new = __g1_interner_new;
let Interner::len = __g1_interner_len;
let Interner::get = __g1_interner_get;
let Interner::intern = __g1_interner_intern;
let Interner::index_or_len = __g1_interner_index_or_len;
let Interner::intern_string = __g1_string_interner_intern;
let Interner::string_index_or_len = __g1_string_interner_index_or_len;
// Layer 3c: compiler resource accounting. StepBudget is deliberately based on
// deterministic logical work rather than wall time. Its state is private so a
// compiler phase can spend or inspect a budget but cannot replenish it.
struct StepBudget { private remaining: usize }

__g1_step_budget_new(limit: usize) -> StepBudget { StepBudget { remaining: move limit } }

__g1_step_budget_remaining(value: &StepBudget) -> usize { value.remaining }

__g1_step_budget_is_exhausted(value: &StepBudget) -> Bool { value.remaining == 0 }

__g1_step_budget_spend(value: &mut StepBudget, steps: usize) -> Bool {
    let remaining = __g1_step_budget_remaining(&*value);
    (*value).remaining = move remaining - move steps;
    true
}

__g1_step_budget_try_take(value: &mut StepBudget, steps: usize) -> Bool {
    let available = __g1_step_budget_remaining(&*value);
    handle steps <= available {
        Result::Ok(_) => __g1_step_budget_spend(move value, move steps),
        Result::Err(_) => false
    }
}

let StepBudget::new = __g1_step_budget_new;
let StepBudget::remaining = __g1_step_budget_remaining;
let StepBudget::is_exhausted = __g1_step_budget_is_exhausted;
let StepBudget::try_take = __g1_step_budget_try_take;
// Layer 4: compiler-host protocols. String remains an ordinary source alias;
// only this standard-library source entry has the authority to seal the host's
// initialized Array<Text> result inside Vec's private representation.
effect ProcessArgs { get() -> Vec<String> }

effect FileRead { read(path: String) -> Bytes }

effect FileWrite { write(path: String, bytes: Bytes) }

effect Diagnostic { write(text: String) }

// Recoverable phase diagnostics are distinct from terminal label exits. The
// payload remains structured and generic; a phase-local handler decides how to
// store/render it and then resumes compilation.
effect Report<D> { [1,1] emit(diagnostic: D) -> () }

process_args() -> Vec<String> / ProcessArgs { ProcessArgs::get() }

read_file(path: String) -> Bytes / FileRead { FileRead::read(move path) }

write_file(path: String, bytes: Bytes) / FileWrite { FileWrite::write(move path, move bytes) }

write_diagnostic(text: String) / Diagnostic { Diagnostic::write(move text) }

__g1_vec_from_array<T>(storage: Array<T>) -> Vec<T> { Vec { storage: move storage } }

run_compiler_host<F, R>(main: F) -> R where F: Fn < (),
Output = R,
Effects = { ProcessArgs, FileRead, FileWrite, Diagnostic } > {
    handle { main() } {
        ProcessArgs::get(continuation) => {
            continuation(__g1_vec_from_array(__g1_process_args_get()))
        },
        FileRead::read(path, continuation) => { continuation(__g1_fs_read(move path)) },
        FileWrite::write(path, bytes, continuation) => {
            __g1_fs_write(move path, move bytes);
            continuation(())
        },
        Diagnostic::write(text, continuation) => {
            __g1_diagnostic_write(move text);
            continuation(())
        }
    }
}

// Source-defined structured iteration. `Break` and `Continue` are ordinary
// terminal effects; the nearest combinator handles its own control requests,
// so nested loops compose without compiler-known loop nodes. An explicit
// binder around the call (`@name: { loop { ... } }`) gives APIs a generative
// lexical brand when they need to name the loop region.
effect Break { stop() -> ! }

effect Continue { next() -> ! }

break() -> !/ Break { Break::stop() }

continue() -> !/ Continue { Continue::next() }

__g1_loop_continue_flag() -> u32 { 1 }

__g1_loop_stop_flag() -> u32 { 0 }

__g1_loop_step<F>(body: F) / Break where F: Fn < (),
Output = (),
Effects = { Break, Continue } > {
    handle body() { Continue::next() => () };
    __g1_loop_step(body)
}

loop<F>(body: F) where F: Fn < (),
Output = (),
Effects = { Break, Continue } > { handle __g1_loop_step(body) { Break::stop() => () } }

__g1_while_step<F>(step: F) / Break where F: Fn < (),
Output = u32,
Effects = { Break, Continue } > {
    match((handle step() { Continue::next() => 1 }) == 0) {
        true => (),
        false => __g1_while_step(step)
    }
}

while<F>(step: F) where F: Fn < (),
Output = u32,
Effects = { Break, Continue } > { handle __g1_while_step(step) { Break::stop() => () } }

until<F>(step: F) where F: Fn < (),
Output = u32,
Effects = { Break, Continue } > { while(step) }

__g1_times_step<F>(remaining: usize, body: F) / Break where F: Fn < (),
Output = (),
Effects = { Break, Continue } > {
    match(remaining == 0) {
        true => (),
        false => {
            handle body() { Continue::next() => () };
            __g1_times_step(remaining - 1, body)
        }
    }
}

times<F>(count: usize, body: F) where F: Fn < (),
Output = (),
Effects = { Break, Continue } > { handle __g1_times_step(count, body) { Break::stop() => () } }

__g1_for_each_step<T, F>(iterator: VecIntoIter<T>, body: F) / Break where T: Use<[0, 0]>,
F: Fn < (T),
Output = (),
Effects = { Break, Continue } > {
    match(VecIntoIter::next(iterator)) {
        Option::Some((item, remaining)) => {
            handle body(item) { Continue::next() => () };
            __g1_for_each_step(remaining, body)
        },
        None => ()
    }
}

for_each<T, F>(iterator: VecIntoIter<T>, body: F) where T: Use<[0, 0]>,
F: Fn < (T),
Output = (),
Effects = { Break, Continue } > {
    handle __g1_for_each_step(iterator, body) { Break::stop() => () }
}

fold<T, A, F>(iterator: VecIntoIter<T>, seed: A, body: F) -> A where F: Fn < (A, T),
Output = A,
Effects = {} > {
    match(VecIntoIter::next(iterator)) {
        Option::Some((item, remaining)) => fold(remaining, body(seed, item), body),
        None => seed
    }
}

// Proof-only error propagation. `exit` is a statically branded destination;
// every instantiated call is control-inlined and its error arm becomes a
// direct LEAVE in the caller's frame.
try<T, E, S, L>(value: Result<T, E>, exit: L) -> T where L: Label<Result<S, E>> {
    handle value {
        Result::Ok(inner) => move inner,
        Result::Err(error) => exit(Result::Err(move error))
    }
}

// Small branded guard vocabulary. These functions retain the caller's exact
// result/error type and become direct leaves when their label is static.
bail<T, E, L>(error: E, exit: L) -> ! where L: Label<Result<T, E>> {
    exit(Result::Err(move error))
}

ensure<T, E, L>(condition: Bool, error: E, exit: L)
where L: Label<Result<T, E>>,
E: Use<[0, 1]> {
    if(condition) { () } else { exit(Result::Err(move error)) }
}

leave_if<T, L>(condition: Bool, value: T, exit: L)
where L: Label<T>,
T: Use<[0, 1]> {
    if(condition) { exit(move value) } else { () }
}

some_or_leave<T, R, L>(value: Option<T>, failure: R, exit: L) -> T
where L: Label<R>,
R: Use<[0, 1]> {
    if(value is Option::Some(inner)) {
        inner
    } else {
        exit(move failure)
    }
}

ok_or_leave<T, E, S, L>(value: Result<T, E>, exit: L) -> T
where L: Label<Result<S, E>> {
    try(move value, exit)
}

require<T, E, S, L>(value: Option<T>, error: E, exit: L) -> T
where L: Label<Result<S, E>>,
E: Use<[0, 1]> {
    if(value is Option::Some(inner)) {
        inner
    } else {
        exit(Result::Err(move error))
    }
}

require_eq<T, E, L>(equal: Bool, error: E, exit: L)
where L: Label<Result<T, E>>,
E: Use<[0, 1]> {
    ensure(equal, error, exit)
}

require_index<T, E, S, L>(value: Option<T>, error: E, exit: L) -> T
where L: Label<Result<S, E>>,
E: Use<[0, 1]> {
    require(value, error, exit)
}

require_conversion<T, E, S, L>(value: Result<T, E>, exit: L) -> T
where L: Label<Result<S, E>> {
    try(value, exit)
}

return_if<T, L>(condition: Bool, value: T, exit: L)
where L: Label<T>,
T: Use<[0, 1]> {
    leave_if(condition, value, exit)
}
