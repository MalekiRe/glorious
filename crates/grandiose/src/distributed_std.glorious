struct SourceFileTag {}

struct SourceFile {
    private name: String,
    private source: String,
    private start: usize,
    private end: usize,
    private line_starts: Vec<usize>
}

struct SourceLocation { file: Id<SourceFileTag>, line: usize, column: usize }

enum SourceMapAddResult { Added(Id<SourceFileTag>), Capacity(ToolkitCapacityError) }

enum __SourceFileIdResult { Fits(Id<SourceFileTag>), Overflow }

struct SourceMap { private files: Vec<SourceFile>, private total_length: usize }

__g1_source_map_maybe_line(starts: Vec<usize>, next: usize, newline: Bool) -> Vec<usize> {
    handle move newline {
        Result::Ok(_) => {
            Vec::push(&mut starts, move next);
            move starts
        },
        Result::Err(_) => move starts
    }
}

__g1_source_map_new() -> SourceMap { SourceMap { files: Vec::new(), total_length: 0 } }

__g1_source_map_scan_lines(bytes: Bytes, cursor: usize, length: usize, starts: Vec<usize>) -> Vec<
    usize
> {
    handle cursor < length {
        Result::Ok(_) => {
            let newline = __g1_bytes_get(bytes, cursor) == 10;
            let starts = __g1_source_map_maybe_line(move starts, cursor + 1, move newline);
            __g1_source_map_scan_lines(move bytes, cursor + 1, length, move starts)
        },
        Result::Err(_) => move starts
    }
}

__g1_source_map_empty_lines() -> Vec<usize> { Vec::new() }

__g1_source_map_line_starts(source: &String) -> Vec<usize> {
    let starts = __g1_source_map_empty_lines();
    Vec::push(&mut starts, __g1_toolkit_usize_zero());
    let bytes = String::as_bytes(source);
    let length = Bytes::len(&bytes);
    __g1_source_map_scan_lines(move bytes, 0, length, move starts)
}

__g1_source_map_push(
    value: &mut SourceMap,
    id: Id<SourceFileTag>,
    name: String,
    source: String,
    end: usize
) -> SourceMapAddResult {
    let start = value.total_length;
    let line_starts = __g1_source_map_line_starts(&source);
    Vec::push(
        &mut value.files,
        SourceFile {
            name: move name,
            source: move source,
            start: start,
            end: end,
            line_starts: move line_starts
        }
    );
    (*value).total_length = move end;
    SourceMapAddResult::Added(move id)
}

__g1_source_map_add(value: &mut SourceMap, name: String, source: String) -> SourceMapAddResult {
    let length = String::byte_len(&source);
    let start = value.total_length;
    let file_count = Vec::len(&value.files);
    let tag = SourceFileTag {};
    let id_result = handle checked_usize_to_u32(file_count) {
        Result::Ok(raw) => __SourceFileIdResult::Fits(Id::with_tag(move raw, &tag)),
        Result::Err(_) => __SourceFileIdResult::Overflow
    };
    handle checked_usize_add(start, length) {
        Result::Ok(end) => {
            handle move id_result {
                __SourceFileIdResult::Fits(id) => __g1_source_map_push(
                    move value,
                    move id,
                    move name,
                    move source,
                    move end
                ),
                __SourceFileIdResult::Overflow => SourceMapAddResult::Capacity(
                    ToolkitCapacityError::IdSpaceExhausted
                )
            }
        },
        Result::Err(_) => SourceMapAddResult::Capacity(ToolkitCapacityError::CounterOverflow)
    }
}

__g1_source_map_file_count(value: &SourceMap) -> usize { Vec::len(&value.files) }

__g1_source_map_total_length(value: &SourceMap) -> usize { value.total_length }

__g1_source_map_file<'a>(value: &'a SourceMap, id: Id<SourceFileTag>) -> Option<& 'a SourceFile> {
    Vec::get(&value.files, Id::to_usize(move id))
}

__g1_source_file_name<'a>(value: &'a SourceFile) -> &'a String { &value.name }

__g1_source_file_source<'a>(value: &'a SourceFile) -> &'a String { &value.source }

__g1_source_file_start(value: &SourceFile) -> usize { value.start }

__g1_source_file_end(value: &SourceFile) -> usize { value.end }

__g1_source_line_start(starts: &Vec<usize>, index: usize) -> usize {
    __g1_array_get_copy(&starts.storage, move index)
}

__g1_source_line_count(starts: &Vec<usize>) -> usize { __g1_array_len(&starts.storage) }

__g1_source_map_line_index(starts: &Vec<usize>, offset: usize, cursor: usize, best: usize) -> usize {
    handle cursor < __g1_source_line_count(starts) {
        Result::Ok(_) => {
            let start = __g1_source_line_start(starts, cursor);
            handle start <= offset {
                Result::Ok(_) => __g1_source_map_line_index(starts, offset, cursor + 1, cursor),
                Result::Err(_) => move best
            }
        },
        Result::Err(_) => move best
    }
}

__g1_source_map_location_for(file: &SourceFile, file_index: usize, offset: usize) -> Option<
    SourceLocation
> {
    let local = __g1_vec_deque_usize_sub(offset, file.start);
    let line = __g1_source_map_line_index(&file.line_starts, local, 0, 0);
    let line_start = __g1_source_line_start(&file.line_starts, line);
    Option::Some(
        SourceLocation {
            file: Id { raw: wrapping_convert_to_u32(file_index) },
            line: move line,
            column: __g1_vec_deque_usize_sub(move local, move line_start)
        }
    )
}

__g1_source_map_file_at<'a>(value: &'a SourceMap, cursor: usize) -> &'a SourceFile {
    Vec::index(&value.files, move cursor)
}

__g1_source_map_contains_offset(value: &SourceMap, cursor: usize, offset: usize) -> Bool {
    let file = __g1_source_map_file_at(value, cursor);
    let start = file.start;
    let end = file.end;
    handle start <= offset { Result::Ok(_) => offset < end, Result::Err(_) => false }
}

__g1_source_map_location_at(value: &SourceMap, cursor: usize, offset: usize) -> Option<
    SourceLocation
> { __g1_source_map_location_for(__g1_source_map_file_at(value, cursor), cursor, offset) }

__g1_source_map_lookup_at(value: &SourceMap, offset: usize, cursor: usize, length: usize) -> Option<
    SourceLocation
