// Self-host regression: the trusted f32 comparison produces the same scalar
// `u32` identity consumed by the ordinary Bool wrapper.  Keep the manifest
// prefix in its frozen declaration order: native runtime authority is bound to
// those declaration identities, not merely to their spelling.
__g1_text_byte_len(value: Text) -> usize { () }
__g1_text_concat(left: Text, right: Text) -> Text { () }
__g1_text_eq(left: Text, right: Text) -> u32 { () }
__g1_text_from_utf8_checked(value: Bytes) -> Text { () }
__g1_text_as_bytes(value: Text) -> Bytes { () }
__g1_bytes_len(value: Bytes) -> usize { () }
__g1_bytes_concat(left: Bytes, right: Bytes) -> Bytes { () }
__g1_bytes_get(value: Bytes, index: usize) -> u8 { () }
__g1_bytes_slice(value: Bytes, start: usize, end: usize) -> Bytes { () }
__g1_bytes_from_array_move(value: Array<u8>) -> Bytes { () }
__g1_bytes_to_array(value: Bytes) -> Array<u8> { () }
__g1_bytes_utf8_valid_up_to(value: Bytes) -> usize { () }
__g1_char_from_u32_checked(value: u32) -> char { () }
__g1_char_to_u32(value: char) -> u32 { () }
__g1_abort() -> ! { () }
__g1_f32_add(left: f32, right: f32) -> f32 { () }
__g1_f32_sub(left: f32, right: f32) -> f32 { () }
__g1_f32_mul(left: f32, right: f32) -> f32 { () }
__g1_f32_div(left: f32, right: f32) -> f32 { () }
__g1_f32_rem(left: f32, right: f32) -> f32 { () }
__g1_f32_neg(value: f32) -> f32 { () }
__g1_f32_eq(left: f32, right: f32) -> u32 { () }

enum Result<T, E> { Ok(T), Err(E) }
type Option<T> = Result<T, ()>;
type Bool = Option<()>;
let true = Result::Ok(());
let false = Result::Err(());

__g1_bool_from_u32(value: u32) -> Bool { Result::Ok(()) }

f32_equal(left: f32, right: f32) -> Bool {
    __g1_bool_from_u32(__g1_f32_eq(move left, move right))
}

main() { () }
