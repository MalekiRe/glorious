// Self-host regression: contextual f32 literals lower through Core primitives,
// including a negated literal in an if branch.
choose(flag: Bool) -> f32 {
    if(flag) { 1.0 } else { -2.0 }
}
f64_boundary(flag: Bool) -> f64 {
    if(flag) { -170141183460469231731687303715884105728.0 }
    else { 340282366920938463463374607431768211456.0 }
}
fractional(flag: Bool) -> f32 {
    if(flag) { 1.25 } else { 1.25e2 }
}
// This lies just above an f32 midpoint and must parse directly at f32 width.
rounds_at_f32_width() -> f32 {
    1.00000005960464477539062582718061255302767487140869206996285356581211090087890625
}
main() -> { choose(true); f64_boundary(false); fractional(true); rounds_at_f32_width(); () }
