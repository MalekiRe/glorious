// Regression for the full-prelude route: a source Bool alias expands to the
// same `Result<(), ()>` identity inferred by contextual `if`.
enum Result<T, E> { Ok(T), Err(E) }
type Option<T> = Result<T, ()>;
type Bool = Option<()>;

if<A, E, B, F>(condition: Result<A, E>, body: F) -> Result<B, E>
where F: Fn<(), Output = B> {
    handle condition {
        Result::Ok(_) => Result::Ok(body()),
        Result::Err(error) => Result::Err(error)
    }
}

else<A, E, F>(value: Result<A, E>, fallback: F) -> A
where F: Fn<(), Output = A> {
    handle value {
        Result::Ok(result) => result,
        Result::Err(_) => fallback()
    }
}

f32_predicate(value: f32) -> Bool { Result::Ok(()) }

checked(value: f32) -> Option<u8> {
    if(f32_predicate(value)) { Result::Ok(0) }
    else { Result::Err(()) }
}

main() -> { checked(0.0); () }
