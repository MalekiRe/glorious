import Grounded.SourceExpressions

/-! Callable import resolution is the least relation generated by declarations
and visible import edges. Cycles carry existing identities; they cannot create
one. Priority depends on source bindings, not on traversal order. -/
namespace Grounded

structure NamedParameter where
  name : Identifier
  type : TypeExpr
  mutable : Bool := false

structure FunctionSyntax where
  name : Identifier
  visibility : Visibility := .private
  parameters : List NamedParameter
  result : Option TypeExpr := none
  body : NamedExpr

structure NamedFunction extends FunctionSyntax where
  home : Module

inductive FunctionImportKind where
  | explicit (sourceName localName : Identifier)
  | glob

structure FunctionImportSyntax where
  target : ModulePath
  kind : FunctionImportKind
  visibility : Visibility := .private

structure FunctionImport where
  home : Module
  target : Module
  kind : FunctionImportKind
  visibility : Visibility := .private

/-- Source import targets use the same path interpreter as source calls.
Failure is retained; an unresolved explicit import must not expose a fallback. -/
def FunctionImportSyntax.resolve (dependencies : Identifier → Option Nat) (home : Module)
    (source : FunctionImportSyntax) : Option FunctionImport :=
  (source.target.resolve dependencies home).map fun target =>
    ⟨home, target, source.kind, source.visibility⟩

def resolveFunctionImports (dependencies : Module → Identifier → Option Nat) :
    List (Module × FunctionImportSyntax) → Option (List FunctionImport)
  | [] => some []
  | (home, source) :: rest => do
      let first ← source.resolve (dependencies home) home
      let tail ← resolveFunctionImports dependencies rest
      pure (first :: tail)


theorem FunctionImportSyntax.resolve_selected {dependencies : Identifier → Option Nat} {home : Module}
    {source : FunctionImportSyntax} {edge : FunctionImport} (resolved : source.resolve dependencies home = some edge) :
    edge.home = home ∧ edge.kind = source.kind ∧ edge.visibility = source.visibility ∧
      source.target.resolve dependencies home = some edge.target := by
  obtain ⟨target, path, rfl⟩ := Option.map_eq_some_iff.mp resolved
  exact ⟨rfl, rfl, rfl, path⟩

private theorem resolveFunctionImports.cons {dependencies : Module → Identifier → Option Nat}
    {owned : Module × FunctionImportSyntax} {sources : List (Module × FunctionImportSyntax)}
    {outputs : List FunctionImport} (resolved : resolveFunctionImports dependencies (owned :: sources) = some outputs) :
    ∃ edge tail, owned.2.resolve (dependencies owned.1) owned.1 = some edge ∧
      resolveFunctionImports dependencies sources = some tail ∧ outputs = edge :: tail := by
  obtain ⟨edge, head, remaining⟩ := Option.bind_eq_some_iff.mp resolved
  obtain ⟨tail, rest, same⟩ := Option.bind_eq_some_iff.mp remaining
  exact ⟨edge, tail, head, rest, (Option.some.inj same).symm⟩

/-- Every source import survives at its original position; none is skipped. -/
theorem resolveFunctionImports.source {dependencies : Module → Identifier → Option Nat}
    {sources : List (Module × FunctionImportSyntax)} {outputs : List FunctionImport}
    (resolved : resolveFunctionImports dependencies sources = some outputs)
    {index : Nat} {owned : Module × FunctionImportSyntax} (selected : sources[index]? = some owned) :
    ∃ edge, outputs[index]? = some edge ∧ owned.2.resolve (dependencies owned.1) owned.1 = some edge := by
  induction sources generalizing outputs index with
  | nil => simp at selected
  | cons first rest ih =>
    obtain ⟨edge, tail, head, continued, rfl⟩ := resolveFunctionImports.cons resolved
    cases index with
    | zero =>
      have same := Option.some.inj selected
      subst owned
      exact ⟨edge, rfl, head⟩
    | succ index => exact ih continued selected

/-- Every resolved edge originates at the same position in the source list. -/
theorem resolveFunctionImports.origin {dependencies : Module → Identifier → Option Nat}
    {sources : List (Module × FunctionImportSyntax)} {outputs : List FunctionImport}
    (resolved : resolveFunctionImports dependencies sources = some outputs)
    {index : Nat} {edge : FunctionImport} (selected : outputs[index]? = some edge) :
    ∃ owned, sources[index]? = some owned ∧ owned.2.resolve (dependencies owned.1) owned.1 = some edge := by
  induction sources generalizing outputs index with
  | nil =>
    have same := Option.some.inj resolved
    subst outputs
    simp at selected
  | cons first rest ih =>
    obtain ⟨headEdge, tail, head, continued, rfl⟩ := resolveFunctionImports.cons resolved
    cases index with
    | zero =>
      have same := Option.some.inj selected
      subst edge
      exact ⟨first, rfl, head⟩
    | succ index => exact ih continued selected


theorem resolveFunctionImports.exists {dependencies : Module → Identifier → Option Nat}
    {sources : List (Module × FunctionImportSyntax)}
    (possible : ∀ owned ∈ sources, ∃ edge, owned.2.resolve (dependencies owned.1) owned.1 = some edge) :
    ∃ outputs, resolveFunctionImports dependencies sources = some outputs := by
  induction sources with
  | nil => exact ⟨[], rfl⟩
  | cons owned rest ih =>
    obtain ⟨edge, head⟩ := possible owned (by simp)
    obtain ⟨tail, continued⟩ := ih (fun original member => possible original (by simp [member]))
    exact ⟨edge :: tail, by simp [resolveFunctionImports, head, continued]⟩


/-- Explicit source bindings suppress weak imports even when the explicit
binding is unresolved. An invalid explicit import cannot expose a fallback. -/
def ExplicitFunctionBinding (sources : List NamedFunction) (imports : List FunctionImport)
    (home : Module) (name : Identifier) : Prop :=
  (∃ declaration ∈ sources, declaration.home = home ∧ declaration.name = name) ∨
  ∃ edge ∈ imports, edge.home = home ∧ ∃ sourceName, edge.kind = .explicit sourceName name

inductive FunctionImport.Selects (sources : List NamedFunction) (imports : List FunctionImport)
    (edge : FunctionImport) : Identifier → Identifier → Prop where
  | explicit {sourceName localName} (kind : edge.kind = .explicit sourceName localName) :
      edge.Selects sources imports localName sourceName
  | glob {name} (kind : edge.kind = .glob)
      (unshadowed : ¬ ExplicitFunctionBinding sources imports edge.home name) :
      edge.Selects sources imports name name

/-- Visibility belongs to each binding edge. The origin declaration retains
its own visibility and contract at the eventual invocation boundary. -/
inductive FunctionCandidate (sources : List NamedFunction) (imports : List FunctionImport) :
    Module → Identifier → Nat → Visibility → Prop where
  | declaration {identity declaration} (found : sources[identity]? = some declaration) :
      FunctionCandidate sources imports declaration.home declaration.name identity declaration.visibility
  | imported {edge name sourceName identity visibility}
      (member : edge ∈ imports) (selected : edge.Selects sources imports name sourceName)
      (target : FunctionCandidate sources imports edge.target sourceName identity visibility)
      (accessible : visibility.Allows edge.target edge.home) :
      FunctionCandidate sources imports edge.home name identity edge.visibility

theorem FunctionCandidate.origin {sources : List NamedFunction} {imports : List FunctionImport}
    {home : Module} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (candidate : FunctionCandidate sources imports home name identity visibility) :
    ∃ declaration, sources[identity]? = some declaration := by
  induction candidate with
  | declaration found => exact ⟨_, found⟩
  | imported _ _ _ _ ih => exact ih

/-- Leastness excludes unsupported fixed points, including self-supporting
cycles. The comparison relation is arbitrary and must satisfy exactly the
same declaration and import closure rules. -/
theorem FunctionCandidate.least {sources : List NamedFunction} {imports : List FunctionImport}
    (relation : Module → Identifier → Nat → Visibility → Prop)
    (declarations : ∀ identity declaration, sources[identity]? = some declaration →
      relation declaration.home declaration.name identity declaration.visibility)
    (steps : ∀ edge name sourceName identity visibility, edge ∈ imports →
      edge.Selects sources imports name sourceName → relation edge.target sourceName identity visibility →
      visibility.Allows edge.target edge.home → relation edge.home name identity edge.visibility)
    {home : Module} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (candidate : FunctionCandidate sources imports home name identity visibility) :
    relation home name identity visibility := by
  induction candidate with
  | declaration found => exact declarations _ _ found
  | imported member selected _ accessible ih => exact steps _ _ _ _ _ member selected ih accessible


/-- Only accessible candidates participate in lookup. Repeated routes to the
same identity are not an overload set or an ambiguity. -/
def VisibleFunctionCandidate (sources : List NamedFunction) (imports : List FunctionImport)
    (caller home : Module) (name : Identifier) (identity : Nat) : Prop :=
  ∃ visibility, FunctionCandidate sources imports home name identity visibility ∧
    visibility.Allows home caller

def FunctionResolution (sources : List NamedFunction) (imports : List FunctionImport)
    (caller home : Module) (name : Identifier) (identity : Nat) : Prop :=
  VisibleFunctionCandidate sources imports caller home name identity ∧
    ∀ other, VisibleFunctionCandidate sources imports caller home name other → other = identity

theorem FunctionResolution.unique {sources : List NamedFunction} {imports : List FunctionImport}
    {caller home : Module} {name : Identifier} {first second : Nat}
    (left : FunctionResolution sources imports caller home name first)
    (right : FunctionResolution sources imports caller home name second) : first = second :=
  right.2 first left.1

/-- Semantic selection, not an assumed import table. Both missing and ambiguous
names have no selected identity; admission distinguishes their obligations. -/
noncomputable def functionNames (sources : List NamedFunction) (imports : List FunctionImport)
    (caller home : Module) (name : Identifier) : Option Nat := by
  classical
  exact if resolved : ∃ identity, FunctionResolution sources imports caller home name identity
    then some (Classical.choose resolved) else none

theorem functionNames.selected_iff {sources : List NamedFunction} {imports : List FunctionImport}
    {caller home : Module} {name : Identifier} {identity : Nat} :
    functionNames sources imports caller home name = some identity ↔
      FunctionResolution sources imports caller home name identity := by
  classical
  unfold functionNames
  split
  next found =>
    constructor
    · intro same
      cases Option.some.inj same
      exact Classical.choose_spec found
    · intro resolved
      exact congrArg some ((Classical.choose_spec found).unique resolved)
  next missing =>
    constructor
    · intro impossible; cases impossible
    · intro resolved; exact False.elim (missing ⟨identity, resolved⟩)

theorem functionNames.selected {sources : List NamedFunction} {imports : List FunctionImport}
    {caller home : Module} {name : Identifier} {identity : Nat}
    (resolved : functionNames sources imports caller home name = some identity) :
    ∃ declaration, sources[identity]? = some declaration := by
  obtain ⟨visibility, candidate, _⟩ := (functionNames.selected_iff.mp resolved).1
  exact candidate.origin

/-- An unseeded cycle cannot resolve, whatever its length or visibility. -/
theorem functionNames.empty (imports : List FunctionImport) (caller home : Module) (name : Identifier) :
    functionNames [] imports caller home name = none := by
  cases found : functionNames [] imports caller home name with
  | none => rfl
  | some identity =>
    obtain ⟨declaration, impossible⟩ := functionNames.selected found
    simp at impossible

/-- Actual conflicting declaration identities are rejected, rather than chosen
by source order, argument types, or expected result type. -/
theorem functionNames.ambiguous {sources : List NamedFunction} {imports : List FunctionImport}
    {caller home : Module} {name : Identifier} {first second : Nat}
    (left : VisibleFunctionCandidate sources imports caller home name first)
    (right : VisibleFunctionCandidate sources imports caller home name second)
    (different : first ≠ second) : functionNames sources imports caller home name = none := by
  cases found : functionNames sources imports caller home name with
  | none => rfl
  | some identity =>
    have resolved := functionNames.selected_iff.mp found
    exact False.elim (different ((resolved.2 first left).trans (resolved.2 second right).symm))

theorem ExplicitFunctionBinding.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (home : Module) (name : Identifier) :
    ExplicitFunctionBinding sources first home name ↔ ExplicitFunctionBinding sources second home name := by
  simp only [ExplicitFunctionBinding, same]

theorem FunctionCandidate.transport_imports {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    {home : Module} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (candidate : FunctionCandidate sources first home name identity visibility) :
    FunctionCandidate sources second home name identity visibility := by
  induction candidate with
  | declaration found => exact .declaration found
  | imported member selected _ accessible ih =>
    refine .imported ((same _).mp member) ?_ ih accessible
    cases selected with
    | explicit kind => exact .explicit kind
    | glob kind unshadowed =>
      exact .glob kind (fun shadowed => unshadowed ((ExplicitFunctionBinding.imports_congr same _ _).mpr shadowed))

theorem FunctionCandidate.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (home : Module) (name : Identifier) (identity : Nat) (visibility : Visibility) :
    FunctionCandidate sources first home name identity visibility ↔
      FunctionCandidate sources second home name identity visibility :=
  ⟨FunctionCandidate.transport_imports same, FunctionCandidate.transport_imports (fun edge => (same edge).symm)⟩

theorem FunctionResolution.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (caller home : Module) (name : Identifier) (identity : Nat) :
    FunctionResolution sources first caller home name identity ↔
      FunctionResolution sources second caller home name identity := by
  simp only [FunctionResolution, VisibleFunctionCandidate, FunctionCandidate.imports_congr same]

/-- Resolution depends on the set of import edges, not their enumeration or
multiplicity. This includes both successful and ambiguous cyclic closures. -/
theorem functionNames.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (caller home : Module) (name : Identifier) :
    functionNames sources first caller home name = functionNames sources second caller home name := by
  cases left : functionNames sources first caller home name with
  | some identity =>
    exact (functionNames.selected_iff.mpr ((FunctionResolution.imports_congr same _ _ _ _).mp
      (functionNames.selected_iff.mp left))).symm
  | none =>
    cases right : functionNames sources second caller home name with
    | none => rfl
    | some identity =>
      have selected := functionNames.selected_iff.mpr ((FunctionResolution.imports_congr same _ _ _ _).mpr
        (functionNames.selected_iff.mp right))
      rw [left] at selected
      contradiction


/-- Module existence is supplied by the source closure, not guessed from the
presence of functions: an empty declared module is a valid glob target. -/
def FunctionImportsValid (modules : List Module) (sources : List NamedFunction)
    (imports : List FunctionImport) : Prop :=
  modules.Nodup ∧
  (∀ declaration ∈ sources, declaration.home ∈ modules) ∧
  (∀ edge ∈ imports, edge.home ∈ modules ∧ edge.target ∈ modules ∧
    ∀ sourceName localName, edge.kind = .explicit sourceName localName →
      ∃ identity, functionNames sources imports edge.home edge.target sourceName = some identity) ∧
  (∀ caller home, home ∈ modules → ∀ name first second,
    VisibleFunctionCandidate sources imports caller home name first →
    VisibleFunctionCandidate sources imports caller home name second → first = second)

/-- A visible declaration path in a valid namespace constructs selection.
No completed resolver result is an extra premise at this boundary. -/
theorem FunctionImportsValid.resolve_existing {modules : List Module} {sources : List NamedFunction}
    {imports : List FunctionImport} (valid : FunctionImportsValid modules sources imports)
    {caller home : Module} (included : home ∈ modules) {name : Identifier} {identity : Nat}
    (candidate : VisibleFunctionCandidate sources imports caller home name identity) :
    functionNames sources imports caller home name = some identity := by
  apply functionNames.selected_iff.mpr
  exact ⟨candidate, fun other found => valid.2.2.2 caller home included name other identity found candidate⟩


theorem FunctionImportsValid.imports_congr {modules : List Module} {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second) :
    FunctionImportsValid modules sources first ↔ FunctionImportsValid modules sources second := by
  simp only [FunctionImportsValid, same, functionNames.imports_congr same,
    VisibleFunctionCandidate, FunctionCandidate.imports_congr same]


end Grounded
