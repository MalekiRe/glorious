import Grounded.SourceExpressions

/-! Callable import resolution is the least relation generated by declarations
and visible import edges. Cycles carry existing identities; they cannot create
one. Priority depends on source bindings, not on traversal order. -/
namespace Grounded

structure NamedParameter where
  name : Identifier
  type : TypeExpr
  mutable : Bool := false

structure FunctionSyntax where
  name : Identifier
  visibility : Visibility := .private
  parameters : List NamedParameter
  result : Option TypeExpr := none
  body : NamedExpr

structure NamedFunction extends FunctionSyntax where
  home : Module

inductive FunctionImportKind where
  | explicit (sourceName localName : Identifier)
  | glob
  /-- Driver-injected lowest-priority import. -/
  | prelude

inductive ImportSelection where
  | item (kind : FunctionImportKind)
  | descend (path : List Identifier) (selection : ImportSelection)
  | group (selections : List ImportSelection)


/-- Automatic priority is driver metadata, not an authored import form. -/
inductive ImportSelection.Authored : ImportSelection → Prop where
  | explicit (sourceName localName : Identifier) : Authored (.item (.explicit sourceName localName))
  | glob : Authored (.item .glob)
  | descend {path selection} (nested : Authored selection) : Authored (.descend path selection)
  | group {selections} (members : ∀ selection ∈ selections, Authored selection) : Authored (.group selections)


structure FunctionImportSyntax where
  target : ModulePath
  selection : ImportSelection
  visibility : Visibility := .private

structure FunctionImport where
  home : Module
  target : Module
  kind : FunctionImportKind
  visibility : Visibility := .private

/-- Namespace entries retain group obligations even when no binding is emitted. -/
inductive ImportEntry where
  | namespace (home target : Module)
  | binding (edge : FunctionImport)

def ImportEntry.home : ImportEntry → Module
  | .namespace home _ => home
  | .binding edge => edge.home

def ImportEntry.target : ImportEntry → Module
  | .namespace _ target => target
  | .binding edge => edge.target

def ImportEntry.bindings : ImportEntry → List FunctionImport
  | .namespace _ _ => []
  | .binding edge => [edge]

mutual
def ImportSelection.emit (home target : Module) (visibility : Visibility) : ImportSelection → List ImportEntry
  | .item kind => [.binding ⟨home, target, kind, visibility⟩]
  | .descend path selection => .namespace home target ::
      selection.emit home ⟨target.package, target.path ++ path⟩ visibility
  | .group selections => .namespace home target :: emitImportSelections home target visibility selections
def emitImportSelections (home target : Module) (visibility : Visibility) : List ImportSelection → List ImportEntry
  | [] => []
  | first :: rest => first.emit home target visibility ++ emitImportSelections home target visibility rest
end

theorem ImportSelection.emit_root (selection : ImportSelection) (home target : Module) (visibility : Visibility) :
    ∃ entry ∈ selection.emit home target visibility, entry.home = home ∧ entry.target = target := by
  cases selection with
  | item kind => exact ⟨.binding ⟨home, target, kind, visibility⟩, by simp [ImportSelection.emit], rfl, rfl⟩
  | descend path selection => exact ⟨.namespace home target, by simp [ImportSelection.emit], rfl, rfl⟩
  | group selections => exact ⟨.namespace home target, by simp [ImportSelection.emit], rfl, rfl⟩


/-- Source rules for grouped imports: descent changes only the target namespace;
all leaves retain their declaring module and the enclosing import's visibility. -/
inductive ImportSelection.Emits (home : Module) (visibility : Visibility) :
    Module → ImportSelection → ImportEntry → Prop where
  | item {target} (kind : FunctionImportKind) :
      Emits home visibility target (.item kind) (.binding ⟨home, target, kind, visibility⟩)
  | descendRoot {target} (path : List Identifier) (selection : ImportSelection) :
      Emits home visibility target (.descend path selection) (.namespace home target)
  | descend {target path selection entry}
      (emitted : Emits home visibility ⟨target.package, target.path ++ path⟩ selection entry) :
      Emits home visibility target (.descend path selection) entry
  | groupRoot {target} (selections : List ImportSelection) :
      Emits home visibility target (.group selections) (.namespace home target)
  | group {target selections selection entry} (member : selection ∈ selections)
      (emitted : Emits home visibility target selection entry) :
      Emits home visibility target (.group selections) entry

/-- Descents and groups cannot manufacture automatic-priority bindings. -/
theorem ImportSelection.Authored.emitted_kind {selection : ImportSelection}
    (authored : selection.Authored) {home target : Module} {visibility : Visibility} {edge : FunctionImport}
    (emitted : ImportSelection.Emits home visibility target selection (.binding edge)) :
    edge.kind ≠ .prelude := by
  induction authored generalizing home target visibility edge with
  | explicit sourceName localName => cases emitted; simp
  | glob => cases emitted; simp
  | descend nested ih =>
    cases emitted with
    | descend emitted => exact ih emitted
  | group members ih =>
    cases emitted with
    | group member emitted => exact ih _ member emitted


mutual
theorem ImportSelection.emit_sound (selection : ImportSelection) (home target : Module) (visibility : Visibility)
    (entry : ImportEntry) (member : entry ∈ selection.emit home target visibility) :
    ImportSelection.Emits home visibility target selection entry := by
  cases selection with
  | item kind =>
    have same := List.mem_singleton.mp member
    cases same
    exact .item kind
  | descend path selection =>
    rcases List.mem_cons.mp member with rfl | member
    · exact .descendRoot path selection
    · exact .descend (selection.emit_sound home _ visibility entry member)
  | group selections =>
    rcases List.mem_cons.mp member with rfl | member
    · exact .groupRoot selections
    · obtain ⟨selection, included, emitted⟩ := emitImportSelections.sound selections home target visibility entry member
      exact .group included emitted
theorem emitImportSelections.sound (selections : List ImportSelection) (home target : Module) (visibility : Visibility)
    (entry : ImportEntry) (member : entry ∈ emitImportSelections home target visibility selections) :
    ∃ selection ∈ selections, ImportSelection.Emits home visibility target selection entry := by
  cases selections with
  | nil => simp [emitImportSelections] at member
  | cons first rest =>
    rcases List.mem_append.mp member with head | tail
    · exact ⟨first, by simp, first.emit_sound home target visibility entry head⟩
    · obtain ⟨selection, included, emitted⟩ := emitImportSelections.sound rest home target visibility entry tail
      exact ⟨selection, by simp [included], emitted⟩
end

theorem emitImportSelections.member {selections : List ImportSelection} {selection : ImportSelection}
    {home target : Module} {visibility : Visibility} {entry : ImportEntry}
    (included : selection ∈ selections) (member : entry ∈ selection.emit home target visibility) :
    entry ∈ emitImportSelections home target visibility selections := by
  induction selections with
  | nil => cases included
  | cons first rest ih =>
    rcases List.mem_cons.mp included with rfl | included
    · exact List.mem_append.mpr (.inl member)
    · exact List.mem_append.mpr (.inr (ih included))

theorem ImportSelection.Emits.complete {home target : Module} {visibility : Visibility}
    {selection : ImportSelection} {entry : ImportEntry} (emitted : Emits home visibility target selection entry) :
    entry ∈ selection.emit home target visibility := by
  induction emitted with
  | item => simp [ImportSelection.emit]
  | descendRoot => simp [ImportSelection.emit]
  | descend _ ih => exact List.mem_cons_of_mem _ ih
  | groupRoot => simp [ImportSelection.emit]
  | group member _ ih => exact List.mem_cons_of_mem _ (emitImportSelections.member member ih)

theorem ImportSelection.Emits.home {home target : Module} {visibility : Visibility}
    {selection : ImportSelection} {entry : ImportEntry} (emitted : Emits home visibility target selection entry) :
    entry.home = home := by
  induction emitted with
  | item => rfl
  | descendRoot => rfl
  | descend _ ih => exact ih
  | groupRoot => rfl
  | group _ _ ih => exact ih

theorem ImportSelection.Emits.visibility {home target : Module} {visibility : Visibility}
    {selection : ImportSelection} {entry : ImportEntry} (emitted : Emits home visibility target selection entry) :
    match (generalizing := false) entry with
    | .namespace _ _ => True
    | .binding edge => edge.visibility = visibility := by
  induction emitted with
  | item => rfl
  | descendRoot => trivial
  | descend _ ih => exact ih
  | groupRoot => trivial
  | group _ _ ih => exact ih


/-- Source import targets use the same path interpreter as source calls.
Failure is retained; an unresolved explicit import must not expose a fallback. -/
def FunctionImportSyntax.resolve (dependencies : Identifier → Option Nat) (home : Module)
    (source : FunctionImportSyntax) : Option (List ImportEntry) :=
  (source.target.resolve dependencies home).map fun target =>
    source.selection.emit home target source.visibility

def resolveFunctionImports (dependencies : Module → Identifier → Option Nat) :
    List (Module × FunctionImportSyntax) → Option (List (List ImportEntry))
  | [] => some []
  | (home, source) :: rest => do
      let first ← source.resolve (dependencies home) home
      let tail ← resolveFunctionImports dependencies rest
      pure (first :: tail)


theorem FunctionImportSyntax.resolve_selected {dependencies : Identifier → Option Nat} {home : Module}
    {source : FunctionImportSyntax} {entries : List ImportEntry} (resolved : source.resolve dependencies home = some entries) :
    ∃ target, source.target.resolve dependencies home = some target ∧
      entries = source.selection.emit home target source.visibility := by
  obtain ⟨target, path, rfl⟩ := Option.map_eq_some_iff.mp resolved
  exact ⟨target, path, rfl⟩

private theorem resolveFunctionImports.cons {dependencies : Module → Identifier → Option Nat}
    {owned : Module × FunctionImportSyntax} {sources : List (Module × FunctionImportSyntax)}
    {outputs : List (List ImportEntry)} (resolved : resolveFunctionImports dependencies (owned :: sources) = some outputs) :
    ∃ edge tail, owned.2.resolve (dependencies owned.1) owned.1 = some edge ∧
      resolveFunctionImports dependencies sources = some tail ∧ outputs = edge :: tail := by
  obtain ⟨edge, head, remaining⟩ := Option.bind_eq_some_iff.mp resolved
  obtain ⟨tail, rest, same⟩ := Option.bind_eq_some_iff.mp remaining
  exact ⟨edge, tail, head, rest, (Option.some.inj same).symm⟩

/-- Every source import survives at its original position; none is skipped. -/
theorem resolveFunctionImports.source {dependencies : Module → Identifier → Option Nat}
    {sources : List (Module × FunctionImportSyntax)} {outputs : List (List ImportEntry)}
    (resolved : resolveFunctionImports dependencies sources = some outputs)
    {index : Nat} {owned : Module × FunctionImportSyntax} (selected : sources[index]? = some owned) :
    ∃ edge, outputs[index]? = some edge ∧ owned.2.resolve (dependencies owned.1) owned.1 = some edge := by
  induction sources generalizing outputs index with
  | nil => simp at selected
  | cons first rest ih =>
    obtain ⟨edge, tail, head, continued, rfl⟩ := resolveFunctionImports.cons resolved
    cases index with
    | zero =>
      have same := Option.some.inj selected
      subst owned
      exact ⟨edge, rfl, head⟩
    | succ index => exact ih continued selected

/-- Every resolved import batch originates at the same position in the source list. -/
theorem resolveFunctionImports.origin {dependencies : Module → Identifier → Option Nat}
    {sources : List (Module × FunctionImportSyntax)} {outputs : List (List ImportEntry)}
    (resolved : resolveFunctionImports dependencies sources = some outputs)
    {index : Nat} {edge : List ImportEntry} (selected : outputs[index]? = some edge) :
    ∃ owned, sources[index]? = some owned ∧ owned.2.resolve (dependencies owned.1) owned.1 = some edge := by
  induction sources generalizing outputs index with
  | nil =>
    have same := Option.some.inj resolved
    subst outputs
    simp at selected
  | cons first rest ih =>
    obtain ⟨headEdge, tail, head, continued, rfl⟩ := resolveFunctionImports.cons resolved
    cases index with
    | zero =>
      have same := Option.some.inj selected
      subst edge
      exact ⟨first, rfl, head⟩
    | succ index => exact ih continued selected


theorem resolveFunctionImports.exists {dependencies : Module → Identifier → Option Nat}
    {sources : List (Module × FunctionImportSyntax)}
    (possible : ∀ owned ∈ sources, ∃ edge, owned.2.resolve (dependencies owned.1) owned.1 = some edge) :
    ∃ outputs, resolveFunctionImports dependencies sources = some outputs := by
  induction sources with
  | nil => exact ⟨[], rfl⟩
  | cons owned rest ih =>
    obtain ⟨edge, head⟩ := possible owned (by simp)
    obtain ⟨tail, continued⟩ := ih (fun original member => possible original (by simp [member]))
    exact ⟨edge :: tail, by simp [resolveFunctionImports, head, continued]⟩


/-- Explicit source bindings suppress weak imports even when the explicit
binding is unresolved. An invalid explicit import cannot expose a fallback. -/
def ExplicitFunctionBinding (sources : List NamedFunction) (imports : List FunctionImport)
    (home : Module) (name : Identifier) : Prop :=
  (∃ declaration ∈ sources, declaration.home = home ∧ declaration.name = name) ∨
  ∃ edge ∈ imports, edge.home = home ∧ ∃ sourceName, edge.kind = .explicit sourceName name

/-- One declaration-seeded path producer, parameterized by admissible import
edges. Discovery and priority selection share this relation. -/
inductive FunctionProvenance (sources : List NamedFunction) (imports : List FunctionImport)
    (selects : FunctionImport → Identifier → Identifier → Prop) :
    Module → Identifier → Nat → Visibility → Prop where
  | declaration {identity declaration} (found : sources[identity]? = some declaration) :
      FunctionProvenance sources imports selects declaration.home declaration.name identity declaration.visibility
  | imported {edge name sourceName identity visibility}
      (member : edge ∈ imports) (selected : selects edge name sourceName)
      (target : FunctionProvenance sources imports selects edge.target sourceName identity visibility)
      (accessible : visibility.Allows edge.target edge.home) :
      FunctionProvenance sources imports selects edge.home name identity edge.visibility

/-- Discovery retains all declared import routes before priority filtering. -/
inductive FunctionImport.Routes (edge : FunctionImport) : Identifier → Identifier → Prop where
  | explicit {sourceName localName} (kind : edge.kind = .explicit sourceName localName) :
      edge.Routes localName sourceName
  | glob {name} (kind : edge.kind = .glob) : edge.Routes name name
  | prelude {name} (kind : edge.kind = .prelude) : edge.Routes name name

abbrev RawFunctionCandidate (sources : List NamedFunction) (imports : List FunctionImport) :=
  FunctionProvenance sources imports FunctionImport.Routes

/-- An authored glob claims only names backed by an accessible finite path.
The mere presence of an unrelated or empty glob never suppresses a prelude. -/
def GlobFunctionBinding (sources : List NamedFunction) (imports : List FunctionImport)
    (home : Module) (name : Identifier) : Prop :=
  ∃ edge ∈ imports, edge.home = home ∧ edge.kind = .glob ∧
    ∃ identity visibility, RawFunctionCandidate sources imports edge.target name identity visibility ∧
      visibility.Allows edge.target edge.home

theorem RawFunctionCandidate.transport_imports {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    {home : Module} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (candidate : RawFunctionCandidate sources first home name identity visibility) :
    RawFunctionCandidate sources second home name identity visibility := by
  induction candidate with
  | declaration found => exact .declaration found
  | imported member selected _ accessible ih => exact .imported ((same _).mp member) selected ih accessible

theorem RawFunctionCandidate.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (home : Module) (name : Identifier) (identity : Nat) (visibility : Visibility) :
    RawFunctionCandidate sources first home name identity visibility ↔
      RawFunctionCandidate sources second home name identity visibility :=
  ⟨RawFunctionCandidate.transport_imports same, RawFunctionCandidate.transport_imports (fun edge => (same edge).symm)⟩

theorem GlobFunctionBinding.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (home : Module) (name : Identifier) :
    GlobFunctionBinding sources first home name ↔ GlobFunctionBinding sources second home name := by
  simp only [GlobFunctionBinding, same, RawFunctionCandidate.imports_congr same]

inductive FunctionImport.Selects (sources : List NamedFunction) (imports : List FunctionImport)
    (edge : FunctionImport) : Identifier → Identifier → Prop where
  | explicit {sourceName localName} (kind : edge.kind = .explicit sourceName localName) :
      edge.Selects sources imports localName sourceName
  | glob {name} (kind : edge.kind = .glob)
      (unshadowed : ¬ ExplicitFunctionBinding sources imports edge.home name) :
      edge.Selects sources imports name name
  | prelude {name} (kind : edge.kind = .prelude)
      (unshadowed : ¬ ExplicitFunctionBinding sources imports edge.home name)
      (noGlob : ¬ GlobFunctionBinding sources imports edge.home name) :
      edge.Selects sources imports name name

/-- Selection filters each hop of the same finite path relation. -/
abbrev FunctionCandidate (sources : List NamedFunction) (imports : List FunctionImport) :=
  FunctionProvenance sources imports (FunctionImport.Selects sources imports)

theorem FunctionCandidate.raw {sources : List NamedFunction} {imports : List FunctionImport}
    {home : Module} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (candidate : FunctionCandidate sources imports home name identity visibility) :
    RawFunctionCandidate sources imports home name identity visibility := by
  induction candidate with
  | declaration found => exact .declaration found
  | imported member selected _ accessible ih =>
    apply FunctionProvenance.imported member _ ih accessible
    cases selected with
    | explicit kind => exact .explicit kind
    | glob kind _ => exact .glob kind
    | prelude kind _ _ => exact .prelude kind


theorem FunctionCandidate.origin {sources : List NamedFunction} {imports : List FunctionImport}
    {home : Module} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (candidate : FunctionCandidate sources imports home name identity visibility) :
    ∃ declaration, sources[identity]? = some declaration := by
  induction candidate with
  | declaration found => exact ⟨_, found⟩
  | imported _ _ _ _ ih => exact ih

/-- Leastness excludes unsupported fixed points, including self-supporting
cycles. The comparison relation is arbitrary and must satisfy exactly the
same declaration and import closure rules. -/
theorem FunctionCandidate.least {sources : List NamedFunction} {imports : List FunctionImport}
    (relation : Module → Identifier → Nat → Visibility → Prop)
    (declarations : ∀ identity declaration, sources[identity]? = some declaration →
      relation declaration.home declaration.name identity declaration.visibility)
    (steps : ∀ edge name sourceName identity visibility, edge ∈ imports →
      edge.Selects sources imports name sourceName → relation edge.target sourceName identity visibility →
      visibility.Allows edge.target edge.home → relation edge.home name identity edge.visibility)
    {home : Module} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (candidate : FunctionCandidate sources imports home name identity visibility) :
    relation home name identity visibility := by
  induction candidate with
  | declaration found => exact declarations _ _ found
  | imported member selected _ accessible ih => exact steps _ _ _ _ _ member selected ih accessible


/-- Only accessible candidates participate in lookup. Repeated routes to the
same identity are not an overload set or an ambiguity. -/
def VisibleFunctionCandidate (sources : List NamedFunction) (imports : List FunctionImport)
    (caller home : Module) (name : Identifier) (identity : Nat) : Prop :=
  ∃ visibility, FunctionCandidate sources imports home name identity visibility ∧
    visibility.Allows home caller

def FunctionResolution (sources : List NamedFunction) (imports : List FunctionImport)
    (caller home : Module) (name : Identifier) (identity : Nat) : Prop :=
  VisibleFunctionCandidate sources imports caller home name identity ∧
    ∀ other, VisibleFunctionCandidate sources imports caller home name other → other = identity

theorem FunctionResolution.unique {sources : List NamedFunction} {imports : List FunctionImport}
    {caller home : Module} {name : Identifier} {first second : Nat}
    (left : FunctionResolution sources imports caller home name first)
    (right : FunctionResolution sources imports caller home name second) : first = second :=
  right.2 first left.1

/-- Semantic selection, not an assumed import table. Both missing and ambiguous
names have no selected identity; admission distinguishes their obligations. -/
noncomputable def functionNames (sources : List NamedFunction) (imports : List FunctionImport)
    (caller home : Module) (name : Identifier) : Option Nat := by
  classical
  exact if resolved : ∃ identity, FunctionResolution sources imports caller home name identity
    then some (Classical.choose resolved) else none

theorem functionNames.selected_iff {sources : List NamedFunction} {imports : List FunctionImport}
    {caller home : Module} {name : Identifier} {identity : Nat} :
    functionNames sources imports caller home name = some identity ↔
      FunctionResolution sources imports caller home name identity := by
  classical
  unfold functionNames
  split
  next found =>
    constructor
    · intro same
      cases Option.some.inj same
      exact Classical.choose_spec found
    · intro resolved
      exact congrArg some ((Classical.choose_spec found).unique resolved)
  next missing =>
    constructor
    · intro impossible; cases impossible
    · intro resolved; exact False.elim (missing ⟨identity, resolved⟩)

theorem functionNames.selected {sources : List NamedFunction} {imports : List FunctionImport}
    {caller home : Module} {name : Identifier} {identity : Nat}
    (resolved : functionNames sources imports caller home name = some identity) :
    ∃ declaration, sources[identity]? = some declaration := by
  obtain ⟨visibility, candidate, _⟩ := (functionNames.selected_iff.mp resolved).1
  exact candidate.origin

/-- An unseeded cycle cannot resolve, whatever its length or visibility. -/
theorem functionNames.empty (imports : List FunctionImport) (caller home : Module) (name : Identifier) :
    functionNames [] imports caller home name = none := by
  cases found : functionNames [] imports caller home name with
  | none => rfl
  | some identity =>
    obtain ⟨declaration, impossible⟩ := functionNames.selected found
    simp at impossible

/-- Actual conflicting declaration identities are rejected, rather than chosen
by source order, argument types, or expected result type. -/
theorem functionNames.ambiguous {sources : List NamedFunction} {imports : List FunctionImport}
    {caller home : Module} {name : Identifier} {first second : Nat}
    (left : VisibleFunctionCandidate sources imports caller home name first)
    (right : VisibleFunctionCandidate sources imports caller home name second)
    (different : first ≠ second) : functionNames sources imports caller home name = none := by
  cases found : functionNames sources imports caller home name with
  | none => rfl
  | some identity =>
    have resolved := functionNames.selected_iff.mp found
    exact False.elim (different ((resolved.2 first left).trans (resolved.2 second right).symm))

theorem ExplicitFunctionBinding.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (home : Module) (name : Identifier) :
    ExplicitFunctionBinding sources first home name ↔ ExplicitFunctionBinding sources second home name := by
  simp only [ExplicitFunctionBinding, same]

theorem FunctionCandidate.transport_imports {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    {home : Module} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (candidate : FunctionCandidate sources first home name identity visibility) :
    FunctionCandidate sources second home name identity visibility := by
  induction candidate with
  | declaration found => exact .declaration found
  | imported member selected _ accessible ih =>
    refine .imported ((same _).mp member) ?_ ih accessible
    cases selected with
    | explicit kind => exact .explicit kind
    | glob kind unshadowed =>
      exact .glob kind (fun shadowed => unshadowed ((ExplicitFunctionBinding.imports_congr same _ _).mpr shadowed))
    | prelude kind unshadowed noGlob =>
      exact .prelude kind
        (fun shadowed => unshadowed ((ExplicitFunctionBinding.imports_congr same _ _).mpr shadowed))
        (fun shadowed => noGlob ((GlobFunctionBinding.imports_congr same _ _).mpr shadowed))

theorem FunctionCandidate.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (home : Module) (name : Identifier) (identity : Nat) (visibility : Visibility) :
    FunctionCandidate sources first home name identity visibility ↔
      FunctionCandidate sources second home name identity visibility :=
  ⟨FunctionCandidate.transport_imports same, FunctionCandidate.transport_imports (fun edge => (same edge).symm)⟩

theorem FunctionResolution.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (caller home : Module) (name : Identifier) (identity : Nat) :
    FunctionResolution sources first caller home name identity ↔
      FunctionResolution sources second caller home name identity := by
  simp only [FunctionResolution, VisibleFunctionCandidate, FunctionCandidate.imports_congr same]

/-- Resolution depends on the set of import edges, not their enumeration or
multiplicity. This includes both successful and ambiguous cyclic closures. -/
theorem functionNames.imports_congr {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second)
    (caller home : Module) (name : Identifier) :
    functionNames sources first caller home name = functionNames sources second caller home name := by
  cases left : functionNames sources first caller home name with
  | some identity =>
    exact (functionNames.selected_iff.mpr ((FunctionResolution.imports_congr same _ _ _ _).mp
      (functionNames.selected_iff.mp left))).symm
  | none =>
    cases right : functionNames sources second caller home name with
    | none => rfl
    | some identity =>
      have selected := functionNames.selected_iff.mpr ((FunctionResolution.imports_congr same _ _ _ _).mpr
        (functionNames.selected_iff.mp right))
      rw [left] at selected
      contradiction


/-- Module existence is supplied by the source closure, not guessed from the
presence of functions: an empty declared module is a valid glob target. Explicit
imports check both their target binding and the original declaration's privacy,
including unused imports through arbitrarily many aliases and re-exports. -/
def FunctionImportsValid (modules : List Module) (sources : List NamedFunction)
    (imports : List FunctionImport) : Prop :=
  modules.Nodup ∧
  (∀ declaration ∈ sources, declaration.home ∈ modules) ∧
  (∀ edge ∈ imports, edge.home ∈ modules ∧ edge.target ∈ modules ∧
    ∀ sourceName localName, edge.kind = .explicit sourceName localName →
      ∃ identity, VisibleFunctionCandidate sources imports edge.home edge.target sourceName identity ∧
        ∃ declaration, sources[identity]? = some declaration ∧
          declaration.visibility.Allows declaration.home edge.home) ∧
  (∀ caller home, home ∈ modules → ∀ name first second,
    VisibleFunctionCandidate sources imports caller home name first →
    VisibleFunctionCandidate sources imports caller home name second → first = second)

/-- A visible declaration path in a valid namespace constructs selection.
No completed resolver result is an extra premise at this boundary. -/
theorem FunctionImportsValid.resolve_existing {modules : List Module} {sources : List NamedFunction}
    {imports : List FunctionImport} (valid : FunctionImportsValid modules sources imports)
    {caller home : Module} (included : home ∈ modules) {name : Identifier} {identity : Nat}
    (candidate : VisibleFunctionCandidate sources imports caller home name identity) :
    functionNames sources imports caller home name = some identity := by
  apply functionNames.selected_iff.mpr
  exact ⟨candidate, fun other found => valid.2.2.2 caller home included name other identity found candidate⟩


/-- Explicit bindings are constructed from finite, declaration-seeded provenance.
The input contract does not contain a completed resolver result. -/
theorem FunctionImportsValid.explicit_binding {modules : List Module} {sources : List NamedFunction}
    {imports : List FunctionImport} (valid : FunctionImportsValid modules sources imports)
    {edge : FunctionImport} (member : edge ∈ imports) {sourceName localName : Identifier}
    (kind : edge.kind = .explicit sourceName localName) :
    ∃ identity, FunctionCandidate sources imports edge.home localName identity edge.visibility ∧
      ∃ declaration, sources[identity]? = some declaration ∧
        declaration.visibility.Allows declaration.home edge.home := by
  obtain ⟨identity, ⟨visibility, candidate, accessible⟩, declaration, found, authorized⟩ :=
    (valid.2.2.1 edge member).2.2 sourceName localName kind
  exact ⟨identity, .imported member (.explicit kind) candidate accessible, declaration, found, authorized⟩


theorem FunctionImportsValid.imports_congr {modules : List Module} {sources : List NamedFunction}
    {first second : List FunctionImport} (same : ∀ edge, edge ∈ first ↔ edge ∈ second) :
    FunctionImportsValid modules sources first ↔ FunctionImportsValid modules sources second := by
  simp only [FunctionImportsValid, same,
    VisibleFunctionCandidate, FunctionCandidate.imports_congr same]


/-- An alias cannot launder declaration privacy at an explicit import. The
candidate may have any finite re-export provenance; uniqueness identifies it
with the declaration authorized by the actual import admission rule. -/
theorem FunctionImportsValid.explicit_origin {modules : List Module} {sources : List NamedFunction}
    {imports : List FunctionImport} (valid : FunctionImportsValid modules sources imports)
    {edge : FunctionImport} (member : edge ∈ imports) {sourceName localName : Identifier}
    (kind : edge.kind = .explicit sourceName localName) {identity : Nat}
    (candidate : VisibleFunctionCandidate sources imports edge.home edge.target sourceName identity)
    {declaration : NamedFunction} (declared : sources[identity]? = some declaration) :
    declaration.visibility.Allows declaration.home edge.home := by
  obtain ⟨other, selected, origin, found, authorized⟩ :=
    (valid.2.2.1 edge member).2.2 sourceName localName kind
  have same := valid.2.2.2 edge.home edge.target (valid.2.2.1 edge member).2.1
    sourceName identity other candidate selected
  subst other
  cases Option.some.inj (found.symm.trans declared)
  exact authorized


/-- A real authored-glob candidate excludes direct automatic-prelude selection
for that name, irrespective of the prelude's declaration identity. -/
theorem FunctionImport.Selects.prelude_excluded {sources : List NamedFunction} {imports : List FunctionImport}
    {ordinary automatic : FunctionImport} {name : Identifier} {identity : Nat} {visibility : Visibility}
    (member : ordinary ∈ imports) (kind : ordinary.kind = .glob)
    (sameHome : ordinary.home = automatic.home) (automaticKind : automatic.kind = .prelude)
    (target : FunctionCandidate sources imports ordinary.target name identity visibility)
    (accessible : visibility.Allows ordinary.target ordinary.home) :
    ¬ automatic.Selects sources imports name name := by
  intro selected
  cases selected with
  | explicit selectedKind => simp [automaticKind] at selectedKind
  | glob selectedKind _ => simp [automaticKind] at selectedKind
  | prelude _ _ noGlob =>
    exact noGlob ⟨ordinary, member, sameHome, kind, identity, visibility, target.raw, accessible⟩

/-- With one authored incoming glob, any number of automatic prelude edges
cannot make its uniquely resolved target ambiguous. No successful local lookup
or global uniqueness premise is supplied. Other modules may have arbitrary
imports, including finite re-export paths and cycles. -/
theorem functionNames.glob_over_prelude {sources : List NamedFunction} {imports : List FunctionImport}
    {home : Module} {ordinary : FunctionImport} {name : Identifier} {identity : Nat}
    (member : ordinary ∈ imports) (owned : ordinary.home = home) (kind : ordinary.kind = .glob)
    (localAccess : ordinary.visibility.Allows home home)
    (unshadowed : ¬ ExplicitFunctionBinding sources imports home name)
    (targetResolved : FunctionResolution sources imports home ordinary.target name identity)
    (incoming : ∀ edge ∈ imports, edge.home = home → edge = ordinary ∨ edge.kind = .prelude) :
    functionNames sources imports home home name = some identity := by
  obtain ⟨visibility, target, accessible⟩ := targetResolved.1
  have access : visibility.Allows ordinary.target ordinary.home := by simpa only [owned] using accessible
  have noExplicit : ¬ ExplicitFunctionBinding sources imports ordinary.home name := by
    simpa only [owned] using unshadowed
  have candidate : FunctionCandidate sources imports home name identity ordinary.visibility := by
    simpa only [owned] using FunctionProvenance.imported member (.glob kind noExplicit) target access
  apply functionNames.selected_iff.mpr
  refine ⟨⟨ordinary.visibility, candidate, localAccess⟩, ?_⟩
  intro other observed
  obtain ⟨otherVisibility, otherCandidate, _⟩ := observed
  cases otherCandidate with
  | declaration found =>
    exact False.elim (unshadowed (.inl ⟨_, List.mem_of_getElem? found, rfl, rfl⟩))
  | @imported edge localName sourceName other visibility memberOther selected original accessibleOther =>
    rcases incoming edge memberOther rfl with same | automatic
    · subst edge
      cases selected with
      | explicit selectedKind => simp [kind] at selectedKind
      | prelude selectedKind _ _ => simp [kind] at selectedKind
      | glob _ _ => exact targetResolved.2 other ⟨visibility, original, accessibleOther⟩
    · have blocked := FunctionImport.Selects.prelude_excluded member kind owned automatic target access
      cases selected with
      | explicit selectedKind => simp [automatic] at selectedKind
      | glob selectedKind _ => simp [automatic] at selectedKind
      | prelude selectedKind noExplicit noGlob => exact False.elim (blocked (.prelude selectedKind noExplicit noGlob))


end Grounded
