      (projection : ProjectionStep program home middle after held parent key result)
      (evidence : ResultEvidence program middle after result) :
      HasType program phase home before held (.field body key) result after (.unary plan) none
  | call {phase : Phase} {home : Module} {before middle hidden prepared bodyAfter cleaned after : Point program phase}
