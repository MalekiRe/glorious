      {expression : Expr} {result : Result phase} {plan : CorePlan}
      (typed : HasType program phase home before held expression result after plan none)
      (atomic : ExpectedAtom expression) (notReference : NotReference result.type) :
      HasType program phase home before held expression result after plan (some result.type)
inductive HasTypes (program : Program) : (phase : Phase) → Module → Point program phase →
    List (Payload phase) → List Expr → List (Result phase) → Point program phase → List CorePlan → Option (List Ty) → Type where
  | nil {phase : Phase} {home : Module} {before : Point program phase} {held : List (Payload phase)} :
      HasTypes program phase home before held [] [] before [] none
  | cons {phase : Phase} {home : Module} {before middle after : Point program phase} {held : List (Payload phase)}
      {head : Expr} {tail : List Expr} {first : Result phase} {rest : List (Result phase)} {headPlan : CorePlan} {tailPlans : List CorePlan}
      (firstTyped : HasType program phase home before held head first middle headPlan none)
      (restTyped : HasTypes program phase home middle (held ++ [first.payload]) tail rest after tailPlans none) :
      HasTypes program phase home before held (head :: tail) (first :: rest) after (headPlan :: tailPlans) none
  | expectedNil {phase : Phase} {home : Module} {before : Point program phase} {held : List (Payload phase)} :
      HasTypes program phase home before held [] [] before [] (some [])
  | expectedCons {phase : Phase} {home : Module} {before middle after : Point program phase} {held : List (Payload phase)}
      {head : Expr} {tail : List Expr} {first : Result phase} {rest : List (Result phase)} {headPlan : CorePlan} {tailPlans : List CorePlan} {types : List Ty}
      (firstTyped : HasType program phase home before held head first middle headPlan (some first.type))
      (restTyped : HasTypes program phase home middle (held ++ [first.payload]) tail rest after tailPlans (some types)) :
      HasTypes program phase home before held (head :: tail) (first :: rest) after (headPlan :: tailPlans) (some (first.type :: types))
inductive ArmsType (program : Program) : (phase : Phase) → Module → Point program phase →
    List (Payload phase) → Result phase → Result phase → List Pattern → List (Pattern × Core) →
      Point program phase → Option Ty → Type where
  | empty {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {subject result : Result phase} {previous : List Pattern} {expected : Option Ty} :
      ArmsType program phase home before held subject result previous [] after expected
  | dormant {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {subject result : Result phase} {previous : List Pattern} {pattern : Pattern} {body : Core}
      {rest : List (Pattern × Core)} {expected : Option Ty}
      {patternAfter bodyAfter cleaned : Point program .checking}
      {bindings : List (String × Result .checking)} {hypotheticalResult : Result .checking}
      (patternTyped : PatternProduces program home .checking (held.map Payload.erase)
        (declareInput (program := program) before.checked subject.type).1 pattern
        (declareInput (program := program) before.checked subject.type).2 bindings patternAfter)
      (impossible : patternTyped.ImpossibleAgainst subject.payload.checked)
      (interpreted : subject.Interpreted before)
      (useful : Useful program subject.type previous pattern)
      (bodyTyped : HasType program .checking home (patternBodyPoint patternAfter bindings)
        (held.map Payload.erase) body.source hypotheticalResult bodyAfter body.plan expected)
      (resultType : hypotheticalResult.type = result.type)
      (cleanup : CleanupStep program bodyAfter cleaned (held.map Payload.erase ++ [hypotheticalResult.payload]) bindings.length)
      (tailTyped : ArmsType program phase home before held subject result (previous ++ [pattern]) rest after expected) :
      ArmsType program phase home before held subject result previous ((pattern, body) :: rest) after expected
  | clause {phase : Phase} {home : Module} {before patternAfter prepared bodyAfter cleaned after : Point program phase}
      {held : List (Payload phase)} {subject result : Result phase} {previous : List Pattern}
      {pattern : Pattern} {body : Core} {rest : List (Pattern × Core)} {bindings : List (String × Result phase)} {expected : Option Ty}
      (patternTyped : PatternProduces program home phase held before pattern subject bindings patternAfter)
      (distinct : (bindings.map Prod.fst).Nodup)
      (useful : Useful program subject.type previous pattern)
      (prepare : PrepareStep program patternAfter prepared
        (bindings.map fun entry => (entry.1, ⟨entry.2.type, false, .full⟩)) (bindings.map Prod.snd))
      (bodyTyped : HasType program phase home prepared held body.source result bodyAfter body.plan expected)
      (cleanup : CleanupStep program bodyAfter cleaned (held ++ [result.payload]) bindings.length)
      (stable : PointsStable bodyAfter cleaned)
      (joined : JoinStep program cleaned after)
      (tailTyped : ArmsType program phase home before held subject result (previous ++ [pattern]) rest after expected) :
      ArmsType program phase home before held subject result previous ((pattern, body) :: rest) after expected
inductive PatternConstantsTyped (program : Program) : (phase : Phase) → Module → PatternSource → PatternPlan → Type where
  | wildcard {phase : Phase} {home : Module} : PatternConstantsTyped program phase home .wildcard .leaf
  | binder {phase : Phase} {home : Module} (name : String) : PatternConstantsTyped program phase home (.binder name) .leaf
  | node {phase : Phase} {home : Module} {head : Head} {fields : List PatternSource} {plans : List PatternPlan}
      (source : head.Source) (constants : PatternsConstantsTyped program phase home fields plans) :
      PatternConstantsTyped program phase home (.node head fields) (.node plans)
  | constant {phase : Phase} {home : Module} {before after : Point program phase}
      {name : String} {result : Result phase} {plan : CorePlan}
      (beforeEmpty : before.checked = .empty)
      (actualEmpty : Required phase fun executable => before.source executable = .empty ∧ after.source executable = .empty)
      (typed : HasType program phase home before [] (.constant name) result after plan none) :
      PatternConstantsTyped program phase home (.constant name) (.constant plan)
inductive PatternsConstantsTyped (program : Program) : (phase : Phase) → Module → List PatternSource → List PatternPlan → Type where
  | nil {phase : Phase} {home : Module} : PatternsConstantsTyped program phase home [] []
  | cons {phase : Phase} {home : Module} {first : PatternSource} {rest : List PatternSource} {plan : PatternPlan} {plans : List PatternPlan}
      (head : PatternConstantsTyped program phase home first plan)
      (tail : PatternsConstantsTyped program phase home rest plans) :
      PatternsConstantsTyped program phase home (first :: rest) (plan :: plans)
inductive ArmConstantsTyped (program : Program) : (phase : Phase) → Module → List (PatternSource × Expr) → List (PatternPlan × CorePlan) → Type where
  | nil {phase : Phase} {home : Module} : ArmConstantsTyped program phase home [] []
  | cons {phase : Phase} {home : Module} {pattern : PatternSource} {body : Expr} {rest : List (PatternSource × Expr)}
      {patternPlan : PatternPlan} {bodyPlan : CorePlan} {plans : List (PatternPlan × CorePlan)}
      (head : PatternConstantsTyped program phase home pattern patternPlan)
      (tail : ArmConstantsTyped program phase home rest plans) :
      ArmConstantsTyped program phase home ((pattern, body) :: rest) ((patternPlan, bodyPlan) :: plans)
end

end Grounded.Elaboration

/- Section: ElaborationCheckedNormalization -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {home : Module} {phase : Phase}

/-- Checking may retain ended markers and advance its logical supply without
allocating any resident or loan. Neither field is a runtime-state oracle. -/
structure EmptyResources (context : Checked.Context) : Prop where
  names : context.names = []
  storage : ∀ base, context.storage base = none
  loans : context.loans = []

namespace EmptyResources

theorem empty : EmptyResources Checked.Context.empty := ⟨rfl, fun _ => rfl, rfl⟩

theorem hide {context : Checked.Context} (empty : EmptyResources context) :
    EmptyResources context.hide := ⟨rfl, empty.storage, empty.loans⟩

theorem resume {caller callee : Checked.Context} (first : EmptyResources caller)
    (last : EmptyResources callee) : EmptyResources (caller.resume callee) :=
  ⟨first.names, last.storage, last.loans⟩

theorem endPayload {context : Checked.Context} (empty : EmptyResources context)
    (payload : Checked.Payload) : EmptyResources (context.endPayload payload) :=
  ⟨empty.names, empty.storage, empty.loans⟩

theorem bindings {context : Checked.Context} (empty : EmptyResources context) :
    context.bindings = [] := by simp [Checked.Context.bindings, empty.names]

end EmptyResources

private theorem referenceFree_replaceChild {value replacement updated : Value} {index : Nat}
    (plain : value.ReferenceFree) (fresh : replacement.ReferenceFree)
    (written : value.replaceChild index replacement = some updated) : updated.ReferenceFree := by
  obtain ⟨source, children⟩ := Value.referenceFree_iff_head_children.mp plain
  obtain ⟨head, fields⟩ := Value.replaceChild_shape written
  apply Value.referenceFree_iff_head_children.mpr
  refine ⟨head ▸ source, ?_⟩
  rw [fields]
  apply valuesReferenceFree_iff.mpr
  intro child member
  rcases List.mem_or_eq_of_mem_set member with old | rfl
  · exact valuesReferenceFree_iff.mp children child old
  · exact fresh

private theorem nominalResident {identity : Nat} {tag : Option Nat} {types : List Ty} {values : List Value}
    (shape : HeadType program (.nominal identity tag) (.nominal identity) types)
    (finite : FiniteLayout program.target program.data (.nominal identity))
    (residents : ValuesHaveTypes program values types) :
    ValueHasType program (.nominal identity tag values) (.nominal identity) := by
  cases shape with
  | nominal declared chosen => exact .nominal declared chosen finite residents

mutual
/-- A consumer of the ordinary phase-indexed typing derivation. Structural
checking yields an actual value in the sole canonical evaluator, without any
executable realization, future evaluation premise, or source-payload oracle. -/
theorem HasType.structural_evaluates {program : Program} {phase : Phase} {home : Module}
    {before after : Point program phase}
    {held : List (Payload phase)} {expression : Expr} {result : Result phase}
    {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected) :
    Structural expression → EmptyResources before.checked →
      EmptyResources after.checked ∧ ∃ value,
        Evaluates program .empty ⟨expression, plan⟩ value .empty ∧
        ValueHasType program value result.type ∧ value.ReferenceFree := by
  match typed with
  | .unit => intro _ empty; exact ⟨empty, .unit, .unit, .unit, trivial⟩
  | .integer fits => intro _ empty; exact ⟨empty, _, .integer fits, .integer fits, trivial⟩
  | .character valid => intro _ empty; exact ⟨empty, _, .character valid, .character valid, trivial⟩
  | .group typed =>
    intro structural empty
    cases structural with
    | group body =>
      obtain ⟨last, value, evaluated, resident, plain⟩ := typed.structural_evaluates body empty
      exact ⟨last, value, .group evaluated, resident, plain⟩
  | .read .. | .move .. | .implicitMove .. | .borrow .. | .reborrow .. | .dereference .. | .moveIndirect .. |
      .sequence .. | .bind .. | .call .. | .assign .. | .assignIndirect .. | .applyPatterns .. |
      .expectedDereference .. | .expectedMoveIndirect .. | .expectedMove .. | .expectedBorrow .. | .expectedCall .. =>
    intro structural; cases structural
  | .tuple contextual head tail supported =>
    intro structural empty
    cases structural with
    | tuple first rest =>
      obtain ⟨middle, value, evaluated, resident, plain⟩ := head.structural_evaluates first empty
      obtain ⟨last, values, evaluations, residents, plains⟩ := tail.structural_evaluates rest middle
      exact ⟨last, _, .tuple evaluated evaluations (.of_plain ⟨plain, plains⟩),
        .tuple resident residents, plain, plains⟩
  | .array contextual typed types finite size =>
    intro structural empty
    cases structural with
    | array elements =>
      obtain ⟨last, values, evaluated, residents, plain⟩ := typed.structural_evaluates elements empty
      exact ⟨last, _, .array evaluated (.of_plain plain), .array (types ▸ residents) finite size, plain⟩
  | .construct shape visible typed finite capability =>
    intro structural empty
    cases structural with
    | construct identity tag elements =>
      obtain ⟨last, values, evaluated, residents, plain⟩ := typed.structural_evaluates elements empty
      exact ⟨last, _, .construct evaluated (.of_plain plain), nominalResident shape finite residents, plain⟩
  | .view view body =>
    intro structural empty
    obtain ⟨_, found⟩ := view.selection_found
    simp [empty.bindings, lookup] at found
  | .constant declared visible resolved structural hidden body resume referenceFree interpreted actual =>
    intro _ empty
    obtain ⟨last, value, evaluated, resident, plain⟩ :=
      body.structural_evaluates structural (hidden.checked ▸ empty.hide)
    refine ⟨resume.checked ▸ empty.resume last, value, ?_, resident, plain⟩
    simpa [Environment.hide, Environment.resume, Environment.empty] using
      (Evaluates.constant (environment := .empty) declared
        (by simpa [Environment.hide, Environment.empty] using evaluated) plain)
  | .field source projection evidence =>
    intro structural empty
    cases structural with
    | field body key =>
      obtain ⟨middle, parent, evaluated, resident, plain⟩ := source.structural_evaluates body empty
      obtain ⟨value, indexed, found, selectedTyped, replace⟩ := projection.selected.access resident
      obtain ⟨residual, replaced, residualTyped⟩ := replace .vacant .vacant .vacant
      have valuePlain := plain.children found
      have residualPlain := referenceFree_replaceChild plain (show Value.ReferenceFree .vacant from trivial) replaced
      refine ⟨projection.updated ▸ middle.endPayload _, value,
        .field evaluated ?_ ?_ (.data residualPlain (projection.discard.realized residualTyped).destroys)
          (.of_plain valuePlain), selectedTyped, valuePlain⟩
      · simp [Value.readField, indexed, found]
      · simp [Value.takeField, indexed, found, replaced]
  | .endOwn ending body =>
    intro structural empty
    have found := ending.selected
    simp [empty.bindings] at found
  | .endAfter body ending =>
    intro structural empty
    obtain ⟨middle, _⟩ := body.structural_evaluates structural empty
    have found := ending.selected
    simp [middle.bindings] at found
  | .raiseSupply body larger checked stable actual =>
    intro structural empty
    obtain ⟨middle, value, evaluated, resident, plain⟩ := body.structural_evaluates structural empty
    refine ⟨?_, value, evaluated, resident, plain⟩
    rw [checked]
    exact ⟨middle.names, middle.storage, middle.loans⟩
  | .expectedField typed => exact typed.structural_evaluates
  | .expectedData typed atomic notReference => exact typed.structural_evaluates

termination_by structural typed

theorem HasTypes.structural_evaluates {program : Program} {phase : Phase} {home : Module}
    {before after : Point program phase}
    {held : List (Payload phase)} {expressions : List Expr} {results : List (Result phase)}
    {plans : List CorePlan} {expected : Option (List Ty)}
    (typed : HasTypes program phase home before held expressions results after plans expected) :
    (∀ expression ∈ expressions, Structural expression) → EmptyResources before.checked →
      EmptyResources after.checked ∧ ∃ values,
        EvaluatesList program .empty expressions plans values .empty ∧
        ValuesHaveTypes program values (results.map Result.type) ∧ valuesReferenceFree values := by
  match typed with
  | .nil | .expectedNil => intro _ empty; exact ⟨empty, [], .nil, .nil, trivial⟩
  | .cons head tail | .expectedCons head tail =>
    intro structural empty
    obtain ⟨middle, value, evaluated, resident, plain⟩ := head.structural_evaluates (structural _ (by simp)) empty
    obtain ⟨last, values, evaluations, residents, plains⟩ := tail.structural_evaluates
      (fun expression member => structural expression (by simp [member])) middle
    exact ⟨last, value :: values, .cons evaluated evaluations (.of_plain plain), .cons resident residents, plain, plains⟩
termination_by structural typed
end


/-- Administrative wrappers cannot manufacture a constant declaration or alter
its resolved result type. This inversion consumes the same typing derivation. -/
theorem HasType.constantDeclaration {program : Program} {phase : Phase} {home : Module}
    {before after : Point program phase} {held : List (Payload phase)}
    {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected) :
    ∀ name, expression = .constant name → ∃ declaration,
      program.constants name = some declaration ∧ ResolvesType program.aliases declaration.type result.type := by
  match typed with
  | .constant declared _ resolved _ _ _ _ _ _ _ =>
    intro name same; cases same; exact ⟨_, declared, resolved⟩
  | .view _ body => exact body.constantDeclaration
  | .endOwn _ body => exact body.constantDeclaration
  | .endAfter body _ => exact body.constantDeclaration
  | .raiseSupply body _ _ _ _ => exact body.constantDeclaration
  | .expectedData body _ _ => exact body.constantDeclaration
  | .unit | .integer .. | .character .. | .group .. | .read .. | .move .. | .implicitMove .. |
      .borrow .. | .reborrow .. | .dereference .. | .moveIndirect .. | .tuple .. | .array .. |
      .construct .. | .sequence .. | .bind .. | .field .. | .call .. | .assign .. |
      .assignIndirect .. | .applyPatterns .. | .expectedField .. | .expectedDereference .. |
      .expectedMoveIndirect .. | .expectedMove .. | .expectedBorrow .. | .expectedCall .. =>
    intro name same; cases same
termination_by structural typed

mutual
/-- The normalized domain is inhabited already in checking. The vacuous
checking-phase actualEmpty field is not used to obtain an evaluation. -/
theorem PatternConstantsTyped.normalizes {program : Program} {phase : Phase} {home : Module}
    {source : PatternSource} {plan : PatternPlan}
    (constants : PatternConstantsTyped program phase home source plan) :
    ∃ normalized, NormalizesPattern program source plan normalized := by
  match constants with
  | .wildcard => exact ⟨_, .wildcard⟩
  | .binder name => exact ⟨_, .binder name⟩
  | .node source constants =>
    obtain ⟨normalized, normalization⟩ := constants.normalizes
    exact ⟨_, .node normalization⟩
  | .constant beforeEmpty actualEmpty typed =>
    obtain ⟨declaration, declared, resolved⟩ := typed.constantDeclaration _ rfl
    obtain ⟨_, value, evaluated, _, _⟩ :=
      typed.structural_evaluates (.constant _) (beforeEmpty ▸ EmptyResources.empty)
    exact ⟨_, .constantValue declared resolved evaluated⟩
termination_by structural constants

theorem PatternsConstantsTyped.normalizes {program : Program} {phase : Phase} {home : Module}
    {sources : List PatternSource} {plans : List PatternPlan}
    (constants : PatternsConstantsTyped program phase home sources plans) :
    ∃ normalized, NormalizesPatterns program sources plans normalized := by
  match constants with
  | .nil => exact ⟨[], .patternsNil⟩
  | .cons first rest =>
    obtain ⟨normalized, normalization⟩ := first.normalizes
    obtain ⟨normalizedRest, normalizations⟩ := rest.normalizes
    exact ⟨_, .patternsCons normalization normalizations⟩
termination_by structural constants
end

/-- Hence applyPatterns' universally quantified bodies and coverage obligations
always have an actual normalized input, including on dormant checking paths. -/
theorem ArmConstantsTyped.normalizes {program : Program} {phase : Phase} {home : Module}
    {sources : List (PatternSource × Expr)} {plans : List (PatternPlan × CorePlan)}
    (constants : ArmConstantsTyped program phase home sources plans) :
    ∃ normalized, NormalizesArms program sources plans normalized := by
  match constants with
  | .nil => exact ⟨[], .armsNil⟩
  | .cons first rest =>
    obtain ⟨normalized, normalization⟩ := first.normalizes
    obtain ⟨normalizedRest, normalizations⟩ := rest.normalizes
    exact ⟨_, .armsCons normalization normalizations⟩
termination_by structural constants
end Grounded.Elaboration

/- Section: StateAssignment -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem StateTyped.selectedCut {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {origin : Origin} {binder : Nat} {slot : Slot} {old : SourcePayload}
    (base : origin.base = .binder binder) (stored : context.storage (.binder binder) = some slot)
    (selected : slot.payload.select origin.fields = some old) :
    ∀ node ∈ old.nodes, context.Own node → ∀ other resident fields,
      context.storage other = some resident → resident.payload.Occurs fields node →
        other = origin.base ∧ origin.fields.IsPrefix fields := by
  intro node member own other resident fields otherStored occurrence
  obtain ⟨loan, found, ownBit⟩ := own
  obtain ⟨suffix, inside⟩ := SourcePayload.mem_nodes_iff.mp member
  obtain ⟨value, runtimeStored, _, related⟩ := typed.cells binder slot stored
  have carried : Carries environment held (interpretation.node node)
      (.stored (interpretation.binder binder) (origin.fields ++ suffix)) := by
    change (environment.store (interpretation.binder binder) >>= fun value => value.readIndices (origin.fields ++ suffix)) = _
    simp only [runtimeStored]
    exact related.occurs_readIndices (SourcePayload.select_occurs selected inside)
  obtain ⟨place, _, unique⟩ := typed.custody (interpretation.node node) _ (typed.records node loan found) ownBit
  cases other with
  | binder second =>
    obtain ⟨otherValue, otherRuntimeStored, _, otherRelated⟩ := typed.cells second resident otherStored
    have otherCarried : Carries environment held (interpretation.node node) (.stored (interpretation.binder second) fields) := by
      change (environment.store (interpretation.binder second) >>= fun value => value.readIndices fields) = _
      simp only [otherRuntimeStored]
      exact otherRelated.occurs_readIndices occurrence
    have equality := (unique _ otherCarried).trans (unique _ carried).symm
    have components := Carrier.stored.inj equality
    have same := typed.binderDistinct second binder (.inl ⟨resident, otherStored⟩) (.inl ⟨slot, stored⟩) components.1
    exact ⟨by simp only [base, same], ⟨suffix, components.2.symm⟩⟩

theorem StateTyped.assignTarget {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value} {replacement : ResultType} {value : Value}
    (typed : StateTyped program interpretation context (heldPayloads ++ [replacement.payload]) environment (held ++ [value]))
    (valueTyped : ResultTyped program interpretation context replacement value)
    {origin : Origin} {binder : Nat} {slot : Slot} {state : Initialization} {old updated : SourcePayload}
    (base : origin.base = .binder binder) (stored : context.storage (.binder binder) = some slot)
    (path : CanonicalPath program slot.type origin.fields replacement.type)
    (access : slot.initialization.Access origin.fields state)
    (selected : slot.payload.select origin.fields = some old)
    (drop : StorageDisposition program state replacement.type)
    (unprotected : ∀ node ∈ old.nodes, node ∉ payloadNodes (heldPayloads ++ [replacement.payload]))
    (ready : ∀ node ∈ old.nodes, context.Restored node)
    (write : SourcePayload.Write program slot.type origin.fields slot.payload replacement.payload updated)
    (separated : ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan → loan.own = true →
      (origin.Within loan.target ∧ loan.mode = .unique) ∨ origin.Apart loan.target) :
    ∃ resident disposed after, environment.at (interpretation.origin origin) = some resident ∧
      Environment.Disposes program environment resident disposed ∧
      disposed.writeAddress (interpretation.origin origin) value = some after ∧
      StateTyped program interpretation ((context.dispose old).writeTarget origin .full updated) heldPayloads after held ∧
      StateProgress context ((context.dispose old).writeTarget origin .full updated) environment after interpretation interpretation := by
  obtain ⟨root, rootStored, rootTyped, rootRelated⟩ := typed.cells binder slot stored
  obtain ⟨resident, read, residentTyped⟩ := path.resident rootTyped access
  have actual : environment.at (interpretation.origin origin) = some resident := by
    simp only [Environment.at, Interpretation.origin, base, rootStored, Bind.bind, Option.bind_some, read]
  have oldRelated := rootRelated.select selected read
  have oldTyped := (typed.source.allocated binder slot stored).2.2.2.select path selected
  obtain ⟨disposed, disposal, disposedTyped⟩ := typed.toStoreTyped.dispose oldRelated
    (fun _ member => oldTyped.node_bound member) ready (drop.realized residentTyped)
  have replacementTyped := valueTyped.transport (Context.History.dispose context old) (.refl _ _)
  have disposedStored : (context.dispose old).storage (.binder binder) = some slot := by simpa only [Context.dispose_storage] using stored
  obtain ⟨after, written, afterTyped⟩ := disposedTyped.writeTarget_preserves base disposedStored path access
    replacementTyped.resident write replacementTyped.payload replacementTyped.corresponds
    (fun node loan found own => separated node loan (Context.dispose_active_record found own) own)
  have target : (context.dispose old).Target program origin replacement.type := by
    simpa only [Context.Target, base] using (show ∃ slot, (context.dispose old).storage (.binder binder) = some slot ∧
      CanonicalPath program slot.type origin.fields replacement.type ∧ ∃ state, slot.initialization.Access origin.fields state from
      ⟨slot, disposedStored, path, state, access⟩)
  have replacementAvailable : (context.dispose old).PayloadAvailable replacement.payload := by
    intro node member
    have heldMember : node ∈ payloadNodes (heldPayloads ++ [replacement.payload]) := by simp [payloadNodes_append, payloadNodes, member]
    exact ⟨(typed.heldOwn node heldMember).dispose_of_not_mem (fun oldMember => unprotected node oldMember heldMember),
      (typed.heldReady node heldMember).dispose old⟩
  have length : heldPayloads.length = held.length := by
    have total := typed.heldShape.length
    simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using total
  refine ⟨resident, disposed, after, actual, disposal, written, ?_, ?_⟩
  · exact { afterTyped with
      heldShape := (typed.heldShape.append_inv length).1
      heldOwn := fun node member => (typed.heldOwn node (by simp [payloadNodes_append, member])).dispose_of_not_mem
        (fun oldMember => unprotected node oldMember (by simp [payloadNodes_append, member]))
      heldReady := fun node member loan found own => Context.Ready.writeTarget_initialized target base
        (((typed.heldReady node (by simp [payloadNodes_append, member])).dispose old) loan found own) .full updated
      observedOwn := typed.observedOwn.assignTarget (base ▸ stored) write (typed.selectedCut base stored selected) replacementAvailable
      custody := typed.custody.assignAddress actual disposal written }
  · exact (StateProgress.dispose (reference := old) typed.source disposal).trans
      (StateProgress.writeTarget disposedTyped.source written) (Nat.le_of_eq disposal.storage.supply.symm)

end Grounded

/- Section: ElaborationWriteExecution -/
namespace Grounded.Elaboration
set_option autoImplicit false

/-- Execute the masked replacement using current storage and custody, without a
continuation or an assumed post-state. Disposal preserves the pending replacement. -/
theorem SourceWrite.execute {program : Program} {home : Module}
    {before after : Grounded.Context} {heldPayloads : List SourcePayload}
    {place : AccessPlace} {replacement : ResultType}
    (write : SourceWrite program home before heldPayloads place replacement after)
    {interpretation : Interpretation} {environment : Environment} {held : List Value} {value : Value}
    (typed : StateTyped program interpretation before (heldPayloads ++ [replacement.payload]) environment (held ++ [value]))
    (valueTyped : ResultTyped program interpretation before replacement value) :
    ∃ resident disposed updated,
      environment.resolveAccess program place = some ⟨interpretation.origin write.target, write.parent.map interpretation.node⟩ ∧
      environment.CarrierPermits program .unique place ∧
      environment.Authorizes .unique ⟨interpretation.origin write.target, write.parent.map interpretation.node⟩ ∧
      environment.Permits .unique (write.parent.map interpretation.node) (interpretation.origin write.target) ∧
      environment.at (interpretation.origin write.target) = some resident ∧
      Environment.Disposes program environment resident disposed ∧
      disposed.ResultUsable value ∧
      disposed.writeAddress (interpretation.origin write.target) value = some updated ∧
      StateTyped program interpretation after heldPayloads updated held ∧
      StateProgress before after environment updated interpretation interpretation := by
  obtain ⟨known, _, ancestor, resolved, authority, _⟩ := typed.toStoreTyped.resolveAccessMasked write.access
  have baseExists : ∃ binder, write.target.base = .binder binder := by
    have access := write.access
    cases parent : write.parent with
    | none =>
      rw [parent] at access
      have ownerBase : ∀ {p t ty}, AccessType program home before .unique p t ty none →
          ∃ binder, t.base = .binder binder := by
        intro p t ty access
        cases access with
        | owner => exact ⟨_, rfl⟩
      exact ownerBase access
    | some node =>
      rw [parent] at access
      obtain ⟨_, binder, _, _, _, _, base⟩ := access.uniqueTarget typed.toStoreTyped
      exact ⟨binder, base⟩
  obtain ⟨binder, base⟩ := baseExists
  have stored : before.storage (.binder binder) = some write.slot := by simpa only [base] using write.stored
  have separated : ∀ (node : Nat) (loan : SourceLoan), before.loans[node]? = some loan → loan.own = true →
      (write.target.Within loan.target ∧ loan.mode = .unique) ∨ write.target.Apart loan.target := by
    intro node loan found own
    rcases write.permitted node loan found own with shared | ancestral | apart
    · cases shared.1
    · obtain ⟨parent, same, derived⟩ := ancestral
      obtain ⟨parentLoan, parentFound, within⟩ := ancestor parent same
      have outer := derived.targetWithin typed.source parentFound found
      exact .inl ⟨⟨within.1.trans outer.1, outer.2.trans within.2⟩,
        derived.unique typed.source parentFound found (write.access.parentMode parent parentLoan same parentFound rfl)⟩
    · exact .inr apart
  obtain ⟨resident, disposed, updated, read, disposal, written, state, progress⟩ :=
    typed.assignTarget valueTyped base stored write.path write.mask write.selected write.discard
      write.unprotected write.ready write.written separated
  obtain ⟨root, rootStored, rootTyped, rootRelated⟩ := typed.cells binder write.slot stored
  obtain ⟨old, oldRead, oldTyped⟩ := write.path.resident rootTyped write.mask
  have oldAt : environment.at (interpretation.origin write.target) = some old := by
    simp only [Environment.at, Interpretation.origin, base, rootStored, Bind.bind, Option.bind_some, oldRead]
  have same : old = resident := Option.some.inj (oldAt.symm.trans read)
  subst old
  have related := rootRelated.select write.selected oldRead
  have payloadTyped := (typed.source.allocated binder write.slot stored).2.2.2.select write.path write.selected
  obtain ⟨disposed', disposal', disposedTyped⟩ := typed.toStoreTyped.dispose related
    (fun _ member => payloadTyped.node_bound member) write.ready (write.discard.realized oldTyped)
  have sameDisposed := disposal'.deterministic disposal
  subst disposed'
  have replacementTyped := valueTyped.transport (Context.History.dispose before write.old) (.refl _ _)
  have usable : disposed.ResultUsable value := replacementTyped.usable disposedTyped
    (fun node member => (typed.heldOwn node (by simp [payloadNodes_append, payloadNodes, member])).dispose_of_not_mem
      (fun old => write.unprotected node old (by simp [payloadNodes_append, payloadNodes, member])))
    (fun node member => (typed.heldReady node (by simp [payloadNodes_append, payloadNodes, member])).dispose write.old)
  exact ⟨resident, disposed, updated, resolved, typed.toStoreTyped.carrierPermits write.access,
    authority, typed.toStoreTyped.permits known write.permitted, read, disposal, usable, written,
    write.updated.symm ▸ state, write.updated.symm ▸ progress⟩

/-- Direct assignment fragments, including owner conflict exclusion. -/
theorem SourceWrite.executeOwner {program : Program} {home : Module}
    {before after : Grounded.Context} {heldPayloads : List SourcePayload}
    {place : Place} {replacement : ResultType}
    (write : SourceWrite program home before heldPayloads (.owner place) replacement after)
    {interpretation : Interpretation} {environment : Environment} {held : List Value} {value : Value}
    (typed : StateTyped program interpretation before (heldPayloads ++ [replacement.payload]) environment (held ++ [value]))
    (valueTyped : ResultTyped program interpretation before replacement value) :
    ∃ resident disposed updated,
      environment.resolvePlace program place = some (interpretation.origin write.target) ∧
      environment.OwnerFree (interpretation.origin write.target) ∧
      environment.at (interpretation.origin write.target) = some resident ∧
      Environment.Disposes program environment resident disposed ∧
      disposed.ResultUsable value ∧
      disposed.writeAddress (interpretation.origin write.target) value = some updated ∧
      StateTyped program interpretation after heldPayloads updated held ∧
      StateProgress before after environment updated interpretation interpretation := by
  obtain ⟨resident, disposed, updated, resolved, _, _, permitted, read, disposal, usable, written, state, progress⟩ :=
    write.execute typed valueTyped
  have parentNone : ∀ {target type parent}, AccessType program home before .unique (.owner place) target type parent → parent = none := by
    intro target type parent access
    cases access
    rfl
  have parent := parentNone write.access
  have ownerResolved : environment.resolvePlace program place = some (interpretation.origin write.target) := by
    cases found : environment.resolvePlace program place <;> simp [Environment.resolveAccess, found] at resolved
    exact congrArg some resolved.1
  have free : environment.OwnerFree (interpretation.origin write.target) := by
    intro node loan found own
    rcases permitted node loan found own with shared | ancestral | apart
    · cases shared.1
    · obtain ⟨selected, impossible, _⟩ := ancestral
      simp [parent] at impossible
    · exact apart
  exact ⟨resident, disposed, updated, ownerResolved, free, read, disposal, usable, written, state, progress⟩

/-- Indirect assignment fragments retain the actual address and parent authority. -/
theorem SourceWrite.executeIndirect {program : Program} {home : Module}
    {before after : Grounded.Context} {heldPayloads : List SourcePayload}
    {reference : Place} {fields : List FieldKey} {replacement : ResultType}
    (write : SourceWrite program home before heldPayloads (.dereference reference fields) replacement after)
    {interpretation : Interpretation} {environment : Environment} {held : List Value} {value : Value}
    (typed : StateTyped program interpretation before (heldPayloads ++ [replacement.payload]) environment (held ++ [value]))
    (valueTyped : ResultTyped program interpretation before replacement value) :
    ∃ (access : Environment.ResolvedAccess), ∃ resident disposed updated,
      environment.resolveAccess program (.dereference reference fields) = some access ∧
      environment.CarrierPermits program .unique (.dereference reference fields) ∧
      environment.Authorizes .unique access ∧
      environment.Permits .unique access.parent access.address ∧
      environment.at access.address = some resident ∧
      Environment.Disposes program environment resident disposed ∧
      disposed.ResultUsable value ∧
      disposed.writeAddress access.address value = some updated ∧
      StateTyped program interpretation after heldPayloads updated held ∧
      StateProgress before after environment updated interpretation interpretation := by
  obtain ⟨resident, disposed, updated, fragments⟩ := write.execute typed valueTyped
  exact ⟨_, resident, disposed, updated, fragments⟩

end Grounded.Elaboration

/- Section: ElaborationExecutionContracts -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {phase : Phase}

/-- Execution consumes the current typed state; no future state is an admission premise. -/
def Executes (before : Point program phase) (held : List (Payload phase))
    (expression : Expr) (result : Result phase) (after : Point program phase) (plan : CorePlan) : Prop :=
  ∀ executable : phase = .executable, ∀ {interpretation : Interpretation} {environment : Environment} {values : List Value},
    StateTyped program interpretation (before.source executable) (sourcePayloads held executable) environment values →
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source executable) (result.source executable) value ∧
      StateTyped program last (after.source executable) (sourcePayloads held executable ++ [result.payload.source executable])
        final (values ++ [value]) ∧
      StateProgress (before.source executable) (after.source executable) environment final interpretation last

def ExecutesList (before : Point program phase) (held : List (Payload phase))
    (expressions : List Expr) (results : List (Result phase)) (after : Point program phase) (plans : List CorePlan) : Prop :=
  ∀ executable : phase = .executable, ∀ {interpretation : Interpretation} {environment : Environment} {values : List Value},
    StateTyped program interpretation (before.source executable) (sourcePayloads held executable) environment values →
    ∃ residents final last, EvaluatesList program environment expressions plans residents final ∧
      ResultsTyped program last (after.source executable) (sourceResults results executable) residents ∧
      StateTyped program last (after.source executable)
        (sourcePayloads held executable ++ (sourceResults results executable).map ResultType.payload) final (values ++ residents) ∧
      StateProgress (before.source executable) (after.source executable) environment final interpretation last

def ExecutesArms (before : Point program phase) (held : List (Payload phase)) (subject result : Result phase)
    (arms : List (Pattern × Core)) (after : Point program phase) : Prop :=
  ∀ executable : phase = .executable, ∀ {interpretation : Interpretation} {environment : Environment} {values : List Value}
    {value : Value} {bindings : BindingValues} {body : Core},
    StateTyped program interpretation (before.source executable) (sourcePayloads held executable ++ [subject.payload.source executable])
      environment (values ++ [value]) →
    ResultTyped program interpretation (before.source executable) (subject.source executable) value →
    selectArm value arms = some (bindings, body) →
    ∃ resultValue consumed localAfter final last,
      ConsumesArm program environment value arms bindings body consumed ∧
      Evaluates program (consumed.prepare bindings) body resultValue localAfter ∧
      (∃ trace, Cleans program bindings.length localAfter trace final) ∧
      ResultTyped program last (after.source executable) (result.source executable) resultValue ∧
      StateTyped program last (after.source executable) (sourcePayloads held executable ++ [result.payload.source executable])
        final (values ++ [resultValue]) ∧
      StateProgress (before.source executable) (after.source executable) environment final interpretation last


@[simp] theorem sourcePayloads_singleton (payload : Payload phase) (executable : phase = .executable) :
    sourcePayloads [payload] executable = [payload.source executable] := rfl
@[simp] theorem sourceResults_types (results : List (Result phase)) (executable : phase = .executable) :
    (sourceResults results executable).map ResultType.type = results.map Result.type := by
  simp [sourceResults, Result.source]
@[simp] theorem sourceResults_payloads (results : List (Result phase)) (executable : phase = .executable) :
    (sourceResults results executable).map ResultType.payload = sourcePayloads (results.map Result.payload) executable := by
  simp [sourceResults, sourcePayloads, Result.source]

theorem pendingResultUsable {interpretation : Interpretation} {context : Grounded.Context} {held : List SourcePayload}
    {payload : SourcePayload} {environment : Environment} {values : List Value} {value : Value}
    (typed : StateTyped program interpretation context (held ++ [payload]) environment (values ++ [value])) :
    environment.ResultUsable value :=
  typed.heldUsable (by simp : (values ++ [value])[values.length]? = some value)

theorem HasTypes.expected_types {home : Module} {before after : Point program phase} {held : List (Payload phase)}
    {expressions : List Expr} {results : List (Result phase)} {plans : List CorePlan} {expected : Option (List Ty)}
    (typed : HasTypes program phase home before held expressions results after plans expected) :
    ∀ types, expected = some types → results.map Result.type = types := by
  match typed with
  | .nil | .cons .. => intro _ same; cases same
  | .expectedNil => intro _ same; cases same; rfl
  | .expectedCons _ rest =>
    intro _ same; cases same
    simp only [List.map_cons, rest.expected_types _ rfl]
termination_by structural typed

end Grounded.Elaboration

/- Section: ElaborationExecutionSteps -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem SlotsCorrespond.index {interpretation : Interpretation} {store : Store}
    {bindings : List (String × Root)} {slots : List (String × Slot)}
    (correspond : SlotsCorrespond interpretation store bindings slots) {index : Nat} {binding : String × Slot}
    (selected : slots[index]? = some binding) :
    bindings[index]? = some (binding.1, interpretation.binder binding.2.binder) ∧
      ∀ value, store (interpretation.binder binding.2.binder) = some value → binding.2.Corresponds interpretation value := by
  induction correspond generalizing index with
  | nil => simp at selected
  | @cons name root slot bindings slots identity resident rest ih =>
    cases index with
    | zero =>
      cases Option.some.inj selected
      exact ⟨by simp [identity], by simpa only [identity] using resident⟩
    | succ index => exact ih selected

namespace Elaboration

theorem SourceEnding.execute {before after : Grounded.Context} {heldPayloads : List SourcePayload}
    {slot : Nat} {fields : List Nat} (ending : SourceEnding program before heldPayloads slot fields after)
    {interpretation : Interpretation} {environment : Environment} {held : List Value}
    (typed : StateTyped program interpretation before heldPayloads environment held) :
    ∃ final, environment.endSlot slot fields = some final ∧
      StateTyped program interpretation after heldPayloads final held ∧
      StateProgress before after environment final interpretation interpretation := by
  obtain ⟨indexed, correspondence⟩ := typed.slots.index ending.selected
  obtain ⟨values, stored, _⟩ := typed.residents.residents
  obtain ⟨value, found⟩ := stored.present (List.mem_map_of_mem (List.mem_of_getElem? indexed))
  have occurrence := SourcePayload.occurs_iff_select.mpr ending.handle
  have selected := (correspondence value found).occurs_readIndices occurrence
  have member := SourcePayload.mem_nodes_iff.mpr ⟨fields, occurrence⟩
  obtain ⟨loan, sourceFound⟩ := (typed.source.slots ending.binding (List.mem_of_getElem? ending.selected)).2.node_found member
  obtain ⟨final, ended, state⟩ := typed.endOwn sourceFound ending.unprotected ending.unobserved
  have runtimeFound := typed.records ending.node loan sourceFound
  have restored := typed.toStoreTyped.restored sourceFound ending.ready
  have endSlot : environment.endSlot slot fields = some final := by
    simp only [Environment.endSlot, indexed, Bind.bind, Option.bind_some, found, selected, runtimeFound]
    by_cases own : loan.own = true
    · obtain ⟨resident, read⟩ := restored _ runtimeFound own
      simpa [read] using ended
    · have off : loan.own = false := Bool.eq_false_iff.mpr own
      simpa [off] using ended
  exact ⟨final, endSlot, ending.updated.symm ▸ state,
    ending.updated.symm ▸ StateProgress.endOwn typed.source ended⟩

end Elaboration
end Grounded

/- Section: ElaborationValueExecution -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {phase : Phase} {home : Module}
  {before after : Point program phase} {held : List (Payload phase)} {result : Result phase}

theorem Executes.unit : Executes before held .unit (.data phase .unit) before .leaf := by
  intro executable
  cases executable
  intro interpretation environment values state
  exact ⟨.unit, environment, interpretation, .unit, ⟨.unit, .plain _, .plain (by trivial)⟩,
    state.appendPlain (by trivial), .refl state.source⟩

theorem Executes.integer {type : IntegerType} {number : Nat} (fits : type.Contains program.target number) :
    Executes before held (.integer type number) (.data phase (.integer type)) before .leaf := by
  intro executable
  cases executable
  intro interpretation environment values state
  exact ⟨.integer type number, environment, interpretation, .integer fits,
    ⟨.integer fits, .plain _, .plain (by trivial)⟩, state.appendPlain (by trivial), .refl state.source⟩

theorem Executes.character {number : Nat} (valid : UnicodeScalar number) :
    Executes before held (.character number) (.data phase .character) before .leaf := by
  intro executable
  cases executable
  intro interpretation environment values state
  exact ⟨.character number, environment, interpretation, .character valid,
    ⟨.character valid, .plain _, .plain (by trivial)⟩, state.appendPlain (by trivial), .refl state.source⟩

theorem Executes.group {body : Expr} {plan : CorePlan} (bodyExec : Executes before held body result after plan) :
    Executes before held (.group body) result after (.unary plan) := by
  intro executable interpretation environment values state
  obtain ⟨value, final, last, evaluated, resident, finalTyped, progress⟩ := bodyExec executable state
  exact ⟨value, final, last, .group evaluated, resident, finalTyped, progress⟩

theorem Executes.read {place : Place}
    (actual : Required phase fun executable => Nonempty (SourceRead program home
      (before.source executable) place (result.source executable) (after.source executable))) :
    Executes before held (.read place) result after .leaf := by
  intro executable interpretation environment values state
  obtain ⟨step⟩ := actual executable
  exact state.executesRead step.selected step.access step.initialized step.path step.provenance
    step.available step.permission step.permitted step.copied

theorem Executes.move {place : Place}
    (actual : Required phase fun executable => Nonempty (SourceMove program home
      (before.source executable) place (result.source executable) (after.source executable))) :
    Executes before held (.move place) result after .leaf := by
  intro executable interpretation environment values state
  obtain ⟨step⟩ := actual executable
  rw [step.updated]
  exact state.executesMove step.selected step.access step.initialized step.path step.provenance
    step.available step.free step.cleared

theorem Executes.implicitMove {place : Place} (body : Executes before held (.move place) result after .leaf) :
    Executes before held (.read place) result after .implicitMove := by
  intro executable interpretation environment values state
  obtain ⟨value, final, last, evaluated, resident, finalTyped, progress⟩ := body executable state
  exact ⟨value, final, last, .implicitMove evaluated, resident, finalTyped, progress⟩

theorem Executes.borrow {mode : BorrowMode} {place : AccessPlace} {referent : Ty}
    (actual : Required phase fun executable => Nonempty (SourceBorrow program home
      (before.source executable) mode place referent (result.source executable) (after.source executable))) :
    Executes before held (.borrow mode place) result after .leaf := by
  intro executable interpretation environment values state
  obtain ⟨step⟩ := actual executable
  have payload : result.payload.source executable = .reference (before.source executable).loans.length :=
    congrArg ResultType.payload step.produced
  simpa only [step.updated, step.produced, payload] using
    state.executesBorrow step.access step.ready step.permitted step.finite step.provenance step.available

theorem Executes.reborrow {mode : BorrowMode} {place : Place}
    (body : Executes before held (.borrow mode (.dereference place [])) result after .leaf) :
    Executes before held (.read place) result after (.reborrow mode) := by
  intro executable interpretation environment values state
  obtain ⟨value, final, last, evaluated, resident, finalTyped, progress⟩ := body executable state
  have reborrow : Evaluates program environment ⟨.read place, .reborrow mode⟩ value final := by
    cases evaluated with
    | borrow resolved carrier authority permission ready selected usable =>
      exact .reborrow resolved carrier authority permission ready selected usable
  exact ⟨value, final, last, reborrow, resident, finalTyped, progress⟩

theorem Executes.dereference {reference : Place} {fields : List FieldKey}
    (actual : Required phase fun executable => Nonempty (SourceDereference program home
      (before.source executable) reference fields (result.source executable) (after.source executable))) :
    Executes before held (.dereference reference fields) result after .leaf := by
  intro executable interpretation environment values state
  obtain ⟨step⟩ := actual executable
  exact state.executesDereference step.access step.ready step.permitted step.provenance step.available step.permission step.copied

theorem Executes.moveIndirect {reference : Place} {fields : List FieldKey}
    (actual : Required phase fun executable => Nonempty (SourceMoveIndirect program home
      (before.source executable) (sourcePayloads held executable) reference fields
      (result.source executable) (after.source executable))) :
    Executes before held (.moveIndirect reference fields) result after .leaf := by
  intro executable interpretation environment values state
  obtain ⟨step⟩ := actual executable
  rw [step.updated]
  exact state.executesMoveIndirect step.access step.ready step.permitted step.stored step.path
    step.provenance step.available step.pending step.cleared

end Grounded.Elaboration

/- Section: ElaborationAggregateExecution -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {phase : Phase} {home : Module}
  {before middle after : Point program phase} {held : List (Payload phase)}

theorem ExecutesList.nil : ExecutesList before held [] [] before [] := by
  intro executable interpretation environment values state
  exact ⟨[], environment, interpretation, .nil, .nil, by simpa [sourceResults] using state, .refl state.source⟩

theorem ExecutesList.cons {head : Expr} {tail : List Expr} {first : Result phase} {rest : List (Result phase)}
    {headPlan : CorePlan} {tailPlans : List CorePlan}
    (headExec : Executes before held head first middle headPlan)
    (tailExec : ExecutesList middle (held ++ [first.payload]) tail rest after tailPlans) :
    ExecutesList before held (head :: tail) (first :: rest) after (headPlan :: tailPlans) := by
  intro executable interpretation environment values state
  obtain ⟨value, initial, firstMap, headEval, firstTyped, firstState, firstProgress⟩ := headExec executable state
  obtain ⟨residents, final, last, tailEval, restTyped, finalTyped, tailProgress⟩ :=
    tailExec executable (by simpa only [sourcePayloads_append, sourcePayloads_singleton] using firstState)
  have retained := firstTyped.transport tailProgress.history tailProgress.interpretation
  have frontUsable : final.ResultUsable value :=
    finalTyped.heldUsable (index := values.length) (by simp)
  exact ⟨value :: residents, final, last, .cons headEval tailEval frontUsable, .cons retained restTyped,
    by simpa only [sourceResults, sourcePayloads, Result.source, Payload.aggregate, Payload.source, List.map_map, Function.comp_def, List.map_cons, List.map_nil, List.map_append, List.append_assoc, List.singleton_append, Value.children] using finalTyped,
    firstProgress.trans tailProgress (headEval.storage state.residents.valid).2.supply⟩

theorem Executes.tuple {head : Expr} {tail : List Expr} {first : Result phase} {rest : List (Result phase)}
    {headPlan : CorePlan} {tailPlans : List CorePlan}
    (headExec : Executes before held head first middle headPlan)
    (tailExec : ExecutesList middle (held ++ [first.payload]) tail rest after tailPlans) :
    Executes before held (.tuple head tail)
      ⟨.tuple first.type (rest.map Result.type), .aggregate .tuple (first.payload :: rest.map Result.payload)⟩
      after (.batch (headPlan :: tailPlans)) := by
  intro executable
  cases executable
  intro interpretation environment values state
  obtain ⟨value, initial, firstMap, headEval, firstTyped, firstState, firstProgress⟩ := headExec rfl state
  obtain ⟨residents, final, last, tailEval, restTyped, finalTyped, tailProgress⟩ :=
    tailExec rfl (by simpa only [sourcePayloads_append, sourcePayloads_singleton] using firstState)
  have retained := firstTyped.transport tailProgress.history tailProgress.interpretation
  have resident := retained.tuple restTyped
  have flat : StateTyped program last (after.source rfl)
      (sourcePayloads held rfl ++ (first.source rfl).payload :: (sourceResults rest rfl).map ResultType.payload)
      final (values ++ (Value.tuple value residents).children) := by
    simpa only [Result.source, sourcePayloads_append, sourcePayloads_singleton, List.append_assoc, List.singleton_append, Value.children] using finalTyped
  have packed := flat.pack resident.corresponds
  refine ⟨.tuple value residents, final, last, .tuple headEval tailEval (pendingResultUsable packed), ?_, ?_,
    firstProgress.trans tailProgress (headEval.storage state.residents.valid).2.supply⟩
  · change ResultTyped program last (after.source rfl)
      ⟨.tuple first.type (rest.map Result.type),
        .aggregate .tuple (first.payload.source rfl :: sourcePayloads (rest.map Result.payload) rfl)⟩ (.tuple value residents)
    simpa only [Result.source, sourceResults_types, sourceResults_payloads] using resident
  · change StateTyped program last (after.source rfl)
      (sourcePayloads held rfl ++ [.aggregate .tuple (first.payload.source rfl :: sourcePayloads (rest.map Result.payload) rfl)])
      final (values ++ [.tuple value residents])
    simpa only [Result.source, sourceResults_payloads] using packed

theorem Executes.array {element : Ty} {elements : List Expr} {results : List (Result phase)} {plans : List CorePlan}
    (body : ExecutesList before held elements results after plans)
    (types : results.map Result.type = List.replicate elements.length element)
    (finite : FiniteLayout program.target program.data element)
    (size : elements.length < 2 ^ program.target.pointerBits) :
    Executes before held (.array elements)
      ⟨.array element elements.length, .aggregate .array (results.map Result.payload)⟩ after (.batch plans) := by
  intro executable
  cases executable
  intro interpretation environment values state
  obtain ⟨residents, final, last, evaluated, residentsTyped, finalTyped, progress⟩ := body rfl state
  have resident := residentsTyped.array (by simpa using types) finite size
  have packed := finalTyped.pack resident.corresponds
  refine ⟨.array residents, final, last, .array evaluated (pendingResultUsable packed), ?_, ?_, progress⟩
  · change ResultTyped program last (after.source rfl)
      ⟨.array element elements.length, .aggregate .array (sourcePayloads (results.map Result.payload) rfl)⟩ (.array residents)
    simpa only [sourceResults_payloads] using resident
  · change StateTyped program last (after.source rfl)
      (sourcePayloads held rfl ++ [.aggregate .array (sourcePayloads (results.map Result.payload) rfl)])
      final (values ++ [.array residents])
    simpa only [sourceResults_payloads] using packed

theorem Executes.construct {identity : Nat} {tag : Option Nat} {fields : List Expr}
    {results : List (Result phase)} {plans : List CorePlan}
    (shape : HeadType program (.nominal identity tag) (.nominal identity) (results.map Result.type))
    (body : ExecutesList before held fields results after plans)
    (finite : FiniteLayout program.target program.data (.nominal identity)) :
    Executes before held (.construct identity tag fields)
      ⟨.nominal identity, .aggregate (.nominal identity tag) (results.map Result.payload)⟩ after (.batch plans) := by
  intro executable
  cases executable
  intro interpretation environment values state
  obtain ⟨residents, final, last, evaluated, residentsTyped, finalTyped, progress⟩ := body rfl state
  generalize typesEq : results.map Result.type = types at shape
  cases shape with
  | nominal declared chosen =>
    have resident := residentsTyped.nominal declared chosen finite (by simpa only [sourceResults_types] using typesEq)
    have packed := finalTyped.pack resident.corresponds
    refine ⟨.nominal identity tag residents, final, last, .construct evaluated (pendingResultUsable packed), ?_, ?_, progress⟩
    · change ResultTyped program last (after.source rfl)
        ⟨.nominal identity, .aggregate (.nominal identity tag) (sourcePayloads (results.map Result.payload) rfl)⟩
        (.nominal identity tag residents)
      simpa only [sourceResults_payloads] using resident
    · change StateTyped program last (after.source rfl)
        (sourcePayloads held rfl ++ [.aggregate (.nominal identity tag) (sourcePayloads (results.map Result.payload) rfl)])
        final (values ++ [.nominal identity tag residents])
      simpa only [sourceResults_payloads] using packed

end Grounded.Elaboration

/- Section: ElaborationControlExecution -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {phase : Phase} {home : Module}

theorem Executes.view {before viewed after : Point program phase} {held : List (Payload phase)}
    {reference : Place} {expression : Expr} {result : Result phase} {plan : CorePlan}
    (view : ViewStep program home before viewed reference) (body : Executes viewed held expression result after plan) :
    Executes before held expression result after plan := by
  intro executable interpretation environment values state
  simpa only [view.source_eq executable] using body executable (view.source_eq executable ▸ state)

theorem Executes.sequence {before middle disposed after : Point program phase} {held : List (Payload phase)}
    {first rest : Expr} {discarded result : Result phase} {firstPlan restPlan : CorePlan}
    (head : Executes before held first discarded middle firstPlan)
    (dispose : PatternDisposal program held middle discarded disposed)
    (tail : Executes disposed held rest result after restPlan) :
    Executes before held (.sequence first rest) result after (.binary firstPlan restPlan) := by
  intro executable interpretation environment values state
  obtain ⟨resident, initial, firstMap, headEval, residentTyped, initialState, headProgress⟩ := head executable state
  obtain ⟨disposedEnv, disposal, disposedState⟩ := initialState.disposeResult residentTyped dispose.discard (dispose.actual executable).1
  have disposalProgress := StateProgress.dispose (interpretation := firstMap)
    (reference := discarded.payload.source executable) initialState.source disposal
  simp only [Result.source] at disposedState
  rw [← (dispose.actual executable).2.1] at disposedState disposalProgress
  obtain ⟨value, final, last, tailEval, resultTyped, finalState, tailProgress⟩ := tail executable disposedState
  exact ⟨value, final, last, .sequence headEval disposal tailEval, resultTyped, finalState,
    headProgress.trans (disposalProgress.trans tailProgress (by simp only [disposal.storage.supply, Nat.le_refl]))
      (headEval.storage state.residents.valid).2.supply⟩

theorem Executes.field {before middle after : Point program phase} {held : List (Payload phase)}
    {body : Expr} {key : FieldKey} {parent result : Result phase} {plan : CorePlan}
    (source : Executes before held body parent middle plan)
    (projection : ProjectionStep program home middle after held parent key result) :
    Executes before held (.field body key) result after (.unary plan) := by
  intro executable interpretation environment values state
  obtain ⟨value, initial, firstMap, evaluated, parentTyped, initialState, sourceProgress⟩ := source executable state
  obtain ⟨remainder, selected, written, legal, updated⟩ := projection.actual executable
  obtain ⟨extracted, residual, final, read, taken, _, disposal, resultTyped, finalState, projectionProgress⟩ :=
    initialState.field parentTyped projection.selected selected written projection.discard
      (by simpa only [sourcePayloads_append, sourcePayloads_singleton] using legal)
  rw [← updated] at resultTyped finalState projectionProgress
  exact ⟨extracted, final, firstMap, .field evaluated read taken disposal (pendingResultUsable finalState),
    resultTyped, finalState, sourceProgress.trans projectionProgress (evaluated.storage state.residents.valid).2.supply⟩

theorem Executes.assign {before middle written after : Point program phase} {held : List (Payload phase)}
    {place : Place} {value rest : Expr} {replacement result : Result phase} {valuePlan restPlan : CorePlan}
    (resident : Executes before held value replacement middle valuePlan)
    (write : WriteStep program home middle written held (.owner place) replacement)
    (continued : Executes written held rest result after restPlan) :
    Executes before held (.assign place value rest) result after (.binary valuePlan restPlan) := by
  intro executable interpretation environment values state
  obtain ⟨replacementValue, initial, firstMap, evaluated, replacementTyped, initialState, firstProgress⟩ := resident executable state
  obtain ⟨step⟩ := write.actual executable
  obtain ⟨old, disposed, updated, resolved, free, read, disposal, usable, changed, updatedState, writeProgress⟩ :=
    step.executeOwner initialState replacementTyped
  obtain ⟨resultValue, final, last, bodyEval, resultTyped, finalState, bodyProgress⟩ := continued executable updatedState
  have supply : initial.nextRoot ≤ updated.nextRoot := by
    simp only [(Environment.writeAddress_update changed).supply, disposal.storage.supply, Nat.le_refl]
  exact ⟨resultValue, final, last, .assign evaluated resolved free read disposal usable changed bodyEval,
    resultTyped, finalState, firstProgress.trans (writeProgress.trans bodyProgress supply)
      (evaluated.storage state.residents.valid).2.supply⟩

theorem Executes.assignIndirect {before middle written after : Point program phase} {held : List (Payload phase)}
    {reference : Place} {fields : List FieldKey} {value rest : Expr} {replacement result : Result phase}
    {valuePlan restPlan : CorePlan}
    (resident : Executes before held value replacement middle valuePlan)
    (write : WriteStep program home middle written held (.dereference reference fields) replacement)
    (continued : Executes written held rest result after restPlan) :
    Executes before held (.assignIndirect reference fields value rest) result after (.binary valuePlan restPlan) := by
  intro executable interpretation environment values state
  obtain ⟨replacementValue, initial, firstMap, evaluated, replacementTyped, initialState, firstProgress⟩ := resident executable state
  obtain ⟨step⟩ := write.actual executable
  obtain ⟨access, old, disposed, updated, resolved, carrier, authority, permitted, read, disposal, usable, changed,
    updatedState, writeProgress⟩ := step.executeIndirect initialState replacementTyped
  obtain ⟨resultValue, final, last, bodyEval, resultTyped, finalState, bodyProgress⟩ := continued executable updatedState
  have supply : initial.nextRoot ≤ updated.nextRoot := by
    simp only [(Environment.writeAddress_update changed).supply, disposal.storage.supply, Nat.le_refl]
  exact ⟨resultValue, final, last,
    .assignIndirect evaluated resolved carrier authority permitted read disposal usable changed bodyEval,
    resultTyped, finalState, firstProgress.trans (writeProgress.trans bodyProgress supply)
      (evaluated.storage state.residents.valid).2.supply⟩

theorem Executes.endOwn {before ended after : Point program phase} {held : List (Payload phase)}
    {expression : Expr} {result : Result phase} {plan : CorePlan} {slot : Nat} {fields : List Nat}
    (ending : EndingStep program before ended held slot fields)
    (continued : Executes ended held expression result after plan) :
    Executes before held expression result after (.endOwn slot plan fields) := by
  intro executable interpretation environment values state
  obtain ⟨step⟩ := ending.actual executable
  obtain ⟨endedEnv, actual, endedState, endingProgress⟩ := step.execute state
  obtain ⟨value, final, last, evaluated, resident, finalState, bodyProgress⟩ := continued executable endedState
  exact ⟨value, final, last, .endOwn actual evaluated, resident, finalState,
    endingProgress.trans bodyProgress (by simp only [(Environment.endSlot_storage actual).supply, Nat.le_refl])⟩

theorem Executes.endAfter {before middle after : Point program phase} {held : List (Payload phase)}
    {expression : Expr} {result : Result phase} {plan : CorePlan} {slot : Nat} {fields : List Nat}
    (body : Executes before held expression result middle plan)
    (ending : EndingStep program middle after (held ++ [result.payload]) slot fields) :
    Executes before held expression result after (.endAfter slot plan fields) := by
  intro executable interpretation environment values state
  obtain ⟨value, initial, firstMap, evaluated, resident, initialState, bodyProgress⟩ := body executable state
  obtain ⟨step⟩ := ending.actual executable
  obtain ⟨final, actual, finalState, endingProgress⟩ := step.execute (by
    simpa only [sourcePayloads_append, sourcePayloads_singleton] using initialState)
  have pending : StateTyped program firstMap (after.source executable)
      (sourcePayloads held executable ++ [result.payload.source executable]) final (values ++ [value]) := by
    simpa only [sourcePayloads_append, sourcePayloads_singleton] using finalState
  exact ⟨value, final, firstMap, .endAfter evaluated actual (pendingResultUsable pending),
    resident.transport endingProgress.history endingProgress.interpretation, pending,
    bodyProgress.trans endingProgress (evaluated.storage state.residents.valid).2.supply⟩

theorem Executes.raiseSupply {before middle after : Point program phase} {held : List (Payload phase)}
    {expression : Expr} {result : Result phase} {plan : CorePlan}
    (body : Executes before held expression result middle plan)
    (actual : Required phase fun executable => ∃ sourceSupply,
      (middle.source executable).nextBinder ≤ sourceSupply ∧
      after.source executable = { middle.source executable with nextBinder := sourceSupply }) :
    Executes before held expression result after plan := by
  intro executable interpretation environment values state
  obtain ⟨value, final, last, evaluated, resident, finalState, bodyProgress⟩ := body executable state
  obtain ⟨supply, larger, updated⟩ := actual executable
  have growth := StateProgress.raiseSupply (interpretation := last) (environment := final) finalState.source larger
  rw [← updated] at growth
  exact ⟨value, final, last, evaluated, resident.transport growth.history growth.interpretation,
    updated.symm ▸ finalState.raiseSupply larger,
    bodyProgress.trans growth (evaluated.storage state.residents.valid).2.supply⟩

end Grounded.Elaboration

/- Section: ElaborationCallExecution -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {phase : Phase}

/-- Binding consumes the initializer's pending result and protects the body's result during retirement. -/
theorem Executes.bind {before middle bound bodyAfter after : Point program phase}
    {held : List (Payload phase)} {mutable : Bool} {name : String} {annotation : Option TypeExpr}
    {initial body : Expr} {localType result : Result phase} {initialPlan bodyPlan : CorePlan}
    (initialized : Executes before held initial localType middle initialPlan)
    (binding : BindStep program middle bound name mutable localType)
    (continued : Executes bound held body result bodyAfter bodyPlan)
    (cleanup : CleanupStep program bodyAfter after (held ++ [result.payload]) 1) :
    Executes before held (.bind mutable name annotation initial body) result after (.binary initialPlan bodyPlan) := by
  intro executable interpretation environment values typed
  obtain ⟨resident, middleEnv, middleMap, initialEval, initialResult, initialState, initialProgress⟩ := initialized executable typed
  have boundState := initialState.bind initialResult name mutable
  rw [← binding.actual executable] at boundState
  obtain ⟨value, localAfter, last, bodyEval, bodyResult, bodyState, bodyProgress⟩ := continued executable boundState
  obtain ⟨final, trace, cleaned, finalState⟩ := cleanup.cleanup executable (by
    simpa only [sourcePayloads_append, sourcePayloads_singleton] using bodyState)
  have finalPending : StateTyped program last (after.source executable)
      (sourcePayloads held executable ++ [result.payload.source executable]) final (values ++ [value]) := by
    simpa only [sourcePayloads_append, sourcePayloads_singleton] using finalState
  have cleanupProgress := StateProgress.cleanup (interpretation := last) bodyState.source cleaned
  rw [← (cleanup.source executable).2] at cleanupProgress
  have bindProgress := StateProgress.bind (interpretation := middleMap) (environment := middleEnv)
    initialState.source name mutable (localType.source executable) resident
  rw [← binding.actual executable] at bindProgress
  have inner := bindProgress.trans bodyProgress (by simp [Environment.bind])
  have whole := initialProgress.trans inner (initialEval.storage typed.residents.valid).2.supply
  have evaluated := Evaluates.bind (mutable := mutable) (annotation := annotation) initialEval (pendingResultUsable initialState) bodyEval
    ⟨trace, cleaned⟩ (pendingResultUsable finalPending)
  refine ⟨value, final, last, evaluated,
    bodyResult.transport cleanupProgress.history cleanupProgress.interpretation, finalPending, ?_⟩
  apply whole.trans cleanupProgress
  exact Nat.le_trans (initialEval.storage typed.residents.valid).2.supply
    (Nat.le_trans (by simp [Environment.bind]) (bodyEval.storage boundState.residents.valid).2.supply)

/-- Constants execute their existing body plan in the hidden caller store, then restore only visibility. -/
theorem Executes.constant {before hidden constantAfter after : Point program phase}
    {held : List (Payload phase)} {name : String} {declaration : ConstantDecl}
    {result : Result phase} {plan : CorePlan}
    (declared : program.constants name = some declaration)
    (hiddenStep : HideStep program before hidden)
    (initialized : Executes hidden held declaration.body result constantAfter plan)
    (resume : ResumeStep program before constantAfter after)
    (empty : Required phase fun executable => (result.payload.source executable).nodes = []) :
    Executes before held (.constant name) result after (.unary plan) := by
  intro executable interpretation environment values typed
  have hiddenState := typed.hide
  rw [← hiddenStep.actual executable] at hiddenState
  obtain ⟨value, constantEnv, last, bodyEval, bodyResult, bodyState, progress⟩ := initialized executable hiddenState
  have plain := bodyResult.corresponds.referenceFree_iff.mpr (empty executable)
  rw [hiddenStep.actual executable] at progress
  have supply := (bodyEval.storage hiddenState.residents.valid).2.supply
  have resumed := StateTyped.resume typed.toStoreTyped bodyState progress supply
  have resultResumed := bodyResult.resume (caller := before.source executable)
  have progressResumed := progress.resume typed.source
  rw [← resume.actual executable] at resumed resultResumed progressResumed
  exact ⟨value, environment.resume constantEnv, last, .constant declared bodyEval plain,
    resultResumed, resumed, progressResumed⟩

private theorem prepareSupply (environment : Environment) (bindings : BindingValues) :
    environment.nextRoot ≤ (environment.prepare bindings).nextRoot := by
  induction bindings generalizing environment with
  | nil => exact Nat.le_refl _
  | cons binding bindings ih =>
    exact Nat.le_trans (Nat.le_succ _) (ih (environment.bind binding.1 binding.2))

/-- Calls use the actual argument, prepared body and cleanup states; pending handles remain protected. -/
theorem Executes.call {before middle hidden prepared bodyAfter cleaned after : Point program phase}
    {held : List (Payload phase)} {identity : Nat} {arguments : List Expr}
    {argumentTypes : List (Result phase)} {result : Result phase}
    {argumentPlans : List CorePlan} {bodyPlan : CorePlan} {declaration : FunctionDecl}
    (declared : program.functions identity = some declaration)
    (inputs : ExecutesList before held arguments argumentTypes middle argumentPlans)
    (types : argumentTypes.map Result.type = declaration.parameters.map fun parameter => parameter.2.type)
    (hide : HideStep program middle hidden)
    (prepare : PrepareStep program hidden prepared declaration.parameters argumentTypes)
    (body : Executes prepared held declaration.body result bodyAfter bodyPlan)
    (cleanup : CleanupStep program bodyAfter cleaned (held ++ [result.payload]) declaration.parameters.length)
    (resume : ResumeStep program middle cleaned after) :
    Executes before held (.call identity arguments) result after (.call argumentPlans bodyPlan) := by
  intro executable interpretation environment values typed
  obtain ⟨residents, middleEnv, middleMap, inputsEval, inputsResult, inputsState, inputsProgress⟩ := inputs executable typed
  have hiddenState := inputsState.hide
  have hiddenResults := inputsResult.hide
  rw [← hide.actual executable] at hiddenState hiddenResults
  have aligned : declaration.parameters.map (fun parameter => parameter.2.type) =
      (sourceResults argumentTypes executable).map ResultType.type := by
    simpa only [sourceResults_types] using types.symm
  obtain ⟨preparedMap, preparedState, preparedProgress⟩ := hiddenState.prepare hiddenResults aligned
  rw [← prepare.actual executable] at preparedState preparedProgress
  obtain ⟨value, localAfter, last, bodyEval, bodyResult, bodyState, bodyProgress⟩ := body executable preparedState
  obtain ⟨final, trace, cleanedEval, finalState⟩ := cleanup.cleanup executable (by
    simpa only [sourcePayloads_append, sourcePayloads_singleton] using bodyState)
  have finalPending : StateTyped program last (cleaned.source executable)
      (sourcePayloads held executable ++ [result.payload.source executable]) final (values ++ [value]) := by
    simpa only [sourcePayloads_append, sourcePayloads_singleton] using finalState
  have cleanupProgress := StateProgress.cleanup (interpretation := last) bodyState.source cleanedEval
  rw [← (cleanup.source executable).2] at cleanupProgress
  have preparedSupply := prepareSupply middleEnv.hide ((declaration.parameters.map Prod.fst).zip residents)
  have bodySupply := (bodyEval.storage preparedState.residents.valid).2.supply
  have innerProgress := preparedProgress.trans bodyProgress preparedSupply
  have localProgress := innerProgress.trans cleanupProgress (Nat.le_trans preparedSupply bodySupply)
  rw [hide.actual executable] at localProgress
  have cleanedResult := bodyResult.transport cleanupProgress.history cleanupProgress.interpretation
  have resultResumed := cleanedResult.resume (caller := middle.source executable)
  have length : ((declaration.parameters.map Prod.fst).zip residents).length = declaration.parameters.length := by
    have total := inputsResult.corresponds.length
    have alignedLength := congrArg List.length aligned
    simp only [List.length_map, sourceResults] at total alignedLength
    simp only [List.length_zip, List.length_map]
    omega
  have scopedEvolution := (bodyEval.storage preparedState.residents.valid).2.scope inputsState.residents.valid.hide
    ((declaration.parameters.map Prod.fst).zip residents)
  have cleanedEvolution := cleanedEval.suffix_evolution bodyState.residents.valid
  rw [← length] at cleanedEvolution
  have supply := (scopedEvolution.trans cleanedEvolution).supply
  have resumed := StateTyped.resume inputsState.toStoreTyped finalPending localProgress supply
  have resumedProgress := localProgress.resume inputsState.source
  rw [← resume.actual executable] at resumed resultResumed resumedProgress
  refine ⟨value, middleEnv.resume final, last,
    .call declared inputsEval bodyEval ⟨trace, ?_⟩ (pendingResultUsable finalPending),
    resultResumed, resumed, inputsProgress.trans resumedProgress (inputsEval.storage typed.residents.valid).2.supply⟩
  simpa only [length] using cleanedEval

end Grounded.Elaboration

/- Section: CoverageDispatch -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}


theorem ValuesHaveTypes.argument {values : List Value} {types : List Ty}
    (typed : ValuesHaveTypes program values types) :
    ValueHasType program (argumentValue values) (argumentType types) := by
  cases typed with
  | nil => exact .unit
  | cons head tail =>
    cases tail with
    | nil => exact head
    | cons next rest => exact .tuple head (.cons next rest)



/-- Constructor-space coverage constructs an actual first matching clause. No
post-evaluation match result occurs among the admission premises. -/
theorem Covers.selectArm {α : Type} {type : Ty} {arms : List (Pattern × α)} {value : Value}
    (covered : Covers program [type] (arms.map (fun arm => [arm.1])))
    (typed : ValueHasType program value type) :
    ∃ bindings body, selectArm value arms = some (bindings, body) := by
  have lengths : ∀ {values : List Value} {types : List Ty},
      ValuesHaveTypes program values types → values.length = types.length := by
    intro values
    induction values with
    | nil => intro types typed; cases typed; rfl
    | cons value values ih =>
      intro types typed
      cases typed with
      | cons first rest => exact congrArg Nat.succ (ih rest)
  have appendTyped : ∀ {first second : List Value} {front back : List Ty},
      ValuesHaveTypes program first front → ValuesHaveTypes program second back →
      ValuesHaveTypes program (first ++ second) (front ++ back) := by
    intro first
    induction first with
    | nil => intro second front back typed rest; cases typed; exact rest
    | cons value values ih =>
      intro second front back typed rest
      cases typed with
      | cons head tail => exact .cons head (ih tail rest)
  have appendMatching : ∀ (patterns : List Pattern) (values : List Value),
      patterns.length = values.length → ∀ tail rest,
      matchPatterns (patterns ++ tail) (values ++ rest) =
        ((matchPatterns patterns values).bind fun first =>
          (matchPatterns tail rest).bind fun second => some (first ++ second)) := by
    intro patterns
    induction patterns with
    | nil =>
      intro values equal tail rest
      have empty : values = [] := by simpa using equal.symm
      subst values
      simp [matchPatterns]
    | cons pattern patterns ih =>
      intro values equal tail rest
      cases values with
      | nil => simp at equal
      | cons value values =>
        have lengths : patterns.length = values.length := by simpa using equal
        simp only [List.cons_append, matchPatterns]
        rw [ih values lengths]
        cases head : pattern.matchValue value <;>
          cases front : matchPatterns patterns values <;>
          cases back : matchPatterns tail rest <;>
          simp [List.append_assoc]
  have literalFields : ∀ (expected actual : List Value) (bindings : List (String × Value)),
      matchPatterns (expected.map (Pattern.literal none)) actual = some bindings → expected = actual := by
    intro expected
    induction expected with
    | nil =>
      intro actual bindings matched
      cases actual with
      | nil => rfl
      | cons head tail => simp [matchPatterns] at matched
    | cons expected rest ih =>
      intro actual bindings matched
      cases actual with
      | nil => simp [matchPatterns] at matched
      | cons value values =>
        simp only [List.map_cons, matchPatterns, Pattern.matchValue] at matched
        split at matched
        next same =>
          subst value
          have tailMatch : matchPatterns (rest.map (Pattern.literal none)) values = some bindings := by
            simpa using matched
          have sameTail := ih values bindings tailMatch
          subst values
          rfl
        next different => simp at matched
  have valueExt : ∀ (left right : Value), left.head = right.head → left.children = right.children → left = right := by
    intro left right heads children
    cases left <;> cases right <;> simp_all [Value.head, Value.children]
  have matrixSound : ∀ {types : List Ty} {rows : List (List Pattern)}, Covers program types rows →
      ∀ values, ValuesHaveTypes program values types →
      ∃ row ∈ rows, ∃ bindings, matchPatterns row values = some bindings := by
    intro types rows coverage
    induction coverage with
    | done contained =>
      intro values typed
      cases typed
      exact ⟨[], contained, [], by simp [matchPatterns]⟩
    | @split type types rows branches ih =>
      intro values typed
      cases typed with
      | @cons _ value values _ _ first rest =>
        obtain ⟨fields, headTyped, childrenTyped⟩ := ValueHasType.decompose first
        obtain ⟨row, included, bindings, matched⟩ :=
          ih _ fields headTyped _ (appendTyped childrenTyped rest)
        obtain ⟨original, originalIncluded, specialized⟩ := List.mem_filterMap.mp included
        cases original with
        | nil => simp [specializeRow] at specialized
        | cons pattern patterns =>
          simp only [specializeRow, Option.map_eq_some_iff] at specialized
          obtain ⟨front, frontSelected, sameRow⟩ := specialized
          subst row
          have frontLength : front.length = value.children.length := by
            have normalized : front.length = fields.length := by
              cases pattern with
              | wildcard => simp [Pattern.specialize] at frontSelected; subst front; simp
              | binder name => simp [Pattern.specialize] at frontSelected; subst front; simp
              | node head children =>
                simp only [Pattern.specialize] at frontSelected
                split at frontSelected <;> simp_all
              | literal type expected =>
                simp only [Pattern.specialize] at frontSelected
                split at frontSelected
                next selected =>
                  have same := Option.some.inj frontSelected
                  subst front
                  simpa using selected.2
                next impossible => contradiction
            exact normalized.trans (lengths childrenTyped).symm
          rw [appendMatching front value.children frontLength] at matched
          simp only [Option.bind_eq_some_iff] at matched
          obtain ⟨firstBindings, firstMatched, restBindings, restMatched, _⟩ := matched
          have originalMatches : ∃ result, pattern.matchValue value = some result := by
            cases pattern with
            | wildcard => exact ⟨[], by simp [Pattern.matchValue]⟩
            | binder name => exact ⟨[(name, value)], by simp [Pattern.matchValue]⟩
            | node head children =>
              simp only [Pattern.specialize] at frontSelected
              split at frontSelected
              next selected =>
                have sameChildren := Option.some.inj frontSelected
                subst front
                exact ⟨firstBindings, by simpa [Pattern.matchValue, selected.1] using firstMatched⟩
              next impossible => contradiction
            | literal type expected =>
              simp only [Pattern.specialize] at frontSelected
              split at frontSelected
              next selected =>
                have sameFront := Option.some.inj frontSelected
                subst front
                have childrenEqual := literalFields expected.children value.children firstBindings firstMatched
                have equal := valueExt expected value selected.1 childrenEqual
                exact ⟨[], by simp [Pattern.matchValue, equal]⟩
              next impossible => contradiction
          obtain ⟨headBindings, headMatched⟩ := originalMatches
          exact ⟨pattern :: patterns, originalIncluded, headBindings ++ restBindings,
            by simp [matchPatterns, headMatched, restMatched]⟩
  obtain ⟨row, included, bindings, matched⟩ := matrixSound covered [value] (.cons typed .nil)
  obtain ⟨arm, armIncluded, sameRow⟩ := List.mem_map.mp included
  subst row
  have armMatches : arm.1.matchValue value ≠ none := by
    intro missing
    simp [matchPatterns, missing] at matched
  have noneMeansMissing : ∀ (arms : List (Pattern × α)), Grounded.selectArm value arms = none →
      ∀ arm ∈ arms, arm.1.matchValue value = none := by
    intro arms
    induction arms with
    | nil => simp
    | cons first rest ih =>
      intro missing arm included
      simp only [Grounded.selectArm] at missing
      cases selected : first.1.matchValue value with
      | some found => simp [selected] at missing
      | none =>
        simp only [selected] at missing
        rcases List.mem_cons.mp included with same | later
        · subst arm; exact selected
        · exact ih missing arm later
  cases selected : Grounded.selectArm value arms with
  | none => exact False.elim (armMatches (noneMeansMissing arms selected arm armIncluded))
  | some result => exact ⟨result.1, result.2, rfl⟩


end Grounded

/- Section: ElaborationArmsExecution -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {phase : Phase} {home : Module}

/-- Packing arguments commutes with the producer’s concrete source image. -/
@[simp] theorem argumentResult_source (results : List (Result phase)) (executable : phase = .executable) :
    (argumentResult results).source executable = Grounded.argumentResult (sourceResults results executable) := by
  subst phase
  cases results with
  | nil => rfl
  | cons first rest =>
    cases rest with
    | nil => rfl
    | cons second tail =>
      simp [argumentResult, Grounded.argumentResult, sourceResults, Result.source,
        Payload.source, Payload.aggregate, List.map_map, Function.comp_def]
      exact congrArg (List.cons first.payload.meaning)
        (congrArg (List.cons second.payload.meaning) (List.map_map ..))

theorem ExecutesArms.empty {before after : Point program phase} {held : List (Payload phase)}
    {subject result : Result phase} : ExecutesArms before held subject result [] after := by
  intro executable interpretation environment values value bindings body state subjectTyped selected
  simp [selectArm] at selected

/-- Dormant clauses are skipped by the existing matcher; their checking-only body never runs. -/
theorem ExecutesArms.dormant
    {before after : Point program phase} {held : List (Payload phase)}
    {subject result : Result phase} {previous : List Pattern} {pattern : Pattern} {body : Core}
    {rest : List (Pattern × Core)} {expected : Option Ty}
    {patternAfter bodyAfter cleaned : Point program .checking}
    {bindings : List (String × Result .checking)} {hypotheticalResult : Result .checking}
    (patternTyped : PatternProduces program home .checking (held.map Payload.erase)
      (declareInput (program := program) before.checked subject.type).1 pattern
      (declareInput (program := program) before.checked subject.type).2 bindings patternAfter)
    (impossible : patternTyped.ImpossibleAgainst subject.payload.checked)
    (interpreted : subject.Interpreted before)
    (_useful : Useful program subject.type previous pattern)
    (_bodyTyped : HasType program .checking home (patternBodyPoint patternAfter bindings)
      (held.map Payload.erase) body.source hypotheticalResult bodyAfter body.plan expected)
    (_resultType : hypotheticalResult.type = result.type)
    (_cleanup : CleanupStep program bodyAfter cleaned (held.map Payload.erase ++ [hypotheticalResult.payload]) bindings.length)
    (_tailTyped : ArmsType program phase home before held subject result (previous ++ [pattern]) rest after expected)
    (_bodyExecutes : Executes (patternBodyPoint patternAfter bindings) (held.map Payload.erase)
      body.source hypotheticalResult bodyAfter body.plan)
    (tailExecutes : ExecutesArms before held subject result rest after) :
    ExecutesArms before held subject result ((pattern, body) :: rest) after := by
  intro executable interpretation environment values value actualBindings actualBody state subjectTyped selected
  have missed := patternTyped.impossibleAgainstNoMatch impossible (interpreted executable)
    subjectTyped.resident subjectTyped.corresponds
  have selectedTail : selectArm value rest = some (actualBindings, actualBody) := by
    simpa only [selectArm, missed] using selected
  obtain ⟨resultValue, consumed, localAfter, final, last, consumption, evaluated, cleanup,
    resultTyped, finalTyped, progress⟩ := tailExecutes executable state subjectTyped selectedTail
  exact ⟨resultValue, consumed, localAfter, final, last, .miss missed consumption, evaluated,
    cleanup, resultTyped, finalTyped, progress⟩

/-- Consume the exact pattern product before preparing locals, then clean and join its body state. -/
theorem ExecutesArms.clause
    {before patternAfter prepared bodyAfter cleaned after : Point program phase}
    {held : List (Payload phase)} {subject result : Result phase} {previous : List Pattern}
    {pattern : Pattern} {body : Core} {rest : List (Pattern × Core)}
    {bindings : List (String × Result phase)} {expected : Option Ty}
    (patternTyped : PatternProduces program home phase held before pattern subject bindings patternAfter)
    (_distinct : (bindings.map Prod.fst).Nodup)
    (_useful : Useful program subject.type previous pattern)
    (prepare : PrepareStep program patternAfter prepared
      (bindings.map fun entry => (entry.1, ⟨entry.2.type, false, .full⟩)) (bindings.map Prod.snd))
    (_bodyTyped : HasType program phase home prepared held body.source result bodyAfter body.plan expected)
    (cleanup : CleanupStep program bodyAfter cleaned (held ++ [result.payload]) bindings.length)
    (_stable : PointsStable bodyAfter cleaned)
    (joined : JoinStep program cleaned after)
    (_tailTyped : ArmsType program phase home before held subject result (previous ++ [pattern]) rest after expected)
    (bodyExecutes : Executes prepared held body.source result bodyAfter body.plan)
    (tailExecutes : ExecutesArms before held subject result rest after) :
    ExecutesArms before held subject result ((pattern, body) :: rest) after := by
  intro executable
  subst phase
  intro interpretation environment values value actualBindings actualBody state subjectTyped selected
  cases matched : pattern.matchValue value with
  | none =>
    have selectedTail : selectArm value rest = some (actualBindings, actualBody) := by
      simpa only [selectArm, matched] using selected
    obtain ⟨resultValue, consumed, localAfter, final, last, consumption, evaluated, cleaning,
      resultTyped, finalTyped, progress⟩ := tailExecutes rfl state subjectTyped selectedTail
    exact ⟨resultValue, consumed, localAfter, final, last, .miss matched consumption, evaluated,
      cleaning, resultTyped, finalTyped, progress⟩
  | some residents =>
    have selectedHead : (residents, body) = (actualBindings, actualBody) := by
      simpa only [selectArm, matched, Option.some.injEq] using selected
    cases selectedHead
    obtain ⟨consumed, consumedTrace, consumption, bindingsTyped, consumedTyped, consumedProgress⟩ :=
      patternTyped.consume state subjectTyped matched
    obtain ⟨preparedMap, preparedTyped, prepareProgress⟩ := consumedTyped.prepareBindings bindingsTyped
    have preparedSource : prepared.source rfl =
        Grounded.Context.prepare (patternBindings (bindingSources bindings rfl))
          ((bindingSources bindings rfl).map Prod.snd) (patternAfter.source rfl) := by
      simpa only [patternBindings, bindingSources, sourceResults, List.map_map, Function.comp_def,
        Result.source] using prepare.actual rfl
    rw [← preparedSource] at preparedTyped prepareProgress
    obtain ⟨resultValue, localAfter, last, evaluated, resultTyped, localTyped, bodyProgress⟩ :=
      bodyExecutes rfl preparedTyped
    obtain ⟨final, trace, cleaning, cleanedTyped⟩ := cleanup.cleanup rfl
      (by simpa only [sourcePayloads_append, sourcePayloads_singleton] using localTyped)
    have cleanProgress := StateProgress.cleanup (interpretation := last) localTyped.source cleaning
    rw [← (cleanup.source rfl).2] at cleanProgress
    have joinProgress := StateProgress.join (interpretation := last) (environment := final)
      cleanedTyped.source (joined.actual rfl)
    have bodySupply := (evaluated.storage preparedTyped.residents.valid).2.supply
    have preparedSupply : consumed.nextRoot ≤ (consumed.prepare actualBindings).nextRoot := by
      have supply : ∀ (bindings : BindingValues) (environment : Environment),
          environment.nextRoot ≤ (environment.prepare bindings).nextRoot := by
        intro bindings
        induction bindings with
        | nil => intro environment; exact Nat.le_refl _
        | cons first rest ih =>
          intro environment
          exact Nat.le_trans (Nat.le_succ _) (ih (environment.bind first.1 first.2))
      exact supply actualBindings consumed
    have cleanSupply : localAfter.nextRoot ≤ final.nextRoot := by
      simpa only [cleaning.suffix.supply, Environment.retire] using Nat.le_refl localAfter.nextRoot
    have combined := consumedProgress.trans
      (prepareProgress.trans
        (bodyProgress.trans (cleanProgress.trans joinProgress cleanSupply) bodySupply) preparedSupply)
      (by rw [consumption.storage.supply]; exact Nat.le_refl _)
    have finalResult := (resultTyped.transport cleanProgress.history cleanProgress.interpretation).transport
      joinProgress.history joinProgress.interpretation
    have lengths : actualBindings.length = bindings.length := by
      have same := congrArg List.length bindingsTyped.names
      simpa only [bindingSources, List.length_map] using same.symm
    refine ⟨resultValue, consumed, localAfter, final, last, .hit matched consumption, evaluated,
      ⟨trace, ?_⟩, finalResult, ?_, combined⟩
    · rw [lengths]; exact cleaning
    · simpa only [sourcePayloads_append, sourcePayloads_singleton] using cleanedTyped.join (joined.actual rfl)

/-- Normalization and coverage select an actual arm, preserving the packed argument custody. -/
theorem Executes.applyPatterns
    {before middle after : Point program phase} {held : List (Payload phase)}
    {inputs : List Ty} {arguments : List Expr} {argumentTypes : List (Result phase)}
    {arms : List (PatternSource × Expr)} {result : Result phase}
    {argumentPlans : List CorePlan} {armPlans : List (PatternPlan × CorePlan)} {expected : Option Ty}
    (argumentsTyped : HasTypes program phase home before held arguments argumentTypes middle argumentPlans (some inputs))
    (_nonempty : arms ≠ [])
    (constants : ArmConstantsTyped program phase home arms armPlans)
    (covered : ∀ normalized, NormalizesArms program arms armPlans normalized →
      Covers program [argumentType inputs] (normalized.map fun arm => [arm.1]))
    (_bodies : ∀ normalized, NormalizesArms program arms armPlans normalized →
      ArmsType program phase home middle held (argumentResult argumentTypes) result [] normalized after expected)
    (argumentsExecutes : ExecutesList before held arguments argumentTypes middle argumentPlans)
    (bodiesExecute : ∀ normalized, NormalizesArms program arms armPlans normalized →
      ExecutesArms middle held (argumentResult argumentTypes) result normalized after) :
    Executes before held (.applyPatterns inputs arguments arms) result after (.patterns argumentPlans armPlans) := by
  intro executable interpretation environment values state
  obtain ⟨normalized, normalization⟩ := constants.normalizes
  obtain ⟨residents, middleEnvironment, middleMap, argumentsEval, argumentsResult, pending, argumentProgress⟩ :=
    argumentsExecutes executable state
  have packed := pending.packArgument argumentsResult
  have subjectTyped := argumentsResult.argument
  have shape : ValueHasType program (argumentValue residents) (argumentType inputs) := by
    simpa only [Grounded.argumentResult_type, sourceResults_types,
      argumentsTyped.expected_types _ rfl] using subjectTyped.resident
  obtain ⟨bindings, body, selected⟩ := (covered normalized normalization).selectArm shape
  have sourceEq := argumentResult_source argumentTypes executable
  have subject : ResultTyped program middleMap (middle.source executable)
      ((argumentResult argumentTypes).source executable) (argumentValue residents) := sourceEq.symm ▸ subjectTyped
  have packedState : StateTyped program middleMap (middle.source executable)
      (sourcePayloads held executable ++ [(argumentResult argumentTypes).payload.source executable])
      middleEnvironment (values ++ [argumentValue residents]) := by
    change StateTyped _ _ _ (sourcePayloads held executable ++
      [((argumentResult argumentTypes).source executable).payload]) _ _
    rw [sourceEq]
    exact packed
  obtain ⟨resultValue, consumed, localAfter, final, last, consumption, evaluated, cleaning,
    resultTyped, finalTyped, progress⟩ := bodiesExecute normalized normalization executable packedState subject selected
  exact ⟨resultValue, final, last, .applyPatterns normalization argumentsEval (pendingResultUsable packed)
    consumption evaluated cleaning (pendingResultUsable finalTyped), resultTyped, finalTyped,
    argumentProgress.trans progress (argumentsEval.storage state.residents.valid).2.supply⟩

end Grounded.Elaboration

/- Section: ElaborationErasure -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {phase : Phase} {home : Module}

@[simp] theorem Payload.erase_id (p : Payload .checking) : p.erase = p := by
  cases p with | mk checked meaning => cases meaning; rfl
@[simp] theorem Payload.erase_twice (p : Payload phase) : p.erase.erase = p.erase := rfl
@[simp] theorem erasedPayloads_twice (ps : List (Payload phase)) :
    (ps.map Payload.erase).map Payload.erase = ps.map Payload.erase := by simp
@[simp] theorem Result.erase_type (r : Result phase) : r.erase.type = r.type := rfl
@[simp] theorem Result.erase_payload (r : Result phase) : r.erase.payload = r.payload.erase := rfl
@[simp] theorem checkedPayloads_erase (ps : List (Payload phase)) :
    checkedPayloads (ps.map Payload.erase) = checkedPayloads ps := by
  simp [checkedPayloads, Payload.erase]
@[simp] theorem checkedResults_erase (rs : List (Result phase)) :
    checkedResults (rs.map Result.erase) = checkedResults rs := by simp [checkedResults]
@[simp] theorem resultTypes_erase (rs : List (Result phase)) :
    (rs.map Result.erase).map Result.type = rs.map Result.type := by simp
@[simp] theorem resultPayloads_erase (rs : List (Result phase)) :
    (rs.map Result.erase).map Result.payload = (rs.map Result.payload).map Payload.erase := by simp
@[simp] theorem argumentResult_erase (rs : List (Result phase)) :
    argumentResult (rs.map Result.erase) = (argumentResult rs).erase := by
  cases rs with
  | nil => rfl
  | cons a rs => cases rs with
    | nil => rfl
    | cons b rs => simp [argumentResult, Result.erase, Payload.erase, Payload.aggregate, Function.comp_def]

private theorem checkingRequired {condition : Phase.checking = .executable → Prop} :
    Required .checking condition := fun executable => nomatch executable
private theorem checkingStable {before after : Point program .checking} : PointsStable before after := checkingRequired

theorem BindStep.erase {before after : Point program phase} {name : String} {mutable : Bool} {result : Result phase}
    (step : BindStep program before after name mutable result) :
    BindStep program before.erase after.erase name mutable result.erase := ⟨step.checked, checkingRequired⟩
theorem PrepareStep.erase {before after : Point program phase} {parameters : List (String × BindingType)} {arguments : List (Result phase)}
    (step : PrepareStep program before after parameters arguments) :
    PrepareStep program before.erase after.erase parameters (arguments.map Result.erase) :=
  ⟨by simpa using step.checked, checkingRequired⟩
theorem ResultEvidence.erase {before after : Point program phase} {result : Result phase}
    (e : ResultEvidence program before after result) : ResultEvidence program before.erase after.erase result.erase :=
  ⟨e.typed, checkingRequired, checkingStable⟩
theorem HideStep.erase {before after : Point program phase} (step : HideStep program before after) :
    HideStep program before.erase after.erase := ⟨step.checked, checkingStable, checkingRequired⟩
theorem ResumeStep.erase {caller callee after : Point program phase} (step : ResumeStep program caller callee after) :
    ResumeStep program caller.erase callee.erase after.erase := ⟨step.checked, checkingStable, checkingRequired⟩
theorem JoinStep.erase {before after : Point program phase} (step : JoinStep program before after) :
    JoinStep program before.erase after.erase :=
  ⟨step.names, step.storage, step.loans, step.ended, step.binders, step.symbols, checkingStable, checkingRequired⟩
def EndingStep.erase {before after : Point program phase} {held : List (Payload phase)} {slot : Nat} {fields : List Nat}
    (step : EndingStep program before after held slot fields) :
    EndingStep program before.erase after.erase (held.map Payload.erase) slot fields :=
  ⟨step.binding, step.symbol, step.referent, step.mode, step.selected, step.handle,
    by simpa using step.permitted, step.updated, checkingStable, checkingRequired⟩
def WriteStep.erase {before after : Point program phase} {held : List (Payload phase)} {place : AccessPlace} {result : Result phase}
    (step : WriteStep program home before after held place result) :
    WriteStep program home before.erase after.erase (held.map Payload.erase) place result.erase :=
  ⟨step.target, step.parent, step.slot, step.state, step.old, step.updatedPayload,
    step.access, step.permitted, step.stored, step.mask, step.selected, step.discard,
    by simpa [checkedPayloads, Payload.erase, Result.erase, Function.comp_def] using step.unprotected,
    step.ready, step.written, step.updated, checkingStable, checkingRequired⟩
def ProjectionStep.erase {before after : Point program phase} {held : List (Payload phase)} {parent result : Result phase} {key : FieldKey}
    (step : ProjectionStep program home before after held parent key result) :
    ProjectionStep program home before.erase after.erase (held.map Payload.erase) parent.erase key result.erase :=
  ⟨step.index, step.remainder, step.selected, step.source, step.cleared, step.discard,
    by simpa [checkedPayloads, Payload.erase, Result.erase, Function.comp_def] using step.disposable,
    step.updated, checkingStable, checkingRequired⟩
theorem ReturnStep.erase {before : Point program phase} {arguments : List (Result phase)} {result : Result phase}
    (step : ReturnStep program before arguments result) :
    ReturnStep program before.erase (arguments.map Result.erase) result.erase where
  checked := by
    rcases step.checked with free | ⟨capacity, origins⟩
    · exact .inl free
    · refine .inr ⟨by simpa [Result.erase, Payload.erase, Function.comp_def] using capacity, ?_⟩
      intro reference occurs
      obtain ⟨argument, member, ancestor, active, derived⟩ := origins reference occurs
      exact ⟨argument.erase, List.mem_map.mpr ⟨argument, member, rfl⟩, ancestor, active, derived⟩
  actual := checkingRequired

mutual
/-- Structural computation keeps expression and plan indices unchanged. Phase
erasure only discards actual-world evidence and recursively erases selected
products; dormant checking bodies are retained rather than reconstructed. -/
def HasType.erase {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
    {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty}
    (product : HasType program phase home before held expression result after plan expected) :
    HasType program .checking home before.erase (held.map Payload.erase) expression result.erase after.erase plan expected := by
  match product with
  | .unit => exact .unit
  | .integer fits => exact .integer fits
  | .character valid => exact .character valid
  | .group body => exact .group body.erase
  | @HasType.read _ phase home before after held place selected result selection sameType copy evidence actual =>
    exact .read (selected := selected.erase) selection sameType copy evidence.erase checkingRequired
  | .move selection available free cleared updated evidence actual =>
    exact .move selection available free cleared updated evidence.erase checkingRequired
  | .implicitMove body noncopy => exact .implicitMove body.erase noncopy
  | .borrow access ready stored selected available finite permitted produced updated evidence actual =>
    exact .borrow access ready stored selected available finite permitted produced updated evidence.erase checkingRequired
  | .reborrow body type => exact .reborrow body.erase type
  | @HasType.dereference _ phase home before after held reference fields target parent selected result slot access ready stored provenance permission available permitted sameType copy evidence actual =>
    exact .dereference (selected := selected.erase) access ready stored provenance permission available permitted sameType copy evidence.erase checkingRequired
  | .moveIndirect access ready permitted stored selected available cleared updated evidence actual =>
    exact .moveIndirect access ready permitted stored selected available cleared updated evidence.erase checkingRequired
  | @HasType.tuple _ phase home before middle after held h t first rest hp tp expected contextual head tail supported =>
    simpa [Result.erase, Payload.erase, Payload.aggregate, Function.comp_def] using
      HasType.tuple (rest := rest.map Result.erase) (by simpa only [resultTypes_erase, Result.erase_type] using contextual) head.erase (by simpa only [List.map_append, List.map_cons, List.map_nil, resultTypes_erase, Result.erase_payload] using tail.erase) (by simpa only [resultTypes_erase, Result.erase_type] using supported)
  | .array contextual body types finite size =>
    simpa [Result.erase, Payload.erase, Payload.aggregate, Function.comp_def] using
      HasType.array contextual body.erase (by simpa only [resultTypes_erase] using types) finite size
  | @HasType.construct _ phase home before after held identity tag fields results plans shape visible body finite capability =>
    simpa [Result.erase, Payload.erase, Payload.aggregate, Function.comp_def] using
      HasType.construct (results := results.map Result.erase) (by simpa only [resultTypes_erase] using shape) visible (by simpa only [resultTypes_erase] using body.erase) finite capability
  | .view view body => exact .view view.erase body.erase
  | .sequence head dispose tail => exact .sequence head.erase dispose.erase tail.erase
  | .bind initial annotated binding body cleanup stable =>
    exact .bind initial.erase annotated binding.erase body.erase (by simpa using cleanup.erase) checkingStable
  | .constant declared visible resolved structural hidden body resume referenceFree interpreted empty =>
    exact .constant declared visible resolved structural hidden.erase body.erase resume.erase referenceFree checkingRequired checkingRequired
  | .field body projection evidence => exact .field body.erase projection.erase evidence.erase
  | .call declared visible distinct initialized inputs hide prepare body resultType origin cleanup resume stable =>
    exact .call declared visible distinct initialized inputs.erase hide.erase prepare.erase body.erase resultType origin.erase (by simpa using cleanup.erase) resume.erase checkingStable
  | .assign resident write continued => exact .assign resident.erase write.erase continued.erase
  | .assignIndirect resident write continued => exact .assignIndirect resident.erase write.erase continued.erase
  | .endOwn ending body => exact .endOwn ending.erase body.erase
  | .endAfter body ending => exact .endAfter body.erase (by simpa using ending.erase)
  | .raiseSupply body larger checked stable actual => exact .raiseSupply body.erase larger checked checkingStable checkingRequired
  | .applyPatterns arguments nonempty constants covered bodies =>
    exact .applyPatterns arguments.erase nonempty constants.erase covered
      (fun normalized normalization => by simpa using (bodies normalized normalization).erase)
  | .expectedField body => exact .expectedField body.erase
  | .expectedDereference body => exact .expectedDereference body.erase
  | .expectedMoveIndirect body => exact .expectedMoveIndirect body.erase
  | .expectedMove body => exact .expectedMove body.erase
  | .expectedBorrow body => exact .expectedBorrow body.erase
  | .expectedCall body => exact .expectedCall body.erase
  | .expectedData body atomic notReference => exact .expectedData body.erase atomic notReference
termination_by structural product

def HasTypes.erase {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
    {expressions : List Expr} {results : List (Result phase)} {plans : List CorePlan} {expected : Option (List Ty)}
    (product : HasTypes program phase home before held expressions results after plans expected) :
    HasTypes program .checking home before.erase (held.map Payload.erase) expressions (results.map Result.erase) after.erase plans expected := by
  match product with
  | .nil => exact .nil
  | .expectedNil => exact .expectedNil
  | .cons first rest => exact .cons first.erase (by simpa using rest.erase)
  | .expectedCons first rest => exact .expectedCons first.erase (by simpa using rest.erase)
termination_by structural product

def ArmsType.erase {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
    {subject result : Result phase} {previous : List Pattern} {arms : List (Pattern × Core)} {expected : Option Ty}
    (product : ArmsType program phase home before held subject result previous arms after expected) :
    ArmsType program .checking home before.erase (held.map Payload.erase) subject.erase result.erase previous arms after.erase expected := by
  match product with
  | @ArmsType.dormant _ phase home before after held subject result previous pat core rest expected patternAfter bodyAfter cleaned bindings hypotheticalResult pattern impossible interpreted useful body resultType cleanup tail =>
    have build := @ArmsType.dormant program .checking home before.erase after.erase (held.map Payload.erase)
      subject.erase result.erase previous pat core rest expected patternAfter bodyAfter cleaned bindings hypotheticalResult
    rw [erasedPayloads_twice] at build
    exact build pattern impossible checkingRequired useful body resultType cleanup tail.erase
  | .empty => exact .empty
  | .clause pattern distinct useful prepare body cleanup stable joined tail =>
    apply ArmsType.clause pattern.erase (by simpa using distinct) useful
    · simpa [bindingErase, Function.comp_def] using prepare.erase
    · exact body.erase
    · simpa [bindingErase] using cleanup.erase
    · exact checkingStable
    · exact joined.erase
    · exact tail.erase
termination_by structural product

def PatternConstantsTyped.erase {phase : Phase} {home : Module} {pattern : PatternSource} {plan : PatternPlan}
    (product : PatternConstantsTyped program phase home pattern plan) :
    PatternConstantsTyped program .checking home pattern plan := by
  match product with
  | .wildcard => exact .wildcard
  | .binder name => exact .binder name
  | .node source constants => exact .node source constants.erase
  | .constant beforeEmpty actualEmpty typed => exact .constant beforeEmpty checkingRequired typed.erase
termination_by structural product

def PatternsConstantsTyped.erase {phase : Phase} {home : Module} {patterns : List PatternSource} {plans : List PatternPlan}
    (product : PatternsConstantsTyped program phase home patterns plans) :
    PatternsConstantsTyped program .checking home patterns plans := by
  match product with
  | .nil => exact .nil
  | .cons head tail => exact .cons head.erase tail.erase
termination_by structural product

def ArmConstantsTyped.erase {phase : Phase} {home : Module} {arms : List (PatternSource × Expr)} {plans : List (PatternPlan × CorePlan)}
    (product : ArmConstantsTyped program phase home arms plans) :
    ArmConstantsTyped program .checking home arms plans := by
  match product with
  | .nil => exact .nil
  | .cons head tail => exact .cons head.erase tail.erase
termination_by structural product
end

/-- Equality with the computed checking product, not mere agreement of indices. -/
def HasType.ErasesTo {before after : Point program phase} {held : List (Payload phase)}
    {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty}
    (actual : HasType program phase home before held expression result after plan expected)
    (chosen : HasType program .checking home before.erase (held.map Payload.erase)
      expression result.erase after.erase plan expected) : Prop := actual.erase = chosen


end Grounded.Elaboration

/- Section: ElaborationSourceImport -/
namespace Grounded.Elaboration
set_option autoImplicit false

namespace SourceImport

def symbols : Symbols where
  reference := fun reference => match reference with
    | .existing node => node
    | _ => 0
  binder := id

def base : OriginBase → Checked.Base
  | .binder identity => .binder identity

def address (origin : Origin) : Checked.Address := ⟨base origin.base, origin.fields⟩

def loan (entry : SourceLoan × Nat) : Checked.Loan :=
  ⟨.existing entry.2, address entry.1.target, entry.1.referent, entry.1.mode,
    entry.1.parent.map Checked.Reference.existing⟩


def ended (entry : SourceLoan × Nat) : Checked.Payload :=
  if entry.1.own then .plain
  else .reference (.existing entry.2) entry.1.referent entry.1.mode

/-- Schema owners use canonical root identities, never argument identities. -/
def owner : OriginBase → Nat
  | .binder identity => identity

def symbolSupply (source : Grounded.Context) : Nat :=
  source.nextBinder


mutual
inductive PayloadProduced (program : Program) (ownerId : Nat) :
    List Checked.Component → Initialization → SourcePayload → Ty → Checked.Payload → Prop where
  | plain {path : List Checked.Component} {state : Initialization} {type : Ty}
      (notHandle : state.Complete → ∀ referent mode, type ≠ .reference referent mode) :
      PayloadProduced program ownerId path state .plain type (.schema ownerId path type [] .referenceFree)
  | reference (path : List Checked.Component) (state : Initialization) (node : Nat) (referent : Ty) (mode : BorrowMode) :
      PayloadProduced program ownerId path state (.reference node) (.reference referent mode)
        (.reference (.existing node) referent mode)
  | aggregate {path : List Checked.Component} {state : Initialization} {head : Head} {type : Ty} {types : List Ty}
      {concrete : List SourcePayload} {checked : List Checked.Payload}
      (source : head.Source) (shape : HeadType program head type types)
      (fields : PayloadsProduced program ownerId
        (fun index => path ++ [.constructor head, .field index]) state.child concrete types checked) :
      PayloadProduced program ownerId path state (.aggregate head concrete) type (.aggregate head checked)
inductive PayloadsProduced (program : Program) (ownerId : Nat) :
    (Nat → List Checked.Component) → (Nat → Initialization) → List SourcePayload → List Ty → List Checked.Payload → Prop where
  | nil (paths : Nat → List Checked.Component) (states : Nat → Initialization) :
      PayloadsProduced program ownerId paths states [] [] []
  | cons {paths : Nat → List Checked.Component} {states : Nat → Initialization}
      {concrete : SourcePayload} {concretes : List SourcePayload}
      {type : Ty} {types : List Ty} {checked : Checked.Payload} {checks : List Checked.Payload}
      (first : PayloadProduced program ownerId (paths 0) (states 0) concrete type checked)
      (rest : PayloadsProduced program ownerId (fun index => paths (index + 1))
        (fun index => states (index + 1)) concretes types checks) :
      PayloadsProduced program ownerId paths states (concrete :: concretes) (type :: types) (checked :: checks)
end

mutual
theorem PayloadProduced.meaning {program : Program} {state : Initialization} {concrete : SourcePayload}
    {ownerId : Nat} {path : List Checked.Component}
    {type : Ty} {checked : Checked.Payload} (produced : PayloadProduced program ownerId path state concrete type checked) :
    PayloadMeaning program symbols state checked type concrete := by
  cases produced with
  | plain notHandle => exact .schemaPlain (.inl rfl) notHandle
  | reference => exact .reference ..
  | aggregate source shape fields => exact .aggregate source shape fields.meaning
theorem PayloadsProduced.meaning {program : Program} {states : Nat → Initialization}
    {ownerId : Nat} {paths : Nat → List Checked.Component}
    {concrete : List SourcePayload} {types : List Ty} {checked : List Checked.Payload}
    (produced : PayloadsProduced program ownerId paths states concrete types checked) :
    PayloadMeanings program symbols states checked types concrete := by
  cases produced with
  | nil paths states => exact .nil states
  | cons first rest => exact .cons first.meaning rest.meaning
end

/-- The source cell is the producer input in both phases, not an executable-only
permission to choose a knowledge bit. Its current mask is preserved verbatim. -/
structure Cells (program : Program) (source : Grounded.Context) where
  payload : OriginBase → Grounded.Slot → Checked.Payload
  produced : ∀ origin slot, source.storage origin = some slot →
    PayloadProduced program (owner origin) [] slot.initialization slot.payload slot.type (payload origin slot)

def Cells.slot {program : Program} {source : Grounded.Context}
    (cells : Cells program source) (origin : OriginBase) (slot : Grounded.Slot) : Checked.Slot :=
  ⟨slot.toBindingType, slot.binder, cells.payload origin slot⟩

def Cells.context {program : Program} {source : Grounded.Context}
    (cells : Cells program source) : Checked.Context where
  names := source.names
  storage := fun checked => match checked with
    | .binder identity => (source.storage (.binder identity)).map (cells.slot (.binder identity))
    | .referent _ => none
  loans := source.loans.zipIdx.map loan
  ended := source.loans.zipIdx.map ended
  nextBinder := source.nextBinder
  nextSymbol := symbolSupply source

theorem ended_occurs {program : Program} {entry : SourceLoan × Nat} {reference : Checked.Reference} :
    (ended entry).Occurs program reference ↔
      entry.1.own = false ∧ reference = .existing entry.2 := by
  unfold ended
  cases own : entry.1.own
  · simp only [Bool.false_eq_true, ↓reduceIte]
    constructor
    · intro occurs; cases occurs; exact ⟨trivial, rfl⟩
    · rintro ⟨_, rfl⟩; exact .reference ..
  · simp only [↓reduceIte]
    constructor
    · intro occurs; cases occurs
    · rintro ⟨impossible, _⟩; cases impossible

theorem Cells.notEnded {program : Program} {source : Grounded.Context} (cells : Cells program source)
    {node : Nat} {actual : SourceLoan} (found : source.loans[node]? = some actual) :
    cells.context.NotEnded (program := program) (.existing node) ↔ actual.own = true := by
  constructor
  · intro available
    cases own : actual.own with
    | true => rfl
    | false =>
      have member : (actual, node) ∈ source.loans.zipIdx := List.mem_zipIdx_iff_getElem?.mpr found
      exact False.elim (available (ended (actual, node)) (List.mem_map.mpr ⟨_, member, rfl⟩)
        (ended_occurs.mpr ⟨own, rfl⟩))
  · intro own payload member occurs
    change payload ∈ source.loans.zipIdx.map ended at member
    obtain ⟨entry, indexed, equal⟩ := (List.mem_map (f := ended)).mp member
    subst payload
    obtain ⟨dead, same⟩ := ended_occurs.mp occurs
    have identity : node = entry.2 := Checked.Reference.existing.inj same
    have selected := List.mem_zipIdx_iff_getElem?.mp indexed
    rw [← identity, found] at selected
    have equal := Option.some.inj selected
    exact Bool.noConfusion (own.symm.trans (equal ▸ dead))

@[simp] theorem address_meaning (source : Grounded.Context) (origin : Origin) :
    symbols.address source (address origin) = some origin := by
  cases origin with | mk origin fields => cases origin <;> rfl



theorem Cells.meaning {program : Program} {source : Grounded.Context} (cells : Cells program source) :
    ContextMeaning program symbols cells.context source where
  names := by simp [Cells.context, symbols]
  binders := rfl
  cells := by
    intro checked slot actualBase stored mapped
    cases checked with
    | referent reference => cases mapped
    | binder identity =>
      obtain ⟨actual, found, equal⟩ := Option.map_eq_some_iff.mp stored
      cases equal
      cases mapped
      exact ⟨actual, found, rfl, rfl, rfl, rfl, (cells.produced _ _ found).meaning⟩
  noOpaqueCells := fun _ => rfl
  rootCoverage := by
    intro binder slot stored
    refine ⟨binder, cells.slot (.binder binder) slot, ?_, rfl⟩
    change (source.storage (.binder binder)).map (cells.slot (.binder binder)) = _
    simp only [stored, Option.map_some]
  rootIdentity := by intro first second _ _ same; exact same
  loans := by
    intro imported member
    change imported ∈ source.loans.zipIdx.map loan at member
    obtain ⟨entry, indexed, equal⟩ := (List.mem_map (f := loan)).mp member
    subst imported
    have found := List.mem_zipIdx_iff_getElem?.mp indexed
    refine ⟨entry.1, found, address_meaning source entry.1.target, rfl, rfl, ?_, ?_⟩
    · simp [loan, symbols, Option.map_map, Function.comp_def]
    · exact (cells.notEnded found).symm

/-- Import uses each existing source root and loan identity exactly once. No
referent mirror, ownership grant, alias injectivity, or runtime premise is added. -/
def Cells.point {program : Program} {source : Grounded.Context} (cells : Cells program source) :
    Point program .executable := ⟨cells.context, ⟨source, symbols, cells.meaning⟩⟩

@[simp] theorem Cells.point_source {program : Program} {source : Grounded.Context}
    (cells : Cells program source) : cells.point.source rfl = source := rfl

theorem Cells.loan_found {program : Program} {source : Grounded.Context} (cells : Cells program source)
    {node : Nat} {actual : SourceLoan} (found : source.loans[node]? = some actual) :
    cells.context.loan (.existing node) = some (loan (actual, node)) := by
  have member : loan (actual, node) ∈ cells.context.loans :=
    List.mem_map.mpr ⟨_, List.mem_zipIdx_iff_getElem?.mpr found, rfl⟩
  cases selected : cells.context.loan (.existing node) with
  | none =>
    have absent := List.find?_eq_none.mp selected _ member
    exact False.elim (absent (by simp [loan]))
  | some imported =>
    have same := List.find?_some selected
    have included := List.mem_of_find?_eq_some selected
    change imported ∈ source.loans.zipIdx.map loan at included
    obtain ⟨entry, indexed, equal⟩ := (List.mem_map (f := loan)).mp included
    subst imported
    have identity : entry.2 = node := by simpa [loan] using same
    have actualFound := List.mem_zipIdx_iff_getElem?.mp indexed
    rw [identity, found] at actualFound
    have actualSame := Option.some.inj actualFound
    cases entry with
    | mk other index =>
      dsimp at identity actualSame
      subst index
      subst other
      rfl

theorem Cells.referenceTarget {program : Program} {source : Grounded.Context} (cells : Cells program source)
    {node : Nat} {actual : SourceLoan} (found : source.loans[node]? = some actual) :
    cells.context.referenceTarget (.existing node) = address actual.target := by
  simp only [Checked.Context.referenceTarget, cells.loan_found found]
  rfl

theorem Cells.no_opaque_target {program : Program} {source : Grounded.Context} (cells : Cells program source)
    {node : Nat} {actual : SourceLoan} (found : source.loans[node]? = some actual)
    (reference : Checked.Reference) (fields : List Nat) :
    cells.context.referenceTarget (.existing node) ≠ ⟨.referent reference, fields⟩ := by
  rw [cells.referenceTarget found]
  cases targetBase : actual.target.base <;> simp [address, base, targetBase]


mutual
theorem PayloadProduced.uncertain {program : Program} {state : Initialization} {source : SourcePayload}
    {ownerId : Nat} {path : List Checked.Component}
    {type : Ty} {checked : Checked.Payload} (produced : PayloadProduced program ownerId path state source type checked) :
    PayloadProduced program ownerId path .maybe source type checked := by
  cases produced with
  | plain _ => exact .plain (by intro complete; cases complete)
  | reference => exact .reference ..
  | aggregate source shape fields => exact .aggregate source shape fields.uncertain
theorem PayloadsProduced.uncertain {program : Program} {states : Nat → Initialization}
    {ownerId : Nat} {paths : Nat → List Checked.Component}
    {source : List SourcePayload} {types : List Ty} {checked : List Checked.Payload}
    (produced : PayloadsProduced program ownerId paths states source types checked) :
    PayloadsProduced program ownerId paths (fun _ => .maybe) source types checked := by
  cases produced with
  | nil => exact .nil _ _
  | cons first rest => exact .cons first.uncertain rest.uncertain
end

theorem aggregate_fields {program : Program} {loans : List SourceLoan} {head : Head}
    {payloads : List SourcePayload} {type : Ty} {types : List Ty}
    (typed : SourcePayload.Typed program loans (.aggregate head payloads) type)
    (shape : HeadType program head type types) : PayloadsTyped program loans payloads types := by
  cases typed with
  | aggregate _ actual fields =>
    cases actual.fields_unique shape
    exact fields


theorem payloadProduced_of_resident {program : Program} {node : Nat → Nat} {loans : List SourceLoan}
    {ownerId : Nat} {path : List Checked.Component}
    {state : Initialization} {value : Value} {type : Ty}
    (resident : ResidentTyped program state value type) {source : SourcePayload}
    (typed : SourcePayload.Typed program loans source type)
    (related : source.Corresponds node value) :
    ∃ checked, PayloadProduced program ownerId path state source type checked := by
  induction resident using ResidentTyped.rec
    (motive_2 := fun states values types _ => ∀ {sources} (paths : Nat → List Checked.Component), PayloadsTyped program loans sources types →
      PayloadsCorrespond node sources values →
      ∃ checked, PayloadsProduced program ownerId paths states sources types checked) generalizing source path with
  | vacant =>
    cases related with
    | plain => exact ⟨_, .plain (by intro complete; cases complete)⟩
    | aggregate source constructor children =>
      subst_vars
      cases typed with | aggregate _ shape _ => cases shape
  | uncertain actual permission ih =>
    obtain ⟨checked, produced⟩ := ih (path := path) typed related
    exact ⟨checked, produced.uncertain⟩
  | unit =>
    cases related with
    | plain => exact ⟨_, .plain (by intro _ _ _ equal; cases equal)⟩
    | aggregate source constructor children =>
      subst_vars
      cases children
      exact ⟨_, .aggregate source .unit (.nil _ _)⟩
  | integer fits =>
    cases related with
    | plain => exact ⟨_, .plain (by intro _ _ _ equal; cases equal)⟩
    | aggregate source constructor children =>
      subst_vars
      cases children
      exact ⟨_, .aggregate source (.integer fits) (.nil _ _)⟩
  | character valid =>
    cases related with
    | plain => exact ⟨_, .plain (by intro _ _ _ equal; cases equal)⟩
    | aggregate source constructor children =>
      subst_vars
      cases children
      exact ⟨_, .aggregate source (.character valid) (.nil _ _)⟩
  | reference identity finite =>
    obtain ⟨actual, equal, _⟩ := related.reference_inv
    subst source
    exact ⟨_, .reference ..⟩
  | tuple first rest present firstIH restIH =>
    cases related with
    | plain => exact ⟨_, .plain (by intro _ _ _ equal; cases equal)⟩
    | aggregate source constructor children =>
      subst_vars
      cases children with
      | cons head tail =>
        have fields := aggregate_fields typed (.tuple _ _)
        cases fields with
        | cons firstTyped restTyped =>
          obtain ⟨first, producedFirst⟩ := firstIH (path := path ++ [.constructor .tuple, .field 0]) firstTyped head
          obtain ⟨rest, producedRest⟩ := restIH (fun index => path ++ [.constructor .tuple, .field (index + 1)]) restTyped tail
          exact ⟨_, .aggregate source (.tuple _ _) (.cons producedFirst producedRest)⟩
  | array residents finite size present ih =>
    cases related with
    | plain => exact ⟨_, .plain (by intro _ _ _ equal; cases equal)⟩
    | aggregate source constructor children =>
      subst_vars
      obtain ⟨checked, produced⟩ := ih (fun index => path ++ [.constructor .array, .field index]) (aggregate_fields typed (.array _ _)) children
      exact ⟨_, .aggregate source (.array _ _) produced⟩
  | @nominal state identity tag declaration schema values declared chosen finite residents present ih =>
    cases related with
    | plain => exact ⟨_, .plain (by intro _ _ _ equal; cases equal)⟩
    | aggregate source constructor children =>
      subst_vars
      obtain ⟨checked, produced⟩ := ih (fun index => path ++ [.constructor (.nominal identity tag), .field index]) (aggregate_fields typed (.nominal declared chosen)) children
      exact ⟨_, .aggregate source (.nominal declared chosen) produced⟩
  | nil =>
    rename_i sources paths typed related
    cases related
    exact ⟨[], .nil _ _⟩
  | cons head tail headIH tailIH =>
    rename_i sources paths typed related
    cases related with
    | cons first rest =>
      cases typed with
      | cons firstTyped restTyped =>
        obtain ⟨first, producedFirst⟩ := headIH (path := paths 0) firstTyped first
        obtain ⟨rest, producedRest⟩ := tailIH (fun index => paths (index + 1)) restTyped rest
        exact ⟨_, .cons producedFirst producedRest⟩


theorem cellPayload_exists {program : Program} {interpretation : Interpretation}
    {source : Grounded.Context} {environment : Environment}
    (store : StoreTyped program interpretation source environment)
    (origin : OriginBase) (slot : Grounded.Slot) (found : source.storage origin = some slot) :
    ∃ checked, PayloadProduced program (owner origin) [] slot.initialization slot.payload slot.type checked := by
  cases origin with
  | binder identity =>
    obtain ⟨value, _, resident, related⟩ := store.cells identity slot found
    exact payloadProduced_of_resident resident (store.source.allocated identity slot found).2.2.2 related

/-- Only the current resident store is consumed. No evaluator, later execution,
future callback, or hypothetical source world is used to import its products. -/
noncomputable def Cells.ofStoreTyped {program : Program} {interpretation : Interpretation}
    {source : Grounded.Context} {environment : Environment}
    (store : StoreTyped program interpretation source environment) : Cells program source := by
  classical
  exact {
    payload := fun origin slot => if found : source.storage origin = some slot then
      Classical.choose (cellPayload_exists store origin slot found) else .plain
    produced := by
      intro origin slot found
      rw [dif_pos found]
      exact Classical.choose_spec (cellPayload_exists store origin slot found)
  }

noncomputable def pointOfStore {program : Program} {interpretation : Interpretation}
    {source : Grounded.Context} {environment : Environment}
    (store : StoreTyped program interpretation source environment) : Point program .executable :=
  (Cells.ofStoreTyped store).point

@[simp] theorem pointOfStore_source {program : Program} {interpretation : Interpretation}
    {source : Grounded.Context} {environment : Environment}
    (store : StoreTyped program interpretation source environment) :
    (pointOfStore store).source rfl = source := rfl
/-- External entry checks the declared canonical root type and mask against the
actual resident. Value shape alone does not establish this typing evidence.
Names may omit hidden roots; loans may alias any canonical root/path. All
resource obligations concern the current state, including the actual pending
values and ended loan history, not a future evaluation. -/
structure CanonicalEntry (program : Program) (interpretation : Interpretation)
    (source : Grounded.Context) (pendingPayloads : List SourcePayload)
    (environment : Environment) (pending : List Value) : Prop where
  sourceValid : source.WellFormed program
  runtimeValid : environment.Valid
  names : environment.bindings = source.names.map (fun entry => (entry.1, interpretation.binder entry.2))
  roots : ∀ binder slot, source.storage (.binder binder) = some slot →
    ∃ value, environment.store (interpretation.binder binder) = some value ∧
      SlotTyped program value slot.toBindingType ∧ slot.Corresponds interpretation value
  binderBound : ∀ binder, source.MentionsBinder binder → interpretation.binder binder < environment.nextRoot
  binderDistinct : ∀ first second, source.MentionsBinder first → source.MentionsBinder second →
    interpretation.binder first = interpretation.binder second → first = second
  nodeOrder : ∀ first second, first < second → second < source.loans.length →
    interpretation.node first < interpretation.node second
  records : ∀ (node : Nat) (loan : SourceLoan), source.loans[node]? = some loan →
    environment.loans[interpretation.node node]? =
      some ⟨interpretation.origin loan.target, loan.parent.map interpretation.node, loan.own, loan.mode⟩
  activeCoverage : ∀ (node : Nat) (loan : Loan), environment.loans[node]? = some loan → loan.own = true →
    ∃ sourceNode sourceLoan, source.loans[sourceNode]? = some sourceLoan ∧ interpretation.node sourceNode = node
  targets : ∀ (node : Nat) (loan : SourceLoan), source.loans[node]? = some loan → loan.own = true →
    source.Target program loan.target loan.referent ∧ (loan.mode = .shared → source.Ready loan.target)
  storedHandles : ∀ root value, environment.store root = some value →
    ∀ path node, value.readIndices path = some (.reference node) → node < environment.loans.length
  pendingShape : PayloadsCorrespond interpretation.node pendingPayloads pending
  pendingOwn : ∀ node ∈ payloadNodes pendingPayloads, source.Own node
  pendingReady : ∀ node ∈ payloadNodes pendingPayloads, source.Restored node
  observedOwn : source.ObservedOwn program
  custody : Custody environment pending

/-- Visible resident typing and correspondence are reconstructed from canonical
root evidence; neither a pre-established StateTyped nor execution is assumed. -/
theorem CanonicalEntry.stateTyped {program : Program} {interpretation : Interpretation}
    {source : Grounded.Context} {pendingPayloads : List SourcePayload}
    {environment : Environment} {pending : List Value}
    (entry : CanonicalEntry program interpretation source pendingPayloads environment pending) :
    StateTyped program interpretation source pendingPayloads environment pending := by
  obtain ⟨residents, slots⟩ := Grounded.Context.reconstruct entry.sourceValid entry.runtimeValid entry.names entry.roots
  exact {
    source := entry.sourceValid
    residents := residents
    slots := slots
    cells := entry.roots
    binderBound := entry.binderBound
    binderDistinct := entry.binderDistinct
    nodeOrder := entry.nodeOrder
    records := entry.records
    activeCoverage := entry.activeCoverage
    sourceTargets := entry.targets
    storeShape := entry.storedHandles
    heldShape := entry.pendingShape
    heldOwn := entry.pendingOwn
    heldReady := entry.pendingReady
    observedOwn := entry.observedOwn
    custody := entry.custody }

/-- The executable producer imports the canonical cells justified by entry
root typing. This is metadata only: it allocates no runtime root or loan. -/
noncomputable def CanonicalEntry.point {program : Program} {interpretation : Interpretation}
    {source : Grounded.Context} {pendingPayloads : List SourcePayload}
    {environment : Environment} {pending : List Value}
    (entry : CanonicalEntry program interpretation source pendingPayloads environment pending) :
    Point program .executable := pointOfStore entry.stateTyped.toStoreTyped

@[simp] theorem CanonicalEntry.point_source {program : Program} {interpretation : Interpretation}
    {source : Grounded.Context} {pendingPayloads : List SourcePayload}
    {environment : Environment} {pending : List Value}
    (entry : CanonicalEntry program interpretation source pendingPayloads environment pending) :
    entry.point.source rfl = source := rfl



theorem PayloadProduced.plain_knowledge {program : Program} {state : Initialization}
    {ownerId : Nat} {path : List Checked.Component}
    {type : Ty} {checked : Checked.Payload} (produced : PayloadProduced program ownerId path state .plain type checked) :
    checked = .schema ownerId path type [] .referenceFree := by
  cases produced
  rfl

theorem Cells.plain_knowledge {program : Program} {source : Grounded.Context} (cells : Cells program source)
    {origin : OriginBase} {slot : Grounded.Slot} (found : source.storage origin = some slot)
    (plain : slot.payload = .plain) : cells.payload origin slot = .schema (owner origin) [] slot.type [] .referenceFree := by
  have produced := cells.produced origin slot found
  rw [plain] at produced
  exact produced.plain_knowledge


mutual
theorem PayloadProduced.typed {program : Program} {state : Initialization} {source : SourcePayload}
    {ownerId : Nat} {path : List Checked.Component}
    {type : Ty} {checked : Checked.Payload} (produced : PayloadProduced program ownerId path state source type checked) :
    checked.Typed program type := by
  cases produced with
  | plain => exact .schema ownerId path _ [] .referenceFree
  | reference => exact .reference ..
  | aggregate source shape fields => exact .aggregate source shape fields.typed
theorem PayloadsProduced.typed {program : Program} {states : Nat → Initialization}
    {ownerId : Nat} {paths : Nat → List Checked.Component}
    {source : List SourcePayload} {types : List Ty} {checked : List Checked.Payload}
    (produced : PayloadsProduced program ownerId paths states source types checked) :
    Checked.PayloadsTyped program checked types := by
  cases produced with
  | nil => exact .nil
  | cons first rest => exact .cons first.typed rest.typed
end

theorem Cells.storage {program : Program} {source : Grounded.Context} (cells : Cells program source)
    (origin : OriginBase) : cells.context.storage (base origin) =
      (source.storage origin).map (cells.slot origin) := by
  cases origin <;> rfl

theorem PayloadsProduced.getElem {program : Program} {ownerId : Nat}
    {paths : Nat → List Checked.Component} {states : Nat → Initialization}
    {sources : List SourcePayload} {types : List Ty} {checks : List Checked.Payload}
    (produced : PayloadsProduced program ownerId paths states sources types checks)
    {index : Nat} {source : SourcePayload} (found : sources[index]? = some source) :
    ∃ type checked, types[index]? = some type ∧ checks[index]? = some checked ∧
      PayloadProduced program ownerId (paths index) (states index) source type checked := by
  induction index generalizing paths states sources types checks with
  | zero =>
    cases produced with
    | nil => simp at found
    | cons first rest =>
      cases Option.some.inj found
      exact ⟨_, _, rfl, rfl, first⟩
  | succ index ih =>
    cases produced with
    | nil => simp at found
    | cons first rest => exact ih rest found

/-- Import preserves the exact selected handle through arbitrary nested source
products. It does not replace the source target with a guessed symbolic owner. -/
theorem PayloadProduced.selectReference {program : Program} {home : Module}
    {type referent : Ty} {mode : BorrowMode} {keys : List FieldKey} {indices : List Nat}
    (path : PathType program home type keys indices (.reference referent mode))
    {ownerId : Nat} {stem : List Checked.Component} {state : Initialization}
    {source : SourcePayload} {checked : Checked.Payload}
    (produced : PayloadProduced program ownerId stem state source type checked)
    {node : Nat} (selected : source.select indices = some (.reference node)) :
    Nonempty (Checked.Payload.Select program home checked type keys indices
      (.reference (.existing node) referent mode) (.reference referent mode)) := by
  induction keys generalizing type indices ownerId stem state source checked with
  | nil =>
    cases path
    cases produced with
    | plain => simp [SourcePayload.select] at selected
    | reference =>
      simp only [SourcePayload.select, Option.some.injEq, SourcePayload.reference.injEq] at selected
      subst node
      exact ⟨.here _ _⟩
    | aggregate => simp [SourcePayload.select] at selected
  | cons key keys ih =>
    cases path with
    | cons projection rest =>
      cases produced with
      | plain => simp [SourcePayload.select] at selected
      | reference => simp [SourcePayload.select] at selected
      | aggregate source shape fields =>
        simp only [SourcePayload.select] at selected
        obtain ⟨child, found, selected⟩ := Option.bind_eq_some_iff.mp selected
        obtain ⟨type, checked, typeFound, checkedFound, produced⟩ := fields.getElem found
        have same := Option.some.inj (typeFound.symm.trans (projection.headType shape).2)
        subst type
        obtain ⟨selection⟩ := ih rest produced selected
        exact ⟨.aggregate projection checkedFound selection⟩

theorem Cells.bindings {program : Program} {source : Grounded.Context}
    (cells : Cells program source) (valid : source.WellFormed program) :
    cells.context.bindings = source.bindings.map
      (fun entry => (entry.1, cells.slot (.binder entry.2.binder) entry.2)) := by
  unfold Checked.Context.bindings Grounded.Context.bindings
  simp only [Cells.context]
  rw [List.map_filterMap]
  apply Grounded.Context.filterMap_congr_mem
  intro entry _
  cases stored : source.storage (.binder entry.2) with
  | none => simp
  | some slot => simp [(valid.allocated entry.2 slot stored).1]

theorem Cells.lookup_imported {program : Program} {source : Grounded.Context}
    (cells : Cells program source) (valid : source.WellFormed program)
    {name : String} {slot : Grounded.Slot} (found : lookup name source.bindings = some slot) :
    lookup name cells.context.bindings = some (cells.slot (.binder slot.binder) slot) := by
  rw [cells.bindings valid]
  have mapped : ∀ bindings : List (String × Grounded.Slot), lookup name bindings = some slot →
      lookup name (bindings.map (fun entry => (entry.1, cells.slot (.binder entry.2.binder) entry.2))) =
        some (cells.slot (.binder slot.binder) slot) := by
    intro bindings
    induction bindings with
    | nil => intro found; simp [lookup] at found
    | cons entry rest ih =>
      intro found
      simp only [lookup, List.map_cons] at found ⊢
      split at found
      · rename_i same
        cases Option.some.inj found
        simp [same]
      · rename_i different
        simpa [different] using ih found
  exact mapped _ found

/-- An actual selected imported handle constructs its canonical lens. The target
and current referent mask are derived from its existing loan and declared root,
not accepted as a new canonical-target premise. Nested carriers and masked
unique referents are admitted; no target-alias injectivity is needed. -/
theorem Cells.canonicalView {program : Program} {home : Module} {source : Grounded.Context}
    (cells : Cells program source) {interpretation : Interpretation} {environment : Environment}
    (store : StoreTyped program interpretation source environment)
    {place : Place} {slot : Grounded.Slot} {indices : List Nat} {state : Initialization}
    {node : Nat} {actual : SourceLoan}
    (found : lookup place.root source.bindings = some slot)
    (access : slot.initialization.Access indices state) (complete : state.Complete)
    (path : PathType program home slot.type place.fields indices (.reference actual.referent actual.mode))
    (selected : slot.payload.select indices = some (.reference node))
    (loanFound : source.loans[node]? = some actual) (own : actual.own = true) :
    Nonempty (CanonicalView program home cells.point place) := by
  have slotStored := store.source.member_stored _ (lookup_member found)
  obtain ⟨selection⟩ := (cells.produced _ _ slotStored).selectReference path selected
  have target := (store.sourceTargets node actual loanFound own).1
  cases base : actual.target.base with
  | binder binder =>
    obtain ⟨root, stored, canonical, mask, masked⟩ := target
    refine ⟨{
      symbol := .existing node
      referent := actual.referent
      mode := actual.mode
      selection := {
        slot := cells.slot (.binder slot.binder) slot
        indices := indices
        state := state
        found := cells.lookup_imported store.source found
        access := access
        complete := complete
        selected := selection
        typed := .reference .. }
      available := (cells.notEnded loanFound).mpr own
      binder := binder
      fields := actual.target.fields
      root := cells.slot (.binder binder) root
      state := mask
      target := ?_
      stored := ?_
      path := canonical
      mask := masked }⟩
    · change cells.context.referenceTarget (.existing node) = _
      rw [cells.referenceTarget loanFound]
      simp [address, base, SourceImport.base]
    · change (source.storage (.binder binder)).map (cells.slot (.binder binder)) = _
      simp only [← base, stored, Option.map_some]


/-- The canonical external entry supplies an executable view directly from the
actual selected carrier. The constructed view neither allocates nor redirects
any checking or runtime identity; its erasure retains the canonical branch. -/
theorem CanonicalEntry.view {program : Program} {home : Module} {interpretation : Interpretation}
    {source : Grounded.Context} {pendingPayloads : List SourcePayload}
    {environment : Environment} {pending : List Value}
    (entry : CanonicalEntry program interpretation source pendingPayloads environment pending)
    {place : Place} {slot : Grounded.Slot} {indices : List Nat} {state : Initialization}
    {node : Nat} {actual : SourceLoan}
    (found : lookup place.root source.bindings = some slot)
    (access : slot.initialization.Access indices state) (complete : state.Complete)
    (path : PathType program home slot.type place.fields indices (.reference actual.referent actual.mode))
    (selected : slot.payload.select indices = some (.reference node))
    (loanFound : source.loans[node]? = some actual) (own : actual.own = true) :
    ∃ view : CanonicalView program home entry.point place,
      (ViewStep.canonical view).erase = ViewStep.canonical view.erase := by
  obtain ⟨view⟩ := (Cells.ofStoreTyped entry.stateTyped.toStoreTyped).canonicalView
    entry.stateTyped.toStoreTyped found access complete path selected loanFound own
  exact ⟨view, rfl⟩


theorem Cells.resident_plain {program : Program} {source : Grounded.Context} (cells : Cells program source)
    {origin : OriginBase} {slot : Grounded.Slot} (found : source.storage origin = some slot)
    (plain : slot.payload = .plain) :
    cells.context.storage (base origin) = some
      ⟨slot.toBindingType, slot.binder, .schema (owner origin) [] slot.type [] .referenceFree⟩ := by
  rw [cells.storage, found]
  simp only [Option.map_some, Cells.slot, cells.plain_knowledge found plain]

theorem Cells.erased_plain {program : Program} {source : Grounded.Context} (cells : Cells program source)
    {origin : OriginBase} {slot : Grounded.Slot} (found : source.storage origin = some slot)
    (plain : slot.payload = .plain) :
    cells.point.erase.checked.storage (base origin) = some
      ⟨slot.toBindingType, slot.binder, .schema (owner origin) [] slot.type [] .referenceFree⟩ :=
  cells.resident_plain found plain

theorem mixed_plain_target_cell {program : Program} {source : Grounded.Context}
    {target : Origin} {type : Ty} (payload : source.TargetPayload program target type .plain)
    (_mixed : ¬ ReferenceFreeLayout program.target program.data type) :
    ∃ slot, source.storage target.base = some slot ∧ CanonicalPath program slot.type target.fields type ∧
      slot.payload.select target.fields = some .plain := by
  cases payload with
  | cell stored path selected => exact ⟨_, stored, path, selected⟩



theorem Cells.referenceTarget_source {program : Program} {source : Grounded.Context}
    (cells : Cells program source) {node : Nat} {actual : SourceLoan}
    (found : source.loans[node]? = some actual) :
    symbols.address source (cells.context.referenceTarget (.existing node)) = some actual.target := by
  rw [cells.referenceTarget found]
  exact address_meaning source actual.target


theorem pointOfStore_target {program : Program} {interpretation : Interpretation}
    {source : Grounded.Context} {environment : Environment}
    (store : StoreTyped program interpretation source environment)
    {node : Nat} {actual : SourceLoan} (found : source.loans[node]? = some actual)
    (own : actual.own = true) :
    symbols.address source ((pointOfStore store).checked.referenceTarget (.existing node)) = some actual.target ∧
    source.Target program actual.target actual.referent :=
  ⟨(Cells.ofStoreTyped store).referenceTarget_source found, (store.sourceTargets node actual found own).1⟩



theorem owner_injective {first second : OriginBase} (same : owner first = owner second) : first = second := by
  cases first
  cases second
  exact congrArg OriginBase.binder same

theorem owner_lt_supply {program : Program} {source : Grounded.Context}
    (valid : source.WellFormed program) {origin : OriginBase} {slot : Grounded.Slot}
    (found : source.storage origin = some slot) : owner origin < symbolSupply source := by
  cases origin with
  | binder identity =>
    have bound := (valid.allocated identity slot found).2.1
    simp only [owner, symbolSupply]
    omega

theorem schema_occurs_identity {program : Program} {ownerId : Nat} {path : List Checked.Component}
    {type : Ty} {reference : Checked.Reference}
    (occurs : Checked.Payload.Occurs program (.schema ownerId path type [] .referenceFree) reference) :
    ∃ suffix, reference = .parameter ownerId (path ++ suffix) := by
  cases occurs
  exact ⟨_, rfl⟩

theorem schema_owners_disjoint {program : Program} {first second : Nat}
    {left right : List Checked.Component} {firstType secondType : Ty} {reference : Checked.Reference}
    (different : first ≠ second)
    (one : Checked.Payload.Occurs program (.schema first left firstType [] .referenceFree) reference)
    (two : Checked.Payload.Occurs program (.schema second right secondType [] .referenceFree) reference) : False := by
  obtain ⟨_, one⟩ := schema_occurs_identity one
  obtain ⟨_, two⟩ := schema_occurs_identity two
  exact different (Checked.Reference.parameter.inj (one.symm.trans two)).1

theorem schema_siblings_disjoint {program : Program} {ownerId : Nat} {path : List Checked.Component}
    {head : Head} {first second : Nat} {firstType secondType : Ty} {reference : Checked.Reference}
    (different : first ≠ second)
    (one : Checked.Payload.Occurs program
      (.schema ownerId (path ++ [.constructor head, .field first]) firstType [] .referenceFree) reference)
    (two : Checked.Payload.Occurs program
      (.schema ownerId (path ++ [.constructor head, .field second]) secondType [] .referenceFree) reference) : False := by
  obtain ⟨left, one⟩ := schema_occurs_identity one
  obtain ⟨right, two⟩ := schema_occurs_identity two
  have equal := (Checked.Reference.parameter.inj (one.symm.trans two)).2
  simp only [List.append_assoc, List.append_cancel_left_eq, List.cons_append, List.nil_append,
    List.cons.injEq, Checked.Component.field.injEq] at equal
  exact different equal.2.1

theorem Cells.plain_roots_disjoint {program : Program} {source : Grounded.Context} (cells : Cells program source)
    {first second : OriginBase} {firstSlot secondSlot : Grounded.Slot}
    (firstFound : source.storage first = some firstSlot) (secondFound : source.storage second = some secondSlot)
    (firstPlain : firstSlot.payload = .plain) (secondPlain : secondSlot.payload = .plain)
    (different : first ≠ second) {reference : Checked.Reference}
    (one : (cells.payload first firstSlot).Occurs program reference)
    (two : (cells.payload second secondSlot).Occurs program reference) : False := by
  rw [cells.plain_knowledge firstFound firstPlain] at one
  rw [cells.plain_knowledge secondFound secondPlain] at two
  exact schema_owners_disjoint (fun same => different (owner_injective same)) one two

mutual
theorem PayloadProduced.established {program : Program} {ownerId supply : Nat} {path : List Checked.Component}
    {state : Initialization} {source : SourcePayload} {type : Ty} {checked : Checked.Payload}
    (produced : PayloadProduced program ownerId path state source type checked) (bound : ownerId < supply)
    {reference : Checked.Reference} (occurs : checked.Occurs program reference) :
    ReferenceEstablished supply reference := by
  cases produced with
  | plain =>
    obtain ⟨suffix, rfl⟩ := schema_occurs_identity occurs
    exact bound
  | reference => cases occurs; trivial
  | aggregate source shape fields =>
    cases occurs with
    | child selected nested => exact fields.established bound selected nested
theorem PayloadsProduced.established {program : Program} {ownerId supply : Nat}
    {paths : Nat → List Checked.Component} {states : Nat → Initialization}
    {source : List SourcePayload} {types : List Ty} {checked : List Checked.Payload}
    (produced : PayloadsProduced program ownerId paths states source types checked) (bound : ownerId < supply)
    {field : Checked.Payload} (member : field ∈ checked)
    {reference : Checked.Reference} (occurs : field.Occurs program reference) :
    ReferenceEstablished supply reference := by
  cases produced with
  | nil => cases member
  | cons first rest =>
    rcases List.mem_cons.mp member with rfl | member
    · exact first.established bound occurs
    · exact rest.established bound member occurs
end

theorem Cells.occurrence_established {program : Program} {source : Grounded.Context} (cells : Cells program source)
    (valid : source.WellFormed program) {origin : OriginBase} {slot : Grounded.Slot}
    (stored : source.storage origin = some slot) {reference : Checked.Reference}
    (occurs : (cells.payload origin slot).Occurs program reference) :
    ReferenceEstablished cells.context.nextSymbol reference :=
  (cells.produced origin slot stored).established (owner_lt_supply valid stored) occurs


theorem Cells.end_plain_preserves_other_available {program : Program} {source : Grounded.Context}
    (cells : Cells program source) {first second : OriginBase} {firstSlot secondSlot : Grounded.Slot}
    (firstFound : source.storage first = some firstSlot) (secondFound : source.storage second = some secondSlot)
    (firstPlain : firstSlot.payload = .plain) (secondPlain : secondSlot.payload = .plain)
    (different : first ≠ second)
    (available : cells.context.Available (program := program) (cells.payload second secondSlot)) :
    (cells.context.endPayload (cells.payload first firstSlot)).Available (program := program)
      (cells.payload second secondSlot) := by
  intro reference occurs payload member ended
  change payload ∈ cells.payload first firstSlot :: cells.context.ended at member
  rcases List.mem_cons.mp member with rfl | member
  · exact cells.plain_roots_disjoint firstFound secondFound firstPlain secondPlain different ended occurs
  · exact available reference occurs payload member ended


end SourceImport
end Grounded.Elaboration

/- Section: ElaborationCorrectness -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program}

mutual
/-- The sole phase-indexed producer constructs an execution of its exact Core plan. -/
theorem HasType.execution_correctness {phase : Phase} {home : Module}
    {before after : Point program phase} {held : List (Payload phase)}
    {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected) :
    Executes before held expression result after plan := by
  match typed with
  | .unit => exact Executes.unit
  | .integer fits => exact Executes.integer fits
  | .character valid => exact Executes.character valid
  | .group body => exact Executes.group body.execution_correctness
  | .read _ _ _ _ actual => exact Executes.read actual
  | .move _ _ _ _ _ _ actual => exact Executes.move actual
  | .implicitMove body _ => exact Executes.implicitMove body.execution_correctness
  | .borrow _ _ _ _ _ _ _ _ _ _ actual => exact Executes.borrow actual
  | .reborrow body _ => exact Executes.reborrow body.execution_correctness
  | .dereference _ _ _ _ _ _ _ _ _ _ actual => exact Executes.dereference actual
  | .moveIndirect _ _ _ _ _ _ _ _ _ actual => exact Executes.moveIndirect actual
  | .tuple _ first rest _ => exact Executes.tuple first.execution_correctness rest.execution_correctness
  | .array _ body types finite size => exact Executes.array body.execution_correctness types finite size
  | .construct shape _ body finite _ => exact Executes.construct shape body.execution_correctness finite
  | .view view body => exact Executes.view view body.execution_correctness
  | .sequence head dispose tail => exact Executes.sequence head.execution_correctness dispose tail.execution_correctness
  | .bind initialized _ binding continued cleanup _ =>
    exact Executes.bind initialized.execution_correctness binding continued.execution_correctness cleanup
  | .constant declared _ _ _ hidden initialized resume _ _ empty =>
    exact Executes.constant declared hidden initialized.execution_correctness resume empty
  | .field body projection _ => exact Executes.field body.execution_correctness projection
  | .call declared _ _ _ inputs hide prepare body _ _ cleanup resume _ =>
    exact Executes.call declared inputs.execution_correctness (inputs.expected_types _ rfl) hide prepare
      body.execution_correctness cleanup resume
  | .assign resident write continued => exact Executes.assign resident.execution_correctness write continued.execution_correctness
  | .assignIndirect resident write continued =>
    exact Executes.assignIndirect resident.execution_correctness write continued.execution_correctness
  | .endOwn ending body => exact Executes.endOwn ending body.execution_correctness
  | .endAfter body ending => exact Executes.endAfter body.execution_correctness ending
  | .raiseSupply body _ _ _ actual => exact Executes.raiseSupply body.execution_correctness actual
  | .applyPatterns arguments nonempty constants covered bodies =>
    exact Executes.applyPatterns arguments nonempty constants covered bodies arguments.execution_correctness
      (fun normalized normalization => (bodies normalized normalization).execution_correctness)
  | .expectedField body | .expectedDereference body | .expectedMoveIndirect body | .expectedMove body |
      .expectedBorrow body | .expectedCall body | .expectedData body _ _ => exact body.execution_correctness
termination_by structural typed

/-- Pending residents, not just projected nodes, compose in left-to-right order. -/
theorem HasTypes.execution_correctness {phase : Phase} {home : Module}
    {before after : Point program phase} {held : List (Payload phase)}
    {expressions : List Expr} {results : List (Result phase)} {plans : List CorePlan} {expected : Option (List Ty)}
    (typed : HasTypes program phase home before held expressions results after plans expected) :
    ExecutesList before held expressions results after plans := by
  match typed with
  | .nil | .expectedNil => exact ExecutesList.nil
  | .cons head tail | .expectedCons head tail =>
    exact ExecutesList.cons head.execution_correctness tail.execution_correctness
termination_by structural typed

/-- Dispatch consumes the same checked pattern product, including impossible-arm proofs. -/
theorem ArmsType.execution_correctness {phase : Phase} {home : Module}
    {before after : Point program phase} {held : List (Payload phase)}
    {subject result : Result phase} {previous : List Pattern} {arms : List (Pattern × Core)} {expected : Option Ty}
    (typed : ArmsType program phase home before held subject result previous arms after expected) :
    ExecutesArms before held subject result arms after := by
  match typed with
  | .empty => exact ExecutesArms.empty
  | .dormant pattern impossible interpreted useful body resultType cleanup tail =>
    exact ExecutesArms.dormant pattern impossible interpreted useful body resultType cleanup tail
      body.execution_correctness tail.execution_correctness
  | .clause pattern distinct useful prepare body cleanup stable joined tail =>
    exact ExecutesArms.clause pattern distinct useful prepare body cleanup stable joined tail
      body.execution_correctness tail.execution_correctness
termination_by structural typed
end

/-- Connected correctness includes exact products, current storage, custody,
restored protected results, and determinism of the single evaluator. -/
theorem correctness {home : Module} {before after : Point program .executable}
    {held : List (Payload .executable)} {expression : Expr} {result : Result .executable}
    {plan : CorePlan} {expected : Option Ty}
    (admitted : HasType program .executable home before held expression result after plan expected)
    {interpretation : Interpretation} {environment : Environment} {values : List Value}
    (state : StateTyped program interpretation (before.source rfl) (sourcePayloads held rfl) environment values) :
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧
      StateTyped program last (after.source rfl) (sourcePayloads held rfl ++ [result.payload.source rfl]) final (values ++ [value]) ∧
      StateProgress (before.source rfl) (after.source rfl) environment final interpretation last ∧
      environment.Evolution final ∧ final.ResultUsable value ∧
      ∀ other otherFinal, Evaluates program environment ⟨expression, plan⟩ other otherFinal → other = value ∧ otherFinal = final := by
  obtain ⟨value, final, last, evaluated, resident, finalTyped, progress⟩ := admitted.execution_correctness rfl state
  exact ⟨value, final, last, evaluated, resident, finalTyped, progress,
    (evaluated.storage state.residents.valid).2, pendingResultUsable finalTyped,
    fun _ _ alternative => alternative.deterministic evaluated⟩

end Grounded.Elaboration

/- Section: ElaborationReturnSafety -/
namespace Grounded
set_option autoImplicit false

theorem Context.History.derived {before after : Context} (history : History before after)
    {node ancestor : Nat} (derived : before.Derived node ancestor) : after.Derived node ancestor := by
  induction derived with
  | same => exact .same _
  | child found parent rest ih =>
    obtain ⟨loan, retained, _, _, parentSame, _, _⟩ := history.records _ _ found
    exact .child retained (parentSame.trans parent) ih

namespace Elaboration
variable {program : Program}

/-- Every returned handle occurrence, not merely the result's outer type, has
actual runtime ancestry in the single admitted argument occurrence. -/
theorem ReturnStep.runtime_origins {before after : Point program .executable}
    {arguments : List (Result .executable)} {result : Result .executable}
    (step : ReturnStep program before arguments result)
    (history : Context.History (before.source rfl) (after.source rfl))
    {interpretation : Interpretation} {environment : Environment} {value : Value}
    (stored : StoreTyped program interpretation (after.source rfl) environment)
    (related : (result.payload.source rfl).Corresponds interpretation.node value)
    {path : List Nat} {node : Nat} (occurrence : value.readIndices path = some (.reference node)) :
    ∃ input, payloadNodes ((sourceResults arguments rfl).map ResultType.payload) = [input] ∧
      environment.Derived node (interpretation.node input) := by
  obtain ⟨identity, selected, equal⟩ := related.readIndices_reference_iff.mp occurrence
  obtain ⟨input, singleton, derived⟩ := step.actual rfl identity
    (SourcePayload.mem_nodes_iff.mpr ⟨path, selected⟩)
  exact ⟨input, singleton, equal.symm ▸ stored.derived (history.derived derived)⟩

/-- General execution followed by the actual ordered cleanup keeps every nested
returned handle owned/restored, and retains its admitted input ancestry. The
argument-origin rule is deliberately the bounded singleton rule, not a model of
arbitrary declared lifetimes. -/
theorem correctness_return_cleanup {home : Module} {before after cleaned : Point program .executable}
    {held : List (Payload .executable)} {expression : Expr} {result : Result .executable}
    {arguments : List (Result .executable)} {plan : CorePlan} {expected : Option Ty} {count : Nat}
    (admitted : HasType program .executable home before held expression result after plan expected)
    (returns : ReturnStep program after arguments result)
    (cleanup : CleanupStep program after cleaned (held ++ [result.payload]) count)
    {interpretation : Interpretation} {environment : Environment} {values : List Value}
    (state : StateTyped program interpretation (before.source rfl) (sourcePayloads held rfl) environment values) :
    ∃ value localAfter final last trace,
      Evaluates program environment ⟨expression, plan⟩ value localAfter ∧
      Cleans program count localAfter trace final ∧
      StateTyped program last (cleaned.source rfl)
        (sourcePayloads held rfl ++ [result.payload.source rfl]) final (values ++ [value]) ∧
      final.ResultUsable value ∧
      ∀ path node, value.readIndices path = some (.reference node) →
        ∃ input, payloadNodes ((sourceResults arguments rfl).map ResultType.payload) = [input] ∧
          final.Derived node (last.node input) := by
  obtain ⟨value, localAfter, last, evaluated, resident, localState, _⟩ := admitted.execution_correctness rfl state
  obtain ⟨final, trace, cleanedEval, finalState⟩ := cleanup.cleanup rfl (by
    simpa only [sourcePayloads_append, sourcePayloads_singleton] using localState)
  have pending : StateTyped program last (cleaned.source rfl)
      (sourcePayloads held rfl ++ [result.payload.source rfl]) final (values ++ [value]) := by
    simpa only [sourcePayloads_append, sourcePayloads_singleton] using finalState
  have history := Context.History.cleanup (after.source rfl) count
  rw [← (cleanup.source rfl).2] at history
  exact ⟨value, localAfter, final, last, trace, evaluated, cleanedEval, pending,
    pendingResultUsable pending, fun _ _ occurrence =>
      returns.runtime_origins history pending.toStoreTyped resident.corresponds occurrence⟩

end Elaboration
end Grounded

/- Section: StateEmpty -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

def Interpretation.empty : Interpretation := ⟨id, id⟩

theorem StateTyped.empty : StateTyped program .empty .empty [] .empty [] := by
 refine {
   source := ?_
   residents := ⟨.empty, [], .nil, .nil⟩
   slots := .nil
   cells := by intro binder slot stored; cases stored
   binderBound := ?_
   binderDistinct := ?_
   nodeOrder := ?_
   records := ?_
   activeCoverage := ?_
   sourceTargets := by intro node loan found; simp [Context.empty] at found
   storeShape := by intro root value found; cases found
   heldShape := .nil
   heldOwn := by intro node member; cases member
   heldReady := by intro node member; cases member
   observedOwn := by intro node loan found; simp [Context.empty] at found
   custody := by intro node loan found; simp [Environment.empty] at found }
 · constructor <;> simp [Context.empty, Context.bindings]
 · intro binder mentioned
   rcases mentioned with ⟨slot, stored⟩ | ⟨node, loan, found, _⟩
   · cases stored
   · simp [Context.empty] at found
 · intro first second _ _ same; exact same
 · intro first second _ bound; exact False.elim (Nat.not_lt_zero _ bound)
 · intro node loan found; simp [Context.empty] at found
 · intro node loan found; simp [Environment.empty] at found

end Grounded

/- Section: ElaborationPublicSafety -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program}

/-- Current-state entry uses the canonical import of all actual source cells and
loan targets. Pending residents retain their full payload/value correspondence. -/
theorem imported_correctness {home : Module} {source : Grounded.Context}
    {interpretation : Interpretation} {environment : Environment}
    {held : List (Payload .executable)} {values : List Value}
    (state : StateTyped program interpretation source (sourcePayloads held rfl) environment values)
    {after : Point program .executable} {expression : Expr} {result : Result .executable}
    {plan : CorePlan} {expected : Option Ty}
    (admitted : HasType program .executable home (SourceImport.pointOfStore state.toStoreTyped)
      held expression result after plan expected) :
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧
      StateTyped program last (after.source rfl) (sourcePayloads held rfl ++ [result.payload.source rfl])
        final (values ++ [value]) ∧
      StateProgress source (after.source rfl) environment final interpretation last ∧
      environment.Evolution final ∧ final.ResultUsable value ∧
      ∀ other otherFinal, Evaluates program environment ⟨expression, plan⟩ other otherFinal →
        other = value ∧ otherFinal = final :=
  correctness admitted state

/-- General canonical external entry derives the initial state from declared
root typing and current loan/custody evidence, then runs the same admitted Core
with exact pending residents. No normalization or evaluation premise is used. -/
theorem canonical_entry_correctness {home : Module} {source : Grounded.Context}
    {interpretation : Interpretation} {environment : Environment}
    {held : List (Payload .executable)} {values : List Value}
    (entry : SourceImport.CanonicalEntry program interpretation source (sourcePayloads held rfl) environment values)
    {after : Point program .executable} {expression : Expr} {result : Result .executable}
    {plan : CorePlan} {expected : Option Ty}
    (admitted : HasType program .executable home entry.point held expression result after plan expected) :
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧
      StateTyped program last (after.source rfl) (sourcePayloads held rfl ++ [result.payload.source rfl])
        final (values ++ [value]) ∧
      StateProgress source (after.source rfl) environment final interpretation last ∧
      environment.Evolution final ∧ final.ResultUsable value ∧
      ∀ other otherFinal, Evaluates program environment ⟨expression, plan⟩ other otherFinal →
        other = value ∧ otherFinal = final :=
  imported_correctness entry.stateTyped admitted


/-- Reference-free syntax and declarations preserve empty loan history. Agreement
transports the exact same Core and result through the sole evaluator; it does not
assert an unsupported correspondence between arbitrary loan-bearing stores. -/
theorem correctness_referenceFree {home : Module} {before after : Point program .executable}
    {held : List (Payload .executable)} {expression : Expr} {result : Result .executable}
    {plan : CorePlan} {expected : Option Ty}
    (admitted : HasType program .executable home before held expression result after plan expected)
    {interpretation : Interpretation} {environment : Environment} {values : List Value}
    (state : StateTyped program interpretation (before.source rfl) (sourcePayloads held rfl) environment values)
    (declarations : program.ReferenceFree) (source : expression.ReferenceFree) (empty : environment.loans = []) :
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧ value.ReferenceFree ∧
      StateTyped program last (after.source rfl) (sourcePayloads held rfl ++ [result.payload.source rfl])
        final (values ++ [value]) ∧ final.loans = [] ∧
      ∀ otherEnvironment, environment.Agrees otherEnvironment → otherEnvironment.loans = [] →
        ∃ otherFinal, Evaluates program otherEnvironment ⟨expression, plan⟩ value otherFinal ∧
          EnvironmentTyped program otherFinal (after.source rfl).erase ∧ final.Agrees otherFinal := by
  obtain ⟨value, final, last, evaluated, resident, finalTyped, _⟩ := correctness admitted state
  have finalEmpty := evaluated.empty_of_referenceFree declarations source empty
  refine ⟨value, final, last, evaluated, resident, evaluated.referenceFree_of_empty finalEmpty,
    finalTyped, finalEmpty, ?_⟩
  intro otherEnvironment same otherEmpty
  obtain ⟨_, otherFinal, otherEval, finalSame, _⟩ :=
    evaluated.referenceFree_source_agreement declarations source empty otherEmpty same
  refine ⟨otherFinal, otherEval, ?_, finalSame⟩
  obtain ⟨residents, stored, typedResidents⟩ := finalTyped.residents.residents
  obtain ⟨observed, first, second⟩ := finalSame.values
  cases stored.unique first
  exact ⟨finalSame.rightValid, residents, second, typedResidents⟩

/-- Every active target remains addressable with its initialization mask. Only
shared targets are asserted readable; arbitrary unique targets may be vacant.
The returned value and all exact pending residents separately retain custody. -/
theorem correctness_noDangling {home : Module} {before after : Point program .executable}
    {held : List (Payload .executable)} {expression : Expr} {result : Result .executable}
    {plan : CorePlan} {expected : Option Ty}
    (admitted : HasType program .executable home before held expression result after plan expected)
    {interpretation : Interpretation} {environment : Environment} {values : List Value}
    (state : StateTyped program interpretation (before.source rfl) (sourcePayloads held rfl) environment values) :
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧
      StateTyped program last (after.source rfl) (sourcePayloads held rfl ++ [result.payload.source rfl])
        final (values ++ [value]) ∧ final.ResultUsable value ∧
      ∀ (node : Nat) (loan : Loan), final.loans[node]? = some loan → loan.own = true →
        ∃ target type mask, final.at loan.target = some target ∧ ResidentTyped program mask target type ∧
          FiniteLayout program.target program.data type ∧
          (loan.mode = .shared → final.readAddress loan.target = some target ∧ ValueHasType program target type) := by
  obtain ⟨value, final, last, evaluated, resident, finalTyped, _, _, usable, _⟩ := correctness admitted state
  exact ⟨value, final, last, evaluated, resident, finalTyped, usable,
    fun _ _ found own => finalTyped.toStoreTyped.noDangling found own⟩

/-- Canonical root-to-referent paths cover every active target, including hidden
external roots and masked unique targets. -/
theorem correctness_canonicalTargets {home : Module} {before after : Point program .executable}
    {held : List (Payload .executable)} {expression : Expr} {result : Result .executable}
    {plan : CorePlan} {expected : Option Ty}
    (admitted : HasType program .executable home before held expression result after plan expected)
    {interpretation : Interpretation} {environment : Environment} {values : List Value}
    (state : StateTyped program interpretation (before.source rfl) (sourcePayloads held rfl) environment values) :
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧
      StateTyped program last (after.source rfl) (sourcePayloads held rfl ++ [result.payload.source rfl])
        final (values ++ [value]) ∧
      ∀ (node : Nat) (loan : SourceLoan), (after.source rfl).loans[node]? = some loan → loan.own = true →
        ∀ binder, loan.target.base = .binder binder →
          ∃ slot mask resident, (after.source rfl).storage (.binder binder) = some slot ∧
            CanonicalPath program slot.type loan.target.fields loan.referent ∧
            slot.initialization.Access loan.target.fields mask ∧
            final.at (last.origin loan.target) = some resident ∧ ResidentTyped program mask resident loan.referent := by
  obtain ⟨value, final, last, evaluated, resident, finalTyped, _⟩ := correctness admitted state
  exact ⟨value, final, last, evaluated, resident, finalTyped,
    fun _ _ found own _ base => finalTyped.toStoreTyped.canonicalTargets found own base⟩

/-- Closed entry imports the proved empty canonical state. Evolution retires all
scoped cells, without incorrectly resetting the identity supply or loan history. -/
theorem closed_correctness {home : Module} {after : Point program .executable}
    {expression : Expr} {result : Result .executable} {plan : CorePlan} {expected : Option Ty}
    (admitted : HasType program .executable home
      (SourceImport.pointOfStore (StateTyped.empty (program := program)).toStoreTyped)
      [] expression result after plan expected) :
    ∃ value final last, Evaluates program .empty ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧
      StateTyped program last (after.source rfl) [result.payload.source rfl] final [value] ∧
      final.bindings = [] ∧ (∀ root, final.store root = none) ∧ final.ResultUsable value ∧
      ∀ other otherFinal, Evaluates program .empty ⟨expression, plan⟩ other otherFinal →
        other = value ∧ otherFinal = final := by
  obtain ⟨value, final, last, evaluated, resident, finalTyped, _, evolution, usable, unique⟩ :=
    imported_correctness (held := []) StateTyped.empty admitted
  exact ⟨value, final, last, evaluated, resident, finalTyped, evolution.bindings,
    fun root => evolution.fresh root (Nat.zero_le _), usable, unique⟩

/-- An exact nested leaf of a currently active target retains Own and support.
This does not require restoration of a nested unique referent with holes. -/
theorem state_targetClosure {interpretation : Interpretation} {context : Grounded.Context}
    {held : List SourcePayload} {environment : Environment} {values : List Value}
    (state : StateTyped program interpretation context held environment values)
    {outer inner : Nat} {loan : Loan} {resident : Value} {path : List Nat}
    (found : environment.loans[outer]? = some loan) (own : loan.own = true)
    (raw : environment.at loan.target = some resident)
    (leaf : resident.readIndices path = some (.reference inner)) : environment.Usable inner := by
  obtain ⟨sourceNode, sourceLoan, sourceFound, sameNode⟩ := state.activeCoverage outer loan found own
  have record := state.records sourceNode sourceLoan sourceFound
  rw [sameNode, found] at record
  cases Option.some.inj record
  have payload : ∃ payload, context.TargetPayload program sourceLoan.target sourceLoan.referent payload ∧
      payload.Corresponds interpretation.node resident := by
    cases base : sourceLoan.target.base with
    | binder binder =>
      obtain ⟨slot, _, _, stored, canonical, _⟩ := state.toStoreTyped.canonicalTargets sourceFound own base
      obtain ⟨root, rootStored, _, related⟩ := state.cells binder slot stored
      have selected : root.readIndices sourceLoan.target.fields = some resident := by
        simpa [Environment.at, Interpretation.origin, base, rootStored] using raw
      obtain ⟨payload, selectedPayload, relatedPayload⟩ := related.readIndices selected
      exact ⟨payload, .cell (by simpa [base] using stored) canonical selectedPayload, relatedPayload⟩
  obtain ⟨payload, provenance, related⟩ := payload
  obtain ⟨identity, occurrence, same⟩ := related.readIndices_reference_iff.mp leaf
  rw [same]
  exact state.toStoreTyped.usable (state.observedOwn sourceNode sourceLoan sourceFound own payload provenance
    identity (SourcePayload.mem_nodes_iff.mpr ⟨path, occurrence⟩))

/-- Execution closes active targets over their exact nested reference leaves.
Pending values, including the returned value, satisfy the stronger restored
contract. No unrestricted readiness is claimed for nested unique targets. -/
theorem correctness_targetClosure {home : Module} {before after : Point program .executable}
    {held : List (Payload .executable)} {expression : Expr} {result : Result .executable}
    {plan : CorePlan} {expected : Option Ty}
    (admitted : HasType program .executable home before held expression result after plan expected)
    {interpretation : Interpretation} {environment : Environment} {values : List Value}
    (state : StateTyped program interpretation (before.source rfl) (sourcePayloads held rfl) environment values) :
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧
      StateTyped program last (after.source rfl) (sourcePayloads held rfl ++ [result.payload.source rfl])
        final (values ++ [value]) ∧
      (∀ (outer inner : Nat) (loan : Loan) (resident : Value) (path : List Nat),
        final.loans[outer]? = some loan → loan.own = true → final.at loan.target = some resident →
        resident.readIndices path = some (.reference inner) → final.Usable inner) ∧
      (∀ (index inner : Nat) (resident : Value) (path : List Nat),
        (values ++ [value])[index]? = some resident → resident.readIndices path = some (.reference inner) →
        final.Usable inner ∧ final.Restored inner) := by
  obtain ⟨value, final, last, evaluated, resident, finalTyped, _⟩ := correctness admitted state
  refine ⟨value, final, last, evaluated, resident, finalTyped,
    fun _ _ _ _ _ found own raw leaf => state_targetClosure finalTyped found own raw leaf, ?_⟩
  intro index inner resident path found leaf
  obtain ⟨payload, selected, related⟩ := (finalTyped.heldShape.select index).2 resident found
  obtain ⟨identity, occurrence, same⟩ := related.readIndices_reference_iff.mp leaf
  have member := payloadNodes_mem.mpr ⟨payload, List.mem_of_getElem? selected,
    SourcePayload.mem_nodes_iff.mpr ⟨path, occurrence⟩⟩
  obtain ⟨loan, recorded, _⟩ := finalTyped.heldOwn identity member
  rw [same]
  exact ⟨finalTyped.toStoreTyped.usable (finalTyped.heldOwn identity member),
    finalTyped.toStoreTyped.restored recorded (finalTyped.heldReady identity member)⟩


end Grounded.Elaboration

/- Section: ElaborationAdmissionConsumers -/
namespace Grounded
set_option autoImplicit false

/-- A compulsory expected-site reborrow may carry checked endings, but no
ordinary Copy, transfer, or expression wrapper. Views add no Core wrapper. -/
inductive CorePlan.Reborrows (mode : BorrowMode) : CorePlan → Prop where
  | direct : Reborrows mode (.reborrow mode)
  | endOwn {plan : CorePlan} (slot : Nat) (fields : List Nat)
      (body : Reborrows mode plan) : Reborrows mode (.endOwn slot plan fields)
  | endAfter {plan : CorePlan} (slot : Nat) (fields : List Nat)
      (body : Reborrows mode plan) : Reborrows mode (.endAfter slot plan fields)

namespace Elaboration
variable {program : Program} {phase : Phase} {home : Module}

/-- Reference expectations select the requested-mode reborrow in both phases,
including through views and checked administrative metadata. -/
theorem HasType.reference_read_selection {before after : Point program phase}
    {held : List (Payload phase)} {expression : Expr} {result : Result phase}
    {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected)
    {place : Place} {referent : Ty} {mode : BorrowMode} :
    expression = .read place → expected = some (.reference referent mode) → plan.Reborrows mode := by
  match typed with
  | .reborrow _ _ => intro _ same; cases same; exact .direct
  | .view _ body => exact body.reference_read_selection
  | .endOwn _ body =>
    intro source expected; exact .endOwn _ _ (body.reference_read_selection source expected)
  | .endAfter body _ =>
    intro source expected; exact .endAfter _ _ (body.reference_read_selection source expected)
  | .raiseSupply body _ _ _ _ => exact body.reference_read_selection
  | .expectedData _ _ notReference =>
    intro _ expected
    have same := Option.some.inj expected
    rw [same] at notReference
    exact False.elim notReference
  | .unit | .integer .. | .character .. | .group .. | .read .. | .move .. | .implicitMove .. |
      .borrow .. | .dereference .. | .moveIndirect .. | .tuple .. | .array .. | .construct .. |
      .sequence .. | .bind .. | .constant .. | .field .. | .call .. | .assign .. |
      .assignIndirect .. | .applyPatterns .. | .expectedField .. | .expectedDereference .. |
      .expectedMoveIndirect .. | .expectedMove .. | .expectedBorrow .. | .expectedCall .. =>
    intro source expected; cases source <;> cases expected
termination_by structural typed

theorem HasType.reference_read_not_leaf {before after : Point program phase}
    {held : List (Payload phase)} {expression : Expr} {result : Result phase}
    {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected)
    {place : Place} {referent : Ty} {mode : BorrowMode}
    (source : expression = .read place) (leaf : plan = .leaf)
    (expectedType : expected = some (.reference referent mode)) : False := by
  have selected := typed.reference_read_selection source expectedType
  cases leaf
  cases selected

theorem HasType.reference_read_not_implicitMove {before after : Point program phase}
    {held : List (Payload phase)} {expression : Expr} {result : Result phase}
    {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected)
    {place : Place} {referent : Ty} {mode : BorrowMode}
    (source : expression = .read place) (move : plan = .implicitMove)
    (expectedType : expected = some (.reference referent mode)) : False := by
  have selected := typed.reference_read_selection source expectedType
  cases move
  cases selected

/-- An inspected ordinary leaf read carries positive Copy permission. Neither
view elaboration nor expected-data checking introduces a uniqueness loophole. -/
theorem HasType.read_leaf_duplicable {before after : Point program phase}
    {held : List (Payload phase)} {expression : Expr} {result : Result phase}
    {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected)
    {place : Place} :
    expression = .read place → plan = .leaf → Duplicable program.data result.type := by
  match typed with
  | .read selection sameType _ _ _ => intro _ _; exact sameType ▸ selection.permission
  | .view _ body => exact body.read_leaf_duplicable
  | .raiseSupply body _ _ _ _ => exact body.read_leaf_duplicable
  | .expectedData body _ _ => exact body.read_leaf_duplicable
  | .unit | .integer .. | .character .. | .group .. | .move .. | .implicitMove .. |
      .borrow .. | .reborrow .. | .dereference .. | .moveIndirect .. | .tuple .. | .array .. |
      .construct .. | .sequence .. | .bind .. | .constant .. | .field .. | .call .. |
      .assign .. | .assignIndirect .. | .endOwn .. | .endAfter .. | .applyPatterns .. |
      .expectedField .. | .expectedDereference .. | .expectedMoveIndirect .. |
      .expectedMove .. | .expectedBorrow .. | .expectedCall .. =>
    intro source leaf; cases source <;> cases leaf
termination_by structural typed

theorem HasType.read_leaf_not_nonduplicable {before after : Point program phase}
    {held : List (Payload phase)} {place : Place} {result : Result phase} {expected : Option Ty}
    (typed : HasType program phase home before held (.read place) result after .leaf expected) :
    ¬ Nonduplicable program.data result.type :=
  fun noncopy => noncopy.not_duplicable (typed.read_leaf_duplicable rfl rfl)

theorem HasType.read_leaf_reference_shared {before after : Point program phase}
    {held : List (Payload phase)} {place : Place} {result : Result phase} {expected : Option Ty}
    (typed : HasType program phase home before held (.read place) result after .leaf expected)
    {referent : Ty} {mode : BorrowMode} (reference : result.type = .reference referent mode) :
    mode = .shared :=
  UsePermission.duplicable_reference_shared (reference ▸ typed.read_leaf_duplicable rfl rfl)

/-- Default transfer requires positive noncopy evidence from the same producer;
a missing Copy derivation is not such evidence. -/
theorem HasType.implicitMove_nonduplicable {before after : Point program phase}
    {held : List (Payload phase)} {expression : Expr} {result : Result phase}
    {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected) :
    plan = .implicitMove → Nonduplicable program.data result.type := by
  match typed with
  | .implicitMove _ noncopy => intro _; exact noncopy
  | .view _ body | .raiseSupply body _ _ _ _ | .expectedData body _ _ |
      .expectedField body | .expectedDereference body | .expectedMoveIndirect body |
      .expectedMove body | .expectedBorrow body | .expectedCall body =>
    exact body.implicitMove_nonduplicable
  | .unit | .integer .. | .character .. | .group .. | .read .. | .move .. |
      .borrow .. | .reborrow .. | .dereference .. | .moveIndirect .. | .tuple .. | .array .. |
      .construct .. | .sequence .. | .bind .. | .constant .. | .field .. | .call .. |
      .assign .. | .assignIndirect .. | .endOwn .. | .endAfter .. | .applyPatterns .. =>
    intro impossible; cases impossible
termination_by structural typed

theorem HasType.implicitMove_not_copy {before after : Point program phase}
    {held : List (Payload phase)} {expression : Expr} {result : Result phase} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after .implicitMove expected) :
    ¬ Duplicable program.data result.type := (typed.implicitMove_nonduplicable rfl).not_duplicable

mutual
/-- Expected checking preserves the exact type, including reference mode and
referent, on executable and hypothetical checking derivations alike. -/
theorem HasType.expected_type {phase : Phase} {home : Module}
    {before after : Point program phase} {held : List (Payload phase)}
    {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected) :
    ∀ type, expected = some type → result.type = type := by
  match typed with
  | .unit | .integer .. | .character .. | .read .. | .move .. | .implicitMove .. |
      .borrow .. | .dereference .. | .moveIndirect .. | .construct .. | .constant .. |
      .field .. | .call .. => intro _ impossible; cases impossible
  | .group body | .view _ body | .sequence _ _ body | .bind _ _ _ body _ _ |
      .assign _ _ body | .assignIndirect _ _ body | .endOwn _ body | .endAfter body _ |
      .raiseSupply body _ _ _ _ => exact body.expected_type
  | .reborrow _ shape => intro _ same; cases same; exact shape
  | .tuple contextual _ _ _ | .array contextual _ _ _ _ =>
    intro type expected
    rcases contextual with none | some
    · rw [none] at expected; cases expected
    · cases some; cases expected; rfl
  | .applyPatterns _ nonempty constants _ bodies =>
    obtain ⟨normalized, normalization⟩ := constants.normalizes
    have normalizedNonempty : normalized ≠ [] := by
      intro empty
      cases empty
      cases normalization
      exact nonempty rfl
    exact (bodies normalized normalization).expected_type normalizedNonempty
  | .expectedField _ | .expectedDereference _ | .expectedMoveIndirect _ | .expectedMove _ |
      .expectedBorrow _ | .expectedCall _ | .expectedData _ _ _ =>
    intro _ same; cases same; rfl
termination_by structural typed

/-- Dormant alternatives remain checked by the same family; their result-type
transport and active alternatives agree with the requested result type. -/
theorem ArmsType.expected_type {phase : Phase} {home : Module}
    {before after : Point program phase} {held : List (Payload phase)}
    {subject result : Result phase} {previous : List Pattern} {arms : List (Pattern × Core)}
    {expected : Option Ty}
    (typed : ArmsType program phase home before held subject result previous arms after expected) :
    arms ≠ [] → ∀ type, expected = some type → result.type = type := by
  match typed with
  | .empty => intro nonempty; exact False.elim (nonempty rfl)
  | .dormant _ _ _ _ body resultType _ _ =>
    intro _ type expected; exact resultType.symm.trans (body.expected_type type expected)
  | .clause _ _ _ _ body _ _ _ _ => intro _; exact body.expected_type
termination_by structural typed
end

/-- Source literal predicates survive every metadata-only producer step,
including views and checking against a contextual data type. -/
theorem HasType.literal_valid {before after : Point program phase}
    {held : List (Payload phase)} {expression : Expr} {result : Result phase}
    {plan : CorePlan} {expected : Option Ty}
    (typed : HasType program phase home before held expression result after plan expected) :
    (fun source : Expr => match source with
      | .integer type magnitude => type.Contains program.target magnitude
      | .character number => UnicodeScalar number
      | _ => True) expression := by
  match typed with
  | .integer fits => exact fits
  | .character valid => exact valid
  | .view _ body | .endOwn _ body | .endAfter body _ | .raiseSupply body _ _ _ _ |
      .expectedData body _ _ => exact body.literal_valid
  | .unit | .group .. | .read .. | .move .. | .implicitMove .. | .borrow .. | .reborrow .. |
      .dereference .. | .moveIndirect .. | .tuple .. | .array .. | .construct .. | .sequence .. |
      .bind .. | .constant .. | .field .. | .call .. | .assign .. | .assignIndirect .. |
      .applyPatterns .. | .expectedField .. | .expectedDereference .. | .expectedMoveIndirect .. |
      .expectedMove .. | .expectedBorrow .. | .expectedCall .. => trivial
termination_by structural typed

/-- Exact target-relative integer admission, independently of emitted metadata. -/
theorem integer_admission (before : Point program phase) (held : List (Payload phase))
    (type : IntegerType) (magnitude : Nat) :
    (∃ result after plan, Nonempty
      (HasType program phase home before held (.integer type magnitude) result after plan none)) ↔
      type.Contains program.target magnitude := by
  constructor
  · rintro ⟨_, _, _, ⟨admitted⟩⟩; exact admitted.literal_valid
  · intro fits; exact ⟨_, _, _, ⟨.integer fits⟩⟩

/-- Exact Unicode scalar admission in checking and executable elaboration. -/
theorem character_admission (before : Point program phase) (held : List (Payload phase))
    (number : Nat) :
    (∃ result after plan, Nonempty
      (HasType program phase home before held (.character number) result after plan none)) ↔
      UnicodeScalar number := by
  constructor
  · rintro ⟨_, _, _, ⟨admitted⟩⟩; exact admitted.literal_valid
  · intro valid; exact ⟨_, _, _, ⟨.character valid⟩⟩

end Elaboration
private theorem HeadType.nonduplicable_child {program : Program}
    {head : Head} {type child : Ty} {types : List Ty}
    (shape : HeadType program head type types) (member : child ∈ types)
    (noncopy : Nonduplicable program.data child) : Nonduplicable program.data type := by
  cases shape with
  | unit | integer | character | reference => simp at member
  | tuple first rest =>
    rcases List.mem_cons.mp member with same | included
    · cases same; exact .tupleHead noncopy
    · exact .tupleTail included noncopy
  | array element length =>
    cases List.eq_of_mem_replicate member
    cases length with
    | zero => simp at member
    | succ length => exact .array (Nat.succ_pos _) noncopy
  | @nominal identity tag declaration schema declared chosen =>
    obtain ⟨field, included, same⟩ := List.mem_map.mp member
    have schemaMember : schema ∈ declaration.schemas := by
      cases declaration with
      | mk home visibility shape restriction =>
        cases shape <;> cases tag <;> simp_all [DataDecl.constructor, DataDecl.schemas]
        exact List.mem_of_getElem? chosen
    exact .field declared schemaMember included (same ▸ noncopy)

namespace Checked
variable {program : Program}

/-- A unique occurrence at any declared constructor path is positive noncopy
evidence, including inside nominal alternatives and nonempty arrays. -/
theorem ReferencePath.unique_nonduplicable {type referent : Ty} {path : List Component}
    {mode : BorrowMode} (reference : ReferencePath program type path referent mode) :
    mode = .unique → Nonduplicable program.data type := by
  induction reference with
  | here => intro unique; cases unique; exact .unique _
  | child _ shape selected _ ih =>
    intro unique
    exact shape.nonduplicable_child (List.mem_of_getElem? selected) (ih unique)

/-- Copy bounds every nested declared occurrence to shared mode; schema
knowledge and abstraction do not hide unique fields from the capability check. -/
theorem ReferencePath.duplicable_shared {type referent : Ty} {path : List Component}
    {mode : BorrowMode} (reference : ReferencePath program type path referent mode)
    (permission : Duplicable program.data type) : mode = .shared := by
  cases mode with
  | shared => rfl
  | unique => exact False.elim ((reference.unique_nonduplicable rfl).not_duplicable permission)

mutual
/-- Recursive checked Copy retains old loan rows and can add only shared rows.
Opaque schema stamps create no rows; their declared modes obey Copy permission. -/
theorem CopyPayload.shared_loans {before after : Context} {payload copied : Payload}
    (copy : CopyPayload before payload copied after) :
    ∀ loan ∈ after.loans, loan ∈ before.loans ∨ loan.mode = .shared := by
  cases copy with
  | plain | schema => intro loan member; exact .inl member
  | reference =>
    intro loan member
    rcases List.mem_append.mp member with previous | created
    · exact .inl previous
    · cases List.mem_singleton.mp created; exact .inr rfl
  | aggregate _ children => exact children.shared_loans

theorem CopyPayloads.shared_loans {before after : Context} {payloads copied : List Payload}
    (copy : CopyPayloads before payloads copied after) :
    ∀ loan ∈ after.loans, loan ∈ before.loans ∨ loan.mode = .shared := by
  cases copy with
  | nil => intro loan member; exact .inl member
  | cons first rest =>
    intro loan member
    rcases rest.shared_loans loan member with earlier | shared
    · exact first.shared_loans loan earlier
    · exact .inr shared
end

theorem CopyPayload.no_unique_creation {before after : Context} {payload copied : Payload}
    (copy : CopyPayload before payload copied after)
    {loan : Loan} (member : loan ∈ after.loans) (unique : loan.mode = .unique) :
    loan ∈ before.loans := by
  rcases copy.shared_loans loan member with previous | shared
  · exact previous
  · rw [unique] at shared; cases shared

end Checked

namespace Elaboration
variable {program : Program} {phase : Phase} {home : Module}

/-- The ordinary read consumer applies the recursive uniqueness bound to the
actual admitted result type, not just a top-level reference or a sample value. -/
theorem HasType.read_leaf_references_shared {before after : Point program phase}
    {held : List (Payload phase)} {place : Place} {result : Result phase} {expected : Option Ty}
    (typed : HasType program phase home before held (.read place) result after .leaf expected)
    {path : List Checked.Component} {referent : Ty} {mode : BorrowMode}
    (reference : Checked.ReferencePath program result.type path referent mode) :
    mode = .shared :=
  reference.duplicable_shared (typed.read_leaf_duplicable rfl rfl)

end Elaboration
end Grounded

/- Section: ElaborationChosenCorrectness -/
namespace Grounded.Elaboration
set_option autoImplicit false

/-- A realized source admission must erase to the particular chosen checking
product, not merely have the same type/plan indices. The witness contains source
rules only; actual evaluation and its post-state are constructed here. -/
theorem checked_correctness {program : Program} {home : Module}
    {before after : Point program .executable} {held : List (Payload .executable)}
    {expression : Expr} {result : Result .executable} {plan : CorePlan} {expected : Option Ty}
    (chosen : HasType program .checking home before.erase (held.map Payload.erase)
      expression result.erase after.erase plan expected)
    (realized : ∃ admitted : HasType program .executable home before held expression result after plan expected,
      admitted.ErasesTo chosen)
    {interpretation : Interpretation} {environment : Environment} {values : List Value}
    (state : StateTyped program interpretation (before.source rfl) (sourcePayloads held rfl) environment values) :
    ∃ value final last, Evaluates program environment ⟨expression, plan⟩ value final ∧
      ResultTyped program last (after.source rfl) (result.source rfl) value ∧
      StateTyped program last (after.source rfl) (sourcePayloads held rfl ++ [result.payload.source rfl]) final (values ++ [value]) ∧
      StateProgress (before.source rfl) (after.source rfl) environment final interpretation last ∧
      environment.Evolution final ∧ final.ResultUsable value ∧
      ∀ other otherFinal, Evaluates program environment ⟨expression, plan⟩ other otherFinal → other = value ∧ otherFinal = final := by
  obtain ⟨admitted, exactProduct⟩ := realized
  change admitted.erase = chosen at exactProduct
  subst chosen
  exact correctness admitted state

end Grounded.Elaboration
