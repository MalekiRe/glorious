  | construct {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {identity : Nat} {tag : Option Nat} {fields : List Expr} {results : List (Result phase)} {plans : List CorePlan}
      (shape : HeadType program (.nominal identity tag) (.nominal identity) (results.map Result.type))
      (visible : (Head.nominal identity tag).Accessible program home)
      (typed : HasTypes program phase home before held fields results after plans (some (results.map Result.type)))
      (finite : FiniteLayout program.target program.data (.nominal identity))
      (capability : UsePermission program.data (.nominal identity) .exact) :
      HasType program phase home before held (.construct identity tag fields)
        ⟨.nominal identity, .aggregate (.nominal identity tag) (results.map Result.payload)⟩ after (.batch plans) none
  | view {phase : Phase} {home : Module} {before viewed after : Point program phase} {held : List (Payload phase)}
      {reference : Place} {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty}
      (view : ViewStep program home before viewed reference)
      (body : HasType program phase home viewed held expression result after plan expected) :
      HasType program phase home before held expression result after plan expected
  | sequence {phase : Phase} {home : Module} {before middle disposed after : Point program phase} {held : List (Payload phase)}
      {first rest : Expr} {discarded result : Result phase} {firstPlan restPlan : CorePlan} {expected : Option Ty}
      (head : HasType program phase home before held first discarded middle firstPlan none)
      (dispose : PatternDisposal program held middle discarded disposed)
      (tail : HasType program phase home disposed held rest result after restPlan expected) :
      HasType program phase home before held (.sequence first rest) result after (.binary firstPlan restPlan) expected
  | bind {phase : Phase} {home : Module} {before middle bound bodyAfter after : Point program phase} {held : List (Payload phase)}
      {mutable : Bool} {name : String} {annotation : Option TypeExpr} {initial body : Expr}
      {localType result : Result phase} {initialPlan bodyPlan : CorePlan} {expected : Option Ty}
      (initialized : HasType program phase home before held initial localType middle initialPlan (annotation.map fun _ => localType.type))
      (annotated : Annotation program.aliases annotation localType.type)
      (binding : BindStep program middle bound name mutable localType)
      (continued : HasType program phase home bound held body result bodyAfter bodyPlan expected)
      (cleanup : CleanupStep program bodyAfter after (held ++ [result.payload]) 1)
      (stable : PointsStable bodyAfter after) :
      HasType program phase home before held (.bind mutable name annotation initial body) result after (.binary initialPlan bodyPlan) expected
  | constant {phase : Phase} {home : Module} {before hidden constantAfter after : Point program phase} {held : List (Payload phase)}
      {name : String} {declaration : ConstantDecl} {result : Result phase} {plan : CorePlan}
      (declared : program.constants name = some declaration)
      (visible : declaration.visibility.Allows declaration.home home)
      (resolved : ResolvesType program.aliases declaration.type result.type)
      (structural : Structural declaration.body)
      (hiddenStep : HideStep program before hidden)
      (initialized : HasType program phase declaration.home hidden held declaration.body result constantAfter plan none)
      (resume : ResumeStep program before constantAfter after)
      (referenceFree : Payload.NoHandles result.payload.checked)
      (interpreted : result.Interpreted constantAfter)
      (empty : Required phase fun executable => (result.payload.source executable).nodes = []) :
