      (declared : program.functions identity = some declaration)
      (visible : declaration.visibility.Allows declaration.home home)
      (distinct : (declaration.parameters.map Prod.fst).Nodup)
      (initialized : ∀ parameter ∈ declaration.parameters, parameter.2.initialization = .full)
      (inputs : HasTypes program phase home before held arguments argumentTypes middle argumentPlans
        (some (declaration.parameters.map fun parameter => parameter.2.type)))
      (hide : HideStep program middle hidden)
      (prepare : PrepareStep program hidden prepared declaration.parameters argumentTypes)
      (body : HasType program phase declaration.home prepared held declaration.body result bodyAfter bodyPlan (some declaration.result))
      (resultType : result.type = declaration.result)
      (origin : ReturnStep program bodyAfter argumentTypes result)
      (cleanup : CleanupStep program bodyAfter cleaned (held ++ [result.payload]) declaration.parameters.length)
      (resume : ResumeStep program middle cleaned after)
      (stable : PointsStable bodyAfter cleaned) :
      HasType program phase home before held (.call identity arguments) result after (.call argumentPlans bodyPlan) none
  | assign {phase : Phase} {home : Module} {before middle written after : Point program phase} {held : List (Payload phase)}
      {place : Place} {value rest : Expr} {replacement result : Result phase} {valuePlan restPlan : CorePlan} {expected : Option Ty}
      (resident : HasType program phase home before held value replacement middle valuePlan (some replacement.type))
      (write : WriteStep program home middle written held (.owner place) replacement)
      (continued : HasType program phase home written held rest result after restPlan expected) :
      HasType program phase home before held (.assign place value rest) result after (.binary valuePlan restPlan) expected
  | assignIndirect {phase : Phase} {home : Module} {before middle written after : Point program phase} {held : List (Payload phase)}
      {reference : Place} {fields : List FieldKey} {value rest : Expr} {replacement result : Result phase}
      {valuePlan restPlan : CorePlan} {expected : Option Ty}
      (resident : HasType program phase home before held value replacement middle valuePlan (some replacement.type))
      (write : WriteStep program home middle written held (.dereference reference fields) replacement)
      (continued : HasType program phase home written held rest result after restPlan expected) :
      HasType program phase home before held (.assignIndirect reference fields value rest) result after (.binary valuePlan restPlan) expected
  | endOwn {phase : Phase} {home : Module} {before ended after : Point program phase} {held : List (Payload phase)}
      {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty} {slot : Nat} {fields : List Nat}
      (ending : EndingStep program before ended held slot fields)
      (continued : HasType program phase home ended held expression result after plan expected) :
      HasType program phase home before held expression result after (.endOwn slot plan fields) expected
  | endAfter {phase : Phase} {home : Module} {before middle after : Point program phase} {held : List (Payload phase)}
      {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty} {slot : Nat} {fields : List Nat}
      (body : HasType program phase home before held expression result middle plan expected)
      (ending : EndingStep program middle after (held ++ [result.payload]) slot fields) :
      HasType program phase home before held expression result after (.endAfter slot plan fields) expected
  | raiseSupply {phase : Phase} {home : Module} {before middle after : Point program phase} {held : List (Payload phase)}
      {expression : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty} {supply : Nat}
      (body : HasType program phase home before held expression result middle plan expected)
      (larger : middle.checked.nextBinder ≤ supply)
      (checked : after.checked = { middle.checked with nextBinder := supply })
      (stable : PointsStable middle after)
      (actual : Required phase fun executable => ∃ sourceSupply,
        (middle.source executable).nextBinder ≤ sourceSupply ∧
        after.source executable = { middle.source executable with nextBinder := sourceSupply }) :
