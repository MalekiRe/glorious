/- Section: Prefix -/
/-!
Target-indexed expressions, structural/nominal data, and first-class shared/unique references.
Normative basis: §§2.2–2.3, 3.2–3.4, 4.1–4.4, 5.1–5.3, 6.1–6.3, 7.2–7.7, 9.1–9.2 and 13.1.
Declarations, field types, identities and lexical names are already decoded.
Constructors consume argument expressions in their recorded order. Literal
magnitudes and Unicode numbers are decoded; source elaboration is not proved.
Direct named calls and immediate pattern-callable application share correctness.
Finite-inline nominal owners have checked structural use bounds and manual
restrictions. Actual zero-use boundaries construct ordered logical destruction.
Affine arm joins retain branch residents under conservative initialization.
Lexical names select non-reused logical roots in one authoritative optional-resident
store. Calls retain caller cells; scope cleanup retires only its own roots.
These identities are not physical addresses or successful allocation requests.
Mode-sensitive loans, canonical borrowed subaddresses and checked own-ending
metadata are connected to the same source producer and correctness theorem.
Explicit unique/shared borrowing and reborrowing preserve immutable modes;
canonical referent mutation and restoration consume the same storage invariants.
Default owned reads copy Duplicable data/handles or transfer from positive static
noncopy evidence; reference expectations compel fresh reborrowing instead.
Custom hooks, physical realization and exhaustion remain open.
Admission supplies no successful execution or normalization witness.
Constant-normal-form checks are consumed only after normalization is derived.
No prior specification modules are imported.
-/

namespace Grounded

/-- The selected target supplies its positive pointer width (§4.4). Other ABI
properties enter when their semantic consumers are introduced. -/
structure Target where
  pointerBits : Nat
  positive : 0 < pointerBits

inductive Width where
  | w8 | w16 | w32 | w64 | w128
  | pointer
  deriving DecidableEq

def Width.bits (target : Target) : Width → Nat
  | .w8 => 8
  | .w16 => 16
  | .w32 => 32
  | .w64 => 64
  | .w128 => 128
  | .pointer => target.pointerBits

structure IntegerType where
  signed : Bool
  width : Width
  deriving DecidableEq

/-- Mathematical scalar range; there is no implicit wrapping of literals. -/
def IntegerType.Contains (target : Target) (type : IntegerType) (value : Int) : Prop :=
  let bound : Int := 2 ^ (type.width.bits target - if type.signed then 1 else 0)
  (if type.signed then -bound else 0) ≤ value ∧ value < bound

def UnicodeScalar (number : Nat) : Prop :=
  number < 0x110000 ∧ (number < 0xd800 ∨ 0xe000 ≤ number)

inductive BorrowMode where
  | shared | unique
  deriving DecidableEq

inductive Ty where
  | unit
  | integer (type : IntegerType)
  | character
  | tuple (head : Ty) (tail : List Ty)
  | array (element : Ty) (length : Nat)
  | nominal (identity : Nat)
  | reference (referent : Ty) (mode : BorrowMode := .shared)

mutual
/-- Syntactic supported-data shape, not a claim about unknown nominal layouts.
A non-vacant nominal resident separately supplies its checked FiniteLayout. -/
def Ty.DataShape : Ty → Prop
  | .reference _ _ => False
  | .tuple head tail => head.DataShape ∧ typesDataShape tail
  | .array element _ => element.DataShape
  | _ => True

def typesDataShape : List Ty → Prop
  | [] => True
  | type :: types => type.DataShape ∧ typesDataShape types
end

theorem typesDataShape_iff (types : List Ty) : typesDataShape types ↔ ∀ type ∈ types, type.DataShape := by
  induction types with
  | nil => simp [typesDataShape]
  | cons first rest ih => simp [typesDataShape, ih]

/-- Decoded type expressions retain alias references until static resolution. -/
inductive TypeExpr where
  | concrete (type : Ty)
  | alias (name : String)
  | tuple (head : TypeExpr) (tail : List TypeExpr)
  | array (element : TypeExpr) (length : Nat)

abbrev Aliases := String → Option TypeExpr


mutual
/-- Alias expansion is finite and independent of declaration order. No alias
identity survives in the resolved type (§4.3). -/
inductive ResolvesType (aliases : Aliases) : TypeExpr → Ty → Prop where
  | concrete (type : Ty) : ResolvesType aliases (.concrete type) type
  | alias {name : String} {body : TypeExpr} {type : Ty}
      (declared : aliases name = some body) (expanded : ResolvesType aliases body type) :
      ResolvesType aliases (.alias name) type
  | tuple {head : TypeExpr} {tail : List TypeExpr} {first : Ty} {rest : List Ty}
      (firstType : ResolvesType aliases head first) (restTypes : ResolvesTypes aliases tail rest) :
      ResolvesType aliases (.tuple head tail) (.tuple first rest)
  | array {element : TypeExpr} {type : Ty} (length : Nat)
      (resolved : ResolvesType aliases element type) :
      ResolvesType aliases (.array element length) (.array type length)

inductive ResolvesTypes (aliases : Aliases) : List TypeExpr → List Ty → Prop where
  | nil : ResolvesTypes aliases [] []
  | cons {head : TypeExpr} {tail : List TypeExpr} {first : Ty} {rest : List Ty}
      (firstType : ResolvesType aliases head first) (restTypes : ResolvesTypes aliases tail rest) :
      ResolvesTypes aliases (head :: tail) (first :: rest)
end

inductive Annotation (aliases : Aliases) : Option TypeExpr → Ty → Prop where
  | inferred (type : Ty) : Annotation aliases none type
  | explicit {source : TypeExpr} {type : Ty} (resolved : ResolvesType aliases source type) :
      Annotation aliases (some source) type

/-- Resolved module identity, including the package boundary (§2.2). -/
structure Module where
  package : Nat
  path : List Nat

inductive Visibility where
  | «private» | package | parent | «public»

def Visibility.Allows (visibility : Visibility) (owner caller : Module) : Prop :=
  match visibility with
  | .private => caller.package = owner.package ∧ owner.path.IsPrefix caller.path
  | .package => caller.package = owner.package
  | .parent => owner.path ≠ [] ∧ caller.package = owner.package ∧
      owner.path.dropLast.IsPrefix caller.path
  | .public => True

inductive FieldKey where
  | named (name : String)
  | positional (index : Nat)

structure Field where
  type : Ty
  visibility : Visibility := .private

/-- Declaration order is retained even for named fields. -/
inductive Fields where
  | tuple (fields : List Field)
  | record (fields : List (String × Field))

def Fields.residents : Fields → List Field
  | .tuple fields => fields
  | .record fields => fields.map Prod.snd

def Fields.Valid : Fields → Prop
  | .tuple _ => True
  | .record fields => (fields.map Prod.fst).Nodup

def Fields.index : Fields → FieldKey → Option Nat
  | .tuple fields, .positional index => if index < fields.length then some index else none
  | .record fields, .named name => fields.findIdx? (fun field => field.1 == name)
  | _, _ => none

inductive DataShape where
  | «structure» (fields : Fields)
  | enumeration (variants : List Fields)

inductive Principal where
  | duplicable | affine | exact

structure DataDecl where
  home : Module
  visibility : Visibility := .private
  shape : DataShape
  restriction : Option Principal := none

def DataDecl.schemas (declaration : DataDecl) : List Fields :=
  match declaration.shape with
  | .structure fields => [fields]
  | .enumeration variants => variants

/-- No variant tag denotes a struct; an explicit tag denotes an enum variant. -/
def DataDecl.constructor (declaration : DataDecl) (tag : Option Nat) : Option Fields :=
  match declaration.shape, tag with
  | .structure fields, none => some fields
  | .enumeration variants, some index => variants[index]?
  | _, _ => none

abbrev DataDeclarations := Nat → Option DataDecl

/-- Inline expansion checks every variant; a reference is a finite handle and
never expands its referent. Zero-length arrays still check their element layout. -/
inductive FiniteLayout (target : Target) (data : DataDeclarations) : Ty → Prop where
  | unit : FiniteLayout target data .unit
  | integer (type : IntegerType) : FiniteLayout target data (.integer type)
  | character : FiniteLayout target data .character
  | reference (referent : Ty) (mode : BorrowMode) :
      FiniteLayout target data (.reference referent mode)
  | tuple {head : Ty} {tail : List Ty} (first : FiniteLayout target data head)
      (rest : ∀ type ∈ tail, FiniteLayout target data type) :
      FiniteLayout target data (.tuple head tail)
  | array {element : Ty} {length : Nat} (resident : FiniteLayout target data element)
      (size : length < 2 ^ target.pointerBits) : FiniteLayout target data (.array element length)
  | nominal {identity : Nat} {declaration : DataDecl}
      (declared : data identity = some declaration)
      (schemas : ∀ schema ∈ declaration.schemas, schema.Valid)
      (fields : ∀ schema ∈ declaration.schemas, ∀ field ∈ schema.residents,
        FiniteLayout target data field.type) : FiniteLayout target data (.nominal identity)

/-- Positive reference-free inline layout. Unlike handle finiteness, every field
of every nominal variant is recursively reference-free. Unknown nominal names
and vacant resident typing do not imply this evidence. -/
inductive ReferenceFreeLayout (target : Target) (data : DataDeclarations) : Ty → Prop where
  | unit : ReferenceFreeLayout target data .unit
  | integer (type : IntegerType) : ReferenceFreeLayout target data (.integer type)
  | character : ReferenceFreeLayout target data .character
  | tuple {head : Ty} {tail : List Ty} (first : ReferenceFreeLayout target data head)
      (rest : ∀ type ∈ tail, ReferenceFreeLayout target data type) :
      ReferenceFreeLayout target data (.tuple head tail)
  | array {element : Ty} {length : Nat} (resident : ReferenceFreeLayout target data element)
      (size : length < 2 ^ target.pointerBits) : ReferenceFreeLayout target data (.array element length)
  | nominal {identity : Nat} {declaration : DataDecl}
      (declared : data identity = some declaration)
      (schemas : ∀ schema ∈ declaration.schemas, schema.Valid)
      (fields : ∀ schema ∈ declaration.schemas, ∀ field ∈ schema.residents,
        ReferenceFreeLayout target data field.type) : ReferenceFreeLayout target data (.nominal identity)

theorem ReferenceFreeLayout.finite {target : Target} {data : DataDeclarations} {type : Ty}
    (layout : ReferenceFreeLayout target data type) : FiniteLayout target data type := by
  induction layout with
  | unit => exact .unit
  | integer type => exact .integer type
  | character => exact .character
  | tuple first rest firstIH restIH => exact .tuple firstIH restIH
  | array resident size ih => exact .array ih size
  | nominal declared schemas fields ih => exact .nominal declared schemas ih

theorem ReferenceFreeLayout.dataShape {target : Target} {data : DataDeclarations} {type : Ty}
    (finite : ReferenceFreeLayout target data type) : type.DataShape := by
  induction finite with
  | unit | integer | character | nominal => trivial
  | tuple first rest firstIH restIH => exact ⟨firstIH, (typesDataShape_iff _).mpr restIH⟩
  | array resident size ih => exact ih

/-- Syntactic data admission preserves vacant unknown nominal cells. Finite
layouts additionally admit recursive reference aggregates. The direct-reference
form retains the existing stronger referent-admission witness. -/
inductive StorageType (target : Target) (data : DataDeclarations) : Ty → Prop where
  | data {type : Ty} (shape : type.DataShape) : StorageType target data type
  | reference {referent : Ty} {mode : BorrowMode} (finite : FiniteLayout target data referent) :
      StorageType target data (.reference referent mode)
  | finite {type : Ty} (layout : FiniteLayout target data type) : StorageType target data type


/-- Constructor identity for structural matching; tuples remain distinct from nominal data. -/
inductive Head where
  | vacant
  | reference (node : Nat)
  | unit
  | integer (type : IntegerType) (number : Int)
  | character (number : Nat)
  | tuple | array
  | nominal (identity : Nat) (tag : Option Nat)
  deriving DecidableEq

/-- Runtime reference observations are not source constructor patterns. -/
def Head.Source : Head → Prop
  | .reference _ => False
  | _ => True

inductive Value where
  | vacant
  | reference (node : Nat)
  | unit
  | integer (type : IntegerType) (number : Int)
  | character (number : Nat)
  | tuple (head : Value) (tail : List Value)
  | array (elements : List Value)
  | nominal (identity : Nat) (tag : Option Nat) (fields : List Value)

mutual
/-- A whole owned result contains no vacancy at any depth. -/
def Value.initialized : Value → Bool
  | .vacant => false
  | .tuple head tail => head.initialized && valuesInitialized tail
  | .array values | .nominal _ _ values => valuesInitialized values
  | _ => true
termination_by value => sizeOf value

def valuesInitialized : List Value → Bool
  | [] => true
  | value :: values => value.initialized && valuesInitialized values
termination_by values => sizeOf values
end

mutual
/-- Total structural equality for constant patterns, without user-defined Eq. -/
def Value.equal (left right : Value) : Bool :=
  match left, right with
  | .vacant, .vacant => true
  | .reference node, .reference other => decide (node = other)
  | .unit, .unit => true
  | .integer type number, .integer otherType otherNumber => decide (type = otherType) && decide (number = otherNumber)
  | .character number, .character other => decide (number = other)
  | .tuple head tail, .tuple otherHead otherTail => head.equal otherHead && valuesEqual tail otherTail
  | .array values, .array others => valuesEqual values others
  | .nominal identity tag values, .nominal otherIdentity otherTag others =>
      decide (identity = otherIdentity) && decide (tag = otherTag) && valuesEqual values others
  | _, _ => false
termination_by sizeOf left

def valuesEqual (left right : List Value) : Bool :=
  match left, right with
  | [], [] => true
  | head :: tail, otherHead :: otherTail => head.equal otherHead && valuesEqual tail otherTail
  | _, _ => false
termination_by sizeOf left
end

instance : BEq Value := ⟨Value.equal⟩

instance : LawfulBEq Value := by
  have equal_iff : ∀ (left right : Value), left.equal right = true ↔ left = right := by
    intro left
    induction left using Value.rec
      (motive_2 := fun values => ∀ others, valuesEqual values others = true ↔ values = others) with
    | vacant => intro right; cases right <;> simp [Value.equal]
    | reference node => intro right; cases right <;> simp [Value.equal]
    | unit => intro right; cases right <;> simp [Value.equal]
    | integer type number => intro right; cases right <;> simp [Value.equal]
    | character number => intro right; cases right <;> simp [Value.equal]
    | tuple head tail headIH tailIH => intro right; cases right <;> simp [Value.equal, headIH, tailIH]
    | array values ih => intro right; cases right <;> simp [Value.equal, ih]
    | nominal identity tag values ih => intro right; cases right <;> simp [Value.equal, ih, and_assoc]
    | nil => rename_i others; cases others <;> simp [valuesEqual]
    | cons head tail headIH tailIH => rename_i others; cases others <;> simp [valuesEqual, headIH, tailIH]
  exact { rfl := (equal_iff _ _).mpr rfl, eq_of_beq := fun matched => (equal_iff _ _).mp matched }

instance : DecidableEq Value := instDecidableEqOfLawfulBEq


inductive Pattern where
  | wildcard
  | binder (name : String)
  | node (head : Head) (fields : List Pattern)
  /-- Some retains the declared type; None occurs only in coverage specialization. -/
  | literal (type : Option Ty) (value : Value)


inductive PatternSource where
  | wildcard
  | binder (name : String)
  | node (head : Head) (fields : List PatternSource)
  | constant (name : String)

inductive Initialization where
  | full
  | vacant
  /-- A correlation-losing affine join retains the actual resident or vacancy. -/
  | maybe
  | fields (entries : List (Nat × Initialization))

/-- Field access requires a definitely present ancestor, not a complete one. -/
@[simp] def Initialization.Present : Initialization → Prop
  | .full | .fields _ => True
  | .vacant | .maybe => False

def Initialization.child (state : Initialization) (index : Nat) : Initialization :=
  match state with
  | .full => .full
  | .vacant => .vacant
  | .maybe => .maybe
  | .fields entries => match entries.find? (fun entry => entry.1 == index) with
    | some entry => entry.2
    | none => .full

inductive Initialization.Complete : Initialization → Prop where
  | full : Complete .full
  | fields {entries : List (Nat × Initialization)}
      (complete : ∀ index, ((Initialization.fields entries).child index).Complete) : Complete (.fields entries)

theorem Initialization.Complete.child {state : Initialization} (complete : state.Complete) (index : Nat) :
    (state.child index).Complete := by
  cases complete with
  | full => exact .full
  | fields complete => exact complete index

def Initialization.setChild (state : Initialization) (index : Nat) (replacement : Initialization) : Initialization :=
  let entries := match state with | .fields entries => entries | _ => []
  .fields ((index, replacement) :: entries.filter (fun entry => entry.1 != index))

theorem Initialization.child_setChild {state : Initialization} (present : state.Present)
    (index : Nat) (replacement : Initialization) (other : Nat) :
    (state.setChild index replacement).child other = if other = index then replacement else state.child other := by
  cases state with
  | vacant | maybe => exact False.elim present
  | full =>
    by_cases same : other = index
    · subst other; simp only [setChild, child, List.find?_cons, show (index == index) = true from decide_eq_true rfl, ↓reduceIte]
    · simp only [setChild, child, List.filter_nil, List.find?_cons, show (index == other) = false from beq_eq_false_iff_ne.mpr (Ne.symm same), List.find?_nil, if_neg same]
  | fields entries =>
    by_cases same : other = index
    · subst other; simp only [setChild, child, List.find?_cons, show (index == index) = true from decide_eq_true rfl, ↓reduceIte]
    · simp only [setChild, child, List.find?_cons]
      simp only [show (index == other) = false from beq_eq_false_iff_ne.mpr (Ne.symm same)]
      rw [List.find?_filter]
      have predicates : (fun entry : Nat × Initialization => decide ((entry.1 != index) = true ∧ (entry.1 == other) = true)) = (fun entry => entry.1 == other) := by
        funext entry
        apply Bool.eq_iff_iff.mpr
        simp only [decide_eq_true_eq, bne_iff_ne, beq_iff_eq]
        exact ⟨And.right, fun equal => ⟨fun h => same (equal.symm.trans h), equal⟩⟩
      rw [predicates]
      simp only [if_neg same]

inductive Initialization.Access : Initialization → List Nat → Initialization → Prop where
  | here (state : Initialization) : Access state [] state
  | child {state selected : Initialization} {index : Nat} {indices : List Nat}
      (present : state.Present) (access : Access (state.child index) indices selected) : Access state (index :: indices) selected

theorem Initialization.Access.append {state middle selected : Initialization} {first second : List Nat}
    (front : state.Access first middle) (back : middle.Access second selected) :
    state.Access (first ++ second) selected := by
  induction front with
  | here => exact back
  | child present _ ih => exact .child present (ih back)

theorem Initialization.Access.deterministic {state first second : Initialization} {indices : List Nat}
    (left : state.Access indices first) (right : state.Access indices second) : first = second := by
  induction left with
  | here => cases right; rfl
  | child _ _ ih => cases right with | child _ rest => exact ih rest

theorem Initialization.Access.split {state selected : Initialization} {first second : List Nat}
    (access : state.Access (first ++ second) selected) :
    ∃ middle, state.Access first middle ∧ middle.Access second selected := by
  induction first generalizing state with
  | nil => exact ⟨state, .here _, access⟩
  | cons index indices ih =>
    cases access with
    | child present rest =>
      obtain ⟨middle, front, back⟩ := ih rest
      exact ⟨middle, .child present front, back⟩

theorem Initialization.Complete.access_all {state : Initialization} (complete : state.Complete)
    (indices : List Nat) : ∃ selected, state.Access indices selected ∧ selected.Complete := by
  induction indices generalizing state with
  | nil => exact ⟨state, .here _, complete⟩
  | cons index indices ih =>
    obtain ⟨selected, access, ready⟩ := ih (complete.child index)
    exact ⟨selected, .child (by cases complete <;> trivial) access, ready⟩


/-- Unknown presence permits replacing the whole root, never descending into it. -/
theorem Initialization.Access.maybe_iff {indices : List Nat} {selected : Initialization} :
    Access .maybe indices selected ↔ indices = [] ∧ selected = .maybe := by
  constructor
  · intro access
    cases access with
    | here => exact ⟨rfl, rfl⟩
    | child present access => exact False.elim present
  · rintro ⟨rfl, rfl⟩
    exact .here .maybe

def Initialization.write (state : Initialization) (indices : List Nat) (replacement : Initialization) : Initialization :=
  match indices with
  | [] => replacement
  | index :: rest => state.setChild index ((state.child index).write rest replacement)

theorem Initialization.setChild_complete_iff {state next : Initialization} (present : state.Present) (index : Nat) :
    (state.setChild index next).Complete ↔ next.Complete ∧ ∀ other, other ≠ index → (state.child other).Complete := by
  constructor
  · intro complete
    exact ⟨by simpa only [child_setChild present, ↓reduceIte] using complete.child index,
      fun other different => by simpa only [child_setChild present, if_neg different] using complete.child other⟩
  · rintro ⟨nextComplete, remaining⟩
    apply Complete.fields
    intro other
    change ((state.setChild index next).child other).Complete
    rw [child_setChild present]
    split
    next => exact nextComplete
    next different => exact remaining other different

theorem Initialization.Complete.access {state selected : Initialization} {indices : List Nat}
    (complete : state.Complete) (access : state.Access indices selected) : selected.Complete := by
  induction access with
  | here => exact complete
  | child present access ih => exact ih (complete.child _)

theorem Initialization.Access.write {state selected : Initialization} {indices : List Nat}
    (access : state.Access indices selected) (next : Initialization) : (state.write indices next).Access indices next := by
  induction access with
  | here => exact .here next
  | child present access ih =>
    apply Access.child (by simp [Initialization.write, setChild])
    simpa only [Initialization.write, child_setChild present, ↓reduceIte] using ih

theorem Initialization.Access.clear_incomplete {state selected : Initialization} {indices : List Nat}
    (access : state.Access indices selected) : ¬ (state.write indices .vacant).Complete := by
  intro complete
  have impossible := complete.access (access.write .vacant)
  cases impossible

inductive CoordinatesApart : List Nat → List Nat → Prop where
  | siblings {left right : Nat} {xs ys : List Nat} (different : left ≠ right) : CoordinatesApart (left :: xs) (right :: ys)
  | descend {index : Nat} {xs ys : List Nat} (apart : CoordinatesApart xs ys) : CoordinatesApart (index :: xs) (index :: ys)

theorem Initialization.Access.write_frame {state selected retained : Initialization} {indices observed : List Nat}
    (access : state.Access indices selected) (kept : state.Access observed retained) (apart : CoordinatesApart indices observed)
    (next : Initialization) : (state.write indices next).Access observed retained := by
  induction apart generalizing state selected retained with
  | siblings different =>
    cases access with
    | child present access =>
      cases kept with
      | child keptPresent kept =>
        apply Access.child (by simp [Initialization.write, setChild])
        simpa only [Initialization.write, child_setChild present, if_neg (Ne.symm different)] using kept
  | descend apart ih =>
    cases access with
    | child present access =>
      cases kept with
      | child keptPresent kept =>
        apply Access.child (by simp [Initialization.write, setChild])
        simpa only [Initialization.write, child_setChild present, ↓reduceIte] using ih access kept

theorem Initialization.Access.restore_complete {state selected next : Initialization} {indices : List Nat}
    (access : state.Access indices selected) (first : Initialization) (restored : next.Complete) :
    state.Complete → ((state.write indices first).write indices next).Complete := by
  induction access with
  | here => intro _; exact restored
  | @child state selected index indices present access ih =>
    intro complete
    have outerPresent : (state.write (index :: indices) first).Present := by simp [Initialization.write, setChild]
    apply (setChild_complete_iff outerPresent index).mpr
    constructor
    · simpa only [Initialization.write, child_setChild present, ↓reduceIte] using ih (complete.child index)
    · intro other different
      simpa only [Initialization.write, child_setChild present, if_neg different] using complete.child other

structure BindingType where
  type : Ty
  mutable : Bool := false
  initialization : Initialization := .full

structure Place where
  root : String
  fields : List FieldKey := []

/-- Canonical storage identities include hidden external backing roots.
Argument handles may share an identity and path; identities never allocate owners. -/
inductive OriginBase where
  | binder (identity : Nat)
  deriving DecidableEq

structure Origin where
  base : OriginBase
  fields : List Nat := []

/-- Shared and unique handles are loan nodes. Ended records remain in history. -/
structure SourceLoan where
  target : Origin
  referent : Ty
  parent : Option Nat
  own : Bool
  mode : BorrowMode := .shared

/-- The source producer records resident provenance compositionally. A plain
subtree asserts reference freedom but carries no invented constructor or arity. -/
inductive SourcePayload where
  | plain
  | reference (node : Nat)
  | aggregate (head : Head) (fields : List SourcePayload)

mutual
def SourcePayload.nodes : SourcePayload → List Nat
  | .plain => []
  | .reference node => [node]
  | .aggregate _ fields => payloadNodes fields

def payloadNodes : List SourcePayload → List Nat
  | [] => []
  | field :: fields => field.nodes ++ payloadNodes fields
end

/-- Paths identify occurrences, not equality of loan targets or resident values. -/
inductive SourcePayload.Occurs : SourcePayload → List Nat → Nat → Prop where
  | reference (node : Nat) : Occurs (.reference node) [] node
  | field {head : Head} {fields : List SourcePayload} {index : Nat}
      {payload : SourcePayload} {path : List Nat} {node : Nat}
      (selected : fields[index]? = some payload) (nested : Occurs payload path node) :
      Occurs (.aggregate head fields) (index :: path) node

/-- Selecting plain provenance needs the independent canonical path proof to
establish that a resident exists; this projection supplies no layout evidence. -/
def SourcePayload.select : SourcePayload → List Nat → Option SourcePayload
  | payload, [] => some payload
  | .plain, _ :: _ => some .plain
  | .reference _, _ :: _ => none
  | .aggregate _ fields, index :: path => fields[index]?.bind (fun child => child.select path)
termination_by _ path => path.length

/-- Declaration metadata is separate from the identities produced at introduction. -/
structure Slot extends BindingType where
  binder : Nat
  payload : SourcePayload

/-- Declaration identity excludes mutable resident provenance. -/
def Slot.metadata (slot : Slot) : Ty × Bool × Nat :=
  (slot.type, slot.mutable, slot.binder)

structure Context where
  names : List (String × Nat)
  storage : OriginBase → Option Slot
  loans : List SourceLoan
  nextBinder : Nat

/-- Lexical lookup is a view of authoritative source storage. Hiding names does
not hide, duplicate, or roll back the initialization of the named storage. -/
def Context.bindings (context : Context) : List (String × Slot) :=
  context.names.filterMap fun entry =>
    (context.storage (.binder entry.2)).map fun slot => (entry.1, slot)

structure ResultType where
  type : Ty
  payload : SourcePayload

/-- This is source-level explicit dereference, not an owned temporary projection. -/
inductive AccessPlace where
  | owner (place : Place)
  | dereference (reference : Place) (fields : List FieldKey)


inductive Expr where
  | unit
  | integer (type : IntegerType) (magnitude : Nat)
  | character (number : Nat)
  | group (body : Expr)
  | read (place : Place)
  | move (place : Place)
  | borrow (mode : BorrowMode) (place : AccessPlace)
  | dereference (reference : Place) (fields : List FieldKey)
  | moveIndirect (reference : Place) (fields : List FieldKey)
  | assignIndirect (reference : Place) (fields : List FieldKey) (value rest : Expr)
  | sequence (first rest : Expr)
  | bind (mutable : Bool) (name : String) (annotation : Option TypeExpr) (initial body : Expr)
  | tuple (head : Expr) (tail : List Expr)
  | array (elements : List Expr)
  | constant (name : String)
  | construct (identity : Nat) (tag : Option Nat) (fields : List Expr)
  | field (body : Expr) (key : FieldKey)
  | call (identity : Nat) (arguments : List Expr)
  | assign (place : Place) (value rest : Expr)
  | applyPatterns (inputs : List Ty) (arguments : List Expr) (arms : List (PatternSource × Expr))

mutual
/-- The sole admission derivation produces this execution metadata. Ending names
an exact lexical slot, not a source node interpreted as a runtime allocation ID. -/
inductive CorePlan where
  | leaf
  | implicitMove
  | reborrow (mode : BorrowMode)
  | unary (body : CorePlan)
  | binary (first rest : CorePlan)
  | batch (elements : List CorePlan)
  | call (arguments : List CorePlan) (body : CorePlan)
  | patterns (arguments : List CorePlan) (arms : List (PatternPlan × CorePlan))
  | endOwn (slot : Nat) (continuation : CorePlan) (fields : List Nat := [])
  | endAfter (slot : Nat) (body : CorePlan) (fields : List Nat := [])

inductive PatternPlan where
  | leaf
  | node (fields : List PatternPlan)
  | constant (initializer : CorePlan)
end

structure Core where
  source : Expr
  plan : CorePlan

def Core.erase (core : Core) : Expr := core.source

/-- This restricts constant syntax, not a second evaluator. Constant dependencies
are checked by the same typing derivation and use the same evaluation relation. -/
inductive Structural : Expr → Prop where
  | unit : Structural .unit
  | integer (type : IntegerType) (magnitude : Nat) : Structural (.integer type magnitude)
  | character (number : Nat) : Structural (.character number)
  | group {body : Expr} (closed : Structural body) : Structural (.group body)
  | tuple {head : Expr} {tail : List Expr} (first : Structural head)
      (rest : ∀ expression ∈ tail, Structural expression) : Structural (.tuple head tail)
  | array {elements : List Expr} (residents : ∀ expression ∈ elements, Structural expression) :
      Structural (.array elements)
  | constant (name : String) : Structural (.constant name)
  | construct {fields : List Expr} (identity : Nat) (tag : Option Nat)
      (residents : ∀ expression ∈ fields, Structural expression) :
      Structural (.construct identity tag fields)
  | field {body : Expr} (closed : Structural body) (key : FieldKey) : Structural (.field body key)
structure ConstantDecl where
  home : Module
  visibility : Visibility := .private
  type : TypeExpr
  body : Expr

abbrev Constants := String → Option ConstantDecl

/-- Direct, noncapturing, effect-free functions; omitted results denote unit. -/
structure FunctionDecl where
  home : Module
  visibility : Visibility := .private
  parameters : List (String × BindingType)
  result : Ty := .unit
  body : Expr

/-- One immutable decoded program supplies the facts shared by static and
dynamic semantics. It carries source declarations, never execution guarantees. -/
structure Program where
  target : Target
  aliases : Aliases
  constants : Constants
  data : DataDeclarations
  functions : Nat → Option FunctionDecl
variable {program : Program}
variable {home : Module}
/-- One field contract supplies tuple bounds and nominal visibility to reads and writes. -/
inductive ProjectionType (program : Program) (home : Module) : Ty → FieldKey → Nat → Ty → Prop where
  | tuple {first type : Ty} {rest : List Ty} {index : Nat}
      (selected : (first :: rest)[index]? = some type) :
      ProjectionType program home (.tuple first rest) (.positional index) index type
  | nominal {identity index : Nat} {key : FieldKey} {declaration : DataDecl} {schema : Fields} {field : Field}
      (declared : program.data identity = some declaration)
      (structureOnly : declaration.shape = .structure schema)
      (indexed : schema.index key = some index) (selected : schema.residents[index]? = some field)
      (visible : field.visibility.Allows declaration.home home) :
      ProjectionType program home (.nominal identity) key index field.type

inductive PathType (program : Program) (home : Module) : Ty → List FieldKey → List Nat → Ty → Prop where
  | nil (type : Ty) : PathType program home type [] [] type
  | cons {source middle target : Ty} {key : FieldKey} {keys : List FieldKey} {index : Nat} {indices : List Nat}
      (head : ProjectionType program home source key index middle) (tail : PathType program home middle keys indices target) :
      PathType program home source (key :: keys) (index :: indices) target

/-- Canonical paths retain checked projection facts, including the module which
 authorized each step. Reborrowing can cross module boundaries. -/
inductive CanonicalPath (program : Program) : Ty → List Nat → Ty → Prop where
  | nil (type : Ty) : CanonicalPath program type [] type
  | cons {source middle target : Ty} {index : Nat} {indices : List Nat}
      {home : Module} {key : FieldKey}
      (head : ProjectionType program home source key index middle)
      (tail : CanonicalPath program middle indices target) :
      CanonicalPath program source (index :: indices) target

theorem PathType.canonical {source target : Ty} {keys : List FieldKey} {indices : List Nat}
    (path : PathType program home source keys indices target) : CanonicalPath program source indices target := by
  induction path with
  | nil => exact .nil _
  | cons head _ ih => exact .cons head ih

theorem CanonicalPath.append {source middle target : Ty} {first second : List Nat}
    (front : CanonicalPath program source first middle) (back : CanonicalPath program middle second target) :
    CanonicalPath program source (first ++ second) target := by
  induction front with
  | nil => exact back
  | cons head _ ih => exact .cons head (ih back)





/-- A requested interval must be contained in the owner's principal interval. -/
def Principal.Accepts : Principal → Principal → Prop
  | .duplicable, _ => True
  | .affine, .duplicable => False
  | .affine, _ => True
  | .exact, .exact => True
  | .exact, _ => False

/-- One producer checks structural capability and coherent manual restrictions.
The index is a requested bound, not an assertion of the principal class. -/
inductive UsePermission (data : DataDeclarations) : Ty → Principal → Prop where
  | unit {bound : Principal} : UsePermission data .unit bound
  | integer (type : IntegerType) {bound : Principal} : UsePermission data (.integer type) bound
  | character {bound : Principal} : UsePermission data .character bound
  | reference (referent : Ty) {bound : Principal} : UsePermission data (.reference referent) bound
  | unique (referent : Ty) {bound : Principal} (allowed : Principal.affine.Accepts bound) :
      UsePermission data (.reference referent .unique) bound
  | tuple {head : Ty} {tail : List Ty} {bound : Principal} (first : UsePermission data head bound)
      (rest : ∀ type ∈ tail, UsePermission data type bound) : UsePermission data (.tuple head tail) bound
  | array {element : Ty} {bound : Principal} (length : Nat) (resident : UsePermission data element bound) :
      UsePermission data (.array element length) bound
  | emptyArray (element : Ty) {bound : Principal} : UsePermission data (.array element 0) bound
  | inferred {identity : Nat} {declaration : DataDecl} {bound : Principal}
      (declared : data identity = some declaration) (unrestricted : declaration.restriction = none)
      (fields : ∀ schema ∈ declaration.schemas, ∀ field ∈ schema.residents, UsePermission data field.type bound) :
      UsePermission data (.nominal identity) bound
  | restricted {identity : Nat} {declaration : DataDecl} {principal bound : Principal}
      (declared : data identity = some declaration) (restriction : declaration.restriction = some principal)
      (fields : ∀ schema ∈ declaration.schemas, ∀ field ∈ schema.residents, UsePermission data field.type principal)
      (permitted : principal.Accepts bound) : UsePermission data (.nominal identity) bound

abbrev Duplicable (data : DataDeclarations) (type : Ty) := UsePermission data type .duplicable
abbrev MayDiscard (data : DataDeclarations) (type : Ty) := UsePermission data type .affine

/-- Positive structural/declaration evidence, never failure to find Copy.
An empty concrete array has no resident witness and remains duplicable. -/
inductive Nonduplicable (data : DataDeclarations) : Ty → Prop where
  | unique (referent : Ty) : Nonduplicable data (.reference referent .unique)
  | tupleHead {head : Ty} {tail : List Ty} (resident : Nonduplicable data head) :
      Nonduplicable data (.tuple head tail)
  | tupleTail {head type : Ty} {tail : List Ty} (member : type ∈ tail)
      (resident : Nonduplicable data type) : Nonduplicable data (.tuple head tail)
  | array {element : Ty} {length : Nat} (positive : 0 < length)
      (resident : Nonduplicable data element) : Nonduplicable data (.array element length)
  | restricted {identity : Nat} {declaration : DataDecl} {principal : Principal}
      (declared : data identity = some declaration) (restriction : declaration.restriction = some principal)
      (noncopy : principal = .affine ∨ principal = .exact) : Nonduplicable data (.nominal identity)
  | field {identity : Nat} {declaration : DataDecl} {schema : Fields} {field : Field}
      (declared : data identity = some declaration) (schemaMember : schema ∈ declaration.schemas)
      (fieldMember : field ∈ schema.residents) (resident : Nonduplicable data field.type) :
      Nonduplicable data (.nominal identity)

theorem Nonduplicable.not_duplicable {data : DataDeclarations} {type : Ty}
    (noncopy : Nonduplicable data type) : ¬ Duplicable data type := by
  induction noncopy with
  | unique => intro copy; cases copy with | unique _ allowed => exact allowed
  | tupleHead resident ih => intro copy; cases copy with | tuple first rest => exact ih first
  | tupleTail member resident ih => intro copy; cases copy with | tuple first rest => exact ih (rest _ member)
  | array positive resident ih =>
    intro copy
    cases copy with
    | array _ resident => exact ih resident
    | emptyArray => exact Nat.not_lt_zero _ positive
  | restricted declared restriction noncopy =>
    intro copy
    cases copy with
    | inferred other unrestricted fields =>
      cases Option.some.inj (declared.symm.trans other)
      simp_all
    | restricted other restricted fields permitted =>
      cases Option.some.inj (declared.symm.trans other)
      cases Option.some.inj (restriction.symm.trans restricted)
      rcases noncopy with same | same <;> cases same <;> exact permitted
  | field declared schemaMember fieldMember resident ih =>
    intro copy
    cases copy with
    | inferred other unrestricted fields =>
      cases Option.some.inj (declared.symm.trans other)
      exact ih (fields _ schemaMember _ fieldMember)
    | restricted other restricted fields permitted =>
      cases Option.some.inj (declared.symm.trans other)
      have accepts : ∀ p : Principal, p.Accepts .duplicable → p = .duplicable := by
        intro p; cases p <;> simp [Principal.Accepts]
      cases accepts _ permitted
      exact ih (fields _ schemaMember _ fieldMember)

/-- Shared-handle copying uses the same capability evidence as owned data. -/
theorem UsePermission.duplicable_reference_shared {data : DataDeclarations} {referent : Ty} {mode : BorrowMode}
    (copy : Duplicable data (.reference referent mode)) : mode = .shared := by
  cases mode with
  | shared => rfl
  | unique => exact False.elim ((Nonduplicable.unique referent).not_duplicable copy)

private theorem ownedChoice_list {α : Type} {copy noncopy : α → Prop} {values : List α}
    (choices : ∀ value ∈ values, copy value ∨ noncopy value) :
    (∀ value ∈ values, copy value) ∨ ∃ value ∈ values, noncopy value := by
  induction values with
  | nil => exact .inl (by simp)
  | cons head tail ih =>
    rcases choices head (by simp) with first | first
    · rcases ih (fun value member => choices value (by simp [member])) with rest | rest
      · exact .inl (by intro value member; rcases List.mem_cons.mp member with rfl | member; exact first; exact rest _ member)
      · obtain ⟨value, member, witness⟩ := rest
        exact .inr ⟨value, by simp [member], witness⟩
    · exact .inr ⟨head, by simp, first⟩

/-- Every finite data layout has an evidence-backed owned-use choice. Restriction
checks and resident witnesses, not proof-search failure, select transfer. -/
theorem FiniteLayout.owned_choice {target : Target} {data : DataDeclarations} {type : Ty}
    (finite : FiniteLayout target data type) : Duplicable data type ∨ Nonduplicable data type := by
  induction finite with
  | unit => exact .inl .unit
  | integer type => exact .inl (.integer type)
  | character => exact .inl .character
  | reference referent mode =>
    cases mode with
    | shared => exact .inl (.reference referent)
    | unique => exact .inr (.unique referent)
  | tuple first rest firstIH restIH =>
    rcases firstIH with copy | noncopy
    · rcases ownedChoice_list restIH with copies | witness
      · exact .inl (.tuple copy copies)
      · obtain ⟨type, member, noncopy⟩ := witness
        exact .inr (.tupleTail member noncopy)
    · exact .inr (.tupleHead noncopy)
  | @array element length resident size ih =>
    cases length with
    | zero => exact .inl (.emptyArray element)
    | succ length =>
      rcases ih with copy | noncopy
      · exact .inl (.array _ copy)
      · exact .inr (.array (Nat.zero_lt_succ _) noncopy)
  | @nominal identity declaration declared schemas fields ih =>
    have classified := ownedChoice_list (fun schema member => ownedChoice_list (ih schema member))
    rcases classified with copies | witness
    · cases restriction : declaration.restriction with
      | none => exact .inl (.inferred declared restriction copies)
      | some principal =>
        cases principal with
        | duplicable => exact .inl (.restricted declared restriction copies trivial)
        | affine => exact .inr (.restricted declared restriction (.inl rfl))
        | exact => exact .inr (.restricted declared restriction (.inr rfl))
    · obtain ⟨schema, schemaMember, field, fieldMember, noncopy⟩ := witness
      exact .inr (.field declared schemaMember fieldMember noncopy)

/-- A branch may preserve its exact mask, or forget an affine slot's state.
No resident is destroyed and no runtime choice is supplied by this rule. -/
inductive Initialization.Joins (data : DataDeclarations) (type : Ty) : Initialization → Initialization → Prop where
  | same (state : Initialization) : Joins data type state state
  | affine {state : Initialization} (permission : MayDiscard data type) : Joins data type state .maybe

/-- Correlation-losing joins preserve lexical identity, type and mutability.
Positive-lower slots must retain their entire initialization mask. -/
inductive ContextJoins (program : Program) : List (String × BindingType) → List (String × BindingType) → Prop where
  | nil : ContextJoins program [] []
  | cons {name : String} {type : Ty} {mutable : Bool} {before after : Initialization}
      {context joined : List (String × BindingType)}
      (head : Initialization.Joins program.data type before after) (tail : ContextJoins program context joined) :
      ContextJoins program ((name, ⟨type, mutable, before⟩) :: context) ((name, ⟨type, mutable, after⟩) :: joined)

theorem Initialization.Joins.positive_lower {data : DataDeclarations} {type : Ty} {before after : Initialization}
    (joined : Joins data type before after) (positive : ¬ MayDiscard data type) : before = after := by
  cases joined with
  | same => rfl
  | affine permission => exact False.elim (positive permission)

def Initialization.Hole (program : Program) (state : Initialization) (type : Ty) : Prop :=
  ∃ home keys indices target, PathType program home type keys indices target ∧ state.Access indices .vacant

mutual
inductive StorageDisposition (program : Program) : Initialization → Ty → Prop where
  | vacant {type : Ty} : StorageDisposition program .vacant type
  | whole {state : Initialization} {type : Ty} (permission : MayDiscard program.data type) : StorageDisposition program state type
  | tuple {state : Initialization} {first : Ty} {rest : List Ty}
      (hole : state.Hole program (.tuple first rest)) (fields : StorageDispositions program state.child (first :: rest)) :
      StorageDisposition program state (.tuple first rest)
  | nominal {state : Initialization} {identity : Nat} {declaration : DataDecl} {schema : Fields}
      (declared : program.data identity = some declaration) (structureOnly : declaration.shape = .structure schema)
      (hole : state.Hole program (.nominal identity))
      (fields : StorageDispositions program state.child (schema.residents.map Field.type)) :
      StorageDisposition program state (.nominal identity)
inductive StorageDispositions (program : Program) : (Nat → Initialization) → List Ty → Prop where
  | nil {states : Nat → Initialization} : StorageDispositions program states []
  | cons {states : Nat → Initialization} {first : Ty} {rest : List Ty}
      (head : StorageDisposition program (states 0) first)
      (tail : StorageDispositions program (fun index => states (index + 1)) rest) : StorageDispositions program states (first :: rest)
end

def BindingType.Disposable (program : Program) (slot : BindingType) : Prop :=
  StorageDisposition program slot.initialization slot.type

/-- Nearest lexical binding wins, including in shadowing initializers. -/
def lookup {α : Type} (name : String) : List (String × α) → Option α
  | [] => none
  | (key, value) :: rest => if name = key then some value else lookup name rest

mutual
inductive ResidentTyped (program : Program) : Initialization → Value → Ty → Prop where
  | vacant {type : Ty} : ResidentTyped program .vacant .vacant type
  /-- Static uncertainty never replaces, drops or fabricates a branch resident. -/
  | uncertain {state : Initialization} {value : Value} {type : Ty}
      (actual : ResidentTyped program state value type) (permission : MayDiscard program.data type) :
      ResidentTyped program .maybe value type
  | unit : ResidentTyped program .full .unit .unit
  | integer {type : IntegerType} {number : Int} (fits : type.Contains program.target number) :
      ResidentTyped program .full (.integer type number) (.integer type)
  | character {number : Nat} (valid : UnicodeScalar number) : ResidentTyped program .full (.character number) .character
  /-- This is inert handle shape, not usable reference validity. -/
  | reference {referent : Ty} {mode : BorrowMode} (node : Nat) (finite : FiniteLayout program.target program.data referent) :
      ResidentTyped program .full (.reference node) (.reference referent mode)
  | tuple {state : Initialization} {head : Value} {tail : List Value} {first : Ty} {rest : List Ty}
      (headTyped : ResidentTyped program (state.child 0) head first)
      (tailTyped : ResidentsTyped program (fun index => state.child (index + 1)) tail rest)
      (present : state.Present := by trivial) :
      ResidentTyped program state (.tuple head tail) (.tuple first rest)
  | array {state : Initialization} {values : List Value} {element : Ty} {length : Nat}
      (residents : ResidentsTyped program state.child values (List.replicate length element))
      (elementValid : FiniteLayout program.target program.data element)
      (size : length < 2 ^ program.target.pointerBits)
      (present : state.Present := by trivial) :
      ResidentTyped program state (.array values) (.array element length)
  | nominal {state : Initialization} {identity : Nat} {tag : Option Nat} {declaration : DataDecl} {schema : Fields}
      {values : List Value} (declared : program.data identity = some declaration)
      (chosen : declaration.constructor tag = some schema)
      (finite : FiniteLayout program.target program.data (.nominal identity))
      (residents : ResidentsTyped program state.child values (schema.residents.map Field.type))
      (present : state.Present := by trivial) :
      ResidentTyped program state (.nominal identity tag values) (.nominal identity)
inductive ResidentsTyped (program : Program) : (Nat → Initialization) → List Value → List Ty → Prop where
  | nil {states : Nat → Initialization} : ResidentsTyped program states [] []
  | cons {states : Nat → Initialization} {head : Value} {tail : List Value} {first : Ty} {rest : List Ty}
      (headTyped : ResidentTyped program (states 0) head first)
      (tailTyped : ResidentsTyped program (fun index => states (index + 1)) tail rest) :
      ResidentsTyped program states (head :: tail) (first :: rest)
end

abbrev ValueHasType (program : Program) (value : Value) (type : Ty) := ResidentTyped program .full value type
abbrev ValuesHaveTypes (program : Program) (values : List Value) (types : List Ty) :=
  ResidentsTyped program (fun _ => .full) values types

theorem ResidentTyped.complete {program : Program} {state : Initialization} {value : Value} {type : Ty}
    (typed : ResidentTyped program state value type) (complete : state.Complete) :
    ValueHasType program value type ∧ value.initialized = true := by
  induction typed using ResidentTyped.rec
    (motive_2 := fun states values types _ => (∀ index, (states index).Complete) →
      ValuesHaveTypes program values types ∧ valuesInitialized values = true) with
  | vacant => cases complete
  | uncertain actual permission ih => cases complete
  | unit => exact ⟨.unit, by simp [Value.initialized]⟩
  | integer fits => exact ⟨.integer fits, by simp [Value.initialized]⟩
  | character valid => exact ⟨.character valid, by simp [Value.initialized]⟩
  | reference node finite => exact ⟨.reference node finite, by simp [Value.initialized]⟩
  | tuple head tail present headIH tailIH =>
    obtain ⟨headTyped, headLive⟩ := headIH (complete.child 0)
    obtain ⟨tailTyped, tailLive⟩ := tailIH (fun index => complete.child (index + 1))
    exact ⟨.tuple headTyped tailTyped, by simp [Value.initialized, headLive, tailLive]⟩
  | array residents elementValid size present ih =>
    obtain ⟨typed, live⟩ := ih complete.child
    exact ⟨.array typed elementValid size, by simpa [Value.initialized] using live⟩
  | nominal declared chosen finite residents present ih =>
    obtain ⟨typed, live⟩ := ih complete.child
    exact ⟨.nominal declared chosen finite typed, by simpa [Value.initialized] using live⟩
  | nil => exact ⟨.nil, by simp [valuesInitialized]⟩
  | cons head tail headIH tailIH =>
    rename_i complete
    obtain ⟨headTyped, headLive⟩ := headIH (complete 0)
    obtain ⟨tailTyped, tailLive⟩ := tailIH (fun index => complete (index + 1))
    exact ⟨.cons headTyped tailTyped, by simp [valuesInitialized, headLive, tailLive]⟩

/-- Transferred inputs, not resident storage. Introduction allocates logical roots. -/
abbrev BindingValues := List (String × Value)

/-- Unbounded logical identities, not physical addresses or allocation requests. -/
abbrev Root := Nat
abbrev Store := Root → Option Value
/-- A logical resident coordinate, never a physical byte address. -/
structure Address where
  root : Root
  fields : List Nat
  deriving DecidableEq

/-- Different roots, or divergent fields below one root, cannot alias. -/
def Address.Apart (left right : Address) : Prop :=
  left.root ≠ right.root ∨ CoordinatesApart left.fields right.fields

/-- A runtime node retains its canonical target and immutable ancestry. Own
availability is independent of carrier location; ending changes only own. -/
structure Loan where
  target : Address
  parent : Option Nat
  own : Bool
  mode : BorrowMode := .shared


structure Environment where
  bindings : List (String × Root)
  store : Store
  nextRoot : Root
  loans : List Loan := []

namespace Environment

def empty : Environment := ⟨[], fun _ => none, 0, []⟩
def roots (environment : Environment) := environment.bindings.map Prod.snd

/-- Coarse mutation framing is not access authorization. Own permission and
mode select live unique targets; inactive history may name retired cells. -/
def UniqueRoot (environment : Environment) (root : Root) : Prop :=
  ∃ (node : Nat) (loan : Loan), environment.loans[node]? = some loan ∧ loan.own = true ∧
    loan.mode = .unique ∧ loan.target.root = root

def MutationRoot (environment : Environment) (root : Root) : Prop :=
  root ∈ environment.roots ∨ environment.UniqueRoot root

/-- Hidden cells, as well as visible roots, precede the never-rewound supply.
Distinct lexical roots prevent two owned bindings from aliasing one resident. -/
structure Valid (environment : Environment) : Prop where
  bounded : ∀ root value, environment.store root = some value → root < environment.nextRoot
  named : ∀ root ∈ environment.roots, root < environment.nextRoot
  distinct : environment.roots.Nodup

def get (name : String) (environment : Environment) : Option Value := do
  let root ← lookup name environment.bindings
  environment.store root

def put (root : Root) (resident : Value) (environment : Environment) : Environment :=
  { environment with store := fun other => if other = root then some resident else environment.store other }

def bind (name : String) (resident : Value) (environment : Environment) : Environment :=
  { environment with
    bindings := (name, environment.nextRoot) :: environment.bindings
    store := fun root => if root = environment.nextRoot then some resident else environment.store root
    nextRoot := environment.nextRoot + 1 }

/-- Source-order introduction produces a reversed, newest-first lexical prefix. -/
def prepare : BindingValues → Environment → Environment
  | [], environment => environment
  | (name, value) :: rest, environment => prepare rest (environment.bind name value)

def hide (environment : Environment) : Environment := { environment with bindings := [] }

/-- Retirement removes cells; a move instead leaves a live vacant cell. -/
def retire (count : Nat) (environment : Environment) : Environment :=
  { environment with
    bindings := environment.bindings.drop count
    store := fun root => if root ∈ (environment.bindings.take count).map Prod.snd then none else environment.store root }

/-- Restore visibility only, retaining the actual callee post-store and supply. -/
def resume (caller after : Environment) : Environment := { after with bindings := caller.bindings }

end Environment

namespace Environment

theorem Valid.empty : empty.Valid := by
  refine ⟨?_, ?_, by simp [roots, Environment.empty]⟩
  · intro root value found; cases found
  · simp [roots, Environment.empty]

/-- Freshness is derived from the store invariant, never assumed as a certificate. -/
theorem Valid.fresh {environment : Environment} (valid : environment.Valid) :
    environment.store environment.nextRoot = none := by
  cases found : environment.store environment.nextRoot with
  | none => rfl
  | some value => exact False.elim (Nat.lt_irrefl _ (valid.bounded _ _ found))

theorem lookup_mem {bindings : List (String × Root)} {name : String} {root : Root}
    (found : lookup name bindings = some root) : root ∈ bindings.map Prod.snd := by
  induction bindings with
  | nil => simp [lookup] at found
  | cons entry rest ih =>
    simp only [lookup] at found
    split at found
    · cases found; simp
    · exact List.mem_cons_of_mem _ (ih found)

theorem Valid.put {environment : Environment} (valid : environment.Valid)
    {root : Root} (bound : root < environment.nextRoot) (value : Value) :
    (environment.put root value).Valid := by
  refine ⟨?_, valid.named, valid.distinct⟩
  intro other resident found
  simp only [Environment.put] at found ⊢
  split at found
  · subst other; exact bound
  · exact valid.bounded _ _ found

theorem Valid.bind {environment : Environment} (valid : environment.Valid) (name : String) (value : Value) :
    (environment.bind name value).Valid := by
  refine ⟨?_, ?_, ?_⟩
  · intro root resident found
    simp only [Environment.bind] at found ⊢
    split at found
    · subst root; exact Nat.lt_succ_self _
    · exact Nat.lt_succ_of_lt (valid.bounded _ _ found)
  · intro root included
    simp only [roots, Environment.bind, List.map_cons, List.mem_cons] at included
    rcases included with rfl | included
    · exact Nat.lt_succ_self _
    · exact Nat.lt_succ_of_lt (valid.named root included)
  · simp only [roots, Environment.bind, List.map_cons, List.nodup_cons]
    exact ⟨fun included => Nat.lt_irrefl _ (valid.named _ included), valid.distinct⟩

theorem Valid.hide {environment : Environment} (valid : environment.Valid) : environment.hide.Valid :=
  ⟨valid.bounded, by simp [roots, Environment.hide], by simp [roots, Environment.hide]⟩

theorem Valid.prepare {environment : Environment} (valid : environment.Valid) (values : BindingValues) :
    (environment.prepare values).Valid := by
  induction values generalizing environment with
  | nil => exact valid
  | cons entry rest ih => exact ih (valid.bind entry.1 entry.2)

theorem Valid.retire {environment : Environment} (valid : environment.Valid) (count : Nat) :
    (environment.retire count).Valid := by
  refine ⟨?_, ?_, ?_⟩
  · intro root value found
    simp only [Environment.retire] at found ⊢
    split at found
    · cases found
    · exact valid.bounded _ _ found
  · intro root included
    apply valid.named root
    simpa only [roots, Environment.retire, List.map_drop] using (List.mem_of_mem_drop (by simpa [roots, Environment.retire, List.map_drop] using included) : root ∈ environment.roots)
  · simpa only [roots, Environment.retire, List.map_drop, List.Nodup] using (valid.distinct.drop (i := count))

theorem retire_absent (environment : Environment) (count : Nat) {root : Root}
    (retired : root ∈ (environment.bindings.take count).map Prod.snd) :
    (environment.retire count).store root = none := by simp only [Environment.retire, if_pos retired]

theorem retire_frame (environment : Environment) (count : Nat) {root : Root}
    (retained : root ∉ (environment.bindings.take count).map Prod.snd) :
    (environment.retire count).store root = environment.store root := by simp only [Environment.retire, if_neg retained]

theorem retire_retained {environment : Environment} (valid : environment.Valid) (count : Nat) {root : Root}
    (retained : root ∈ (environment.bindings.drop count).map Prod.snd) :
    (environment.retire count).store root = environment.store root := by
  apply retire_frame
  have distinct : ((environment.roots.take count) ++ environment.roots.drop count).Nodup := by
    simpa using valid.distinct
  have disjoint := (List.nodup_append.mp distinct).2.2
  intro included
  exact disjoint _ (by simpa [roots, List.map_take] using included) _
    (by simpa [roots, List.map_drop] using retained) rfl

end Environment

/-- Actual execution preserves names and frames cells outside incoming owners
and unique targets. Newly introduced authority originates in that footprint or
the fresh supply. Scoped fresh cells are retired; old vacancies never resurrect. -/
structure Environment.Evolution (before after : Environment) : Prop where
  bindings : after.bindings = before.bindings
  supply : before.nextRoot ≤ after.nextRoot
  frame : ∀ root, ¬ before.MutationRoot root → after.store root = before.store root
  authority : ∀ root, after.UniqueRoot root → before.MutationRoot root ∨ before.nextRoot ≤ root
  vacancies : ∀ root, root < before.nextRoot → before.store root = none → after.store root = none
  fresh : ∀ root, before.nextRoot ≤ root → after.store root = none

namespace Environment.Evolution

theorem absent {before after : Environment} (evolved : Evolution before after)
    (root : Root) (missing : before.store root = none) : after.store root = none := by
  by_cases old : root < before.nextRoot
  · exact evolved.vacancies root old missing
  · exact evolved.fresh root (Nat.le_of_not_gt old)

theorem refl (environment : Environment) (valid : environment.Valid) : Evolution environment environment := by
  refine ⟨rfl, Nat.le_refl _, fun _ _ => rfl, fun _ live => .inl (.inr live), fun _ _ missing => missing, ?_⟩
  intro root fresh
  cases found : environment.store root with
  | none => rfl
  | some value => exact False.elim (Nat.not_lt_of_ge fresh (valid.bounded root value found))

theorem trans {before middle after : Environment} (first : Evolution before middle)
    (rest : Evolution middle after) : Evolution before after := by
  refine ⟨rest.bindings.trans first.bindings, Nat.le_trans first.supply rest.supply, ?_, ?_, ?_, ?_⟩
  · intro root outside
    by_cases old : root < before.nextRoot
    · have hidden : ¬ middle.MutationRoot root := by
        intro member
        rcases member with named | live
        · exact outside (.inl (by simpa only [Environment.roots, first.bindings] using named))
        · rcases first.authority root live with member | fresh
          · exact outside member
          · exact Nat.not_lt_of_ge fresh old
      exact (rest.frame root hidden).trans (first.frame root outside)
    · have missing := first.fresh root (Nat.le_of_not_gt old)
      exact (rest.absent root missing).trans (missing.symm.trans (first.frame root outside))
  · intro root live
    rcases rest.authority root live with member | fresh
    · rcases member with named | live
      · exact .inl (.inl (by simpa only [Environment.roots, first.bindings] using named))
      · exact first.authority root live
    · exact .inr (Nat.le_trans first.supply fresh)
  · intro root old missing
    exact rest.absent root (first.vacancies root old missing)
  · intro root fresh
    exact rest.absent root (first.fresh root fresh)
end Environment.Evolution

namespace Environment

theorem retire_add (environment : Environment) (first rest : Nat) :
    (environment.retire first).retire rest = environment.retire (first + rest) := by
  cases environment with
  | mk bindings store nextRoot loans =>
    simp only [retire, List.drop_drop]
    congr 1
    funext root
    have takeAdd : ∀ (bindings : List (String × Root)) (first rest : Nat),
        bindings.take (first + rest) = bindings.take first ++ (bindings.drop first).take rest := by
      intro bindings first
      induction first generalizing bindings with
      | zero => intro rest; simp only [Nat.zero_add, List.take_zero, List.drop_zero, List.nil_append]
      | succ first ih =>
        intro rest
        cases bindings with
        | nil => simp
        | cons entry bindings => simpa only [Nat.succ_add, List.take_succ_cons, List.drop_succ_cons, List.cons_append] using congrArg (entry :: ·) (ih bindings rest)
    have union : root ∈ (bindings.take (first + rest)).map Prod.snd ↔
        root ∈ (bindings.take first).map Prod.snd ∨ root ∈ ((bindings.drop first).take rest).map Prod.snd := by
      rw [takeAdd, List.map_append, List.mem_append]
    by_cases tail : root ∈ ((bindings.drop first).take rest).map Prod.snd
    · simp only [if_pos tail, if_pos (union.mpr (Or.inr tail))]
    · by_cases head : root ∈ (bindings.take first).map Prod.snd
      · simp only [if_neg tail, if_pos head, if_pos (union.mpr (Or.inl head))]
      · have absent : root ∉ (bindings.take (first + rest)).map Prod.snd :=
          fun member => (union.mp member).elim head tail
        simp only [if_neg tail, if_neg head, if_neg absent]

theorem Evolution.unbind {before after : Environment} (valid : before.Valid) {name : String} {value : Value}
    (evolved : Evolution (before.bind name value) after) : Evolution before (after.retire 1) := by
  refine ⟨by simp [retire, evolved.bindings, bind], Nat.le_trans (Nat.le_succ _) evolved.supply, ?_, ?_, ?_, ?_⟩
  · intro root outside
    by_cases same : root = before.nextRoot
    · subst root
      rw [show (after.retire 1).store before.nextRoot = none by simp [retire, evolved.bindings, bind]]
      exact valid.fresh.symm
    · have hidden : ¬ (before.bind name value).MutationRoot root := by
        simpa [MutationRoot, UniqueRoot, roots, bind, same] using outside
      have framed := evolved.frame root hidden
      simpa [retire, evolved.bindings, bind, same] using framed
  · intro root live
    rcases evolved.authority root live with member | fresh
    · rcases member with named | live
      · have included : root = before.nextRoot ∨ root ∈ before.roots := by simpa [roots, bind] using named
        rcases included with same | named
        · exact .inr (Nat.le_of_eq same.symm)
        · exact .inl (.inl named)
      · exact .inl (.inr live)
    · exact .inr (Nat.le_trans (Nat.le_succ _) fresh)
  · intro root old missing
    have different := Nat.ne_of_lt old
    have still := evolved.vacancies root (Nat.lt_succ_of_lt old) (by simpa [bind, different] using missing)
    simpa [retire, evolved.bindings, bind, different] using still
  · intro root fresh
    by_cases same : root = before.nextRoot
    · subst root; simp [retire, evolved.bindings, bind]
    · have later : before.nextRoot + 1 ≤ root := Nat.succ_le_of_lt (Nat.lt_of_le_of_ne fresh (Ne.symm same))
      have missing := evolved.fresh root later
      simpa [retire, evolved.bindings, bind, same] using missing

theorem Evolution.scope {before after : Environment} (valid : before.Valid) (values : BindingValues)
    (evolved : Evolution (before.prepare values) after) : Evolution before (after.retire values.length) := by
  induction values generalizing before with
  | nil => simpa [prepare, retire] using evolved
  | cons entry rest ih =>
    have inner := ih (valid.bind entry.1 entry.2) evolved
    have outer := inner.unbind valid
    simpa [retire_add, Nat.add_comm] using outer

theorem Evolution.resume {caller after : Environment} (evolved : Evolution caller.hide after) :
    Evolution caller (caller.resume after) := by
  refine ⟨rfl, evolved.supply, ?_, ?_, evolved.vacancies, evolved.fresh⟩
  · intro root outside
    exact evolved.frame root (by simpa [MutationRoot, UniqueRoot, roots, hide] using (fun live => outside (.inr live)))
  · intro root live
    rcases evolved.authority root live with member | fresh
    · rcases member with named | live
      · simp [roots, hide] at named
      · exact .inl (.inr live)
    · exact .inr fresh

theorem Valid.resume {caller after : Environment} (valid : caller.Valid) (afterValid : after.Valid)
    (supply : caller.nextRoot ≤ after.nextRoot) : (caller.resume after).Valid :=
  ⟨afterValid.bounded, fun root member => Nat.lt_of_lt_of_le (valid.named root member) supply, valid.distinct⟩

end Environment

/-- Read-only logical-value projection. A missing cell has no constructor;
there is no default value and no independent copy of runtime residents. -/
inductive StoredBindings (store : Store) : List (String × Root) → BindingValues → Prop where
  | nil : StoredBindings store [] []
  | cons {name : String} {root : Root} {value : Value} {bindings : List (String × Root)} {values : BindingValues}
      (found : store root = some value) (rest : StoredBindings store bindings values) :
      StoredBindings store ((name, root) :: bindings) ((name, value) :: values)

namespace StoredBindings



theorem frame {before after : Store} {bindings : List (String × Root)} {values : BindingValues}
    (stored : StoredBindings before bindings values)
    (same : ∀ root ∈ bindings.map Prod.snd, after root = before root) : StoredBindings after bindings values := by
  induction stored with
  | nil => exact .nil
  | cons found rest ih =>
    exact .cons ((same _ (by simp)).trans found) (ih (fun root member => same root (List.mem_cons_of_mem _ member)))

theorem take {store : Store} {bindings : List (String × Root)} {values : BindingValues}
    (stored : StoredBindings store bindings values) (count : Nat) :
    StoredBindings store (bindings.take count) (values.take count) := by
  induction count generalizing bindings values with
  | zero => exact .nil
  | succ count ih => cases stored with
    | nil => exact .nil
    | cons found rest => exact .cons found (ih rest)

theorem drop {store : Store} {bindings : List (String × Root)} {values : BindingValues}
    (stored : StoredBindings store bindings values) (count : Nat) :
    StoredBindings store (bindings.drop count) (values.drop count) := by
  induction count generalizing bindings values with
  | zero => exact stored
  | succ count ih => cases stored with
    | nil => exact .nil
    | cons found rest => exact ih rest

theorem lookup {store : Store} {bindings : List (String × Root)} {values : BindingValues}
    (stored : StoredBindings store bindings values) (name : String) :
    (Grounded.lookup name bindings >>= store) = Grounded.lookup name values := by
  induction stored with
  | nil => rfl
  | cons found rest ih => simp only [Grounded.lookup]; split <;> simp_all

end StoredBindings

/-- Vacancies are storage, never well-typed owned results. -/
abbrev SlotTyped (program : Program) (resident : Value) (slot : BindingType) :=
  ResidentTyped program slot.initialization resident slot.type

inductive ValuesBindingsTyped (program : Program) : BindingValues → List (String × BindingType) → Prop where
  | nil : ValuesBindingsTyped program [] []
  | cons {name : String} {value : Value} {type : BindingType}
      {environment : BindingValues} {context : List (String × BindingType)}
      (resident : SlotTyped program value type) (rest : ValuesBindingsTyped program environment context) :
      ValuesBindingsTyped program ((name, value) :: environment) ((name, type) :: context)

/-- Resident typing consumes the authoritative root lookup relation. -/
structure EnvironmentTyped (program : Program) (environment : Environment) (context : List (String × BindingType)) : Prop where
  valid : environment.Valid
  residents : ∃ values, StoredBindings environment.store environment.bindings values ∧ ValuesBindingsTyped program values context

/-- Join soundness keeps the actual branch resident unchanged. -/
theorem ResidentTyped.join {state joined : Initialization} {value : Value} {type : Ty}
    (typed : ResidentTyped program state value type) (join : Initialization.Joins program.data type state joined) :
    ResidentTyped program joined value type := by
  cases join with
  | same => exact typed
  | affine permission => exact .uncertain typed permission

/-- A common static post-context accepts each actual branch environment verbatim. -/
theorem ValuesBindingsTyped.join {environment : BindingValues} {context joined : List (String × BindingType)}
    (typed : ValuesBindingsTyped program environment context) (join : ContextJoins program context joined) :
    ValuesBindingsTyped program environment joined := by
  induction join generalizing environment with
  | nil => cases typed; exact .nil
  | cons head tail ih =>
    cases typed with
    | cons resident rest => exact .cons (ResidentTyped.join resident head) (ih rest)

theorem Principal.Accepts.trans {first middle last : Principal} (front : first.Accepts middle) (back : middle.Accepts last) : first.Accepts last := by
  cases first <;> cases middle <;> cases last <;> simp_all [Principal.Accepts]

theorem UsePermission.weaken {data : DataDeclarations} {type : Ty} {bound requested : Principal}
    (permission : UsePermission data type bound) (accepted : bound.Accepts requested) : UsePermission data type requested := by
  induction permission with
  | unit => exact .unit
  | integer type => exact .integer type
  | character => exact .character
  | reference referent => exact .reference referent
  | unique referent allowed => exact .unique referent (allowed.trans accepted)
  | tuple first rest firstIH restIH => exact .tuple (firstIH accepted) (fun type included => restIH type included accepted)
  | array length resident ih => exact .array length (ih accepted)
  | emptyArray element => exact .emptyArray element
  | inferred declared unrestricted fields ih => exact .inferred declared unrestricted (fun schema included field member => ih schema included field member accepted)
  | restricted declared restriction fields permitted ih => exact .restricted declared restriction fields (permitted.trans accepted)

theorem UsePermission.nominal_restriction {data : DataDeclarations} {identity : Nat} {declaration : DataDecl} {principal bound : Principal}
    (permission : UsePermission data (.nominal identity) bound) (declared : data identity = some declaration)
    (restriction : declaration.restriction = some principal) : principal.Accepts bound := by
  cases permission with
  | inferred found unrestricted fields =>
    have same := Option.some.inj (found.symm.trans declared)
    cases same
    simp [restriction] at unrestricted
  | restricted found chosen fields permitted =>
    have same := Option.some.inj (found.symm.trans declared)
    cases same
    have samePrincipal := Option.some.inj (chosen.symm.trans restriction)
    cases samePrincipal
    exact permitted

theorem ResidentTyped.vacant_value {program : Program} {value : Value} {type : Ty}
    (typed : ResidentTyped program .vacant value type) : value = .vacant := by
  cases typed <;> simp_all

inductive Value.Disposable (program : Program) : Value → Prop where
  | vacant : Value.Disposable program .vacant
  | owned {state : Initialization} {value : Value} {type : Ty}
      (typed : ResidentTyped program state value type) (permission : MayDiscard program.data type) : Value.Disposable program value
  | tuple {head : Value} {tail : List Value} (incomplete : (Value.tuple head tail).initialized = false)
      (first : Value.Disposable program head) (rest : ∀ value ∈ tail, Value.Disposable program value) :
      Value.Disposable program (.tuple head tail)
  | nominal {identity : Nat} {declaration : DataDecl} {schema : Fields} {values : List Value}
      (declared : program.data identity = some declaration) (structureOnly : declaration.shape = .structure schema)
      (incomplete : (Value.nominal identity none values).initialized = false)
      (fields : ∀ value ∈ values, Value.Disposable program value) : Value.Disposable program (.nominal identity none values)

theorem ResidentTyped.disposable {state : Initialization} {value : Value} {type : Ty}
    (typed : ResidentTyped program state value type) (allowed : MayDiscard program.data type) : value.Disposable program :=
  .owned typed allowed

theorem ValuesBindingsTyped.take {environment : BindingValues} {context : List (String × BindingType)}
    (typed : ValuesBindingsTyped program environment context) (count : Nat) :
    ValuesBindingsTyped program (environment.take count) (context.take count) := by
  induction count generalizing environment context with
  | zero => exact .nil
  | succ count ih =>
    cases typed with
    | nil => exact .nil
    | cons head tail => exact .cons head (ih tail)



def Value.head : Value → Head
  | .vacant => .vacant
  | .reference node => .reference node
  | .unit => .unit
  | .integer type number => .integer type number
  | .character number => .character number
  | .tuple _ _ => .tuple
  | .array _ => .array
  | .nominal identity tag _ => .nominal identity tag

/-- Children remain in declaration order. -/
def Value.children : Value → List Value
  | .tuple head tail => head :: tail
  | .array values | .nominal _ _ values => values
  | _ => []

mutual
/-- Logical finish events use relative field paths, never physical addresses. -/
def Value.destructionTrace : Value → List (List Nat)
  | .vacant => []
  | .unit | .integer _ _ | .character _ | .reference _ => [[]]
  | .tuple head tail => destructionFields 0 (head :: tail) ++ [[]]
  | .array values | .nominal _ _ values => destructionFields 0 values ++ [[]]
def destructionFields (index : Nat) : List Value → List (List Nat)
  | [] => []
  | value :: values => destructionFields (index + 1) values ++ value.destructionTrace.map (index :: ·)
end

mutual
/-- Finite no-hook logical destruction: vacant slots are skipped, children
execute right to left, and only then does the enclosing resident finish. -/
inductive Value.Destroys (program : Program) : Value → List (List Nat) → Value → Prop where
  | vacant : Value.Destroys program .vacant [] .vacant
  | resident {value : Value} {trace : List (List Nat)}
      (present : value ≠ .vacant) (allowed : value.Disposable program)
      (children : DestroysFields program 0 value.children trace) :
      Value.Destroys program value (trace ++ [[]]) .vacant
inductive DestroysFields (program : Program) : Nat → List Value → List (List Nat) → Prop where
  | nil (index : Nat) : DestroysFields program index [] []
  | cons {index : Nat} {value : Value} {values : List Value} {first rest : List (List Nat)}
      (tail : DestroysFields program (index + 1) values rest)
      (head : value.Destroys program first .vacant) :
      DestroysFields program index (value :: values) (rest ++ first.map (index :: ·))
end

theorem Value.Destroys.result_order {value after : Value} {trace : List (List Nat)}
    (executed : value.Destroys program trace after) :
    after = .vacant ∧ trace = value.destructionTrace := by
  induction executed using Value.Destroys.rec
    (motive_2 := fun index values trace _ => trace = destructionFields index values) with
  | vacant => simp [Value.destructionTrace]
  | @resident value trace present allowed children ih =>
    refine ⟨rfl, ?_⟩
    rw [ih]
    cases value <;> simp_all [destructionTrace, Value.children, destructionFields]
  | nil => simp [destructionFields]
  | cons tail head tailIH headIH => simp [destructionFields, tailIH, headIH.2]

theorem ResidentTyped.children_disposable {state : Initialization} {value : Value} {type : Ty}
    (typed : ResidentTyped program state value type) (allowed : MayDiscard program.data type) :
    ∀ child ∈ value.children, child.Disposable program := by
  have residents : ∀ {states : Nat → Initialization} {values : List Value} {types : List Ty},
      ResidentsTyped program states values types → (∀ type ∈ types, MayDiscard program.data type) →
      ∀ value ∈ values, value.Disposable program := by
    intro states values
    induction values generalizing states with
    | nil => intro types typed permissions value member; cases member
    | cons head tail ih =>
      intro types typed permissions value member
      cases typed with
      | cons first rest =>
        rcases List.mem_cons.mp member with rfl | member
        · exact .owned first (permissions _ (by simp))
        · exact ih rest (fun type member => permissions type (List.mem_cons_of_mem _ member)) value member
  induction typed using ResidentTyped.rec (motive_2 := fun _ _ _ _ => True) with
  | uncertain actual permission ih => exact ih allowed
  | vacant | unit | integer | character | reference => simp [Value.children]
  | tuple head tail present headIH tailIH =>
    cases allowed with
    | tuple first rest => exact residents (.cons head tail) (by simpa using And.intro first rest)
  | array typed finite size present ih =>
    cases allowed with
    | array length resident => exact residents typed (by intro type member; have same := List.eq_of_mem_replicate member; subst type; exact resident)
    | emptyArray element => cases typed; simp [Value.children]
  | @nominal state identity tag declaration schema values declared chosen finite typed present ih =>
    have member : schema ∈ declaration.schemas := by
      cases declaration with
      | mk home visibility shape restriction =>
        cases shape <;> cases tag <;> simp_all [DataDecl.constructor, DataDecl.schemas]
        exact List.mem_of_getElem? chosen
    have fields : ∀ field ∈ schema.residents, MayDiscard program.data field.type := by
      cases allowed with
      | inferred found unrestricted fields =>
        cases Option.some.inj (found.symm.trans declared)
        exact fields schema member
      | restricted found restriction fields permitted =>
        cases Option.some.inj (found.symm.trans declared)
        exact fun field included => (fields schema member field included).weaken permitted
    exact residents typed (by simpa using fields)
  | nil => trivial
  | cons head tail headIH tailIH => trivial

theorem Value.Disposable.children {value : Value} (allowed : value.Disposable program) :
    ∀ child ∈ value.children, child.Disposable program := by
  cases allowed with
  | vacant => simp [Value.children]
  | owned typed permission => exact typed.children_disposable permission
  | tuple incomplete first rest => simpa [Value.children] using And.intro first rest
  | nominal declared structureOnly incomplete fields => exact fields

/-- Runtime permission constructs execution rather than assuming its success. -/
theorem Value.Disposable.destroys {value : Value} (allowed : value.Disposable program) :
    value.Destroys program value.destructionTrace .vacant := by
  induction value using Value.rec
    (motive_2 := fun values => (∀ child ∈ values, child.Disposable program) →
      ∀ index, DestroysFields program index values (destructionFields index values)) with
  | vacant => simpa only [Value.destructionTrace] using (Value.Destroys.vacant (program := program))
  | unit => simpa only [Value.destructionTrace, List.nil_append] using (Value.Destroys.resident (by simp) allowed (.nil 0))
  | integer type number => simpa only [Value.destructionTrace, List.nil_append] using (Value.Destroys.resident (by simp) allowed (.nil 0))
  | character number => simpa only [Value.destructionTrace, List.nil_append] using (Value.Destroys.resident (by simp) allowed (.nil 0))
  | reference node => simpa only [Value.destructionTrace, List.nil_append] using (Value.Destroys.resident (by simp) allowed (.nil 0))
  | tuple head tail headIH tailIH =>
    have permitted := allowed.children
    simp only [Value.children, List.mem_cons, forall_eq_or_imp] at permitted
    simpa only [Value.destructionTrace, destructionFields] using
      Value.Destroys.resident (by simp) allowed (.cons (tailIH permitted.2 1) (headIH permitted.1))
  | array values ih =>
    simpa only [Value.destructionTrace] using Value.Destroys.resident (by simp) allowed (ih allowed.children 0)
  | nominal identity tag values ih =>
    simpa only [Value.destructionTrace] using Value.Destroys.resident (by simp) allowed (ih allowed.children 0)
  | nil => rename_i permitted index; simpa only [destructionFields] using DestroysFields.nil (program := program) index
  | cons head tail headIH tailIH =>
    rename_i permitted index
    simpa only [destructionFields] using DestroysFields.cons
      (tailIH (fun v m => permitted v (List.mem_cons_of_mem _ m)) (index + 1))
      (headIH (permitted head (List.mem_cons_self ..)))

theorem destructionFields.lower_bound {index : Nat} {values : List Value} {path : List Nat}
    (member : path ∈ destructionFields index values) :
    ∃ field suffix, path = field :: suffix ∧ index ≤ field := by
  induction values generalizing index with
  | nil => simp [destructionFields] at member
  | cons value values ih =>
    simp only [destructionFields, List.mem_append] at member
    rcases member with tail | head
    · obtain ⟨field, suffix, rfl, bound⟩ := ih tail
      exact ⟨field, suffix, rfl, by omega⟩
    · obtain ⟨suffix, _, rfl⟩ := List.mem_map.mp head
      exact ⟨index, suffix, rfl, Nat.le_refl _⟩

/-- Relative field coordinates identify each active resident exactly once. -/
theorem Value.destructionTrace_nodup (value : Value) : value.destructionTrace.Nodup := by
  have finish : ∀ values, (destructionFields 0 values).Nodup → (destructionFields 0 values ++ [[]]).Nodup := by
    intro values unique
    refine List.nodup_append.mpr ⟨unique, by simp, ?_⟩
    intro path member other singleton same
    have empty : other = [] := by simpa using singleton
    obtain ⟨field, suffix, shape, _⟩ := destructionFields.lower_bound member
    simp [empty, same] at shape
  have prefixUnique : ∀ (index : Nat) (trace : List (List Nat)), trace.Nodup → (trace.map (index :: ·)).Nodup := by
    intro index trace unique
    simpa only [List.Nodup, List.pairwise_map, ne_eq, List.cons.injEq, true_and] using unique
  induction value using Value.rec
    (motive_2 := fun values => ∀ index, (destructionFields index values).Nodup) with
  | vacant | unit | integer | character | reference => simp [Value.destructionTrace]
  | tuple head tail headIH tailIH =>
    simp only [Value.destructionTrace]
    apply finish
    simp only [destructionFields]
    refine List.nodup_append.mpr ⟨tailIH 1, prefixUnique 0 _ headIH, ?_⟩
    intro path member other mapped same
    obtain ⟨field, suffix, shape, bound⟩ := destructionFields.lower_bound member
    obtain ⟨rest, _, rfl⟩ := List.mem_map.mp mapped
    have equal := List.cons.inj (shape.symm.trans same)
    omega
  | array values ih => simpa only [Value.destructionTrace] using finish values (ih 0)
  | nominal identity tag values ih => simpa only [Value.destructionTrace] using finish values (ih 0)
  | nil => rename_i index; simp [destructionFields]
  | cons head tail headIH tailIH =>
    rename_i index
    simp only [destructionFields]
    refine List.nodup_append.mpr ⟨tailIH (index + 1), prefixUnique index _ headIH, ?_⟩
    intro path member other mapped same
    obtain ⟨field, suffix, shape, bound⟩ := destructionFields.lower_bound member
    obtain ⟨rest, _, rfl⟩ := List.mem_map.mp mapped
    have equal := List.cons.inj (shape.symm.trans same)
    omega

theorem destructionFields.vacant_slot {values : List Value} {slot : Nat}
    (vacant : values[slot]? = some .vacant) (index : Nat) (suffix : List Nat) :
    (index + slot) :: suffix ∉ destructionFields index values := by
  induction values generalizing slot index with
  | nil => simp at vacant
  | cons value values ih =>
    cases slot with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at vacant
      subst value
      simp only [destructionFields, Value.destructionTrace, List.map_nil, List.append_nil, Nat.add_zero]
      intro member
      obtain ⟨field, rest, shape, bound⟩ := destructionFields.lower_bound member
      have same := (List.cons.inj shape).1
      omega
    | succ slot =>
      simp only [List.getElem?_cons_succ] at vacant
      simp only [destructionFields, List.mem_append, not_or]
      constructor
      · simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ih vacant (index + 1)
      · intro member
        obtain ⟨rest, _, equal⟩ := List.mem_map.mp member
        have same := (List.cons.inj equal).1
        omega

theorem Value.Destroys.exactly_once {value after : Value} {trace : List (List Nat)}
    (executed : value.Destroys program trace after) : trace.Nodup := by
  rw [executed.result_order.2]
  exact value.destructionTrace_nodup

theorem Value.Destroys.vacant_trace {trace : List (List Nat)} {after : Value}
    (executed : Value.Destroys program .vacant trace after) : trace = [] ∧ after = .vacant := by
  have result := executed.result_order
  simpa only [Value.destructionTrace] using And.intro result.2 result.1

theorem Value.Destroys.skips_vacant_field {value after : Value} {trace : List (List Nat)}
    (executed : value.Destroys program trace after) {index : Nat}
    (vacant : value.children[index]? = some .vacant) (suffix : List Nat) :
    index :: suffix ∉ trace := by
  rw [executed.result_order.2]
  have absent := destructionFields.vacant_slot vacant 0 suffix
  cases value <;> simp_all [Value.children, Value.destructionTrace]

/-- Ordered cleanup reads each resident through its stable root. Child paths
remain relative; root identities do not shift when a preceding owner retires. -/
inductive DestroysRoots (program : Program) (store : Store) : List Root → List (Root × List Nat) → Prop where
  | nil : DestroysRoots program store [] []
  | cons {root : Root} {roots : List Root} {value : Value} {first : List (List Nat)} {rest : List (Root × List Nat)}
      (found : store root = some value) (head : value.Destroys program first .vacant)
      (tail : DestroysRoots program store roots rest) :
      DestroysRoots program store (root :: roots) (first.map (root, ·) ++ rest)

def cleanupTrace (store : Store) : List Root → Option (List (Root × List Nat))
  | [] => some []
  | root :: roots => do
    let value ← store root
    let rest ← cleanupTrace store roots
    some (value.destructionTrace.map (root, ·) ++ rest)


theorem DestroysRoots.order {store : Store} {roots : List Root} {trace : List (Root × List Nat)}
    (executed : DestroysRoots program store roots trace) : cleanupTrace store roots = some trace := by
  induction executed with
  | nil => rfl
  | cons found head tail ih => simp [cleanupTrace, found, ih, head.result_order.2]

theorem DestroysRoots.scoped {store : Store} {roots : List Root} {trace : List (Root × List Nat)}
    (executed : DestroysRoots program store roots trace) : ∀ event ∈ trace, event.1 ∈ roots := by
  induction executed with
  | nil => simp
  | cons found head tail ih =>
    intro event included
    rcases List.mem_append.mp included with first | rest
    · obtain ⟨path, _, rfl⟩ := List.mem_map.mp first
      exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (ih event rest)

theorem DestroysRoots.exactly_once {store : Store} {roots : List Root} {trace : List (Root × List Nat)}
    (executed : DestroysRoots program store roots trace) (distinct : roots.Nodup) : trace.Nodup := by
  induction executed with
  | nil => exact List.Pairwise.nil
  | cons found head tail ih =>
    obtain ⟨outside, distinct⟩ := List.nodup_cons.mp distinct
    refine List.nodup_append.mpr ⟨?_, ih distinct, ?_⟩
    · simpa only [List.Nodup, List.pairwise_map, ne_eq, Prod.mk.injEq, true_and] using head.exactly_once
    · intro first included last member equal
      obtain ⟨path, _, rfl⟩ := List.mem_map.mp included
      cases equal
      exact outside (tail.scoped _ member)


theorem DestroysRoots.exists {store : Store} {bindings : List (String × Root)} {values : BindingValues}
    (stored : StoredBindings store bindings values) (allowed : ∀ entry ∈ values, entry.2.Disposable program) :
    ∃ trace, DestroysRoots program store (bindings.map Prod.snd) trace := by
  induction stored with
  | nil => exact ⟨[], .nil⟩
  | cons found rest ih =>
    obtain ⟨trace, tail⟩ := ih (fun entry member => allowed entry (List.mem_cons_of_mem _ member))
    exact ⟨_, .cons found (allowed _ (List.mem_cons_self ..)).destroys tail⟩

/-- Resolve one actual tuple/structure field; enum payloads and array indexing are not field projection. -/
def Value.fieldIndex (program : Program) (value : Value) (key : FieldKey) : Option Nat :=
  match value, key with
  | .tuple _ _, .positional index => some index
  | .nominal identity none _, key => do
      let declaration ← program.data identity
      match declaration.shape with
      | .structure schema => schema.index key
      | .enumeration _ => none
  | _, _ => none

def Value.readField (program : Program) (value : Value) (key : FieldKey) : Option Value := do
  let index ← value.fieldIndex program key
  value.children[index]?

def Value.replaceChild (value : Value) (index : Nat) (replacement : Value) : Option Value :=
  match value with
  | .tuple head tail =>
      match index with
      | 0 => some (.tuple replacement tail)
      | index + 1 => (tail[index]?).map fun _ => .tuple head (tail.set index replacement)
  | .nominal identity tag fields => (fields[index]?).map fun _ => .nominal identity tag (fields.set index replacement)
  | _ => none

/-- Resolve source keys once, checking every actual child slot. A selected
vacancy is allowed; no projection can descend through it. -/
def Value.resolvePath (program : Program) (value : Value) : List FieldKey → Option (List Nat)
  | [] => some []
  | key :: rest => do
      let index ← value.fieldIndex program key
      let child ← value.children[index]?
      let indices ← child.resolvePath program rest
      some (index :: indices)

def Value.readIndices (value : Value) : List Nat → Option Value
  | [] => some value
  | index :: rest => do
      let child ← value.children[index]?
      child.readIndices rest

def Value.writeIndices (value : Value) (indices : List Nat) (replacement : Value) : Option Value :=
  match indices with
  | [] => some replacement
  | index :: rest => do
      let child ← value.children[index]?
      let updated ← child.writeIndices rest replacement
      value.replaceChild index updated

/-- Owned temporary projection has no stored root to resolve. -/
def Value.takeField (program : Program) (value : Value) (key : FieldKey) : Option Value := do
  let index ← value.fieldIndex program key
  let _ ← value.children[index]?
  value.replaceChild index .vacant

mutual
def Pattern.matchValue (pattern : Pattern) (value : Value) : Option (List (String × Value)) :=
  match pattern with
  | .wildcard => some []
  | .binder name => some [(name, value)]
  | .literal _ expected => if value = expected then some [] else none
  | .node head fields =>
      if head = value.head then matchPatterns fields value.children else none
termination_by sizeOf pattern

def matchPatterns (patterns : List Pattern) (values : List Value) : Option (List (String × Value)) :=
  match patterns, values with
  | [], [] => some []
  | pattern :: patterns, value :: values => do
      let first ← pattern.matchValue value
      let rest ← matchPatterns patterns values
      pure (first ++ rest)
  | _, _ => none
termination_by sizeOf patterns
end

/-- Constructor signatures are shared by pattern typing and coverage specialization. -/
inductive HeadType (program : Program) : Head → Ty → List Ty → Prop where
  | unit : HeadType program .unit .unit []
  | integer {type : IntegerType} {number : Int} (fits : type.Contains program.target number) :
      HeadType program (.integer type number) (.integer type) []
  | character {number : Nat} (valid : UnicodeScalar number) :
      HeadType program (.character number) .character []
  | reference (node : Nat) (referent : Ty) {mode : BorrowMode} : HeadType program (.reference node) (.reference referent mode) []
  | tuple (first : Ty) (rest : List Ty) : HeadType program .tuple (.tuple first rest) (first :: rest)
  | array (element : Ty) (length : Nat) : HeadType program .array (.array element length) (List.replicate length element)
  | nominal {identity : Nat} {tag : Option Nat} {declaration : DataDecl} {schema : Fields}
      (declared : program.data identity = some declaration)
      (chosen : declaration.constructor tag = some schema) :
      HeadType program (.nominal identity tag) (.nominal identity) (schema.residents.map Field.type)

def Head.Accessible (program : Program) (home : Module) : Head → Prop
  | .nominal identity tag => ∃ declaration schema,
      program.data identity = some declaration ∧ declaration.constructor tag = some schema ∧
      declaration.visibility.Allows declaration.home home ∧
      ∀ field ∈ schema.residents, field.visibility.Allows declaration.home home
  | _ => True



/-- Static matrix specialization, not an assumption that an execution will match. -/
def Pattern.specialize (head : Head) (arity : Nat) : Pattern → Option (List Pattern)
  | .wildcard | .binder _ => some (List.replicate arity .wildcard)
  | .node selected fields => if selected = head ∧ fields.length = arity then some fields else none
  | .literal _ value => if value.head = head ∧ value.children.length = arity
      then some (value.children.map (Pattern.literal none)) else none

def specializeRow (head : Head) (arity : Nat) : List Pattern → Option (List Pattern)
  | [] => none
  | pattern :: tail => (pattern.specialize head arity).map (· ++ tail)

inductive Covers (program : Program) : List Ty → List (List Pattern) → Prop where
  | done {rows : List (List Pattern)} (empty : [] ∈ rows) : Covers program [] rows
  | split {type : Ty} {types : List Ty} {rows : List (List Pattern)}
      (branches : ∀ head fields, HeadType program head type fields →
        Covers program (fields ++ types) (rows.filterMap (specializeRow head fields.length))) :
      Covers program (type :: types) rows

/-- The callable's argument list is retained; only pattern interpretation unwraps
one argument. A singleton tuple argument is not two arguments (§6.1). -/
def argumentType : List Ty → Ty
  | [] => .unit
  | [type] => type
  | head :: next :: tail => .tuple head (next :: tail)

def argumentValue : List Value → Value
  | [] => .unit
  | [value] => value
  | head :: next :: tail => .tuple head (next :: tail)

def selectArm {α : Type} (value : Value) : List (Pattern × α) → Option (List (String × Value) × α)
  | [] => none
  | (pattern, body) :: rest =>
      match pattern.matchValue value with
      | some bindings => some (bindings, body)
      | none => selectArm value rest



/-- A static witness distinguishes each clause from its source-order predecessors.
It is a typed datum, not an assumed result of the subject expression. -/
def Useful (program : Program) (type : Ty) (previous : List Pattern) (pattern : Pattern) : Prop :=
  ∃ value, ValueHasType program value type ∧ pattern.matchValue value ≠ none ∧
    ∀ earlier ∈ previous, earlier.matchValue value = none


/-- Replace the nearest lexical binding; an absent destination is rejected. -/
def replaceBinding {α : Type} (name : String) (value : α) : List (String × α) → Option (List (String × α))
  | [] => none
  | (key, old) :: rest =>
      if key = name then some ((key, value) :: rest)
      else ((key, old) :: ·) <$> replaceBinding name value rest

namespace Environment

/-- Lexical selection and canonical field resolution happen once in this store. -/
def resolvePlace (program : Program) (place : Place) (environment : Environment) : Option Address := do
  let root ← lookup place.root environment.bindings
  let parent ← environment.store root
  let indices ← parent.resolvePath program place.fields
  some ⟨root, indices⟩

/-- Raw selected storage, including vacancy, for replacement disposal. -/
def «at» (address : Address) (environment : Environment) : Option Value := do
  let parent ← environment.store address.root
  parent.readIndices address.fields

/-- Owned access additionally requires the entire selected subtree initialized. -/
def readAddress (address : Address) (environment : Environment) : Option Value := do
  let resident ← environment.at address
  if resident.initialized then some resident else none

/-- Even whole-root restoration requires an allocated cell, never a missing root. -/
def writeAddress (address : Address) (replacement : Value) (environment : Environment) : Option Environment := do
  let parent ← environment.store address.root
  let updated ← parent.writeIndices address.fields replacement
  some (environment.put address.root updated)

def takeAddress (address : Address) (environment : Environment) : Option (Value × Environment) := do
  let value ← environment.readAddress address
  let after ← environment.writeAddress address .vacant
  some (value, after)

end Environment

mutual
/-- No reference bits at any aggregate depth. -/
def Value.ReferenceFree : Value → Prop
  | .reference _ => False
  | .tuple head tail => head.ReferenceFree ∧ valuesReferenceFree tail
  | .array values | .nominal _ _ values => valuesReferenceFree values
  | _ => True

def valuesReferenceFree : List Value → Prop
  | [] => True
  | value :: values => value.ReferenceFree ∧ valuesReferenceFree values
end

/-- Supported data shape plus actual resident typing rules out every reference
bit. Unknown nominal names alone do not supply this conclusion. -/
theorem ResidentTyped.referenceFree {state : Initialization} {value : Value} {type : Ty}
    (typed : ResidentTyped program state value type)
    (layout : ReferenceFreeLayout program.target program.data type) : value.ReferenceFree := by
  induction typed using ResidentTyped.rec
    (motive_2 := fun states values types _ =>
      (∀ type ∈ types, ReferenceFreeLayout program.target program.data type) →
        valuesReferenceFree values) with
  | vacant | unit | integer | character => trivial
  | uncertain actual permission ih => exact ih layout
  | reference node finite => cases layout
  | tuple head tail present headIH tailIH =>
    cases layout with
    | tuple first rest => exact ⟨headIH first, tailIH rest⟩
  | @array state values element length residents elementValid size present ih =>
    cases layout with
    | array elementLayout _ =>
      apply ih
      intro type included
      cases List.eq_of_mem_replicate included
      exact elementLayout
  | @nominal state identity tag declaration schema values declared chosen finite residents present ih =>
    apply ih
    intro type included
    obtain ⟨field, member, equal⟩ := List.mem_map.mp included
    cases equal
    have schemaMember : schema ∈ declaration.schemas := by
      cases declaration with
      | mk home visibility shape restriction =>
        cases shape <;> cases tag <;> simp_all [DataDecl.constructor, DataDecl.schemas]
        exact List.mem_of_getElem? chosen
    cases layout with
    | nominal found schemas fields =>
      cases Option.some.inj (found.symm.trans declared)
      exact fields schema schemaMember field member
  | nil => trivial
  | cons head tail headIH tailIH =>
    rename_i layouts
    exact ⟨headIH (layouts _ (by simp)),
      tailIH (fun type member => layouts type (by simp [member]))⟩


namespace Environment

/-- Resolution carries authority together with the canonical target. -/
structure ResolvedAccess where
  address : Address
  parent : Option Nat

/-- Retained parent records supply ancestry, never their retired own permission. -/
inductive Supported (loans : List Loan) : Nat → Prop where
  | root {node : Nat} {loan : Loan} (found : loans[node]? = some loan)
      (original : loan.parent = none) : Supported loans node
  | child {node parent : Nat} {loan ancestor : Loan}
      (found : loans[node]? = some loan) (derived : loan.parent = some parent)
      (older : parent < node) (parentFound : loans[parent]? = some ancestor)
      (sameRoot : loan.target.root = ancestor.target.root)
      (subaddress : ancestor.target.fields.IsPrefix loan.target.fields)
      (support : Supported loans parent) : Supported loans node

inductive Derived (environment : Environment) : Nat → Nat → Prop where
  | same (node : Nat) : Derived environment node node
  | child {node parent ancestor : Nat} {loan : Loan}
      (found : environment.loans[node]? = some loan) (derived : loan.parent = some parent)
      (rest : Derived environment parent ancestor) : Derived environment node ancestor

/-- Shared/shared overlap is permitted. Selected ancestry conveys authority;
overlapping descendants or independent unique permissions exclude the access. -/
def Permits (mode : BorrowMode) (parent : Option Nat) (address : Address) (environment : Environment) : Prop :=
  ∀ (node : Nat) (loan : Loan), environment.loans[node]? = some loan → loan.own = true →
    (mode = .shared ∧ loan.mode = .shared) ∨
    (∃ selected, parent = some selected ∧ environment.Derived selected node) ∨ address.Apart loan.target

def Usable (node : Nat) (environment : Environment) : Prop :=
  ∃ loan, environment.loans[node]? = some loan ∧ loan.own = true ∧ Supported environment.loans node

def Authorizes (mode : BorrowMode) (access : ResolvedAccess) (environment : Environment) : Prop :=
  match access.parent with
  | none => access.address.root ∈ environment.roots
  | some node => ∃ loan, environment.loans[node]? = some loan ∧ loan.own = true ∧
      Supported environment.loans node ∧ access.address.root = loan.target.root ∧
      loan.target.fields.IsPrefix access.address.fields ∧ (mode = .unique → loan.mode = .unique)

/-- Reading or borrowing through a handle requires its whole target restored.
Masked address resolution itself deliberately does not impose this condition. -/
def AccessReady (access : ResolvedAccess) (environment : Environment) : Prop :=
  ∀ node loan, access.parent = some node → environment.loans[node]? = some loan →
    ∃ value, environment.readAddress loan.target = some value

/-- Shared descendants reserve their own exact targets. Broader inactive parent
regions impose no additional reservation; their address/ancestry records remain. -/
def OwnerFree (address : Address) (environment : Environment) : Prop :=
  ∀ (node : Nat) (loan : Loan), environment.loans[node]? = some loan → loan.own = true → address.Apart loan.target

/-- Normal use and ending require the authoritative referent to be restored.
Low-level access authority stays separate so a unique handle can fill its hole. -/
def Restored (node : Nat) (environment : Environment) : Prop :=
  ∀ loan, environment.loans[node]? = some loan → loan.own = true →
    ∃ value, environment.readAddress loan.target = some value

mutual
def ResultUsable (value : Value) (environment : Environment) : Prop :=
  match value with
  | .reference node => environment.Usable node ∧ environment.Restored node
  | .tuple head tail => environment.ResultUsable head ∧ ResultsUsable tail environment
  | .array values | .nominal _ _ values => ResultsUsable values environment
  | _ => True
def ResultsUsable (values : List Value) (environment : Environment) : Prop :=
  match values with
  | [] => True
  | value :: values => environment.ResultUsable value ∧ ResultsUsable values environment
end

mutual
theorem ResultUsable.of_plain {before : Environment} {value : Value}
    (plain : value.ReferenceFree) : before.ResultUsable value := by
  cases value with
  | reference => exact False.elim plain
  | tuple head tail => exact ⟨ResultUsable.of_plain plain.1, ResultsUsable.of_plain plain.2⟩
  | array values | nominal _ _ values => exact ResultsUsable.of_plain plain
  | vacant | unit | integer | character => trivial
theorem ResultsUsable.of_plain {before : Environment} {values : List Value}
    (plain : valuesReferenceFree values) : ResultsUsable values before := by
  cases values with
  | nil => trivial
  | cons head tail => exact ⟨ResultUsable.of_plain plain.1, ResultsUsable.of_plain plain.2⟩
end

mutual
theorem ResultUsable.plain {before : Environment} {value : Value}
    (usable : before.ResultUsable value) (empty : before.loans = []) : value.ReferenceFree := by
  cases value with
  | reference node => obtain ⟨⟨loan, found, _⟩, _⟩ := usable; simp [empty] at found
  | tuple head tail => exact ⟨ResultUsable.plain usable.1 empty, ResultsUsable.plain usable.2 empty⟩
  | array values | nominal _ _ values => exact ResultsUsable.plain usable empty
  | vacant | unit | integer | character => trivial
theorem ResultsUsable.plain {before : Environment} {values : List Value}
    (usable : ResultsUsable values before) (empty : before.loans = []) : valuesReferenceFree values := by
  cases values with
  | nil => trivial
  | cons head tail => exact ⟨ResultUsable.plain usable.1 empty, ResultsUsable.plain usable.2 empty⟩
end

theorem ResultUsable.empty_plain {value : Value} (usable : empty.ResultUsable value) : value.ReferenceFree :=
  usable.plain rfl

def CarrierPermits (program : Program) (mode : BorrowMode) (place : AccessPlace) (environment : Environment) : Prop :=
  match place with
  | .owner _ => True
  | .dereference reference _ => ∃ carrier, environment.resolvePlace program reference = some carrier ∧
      environment.Permits mode none carrier


/-- Reuse the owner resolver for the handle, then the same canonical field
producer for the referent. No owned copy of the whole referent is performed. -/
def resolveAccess (program : Program) (place : AccessPlace) (environment : Environment) : Option ResolvedAccess := do
  match place with
  | .owner place =>
      let address ← environment.resolvePlace program place
      some ⟨address, none⟩
  | .dereference reference fields =>
      let carrier ← environment.resolvePlace program reference
      let .reference node ← environment.readAddress carrier | none
      let loan ← environment.loans[node]?
      if loan.own then
        let resident ← environment.at loan.target
        let indices ← resident.resolvePath program fields
        some ⟨⟨loan.target.root, loan.target.fields ++ indices⟩, some node⟩
      else none

def addLoan (access : ResolvedAccess) (mode : BorrowMode) (environment : Environment) : Environment :=
  { environment with loans := environment.loans ++ [⟨access.address, access.parent, true, mode⟩] }

/-- Low-level loan-table transition. Ordinary ending uses checked endSlot or
Disposes.reference; this operation alone does not authorize ending a handle. -/
def endOwn (node : Nat) (environment : Environment) : Option Environment := do
  let _ ← environment.loans[node]?
  some { environment with loans := environment.loans.modify node fun loan => { loan with own := false } }

/-- Ordinary slot ending checks the authoritative target before changing own.
Slot indices are checked by the source producer and survive source shadowing. -/
def endSlot (slot : Nat) (fields : List Nat := []) (environment : Environment) : Option Environment := do
  let binding ← environment.bindings[slot]?
  let resident ← environment.store binding.2
  let .reference node ← resident.readIndices fields | none
  let loan ← environment.loans[node]?
  if loan.own && !(environment.readAddress loan.target).isSome then none
  else environment.endOwn node

/-- Successful ordinary ending consumes restored-target evidence from the pre-state. -/
theorem endSlot_checked {before after : Environment} {slot : Nat} {fields : List Nat}
    (ended : before.endSlot slot fields = some after) :
    ∃ binding node, before.bindings[slot]? = some binding ∧
      before.at ⟨binding.2, fields⟩ = some (.reference node) ∧
      before.Restored node ∧ before.endOwn node = some after := by
  simp only [endSlot, Bind.bind, Option.bind_eq_some_iff] at ended
  obtain ⟨binding, selected, resident, stored, value, extracted, ended⟩ := ended
  cases value <;> try cases ended
  case reference node =>
    simp only [Option.bind_eq_some_iff] at ended
    obtain ⟨loan, found, ended⟩ := ended
    split at ended
    · cases ended
    · rename_i permitted
      refine ⟨binding, node, selected, by simp [Environment.at, stored, extracted], ?_, ended⟩
      intro actual actualFound own
      have same := Option.some.inj (found.symm.trans actualFound)
      subst actual
      cases read : before.readAddress loan.target with
      | none => simp [own, read] at permitted
      | some resident => exact ⟨resident, rfl⟩

mutual
/-- Structural copying allocates shared child loans in left-to-right leaf order.
Reference-free subtrees may instead use the identity transition. -/
inductive Copies : Environment → Value → Value → Environment → Prop where
  | data {environment : Environment} {value : Value} (plain : value.ReferenceFree) :
      Copies environment value value environment
  | reference {environment : Environment} {node : Nat} {loan : Loan}
      (found : environment.loans[node]? = some loan) (shared : loan.mode = .shared)
      (allowed : environment.Usable node) :
      Copies environment (.reference node) (.reference environment.loans.length)
        (environment.addLoan ⟨loan.target, some node⟩ .shared)
  | tuple {before middle after : Environment} {head copiedHead : Value} {tail copiedTail : List Value}
      (first : Copies before head copiedHead middle)
      (rest : CopiesFields middle tail copiedTail after) :
      Copies before (.tuple head tail) (.tuple copiedHead copiedTail) after
  | array {before after : Environment} {values copied : List Value}
      (fields : CopiesFields before values copied after) :
      Copies before (.array values) (.array copied) after
  | nominal {before after : Environment} {identity : Nat} {tag : Option Nat} {values copied : List Value}
      (fields : CopiesFields before values copied after) :
      Copies before (.nominal identity tag values) (.nominal identity tag copied) after

/-- Ordered runtime field traversal; this is not a source metadata scanner. -/
inductive CopiesFields : Environment → List Value → List Value → Environment → Prop where
  | nil {environment : Environment} : CopiesFields environment [] [] environment
  | cons {before middle after : Environment} {head copiedHead : Value} {tail copiedTail : List Value}
      (first : Copies before head copiedHead middle)
      (rest : CopiesFields middle tail copiedTail after) :
      CopiesFields before (head :: tail) (copiedHead :: copiedTail) after
end

mutual
/-- In-place structural own-ending retains canonical storage throughout. Children
finish right to left before the disposable enclosing shell finishes logically.
Pure structural destruction is used only for reference-free owned data. -/
inductive Disposes (program : Program) : Environment → Value → Environment → Prop where
  | data {environment : Environment} {value : Value} {trace : List (List Nat)}
      (plain : value.ReferenceFree) (destroyed : value.Destroys program trace .vacant) :
      Disposes program environment value environment
  | reference {environment after : Environment} {node : Nat}
      (ready : environment.Restored node)
      (ended : environment.endOwn node = some after) :
      Disposes program environment (.reference node) after
  | tuple {before after : Environment} {head : Value} {tail : List Value}
      (allowed : (Value.tuple head tail).Disposable program)
      (children : DisposesFields program before (head :: tail) after) :
      Disposes program before (.tuple head tail) after
  | array {before after : Environment} {values : List Value}
      (allowed : (Value.array values).Disposable program)
      (children : DisposesFields program before values after) :
      Disposes program before (.array values) after
  | nominal {before after : Environment} {identity : Nat} {tag : Option Nat} {values : List Value}
      (allowed : (Value.nominal identity tag values).Disposable program)
      (children : DisposesFields program before values after) :
      Disposes program before (.nominal identity tag values) after
/-- Declaration-order fields execute in reverse without detachment or clearing. -/
inductive DisposesFields (program : Program) : Environment → List Value → Environment → Prop where
  | nil {environment : Environment} : DisposesFields program environment [] environment
  | cons {before middle after : Environment} {value : Value} {values : List Value}
      (tail : DisposesFields program before values middle)
      (head : Disposes program middle value after) :
      DisposesFields program before (value :: values) after
end


end Environment

/-- Exact storage equality deliberately leaves real loan bookkeeping observable. -/
structure Environment.SameStorage (before after : Environment) : Prop where
  bindings : after.bindings = before.bindings
  store : after.store = before.store
  supply : after.nextRoot = before.nextRoot

theorem Environment.Disposes.storage {before after : Environment} {value : Value}
    (disposed : Disposes program before value after) : before.SameStorage after := by
  induction disposed using Disposes.rec
    (motive_2 := fun before _ after _ => before.SameStorage after) with
  | data => exact ⟨rfl, rfl, rfl⟩
  | reference _ ended =>
    simp only [Environment.endOwn, Bind.bind, Option.bind_eq_some_iff, Option.some.injEq] at ended
    obtain ⟨_, _, rfl⟩ := ended
    exact ⟨rfl, rfl, rfl⟩
  | tuple _ _ ih | array _ _ ih | nominal _ _ ih => exact ih
  | nil => exact ⟨rfl, rfl, rfl⟩
  | cons _ _ tailIH headIH =>
    exact ⟨headIH.bindings.trans tailIH.bindings, headIH.store.trans tailIH.store,
      headIH.supply.trans tailIH.supply⟩


mutual
inductive Pattern.Consumes (program : Program) : Environment → Pattern → Value → BindingValues → Environment → List (List Nat) → Prop where
  | wildcard {before after : Environment} {value : Value}
      (disposed : Environment.Disposes program before value after) :
      Pattern.Consumes program before .wildcard value [] after value.destructionTrace
  | binder (before : Environment) (name : String) (value : Value) :
      Pattern.Consumes program before (.binder name) value [(name, value)] before []
  | literal {before after : Environment} {type : Option Ty} {value : Value}
      (disposed : Environment.Disposes program before value after) :
      Pattern.Consumes program before (.literal type value) value [] after value.destructionTrace
  | node {before after : Environment} {head : Head} {patterns : List Pattern} {value : Value}
      {bindings : BindingValues} {trace : List (List Nat)}
      (source : head.Source) (same : head = value.head)
      (fields : ConsumesFields program before 0 patterns value.children bindings after trace) :
      Pattern.Consumes program before (.node head patterns) value bindings after trace
inductive ConsumesFields (program : Program) : Environment → Nat → List Pattern → List Value → BindingValues → Environment → List (List Nat) → Prop where
  | nil (before : Environment) (index : Nat) : ConsumesFields program before index [] [] [] before []
  | cons {before middle after : Environment} {index : Nat} {pattern : Pattern} {patterns : List Pattern}
      {value : Value} {values : List Value} {front back : BindingValues} {first rest : List (List Nat)}
      (tail : ConsumesFields program before (index + 1) patterns values back middle rest)
      (head : Pattern.Consumes program middle pattern value front after first) :
      ConsumesFields program before index (pattern :: patterns) (value :: values) (front ++ back)
        after (rest ++ first.map (index :: ·))
end

inductive ConsumesArm (program : Program) (before : Environment) (value : Value) {α : Type} :
    List (Pattern × α) → BindingValues → α → Environment → Prop where
  | hit {pattern : Pattern} {body : α} {rest : List (Pattern × α)} {bindings : BindingValues}
      {after : Environment} {trace : List (List Nat)}
      (matched : pattern.matchValue value = some bindings)
      (consumed : Pattern.Consumes program before pattern value bindings after trace) :
      ConsumesArm program before value ((pattern, body) :: rest) bindings body after
  | miss {pattern : Pattern} {body result : α} {rest : List (Pattern × α)} {bindings : BindingValues}
      {after : Environment} (missed : pattern.matchValue value = none)
      (selected : ConsumesArm program before value rest bindings result after) :
      ConsumesArm program before value ((pattern, body) :: rest) bindings result after

theorem Pattern.Consumes.matches {before after : Environment} {pattern : Pattern} {value : Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : Pattern.Consumes program before pattern value bindings after trace) :
    pattern.matchValue value = some bindings := by
  induction consumed using Pattern.Consumes.rec
    (motive_2 := fun _ _ patterns values bindings _ _ _ => matchPatterns patterns values = some bindings) with
  | wildcard | binder | literal => simp [Pattern.matchValue]
  | node _ same _ ih => simpa [Pattern.matchValue, same] using ih
  | nil => simp [matchPatterns]
  | cons _ _ tail head => simp [matchPatterns, head, tail]

theorem Pattern.Consumes.storage {before after : Environment} {pattern : Pattern} {value : Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : Pattern.Consumes program before pattern value bindings after trace) : before.SameStorage after := by
  induction consumed using Pattern.Consumes.rec
    (motive_2 := fun before _ _ _ _ after _ _ => before.SameStorage after) with
  | wildcard disposed | literal disposed => exact disposed.storage
  | binder | nil => exact ⟨rfl, rfl, rfl⟩
  | node _ _ _ ih => exact ih
  | cons _ _ tail head => exact ⟨head.bindings.trans tail.bindings, head.store.trans tail.store, head.supply.trans tail.supply⟩

theorem Pattern.Consumes.binder_result {before after : Environment} {name : String} {value : Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : Pattern.Consumes program before (.binder name) value bindings after trace) :
    bindings = [(name, value)] ∧ after = before ∧ trace = [] := by cases consumed; exact ⟨rfl, rfl, rfl⟩

theorem ConsumesArm.matches {α : Type} {before after : Environment} {value : Value}
    {arms : List (Pattern × α)} {bindings : BindingValues} {body : α}
    (consumed : ConsumesArm program before value arms bindings body after) : selectArm value arms = some (bindings, body) := by
  induction consumed with
  | hit matched _ => simp [selectArm, matched]
  | miss missed _ ih => simp [selectArm, missed, ih]

/-- This is only a logical-trace projection, never permission to discard live bits
without executing the node transition. The data constructor requires reference freedom. -/
theorem Environment.Disposes.logical {before after : Environment} {value : Value}
    (disposed : Disposes program before value after) : value.Destroys program value.destructionTrace .vacant := by
  induction disposed using Disposes.rec
    (motive_2 := fun _ values _ _ => ∀ index, DestroysFields program index values (destructionFields index values)) with
  | data plain destroyed => simpa only [destroyed.result_order.2] using destroyed
  | @reference environment after node _ ended =>
    simpa only [Value.destructionTrace, List.nil_append] using
      (Value.Destroys.resident (program := program) (by intro impossible; cases impossible)
        (.owned (.reference node (referent := .unit) .unit) (.reference .unit)) (.nil 0))
  | tuple allowed _ ih | array allowed _ ih | nominal allowed _ ih =>
    simp only [Value.destructionTrace]
    exact .resident (by intro impossible; cases impossible) allowed (ih 0)
  | nil => simp only [destructionFields]; exact .nil _
  | cons _ _ tailIH headIH =>
    rename_i index
    simp only [destructionFields]
    exact .cons (tailIH (index + 1)) headIH

inductive DisposesRoots (program : Program) : Environment → List Root → List (Root × List Nat) → Environment → Prop where
  | nil {environment : Environment} : DisposesRoots program environment [] [] environment
  | cons {before middle after : Environment} {root : Root} {roots : List Root}
      {value : Value} {trace : List (Root × List Nat)}
      (found : before.store root = some value) (free : before.OwnerFree ⟨root, []⟩)
      (head : Environment.Disposes program before value middle)
      (tail : DisposesRoots program middle roots trace after) :
      DisposesRoots program before (root :: roots)
        (value.destructionTrace.map (fun path => (root, path)) ++ trace) after

theorem DisposesRoots.storage {before after : Environment} {roots : List Root} {trace : List (Root × List Nat)}
    (disposed : DisposesRoots program before roots trace after) : before.SameStorage after := by
  induction disposed with
  | nil => exact ⟨rfl, rfl, rfl⟩
  | cons found free head tail ih =>
    exact ⟨ih.bindings.trans head.storage.bindings, ih.store.trans head.storage.store,
      ih.supply.trans head.storage.supply⟩

theorem DisposesRoots.logical {before after : Environment} {roots : List Root} {trace : List (Root × List Nat)}
    (disposed : DisposesRoots program before roots trace after) : DestroysRoots program before.store roots trace := by
  induction disposed with
  | nil => exact .nil
  | cons found free head tail ih =>
    rw [head.storage.store] at ih
    exact .cons found head.logical ih
/-- The former pure destruction is executable only for reference-free cells and
source-derived owner permission; this is a specialization of the real transition. -/
theorem DisposesRoots.of_data {environment : Environment} {roots : List Root} {trace : List (Root × List Nat)}
    (destroyed : DestroysRoots program environment.store roots trace)
    (plain : ∀ root ∈ roots, ∀ value, environment.store root = some value → value.ReferenceFree)
    (free : ∀ root ∈ roots, environment.OwnerFree ⟨root, []⟩) :
    DisposesRoots program environment roots trace environment := by
  induction destroyed with
  | nil => exact .nil
  | @cons root roots value first rest found head tail ih =>
    rw [head.result_order.2]
    exact .cons found (free root (by simp)) (.data (plain root (by simp) value found) head)
      (ih (fun other member => plain other (by simp [member])) (fun other member => free other (by simp [member])))

inductive Cleans (program : Program) (count : Nat) (before : Environment) : List (Root × List Nat) → Environment → Prop where
  | retire {disposed : Environment} {trace : List (Root × List Nat)}
      (destroyed : DisposesRoots program before ((before.bindings.take count).map Prod.snd) trace disposed) :
      Cleans program count before trace (disposed.retire count)

theorem Cleans.suffix {count : Nat} {before after : Environment} {trace : List (Root × List Nat)}
    (executed : Cleans program count before trace after) : (before.retire count).SameStorage after := by
  cases executed with
  | retire destroyed =>
    refine ⟨by simp [Environment.retire, destroyed.storage.bindings], ?_, destroyed.storage.supply⟩
    funext root
    simp only [Environment.retire, destroyed.storage.bindings, destroyed.storage.store]

theorem Cleans.order {count : Nat} {before after : Environment} {trace : List (Root × List Nat)}
    (executed : Cleans program count before trace after) :
    cleanupTrace before.store ((before.bindings.take count).map Prod.snd) = some trace := by
  cases executed with | retire destroyed => exact destroyed.logical.order

theorem Cleans.trace_scoped {count : Nat} {before after : Environment} {trace : List (Root × List Nat)}
    (executed : Cleans program count before trace after) :
    ∀ event ∈ trace, event.1 ∈ (before.bindings.take count).map Prod.snd := by
  cases executed with | retire destroyed => exact destroyed.logical.scoped

theorem Cleans.exactly_once {count : Nat} {before after : Environment} {trace : List (Root × List Nat)}
    (executed : Cleans program count before trace after) (valid : before.Valid) : trace.Nodup := by
  cases executed with
  | retire destroyed =>
    apply destroyed.logical.exactly_once
    simpa only [Environment.roots, List.map_take, List.Nodup] using (valid.distinct.take (i := count))

/-- Retirement invalidates cleaned identities; mere own ending retains the bits. -/
theorem Cleans.retired {count : Nat} {before after : Environment} {trace : List (Root × List Nat)}
    (executed : Cleans program count before trace after) :
    ∀ root ∈ (before.bindings.take count).map Prod.snd, after.store root = none := by
  rw [executed.suffix.store]
  exact fun _ member => before.retire_absent count member

/-- The caller-store frame is exact even when cleanup changes node ownership. -/
theorem Cleans.frame {count : Nat} {before after : Environment} {trace : List (Root × List Nat)}
    (executed : Cleans program count before trace after) :
    ∀ root, root ∉ (before.bindings.take count).map Prod.snd → after.store root = before.store root := by
  rw [executed.suffix.store]
  exact fun _ outside => before.retire_frame count outside


/-- Disjointness concerns canonical backing roots and field coordinates,
not argument identities. Aliased handles share the same root identity. -/
def Origin.Apart (left right : Origin) : Prop :=
  match left.base, right.base with
  | .binder first, .binder second => first ≠ second ∨ CoordinatesApart left.fields right.fields

def Origin.Within (child parent : Origin) : Prop :=
  child.base = parent.base ∧ parent.fields.IsPrefix child.fields

def Origin.extend (origin : Origin) (indices : List Nat) : Origin :=
  { origin with fields := origin.fields ++ indices }

def Origin.Bounded (origin : Origin) (context : Context) : Prop :=
  match origin.base with
  | .binder identity => identity < context.nextBinder

mutual
/-- Loan types are checked at their producer-recorded field, including the active
nominal constructor. Plain subtrees assert no resident loan metadata. -/
inductive SourcePayload.Typed (program : Program) (loans : List SourceLoan) : SourcePayload → Ty → Prop where
  | plain (type : Ty) : SourcePayload.Typed program loans .plain type
  | reference {node : Nat} {loan : SourceLoan} (found : loans[node]? = some loan) :
      SourcePayload.Typed program loans (.reference node) (.reference loan.referent loan.mode)
  | aggregate {head : Head} {payloads : List SourcePayload} {type : Ty} {fields : List Ty}
      (source : head.Source) (shape : HeadType program head type fields)
      (residents : PayloadsTyped program loans payloads fields) :
      SourcePayload.Typed program loans (.aggregate head payloads) type
inductive PayloadsTyped (program : Program) (loans : List SourceLoan) : List SourcePayload → List Ty → Prop where
  | nil : PayloadsTyped program loans [] []
  | cons {payload : SourcePayload} {payloads : List SourcePayload} {type : Ty} {types : List Ty}
      (head : SourcePayload.Typed program loans payload type)
      (tail : PayloadsTyped program loans payloads types) :
      PayloadsTyped program loans (payload :: payloads) (type :: types)
end

mutual
theorem SourcePayload.Typed.transport {before after : List SourceLoan} {payload : SourcePayload} {type : Ty}
    (typed : SourcePayload.Typed program before payload type)
    (records : ∀ (node : Nat) (loan : SourceLoan), before[node]? = some loan → ∃ retained : SourceLoan, after[node]? = some retained ∧
      retained.referent = loan.referent ∧ retained.mode = loan.mode) :
    SourcePayload.Typed program after payload type := by
  cases typed with
  | plain type => exact .plain type
  | @reference node loan found =>
    obtain ⟨retained, stored, referent, mode⟩ := records node loan found
    simpa only [referent, mode] using (SourcePayload.Typed.reference (program := program) stored)
  | aggregate source shape residents =>
    exact .aggregate source shape (PayloadsTyped.transport residents records)

theorem PayloadsTyped.transport {before after : List SourceLoan} {payloads : List SourcePayload} {types : List Ty}
    (typed : PayloadsTyped program before payloads types)
    (records : ∀ (node : Nat) (loan : SourceLoan), before[node]? = some loan → ∃ retained : SourceLoan, after[node]? = some retained ∧
      retained.referent = loan.referent ∧ retained.mode = loan.mode) :
    PayloadsTyped program after payloads types := by
  cases typed with
  | nil => exact .nil
  | cons head tail => exact .cons (SourcePayload.Typed.transport head records) (PayloadsTyped.transport tail records)
end

mutual
theorem SourcePayload.Typed.node_found {loans : List SourceLoan} {payload : SourcePayload} {type : Ty}
    (typed : SourcePayload.Typed program loans payload type) {node : Nat} (member : node ∈ payload.nodes) :
    ∃ loan, loans[node]? = some loan := by
  cases typed with
  | plain => simp [SourcePayload.nodes] at member
  | reference found =>
    simp only [SourcePayload.nodes, List.mem_singleton] at member
    subst node
    exact ⟨_, found⟩
  | aggregate _ _ residents => exact PayloadsTyped.node_found residents member

theorem PayloadsTyped.node_found {loans : List SourceLoan} {payloads : List SourcePayload} {types : List Ty}
    (typed : PayloadsTyped program loans payloads types) {node : Nat} (member : node ∈ payloadNodes payloads) :
    ∃ loan, loans[node]? = some loan := by
  cases typed with
  | nil => simp [payloadNodes] at member
  | cons head tail =>
    rcases List.mem_append.mp member with member | member
    · exact SourcePayload.Typed.node_found head member
    · exact PayloadsTyped.node_found tail member
end

theorem SourcePayload.Typed.node_bound {loans : List SourceLoan} {payload : SourcePayload} {type : Ty}
    (typed : SourcePayload.Typed program loans payload type) {node : Nat} (member : node ∈ payload.nodes) :
    node < loans.length := by
  obtain ⟨_, found⟩ := typed.node_found member
  exact (List.getElem?_eq_some_iff.mp found).1

theorem SourcePayload.Typed.reference_inv {loans : List SourceLoan} {node : Nat} {type : Ty}
    (typed : SourcePayload.Typed program loans (.reference node) type) :
    ∃ loan, loans[node]? = some loan ∧ type = .reference loan.referent loan.mode := by
  cases typed with
  | reference found => exact ⟨_, found, rfl⟩

theorem PayloadsTyped.length {loans : List SourceLoan} {payloads : List SourcePayload} {types : List Ty}
    (typed : PayloadsTyped program loans payloads types) : payloads.length = types.length := by
  cases typed with
  | nil => rfl
  | cons _ tail => simp only [List.length_cons, PayloadsTyped.length tail]

theorem PayloadsTyped.append {loans : List SourceLoan} {left right : List SourcePayload} {leftTypes rightTypes : List Ty}
    (first : PayloadsTyped program loans left leftTypes) (second : PayloadsTyped program loans right rightTypes) :
    PayloadsTyped program loans (left ++ right) (leftTypes ++ rightTypes) := by
  cases first with
  | nil => exact second
  | cons head tail => exact .cons head (PayloadsTyped.append tail second)

theorem PayloadsTyped.getElem {loans : List SourceLoan} {payloads : List SourcePayload} {types : List Ty}
    (typed : PayloadsTyped program loans payloads types) {index : Nat} {payload : SourcePayload}
    (selected : payloads[index]? = some payload) :
    ∃ type, types[index]? = some type ∧ SourcePayload.Typed program loans payload type := by
  cases typed with
  | nil => simp at selected
  | cons head tail =>
    cases index with
    | zero => cases selected; exact ⟨_, rfl, head⟩
    | succ index => exact PayloadsTyped.getElem tail selected

theorem PayloadsTyped.set {loans : List SourceLoan} {payloads : List SourcePayload} {types : List Ty}
    (typed : PayloadsTyped program loans payloads types) {index : Nat} {type : Ty} {replacement : SourcePayload}
    (selected : types[index]? = some type) (resident : SourcePayload.Typed program loans replacement type) :
    PayloadsTyped program loans (payloads.set index replacement) types := by
  cases typed with
  | nil => simp at selected
  | cons head tail =>
    cases index with
    | zero => cases selected; exact .cons resident tail
    | succ index => exact .cons head (PayloadsTyped.set tail selected resident)

theorem PayloadsTyped.plain (program : Program) (loans : List SourceLoan) (types : List Ty) :
    PayloadsTyped program loans (List.replicate types.length .plain) types := by
  induction types with
  | nil => exact .nil
  | cons type types ih => exact .cons (.plain type) ih

inductive SourcePayload.Write (program : Program) : Ty → List Nat → SourcePayload → SourcePayload → SourcePayload → Prop where
  | here {type : Ty} {before replacement : SourcePayload} : Write program type [] before replacement replacement
  | aggregate {type middle : Ty} {home : Module} {key : FieldKey} {index : Nat} {path : List Nat}
      {head : Head} {fields : List SourcePayload} {child replacement updated : SourcePayload}
      (projection : ProjectionType program home type key index middle)
      (selected : fields[index]? = some child)
      (nested : Write program middle path child replacement updated) :
      Write program type (index :: path) (.aggregate head fields) replacement (.aggregate head (fields.set index updated))
  | plainExpand {type middle : Ty} {home : Module} {key : FieldKey} {index : Nat} {path : List Nat}
      {head : Head} {types : List Ty} {replacement updated : SourcePayload}
      (projection : ProjectionType program home type key index middle)
      (shape : HeadType program head type types)
      (selected : types[index]? = some middle)
      (nested : Write program middle path .plain replacement updated) :
      Write program type (index :: path) .plain replacement
        (.aggregate head ((List.replicate types.length .plain).set index updated))

namespace Context

def empty : Context := ⟨[], fun _ => none, [], 0⟩
def erase (context : Context) : List (String × BindingType) :=
  context.bindings.map fun binding => (binding.1, binding.2.toBindingType)


/-- Update the canonical mask and the producer-computed whole-root payload.
Type, mutability and binder identity remain declaration metadata. -/
def writeTarget (context : Context) (origin : Origin) (next : Initialization) (payload : SourcePayload) : Context :=
  { context with storage := fun base => if base = origin.base then
      (context.storage base).map (fun slot => { slot with initialization := slot.initialization.write origin.fields next, payload := payload })
    else context.storage base }

theorem writeTarget_metadata (context : Context) (origin : Origin) (next : Initialization) (payload : SourcePayload)
    {slot : Slot} (stored : context.storage origin.base = some slot) :
    ∃ updated, (context.writeTarget origin next payload).storage origin.base = some updated ∧ updated.metadata = slot.metadata :=
  ⟨{ slot with initialization := slot.initialization.write origin.fields next, payload := payload }, by simp [writeTarget, stored], rfl⟩


/-- Commit an owner operation back to stable storage identities. The lexical
view is consumed once; hidden storage is retained. -/
def withSlots (context : Context) (slots : List (String × Slot)) : Context :=
  { context with
    names := slots.map (fun binding => (binding.1, binding.2.binder))
    storage := fun origin =>
      match origin with
      | .binder binder =>
          match slots.find? (fun binding => binding.2.binder == binder) with
          | some binding => some binding.2
          | none => context.storage origin
      }

/-- Finite semantic support of the proof interpretation. Gaps below nextBinder
need no runtime root, so source supply joins never fabricate allocations. -/
def MentionsBinder (context : Context) (binder : Nat) : Prop :=
  (∃ slot, context.storage (.binder binder) = some slot) ∨
    ∃ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan ∧ loan.target.base = .binder binder


/-- Ancestry comes from actual retained source loan records, not type equality. -/
inductive Derived (context : Context) : Nat → Nat → Prop where
  | same (node : Nat) : context.Derived node node
  | child {node parent origin : Nat} {loan : SourceLoan}
      (found : context.loans[node]? = some loan) (derived : loan.parent = some parent)
      (ancestor : context.Derived parent origin) : context.Derived node origin

def Permits (context : Context) (mode : BorrowMode) (parent : Option Nat) (origin : Origin) : Prop :=
  ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan → loan.own = true →
    (mode = .shared ∧ loan.mode = .shared) ∨
    (∃ selected, parent = some selected ∧ context.Derived selected node) ∨ origin.Apart loan.target
/-- Every target, including an external argument referent, is typed from its
canonical backing root. The selected mask is queried, never retained in a loan. -/
def Target (program : Program) (context : Context) (origin : Origin) (referent : Ty) : Prop :=
  match origin.base with
  | .binder binder => ∃ slot, context.storage (.binder binder) = some slot ∧
      CanonicalPath program slot.type origin.fields referent ∧
      ∃ state, slot.initialization.Access origin.fields state

/-- Readiness queries authoritative root storage, including external backing cells. -/
def Ready (context : Context) (origin : Origin) : Prop :=
  match origin.base with
  | .binder binder => ∃ slot state, context.storage (.binder binder) = some slot ∧
      slot.initialization.Access origin.fields state ∧ state.Complete

def SourceTarget (program : Program) (context : Context) (loan : SourceLoan) : Prop :=
  context.Target program loan.target loan.referent ∧
  (loan.mode = .shared → context.Ready loan.target)

/-- Reads and borrows require the entire parent target, not merely a complete child.
Restoration uses masked access without this operation-specific prerequisite. -/
def AccessReady (context : Context) (target : Origin) (parent : Option Nat) : Prop :=
  context.Ready target ∧ ∀ node loan, parent = some node → context.loans[node]? = some loan →
    context.Ready loan.target

theorem SourceTarget.storage_congr {before after : Context} {loan : SourceLoan}
    (target : before.SourceTarget program loan)
    (same : after.storage loan.target.base = before.storage loan.target.base) : after.SourceTarget program loan := by
  rcases loan with ⟨⟨base, fields⟩, referent, parent, own, mode⟩
  cases base <;> simpa only [Context.SourceTarget, Context.Target, Context.Ready, same] using target

def Free (context : Context) (origin : Origin) : Prop :=
  ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan → loan.own = true → origin.Apart loan.target

def Own (context : Context) (node : Nat) : Prop :=
  ∃ loan, context.loans[node]? = some loan ∧ loan.own = true


def Restored (context : Context) (node : Nat) : Prop :=
  ∀ loan, context.loans[node]? = some loan → loan.own = true → context.Ready loan.target

/-- Every target payload is selected from authoritative root storage. -/
inductive TargetPayload (program : Program) (context : Context) : Origin → Ty → SourcePayload → Prop where
  | cell {origin : Origin} {slot : Slot} {referent : Ty} {payload : SourcePayload}
      (stored : context.storage origin.base = some slot)
      (path : CanonicalPath program slot.type origin.fields referent)
      (selected : slot.payload.select origin.fields = some payload) :
      TargetPayload program context origin referent payload

def PayloadAvailable (context : Context) (payload : SourcePayload) : Prop :=
  ∀ node ∈ payload.nodes, context.Own node ∧ context.Restored node

/-- A live outer observation retains the own permission of every inner handle
in its current target, not a saved snapshot of a formerly resident payload. -/
def ObservedOwn (program : Program) (context : Context) : Prop :=
  ∀ (outer : Nat) (loan : SourceLoan), context.loans[outer]? = some loan → loan.own = true →
    ∀ payload, context.TargetPayload program loan.target loan.referent payload →
      ∀ inner ∈ payload.nodes, context.Own inner

def Unobserved (program : Program) (context : Context) (node : Nat) : Prop :=
  ∀ (outer : Nat) (loan : SourceLoan), context.loans[outer]? = some loan → loan.own = true → outer ≠ node →
    ∀ payload, context.TargetPayload program loan.target loan.referent payload → node ∉ payload.nodes

def endOwn (context : Context) (node : Nat) : Context :=
  { context with loans := context.loans.modify node fun loan => { loan with own := false } }

/-- Only surviving observers constrain an own-ending. Each next guard is checked
in the deterministic source state after the preceding ending. -/
def NodesDisposable (program : Program) (held : List SourcePayload) : Context → List Nat → Prop
  | _, [] => True
  | context, node :: nodes =>
      node ∉ payloadNodes held ∧ context.Restored node ∧ context.Unobserved program node ∧
        NodesDisposable program held (context.endOwn node) nodes

def PayloadDisposable (program : Program) (context : Context)
    (held : List SourcePayload) (payload : SourcePayload) : Prop :=
  NodesDisposable program held context payload.nodes.reverse



/-- Own endings follow reverse declaration order projected from the one payload. -/
def dispose (context : Context) (payload : SourcePayload) : Context :=
  payload.nodes.reverse.foldl (fun current node => current.endOwn node) context

theorem dispose_induction {P : Context → Prop} {context : Context} (initial : P context)
    (step : ∀ current node, P current → P (current.endOwn node)) (payload : SourcePayload) :
    P (context.dispose payload) := by
  unfold Context.dispose
  generalize payload.nodes.reverse = nodes
  induction nodes generalizing context with
  | nil => exact initial
  | cons node nodes ih => exact ih (step context node initial)

@[simp] theorem dispose_names (context : Context) (payload : SourcePayload) :
    (context.dispose payload).names = context.names :=
  dispose_induction (P := fun current => current.names = context.names) rfl (fun _ _ same => same) payload

@[simp] theorem dispose_storage (context : Context) (payload : SourcePayload) :
    (context.dispose payload).storage = context.storage :=
  dispose_induction (P := fun current => current.storage = context.storage) rfl (fun _ _ same => same) payload

@[simp] theorem dispose_bindings (context : Context) (payload : SourcePayload) :
    (context.dispose payload).bindings = context.bindings := by
  simp only [Context.bindings, dispose_names, dispose_storage]

@[simp] theorem dispose_supply (context : Context) (payload : SourcePayload) :
    (context.dispose payload).nextBinder = context.nextBinder :=
  dispose_induction (P := fun current => current.nextBinder = context.nextBinder) rfl (fun _ _ same => same) payload


def borrow (context : Context) (target : Origin) (referent : Ty) (parent : Option Nat) (mode : BorrowMode) : Context :=
  { context with loans := context.loans ++ [⟨target, referent, parent, true, mode⟩] }

mutual
/-- The same producer recursively assigns fresh children to shared occurrences.
There is deliberately no constructor for copying a unique handle. -/
inductive CopyPayload : Context → SourcePayload → SourcePayload → Context → Prop where
  | plain (context : Context) : CopyPayload context .plain .plain context
  | reference {context : Context} {node : Nat} {loan : SourceLoan}
      (found : context.loans[node]? = some loan) (shared : loan.mode = .shared)
      (own : context.Own node) (ready : context.Restored node)
      (permitted : context.Permits .shared (some node) loan.target) :
      CopyPayload context (.reference node) (.reference context.loans.length)
        (context.borrow loan.target loan.referent (some node) .shared)
  | aggregate {before after : Context} {head : Head} {fields copied : List SourcePayload}
      (children : CopyPayloads before fields copied after) :
      CopyPayload before (.aggregate head fields) (.aggregate head copied) after
inductive CopyPayloads : Context → List SourcePayload → List SourcePayload → Context → Prop where
  | nil (context : Context) : CopyPayloads context [] [] context
  | cons {before middle after : Context} {head copied : SourcePayload} {tail copiedTail : List SourcePayload}
      (first : CopyPayload before head copied middle)
      (rest : CopyPayloads middle tail copiedTail after) :
      CopyPayloads before (head :: tail) (copied :: copiedTail) after
end


def bind (context : Context) (name : String) (mutable : Bool) (result : ResultType) : Context :=
  { context with
    names := (name, context.nextBinder) :: context.names
    storage := fun origin => if origin = .binder context.nextBinder then
      some ⟨⟨result.type, mutable, .full⟩, context.nextBinder, result.payload⟩
      else context.storage origin
    nextBinder := context.nextBinder + 1 }

def hide (context : Context) : Context := { context with names := [] }

def retire (context : Context) (count : Nat) : Context :=
  { context with
    names := context.names.drop count
    storage := fun origin => match origin with
      | .binder binder => if binder ∈ (context.names.take count).map Prod.snd then none else context.storage origin
      }

/-- Node history and binder supplies are never rewound at scope exit. -/
def disposeSlots (context : Context) (slots : List (String × Slot)) : Context :=
  slots.foldl (fun current slot => current.dispose slot.2.payload) context

def cleanup (context : Context) (count : Nat) : Context :=
  (context.disposeSlots (context.bindings.take count)).retire count

structure WellFormed (program : Program) (context : Context) : Prop where
  distinct : (context.bindings.map (fun binding => binding.2.binder)).Nodup
  supported : ∀ binding ∈ context.bindings, StorageType program.target program.data binding.2.type
  slots : ∀ binding ∈ context.bindings, binding.2.binder < context.nextBinder ∧
    SourcePayload.Typed program context.loans binding.2.payload binding.2.type
  targets : ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan →
    loan.target.Bounded context ∧ FiniteLayout program.target program.data loan.referent
  parents : ∀ (node : Nat) (loan : SourceLoan) (parent : Nat), context.loans[node]? = some loan →
    loan.parent = some parent → parent < node ∧ ∃ ancestor, context.loans[parent]? = some ancestor ∧
      loan.target.Within ancestor.target
  named : ∀ entry ∈ context.names, ∃ slot, context.storage (.binder entry.2) = some slot
  allocated : ∀ binder slot, context.storage (.binder binder) = some slot →
    slot.binder = binder ∧ binder < context.nextBinder ∧
    StorageType program.target program.data slot.type ∧
    SourcePayload.Typed program context.loans slot.payload slot.type
  parentModes : ∀ (node : Nat) (loan : SourceLoan) (parent : Nat) (ancestor : SourceLoan),
    context.loans[node]? = some loan → loan.parent = some parent → context.loans[parent]? = some ancestor →
    loan.mode = .unique → ancestor.mode = .unique

theorem WellFormed.member_stored {context : Context} (valid : context.WellFormed program)
    (binding : String × Slot) (member : binding ∈ context.bindings) :
    context.storage (.binder binding.2.binder) = some binding.2 := by
  obtain ⟨entry, _, found⟩ := List.mem_filterMap.mp member
  obtain ⟨slot, stored, same⟩ := Option.map_eq_some_iff.mp found
  cases same
  rw [(valid.allocated entry.2 slot stored).1]
  exact stored

theorem WellFormed.member_known {context : Context} (valid : context.WellFormed program)
    (binding : String × Slot) (member : binding ∈ context.bindings) :
    context.MentionsBinder binding.2.binder :=
  .inl ⟨binding.2, valid.member_stored binding member⟩

theorem filterMap_congr_mem {α β : Type} (entries : List α) (left right : α → Option β)
    (same : ∀ entry ∈ entries, left entry = right entry) :
    entries.filterMap left = entries.filterMap right := by
  induction entries with
  | nil => rfl
  | cons entry entries ih =>
      simp only [List.filterMap_cons, same entry (by simp), ih (fun other member => same other (by simp [member]))]

theorem WellFormed.bindings_binders {context : Context} (valid : context.WellFormed program) :
    context.bindings.map (fun binding => binding.2.binder) = context.names.map Prod.snd := by
  unfold Context.bindings
  rw [List.map_filterMap]
  rw [← List.filterMap_eq_map]
  apply filterMap_congr_mem
  intro entry member
  obtain ⟨slot, found⟩ := valid.named entry member
  simp [found, (valid.allocated entry.2 slot found).1]

theorem WellFormed.bindings_bind {context : Context} (valid : context.WellFormed program)
    (name : String) (mutable : Bool) (result : ResultType) :
    (context.bind name mutable result).bindings =
      (name, ⟨⟨result.type, mutable, .full⟩, context.nextBinder, result.payload⟩) :: context.bindings := by
  simp only [Context.bindings, Context.bind, List.filterMap_cons, ↓reduceIte, Option.map_some]
  congr 1
  apply filterMap_congr_mem
  intro entry member
  obtain ⟨slot, found⟩ := valid.named entry member
  have different : OriginBase.binder entry.2 ≠ .binder context.nextBinder := by
    intro equal
    have same := OriginBase.binder.inj equal
    exact Nat.ne_of_lt (valid.allocated entry.2 slot found).2.1 same
  simp [different]

theorem Derived.unique {context : Context} {node ancestor : Nat} {loan parentLoan : SourceLoan}
    (derived : context.Derived node ancestor) (valid : context.WellFormed program)
    (found : context.loans[node]? = some loan) (ancestorFound : context.loans[ancestor]? = some parentLoan)
    (unique : loan.mode = .unique) : parentLoan.mode = .unique := by
  induction derived generalizing loan with
  | same => cases Option.some.inj (found.symm.trans ancestorFound); exact unique
  | @child node parent ancestor current currentFound parentEq rest ih =>
    cases Option.some.inj (currentFound.symm.trans found)
    obtain ⟨_, parentRecord, parentFound, _⟩ := valid.parents node current parent currentFound parentEq
    exact ih parentFound ancestorFound (valid.parentModes node current parent parentRecord currentFound parentEq parentFound unique)

end Context

def Origin.Known (origin : Origin) (context : Context) : Prop :=
  match origin.base with
  | .binder identity => context.MentionsBinder identity

theorem Context.WellFormed.loanKnown {context : Context} (_valid : context.WellFormed program)
    {node : Nat} {loan : SourceLoan} (found : context.loans[node]? = some loan) : loan.target.Known context := by
  cases base : loan.target.base with
  | binder identity =>
    change (match loan.target.base with | .binder identity => context.MentionsBinder identity)
    rw [base]
    exact .inr ⟨node, loan, found, base⟩

namespace Context

theorem endOwn_found (context : Context) (ended : Nat) {node : Nat} {loan : SourceLoan}
    (found : context.loans[node]? = some loan) :
    (context.endOwn ended).loans[node]? = some { loan with own := if ended = node then false else loan.own } := by
  simp only [endOwn, List.getElem?_modify, found]
  split <;> rfl

theorem endOwn_original {context : Context} {ended node : Nat} {loan : SourceLoan}
    (found : (context.endOwn ended).loans[node]? = some loan) :
    ∃ original, context.loans[node]? = some original ∧
      loan = { original with own := if ended = node then false else original.own } := by
  change (context.loans.modify ended fun loan => { loan with own := false })[node]? = some loan at found
  rw [List.getElem?_modify] at found
  obtain ⟨original, found, equal⟩ := Option.map_eq_some_iff.mp found
  refine ⟨original, found, ?_⟩
  cases equal
  split <;> rfl

theorem endOwn_mentions (context : Context) (ended binder : Nat) :
    (context.endOwn ended).MentionsBinder binder ↔ context.MentionsBinder binder := by
  constructor
  · rintro (slot | ⟨node, loan, found, base⟩)
    · exact .inl slot
    · obtain ⟨original, originalFound, rfl⟩ := endOwn_original found
      exact .inr ⟨node, original, originalFound, base⟩
  · rintro (slot | ⟨node, loan, found, base⟩)
    · exact .inl slot
    · exact .inr ⟨node, _, context.endOwn_found ended found, base⟩

theorem WellFormed.endOwn {context : Context} (valid : context.WellFormed program) (ended : Nat) :
    (context.endOwn ended).WellFormed program := by
  refine { valid with slots := ?_, targets := ?_, parents := ?_, allocated := ?_, parentModes := ?_ }
  · intro binding member
    obtain ⟨bound, reference⟩ := valid.slots binding member
    refine ⟨bound, ?_⟩
    exact reference.transport (fun _ _ found => ⟨_, context.endOwn_found ended found, rfl, rfl⟩)
  · intro node loan found
    obtain ⟨original, originalFound, rfl⟩ := endOwn_original found
    exact valid.targets node original originalFound
  · intro node loan parent found derived
    obtain ⟨original, originalFound, rfl⟩ := endOwn_original found
    obtain ⟨older, ancestor, parentFound, within⟩ := valid.parents _ _ _ originalFound derived
    exact ⟨older, _, context.endOwn_found ended parentFound, within⟩
  · intro binder slot stored
    obtain ⟨identity, bound, supported, reference⟩ := valid.allocated binder slot stored
    refine ⟨identity, bound, supported, ?_⟩
    exact reference.transport (fun _ _ found => ⟨_, context.endOwn_found ended found, rfl, rfl⟩)
  · intro node loan parent ancestor found derived parentFound unique
    obtain ⟨old, oldFound, rfl⟩ := endOwn_original found
    obtain ⟨oldParent, oldParentFound, rfl⟩ := endOwn_original parentFound
    exact valid.parentModes node old parent oldParent oldFound derived oldParentFound unique

end Context




inductive PatternOutcome where
  | impossible
  | produced (bindings : List (String × ResultType)) (after : Context)

def bindingPayloads (bindings : List (String × ResultType)) : List SourcePayload := bindings.map (·.2.payload)
def plainResults (types : List Ty) : List ResultType := types.map (fun type => ⟨type, .plain⟩)
def fieldResults (types : List Ty) (payloads : List SourcePayload) : List ResultType :=
  List.zipWith (fun type payload => ⟨type, payload⟩) types payloads

mutual
inductive PatternType (program : Program) (home : Module) :
    List SourcePayload → Context → Pattern → ResultType → PatternOutcome → Prop where
  | wildcard {held : List SourcePayload} {before : Context} {result : ResultType}
      (discard : MayDiscard program.data result.type) (legal : before.PayloadDisposable program held result.payload) :
      PatternType program home held before .wildcard result (.produced [] (before.dispose result.payload))
  | binder {held : List SourcePayload} (before : Context) (name : String) (result : ResultType) :
      PatternType program home held before (.binder name) result (.produced [(name, result)] before)
  | literal {held : List SourcePayload} {before : Context} {result : ResultType} {value : Value}
      (typed : ValueHasType program value result.type) (discard : MayDiscard program.data result.type)
      (legal : before.PayloadDisposable program held result.payload) :
      PatternType program home held before (.literal (some result.type) value) result (.produced [] (before.dispose result.payload))
  | plain {held : List SourcePayload} {before : Context} {head : Head} {patterns : List Pattern} {type : Ty} {fields : List Ty}
      {outcome : PatternOutcome} (shape : HeadType program head type fields) (access : head.Accessible program home)
      (children : PatternsType program home held before patterns (plainResults fields) outcome) :
      PatternType program home held before (.node head patterns) ⟨type, .plain⟩ outcome
  | aggregate {held : List SourcePayload} {before : Context} {head : Head} {patterns : List Pattern} {type : Ty} {fields : List Ty}
      {payloads : List SourcePayload} {outcome : PatternOutcome}
      (shape : HeadType program head type fields) (access : head.Accessible program home)
      (children : PatternsType program home held before patterns (fieldResults fields payloads) outcome) :
      PatternType program home held before (.node head patterns) ⟨type, .aggregate head payloads⟩ outcome
  /-- A fully owned reference cannot have plain correspondence. Vacant slots are not subjects. -/
  | plainReference {held : List SourcePayload} {before : Context} {pattern : Pattern}
      {referent : Ty} {mode : BorrowMode} :
      PatternType program home held before pattern ⟨.reference referent mode, .plain⟩ .impossible
  | impossible {held : List SourcePayload} {before : Context} {head active : Head} {patterns : List Pattern} {type : Ty} {fields : List Ty}
      {payloads : List SourcePayload} {checked : PatternOutcome}
      (different : head ≠ active) (shape : HeadType program head type fields) (access : head.Accessible program home)
      (children : PatternsType program home held before patterns (plainResults fields) checked) :
      PatternType program home held before (.node head patterns) ⟨type, .aggregate active payloads⟩ .impossible
inductive PatternsType (program : Program) (home : Module) :
    List SourcePayload → Context → List Pattern → List ResultType → PatternOutcome → Prop where
  | nil {held : List SourcePayload} (before : Context) : PatternsType program home held before [] [] (.produced [] before)
  | cons {held : List SourcePayload} {before middle after : Context} {pattern : Pattern} {patterns : List Pattern}
      {result : ResultType} {results : List ResultType} {front back : List (String × ResultType)}
      (tail : PatternsType program home (result.payload :: held) before patterns results (.produced back middle))
      (head : PatternType program home (bindingPayloads back ++ held) middle pattern result (.produced front after)) :
      PatternsType program home held before (pattern :: patterns) (result :: results) (.produced (front ++ back) after)
  | impossibleHead {held : List SourcePayload} {before middle : Context} {pattern : Pattern} {patterns : List Pattern}
      {result : ResultType} {results : List ResultType} {back : List (String × ResultType)}
      (tail : PatternsType program home (result.payload :: held) before patterns results (.produced back middle))
      (head : PatternType program home (bindingPayloads back ++ held) middle pattern result .impossible) :
      PatternsType program home held before (pattern :: patterns) (result :: results) .impossible
  | impossibleTail {held : List SourcePayload} {before : Context} {pattern : Pattern} {patterns : List Pattern}
      {result : ResultType} {results : List ResultType} {checked : PatternOutcome}
      (tail : PatternsType program home (result.payload :: held) before patterns results .impossible)
      (head : PatternType program home held before pattern result checked) :
      PatternsType program home held before (pattern :: patterns) (result :: results) .impossible
end


def patternBindings (bindings : List (String × ResultType)) : List (String × BindingType) :=
  bindings.map (fun binding => (binding.1, ⟨binding.2.type, false, .full⟩))

namespace Context

theorem borrow_found {context : Context} {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    {node : Nat} {loan : SourceLoan} (found : context.loans[node]? = some loan) :
    (context.borrow target referent parent mode).loans[node]? = some loan := by
  exact List.getElem?_append_left ((List.getElem?_eq_some_iff.mp found).1) |>.trans found

theorem borrow_last (context : Context) (target : Origin) (referent : Ty) (parent : Option Nat) (mode : BorrowMode) :
    (context.borrow target referent parent mode).loans[context.loans.length]? = some ⟨target, referent, parent, true, mode⟩ := by
  simp [borrow]

theorem borrow_cases {context : Context} {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    {node : Nat} {loan : SourceLoan} (found : (context.borrow target referent parent mode).loans[node]? = some loan) :
    context.loans[node]? = some loan ∨ (node = context.loans.length ∧ loan = ⟨target, referent, parent, true, mode⟩) := by
  by_cases bound : node < context.loans.length
  · exact .inl (by simpa only [borrow, List.getElem?_append_left bound] using found)
  · simp only [borrow, List.getElem?_append_right (Nat.le_of_not_lt bound)] at found
    cases difference : node - context.loans.length with
    | zero =>
      exact .inr ⟨Nat.le_antisymm (Nat.sub_eq_zero_iff_le.mp difference) (Nat.le_of_not_lt bound),
        by simpa only [difference, List.getElem?_cons_zero, Option.some.injEq] using found.symm⟩
    | succ rest => simp [difference] at found

theorem borrow_mentions {context : Context} {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (known : target.Known context) (binder : Nat) :
    (context.borrow target referent parent mode).MentionsBinder binder ↔ context.MentionsBinder binder := by
  constructor
  · intro mentioned
    rcases mentioned with slot | ⟨node, loan, found, base⟩
    · exact .inl slot
    · rcases borrow_cases found with old | ⟨_, rfl⟩
      · exact .inr ⟨node, loan, old, base⟩
      · change target.base = .binder binder at base
        simpa [Origin.Known, base] using known
  · intro mentioned
    rcases mentioned with slot | ⟨node, loan, found, base⟩
    · exact .inl slot
    · exact .inr ⟨node, loan, borrow_found found, base⟩

theorem WellFormed.borrow {context : Context} (valid : context.WellFormed program)
    {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (bounded : target.Bounded context) (finite : FiniteLayout program.target program.data referent)
    (ancestor : ∀ node, parent = some node → ∃ loan, context.loans[node]? = some loan ∧ target.Within loan.target)
    (parentMode : ∀ node loan, parent = some node → context.loans[node]? = some loan → mode = .unique → loan.mode = .unique) :
    (context.borrow target referent parent mode).WellFormed program := by
  refine ⟨valid.distinct, valid.supported, ?_, ?_, ?_, valid.named, ?_, ?_⟩
  · intro binding member
    obtain ⟨bound, reference⟩ := valid.slots binding member
    refine ⟨bound, ?_⟩
    exact reference.transport (fun _ loan found => ⟨loan, borrow_found found, rfl, rfl⟩)
  · intro node loan found
    rcases borrow_cases found with old | ⟨_, rfl⟩
    · exact valid.targets node loan old
    · exact ⟨bounded, finite⟩
  · intro node loan parentNode found derived
    rcases borrow_cases found with old | ⟨rfl, rfl⟩
    · obtain ⟨older, ancestor, ancestorFound, within⟩ := valid.parents node loan parentNode old derived
      exact ⟨older, ancestor, borrow_found ancestorFound, within⟩
    · obtain ⟨ancestor, ancestorFound, within⟩ := ancestor parentNode derived
      exact ⟨(List.getElem?_eq_some_iff.mp ancestorFound).1, ancestor, borrow_found ancestorFound, within⟩
  · intro binder slot stored
    obtain ⟨identity, bound, supported, reference⟩ := valid.allocated binder slot stored
    refine ⟨identity, bound, supported, ?_⟩
    exact reference.transport (fun _ loan found => ⟨loan, borrow_found found, rfl, rfl⟩)
  · intro node loan parentNode parentLoan found derived parentFound unique
    rcases borrow_cases found with old | ⟨rfl, rfl⟩
    · obtain ⟨_, original, originalFound, _⟩ := valid.parents node loan parentNode old derived
      have same := Option.some.inj ((borrow_found originalFound).symm.trans parentFound)
      subst parentLoan
      exact valid.parentModes node loan parentNode original old derived originalFound unique
    · obtain ⟨original, originalFound, _⟩ := ancestor parentNode derived
      have same := Option.some.inj ((borrow_found originalFound).symm.trans parentFound)
      subst parentLoan
      exact parentMode parentNode original derived originalFound unique

end Context


/-- Proof interpretation only. Runtime end actions use actual carrier values;
no source-identity map is installed in the executable environment. -/
structure Interpretation where
  binder : Nat → Root
  node : Nat → Nat

def Interpretation.origin (interpretation : Interpretation) (origin : Origin) : Address :=
  match origin.base with
  | .binder identity => ⟨interpretation.binder identity, origin.fields⟩

mutual
/-- This realizes the producer payload against actual resident values; it does
not rediscover source provenance or identify occurrences by value equality. -/
inductive SourcePayload.Corresponds (node : Nat → Nat) : SourcePayload → Value → Prop where
  | plain {value : Value} (free : value.ReferenceFree) : SourcePayload.Corresponds node .plain value
  | reference (identity : Nat) : SourcePayload.Corresponds node (.reference identity) (.reference (node identity))
  | aggregate {head : Head} {fields : List SourcePayload} {value : Value}
      (source : head.Source) (constructor : value.head = head)
      (children : PayloadsCorrespond node fields value.children) :
      SourcePayload.Corresponds node (.aggregate head fields) value
inductive PayloadsCorrespond (node : Nat → Nat) : List SourcePayload → List Value → Prop where
  | nil : PayloadsCorrespond node [] []
  | cons {payload : SourcePayload} {payloads : List SourcePayload} {value : Value} {values : List Value}
      (head : SourcePayload.Corresponds node payload value)
      (tail : PayloadsCorrespond node payloads values) :
      PayloadsCorrespond node (payload :: payloads) (value :: values)
end

theorem SourcePayload.occurs_iff_select {payload : SourcePayload} {path : List Nat} {node : Nat} :
    payload.Occurs path node ↔ payload.select path = some (.reference node) := by
  constructor
  · intro occurrence
    induction occurrence with
    | reference => simp [SourcePayload.select]
    | field found _ ih => simp [SourcePayload.select, found, ih]
  · induction path generalizing payload with
    | nil => intro selected; simp [SourcePayload.select] at selected; subst payload; constructor
    | cons index path ih =>
      cases payload with
      | plain => simp [SourcePayload.select]
      | reference identity => simp [SourcePayload.select]
      | aggregate head fields =>
        intro selected
        simp only [SourcePayload.select, Option.bind_eq_some_iff] at selected
        obtain ⟨child, found, selected⟩ := selected
        exact .field found (ih selected)

theorem payloadNodes_mem {fields : List SourcePayload} {node : Nat} :
    node ∈ payloadNodes fields ↔ ∃ payload ∈ fields, node ∈ payload.nodes := by
  induction fields with
  | nil => simp [payloadNodes]
  | cons payload fields ih => simp [payloadNodes, ih, or_and_right, exists_or, eq_comm]

theorem SourcePayload.mem_nodes_iff {payload : SourcePayload} {node : Nat} :
    node ∈ payload.nodes ↔ ∃ path, payload.Occurs path node := by
  induction payload using SourcePayload.rec
    (motive_2 := fun fields => ∀ child ∈ fields, node ∈ child.nodes ↔ ∃ path, child.Occurs path node) with
  | plain => simp [SourcePayload.nodes]; intro path occurrence; cases occurrence
  | reference identity =>
    simp only [SourcePayload.nodes, List.mem_singleton]
    constructor
    · intro same; subst node; exact ⟨[], .reference identity⟩
    · rintro ⟨path, occurrence⟩; cases occurrence; rfl
  | nil => rename_i child member; cases member
  | cons child fields ihChild ihFields =>
    rename_i selected member
    rcases List.mem_cons.mp member with same | member
    · subst selected; exact ihChild
    · exact ihFields selected member
  | aggregate head fields ih =>
    rw [SourcePayload.nodes, payloadNodes_mem]
    constructor
    · rintro ⟨child, member, nested⟩
      obtain ⟨index, found⟩ := List.mem_iff_getElem?.mp member
      obtain ⟨path, occurrence⟩ := (ih child member).mp nested
      exact ⟨index :: path, .field found occurrence⟩
    · rintro ⟨path, occurrence⟩
      cases occurrence with
      | field found nested =>
        have member := List.mem_of_getElem? found
        exact ⟨_, member, (ih _ member).mpr ⟨_, nested⟩⟩

theorem PayloadsCorrespond.append {node : Nat → Nat} {left right : List SourcePayload}
    {xs ys : List Value} (first : PayloadsCorrespond node left xs)
    (second : PayloadsCorrespond node right ys) : PayloadsCorrespond node (left ++ right) (xs ++ ys) := by
  induction left generalizing xs with
  | nil => cases first; exact second
  | cons payload payloads ih => cases first with
    | cons head tail => exact .cons head (ih tail)

theorem PayloadsCorrespond.select {node : Nat → Nat} {fields : List SourcePayload} {values : List Value}
    (related : PayloadsCorrespond node fields values) (index : Nat) :
    (∀ payload, fields[index]? = some payload → ∃ value, values[index]? = some value ∧ payload.Corresponds node value) ∧
    (∀ value, values[index]? = some value → ∃ payload, fields[index]? = some payload ∧ payload.Corresponds node value) := by
  induction fields generalizing values index with
  | nil => cases related; simp
  | cons payload fields ih =>
    cases related with
    | cons head tail =>
      cases index with
      | zero =>
        constructor <;> intro selected found <;> simp only [List.getElem?_cons_zero, Option.some.injEq] at found
        · subst selected; exact ⟨_, rfl, head⟩
        · subst selected; exact ⟨_, rfl, head⟩
      | succ index => simpa using ih tail index

theorem SourcePayload.Corresponds.congr {left right : Nat → Nat} {payload : SourcePayload} {value : Value}
    (related : payload.Corresponds left value) (agree : ∀ identity ∈ payload.nodes, left identity = right identity) :
    payload.Corresponds right value := by
  induction related using SourcePayload.Corresponds.rec
    (motive_2 := fun fields values _ => (∀ identity ∈ payloadNodes fields, left identity = right identity) → PayloadsCorrespond right fields values) with
  | plain free => exact .plain free
  | reference identity => rw [agree identity (by simp [SourcePayload.nodes])]; exact .reference identity
  | aggregate source constructor children ih => exact .aggregate source constructor (ih agree)
  | nil => exact .nil
  | cons head tail ihHead ihTail =>
    rename_i agree
    exact .cons (ihHead (fun identity member => agree identity (by simp [payloadNodes, member])))
      (ihTail (fun identity member => agree identity (by simp [payloadNodes, member])))

theorem valuesReferenceFree_iff {values : List Value} :
    valuesReferenceFree values ↔ ∀ value ∈ values, value.ReferenceFree := by
  induction values with
  | nil => simp [valuesReferenceFree]
  | cons value values ih => simp [valuesReferenceFree, ih]

theorem Value.ReferenceFree.child {value child : Value} (free : value.ReferenceFree)
    (member : child ∈ value.children) : child.ReferenceFree := by
  have all : valuesReferenceFree value.children := by
    cases value <;> simp_all [Value.ReferenceFree, Value.children, valuesReferenceFree]
  exact valuesReferenceFree_iff.mp all child member



theorem Value.readIndices_append (value : Value) (first second : List Nat) :
    value.readIndices (first ++ second) = (value.readIndices first >>= fun value => value.readIndices second) := by
  induction first generalizing value with
  | nil => rfl
  | cons index rest ih =>
    simp only [List.cons_append, Value.readIndices]
    cases value.children[index]? <;> simp [ih]

@[simp] theorem Value.readIndices_nil (value : Value) : value.readIndices [] = some value := rfl

@[simp] theorem Value.readIndices_reference {node other : Nat} {fields : List Nat} :
    (Value.reference node).readIndices fields = some (.reference other) ↔ fields = [] ∧ node = other := by
  cases fields <;> simp [Value.readIndices, Value.children]

theorem Value.ReferenceFree.children {value child : Value} (plain : value.ReferenceFree)
    {index : Nat} (found : value.children[index]? = some child) : child.ReferenceFree := by
  have member := List.mem_of_getElem? found
  have all : ∀ values, valuesReferenceFree values → ∀ value ∈ values, value.ReferenceFree := by
    intro values free
    induction values with
    | nil => simp
    | cons first rest ih =>
      intro value member
      rcases List.mem_cons.mp member with rfl | member
      · exact free.1
      · exact ih free.2 value member
  cases value with
  | tuple head tail => exact all (head :: tail) plain child member
  | array values => exact all values plain child member
  | nominal identity tag values => exact all values plain child member
  | _ => simp [Value.children] at member

theorem Value.ReferenceFree.readIndices {value selected : Value} {fields : List Nat}
    (plain : value.ReferenceFree) (read : value.readIndices fields = some selected) : selected.ReferenceFree := by
  induction fields generalizing value with
  | nil => cases Option.some.inj read; exact plain
  | cons index rest ih =>
    obtain ⟨child, found, read⟩ := Option.bind_eq_some_iff.mp read
    exact ih (plain.children found) read

theorem Value.ReferenceFree.noReference {value : Value} (plain : value.ReferenceFree) (fields : List Nat) (node : Nat) :
    value.readIndices fields ≠ some (.reference node) := by
  intro read
  exact plain.readIndices read


inductive Carrier where
  | stored (root : Root) (fields : List Nat := [])
  | held (index : Nat) (fields : List Nat := [])

def Carries (environment : Environment) (held : List Value) (node : Nat) : Carrier → Prop
  | .stored root fields => (environment.store root >>= fun value => value.readIndices fields) = some (.reference node)
  | .held index fields => (held[index]? >>= fun value => value.readIndices fields) = some (.reference node)

/-- The concrete held values are evaluated argument prefixes or protected return
payloads, not a future-use oracle. Inactive carrier bits are deliberately inert. -/
def Custody (environment : Environment) (held : List Value) : Prop :=
  ∀ (node : Nat) (loan : Loan), environment.loans[node]? = some loan → loan.own = true →
    ∃ location, Carries environment held node location ∧
      ∀ other, Carries environment held node other → other = location

@[simp] theorem carries_stored_nil {environment : Environment} {held : List Value} {node root : Nat} :
    Carries environment held node (.stored root) ↔ environment.store root = some (.reference node) := by
  simp [Carries]

@[simp] theorem carries_held_nil {environment : Environment} {held : List Value} {node index : Nat} :
    Carries environment held node (.held index) ↔ held[index]? = some (.reference node) := by
  simp [Carries]

theorem Carries.held_bound {environment : Environment} {held : List Value} {node index : Nat} {fields : List Nat}
    (carrier : Carries environment held node (.held index fields)) : index < held.length := by
  obtain ⟨value, found, _⟩ := Option.bind_eq_some_iff.mp carrier
  exact (List.getElem?_eq_some_iff.mp found).1

theorem carries_held_append {environment : Environment} {held tail : List Value} {node index : Nat} {fields : List Nat} :
    Carries environment (held ++ tail) node (.held index fields) ↔
      (index < held.length ∧ Carries environment held node (.held index fields)) ∨
      (held.length ≤ index ∧ Carries environment tail node (.held (index - held.length) fields)) := by
  by_cases bound : index < held.length
  · simp [Carries, List.getElem?_append_left bound, bound, Nat.not_le_of_lt bound]
  · simp [Carries, List.getElem?_append_right (Nat.le_of_not_lt bound), bound, Nat.le_of_not_lt bound]

theorem carries_held_append_reference {environment : Environment} {held : List Value} {node other index : Nat} {fields : List Nat} :
    Carries environment (held ++ [.reference node]) other (.held index fields) ↔
      Carries environment held other (.held index fields) ∨ (index = held.length ∧ fields = [] ∧ node = other) := by
  rw [carries_held_append]
  by_cases bound : index < held.length
  · have ne : index ≠ held.length := Nat.ne_of_lt bound
    simp [bound, Nat.not_le_of_lt bound, ne]
  · have absent : ¬ Carries environment held other (.held index fields) := fun c => bound c.held_bound
    simp only [bound, false_and, false_or, Nat.le_of_not_lt bound, true_and, absent]
    cases difference : index - held.length with
    | zero =>
      have eq : index = held.length := by omega
      simp [Carries, eq]
    | succ rest =>
      have ne : index ≠ held.length := by omega
      simp [Carries, ne]

theorem Custody.transport {before after : Environment} {held pending : List Value}
    (custody : Custody before held) (forward backward : Carrier → Carrier)
    (active : ∀ (node : Nat) (loan : Loan), after.loans[node]? = some loan → loan.own = true → before.loans[node]? = some loan)
    (lift : ∀ node place, Carries before held node place → Carries after pending node (forward place))
    (lower : ∀ node place, Carries after pending node place → Carries before held node (backward place))
    (inverse : ∀ node place, Carries after pending node place → forward (backward place) = place) :
    Custody after pending := by
  intro node loan found own
  obtain ⟨place, carried, unique⟩ := custody node loan (active node loan found own) own
  refine ⟨forward place, lift node place carried, ?_⟩
  intro other carried
  exact (inverse node other carried).symm.trans (congrArg forward (unique _ (lower node other carried)))

theorem pendingIndexBijection {α : Type} {left right : List α} (permuted : left.Perm right) :
    ∃ forward backward : Nat → Nat,
      (∀ index, right[forward index]? = left[index]?) ∧
      (∀ index, left[backward index]? = right[index]?) ∧
      (∀ index, backward (forward index) = index) ∧
      (∀ index, forward (backward index) = index) := by
  induction permuted with
  | nil => exact ⟨id, id, by simp, by simp, by simp, by simp⟩
  | cons value permuted ih =>
    obtain ⟨forward, backward, read, unread, inverse, reverse⟩ := ih
    let lift (f : Nat → Nat) : Nat → Nat := fun index => match index with
      | 0 => 0
      | index + 1 => f index + 1
    refine ⟨lift forward, lift backward, ?_, ?_, ?_, ?_⟩
    · intro index; cases index <;> simp [lift, read]
    · intro index; cases index <;> simp [lift, unread]
    · intro index; cases index <;> simp [lift, inverse]
    · intro index; cases index <;> simp [lift, reverse]
  | swap first second rest =>
    let swap : Nat → Nat := fun index => match index with
      | 0 => 1
      | 1 => 0
      | index + 2 => index + 2
    refine ⟨swap, swap, ?_, ?_, ?_, ?_⟩
    all_goals intro index; cases index with
      | zero => rfl
      | succ index => cases index <;> rfl
  | trans first second firstIH secondIH =>
    obtain ⟨f, g, read, unread, inverse, reverse⟩ := firstIH
    obtain ⟨h, k, read', unread', inverse', reverse'⟩ := secondIH
    exact ⟨h ∘ f, g ∘ k, fun i => (read' _).trans (read _),
      fun i => (unread _).trans (unread' _),
      fun i => by simp [inverse', inverse],
      fun i => by simp [reverse, reverse']⟩

theorem Custody.permPending {environment : Environment} {held other : List Value}
    (custody : Custody environment held) (permuted : held.Perm other) : Custody environment other := by
  obtain ⟨forward, backward, read, unread, inverse, reverse⟩ := pendingIndexBijection permuted
  let lift (f : Nat → Nat) : Carrier → Carrier
    | .stored root fields => .stored root fields
    | .held index fields => .held (f index) fields
  apply custody.transport (lift forward) (lift backward) (fun _ _ found _ => found)
  · intro node place carried
    cases place with
    | stored root fields => exact carried
    | held index fields => simpa [lift, Carries, read] using carried
  · intro node place carried
    cases place with
    | stored root fields => exact carried
    | held index fields => simpa [lift, Carries, unread] using carried
  · intro node place carried
    cases place <;> simp [lift, reverse]

theorem carries_held_append_value {environment : Environment} {held : List Value} {value : Value}
    {node index : Nat} {fields : List Nat} :
    Carries environment (held ++ [value]) node (.held index fields) ↔
      Carries environment held node (.held index fields) ∨
        (index = held.length ∧ value.readIndices fields = some (.reference node)) := by
  rw [carries_held_append]
  by_cases bound : index < held.length
  · simp [bound, Nat.not_le_of_lt bound, Nat.ne_of_lt bound]
  · have absent : ¬ Carries environment held node (.held index fields) := fun c => bound c.held_bound
    simp only [bound, false_and, false_or, Nat.le_of_not_lt bound, true_and, absent]
    cases difference : index - held.length with
    | zero =>
      have eq : index = held.length := by omega
      simp [Carries, eq]
    | succ rest =>
      have ne : index ≠ held.length := by omega
      simp [Carries, ne]

def Carrier.pack (count : Nat) : Carrier → Carrier
  | .stored root fields => .stored root fields
  | .held index fields =>
    if index < count then .held index fields else .held count ((index - count) :: fields)

def Carrier.unpack (count : Nat) : Carrier → Carrier
  | .stored root fields => .stored root fields
  | .held index fields =>
    if index < count then .held index fields else
      match fields with
      | [] => .held index []
      | child :: rest => .held (count + child) rest

theorem Carrier.unpack_pack (count : Nat) (place : Carrier) :
    (place.pack count).unpack count = place := by
  cases place with
  | stored root fields => rfl
  | held index fields =>
    by_cases bound : index < count
    · simp [Carrier.pack, Carrier.unpack, bound]
    · simp [Carrier.pack, Carrier.unpack, bound, Nat.add_sub_of_le (Nat.le_of_not_lt bound)]

theorem Carries.pack {environment : Environment} {held : List Value} {value : Value}
    {node : Nat} {place : Carrier} :
    Carries environment (held ++ [value]) node (place.pack held.length) ↔
      Carries environment (held ++ value.children) node place := by
  cases place with
  | stored root fields => rfl
  | held index fields =>
    by_cases bound : index < held.length
    · simp [Carrier.pack, Carries, bound, List.getElem?_append_left bound]
    · simp [Carrier.pack, Carries, bound, List.getElem?_append_right (Nat.le_of_not_lt bound), Value.readIndices]

theorem Carries.pack_unpack {environment : Environment} {held : List Value} {value : Value}
    (constructor : value.head.Source) {node : Nat} {place : Carrier}
    (carried : Carries environment (held ++ [value]) node place) :
    (place.unpack held.length).pack held.length = place := by
  cases place with
  | stored root fields => rfl
  | held index fields =>
    by_cases bound : index < held.length
    · simp [Carrier.pack, Carrier.unpack, bound]
    · rcases carries_held_append_value.mp carried with old | ⟨rfl, read⟩
      · exact False.elim (bound old.held_bound)
      · cases fields with
        | nil =>
          have equal : value = .reference node := Option.some.inj read
          subst value
          exact False.elim constructor
        | cons child rest => simp [Carrier.pack, Carrier.unpack]

theorem Custody.pack {environment : Environment} {held : List Value} {value : Value}
    (custody : Custody environment (held ++ value.children)) (constructor : value.head.Source) :
    Custody environment (held ++ [value]) := by
  apply custody.transport (Carrier.pack held.length) (Carrier.unpack held.length) (fun _ _ found _ => found)
  · intro node place carried; exact Carries.pack.mpr carried
  · intro node place carried
    apply Carries.pack.mp
    rw [carried.pack_unpack constructor]
    exact carried
  · intro node place carried; exact carried.pack_unpack constructor

theorem Custody.unpack {environment : Environment} {held : List Value} {value : Value}
    (custody : Custody environment (held ++ [value])) (constructor : value.head.Source) :
    Custody environment (held ++ value.children) := by
  apply custody.transport (Carrier.unpack held.length) (Carrier.pack held.length) (fun _ _ found _ => found)
  · intro node place carried
    apply Carries.pack.mp
    rw [carried.pack_unpack constructor]
    exact carried
  · intro node place carried; exact Carries.pack.mpr carried
  · intro node place carried; exact Carrier.unpack_pack _ _

theorem Custody.packTuple {environment : Environment} {held : List Value} {first : Value} {rest : List Value}
    (custody : Custody environment (held ++ first :: rest)) :
    Custody environment (held ++ [.tuple first rest]) := custody.pack (by trivial)

theorem Custody.packArray {environment : Environment} {held values : List Value}
    (custody : Custody environment (held ++ values)) :
    Custody environment (held ++ [.array values]) := custody.pack (by trivial)

theorem Custody.packNominal {environment : Environment} {held values : List Value} {identity : Nat} {tag : Option Nat}
    (custody : Custody environment (held ++ values)) :
    Custody environment (held ++ [.nominal identity tag values]) := custody.pack (by trivial)

theorem Custody.appendInactive {environment : Environment} {held : List Value} {value : Value}
    (custody : Custody environment held)
    (inactive : ∀ (node : Nat) (loan : Loan), environment.loans[node]? = some loan → loan.own = true →
      ∀ fields, value.readIndices fields ≠ some (.reference node)) : Custody environment (held ++ [value]) := by
  intro node loan found own
  obtain ⟨place, carried, unique⟩ := custody node loan found own
  have same : ∀ place, Carries environment (held ++ [value]) node place ↔ Carries environment held node place := by
    intro place
    cases place with
    | stored root fields => rfl
    | held index fields => simp [carries_held_append_value, inactive node loan found own fields]
  exact ⟨place, (same _).mpr carried, fun other c => unique _ ((same _).mp c)⟩

theorem Custody.dropInactive {environment : Environment} {held : List Value} {value : Value}
    (custody : Custody environment (held ++ [value]))
    (inactive : ∀ (node : Nat) (loan : Loan), environment.loans[node]? = some loan → loan.own = true →
      ∀ fields, value.readIndices fields ≠ some (.reference node)) : Custody environment held := by
  intro node loan found own
  obtain ⟨place, carried, unique⟩ := custody node loan found own
  have same : ∀ place, Carries environment (held ++ [value]) node place ↔ Carries environment held node place := by
    intro place
    cases place with
    | stored root fields => rfl
    | held index fields => simp [carries_held_append_value, inactive node loan found own fields]
  exact ⟨place, (same _).mp carried, fun other c => unique _ ((same _).mpr c)⟩

theorem SourcePayload.Corresponds.readIndices {node : Nat → Nat} {payload : SourcePayload}
    {value selected : Value} {path : List Nat} (related : payload.Corresponds node value)
    (read : value.readIndices path = some selected) :
    ∃ source, payload.select path = some source ∧ source.Corresponds node selected := by
  induction path generalizing payload value with
  | nil =>
    simp only [Value.readIndices, Option.some.injEq] at read
    subst selected
    exact ⟨payload, by simp [SourcePayload.select], related⟩
  | cons index path ih =>
    cases related with
    | plain free => exact ⟨.plain, by simp [SourcePayload.select], .plain (free.readIndices read)⟩
    | reference identity => simp [Value.readIndices, Value.children] at read
    | aggregate source constructor children =>
      simp only [Value.readIndices, Bind.bind, Option.bind_eq_some_iff] at read
      obtain ⟨child, found, read⟩ := read
      obtain ⟨childSource, sourceFound, childRelated⟩ := (children.select index).2 child found
      obtain ⟨selectedSource, sourceSelected, selectedRelated⟩ := ih childRelated read
      exact ⟨selectedSource, by simp [SourcePayload.select, sourceFound, sourceSelected], selectedRelated⟩

theorem SourcePayload.Corresponds.select {node : Nat → Nat} {payload selectedSource : SourcePayload}
    {value selected : Value} {path : List Nat} (related : payload.Corresponds node value)
    (source : payload.select path = some selectedSource)
    (read : value.readIndices path = some selected) : selectedSource.Corresponds node selected := by
  obtain ⟨other, found, related⟩ := related.readIndices read
  rw [source] at found
  cases Option.some.inj found
  exact related

theorem SourcePayload.Corresponds.reference_inv {node : Nat → Nat} {payload : SourcePayload} {actual : Nat}
    (related : payload.Corresponds node (.reference actual)) :
    ∃ identity, payload = .reference identity ∧ actual = node identity := by
  cases related with
  | plain free => exact False.elim free
  | reference identity => exact ⟨identity, rfl, rfl⟩
  | aggregate source constructor children =>
    subst_vars
    exact False.elim source

theorem SourcePayload.Corresponds.occurs_readIndices {node : Nat → Nat} {payload : SourcePayload}
    {value : Value} {path : List Nat} {identity : Nat} (related : payload.Corresponds node value)
    (occurrence : payload.Occurs path identity) : value.readIndices path = some (.reference (node identity)) := by
  induction occurrence generalizing value with
  | reference identity => cases related; rfl
  | field found nested ih =>
    cases related with
    | aggregate source constructor children =>
      obtain ⟨child, childFound, childRelated⟩ := (children.select _).1 _ found
      simp [Value.readIndices, childFound, ih childRelated]

theorem SourcePayload.Corresponds.readIndices_reference_iff {node : Nat → Nat} {payload : SourcePayload}
    {value : Value} {path : List Nat} {actual : Nat} (related : payload.Corresponds node value) :
    value.readIndices path = some (.reference actual) ↔
      ∃ identity, payload.Occurs path identity ∧ actual = node identity := by
  constructor
  · intro read
    obtain ⟨selected, found, selectedRelated⟩ := related.readIndices read
    obtain ⟨identity, same, renamed⟩ := selectedRelated.reference_inv
    subst selected
    exact ⟨identity, SourcePayload.occurs_iff_select.mpr found, renamed⟩
  · rintro ⟨identity, occurrence, rfl⟩
    exact related.occurs_readIndices occurrence

theorem Value.referenceFree_iff_head_children {value : Value} :
    value.ReferenceFree ↔ value.head.Source ∧ valuesReferenceFree value.children := by
  cases value <;> simp [Value.ReferenceFree, Value.head, Head.Source, Value.children, valuesReferenceFree]

theorem SourcePayload.Corresponds.referenceFree_iff {node : Nat → Nat} {payload : SourcePayload}
    {value : Value} (related : payload.Corresponds node value) :
    value.ReferenceFree ↔ payload.nodes = [] := by
  induction related using SourcePayload.Corresponds.rec
    (motive_2 := fun fields values _ => valuesReferenceFree values ↔ payloadNodes fields = []) with
  | plain free => simp [SourcePayload.nodes, free]
  | reference identity => simp [Value.ReferenceFree, SourcePayload.nodes]
  | aggregate source constructor children ih =>
    rw [Value.referenceFree_iff_head_children, constructor]
    simpa [source, SourcePayload.nodes] using ih
  | nil => simp [valuesReferenceFree, payloadNodes]
  | cons head tail ihHead ihTail => simp [valuesReferenceFree, payloadNodes, ihHead, ihTail]

theorem SourcePayload.nodes_nil_iff_no_occurrences {payload : SourcePayload} :
    payload.nodes = [] ↔ ∀ path identity, ¬ payload.Occurs path identity := by
  constructor
  · intro empty path identity occurrence
    have member := SourcePayload.mem_nodes_iff.mpr ⟨path, occurrence⟩
    simp [empty] at member
  · intro absent
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro identity member
    obtain ⟨path, occurrence⟩ := SourcePayload.mem_nodes_iff.mp member
    exact absent path identity occurrence

theorem SourcePayload.Corresponds.referenceFree_iff_no_occurrences {node : Nat → Nat}
    {payload : SourcePayload} {value : Value} (related : payload.Corresponds node value) :
    value.ReferenceFree ↔ ∀ path identity, ¬ payload.Occurs path identity :=
  related.referenceFree_iff.trans SourcePayload.nodes_nil_iff_no_occurrences

theorem PayloadsCorrespond.congr {left right : Nat → Nat} {fields : List SourcePayload}
    {values : List Value} (related : PayloadsCorrespond left fields values)
    (agree : ∀ identity ∈ payloadNodes fields, left identity = right identity) :
    PayloadsCorrespond right fields values := by
  induction fields generalizing values with
  | nil => cases related; exact .nil
  | cons payload fields ih =>
    cases related with
    | cons head tail =>
      exact .cons (head.congr (fun identity member => agree identity (by simp [payloadNodes, member])))
        (ih tail (fun identity member => agree identity (by simp [payloadNodes, member])))

def Slot.Corresponds (interpretation : Interpretation) (slot : Slot) (value : Value) : Prop :=
  SourcePayload.Corresponds interpretation.node slot.payload value

inductive SlotsCorrespond (interpretation : Interpretation) (store : Store) :
    List (String × Root) → List (String × Slot) → Prop where
  | nil : SlotsCorrespond interpretation store [] []
  | cons {name : String} {root : Root} {slot : Slot} {bindings : List (String × Root)}
      {slots : List (String × Slot)}
      (identity : root = interpretation.binder slot.binder)
      (resident : ∀ value, store root = some value → slot.Corresponds interpretation value)
      (rest : SlotsCorrespond interpretation store bindings slots) :
      SlotsCorrespond interpretation store ((name, root) :: bindings) ((name, slot) :: slots)

def Interpretation.addNode (interpretation : Interpretation) (source runtime : Nat) : Interpretation :=
  { interpretation with node := fun node => if node = source then runtime else interpretation.node node }

theorem Interpretation.addNode_old (interpretation : Interpretation) {source node runtime : Nat}
    (older : node < source) : (interpretation.addNode source runtime).node node = interpretation.node node := by
  simp [addNode, Nat.ne_of_lt older]

theorem SlotsCorrespond.node_congr {before after : Interpretation} {store : Store}
    {bindings : List (String × Root)} {slots : List (String × Slot)}
    (typed : SlotsCorrespond before store bindings slots)
    (sameBinders : ∀ binder, after.binder binder = before.binder binder)
    (sameNodes : ∀ binding ∈ slots, ∀ node ∈ binding.2.payload.nodes, after.node node = before.node node) :
    SlotsCorrespond after store bindings slots := by
  induction typed with
  | nil => exact .nil
  | @cons name root slot bindings slots identity resident rest ih =>
    refine .cons (identity.trans (sameBinders slot.binder).symm) ?_ (ih ?_)
    · intro value stored
      exact (resident value stored).congr (fun node member => (sameNodes (name, slot) (by simp) node member).symm)
    · intro binding member node occurrence
      exact sameNodes binding (by simp [member]) node occurrence







/-- Both structural and nominal projections consume the same positional typing fact. -/
theorem ResidentsTyped.select {types : List Ty} {values : List Value} {states : Nat → Initialization}
    (typed : ResidentsTyped program states values types) (index : Nat) (type : Ty)
    (selection : types[index]? = some type) :
    ∃ value, values[index]? = some value ∧ ResidentTyped program (states index) value type := by
  induction types generalizing values index states with
  | nil => cases typed; simp at selection
  | cons head tail ih =>
    cases typed with
    | cons headTyped tailTyped =>
      cases index with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at selection
        subst type
        exact ⟨_, rfl, headTyped⟩
      | succ index => exact ih tailTyped index selection

theorem ResidentsTyped.set {program : Program} {types : List Ty} {values : List Value} {states : Nat → Initialization}
    (typed : ResidentsTyped program states values types) (index : Nat) {type : Ty}
    (selected : types[index]? = some type) {replacement : Value} {next : Initialization}
    (resident : ResidentTyped program next replacement type) :
    ResidentsTyped program (fun other => if other = index then next else states other) (values.set index replacement) types := by
  induction types generalizing values index states with
  | nil => cases typed; simp at selected
  | cons first rest ih =>
    cases typed with
    | cons head tail =>
      cases index with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at selected
        cases selected
        exact .cons (by simpa only [↓reduceIte] using resident) (by simpa only [Nat.add_one_ne_zero, ↓reduceIte] using tail)
      | succ index =>
        exact .cons (by simpa only [Nat.zero_ne_add_one, ↓reduceIte] using head) (by simpa only [Nat.add_right_cancel_iff] using ih tail index selected)

/-- The selected resident and lawful replacement are derived from the same field contract. -/
theorem ProjectionType.access {source target : Ty} {key : FieldKey} {index : Nat} {state : Initialization}
    (projection : ProjectionType program home source key index target) {value : Value}
    (typed : ResidentTyped program state value source) (present : state.Present := by trivial) :
    ∃ resident, value.fieldIndex program key = some index ∧ value.children[index]? = some resident ∧
      ResidentTyped program (state.child index) resident target ∧
      ∀ replacement next, ResidentTyped program next replacement target →
        ∃ updated, value.replaceChild index replacement = some updated ∧
          ResidentTyped program (state.setChild index next) updated source := by
  cases projection with
  | @tuple first type rest index selected =>
    cases typed with
    | vacant => exact False.elim present
    | uncertain typed permission => exact False.elim present
    | @tuple state head tail _ _ headTyped tailTyped _ =>
      obtain ⟨resident, found, residentTyped⟩ := ResidentsTyped.select (states := state.child) (.cons headTyped tailTyped) index target selected
      refine ⟨resident, rfl, found, residentTyped, ?_⟩
      intro replacement next replacementTyped
      have changed : ResidentsTyped program (state.setChild index next).child ((head :: tail).set index replacement) (first :: rest) := by
        rw [show (state.setChild index next).child = (fun other => if other = index then next else state.child other) from funext (state.child_setChild present index next)]
        exact ResidentsTyped.set (.cons headTyped tailTyped) index selected replacementTyped
      cases index with
      | zero =>
        cases changed with
        | cons firstChanged restChanged => exact ⟨_, rfl, .tuple firstChanged restChanged (by simp [Initialization.setChild])⟩
      | succ index =>
        change tail[index]? = some resident at found
        cases changed with
        | cons firstChanged restChanged =>
          exact ⟨_, by simp [Value.replaceChild, found], .tuple firstChanged restChanged (by simp [Initialization.setChild])⟩
  | @nominal identity index key declaration schema field declared structureOnly indexed selected visible =>
    cases typed with
    | vacant => exact False.elim present
    | uncertain typed permission => exact False.elim present
    | @nominal state _ tag otherDeclaration otherSchema values otherDeclared chosen finite residents _ =>
      have sameDeclaration := Option.some.inj (otherDeclared.symm.trans declared)
      subst otherDeclaration
      cases tag with
      | some tag => simp [DataDecl.constructor, structureOnly] at chosen
      | none =>
        have sameSchema : otherSchema = schema := by simpa [DataDecl.constructor, structureOnly] using chosen.symm
        subst otherSchema
        have selectedType : (schema.residents.map Field.type)[index]? = some field.type := by simp [List.getElem?_map, selected]
        obtain ⟨resident, found, residentTyped⟩ := ResidentsTyped.select residents index field.type selectedType
        refine ⟨resident, ?_, found, residentTyped, ?_⟩
        · simp [Value.fieldIndex, declared, structureOnly, indexed]
        · intro replacement next replacementTyped
          have changed : ResidentsTyped program (state.setChild index next).child (values.set index replacement) (schema.residents.map Field.type) := by
            rw [show (state.setChild index next).child = (fun other => if other = index then next else state.child other) from funext (state.child_setChild present index next)]
            exact residents.set index selectedType replacementTyped
          exact ⟨_, by simp [Value.replaceChild, found], .nominal declared chosen finite changed (by simp [Initialization.setChild])⟩

/-- Runtime resolution agrees with the sole source index derivation. -/
theorem PathType.resident {source target : Ty} {keys : List FieldKey} {indices : List Nat} {state selected : Initialization}
    (path : PathType program home source keys indices target) {value : Value}
    (typed : ResidentTyped program state value source) (access : state.Access indices selected) :
    value.resolvePath program keys = some indices ∧
      ∃ resident, value.readIndices indices = some resident ∧ ResidentTyped program selected resident target := by
  induction path generalizing value state selected with
  | nil => cases access; exact ⟨rfl, value, rfl, typed⟩
  | @cons source middle target key keys index indices head tail ih =>
    cases access with
    | child present childAccess =>
      obtain ⟨child, indexed, found, childTyped, _⟩ := head.access typed present
      obtain ⟨resolved, resident, selected, residentTyped⟩ := ih childTyped childAccess
      exact ⟨by simp [Value.resolvePath, indexed, found, resolved], resident,
        by simp [Value.readIndices, found, selected], residentTyped⟩

theorem CanonicalPath.resident {source target : Ty} {indices : List Nat} {state selected : Initialization}
    (path : CanonicalPath program source indices target) {value : Value}
    (typed : ResidentTyped program state value source) (access : state.Access indices selected) :
    ∃ resident, value.readIndices indices = some resident ∧ ResidentTyped program selected resident target := by
  induction path generalizing value state selected with
  | nil => cases access; exact ⟨value, rfl, typed⟩
  | cons head _ ih =>
    cases access with
    | child present childAccess =>
      obtain ⟨child, _, found, childTyped, _⟩ := head.access typed present
      obtain ⟨resident, selected, residentTyped⟩ := ih childTyped childAccess
      exact ⟨resident, by simp [Value.readIndices, found, selected], residentTyped⟩

end Grounded

/- Section: CheckedPayload -/
namespace Grounded.Checked
set_option autoImplicit false

/-- Symbols in a checked product are not source or runtime loan numbers. A
parameter occurrence records constructor choices as well as field positions. -/
inductive Component where
  | constructor (head : Head)
  | field (index : Nat)
  deriving DecidableEq

inductive Reference where
  | existing (node : Nat)
  | parameter (owner : Nat) (path : List Component)
  | borrowed (identity : Nat)
  | copied (identity : Nat) (parent : Reference)
  deriving DecidableEq

inductive Base where
  | binder (identity : Nat)
  | referent (reference : Reference)
  deriving DecidableEq

structure Address where
  base : Base
  fields : List Nat := []
  deriving DecidableEq

/-- Shape knowledge is produced from source facts; it never deletes declared
reference occurrences from ordinary checking. -/
inductive SchemaKnowledge where
  | unknown
  | referenceFree
  deriving DecidableEq

/-- Schemas retain declared hypothetical references even when the current
source subtree is known reference-free. Fresh declaration inputs are unknown. -/
inductive Payload where
  | plain
  | reference (symbol : Reference) (referent : Ty) (mode : BorrowMode)
  | aggregate (head : Head) (fields : List Payload)
  | schema (owner : Nat) (path : List Component) (type : Ty) (copies : List Nat)
      (knowledge : SchemaKnowledge := .unknown)

/-- Copy stamps are applied in their production order. -/
def Reference.rename (reference : Reference) (copies : List Nat) : Reference :=
  copies.foldl (fun reference identity => .copied identity reference) reference

def Payload.input (owner : Nat) (path : List Component) (type : Ty)
    (copies : List Nat := []) (knowledge : SchemaKnowledge := .unknown) : Payload :=
  match type with
  | .reference referent mode => .reference ((Reference.parameter owner path).rename copies) referent mode
  | _ => .schema owner path type copies knowledge


/-- Type paths belong to the declared schema, not to a guessed active value. -/
inductive ReferencePath (program : Program) : Ty → List Component → Ty → BorrowMode → Prop where
  | here (referent : Ty) (mode : BorrowMode) :
      ReferencePath program (.reference referent mode) [] referent mode
  | child {type child referent : Ty} {head : Head} {types : List Ty}
      {index : Nat} {path : List Component} {mode : BorrowMode}
      (source : head.Source) (shape : HeadType program head type types)
      (selected : types[index]? = some child)
      (nested : ReferencePath program child path referent mode) :
      ReferencePath program type (.constructor head :: .field index :: path) referent mode

/-- The same payload product supplies local resource occurrences. Schema
occurrences range over declared alternatives; they are not live-node claims. -/
inductive Payload.Occurs (program : Program) : Payload → Reference → Prop where
  | reference (symbol : Reference) (referent : Ty) (mode : BorrowMode) :
      Occurs program (.reference symbol referent mode) symbol
  | child {head : Head} {fields : List Payload} {field : Payload} {symbol : Reference}
      (selected : field ∈ fields) (nested : Occurs program field symbol) :
      Occurs program (.aggregate head fields) symbol
  | schema {owner : Nat} {path suffix : List Component} {type referent : Ty}
      {mode : BorrowMode} {copies : List Nat} {knowledge : SchemaKnowledge}
      (selected : ReferencePath program type suffix referent mode) :
      Occurs program (.schema owner path type copies knowledge)
        ((Reference.parameter owner (path ++ suffix)).rename copies)

mutual
inductive Payload.Typed (program : Program) : Payload → Ty → Prop where
  | plain {type : Ty} (free : ReferenceFreeLayout program.target program.data type) :
      Payload.Typed program .plain type
  | reference (symbol : Reference) (referent : Ty) (mode : BorrowMode) :
      Payload.Typed program (.reference symbol referent mode) (.reference referent mode)
  | aggregate {head : Head} {fields : List Payload} {type : Ty} {types : List Ty}
      (source : head.Source) (shape : HeadType program head type types)
      (children : PayloadsTyped program fields types) :
      Payload.Typed program (.aggregate head fields) type
  | schema (owner : Nat) (path : List Component) (type : Ty) (copies : List Nat)
      (knowledge : SchemaKnowledge := .unknown) :
      Payload.Typed program (.schema owner path type copies knowledge) type
inductive PayloadsTyped (program : Program) : List Payload → List Ty → Prop where
  | nil : PayloadsTyped program [] []
  | cons {head : Payload} {tail : List Payload} {first : Ty} {rest : List Ty}
      (typed : Payload.Typed program head first) (types : PayloadsTyped program tail rest) :
      PayloadsTyped program (head :: tail) (first :: rest)
end

structure Result where
  type : Ty
  payload : Payload

structure Slot extends BindingType where
  binder : Nat
  payload : Payload

structure Loan where
  reference : Reference
  target : Address
  referent : Ty
  mode : BorrowMode
  parent : Option Reference

/-- Ended occurrences and created loans are authoritative checking state.
Unknown external support is discharged by realization, never inferred from a
possible-initialization mask. -/
structure Context where
  names : List (String × Nat)
  storage : Base → Option Slot
  loans : List Loan
  ended : List Payload
  nextBinder : Nat
  nextSymbol : Nat

variable {program : Program}

def Context.bindings (context : Context) : List (String × Slot) :=
  context.names.filterMap fun entry =>
    (context.storage (.binder entry.2)).map fun slot => (entry.1, slot)

def Context.NotEnded (context : Context) (reference : Reference) : Prop :=
  ∀ payload ∈ context.ended, ¬ payload.Occurs program reference

def Context.Available (context : Context) (payload : Payload) : Prop :=
  ∀ reference, payload.Occurs program reference → context.NotEnded (program := program) reference

def Context.endPayload (context : Context) (payload : Payload) : Context :=
  { context with ended := payload :: context.ended }

@[simp] theorem Payload.input_typed (owner : Nat) (path : List Component)
    (type : Ty) (copies : List Nat) (knowledge : SchemaKnowledge := .unknown) :
    Payload.Typed program (Payload.input owner path type copies knowledge) type := by
  cases type <;> simp only [Payload.input]
  all_goals first | exact .schema _ _ _ _ knowledge | exact .reference ..


/-- A locally ended occurrence cannot be made available by branch unreachability. -/
theorem Context.unavailable_after_end {context : Context} {payload : Payload} {reference : Reference}
    (occurs : payload.Occurs program reference) :
    ¬ (context.endPayload payload).Available (program := program) payload := by
  intro available
  exact available reference occurs payload (by simp [Context.endPayload]) occurs

/-- Shape transport alone does not authorize Copy. The producer consumes this
positive permission together with local occurrence availability. -/
structure CopyAllowed (program : Program) (context : Context) (result : Result) : Prop where
  typed : result.payload.Typed program result.type
  permission : Duplicable program.data result.type
  available : context.Available (program := program) result.payload

theorem CopyAllowed.not_nonduplicable {context : Context} {result : Result}
    (allowed : CopyAllowed program context result)
    (noncopy : Nonduplicable program.data result.type) : False :=
  noncopy.not_duplicable allowed.permission

/-- Every reference-typed checked product accounts for a reference occurrence;
neither abstract schemas nor aggregate heads can erase the obligation. -/
theorem Payload.Typed.reference_occurs {payload : Payload} {referent : Ty} {mode : BorrowMode}
    (typed : Payload.Typed program payload (.reference referent mode)) :
    ∃ reference, payload.Occurs program reference := by
  cases typed with
  | plain free => cases free
  | reference reference referent mode => exact ⟨reference, .reference reference referent mode⟩
  | aggregate source shape children => cases shape; contradiction
  | schema owner path type copies knowledge =>
      exact ⟨_, .schema (.here referent mode)⟩

end Grounded.Checked

/- Section: CheckedContext -/
namespace Grounded.Checked
set_option autoImplicit false
variable {program : Program}

def Context.empty : Context := ⟨[], fun _ => none, [], [], 0, 0⟩

def Address.extend (address : Address) (fields : List Nat) : Address :=
  { address with fields := address.fields ++ fields }

/-- Different opaque referents are not assumed disjoint. This predicate detects
only a definite local overlap; external separation remains a realization duty. -/
def Address.KnownOverlap (left right : Address) : Prop :=
  left.base = right.base ∧ ¬ CoordinatesApart left.fields right.fields

def Context.loan (context : Context) (reference : Reference) : Option Loan :=
  context.loans.find? (fun loan => loan.reference == reference)

def Context.referenceTarget (context : Context) : Reference → Address
  | .copied _ parent => context.referenceTarget parent
  | reference =>
      match context.loan reference with
      | some loan => loan.target
      | none => ⟨.referent reference, []⟩

inductive Context.Derived (context : Context) : Reference → Reference → Prop where
  | refl (reference : Reference) : Derived context reference reference
  | copied (identity : Nat) {parent ancestor : Reference} (rest : Derived context parent ancestor) :
      Derived context (.copied identity parent) ancestor
  | borrowed {reference parent ancestor : Reference} {loan : Loan}
      (found : context.loan reference = some loan) (original : loan.parent = some parent)
      (rest : Derived context parent ancestor) : Derived context reference ancestor

/-- Canonical views survive exactly while the original authority or a known
descendant still refers to them. Ended handle rows are not mutable mask caches. -/
def Context.ViewNeeded (context : Context) (reference : Reference) : Prop :=
  context.NotEnded (program := program) reference ∨
    ∃ loan ∈ context.loans, context.NotEnded (program := program) loan.reference ∧
      (context.referenceTarget loan.reference).base = .referent reference

/-- Absence of a symbolic cell records lack of local information, not actual
readiness. A known vacancy is nevertheless rejected even on a dormant path. -/
def Context.NotKnownUnrestored (context : Context) (reference : Reference) : Prop :=
  let address := context.referenceTarget reference
  ∀ slot, context.storage address.base = some slot →
    ∃ state, slot.initialization.Access address.fields state ∧ state.Complete

def Context.ResourcesAvailable (context : Context) (payload : Payload) : Prop :=
  ∀ reference, payload.Occurs program reference →
    context.NotEnded (program := program) reference ∧ context.NotKnownUnrestored reference

def Context.LocalPermits (context : Context) (mode : BorrowMode)
    (parent : Option Reference) (target : Address) : Prop :=
  ∀ loan ∈ context.loans, context.NotEnded (program := program) loan.reference →
    (∃ reference, parent = some reference ∧ context.Derived reference loan.reference) ∨
      (mode = .shared ∧ loan.mode = .shared) ∨ ¬ target.KnownOverlap loan.target

def Context.hide (context : Context) : Context := { context with names := [] }

def Context.resume (caller callee : Context) : Context :=
  { callee with names := caller.names }

def Context.bind (context : Context) (name : String) (mutable : Bool) (result : Result) : Context :=
  { context with
    names := (name, context.nextBinder) :: context.names
    storage := fun base => if base = .binder context.nextBinder then
      some ⟨⟨result.type, mutable, .full⟩, context.nextBinder, result.payload⟩ else context.storage base
    nextBinder := context.nextBinder + 1 }

def Context.writeTarget (context : Context) (target : Address)
    (next : Initialization) (payload : Payload) : Context :=
  { context with storage := fun base =>
    if base = target.base then
      (context.storage base).map fun slot =>
        { slot with initialization := slot.initialization.write target.fields next, payload := payload }
    else context.storage base }

def Context.borrow (context : Context) (target : Address) (referent : Ty)
    (mode : BorrowMode) (parent : Option Reference) : Context :=
  { context with
    loans := context.loans ++ [⟨.borrowed context.nextSymbol, target, referent, mode, parent⟩]
    nextSymbol := context.nextSymbol + 1 }

/-- Copy renamings use a fresh stamp; this operation alone is not Copy admission. -/
def Context.advanceSymbol (context : Context) : Context :=
  { context with nextSymbol := context.nextSymbol + 1 }

mutual
inductive Payload.Select (program : Program) (home : Module) :
    Payload → Ty → List FieldKey → List Nat → Payload → Ty → Type where
  | here (payload : Payload) (type : Ty) :
      Select program home payload type [] [] payload type
  | aggregate {head : Head} {fields : List Payload} {type middle selectedType : Ty}
      {key : FieldKey} {keys : List FieldKey} {index : Nat} {indices : List Nat}
      {field selected : Payload}
      (projection : ProjectionType program home type key index middle)
      (found : fields[index]? = some field)
      (rest : Select program home field middle keys indices selected selectedType) :
      Select program home (.aggregate head fields) type (key :: keys) (index :: indices) selected selectedType
  | schema {owner : Nat} {path : List Component} {type middle selectedType : Ty}
      {copies : List Nat} {head : Head} {types : List Ty} {knowledge : SchemaKnowledge}
      {key : FieldKey} {keys : List FieldKey} {index : Nat} {indices : List Nat} {selected : Payload}
      (projection : ProjectionType program home type key index middle)
      (shape : HeadType program head type types) (found : types[index]? = some middle)
      (rest : Select program home (Payload.input owner (path ++ [.constructor head, .field index]) middle copies knowledge)
        middle keys indices selected selectedType) :
      Select program home (.schema owner path type copies knowledge) type (key :: keys) (index :: indices) selected selectedType
  | plain {type middle selectedType : Ty} {key : FieldKey} {keys : List FieldKey}
      {index : Nat} {indices : List Nat} {selected : Payload}
      (projection : ProjectionType program home type key index middle)
      (free : ReferenceFreeLayout program.target program.data type)
      (rest : Select program home .plain middle keys indices selected selectedType) :
      Select program home .plain type (key :: keys) (index :: indices) selected selectedType
end

/-- Selection cannot make an uninitialized owned place readable: this separate
local mask premise is common to checking and executable elaboration. -/
structure PlaceSelection (program : Program) (home : Module) (context : Context)
    (place : Place) (result : Result) where
  slot : Slot
  indices : List Nat
  state : Initialization
  found : lookup place.root context.bindings = some slot
  access : slot.initialization.Access indices state
  complete : state.Complete
  selected : Payload.Select program home slot.payload slot.type place.fields indices result.payload result.type
  typed : result.payload.Typed program result.type

/-- Common Copy checking retains all positive type and local resource premises.
Executable elaboration must additionally realize its actual source CopyPayload. -/
structure CopySelection (program : Program) (home : Module) (context : Context)
    (place : Place) (result : Result) extends PlaceSelection program home context place result where
  permission : Duplicable program.data result.type
  available : context.ResourcesAvailable (program := program) result.payload
  carrier : context.LocalPermits (program := program) .shared none ⟨.binder slot.binder, indices⟩

theorem Context.ended_not_available {context : Context} {payload : Payload} {reference : Reference}
    (occurs : payload.Occurs program reference) :
    ¬ (context.endPayload payload).ResourcesAvailable (program := program) payload := by
  intro available
  exact (available reference occurs).1 payload (by simp [Context.endPayload]) occurs

end Grounded.Checked

/- Section: StoragePayload -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

theorem ResidentsTyped.length_eq {program : Program} {states : Nat → Initialization}
    {values : List Value} {types : List Ty} (typed : ResidentsTyped program states values types) :
    values.length = types.length := by
  induction types generalizing values states with
  | nil => cases typed; rfl
  | cons first rest ih => cases typed with
    | cons head tail => simpa using ih tail

theorem ProjectionType.payloadShell {program : Program} {home : Module} {type middle : Ty}
    {key : FieldKey} {index : Nat} {head : Head} {types : List Ty} {state : Initialization} {value : Value}
    (projection : ProjectionType program home type key index middle)
    (shape : HeadType program head type types)
    (typed : ResidentTyped program state value type) (present : state.Present) :
    head.Source ∧ value.head = head ∧ value.children.length = types.length := by
  cases projection with
  | tuple selected =>
    cases shape
    cases typed with
    | vacant => exact False.elim present
    | uncertain actual permission => exact False.elim present
    | tuple first rest live => exact ⟨by trivial, rfl, ResidentsTyped.length_eq (.cons first rest)⟩
  | @nominal identity index key declaration schema field declared structureOnly indexed selected visible =>
    cases shape with
    | @nominal _ tag otherDeclaration otherSchema otherDeclared chosen =>
      have sameDeclaration := Option.some.inj (otherDeclared.symm.trans declared)
      subst otherDeclaration
      cases tag with
      | some tag => simp [DataDecl.constructor, structureOnly] at chosen
      | none =>
        have sameSchema : otherSchema = schema := by simpa [DataDecl.constructor, structureOnly] using chosen.symm
        subst otherSchema
        cases typed with
        | vacant => exact False.elim present
        | uncertain actual permission => exact False.elim present
        | @nominal _ _ actualTag actualDeclaration actualSchema values actualDeclared actualChosen finite residents live =>
          have sameDeclaration := Option.some.inj (actualDeclared.symm.trans declared)
          subst actualDeclaration
          cases actualTag with
          | some tag => simp [DataDecl.constructor, structureOnly] at actualChosen
          | none =>
            have sameSchema : actualSchema = schema := by simpa [DataDecl.constructor, structureOnly] using actualChosen.symm
            subst actualSchema
            exact ⟨by trivial, rfl, residents.length_eq⟩

theorem PayloadsCorrespond.set {node : Nat → Nat} {fields : List SourcePayload} {values : List Value}
    (related : PayloadsCorrespond node fields values) (index : Nat) {payload : SourcePayload} {value : Value}
    (replacement : payload.Corresponds node value) :
    PayloadsCorrespond node (fields.set index payload) (values.set index value) := by
  induction fields generalizing values index with
  | nil => cases related; exact .nil
  | cons first rest ih =>
    cases related with
    | cons head tail =>
      cases index with
      | zero => exact .cons replacement tail
      | succ index => exact .cons head (ih tail index)

theorem PayloadsCorrespond.plain {node : Nat → Nat} {values : List Value}
    (free : valuesReferenceFree values) : PayloadsCorrespond node (List.replicate values.length .plain) values := by
  induction values with
  | nil => exact .nil
  | cons first rest ih => exact .cons (.plain free.1) (ih free.2)

theorem Value.replaceChild_shape {value replacement updated : Value} {index : Nat}
    (written : value.replaceChild index replacement = some updated) :
    updated.head = value.head ∧ updated.children = value.children.set index replacement := by
  cases value with
  | vacant | unit | integer | character | array | reference => simp [Value.replaceChild] at written
  | tuple head tail =>
    cases index with
    | zero => cases Option.some.inj written; exact ⟨rfl, rfl⟩
    | succ index =>
      obtain ⟨old, found, same⟩ := Option.map_eq_some_iff.mp written
      cases same
      exact ⟨rfl, rfl⟩
  | nominal identity tag fields =>
    obtain ⟨old, found, same⟩ := Option.map_eq_some_iff.mp written
    cases same
    exact ⟨rfl, rfl⟩

theorem SourcePayload.Write.corresponds {program : Program} {type : Ty} {path : List Nat}
    {before replacement after : SourcePayload} (write : Write program type path before replacement after)
    {node : Nat → Nat} {value resident updated : Value} {state selected : Initialization}
    (typed : ResidentTyped program state value type) (access : state.Access path selected)
    (related : before.Corresponds node value) (replacementRelated : replacement.Corresponds node resident)
    (written : value.writeIndices path resident = some updated) : after.Corresponds node updated := by
  induction write generalizing state selected value updated with
  | here =>
    simp only [Value.writeIndices, Option.some.injEq] at written
    subst updated
    exact replacementRelated
  | aggregate projection found nested ih =>
    cases access with
    | child present access =>
      obtain ⟨child, indexed, childFound, childTyped, replace⟩ := projection.access typed present
      simp only [Value.writeIndices, Bind.bind, childFound, Option.bind_some, Option.bind_eq_some_iff] at written
      obtain ⟨next, changed, replaced⟩ := written
      cases related with
      | aggregate source constructor children =>
        obtain ⟨other, otherFound, childRelated⟩ := (children.select _).1 _ found
        have same := Option.some.inj (otherFound.symm.trans childFound)
        subst other
        have nextRelated := ih childTyped access childRelated replacementRelated changed
        have shape := Value.replaceChild_shape replaced
        exact .aggregate source (shape.1.trans constructor) (shape.2 ▸ children.set _ nextRelated)
  | plainExpand projection shape found nested ih =>
    cases access with
    | child present access =>
      obtain ⟨child, indexed, childFound, childTyped, replace⟩ := projection.access typed present
      obtain ⟨source, constructor, length⟩ := projection.payloadShell shape typed present
      simp only [Value.writeIndices, Bind.bind, childFound, Option.bind_some, Option.bind_eq_some_iff] at written
      obtain ⟨next, changed, replaced⟩ := written
      cases related with
      | plain free =>
        have childRelated : SourcePayload.Corresponds node .plain child := .plain (free.child (List.mem_of_getElem? childFound))
        have nextRelated := ih childTyped access childRelated replacementRelated changed
        have freeChildren := (Value.referenceFree_iff_head_children.mp free).2
        have children : PayloadsCorrespond node (List.replicate _ .plain) value.children := PayloadsCorrespond.plain freeChildren
        rw [length] at children
        have resultShape := Value.replaceChild_shape replaced
        exact .aggregate source (resultShape.1.trans constructor) (resultShape.2 ▸ children.set _ nextRelated)

theorem Value.replaceChild_readback {value replacement updated : Value} {index : Nat}
    (written : value.replaceChild index replacement = some updated) :
    updated.children[index]? = some replacement := by
  cases value with
  | vacant | unit | integer | character | array | reference => simp [Value.replaceChild] at written
  | tuple head tail =>
    cases index with
    | zero => cases Option.some.inj written; rfl
    | succ index =>
      obtain ⟨old, found, same⟩ := Option.map_eq_some_iff.mp written
      cases same
      obtain ⟨bound, _⟩ := List.getElem?_eq_some_iff.mp found
      simp [Value.children, bound]
  | nominal identity tag fields =>
    obtain ⟨old, found, same⟩ := Option.map_eq_some_iff.mp written
    cases same
    obtain ⟨bound, _⟩ := List.getElem?_eq_some_iff.mp found
    simp [Value.children, bound]

theorem Value.writeIndices_readback {value replacement updated : Value} {indices : List Nat}
    (written : value.writeIndices indices replacement = some updated) :
    updated.readIndices indices = some replacement := by
  induction indices generalizing value updated with
  | nil => cases Option.some.inj written; rfl
  | cons index indices ih =>
    simp only [Value.writeIndices, Bind.bind, Option.bind_eq_some_iff] at written
    obtain ⟨child, found, next, changed, replaced⟩ := written
    have readback := Value.replaceChild_readback replaced
    simp [Value.readIndices, readback, ih changed]

theorem CanonicalPath.write {source target : Ty} {indices : List Nat} {state selected next : Initialization}
    (path : CanonicalPath program source indices target) {value replacement : Value}
    (typed : ResidentTyped program state value source) (access : state.Access indices selected)
    (resident : ResidentTyped program next replacement target) :
    ∃ updated, value.writeIndices indices replacement = some updated ∧
      ResidentTyped program (state.write indices next) updated source ∧ updated.readIndices indices = some replacement := by
  induction path generalizing value state selected with
  | nil => exact ⟨replacement, rfl, resident, rfl⟩
  | @cons source middle target index indices home key head tail ih =>
    cases access with
    | child present childAccess =>
      obtain ⟨child, _, found, childTyped, replace⟩ := head.access typed present
      obtain ⟨updatedChild, written, updatedChildTyped, _⟩ := ih childTyped childAccess resident
      obtain ⟨updated, replaced, updatedTyped⟩ := replace updatedChild _ updatedChildTyped
      have pathWritten : value.writeIndices (index :: indices) replacement = some updated := by
        simp [Value.writeIndices, found, written, replaced]
      exact ⟨updated, pathWritten, updatedTyped, Value.writeIndices_readback pathWritten⟩

theorem PathType.write {source target : Ty} {keys : List FieldKey} {indices : List Nat} {state selected next : Initialization}
    (path : PathType program home source keys indices target) {value replacement : Value}
    (typed : ResidentTyped program state value source) (access : state.Access indices selected)
    (resident : ResidentTyped program next replacement target) :
    ∃ updated, value.writeIndices indices replacement = some updated ∧
      ResidentTyped program (state.write indices next) updated source ∧ updated.readIndices indices = some replacement :=
  path.canonical.write typed access resident

theorem ProjectionType.headType {program : Program} {home : Module} {type middle : Ty}
    {key : FieldKey} {index : Nat} {head : Head} {types : List Ty}
    (projection : ProjectionType program home type key index middle)
    (shape : HeadType program head type types) : head.Source ∧ types[index]? = some middle := by
  cases projection with
  | tuple selected => cases shape; exact ⟨by trivial, selected⟩
  | @nominal identity index key declaration schema field declared structureOnly indexed selected visible =>
    cases shape with
    | @nominal _ tag otherDeclaration otherSchema otherDeclared chosen =>
      have sameDeclaration := Option.some.inj (otherDeclared.symm.trans declared)
      subst otherDeclaration
      cases tag with
      | some tag => simp [DataDecl.constructor, structureOnly] at chosen
      | none =>
        have sameSchema : otherSchema = schema := by simpa [DataDecl.constructor, structureOnly] using chosen.symm
        subst otherSchema
        exact ⟨by trivial, by simp [List.getElem?_map, selected]⟩

theorem ProjectionType.signature {program : Program} {home : Module} {type middle : Ty}
    {key : FieldKey} {index : Nat} (projection : ProjectionType program home type key index middle) :
    ∃ head types, HeadType program head type types := by
  cases projection with
  | tuple selected => exact ⟨_, _, .tuple _ _⟩
  | @nominal identity index key declaration schema field declared structureOnly indexed selected visible =>
    exact ⟨_, _, .nominal (tag := none) (schema := schema) declared (by simp [DataDecl.constructor, structureOnly])⟩

theorem ProjectionType.target_eq {program : Program} {leftHome rightHome : Module} {type left right : Ty}
    {leftKey rightKey : FieldKey} {index : Nat}
    (first : ProjectionType program leftHome type leftKey index left)
    (second : ProjectionType program rightHome type rightKey index right) : left = right := by
  obtain ⟨head, types, shape⟩ := first.signature
  exact Option.some.inj ((first.headType shape).2.symm.trans (second.headType shape).2)


theorem SourcePayload.Write.typed {program : Program} {type target : Ty} {path : List Nat}
    {before replacement after : SourcePayload} (write : Write program type path before replacement after)
    {loans : List SourceLoan} (typed : before.Typed program loans type)
    (canonical : CanonicalPath program type path target) (resident : replacement.Typed program loans target) :
    after.Typed program loans type := by
  induction write generalizing target with
  | here => cases canonical; exact resident
  | aggregate projection found nested ih =>
    cases canonical with
    | cons other tail =>
      have same := projection.target_eq other
      subst_vars
      cases typed with
      | aggregate source shape children =>
        have selected := (projection.headType shape).2
        obtain ⟨childType, childSelected, childTyped⟩ := children.getElem found
        have same := Option.some.inj (childSelected.symm.trans selected)
        subst childType
        exact .aggregate source shape (children.set selected (ih childTyped tail resident))
  | plainExpand projection shape found nested ih =>
    cases canonical with
    | cons other tail =>
      have same := projection.target_eq other
      subst_vars
      exact .aggregate (projection.headType shape).1 shape
        ((PayloadsTyped.plain program loans _).set found (ih (.plain _) tail resident))
theorem PayloadsTyped.select {program : Program} {loans : List SourceLoan}
    {payloads : List SourcePayload} {types : List Ty} (typed : PayloadsTyped program loans payloads types)
    {index : Nat} {type : Ty} (selected : types[index]? = some type) :
    ∃ payload, payloads[index]? = some payload ∧ payload.Typed program loans type := by
  cases typed with
  | nil => simp at selected
  | cons head tail =>
    cases index with
    | zero => cases selected; exact ⟨_, rfl, head⟩
    | succ index => exact PayloadsTyped.select tail selected

theorem SourcePayload.Write.exists {program : Program} {type target : Ty} {path : List Nat}
    (canonical : CanonicalPath program type path target) {before : SourcePayload}
    {loans : List SourceLoan} (typed : before.Typed program loans type) (replacement : SourcePayload) :
    ∃ after, Write program type path before replacement after := by
  induction canonical generalizing before with
  | nil => exact ⟨replacement, .here⟩
  | cons projection tail ih =>
    cases typed with
    | plain =>
      obtain ⟨head, types, shape⟩ := projection.signature
      obtain ⟨updated, nested⟩ := ih (.plain _)
      exact ⟨_, .plainExpand projection shape (projection.headType shape).2 nested⟩
    | reference found => cases projection
    | aggregate source shape children =>
      obtain ⟨child, found, childTyped⟩ := children.select (projection.headType shape).2
      obtain ⟨updated, nested⟩ := ih childTyped
      exact ⟨_, .aggregate projection found nested⟩

theorem SourcePayload.Write.realizes {program : Program} {type target : Ty} {path : List Nat}
    {before replacement after : SourcePayload} (write : Write program type path before replacement after)
    (canonical : CanonicalPath program type path target)
    {node : Nat → Nat} {value resident : Value} {state selected next : Initialization}
    (typed : ResidentTyped program state value type) (access : state.Access path selected)
    (residentTyped : ResidentTyped program next resident target)
    (related : before.Corresponds node value) (replacementRelated : replacement.Corresponds node resident) :
    ∃ updated, value.writeIndices path resident = some updated ∧
      ResidentTyped program (state.write path next) updated type ∧ after.Corresponds node updated := by
  obtain ⟨updated, written, typedAfter⟩ := canonical.write typed access residentTyped
  exact ⟨updated, written, typedAfter.1, write.corresponds typed access related replacementRelated written⟩
theorem SourcePayload.Typed.select {program : Program} {loans : List SourceLoan}
    {payload selected : SourcePayload} {source target : Ty} {indices : List Nat}
    (typed : payload.Typed program loans source) (canonical : CanonicalPath program source indices target)
    (selectedAt : payload.select indices = some selected) : selected.Typed program loans target := by
  induction canonical generalizing payload with
  | nil =>
    simp only [SourcePayload.select, Option.some.injEq] at selectedAt
    subst selected
    exact typed
  | cons projection tail ih =>
    cases typed with
    | plain =>
      simp only [SourcePayload.select, Option.some.injEq] at selectedAt
      subst selected
      exact .plain _
    | reference found => cases projection
    | aggregate source shape children =>
      obtain ⟨child, found, childTyped⟩ := children.select (projection.headType shape).2
      simp only [SourcePayload.select, found, Option.bind_some] at selectedAt
      exact ih childTyped selectedAt

end Grounded

/- Section: StorageBase -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

structure StoreTyped (program : Program) (interpretation : Interpretation) (context : Context)
    (environment : Environment) : Prop where
  source : context.WellFormed program
  residents : EnvironmentTyped program environment context.erase
  slots : SlotsCorrespond interpretation environment.store environment.bindings context.bindings
  cells : ∀ binder slot, context.storage (.binder binder) = some slot →
    ∃ value, environment.store (interpretation.binder binder) = some value ∧
      SlotTyped program value slot.toBindingType ∧ slot.Corresponds interpretation value
  binderBound : ∀ binder, context.MentionsBinder binder → interpretation.binder binder < environment.nextRoot
  binderDistinct : ∀ first second, context.MentionsBinder first → context.MentionsBinder second →
    interpretation.binder first = interpretation.binder second → first = second
  nodeOrder : ∀ first second, first < second → second < context.loans.length →
    interpretation.node first < interpretation.node second
  records : ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan →
    environment.loans[interpretation.node node]? =
      some ⟨interpretation.origin loan.target, loan.parent.map interpretation.node, loan.own, loan.mode⟩
  activeCoverage : ∀ (node : Nat) (loan : Loan), environment.loans[node]? = some loan → loan.own = true →
    ∃ sourceNode sourceLoan, context.loans[sourceNode]? = some sourceLoan ∧ interpretation.node sourceNode = node
  sourceTargets : ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan → loan.own = true →
    context.SourceTarget program loan
  storeShape : ∀ root value, environment.store root = some value →
    ∀ path node, value.readIndices path = some (.reference node) → node < environment.loans.length

/-- The masked target theorem consumes global cell correspondence and the canonical
source path. A vacant selected resident is allowed; no successful read is assumed. -/
theorem StoreTyped.targetResident {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {origin : Origin} {referent : Ty}
    (target : context.Target program origin referent) {binder : Nat} (base : origin.base = .binder binder) :
    ∃ state value, environment.at (interpretation.origin origin) = some value ∧
      ResidentTyped program state value referent := by
  obtain ⟨slot, stored, path, state, access⟩ := (by simpa [Context.Target, base] using target)
  obtain ⟨root, found, rootTyped, _⟩ := typed.cells binder slot stored
  obtain ⟨value, selected, resident⟩ := path.resident rootTyped access
  exact ⟨state, value, by simp [Environment.at, Interpretation.origin, base, found, selected], resident⟩

theorem StoreTyped.targetReady {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {origin : Origin} {referent : Ty}
    (target : context.Target program origin referent) (ready : context.Ready origin)
    {binder : Nat} (base : origin.base = .binder binder) :
    ∃ value, environment.readAddress (interpretation.origin origin) = some value ∧ ValueHasType program value referent := by
  obtain ⟨slot, stored, path, _, _⟩ := (by simpa [Context.Target, base] using target)
  simp only [Context.Ready, base] at ready
  obtain ⟨readySlot, state, readyStored, access, complete⟩ := ready
  have same := Option.some.inj (stored.symm.trans readyStored)
  subst readySlot
  obtain ⟨root, found, rootTyped, _⟩ := typed.cells binder slot stored
  obtain ⟨value, selected, resident⟩ := path.resident rootTyped access
  obtain ⟨full, initialized⟩ := resident.complete complete
  exact ⟨value, by simp [Environment.readAddress, Environment.at, Interpretation.origin, base, found, selected, initialized], full⟩

theorem StoreTyped.targetsReady {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) (node : Nat) (loan : SourceLoan)
    (found : context.loans[node]? = some loan) (own : loan.own = true) (ready : context.Ready loan.target) :
    ∃ value, environment.readAddress (interpretation.origin loan.target) = some value ∧ ValueHasType program value loan.referent := by
  cases base : loan.target.base with
  | binder binder => exact typed.targetReady (typed.sourceTargets node loan found own).1 ready base

theorem StoreTyped.targets {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) (node : Nat) (loan : SourceLoan)
    (found : context.loans[node]? = some loan) (own : loan.own = true) (shared : loan.mode = .shared) :
    ∃ value, environment.readAddress (interpretation.origin loan.target) = some value ∧ ValueHasType program value loan.referent :=
  typed.targetsReady node loan found own ((typed.sourceTargets node loan found own).2 shared)

theorem StoreTyped.restored {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {node : Nat} {loan : SourceLoan}
    (found : context.loans[node]? = some loan) (ready : context.Restored node) :
    environment.Restored (interpretation.node node) := by
  intro actual selected own
  have equal := Option.some.inj ((typed.records node loan found).symm.trans selected)
  subst actual
  obtain ⟨value, read, _⟩ := typed.targetsReady node loan found own (ready loan found own)
  exact ⟨value, read⟩

theorem StoreTyped.canonicalTargets {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {node : Nat} {loan : SourceLoan}
    (found : context.loans[node]? = some loan) (own : loan.own = true)
    {binder : Nat} (base : loan.target.base = .binder binder) :
    ∃ slot state value, context.storage (.binder binder) = some slot ∧
      CanonicalPath program slot.type loan.target.fields loan.referent ∧
      slot.initialization.Access loan.target.fields state ∧
      environment.at (interpretation.origin loan.target) = some value ∧ ResidentTyped program state value loan.referent := by
  have target := (typed.sourceTargets node loan found own).1
  simp only [Context.Target, base] at target
  obtain ⟨slot, stored, path, state, access⟩ := target
  obtain ⟨root, rootStored, rootTyped, _⟩ := typed.cells binder slot stored
  obtain ⟨value, selected, resident⟩ := path.resident rootTyped access
  exact ⟨slot, state, value, stored, path, access,
    by simp [Environment.at, Interpretation.origin, base, rootStored, selected], resident⟩





theorem Interpretation.within (interpretation : Interpretation) {child parent : Origin}
    (within : child.Within parent) :
    (interpretation.origin child).root = (interpretation.origin parent).root ∧
      (interpretation.origin parent).fields.IsPrefix (interpretation.origin child).fields := by
  rcases child with ⟨childBase, childFields⟩
  rcases parent with ⟨parentBase, parentFields⟩
  rcases within with ⟨same, initial⟩
  cases same
  cases childBase with
  | binder identity => exact ⟨rfl, initial⟩

namespace StoreTyped

variable {interpretation : Interpretation} {context : Context} {environment : Environment}

/-- Static disjointness reflects through injective canonical roots and the
existing canonical field-disjointness relation. -/
theorem apart (typed : StoreTyped program interpretation context environment)
    {left right : Origin} (leftBound : left.Known context) (rightBound : right.Known context)
    (apart : left.Apart right) : (interpretation.origin left).Apart (interpretation.origin right) := by
  cases left with
  | mk leftBase leftFields =>
    cases right with
    | mk rightBase rightFields =>
      cases leftBase with
      | binder first =>
        cases rightBase with
        | binder second =>
          rcases apart with different | fields
          · exact .inl (fun same => different (typed.binderDistinct _ _ leftBound rightBound same))
          · exact .inr fields

/-- Ancestry permission is derived from source parent records and componentwise
interpretation. No ancestor own bit or ancestor target initialization is used. -/
theorem supported (typed : StoreTyped program interpretation context environment)
    {node : Nat} {loan : SourceLoan} (found : context.loans[node]? = some loan) :
    Environment.Supported environment.loans (interpretation.node node) := by
  induction node using Nat.strongRecOn generalizing loan with
  | ind node ih =>
    cases parent : loan.parent with
    | none => exact .root (typed.records _ _ found) (by simp [parent])
    | some ancestor =>
      obtain ⟨older, parentLoan, parentFound, within⟩ := typed.source.parents _ _ _ found parent
      have translated := interpretation.within within
      exact .child (typed.records _ _ found) (by simp [parent])
        (typed.nodeOrder _ _ older (List.getElem?_eq_some_iff.mp found).1)
        (typed.records _ _ parentFound) translated.1 translated.2 (ih ancestor older parentFound)

theorem usable (typed : StoreTyped program interpretation context environment)
    {node : Nat} (own : context.Own node) : environment.Usable (interpretation.node node) := by
  obtain ⟨loan, found, available⟩ := own
  exact ⟨_, typed.records _ _ found, available, typed.supported found⟩

theorem nodeInjective (typed : StoreTyped program interpretation context environment)
    {first second : Nat} (firstBound : first < context.loans.length) (secondBound : second < context.loans.length)
    (same : interpretation.node first = interpretation.node second) : first = second := by
  rcases Nat.lt_trichotomy first second with less | equal | more
  · exact False.elim ((Nat.ne_of_lt (typed.nodeOrder _ _ less secondBound)) same)
  · exact equal
  · exact False.elim ((Nat.ne_of_lt (typed.nodeOrder _ _ more firstBound)) same.symm)

theorem derived (typed : StoreTyped program interpretation context environment)
    {node ancestor : Nat} (source : context.Derived node ancestor) :
    environment.Derived (interpretation.node node) (interpretation.node ancestor) := by
  induction source with
  | same node => exact .same _
  | child found parent rest ih => exact .child (typed.records _ _ found) (by simp [parent]) ih

theorem permits (typed : StoreTyped program interpretation context environment)
    {mode : BorrowMode} {parent : Option Nat} {origin : Origin}
    (known : origin.Known context) (allowed : context.Permits mode parent origin) :
    environment.Permits mode (parent.map interpretation.node) (interpretation.origin origin) := by
  intro runtimeNode runtimeLoan runtimeFound runtimeOwn
  obtain ⟨node, loan, found, same⟩ := typed.activeCoverage runtimeNode runtimeLoan runtimeFound runtimeOwn
  have record := typed.records node loan found
  rw [same, runtimeFound] at record
  cases Option.some.inj record.symm
  rcases allowed node loan found runtimeOwn with shared | ancestral | apart
  · exact .inl shared
  · obtain ⟨selected, parent, path⟩ := ancestral
    exact .inr (.inl ⟨interpretation.node selected, by simp [parent], by rw [← same]; exact typed.derived path⟩)
  · exact .inr (.inr (typed.apart known (typed.source.loanKnown found) apart))

/-- Owner-mutation permission is a conclusion, not an admission callback. -/
theorem ownerFree (typed : StoreTyped program interpretation context environment)
    {origin : Origin} (bound : origin.Known context) (free : context.Free origin) :
    environment.OwnerFree (interpretation.origin origin) := by
  intro runtimeNode runtimeLoan runtimeFound runtimeOwn
  obtain ⟨node, loan, found, sameNode⟩ := typed.activeCoverage _ _ runtimeFound runtimeOwn
  have record := typed.records node loan found
  rw [sameNode, runtimeFound] at record
  cases Option.some.inj record
  exact typed.apart bound (typed.source.loanKnown found) (free node loan found runtimeOwn)

/-- Every active runtime node has an addressable typed target. Unique targets may
be masked; shared targets are initialized even under ended or hidden ancestors. -/
theorem noDangling (typed : StoreTyped program interpretation context environment)
    {node : Nat} {loan : Loan} (found : environment.loans[node]? = some loan) (own : loan.own = true) :
    ∃ value type state, environment.at loan.target = some value ∧ ResidentTyped program state value type ∧
      FiniteLayout program.target program.data type ∧
      (loan.mode = .shared → environment.readAddress loan.target = some value ∧ ValueHasType program value type) := by
  obtain ⟨sourceNode, sourceLoan, sourceFound, sameNode⟩ := typed.activeCoverage _ _ found own
  have record := typed.records sourceNode sourceLoan sourceFound
  rw [sameNode, found] at record
  cases Option.some.inj record
  by_cases shared : sourceLoan.mode = .shared
  · obtain ⟨value, read, typedValue⟩ := typed.targets _ _ sourceFound own shared
    have raw : environment.at (interpretation.origin sourceLoan.target) = some value := by
      simp only [Environment.readAddress, Bind.bind, Option.bind_eq_some_iff] at read
      obtain ⟨resident, raw, live⟩ := read
      split at live <;> simp_all
    exact ⟨value, sourceLoan.referent, .full, raw, typedValue, (typed.source.targets _ _ sourceFound).2, fun _ => ⟨read, typedValue⟩⟩
  · cases base : sourceLoan.target.base with
    | binder binder =>
      obtain ⟨state, value, raw, resident⟩ := typed.targetResident (typed.sourceTargets _ _ sourceFound own).1 base
      exact ⟨value, sourceLoan.referent, state, raw, resident, (typed.source.targets _ _ sourceFound).2, fun same => False.elim (shared same)⟩
end StoreTyped

theorem SlotsCorrespond.bindings {interpretation : Interpretation} {store : Store}
    {bindings : List (String × Root)} {slots : List (String × Slot)}
    (typed : SlotsCorrespond interpretation store bindings slots) :
    bindings = slots.map (fun binding => (binding.1, interpretation.binder binding.2.binder)) := by
  induction typed with
  | nil => rfl
  | cons identity _ _ ih => simp only [List.map_cons, identity, ih]

theorem Context.reconstruct {context : Context} {environment : Environment} {interpretation : Interpretation}
    (valid : context.WellFormed program) (runtimeValid : environment.Valid)
    (names : environment.bindings = context.names.map (fun entry => (entry.1, interpretation.binder entry.2)))
    (cells : ∀ binder slot, context.storage (.binder binder) = some slot →
      ∃ value, environment.store (interpretation.binder binder) = some value ∧
        SlotTyped program value slot.toBindingType ∧ slot.Corresponds interpretation value) :
    EnvironmentTyped program environment context.erase ∧
      SlotsCorrespond interpretation environment.store environment.bindings context.bindings := by
  let view (entries : List (String × Nat)) := entries.filterMap fun entry =>
    (context.storage (.binder entry.2)).map fun slot => (entry.1, slot)
  have assemble : ∀ entries : List (String × Nat),
      (∀ entry ∈ entries, ∃ slot, context.storage (.binder entry.2) = some slot) →
      ∃ values, StoredBindings environment.store (entries.map fun entry => (entry.1, interpretation.binder entry.2)) values ∧
        ValuesBindingsTyped program values ((view entries).map fun binding => (binding.1, binding.2.toBindingType)) ∧
        SlotsCorrespond interpretation environment.store
          (entries.map fun entry => (entry.1, interpretation.binder entry.2)) (view entries) := by
    intro entries
    induction entries with
    | nil => intro _; exact ⟨[], .nil, .nil, .nil⟩
    | cons entry entries ih =>
      intro present
      obtain ⟨slot, found⟩ := present entry (by simp)
      obtain ⟨value, stored, resident, corresponds⟩ := cells entry.2 slot found
      obtain ⟨values, storedRest, residents, slots⟩ := ih (fun other member => present other (by simp [member]))
      have identity := (valid.allocated entry.2 slot found).1
      simp only [view, List.filterMap_cons, found, Option.map_some, List.map_cons]
      refine ⟨(entry.1, value) :: values, .cons stored storedRest, .cons resident residents, ?_⟩
      exact .cons (congrArg interpretation.binder identity.symm)
        (fun actual read => (Option.some.inj (stored.symm.trans read)) ▸ corresponds) slots
  obtain ⟨values, stored, residents, slots⟩ := assemble context.names valid.named
  refine ⟨⟨runtimeValid, values, ?_, residents⟩, ?_⟩
  · rw [names]; exact stored
  · rw [names]; exact slots
end Grounded

/- Section: StateResults -/
namespace Grounded

structure ResultTyped (program : Program) (interpretation : Interpretation) (context : Context)
    (result : ResultType) (value : Value) : Prop where
  resident : ValueHasType program value result.type
  payload : SourcePayload.Typed program context.loans result.payload result.type
  corresponds : result.payload.Corresponds interpretation.node value

inductive ResultsTyped (program : Program) (interpretation : Interpretation) (context : Context) : List ResultType → List Value → Prop where
  | nil : ResultsTyped program interpretation context [] []
  | cons {result results value values} (head : ResultTyped program interpretation context result value)
      (tail : ResultsTyped program interpretation context results values) :
      ResultsTyped program interpretation context (result :: results) (value :: values)

theorem PayloadsCorrespond.length {node : Nat → Nat} {payloads : List SourcePayload} {values : List Value}
    (related : PayloadsCorrespond node payloads values) : payloads.length = values.length := by
  induction payloads generalizing values with
  | nil => cases related; rfl
  | cons payload payloads ih => cases related with
    | cons head tail => exact congrArg Nat.succ (ih tail)

theorem PayloadsCorrespond.append_inv {node : Nat → Nat} {left right : List SourcePayload} {xs ys : List Value}
    (related : PayloadsCorrespond node (left ++ right) (xs ++ ys)) (length : left.length = xs.length) :
    PayloadsCorrespond node left xs ∧ PayloadsCorrespond node right ys := by
  induction left generalizing xs with
  | nil =>
    have empty : xs = [] := by simpa using length.symm
    subst xs
    exact ⟨.nil, related⟩
  | cons head tail ih =>
    cases xs with
    | nil => simp at length
    | cons value values =>
      cases related with
      | cons first rest =>
        obtain ⟨front, back⟩ := ih rest (Nat.succ.inj length)
        exact ⟨.cons first front, back⟩

theorem payloadNodes_append (left right : List SourcePayload) :
    payloadNodes (left ++ right) = payloadNodes left ++ payloadNodes right := by
  induction left with
  | nil => rfl
  | cons head tail ih => simp only [List.cons_append, payloadNodes, ih, List.append_assoc]

theorem payloadNodes_perm {left right : List SourcePayload} (permuted : left.Perm right) :
    (payloadNodes left).Perm (payloadNodes right) := by
  induction permuted with
  | nil => exact .nil
  | cons head permuted ih => exact List.Perm.append_left _ ih
  | swap first second tail =>
    simpa only [payloadNodes, List.append_assoc] using
      (List.perm_append_comm (l₁ := second.nodes) (l₂ := first.nodes)).append_right (payloadNodes tail)
  | trans first second ih₁ ih₂ => exact ih₁.trans ih₂

theorem SourcePayload.Corresponds.usable {node : Nat → Nat} {payload : SourcePayload} {value : Value}
    (related : payload.Corresponds node value) {environment : Environment}
    (resources : ∀ identity ∈ payload.nodes, environment.Usable (node identity) ∧ environment.Restored (node identity)) :
    environment.ResultUsable value := by
  induction related using SourcePayload.Corresponds.rec
    (motive_2 := fun payloads values _ =>
      (∀ identity ∈ payloadNodes payloads, environment.Usable (node identity) ∧ environment.Restored (node identity)) →
        Environment.ResultsUsable values environment) with
  | plain free => exact .of_plain free
  | reference identity => exact resources identity (by simp [SourcePayload.nodes])
  | @aggregate head fields value source constructor children ih =>
    have usable := ih resources
    subst head
    cases value <;> simp_all [Value.head, Value.children, Head.Source, Environment.ResultUsable, Environment.ResultsUsable]
  | nil => trivial
  | @cons payload payloads value values head tail ihHead ihTail =>
    rename_i available
    exact ⟨ihHead (fun identity member => available identity (by simp [payloadNodes, member])),
      ihTail (fun identity member => available identity (by simp [payloadNodes, member]))⟩

theorem ResultsTyped.corresponds {program : Program} {interpretation : Interpretation} {context : Context}
    {results : List ResultType} {values : List Value}
    (typed : ResultsTyped program interpretation context results values) :
    PayloadsCorrespond interpretation.node (results.map ResultType.payload) values := by
  induction typed with
  | nil => exact .nil
  | cons head tail ih => exact .cons head.corresponds ih

theorem ResultsTyped.length {program : Program} {interpretation : Interpretation} {context : Context}
    {results : List ResultType} {values : List Value}
    (typed : ResultsTyped program interpretation context results values) : values.length = results.length := by
  simpa using typed.corresponds.length.symm

theorem ResultsTyped.residents {program : Program} {interpretation : Interpretation} {context : Context}
    {results : List ResultType} {values : List Value}
    (typed : ResultsTyped program interpretation context results values) :
    ValuesHaveTypes program values (results.map ResultType.type) := by
  induction typed with
  | nil => exact .nil
  | cons head tail ih => exact .cons head.resident ih

theorem ResultsTyped.payloads {program : Program} {interpretation : Interpretation} {context : Context}
    {results : List ResultType} {values : List Value}
    (typed : ResultsTyped program interpretation context results values) :
    PayloadsTyped program context.loans (results.map ResultType.payload) (results.map ResultType.type) := by
  induction typed with
  | nil => exact .nil
  | cons head tail ih => exact .cons head.payload ih

theorem ResultTyped.transportRecords {program : Program} {before after : Context} {first last : Interpretation}
    {result : ResultType} {value : Value} (typed : ResultTyped program first before result value)
    (records : ∀ (node : Nat) (loan : SourceLoan), before.loans[node]? = some loan → ∃ retained : SourceLoan,
      after.loans[node]? = some retained ∧ retained.referent = loan.referent ∧ retained.mode = loan.mode)
    (same : ∀ node, node < before.loans.length → last.node node = first.node node) :
    ResultTyped program last after result value :=
  ⟨typed.resident, typed.payload.transport records,
    typed.corresponds.congr (fun node member => (same node (typed.payload.node_bound member)).symm)⟩

theorem ResultsTyped.transportRecords {program : Program} {before after : Context} {first last : Interpretation}
    {results : List ResultType} {values : List Value} (typed : ResultsTyped program first before results values)
    (records : ∀ (node : Nat) (loan : SourceLoan), before.loans[node]? = some loan → ∃ retained : SourceLoan,
      after.loans[node]? = some retained ∧ retained.referent = loan.referent ∧ retained.mode = loan.mode)
    (same : ∀ node, node < before.loans.length → last.node node = first.node node) :
    ResultsTyped program last after results values := by
  induction typed with
  | nil => exact .nil
  | cons head tail ih => exact .cons (head.transportRecords records same) ih

end Grounded

/- Section: CustodyEffects -/

namespace Grounded

variable {program : Program}

namespace Environment

theorem endOwn_state {before after : Environment} {node : Nat}
    (ended : before.endOwn node = some after) :
    after = { before with loans := before.loans.modify node fun loan => { loan with own := false } } := by
  cases found : before.loans[node]? with
  | none => simp [endOwn, found] at ended
  | some loan => simpa [endOwn, found] using ended.symm

theorem endOwn_active {before after : Environment} {ended node : Nat} {loan : Loan}
    (step : before.endOwn ended = some after) (found : after.loans[node]? = some loan) (own : loan.own = true) :
    before.loans[node]? = some loan ∧ ended ≠ node := by
  rw [endOwn_state step] at found
  change (before.loans.modify ended fun loan => { loan with own := false })[node]? = some loan at found
  rw [List.getElem?_modify] at found
  obtain ⟨original, found, equal⟩ := Option.map_eq_some_iff.mp found
  split at equal
  · cases equal
    cases own
  · cases equal
    exact ⟨found, by assumption⟩

end Environment

theorem Value.replaceChild_frame {value replacement updated : Value} {index other : Nat}
    (written : value.replaceChild index replacement = some updated) (different : other ≠ index) :
    updated.children[other]? = value.children[other]? := by
  cases value with
  | vacant | unit | integer | character | array | reference => simp [Value.replaceChild] at written
  | tuple head tail =>
    cases index with
    | zero =>
      cases Option.some.inj written
      cases other with
      | zero => exact False.elim (different rfl)
      | succ other => rfl
    | succ index =>
      obtain ⟨old, _, same⟩ := Option.map_eq_some_iff.mp written
      cases same
      cases other with
      | zero => rfl
      | succ other =>
        have unequal : other ≠ index := fun equal => different (congrArg Nat.succ equal)
        simp [Value.children, Ne.symm unequal]
  | nominal identity tag fields =>
    obtain ⟨old, _, same⟩ := Option.map_eq_some_iff.mp written
    cases same
    simp [Value.children, Ne.symm different]

theorem Value.writeIndices_frame {value replacement updated : Value} {indices observed : List Nat}
    (written : value.writeIndices indices replacement = some updated) (apart : CoordinatesApart indices observed) :
    updated.readIndices observed = value.readIndices observed := by
  induction apart generalizing value updated with
  | siblings different =>
    simp only [Value.writeIndices, Bind.bind, Option.bind_eq_some_iff] at written
    obtain ⟨child, _, next, _, replaced⟩ := written
    simp only [Value.readIndices, Value.replaceChild_frame replaced (Ne.symm different)]
  | descend apart ih =>
    simp only [Value.writeIndices, Bind.bind, Option.bind_eq_some_iff] at written
    obtain ⟨child, found, next, changed, replaced⟩ := written
    simp only [Value.readIndices, Bind.bind, Value.replaceChild_readback replaced, found, Option.bind_some, ih changed]

theorem Value.replaceChild_notReference {value replacement updated : Value} {index node : Nat}
    (written : value.replaceChild index replacement = some updated) : updated ≠ .reference node := by
  cases value <;> simp only [Value.replaceChild] at written
  all_goals try cases written
  case tuple head tail =>
    cases index with
    | zero => cases written; simp
    | succ index =>
      obtain ⟨_, _, equal⟩ := Option.map_eq_some_iff.mp written
      cases equal; simp
  case nominal identity tag values =>
    obtain ⟨_, _, equal⟩ := Option.map_eq_some_iff.mp written
    cases equal; simp

theorem Value.writeIndices_reference_cases {value replacement updated : Value} {indices observed : List Nat}
    (written : value.writeIndices indices replacement = some updated) {node : Nat}
    (reference : updated.readIndices observed = some (.reference node)) :
    (∃ suffix, observed = indices ++ suffix ∧ replacement.readIndices suffix = some (.reference node)) ∨
      (CoordinatesApart indices observed ∧ value.readIndices observed = some (.reference node)) := by
  induction indices generalizing value updated observed with
  | nil => cases Option.some.inj written; exact .inl ⟨observed, rfl, reference⟩
  | cons index indices ih =>
    obtain ⟨child, found, next, changed, replaced⟩ :=
      (show ∃ child, value.children[index]? = some child ∧ ∃ next,
        child.writeIndices indices replacement = some next ∧ value.replaceChild index next = some updated by
        simpa only [Value.writeIndices, Bind.bind, Option.bind_eq_some_iff] using written)
    cases observed with
    | nil => exact False.elim (Value.replaceChild_notReference replaced (Option.some.inj reference))
    | cons other observed =>
      by_cases equal : other = index
      · subst other
        have selected : next.readIndices observed = some (.reference node) := by
          simpa [Value.readIndices, Value.replaceChild_readback replaced] using reference
        rcases ih changed selected with ⟨suffix, rfl, read⟩ | ⟨apart, read⟩
        · exact .inl ⟨suffix, rfl, read⟩
        · exact .inr ⟨.descend apart, by simpa [Value.readIndices, found] using read⟩
      · have apart : CoordinatesApart (index :: indices) (other :: observed) := .siblings (Ne.symm equal)
        exact .inr ⟨apart, (Value.writeIndices_frame written apart).symm.trans reference⟩

theorem Value.writeIndices_reference_iff {value replacement updated : Value} {indices observed : List Nat}
    (written : value.writeIndices indices replacement = some updated) {node : Nat} :
    updated.readIndices observed = some (.reference node) ↔
    (∃ suffix, observed = indices ++ suffix ∧ replacement.readIndices suffix = some (.reference node)) ∨
      (CoordinatesApart indices observed ∧ value.readIndices observed = some (.reference node)) := by
  constructor
  · exact Value.writeIndices_reference_cases written
  · intro occurrence
    rcases occurrence with ⟨suffix, rfl, read⟩ | ⟨apart, read⟩
    · simpa [Value.readIndices_append, Value.writeIndices_readback written] using read
    · exact (Value.writeIndices_frame written apart).trans read

theorem Environment.writeAddress_readback {address : Address} {replacement : Value} {before after : Environment}
    (written : before.writeAddress address replacement = some after) :
    after.at address = some replacement := by
  simp only [Environment.writeAddress, Bind.bind, Option.bind_eq_some_iff] at written
  obtain ⟨parent, found, updated, changed, same⟩ := written
  cases same
  simp [Environment.at, Environment.put, Value.writeIndices_readback changed]

theorem Value.replaceChild_inverse {value resident replacement updated : Value} {index : Nat}
    (found : value.children[index]? = some resident)
    (written : value.replaceChild index replacement = some updated) :
    updated.replaceChild index resident = some value := by
  cases value with
  | vacant | unit | integer | character | array | reference => simp [Value.replaceChild] at written
  | tuple head tail =>
    cases index with
    | zero =>
      simp only [Value.children, List.getElem?_cons_zero, Option.some.injEq] at found
      cases found
      cases Option.some.inj written
      rfl
    | succ index =>
      change tail[index]? = some resident at found
      have same : .tuple head (tail.set index replacement) = updated := by
        simpa [Value.replaceChild, found] using written
      cases same
      obtain ⟨bound, selected⟩ := List.getElem?_eq_some_iff.mp found
      rw [← selected]
      simp [Value.replaceChild, bound, List.set_set, List.set_getElem_self]
  | nominal identity tag fields =>
    change fields[index]? = some resident at found
    have same : .nominal identity tag (fields.set index replacement) = updated := by
      simpa [Value.replaceChild, found] using written
    cases same
    obtain ⟨bound, selected⟩ := List.getElem?_eq_some_iff.mp found
    rw [← selected]
    simp [Value.replaceChild, bound, List.set_set, List.set_getElem_self]

theorem Value.writeIndices_inverse {value resident replacement updated : Value} {indices : List Nat}
    (read : value.readIndices indices = some resident)
    (written : value.writeIndices indices replacement = some updated) :
    updated.writeIndices indices resident = some value := by
  induction indices generalizing value updated with
  | nil => cases Option.some.inj read; cases Option.some.inj written; rfl
  | cons index indices ih =>
    simp only [Value.writeIndices, Bind.bind, Option.bind_eq_some_iff] at written
    obtain ⟨child, found, next, changed, replaced⟩ := written
    have childRead : child.readIndices indices = some resident := by simpa [Value.readIndices, found] using read
    have childAfter := Value.replaceChild_readback replaced
    have parentRestored := Value.replaceChild_inverse found replaced
    simp [Value.writeIndices, childAfter, ih childRead changed, parentRestored]

theorem Environment.writeAddress_inverse {address : Address} {resident replacement : Value} {before after : Environment}
    (read : before.at address = some resident)
    (written : before.writeAddress address replacement = some after) :
    after.writeAddress address resident = some before := by
  simp only [Environment.writeAddress, Bind.bind, Option.bind_eq_some_iff] at written
  obtain ⟨parent, found, updated, changed, same⟩ := written
  cases same
  have rawRead : parent.readIndices address.fields = some resident := by simpa [Environment.at, found] using read
  have restored := Value.writeIndices_inverse rawRead changed
  have restore : (before.put address.root updated).put address.root parent = before := by
    cases before with
    | mk bindings store nextRoot =>
      simp only [Environment.put]
      congr 1
      funext other
      by_cases equal : other = address.root
      · subst other; simpa only [↓reduceIte] using found.symm
      · simp [equal]
  simpa [Environment.writeAddress, Environment.put, restored] using congrArg some restore

theorem Environment.takeAddress_eq_some {address : Address} {before after : Environment} {value : Value} :
    before.takeAddress address = some (value, after) ↔
      before.readAddress address = some value ∧ before.writeAddress address .vacant = some after := by
  simp [Environment.takeAddress, Bind.bind, Option.bind_eq_some_iff]

theorem Environment.readAddress_at {environment : Environment} {address : Address} {value : Value}
    (read : environment.readAddress address = some value) : environment.at address = some value := by
  simp only [Environment.readAddress, Bind.bind, Option.bind_eq_some_iff] at read
  obtain ⟨actual, found, selected⟩ := read
  split at selected
  · cases Option.some.inj selected; exact found
  · cases selected

theorem Environment.writeAddress_loans {before after : Environment} {address : Address} {value : Value}
    (written : before.writeAddress address value = some after) : after.loans = before.loans := by
  simp only [writeAddress, Bind.bind, Option.bind_eq_some_iff, Option.some.injEq] at written
  obtain ⟨parent, _, updated, _, rfl⟩ := written
  rfl

theorem Custody.borrow {environment : Environment} {held : List Value}
    (custody : Custody environment held)
    (bounded : ∀ node location, Carries environment held node location → node < environment.loans.length)
    (access : Environment.ResolvedAccess) (mode : BorrowMode) :
    Custody (environment.addLoan access mode) (held ++ [.reference environment.loans.length]) := by
  have lift : ∀ node location, Carries environment held node location →
      Carries (environment.addLoan access mode) (held ++ [.reference environment.loans.length]) node location := by
    intro node location carrier
    cases location with
    | stored root fields => exact carrier
    | held index fields => exact carries_held_append_reference.mpr (.inl carrier)
  intro node loan found own
  by_cases older : node < environment.loans.length
  · have old : environment.loans[node]? = some loan :=
      (List.getElem?_append_left older).symm.trans found
    obtain ⟨location, carrier, unique⟩ := custody node loan old own
    refine ⟨location, lift node location carrier, ?_⟩
    intro other carried
    apply unique other
    cases other with
    | stored root fields => exact carried
    | held index fields =>
      rcases carries_held_append_reference.mp carried with old | ⟨_, _, same⟩
      · exact old
      · exact False.elim ((Nat.ne_of_lt older) same.symm)
  · simp only [Environment.addLoan, List.getElem?_append_right (Nat.le_of_not_lt older)] at found
    cases difference : node - environment.loans.length with
    | succ rest => simp [difference] at found
    | zero =>
      have same : node = environment.loans.length := by omega
      subst node
      refine ⟨.held held.length, by simp [Carries], ?_⟩
      intro location carrier
      cases location with
      | stored root fields => exact False.elim (Nat.lt_irrefl _ (bounded _ (.stored root fields) carrier))
      | held index fields =>
        rcases carries_held_append_reference.mp carrier with old | ⟨rfl, rfl, _⟩
        · exact False.elim (Nat.lt_irrefl _ (bounded _ (.held index fields) old))
        · rfl

theorem CoordinatesApart.notPrefix {first second : List Nat} (apart : CoordinatesApart first second) :
    ¬ first.IsPrefix second := by
  induction apart with
  | siblings different =>
    rintro ⟨suffix, equal⟩
    exact different (List.cons.inj equal).1
  | descend apart ih =>
    rintro ⟨suffix, equal⟩
    exact ih ⟨suffix, (List.cons.inj equal).2⟩

theorem Environment.writeAddress_reference_iff {before after : Environment} {address : Address} {replacement : Value}
    (written : before.writeAddress address replacement = some after) {root node : Nat} {fields : List Nat} {held : List Value} :
    Carries after held node (.stored root fields) ↔
      (root = address.root ∧ ∃ suffix, fields = address.fields ++ suffix ∧ replacement.readIndices suffix = some (.reference node)) ∨
      (address.Apart ⟨root, fields⟩ ∧ Carries before held node (.stored root fields)) := by
  simp only [Environment.writeAddress, Bind.bind, Option.bind_eq_some_iff] at written
  obtain ⟨parent, stored, updated, changed, equal⟩ := written
  cases equal
  by_cases same : root = address.root
  · subst root
    simpa [Carries, Environment.put, stored, Address.Apart] using
      (Value.writeIndices_reference_iff (observed := fields) (node := node) changed)
  · simp [Carries, Environment.put, same, Address.Apart, Ne.symm same]

def Carrier.extractAddress (count : Nat) (address : Address) : Carrier → Carrier
  | .stored root fields =>
    if root = address.root ∧ address.fields.IsPrefix fields then .held count (fields.drop address.fields.length)
    else .stored root fields
  | .held index fields => .held index fields

def Carrier.insertAddress (count : Nat) (address : Address) : Carrier → Carrier
  | .stored root fields => .stored root fields
  | .held index fields =>
    if index = count then .stored address.root (address.fields ++ fields) else .held index fields

theorem Carrier.extractAddress_apart {address : Address} {root : Nat} {fields : List Nat}
    (apart : address.Apart ⟨root, fields⟩) (count : Nat) :
    (Carrier.stored root fields).extractAddress count address = .stored root fields := by
  have outside : ¬(root = address.root ∧ address.fields.IsPrefix fields) := by
    rintro ⟨rfl, inside⟩
    rcases apart with ne | apart
    · exact ne rfl
    · exact apart.notPrefix inside
  simp [Carrier.extractAddress, outside]

theorem Custody.extractAddress_iff {before after : Environment} {held : List Value} {address : Address} {resident : Value}
    (read : before.at address = some resident)
    (written : before.writeAddress address .vacant = some after) :
    Custody before held ↔ Custody after (held ++ [resident]) := by
  let forward := Carrier.extractAddress held.length address
  let backward := Carrier.insertAddress held.length address
  have inverseWrite := Environment.writeAddress_inverse read written
  have loanEq := Environment.writeAddress_loans written
  have vacancy : ∀ fields node, Value.vacant.readIndices fields ≠ some (.reference node) :=
    fun fields node => Value.ReferenceFree.noReference (by trivial) fields node
  have lowerStored : ∀ node root fields, Carries after held node (.stored root fields) →
      address.Apart ⟨root, fields⟩ ∧ Carries before held node (.stored root fields) := by
    intro node root fields carried
    rcases (Environment.writeAddress_reference_iff written).mp carried with ⟨_, suffix, _, bad⟩ | framed
    · exact False.elim (vacancy suffix node bad)
    · exact framed
  have lift : ∀ node place, Carries before held node place → Carries after (held ++ [resident]) node (forward place) := by
    intro node place carried
    cases place with
    | stored root fields =>
      rcases (Environment.writeAddress_reference_iff inverseWrite).mp carried with ⟨rfl, suffix, rfl, selected⟩ | ⟨apart, kept⟩
      · have inside : address.fields.IsPrefix (address.fields ++ suffix) := ⟨suffix, rfl⟩
        simp only [forward, Carrier.extractAddress, inside, and_self, ↓reduceIte, List.drop_left]
        exact carries_held_append_value.mpr (.inr ⟨rfl, selected⟩)
      · simpa only [forward, Carrier.extractAddress_apart apart, Carries] using kept
    | held index fields =>
      exact carries_held_append_value.mpr (.inl carried)
  have lower : ∀ node place, Carries after (held ++ [resident]) node place → Carries before held node (backward place) := by
    intro node place carried
    cases place with
    | stored root fields => exact (lowerStored node root fields carried).2
    | held index fields =>
      rcases carries_held_append_value.mp carried with old | ⟨rfl, selected⟩
      · have unequal : index ≠ held.length := Nat.ne_of_lt old.held_bound
        simpa [backward, Carrier.insertAddress, unequal, Carries] using old
      · simp only [backward, Carrier.insertAddress, ↓reduceIte]
        exact (Environment.writeAddress_reference_iff inverseWrite).mpr (.inl ⟨rfl, fields, rfl, selected⟩)
  have leftInv : ∀ node place, Carries before held node place → backward (forward place) = place := by
    intro node place carried
    cases place with
    | stored root fields =>
      by_cases inside : root = address.root ∧ address.fields.IsPrefix fields
      · obtain ⟨rfl, suffix, rfl⟩ := inside
        simp [forward, backward, Carrier.extractAddress, Carrier.insertAddress, List.IsPrefix]
      · simp [forward, backward, Carrier.extractAddress, Carrier.insertAddress, inside]
    | held index fields =>
      simp [forward, backward, Carrier.extractAddress, Carrier.insertAddress, Nat.ne_of_lt carried.held_bound]
  have rightInv : ∀ node place, Carries after (held ++ [resident]) node place → forward (backward place) = place := by
    intro node place carried
    cases place with
    | stored root fields =>
      exact Carrier.extractAddress_apart (lowerStored node root fields carried).1 held.length
    | held index fields =>
      rcases carries_held_append_value.mp carried with old | ⟨rfl, selected⟩
      · simp [forward, backward, Carrier.insertAddress, Carrier.extractAddress, Nat.ne_of_lt old.held_bound]
      · simp [forward, backward, Carrier.insertAddress, Carrier.extractAddress, List.IsPrefix]
  constructor
  · intro custody
    exact custody.transport forward backward (fun _ _ found _ => loanEq ▸ found) lift lower rightInv
  · intro custody
    exact custody.transport backward forward (fun _ _ found _ => loanEq.symm ▸ found) lower lift leftInv

theorem Custody.takeAddress {before after : Environment} {held : List Value} {address : Address} {resident : Value}
    (custody : Custody before held) (taken : before.takeAddress address = some (resident, after)) :
    Custody after (held ++ [resident]) := by
  obtain ⟨read, written⟩ := Environment.takeAddress_eq_some.mp taken
  exact (Custody.extractAddress_iff (Environment.readAddress_at read) written).mp custody

theorem Custody.installAddress {before after : Environment} {held : List Value} {address : Address} {resident : Value}
    (custody : Custody before (held ++ [resident])) (vacant : before.at address = some .vacant)
    (written : before.writeAddress address resident = some after) : Custody after held := by
  exact (Custody.extractAddress_iff (Environment.writeAddress_readback written)
    (Environment.writeAddress_inverse vacant written)).mpr custody

theorem Custody.installSelected {before after : Environment} {held : List Value} {address : Address} {resident old : Value}
    (custody : Custody before (held ++ [resident])) (read : before.at address = some old)
    (inactive : ∀ (node : Nat) (loan : Loan), before.loans[node]? = some loan → loan.own = true →
      ∀ fields, old.readIndices fields ≠ some (.reference node))
    (written : before.writeAddress address resident = some after) : Custody after held := by
  let forward := Carrier.insertAddress held.length address
  let backward := Carrier.extractAddress held.length address
  have inverseWrite := Environment.writeAddress_inverse read written
  have loanEq := Environment.writeAddress_loans written
  intro node loan found own
  have oldFound : before.loans[node]? = some loan := loanEq ▸ found
  obtain ⟨place, carried, unique⟩ := custody node loan oldFound own
  have lift : ∀ place, Carries before (held ++ [resident]) node place → Carries after held node (forward place) := by
    intro place carried
    cases place with
    | stored root fields =>
      rcases (Environment.writeAddress_reference_iff inverseWrite).mp carried with ⟨_, suffix, _, bad⟩ | ⟨apart, kept⟩
      · exact False.elim (inactive node loan oldFound own suffix bad)
      · exact kept
    | held index fields =>
      rcases carries_held_append_value.mp carried with previous | ⟨rfl, selected⟩
      · have unequal : index ≠ held.length := Nat.ne_of_lt previous.held_bound
        simpa [forward, Carrier.insertAddress, unequal, Carries] using previous
      · simp only [forward, Carrier.insertAddress, ↓reduceIte]
        exact (Environment.writeAddress_reference_iff written).mpr (.inl ⟨rfl, fields, rfl, selected⟩)
  have lower : ∀ place, Carries after held node place → Carries before (held ++ [resident]) node (backward place) := by
    intro place carried
    cases place with
    | stored root fields =>
      rcases (Environment.writeAddress_reference_iff written).mp carried with ⟨rfl, suffix, rfl, selected⟩ | ⟨apart, kept⟩
      · have inside : address.fields.IsPrefix (address.fields ++ suffix) := ⟨suffix, rfl⟩
        simp only [backward, Carrier.extractAddress, inside, and_self, ↓reduceIte, List.drop_left]
        exact carries_held_append_value.mpr (.inr ⟨rfl, selected⟩)
      · simpa only [backward, Carrier.extractAddress_apart apart, Carries] using kept
    | held index fields => exact carries_held_append_value.mpr (.inl carried)
  have inverse : ∀ place, Carries after held node place → forward (backward place) = place := by
    intro place carried
    cases place with
    | stored root fields =>
      by_cases inside : root = address.root ∧ address.fields.IsPrefix fields
      · obtain ⟨rfl, suffix, rfl⟩ := inside
        simp [forward, backward, Carrier.extractAddress, Carrier.insertAddress, List.IsPrefix]
      · simp [forward, backward, Carrier.extractAddress, Carrier.insertAddress, inside]
    | held index fields =>
      simp [forward, backward, Carrier.extractAddress, Carrier.insertAddress, Nat.ne_of_lt carried.held_bound]
  refine ⟨forward place, lift place carried, ?_⟩
  intro other carried
  exact (inverse other carried).symm.trans (congrArg forward (unique _ (lower other carried)))

theorem Custody.endOwn {before after : Environment} {held : List Value} {node : Nat}
    (custody : Custody before held) (ended : before.endOwn node = some after) : Custody after held := by
  intro other loan found own
  have old := Environment.endOwn_active ended found own
  obtain ⟨location, carrier, unique⟩ := custody other loan old.1 own
  have stores : after.store = before.store := by rw [Environment.endOwn_state ended]
  have equivalent : ∀ place, Carries after held other place ↔ Carries before held other place := by
    intro place; cases place <;> simp [Carries, stores]
  exact ⟨location, (equivalent _).mpr carrier, fun second carried => unique second ((equivalent _).mp carried)⟩

theorem Custody.retire {environment : Environment} {held : List Value} {count : Nat}
    (custody : Custody environment held)
    (cleared : ∀ root ∈ (environment.bindings.take count).map Prod.snd,
      ∀ node loan, environment.loans[node]? = some loan → loan.own = true →
        ∀ fields, ¬ Carries environment held node (.stored root fields)) : Custody (environment.retire count) held := by
  intro node loan found own
  obtain ⟨location, carrier, unique⟩ := custody node loan found own
  have equivalent : ∀ place, Carries (environment.retire count) held node place ↔ Carries environment held node place := by
    intro place
    cases place with
    | held index => rfl
    | stored root fields =>
      by_cases removed : root ∈ (environment.bindings.take count).map Prod.snd
      · simp only [Carries, Environment.retire, if_pos removed]
        have absent := cleared root removed node loan found own fields
        simpa only [Carries, Bind.bind, Option.bind_none, reduceCtorEq, false_iff] using absent
      · simp only [Carries, Environment.retire, if_neg removed]
  exact ⟨location, (equivalent _).mpr carrier, fun second carried => unique second ((equivalent _).mp carried)⟩

theorem Custody.bindValue {environment : Environment} {held : List Value} {value : Value}
    (custody : Custody environment (held ++ [value])) (valid : environment.Valid) (name : String) :
    Custody (environment.bind name value) held := by
  let forward := Carrier.insertAddress held.length ⟨environment.nextRoot, []⟩
  let backward := Carrier.extractAddress held.length ⟨environment.nextRoot, []⟩
  apply custody.transport (after := environment.bind name value) forward backward (fun _ _ found _ => found)
  · intro node place carried
    cases place with
    | stored root fields =>
      by_cases equal : root = environment.nextRoot
      · simp [Carries, equal, valid.fresh] at carried
      · simpa [forward, Carrier.insertAddress, Carries, Environment.bind, equal] using carried
    | held index fields =>
      rcases carries_held_append_value.mp carried with previous | ⟨rfl, selected⟩
      · have unequal := Nat.ne_of_lt previous.held_bound
        simpa [forward, Carrier.insertAddress, Carries, unequal] using previous
      · simpa [forward, Carrier.insertAddress, Carries, Environment.bind] using selected
  · intro node place carried
    cases place with
    | stored root fields =>
      by_cases equal : root = environment.nextRoot
      · subst root
        have selected : value.readIndices fields = some (.reference node) := by
          simpa [Carries, Environment.bind] using carried
        simpa [backward, Carrier.extractAddress, List.IsPrefix] using
          (carries_held_append_value (environment := environment) (held := held) (value := value)
            (node := node) (index := held.length) (fields := fields)).mpr (.inr ⟨rfl, selected⟩)
      · simpa [backward, Carrier.extractAddress, Carries, Environment.bind, equal] using carried
    | held index fields => exact carries_held_append_value.mpr (.inl carried)
  · intro node place carried
    cases place with
    | stored root fields =>
      by_cases equal : root = environment.nextRoot
      · subst root; simp [forward, backward, Carrier.insertAddress, Carrier.extractAddress, List.IsPrefix]
      · simp [forward, backward, Carrier.insertAddress, Carrier.extractAddress, equal]
    | held index fields =>
      simp [forward, backward, Carrier.insertAddress, Carrier.extractAddress, Nat.ne_of_lt carried.held_bound]

theorem Environment.Disposes.active {before after : Environment} {value : Value}
    (disposed : Environment.Disposes program before value after)
    {node : Nat} {loan : Loan} (found : after.loans[node]? = some loan) (own : loan.own = true) :
    before.loans[node]? = some loan ∧ value ≠ .reference node := by
  induction disposed using Environment.Disposes.rec
    (motive_2 := fun before _ after _ => after.loans[node]? = some loan → before.loans[node]? = some loan) with
  | data plain =>
    refine ⟨found, ?_⟩
    intro equal; rw [equal] at plain; exact plain
  | reference _ ended =>
    have active := Environment.endOwn_active ended found own
    exact ⟨active.1, fun equal => active.2 (Value.reference.inj equal)⟩
  | tuple _ _ ih | array _ _ ih | nominal _ _ ih => exact ⟨ih found, by intro impossible; cases impossible⟩
  | nil => assumption
  | cons _ _ tailIH headIH => rename_i found; exact tailIH (headIH found).1

theorem Environment.Disposes.activeOccurrence {before after : Environment} {value : Value}
    (disposed : Environment.Disposes program before value after)
    {node : Nat} {loan : Loan} (found : after.loans[node]? = some loan) (own : loan.own = true) :
    ∀ fields, value.readIndices fields ≠ some (.reference node) := by
  revert found
  induction disposed using Environment.Disposes.rec
    (motive_2 := fun _ values after _ => after.loans[node]? = some loan →
      ∀ (index : Nat) (child : Value), values[index]? = some child → ∀ (fields : List Nat), child.readIndices fields ≠ some (.reference node)) with
  | data plain _ => intro found fields; exact plain.noReference fields node
  | reference ready ended =>
    intro found fields read
    obtain ⟨_, equal⟩ := Value.readIndices_reference.mp read
    exact (Environment.endOwn_active ended found own).2 equal
  | tuple _ _ ih | array _ _ ih | nominal _ _ ih =>
    intro found fields read
    cases fields with
    | nil => cases read
    | cons index fields =>
      obtain ⟨child, selected, read⟩ := Option.bind_eq_some_iff.mp read
      exact ih found index child selected fields read
  | nil => simp_all
  | cons tail head tailIH headIH =>
    rename_i loanFound index child selected fields
    intro read
    cases index with
    | zero =>
      cases Option.some.inj selected
      exact headIH loanFound fields read
    | succ index =>
      exact tailIH (head.active loanFound own).1 index child selected fields read

theorem Custody.dispose {before after : Environment} {held : List Value} {value : Value}
    (custody : Custody before held) (disposed : Environment.Disposes program before value after) :
    Custody after held := by
  induction disposed using Environment.Disposes.rec
    (motive_2 := fun before _ after _ => Custody before held → Custody after held) with
  | data => exact custody
  | reference _ ended => exact custody.endOwn ended
  | tuple _ _ ih | array _ _ ih | nominal _ _ ih => exact ih custody
  | nil => assumption
  | cons _ _ tailIH headIH => rename_i custody; exact headIH (tailIH custody)

theorem Custody.disposePending {before after : Environment} {held : List Value} {value : Value}
    (custody : Custody before (held ++ [value])) (disposed : Environment.Disposes program before value after) :
    Custody after held := by
  apply (custody.dispose disposed).dropInactive
  intro node loan found own fields
  exact disposed.activeOccurrence found own fields

theorem Custody.disposeFieldsPending {before after : Environment} {held values : List Value}
    (custody : Custody before (held ++ values)) (disposed : Environment.DisposesFields program before values after) :
    Custody after held := by
  induction disposed using Environment.DisposesFields.rec
    (motive_1 := fun _ _ _ _ => True) generalizing held with
  | data | reference | tuple | array | nominal => trivial
  | nil => simpa using custody
  | @cons before middle after value values tail head ih _ =>
    have pending : Custody before ((held ++ [value]) ++ values) := by simpa [List.append_assoc] using custody
    exact (ih pending).disposePending head

theorem Custody.assignAddress {before disposed after : Environment} {held : List Value} {address : Address} {resident old : Value}
    (custody : Custody before (held ++ [resident])) (read : before.at address = some old)
    (disposal : Environment.Disposes program before old disposed)
    (written : disposed.writeAddress address resident = some after) : Custody after held := by
  apply (custody.dispose disposal).installSelected (old := old) _ _ written
  · simpa [Environment.at, disposal.storage.store] using read
  · intro node loan found own fields
    exact disposal.activeOccurrence found own fields

theorem DisposesRoots.active {before after : Environment} {roots : List Root}
    {trace : List (Root × List Nat)} (disposed : DisposesRoots program before roots trace after)
    {node : Nat} {loan : Loan} (found : after.loans[node]? = some loan) (own : loan.own = true) :
    before.loans[node]? = some loan ∧
      ∀ root ∈ roots, after.store root ≠ some (.reference node) := by
  induction disposed with
  | nil => exact ⟨found, by simp⟩
  | @cons before middle after root roots value trace stored free head tail ih =>
    have rest := ih found
    have first := head.active rest.1 own
    refine ⟨first.1, ?_⟩
    intro cell member
    rcases List.mem_cons.mp member with rfl | member
    · rw [tail.storage.store, head.storage.store, stored]
      exact fun equal => first.2 (Option.some.inj equal)
    · exact rest.2 cell member

theorem DisposesRoots.activeOccurrences {before after : Environment} {roots : List Root}
    {trace : List (Root × List Nat)} (disposed : DisposesRoots program before roots trace after)
    {node : Nat} {loan : Loan} (found : after.loans[node]? = some loan) (own : loan.own = true) :
    ∀ root ∈ roots, ∀ fields held, ¬ Carries after held node (.stored root fields) := by
  induction disposed with
  | nil => simp
  | @cons before middle after root roots value trace stored free head tail ih =>
    have rest := tail.active found own
    intro cell member fields held carried
    rcases List.mem_cons.mp member with rfl | member
    · have read : value.readIndices fields = some (.reference node) := by
        simpa [Carries, tail.storage.store, head.storage.store, stored] using carried
      exact head.activeOccurrence rest.1 own fields read
    · exact ih found cell member fields held carried

theorem Custody.disposesRoots {before after : Environment} {held : List Value} {roots : List Root}
    {trace : List (Root × List Nat)} (custody : Custody before held)
    (disposed : DisposesRoots program before roots trace after) : Custody after held := by
  induction disposed with
  | nil => exact custody
  | cons stored free head tail ih => exact ih (custody.dispose head)

theorem Custody.cleans {before after : Environment} {held : List Value} {count : Nat}
    {trace : List (Root × List Nat)} (custody : Custody before held)
    (cleaned : Cleans program count before trace after) : Custody after held := by
  cases cleaned with
  | retire disposed =>
    apply (custody.disposesRoots disposed).retire
    intro root member node loan found own fields
    exact disposed.activeOccurrences found own root
      (by simpa only [disposed.storage.bindings] using member) fields held

theorem Custody.writeAddress {before after : Environment} {held : List Value} {address : Address}
    {replacement selected : Value} (custody : Custody before held)
    (read : before.at address = some selected) (oldPlain : selected.ReferenceFree)
    (plain : replacement.ReferenceFree) (written : before.writeAddress address replacement = some after) :
    Custody after held := by
  have inverse := Environment.writeAddress_inverse read written
  intro node loan found own
  have previous : before.loans[node]? = some loan := Environment.writeAddress_loans written ▸ found
  obtain ⟨place, carried, unique⟩ := custody node loan previous own
  have same : ∀ place, Carries after held node place ↔ Carries before held node place := by
    intro place
    cases place with
    | held index fields => rfl
    | stored root fields =>
      constructor
      · intro carried
        rcases (Environment.writeAddress_reference_iff written).mp carried with ⟨_, suffix, _, bad⟩ | ⟨_, kept⟩
        · exact False.elim (plain.noReference suffix node bad)
        · exact kept
      · intro carried
        rcases (Environment.writeAddress_reference_iff inverse).mp carried with ⟨_, suffix, _, bad⟩ | ⟨_, kept⟩
        · exact False.elim (oldPlain.noReference suffix node bad)
        · exact kept
  exact ⟨place, (same _).mpr carried, fun other c => unique _ ((same _).mp c)⟩

end Grounded

/- Section: State -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

structure StateTyped (program : Program) (interpretation : Interpretation) (context : Context)
    (heldPayloads : List SourcePayload) (environment : Environment) (held : List Value) : Prop
    extends StoreTyped program interpretation context environment where
  heldShape : PayloadsCorrespond interpretation.node heldPayloads held
  heldOwn : ∀ node ∈ payloadNodes heldPayloads, context.Own node
  heldReady : ∀ node ∈ payloadNodes heldPayloads, context.Restored node
  observedOwn : context.ObservedOwn program
  custody : Custody environment held

theorem ResultTyped.usable {interpretation : Interpretation} {context : Context}
    {environment : Environment} {value : Value} {result : ResultType}
    (typed : ResultTyped program interpretation context result value)
    (store : StoreTyped program interpretation context environment)
    (own : ∀ node ∈ result.payload.nodes, context.Own node)
    (ready : ∀ node ∈ result.payload.nodes, context.Restored node) : environment.ResultUsable value := by
  apply typed.corresponds.usable
  intro node member
  obtain ⟨loan, found, _⟩ := own node member
  exact ⟨store.usable (own node member), store.restored found (ready node member)⟩

theorem ResultsTyped.usable {interpretation : Interpretation} {context : Context}
    {environment : Environment} {values : List Value} {results : List ResultType}
    (typed : ResultsTyped program interpretation context results values)
    (store : StoreTyped program interpretation context environment)
    (own : ∀ node ∈ payloadNodes (results.map ResultType.payload), context.Own node)
    (ready : ∀ node ∈ payloadNodes (results.map ResultType.payload), context.Restored node) :
    Environment.ResultsUsable values environment := by
  induction typed with
  | nil => trivial
  | cons head tail ih =>
    exact ⟨head.usable store (fun node member => own node (by simp [payloadNodes, member]))
      (fun node member => ready node (by simp [payloadNodes, member])),
      ih (fun node member => own node (by simp [payloadNodes, member]))
        (fun node member => ready node (by simp [payloadNodes, member]))⟩

namespace StateTyped
variable {interpretation : Interpretation} {context : Context} {heldPayloads : List SourcePayload}
variable {environment : Environment} {held : List Value}

theorem carrierBound (typed : StateTyped program interpretation context heldPayloads environment held)
    {node : Nat} {location : Carrier} (carrier : Carries environment held node location) :
    node < environment.loans.length := by
  cases location with
  | stored root path =>
    obtain ⟨value, found, selected⟩ := Option.bind_eq_some_iff.mp carrier
    exact typed.storeShape root value found path node selected
  | held index path =>
    obtain ⟨value, found, selected⟩ := Option.bind_eq_some_iff.mp carrier
    obtain ⟨payload, sourceFound, related⟩ := (typed.heldShape.select index).2 value found
    obtain ⟨identity, occurrence, same⟩ := related.readIndices_reference_iff.mp selected
    have member : identity ∈ payloadNodes heldPayloads :=
      payloadNodes_mem.mpr ⟨payload, List.mem_of_getElem? sourceFound, SourcePayload.mem_nodes_iff.mpr ⟨path, occurrence⟩⟩
    obtain ⟨loan, loanFound, _⟩ := typed.heldOwn identity member
    rw [same]
    exact (List.getElem?_eq_some_iff.mp (typed.records identity loan loanFound)).1

theorem heldUsable (typed : StateTyped program interpretation context heldPayloads environment held)
    {index : Nat} {value : Value} (found : held[index]? = some value) : environment.ResultUsable value := by
  obtain ⟨payload, selected, related⟩ := (typed.heldShape.select index).2 value found
  apply related.usable
  intro node included
  have member := payloadNodes_mem.mpr ⟨payload, List.mem_of_getElem? selected, included⟩
  obtain ⟨loan, recorded, _⟩ := typed.heldOwn node member
  exact ⟨typed.toStoreTyped.usable (typed.heldOwn node member), typed.toStoreTyped.restored recorded (typed.heldReady node member)⟩

theorem permPending (typed : StateTyped program interpretation context heldPayloads environment held)
    {pendingPayloads : List SourcePayload} {pending : List Value}
    (source : heldPayloads.Perm pendingPayloads) (actual : held.Perm pending)
    (corresponds : PayloadsCorrespond interpretation.node pendingPayloads pending) :
    StateTyped program interpretation context pendingPayloads environment pending :=
  { typed.toStoreTyped with
    heldShape := corresponds
    heldOwn := fun node member => typed.heldOwn node ((payloadNodes_perm source).mem_iff.mpr member)
    heldReady := fun node member => typed.heldReady node ((payloadNodes_perm source).mem_iff.mpr member)
    observedOwn := typed.observedOwn
    custody := typed.custody.permPending actual }

theorem pack {fields : List SourcePayload} {value : Value} {head : Head}
    (typed : StateTyped program interpretation context (heldPayloads ++ fields) environment (held ++ value.children))
    (corresponds : (SourcePayload.aggregate head fields).Corresponds interpretation.node value) :
    StateTyped program interpretation context (heldPayloads ++ [.aggregate head fields]) environment (held ++ [value]) := by
  cases corresponds with
  | aggregate source constructor children =>
    have length : heldPayloads.length = held.length := by
      have total := typed.heldShape.length
      have tail := children.length
      simp only [List.length_append] at total
      omega
    obtain ⟨front, _⟩ := typed.heldShape.append_inv length
    refine { typed.toStoreTyped with
      heldShape := front.append (.cons (.aggregate source constructor children) .nil)
      heldOwn := ?_
      heldReady := ?_
      observedOwn := typed.observedOwn
      custody := typed.custody.pack (constructor ▸ source) }
    · simpa only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.append_nil] using typed.heldOwn
    · simpa only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.append_nil] using typed.heldReady

theorem unpack {fields : List SourcePayload} {value : Value} {head : Head}
    (typed : StateTyped program interpretation context (heldPayloads ++ [.aggregate head fields]) environment (held ++ [value])) :
    StateTyped program interpretation context (heldPayloads ++ fields) environment (held ++ value.children) := by
  have length : heldPayloads.length = held.length := by
    have total := typed.heldShape.length
    simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using total
  obtain ⟨front, tail⟩ := typed.heldShape.append_inv length
  cases tail with
  | cons related rest =>
    cases related with
    | aggregate source constructor children =>
      refine { typed.toStoreTyped with
        heldShape := front.append children
        heldOwn := ?_
        heldReady := ?_
        observedOwn := typed.observedOwn
        custody := typed.custody.unpack (constructor ▸ source) }
      · simpa only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.append_nil] using typed.heldOwn
      · simpa only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.append_nil] using typed.heldReady

theorem appendPlain (typed : StateTyped program interpretation context heldPayloads environment held)
    {value : Value} (free : value.ReferenceFree) :
    StateTyped program interpretation context (heldPayloads ++ [.plain]) environment (held ++ [value]) :=
  { typed.toStoreTyped with
    heldShape := typed.heldShape.append (.cons (.plain free) .nil)
    heldOwn := by simpa only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.nil_append, List.append_nil] using typed.heldOwn
    heldReady := by simpa only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.nil_append, List.append_nil] using typed.heldReady
    observedOwn := typed.observedOwn
    custody := typed.custody.appendInactive (fun node _ _ _ path => free.noReference path node) }

theorem dropPlain {value : Value}
    (typed : StateTyped program interpretation context (heldPayloads ++ [.plain]) environment (held ++ [value])) :
    StateTyped program interpretation context heldPayloads environment held := by
  have length : heldPayloads.length = held.length := by
    have total := typed.heldShape.length
    simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using total
  obtain ⟨front, tail⟩ := typed.heldShape.append_inv length
  cases tail with
  | cons related rest =>
    cases related with
    | plain free =>
      exact { typed.toStoreTyped with
        heldShape := front
        heldOwn := by simpa only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.nil_append, List.append_nil] using typed.heldOwn
        heldReady := by simpa only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.nil_append, List.append_nil] using typed.heldReady
        observedOwn := typed.observedOwn
        custody := typed.custody.dropInactive (fun node _ _ _ path => free.noReference path node) }

end StateTyped
end Grounded

/- Section: SourceContext -/

namespace Grounded
variable {program : Program}

namespace Context
@[simp] theorem dispose_loans_length (context : Context) (payload : SourcePayload) :
    (context.dispose payload).loans.length = context.loans.length := by
  apply dispose_induction (P := fun current => current.loans.length = context.loans.length) rfl _ payload
  intro current node same
  simpa only [Context.endOwn, List.length_modify] using same
end Context

/-- The actual context producer assigns fresh identities when carriers are introduced. -/
def Context.prepare (parameters : List (String × BindingType)) (arguments : List ResultType) (context : Context) : Context :=
  (parameters.zip arguments).foldl (fun current entry => current.bind entry.1.1 entry.1.2.mutable entry.2) context

def Context.resume (caller after : Context) : Context := { after with names := caller.names }

inductive SourcePayload.Joins : SourcePayload → SourcePayload → Prop where
  | same (payload : SourcePayload) : Joins payload payload
  | plain {before : SourcePayload} (empty : before.nodes = []) : Joins before .plain

theorem SourcePayload.Joins.nodes {before after : SourcePayload} (joined : before.Joins after) :
    after.nodes = before.nodes := by
  cases joined with
  | same => rfl
  | plain empty => exact empty.symm

theorem SourcePayload.Joins.typed {before after : SourcePayload} (joined : before.Joins after)
    {loans : List SourceLoan} {type : Ty} (typed : SourcePayload.Typed program loans before type) :
    SourcePayload.Typed program loans after type := by
  cases joined with
  | same => exact typed
  | plain => exact .plain type


inductive SlotsJoin (program : Program) : List (String × Slot) → List (String × Slot) → Prop where
  | nil : SlotsJoin program [] []
  | cons {name : String} {type : Ty} {mutable : Bool} {before after : Initialization}
      {binder : Nat} {beforePayload afterPayload : SourcePayload} {slots joined : List (String × Slot)}
      (head : Initialization.Joins program.data type before after)
      (payloadJoins : beforePayload.Joins afterPayload) (tail : SlotsJoin program slots joined) :
      SlotsJoin program ((name, ⟨⟨type, mutable, before⟩, binder, beforePayload⟩) :: slots)
        ((name, ⟨⟨type, mutable, after⟩, binder, afterPayload⟩) :: joined)

/-- Initialization may weaken, but payload abstraction may erase only empty
reference-free constructor shells, preserving the complete ordered node list. -/
inductive CellJoin (program : Program) : Option Slot → Option Slot → Prop where
  | absent : CellJoin program none none
  | resident {type : Ty} {mutable : Bool} {before after : Initialization}
      {binder : Nat} {beforePayload afterPayload : SourcePayload}
      (state : Initialization.Joins program.data type before after)
      (payloadJoins : beforePayload.Joins afterPayload) :
      CellJoin program (some ⟨⟨type, mutable, before⟩, binder, beforePayload⟩)
        (some ⟨⟨type, mutable, after⟩, binder, afterPayload⟩)

theorem CellJoin.forward {before after : Option Slot} (joined : CellJoin program before after)
    {slot : Slot} (found : before = some slot) :
    ∃ current, after = some current ∧ current.metadata = slot.metadata ∧
      Initialization.Joins program.data slot.type slot.initialization current.initialization := by
  cases joined with
  | absent => cases found
  | resident state _ => cases found; exact ⟨_, rfl, rfl, state⟩

theorem CellJoin.backward {before after : Option Slot} (joined : CellJoin program before after)
    {slot : Slot} (found : after = some slot) :
    ∃ original, before = some original ∧ slot.metadata = original.metadata ∧
      Initialization.Joins program.data original.type original.initialization slot.initialization := by
  cases joined with
  | absent => cases found
  | resident state _ => cases found; exact ⟨_, rfl, rfl, state⟩

theorem CellJoin.payloadJoins {before after : Option Slot} (joined : CellJoin program before after)
    {original current : Slot} (first : before = some original) (last : after = some current) :
    original.payload.Joins current.payload := by
  cases joined with
  | absent => cases first
  | resident _ payloadJoins => cases first; cases last; exact payloadJoins

/-- Branch joins preserve exact loan history, origins and ordered handle identities;
initialization, empty payload shells and fresh-ID supply may weaken. -/
structure Context.Joins (program : Program) (before after : Context) : Prop where
  names : after.names = before.names
  storage : ∀ origin, CellJoin program (before.storage origin) (after.storage origin)
  loans : after.loans = before.loans
  supply : before.nextBinder ≤ after.nextBinder
  targetMasks : ∀ (node : Nat) (loan : SourceLoan), before.loans[node]? = some loan → loan.own = true →
    ∀ (binder : Nat) (old current : Slot) (state : Initialization), loan.target.base = .binder binder →
      before.storage (.binder binder) = some old → after.storage (.binder binder) = some current →
      old.initialization.Access loan.target.fields state →
      ∃ next, current.initialization.Access loan.target.fields next ∧ (state.Complete → next.Complete)

theorem Context.Joins.slots {before after : Context} (joined : Context.Joins program before after) :
    SlotsJoin program before.bindings after.bindings := by
  unfold Context.bindings
  rw [joined.names]
  have view (names : List (String × Nat)) :
      SlotsJoin program
        (names.filterMap fun entry => (before.storage (.binder entry.2)).map fun slot => (entry.1, slot))
        (names.filterMap fun entry => (after.storage (.binder entry.2)).map fun slot => (entry.1, slot)) := by
    induction names with
    | nil => exact .nil
    | cons entry names ih =>
        simp only [List.filterMap_cons]
        have cells := joined.storage (.binder entry.2)
        generalize before.storage (.binder entry.2) = old at cells ⊢
        generalize after.storage (.binder entry.2) = current at cells ⊢
        cases cells with
        | absent => exact ih
        | resident state payloadJoins => exact SlotsJoin.cons state payloadJoins ih
  exact view before.names

namespace Context

theorem WellFormed.bind {context : Context} (valid : context.WellFormed program)
    (name : String) (mutable : Bool) (result : ResultType)
    (supported : StorageType program.target program.data result.type)
    (reference : SourcePayload.Typed program context.loans result.payload result.type) :
    (context.bind name mutable result).WellFormed program := by
  refine ⟨?_, ?_, ?_, ?_, valid.parents, ?_, ?_, valid.parentModes⟩
  · rw [valid.bindings_bind name mutable result, List.map_cons, List.nodup_cons]
    refine ⟨?_, valid.distinct⟩
    intro member
    obtain ⟨binding, member, same⟩ := List.mem_map.mp member
    have bound := (valid.slots binding member).1
    change binding.2.binder = context.nextBinder at same
    omega
  · intro binding member
    rw [valid.bindings_bind name mutable result] at member
    rcases List.mem_cons.mp member with rfl | member
    · exact supported
    · exact valid.supported binding member
  · intro binding member
    rw [valid.bindings_bind name mutable result] at member
    rcases List.mem_cons.mp member with rfl | member
    · exact ⟨Nat.lt_succ_self _, reference⟩
    · obtain ⟨bound, references⟩ := valid.slots binding member
      exact ⟨Nat.lt_succ_of_lt bound, references⟩
  · intro node loan found
    obtain ⟨bound, finite⟩ := valid.targets node loan found
    refine ⟨?_, finite⟩
    cases base : loan.target.base <;> simp_all [Origin.Bounded, Context.bind]
    omega
  · intro entry member
    rcases List.mem_cons.mp member with rfl | member
    · exact ⟨⟨⟨result.type, mutable, .full⟩, context.nextBinder, result.payload⟩, by simp [Context.bind]⟩
    · obtain ⟨slot, found⟩ := valid.named entry member
      have different := Nat.ne_of_lt (valid.allocated entry.2 slot found).2.1
      exact ⟨slot, by simpa [Context.bind, different] using found⟩
  · intro binder slot stored
    simp only [Context.bind] at stored
    split at stored
    · rename_i same
      have identity := OriginBase.binder.inj same
      cases stored
      exact ⟨identity.symm, identity ▸ Nat.lt_succ_self _, supported, reference⟩
    · obtain ⟨identity, bound, supported, reference⟩ := valid.allocated binder slot stored
      exact ⟨identity, Nat.lt_succ_of_lt bound, supported, reference⟩

theorem WellFormed.hide {context : Context} (valid : context.WellFormed program) :
    context.hide.WellFormed program := by
  exact ⟨by simp [Context.hide, Context.bindings], by simp [Context.hide, Context.bindings],
    by simp [Context.hide, Context.bindings], valid.targets, valid.parents,
    by simp [Context.hide], valid.allocated, valid.parentModes⟩

theorem WellFormed.retire_retained {context : Context} (valid : context.WellFormed program)
    (count : Nat) {binder : Nat} (member : binder ∈ (context.names.drop count).map Prod.snd) :
    (context.retire count).storage (.binder binder) = context.storage (.binder binder) := by
  have distinct : ((context.names.map Prod.snd).take count ++ (context.names.map Prod.snd).drop count).Nodup := by
    simpa [← valid.bindings_binders] using valid.distinct
  have disjoint := (List.nodup_append.mp distinct).2.2
  have absent : binder ∉ (context.names.take count).map Prod.snd := by
    intro included
    exact disjoint _ (by simpa only [List.map_take] using included) _
      (by simpa only [List.map_drop] using member) rfl
  simp only [Context.retire, if_neg absent]

private theorem filterMap_drop_of_some {α β : Type} (entries : List α) (f : α → Option β)
    (total : ∀ entry ∈ entries, ∃ value, f entry = some value) (count : Nat) :
    (entries.drop count).filterMap f = (entries.filterMap f).drop count := by
  induction count generalizing entries with
  | zero => rfl
  | succ count ih =>
      cases entries with
      | nil => rfl
      | cons entry entries =>
          obtain ⟨value, found⟩ := total entry (by simp)
          simpa [List.filterMap_cons, found] using
            ih entries (fun other member => total other (by simp [member]))

theorem WellFormed.bindings_retire {context : Context} (valid : context.WellFormed program)
    (count : Nat) : (context.retire count).bindings = context.bindings.drop count := by
  unfold Context.bindings
  change (context.names.drop count).filterMap _ = _
  calc
    _ = (context.names.drop count).filterMap (fun entry =>
        (context.storage (.binder entry.2)).map fun slot => (entry.1, slot)) := by
      apply filterMap_congr_mem
      intro entry member
      rw [valid.retire_retained count (List.mem_map.mpr ⟨entry, member, rfl⟩)]
    _ = _ := filterMap_drop_of_some context.names _ (by
      intro entry member
      obtain ⟨slot, found⟩ := valid.named entry member
      exact ⟨(entry.1, slot), by simp [found]⟩) count

theorem WellFormed.retire {context : Context} (valid : context.WellFormed program) (count : Nat) :
    (context.retire count).WellFormed program := by
  refine ⟨?_, ?_, ?_, valid.targets, valid.parents, ?_, ?_, valid.parentModes⟩
  · rw [valid.bindings_retire count, List.map_drop]
    exact valid.distinct.drop
  · intro binding member
    rw [valid.bindings_retire count] at member
    exact valid.supported binding (List.mem_of_mem_drop member)
  · intro binding member
    rw [valid.bindings_retire count] at member
    exact valid.slots binding (List.mem_of_mem_drop member)
  · intro entry member
    obtain ⟨slot, found⟩ := valid.named entry (List.mem_of_mem_drop member)
    exact ⟨slot, (valid.retire_retained count (List.mem_map.mpr ⟨entry, member, rfl⟩)).trans found⟩
  · intro binder slot stored
    simp only [Context.retire] at stored
    split at stored
    · cases stored
    · exact valid.allocated binder slot stored

theorem WellFormed.dispose {context : Context} (valid : context.WellFormed program) (reference : SourcePayload) :
    (context.dispose reference).WellFormed program := by
  exact dispose_induction valid (fun _ node formed => formed.endOwn node) reference

theorem WellFormed.disposeSlots {context : Context} (valid : context.WellFormed program)
    (slots : List (String × Slot)) : (context.disposeSlots slots).WellFormed program := by
  induction slots generalizing context with
  | nil => exact valid
  | cons slot slots ih => exact ih (valid.dispose slot.2.payload)

theorem WellFormed.cleanup {context : Context} (valid : context.WellFormed program) (count : Nat) :
    (context.cleanup count).WellFormed program :=
  (valid.disposeSlots (context.bindings.take count)).retire count

@[simp] theorem disposeSlots_bindings (context : Context) (slots : List (String × Slot)) :
    (context.disposeSlots slots).bindings = context.bindings := by
  induction slots generalizing context with
  | nil => rfl
  | cons slot slots ih =>
    change ((context.dispose slot.2.payload).disposeSlots slots).bindings = _
    rw [ih]
    simp

@[simp] theorem disposeSlots_supply (context : Context) (slots : List (String × Slot)) :
    (context.disposeSlots slots).nextBinder = context.nextBinder := by
  induction slots generalizing context with
  | nil => rfl
  | cons slot slots ih =>
    change ((context.dispose slot.2.payload).disposeSlots slots).nextBinder = _
    rw [ih]
    simp


theorem WellFormed.prepare {context : Context} (valid : context.WellFormed program)
    (parameters : List (String × BindingType)) (arguments : List ResultType)
    (supported : ∀ result ∈ arguments, StorageType program.target program.data result.type)
    (reference : ∀ result ∈ arguments, SourcePayload.Typed program context.loans result.payload result.type) :
    (Context.prepare parameters arguments context).WellFormed program := by
  induction parameters generalizing arguments context with
  | nil => exact valid
  | cons parameter parameters ih =>
    cases arguments with
    | nil => exact valid
    | cons argument arguments =>
      exact ih (valid.bind parameter.1 parameter.2.mutable argument
        (supported argument (by simp)) (reference argument (by simp))) arguments
        (fun result member => supported result (by simp [member]))
        (fun result member => reference result (by simp [member]))

end Context


/-- Static record retention, not an operational progress premise. -/
structure Context.History (before after : Context) : Prop where
  records : ∀ (node : Nat) (loan : SourceLoan), before.loans[node]? = some loan → ∃ retained : SourceLoan,
    after.loans[node]? = some retained ∧ retained.target = loan.target ∧
    retained.referent = loan.referent ∧ retained.parent = loan.parent ∧ retained.mode = loan.mode ∧
    (retained.own = true → loan.own = true)
  supply : before.nextBinder ≤ after.nextBinder
  visible : ∀ binder ∈ after.names.map Prod.snd, binder < before.nextBinder →
    binder ∈ before.names.map Prod.snd
  retained : ∀ binder slot, binder < before.nextBinder → before.storage (.binder binder) = some slot →
    binder ∉ before.names.map Prod.snd → ∃ current, after.storage (.binder binder) = some current ∧
      current.metadata = slot.metadata

namespace Context
namespace History

theorem refl (context : Context) : History context context :=
  ⟨fun _ loan found => ⟨loan, found, rfl, rfl, rfl, rfl, id⟩, Nat.le_refl _,
    fun _ member _ => member, fun _ slot _ found _ => ⟨slot, found, rfl⟩⟩

theorem trans {before middle after : Context} (first : History before middle)
    (second : History middle after) : History before after := by
  refine ⟨?_, Nat.le_trans first.supply second.supply, ?_, ?_⟩
  · intro node loan found
    obtain ⟨middleLoan, middleFound, target, referent, parent, mode, own⟩ := first.records node loan found
    obtain ⟨lastLoan, lastFound, lastTarget, lastReferent, lastParent, lastMode, lastOwn⟩ := second.records node middleLoan middleFound
    exact ⟨lastLoan, lastFound, lastTarget.trans target, lastReferent.trans referent,
      lastParent.trans parent, lastMode.trans mode, fun live => own (lastOwn live)⟩
  · intro binder member old
    exact first.visible binder (second.visible binder member (Nat.lt_of_lt_of_le old first.supply)) old
  · intro binder slot old stored hidden
    obtain ⟨middleSlot, middleStored, middleMetadata⟩ := first.retained binder slot old stored hidden
    have middleHidden : binder ∉ middle.names.map Prod.snd := fun member => hidden (first.visible binder member old)
    obtain ⟨afterSlot, afterStored, afterMetadata⟩ := second.retained binder middleSlot
      (Nat.lt_of_lt_of_le old first.supply) middleStored middleHidden
    exact ⟨afterSlot, afterStored, afterMetadata.trans middleMetadata⟩

theorem endOwn (context : Context) (node : Nat) : History context (context.endOwn node) := by
  refine ⟨?_, Nat.le_refl _, fun _ member _ => member, fun _ slot _ found _ => ⟨slot, found, rfl⟩⟩
  intro old loan found
  refine ⟨_, context.endOwn_found node found, rfl, rfl, rfl, rfl, ?_⟩
  split <;> simp_all

theorem dispose (context : Context) (reference : SourcePayload) : History context (context.dispose reference) := by
  exact dispose_induction (refl context) (fun current node history => history.trans (endOwn current node)) reference

theorem disposeSlots (context : Context) (slots : List (String × Slot)) :
    History context (context.disposeSlots slots) := by
  induction slots generalizing context with
  | nil => exact refl context
  | cons slot slots ih => exact (dispose context slot.2.payload).trans (ih _)

theorem bind (context : Context) (name : String) (mutable : Bool) (result : ResultType) :
    History context (context.bind name mutable result) := by
  refine ⟨fun _ loan found => ⟨loan, found, rfl, rfl, rfl, rfl, id⟩, Nat.le_succ _, ?_, ?_⟩
  · intro binder member old
    rcases List.mem_cons.mp member with same | member
    · exact False.elim (Nat.ne_of_lt old same)
    · exact member
  · intro binder slot old stored _
    exact ⟨slot, by simpa [Context.bind, Nat.ne_of_lt old] using stored, rfl⟩

theorem hide (context : Context) : History context context.hide :=
  ⟨fun _ loan found => ⟨loan, found, rfl, rfl, rfl, rfl, id⟩, Nat.le_refl _,
    by simp [Context.hide], fun _ slot _ found _ => ⟨slot, found, rfl⟩⟩

theorem retire (context : Context) (count : Nat) : History context (context.retire count) := by
  refine ⟨fun _ loan found => ⟨loan, found, rfl, rfl, rfl, rfl, id⟩, Nat.le_refl _, ?_, ?_⟩
  · intro binder member _
    exact List.mem_of_mem_drop (by simpa [Context.retire, List.map_drop] using member)
  · intro binder slot _ stored hidden
    have absent : binder ∉ (context.names.take count).map Prod.snd := by
      intro member
      exact hidden (List.mem_of_mem_take (by simpa only [List.map_take] using member))
    exact ⟨slot, by simpa only [Context.retire, if_neg absent] using stored, rfl⟩

theorem cleanup (context : Context) (count : Nat) : History context (context.cleanup count) :=
  (disposeSlots context (context.bindings.take count)).trans (retire _ count)

theorem borrow (context : Context) (target : Origin) (referent : Ty) (parent : Option Nat) (mode : BorrowMode) :
    History context (context.borrow target referent parent mode) :=
  ⟨fun _ loan found => ⟨loan, borrow_found found, rfl, rfl, rfl, rfl, id⟩, Nat.le_refl _,
    fun _ member _ => member, fun _ slot _ found _ => ⟨slot, found, rfl⟩⟩

theorem prepare (context : Context) (parameters : List (String × BindingType)) (arguments : List ResultType) :
    History context (Context.prepare parameters arguments context) := by
  induction parameters generalizing arguments context with
  | nil => exact refl context
  | cons parameter parameters ih =>
    cases arguments with
    | nil => exact refl context
    | cons argument arguments => exact (bind context parameter.1 parameter.2.mutable argument).trans (ih _ _)

end History

/-- Raising the unused source-ID supply does not create semantic support. -/
theorem bind_mentions_old {context : Context} {name : String} {mutable : Bool} {result : ResultType}
    {binder : Nat} (old : binder < context.nextBinder) :
    (context.bind name mutable result).MentionsBinder binder ↔ context.MentionsBinder binder := by
  simp only [Context.MentionsBinder, Context.bind, OriginBase.binder.injEq, if_neg (Nat.ne_of_lt old)]

theorem hide_mentions {context : Context} {binder : Nat} :
    context.hide.MentionsBinder binder → context.MentionsBinder binder := id

theorem retire_mentions {context : Context} {count binder : Nat} :
    (context.retire count).MentionsBinder binder → context.MentionsBinder binder := by
  rintro (⟨slot, stored⟩ | loan)
  · simp only [Context.retire] at stored
    split at stored
    · cases stored
    · exact .inl ⟨slot, stored⟩
  · exact .inr loan

theorem dispose_mentions (context : Context) (reference : SourcePayload) (binder : Nat) :
    (context.dispose reference).MentionsBinder binder ↔ context.MentionsBinder binder := by
  exact dispose_induction Iff.rfl
    (fun current node same => (current.endOwn_mentions node binder).trans same) reference

theorem disposeSlots_mentions (context : Context) (slots : List (String × Slot)) (binder : Nat) :
    (context.disposeSlots slots).MentionsBinder binder ↔ context.MentionsBinder binder := by
  induction slots generalizing context with
  | nil => exact Iff.rfl
  | cons slot slots ih => exact (ih _).trans (dispose_mentions _ _ _)

theorem cleanup_mentions {context : Context} {count binder : Nat} :
    (context.cleanup count).MentionsBinder binder → context.MentionsBinder binder :=
  fun mentioned => (disposeSlots_mentions _ _ _).mp (retire_mentions mentioned)

theorem prepare_mentions_old {context : Context} (parameters : List (String × BindingType))
    (arguments : List ResultType) {binder : Nat} (old : binder < context.nextBinder) :
    (Context.prepare parameters arguments context).MentionsBinder binder ↔ context.MentionsBinder binder := by
  induction parameters generalizing arguments context with
  | nil => exact Iff.rfl
  | cons parameter parameters ih =>
    cases arguments with
    | nil => exact Iff.rfl
    | cons argument arguments =>
      exact (ih arguments (Nat.lt_succ_of_lt old)).trans (bind_mentions_old old)
end Context


theorem SlotsJoin.layout {before after : List (String × Slot)} (joined : SlotsJoin program before after) :
    after.map (fun binding => (binding.1, binding.2.type, binding.2.mutable, binding.2.binder, binding.2.payload.nodes)) =
    before.map (fun binding => (binding.1, binding.2.type, binding.2.mutable, binding.2.binder, binding.2.payload.nodes)) := by
  induction joined with
  | nil => rfl
  | cons head payloadJoins tail ih => simp only [List.map_cons, payloadJoins.nodes, ih]

theorem SlotsJoin.binders {before after : List (String × Slot)} (joined : SlotsJoin program before after) :
    after.map (fun binding => binding.2.binder) = before.map (fun binding => binding.2.binder) := by
  induction joined with
  | nil => rfl
  | cons head _ tail ih => simp only [List.map_cons, ih]

theorem SlotsJoin.member {before after : List (String × Slot)} (joined : SlotsJoin program before after)
    {binding : String × Slot} (member : binding ∈ after) :
    ∃ original ∈ before, binding.2.type = original.2.type ∧
      binding.2.binder = original.2.binder ∧ original.2.payload.Joins binding.2.payload := by
  induction joined with
  | nil => exact False.elim (List.not_mem_nil member)
  | cons head payloadJoins tail ih =>
    rcases List.mem_cons.mp member with rfl | member
    · exact ⟨_, List.mem_cons_self, rfl, rfl, payloadJoins⟩
    · obtain ⟨original, originalMember, shape⟩ := ih member
      exact ⟨original, List.mem_cons_of_mem _ originalMember, shape⟩

namespace Context

theorem Joins.wellFormed {before after : Context} (joined : Joins program before after)
    (valid : before.WellFormed program) : after.WellFormed program := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [joined.slots.binders]
    exact valid.distinct
  · intro binding member
    obtain ⟨original, member, type, _, _⟩ := joined.slots.member member
    rw [type]
    exact valid.supported original member
  · intro binding member
    obtain ⟨original, member, type, binder, reference⟩ := joined.slots.member member
    obtain ⟨bound, references⟩ := valid.slots original member
    refine ⟨?_, ?_⟩
    · rw [binder]
      exact Nat.lt_of_lt_of_le bound joined.supply
    · simpa only [joined.loans, type] using reference.typed references
  · intro node loan found
    obtain ⟨bounded, finite⟩ := valid.targets node loan (joined.loans ▸ found)
    refine ⟨?_, finite⟩
    cases base : loan.target.base with
    | binder identity =>
      simp only [Origin.Bounded, base] at bounded ⊢
      exact Nat.lt_of_lt_of_le bounded joined.supply
  · intro node loan parent found derived
    obtain ⟨older, ancestor, ancestorFound, within⟩ := valid.parents node loan parent (joined.loans ▸ found) derived
    exact ⟨older, ancestor, joined.loans.symm ▸ ancestorFound, within⟩
  · intro entry member
    obtain ⟨slot, stored⟩ := valid.named entry (joined.names ▸ member)
    obtain ⟨current, found, _, _⟩ := (joined.storage (.binder entry.2)).forward stored
    exact ⟨current, found⟩
  · intro binder slot stored
    obtain ⟨original, found, metadata, _⟩ := (joined.storage (.binder binder)).backward stored
    obtain ⟨identity, bound, supported, reference⟩ := valid.allocated binder original found
    have payloadJoins := (joined.storage (.binder binder)).payloadJoins found stored
    rcases (show slot.type = original.type ∧ slot.mutable = original.mutable ∧
        slot.binder = original.binder from
      by simpa only [Slot.metadata, Prod.mk.injEq] using metadata) with ⟨type, _, binderEq⟩
    refine ⟨binderEq.trans identity, Nat.lt_of_lt_of_le bound joined.supply, type.symm ▸ supported, ?_⟩
    simpa only [joined.loans, type] using payloadJoins.typed reference
  · intro node loan parent ancestor found derived parentFound unique
    exact valid.parentModes node loan parent ancestor (joined.loans ▸ found) derived (joined.loans ▸ parentFound) unique

theorem Joins.mentions {before after : Context} (joined : Joins program before after) (binder : Nat) :
    after.MentionsBinder binder ↔ before.MentionsBinder binder := by
  constructor
  · rintro (⟨slot, stored⟩ | loan)
    · obtain ⟨original, found, _, _⟩ := (joined.storage (.binder binder)).backward stored
      exact .inl ⟨original, found⟩
    · exact .inr (joined.loans ▸ loan)
  · rintro (⟨slot, stored⟩ | loan)
    · obtain ⟨current, found, _, _⟩ := (joined.storage (.binder binder)).forward stored
      exact .inl ⟨current, found⟩
    · exact .inr (joined.loans.symm ▸ loan)

theorem Joins.history {before after : Context} (joined : Joins program before after) : History before after := by
  refine ⟨fun _ loan found => ⟨loan, joined.loans.symm ▸ found, rfl, rfl, rfl, rfl, id⟩,
    joined.supply, fun _ member _ => joined.names ▸ member, ?_⟩
  intro binder slot _ stored _
  obtain ⟨current, found, metadata, _⟩ := (joined.storage (.binder binder)).forward stored
  exact ⟨current, found, metadata⟩

/-- Only support actually mentioned by slots or loan history is reflected. -/
def ReflectsSupport (before after : Context) : Prop :=
  ∀ binder, after.MentionsBinder binder → binder < before.nextBinder → before.MentionsBinder binder

namespace ReflectsSupport

theorem refl (context : Context) : ReflectsSupport context context := fun _ mentioned _ => mentioned

theorem trans {before middle after : Context} (first : ReflectsSupport before middle)
    (second : ReflectsSupport middle after) (supply : before.nextBinder ≤ middle.nextBinder) :
    ReflectsSupport before after :=
  fun binder mentioned old => first binder (second binder mentioned (Nat.lt_of_lt_of_le old supply)) old

theorem bind (context : Context) (name : String) (mutable : Bool) (result : ResultType) :
    ReflectsSupport context (context.bind name mutable result) :=
  fun _ mentioned old => (bind_mentions_old old).mp mentioned

theorem hide (context : Context) : ReflectsSupport context context.hide :=
  fun _ mentioned _ => hide_mentions mentioned

theorem retire (context : Context) (count : Nat) : ReflectsSupport context (context.retire count) :=
  fun _ mentioned _ => retire_mentions mentioned

theorem endOwn (context : Context) (node : Nat) : ReflectsSupport context (context.endOwn node) :=
  fun binder mentioned _ => (context.endOwn_mentions node binder).mp mentioned

theorem dispose (context : Context) (reference : SourcePayload) : ReflectsSupport context (context.dispose reference) :=
  fun binder mentioned _ => (dispose_mentions context reference binder).mp mentioned

theorem disposeSlots (context : Context) (slots : List (String × Slot)) :
    ReflectsSupport context (context.disposeSlots slots) :=
  fun binder mentioned _ => (disposeSlots_mentions context slots binder).mp mentioned

theorem cleanup (context : Context) (count : Nat) : ReflectsSupport context (context.cleanup count) :=
  fun _ mentioned _ => cleanup_mentions mentioned

theorem borrow {context : Context} {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (known : target.Known context) : ReflectsSupport context (context.borrow target referent parent mode) :=
  fun binder mentioned _ => (borrow_mentions known binder).mp mentioned

theorem prepare (context : Context) (parameters : List (String × BindingType)) (arguments : List ResultType) :
    ReflectsSupport context (Context.prepare parameters arguments context) :=
  fun _ mentioned old => (prepare_mentions_old parameters arguments old).mp mentioned

theorem joins {before after : Context} (joined : Joins program before after) : ReflectsSupport before after :=
  fun binder mentioned _ => (joined.mentions binder).mp mentioned

end ReflectsSupport
end Context

namespace Context

theorem History.resume {caller after : Context} (evolved : History caller.hide after) :
    History caller (caller.resume after) :=
  ⟨evolved.records, evolved.supply, fun _ member _ => member,
    fun binder slot old stored _ => evolved.retained binder slot old stored (by simp [Context.hide])⟩

theorem WellFormed.resume {caller after : Context} (callerValid : caller.WellFormed program)
    (afterValid : after.WellFormed program) (evolved : History caller.hide after) :
    (caller.resume after).WellFormed program := by
  have named : ∀ entry ∈ caller.names, ∃ slot, after.storage (.binder entry.2) = some slot := by
    intro entry member
    obtain ⟨slot, found⟩ := callerValid.named entry member
    obtain ⟨current, stored, _⟩ := evolved.retained entry.2 slot
      (callerValid.allocated entry.2 slot found).2.1 found (by simp [Context.hide])
    exact ⟨current, stored⟩
  have binders : (caller.resume after).bindings.map (fun binding => binding.2.binder) = caller.names.map Prod.snd := by
    unfold Context.bindings
    rw [List.map_filterMap, ← List.filterMap_eq_map]
    apply filterMap_congr_mem
    intro entry member
    obtain ⟨slot, found⟩ := named entry member
    simp [Context.resume, found, (afterValid.allocated entry.2 slot found).1]
  refine ⟨?_, ?_, ?_, afterValid.targets, afterValid.parents, named, afterValid.allocated, afterValid.parentModes⟩
  · rw [binders, ← callerValid.bindings_binders]
    exact callerValid.distinct
  · intro binding member
    obtain ⟨entry, _, found⟩ := List.mem_filterMap.mp member
    obtain ⟨slot, stored, same⟩ := Option.map_eq_some_iff.mp found
    cases same
    exact (afterValid.allocated entry.2 slot stored).2.2.1
  · intro binding member
    obtain ⟨entry, _, found⟩ := List.mem_filterMap.mp member
    obtain ⟨slot, stored, same⟩ := Option.map_eq_some_iff.mp found
    cases same
    obtain ⟨identity, bound, _, reference⟩ := afterValid.allocated entry.2 slot stored
    exact ⟨identity.symm ▸ bound, reference⟩

/-- Visibility restoration does not change the authoritative storage support. -/
theorem resume_mentions {caller after : Context} {binder : Nat} :
    (caller.resume after).MentionsBinder binder → caller.MentionsBinder binder ∨ after.MentionsBinder binder :=
  fun mentioned => .inr mentioned

theorem ReflectsSupport.resume {caller after : Context} (reflected : ReflectsSupport caller.hide after) :
    ReflectsSupport caller (caller.resume after) := by
  intro binder mentioned old
  rcases resume_mentions mentioned with callerMentioned | afterMentioned
  · exact callerMentioned
  · exact hide_mentions (reflected binder afterMentioned old)

end Context

theorem replaceBinding_lookup {α : Type} {name : String} {value : α} {before after : List (String × α)}
    (replaced : replaceBinding name value before = some after) : lookup name after = some value := by
  induction before generalizing after with
  | nil => simp [replaceBinding] at replaced
  | cons entry rest ih =>
    obtain ⟨key, old⟩ := entry
    simp only [replaceBinding] at replaced
    split at replaced
    next same =>
      cases Option.some.inj replaced
      simp [lookup, same]
    next different =>
      obtain ⟨next, changed, same⟩ := Option.map_eq_some_iff.mp replaced
      cases same
      simp [lookup, Ne.symm different, ih changed]

theorem lookup_member {α : Type} {bindings : List (String × α)} {name : String} {value : α}
    (found : lookup name bindings = some value) : (name, value) ∈ bindings := by
  induction bindings with
  | nil => simp [lookup] at found
  | cons entry rest ih =>
    obtain ⟨key, resident⟩ := entry
    simp only [lookup] at found
    split at found
    · rename_i same
      cases Option.some.inj found
      simp [same]
    · exact List.mem_cons_of_mem _ (ih found)

theorem replaceBinding_map_same {α β : Type} (f : α → β) {name : String} {old value : α}
    {before after : List (String × α)} (selected : lookup name before = some old)
    (changed : replaceBinding name value before = some after) (same : f value = f old) :
    after.map (fun x => f x.2) = before.map (fun x => f x.2) := by
  induction before generalizing after with
  | nil => simp [lookup] at selected
  | cons entry rest ih =>
    obtain ⟨key, resident⟩ := entry
    simp only [lookup] at selected
    simp only [replaceBinding] at changed
    split at selected
    · rename_i equal
      rw [if_pos equal.symm] at changed
      cases Option.some.inj selected
      cases Option.some.inj changed
      simp [same]
    · rename_i different
      rw [if_neg (Ne.symm different)] at changed
      obtain ⟨next, tailChanged, rfl⟩ := Option.map_eq_some_iff.mp changed
      simp [ih selected tailChanged]

theorem replaceBinding_members {α : Type} {name : String} {value : α}
    {before after : List (String × α)} (changed : replaceBinding name value before = some after)
    {binding : String × α} (member : binding ∈ after) : binding = (name, value) ∨ binding ∈ before := by
  induction before generalizing after with
  | nil => simp [replaceBinding] at changed
  | cons entry rest ih =>
    obtain ⟨key, old⟩ := entry
    simp only [replaceBinding] at changed
    split at changed
    · rename_i equal
      cases Option.some.inj changed
      rcases List.mem_cons.mp member with rfl | member
      · exact Or.inl (by simp [equal])
      · exact Or.inr (List.mem_cons_of_mem _ member)
    · obtain ⟨next, tailChanged, rfl⟩ := Option.map_eq_some_iff.mp changed
      rcases List.mem_cons.mp member with rfl | member
      · exact Or.inr (by simp)
      · rcases ih tailChanged member with same | old
        · exact Or.inl same
        · exact Or.inr (List.mem_cons_of_mem _ old)

private theorem findSlot {slots : List (String × Slot)}
    (distinct : (slots.map (fun binding => binding.2.binder)).Nodup)
    {binding : String × Slot} (member : binding ∈ slots) :
    slots.find? (fun entry => entry.2.binder == binding.2.binder) = some binding := by
  induction slots with
  | nil => cases member
  | cons first rest ih =>
      obtain ⟨absent, tailDistinct⟩ := List.nodup_cons.mp distinct
      rcases List.mem_cons.mp member with rfl | member
      · simp
      · have different : first.2.binder ≠ binding.2.binder := by
          intro same
          exact absent (List.mem_map.mpr ⟨binding, member, same.symm⟩)
        simpa [List.find?_cons, different] using ih tailDistinct member

theorem Context.withSlots_bindings (context : Context) {slots : List (String × Slot)}
    (distinct : (slots.map (fun binding => binding.2.binder)).Nodup) :
    (context.withSlots slots).bindings = slots := by
  simp only [Context.bindings, Context.withSlots, List.filterMap_map]
  have equal := Context.filterMap_congr_mem slots
    (fun binding => ((context.withSlots slots).storage (.binder binding.2.binder)).map fun slot => (binding.1, slot))
    some (by
      intro binding member
      simp only [Context.withSlots, findSlot distinct member, Option.map_some])
  simpa only [Context.withSlots, List.filterMap_some_fun, Function.comp_def, id_eq] using equal

theorem Context.withSlots_storage_cases {context : Context} {slots : List (String × Slot)}
    {binder : Nat} {slot : Slot} (stored : (context.withSlots slots).storage (.binder binder) = some slot) :
    (∃ binding ∈ slots, binding.2 = slot ∧ binding.2.binder = binder) ∨
      context.storage (.binder binder) = some slot := by
  cases chosen : slots.find? (fun binding => binding.2.binder == binder) with
  | none => exact .inr (by simpa only [Context.withSlots, chosen] using stored)
  | some binding =>
      have same : binding.2 = slot := by simpa only [Context.withSlots, chosen, Option.some.injEq] using stored
      exact .inl ⟨binding, List.mem_of_find?_eq_some chosen, same, by simpa using List.find?_some chosen⟩

theorem Context.WellFormed.replaceSlot_storage {context : Context} (valid : context.WellFormed program)
    {name : String} {slot replacement : Slot} {slots : List (String × Slot)}
    (selected : lookup name context.bindings = some slot)
    (changed : replaceBinding name replacement context.bindings = some slots)
    (sameBinder : replacement.binder = slot.binder) (binder : Nat) :
    (context.withSlots slots).storage (.binder binder) =
      if binder = slot.binder then some replacement else context.storage (.binder binder) := by
  have distinct : (slots.map (fun binding => binding.2.binder)).Nodup := by
    rw [replaceBinding_map_same Slot.binder selected changed sameBinder]
    exact valid.distinct
  by_cases same : binder = slot.binder
  · subst binder
    have found := findSlot distinct (lookup_member (replaceBinding_lookup changed))
    have target : slots.find? (fun entry => entry.2.binder == slot.binder) = some (name, replacement) := by
      simpa only [sameBinder] using found
    simp [Context.withSlots, target]
  · rw [if_neg same]
    cases chosen : slots.find? (fun binding => binding.2.binder == binder) with
    | none => simp only [Context.withSlots, chosen]
    | some binding =>
      have identity : binding.2.binder = binder := by simpa using List.find?_some chosen
      rcases replaceBinding_members changed (List.mem_of_find?_eq_some chosen) with rfl | retained
      · exact False.elim (same (sameBinder.symm.trans identity).symm)
      · have stored := valid.member_stored binding retained
        simpa only [Context.withSlots, chosen, identity] using stored.symm

theorem Context.WellFormed.replaceSlot {program : Program} {context : Context}
    (valid : context.WellFormed program) {name : String} {slot replacement : Slot}
    {slots : List (String × Slot)} (selected : lookup name context.bindings = some slot)
    (changed : replaceBinding name replacement context.bindings = some slots)
    (binder : replacement.binder = slot.binder) (type : replacement.type = slot.type)
    (reference : SourcePayload.Typed program context.loans replacement.payload replacement.type) :
    ((context.withSlots slots) : Context).WellFormed program := by
  have member := lookup_member selected
  have distinct : (slots.map (fun binding => binding.2.binder)).Nodup := by
    rw [replaceBinding_map_same Slot.binder selected changed binder]
    exact valid.distinct
  have view := context.withSlots_bindings distinct
  have properties : ∀ binding ∈ slots, StorageType program.target program.data binding.2.type ∧
      binding.2.binder < context.nextBinder ∧
      SourcePayload.Typed program context.loans binding.2.payload binding.2.type := by
    intro binding memberNew
    rcases replaceBinding_members changed memberNew with rfl | retained
    · exact ⟨type.symm ▸ valid.supported (name, slot) member,
        binder.symm ▸ (valid.slots (name, slot) member).1, reference⟩
    · exact ⟨valid.supported binding retained, valid.slots binding retained⟩
  refine ⟨by simpa only [view] using distinct, ?_, ?_, valid.targets, valid.parents, ?_, ?_, valid.parentModes⟩
  · intro binding memberNew
    exact (properties binding (view ▸ memberNew)).1
  · intro binding memberNew
    exact (properties binding (view ▸ memberNew)).2
  · intro entry memberNew
    obtain ⟨binding, memberIn, rfl⟩ := List.mem_map.mp memberNew
    exact ⟨binding.2, by simp only [Context.withSlots, findSlot distinct memberIn]⟩
  · intro identity current stored
    rcases Context.withSlots_storage_cases stored with ⟨binding, memberNew, rfl, equal⟩ | old
    · obtain ⟨supported, bound, reference⟩ := properties binding memberNew
      exact ⟨equal, equal ▸ bound, supported, reference⟩
    · exact valid.allocated identity current old

theorem Context.replaceSlot_mentions {context : Context} (valid : context.WellFormed program)
    {name : String} {slot replacement : Slot} {slots : List (String × Slot)}
    (selected : lookup name context.bindings = some slot)
    (changed : replaceBinding name replacement context.bindings = some slots)
    (binder : replacement.binder = slot.binder) {id : Nat}
    (mentioned : (context.withSlots slots).MentionsBinder id) : context.MentionsBinder id := by
  rcases mentioned with ⟨current, stored⟩ | loan
  · rcases Context.withSlots_storage_cases stored with ⟨binding, member, _, same⟩ | old
    · rcases replaceBinding_members changed member with rfl | retained
      · exact (binder.symm.trans same) ▸ valid.member_known (name, slot) (lookup_member selected)
      · exact same ▸ valid.member_known binding retained
    · exact .inl ⟨current, old⟩
  · exact .inr loan

/-- Canonical mutation changes initialization and payload, retaining declaration metadata. -/
theorem Context.writeTarget_stored (context : Context) (origin : Origin) (next : Initialization) (payload : SourcePayload)
    {base : OriginBase} {slot : Slot} (stored : context.storage base = some slot) :
    ∃ current, (context.writeTarget origin next payload).storage base = some current ∧ current.metadata = slot.metadata := by
  by_cases same : base = origin.base
  · subst base
    exact context.writeTarget_metadata origin next payload stored
  · exact ⟨slot, by simp [Context.writeTarget, same, stored], rfl⟩

theorem Context.writeTarget_original {context : Context} {origin : Origin} {next : Initialization} {payload : SourcePayload}
    {base : OriginBase} {slot : Slot} (stored : (context.writeTarget origin next payload).storage base = some slot) :
    ∃ original, context.storage base = some original ∧ slot.metadata = original.metadata := by
  by_cases same : base = origin.base
  · simp only [Context.writeTarget, if_pos same] at stored
    obtain ⟨original, found, equal⟩ := Option.map_eq_some_iff.mp stored
    cases equal
    exact ⟨original, found, rfl⟩
  · exact ⟨slot, by simpa [Context.writeTarget, same] using stored, rfl⟩

theorem Context.writeTarget_mentions (context : Context) (origin : Origin) (next : Initialization) (payload : SourcePayload) (binder : Nat) :
    (context.writeTarget origin next payload).MentionsBinder binder ↔ context.MentionsBinder binder := by
  constructor
  · rintro (⟨slot, stored⟩ | loan)
    · obtain ⟨original, found, _⟩ := Context.writeTarget_original stored
      exact .inl ⟨original, found⟩
    · exact .inr loan
  · rintro (⟨slot, stored⟩ | loan)
    · obtain ⟨current, found, _⟩ := context.writeTarget_stored origin next payload stored
      exact .inl ⟨current, found⟩
    · exact .inr loan

theorem Context.WellFormed.writeTarget {context : Context} (valid : context.WellFormed program)
    (origin : Origin) (next : Initialization) (payload : SourcePayload)
    (typed : ∀ slot, context.storage origin.base = some slot →
      SourcePayload.Typed program context.loans payload slot.type) :
    (context.writeTarget origin next payload).WellFormed program := by
  have allocated : ∀ binder slot, (context.writeTarget origin next payload).storage (.binder binder) = some slot →
      slot.binder = binder ∧ binder < context.nextBinder ∧ StorageType program.target program.data slot.type ∧
      SourcePayload.Typed program context.loans slot.payload slot.type := by
    intro binder slot stored
    by_cases same : OriginBase.binder binder = origin.base
    · simp only [Context.writeTarget, if_pos same] at stored
      obtain ⟨original, found, equal⟩ := Option.map_eq_some_iff.mp stored
      cases equal
      obtain ⟨identity, bound, supported, _⟩ := valid.allocated binder original found
      exact ⟨identity, bound, supported, typed original (by simpa only [← same] using found)⟩
    · exact valid.allocated binder slot (by simpa [Context.writeTarget, same] using stored)
  have named : ∀ entry ∈ context.names, ∃ slot, (context.writeTarget origin next payload).storage (.binder entry.2) = some slot := by
    intro entry member
    obtain ⟨slot, stored⟩ := valid.named entry member
    obtain ⟨current, found, _⟩ := context.writeTarget_stored origin next payload stored
    exact ⟨current, found⟩
  have bindingStored : ∀ binding ∈ (context.writeTarget origin next payload).bindings,
      (context.writeTarget origin next payload).storage (.binder binding.2.binder) = some binding.2 := by
    intro binding member
    obtain ⟨entry, _, found⟩ := List.mem_filterMap.mp member
    obtain ⟨slot, stored, equal⟩ := Option.map_eq_some_iff.mp found
    cases equal
    rw [(allocated entry.2 slot stored).1]
    exact stored
  refine ⟨?_, ?_, ?_, valid.targets, valid.parents, named, allocated, valid.parentModes⟩
  · have binders : (context.writeTarget origin next payload).bindings.map (fun binding => binding.2.binder) =
        context.names.map Prod.snd := by
      unfold Context.bindings
      rw [List.map_filterMap, ← List.filterMap_eq_map]
      apply Context.filterMap_congr_mem
      intro entry member
      obtain ⟨slot, stored⟩ := named entry member
      simp [stored, (allocated entry.2 slot stored).1]
    rw [binders, ← valid.bindings_binders]
    exact valid.distinct
  · intro binding member
    exact (allocated _ _ (bindingStored binding member)).2.2.1
  · intro binding member
    have facts := allocated _ _ (bindingStored binding member)
    exact ⟨facts.2.1, facts.2.2.2⟩

theorem Context.History.writeTarget (context : Context) (origin : Origin) (next : Initialization) (payload : SourcePayload) :
    Context.History context (context.writeTarget origin next payload) := by
  refine ⟨fun _ loan found => ⟨loan, found, rfl, rfl, rfl, rfl, id⟩, Nat.le_refl _,
    fun _ member _ => member, ?_⟩
  intro binder slot _ stored _
  exact context.writeTarget_stored origin next payload stored

theorem Context.ReflectsSupport.writeTarget (context : Context) (origin : Origin) (next : Initialization) (payload : SourcePayload) :
    Context.ReflectsSupport context (context.writeTarget origin next payload) :=
  fun binder mentioned _ => (context.writeTarget_mentions origin next payload binder).mp mentioned

theorem Context.Derived.writeTarget {context : Context} {node ancestor : Nat}
    (derived : context.Derived node ancestor) (origin : Origin) (next : Initialization) (payload : SourcePayload) :
    (context.writeTarget origin next payload).Derived node ancestor := by
  induction derived with
  | same node => exact .same node
  | child found parent _ ih => exact .child found parent ih

theorem Context.Permits.writeTarget {context : Context} {mode : BorrowMode} {parent : Option Nat} {target : Origin}
    (permitted : context.Permits mode parent target) (origin : Origin) (next : Initialization) (payload : SourcePayload) :
    (context.writeTarget origin next payload).Permits mode parent target := by
  intro node loan found own
  rcases permitted node loan found own with shared | ⟨selected, chosen, derived⟩ | apart
  · exact .inl shared
  · exact .inr (.inl ⟨selected, chosen, derived.writeTarget origin next payload⟩)
  · exact .inr (.inr apart)

/-- An ancestor remains addressable even when a nested resident becomes vacant. -/
theorem Initialization.Access.write_prefix {state selected : Initialization} {indices observed : List Nat}
    (access : state.Access indices selected) (initial : observed.IsPrefix indices) (next : Initialization) :
    ∃ retained, (state.write indices next).Access observed retained := by
  obtain ⟨suffix, rfl⟩ := initial
  induction observed generalizing state with
  | nil => exact ⟨_, .here _⟩
  | cons index rest ih =>
    cases access with
    | child present access =>
      obtain ⟨retained, kept⟩ := ih access
      exact ⟨retained, .child (by simp [Initialization.write, Initialization.setChild])
        (by simpa only [List.cons_append, Initialization.write, Initialization.child_setChild present, ↓reduceIte] using kept)⟩

/-- A complete replacement restores the selected target even if it was a hole. -/
theorem Context.Target.writeTarget_ready {context : Context} {origin : Origin} {referent : Ty}
    (target : context.Target program origin referent) {binder : Nat} (base : origin.base = .binder binder)
    {next : Initialization} (complete : next.Complete) (payload : SourcePayload) :
    (context.writeTarget origin next payload).Ready origin := by
  obtain ⟨slot, stored, _, state, access⟩ := (by simpa [Context.Target, base] using target)
  simp only [Context.Ready, base]
  exact ⟨{ slot with initialization := slot.initialization.write origin.fields next, payload := payload }, next,
    by simp [Context.writeTarget, base, stored], access.write next, complete⟩



theorem Context.Ready.writeTarget_apart {context : Context} {origin observed : Origin} {referent : Ty}
    (target : context.Target program origin referent) {binder : Nat} (base : origin.base = .binder binder)
    (ready : context.Ready observed) (apart : origin.Apart observed) (next : Initialization) (payload : SourcePayload) :
    (context.writeTarget origin next payload).Ready observed := by
  cases observedBase : observed.base with
  | binder other =>
    simp only [Context.Ready, observedBase] at ready ⊢
    obtain ⟨slot, retained, stored, kept, complete⟩ := ready
    by_cases same : other = binder
    · subst other
      obtain ⟨root, rootStored, _, selected, access⟩ := (by simpa [Context.Target, base] using target)
      have equal := Option.some.inj (stored.symm.trans rootStored)
      subst root
      have fields : CoordinatesApart origin.fields observed.fields := by
        simpa [Origin.Apart, base, observedBase] using apart
      exact ⟨{ slot with initialization := slot.initialization.write origin.fields next, payload := payload }, retained,
        by simp [Context.writeTarget, base, stored], access.write_frame kept fields next, complete⟩
    · exact ⟨slot, retained, by simpa [Context.writeTarget, base, same] using stored, kept, complete⟩

/-- Disjoint targets retain their exact masks; ancestors retain a canonical
addressable mask, but only unique ancestors may become incomplete. -/
theorem Context.SourceTarget.writeTarget {context : Context} {origin : Origin} {referent : Ty}
    (target : context.Target program origin referent) {binder : Nat} (base : origin.base = .binder binder)
    {loan : SourceLoan} (source : context.SourceTarget program loan)
    (separated : (origin.Within loan.target ∧ loan.mode = .unique) ∨ origin.Apart loan.target)
    (next : Initialization) (payload : SourcePayload) : (context.writeTarget origin next payload).SourceTarget program loan := by
  obtain ⟨oldTarget, oldReady⟩ := source
  refine ⟨?_, ?_⟩
  · cases observedBase : loan.target.base with
    | binder other =>
      simp only [Context.Target, observedBase] at oldTarget ⊢
      obtain ⟨slot, stored, path, retained, kept⟩ := oldTarget
      by_cases same : other = binder
      · subst other
        obtain ⟨root, rootStored, _, selected, access⟩ := (by simpa [Context.Target, base] using target)
        have equal := Option.some.inj (stored.symm.trans rootStored)
        subst root
        refine ⟨{ slot with initialization := slot.initialization.write origin.fields next, payload := payload },
          by simp [Context.writeTarget, base, stored], path, ?_⟩
        rcases separated with ⟨within, _⟩ | apart
        · exact access.write_prefix within.2 next
        · exact ⟨retained, access.write_frame kept (by simpa [Origin.Apart, base, observedBase] using apart) next⟩
      · exact ⟨slot, by simpa [Context.writeTarget, base, same] using stored, path, retained, kept⟩
  · intro shared
    rcases separated with ⟨_, unique⟩ | apart
    · simp [shared] at unique
    · exact (oldReady shared).writeTarget_apart target base apart next payload

/-- Replacing one selected resident with a complete value preserves a complete
ancestor, without imposing readiness on the resident being replaced. -/
theorem Initialization.Complete.write {state selected next : Initialization} {indices : List Nat}
    (complete : state.Complete) (access : state.Access indices selected) (ready : next.Complete) :
    (state.write indices next).Complete := by
  induction access with
  | here => exact ready
  | child present access ih =>
    apply (Initialization.setChild_complete_iff present _).mpr
    exact ⟨ih (complete.child _), fun other _ => complete.child other⟩

theorem Initialization.Access.write_ready {state selected retained next : Initialization} {indices observed : List Nat}
    (access : state.Access indices selected) (kept : state.Access observed retained)
    (complete : retained.Complete) (ready : next.Complete) :
    ∃ current, (state.write indices next).Access observed current ∧ current.Complete := by
  induction access generalizing observed retained with
  | here => exact ready.access_all observed
  | @child state selected index indices present access ih =>
    cases kept with
    | here => exact ⟨_, .here _, complete.write (.child present access) ready⟩
    | @child _ _ other observed keptPresent kept =>
      by_cases same : other = index
      · subst other
        obtain ⟨current, currentAccess, currentComplete⟩ := ih kept complete
        exact ⟨current, .child (by simp [Initialization.write, Initialization.setChild])
          (by simpa only [Initialization.write, Initialization.child_setChild present, ↓reduceIte] using currentAccess),
          currentComplete⟩
      · exact ⟨retained, .child (by simp [Initialization.write, Initialization.setChild])
          (by simpa only [Initialization.write, Initialization.child_setChild present, if_neg same] using kept), complete⟩

theorem Context.Ready.writeTarget_initialized {context : Context} {origin observed : Origin} {referent : Ty}
    (target : context.Target program origin referent) {binder : Nat} (base : origin.base = .binder binder)
    (ready : context.Ready observed) {next : Initialization} (complete : next.Complete) (payload : SourcePayload) :
    (context.writeTarget origin next payload).Ready observed := by
  cases observedBase : observed.base with
  | binder other =>
    simp only [Context.Ready, observedBase] at ready ⊢
    obtain ⟨slot, retained, stored, kept, initialized⟩ := ready
    by_cases same : other = binder
    · subst other
      obtain ⟨root, rootStored, _, selected, access⟩ := (by simpa [Context.Target, base] using target)
      have equal := Option.some.inj (stored.symm.trans rootStored)
      subst root
      obtain ⟨current, currentAccess, currentComplete⟩ := access.write_ready kept initialized complete
      exact ⟨{ slot with initialization := slot.initialization.write origin.fields next, payload := payload }, current,
        by simp [Context.writeTarget, base, stored], currentAccess, currentComplete⟩
    · exact ⟨slot, retained, by simpa [Context.writeTarget, base, same] using stored, kept, initialized⟩

theorem Context.Restored.endOwn {context : Context} {node : Nat} (ready : context.Restored node) (ended : Nat) :
    (context.endOwn ended).Restored node := by
  intro loan found own
  obtain ⟨original, old, rfl⟩ := Context.endOwn_original found
  have different : ended ≠ node := by intro equal; simp [equal] at own
  exact ready original old (by simpa [different] using own)

theorem Context.Restored.dispose {context : Context} {node : Nat} (ready : context.Restored node)
    (payload : SourcePayload) : (context.dispose payload).Restored node :=
  Context.dispose_induction (P := fun current => current.Restored node) ready
    (fun _ ended restored => restored.endOwn ended) payload


end Grounded

/- Section: StateProgress -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

/-- Frame facts concern the proof interpretation only, including skipped source
IDs. Bounds remain restricted to semantic support, never invented allocations. -/
structure Interpretation.Extends (before after : Interpretation) (context : Context) : Prop where
  binders : ∀ binder, binder < context.nextBinder → after.binder binder = before.binder binder
  nodes : ∀ node, node < context.loans.length → after.node node = before.node node

structure StateProgress (beforeContext afterContext : Context) (before after : Environment)
    (first last : Interpretation) : Prop where
  history : beforeContext.History afterContext
  support : beforeContext.ReflectsSupport afterContext
  interpretation : first.Extends last beforeContext
  fresh : ∀ binder, beforeContext.nextBinder ≤ binder → afterContext.MentionsBinder binder →
    before.nextRoot ≤ last.binder binder
  loanCount : after.loans.length + beforeContext.loans.length = before.loans.length + afterContext.loans.length

def Interpretation.addBinder (interpretation : Interpretation) (source runtime : Nat) : Interpretation :=
  { interpretation with binder := fun binder => if binder = source then runtime else interpretation.binder binder }

theorem Context.WellFormed.mentionedBound {context : Context} (valid : context.WellFormed program)
    {binder : Nat} (mentioned : context.MentionsBinder binder) : binder < context.nextBinder := by
  rcases mentioned with ⟨slot, stored⟩ | ⟨node, loan, found, base⟩
  · exact (valid.allocated binder slot stored).2.1
  · simpa [Origin.Bounded, base] using (valid.targets node loan found).1

theorem Context.bind_mentions (context : Context) (name : String) (mutable : Bool) (result : ResultType)
    (binder : Nat) : (context.bind name mutable result).MentionsBinder binder ↔
      binder = context.nextBinder ∨ context.MentionsBinder binder := by
  by_cases same : binder = context.nextBinder
  · subst binder
    simp [Context.MentionsBinder, Context.bind]
  · simp [Context.MentionsBinder, Context.bind, same]

theorem Environment.endOwn_length {before after : Environment} {node : Nat}
    (ended : before.endOwn node = some after) : after.loans.length = before.loans.length := by
  have same := Environment.endOwn_state ended
  subst after
  simp [List.length_modify]

theorem Environment.Disposes.loans_length {before after : Environment} {value : Value}
    (disposed : Disposes program before value after) : after.loans.length = before.loans.length := by
  induction disposed using Disposes.rec
    (motive_2 := fun before _ after _ => after.loans.length = before.loans.length) with
  | data => rfl
  | reference _ ended => exact endOwn_length ended
  | tuple _ _ ih | array _ _ ih | nominal _ _ ih => exact ih
  | nil => rfl
  | cons _ _ tailIH headIH => exact headIH.trans tailIH

theorem DisposesRoots.loans_length {before after : Environment} {roots : List Root} {trace}
    (disposed : DisposesRoots program before roots trace after) : after.loans.length = before.loans.length := by
  induction disposed with
  | nil => rfl
  | cons _ _ head _ ih => exact ih.trans head.loans_length

theorem Cleans.loans_length {before after : Environment} {count trace}
    (cleaned : Cleans program count before trace after) : after.loans.length = before.loans.length := by
  cases cleaned with | retire disposed => exact disposed.loans_length

theorem Context.History.loanLength {before after : Context} (history : before.History after) :
    before.loans.length ≤ after.loans.length := by
  apply Nat.le_of_not_gt
  intro bound
  obtain ⟨retained, kept, _⟩ := history.records after.loans.length before.loans[after.loans.length]
    (List.getElem?_eq_getElem bound)
  simp at kept

theorem Interpretation.Extends.refl (interpretation : Interpretation) (context : Context) :
    interpretation.Extends interpretation context := ⟨fun _ _ => rfl, fun _ _ => rfl⟩

theorem Interpretation.Extends.trans {first middle last : Interpretation} {before after : Context}
    (front : first.Extends middle before) (back : middle.Extends last after) (history : before.History after) :
    first.Extends last before := by
  refine ⟨?_, ?_⟩
  · intro binder bound
    exact (back.binders binder (Nat.lt_of_lt_of_le bound history.supply)).trans (front.binders binder bound)
  · intro node bound
    exact (back.nodes node (Nat.lt_of_lt_of_le bound history.loanLength)).trans (front.nodes node bound)

theorem StateProgress.refl {interpretation : Interpretation} {context : Context} {environment : Environment}
    (valid : context.WellFormed program) : StateProgress context context environment environment interpretation interpretation :=
  ⟨.refl _, .refl _, .refl _ _, fun _ large known => False.elim (Nat.not_lt_of_ge large (valid.mentionedBound known)), rfl⟩

theorem StateProgress.trans {firstContext middleContext lastContext : Context} {first middle last : Environment}
    {firstMap middleMap lastMap : Interpretation}
    (front : StateProgress firstContext middleContext first middle firstMap middleMap)
    (back : StateProgress middleContext lastContext middle last middleMap lastMap)
    (supply : first.nextRoot ≤ middle.nextRoot) : StateProgress firstContext lastContext first last firstMap lastMap := by
  refine ⟨front.history.trans back.history, front.support.trans back.support front.history.supply,
    front.interpretation.trans back.interpretation front.history, ?_, ?_⟩
  · intro binder large known
    by_cases old : binder < middleContext.nextBinder
    · rw [back.interpretation.binders binder old]
      exact front.fresh binder large (back.support binder known old)
    · exact Nat.le_trans supply (back.fresh binder (Nat.le_of_not_lt old) known)
  · have a := front.loanCount
    have b := back.loanCount
    omega

theorem Context.disposeSlots_loans_length (context : Context) (slots : List (String × Slot)) :
    (context.disposeSlots slots).loans.length = context.loans.length := by
  induction slots generalizing context with
  | nil => rfl
  | cons slot slots ih => exact (ih _).trans (context.dispose_loans_length slot.2.payload)

theorem Context.cleanup_loans_length (context : Context) (count : Nat) :
    (context.cleanup count).loans.length = context.loans.length := context.disposeSlots_loans_length _

theorem StateProgress.endOwn {interpretation : Interpretation} {context : Context} {before after : Environment}
    {node : Nat} (valid : context.WellFormed program) (ended : before.endOwn (interpretation.node node) = some after) :
    StateProgress context (context.endOwn node) before after interpretation interpretation := by
  refine ⟨.endOwn _ _, .endOwn _ _, .refl _ _, ?_, ?_⟩
  · intro binder large known
    exact False.elim (Nat.not_lt_of_ge large (valid.mentionedBound ((context.endOwn_mentions node binder).mp known)))
  · simp only [Environment.endOwn_length ended, Context.endOwn, List.length_modify]

theorem StateProgress.dispose {interpretation : Interpretation} {context : Context} {before after : Environment}
    {reference : SourcePayload} {value : Value} (valid : context.WellFormed program)
    (disposed : Environment.Disposes program before value after) :
    StateProgress context (context.dispose reference) before after interpretation interpretation := by
  refine ⟨.dispose _ _, .dispose _ _, .refl _ _, ?_, ?_⟩
  · intro binder large known
    exact False.elim (Nat.not_lt_of_ge large (valid.mentionedBound ((Context.dispose_mentions _ _ _).mp known)))
  · rw [disposed.loans_length, Context.dispose_loans_length]

theorem StateProgress.cleanup {interpretation : Interpretation} {context : Context} {before after : Environment}
    {count : Nat} {trace : List (Root × List Nat)} (valid : context.WellFormed program)
    (cleaned : Cleans program count before trace after) :
    StateProgress context (context.cleanup count) before after interpretation interpretation := by
  refine ⟨.cleanup _ _, .cleanup _ _, .refl _ _, ?_, ?_⟩
  · intro binder large known
    exact False.elim (Nat.not_lt_of_ge large (valid.mentionedBound (Context.cleanup_mentions known)))
  · rw [cleaned.loans_length, Context.cleanup_loans_length]

theorem StateProgress.bind {interpretation : Interpretation} {context : Context} {environment : Environment}
    (valid : context.WellFormed program) (name : String) (mutable : Bool) (result : ResultType) (value : Value) :
    StateProgress context (context.bind name mutable result) environment (environment.bind name value)
      interpretation (interpretation.addBinder context.nextBinder environment.nextRoot) := by
  refine ⟨.bind _ _ _ _, .bind _ _ _ _, ?_, ?_, rfl⟩
  · refine ⟨?_, fun _ _ => rfl⟩
    intro binder bound
    simp [Interpretation.addBinder, Nat.ne_of_lt bound]
  · intro binder large known
    rcases (Context.bind_mentions _ _ _ _ _).mp known with rfl | old
    · simp [Interpretation.addBinder]
    · exact False.elim (Nat.not_lt_of_ge large (valid.mentionedBound old))

theorem StateProgress.borrow {interpretation : Interpretation} {context : Context} {environment : Environment}
    {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode} (valid : context.WellFormed program)
    (known : target.Known context) :
    StateProgress context (context.borrow target referent parent mode) environment
      (environment.addLoan ⟨interpretation.origin target, parent.map interpretation.node⟩ mode)
      interpretation (interpretation.addNode context.loans.length environment.loans.length) := by
  refine ⟨.borrow _ _ _ _ _, .borrow known, ?_, ?_, ?_⟩
  · refine ⟨fun _ _ => rfl, ?_⟩
    intro node bound
    simp [Interpretation.addNode, Nat.ne_of_lt bound]
  · intro binder large mentioned
    exact False.elim (Nat.not_lt_of_ge large (valid.mentionedBound ((Context.borrow_mentions known binder).mp mentioned)))
  · simp [Context.borrow, Environment.addLoan]
    omega

theorem StateProgress.join {interpretation : Interpretation} {context afterContext : Context} {environment : Environment}
    (valid : context.WellFormed program) (joined : context.Joins program afterContext) :
    StateProgress context afterContext environment environment interpretation interpretation := by
  refine ⟨joined.history, .joins joined, .refl _ _, ?_, ?_⟩
  · intro binder large known
    exact False.elim (Nat.not_lt_of_ge large (valid.mentionedBound ((joined.mentions binder).mp known)))
  · rw [joined.loans]

theorem StateProgress.raiseSupply {interpretation : Interpretation} {context : Context} {environment : Environment}
    (valid : context.WellFormed program) {supply : Nat} (larger : context.nextBinder ≤ supply) :
    StateProgress context {context with nextBinder := supply} environment environment interpretation interpretation := by
  refine ⟨⟨fun _ loan found => ⟨loan, found, rfl, rfl, rfl, rfl, id⟩, larger,
      fun _ member _ => member, fun _ slot _ found _ => ⟨slot, found, rfl⟩⟩,
    fun _ mentioned _ => mentioned, .refl _ _, ?_, rfl⟩
  intro binder large known
  exact False.elim (Nat.not_lt_of_ge large (valid.mentionedBound known))

theorem ResultTyped.transport {before after : Context} {first last : Interpretation} {value : Value} {result : ResultType}
    (typed : ResultTyped program first before result value) (history : before.History after)
    (same : first.Extends last before) : ResultTyped program last after result value := by
  apply typed.transportRecords _ same.nodes
  intro node loan found
  obtain ⟨retained, kept, _, referent, _, mode, _⟩ := history.records node loan found
  exact ⟨retained, kept, referent, mode⟩

theorem ResultsTyped.transport {before after : Context} {first last : Interpretation}
    {results : List ResultType} {values : List Value}
    (typed : ResultsTyped program first before results values) (history : before.History after)
    (same : first.Extends last before) : ResultsTyped program last after results values := by
  induction typed with
  | nil => exact .nil
  | cons head tail ih => exact .cons (head.transport history same) ih

theorem StateProgress.writeTarget {interpretation : Interpretation} {context : Context} {before after : Environment}
    (valid : context.WellFormed program) {origin : Origin} {next : Initialization} {replacement : Value}
    {payload : SourcePayload} (written : before.writeAddress (interpretation.origin origin) replacement = some after) :
    StateProgress context (context.writeTarget origin next payload) before after interpretation interpretation := by
  refine ⟨.writeTarget _ _ _ _, .writeTarget _ _ _ _, .refl _ _, ?_, ?_⟩
  · intro binder large known
    exact False.elim (Nat.not_lt_of_ge large (valid.mentionedBound ((context.writeTarget_mentions origin next payload binder).mp known)))
  · have unchanged := Environment.writeAddress_loans written
    simp only [unchanged, Context.writeTarget]

end Grounded

/- Section: StorageWrites -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

private theorem filterMap_congr_mem {α β : Type} (entries : List α) (left right : α → Option β)
    (same : ∀ entry ∈ entries, left entry = right entry) :
    entries.filterMap left = entries.filterMap right := by
  induction entries with
  | nil => rfl
  | cons entry entries ih =>
      simp only [List.filterMap_cons, same entry (by simp), ih (fun other member => same other (by simp [member]))]

theorem Context.WellFormed.bindings_names {context : Context} (valid : context.WellFormed program) :
    context.bindings.map (fun binding => (binding.1, binding.2.binder)) = context.names := by
  simp only [Context.bindings, List.map_filterMap]
  have equal := filterMap_congr_mem context.names
    (fun entry => ((context.storage (.binder entry.2)).map (fun slot => (entry.1, slot))).map
      (fun binding => (binding.1, binding.2.binder))) some (by
        intro entry member
        obtain ⟨slot, found⟩ := valid.named entry member
        simp only [found, Option.map_some, (valid.allocated entry.2 slot found).1])
  simpa only [List.filterMap_some_fun, id_eq] using equal

theorem Environment.writeAddress_evolution {address : Address} {value : Value} {before after : Environment}
    (authority : before.MutationRoot address.root)
    (written : before.writeAddress address value = some after) (valid : before.Valid) :
    after.Valid ∧ before.Evolution after := by
  simp only [Environment.writeAddress, Bind.bind, Option.bind_eq_some_iff] at written
  obtain ⟨parent, found, updated, _, equal⟩ := written
  cases equal
  have bound := valid.bounded address.root parent found
  refine ⟨valid.put bound updated, rfl, Nat.le_refl _, ?_, fun _ live => .inl (.inr live), ?_, ?_⟩
  · intro root outside
    have different : root ≠ address.root := fun same => outside (same ▸ authority)
    simp only [Environment.put, if_neg different]
  · intro root _ missing
    have different : root ≠ address.root := by
      intro same; subst root; rw [found] at missing; cases missing
    simpa only [Environment.put, if_neg different] using missing
  · intro root fresh
    have different : root ≠ address.root := fun same => Nat.not_lt_of_ge fresh (same ▸ bound)
    simpa only [Environment.put, if_neg different] using (Environment.Evolution.refl before valid).fresh root fresh

theorem Context.Derived.targetWithin {context : Context} (valid : context.WellFormed program)
    {node ancestor : Nat} {loan parentLoan : SourceLoan} (derived : context.Derived node ancestor)
    (found : context.loans[node]? = some loan) (ancestorFound : context.loans[ancestor]? = some parentLoan) :
    loan.target.Within parentLoan.target := by
  induction derived generalizing loan with
  | same =>
    have equal := Option.some.inj (found.symm.trans ancestorFound)
    subst loan
    exact ⟨rfl, ⟨[], by simp⟩⟩
  | child source parent earlier ih =>
    have equal := Option.some.inj (source.symm.trans found)
    subst loan
    obtain ⟨_, middle, middleFound, front⟩ := valid.parents _ _ _ source parent
    have back := ih middleFound ancestorFound
    exact ⟨front.1.trans back.1, back.2.trans front.2⟩
end Grounded

/- Section: StorageCanonical -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem Context.TargetPayload.storage_congr {before after : Context} {origin : Origin}
    {type : Ty} {payload : SourcePayload} (target : before.TargetPayload program origin type payload)
    (storage : after.storage origin.base = before.storage origin.base) : after.TargetPayload program origin type payload := by
  cases target with
  | cell stored path selected => exact .cell (storage.trans stored) path selected

theorem StoreTyped.nodeBound {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {node : Nat}
    (bound : node < context.loans.length) : interpretation.node node < environment.loans.length :=
  (List.getElem?_eq_some_iff.mp (typed.records node context.loans[node] (List.getElem?_eq_getElem bound))).1

theorem StoreTyped.payloadBound {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {payload : SourcePayload} {value : Value} {type : Ty}
    (source : payload.Typed program context.loans type) (related : payload.Corresponds interpretation.node value)
    {path : List Nat} {node : Nat} (read : value.readIndices path = some (.reference node)) :
    node < environment.loans.length := by
  obtain ⟨identity, occurrence, rfl⟩ := related.readIndices_reference_iff.mp read
  exact typed.nodeBound (source.node_bound (SourcePayload.mem_nodes_iff.mpr ⟨path, occurrence⟩))

theorem StoreTyped.writeCanonical {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {binder : Nat} {slot : Slot}
    {indices : List Nat} {state next : Initialization} {target : Ty} {replacement : Value}
    {payload updatedPayload : SourcePayload}
    (stored : context.storage (.binder binder) = some slot)
    (path : CanonicalPath program slot.type indices target) (access : slot.initialization.Access indices state)
    (resident : ResidentTyped program next replacement target)
    (write : SourcePayload.Write program slot.type indices slot.payload payload updatedPayload)
    (related : payload.Corresponds interpretation.node replacement) :
    ∃ parent updated, environment.store (interpretation.binder binder) = some parent ∧
      parent.writeIndices indices replacement = some updated ∧
      ResidentTyped program (slot.initialization.write indices next) updated slot.type ∧
      updatedPayload.Corresponds interpretation.node updated ∧
      environment.writeAddress ⟨interpretation.binder binder, indices⟩ replacement =
        some (environment.put (interpretation.binder binder) updated) := by
  obtain ⟨parent, found, rootTyped, rootRelated⟩ := typed.cells binder slot stored
  obtain ⟨updated, written, updatedTyped, updatedRelated⟩ :=
    write.realizes path rootTyped access resident rootRelated related
  exact ⟨parent, updated, found, written, updatedTyped, updatedRelated,
    by simp [Environment.writeAddress, found, written]⟩

theorem StoreTyped.writeTarget_cells {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {origin : Origin} {binder : Nat} {slot : Slot}
    {referent : Ty} {next state : Initialization} {replacement : Value} {payload updatedPayload : SourcePayload}
    (base : origin.base = .binder binder) (stored : context.storage (.binder binder) = some slot)
    (path : CanonicalPath program slot.type origin.fields referent)
    (access : slot.initialization.Access origin.fields state)
    (resident : ResidentTyped program next replacement referent)
    (write : SourcePayload.Write program slot.type origin.fields slot.payload payload updatedPayload)
    (related : payload.Corresponds interpretation.node replacement) :
    ∃ updated, environment.writeAddress (interpretation.origin origin) replacement =
        some (environment.put (interpretation.binder binder) updated) ∧
      ResidentTyped program (slot.initialization.write origin.fields next) updated slot.type ∧
      updatedPayload.Corresponds interpretation.node updated ∧
      ∀ other current, (context.writeTarget origin next updatedPayload).storage (.binder other) = some current →
        ∃ value, (environment.put (interpretation.binder binder) updated).store (interpretation.binder other) = some value ∧
          SlotTyped program value current.toBindingType ∧ current.Corresponds interpretation value := by
  obtain ⟨parent, updated, found, changed, updatedTyped, updatedRelated, written⟩ :=
    typed.writeCanonical stored path access resident write related
  refine ⟨updated, by simpa only [Interpretation.origin, base] using written,
    updatedTyped, updatedRelated, ?_⟩
  intro other current selected
  by_cases same : other = binder
  · subst other
    simp only [Context.writeTarget, base, ↓reduceIte, stored, Option.map_some, Option.some.injEq] at selected
    subst current
    exact ⟨updated, by simp [Environment.put], updatedTyped, updatedRelated⟩
  · have oldStored : context.storage (.binder other) = some current := by
      simpa [Context.writeTarget, base, same] using selected
    obtain ⟨value, found, valueTyped, corresponds⟩ := typed.cells other current oldStored
    have different : interpretation.binder other ≠ interpretation.binder binder := by
      intro equal
      exact same (typed.binderDistinct other binder (.inl ⟨current, oldStored⟩) (.inl ⟨slot, stored⟩) equal)
    exact ⟨value, by simpa [Environment.put, different] using found, valueTyped, corresponds⟩

theorem StoreTyped.writeTarget_preserves {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {origin : Origin} {binder : Nat} {slot : Slot}
    {referent : Ty} {next state : Initialization} {replacement : Value} {payload updatedPayload : SourcePayload}
    (base : origin.base = .binder binder) (stored : context.storage (.binder binder) = some slot)
    (path : CanonicalPath program slot.type origin.fields referent)
    (access : slot.initialization.Access origin.fields state)
    (resident : ResidentTyped program next replacement referent)
    (write : SourcePayload.Write program slot.type origin.fields slot.payload payload updatedPayload)
    (payloadTyped : payload.Typed program context.loans referent)
    (related : payload.Corresponds interpretation.node replacement)
    (separated : ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan → loan.own = true →
      (origin.Within loan.target ∧ loan.mode = .unique) ∨ origin.Apart loan.target) :
    ∃ after, environment.writeAddress (interpretation.origin origin) replacement = some after ∧
      StoreTyped program interpretation (context.writeTarget origin next updatedPayload) after := by
  obtain ⟨updated, written, updatedTyped, updatedRelated, cells⟩ :=
    typed.writeTarget_cells base stored path access resident write related
  have rootPayloadTyped := write.typed (typed.source.allocated binder slot stored).2.2.2 path payloadTyped
  have target : context.Target program origin referent := by
    simpa only [Context.Target, base] using (show ∃ slot, context.storage (.binder binder) = some slot ∧
      CanonicalPath program slot.type origin.fields referent ∧ ∃ state, slot.initialization.Access origin.fields state from
      ⟨slot, stored, path, state, access⟩)
  have source := typed.source.writeTarget origin next updatedPayload (by
    intro current selected
    rw [base, stored] at selected
    cases Option.some.inj selected
    exact rootPayloadTyped)
  have runtimeValid := typed.residents.valid.put (typed.binderBound binder (.inl ⟨slot, stored⟩)) updated
  have names : (environment.put (interpretation.binder binder) updated).bindings =
      (context.writeTarget origin next updatedPayload).names.map (fun entry => (entry.1, interpretation.binder entry.2)) := by
    change environment.bindings = context.names.map _
    rw [← typed.source.bindings_names, List.map_map, typed.slots.bindings]
    rfl
  obtain ⟨residents, slots⟩ := Context.reconstruct source runtimeValid names cells
  refine ⟨_, written, ?_⟩
  refine { source := source, residents := residents, slots := slots, cells := cells
           binderBound := ?_, binderDistinct := ?_
           nodeOrder := typed.nodeOrder, records := typed.records, activeCoverage := typed.activeCoverage
           sourceTargets := ?_, storeShape := ?_ }
  · intro other mentioned
    exact typed.binderBound other ((context.writeTarget_mentions origin next updatedPayload other).mp mentioned)
  · intro first second firstKnown secondKnown same
    exact typed.binderDistinct first second
      ((context.writeTarget_mentions origin next updatedPayload first).mp firstKnown)
      ((context.writeTarget_mentions origin next updatedPayload second).mp secondKnown) same
  · intro node loan found own
    exact (typed.sourceTargets node loan found own).writeTarget target base (separated node loan found own) next updatedPayload
  · intro root value found indices node read
    by_cases same : root = interpretation.binder binder
    · subst root
      simp only [Environment.put, ↓reduceIte, Option.some.injEq] at found
      subst value
      exact typed.payloadBound rootPayloadTyped updatedRelated read
    · exact typed.storeShape root value (by simpa [Environment.put, same] using found) indices node read

end Grounded

/- Section: StorageEffects -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem Context.TargetPayload.typed {context : Context} {origin : Origin} {referent : Ty} {payload : SourcePayload}
    (target : context.TargetPayload program origin referent payload) (valid : context.WellFormed program) :
    payload.Typed program context.loans referent := by
  cases target with
  | @cell slot referent payload stored path selected =>
    have root : slot.payload.Typed program context.loans slot.type := by
      cases base : origin.base with
      | binder binder => exact (valid.allocated binder slot (base ▸ stored)).2.2.2
    exact root.select path selected

namespace StoreTyped
variable {interpretation : Interpretation} {context : Context} {environment : Environment}

theorem endOwn (typed : StoreTyped program interpretation context environment)
    {ended : Nat} {endedLoan : SourceLoan} (found : context.loans[ended]? = some endedLoan) :
    ∃ after, environment.endOwn (interpretation.node ended) = some after ∧
      StoreTyped program interpretation (context.endOwn ended) after := by
  let after : Environment := { environment with
    loans := environment.loans.modify (interpretation.node ended) fun loan => { loan with own := false } }
  have endedBound := (List.getElem?_eq_some_iff.mp found).1
  have originalRuntime : ∀ (node : Nat) (loan : Loan), after.loans[node]? = some loan →
      ∃ (original : Loan), environment.loans[node]? = some original ∧
        loan = { original with own := if interpretation.node ended = node then false else original.own } := by
    intro node loan selected
    change (environment.loans.modify (interpretation.node ended) fun loan => { loan with own := false })[node]? = some loan at selected
    rw [List.getElem?_modify] at selected
    obtain ⟨original, old, equal⟩ := Option.map_eq_some_iff.mp selected
    refine ⟨original, old, ?_⟩
    cases equal
    split <;> rfl
  refine ⟨after, by simp [Environment.endOwn, typed.records _ _ found, after], ?_⟩
  refine { source := typed.source.endOwn ended
           residents := ⟨⟨typed.residents.valid.bounded, typed.residents.valid.named, typed.residents.valid.distinct⟩,
             typed.residents.residents⟩
           slots := typed.slots
           cells := typed.cells
           binderBound := ?_
           binderDistinct := ?_
           nodeOrder := ?_
           records := ?_
           activeCoverage := ?_
           sourceTargets := by
             intro node loan selected available
             obtain ⟨original, old, rfl⟩ := Context.endOwn_original selected
             have different : ended ≠ node := by intro same; simp [same] at available
             have own : original.own = true := by simpa [different] using available
             exact typed.sourceTargets node original old own
           storeShape := ?_ }
  · intro binder included
    exact typed.binderBound binder ((context.endOwn_mentions ended binder).mp included)
  · intro first second firstKnown secondKnown same
    exact typed.binderDistinct first second ((context.endOwn_mentions ended first).mp firstKnown)
      ((context.endOwn_mentions ended second).mp secondKnown) same
  · intro first second older bound
    exact typed.nodeOrder first second older (by simpa [Context.endOwn] using bound)
  · intro node loan selected
    obtain ⟨original, old, rfl⟩ := Context.endOwn_original selected
    have record := typed.records node original old
    change (environment.loans.modify (interpretation.node ended) fun loan => { loan with own := false })[interpretation.node node]? = _
    rw [List.getElem?_modify, record]
    by_cases same : ended = node
    · subst node; simp
    · have different : interpretation.node ended ≠ interpretation.node node :=
        fun equal => same (typed.nodeInjective endedBound (List.getElem?_eq_some_iff.mp old).1 equal)
      simp [same, different]
  · intro node loan selected available
    obtain ⟨original, old, rfl⟩ := originalRuntime node loan selected
    have different : interpretation.node ended ≠ node := by
      intro same
      simp [same] at available
    have own : original.own = true := by simpa [different] using available
    obtain ⟨sourceNode, sourceLoan, sourceFound, equal⟩ := typed.activeCoverage node original old own
    exact ⟨sourceNode, _, context.endOwn_found ended sourceFound, equal⟩
  · intro root value stored path node read
    simpa [after] using typed.storeShape root value stored path node read

theorem borrow (typed : StoreTyped program interpretation context environment)
    {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (known : target.Known context) (bounded : target.Bounded context)
    (finite : FiniteLayout program.target program.data referent)
    (ancestor : ∀ node, parent = some node → ∃ loan, context.loans[node]? = some loan ∧ target.Within loan.target)
    (parentMode : ∀ node loan, parent = some node → context.loans[node]? = some loan → mode = .unique → loan.mode = .unique)
    (sourceTarget : context.SourceTarget program ⟨target, referent, parent, true, mode⟩) :
    StoreTyped program (interpretation.addNode context.loans.length environment.loans.length)
      (context.borrow target referent parent mode)
      (environment.addLoan ⟨interpretation.origin target, parent.map interpretation.node⟩ mode) := by
  let next := interpretation.addNode context.loans.length environment.loans.length
  let after := environment.addLoan ⟨interpretation.origin target, parent.map interpretation.node⟩ mode
  have oldNode : ∀ node, node < context.loans.length → next.node node = interpretation.node node := by
    intro node bound
    exact interpretation.addNode_old bound
  have nodeBound : ∀ node, node < context.loans.length → interpretation.node node < environment.loans.length := by
    intro node bound
    exact (List.getElem?_eq_some_iff.mp (typed.records node context.loans[node]
      (List.getElem?_eq_getElem bound))).1
  have parentSame : parent.map next.node = parent.map interpretation.node := by
    cases shape : parent with
    | none => rfl
    | some node =>
      obtain ⟨loan, found, _⟩ := ancestor node shape
      simp only [Option.map_some, oldNode node (List.getElem?_eq_some_iff.mp found).1]
  refine { source := typed.source.borrow bounded finite ancestor parentMode
           residents := ⟨⟨typed.residents.valid.bounded, typed.residents.valid.named, typed.residents.valid.distinct⟩,
             typed.residents.residents⟩
           slots := typed.slots.node_congr (fun _ => rfl) ?_
           cells := by
             intro binder slot stored
             obtain ⟨resident, found, residentTyped, corresponds⟩ := typed.cells binder slot stored
             refine ⟨resident, found, residentTyped, ?_⟩
             exact corresponds.congr (fun node member => (oldNode node ((typed.source.allocated binder slot stored).2.2.2.node_bound member)).symm)
           binderBound := ?_
           binderDistinct := ?_
           nodeOrder := ?_
           records := ?_
           activeCoverage := ?_
           sourceTargets := by
             intro node loan found own
             rcases Context.borrow_cases found with old | ⟨_, rfl⟩
             · exact typed.sourceTargets node loan old own
             · exact sourceTarget
           storeShape := ?_ }
  · intro binding member node included
    exact oldNode node ((typed.source.slots binding member).2.node_bound included)
  · intro binder included
    exact typed.binderBound binder ((Context.borrow_mentions known binder).mp included)
  · intro first second firstKnown secondKnown same
    exact typed.binderDistinct first second ((Context.borrow_mentions known first).mp firstKnown)
      ((Context.borrow_mentions known second).mp secondKnown) same
  · intro first second less bound
    have secondLe : second ≤ context.loans.length := Nat.lt_succ_iff.mp (by simpa [Context.borrow] using bound)
    change next.node first < next.node second
    rcases Nat.lt_or_eq_of_le secondLe with secondOld | rfl
    · rw [oldNode first (Nat.lt_trans less secondOld), oldNode second secondOld]
      exact typed.nodeOrder first second less secondOld
    · rw [oldNode first less]
      simpa [next, Interpretation.addNode] using nodeBound first less
  · intro node loan found
    rcases Context.borrow_cases found with old | ⟨rfl, rfl⟩
    · have bound := (List.getElem?_eq_some_iff.mp old).1
      have oldParent : loan.parent.map next.node = loan.parent.map interpretation.node := by
        cases shape : loan.parent with
        | none => rfl
        | some parentNode =>
          have older := (typed.source.parents node loan parentNode old shape).1
          simp only [Option.map_some, oldNode parentNode (Nat.lt_trans older bound)]
      change after.loans[next.node node]? = some ⟨next.origin loan.target, loan.parent.map next.node, loan.own, loan.mode⟩
      rw [oldNode node bound, oldParent]
      exact (List.getElem?_append_left (nodeBound node bound)).trans (typed.records node loan old)
    · change after.loans[next.node context.loans.length]? =
        some ⟨next.origin target, parent.map next.node, true, mode⟩
      rw [parentSame]
      simp [after, next, Environment.addLoan, Interpretation.addNode, Interpretation.origin]
  · intro node loan found own
    change after.loans[node]? = some loan at found
    by_cases bound : node < environment.loans.length
    · have old : environment.loans[node]? = some loan := by
        simpa only [after, Environment.addLoan, List.getElem?_append_left bound] using found
      obtain ⟨sourceNode, sourceLoan, sourceFound, same⟩ := typed.activeCoverage node loan old own
      exact ⟨sourceNode, sourceLoan, Context.borrow_found sourceFound,
        (oldNode sourceNode (List.getElem?_eq_some_iff.mp sourceFound).1).trans same⟩
    · simp only [after, Environment.addLoan, List.getElem?_append_right (Nat.le_of_not_lt bound)] at found
      cases difference : node - environment.loans.length with
      | zero =>
        have same : node = environment.loans.length :=
          Nat.le_antisymm (Nat.sub_eq_zero_iff_le.mp difference) (Nat.le_of_not_lt bound)
        exact ⟨context.loans.length, ⟨target, referent, parent, true, mode⟩,
          Context.borrow_last context target referent parent mode, by simp [Interpretation.addNode, same]⟩
      | succ rest => simp [difference] at found
  · intro root resident stored path node read
    exact Nat.lt_trans (typed.storeShape root resident stored path node read)
      (by simp [Environment.addLoan])

end StoreTyped
end Grounded

/- Section: StateResource -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem Context.Restored.borrow {context : Context} {node : Nat} (ready : context.Restored node)
    (bound : node < context.loans.length) (target : Origin) (referent : Ty) (parent : Option Nat) (mode : BorrowMode) :
    (context.borrow target referent parent mode).Restored node := by
  intro loan found own
  rcases Context.borrow_cases found with old | ⟨same, rfl⟩
  · exact ready loan old own
  · exact False.elim ((Nat.ne_of_lt bound) same)

theorem StoreTyped.targetPayload {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {node : Nat} {loan : SourceLoan}
    (found : context.loans[node]? = some loan) (own : loan.own = true) (ready : context.Ready loan.target) :
    ∃ value payload, environment.readAddress (interpretation.origin loan.target) = some value ∧
      ValueHasType program value loan.referent ∧ context.TargetPayload program loan.target loan.referent payload ∧
      payload.Corresponds interpretation.node value := by
  cases base : loan.target.base with
  | binder binder =>
    have target := (typed.sourceTargets node loan found own).1
    obtain ⟨slot, stored, path, _, _⟩ := (by simpa only [Context.Target, base] using target)
    obtain ⟨value, read, resident⟩ := typed.targetReady target ready base
    obtain ⟨root, rootStored, _, rootRelated⟩ := typed.cells binder slot stored
    have selected : root.readIndices loan.target.fields = some value := by
      simpa only [Environment.at, Interpretation.origin, base, rootStored, Bind.bind, Option.bind_some] using Environment.readAddress_at read
    obtain ⟨payload, sourceSelected, related⟩ := rootRelated.readIndices selected
    exact ⟨value, payload, read, resident, .cell (base ▸ stored) path sourceSelected, related⟩

theorem ResultTyped.newBorrow {interpretation : Interpretation} {context : Context} {environment : Environment}
    {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (finite : FiniteLayout program.target program.data referent) :
    ResultTyped program (interpretation.addNode context.loans.length environment.loans.length)
      (context.borrow target referent parent mode)
      ⟨.reference referent mode, .reference context.loans.length⟩ (.reference environment.loans.length) := by
  refine ⟨.reference _ finite, .reference (Context.borrow_last context target referent parent mode), ?_⟩
  simpa only [Interpretation.addNode, ↓reduceIte] using
    (SourcePayload.Corresponds.reference (node := (interpretation.addNode context.loans.length environment.loans.length).node) context.loans.length)

end Grounded

/- Section: ResidentFinite -/

namespace Grounded

/-- A complete resident supplies finite layout without constraining vacant or
uncertain storage. Nominal and array admission already checks every variant or
element, including the element of an empty array. -/
theorem ResidentTyped.finite {program : Program} {state : Initialization}
    {value : Value} {type : Ty} (typed : ResidentTyped program state value type)
    (complete : state.Complete) : FiniteLayout program.target program.data type := by
  induction typed using ResidentTyped.rec
    (motive_2 := fun states values types _ => (∀ index, (states index).Complete) →
      ∀ type ∈ types, FiniteLayout program.target program.data type) with
  | vacant => cases complete
  | uncertain actual permission ih => cases complete
  | unit => exact .unit
  | integer fits => exact .integer _
  | character valid => exact .character
  | reference node finite => exact .reference _ _
  | tuple head tail present headIH tailIH =>
    exact .tuple (headIH (complete.child 0))
      (tailIH (fun index => complete.child (index + 1)))
  | array residents elementValid size present ih => exact .array elementValid size
  | nominal declared chosen finite residents present ih => exact finite
  | nil => rename_i complete type member; cases member
  | cons head tail headIH tailIH =>
    rename_i complete type member
    rcases List.mem_cons.mp member with rfl | member
    · exact headIH (complete 0)
    · exact tailIH (fun index => complete (index + 1)) type member

/-- Fully initialized values have finite layouts, including reference aggregates. -/
theorem ValueHasType.finite {program : Program} {value : Value} {type : Ty}
    (typed : ValueHasType program value type) : FiniteLayout program.target program.data type :=
  ResidentTyped.finite typed .full

end Grounded

/- Section: StorageScopes -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem StoreTyped.bind {interpretation : Interpretation} {context : Context} {environment : Environment}
    {value : Value} {result : ResultType}
    (typed : StoreTyped program interpretation context environment)
    (valueTyped : ResultTyped program interpretation context result value) (name : String) (mutable : Bool) :
    StoreTyped program (interpretation.addBinder context.nextBinder environment.nextRoot)
      (context.bind name mutable result) (environment.bind name value) := by
  let next := interpretation.addBinder context.nextBinder environment.nextRoot
  have oldBinder : ∀ binder, context.MentionsBinder binder → next.binder binder = interpretation.binder binder := by
    intro binder mentioned
    simp [next, Interpretation.addBinder, Nat.ne_of_lt (typed.source.mentionedBound mentioned)]
  have freshBinder : next.binder context.nextBinder = environment.nextRoot := by simp [next, Interpretation.addBinder]
  have oldOrigin : ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan → next.origin loan.target = interpretation.origin loan.target := by
    intro node loan found
    cases base : loan.target.base with
    | binder binder => simp [Interpretation.origin, base, oldBinder binder (.inr ⟨node, loan, found, base⟩)]
  have supported : StorageType program.target program.data result.type := .finite valueTyped.resident.finite
  have source := typed.source.bind name mutable result supported valueTyped.payload
  have cells : ∀ binder slot, (context.bind name mutable result).storage (.binder binder) = some slot →
      ∃ resident, (environment.bind name value).store (next.binder binder) = some resident ∧
        SlotTyped program resident slot.toBindingType ∧ slot.Corresponds next resident := by
    intro binder slot stored
    by_cases same : binder = context.nextBinder
    · subst binder
      simp only [Context.bind] at stored
      cases stored
      exact ⟨value, by simp [Environment.bind, freshBinder], valueTyped.resident, valueTyped.corresponds⟩
    · have oldStored : context.storage (.binder binder) = some slot := by simpa [Context.bind, same] using stored
      obtain ⟨resident, found, residentTyped, corresponds⟩ := typed.cells binder slot oldStored
      have known : context.MentionsBinder binder := .inl ⟨slot, oldStored⟩
      refine ⟨resident, ?_, residentTyped, corresponds⟩
      rw [oldBinder binder known]
      simpa [Environment.bind, Nat.ne_of_lt (typed.binderBound binder known)] using found
  have names : (environment.bind name value).bindings = (context.bind name mutable result).names.map
      (fun entry => (entry.1, next.binder entry.2)) := by
    simp only [Environment.bind, Context.bind, List.map_cons, freshBinder]
    congr 1
    rw [← typed.source.bindings_names, List.map_map, typed.slots.bindings]
    apply List.map_congr_left
    intro binding member
    simp only [Function.comp_def, oldBinder binding.2.binder (typed.source.member_known binding member)]
  obtain ⟨residents, slots⟩ := Context.reconstruct source (typed.residents.valid.bind name value) names cells
  refine { source := source, residents := residents, slots := slots, cells := cells
           binderBound := ?_, binderDistinct := ?_
           nodeOrder := typed.nodeOrder, records := ?_, activeCoverage := typed.activeCoverage
           sourceTargets := ?_, storeShape := ?_ }
  · intro binder mentioned
    rcases (Context.bind_mentions _ _ _ _ _).mp mentioned with rfl | old
    · simp [Interpretation.addBinder, Environment.bind]
    · change next.binder binder < environment.nextRoot + 1
      rw [oldBinder binder old]
      exact Nat.lt_succ_of_lt (typed.binderBound binder old)
  · intro first second firstMention secondMention equal
    rcases (Context.bind_mentions _ _ _ _ _).mp firstMention with rfl | firstOld <;>
      rcases (Context.bind_mentions _ _ _ _ _).mp secondMention with rfl | secondOld
    · rfl
    · change next.binder context.nextBinder = next.binder second at equal
      rw [freshBinder, oldBinder second secondOld] at equal
      have bound := typed.binderBound second secondOld
      exact False.elim ((Nat.ne_of_lt bound) equal.symm)
    · change next.binder first = next.binder context.nextBinder at equal
      rw [oldBinder first firstOld, freshBinder] at equal
      have bound := typed.binderBound first firstOld
      exact False.elim ((Nat.ne_of_lt bound) equal)
    · apply typed.binderDistinct first second firstOld secondOld
      change next.binder first = next.binder second at equal
      simpa [oldBinder first firstOld, oldBinder second secondOld] using equal
  · intro node loan found
    change environment.loans[interpretation.node node]? = some ⟨next.origin loan.target, loan.parent.map interpretation.node, loan.own, loan.mode⟩
    rw [oldOrigin node loan found]
    exact typed.records node loan found
  · intro node loan found own
    apply (typed.sourceTargets node loan found own).storage_congr
    cases base : loan.target.base with
    | binder binder =>
      have bound : binder < context.nextBinder := by
        simpa [Origin.Bounded, base] using (typed.source.targets node loan found).1
      simp [Context.bind, Nat.ne_of_lt bound]
  · intro root resident stored path node read
    by_cases equal : root = environment.nextRoot
    · subst root
      have same : value = resident := by simpa [Environment.bind] using stored
      subst resident
      exact typed.payloadBound valueTyped.payload valueTyped.corresponds read
    · exact typed.storeShape root resident (by simpa [Environment.bind, equal] using stored) path node read

end Grounded

/- Section: OrderedDisposal -/

namespace Grounded.Context
variable {program : Program}

theorem Restored.before_endOwn {context : Context} {ended node : Nat}
    (ready : context.Restored ended) (after : (context.endOwn ended).Restored node) :
    context.Restored node := by
  by_cases same : ended = node
  · simpa only [same] using ready
  · intro loan found own
    have retained : (context.endOwn ended).loans[node]? = some loan := by
      simpa [same] using context.endOwn_found ended found
    exact after loan retained own

theorem NodesDisposable.excludes {held : List SourcePayload} {context : Context} {nodes : List Nat}
    (legal : NodesDisposable program held context nodes) :
    ∀ node ∈ nodes, node ∉ payloadNodes held := by
  induction nodes generalizing context with
  | nil => simp
  | cons ended nodes ih =>
    intro node member
    rcases List.mem_cons.mp member with rfl | member
    · exact legal.1
    · exact ih legal.2.2.2 node member

theorem NodesDisposable.restored {held : List SourcePayload} {context : Context} {nodes : List Nat}
    (legal : NodesDisposable program held context nodes) : ∀ node ∈ nodes, context.Restored node := by
  induction nodes generalizing context with
  | nil => simp
  | cons ended nodes ih =>
    intro node member
    rcases List.mem_cons.mp member with rfl | member
    · exact legal.2.1
    · exact legal.2.1.before_endOwn (ih legal.2.2.2 node member)

theorem NodesDisposable.append_iff {held : List SourcePayload} {context : Context} {first rest : List Nat} :
    NodesDisposable program held context (first ++ rest) ↔
      NodesDisposable program held context first ∧
      NodesDisposable program held (first.foldl (fun current node => current.endOwn node) context) rest := by
  induction first generalizing context with
  | nil => simp [NodesDisposable]
  | cons node nodes ih => simp only [List.cons_append, NodesDisposable, List.foldl_cons, ih, and_assoc]

theorem NodesDisposable.fold {held : List SourcePayload} {context : Context} {nodes : List Nat}
    {P : Context → Prop} (legal : NodesDisposable program held context nodes) (initial : P context)
    (step : ∀ current node, node ∉ payloadNodes held → current.Restored node →
      current.Unobserved program node → P current → P (current.endOwn node)) :
    P (nodes.foldl (fun current node => current.endOwn node) context) := by
  induction nodes generalizing context with
  | nil => exact initial
  | cons node nodes ih =>
    exact ih legal.2.2.2 (step context node legal.1 legal.2.1 legal.2.2.1 initial)

theorem PayloadDisposable.excludes {held : List SourcePayload} {context : Context} {payload : SourcePayload}
    (legal : context.PayloadDisposable program held payload) : ∀ node ∈ payload.nodes, node ∉ payloadNodes held :=
  fun node member => NodesDisposable.excludes legal node (List.mem_reverse.mpr member)

theorem PayloadDisposable.restored {held : List SourcePayload} {context : Context} {payload : SourcePayload}
    (legal : context.PayloadDisposable program held payload) : ∀ node ∈ payload.nodes, context.Restored node :=
  fun node member => NodesDisposable.restored legal node (List.mem_reverse.mpr member)

end Grounded.Context

/- Section: ObservedOwn -/

namespace Grounded
variable {program : Program}
namespace Context

theorem endOwn_active_record {context : Context} {ended node : Nat} {loan : SourceLoan}
    (found : (context.endOwn ended).loans[node]? = some loan) (own : loan.own = true) :
    context.loans[node]? = some loan ∧ ended ≠ node := by
  obtain ⟨original, previous, rfl⟩ := endOwn_original found
  have different : ended ≠ node := by intro same; simp [same] at own
  simpa [different] using And.intro previous different

theorem dispose_active_record {context : Context} {payload : SourcePayload} {node : Nat} {loan : SourceLoan}
    (found : (context.dispose payload).loans[node]? = some loan) (own : loan.own = true) :
    context.loans[node]? = some loan := by
  unfold Context.dispose at found
  generalize payload.nodes.reverse = nodes at found
  induction nodes generalizing context with
  | nil => exact found
  | cons ended nodes ih => exact (endOwn_active_record (ih found) own).1

theorem Own.endOwn_other {context : Context} {node ended : Nat} (own : context.Own node)
    (different : ended ≠ node) : (context.endOwn ended).Own node := by
  obtain ⟨loan, found, active⟩ := own
  exact ⟨_, context.endOwn_found ended found, by simp [different, active]⟩

theorem Own.dispose_of_not_mem {context : Context} {payload : SourcePayload} {node : Nat}
    (own : context.Own node) (outside : node ∉ payload.nodes) : (context.dispose payload).Own node := by
  unfold Context.dispose
  have absent : node ∉ payload.nodes.reverse := by simpa using outside
  clear outside
  generalize payload.nodes.reverse = nodes at absent ⊢
  induction nodes generalizing context with
  | nil => exact own
  | cons ended nodes ih =>
    apply ih (own.endOwn_other (fun same => absent (by simp [same])))
    exact fun member => absent (by simp [member])

theorem Unobserved.endOwn {context : Context} {node ended : Nat}
    (unobserved : context.Unobserved program node) : (context.endOwn ended).Unobserved program node := by
  intro outer loan found own distinct payload target
  obtain ⟨original, previous, rfl⟩ := endOwn_original found
  have different : ended ≠ outer := by intro same; simp [same] at own
  have active : original.own = true := by simpa [different] using own
  exact unobserved outer original previous active distinct payload
    (target.storage_congr rfl)

theorem ObservedOwn.endOwn {context : Context} {ended : Nat}
    (observed : context.ObservedOwn program) (unobserved : context.Unobserved program ended) :
    (context.endOwn ended).ObservedOwn program := by
  intro outer loan found own payload target inner member
  obtain ⟨original, previous, rfl⟩ := endOwn_original found
  have different : ended ≠ outer := by intro same; simp [same] at own
  have active : original.own = true := by simpa [different] using own
  have targetBefore : context.TargetPayload program original.target original.referent payload :=
    target.storage_congr rfl
  apply (observed outer original previous active payload targetBefore inner member).endOwn_other
  intro equal
  subst inner
  exact unobserved outer original previous active (Ne.symm different) payload targetBefore member

theorem ObservedOwn.borrow {context : Context} {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (observed : context.ObservedOwn program)
    (targetOwn : ∀ payload, context.TargetPayload program target referent payload →
      ∀ node ∈ payload.nodes, context.Own node) :
    (context.borrow target referent parent mode).ObservedOwn program := by
  intro outer loan found own payload provenance inner member
  have previous : context.TargetPayload program loan.target loan.referent payload :=
    provenance.storage_congr rfl
  have innerOwn : context.Own inner := by
    rcases borrow_cases found with old | ⟨_, rfl⟩
    · exact observed outer loan old own payload previous inner member
    · exact targetOwn payload previous inner member
  obtain ⟨innerLoan, selected, active⟩ := innerOwn
  exact ⟨innerLoan, borrow_found selected, active⟩

theorem ObservedOwn.hide {context : Context} (observed : context.ObservedOwn program) :
    context.hide.ObservedOwn program := by
  intro outer loan found own payload target inner member
  exact observed outer loan found own payload (target.storage_congr rfl) inner member

theorem ObservedOwn.resume {caller after : Context} (observed : after.ObservedOwn program) :
    (caller.resume after).ObservedOwn program := by
  intro outer loan found own payload target inner member
  exact observed outer loan found own payload (target.storage_congr rfl) inner member

theorem ObservedOwn.bind {context : Context} (observed : context.ObservedOwn program)
    (valid : context.WellFormed program) (name : String) (mutable : Bool) (result : ResultType) :
    (context.bind name mutable result).ObservedOwn program := by
  intro outer loan found own payload target inner member
  have bounded := (valid.targets outer loan found).1
  have storage : context.storage loan.target.base = (context.bind name mutable result).storage loan.target.base := by
    cases base : loan.target.base with
    | binder binder =>
      have older : binder < context.nextBinder := by simpa [Origin.Bounded, base] using bounded
      simp [Context.bind, Nat.ne_of_lt older]
  exact observed outer loan found own payload (target.storage_congr storage) inner member

theorem TargetPayload.retire_original {context : Context} {origin : Origin} {type : Ty} {payload : SourcePayload}
    {count : Nat} (target : (context.retire count).TargetPayload program origin type payload) :
    context.TargetPayload program origin type payload := by
  cases target with
  | @cell slot referent payload stored path selected =>
    have previous : context.storage origin.base = some slot := by
      cases base : origin.base with
      | binder binder =>
        simp only [Context.retire, base] at stored
        split at stored
        · cases stored
        · exact stored
    exact .cell previous path selected

theorem ObservedOwn.retire {context : Context} (observed : context.ObservedOwn program) (count : Nat) :
    (context.retire count).ObservedOwn program := by
  intro outer loan found own payload target inner member
  exact observed outer loan found own payload target.retire_original inner member

theorem ObservedOwn.dispose {context : Context} {payload : SourcePayload} {held : List SourcePayload}
    (observed : context.ObservedOwn program) (legal : context.PayloadDisposable program held payload) :
    (context.dispose payload).ObservedOwn program :=
  NodesDisposable.fold legal observed (fun _ _ _ _ unobserved invariant => invariant.endOwn unobserved)

end Context

theorem payloadNodes_of_get {fields : List SourcePayload} {index node : Nat} {payload : SourcePayload}
    (selected : fields[index]? = some payload) (member : node ∈ payload.nodes) : node ∈ payloadNodes fields :=
  payloadNodes_mem.mpr ⟨payload, List.mem_of_getElem? selected, member⟩

theorem payloadNodes_set_cases {fields : List SourcePayload} {index node : Nat} {payload : SourcePayload}
    (member : node ∈ payloadNodes (fields.set index payload)) :
    node ∈ payloadNodes fields ∨ node ∈ payload.nodes := by
  induction fields generalizing index with
  | nil => simp [payloadNodes] at member
  | cons first fields ih =>
    cases index with
    | zero =>
      rcases List.mem_append.mp member with front | back
      · exact .inr front
      · exact .inl (List.mem_append_right _ back)
    | succ index =>
      rcases List.mem_append.mp member with front | back
      · exact .inl (List.mem_append_left _ front)
      · rcases ih back with old | fresh
        · exact .inl (List.mem_append_right _ old)
        · exact .inr fresh

@[simp] theorem payloadNodes_replicate_plain (count : Nat) : payloadNodes (List.replicate count .plain) = [] := by
  induction count <;> simp [List.replicate_succ, payloadNodes, SourcePayload.nodes, *]

theorem SourcePayload.select_nodes {before after : SourcePayload} {fields : List Nat}
    (selected : before.select fields = some after) {node : Nat} (member : node ∈ after.nodes) : node ∈ before.nodes := by
  induction fields generalizing before with
  | nil =>
    simp only [SourcePayload.select, Option.some.injEq] at selected
    subst after; exact member
  | cons index fields ih =>
    cases before with
    | plain =>
      simp only [SourcePayload.select, Option.some.injEq] at selected
      subst after; exact member
    | reference => simp [SourcePayload.select] at selected
    | aggregate head children =>
      simp only [SourcePayload.select] at selected
      obtain ⟨child, found, selected⟩ := Option.bind_eq_some_iff.mp selected
      exact payloadNodes_of_get found (ih selected)

theorem SourcePayload.Write.nodes_subset {type : Ty} {path : List Nat} {before replacement after : SourcePayload}
    (written : Write program type path before replacement after) {node : Nat} (member : node ∈ after.nodes) :
    node ∈ before.nodes ∨ node ∈ replacement.nodes := by
  induction written with
  | here => exact .inr member
  | aggregate projection selected nested ih =>
    rcases payloadNodes_set_cases member with old | changed
    · exact .inl old
    · rcases ih changed with old | fresh
      · exact .inl (payloadNodes_of_get selected old)
      · exact .inr fresh
  | plainExpand projection shape selected nested ih =>
    rcases payloadNodes_set_cases member with old | changed
    · simp at old
    · rcases ih changed with old | fresh
      · simp [SourcePayload.nodes] at old
      · exact .inr fresh

theorem SourcePayload.Write.select_nodes_frame {type : Ty} {path observed : List Nat}
    {before replacement after selected : SourcePayload}
    (written : Write program type path before replacement after) (read : after.select observed = some selected)
    {node : Nat} (member : node ∈ selected.nodes) :
    (∃ original, before.select observed = some original ∧ node ∈ original.nodes) ∨ node ∈ replacement.nodes := by
  induction written generalizing observed selected with
  | here => exact .inr (SourcePayload.select_nodes read member)
  | @aggregate type middle home key index path head fields child replacement updated projection found nested ih =>
    cases observed with
    | nil =>
      simp only [SourcePayload.select, Option.some.injEq] at read
      subst selected
      rcases (SourcePayload.Write.aggregate projection found nested).nodes_subset member with old | fresh
      · exact .inl ⟨_, by simp [SourcePayload.select], old⟩
      · exact .inr fresh
    | cons other rest =>
      by_cases same : other = index
      · subst other
        have bound := (List.getElem?_eq_some_iff.mp found).1
        have childRead : updated.select rest = some selected := by simpa [SourcePayload.select, bound] using read
        rcases ih childRead member with ⟨original, oldRead, oldMember⟩ | fresh
        · exact .inl ⟨original, by simp [SourcePayload.select, found, oldRead], oldMember⟩
        · exact .inr fresh
      · exact .inl ⟨selected, by simpa [SourcePayload.select, Ne.symm same] using read, member⟩
  | @plainExpand type middle home key index path head types replacement updated projection shape found nested ih =>
    cases observed with
    | nil =>
      simp only [SourcePayload.select, Option.some.injEq] at read
      subst selected
      rcases (SourcePayload.Write.plainExpand projection shape found nested).nodes_subset member with old | fresh
      · simp [SourcePayload.nodes] at old
      · exact .inr fresh
    | cons other rest =>
      by_cases same : other = index
      · subst other
        have bound := (List.getElem?_eq_some_iff.mp found).1
        have childRead : updated.select rest = some selected := by simpa [SourcePayload.select, bound] using read
        rcases ih childRead member with ⟨original, oldRead, oldMember⟩ | fresh
        · have old := SourcePayload.select_nodes oldRead oldMember
          simp [SourcePayload.nodes] at old
        · exact .inr fresh
      · have unchanged : (SourcePayload.aggregate head (List.replicate types.length .plain)).select (other :: rest) = some selected := by
          simpa [SourcePayload.select, Ne.symm same] using read
        have old := SourcePayload.select_nodes unchanged member
        simp [SourcePayload.nodes] at old

theorem SourcePayload.select_occurs {before after : SourcePayload} {fields path : List Nat} {node : Nat}
    (selected : before.select fields = some after) (occurrence : after.Occurs path node) :
    before.Occurs (fields ++ path) node := by
  induction fields generalizing before with
  | nil =>
    simp only [SourcePayload.select, Option.some.injEq] at selected
    subst before
    exact occurrence
  | cons index fields ih =>
    cases before with
    | plain =>
      simp only [SourcePayload.select, Option.some.injEq] at selected
      subst after
      cases occurrence
    | reference => simp [SourcePayload.select] at selected
    | aggregate head children =>
      simp only [SourcePayload.select] at selected
      obtain ⟨child, found, selected⟩ := Option.bind_eq_some_iff.mp selected
      exact .field found (ih selected)

theorem SourcePayload.Write.occurs_cases {type : Ty} {path observed : List Nat}
    {before replacement after : SourcePayload} (written : Write program type path before replacement after)
    {node : Nat} (occurrence : after.Occurs observed node) :
    (∃ suffix, observed = path ++ suffix ∧ replacement.Occurs suffix node) ∨
      (CoordinatesApart path observed ∧ before.Occurs observed node) := by
  induction written generalizing observed with
  | here => exact .inl ⟨observed, rfl, occurrence⟩
  | @aggregate type middle home key index path head fields child replacement updated projection found nested ih =>
    cases occurrence with
    | @field _ _ other payload rest _ selected occurrence =>
      by_cases same : other = index
      · subst other
        have bound := (List.getElem?_eq_some_iff.mp found).1
        have equal : updated = payload := by simpa [bound] using selected
        subst payload
        rcases ih occurrence with ⟨suffix, rfl, inside⟩ | ⟨apart, old⟩
        · exact .inl ⟨suffix, rfl, inside⟩
        · exact .inr ⟨.descend apart, .field found old⟩
      · have previous : fields[other]? = some payload := by simpa [Ne.symm same] using selected
        exact .inr ⟨.siblings (Ne.symm same), .field previous occurrence⟩
  | @plainExpand type middle home key index path head types replacement updated projection shape found nested ih =>
    cases occurrence with
    | @field _ _ other payload rest _ selected occurrence =>
      by_cases same : other = index
      · subst other
        have bound := (List.getElem?_eq_some_iff.mp found).1
        have equal : updated = payload := by simpa [bound] using selected
        subst payload
        rcases ih occurrence with ⟨suffix, rfl, inside⟩ | ⟨_, impossible⟩
        · exact .inl ⟨suffix, rfl, inside⟩
        · cases impossible
      · have previous : (List.replicate types.length SourcePayload.plain)[other]? = some payload := by
          simpa [Ne.symm same] using selected
        have equal : payload = .plain := List.eq_of_mem_replicate (List.mem_of_getElem? previous)
        subst payload
        cases occurrence

private theorem sourceApart_notPrefix {first second : List Nat} (apart : CoordinatesApart first second) :
    ¬ first.IsPrefix second := by
  induction apart with
  | siblings different => rintro ⟨suffix, equal⟩; exact different (List.cons.inj equal).1
  | descend apart ih => rintro ⟨suffix, equal⟩; exact ih ⟨suffix, (List.cons.inj equal).2⟩

theorem HeadType.referenceFreeFields {head : Head} {type : Ty} {fields : List Ty}
    (shape : HeadType program head type fields) (layout : ReferenceFreeLayout program.target program.data type) :
    ∀ field ∈ fields, ReferenceFreeLayout program.target program.data field := by
  cases shape with
  | unit | integer | character | reference => simp
  | tuple first rest =>
    cases layout with
    | tuple head tail => intro field member; rcases List.mem_cons.mp member with rfl | member; exact head; exact tail field member
  | array element length =>
    cases layout with
    | array elementLayout _ => intro field member; cases List.eq_of_mem_replicate member; exact elementLayout
  | @nominal identity tag declaration schema declared chosen =>
    intro type included
    obtain ⟨field, member, rfl⟩ := List.mem_map.mp included
    have schemaMember : schema ∈ declaration.schemas := by
      cases declaration with
      | mk home visibility shape restriction =>
        cases shape <;> cases tag <;> simp_all [DataDecl.constructor, DataDecl.schemas]
        exact List.mem_of_getElem? chosen
    cases layout with
    | nominal found schemas fields =>
      cases Option.some.inj (found.symm.trans declared)
      exact fields schema schemaMember field member

theorem SourcePayload.Typed.referenceFreeNodes {loans : List SourceLoan} {payload : SourcePayload} {type : Ty}
    (typed : payload.Typed program loans type) (layout : ReferenceFreeLayout program.target program.data type) :
    payload.nodes = [] := by
  induction typed using SourcePayload.Typed.rec
    (motive_2 := fun payloads types _ => (∀ type ∈ types, ReferenceFreeLayout program.target program.data type) → payloadNodes payloads = []) with
  | plain => rfl
  | reference => cases layout
  | aggregate source shape children ih => exact ih (shape.referenceFreeFields layout)
  | nil => rfl
  | cons head tail headIH tailIH =>
    rename_i layouts
    simp only [payloadNodes, headIH (layouts _ (by simp)), List.nil_append]
    exact tailIH (fun type member => layouts type (by simp [member]))

theorem SourcePayload.Joins.select_nodes_back {before after payload : SourcePayload} {fields : List Nat}
    (joined : before.Joins after) (selected : after.select fields = some payload) {node : Nat} (member : node ∈ payload.nodes) :
    ∃ previous, before.select fields = some previous ∧ node ∈ previous.nodes := by
  cases joined with
  | same => exact ⟨payload, selected, member⟩
  | plain empty =>
    cases fields <;> simp [SourcePayload.select] at selected
    all_goals cases selected; simp [SourcePayload.nodes] at member

namespace Context

theorem TargetPayload.nodes_eq {context : Context} {origin : Origin} {type : Ty} {first second : SourcePayload}
    (left : context.TargetPayload program origin type first) (right : context.TargetPayload program origin type second)
    : first.nodes = second.nodes := by
  cases left with
  | cell stored path selected =>
    cases right with
    | cell otherStored otherPath otherSelected =>
      cases Option.some.inj (stored.symm.trans otherStored)
      cases Option.some.inj (selected.symm.trans otherSelected)
      rfl

theorem ObservedOwn.borrowAvailable {context : Context} {target : Origin} {referent : Ty}
    {parent : Option Nat} {mode : BorrowMode} {payload : SourcePayload}
    (observed : context.ObservedOwn program)
    (provenance : context.TargetPayload program target referent payload) (available : context.PayloadAvailable payload) :
    (context.borrow target referent parent mode).ObservedOwn program := by
  apply observed.borrow
  intro other target node member
  exact (available node ((provenance.nodes_eq target).symm ▸ member)).1

theorem TargetPayload.join_nodes_back {before after : Context} (joined : Joins program before after)
    {origin : Origin} {type : Ty} {payload : SourcePayload}
    (target : after.TargetPayload program origin type payload) {node : Nat} (member : node ∈ payload.nodes) :
    ∃ previous, before.TargetPayload program origin type previous ∧ node ∈ previous.nodes := by
  cases target with
  | @cell slot type payload stored path selected =>
    obtain ⟨original, found, metadata, _⟩ := (joined.storage origin.base).backward stored
    have typeEq : slot.type = original.type := congrArg Prod.fst metadata
    have payloadJoin := (joined.storage origin.base).payloadJoins found stored
    obtain ⟨previous, oldSelected, oldMember⟩ := payloadJoin.select_nodes_back selected member
    exact ⟨previous, .cell found (typeEq ▸ path) oldSelected, oldMember⟩

theorem TargetPayload.writeTarget_nodes_back {context : Context} {changed origin : Origin}
    {slot : Slot} {next : Initialization} {replacement updated payload : SourcePayload} {type : Ty}
    (stored : context.storage changed.base = some slot)
    (written : SourcePayload.Write program slot.type changed.fields slot.payload replacement updated)
    (target : (context.writeTarget changed next updated).TargetPayload program origin type payload)
    {node : Nat} (member : node ∈ payload.nodes) :
    (∃ previous, context.TargetPayload program origin type previous ∧ node ∈ previous.nodes) ∨ node ∈ replacement.nodes := by
  cases target with
  | @cell current type payload currentStored path selected =>
    by_cases same : origin.base = changed.base
    · have equal : { slot with initialization := slot.initialization.write changed.fields next, payload := updated } = current := by
        simpa [Context.writeTarget, same, stored] using currentStored
      subst current
      rcases written.select_nodes_frame selected member with ⟨previous, oldRead, oldMember⟩ | fresh
      · exact .inl ⟨previous, .cell (slot := slot) (by simpa only [same] using stored) path oldRead, oldMember⟩
      · exact .inr fresh
    · have previous : context.storage origin.base = some current := by
        simpa [Context.writeTarget, same] using currentStored
      exact .inl ⟨payload, .cell previous path selected, member⟩

theorem TargetPayload.writeTarget_cut {context : Context} {changed origin : Origin}
    {slot : Slot} {next : Initialization} {replacement updated payload : SourcePayload} {type : Ty} {node : Nat}
    (stored : context.storage changed.base = some slot)
    (written : SourcePayload.Write program slot.type changed.fields slot.payload replacement updated)
    (cut : ∀ base resident fields, context.storage base = some resident → resident.payload.Occurs fields node →
      base = changed.base ∧ changed.fields.IsPrefix fields)
    (target : (context.writeTarget changed next updated).TargetPayload program origin type payload)
    (member : node ∈ payload.nodes) : node ∈ replacement.nodes := by
  cases target with
  | @cell current type payload currentStored path selected =>
    obtain ⟨suffix, occurrence⟩ := SourcePayload.mem_nodes_iff.mp member
    have rootOccurrence := SourcePayload.select_occurs selected occurrence
    by_cases same : origin.base = changed.base
    · have equal : { slot with initialization := slot.initialization.write changed.fields next, payload := updated } = current := by
        simpa [Context.writeTarget, same, stored] using currentStored
      subst current
      rcases written.occurs_cases rootOccurrence with ⟨rest, _, inside⟩ | ⟨apart, previous⟩
      · exact SourcePayload.mem_nodes_iff.mpr ⟨rest, inside⟩
      · exact False.elim (sourceApart_notPrefix apart (cut changed.base slot _ stored previous).2)
    · have previous : context.storage origin.base = some current := by
        simpa [Context.writeTarget, same] using currentStored
      exact False.elim (same (cut origin.base current _ previous rootOccurrence).1)

theorem ObservedOwn.assignTarget {context : Context} {origin : Origin} {slot : Slot}
    {next : Initialization} {old replacement updated : SourcePayload}
    (observed : context.ObservedOwn program) (stored : context.storage origin.base = some slot)
    (written : SourcePayload.Write program slot.type origin.fields slot.payload replacement updated)
    (cut : ∀ node ∈ old.nodes, context.Own node → ∀ base resident fields,
      context.storage base = some resident → resident.payload.Occurs fields node →
        base = origin.base ∧ origin.fields.IsPrefix fields)
    (available : (context.dispose old).PayloadAvailable replacement) :
    ((context.dispose old).writeTarget origin next updated).ObservedOwn program := by
  intro outer loan found own payload target inner member
  have priorLoan : context.loans[outer]? = some loan := dispose_active_record found own
  have beforeDisposal : (context.writeTarget origin next updated).TargetPayload program loan.target loan.referent payload :=
    target.storage_congr (by simp [Context.writeTarget])
  rcases beforeDisposal.writeTarget_nodes_back stored written member with ⟨previous, selected, oldMember⟩ | fresh
  · have owned := observed outer loan priorLoan own previous selected inner oldMember
    by_cases ended : inner ∈ old.nodes
    · have fresh := beforeDisposal.writeTarget_cut stored written (cut inner ended owned) member
      exact (available inner fresh).1
    · exact owned.dispose_of_not_mem ended
  · exact (available inner fresh).1

theorem ObservedOwn.writeTarget {context : Context} {origin : Origin} {slot : Slot}
    {next : Initialization} {replacement updated : SourcePayload}
    (observed : context.ObservedOwn program) (stored : context.storage origin.base = some slot)
    (written : SourcePayload.Write program slot.type origin.fields slot.payload replacement updated)
    (available : context.PayloadAvailable replacement) :
    (context.writeTarget origin next updated).ObservedOwn program := by
  intro outer loan found own payload target inner member
  rcases target.writeTarget_nodes_back stored written member with ⟨previous, selected, member⟩ | fresh
  · exact observed outer loan found own previous selected inner member
  · exact (available inner fresh).1

theorem ObservedOwn.joins {before after : Context} (observed : before.ObservedOwn program)
    (joined : Joins program before after) : after.ObservedOwn program := by
  intro outer loan found own payload target inner member
  obtain ⟨previous, selected, member⟩ := target.join_nodes_back joined member
  have active := observed outer loan (joined.loans ▸ found) own previous selected inner member
  simpa only [Context.Own, joined.loans] using active

end Context

end Grounded

/- Section: StateEffects -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}
namespace StateTyped
variable {interpretation : Interpretation} {context : Context} {heldPayloads : List SourcePayload}
variable {environment : Environment} {held : List Value}

theorem borrow (typed : StateTyped program interpretation context heldPayloads environment held)
    {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (known : target.Known context) (bounded : target.Bounded context)
    (finite : FiniteLayout program.target program.data referent)
    (ancestor : ∀ node, parent = some node → ∃ loan, context.loans[node]? = some loan ∧ target.Within loan.target)
    (parentMode : ∀ node loan, parent = some node → context.loans[node]? = some loan → mode = .unique → loan.mode = .unique)
    (sourceTarget : context.SourceTarget program ⟨target, referent, parent, true, mode⟩)
    (ready : context.Ready target)
    (targetOwn : ∀ payload, context.TargetPayload program target referent payload → ∀ node ∈ payload.nodes, context.Own node) :
    StateTyped program (interpretation.addNode context.loans.length environment.loans.length)
      (context.borrow target referent parent mode) (heldPayloads ++ [.reference context.loans.length])
      (environment.addLoan ⟨interpretation.origin target, parent.map interpretation.node⟩ mode)
      (held ++ [.reference environment.loans.length]) := by
  refine {
    toStoreTyped := typed.toStoreTyped.borrow known bounded finite ancestor parentMode sourceTarget
    heldShape := ?_
    heldOwn := ?_
    heldReady := ?_
    observedOwn := typed.observedOwn.borrow targetOwn
    custody := typed.custody.borrow (fun _ _ carrier => typed.carrierBound carrier) _ _ }
  · have previous := typed.heldShape.congr (right := (interpretation.addNode context.loans.length environment.loans.length).node)
      (fun node member => by
        obtain ⟨loan, found, _⟩ := typed.heldOwn node member
        exact (interpretation.addNode_old (List.getElem?_eq_some_iff.mp found).1).symm)
    apply previous.append
    exact .cons (by simpa only [Interpretation.addNode, ↓reduceIte] using
      (SourcePayload.Corresponds.reference (node := (interpretation.addNode context.loans.length environment.loans.length).node) context.loans.length)) .nil
  · intro node member
    simp only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.append_nil, List.mem_append, List.mem_singleton] at member
    rcases member with old | rfl
    · obtain ⟨loan, found, own⟩ := typed.heldOwn node old
      exact ⟨loan, Context.borrow_found found, own⟩
    · exact ⟨_, Context.borrow_last context target referent parent mode, rfl⟩
  · intro node member
    simp only [payloadNodes_append, payloadNodes, SourcePayload.nodes, List.append_nil, List.mem_append, List.mem_singleton] at member
    rcases member with old | rfl
    · obtain ⟨loan, found, _⟩ := typed.heldOwn node old
      exact (typed.heldReady node old).borrow (List.getElem?_eq_some_iff.mp found).1 target referent parent mode
    · intro loan found _
      cases Option.some.inj ((Context.borrow_last context target referent parent mode).symm.trans found)
      exact ready

theorem endOwn (typed : StateTyped program interpretation context heldPayloads environment held)
    {node : Nat} {loan : SourceLoan} (found : context.loans[node]? = some loan)
    (unprotected : node ∉ payloadNodes heldPayloads) (unobserved : context.Unobserved program node) :
    ∃ after, environment.endOwn (interpretation.node node) = some after ∧
      StateTyped program interpretation (context.endOwn node) heldPayloads after held := by
  obtain ⟨after, step, stored⟩ := typed.toStoreTyped.endOwn found
  exact ⟨after, step, { stored with
    heldShape := typed.heldShape
    heldOwn := fun other included => (typed.heldOwn other included).endOwn_other (fun same => unprotected (same ▸ included))
    heldReady := fun other included => (typed.heldReady other included).endOwn node
    observedOwn := typed.observedOwn.endOwn unobserved
    custody := typed.custody.endOwn step }⟩

theorem consumeReference {node : Nat}
    (typed : StateTyped program interpretation context (heldPayloads ++ [.reference node]) environment
      (held ++ [.reference (interpretation.node node)]))
    (unprotected : node ∉ payloadNodes heldPayloads) (unobserved : context.Unobserved program node) :
    ∃ after, environment.endOwn (interpretation.node node) = some after ∧
      StateTyped program interpretation (context.endOwn node) heldPayloads after held := by
  have member : node ∈ payloadNodes (heldPayloads ++ [.reference node]) := by simp [payloadNodes_append, payloadNodes, SourcePayload.nodes]
  obtain ⟨loan, found, _⟩ := typed.heldOwn node member
  obtain ⟨after, step, stored⟩ := typed.toStoreTyped.endOwn found
  have length : heldPayloads.length = held.length := by
    have total := typed.heldShape.length
    simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using total
  have front := (typed.heldShape.append_inv length).1
  exact ⟨after, step, { stored with
    heldShape := front
    heldOwn := fun other included => (typed.heldOwn other (by simp [payloadNodes_append, included])).endOwn_other
      (fun same => unprotected (same ▸ included))
    heldReady := fun other included => (typed.heldReady other (by simp [payloadNodes_append, included])).endOwn node
    observedOwn := typed.observedOwn.endOwn unobserved
    custody := typed.custody.disposePending (program := program) (.reference (typed.toStoreTyped.restored found (typed.heldReady node member)) step) }⟩

theorem bind {value : Value} {result : ResultType}
    (typed : StateTyped program interpretation context (heldPayloads ++ [result.payload]) environment (held ++ [value]))
    (resident : ResultTyped program interpretation context result value) (name : String) (mutable : Bool) :
    StateTyped program (interpretation.addBinder context.nextBinder environment.nextRoot)
      (context.bind name mutable result) heldPayloads (environment.bind name value) held := by
  have length : heldPayloads.length = held.length := by
    have total := typed.heldShape.length
    simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using total
  refine {
    toStoreTyped := typed.toStoreTyped.bind resident name mutable
    heldShape := (typed.heldShape.append_inv length).1
    heldOwn := fun node member => typed.heldOwn node (by simp [payloadNodes_append, member])
    heldReady := ?_
    observedOwn := typed.observedOwn.bind typed.source name mutable result
    custody := typed.custody.bindValue typed.residents.valid name }
  intro node member loan found own
  have ready := typed.heldReady node (by simp [payloadNodes_append, member]) loan found own
  have bounded := (typed.source.targets node loan found).1
  cases base : loan.target.base with
  | binder binder =>
    have older : binder < context.nextBinder := by simpa [Origin.Bounded, base] using bounded
    simpa only [Context.Ready, Context.bind, base, OriginBase.binder.injEq, if_neg (Nat.ne_of_lt older)] using ready

end StateTyped
end Grounded

/- Section: StorageRetire -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem SlotsCorrespond.roots {interpretation : Interpretation} {store : Store}
    {bindings : List (String × Root)} {slots : List (String × Slot)}
    (typed : SlotsCorrespond interpretation store bindings slots) :
    bindings.map Prod.snd = slots.map (fun binding => interpretation.binder binding.2.binder) := by
  induction typed with
  | nil => rfl
  | cons identity resident rest ih => simp [identity, ih]

theorem StoreTyped.retire {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) (count : Nat)
    (free : ∀ root ∈ (environment.bindings.take count).map Prod.snd, environment.OwnerFree ⟨root, []⟩) :
    StoreTyped program interpretation (context.retire count) (environment.retire count) := by
  have cells : ∀ binder slot, (context.retire count).storage (.binder binder) = some slot →
      ∃ value, (environment.retire count).store (interpretation.binder binder) = some value ∧
        SlotTyped program value slot.toBindingType ∧ slot.Corresponds interpretation value := by
    intro binder slot stored
    simp only [Context.retire] at stored
    split at stored
    · cases stored
    · rename_i absent
      obtain ⟨value, found, resident, corresponds⟩ := typed.cells binder slot stored
      have outside : interpretation.binder binder ∉ (environment.bindings.take count).map Prod.snd := by
        intro included
        rw [List.map_take, typed.slots.roots, ← List.map_take] at included
        obtain ⟨binding, member, equal⟩ := List.mem_map.mp included
        have identity := typed.binderDistinct binding.2.binder binder
          (typed.source.member_known binding (List.mem_of_mem_take member)) (.inl ⟨slot, stored⟩) equal
        apply absent
        rw [List.map_take, ← typed.source.bindings_binders, ← List.map_take]
        exact List.mem_map.mpr ⟨binding, member, identity⟩
      exact ⟨value, by simpa only [Environment.retire, if_neg outside] using found, resident, corresponds⟩
  have source := typed.source.retire count
  have names : (environment.retire count).bindings = (context.retire count).names.map
      (fun entry => (entry.1, interpretation.binder entry.2)) := by
    simp only [Environment.retire, Context.retire, List.map_drop]
    congr 1
    rw [← typed.source.bindings_names, List.map_map, typed.slots.bindings]
    rfl
  obtain ⟨residents, slots⟩ := Context.reconstruct source (typed.residents.valid.retire count) names cells
  refine { typed with
    source := source, residents := residents, slots := slots, cells := cells
    binderBound := ?_, binderDistinct := ?_
    sourceTargets := ?_, storeShape := ?_ }
  · intro binder known
    exact typed.binderBound binder (Context.retire_mentions known)
  · intro first second firstKnown secondKnown same
    exact typed.binderDistinct first second (Context.retire_mentions firstKnown) (Context.retire_mentions secondKnown) same
  · intro node loan found own
    apply (typed.sourceTargets node loan found own).storage_congr
    cases base : loan.target.base with
    | binder binder =>
      have outside : binder ∉ (context.names.take count).map Prod.snd := by
        intro removed
        have runtimeRemoved : interpretation.binder binder ∈ (environment.bindings.take count).map Prod.snd := by
          rw [List.map_take, typed.slots.roots]
          have included : interpretation.binder binder ∈ ((context.names.take count).map Prod.snd).map interpretation.binder :=
            List.mem_map.mpr ⟨binder, removed, rfl⟩
          simpa only [List.map_take, ← typed.source.bindings_binders, List.map_map, Function.comp_def] using included
        have apart := free _ runtimeRemoved (interpretation.node node) _ (typed.records node loan found) own
        simp only [Address.Apart, Interpretation.origin, base] at apart
        rcases apart with different | fields
        · exact different rfl
        · cases fields
      simp only [Context.retire, if_neg outside]
  · intro root value stored
    simp only [Environment.retire] at stored
    split at stored
    · cases stored
    · exact typed.storeShape root value stored
end Grounded

/- Section: StorageTransitions -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem StoreTyped.writeTarget {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {origin : Origin} {binder : Nat} {slot : Slot}
    {referent : Ty} {next state : Initialization} {replacement : Value} {payload updatedPayload : SourcePayload}
    (base : origin.base = .binder binder) (stored : context.storage (.binder binder) = some slot)
    (path : CanonicalPath program slot.type origin.fields referent)
    (access : slot.initialization.Access origin.fields state)
    (resident : ResidentTyped program next replacement referent)
    (write : SourcePayload.Write program slot.type origin.fields slot.payload payload updatedPayload)
    (payloadTyped : payload.Typed program context.loans referent)
    (related : payload.Corresponds interpretation.node replacement)
    {node : Nat} {loan : SourceLoan} (found : context.loans[node]? = some loan)
    (own : loan.own = true) (unique : loan.mode = .unique) (within : origin.Within loan.target)
    (permitted : context.Permits .unique (some node) origin) :
    ∃ after, environment.writeAddress (interpretation.origin origin) replacement = some after ∧
      StoreTyped program interpretation (context.writeTarget origin next updatedPayload) after ∧
      environment.Evolution after := by
  obtain ⟨after, written, afterTyped⟩ := typed.writeTarget_preserves base stored path access resident write payloadTyped related (by
    intro other otherLoan selected active
    rcases permitted other otherLoan selected active with impossible | ⟨parent, equal, derived⟩ | apart
    · cases impossible.1
    · cases Option.some.inj equal
      have above := Context.Derived.targetWithin typed.source derived found selected
      exact .inl ⟨⟨within.1.trans above.1, above.2.trans within.2⟩, derived.unique typed.source found selected unique⟩
    · exact .inr apart)
  have authority : environment.MutationRoot (interpretation.origin origin).root :=
    .inr ⟨interpretation.node node, _, typed.records node loan found, own, unique,
      (interpretation.within within).1.symm⟩
  exact ⟨after, written, afterTyped, (Environment.writeAddress_evolution authority written typed.residents.valid).2⟩

theorem StoreTyped.writeOwner {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {origin : Origin} {binder : Nat} {slot : Slot}
    {referent : Ty} {next state : Initialization} {replacement : Value} {payload updatedPayload : SourcePayload}
    (base : origin.base = .binder binder) (stored : context.storage (.binder binder) = some slot)
    (path : CanonicalPath program slot.type origin.fields referent)
    (access : slot.initialization.Access origin.fields state)
    (resident : ResidentTyped program next replacement referent)
    (write : SourcePayload.Write program slot.type origin.fields slot.payload payload updatedPayload)
    (payloadTyped : payload.Typed program context.loans referent)
    (related : payload.Corresponds interpretation.node replacement)
    (visible : binder ∈ context.names.map Prod.snd) (free : context.Free origin) :
    ∃ after, environment.writeAddress (interpretation.origin origin) replacement = some after ∧
      StoreTyped program interpretation (context.writeTarget origin next updatedPayload) after ∧
      environment.Evolution after := by
  obtain ⟨after, written, afterTyped⟩ := typed.writeTarget_preserves base stored path access resident write payloadTyped related
    (fun node loan found own => .inr (free node loan found own))
  have authority : environment.MutationRoot (interpretation.origin origin).root := by
    apply Or.inl
    simp only [Environment.roots, Interpretation.origin, base]
    rw [← typed.source.bindings_binders, List.mem_map] at visible
    rw [typed.slots.roots, List.mem_map]
    obtain ⟨binding, member, equal⟩ := visible
    exact ⟨binding, member, congrArg interpretation.binder equal⟩
  exact ⟨after, written, afterTyped, (Environment.writeAddress_evolution authority written typed.residents.valid).2⟩

theorem StoreTyped.hide {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) :
    StoreTyped program interpretation context.hide environment.hide := by
  refine { typed with
    source := typed.source.hide
    residents := ⟨typed.residents.valid.hide, [], .nil, .nil⟩
    slots := .nil }

theorem StoreTyped.resume {first last : Interpretation} {callerContext afterContext : Context} {caller after : Environment}
    (callerTyped : StoreTyped program first callerContext caller)
    (afterTyped : StoreTyped program last afterContext after)
    (history : callerContext.hide.History afterContext)
    (binders : ∀ binder, binder < callerContext.nextBinder → last.binder binder = first.binder binder)
    (supply : caller.nextRoot ≤ after.nextRoot) :
    StoreTyped program last (callerContext.resume afterContext) (caller.resume after) := by
  have source := callerTyped.source.resume afterTyped.source history
  have names : (caller.resume after).bindings = (callerContext.resume afterContext).names.map
      (fun entry => (entry.1, last.binder entry.2)) := by
    change caller.bindings = callerContext.names.map _
    rw [← callerTyped.source.bindings_names, List.map_map, callerTyped.slots.bindings]
    apply List.map_congr_left
    intro binding member
    have same := binders binding.2.binder
      (callerTyped.source.mentionedBound (callerTyped.source.member_known binding member))
    simp only [Function.comp_def, same]
  obtain ⟨residents, slots⟩ := Context.reconstruct source
    (callerTyped.residents.valid.resume afterTyped.residents.valid supply) names afterTyped.cells
  exact { afterTyped with source := source, residents := residents, slots := slots }

end Grounded

/- Section: StorageDispose -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem StoreTyped.dispose {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {payload : SourcePayload} {value : Value}
    (related : payload.Corresponds interpretation.node value)
    (bound : ∀ node ∈ payload.nodes, node < context.loans.length)
    (ready : ∀ node ∈ payload.nodes, context.Restored node)
    (allowed : value.Disposable program) :
    ∃ after, Environment.Disposes program environment value after ∧
      StoreTyped program interpretation (context.dispose payload) after := by
  induction related using SourcePayload.Corresponds.rec
    (motive_2 := fun payloads values _ => ∀ {context : Context} {environment : Environment},
      StoreTyped program interpretation context environment →
      (∀ node ∈ payloadNodes payloads, node < context.loans.length) →
      (∀ node ∈ payloadNodes payloads, context.Restored node) →
      (∀ value ∈ values, value.Disposable program) →
      ∃ after, Environment.DisposesFields program environment values after ∧
        StoreTyped program interpretation (context.dispose (.aggregate .tuple payloads)) after)
    generalizing context environment with
  | plain free => exact ⟨environment, .data free allowed.destroys, typed⟩
  | reference identity =>
    have bounded := bound identity (by simp [SourcePayload.nodes])
    have found := List.getElem?_eq_getElem bounded
    obtain ⟨after, ended, afterTyped⟩ := typed.endOwn found
    exact ⟨after, .reference (typed.restored found (ready identity (by simp [SourcePayload.nodes]))) ended, afterTyped⟩
  | @aggregate head fields value source constructor children ih =>
    subst head
    cases value with
    | vacant | unit | integer | character =>
      cases children
      exact ⟨environment, .data (by trivial) allowed.destroys, typed⟩
    | reference => exact False.elim source
    | tuple first rest =>
      obtain ⟨after, disposed, afterTyped⟩ := ih typed bound ready allowed.children
      exact ⟨after, .tuple allowed disposed, afterTyped⟩
    | array values =>
      obtain ⟨after, disposed, afterTyped⟩ := ih typed bound ready allowed.children
      exact ⟨after, .array allowed disposed, afterTyped⟩
    | nominal identity tag values =>
      obtain ⟨after, disposed, afterTyped⟩ := ih typed bound ready allowed.children
      exact ⟨after, .nominal allowed disposed, afterTyped⟩
  | nil => rename_i context environment typed _ _ _; exact ⟨environment, .nil, typed⟩
  | @cons payload payloads value values head tail ihHead ihTail =>
    rename_i context environment typed bound ready allowed
    obtain ⟨middle, tailDisposed, middleTyped⟩ := ihTail typed
      (fun node member => bound node (by simp [payloadNodes, member]))
      (fun node member => ready node (by simp [payloadNodes, member]))
      (fun value member => allowed value (by simp [member]))
    obtain ⟨after, headDisposed, afterTyped⟩ := ihHead middleTyped
      (fun node member => by simpa using bound node (by simp [payloadNodes, member]))
      (fun node member => (ready node (by simp [payloadNodes, member])).dispose (.aggregate .tuple payloads))
      (allowed value (by simp))
    refine ⟨after, .cons tailDisposed headDisposed, ?_⟩
    simpa only [Context.dispose, SourcePayload.nodes, payloadNodes, List.reverse_append, List.foldl_append] using afterTyped

theorem ResidentTyped.fully_initialized {state : Initialization} {value : Value} {type : Ty}
    (typed : ResidentTyped program state value type) (live : value.initialized = true) : ValueHasType program value type := by
  induction typed using ResidentTyped.rec
    (motive_2 := fun states values types _ => valuesInitialized values = true → ValuesHaveTypes program values types) with
  | vacant => simp [Value.initialized] at live
  | uncertain actual permission ih => exact ih live
  | unit => exact .unit
  | integer fits => exact .integer fits
  | character valid => exact .character valid
  | reference node finite => exact .reference node finite
  | tuple head tail present headIH tailIH =>
    simp only [Value.initialized, Bool.and_eq_true] at live
    exact .tuple (headIH live.1) (tailIH live.2)
  | array residents finite size present ih => exact .array (ih (by simpa [Value.initialized] using live)) finite size
  | nominal declared chosen finite residents present ih => exact .nominal declared chosen finite (ih (by simpa [Value.initialized] using live))
  | nil => exact .nil
  | cons head tail headIH tailIH =>
    rename_i live
    simp only [valuesInitialized, Bool.and_eq_true] at live
    exact .cons (headIH live.1) (tailIH live.2)

theorem Value.Disposable.not_live_exact_nominal {identity : Nat} {tag : Option Nat} {fields : List Value} {declaration : DataDecl}
    (declared : program.data identity = some declaration) (restriction : declaration.restriction = some .exact)
    (live : (Value.nominal identity tag fields).initialized = true) :
    ¬ Value.Disposable program (.nominal identity tag fields) := by
  intro disposable
  cases disposable with
  | owned typed permitted =>
    cases typed.fully_initialized live with
    | nominal found chosen finite residents present => exact permitted.nominal_restriction declared restriction
  | nominal found structureOnly incomplete fields => simp [live] at incomplete

theorem Initialization.Access.full (indices : List Nat) : Initialization.Access .full indices .full := by
  induction indices with
  | nil => exact .here .full
  | cons index indices ih => exact .child (by trivial) ih

theorem ResidentTyped.hole_uninitialized {state : Initialization} {value : Value} {type : Ty}
    (typed : ResidentTyped program state value type) (hole : state.Hole program type) : value.initialized = false := by
  obtain ⟨home, keys, indices, target, path, access⟩ := hole
  obtain ⟨_, vacancy, selected, vacantTyped⟩ := path.resident typed access
  have absent := ResidentTyped.vacant_value vacantTyped
  subst vacancy
  cases live : value.initialized with
  | false => rfl
  | true =>
    obtain ⟨_, resident, found, residentTyped⟩ := path.resident (typed.fully_initialized live) (Initialization.Access.full indices)
    have same := Option.some.inj (selected.symm.trans found)
    subst resident
    have impossible := (residentTyped.complete .full).2
    simp [Value.initialized] at impossible
theorem StorageDisposition.realized {state : Initialization} {type : Ty} {value : Value}
    (disposition : StorageDisposition program state type) (typed : ResidentTyped program state value type) : Value.Disposable program value := by
  induction disposition using StorageDisposition.rec
    (motive_2 := fun states types _ => ∀ values, ResidentsTyped program states values types → ∀ value ∈ values, Value.Disposable program value)
    generalizing value with
  | vacant => have same := ResidentTyped.vacant_value typed; subst value; exact .vacant
  | whole permission => exact .owned typed permission
  | tuple hole fields ih =>
    have incomplete := typed.hole_uninitialized hole
    cases typed with
    | vacant => exact .vacant
    | uncertain actual permission => exact .owned actual permission
    | tuple head tail present =>
      have children := ih _ (.cons head tail)
      exact .tuple incomplete (children _ (List.mem_cons_self ..)) (fun value member => children value (List.mem_cons_of_mem _ member))
  | @nominal state identity declaration schema declared structureOnly hole fields ih =>
    have incomplete := typed.hole_uninitialized hole
    cases typed with
    | vacant => exact .vacant
    | uncertain actual permission => exact .owned actual permission
    | @nominal _ _ tag otherDeclaration otherSchema values found chosen finite residents present =>
      have same := Option.some.inj (found.symm.trans declared)
      subst otherDeclaration
      cases tag with
      | some tag => simp [DataDecl.constructor, structureOnly] at chosen
      | none =>
        have sameSchema : otherSchema = schema := by simpa [DataDecl.constructor, structureOnly] using chosen.symm
        subst otherSchema
        exact .nominal declared structureOnly incomplete (ih _ residents)
  | nil =>
    rename_i values typed value included
    cases typed
    cases included
  | cons head tail headIH tailIH =>
    rename_i values typed value included
    cases typed with
    | cons first rest =>
      rcases List.mem_cons.mp included with rfl | member
      · exact headIH first
      · exact tailIH _ rest value member
theorem StorageDisposition.live_requires_discard {state : Initialization} {type : Ty} {value : Value}
    (disposition : StorageDisposition program state type) (typed : ResidentTyped program state value type)
    (live : value.initialized = true) : MayDiscard program.data type := by
  cases disposition with
  | vacant => have same := ResidentTyped.vacant_value typed; subst value; simp [Value.initialized] at live
  | whole permission => exact permission
  | tuple hole fields => have absent := typed.hole_uninitialized hole; simp [live] at absent
  | nominal declared structureOnly hole fields => have absent := typed.hole_uninitialized hole; simp [live] at absent

theorem SlotTyped.disposable {value : Value} {slot : BindingType}
    (typed : SlotTyped program value slot) (allowed : slot.Disposable program) : value.Disposable program :=
  StorageDisposition.realized allowed typed

end Grounded

/- Section: StateDispose -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}


theorem StateTyped.disposeResult {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value} {value : Value} {result : ResultType}
    (typed : StateTyped program interpretation context (heldPayloads ++ [result.payload]) environment (held ++ [value]))
    (resident : ResultTyped program interpretation context result value)
    (drop : MayDiscard program.data result.type) (legal : context.PayloadDisposable program heldPayloads result.payload) :
    ∃ after, Environment.Disposes program environment value after ∧
      StateTyped program interpretation (context.dispose result.payload) heldPayloads after held := by
  obtain ⟨after, disposed, stored⟩ := typed.toStoreTyped.dispose resident.corresponds (fun _ member => resident.payload.node_bound member)
    legal.restored (resident.resident.disposable drop)
  have length : heldPayloads.length = held.length := by
    have total := typed.heldShape.length
    simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using total
  exact ⟨after, disposed, { stored with
    heldShape := (typed.heldShape.append_inv length).1
    heldOwn := fun node member => (typed.heldOwn node (by simp [payloadNodes_append, member])).dispose_of_not_mem
      (fun old => legal.excludes node old member)
    heldReady := fun node member => (typed.heldReady node (by simp [payloadNodes_append, member])).dispose result.payload
    observedOwn := typed.observedOwn.dispose legal
    custody := typed.custody.disposePending disposed }⟩

theorem StateTyped.disposeResident {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value} {value : Value} {payload : SourcePayload} {type : Ty}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    (payloadTyped : payload.Typed program context.loans type) (related : payload.Corresponds interpretation.node value)
    (allowed : value.Disposable program) (legal : context.PayloadDisposable program heldPayloads payload) :
    ∃ after, Environment.Disposes program environment value after ∧
      StateTyped program interpretation (context.dispose payload) heldPayloads after held := by
  obtain ⟨after, disposed, stored⟩ := typed.toStoreTyped.dispose related (fun _ member => payloadTyped.node_bound member)
    legal.restored allowed
  exact ⟨after, disposed, { stored with
    heldShape := typed.heldShape
    heldOwn := fun node member => (typed.heldOwn node member).dispose_of_not_mem (fun old => legal.excludes node old member)
    heldReady := fun node member => (typed.heldReady node member).dispose payload
    observedOwn := typed.observedOwn.dispose legal
    custody := typed.custody.dispose disposed }⟩

theorem StateTyped.hide {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held) :
    StateTyped program interpretation context.hide heldPayloads environment.hide held :=
  { typed.toStoreTyped.hide with
    heldShape := typed.heldShape
    heldOwn := typed.heldOwn
    heldReady := typed.heldReady
    observedOwn := typed.observedOwn.hide
    custody := typed.custody }

theorem StateTyped.resume {first last : Interpretation} {callerContext afterContext : Context} {caller after : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (callerTyped : StoreTyped program first callerContext caller)
    (afterTyped : StateTyped program last afterContext heldPayloads after held)
    (progress : StateProgress callerContext.hide afterContext caller.hide after first last)
    (supply : caller.nextRoot ≤ after.nextRoot) :
    StateTyped program last (callerContext.resume afterContext) heldPayloads (caller.resume after) held :=
  { callerTyped.resume afterTyped.toStoreTyped progress.history progress.interpretation.binders supply with
    heldShape := afterTyped.heldShape
    heldOwn := afterTyped.heldOwn
    heldReady := afterTyped.heldReady
    observedOwn := afterTyped.observedOwn.resume
    custody := afterTyped.custody }

end Grounded

/- Section: StateCleanup -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

def Context.Cleanable (program : Program) (held : List SourcePayload) : Context → List (String × Slot) → Prop
  | _, [] => True
  | context, (_, slot) :: slots =>
      slot.toBindingType.Disposable program ∧ context.Free ⟨.binder slot.binder, []⟩ ∧
      context.PayloadDisposable program held slot.payload ∧
      Context.Cleanable program held (context.dispose slot.payload) slots

theorem StoreTyped.member {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {binding : String × Slot}
    (member : binding ∈ context.bindings) :
    ∃ value, environment.store (interpretation.binder binding.2.binder) = some value ∧
      SlotTyped program value binding.2.toBindingType ∧ binding.2.Corresponds interpretation value := by
  obtain ⟨entry, _, mapped⟩ := List.mem_filterMap.mp member
  obtain ⟨slot, stored, same⟩ := Option.map_eq_some_iff.mp mapped
  cases same
  exact typed.cells slot.binder slot (by rw [(typed.source.allocated entry.2 slot stored).1]; exact stored)

theorem StateTyped.disposeSlot {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held) {binding : String × Slot}
    (member : binding ∈ context.bindings) (allowed : binding.2.toBindingType.Disposable program)
    (legal : context.PayloadDisposable program heldPayloads binding.2.payload) :
    ∃ value after, environment.store (interpretation.binder binding.2.binder) = some value ∧
      Environment.Disposes program environment value after ∧
      StateTyped program interpretation (context.dispose binding.2.payload) heldPayloads after held := by
  obtain ⟨value, stored, resident, related⟩ := typed.toStoreTyped.member member
  obtain ⟨after, disposed, afterTyped⟩ := typed.disposeResident (typed.source.slots binding member).2 related
    (resident.disposable allowed) legal
  exact ⟨value, after, stored, disposed, afterTyped⟩

theorem Environment.Disposes.ownerFree {before after : Environment} {value : Value}
    (disposed : Disposes program before value after) {address : Address} (free : before.OwnerFree address) :
    after.OwnerFree address := by
  intro node loan found own
  exact free node loan (disposed.active found own).1 own

theorem DisposesRoots.ownerFree {before after : Environment} {roots : List Root} {trace : List (Root × List Nat)}
    (disposed : DisposesRoots program before roots trace after) {address : Address} (free : before.OwnerFree address) :
    after.OwnerFree address := by
  induction disposed with
  | nil => exact free
  | cons found allowed head tail ih => exact ih (head.ownerFree free)

theorem DisposesRoots.freed {before after : Environment} {roots : List Root} {trace : List (Root × List Nat)}
    (disposed : DisposesRoots program before roots trace after) :
    ∀ root ∈ roots, after.OwnerFree ⟨root, []⟩ := by
  induction disposed with
  | nil => simp
  | cons found allowed head tail ih =>
    intro root member
    rcases List.mem_cons.mp member with rfl | member
    · exact tail.ownerFree (head.ownerFree allowed)
    · exact ih root member

theorem StateTyped.disposeSlots {interpretation : Interpretation} {context : Context}
    {heldPayloads : List SourcePayload} {environment : Environment} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held) {slots : List (String × Slot)}
    (members : ∀ binding ∈ slots, binding ∈ context.bindings)
    (allowed : context.Cleanable program heldPayloads slots) :
    ∃ after trace, DisposesRoots program environment (slots.map fun binding => interpretation.binder binding.2.binder) trace after ∧
      StateTyped program interpretation (context.disposeSlots slots) heldPayloads after held := by
  induction slots generalizing context environment with
  | nil => exact ⟨environment, [], .nil, typed⟩
  | cons binding slots ih =>
    obtain ⟨drop, free, legal, rest⟩ := allowed
    have member := members binding (by simp)
    have known : (Origin.mk (.binder binding.2.binder) []).Known context := typed.source.member_known binding member
    have runtimeFree := typed.toStoreTyped.ownerFree known free
    obtain ⟨value, middle, found, disposed, middleTyped⟩ := typed.disposeSlot member drop legal
    have tailMembers : ∀ slot ∈ slots, slot ∈ (context.dispose binding.2.payload).bindings := by
      intro slot included
      simpa only [Context.dispose_bindings] using members slot (by simp [included])
    obtain ⟨after, trace, tail, afterTyped⟩ := ih middleTyped tailMembers rest
    exact ⟨after, _, .cons found runtimeFree disposed tail, afterTyped⟩

theorem Context.Ready.retire {context : Context} {origin : Origin} {referent : Ty} {count : Nat}
    (ready : context.Ready origin) (target : (context.retire count).Target program origin referent) :
    (context.retire count).Ready origin := by
  cases base : origin.base with
  | binder binder =>
    simp only [Context.Target, base] at target
    obtain ⟨slot, stored, _⟩ := target
    have outside : binder ∉ (context.names.take count).map Prod.snd := by
      intro removed
      simp only [Context.retire, if_pos removed] at stored
      cases stored
    simpa only [Context.Ready, base, Context.retire, if_neg outside] using ready

theorem StateTyped.cleanup {interpretation : Interpretation} {context : Context}
    {heldPayloads : List SourcePayload} {environment : Environment} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held) (count : Nat)
    (allowed : context.Cleanable program heldPayloads (context.bindings.take count)) :
    ∃ after trace, Cleans program count environment trace after ∧
      StateTyped program interpretation (context.cleanup count) heldPayloads after held := by
  obtain ⟨disposed, trace, destroyed, disposedTyped⟩ := typed.disposeSlots
    (fun _ member => List.mem_of_mem_take member) allowed
  have roots : (environment.bindings.take count).map Prod.snd =
      (context.bindings.take count).map (fun binding => interpretation.binder binding.2.binder) := by
    rw [List.map_take, typed.slots.roots, ← List.map_take]
  have destroyedRoots : DisposesRoots program environment ((environment.bindings.take count).map Prod.snd) trace disposed := by
    simpa only [roots] using destroyed
  have cleaned : Cleans program count environment trace (disposed.retire count) := .retire destroyedRoots
  have free : ∀ root ∈ (disposed.bindings.take count).map Prod.snd, disposed.OwnerFree ⟨root, []⟩ := by
    simpa only [destroyed.storage.bindings, roots] using destroyed.freed
  refine ⟨disposed.retire count, trace, cleaned, ?_⟩
  let stored := disposedTyped.toStoreTyped.retire count free
  exact { stored with
    heldShape := disposedTyped.heldShape
    heldOwn := disposedTyped.heldOwn
    heldReady := fun node member loan found own =>
      (disposedTyped.heldReady node member loan found own).retire (stored.sourceTargets node loan found own).1
    observedOwn := disposedTyped.observedOwn.retire count
    custody := typed.custody.cleans cleaned }

end Grounded

/- Section: StorageAccess -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

inductive AccessType (program : Program) (home : Module) (context : Context) (mode : BorrowMode) : AccessPlace → Origin → Ty → Option Nat → Prop where
  | owner {place : Place} {slot : Slot} {indices : List Nat} {state : Initialization} {type : Ty}
      (selected : lookup place.root context.bindings = some slot)
      (access : slot.initialization.Access indices state)
      (path : PathType program home slot.type place.fields indices type)
      (authority : mode = .unique → slot.mutable = true) :
      AccessType program home context mode (.owner place) ⟨.binder slot.binder, indices⟩ type none
  | dereference {reference : Place} {fields : List FieldKey} {slot : Slot} {node : Nat}
      {loan : SourceLoan} {handlePath indices : List Nat} {state : Initialization} {type : Ty}
      (selected : lookup reference.root context.bindings = some slot)
      (carrierPath : PathType program home slot.type reference.fields handlePath (.reference loan.referent loan.mode))
      (handle : slot.payload.select handlePath = some (.reference node))
      (initialized : slot.initialization.Access handlePath state) (complete : state.Complete)
      (carrier : context.Permits mode none ⟨.binder slot.binder, handlePath⟩)
      (found : context.loans[node]? = some loan) (own : loan.own = true)
      (path : PathType program home loan.referent fields indices type)
      (target : context.Target program (loan.target.extend indices) type)
      (authority : mode = .unique → loan.mode = .unique) :
      AccessType program home context mode (.dereference reference fields) (loan.target.extend indices) type (some node)



theorem SlotsCorrespond.lookup {interpretation : Interpretation} {store : Store}
    {bindings : List (String × Root)} {slots : List (String × Slot)}
    (correspond : SlotsCorrespond interpretation store bindings slots) {name : String} {slot : Slot}
    (selected : lookup name slots = some slot) :
    lookup name bindings = some (interpretation.binder slot.binder) ∧
      ∀ value, store (interpretation.binder slot.binder) = some value → slot.Corresponds interpretation value := by
  induction correspond generalizing slot with
  | nil => simp [Grounded.lookup] at selected
  | @cons key root head bindings slots identity resident rest ih =>
    simp only [Grounded.lookup] at selected
    split at selected
    · rename_i same
      cases Option.some.inj selected
      exact ⟨by simp [Grounded.lookup, same, identity], by simpa only [identity] using resident⟩
    · rename_i different
      obtain ⟨named, resident⟩ := ih selected
      exact ⟨by simp [Grounded.lookup, different, named], resident⟩

theorem StoreTyped.resolvePlace {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : Place} {slot : Slot}
    {target : Ty} {indices : List Nat} {state : Initialization}
    (selected : lookup place.root context.bindings = some slot) (access : slot.initialization.Access indices state)
    (path : PathType program home slot.type place.fields indices target) :
    ∃ resident, environment.resolvePlace program place = some ⟨interpretation.binder slot.binder, indices⟩ ∧
      environment.at ⟨interpretation.binder slot.binder, indices⟩ = some resident ∧
      ResidentTyped program state resident target := by
  obtain ⟨root, found, rootTyped, _⟩ := typed.cells slot.binder slot (typed.source.member_stored _ (lookup_member selected))
  obtain ⟨resolved, resident, read, residentTyped⟩ := path.resident rootTyped access
  have named := (typed.slots.lookup selected).1
  exact ⟨resident, by simp [Environment.resolvePlace, named, found, resolved],
    by simp [Environment.at, found, read], residentTyped⟩


theorem Environment.at_subaddress {environment : Environment} {address : Address} {parent value : Value}
    (read : environment.at address = some parent) {indices : List Nat}
    (selected : parent.readIndices indices = some value) :
    environment.at ⟨address.root, address.fields ++ indices⟩ = some value := by
  simp only [Environment.at, Bind.bind, Option.bind_eq_some_iff] at read
  obtain ⟨rootValue, stored, path⟩ := read
  simp [Environment.at, stored, Value.readIndices_append, path, selected]

theorem Environment.readAddress_subaddress {environment : Environment} {address : Address} {parent value : Value}
    (read : environment.readAddress address = some parent) {indices : List Nat}
    (selected : parent.readIndices indices = some value) (live : value.initialized = true) :
    environment.readAddress ⟨address.root, address.fields ++ indices⟩ = some value := by
  simp only [Environment.readAddress, Bind.bind, Option.bind_eq_some_iff] at read
  obtain ⟨actual, found, selectedParent⟩ := read
  split at selectedParent
  · cases Option.some.inj selectedParent
    simp only [Environment.at, Bind.bind, Option.bind_eq_some_iff] at found
    obtain ⟨rootValue, rootStored, path⟩ := found
    simp [Environment.readAddress, Environment.at, rootStored, Value.readIndices_append, path, selected, live]
  · cases selectedParent

theorem Interpretation.origin_extend (interpretation : Interpretation) (origin : Origin) (indices : List Nat) :
    interpretation.origin (origin.extend indices) =
      ⟨(interpretation.origin origin).root, (interpretation.origin origin).fields ++ indices⟩ := by
  cases origin with
  | mk base fields => cases base <;> simp [Interpretation.origin, Origin.extend]

/-- Canonical target typing is independent of operation readiness. -/
theorem AccessType.canonicalTarget {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent) :
    context.Target program target referent := by
  cases access with
  | owner selected available path _ =>
    exact ⟨_, typed.source.member_stored _ (lookup_member selected), path.canonical, _, available⟩
  | dereference _ _ _ _ _ _ _ _ _ target _ => exact target

/-- Positive unique authority is distinct from conflict exclusion and readiness. -/
theorem AccessType.uniqueAuthority {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat}
    (access : AccessType program home context .unique place target referent parent) :
    (parent = none ∧ ∃ slot, context.storage target.base = some slot ∧ slot.mutable = true) ∨
    ∃ node loan, parent = some node ∧ context.loans[node]? = some loan ∧ loan.own = true ∧
      loan.mode = .unique ∧ target.Within loan.target := by
  cases access with
  | owner selected _ _ authority =>
    exact .inl ⟨rfl, _, typed.source.member_stored _ (lookup_member selected), authority rfl⟩
  | @dereference reference fields slot node loan handlePath indices state type _ _ _ _ _ _ found own _ _ authority =>
    exact .inr ⟨node, loan, rfl, found, own, authority rfl, rfl, indices, rfl⟩

theorem AccessType.uniqueTarget {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {node : Nat}
    (access : AccessType program home context .unique place target referent (some node)) :
    ∃ loan binder, context.loans[node]? = some loan ∧ loan.own = true ∧ loan.mode = .unique ∧
      target.Within loan.target ∧ target.base = .binder binder := by
  rcases access.uniqueAuthority typed with ⟨impossible, _⟩ | ⟨selected, loan, same, found, own, unique, within⟩
  · cases impossible
  · cases Option.some.inj same
    cases base : target.base with
    | binder binder => exact ⟨loan, binder, found, own, unique, within, rfl⟩

theorem AccessType.parentMode {context : Context} {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent) :
    ∀ node loan, parent = some node → context.loans[node]? = some loan → mode = .unique → loan.mode = .unique := by
  cases access with
  | owner => intro node loan impossible; cases impossible
  | dereference _ _ _ _ _ _ found _ _ _ authority =>
    intro node loan same other unique
    cases Option.some.inj same
    cases Option.some.inj (found.symm.trans other)
    exact authority unique

theorem AccessType.sourceTarget {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent)
    (ready : context.AccessReady target parent) :
    context.SourceTarget program ⟨target, referent, parent, true, mode⟩ := by
  exact ⟨access.canonicalTarget typed, fun _ => ready.1⟩

/-- Readiness-free positive capability: conflict exclusion is a separate check. -/
theorem StoreTyped.accessAuthority {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent) :
    environment.Authorizes mode ⟨interpretation.origin target, parent.map interpretation.node⟩ := by
  cases access with
  | owner selected _ _ _ =>
    exact List.mem_map.mpr ⟨_, lookup_member (typed.slots.lookup selected).1, rfl⟩
  | @dereference reference fields slot node loan handlePath indices state type _ _ _ _ _ _ found own _ _ authority =>
    have record := typed.records node loan found
    obtain ⟨actual, actualFound, _, support⟩ := typed.usable (show context.Own node from ⟨loan, found, own⟩)
    cases Option.some.inj (actualFound.symm.trans record)
    exact ⟨_, record, own, support, by simp [Interpretation.origin_extend],
      by simp [Interpretation.origin_extend], authority⟩

private theorem Context.ready_complete {context : Context} {origin : Origin} {binder : Nat}
    {slot : Slot} {state : Initialization} (base : origin.base = .binder binder)
    (stored : context.storage (.binder binder) = some slot)
    (access : slot.initialization.Access origin.fields state) (ready : context.Ready origin) : state.Complete := by
  simp only [Context.Ready, base] at ready
  obtain ⟨actual, selected, actualStored, actualAccess, complete⟩ := ready
  cases Option.some.inj (actualStored.symm.trans stored)
  exact (actualAccess.deterministic access) ▸ complete

/-- The one canonical field producer resolves a masked parent. Only ancestors of
its selected child need be present; the child itself may be vacant. -/
private theorem StoreTyped.projectAccess {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {node : Nat} {loan : SourceLoan}
    {fields : List FieldKey} {indices : List Nat} {referent : Ty}
    (found : context.loans[node]? = some loan) (own : loan.own = true)
    (path : PathType program home loan.referent fields indices referent)
    (target : context.Target program (loan.target.extend indices) referent) :
    ∃ state resident value, environment.at (interpretation.origin loan.target) = some resident ∧
      resident.resolvePath program fields = some indices ∧
      environment.at (interpretation.origin (loan.target.extend indices)) = some value ∧
      ResidentTyped program state value referent ∧ (context.Ready (loan.target.extend indices) → state.Complete) := by
  cases base : loan.target.base with
  | binder binder =>
    obtain ⟨slot, stored, parentPath, _, _⟩ := (by simpa [Context.Target, base] using (typed.sourceTargets node loan found own).1)
    obtain ⟨childSlot, childStored, _, state, access⟩ := (by simpa [Context.Target, Origin.extend, base] using target)
    cases Option.some.inj (childStored.symm.trans stored)
    obtain ⟨middle, front, back⟩ := access.split
    obtain ⟨root, rootStored, rootTyped, _⟩ := typed.cells binder slot stored
    obtain ⟨resident, parentRead, parentTyped⟩ := parentPath.resident rootTyped front
    obtain ⟨resolved, value, selected, valueTyped⟩ := path.resident parentTyped back
    have raw : environment.at (interpretation.origin loan.target) = some resident := by
      simp [Environment.at, Interpretation.origin, base, rootStored, parentRead]
    refine ⟨state, resident, value, raw, resolved, ?_, valueTyped, ?_⟩
    · rw [Interpretation.origin_extend]
      exact Environment.at_subaddress raw selected
    · exact Context.ready_complete (by simpa [Origin.extend] using base) stored access


theorem StoreTyped.resolveAccessMasked {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent) :
    target.Known context ∧ target.Bounded context ∧
    (∀ node, parent = some node → ∃ loan, context.loans[node]? = some loan ∧ target.Within loan.target) ∧
    environment.resolveAccess program place = some ⟨interpretation.origin target, parent.map interpretation.node⟩ ∧
    environment.Authorizes mode ⟨interpretation.origin target, parent.map interpretation.node⟩ ∧
    ∃ state value, environment.at (interpretation.origin target) = some value ∧
      ResidentTyped program state value referent ∧ (context.Ready target → state.Complete) := by
  have authority := typed.accessAuthority access
  cases access with
  | @owner place slot indices state type selected available path _ =>
    have member := lookup_member selected
    obtain ⟨value, resolved, raw, resident⟩ := typed.resolvePlace selected available path
    refine ⟨typed.source.member_known _ member, (typed.source.slots _ member).1, ?_, ?_, authority, state, value,
      raw, resident, ?_⟩
    · intro node impossible; cases impossible
    · simp [Environment.resolveAccess, resolved, Interpretation.origin]
    · exact Context.ready_complete rfl (typed.source.member_stored _ member) available
  | @dereference reference fields slot node loan handlePath indices carrierState type selected carrierPath handle initialized carrierComplete carrierPermit found own path target _ =>
    obtain ⟨root, rootStored, rootTyped, rootRelated⟩ := typed.cells slot.binder slot
      (typed.source.member_stored _ (lookup_member selected))
    obtain ⟨fieldsResolved, carrier, carrierRead, carrierTyped⟩ := carrierPath.resident rootTyped initialized
    have carrierRelated := rootRelated.select handle carrierRead
    have carrierEqual : carrier = .reference (interpretation.node node) := by cases carrierRelated; rfl
    subst carrier
    have named := (typed.slots.lookup selected).1
    have resolved : environment.resolvePlace program reference = some ⟨interpretation.binder slot.binder, handlePath⟩ := by
      simp [Environment.resolvePlace, named, rootStored, fieldsResolved]
    have readCarrier : environment.readAddress ⟨interpretation.binder slot.binder, handlePath⟩ =
        some (.reference (interpretation.node node)) := by
      simp [Environment.readAddress, Environment.at, rootStored, carrierRead, Value.initialized]
    obtain ⟨state, resident, value, parentAt, fieldsResolved, targetAt, valueTyped, complete⟩ :=
      typed.projectAccess found own path target
    refine ⟨?_, ?_, ?_, ?_, authority, state, value, targetAt, valueTyped, complete⟩
    · simpa [Origin.Known, Origin.extend] using typed.source.loanKnown found
    · simpa [Origin.Bounded, Origin.extend] using (typed.source.targets node loan found).1
    · intro parent same
      cases Option.some.inj same
      exact ⟨loan, found, rfl, indices, rfl⟩
    · simp [Environment.resolveAccess, resolved, readCarrier, typed.records node loan found, own,
        parentAt, fieldsResolved, Interpretation.origin_extend]

theorem StoreTyped.accessReady {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent)
    (ready : context.AccessReady target parent) :
    environment.AccessReady ⟨interpretation.origin target, parent.map interpretation.node⟩ := by
  cases access with
  | owner => intro node loan impossible; cases impossible
  | @dereference reference fields slot node loan handlePath indices state type _ _ _ _ _ _ found own _ _ _ =>
    intro actualNode actualLoan same actualFound
    cases Option.some.inj same
    have record := typed.records node loan found
    cases Option.some.inj (actualFound.symm.trans record)
    obtain ⟨value, read, _⟩ := typed.targetsReady node loan found own (ready.2 node loan rfl found)
    exact ⟨value, read⟩

theorem StoreTyped.resolveAccess {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent)
    (ready : context.AccessReady target parent) :
    target.Known context ∧ target.Bounded context ∧
    (∀ node, parent = some node → ∃ loan, context.loans[node]? = some loan ∧ target.Within loan.target) ∧
    ∃ value, environment.resolveAccess program place = some ⟨interpretation.origin target, parent.map interpretation.node⟩ ∧
      environment.Authorizes mode ⟨interpretation.origin target, parent.map interpretation.node⟩ ∧
      environment.readAddress (interpretation.origin target) = some value ∧ ValueHasType program value referent := by
  obtain ⟨known, bounded, ancestor, resolved, authority, state, value, raw, resident, complete⟩ := typed.resolveAccessMasked access
  obtain ⟨valueTyped, initialized⟩ := resident.complete (complete ready.1)
  exact ⟨known, bounded, ancestor, value, resolved, authority, by simp [Environment.readAddress, raw, initialized], valueTyped⟩
theorem StoreTyped.carrierPermits {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent) :
    environment.CarrierPermits program mode place := by
  cases access with
  | owner => trivial
  | @dereference reference fields slot node loan handlePath indices state type selected carrierPath _ initialized _ permitted _ _ _ _ _ =>
    obtain ⟨value, resolved, _, _⟩ := typed.resolvePlace selected initialized carrierPath
    exact ⟨_, resolved, typed.permits (origin := ⟨.binder slot.binder, handlePath⟩) (typed.source.member_known _ (lookup_member selected)) permitted⟩

theorem StoreTyped.accessResolved {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {place : AccessPlace} {target : Origin}
    {referent : Ty} {parent : Option Nat} {mode : BorrowMode}
    (access : AccessType program home context mode place target referent parent) :
    environment.resolveAccess program place = some ⟨interpretation.origin target, parent.map interpretation.node⟩ ∧
    environment.Authorizes mode ⟨interpretation.origin target, parent.map interpretation.node⟩ ∧
    environment.CarrierPermits program mode place := by
  obtain ⟨_, _, _, resolved, authority, _⟩ := typed.resolveAccessMasked access
  exact ⟨resolved, authority, typed.carrierPermits access⟩

theorem StoreTyped.targetPayloadCorresponds {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) {origin : Origin} {referent : Ty}
    {payload : SourcePayload} (provenance : context.TargetPayload program origin referent payload)
    {value : Value}
    (read : environment.at (interpretation.origin origin) = some value) :
    payload.Corresponds interpretation.node value := by
  cases provenance with
  | @cell slot referent payload stored path selected =>
    cases base : origin.base with
    | binder binder =>
      obtain ⟨root, found, _, related⟩ := typed.cells binder slot (by simpa [base] using stored)
      exact related.select selected (by simpa [Environment.at, Interpretation.origin, base, found] using read)

end Grounded

/- Section: StorageJoin -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem SourcePayload.Joins.corresponds {before after : SourcePayload} (joined : before.Joins after)
    {node : Nat → Nat} {value : Value} (related : before.Corresponds node value) : after.Corresponds node value := by
  cases joined with
  | same => exact related
  | plain empty => exact .plain (related.referenceFree_iff.mpr empty)

theorem SourcePayload.Joins.select {before after payload : SourcePayload} {path : List Nat}
    (joined : before.Joins after) (selected : before.select path = some payload) :
    ∃ current, after.select path = some current ∧ payload.Joins current := by
  cases joined with
  | same => exact ⟨payload, selected, .same _⟩
  | plain empty =>
    refine ⟨.plain, ?_, .plain ?_⟩
    · cases path <;> simp [SourcePayload.select]
    · apply List.eq_nil_iff_forall_not_mem.mpr
      intro node member
      have old := SourcePayload.select_nodes selected member
      simp [empty] at old

theorem Context.TargetPayload.joins {before after : Context} {origin : Origin} {type : Ty} {payload : SourcePayload}
    (target : before.TargetPayload program origin type payload) (joined : before.Joins program after) :
    ∃ current, after.TargetPayload program origin type current ∧ payload.Joins current := by
  cases target with
  | cell stored path selected =>
    obtain ⟨slot, found, metadata, _⟩ := (joined.storage origin.base).forward stored
    obtain ⟨current, selectedAfter, payloadJoins⟩ := ((joined.storage origin.base).payloadJoins stored found).select selected
    have typeEqual := congrArg (fun metadata => metadata.1) metadata
    change slot.type = _ at typeEqual
    exact ⟨current, .cell found (typeEqual ▸ path) selectedAfter, payloadJoins⟩

theorem StoreTyped.join {interpretation : Interpretation} {context afterContext : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment) (joined : context.Joins program afterContext) :
    StoreTyped program interpretation afterContext environment := by
  have cells : ∀ binder slot, afterContext.storage (.binder binder) = some slot →
      ∃ value, environment.store (interpretation.binder binder) = some value ∧
        SlotTyped program value slot.toBindingType ∧ slot.Corresponds interpretation value := by
      intro binder slot stored
      obtain ⟨original, sourceStored, metadata, state⟩ := (joined.storage (.binder binder)).backward stored
      obtain ⟨value, found, resident, corresponds⟩ := typed.cells binder original sourceStored
      have sameType : slot.type = original.type := congrArg (fun metadata => metadata.1) metadata
      have payloadJoins := (joined.storage (.binder binder)).payloadJoins sourceStored stored
      refine ⟨value, found, ?_, ?_⟩
      · simpa only [SlotTyped, sameType] using resident.join state
      · exact payloadJoins.corresponds corresponds
  have source := joined.wellFormed typed.source
  have names : environment.bindings = afterContext.names.map (fun entry => (entry.1, interpretation.binder entry.2)) := by
    rw [joined.names, ← typed.source.bindings_names, List.map_map, typed.slots.bindings]
    rfl
  obtain ⟨residents, slots⟩ := Context.reconstruct source typed.residents.valid names cells
  refine { typed with
    source := source, residents := residents, slots := slots, cells := cells
    binderBound := ?_
    binderDistinct := ?_
    nodeOrder := ?_
    records := ?_
    activeCoverage := ?_
    sourceTargets := by
      intro node loan found own
      have oldFound : context.loans[node]? = some loan := joined.loans ▸ found
      obtain ⟨target, ready⟩ := typed.sourceTargets node loan oldFound own
      refine ⟨?_, ?_⟩
      · cases base : loan.target.base with
        | binder binder =>
          obtain ⟨slot, stored, path, state, access⟩ := (by simpa [Context.Target, base] using target)
          obtain ⟨current, currentStored, metadata, _⟩ := (joined.storage (.binder binder)).forward stored
          have type : current.type = slot.type := congrArg Prod.fst metadata
          obtain ⟨next, nextAccess, _⟩ := joined.targetMasks node loan oldFound own binder slot current state base stored currentStored access
          simp only [Context.Target, base]
          exact ⟨current, currentStored, type ▸ path, next, nextAccess⟩
      · intro shared
        have oldReady := ready shared
        cases base : loan.target.base with
        | binder binder =>
          simp only [Context.Ready, base] at oldReady ⊢
          obtain ⟨slot, state, stored, access, complete⟩ := oldReady
          obtain ⟨current, currentStored, _, _⟩ := (joined.storage (.binder binder)).forward stored
          obtain ⟨next, nextAccess, nextComplete⟩ := joined.targetMasks node loan oldFound own binder slot current state base stored currentStored access
          exact ⟨current, next, currentStored, nextAccess, nextComplete complete⟩
    }
  · intro binder known
    exact typed.binderBound binder ((joined.mentions binder).mp known)
  · intro first second firstKnown secondKnown same
    exact typed.binderDistinct first second ((joined.mentions first).mp firstKnown) ((joined.mentions second).mp secondKnown) same
  · simpa only [joined.loans] using typed.nodeOrder
  · simpa only [joined.loans] using typed.records
  · simpa only [joined.loans] using typed.activeCoverage
end Grounded

/- Section: StateScopes -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem StateTyped.join {interpretation : Interpretation} {context afterContext : Context} {heldPayloads : List SourcePayload}
    {environment : Environment} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held) (joined : context.Joins program afterContext) :
    StateTyped program interpretation afterContext heldPayloads environment held := by
  exact { typed.toStoreTyped.join joined with
    heldShape := typed.heldShape
    heldOwn := by simpa only [Context.Own, joined.loans] using typed.heldOwn
    heldReady := by
      intro node member loan found own
      have oldFound : context.loans[node]? = some loan := joined.loans ▸ found
      have ready := typed.heldReady node member loan oldFound own
      cases base : loan.target.base with
      | binder binder =>
        simp only [Context.Ready, base] at ready ⊢
        obtain ⟨slot, state, stored, access, complete⟩ := ready
        obtain ⟨current, currentStored, _, _⟩ := (joined.storage (.binder binder)).forward stored
        obtain ⟨next, nextAccess, nextComplete⟩ := joined.targetMasks node loan oldFound own binder slot current state base stored currentStored access
        exact ⟨current, next, currentStored, nextAccess, nextComplete complete⟩
    observedOwn := typed.observedOwn.joins joined
    custody := typed.custody }

theorem StateTyped.raiseSupply {interpretation : Interpretation} {context : Context} {heldPayloads : List SourcePayload}
    {environment : Environment} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held) {supply : Nat}
    (larger : context.nextBinder ≤ supply) :
    StateTyped program interpretation { context with nextBinder := supply } heldPayloads environment held := by
  apply typed.join
  refine ⟨rfl, ?_, rfl, larger, ?_⟩
  · intro base
    cases context.storage base with
    | none => exact .absent
    | some slot => exact .resident (.same _) (.same _)
  · intro node loan found own binder old current state base stored currentStored access
    have equal := Option.some.inj (stored.symm.trans currentStored)
    subst current
    exact ⟨state, access, id⟩

theorem StateTyped.prepare {interpretation : Interpretation} {context : Context}
    {environment : Environment} {heldPayloads : List SourcePayload} {held : List Value}
    {parameters : List (String × BindingType)} {values : List Value} {results : List ResultType}
    (typed : StateTyped program interpretation context (heldPayloads ++ results.map ResultType.payload)
      environment (held ++ values))
    (arguments : ResultsTyped program interpretation context results values)
    (aligned : parameters.map (fun parameter => parameter.2.type) = results.map ResultType.type) :
    ∃ afterMap,
      StateTyped program afterMap (Context.prepare parameters results context) heldPayloads
        (environment.prepare ((parameters.map Prod.fst).zip values)) held ∧
      StateProgress context (Context.prepare parameters results context) environment
        (environment.prepare ((parameters.map Prod.fst).zip values)) interpretation afterMap := by
  induction parameters generalizing interpretation context environment values results with
  | nil =>
    have empty : results = [] := by cases results <;> simp_all
    subst results
    cases arguments
    exact ⟨interpretation, by simpa [Context.prepare, Environment.prepare] using typed, .refl typed.source⟩
  | cons parameter parameters ih =>
    cases arguments with
    | nil => simp at aligned
    | @cons result results value values head tail =>
      have align := List.cons.inj (by simpa only [List.map_cons] using aligned)
      have length : heldPayloads.length = held.length := by
        have total := typed.heldShape.length
        have restLength := (ResultsTyped.cons head tail).corresponds.length
        simp only [List.length_append] at total
        omega
      have front := (typed.heldShape.append_inv length).1
      have reordered : StateTyped program interpretation context
          ((heldPayloads ++ results.map ResultType.payload) ++ [result.payload]) environment
          ((held ++ values) ++ [value]) := by
        apply typed.permPending
        · simpa only [List.append_assoc, List.map_cons, List.singleton_append] using
            (List.perm_append_comm (l₁ := [result.payload]) (l₂ := results.map ResultType.payload)).append_left heldPayloads
        · simpa only [List.append_assoc, List.singleton_append] using
            (List.perm_append_comm (l₁ := [value]) (l₂ := values)).append_left held
        · exact (front.append tail.corresponds).append (.cons head.corresponds .nil)
      have bound := reordered.bind head parameter.1 parameter.2.mutable
      have progress := StateProgress.bind (interpretation := interpretation) (environment := environment) typed.source parameter.1 parameter.2.mutable result value
      obtain ⟨finalMap, finalTyped, finalProgress⟩ := ih bound
        (tail.transport progress.history progress.interpretation) align.2
      refine ⟨finalMap, ?_, ?_⟩
      · simpa only [Context.prepare, Environment.prepare, List.map_cons, List.zip_cons_cons, List.foldl_cons] using finalTyped
      · have combined := progress.trans finalProgress (by simp [Environment.bind])
        simpa only [Context.prepare, Environment.prepare, List.map_cons, List.zip_cons_cons, List.foldl_cons] using combined

end Grounded

/- Section: StoragePrepare -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem StoreTyped.prepare {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment)
    (parameters : List (String × BindingType)) {results : List ResultType} {values : List Value}
    (arguments : ResultsTyped program interpretation context results values) :
    ∃ afterMap, StoreTyped program afterMap (Context.prepare parameters results context)
        (environment.prepare ((parameters.map Prod.fst).zip values)) ∧
      StateProgress context (Context.prepare parameters results context) environment
        (environment.prepare ((parameters.map Prod.fst).zip values)) interpretation afterMap := by
  induction parameters generalizing interpretation context environment results values with
  | nil => exact ⟨interpretation, typed, .refl typed.source⟩
  | cons parameter parameters ih =>
    cases arguments with
    | nil => exact ⟨interpretation, typed, .refl typed.source⟩
    | @cons result results value values head tail =>
      have installed := typed.bind head parameter.1 parameter.2.mutable
      have step := StateProgress.bind (interpretation := interpretation) (environment := environment)
        typed.source parameter.1 parameter.2.mutable result value
      have remaining : ResultsTyped program (interpretation.addBinder context.nextBinder environment.nextRoot)
          (context.bind parameter.1 parameter.2.mutable result) results values :=
        tail.transportRecords (fun node loan found => ⟨loan, found, rfl, rfl⟩) (fun _ _ => rfl)
      obtain ⟨afterMap, prepared, progress⟩ := ih installed remaining
      exact ⟨afterMap, prepared, step.trans progress (by simp [Environment.bind])⟩

end Grounded

/- Section: PatternResults -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module} {interpretation : Interpretation} {context : Context}

/-- This contradiction concerns owned results, not possibly vacant reference slots. -/
theorem ResultTyped.plainReference_impossible {referent : Ty} {mode : BorrowMode} {value : Value}
    (typed : ResultTyped program interpretation context ⟨.reference referent mode, .plain⟩ value) : False := by
  obtain ⟨resident, _, corresponds⟩ := typed
  cases resident
  cases corresponds with
  | plain free => simp [Value.ReferenceFree] at free

theorem SourcePayload.Typed.dispose {context : Context} {payload : SourcePayload} {type : Ty}
    (typed : SourcePayload.Typed program context.loans payload type) (disposed : SourcePayload) :
    SourcePayload.Typed program (context.dispose disposed).loans payload type := by
  exact Context.dispose_induction (P := fun current => SourcePayload.Typed program current.loans payload type) typed (fun current node old =>
    old.transport (fun _ _ found => ⟨_, current.endOwn_found node found, rfl, rfl⟩)) disposed

theorem HeadType.fields_unique {head : Head} {type : Ty} {first second : List Ty}
    (left : HeadType program head type first) (right : HeadType program head type second) : first = second := by
  cases left <;> cases right <;> simp_all

/-- Runtime typing produces the constructor signature consumed by both pattern
binding and exhaustive dispatch; neither consumer guesses resident types. -/
theorem ValueHasType.decompose {value : Value} {type : Ty} (typed : ValueHasType program value type) :
    ∃ fields, HeadType program value.head type fields ∧ ValuesHaveTypes program value.children fields := by
  cases typed with
  | unit => exact ⟨[], .unit, .nil⟩
  | integer fits => exact ⟨[], .integer fits, .nil⟩
  | character valid => exact ⟨[], .character valid, .nil⟩
  | reference node finite => exact ⟨[], .reference node _, .nil⟩
  | tuple first rest => exact ⟨_, .tuple _ _, .cons first rest⟩
  | array residents _ _ => exact ⟨_, .array _ _, residents⟩
  | nominal declared chosen _ residents => exact ⟨_, .nominal declared chosen, residents⟩
inductive BindingResultsTyped (program : Program) (interpretation : Interpretation) (context : Context) :
    List (String × ResultType) → BindingValues → Prop where
  | nil : BindingResultsTyped program interpretation context [] []
  | cons {name : String} {result : ResultType} {results : List (String × ResultType)} {value : Value} {values : BindingValues} (head : ResultTyped program interpretation context result value)
      (tail : BindingResultsTyped program interpretation context results values) :
      BindingResultsTyped program interpretation context ((name, result) :: results) ((name, value) :: values)

def Context.PayloadPreserves (program : Program) (before after : Context) : Prop :=
  ∀ payload type, SourcePayload.Typed program before.loans payload type → SourcePayload.Typed program after.loans payload type

theorem BindingResultsTyped.append {front back : List (String × ResultType)} {first rest : BindingValues}
    (left : BindingResultsTyped program interpretation context front first)
    (right : BindingResultsTyped program interpretation context back rest) :
    BindingResultsTyped program interpretation context (front ++ back) (first ++ rest) := by
  induction left with
  | nil => exact right
  | cons head tail ih => exact .cons head ih

theorem BindingResultsTyped.preserve {before after : Context} {results : List (String × ResultType)} {values : BindingValues}
    (typed : BindingResultsTyped program interpretation before results values)
    (preserved : before.PayloadPreserves program after) : BindingResultsTyped program interpretation after results values := by
  induction typed with
  | nil => exact .nil
  | cons head tail ih => exact .cons ⟨head.resident, preserved _ _ head.payload, head.corresponds⟩ ih
theorem ResultsTyped.plain {context : Context} {types : List Ty} {values : List Value}
    (typed : ValuesHaveTypes program values types) (free : ∀ value ∈ values, value.ReferenceFree) :
    ResultsTyped program interpretation context (plainResults types) values := by
  induction values generalizing types with
  | nil => cases typed; exact .nil
  | cons value values ih => cases typed with | cons head tail => exact .cons ⟨head, .plain _, .plain (free _ (by simp))⟩ (ih tail (fun value member => free value (by simp [member])))

theorem ResultsTyped.fields {context : Context} {types : List Ty} {payloads : List SourcePayload} {values : List Value}
    (typed : ValuesHaveTypes program values types) (payloadTyped : PayloadsTyped program context.loans payloads types)
    (corresponds : PayloadsCorrespond interpretation.node payloads values) :
    ResultsTyped program interpretation context (fieldResults types payloads) values := by
  induction values generalizing types payloads with
  | nil => cases corresponds; cases typed; exact .nil
  | cons value values ih =>
    cases typed with | cons head tail =>
      cases corresponds with | cons first rest =>
        cases payloadTyped with | cons firstTyped restTyped =>
          exact .cons ⟨head, firstTyped, first⟩ (ih tail restTyped rest)

theorem ResultsTyped.field_nodes {context : Context} {types : List Ty} {payloads : List SourcePayload}
    (typed : PayloadsTyped program context.loans payloads types) :
    payloadNodes ((fieldResults types payloads).map ResultType.payload) = payloadNodes payloads := by
  induction payloads generalizing types with
  | nil => cases typed; rfl
  | cons payload payloads ih => cases typed with | cons head tail => simpa [fieldResults, payloadNodes] using congrArg (payload.nodes ++ ·) (ih tail)

theorem plainResults.nodes (types : List Ty) : payloadNodes ((plainResults types).map ResultType.payload) = [] := by
  induction types with
  | nil => rfl
  | cons head tail ih => simpa only [plainResults, List.map_cons, payloadNodes, SourcePayload.nodes, List.nil_append] using ih

def PatternOutcome.Realized (program : Program) (interpretation : Interpretation) (before : Context)
    (environment : Environment) (pattern : Pattern) (value : Value) (bindings : BindingValues) : PatternOutcome → Prop
  | .impossible => False
  | .produced types after => ∃ final trace,
      Pattern.Consumes program environment pattern value bindings final trace ∧
      StoreTyped program interpretation after final ∧ BindingResultsTyped program interpretation after types bindings ∧
      before.PayloadPreserves program after

def PatternOutcome.FieldsRealized (program : Program) (interpretation : Interpretation) (before : Context)
    (environment : Environment) (patterns : List Pattern) (values : List Value) (bindings : BindingValues) : PatternOutcome → Prop
  | .impossible => False
  | .produced types after => ∃ final,
      (∀ index, ∃ trace, ConsumesFields program environment index patterns values bindings final trace) ∧
      StoreTyped program interpretation after final ∧ BindingResultsTyped program interpretation after types bindings ∧
      before.PayloadPreserves program after

theorem matchPatterns.cons_inv {pattern : Pattern} {patterns : List Pattern} {value : Value}
    {values : List Value} {bindings : BindingValues}
    (matched : matchPatterns (pattern :: patterns) (value :: values) = some bindings) :
    ∃ front back, pattern.matchValue value = some front ∧ matchPatterns patterns values = some back ∧ bindings = front ++ back := by
  simp only [matchPatterns, Bind.bind, Option.bind_eq_some_iff, pure, Option.some.injEq] at matched
  obtain ⟨front, first, back, rest, equal⟩ := matched
  exact ⟨front, back, first, rest, equal.symm⟩

theorem PatternOutcome.FieldsRealized.node {before : Context} {environment : Environment}
    {head : Head} {patterns : List Pattern} {value : Value} {bindings : BindingValues} {outcome : PatternOutcome}
    (realized : outcome.FieldsRealized program interpretation before environment patterns value.children bindings)
    (source : head.Source) (same : head = value.head) :
    outcome.Realized program interpretation before environment (.node head patterns) value bindings := by
  cases outcome with
  | impossible => exact realized
  | produced types after =>
    obtain ⟨final, fields, agreement, bindingsTyped, preserves⟩ := realized
    obtain ⟨trace, consumed⟩ := fields 0
    exact ⟨final, trace, .node source same consumed, agreement, bindingsTyped, preserves⟩

theorem PatternType.consume {held : List SourcePayload} {before : Context} {pattern : Pattern}
    {result : ResultType} {outcome : PatternOutcome}
    (typed : PatternType program home held before pattern result outcome)
    {interpretation : Interpretation} {environment : Environment} {value : Value} {bindings : BindingValues}
    (subject : ResultTyped program interpretation before result value)
    (agreement : StoreTyped program interpretation before environment)
    (matched : pattern.matchValue value = some bindings) :
    outcome.Realized program interpretation before environment pattern value bindings := by
  induction typed using PatternType.rec
    (motive_2 := fun held before patterns results outcome _ =>
      ∀ (interpretation : Interpretation) (environment : Environment) (values : List Value) (bindings : BindingValues),
      ResultsTyped program interpretation before results values →
      StoreTyped program interpretation before environment →
      matchPatterns patterns values = some bindings →
      outcome.FieldsRealized program interpretation before environment patterns values bindings)
    generalizing interpretation environment value bindings with
  | wildcard discard legal =>
    simp only [Pattern.matchValue, Option.some.injEq] at matched
    subst bindings
    obtain ⟨after, disposed, afterAgreement⟩ := agreement.dispose subject.corresponds
      (fun _ member => subject.payload.node_bound member) legal.restored
      (subject.resident.disposable discard)
    exact ⟨after, _, .wildcard disposed, afterAgreement, .nil, fun _ _ typed => typed.dispose _⟩
  | binder context name result =>
    simp only [Pattern.matchValue, Option.some.injEq] at matched
    subst bindings
    exact ⟨environment, [], .binder environment name value, agreement, .cons subject .nil, fun _ _ typed => typed⟩
  | literal literalTyped discard legal =>
    simp only [Pattern.matchValue] at matched
    split at matched
    next equal =>
      subst value
      have empty := Option.some.inj matched
      subst bindings
      obtain ⟨after, disposed, afterAgreement⟩ := agreement.dispose subject.corresponds
        (fun _ member => subject.payload.node_bound member) legal.restored
        (subject.resident.disposable discard)
      exact ⟨after, _, .literal disposed, afterAgreement, .nil, fun _ _ typed => typed.dispose _⟩
    next different => contradiction
  | @plain held before head patterns type fields outcome shape access children ih =>
    simp only [Pattern.matchValue] at matched
    split at matched
    next same =>
      obtain ⟨actual, actualShape, residents⟩ := subject.resident.decompose
      rw [← same] at actualShape
      have aligned := shape.fields_unique actualShape
      subst actual
      cases subject.corresponds with
      | plain free =>
        exact (ih interpretation environment value.children bindings (ResultsTyped.plain residents (valuesReferenceFree_iff.mp (Value.referenceFree_iff_head_children.mp free).2))
          agreement matched).node (by simpa only [same] using (Value.referenceFree_iff_head_children.mp free).1) same
    next different => contradiction
  | @aggregate held before head patterns type fields payloads outcome shape access children ih =>
    simp only [Pattern.matchValue] at matched
    split at matched
    next same =>
      obtain ⟨actual, actualShape, residents⟩ := subject.resident.decompose
      rw [← same] at actualShape
      have aligned := shape.fields_unique actualShape
      subst actual
      cases subject.payload with
      | aggregate source payloadShape payloadTyped =>
        have aligned := shape.fields_unique payloadShape
        subst_vars
        cases subject.corresponds with
        | aggregate source constructor payloadCorresponds =>
          exact (ih interpretation environment value.children bindings
            (ResultsTyped.fields residents payloadTyped payloadCorresponds) agreement
            matched).node source rfl
    next different => contradiction
  | plainReference => exact subject.plainReference_impossible.elim
  | @impossible held before head active patterns type fields payloads checked different shape access children ih =>
    cases subject.corresponds with
    | aggregate source constructor payloadCorresponds =>
      simp [Pattern.matchValue, constructor, different] at matched
  | nil before =>
    rename_i interpretation environment values bindings subject agreement matched
    cases subject
    simp only [matchPatterns, Option.some.injEq] at matched
    subst bindings
    exact ⟨environment, fun index => ⟨[], .nil environment index⟩, agreement, .nil, fun _ _ typed => typed⟩
  | @cons held before middle after pattern patterns result results front back tail head tailIH headIH =>
    rename_i interpretation environment values bindings subject agreement matched
    cases subject with
    | @cons _ _ value values first rest =>
      obtain ⟨frontValues, backValues, firstMatch, restMatch, rfl⟩ := matchPatterns.cons_inv matched
      obtain ⟨middleEnvironment, tailConsumed, middleAgreement, backTyped, tailPreserves⟩ :=
        tailIH interpretation environment values backValues rest agreement
          restMatch
      obtain ⟨afterEnvironment, headTrace, headConsumed, afterAgreement, frontTyped, headPreserves⟩ :=
        headIH ⟨first.resident, tailPreserves _ _ first.payload, first.corresponds⟩ middleAgreement
          firstMatch
      exact ⟨afterEnvironment, fun index => by
        obtain ⟨trace, consumed⟩ := tailConsumed (index + 1)
        exact ⟨_, .cons consumed headConsumed⟩,
        afterAgreement, frontTyped.append (backTyped.preserve headPreserves),
        fun payload type typed => headPreserves _ _ (tailPreserves _ _ typed)⟩
  | @impossibleHead held before middle pattern patterns result results back tail head tailIH headIH =>
    rename_i interpretation environment values bindings subject agreement matched
    cases subject with
    | @cons _ _ value values first rest =>
      obtain ⟨frontValues, backValues, firstMatch, restMatch, rfl⟩ := matchPatterns.cons_inv matched
      obtain ⟨middleEnvironment, tailConsumed, middleAgreement, backTyped, tailPreserves⟩ :=
        tailIH interpretation environment values backValues rest agreement
          restMatch
      exact headIH ⟨first.resident, tailPreserves _ _ first.payload, first.corresponds⟩ middleAgreement
        firstMatch
  | @impossibleTail held before pattern patterns result results checked tail head tailIH headIH =>
    rename_i interpretation environment values bindings subject agreement matched
    cases subject with
    | @cons _ _ value values first rest =>
      obtain ⟨frontValues, backValues, firstMatch, restMatch, rfl⟩ := matchPatterns.cons_inv matched
      exact tailIH interpretation environment values backValues rest agreement
        restMatch

theorem BindingResultsTyped.erase {types : List (String × ResultType)} {bindings : BindingValues}
    (typed : BindingResultsTyped program interpretation context types bindings) :
    ValuesBindingsTyped program bindings (patternBindings types) := by
  induction typed with
  | nil => exact .nil
  | cons first rest ih => exact .cons first.resident ih

theorem PatternType.consume_produced {held : List SourcePayload} {before after : Context} {pattern : Pattern}
    {result : ResultType} {types : List (String × ResultType)}
    (typed : PatternType program home held before pattern result (.produced types after))
    {interpretation : Interpretation} {environment : Environment} {value : Value} {bindings : BindingValues}
    (subject : ResultTyped program interpretation before result value)
    (agreement : StoreTyped program interpretation before environment)
    (matched : pattern.matchValue value = some bindings) :
    ∃ final trace, Pattern.Consumes program environment pattern value bindings final trace ∧
      StoreTyped program interpretation after final ∧ BindingResultsTyped program interpretation after types bindings ∧
      before.PayloadPreserves program after := typed.consume subject agreement matched

theorem PatternsType.consume {held : List SourcePayload} {before : Context} {patterns : List Pattern}
    {results : List ResultType} {outcome : PatternOutcome}
    (typed : PatternsType program home held before patterns results outcome)
    {interpretation : Interpretation} {environment : Environment} {values : List Value} {bindings : BindingValues}
    (subject : ResultsTyped program interpretation before results values)
    (agreement : StoreTyped program interpretation before environment)
    (matched : matchPatterns patterns values = some bindings) :
    outcome.FieldsRealized program interpretation before environment patterns values bindings := by
  induction patterns generalizing held before results outcome environment values bindings with
  | nil =>
    cases typed
    cases subject
    simp only [matchPatterns, Option.some.injEq] at matched
    subst bindings
    exact ⟨environment, fun index => ⟨[], .nil environment index⟩, agreement, .nil, fun _ _ typed => typed⟩
  | cons pattern patterns ih =>
    cases typed with
    | cons tail head =>
      cases subject with
      | @cons result results value values first rest =>
        obtain ⟨frontValues, backValues, firstMatch, restMatch, rfl⟩ := matchPatterns.cons_inv matched
        obtain ⟨middle, tailConsumed, middleAgreement, backTyped, tailPreserves⟩ := ih tail rest agreement
          restMatch
        obtain ⟨final, headTrace, headConsumed, afterAgreement, frontTyped, headPreserves⟩ :=
          head.consume_produced ⟨first.resident, tailPreserves _ _ first.payload, first.corresponds⟩ middleAgreement
            firstMatch
        exact ⟨final, fun index => by
          obtain ⟨trace, consumed⟩ := tailConsumed (index + 1)
          exact ⟨_, .cons consumed headConsumed⟩,
          afterAgreement, frontTyped.append (backTyped.preserve headPreserves),
          fun payload type typed => headPreserves _ _ (tailPreserves _ _ typed)⟩
    | impossibleHead tail head =>
      cases subject with
      | @cons result results value values first rest =>
        obtain ⟨frontValues, backValues, firstMatch, restMatch, rfl⟩ := matchPatterns.cons_inv matched
        obtain ⟨middle, tailConsumed, middleAgreement, backTyped, tailPreserves⟩ := ih tail rest agreement
          restMatch
        exact head.consume ⟨first.resident, tailPreserves _ _ first.payload, first.corresponds⟩ middleAgreement
          firstMatch
    | impossibleTail tail head =>
      cases subject with
      | @cons result results value values first rest =>
        obtain ⟨frontValues, backValues, firstMatch, restMatch, rfl⟩ := matchPatterns.cons_inv matched
        exact ih tail rest agreement restMatch

end Grounded

/- Section: StatePatternBindings -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {interpretation : Interpretation} {context : Context}

theorem BindingResultsTyped.results {types : List (String × ResultType)} {bindings : BindingValues}
 (typed : BindingResultsTyped program interpretation context types bindings) :
 ResultsTyped program interpretation context (types.map Prod.snd) (bindings.map Prod.snd) := by
 induction typed with
 | nil => exact .nil
 | cons head tail ih => exact .cons head ih

theorem BindingResultsTyped.corresponds {types : List (String × ResultType)} {bindings : BindingValues}
 (typed : BindingResultsTyped program interpretation context types bindings) :
 PayloadsCorrespond interpretation.node (bindingPayloads types) (bindings.map Prod.snd) := by
 simpa only [bindingPayloads, List.map_map, Function.comp_def] using typed.results.corresponds

theorem BindingResultsTyped.names {types : List (String × ResultType)} {bindings : BindingValues}
 (typed : BindingResultsTyped program interpretation context types bindings) :
 types.map Prod.fst = bindings.map Prod.fst := by
 induction typed with
 | nil => rfl
 | cons head tail ih => exact congrArg (List.cons _) ih

theorem StateTyped.prepareBindings {environment : Environment} {heldPayloads : List SourcePayload}
 {held : List Value} {types : List (String × ResultType)} {bindings : BindingValues}
 (typed : StateTyped program interpretation context (heldPayloads ++ bindingPayloads types)
   environment (held ++ bindings.map Prod.snd))
 (arguments : BindingResultsTyped program interpretation context types bindings) :
 ∃ afterMap,
   StateTyped program afterMap (Context.prepare (patternBindings types) (types.map Prod.snd) context)
     heldPayloads (environment.prepare bindings) held ∧
   StateProgress context (Context.prepare (patternBindings types) (types.map Prod.snd) context)
     environment (environment.prepare bindings) interpretation afterMap := by
 have state : StateTyped program interpretation context
     (heldPayloads ++ (types.map Prod.snd).map ResultType.payload) environment
     (held ++ bindings.map Prod.snd) := by
   simpa only [bindingPayloads, List.map_map, Function.comp_def] using typed
 have aligned : (patternBindings types).map (fun parameter => parameter.2.type) =
     (types.map Prod.snd).map ResultType.type := by
   simp only [patternBindings, List.map_map, Function.comp_def]
 have names : ((patternBindings types).map Prod.fst).zip (bindings.map Prod.snd) = bindings := by
   simp only [patternBindings, List.map_map, Function.comp_def]
   rw [arguments.names]
   clear typed arguments state
   induction bindings with
   | nil => rfl
   | cons head tail ih => simpa only [List.map_cons, List.zip_cons_cons] using congrArg (List.cons head) ih
 simpa only [names] using state.prepare arguments.results aligned

end Grounded

/- Section: PatternSource -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

structure PatternContextEffects (before after : Context) : Prop where
  history : Context.History before after
  support : Context.ReflectsSupport before after
  loans : after.loans.length = before.loans.length
  supply : after.nextBinder = before.nextBinder
  names : after.names = before.names
  storage : after.storage = before.storage

theorem PatternContextEffects.refl (context : Context) : PatternContextEffects context context :=
  ⟨.refl _, .refl _, rfl, rfl, rfl, rfl⟩

theorem PatternContextEffects.dispose (context : Context) (payload : SourcePayload) :
    PatternContextEffects context (context.dispose payload) :=
  ⟨.dispose _ _, .dispose _ _, Context.dispose_loans_length _ _, Context.dispose_supply _ _,
    Context.dispose_names _ _, Context.dispose_storage _ _⟩

theorem PatternContextEffects.trans {before middle after : Context}
    (first : PatternContextEffects before middle) (second : PatternContextEffects middle after) :
    PatternContextEffects before after :=
  ⟨first.history.trans second.history, first.support.trans second.support first.history.supply,
    second.loans.trans first.loans, second.supply.trans first.supply, second.names.trans first.names,
    second.storage.trans first.storage⟩

def PatternOutcome.SourceEffects (before : Context) : PatternOutcome → Prop
  | .impossible => True
  | .produced _ after => PatternContextEffects before after

theorem PatternType.sourceEffects {held : List SourcePayload} {before : Context} {pattern : Pattern}
    {result : ResultType} {outcome : PatternOutcome}
    (typed : PatternType program home held before pattern result outcome) : outcome.SourceEffects before := by
  induction typed using PatternType.rec
    (motive_2 := fun _ before _ _ outcome _ => outcome.SourceEffects before) with
  | wildcard | literal => exact .dispose _ _
  | binder => exact .refl _
  | plain _ _ _ ih | aggregate _ _ _ ih => exact ih
  | plainReference | impossible | impossibleHead | impossibleTail => trivial
  | nil => exact .refl _
  | cons _ _ tail head => exact tail.trans head

theorem PatternType.history {held : List SourcePayload} {before after : Context} {pattern : Pattern}
    {result : ResultType} {bindings : List (String × ResultType)}
    (typed : PatternType program home held before pattern result (.produced bindings after)) :
    Context.History before after := typed.sourceEffects.history

theorem PatternType.reflectsSupport {held : List SourcePayload} {before after : Context} {pattern : Pattern}
    {result : ResultType} {bindings : List (String × ResultType)}
    (typed : PatternType program home held before pattern result (.produced bindings after)) :
    Context.ReflectsSupport before after := typed.sourceEffects.support

def Context.NodesAvailable (context : Context) (nodes : List Nat) : Prop :=
  ∀ node ∈ nodes, context.Own node ∧ context.Restored node

theorem Context.NodesAvailable.append {context : Context} {first second : List Nat}
    (left : context.NodesAvailable first) (right : context.NodesAvailable second) :
    context.NodesAvailable (first ++ second) := by
  intro node member
  rcases List.mem_append.mp member with member | member
  · exact left node member
  · exact right node member

theorem Context.NodesAvailable.left {context : Context} {first second : List Nat}
    (available : context.NodesAvailable (first ++ second)) : context.NodesAvailable first :=
  fun node member => available node (List.mem_append_left _ member)

theorem Context.NodesAvailable.right {context : Context} {first second : List Nat}
    (available : context.NodesAvailable (first ++ second)) : context.NodesAvailable second :=
  fun node member => available node (List.mem_append_right _ member)

theorem Context.NodesAvailable.disposeProtected {context : Context} {held : List SourcePayload} {payload : SourcePayload}
    (available : context.NodesAvailable (payloadNodes held)) (legal : context.PayloadDisposable program held payload) :
    (context.dispose payload).NodesAvailable (payloadNodes held) := by
  intro node member
  have heldAvailable := available node member
  exact ⟨heldAvailable.1.dispose_of_not_mem (fun disposed => legal.excludes node disposed member), heldAvailable.2.dispose payload⟩

theorem fieldResults.nodes_subset (types : List Ty) (payloads : List SourcePayload) :
    ∀ node ∈ payloadNodes ((fieldResults types payloads).map ResultType.payload), node ∈ payloadNodes payloads := by
  induction types generalizing payloads with
  | nil => simp [fieldResults, payloadNodes]
  | cons type types ih =>
    cases payloads with
    | nil => simp [fieldResults, payloadNodes]
    | cons payload payloads =>
      intro node member
      change node ∈ payload.nodes ++ payloadNodes ((fieldResults types payloads).map ResultType.payload) at member
      rcases List.mem_append.mp member with first | rest
      · exact List.mem_append_left _ first
      · exact List.mem_append_right _ (ih payloads node rest)

def PatternOutcome.Resources (program : Program) (held : List SourcePayload) : PatternOutcome → Prop
  | .impossible => True
  | .produced bindings after => after.ObservedOwn program ∧ after.NodesAvailable (payloadNodes held) ∧
      after.NodesAvailable (payloadNodes (bindingPayloads bindings))

theorem PatternType.resourcePreserves {held : List SourcePayload} {before : Context} {pattern : Pattern}
    {result : ResultType} {outcome : PatternOutcome}
    (typed : PatternType program home held before pattern result outcome)
    (observed : before.ObservedOwn program)
    (heldAvailable : before.NodesAvailable (payloadNodes held))
    (subject : before.PayloadAvailable result.payload) : outcome.Resources program held := by
  induction typed using PatternType.rec
    (motive_2 := fun held before _ results outcome _ => before.ObservedOwn program →
      before.NodesAvailable (payloadNodes held) →
      before.NodesAvailable (payloadNodes (results.map ResultType.payload)) → outcome.Resources program held) with
  | wildcard discard legal | literal _ discard legal =>
    exact ⟨observed.dispose legal, heldAvailable.disposeProtected legal,
      by intro node member; cases member⟩
  | binder => exact ⟨observed, heldAvailable, by simpa only [bindingPayloads, List.map_cons, List.map_nil, payloadNodes, List.append_nil, Context.NodesAvailable, Context.PayloadAvailable] using subject⟩
  | plain shape access children ih =>
    exact ih observed heldAvailable (by rw [plainResults.nodes]; intro node member; cases member)
  | aggregate shape access children ih =>
    exact ih observed heldAvailable (fun node member => subject node (fieldResults.nodes_subset _ _ node member))
  | plainReference | impossible | impossibleHead | impossibleTail => trivial
  | nil => rename_i observed heldAvailable subject; exact ⟨observed, heldAvailable, by intro node member; cases member⟩
  | @cons held before middle after pattern patterns result results front back tail head tailIH headIH =>
    rename_i observed heldAvailable subjects
    have subjectSplit : before.NodesAvailable (result.payload.nodes ++ payloadNodes (results.map ResultType.payload)) := subjects
    have tailReady : before.NodesAvailable (payloadNodes (result.payload :: held)) := subjectSplit.left.append heldAvailable
    obtain ⟨middleObserved, middleProtected, backAvailable⟩ := tailIH observed tailReady subjectSplit.right
    have middleSplit : middle.NodesAvailable (result.payload.nodes ++ payloadNodes held) := middleProtected
    have headReady : middle.NodesAvailable (payloadNodes (bindingPayloads back ++ held)) := by
      rw [payloadNodes_append]
      exact backAvailable.append middleSplit.right
    obtain ⟨afterObserved, afterProtected, frontAvailable⟩ := headIH middleObserved headReady middleSplit.left
    have afterSplit : after.NodesAvailable (payloadNodes (bindingPayloads back) ++ payloadNodes held) := by
      simpa only [payloadNodes_append] using afterProtected
    refine ⟨afterObserved, afterSplit.right, ?_⟩
    simpa only [bindingPayloads, List.map_append, payloadNodes_append] using frontAvailable.append afterSplit.left

end Grounded

/- Section: PatternCustody -/

namespace Grounded
variable {program : Program}

mutual
theorem Pattern.Consumes.custody {before after : Environment} {pattern : Pattern} {value : Value}
    {bindings : BindingValues} {trace : List (List Nat)} {held : List Value}
    (consumed : Pattern.Consumes program before pattern value bindings after trace)
    (custody : Custody before (held ++ [value])) :
    Custody after (held ++ bindings.map Prod.snd) := by
  cases consumed with
  | wildcard disposed | literal disposed => simpa using custody.disposePending disposed
  | binder => exact custody
  | node source same fields =>
    exact fields.custody (custody.unpack (same ▸ source))

theorem ConsumesFields.custody {before after : Environment} {index : Nat} {patterns : List Pattern}
    {values : List Value} {bindings : BindingValues} {trace : List (List Nat)} {held : List Value}
    (consumed : ConsumesFields program before index patterns values bindings after trace)
    (custody : Custody before (held ++ values)) :
    Custody after (held ++ bindings.map Prod.snd) := by
  cases consumed with
  | nil => exact custody
  | @cons before middle after index pattern patterns value values front back first rest tail head =>
    have tailInput : Custody before ((held ++ [value]) ++ values) := by
      simpa only [List.append_assoc, List.singleton_append] using custody
    have tailOutput := tail.custody tailInput
    have headInput : Custody middle ((held ++ back.map Prod.snd) ++ [value]) :=
      tailOutput.permPending (by
        simpa only [List.append_assoc] using
          (List.Perm.append_left held (List.perm_append_comm (l₁ := [value]) (l₂ := back.map Prod.snd))))
    have headOutput := head.custody headInput
    exact headOutput.permPending (by
      simpa only [List.map_append, List.append_assoc] using
        (List.Perm.append_left held (List.perm_append_comm (l₁ := back.map Prod.snd) (l₂ := front.map Prod.snd))))
end

end Grounded

/- Section: StatePatterns -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

mutual
theorem Pattern.Consumes.loans_length {before after : Environment} {pattern : Pattern} {value : Value}
 {bindings : BindingValues} {trace : List (List Nat)}
 (consumed : Pattern.Consumes program before pattern value bindings after trace) :
 after.loans.length = before.loans.length := by
 cases consumed with
 | wildcard disposed | literal disposed => exact disposed.loans_length
 | binder => rfl
 | node _ _ fields => exact fields.loans_length

theorem ConsumesFields.loans_length {before after : Environment} {index : Nat}
 {patterns : List Pattern} {values : List Value} {bindings : BindingValues} {trace : List (List Nat)}
 (consumed : ConsumesFields program before index patterns values bindings after trace) :
 after.loans.length = before.loans.length := by
 cases consumed with
 | nil => rfl
 | cons tail head => exact head.loans_length.trans tail.loans_length
end

theorem StateTyped.consumePattern {interpretation : Interpretation} {before after : Context}
 {heldPayloads : List SourcePayload} {environment : Environment} {held : List Value}
 {pattern : Pattern} {result : ResultType} {value : Value}
 {types : List (String × ResultType)} {bindings : BindingValues}
 (typed : StateTyped program interpretation before (heldPayloads ++ [result.payload]) environment (held ++ [value]))
 (source : PatternType program home heldPayloads before pattern result (.produced types after))
 (subject : ResultTyped program interpretation before result value)
 (matched : pattern.matchValue value = some bindings) :
 ∃ final trace,
   Pattern.Consumes program environment pattern value bindings final trace ∧
   BindingResultsTyped program interpretation after types bindings ∧
   StateTyped program interpretation after (heldPayloads ++ bindingPayloads types)
     final (held ++ bindings.map Prod.snd) ∧
   StateProgress before after environment final interpretation interpretation := by
 obtain ⟨final, trace, consumed, store, outputs, _⟩ := source.consume_produced subject typed.toStoreTyped matched
 have original : before.NodesAvailable (payloadNodes heldPayloads) := by
   intro node member
   exact ⟨typed.heldOwn node (by simp [payloadNodes_append, member]),
     typed.heldReady node (by simp [payloadNodes_append, member])⟩
 have available : before.PayloadAvailable result.payload := by
   intro node member
   exact ⟨typed.heldOwn node (by simp [payloadNodes_append, payloadNodes, member]),
     typed.heldReady node (by simp [payloadNodes_append, payloadNodes, member])⟩
 obtain ⟨observed, retained, outputAvailable⟩ := source.resourcePreserves typed.observedOwn original available
 have length : heldPayloads.length = held.length := by
   have total := typed.heldShape.length
   simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using total
 have front := (typed.heldShape.append_inv length).1
 have allAvailable : after.NodesAvailable (payloadNodes (heldPayloads ++ bindingPayloads types)) := by
   rw [payloadNodes_append]
   exact retained.append outputAvailable
 refine ⟨final, trace, consumed, outputs, ?_, ?_⟩
 · exact { store with
     heldShape := front.append outputs.corresponds
     heldOwn := fun node member => (allAvailable node member).1
     heldReady := fun node member => (allAvailable node member).2
     observedOwn := observed
     custody := consumed.custody typed.custody }
 · refine ⟨source.history, source.reflectsSupport, .refl _ _, ?_, ?_⟩
   · intro binder fresh mentioned
     have bound := store.source.mentionedBound mentioned
     rw [source.sourceEffects.supply] at bound
     exact False.elim (Nat.not_lt_of_ge fresh bound)
   · rw [source.sourceEffects.loans, consumed.loans_length]

end Grounded

/- Section: StateCopy -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem Environment.Copies.storage {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) : before.SameStorage after := by
  induction copied using Copies.rec
    (motive_2 := fun before _ _ after _ => before.SameStorage after) with
  | data | reference | nil => exact ⟨rfl, rfl, rfl⟩
  | tuple _ _ first rest => exact ⟨rest.bindings.trans first.bindings, rest.store.trans first.store, rest.supply.trans first.supply⟩
  | array _ ih | nominal _ ih => exact ih
  | cons _ _ first rest => exact ⟨rest.bindings.trans first.bindings, rest.store.trans first.store, rest.supply.trans first.supply⟩

theorem Environment.Copies.of_children {before after : Environment} {value : Value} {values : List Value}
    (source : value.head.Source) (copied : CopiesFields before value.children values after) :
    ∃ result, Copies before value result after ∧ result.head = value.head ∧ result.children = values := by
  cases value with
  | reference => exact False.elim source
  | vacant | unit | integer | character =>
    cases copied
    exact ⟨_, .data (by trivial), rfl, rfl⟩
  | tuple head tail =>
    cases copied with
    | cons first rest => exact ⟨_, .tuple first rest, rfl, rfl⟩
  | array values => exact ⟨_, .array copied, rfl, rfl⟩
  | nominal identity tag values => exact ⟨_, .nominal copied, rfl, rfl⟩

mutual
theorem StateTyped.copyPayload {before after : Context} {source copied : SourcePayload}
    (copy : Context.CopyPayload before source copied after)
    {interpretation : Interpretation} {heldPayloads : List SourcePayload} {environment : Environment} {held : List Value}
    (typed : StateTyped program interpretation before heldPayloads environment held)
    {type : Ty} (payloadTyped : source.Typed program before.loans type) {value : Value}
    (related : source.Corresponds interpretation.node value) :
    ∃ final last result, Environment.Copies environment value result final ∧
      StateTyped program last after (heldPayloads ++ [copied]) final (held ++ [result]) ∧
      copied.Typed program after.loans type ∧ copied.Corresponds last.node result ∧
      StateProgress before after environment final interpretation last := by
  cases copy with
  | plain =>
    cases related with
    | plain free => exact ⟨environment, interpretation, value, .data free, typed.appendPlain free, .plain type, .plain free, .refl typed.source⟩
  | @reference context node loan found shared own ready permitted =>
    cases related
    cases payloadTyped with
    | @reference typedNode typedLoan typedFound =>
      have equal : typedLoan = loan := Option.some.inj (typedFound.symm.trans found)
      subst typedLoan
      obtain ⟨ownLoan, ownFound, ownBit⟩ := own
      have ownEqual : ownLoan = loan := Option.some.inj (ownFound.symm.trans found)
      subst ownLoan
      have targetReady := ready loan found ownBit
      have known := typed.source.loanKnown found
      have finite := (typed.source.targets node loan found).2
      have ancestor : ∀ parent, some node = some parent → ∃ sourceLoan, before.loans[parent]? = some sourceLoan ∧ loan.target.Within sourceLoan.target := by
        intro parent same
        cases Option.some.inj same
        exact ⟨loan, found, rfl, ⟨[], by simp⟩⟩
      have state := typed.borrow (parent := some node) (mode := .shared) known (typed.source.targets node loan found).1 finite ancestor
        (fun _ _ _ _ impossible => by cases impossible)
        (by simpa only [Context.SourceTarget, shared] using typed.sourceTargets node loan found ownBit)
        targetReady
        (fun payload target inner member => typed.observedOwn node loan found ownBit payload target inner member)
      refine ⟨_, _, _, Environment.Copies.reference (typed.records node loan found) shared (typed.toStoreTyped.usable ⟨loan, found, ownBit⟩), state, ?_, ?_, .borrow typed.source known⟩
      · simpa only [shared] using (SourcePayload.Typed.reference (program := program)
          (Context.borrow_last before loan.target loan.referent (some node) .shared))
      · simpa only [Interpretation.addNode, ↓reduceIte] using
          (SourcePayload.Corresponds.reference (node := (interpretation.addNode before.loans.length environment.loans.length).node) before.loans.length)
  | @aggregate before after head fields copiedFields children =>
    cases payloadTyped with
    | aggregate source shape residents =>
      cases related with
      | aggregate _ constructor relatedFields =>
        obtain ⟨final, last, values, copiedValues, state, copiedTyped, corresponding, progress⟩ :=
          StateTyped.copyPayloads children typed residents relatedFields
        obtain ⟨result, copiedValue, resultHead, resultChildren⟩ := Environment.Copies.of_children (constructor ▸ source) copiedValues
        have aggregate : (SourcePayload.aggregate head copiedFields).Corresponds last.node result :=
          .aggregate source (resultHead.trans constructor) (resultChildren ▸ corresponding)
        have packed := StateTyped.pack (value := result) (by simpa only [resultChildren] using state) aggregate
        exact ⟨final, last, result, copiedValue, packed, .aggregate source shape copiedTyped, aggregate, progress⟩

theorem StateTyped.copyPayloads {before after : Context} {sources copied : List SourcePayload}
    (copy : Context.CopyPayloads before sources copied after)
    {interpretation : Interpretation} {heldPayloads : List SourcePayload} {environment : Environment} {held : List Value}
    (typed : StateTyped program interpretation before heldPayloads environment held)
    {types : List Ty} (payloadTyped : PayloadsTyped program before.loans sources types) {values : List Value}
    (related : PayloadsCorrespond interpretation.node sources values) :
    ∃ final last results, Environment.CopiesFields environment values results final ∧
      StateTyped program last after (heldPayloads ++ copied) final (held ++ results) ∧
      PayloadsTyped program after.loans copied types ∧ PayloadsCorrespond last.node copied results ∧
      StateProgress before after environment final interpretation last := by
  cases copy with
  | nil =>
    cases payloadTyped
    cases related
    exact ⟨environment, interpretation, [], .nil, by simpa using typed, .nil, .nil, .refl typed.source⟩
  | cons first rest =>
    cases payloadTyped with
    | cons headTyped tailTyped =>
      cases related with
      | cons headRelated tailRelated =>
        obtain ⟨middle, middleMap, headValue, headCopy, middleTyped, copiedHeadTyped, copiedHeadRelated, headProgress⟩ :=
          StateTyped.copyPayload first typed headTyped headRelated
        have tailTypedMiddle := tailTyped.transport (fun node loan found => by
          obtain ⟨retained, kept, _, referent, _, mode, _⟩ := headProgress.history.records node loan found
          exact ⟨retained, kept, referent, mode⟩)
        have tailRelatedMiddle := tailRelated.congr (right := middleMap.node) (fun node member => by
          obtain ⟨loan, found⟩ := tailTyped.node_found member
          exact (headProgress.interpretation.nodes node (List.getElem?_eq_some_iff.mp found).1).symm)
        obtain ⟨final, last, tailValues, tailCopy, finalTyped, copiedTailTyped, copiedTailRelated, tailProgress⟩ :=
          StateTyped.copyPayloads rest middleTyped tailTypedMiddle tailRelatedMiddle
        have headTypedAfter := copiedHeadTyped.transport (fun node loan found => by
          obtain ⟨retained, kept, _, referent, _, mode, _⟩ := tailProgress.history.records node loan found
          exact ⟨retained, kept, referent, mode⟩)
        have headRelatedAfter := copiedHeadRelated.congr (right := last.node) (fun node member =>
          (tailProgress.interpretation.nodes node (copiedHeadTyped.node_bound member)).symm)
        exact ⟨final, last, headValue :: tailValues, .cons headCopy tailCopy,
          by simpa only [List.append_assoc, List.singleton_append] using finalTyped,
          .cons headTypedAfter copiedTailTyped, .cons headRelatedAfter copiedTailRelated,
          headProgress.trans tailProgress (Nat.le_of_eq headCopy.storage.supply.symm)⟩
end

end Grounded

/- Section: StateCopyResults -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem Environment.Copies.resident {before after : Environment} {value copied : Value}
    (copy : Copies before value copied after) {type : Ty} (typed : ValueHasType program value type) :
    ValueHasType program copied type := by
  induction copy using Copies.rec
    (motive_2 := fun before values copied after _ => ∀ types,
      ValuesHaveTypes program values types → ValuesHaveTypes program copied types) generalizing type with
  | data => exact typed
  | reference found shared allowed => cases typed with | reference node finite => exact .reference _ finite
  | tuple first rest ihFirst ihRest =>
    cases typed with
    | tuple head tail present => exact .tuple (ihFirst head) (ihRest _ tail) present
  | array fields ih =>
    cases typed with
    | array residents finite size present =>
      have copiedTyped := ih _ residents
      exact .array copiedTyped finite size present
  | nominal fields ih =>
    cases typed with
    | nominal declared chosen finite residents present => exact .nominal declared chosen finite (ih _ residents) present
  | nil => assumption
  | cons first rest ihFirst ihRest =>
    rename_i types typed
    cases typed with
    | cons head tail => exact .cons (ihFirst head) (ihRest _ tail)

theorem StateTyped.copyResult {before after : Context} {source copied : SourcePayload}
    (copy : Context.CopyPayload before source copied after)
    {interpretation : Interpretation} {heldPayloads : List SourcePayload} {environment : Environment} {held : List Value}
    (typed : StateTyped program interpretation before heldPayloads environment held)
    {type : Ty} {value : Value} (resident : ResultTyped program interpretation before ⟨type, source⟩ value) :
    ∃ final last result, Environment.Copies environment value result final ∧
      StateTyped program last after (heldPayloads ++ [copied]) final (held ++ [result]) ∧
      ResultTyped program last after ⟨type, copied⟩ result ∧
      StateProgress before after environment final interpretation last := by
  obtain ⟨final, last, result, copiedValue, state, payloadTyped, related, progress⟩ :=
    typed.copyPayload copy resident.payload resident.corresponds
  exact ⟨final, last, result, copiedValue, state, ⟨copiedValue.resident resident.resident, payloadTyped, related⟩, progress⟩

end Grounded

/- Section: RuntimeCanonical -/

namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

mutual
inductive Evaluates (program : Program) : Environment → Core → Value → Environment → Prop where
  | unit {environment : Environment} : Evaluates program environment ⟨.unit, .leaf⟩ .unit environment
  | integer {environment : Environment} {type : IntegerType} {magnitude : Nat}
      (fits : type.Contains program.target magnitude) :
      Evaluates program environment ⟨.integer type magnitude, .leaf⟩ (.integer type magnitude) environment
  | character {environment : Environment} {number : Nat} (valid : UnicodeScalar number) :
      Evaluates program environment ⟨.character number, .leaf⟩ (.character number) environment
  | group {environment after : Environment} {body : Expr} {plan : CorePlan} {value : Value}
      (evaluated : Evaluates program environment ⟨body, plan⟩ value after) :
      Evaluates program environment ⟨.group body, .unary plan⟩ value after
  | read {environment after : Environment} {place : Place} {address : Address} {resident value : Value}
      (resolved : environment.resolvePlace program place = some address)
      (selected : environment.readAddress address = some resident)
      (permitted : environment.Permits .shared none address)
      (copied : Environment.Copies environment resident value after) :
      Evaluates program environment ⟨.read place, .leaf⟩ value after
  | move {environment after : Environment} {place : Place} {address : Address} {value : Value}
      (resolved : environment.resolvePlace program place = some address)
      (free : environment.OwnerFree address) (allowed : environment.ResultUsable value)
      (taken : environment.takeAddress address = some (value, after)) :
      Evaluates program environment ⟨.move place, .leaf⟩ value after
  | implicitMove {environment after : Environment} {place : Place} {value : Value}
      (moved : Evaluates program environment ⟨.move place, .leaf⟩ value after) :
      Evaluates program environment ⟨.read place, .implicitMove⟩ value after
  | borrow {environment : Environment} {place : AccessPlace} {access : Environment.ResolvedAccess} {value : Value}
      {mode : BorrowMode}
      (resolved : environment.resolveAccess program place = some access)
      (carrier : environment.CarrierPermits program mode place)
      (allowed : environment.Authorizes mode access)
      (permitted : environment.Permits mode access.parent access.address)
      (ready : environment.AccessReady access)
      (selected : environment.readAddress access.address = some value) (plain : environment.ResultUsable value) :
      Evaluates program environment ⟨.borrow mode place, .leaf⟩ (.reference environment.loans.length)
        (environment.addLoan access mode)
  | reborrow {environment : Environment} {place : Place} {access : Environment.ResolvedAccess} {value : Value}
      {mode : BorrowMode}
      (resolved : environment.resolveAccess program (.dereference place []) = some access)
      (carrier : environment.CarrierPermits program mode (.dereference place []))
      (allowed : environment.Authorizes mode access)
      (permitted : environment.Permits mode access.parent access.address)
      (ready : environment.AccessReady access)
      (selected : environment.readAddress access.address = some value) (plain : environment.ResultUsable value) :
      Evaluates program environment ⟨.read place, .reborrow mode⟩ (.reference environment.loans.length)
        (environment.addLoan access mode)
  | dereference {environment after : Environment} {reference : Place} {fields : List FieldKey}
      {access : Environment.ResolvedAccess} {resident value : Value}
      (resolved : environment.resolveAccess program (.dereference reference fields) = some access)
      (carrier : environment.CarrierPermits program .shared (.dereference reference fields))
      (allowed : environment.Authorizes .shared access)
      (permitted : environment.Permits .shared access.parent access.address)
      (ready : environment.AccessReady access)
      (selected : environment.readAddress access.address = some resident) (usable : environment.ResultUsable resident)
      (copied : Environment.Copies environment resident value after) :
      Evaluates program environment ⟨.dereference reference fields, .leaf⟩ value after
  | moveIndirect {environment after : Environment} {reference : Place} {fields : List FieldKey}
      {access : Environment.ResolvedAccess} {value : Value}
      (resolved : environment.resolveAccess program (.dereference reference fields) = some access)
      (carrier : environment.CarrierPermits program .unique (.dereference reference fields))
      (allowed : environment.Authorizes .unique access)
      (permitted : environment.Permits .unique access.parent access.address)
      (ready : environment.AccessReady access) (plain : environment.ResultUsable value)
      (taken : environment.takeAddress access.address = some (value, after)) :
      Evaluates program environment ⟨.moveIndirect reference fields, .leaf⟩ value after
  | assignIndirect {environment middle disposed updated after : Environment} {reference : Place} {fields : List FieldKey}
      {expression rest : Expr} {expressionPlan restPlan : CorePlan} {access : Environment.ResolvedAccess}
      {resident old value : Value}
      (evaluated : Evaluates program environment ⟨expression, expressionPlan⟩ resident middle)
      (resolved : middle.resolveAccess program (.dereference reference fields) = some access)
      (carrier : middle.CarrierPermits program .unique (.dereference reference fields))
      (allowed : middle.Authorizes .unique access)
      (permitted : middle.Permits .unique access.parent access.address)
      (previous : middle.at access.address = some old) (dispose : Environment.Disposes program middle old disposed)
      (usable : disposed.ResultUsable resident)
      (written : disposed.writeAddress access.address resident = some updated)
      (continued : Evaluates program updated ⟨rest, restPlan⟩ value after) :
      Evaluates program environment ⟨.assignIndirect reference fields expression rest, .binary expressionPlan restPlan⟩ value after
  | endOwn {environment ended after : Environment} {expression : Expr} {plan : CorePlan} {slot : Nat} {value : Value} {fields : List Nat}
      (endedOwn : environment.endSlot slot fields = some ended)
      (continued : Evaluates program ended ⟨expression, plan⟩ value after) :
      Evaluates program environment ⟨expression, .endOwn slot plan fields⟩ value after
  | endAfter {environment middle after : Environment} {expression : Expr} {plan : CorePlan} {slot : Nat} {value : Value} {fields : List Nat}
      (evaluated : Evaluates program environment ⟨expression, plan⟩ value middle)
      (endedOwn : middle.endSlot slot fields = some after) (usable : after.ResultUsable value) :
      Evaluates program environment ⟨expression, .endAfter slot plan fields⟩ value after
  | sequence {environment middle disposed after : Environment} {first rest : Expr} {firstPlan restPlan : CorePlan}
      {discarded value : Value} (head : Evaluates program environment ⟨first, firstPlan⟩ discarded middle)
      (dispose : Environment.Disposes program middle discarded disposed)
      (tail : Evaluates program disposed ⟨rest, restPlan⟩ value after) :
      Evaluates program environment ⟨.sequence first rest, .binary firstPlan restPlan⟩ value after
  | bind {environment middle localAfter after : Environment} {mutable : Bool} {name : String}
      {annotation : Option TypeExpr} {initial body : Expr} {initialPlan bodyPlan : CorePlan} {resident value : Value}
      (initialized : Evaluates program environment ⟨initial, initialPlan⟩ resident middle)
      (allowed : middle.ResultUsable resident)
      (continued : Evaluates program (middle.bind name resident) ⟨body, bodyPlan⟩ value localAfter)
      (cleanup : ∃ trace, Cleans program 1 localAfter trace after) (usable : after.ResultUsable value) :
      Evaluates program environment ⟨.bind mutable name annotation initial body, .binary initialPlan bodyPlan⟩ value after
  | assign {environment middle disposed updated after : Environment} {place : Place}
      {expression rest : Expr} {expressionPlan restPlan : CorePlan} {address : Address} {resident old value : Value}
      (evaluated : Evaluates program environment ⟨expression, expressionPlan⟩ resident middle)
      (resolved : middle.resolvePlace program place = some address) (free : middle.OwnerFree address)
      (previous : middle.at address = some old) (dispose : Environment.Disposes program middle old disposed)
      (allowed : disposed.ResultUsable resident) (written : disposed.writeAddress address resident = some updated)
      (continued : Evaluates program updated ⟨rest, restPlan⟩ value after) :
      Evaluates program environment ⟨.assign place expression rest, .binary expressionPlan restPlan⟩ value after
  | tuple {environment middle after : Environment} {head : Expr} {tail : List Expr}
      {headPlan : CorePlan} {tailPlans : List CorePlan} {first : Value} {rest : List Value}
      (headEval : Evaluates program environment ⟨head, headPlan⟩ first middle)
      (tailEval : EvaluatesList program middle tail tailPlans rest after)
      (plain : after.ResultUsable (.tuple first rest)) :
      Evaluates program environment ⟨.tuple head tail, .batch (headPlan :: tailPlans)⟩ (.tuple first rest) after
  | array {environment after : Environment} {elements : List Expr} {plans : List CorePlan} {values : List Value}
      (residents : EvaluatesList program environment elements plans values after) (plain : after.ResultUsable (.array values)) :
      Evaluates program environment ⟨.array elements, .batch plans⟩ (.array values) after
  | constant {environment constantAfter : Environment} {name : String} {declaration : ConstantDecl}
      {plan : CorePlan} {value : Value} (declared : program.constants name = some declaration)
      (initialized : Evaluates program environment.hide ⟨declaration.body, plan⟩ value constantAfter)
      (plain : value.ReferenceFree) :
      Evaluates program environment ⟨.constant name, .unary plan⟩ value (environment.resume constantAfter)
  | construct {environment after : Environment} {identity : Nat} {tag : Option Nat}
      {fields : List Expr} {plans : List CorePlan} {values : List Value}
      (residents : EvaluatesList program environment fields plans values after) (plain : after.ResultUsable (.nominal identity tag values)) :
      Evaluates program environment ⟨.construct identity tag fields, .batch plans⟩ (.nominal identity tag values) after
  | field {environment middle after : Environment} {body : Expr} {plan : CorePlan}
      {key : FieldKey} {parent value residual : Value}
      (source : Evaluates program environment ⟨body, plan⟩ parent middle)
      (selected : parent.readField program key = some value) (extracted : parent.takeField program key = some residual)
      (dispose : Environment.Disposes program middle residual after) (usable : after.ResultUsable value) :
      Evaluates program environment ⟨.field body key, .unary plan⟩ value after
  | call {environment middle localAfter cleaned : Environment} {identity : Nat} {arguments : List Expr}
      {argumentPlans : List CorePlan} {bodyPlan : CorePlan} {declaration : FunctionDecl}
      {values : List Value} {value : Value} (declared : program.functions identity = some declaration)
      (inputs : EvaluatesList program environment arguments argumentPlans values middle)
      (body : Evaluates program (middle.hide.prepare (List.zip (declaration.parameters.map Prod.fst) values))
        ⟨declaration.body, bodyPlan⟩ value localAfter)
      (cleanup : ∃ trace, Cleans program (List.zip (declaration.parameters.map Prod.fst) values).length localAfter trace cleaned)
      (usable : cleaned.ResultUsable value) :
      Evaluates program environment ⟨.call identity arguments, .call argumentPlans bodyPlan⟩ value (middle.resume cleaned)
  | applyPatterns {environment middle consumedAfter localAfter after : Environment} {inputs : List Ty} {arguments : List Expr}
      {arms : List (PatternSource × Expr)} {argumentPlans : List CorePlan} {armPlans : List (PatternPlan × CorePlan)}
      {normalized : List (Pattern × Core)} {values : List Value} {bindings : List (String × Value)} {body : Core} {value : Value}
      (normalization : NormalizesArms program arms armPlans normalized)
      (argumentsEval : EvaluatesList program environment arguments argumentPlans values middle)
      (pending : middle.ResultUsable (argumentValue values))
      (selected : ConsumesArm program middle (argumentValue values) normalized bindings body consumedAfter)
      (bodyEval : Evaluates program (consumedAfter.prepare bindings) body value localAfter)
      (cleanup : ∃ trace, Cleans program bindings.length localAfter trace after) (usable : after.ResultUsable value) :
      Evaluates program environment ⟨.applyPatterns inputs arguments arms, .patterns argumentPlans armPlans⟩ value after

inductive EvaluatesList (program : Program) : Environment → List Expr → List CorePlan → List Value → Environment → Prop where
  | nil {environment : Environment} : EvaluatesList program environment [] [] [] environment
  | cons {environment middle after : Environment} {head : Expr} {tail : List Expr}
      {headPlan : CorePlan} {tailPlans : List CorePlan} {first : Value} {rest : List Value}
      (headEval : Evaluates program environment ⟨head, headPlan⟩ first middle)
      (tailEval : EvaluatesList program middle tail tailPlans rest after) (usable : after.ResultUsable first) :
      EvaluatesList program environment (head :: tail) (headPlan :: tailPlans) (first :: rest) after
inductive NormalizesPattern (program : Program) : PatternSource → PatternPlan → Pattern → Prop where
  | wildcard : NormalizesPattern program .wildcard .leaf .wildcard
  | binder (name : String) : NormalizesPattern program (.binder name) .leaf (.binder name)
  | node {head : Head} {source : List PatternSource} {plans : List PatternPlan} {result : List Pattern}
      (fields : NormalizesPatterns program source plans result) :
      NormalizesPattern program (.node head source) (.node plans) (.node head result)
  | constantValue {name : String} {declaration : ConstantDecl} {type : Ty} {value : Value} {plan : CorePlan}
      (declared : program.constants name = some declaration) (resolved : ResolvesType program.aliases declaration.type type)
      {constantAfter : Environment} (evaluated : Evaluates program .empty ⟨.constant name, plan⟩ value constantAfter) :
      NormalizesPattern program (.constant name) (.constant plan) (.literal (some type) value)
inductive NormalizesPatterns (program : Program) : List PatternSource → List PatternPlan → List Pattern → Prop where
  | patternsNil : NormalizesPatterns program [] [] []
  | patternsCons {source : PatternSource} {sources : List PatternSource} {plan : PatternPlan} {plans : List PatternPlan}
      {result : Pattern} {results : List Pattern}
      (head : NormalizesPattern program source plan result) (tail : NormalizesPatterns program sources plans results) :
      NormalizesPatterns program (source :: sources) (plan :: plans) (result :: results)
inductive NormalizesArms (program : Program) : List (PatternSource × Expr) → List (PatternPlan × CorePlan) → List (Pattern × Core) → Prop where
  | armsNil : NormalizesArms program [] [] []
  | armsCons {source : PatternSource} {pattern : Pattern} {body : Expr} {patternPlan : PatternPlan} {bodyPlan : CorePlan}
      {sources : List (PatternSource × Expr)} {plans : List (PatternPlan × CorePlan)} {results : List (Pattern × Core)}
      (head : NormalizesPattern program source patternPlan pattern) (tail : NormalizesArms program sources plans results) :
      NormalizesArms program ((source, body) :: sources) ((patternPlan, bodyPlan) :: plans) ((pattern, ⟨body, bodyPlan⟩) :: results)
end

theorem Value.replaceChild_fieldIndex {value replacement updated : Value} {index : Nat}
    (written : value.replaceChild index replacement = some updated) :
    ∀ key, updated.fieldIndex program key = value.fieldIndex program key := by
  cases value with
  | vacant | unit | integer | character | array | reference => simp [Value.replaceChild] at written
  | tuple head tail =>
    cases index with
    | zero => cases Option.some.inj written; intro key; cases key <;> rfl
    | succ index =>
      obtain ⟨old, _, same⟩ := Option.map_eq_some_iff.mp written
      cases same
      intro key; cases key <;> rfl
  | nominal identity tag fields =>
    obtain ⟨old, _, same⟩ := Option.map_eq_some_iff.mp written
    cases same
    intro key; cases tag <;> cases key <;> rfl

theorem Value.resolvePath_write {value replacement updated : Value} {keys : List FieldKey} {indices : List Nat}
    (resolved : value.resolvePath program keys = some indices)
    (written : value.writeIndices indices replacement = some updated) :
    updated.resolvePath program keys = some indices := by
  induction keys generalizing value updated indices with
  | nil => simp only [Value.resolvePath, Option.some.injEq] at resolved; subst indices; rfl
  | cons key keys ih =>
    simp only [Value.resolvePath, Bind.bind, Option.bind_eq_some_iff] at resolved
    obtain ⟨index, indexed, child, found, rest, tail, same⟩ := resolved
    cases same
    simp only [Value.writeIndices, Bind.bind, found, Option.bind_some, Option.bind_eq_some_iff] at written
    obtain ⟨next, changed, replaced⟩ := written
    have indexSame := Value.replaceChild_fieldIndex (program := program) replaced
    have readback := Value.replaceChild_readback replaced
    simp [Value.resolvePath, indexSame, indexed, readback, ih tail changed]

structure Environment.AddressUpdate (before after : Environment) (address : Address) (replacement : Value) : Prop where
  bindings : after.bindings = before.bindings
  supply : after.nextRoot = before.nextRoot
  readback : after.at address = some replacement
  frame : ∀ observed, address.Apart observed → after.at observed = before.at observed

theorem Environment.writeAddress_update {address : Address} {replacement : Value} {before after : Environment}
    (written : before.writeAddress address replacement = some after) : before.AddressUpdate after address replacement := by
  have readback := Environment.writeAddress_readback written
  simp only [Environment.writeAddress, Bind.bind, Option.bind_eq_some_iff] at written
  obtain ⟨parent, found, updated, changed, same⟩ := written
  cases same
  refine ⟨rfl, rfl, readback, ?_⟩
  intro observed apart
  rcases apart with different | apart
  · simp [Environment.at, Environment.put, Ne.symm different]
  · by_cases equal : observed.root = address.root
    · simp [Environment.at, Environment.put, equal, found, Value.writeIndices_frame changed apart]
    · simp [Environment.at, Environment.put, equal]

theorem Environment.resolvePlace_write {place : Place} {address : Address} {replacement : Value} {before after : Environment}
    (resolved : before.resolvePlace program place = some address)
    (written : before.writeAddress address replacement = some after) :
    after.resolvePlace program place = some address := by
  simp only [Environment.resolvePlace, Bind.bind, Option.bind_eq_some_iff] at resolved
  obtain ⟨root, named, parent, found, indices, path, same⟩ := resolved
  cases same
  simp only [Environment.writeAddress, Bind.bind, found, Option.bind_some, Option.bind_eq_some_iff] at written
  obtain ⟨updated, changed, same⟩ := written
  cases same
  simp [Environment.resolvePlace, Environment.put, named, Value.resolvePath_write path changed]

theorem Environment.takeAddress_invalidates {address : Address} {before after : Environment} {value : Value}
    (taken : before.takeAddress address = some (value, after)) : after.readAddress address = none := by
  have readback := (Environment.writeAddress_update (Environment.takeAddress_eq_some.mp taken).2).readback
  simp [Environment.readAddress, readback, Value.initialized]

/-- An actual move keeps the canonical source address and invalidates its resident. -/

theorem Evaluates.move_invalidates {place : Place} {before after : Environment} {value : Value}
    (evaluated : Evaluates program before ⟨.move place, .leaf⟩ value after) :
    ∃ address, before.resolvePlace program place = some address ∧
      after.resolvePlace program place = some address ∧ after.readAddress address = none := by
  cases evaluated with
  | move resolved free allowed taken => exact ⟨_, resolved,
      Environment.resolvePlace_write resolved (Environment.takeAddress_eq_some.mp taken).2,
      Environment.takeAddress_invalidates taken⟩

/-- Default transfer invalidates exactly the same source resident as explicit move. -/

theorem Evaluates.implicitMove_invalidates {place : Place} {before after : Environment} {value : Value}
    (evaluated : Evaluates program before ⟨.read place, .implicitMove⟩ value after) :
    ∃ address, before.resolvePlace program place = some address ∧
      after.resolvePlace program place = some address ∧ after.readAddress address = none := by
  cases evaluated with
  | implicitMove moved => exact moved.move_invalidates

/-- Owned projection transfers its child before cleanup. No event can target
that child's former slot or descendants, even when its type is not Copy. -/

theorem Evaluates.field_protects_result {before after : Environment} {body : Expr} {plan : CorePlan} {key : FieldKey} {value : Value}
    (evaluated : Evaluates program before ⟨.field body key, .unary plan⟩ value after) :
    ∃ (middle : Environment) (parent residual : Value) (index : Nat) (trace : List (List Nat)),
      Evaluates program before ⟨body, plan⟩ parent middle ∧
      parent.readField program key = some value ∧ parent.fieldIndex program key = some index ∧
      residual.children[index]? = some .vacant ∧ Environment.Disposes program middle residual after ∧
      residual.Destroys program trace .vacant ∧ ∀ suffix, index :: suffix ∉ trace := by
  cases evaluated with
  | field source selected extracted dispose usable =>
    simp only [Value.takeField, Bind.bind, Option.bind_eq_some_iff] at extracted
    obtain ⟨index, indexed, child, found, written⟩ := extracted
    have vacant := Value.replaceChild_readback written
    exact ⟨_, _, _, index, _, source, selected, indexed, vacant, dispose, dispose.logical,
      fun suffix => dispose.logical.skips_vacant_field vacant suffix⟩

theorem Evaluates.move_restore {place : Place} {before after : Environment} {value : Value}
    (evaluated : Evaluates program before ⟨.move place, .leaf⟩ value after) :
    ∃ address, before.resolvePlace program place = some address ∧
      after.resolvePlace program place = some address ∧ after.writeAddress address value = some before := by
  cases evaluated with
  | move resolved free allowed taken =>
    obtain ⟨read, written⟩ := Environment.takeAddress_eq_some.mp taken
    simp only [Environment.readAddress, Bind.bind, Option.bind_eq_some_iff] at read
    obtain ⟨resident, found, live⟩ := read
    split at live
    · cases Option.some.inj live
      exact ⟨_, resolved, Environment.resolvePlace_write resolved written, Environment.writeAddress_inverse found written⟩
    · cases live

/-- Indirect extraction creates a real canonical vacancy; writing the extracted
resident back recovers the entire original store, including hidden cells. -/

theorem Evaluates.moveIndirect_restore {reference : Place} {fields : List FieldKey}
    {before after : Environment} {value : Value}
    (evaluated : Evaluates program before ⟨.moveIndirect reference fields, .leaf⟩ value after) :
    ∃ access, before.resolveAccess program (.dereference reference fields) = some access ∧
      after.at access.address = some .vacant ∧ after.readAddress access.address = none ∧
      after.writeAddress access.address value = some before := by
  cases evaluated with
  | moveIndirect resolved _ _ _ _ _ taken =>
    obtain ⟨read, written⟩ := Environment.takeAddress_eq_some.mp taken
    simp only [Environment.readAddress, Bind.bind, Option.bind_eq_some_iff] at read
    obtain ⟨resident, found, live⟩ := read
    split at live
    · cases Option.some.inj live
      exact ⟨_, resolved, Environment.writeAddress_readback written,
        Environment.takeAddress_invalidates taken, Environment.writeAddress_inverse found written⟩
    · cases live

theorem StoredBindings.unique {store : Store} {bindings : List (String × Root)} {first second : BindingValues}
    (left : StoredBindings store bindings first) (right : StoredBindings store bindings second) : first = second := by
  induction left generalizing second with
  | nil => cases right; rfl
  | cons found rest ih =>
    cases right with
    | cons otherFound otherRest =>
      cases Option.some.inj (found.symm.trans otherFound)
      cases ih otherRest
      rfl

theorem StoredBindings.bind {environment : Environment} {values : BindingValues}
    (stored : StoredBindings environment.store environment.bindings values) (valid : environment.Valid)
    (name : String) (value : Value) :
    StoredBindings (environment.bind name value).store (environment.bind name value).bindings ((name, value) :: values) := by
  refine .cons (by simp [Environment.bind]) ?_
  apply stored.frame
  intro root member
  have different : root ≠ environment.nextRoot := Nat.ne_of_lt (valid.named root member)
  simp only [Environment.bind, if_neg different]

/-- Preparation agrees with the previous logical binding order without rebuilding
storage from that observation: source inputs are installed once, left to right. -/

theorem StoredBindings.prepare {environment : Environment} {values : BindingValues}
    (stored : StoredBindings environment.store environment.bindings values) (valid : environment.Valid)
    (inputs : BindingValues) :
    StoredBindings (environment.prepare inputs).store (environment.prepare inputs).bindings (inputs.reverse ++ values) := by
  induction inputs generalizing environment values with
  | nil => exact stored
  | cons entry rest ih =>
    simpa [Environment.prepare, List.reverse_cons, List.append_assoc] using
      ih (stored.bind valid entry.1 entry.2) (valid.bind entry.1 entry.2)

theorem StoredBindings.retire {environment : Environment} {values : BindingValues}
    (stored : StoredBindings environment.store environment.bindings values) (valid : environment.Valid) (count : Nat) :
    StoredBindings (environment.retire count).store (environment.retire count).bindings (values.drop count) :=
  (stored.drop count).frame (fun _ member => Environment.retire_retained valid count member)

theorem StoredBindings.replace {store : Store} {bindings : List (String × Root)} {values after : BindingValues}
    (stored : StoredBindings store bindings values) (distinct : (bindings.map Prod.snd).Nodup)
    {name : String} {value : Value} (changed : replaceBinding name value values = some after) :
    ∃ root old, Grounded.lookup name bindings = some root ∧ store root = some old ∧
      StoredBindings (fun other => if other = root then some value else store other) bindings after := by
  induction stored generalizing after with
  | nil => simp [replaceBinding] at changed
  | @cons key root resident bindings values found rest ih =>
    obtain ⟨outside, distinct⟩ := List.nodup_cons.mp distinct
    simp only [replaceBinding] at changed
    split at changed
    next same =>
      cases changed
      refine ⟨root, resident, by simp [Grounded.lookup, same], found, .cons (by simp) ?_⟩
      apply rest.frame
      intro other member
      have different : other ≠ root := fun equal => outside (equal ▸ member)
      simp [different]
    next different =>
      obtain ⟨tailAfter, tailChanged, same⟩ := Option.map_eq_some_iff.mp changed
      cases same
      obtain ⟨selected, old, selectedRoot, selectedValue, tailStored⟩ := ih distinct tailChanged
      have unequal : root ≠ selected := fun equal => outside (equal ▸ Environment.lookup_mem selectedRoot)
      exact ⟨selected, old, by simp [Grounded.lookup, Ne.symm different, selectedRoot], selectedValue,
        .cons (by simp [unequal, found]) tailStored⟩

structure Environment.Agrees (left right : Environment) : Prop where
  leftValid : left.Valid
  rightValid : right.Valid
  values : ∃ values, StoredBindings left.store left.bindings values ∧ StoredBindings right.store right.bindings values

namespace Environment.Agrees
theorem get {left right : Environment} (same : left.Agrees right) (name : String) : left.get name = right.get name := by
  obtain ⟨values, first, second⟩ := same.values
  exact (first.lookup name).trans (second.lookup name).symm
end Environment.Agrees

namespace Environment.Agrees
theorem bind {left right : Environment} (same : left.Agrees right) (name : String) (value : Value) :
    (left.bind name value).Agrees (right.bind name value) := by
  obtain ⟨values, first, second⟩ := same.values
  exact ⟨same.leftValid.bind name value, same.rightValid.bind name value, (name, value) :: values,
    first.bind same.leftValid name value, second.bind same.rightValid name value⟩
end Environment.Agrees

namespace Environment.Agrees
theorem prepare {left right : Environment} (same : left.Agrees right) (inputs : BindingValues) :
    (left.prepare inputs).Agrees (right.prepare inputs) := by
  obtain ⟨values, first, second⟩ := same.values
  exact ⟨same.leftValid.prepare inputs, same.rightValid.prepare inputs, inputs.reverse ++ values,
    first.prepare same.leftValid inputs, second.prepare same.rightValid inputs⟩
end Environment.Agrees

namespace Environment.Agrees
theorem hide {left right : Environment} (same : left.Agrees right) : left.hide.Agrees right.hide :=
  ⟨same.leftValid.hide, same.rightValid.hide, [], .nil, .nil⟩
end Environment.Agrees

namespace Environment.Agrees
theorem retire {left right : Environment} (same : left.Agrees right) (count : Nat) :
    (left.retire count).Agrees (right.retire count) := by
  obtain ⟨values, first, second⟩ := same.values
  exact ⟨same.leftValid.retire count, same.rightValid.retire count, values.drop count,
    first.retire same.leftValid count, second.retire same.rightValid count⟩
end Environment.Agrees

namespace Environment.Agrees
theorem resume {left right first last : Environment} (same : left.Agrees right)
    (firstValid : first.Valid) (lastValid : last.Valid)
    (leftFrame : left.hide.Evolution first) (rightFrame : right.hide.Evolution last)
    (leftShared : ∀ root, ¬ left.UniqueRoot root) (rightShared : ∀ root, ¬ right.UniqueRoot root) :
    (left.resume first).Agrees (right.resume last) := by
  obtain ⟨values, leftStored, rightStored⟩ := same.values
  exact ⟨same.leftValid.resume firstValid leftFrame.supply, same.rightValid.resume lastValid rightFrame.supply, values,
    leftStored.frame (fun root _ => leftFrame.frame root (by simpa [Environment.MutationRoot, Environment.UniqueRoot, Environment.roots, Environment.hide] using leftShared root)),
    rightStored.frame (fun root _ => rightFrame.frame root (by simpa [Environment.MutationRoot, Environment.UniqueRoot, Environment.roots, Environment.hide] using rightShared root))⟩
end Environment.Agrees

namespace Environment.Agrees
theorem put {left right : Environment} (same : left.Agrees right) {name : String} {value : Value} {first last : Root}
    (leftName : Grounded.lookup name left.bindings = some first)
    (rightName : Grounded.lookup name right.bindings = some last) :
    (left.put first value).Agrees (right.put last value) := by
  obtain ⟨values, leftStored, rightStored⟩ := same.values
  have available : ∃ old, Grounded.lookup name values = some old := by
    cases found : Grounded.lookup name values with
    | some old => exact ⟨old, rfl⟩
    | none =>
      have rootPresent : ∀ {bindings values}, StoredBindings left.store bindings values →
          Grounded.lookup name bindings = some first → ∃ resident, left.store first = some resident := by
        intro bindings values stored
        induction stored with
        | nil => simp [Grounded.lookup]
        | cons present rest ih =>
          intro selected
          simp only [Grounded.lookup] at selected
          split at selected
          · cases selected; exact ⟨_, present⟩
          · exact ih selected
      obtain ⟨resident, present⟩ := rootPresent leftStored leftName
      have observed := leftStored.lookup name
      simp [leftName, present, found] at observed
  obtain ⟨old, available⟩ := available
  have replacements : ∀ {values : BindingValues}, Grounded.lookup name values = some old →
      ∃ next, replaceBinding name value values = some next := by
    intro values found
    induction values with
    | nil => simp [Grounded.lookup] at found
    | cons entry rest ih =>
      simp only [Grounded.lookup] at found
      split at found
      next equal => exact ⟨(entry.1, value) :: rest, by simp [replaceBinding, equal]⟩
      next different =>
        obtain ⟨next, changed⟩ := ih found
        exact ⟨entry :: next, by simp [replaceBinding, Ne.symm different, changed]⟩
  obtain ⟨next, changed⟩ := replacements available
  obtain ⟨leftRoot, leftOld, leftNamed, leftPresent, leftNext⟩ := leftStored.replace same.leftValid.distinct changed
  obtain ⟨rightRoot, rightOld, rightNamed, rightPresent, rightNext⟩ := rightStored.replace same.rightValid.distinct changed
  cases Option.some.inj (leftNamed.symm.trans leftName)
  cases Option.some.inj (rightNamed.symm.trans rightName)
  exact ⟨same.leftValid.put (same.leftValid.bounded _ _ leftPresent) value,
    same.rightValid.put (same.rightValid.bounded _ _ rightPresent) value, next, leftNext, rightNext⟩
end Environment.Agrees

theorem Environment.Agrees.resolvePlace {left right : Environment} (same : left.Agrees right)
    {place : Place} {address : Address} (resolved : left.resolvePlace program place = some address) :
    ∃ otherAddress, right.resolvePlace program place = some otherAddress ∧ otherAddress.fields = address.fields ∧
      right.at otherAddress = left.at address ∧
      ∀ replacement after, left.writeAddress address replacement = some after →
        ∃ other, right.writeAddress otherAddress replacement = some other ∧ after.Agrees other := by
  simp only [Environment.resolvePlace, Bind.bind, Option.bind_eq_some_iff] at resolved
  obtain ⟨root, named, parent, stored, indices, path, equal⟩ := resolved
  cases equal
  have otherGet : right.get place.root = some parent := by
    rw [← same.get]
    simp [Environment.get, named, stored]
  simp only [Environment.get, Bind.bind, Option.bind_eq_some_iff] at otherGet
  obtain ⟨otherRoot, otherName, otherStored⟩ := otherGet
  refine ⟨⟨otherRoot, indices⟩, by simp [Environment.resolvePlace, otherName, otherStored, path], rfl,
    by simp [Environment.at, stored, otherStored], ?_⟩
  intro replacement after written
  simp only [Environment.writeAddress, Bind.bind, stored, Option.bind_some, Option.bind_eq_some_iff] at written
  obtain ⟨updated, changed, equal⟩ := written
  cases equal
  exact ⟨right.put otherRoot updated, by simp [Environment.writeAddress, otherStored, changed],
    same.put named otherName⟩

theorem DestroysRoots.allowed {store : Store} {bindings : List (String × Root)} {values : BindingValues}
    (stored : StoredBindings store bindings values) {trace : List (Root × List Nat)}
    (destroyed : DestroysRoots program store (bindings.map Prod.snd) trace) :
    ∀ entry ∈ values, entry.2.Disposable program := by
  induction stored generalizing trace with
  | nil => simp
  | cons found rest ih =>
    cases destroyed with
    | cons otherFound head tail =>
      cases Option.some.inj (found.symm.trans otherFound)
      intro entry member
      rcases List.mem_cons.mp member with rfl | member
      · cases head with
        | vacant => exact .vacant
        | resident _ permission _ => exact permission
      · exact ih tail entry member

theorem Cleans.agrees {left right after : Environment} {count : Nat} {trace : List (Root × List Nat)}
    (cleaned : Cleans program count left trace after) (same : left.Agrees right)
    (plain : ∀ root ∈ (right.bindings.take count).map Prod.snd, ∀ value, right.store root = some value → value.ReferenceFree)
    (free : ∀ root ∈ (right.bindings.take count).map Prod.snd, right.OwnerFree ⟨root, []⟩) :
    ∃ otherTrace, Cleans program count right otherTrace (right.retire count) := by
  obtain ⟨values, first, second⟩ := same.values
  cases cleaned with
  | retire destroyed =>
    obtain ⟨otherTrace, otherDestroyed⟩ := DestroysRoots.exists (second.take count) (destroyed.logical.allowed (first.take count))
    exact ⟨otherTrace, .retire (DisposesRoots.of_data otherDestroyed plain free)⟩

theorem Environment.writeAddress_storage {place : Place} {address : Address} {value : Value} {before after : Environment}
    (resolved : before.resolvePlace program place = some address)
    (written : before.writeAddress address value = some after) (valid : before.Valid) :
    after.Valid ∧ before.Evolution after := by
  have named : Grounded.lookup place.root before.bindings = some address.root := by
    simp only [Environment.resolvePlace, Bind.bind, Option.bind_eq_some_iff] at resolved
    obtain ⟨root, named, parent, _, indices, _, equal⟩ := resolved
    cases equal
    exact named
  exact Environment.writeAddress_evolution (.inl (Environment.lookup_mem named)) written valid

theorem Environment.SameStorage.valid {before after : Environment} (same : before.SameStorage after)
    (valid : before.Valid) : after.Valid := by
  refine ⟨?_, ?_, ?_⟩
  · intro root value found
    rw [same.store] at found
    rw [same.supply]
    exact valid.bounded root value found
  · simpa [Environment.roots, same.bindings, same.supply] using valid.named
  · simpa [Environment.roots, same.bindings] using valid.distinct

theorem Environment.SameStorage.evolution {before after : Environment} (same : before.SameStorage after)
    (valid : before.Valid)
    (authority : ∀ root, after.UniqueRoot root → before.MutationRoot root ∨ before.nextRoot ≤ root) :
    before.Evolution after := by
  refine ⟨same.bindings, Nat.le_of_eq same.supply.symm, fun root _ => congrFun same.store root, authority, ?_, ?_⟩
  · intro root _ missing; simpa only [same.store] using missing
  · intro root fresh; simpa only [same.store] using (Environment.Evolution.refl before valid).fresh root fresh

theorem Environment.SameStorage.resolvePlace {before after : Environment} (same : before.SameStorage after) (place : Place) :
    after.resolvePlace program place = before.resolvePlace program place := by
  simp only [Environment.resolvePlace, same.bindings, same.store]

theorem Environment.endSlot_storage {before after : Environment} {slot : Nat} {fields : List Nat}
    (ended : before.endSlot slot fields = some after) : before.SameStorage after := by
  obtain ⟨_, _, _, _, _, transition⟩ := endSlot_checked ended
  cases Environment.endOwn_state transition
  exact ⟨rfl, rfl, rfl⟩

/-- New unique authority must come from the actual canonical access. -/

theorem Environment.Authorizes.mutationRoot {environment : Environment} {access : Environment.ResolvedAccess}
    (allowed : environment.Authorizes .unique access) : environment.MutationRoot access.address.root := by
  cases parent : access.parent with
  | none => exact .inl (by simpa [Environment.Authorizes, parent] using allowed)
  | some node =>
    obtain ⟨loan, found, own, _, root, _, mode⟩ := (by simpa [Environment.Authorizes, parent] using allowed)
    exact .inr ⟨node, loan, found, own, mode, root.symm⟩

theorem Environment.addLoan_unique {environment : Environment} {access : Environment.ResolvedAccess}
    {root : Root} {mode : BorrowMode} (live : (environment.addLoan access mode).UniqueRoot root) :
    environment.UniqueRoot root ∨ (mode = .unique ∧ access.address.root = root) := by
  obtain ⟨node, loan, found, own, unique, target⟩ := live
  by_cases old : node < environment.loans.length
  · exact .inl ⟨node, loan, by simpa only [Environment.addLoan, List.getElem?_append_left old] using found, own, unique, target⟩
  · simp only [Environment.addLoan, List.getElem?_append_right (Nat.le_of_not_lt old)] at found
    cases offset : node - environment.loans.length with
    | zero =>
      simp only [offset, List.getElem?_cons_zero, Option.some.injEq] at found
      cases found
      exact .inr ⟨unique, target⟩
    | succ index => simp [offset] at found

theorem Environment.endOwn_unique {before after : Environment} {node root : Nat}
    (ended : before.endOwn node = some after) (live : after.UniqueRoot root) : before.UniqueRoot root := by
  obtain ⟨other, loan, found, own, mode, target⟩ := live
  exact ⟨other, loan, (Environment.endOwn_active ended found own).1, own, mode, target⟩

theorem Environment.endSlot_unique {before after : Environment} {slot root : Nat} {fields : List Nat}
    (ended : before.endSlot slot fields = some after) (live : after.UniqueRoot root) : before.UniqueRoot root := by
  obtain ⟨_, _, _, _, _, transition⟩ := endSlot_checked ended
  exact Environment.endOwn_unique transition live

theorem Environment.endSlot_evolution {before after : Environment} {slot : Nat} {fields : List Nat}
    (ended : before.endSlot slot fields = some after) (valid : before.Valid) : before.Evolution after :=
  (Environment.endSlot_storage ended).evolution valid
    (fun _ live => .inl (.inr (Environment.endSlot_unique ended live)))

theorem Environment.Copies.uniqueRoots {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) {root : Root} (live : after.UniqueRoot root) : before.UniqueRoot root := by
  induction copied using Copies.rec
    (motive_2 := fun before _ _ after _ => after.UniqueRoot root → before.UniqueRoot root) with
  | data | nil => assumption
  | reference found shared allowed =>
    rcases Environment.addLoan_unique live with old | ⟨impossible, _⟩
    · exact old
    · cases impossible
  | tuple _ _ first rest => exact first (rest live)
  | cons _ _ first rest => rename_i live; exact first (rest live)
  | array _ ih | nominal _ ih => exact ih live

theorem Environment.Copies.evolution {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) (valid : before.Valid) : before.Evolution after :=
  copied.storage.evolution valid (fun _ live => .inl (.inr (copied.uniqueRoots live)))

theorem Environment.Disposes.uniqueRoots {before after : Environment} {value : Value}
    (disposed : Disposes program before value after) {root : Root} (live : after.UniqueRoot root) : before.UniqueRoot root := by
  induction disposed using Disposes.rec
    (motive_2 := fun before _ after _ => after.UniqueRoot root → before.UniqueRoot root) with
  | data => exact live
  | reference _ ended => exact Environment.endOwn_unique ended live
  | tuple _ _ ih | array _ _ ih | nominal _ _ ih => exact ih live
  | nil => assumption
  | cons _ _ tailIH headIH => rename_i live; exact tailIH (headIH live)

theorem Environment.Disposes.evolution {before after : Environment} {value : Value}
    (disposed : Disposes program before value after) (valid : before.Valid) : before.Evolution after :=
  disposed.storage.evolution valid (fun _ live => .inl (.inr (disposed.uniqueRoots live)))

theorem Environment.Disposes.write_evolution {before disposed after : Environment} {old value : Value} {address : Address}
    (dispose : Disposes program before old disposed) (authority : before.MutationRoot address.root)
    (written : disposed.writeAddress address value = some after) (valid : before.Valid) :
    after.Valid ∧ before.Evolution after := by
  have same := dispose.storage
  have disposedValid := same.valid valid
  simp only [Environment.writeAddress, Bind.bind, Option.bind_eq_some_iff] at written
  obtain ⟨parent, found, updated, _, equal⟩ := written
  cases equal
  have bound := disposedValid.bounded address.root parent found
  have originalFound : before.store address.root = some parent := by rw [← same.store]; exact found
  have originalBound := valid.bounded address.root parent originalFound
  refine ⟨disposedValid.put bound updated, same.bindings, Nat.le_of_eq same.supply.symm, ?_,
    fun _ live => .inl (.inr (dispose.uniqueRoots live)), ?_, ?_⟩
  · intro root outside
    have different : root ≠ address.root := fun equal => outside (equal ▸ authority)
    simpa only [Environment.put, if_neg different] using congrFun same.store root
  · intro root _ missing
    have different : root ≠ address.root := by
      intro equal; subst root; rw [originalFound] at missing; cases missing
    simpa only [Environment.put, if_neg different, same.store] using missing
  · intro root fresh
    have different : root ≠ address.root := fun equal => Nat.not_lt_of_ge fresh (equal ▸ originalBound)
    simpa only [Environment.put, if_neg different, same.store] using (Environment.Evolution.refl before valid).fresh root fresh

theorem DisposesRoots.uniqueRoots {before after : Environment} {roots : List Root} {trace : List (Root × List Nat)}
    (disposed : DisposesRoots program before roots trace after) {root : Root} (live : after.UniqueRoot root) : before.UniqueRoot root := by
  induction disposed with
  | nil => exact live
  | cons found free head tail ih => exact head.uniqueRoots (ih live)

theorem Cleans.uniqueRoots {before after : Environment} {count : Nat} {trace : List (Root × List Nat)}
    (cleaned : Cleans program count before trace after) {root : Root} (live : after.UniqueRoot root) : before.UniqueRoot root := by
  cases cleaned with
  | retire disposed => exact disposed.uniqueRoots live

theorem Cleans.suffix_evolution {before after : Environment} {count : Nat} {trace : List (Root × List Nat)}
    (cleaned : Cleans program count before trace after) (valid : before.Valid) :
    (before.retire count).Evolution after :=
  cleaned.suffix.evolution (valid.retire count) (fun _ live => .inl (.inr (cleaned.uniqueRoots live)))

theorem Cleans.valid {before after : Environment} {count : Nat} {trace : List (Root × List Nat)}
    (cleaned : Cleans program count before trace after) (valid : before.Valid) : after.Valid :=
  cleaned.suffix.valid (valid.retire count)

theorem Pattern.Consumes.activeOwn {before after : Environment} {pattern : Pattern} {value : Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : Pattern.Consumes program before pattern value bindings after trace) {node : Nat} {loan : Loan}
    (found : after.loans[node]? = some loan) (own : loan.own = true) : before.loans[node]? = some loan := by
  induction consumed using Pattern.Consumes.rec
    (motive_2 := fun before _ _ _ _ after _ _ => after.loans[node]? = some loan → before.loans[node]? = some loan) with
  | wildcard disposed | literal disposed => exact (disposed.active found own).1
  | binder => exact found
  | node _ _ _ ih => exact ih found
  | nil => assumption
  | cons _ _ tail head => rename_i found; exact tail (head found)

theorem Pattern.Consumes.uniqueRoots {before after : Environment} {pattern : Pattern} {value : Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : Pattern.Consumes program before pattern value bindings after trace) {root : Root}
    (live : after.UniqueRoot root) : before.UniqueRoot root := by
  obtain ⟨node, loan, found, own, mode, target⟩ := live
  exact ⟨node, loan, consumed.activeOwn found own, own, mode, target⟩

theorem ConsumesFields.matches {before after : Environment} {index : Nat} {patterns : List Pattern} {values : List Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : ConsumesFields program before index patterns values bindings after trace) :
    matchPatterns patterns values = some bindings := by
  induction patterns generalizing before after index values bindings trace with
  | nil => cases consumed; simp [matchPatterns]
  | cons pattern patterns ih => cases consumed with | cons tail head => simp [matchPatterns, head.matches, ih tail]

theorem ConsumesFields.storage {before after : Environment} {index : Nat} {patterns : List Pattern} {values : List Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : ConsumesFields program before index patterns values bindings after trace) : before.SameStorage after := by
  induction patterns generalizing before after index values bindings trace with
  | nil => cases consumed; exact ⟨rfl, rfl, rfl⟩
  | cons pattern patterns ih =>
    cases consumed with | cons tail head =>
      have first := ih tail
      exact ⟨head.storage.bindings.trans first.bindings, head.storage.store.trans first.store, head.storage.supply.trans first.supply⟩

theorem ConsumesFields.activeOwn {before after : Environment} {index : Nat} {patterns : List Pattern} {values : List Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : ConsumesFields program before index patterns values bindings after trace) {node : Nat} {loan : Loan}
    (found : after.loans[node]? = some loan) (own : loan.own = true) : before.loans[node]? = some loan := by
  induction patterns generalizing before after index values bindings trace with
  | nil => cases consumed; exact found
  | cons pattern patterns ih => cases consumed with | cons tail head => exact ih tail (head.activeOwn found own)

theorem ConsumesFields.uniqueRoots {before after : Environment} {index : Nat} {patterns : List Pattern} {values : List Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : ConsumesFields program before index patterns values bindings after trace) {root : Root}
    (live : after.UniqueRoot root) : before.UniqueRoot root := by
  obtain ⟨node, loan, found, own, mode, target⟩ := live
  exact ⟨node, loan, consumed.activeOwn found own, own, mode, target⟩

theorem ConsumesArm.storage {α : Type} {before after : Environment} {value : Value}
    {arms : List (Pattern × α)} {bindings : BindingValues} {body : α}
    (consumed : ConsumesArm program before value arms bindings body after) : before.SameStorage after := by
  induction consumed with
  | hit _ consumed => exact consumed.storage
  | miss _ _ ih => exact ih

theorem ConsumesArm.activeOwn {α : Type} {before after : Environment} {value : Value}
    {arms : List (Pattern × α)} {bindings : BindingValues} {body : α}
    (consumed : ConsumesArm program before value arms bindings body after) {node : Nat} {loan : Loan}
    (found : after.loans[node]? = some loan) (own : loan.own = true) : before.loans[node]? = some loan := by
  induction consumed with
  | hit _ consumed => exact consumed.activeOwn found own
  | miss _ _ ih => exact ih found

theorem ConsumesArm.uniqueRoots {α : Type} {before after : Environment} {value : Value}
    {arms : List (Pattern × α)} {bindings : BindingValues} {body : α}
    (consumed : ConsumesArm program before value arms bindings body after) {root : Root}
    (live : after.UniqueRoot root) : before.UniqueRoot root := by
  obtain ⟨node, loan, found, own, mode, target⟩ := live
  exact ⟨node, loan, consumed.activeOwn found own, own, mode, target⟩

theorem Pattern.Consumes.evolution {before after : Environment} {pattern : Pattern} {value : Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : Pattern.Consumes program before pattern value bindings after trace) (valid : before.Valid) : before.Evolution after :=
  consumed.storage.evolution valid (fun _ live => .inl (.inr (consumed.uniqueRoots live)))

theorem ConsumesFields.evolution {before after : Environment} {index : Nat} {patterns : List Pattern} {values : List Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : ConsumesFields program before index patterns values bindings after trace) (valid : before.Valid) : before.Evolution after :=
  consumed.storage.evolution valid (fun _ live => .inl (.inr (consumed.uniqueRoots live)))

theorem ConsumesArm.evolution {α : Type} {before after : Environment} {value : Value}
    {arms : List (Pattern × α)} {bindings : BindingValues} {body : α}
    (consumed : ConsumesArm program before value arms bindings body after) (valid : before.Valid) : before.Evolution after :=
  consumed.storage.evolution valid (fun _ live => .inl (.inr (consumed.uniqueRoots live)))



/-- Every real operation preserves stable lexical roots, the monotone supply,
and all storage outside its incoming owners. Fresh-root availability is derived
inside the bind/parameter preparation steps from Valid, not admission. -/

theorem Evaluates.storage {before after : Environment} {core : Core} {value : Value}
    (evaluated : Evaluates program before core value after) :
    before.Valid → after.Valid ∧ before.Evolution after := by
  induction evaluated using Evaluates.rec
    (motive_2 := fun before _ _ _ after _ => before.Valid → after.Valid ∧ before.Evolution after)
    (motive_3 := fun _ _ _ _ => True) (motive_4 := fun _ _ _ _ => True) (motive_5 := fun _ _ _ _ => True) with
  | unit | integer | character => exact fun valid => ⟨valid, .refl _ valid⟩
  | dereference _ _ _ _ _ _ _ copied => exact fun valid => ⟨copied.storage.valid valid, copied.evolution valid⟩
  | read _ _ _ copied => exact fun valid => ⟨copied.storage.valid valid, copied.evolution valid⟩
  | @borrow environment place access resident mode resolved _ allowed permitted ready selected plain
  | @reborrow environment place access resident mode resolved _ allowed permitted ready selected plain =>
    intro valid
    have same : environment.SameStorage (environment.addLoan access mode) := ⟨rfl, rfl, rfl⟩
    refine ⟨same.valid valid, same.evolution valid ?_⟩
    intro root live
    rcases Environment.addLoan_unique live with old | ⟨unique, target⟩
    · exact .inl (.inr old)
    · subst mode
      rw [← target]
      exact .inl allowed.mutationRoot
  | group _ ih | implicitMove _ ih => exact ih
  | move resolved free allowed taken =>
    exact Environment.writeAddress_storage resolved (Environment.takeAddress_eq_some.mp taken).2
  | moveIndirect _ _ allowed _ _ _ taken =>
    exact Environment.writeAddress_evolution allowed.mutationRoot (Environment.takeAddress_eq_some.mp taken).2
  | assignIndirect _ _ _ allowed _ _ dispose _ written _ initialIH bodyIH =>
    intro valid
    obtain ⟨middleValid, initial⟩ := initialIH valid
    obtain ⟨updatedValid, update⟩ := dispose.write_evolution allowed.mutationRoot written middleValid
    obtain ⟨afterValid, body⟩ := bodyIH updatedValid
    exact ⟨afterValid, initial.trans (update.trans body)⟩
  | endOwn ended _ ih =>
    intro valid
    have same := Environment.endSlot_storage ended
    obtain ⟨afterValid, evolved⟩ := ih (same.valid valid)
    exact ⟨afterValid, (Environment.endSlot_evolution ended valid).trans evolved⟩
  | endAfter _ ended _ ih =>
    intro valid
    obtain ⟨middleValid, evolved⟩ := ih valid
    have same := Environment.endSlot_storage ended
    exact ⟨same.valid middleValid, evolved.trans (Environment.endSlot_evolution ended middleValid)⟩
  | sequence _ dispose _ headIH tailIH =>
    intro valid
    obtain ⟨middleValid, first⟩ := headIH valid
    obtain ⟨afterValid, rest⟩ := tailIH (dispose.storage.valid middleValid)
    exact ⟨afterValid, first.trans ((dispose.evolution middleValid).trans rest)⟩
  | bind _ _ _ cleanup _ initialIH bodyIH =>
    intro valid
    obtain ⟨middleValid, initial⟩ := initialIH valid
    obtain ⟨afterValid, body⟩ := bodyIH (middleValid.bind _ _)
    obtain ⟨_, cleaned⟩ := cleanup
    exact ⟨cleaned.valid afterValid, initial.trans ((body.unbind middleValid).trans (cleaned.suffix_evolution afterValid))⟩
  | assign _ resolved _ _ dispose _ written _ initialIH bodyIH =>
    intro valid
    obtain ⟨middleValid, initial⟩ := initialIH valid
    have resolvedAfter := (dispose.storage.resolvePlace _).trans resolved
    obtain ⟨updatedValid, update⟩ := Environment.writeAddress_storage resolvedAfter written (dispose.storage.valid middleValid)
    obtain ⟨afterValid, body⟩ := bodyIH updatedValid
    exact ⟨afterValid, initial.trans ((dispose.evolution middleValid).trans (update.trans body))⟩
  | tuple _ _ _ headIH tailIH =>
    intro valid
    obtain ⟨middleValid, first⟩ := headIH valid
    obtain ⟨afterValid, rest⟩ := tailIH middleValid
    exact ⟨afterValid, first.trans rest⟩
  | array _ _ ih | construct _ _ ih => exact ih
  | constant _ _ _ ih =>
    intro valid
    obtain ⟨afterValid, body⟩ := ih valid.hide
    exact ⟨valid.resume afterValid body.supply, body.resume⟩
  | field _ _ _ dispose _ ih =>
    intro valid
    obtain ⟨middleValid, body⟩ := ih valid
    exact ⟨dispose.storage.valid middleValid, body.trans (dispose.evolution middleValid)⟩
  | call _ _ _ cleanup _ inputsIH bodyIH =>
    intro valid
    obtain ⟨middleValid, inputs⟩ := inputsIH valid
    obtain ⟨afterValid, body⟩ := bodyIH (middleValid.hide.prepare _)
    obtain ⟨_, cleaned⟩ := cleanup
    have returned := (body.scope middleValid.hide _).trans (cleaned.suffix_evolution afterValid)
    exact ⟨middleValid.resume (cleaned.valid afterValid) returned.supply, inputs.trans returned.resume⟩
  | applyPatterns _ _ _ selected _ cleanup _ _ argumentsIH bodyIH =>
    intro valid
    obtain ⟨middleValid, arguments⟩ := argumentsIH valid
    have consumedValid := selected.storage.valid middleValid
    have consumedEvolution := selected.evolution middleValid
    obtain ⟨afterValid, body⟩ := bodyIH (consumedValid.prepare _)
    obtain ⟨_, cleaned⟩ := cleanup
    exact ⟨cleaned.valid afterValid, arguments.trans (consumedEvolution.trans
      ((body.scope consumedValid _).trans (cleaned.suffix_evolution afterValid)))⟩
  | nil => exact ⟨by assumption, .refl _ (by assumption)⟩
  | cons _ _ _ headIH tailIH =>
    rename_i valid
    obtain ⟨middleValid, first⟩ := headIH valid
    obtain ⟨afterValid, rest⟩ := tailIH middleValid
    exact ⟨afterValid, first.trans rest⟩
  | wildcard | binder | node | constantValue | patternsNil | patternsCons | armsNil | armsCons => trivial


/-- Once an actual scope cleanup retires a root, no subsequent owned execution
can make that identity resolve again. The proof uses its real continuation and
monotone supply, not an allocation-success or future-state certificate. -/

theorem Cleans.retired_stays_absent {before after final : Environment} {count : Nat}
    {trace : List (Root × List Nat)} {expression : Core} {value : Value}
    (cleaned : Cleans program count before trace after) (valid : before.Valid)
    (continued : Evaluates program after expression value final) :
    ∀ root ∈ (before.bindings.take count).map Prod.snd, final.store root = none ∧ root < final.nextRoot := by
  have returned := cleaned.suffix
  have evolved := (continued.storage (cleaned.valid valid)).2
  intro root retired
  have inPrefix : root ∈ before.roots.take count := by simpa [Environment.roots, List.map_take] using retired
  have bound := valid.named root (List.mem_of_mem_take inPrefix)
  exact ⟨evolved.absent root (cleaned.retired root retired),
    Nat.lt_of_lt_of_le (by simpa only [returned.supply, Environment.retire] using bound) evolved.supply⟩

theorem Environment.prepare_old (environment : Environment) (inputs : BindingValues) {root : Root}
    (older : root < environment.nextRoot) :
    (environment.prepare inputs).store root = environment.store root ∧
      (root ∈ (environment.prepare inputs).roots ↔ root ∈ environment.roots) := by
  induction inputs generalizing environment with
  | nil => exact ⟨rfl, Iff.rfl⟩
  | cons entry rest ih =>
    have tail := ih (environment.bind entry.1 entry.2) (Nat.lt_succ_of_lt older)
    have different := Nat.ne_of_lt older
    simpa [Environment.prepare, Environment.bind, Environment.roots, different] using tail

theorem EvaluatesList.storage {before after : Environment} {expressions : List Expr} {plans : List CorePlan} {values : List Value}
    (evaluated : EvaluatesList program before expressions plans values after) :
    before.Valid → after.Valid ∧ before.Evolution after := by
  induction evaluated using EvaluatesList.rec
    (motive_1 := fun _ _ _ _ _ => True)
    (motive_3 := fun _ _ _ _ => True) (motive_4 := fun _ _ _ _ => True) (motive_5 := fun _ _ _ _ => True) with
  | nil => exact fun valid => ⟨valid, .refl _ valid⟩
  | cons head tail usable _ ih =>
    intro valid
    obtain ⟨middleValid, first⟩ := head.storage valid
    obtain ⟨afterValid, rest⟩ := ih middleValid
    exact ⟨afterValid, first.trans rest⟩
  | unit | integer | character | group | implicitMove | read | move | borrow | reborrow | dereference | moveIndirect | assignIndirect | endOwn | endAfter
  | sequence | bind | assign | tuple | array | constant | construct | field | call | applyPatterns
  | wildcard | binder | node | constantValue | patternsNil | patternsCons | armsNil | armsCons => trivial

/-- Implicit reborrowing allocates a fresh child without changing any existing
handle cell, binding, or owner storage. Loan readiness and authority are supplied
by the same runtime access contract as explicit borrowing. -/

theorem Evaluates.reborrow_preserves_storage {before after : Environment} {place : Place}
    {mode : BorrowMode} {value : Value}
    (evaluated : Evaluates program before ⟨.read place, .reborrow mode⟩ value after) :
    before.SameStorage after ∧ value = .reference before.loans.length ∧
      after.loans.length = before.loans.length + 1 := by
  cases evaluated with
  | reborrow => exact ⟨⟨rfl, rfl, rfl⟩, rfl, by simp [Environment.addLoan]⟩

/-- A call preserves post-argument caller cells outside incoming unique-target
roots. Shared-only calls retain the entire store. Actual callee writes remain
in the authoritative store when caller names are restored. -/

theorem Evaluates.call_frame {before after : Environment} {identity : Nat} {arguments : List Expr} {value : Value}
    {argumentPlans : List CorePlan} {bodyPlan : CorePlan}
    (evaluated : Evaluates program before ⟨.call identity arguments, .call argumentPlans bodyPlan⟩ value after) (valid : before.Valid) :
    ∃ middle values declaration localAfter,
      program.functions identity = some declaration ∧ EvaluatesList program before arguments argumentPlans values middle ∧
      Evaluates program (middle.hide.prepare (List.zip (declaration.parameters.map Prod.fst) values)) ⟨declaration.body, bodyPlan⟩ value localAfter ∧
      (∀ root, root < middle.nextRoot →
        (middle.hide.prepare (List.zip (declaration.parameters.map Prod.fst) values)).store root = middle.store root ∧
        root ∉ (middle.hide.prepare (List.zip (declaration.parameters.map Prod.fst) values)).roots) ∧
      after.bindings = middle.bindings ∧
      (∀ root, ¬ middle.UniqueRoot root → after.store root = middle.store root) ∧ middle.nextRoot ≤ after.nextRoot := by
  cases evaluated with
  | call declared inputs body cleanup usable =>
    have middleValid := (inputs.storage valid).1
    obtain ⟨_, cleaned⟩ := cleanup
    have returned := ((body.storage (middleValid.hide.prepare _)).2.scope middleValid.hide _).trans
      (cleaned.suffix_evolution (body.storage (middleValid.hide.prepare _)).1)
    refine ⟨_, _, _, _, declared, inputs, body, ?_, rfl, ?_, returned.supply⟩
    · intro root older
      constructor
      · exact (Environment.prepare_old (Environment.hide _) _ older).1
      · intro retained
        have membership := (Environment.prepare_old (Environment.hide _) _ older).2.mp retained
        simp [Environment.roots, Environment.hide] at membership
    · intro root shared
      exact returned.frame root (by simpa [Environment.MutationRoot, Environment.UniqueRoot, Environment.roots, Environment.hide] using shared)


/-- A result has either reference-free data shape or exactly one direct source
handle. Usability is supplied by the actual protected-resource state. -/

theorem StoredBindings.present {store : Store} {bindings : List (String × Root)} {values : BindingValues}
    (stored : StoredBindings store bindings values) {root : Root} (member : root ∈ bindings.map Prod.snd) :
    ∃ value, store root = some value := by
  induction stored with
  | nil => simp at member
  | cons found rest ih =>
    simp only [List.map_cons, List.mem_cons] at member
    rcases member with rfl | member
    · exact ⟨_, found⟩
    · exact ih member

theorem Environment.Copies.plain_identity {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) : resident.ReferenceFree → value = resident ∧ after = before := by
  induction copied using Copies.rec
    (motive_2 := fun before residents values after _ =>
      valuesReferenceFree residents → values = residents ∧ after = before) with
  | data => intro _; exact ⟨rfl, rfl⟩
  | reference => intro plain; exact False.elim plain
  | tuple _ _ first rest =>
    intro plain
    obtain ⟨rfl, rfl⟩ := first plain.1
    obtain ⟨rfl, rfl⟩ := rest plain.2
    exact ⟨rfl, rfl⟩
  | cons _ _ first rest =>
    rename_i plain
    obtain ⟨rfl, rfl⟩ := first plain.1
    obtain ⟨rfl, rfl⟩ := rest plain.2
    exact ⟨rfl, rfl⟩
  | array _ ih | nominal _ ih =>
    intro plain
    obtain ⟨rfl, rfl⟩ := ih plain
    exact ⟨rfl, rfl⟩
  | nil => exact ⟨rfl, rfl⟩

/-- Copies only append loans; existing ownership/support entries are untouched. -/

theorem Environment.Copies.loans_append {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) : ∃ children, after.loans = before.loans ++ children := by
  induction copied using Copies.rec
    (motive_2 := fun before _ _ after _ => ∃ children, after.loans = before.loans ++ children) with
  | data | nil => exact ⟨[], by simp⟩
  | reference => exact ⟨_, rfl⟩
  | tuple _ _ first rest | cons _ _ first rest =>
    obtain ⟨firstChildren, first⟩ := first
    obtain ⟨restChildren, rest⟩ := rest
    exact ⟨firstChildren ++ restChildren, by rw [rest, first, List.append_assoc]⟩
  | array _ ih | nominal _ ih => exact ih

theorem Environment.Supported.append {loans : List Loan} {node : Nat}
    (supported : Supported loans node) (tail : List Loan) : Supported (loans ++ tail) node := by
  induction supported with
  | root found original => exact .root (by simpa only [List.getElem?_append_left (List.getElem?_eq_some_iff.mp found).1] using found) original
  | child found derived older parentFound sameRoot subaddress support ih =>
    exact .child (by simpa only [List.getElem?_append_left (List.getElem?_eq_some_iff.mp found).1] using found)
      derived older (by simpa only [List.getElem?_append_left (List.getElem?_eq_some_iff.mp parentFound).1] using parentFound)
      sameRoot subaddress ih

theorem Environment.Copies.own {before after : Environment} {resident value : Value} {node : Nat} {loan : Loan}
    (copied : Copies before resident value after) (found : before.loans[node]? = some loan) :
    after.loans[node]? = some loan := by
  obtain ⟨children, appended⟩ := copied.loans_append
  simpa only [appended, List.getElem?_append_left (List.getElem?_eq_some_iff.mp found).1] using found

theorem Environment.Copies.usable {before after : Environment} {resident value : Value} {node : Nat}
    (copied : Copies before resident value after) (usable : before.Usable node) : after.Usable node := by
  obtain ⟨loan, found, own, supported⟩ := usable
  refine ⟨loan, copied.own found, own, ?_⟩
  obtain ⟨children, appended⟩ := copied.loans_append
  rw [appended]
  exact supported.append children

theorem Environment.Copies.restored {before after : Environment} {resident value : Value} {node : Nat}
    (copied : Copies before resident value after) (usable : before.Usable node) (ready : before.Restored node) :
    after.Restored node := by
  obtain ⟨loan, found, own, _⟩ := usable
  intro actual selected active
  cases Option.some.inj ((copied.own found).symm.trans selected)
  obtain ⟨resident, read⟩ := ready loan found own
  exact ⟨resident, by simpa only [Environment.readAddress, Environment.at, copied.storage.store] using read⟩

mutual
theorem Environment.ResultUsable.mono {before after : Environment} {value : Value}
    (usable : before.ResultUsable value)
    (leaves : ∀ node, before.Usable node → before.Restored node → after.Usable node ∧ after.Restored node) :
    after.ResultUsable value := by
  cases value with
  | reference node => exact leaves node usable.1 usable.2
  | tuple head tail => exact ⟨usable.1.mono leaves, Environment.ResultsUsable.mono usable.2 leaves⟩
  | array values | nominal _ _ values => exact Environment.ResultsUsable.mono usable leaves
  | vacant | unit | integer | character => trivial

theorem Environment.ResultsUsable.mono {before after : Environment} {values : List Value}
    (usable : ResultsUsable values before)
    (leaves : ∀ node, before.Usable node → before.Restored node → after.Usable node ∧ after.Restored node) :
    ResultsUsable values after := by
  cases values with
  | nil => trivial
  | cons head tail => exact ⟨usable.1.mono leaves, Environment.ResultsUsable.mono usable.2 leaves⟩
end

theorem Environment.Copies.preserves_result {before after : Environment} {resident value kept : Value}
    (copied : Copies before resident value after) (usable : before.ResultUsable kept) : after.ResultUsable kept :=
  usable.mono (fun _ own ready => ⟨copied.usable own, copied.restored own ready⟩)

theorem Environment.Copies.result_usable {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) : before.ResultUsable resident → after.ResultUsable value := by
  induction copied using Copies.rec
    (motive_2 := fun before residents values after _ => ResultsUsable residents before → ResultsUsable values after) with
  | data plain => intro _; exact .of_plain plain
  | @reference before node loan found shared allowed =>
    intro usable
    have bound := (List.getElem?_eq_some_iff.mp found).1
    have selected : (before.addLoan ⟨loan.target, some node⟩ .shared).loans[before.loans.length]? =
        some ⟨loan.target, some node, true, .shared⟩ := by simp [Environment.addLoan]
    have parentFound : (before.addLoan ⟨loan.target, some node⟩ .shared).loans[node]? = some loan := by
      simpa only [Environment.addLoan, List.getElem?_append_left bound] using found
    refine ⟨⟨_, selected, rfl, .child selected rfl bound parentFound rfl ⟨[], by simp⟩ ?_⟩, ?_⟩
    · obtain ⟨actual, actualFound, _, support⟩ := allowed
      cases Option.some.inj (found.symm.trans actualFound)
      exact support.append _
    · intro actual actualFound own
      cases Option.some.inj (selected.symm.trans actualFound)
      obtain ⟨resident, read⟩ := usable.2 loan found (by obtain ⟨actual, actualFound, own, _⟩ := allowed; cases Option.some.inj (found.symm.trans actualFound); exact own)
      exact ⟨resident, read⟩
  | tuple first rest firstIH restIH =>
    intro usable
    have tailUsable : ResultsUsable _ _ := first.preserves_result (kept := .array _) usable.2
    exact ⟨(Copies.array rest).preserves_result (firstIH usable.1), restIH tailUsable⟩
  | array fields ih | nominal fields ih => exact ih
  | nil => trivial
  | cons first rest firstIH restIH =>
    rename_i usable
    have tailUsable : ResultsUsable _ _ := first.preserves_result (kept := .array _) usable.2
    exact ⟨(Copies.array rest).preserves_result (firstIH usable.1), restIH tailUsable⟩

theorem Environment.Copies.loans_mono {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) : before.loans.length ≤ after.loans.length := by
  obtain ⟨children, appended⟩ := copied.loans_append
  simp [appended]

theorem Environment.Copies.empty_before {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) (empty : after.loans = []) : before.loans = [] := by
  have bound := copied.loans_mono
  rw [empty] at bound
  simpa using (Nat.eq_zero_of_le_zero bound)

theorem Environment.Copies.empty_after {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) : before.loans = [] → after.loans = [] := by
  induction copied using Copies.rec
    (motive_2 := fun before _ _ after _ => before.loans = [] → after.loans = []) with
  | data => exact id
  | nil => assumption
  | reference found => intro empty; simp [empty] at found
  | tuple _ _ first rest => exact fun empty => rest (first empty)
  | cons _ _ first rest => rename_i empty; exact rest (first empty)
  | array _ ih | nominal _ ih => exact ih

theorem Environment.Copies.referenceFree_of_empty {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) : after.loans = [] → value.ReferenceFree := by
  induction copied using Copies.rec
    (motive_2 := fun _ _ values after _ => after.loans = [] → valuesReferenceFree values) with
  | data plain => exact fun _ => plain
  | reference => intro empty; simp [Environment.addLoan] at empty
  | tuple first rest firstIH restIH =>
    intro empty
    have tailCopy : Copies _ (.array _) (.array _) _ := .array rest
    exact ⟨firstIH (tailCopy.empty_before empty), restIH empty⟩
  | cons first rest firstIH restIH =>
    rename_i empty
    have tailCopy : Copies _ (.array _) (.array _) _ := .array rest
    exact ⟨firstIH (tailCopy.empty_before empty), restIH empty⟩
  | array _ ih | nominal _ ih => exact ih
  | nil => trivial

theorem Environment.Copies.empty_identity {before after : Environment} {resident value : Value}
    (copied : Copies before resident value after) (empty : after.loans = []) :
    resident.ReferenceFree ∧ value = resident ∧ after = before := by
  have plain : resident.ReferenceFree := by
    induction copied using Copies.rec
      (motive_2 := fun _ residents _ after _ => after.loans = [] → valuesReferenceFree residents) with
    | data plain => exact plain
    | reference => simp [Environment.addLoan] at empty
    | tuple first rest firstIH restIH =>
      have tailCopy : Copies _ (.array _) (.array _) _ := .array rest
      exact ⟨firstIH (tailCopy.empty_before empty), restIH empty⟩
    | cons first rest firstIH restIH =>
      rename_i empty
      have tailCopy : Copies _ (.array _) (.array _) _ := .array rest
      exact ⟨firstIH (tailCopy.empty_before empty), restIH empty⟩
    | array _ ih | nominal _ ih => exact ih empty
    | nil => trivial
  exact ⟨plain, copied.plain_identity plain⟩

theorem Environment.Copies.deterministic {before firstAfter secondAfter : Environment} {value first second : Value}
    (left : Copies before value first firstAfter) (right : Copies before value second secondAfter) :
    first = second ∧ firstAfter = secondAfter := by
  induction left using Copies.rec
    (motive_2 := fun before residents first firstAfter _ =>
      ∀ second secondAfter, CopiesFields before residents second secondAfter →
        first = second ∧ firstAfter = secondAfter) generalizing second secondAfter with
  | data plain =>
    obtain ⟨values, states⟩ := right.plain_identity plain
    exact ⟨values.symm, states.symm⟩
  | reference found shared allowed =>
    cases right with
    | data plain => exact False.elim plain
    | reference otherFound => cases Option.some.inj (found.symm.trans otherFound); exact ⟨rfl, rfl⟩
  | tuple first rest firstIH restIH =>
    cases right with
    | data plain => exact (Copies.tuple first rest).plain_identity plain
    | tuple otherFirst otherRest =>
      obtain ⟨rfl, rfl⟩ := firstIH otherFirst
      obtain ⟨rfl, rfl⟩ := restIH _ _ otherRest
      exact ⟨rfl, rfl⟩
  | array fields ih =>
    cases right with
    | data plain => exact (Copies.array fields).plain_identity plain
    | array other => obtain ⟨rfl, rfl⟩ := ih _ _ other; exact ⟨rfl, rfl⟩
  | nominal fields ih =>
    cases right with
    | data plain => exact (Copies.nominal fields).plain_identity plain
    | nominal other => obtain ⟨rfl, rfl⟩ := ih _ _ other; exact ⟨rfl, rfl⟩
  | nil => rename_i second secondAfter other; cases other; exact ⟨rfl, rfl⟩
  | cons first rest firstIH restIH =>
    rename_i second secondAfter other
    cases other with
    | cons otherFirst otherRest =>
      obtain ⟨rfl, rfl⟩ := firstIH otherFirst
      obtain ⟨rfl, rfl⟩ := restIH _ _ otherRest
      exact ⟨rfl, rfl⟩

/-- Recursive disposal of reference-free data is exactly the existing identity
transition, so structural and data derivations cannot disagree. -/

theorem Environment.Disposes.referenceFree {before after : Environment} {value : Value}
    (disposed : Disposes program before value after) (plain : value.ReferenceFree) : after = before := by
  induction disposed using Disposes.rec
    (motive_2 := fun before values after _ => valuesReferenceFree values → after = before) with
  | data => rfl
  | reference => cases plain
  | tuple _ _ ih | array _ _ ih | nominal _ _ ih => exact ih plain
  | nil => rfl
  | cons _ _ tailIH headIH => rename_i plain; exact (headIH plain.1).trans (tailIH plain.2)

theorem Environment.Disposes.deterministic {before firstAfter secondAfter : Environment} {value : Value}
    (left : Disposes program before value firstAfter) (right : Disposes program before value secondAfter) :
    firstAfter = secondAfter := by
  induction left using Disposes.rec
    (motive_2 := fun before values after _ => ∀ secondAfter,
      DisposesFields program before values secondAfter → after = secondAfter)
    generalizing secondAfter with
  | data plain destroyed => exact (right.referenceFree plain).symm
  | reference _ ended => cases right with
    | data plain => cases plain
    | reference _ otherEnded => exact Option.some.inj (ended.symm.trans otherEnded)
  | tuple allowed children ih => cases right with
    | data plain => exact (Disposes.tuple allowed children).referenceFree plain
    | tuple _ otherChildren => exact ih _ otherChildren
  | array allowed children ih => cases right with
    | data plain => exact (Disposes.array allowed children).referenceFree plain
    | array _ otherChildren => exact ih _ otherChildren
  | nominal allowed children ih => cases right with
    | data plain => exact (Disposes.nominal allowed children).referenceFree plain
    | nominal _ otherChildren => exact ih _ otherChildren
  | nil => rename_i right; cases right; rfl
  | cons tail head tailIH headIH =>
    rename_i secondAfter right
    cases right with
    | cons otherTail otherHead =>
      cases tailIH _ otherTail
      exact headIH otherHead

theorem DisposesRoots.deterministic {before firstAfter secondAfter : Environment} {roots : List Root}
    {firstTrace secondTrace : List (Root × List Nat)}
    (left : DisposesRoots program before roots firstTrace firstAfter)
    (right : DisposesRoots program before roots secondTrace secondAfter) :
    firstTrace = secondTrace ∧ firstAfter = secondAfter := by
  induction left generalizing secondTrace secondAfter with
  | nil => cases right; exact ⟨rfl, rfl⟩
  | cons found free head tail ih =>
    cases right with
    | cons otherFound otherFree otherHead otherTail =>
      cases Option.some.inj (found.symm.trans otherFound)
      cases head.deterministic otherHead
      obtain ⟨rfl, rfl⟩ := ih otherTail
      exact ⟨rfl, rfl⟩

theorem Cleans.deterministic {before firstAfter secondAfter : Environment} {count : Nat}
    {firstTrace secondTrace : List (Root × List Nat)}
    (left : Cleans program count before firstTrace firstAfter)
    (right : Cleans program count before secondTrace secondAfter) :
    firstTrace = secondTrace ∧ firstAfter = secondAfter := by
  cases left with
  | retire first => cases right with
    | retire second => obtain ⟨rfl, rfl⟩ := first.deterministic second; exact ⟨rfl, rfl⟩

theorem ResolvesType.deterministic {aliases : Aliases} {source : TypeExpr} {first second : Ty}
    (left : ResolvesType aliases source first) (right : ResolvesType aliases source second) : first = second := by
  induction left using ResolvesType.rec
    (motive_2 := fun sources types _ => ∀ others, ResolvesTypes aliases sources others → types = others)
    generalizing second with
  | concrete => cases right; rfl
  | alias declared expanded ih =>
    cases right with
    | alias otherDeclared otherExpanded =>
      cases Option.some.inj (declared.symm.trans otherDeclared)
      exact ih otherExpanded
  | tuple head tail headIH tailIH =>
    cases right with
    | tuple otherHead otherTail => cases headIH otherHead; cases tailIH _ otherTail; rfl
  | array length resolved ih => cases right with
    | array _ other => cases ih other; rfl
  | nil => rename_i others other; cases other; rfl
  | cons head tail headIH tailIH =>
    rename_i others other
    cases other with
    | cons otherHead otherTail => cases headIH otherHead; cases tailIH _ otherTail; rfl

theorem Pattern.Consumes.deterministic {before firstAfter secondAfter : Environment} {pattern : Pattern} {value : Value}
    {firstBindings secondBindings : BindingValues} {firstTrace secondTrace : List (List Nat)}
    (left : Pattern.Consumes program before pattern value firstBindings firstAfter firstTrace)
    (right : Pattern.Consumes program before pattern value secondBindings secondAfter secondTrace) :
    firstBindings = secondBindings ∧ firstAfter = secondAfter ∧ firstTrace = secondTrace := by
  induction left using Pattern.Consumes.rec
    (motive_2 := fun before index patterns values bindings after trace _ =>
      ∀ otherBindings otherAfter otherTrace, ConsumesFields program before index patterns values otherBindings otherAfter otherTrace →
        bindings = otherBindings ∧ after = otherAfter ∧ trace = otherTrace)
    generalizing secondBindings secondAfter secondTrace with
  | wildcard disposed => cases right with | wildcard other => exact ⟨rfl, disposed.deterministic other, rfl⟩
  | binder => cases right; exact ⟨rfl, rfl, rfl⟩
  | literal disposed => cases right with | literal other => exact ⟨rfl, disposed.deterministic other, rfl⟩
  | node _ same fields ih => cases right with | node _ _ other => exact ih _ _ _ other
  | nil => rename_i right; cases right; exact ⟨rfl, rfl, rfl⟩
  | cons tail head tailIH headIH =>
    rename_i otherBindings otherAfter otherTrace right
    cases right with
    | cons otherTail otherHead =>
      obtain ⟨rfl, rfl, rfl⟩ := tailIH _ _ _ otherTail
      obtain ⟨rfl, rfl, rfl⟩ := headIH otherHead
      exact ⟨rfl, rfl, rfl⟩

theorem ConsumesFields.deterministic {before firstAfter secondAfter : Environment} {index : Nat} {patterns : List Pattern}
    {values : List Value} {firstBindings secondBindings : BindingValues} {firstTrace secondTrace : List (List Nat)}
    (left : ConsumesFields program before index patterns values firstBindings firstAfter firstTrace)
    (right : ConsumesFields program before index patterns values secondBindings secondAfter secondTrace) :
    firstBindings = secondBindings ∧ firstAfter = secondAfter ∧ firstTrace = secondTrace := by
  induction patterns generalizing before index values firstBindings secondBindings firstAfter secondAfter firstTrace secondTrace with
  | nil => cases left; cases right; exact ⟨rfl, rfl, rfl⟩
  | cons pattern patterns ih =>
    cases left with | cons tail head =>
      cases right with | cons otherTail otherHead =>
        obtain ⟨rfl, rfl, rfl⟩ := ih tail otherTail
        obtain ⟨rfl, rfl, rfl⟩ := head.deterministic otherHead
        exact ⟨rfl, rfl, rfl⟩

theorem ConsumesArm.deterministic {α : Type} {before firstAfter secondAfter : Environment} {value : Value}
    {arms : List (Pattern × α)} {firstBindings secondBindings : BindingValues} {firstBody secondBody : α}
    (left : ConsumesArm program before value arms firstBindings firstBody firstAfter)
    (right : ConsumesArm program before value arms secondBindings secondBody secondAfter) :
    firstBindings = secondBindings ∧ firstBody = secondBody ∧ firstAfter = secondAfter := by
  induction left generalizing secondBindings secondBody secondAfter with
  | hit matched consumed =>
    cases right with
    | hit otherMatch otherConsumed =>
      obtain ⟨same, after, trace⟩ := consumed.deterministic otherConsumed
      exact ⟨same, rfl, after⟩
    | miss missed _ => rw [matched] at missed; cases missed
  | miss missed selected ih =>
    cases right with
    | hit matched _ => rw [matched] at missed; cases missed
    | miss _ other => exact ih other

theorem Evaluates.deterministic {before firstAfter secondAfter : Environment} {core : Core} {first second : Value}
    (left : Evaluates program before core first firstAfter) (right : Evaluates program before core second secondAfter) :
    first = second ∧ firstAfter = secondAfter := by
  induction left using Evaluates.rec
    (motive_2 := fun before expressions plans values after _ => ∀ other otherAfter,
      EvaluatesList program before expressions plans other otherAfter → values = other ∧ after = otherAfter)
    (motive_3 := fun source plan result _ => ∀ other,
      NormalizesPattern program source plan other → result = other)
    (motive_4 := fun sources plans results _ => ∀ others,
      NormalizesPatterns program sources plans others → results = others)
    (motive_5 := fun sources plans results _ => ∀ others,
      NormalizesArms program sources plans others → results = others)
    generalizing second secondAfter with
  | unit | integer | character => cases right; exact ⟨rfl, rfl⟩
  | group evaluated ih => cases right with
    | group other => exact ih other
  | implicitMove _ ih => cases right with
    | implicitMove other => exact ih other
  | read resolved selected _ copied => cases right with
    | read otherResolved otherSelected _ otherCopied =>
      cases Option.some.inj (resolved.symm.trans otherResolved)
      cases Option.some.inj (selected.symm.trans otherSelected)
      exact copied.deterministic otherCopied
  | move resolved free allowed taken => cases right with
    | move otherResolved otherFree otherAllowed otherTaken =>
      cases Option.some.inj (resolved.symm.trans otherResolved)
      exact Prod.mk.inj (Option.some.inj (taken.symm.trans otherTaken))
  | borrow resolved _ allowed permitted ready selected plain => cases right with
    | borrow otherResolved _ otherAllowed otherPermitted otherReady otherSelected otherPlain =>
      cases Option.some.inj (resolved.symm.trans otherResolved)
      exact ⟨rfl, rfl⟩
  | reborrow resolved _ allowed permitted ready selected plain => cases right with
    | reborrow otherResolved _ otherAllowed otherPermitted otherReady otherSelected otherPlain =>
      cases Option.some.inj (resolved.symm.trans otherResolved)
      exact ⟨rfl, rfl⟩
  | dereference resolved _ allowed permitted ready selected usable copied => cases right with
    | dereference otherResolved _ otherAllowed otherPermitted otherReady otherSelected otherUsable otherCopied =>
      cases Option.some.inj (resolved.symm.trans otherResolved)
      cases Option.some.inj (selected.symm.trans otherSelected)
      exact copied.deterministic otherCopied
  | moveIndirect resolved _ _ _ _ _ taken => cases right with
    | moveIndirect otherResolved _ _ _ _ _ otherTaken =>
      cases Option.some.inj (resolved.symm.trans otherResolved)
      exact Prod.mk.inj (Option.some.inj (taken.symm.trans otherTaken))
  | assignIndirect evaluated resolved _ _ _ previous dispose _ written continued firstIH restIH => cases right with
    | assignIndirect otherEvaluated otherResolved _ _ _ otherPrevious otherDispose _ otherWritten otherContinued =>
      obtain ⟨rfl, rfl⟩ := firstIH otherEvaluated
      cases Option.some.inj (resolved.symm.trans otherResolved)
      cases Option.some.inj (previous.symm.trans otherPrevious)
      cases dispose.deterministic otherDispose
      cases Option.some.inj (written.symm.trans otherWritten)
      exact restIH otherContinued
  | endOwn ended continued ih => cases right with
    | endOwn otherEnded otherContinued =>
      cases Option.some.inj (ended.symm.trans otherEnded)
      exact ih otherContinued
  | endAfter evaluated ended usable ih => cases right with
    | endAfter otherEvaluated otherEnded otherUsable =>
      obtain ⟨rfl, rfl⟩ := ih otherEvaluated
      exact ⟨rfl, Option.some.inj (ended.symm.trans otherEnded)⟩
  | sequence head dispose tail headIH tailIH => cases right with
    | sequence otherHead otherDispose otherTail =>
      obtain ⟨rfl, rfl⟩ := headIH otherHead
      cases dispose.deterministic otherDispose
      exact tailIH otherTail
  | bind initialized allowed continued cleanup usable initialIH bodyIH => cases right with
    | bind otherInitialized otherAllowed otherContinued otherCleanup otherUsable =>
      obtain ⟨rfl, rfl⟩ := initialIH otherInitialized
      obtain ⟨rfl, rfl⟩ := bodyIH otherContinued
      obtain ⟨_, cleanup⟩ := cleanup
      obtain ⟨_, otherCleanup⟩ := otherCleanup
      exact ⟨rfl, (cleanup.deterministic otherCleanup).2⟩
  | assign evaluated resolved free previous dispose allowed written continued valueIH restIH => cases right with
    | assign otherEvaluated otherResolved otherFree otherPrevious otherDispose otherAllowed otherWritten otherContinued =>
      obtain ⟨rfl, rfl⟩ := valueIH otherEvaluated
      cases Option.some.inj (resolved.symm.trans otherResolved)
      cases Option.some.inj (previous.symm.trans otherPrevious)
      cases dispose.deterministic otherDispose
      cases Option.some.inj (written.symm.trans otherWritten)
      exact restIH otherContinued
  | tuple head tail plain headIH tailIH => cases right with
    | tuple otherHead otherTail otherPlain =>
      obtain ⟨rfl, rfl⟩ := headIH otherHead
      obtain ⟨rfl, rfl⟩ := tailIH _ _ otherTail
      exact ⟨rfl, rfl⟩
  | array residents plain ih => cases right with
    | array otherResidents otherPlain =>
      obtain ⟨rfl, rfl⟩ := ih _ _ otherResidents
      exact ⟨rfl, rfl⟩
  | construct residents plain ih => cases right with
    | construct otherResidents otherPlain =>
      obtain ⟨rfl, rfl⟩ := ih _ _ otherResidents
      exact ⟨rfl, rfl⟩
  | constant declared initialized plain ih => cases right with
    | constant otherDeclared otherInitialized otherPlain =>
      cases Option.some.inj (declared.symm.trans otherDeclared)
      obtain ⟨rfl, rfl⟩ := ih otherInitialized
      exact ⟨rfl, rfl⟩
  | field source selected extracted dispose usable ih => cases right with
    | field otherSource otherSelected otherExtracted otherDispose otherUsable =>
      obtain ⟨rfl, rfl⟩ := ih otherSource
      cases Option.some.inj (selected.symm.trans otherSelected)
      cases Option.some.inj (extracted.symm.trans otherExtracted)
      exact ⟨rfl, dispose.deterministic otherDispose⟩
  | call declared inputs body cleanup usable inputsIH bodyIH => cases right with
    | call otherDeclared otherInputs otherBody otherCleanup otherUsable =>
      cases Option.some.inj (declared.symm.trans otherDeclared)
      obtain ⟨rfl, rfl⟩ := inputsIH _ _ otherInputs
      obtain ⟨rfl, rfl⟩ := bodyIH otherBody
      obtain ⟨_, cleanup⟩ := cleanup
      obtain ⟨_, otherCleanup⟩ := otherCleanup
      cases (cleanup.deterministic otherCleanup).2
      exact ⟨rfl, rfl⟩
  | applyPatterns normalization arguments plain selected body cleanup usable normalizeIH argumentsIH bodyIH => cases right with
    | applyPatterns otherNormalization otherArguments otherPlain otherSelected otherBody otherCleanup otherUsable =>
      cases normalizeIH _ otherNormalization
      obtain ⟨rfl, rfl⟩ := argumentsIH _ _ otherArguments
      obtain ⟨rfl, rfl, rfl⟩ := selected.deterministic otherSelected
      obtain ⟨rfl, rfl⟩ := bodyIH otherBody
      obtain ⟨_, cleanup⟩ := cleanup
      obtain ⟨_, otherCleanup⟩ := otherCleanup
      exact ⟨rfl, (cleanup.deterministic otherCleanup).2⟩
  | nil => rename_i other otherAfter otherEval; cases otherEval; exact ⟨rfl, rfl⟩
  | cons head tail usable headIH tailIH =>
      rename_i other otherAfter otherEval
      cases otherEval with
      | cons otherHead otherTail otherUsable =>
        obtain ⟨rfl, rfl⟩ := headIH otherHead
        obtain ⟨rfl, rfl⟩ := tailIH _ _ otherTail
        exact ⟨rfl, rfl⟩
  | wildcard | binder => rename_i other otherEval; cases otherEval; rfl
  | node fields ih =>
      rename_i other otherEval
      cases otherEval with
      | node otherFields => cases ih _ otherFields; rfl
  | constantValue declared resolved evaluated ih =>
      rename_i other otherEval
      cases otherEval with
      | constantValue otherDeclared otherResolved otherEvaluated =>
        cases Option.some.inj (declared.symm.trans otherDeclared)
        cases resolved.deterministic otherResolved
        obtain ⟨rfl, rfl⟩ := ih otherEvaluated
        rfl
  | patternsNil | armsNil => rename_i other otherEval; cases otherEval; rfl
  | patternsCons head tail headIH tailIH =>
      rename_i other otherEval
      cases otherEval with
      | patternsCons otherHead otherTail => cases headIH _ otherHead; cases tailIH _ otherTail; rfl
  | armsCons head tail headIH tailIH =>
      rename_i other otherEval
      cases otherEval with
      | armsCons otherHead otherTail => cases headIH _ otherHead; cases tailIH _ otherTail; rfl

theorem EvaluatesList.deterministic {before firstAfter secondAfter : Environment}
    {expressions : List Expr} {plans : List CorePlan} {first second : List Value}
    (left : EvaluatesList program before expressions plans first firstAfter)
    (right : EvaluatesList program before expressions plans second secondAfter) :
    first = second ∧ firstAfter = secondAfter := by
  induction expressions generalizing before plans first firstAfter second secondAfter with
  | nil => cases left; cases right; exact ⟨rfl, rfl⟩
  | cons expression expressions ih =>
    cases left with
    | cons head tail usable => cases right with
      | cons otherHead otherTail otherUsable =>
        obtain ⟨rfl, rfl⟩ := head.deterministic otherHead
        obtain ⟨rfl, rfl⟩ := ih tail otherTail
        exact ⟨rfl, rfl⟩

theorem NormalizesPattern.deterministic {source : PatternSource} {plan : PatternPlan} {first second : Pattern}
    (left : NormalizesPattern program source plan first)
    (right : NormalizesPattern program source plan second) : first = second := by
  induction left using NormalizesPattern.rec
    (motive_1 := fun _ _ _ _ _ => True)
    (motive_2 := fun _ _ _ _ _ _ => True)
    (motive_4 := fun sources plans results _ => ∀ others,
      NormalizesPatterns program sources plans others → results = others)
    (motive_5 := fun _ _ _ _ => True)
    generalizing second with
  | wildcard | binder => cases right; rfl
  | node fields ih => cases right with
    | node otherFields => cases ih _ otherFields; rfl
  | constantValue declared resolved evaluated ih => cases right with
    | constantValue otherDeclared otherResolved otherEvaluated =>
      cases Option.some.inj (declared.symm.trans otherDeclared)
      cases resolved.deterministic otherResolved
      obtain ⟨rfl, rfl⟩ := evaluated.deterministic otherEvaluated
      rfl
  | patternsNil => rename_i other otherEval; cases otherEval; rfl
  | patternsCons head tail headIH tailIH =>
    rename_i other otherEval
    cases otherEval with
    | patternsCons otherHead otherTail => cases headIH otherHead; cases tailIH _ otherTail; rfl
  | _ => trivial

theorem NormalizesPatterns.deterministic {sources : List PatternSource} {plans : List PatternPlan}
    {first second : List Pattern}
    (left : NormalizesPatterns program sources plans first)
    (right : NormalizesPatterns program sources plans second) : first = second := by
  induction sources generalizing plans first second with
  | nil => cases left; cases right; rfl
  | cons source sources ih => cases left with
    | patternsCons head tail => cases right with
      | patternsCons otherHead otherTail =>
        cases head.deterministic otherHead
        cases ih tail otherTail
        rfl

theorem NormalizesArms.deterministic {sources : List (PatternSource × Expr)}
    {plans : List (PatternPlan × CorePlan)} {first second : List (Pattern × Core)}
    (left : NormalizesArms program sources plans first)
    (right : NormalizesArms program sources plans second) : first = second := by
  induction sources generalizing plans first second with
  | nil => cases left; cases right; rfl
  | cons source sources ih => cases left with
    | armsCons head tail => cases right with
      | armsCons otherHead otherTail =>
        cases head.deterministic otherHead
        cases ih tail otherTail
        rfl

theorem Environment.endSlot_length {before after : Environment} {slot : Nat} {fields : List Nat}
    (ended : before.endSlot slot fields = some after) : after.loans.length = before.loans.length := by
  obtain ⟨_, _, _, _, _, transition⟩ := endSlot_checked ended
  exact endOwn_length transition

theorem Environment.prepare_loans (values : BindingValues) (before : Environment) :
    (before.prepare values).loans = before.loans := by
  induction values generalizing before with
  | nil => rfl
  | cons entry rest ih => exact ih _

theorem ConsumesArm.loans_length {α : Type} {before after : Environment} {value : Value}
    {arms : List (Pattern × α)} {bindings : BindingValues} {body : α}
    (consumed : ConsumesArm program before value arms bindings body after) : after.loans.length = before.loans.length := by
  induction consumed with
  | hit _ consumed => exact consumed.loans_length
  | miss _ _ ih => exact ih

theorem Evaluates.loans_mono {before after : Environment} {core : Core} {value : Value}
    (evaluated : Evaluates program before core value after) : before.loans.length ≤ after.loans.length := by
  induction evaluated using Evaluates.rec
    (motive_2 := fun before _ _ _ after _ => before.loans.length ≤ after.loans.length)
    (motive_3 := fun _ _ _ _ => True)
    (motive_4 := fun _ _ _ _ => True)
    (motive_5 := fun _ _ _ _ => True) with
  | unit | integer | character => exact Nat.le_refl _
  | group _ ih | implicitMove _ ih => exact ih
  | read _ _ _ copied => exact copied.loans_mono
  | move _ _ _ taken =>
    exact Nat.le_of_eq (congrArg List.length (Environment.writeAddress_loans (Environment.takeAddress_eq_some.mp taken).2)).symm
  | moveIndirect _ _ _ _ _ _ taken =>
    exact Nat.le_of_eq (congrArg List.length (Environment.writeAddress_loans (Environment.takeAddress_eq_some.mp taken).2)).symm
  | assignIndirect _ _ _ _ _ _ dispose _ written _ first rest =>
    rw [Environment.writeAddress_loans written, dispose.loans_length] at rest
    exact Nat.le_trans first rest
  | borrow | reborrow => simp [Environment.addLoan]
  | dereference _ _ _ _ _ _ _ copied => exact copied.loans_mono
  | endOwn ended _ ih => simpa only [Environment.endSlot_length ended] using ih
  | endAfter _ ended _ ih => simpa only [Environment.endSlot_length ended] using ih
  | sequence _ dispose _ first rest => exact Nat.le_trans first (by simpa only [dispose.loans_length] using rest)
  | bind _ _ _ cleanup _ first rest =>
    obtain ⟨trace, cleaned⟩ := cleanup
    rw [cleaned.loans_length]
    exact Nat.le_trans first rest
  | assign _ _ _ _ dispose _ written _ first rest =>
    rw [Environment.writeAddress_loans written, dispose.loans_length] at rest
    exact Nat.le_trans first rest
  | tuple _ _ _ first rest => exact Nat.le_trans first rest
  | array _ _ ih => exact ih
  | constant _ _ _ ih => exact ih
  | construct _ _ ih => exact ih
  | field _ _ _ dispose _ ih => simpa only [dispose.loans_length] using ih
  | call _ _ _ cleanup _ first rest =>
    obtain ⟨trace, cleaned⟩ := cleanup
    simp only [Environment.resume, cleaned.loans_length]
    simp only [Environment.prepare_loans, Environment.hide] at rest
    exact Nat.le_trans first rest
  | applyPatterns _ _ _ selected _ cleanup _ _ first rest =>
    obtain ⟨trace, cleaned⟩ := cleanup
    rw [cleaned.loans_length]
    simp only [Environment.prepare_loans] at rest
    rw [selected.loans_length] at rest
    exact Nat.le_trans first rest
  | nil => exact Nat.le_refl _
  | cons _ _ _ first rest => exact Nat.le_trans first rest
  | wildcard | binder | node | constantValue | patternsNil | patternsCons | armsNil | armsCons => trivial

theorem empty_of_length_le {α β : Type} {xs : List α} {ys : List β}
    (le : xs.length ≤ ys.length) (empty : ys = []) : xs = [] := by
  cases xs with
  | nil => rfl
  | cons head tail => simp [empty] at le

theorem Evaluates.empty_before {before after : Environment} {core : Core} {value : Value}
    (evaluated : Evaluates program before core value after) (empty : after.loans = []) : before.loans = [] :=
  empty_of_length_le evaluated.loans_mono empty

theorem EvaluatesList.loans_mono {before after : Environment} {expressions plans values}
    (evaluated : EvaluatesList program before expressions plans values after) : before.loans.length ≤ after.loans.length := by
  induction expressions generalizing before plans values with
  | nil => cases evaluated; exact Nat.le_refl _
  | cons head tail ih =>
    cases evaluated with
    | cons first rest _ => exact Nat.le_trans first.loans_mono (ih rest)

theorem EvaluatesList.empty_before {before after : Environment} {expressions plans values}
    (evaluated : EvaluatesList program before expressions plans values after) (empty : after.loans = []) : before.loans = [] :=
  empty_of_length_le evaluated.loans_mono empty

theorem Environment.empty_endOwn {before after : Environment} {node : Nat} (empty : before.loans = [])
    (ended : before.endOwn node = some after) : False := by
  simp [endOwn, empty] at ended

theorem Environment.empty_endSlot {before after : Environment} {slot : Nat} {fields : List Nat} (empty : before.loans = [])
    (ended : before.endSlot slot fields = some after) : False := by
  obtain ⟨_, _, _, _, _, transition⟩ := endSlot_checked ended
  exact empty_endOwn empty transition

theorem Environment.empty_ownerFree {before : Environment} (empty : before.loans = []) (address : Address) :
    before.OwnerFree address := by
  intro node loan found
  simp [empty] at found

theorem Environment.Disposes.empty {before after : Environment} {value : Value}
    (disposed : Disposes program before value after) (empty : before.loans = []) :
    after = before ∧ value.ReferenceFree := by
  induction disposed using Disposes.rec
    (motive_2 := fun before values after _ => before.loans = [] → after = before ∧ valuesReferenceFree values) with
  | data plain _ => exact ⟨rfl, plain⟩
  | reference _ ended => exact False.elim (empty_endOwn empty ended)
  | tuple _ _ ih | array _ _ ih | nominal _ _ ih => exact ih empty
  | nil => exact ⟨rfl, trivial⟩
  | cons _ _ tailIH headIH =>
    rename_i empty
    obtain ⟨rfl, tailPlain⟩ := tailIH empty
    obtain ⟨rfl, headPlain⟩ := headIH empty
    exact ⟨rfl, headPlain, tailPlain⟩

theorem DisposesRoots.empty {before after : Environment} {roots trace}
    (disposed : DisposesRoots program before roots trace after) (empty : before.loans = []) : after = before := by
  induction disposed with
  | nil => rfl
  | cons _ _ head _ ih =>
    obtain ⟨rfl, _⟩ := head.empty empty
    exact ih empty

theorem Cleans.empty {before after : Environment} {count trace}
    (cleaned : Cleans program count before trace after) (empty : after.loans = []) :
    before.loans = [] ∧ after = before.retire count := by
  have initial := empty_of_length_le (Nat.le_of_eq cleaned.loans_length.symm) empty
  refine ⟨initial, ?_⟩
  cases cleaned with
  | retire disposed => rw [disposed.empty initial]

theorem DisposesRoots.agrees_stored {left right after : Environment} {leftBindings rightBindings : List (String × Root)}
    {values : BindingValues} {trace}
    (first : StoredBindings left.store leftBindings values)
    (second : StoredBindings right.store rightBindings values)
    (disposed : DisposesRoots program left (leftBindings.map Prod.snd) trace after)
    (leftEmpty : left.loans = []) (rightEmpty : right.loans = []) :
    ∃ otherTrace, DisposesRoots program right (rightBindings.map Prod.snd) otherTrace right := by
  induction first generalizing rightBindings trace after with
  | nil => cases second; exact ⟨[], .nil⟩
  | cons found rest ih =>
    cases second with
    | cons otherFound otherRest =>
      cases disposed with
      | cons selected _ head tail =>
        cases Option.some.inj (found.symm.trans selected)
        obtain ⟨rfl, plain⟩ := head.empty leftEmpty
        obtain ⟨otherTrace, otherTail⟩ := ih otherRest tail
        exact ⟨_, .cons otherFound (Environment.empty_ownerFree rightEmpty _) (.data plain head.logical) otherTail⟩

theorem Cleans.agrees_empty {left right after : Environment} {count trace}
    (cleaned : Cleans program count left trace after) (same : left.Agrees right)
    (leftEmpty : after.loans = []) (rightEmpty : right.loans = []) :
    ∃ otherTrace, Cleans program count right otherTrace (right.retire count) ∧ after.Agrees (right.retire count) := by
  obtain ⟨initial, final⟩ := cleaned.empty leftEmpty
  obtain ⟨values, first, second⟩ := same.values
  have other : ∃ otherTrace, Cleans program count right otherTrace (right.retire count) := by
    cases cleaned with
    | retire disposed =>
      obtain ⟨trace, transported⟩ := disposed.agrees_stored (first.take count) (second.take count) initial rightEmpty
      exact ⟨trace, .retire transported⟩
  obtain ⟨trace, other⟩ := other
  exact ⟨trace, other, final ▸ same.retire count⟩

theorem Pattern.Consumes.referenceFree {before after : Environment} {pattern : Pattern} {value : Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : Pattern.Consumes program before pattern value bindings after trace) (plain : value.ReferenceFree) :
    after = before ∧ ∀ other, Pattern.Consumes program other pattern value bindings other trace := by
  induction consumed using Pattern.Consumes.rec
    (motive_2 := fun before index patterns values bindings after trace _ =>
      (∀ value ∈ values, value.ReferenceFree) → after = before ∧
      ∀ other, ConsumesFields program other index patterns values bindings other trace) with
  | wildcard disposed => exact ⟨disposed.referenceFree plain, fun other => .wildcard (.data plain disposed.logical)⟩
  | literal disposed => exact ⟨disposed.referenceFree plain, fun other => .literal (.data plain disposed.logical)⟩
  | binder => exact ⟨rfl, fun other => .binder other _ _⟩
  | node source same fields ih =>
    obtain ⟨identity, replay⟩ := ih (fun _ member => by
      obtain ⟨index, found⟩ := List.mem_iff_getElem?.mp member
      exact plain.children found)
    exact ⟨identity, fun other => .node source same (replay other)⟩
  | nil => exact ⟨rfl, fun other => .nil other _⟩
  | cons tail head tailIH headIH =>
    rename_i plain
    obtain ⟨tailIdentity, tailReplay⟩ := tailIH (fun value member => plain value (by simp [member]))
    obtain ⟨headIdentity, headReplay⟩ := headIH (plain _ (by simp))
    exact ⟨headIdentity.trans tailIdentity, fun other => .cons (tailReplay other) (headReplay other)⟩

theorem ConsumesFields.referenceFree {before after : Environment} {index : Nat} {patterns : List Pattern} {values : List Value}
    {bindings : BindingValues} {trace : List (List Nat)}
    (consumed : ConsumesFields program before index patterns values bindings after trace)
    (plain : ∀ value ∈ values, value.ReferenceFree) : after = before ∧
    ∀ other, ConsumesFields program other index patterns values bindings other trace := by
  induction patterns generalizing before after index values bindings trace with
  | nil => cases consumed; exact ⟨rfl, fun other => .nil other _⟩
  | cons pattern patterns ih =>
    cases consumed with | cons tail head =>
      obtain ⟨tailIdentity, tailReplay⟩ := ih tail (fun value member => plain value (by simp [member]))
      obtain ⟨headIdentity, headReplay⟩ := head.referenceFree (plain _ (by simp))
      exact ⟨headIdentity.trans tailIdentity, fun other => .cons (tailReplay other) (headReplay other)⟩

theorem ConsumesArm.referenceFree {α : Type} {before after : Environment} {value : Value}
    {arms : List (Pattern × α)} {bindings : BindingValues} {body : α}
    (consumed : ConsumesArm program before value arms bindings body after) (plain : value.ReferenceFree) :
    after = before ∧ ∀ other, ConsumesArm program other value arms bindings body other := by
  induction consumed with
  | hit matched consumed =>
    obtain ⟨identity, replay⟩ := consumed.referenceFree plain
    exact ⟨identity, fun other => .hit matched (replay other)⟩
  | miss missed _ ih => exact ⟨ih.1, fun other => .miss missed (ih.2 other)⟩

theorem Evaluates.agrees {left after : Environment} {core : Core} {value : Value}
    (evaluated : Evaluates program left core value after) :
    after.loans = [] → ∀ right, left.Agrees right → right.loans = [] →
      ∃ other, Evaluates program right core value other ∧ after.Agrees other ∧ other.loans = [] := by
  induction evaluated using Evaluates.rec
    (motive_2 := fun left expressions plans values after _ =>
      after.loans = [] → ∀ right, left.Agrees right → right.loans = [] →
        ∃ other, EvaluatesList program right expressions plans values other ∧ after.Agrees other ∧ other.loans = [])
    (motive_3 := fun _ _ _ _ => True)
    (motive_4 := fun _ _ _ _ => True)
    (motive_5 := fun _ _ _ _ => True) with
  | unit => intro _ right same empty; exact ⟨right, .unit, same, empty⟩
  | integer fits => intro _ right same empty; exact ⟨right, .integer fits, same, empty⟩
  | character valid => intro _ right same empty; exact ⟨right, .character valid, same, empty⟩
  | group _ ih =>
    intro final right same empty
    obtain ⟨other, body, agreed, final⟩ := ih final right same empty
    exact ⟨other, .group body, agreed, final⟩
  | implicitMove _ ih =>
    intro final right same empty
    obtain ⟨other, body, agreed, final⟩ := ih final right same empty
    exact ⟨other, .implicitMove body, agreed, final⟩
  | read resolved selected _ copied =>
    intro final right same empty
    obtain ⟨plain, rfl, rfl⟩ := copied.empty_identity final
    obtain ⟨address, otherResolved, _, atSame, _⟩ := same.resolvePlace resolved
    exact ⟨right, .read otherResolved (by simpa only [Environment.readAddress, atSame] using selected)
      (by intro node loan found; simp [empty] at found) (.data plain), same, empty⟩
  | move resolved _ allowed taken =>
    intro final right same empty
    obtain ⟨read, written⟩ := Environment.takeAddress_eq_some.mp taken
    have initial : _ = [] := (Environment.writeAddress_loans written).symm.trans final
    obtain ⟨address, otherResolved, _, atSame, update⟩ := same.resolvePlace resolved
    obtain ⟨other, written, agreed⟩ := update _ _ written
    exact ⟨other, .move otherResolved (Environment.empty_ownerFree empty _) (.of_plain (allowed.plain initial))
      (Environment.takeAddress_eq_some.mpr ⟨by simpa only [Environment.readAddress, atSame] using read, written⟩),
      agreed, (Environment.writeAddress_loans written).trans empty⟩
  | borrow | reborrow => intro final; simp [Environment.addLoan] at final
  | dereference resolved _ _ _ _ _ _ copied =>
    intro final
    have empty := copied.empty_before final
    simp only [Environment.resolveAccess, Bind.bind, Option.bind_eq_some_iff] at resolved
    obtain ⟨carrier, _, resident, _, resolved⟩ := resolved
    cases resident <;> simp_all
  | moveIndirect resolved _ _ _ _ _ taken =>
    intro final
    have empty := (Environment.writeAddress_loans (Environment.takeAddress_eq_some.mp taken).2).symm.trans final
    simp only [Environment.resolveAccess, Bind.bind, Option.bind_eq_some_iff] at resolved
    obtain ⟨carrier, _, resident, _, resolved⟩ := resolved
    cases resident <;> simp_all
  | assignIndirect _ resolved _ _ _ _ dispose _ written continued _ _ =>
    intro final
    have disposedEmpty := (Environment.writeAddress_loans written).symm.trans (continued.empty_before final)
    have empty := empty_of_length_le (Nat.le_of_eq dispose.loans_length.symm) disposedEmpty
    simp only [Environment.resolveAccess, Bind.bind, Option.bind_eq_some_iff] at resolved
    obtain ⟨carrier, _, resident, _, resolved⟩ := resolved
    cases resident <;> simp_all
  | endOwn ended body ih =>
    intro final
    have endedEmpty := body.empty_before final
    have initial := empty_of_length_le (Nat.le_of_eq (Environment.endSlot_length ended).symm) endedEmpty
    exact False.elim (Environment.empty_endSlot initial ended)
  | endAfter body ended _ ih =>
    intro final
    have initial := empty_of_length_le (Nat.le_of_eq (Environment.endSlot_length ended).symm) final
    exact False.elim (Environment.empty_endSlot initial ended)
  | sequence head dispose tail headIH tailIH =>
    intro final right same empty
    have disposedEmpty := tail.empty_before final
    have middleEmpty := empty_of_length_le (Nat.le_of_eq dispose.loans_length.symm) disposedEmpty
    obtain ⟨rfl, plain⟩ := dispose.empty middleEmpty
    obtain ⟨middle, first, middleSame, middleEmpty⟩ := headIH middleEmpty right same empty
    obtain ⟨other, rest, afterSame, otherEmpty⟩ := tailIH final middle middleSame middleEmpty
    exact ⟨other, .sequence first (.data plain dispose.logical) rest, afterSame, otherEmpty⟩
  | bind initial allowed body cleanup usable initialIH bodyIH =>
    intro final right same empty
    obtain ⟨trace, cleaned⟩ := cleanup
    obtain ⟨localEmpty, _⟩ := cleaned.empty final
    have middleEmpty := body.empty_before localEmpty
    obtain ⟨middle, initial, middleSame, middleEmpty'⟩ := initialIH middleEmpty right same empty
    obtain ⟨other, body, afterSame, otherEmpty⟩ := bodyIH localEmpty _ (middleSame.bind _ _) middleEmpty'
    obtain ⟨trace, cleaned, agreed⟩ := cleaned.agrees_empty afterSame final otherEmpty
    exact ⟨other.retire 1, .bind initial (.of_plain (allowed.plain middleEmpty)) body ⟨trace, cleaned⟩
      (.of_plain (usable.plain final)), agreed, otherEmpty⟩
  | assign initial resolved _ previous dispose allowed written body initialIH bodyIH =>
    intro final right same empty
    have updatedEmpty := body.empty_before final
    have disposedEmpty := (Environment.writeAddress_loans written).symm.trans updatedEmpty
    have middleEmpty := empty_of_length_le (Nat.le_of_eq dispose.loans_length.symm) disposedEmpty
    obtain ⟨rfl, plain⟩ := dispose.empty middleEmpty
    obtain ⟨middle, initial, middleSame, middleEmpty'⟩ := initialIH middleEmpty right same empty
    obtain ⟨address, otherResolved, _, atSame, update⟩ := middleSame.resolvePlace resolved
    obtain ⟨updated, written, updatedSame⟩ := update _ _ written
    obtain ⟨other, body, afterSame, otherEmpty⟩ := bodyIH final updated updatedSame ((Environment.writeAddress_loans written).trans middleEmpty')
    exact ⟨other, .assign initial otherResolved (Environment.empty_ownerFree middleEmpty' _) (atSame.trans previous)
      (.data plain dispose.logical) (.of_plain (allowed.plain disposedEmpty)) written body, afterSame, otherEmpty⟩
  | tuple _ tail plain headIH tailIH =>
    intro final right same empty
    obtain ⟨middle, first, middleSame, middleEmpty⟩ := headIH (tail.empty_before final) right same empty
    obtain ⟨other, rest, afterSame, otherEmpty⟩ := tailIH final middle middleSame middleEmpty
    exact ⟨other, .tuple first rest (.of_plain (plain.plain final)), afterSame, otherEmpty⟩
  | array _ plain ih =>
    intro final right same empty
    obtain ⟨other, elements, afterSame, otherEmpty⟩ := ih final right same empty
    exact ⟨other, .array elements (.of_plain (plain.plain final)), afterSame, otherEmpty⟩
  | constant declared initialized plain ih =>
    intro final right same empty
    obtain ⟨other, body, afterSame, otherEmpty⟩ := ih final right.hide same.hide empty
    have initialEmpty := initialized.empty_before final
    simp only [Environment.hide] at initialEmpty
    exact ⟨right.resume other, .constant declared body plain, same.resume afterSame.leftValid afterSame.rightValid
      (initialized.storage same.leftValid.hide).2 (body.storage same.rightValid.hide).2
      (fun root => by simp [Environment.UniqueRoot, initialEmpty])
      (fun root => by simp [Environment.UniqueRoot, empty]), otherEmpty⟩
  | construct _ plain ih =>
    intro final right same empty
    obtain ⟨other, elements, afterSame, otherEmpty⟩ := ih final right same empty
    exact ⟨other, .construct elements (.of_plain (plain.plain final)), afterSame, otherEmpty⟩
  | field _ selected extracted dispose usable ih =>
    intro final right same empty
    have middleEmpty := empty_of_length_le (Nat.le_of_eq dispose.loans_length.symm) final
    obtain ⟨rfl, plain⟩ := dispose.empty middleEmpty
    obtain ⟨other, body, afterSame, otherEmpty⟩ := ih final right same empty
    exact ⟨other, .field body selected extracted (.data plain dispose.logical) (.of_plain (usable.plain final)), afterSame, otherEmpty⟩
  | call declared _ body cleanup usable inputsIH bodyIH =>
    intro final right same empty
    obtain ⟨trace, cleaned⟩ := cleanup
    obtain ⟨localEmpty, cleanedEq⟩ := cleaned.empty final
    have middleEmpty := body.empty_before localEmpty
    simp only [Environment.prepare_loans, Environment.hide] at middleEmpty
    obtain ⟨middle, inputs, middleSame, middleEmpty'⟩ := inputsIH middleEmpty right same empty
    obtain ⟨other, otherBody, afterSame, otherEmpty⟩ := bodyIH localEmpty _ (middleSame.hide.prepare _)
      (by simpa only [Environment.prepare_loans, Environment.hide] using middleEmpty')
    obtain ⟨trace, otherCleaned, agreed⟩ := cleaned.agrees_empty afterSame final otherEmpty
    have leftFrame := (body.storage (middleSame.leftValid.hide.prepare _)).2.scope middleSame.leftValid.hide _
    have rightFrame := (otherBody.storage (middleSame.rightValid.hide.prepare _)).2.scope middleSame.rightValid.hide _
    rw [← cleanedEq] at leftFrame
    exact ⟨_, .call declared inputs otherBody ⟨trace, otherCleaned⟩ (.of_plain (usable.plain final)),
      middleSame.resume agreed.leftValid agreed.rightValid leftFrame rightFrame
        (fun root => by simp [Environment.UniqueRoot, middleEmpty])
        (fun root => by simp [Environment.UniqueRoot, middleEmpty']), otherEmpty⟩
  | applyPatterns normalization _ pending selected bodyEval cleanup usable _ argumentsIH bodyIH =>
    intro final right same empty
    obtain ⟨trace, cleaned⟩ := cleanup
    obtain ⟨localEmpty, _⟩ := cleaned.empty final
    have consumedEmpty := bodyEval.empty_before localEmpty
    simp only [Environment.prepare_loans] at consumedEmpty
    have middleEmpty := empty_of_length_le (Nat.le_of_eq selected.loans_length.symm) consumedEmpty
    have plain := pending.plain middleEmpty
    obtain ⟨identity, replay⟩ := selected.referenceFree plain
    cases identity
    obtain ⟨middle, arguments, middleSame, middleEmpty'⟩ := argumentsIH middleEmpty right same empty
    obtain ⟨other, body, afterSame, otherEmpty⟩ := bodyIH localEmpty _ (middleSame.prepare _)
      (by simpa only [Environment.prepare_loans] using middleEmpty')
    obtain ⟨trace, otherCleaned, agreed⟩ := cleaned.agrees_empty afterSame final otherEmpty
    exact ⟨_, .applyPatterns normalization arguments (.of_plain plain) (replay middle) body ⟨trace, otherCleaned⟩
      (.of_plain (usable.plain final)), agreed, otherEmpty⟩
  | nil => rename_i final right same empty; exact ⟨right, .nil, same, empty⟩
  | cons _ tail usable headIH tailIH =>
    rename_i final right same empty
    obtain ⟨middle, first, middleSame, middleEmpty⟩ := headIH (tail.empty_before final) right same empty
    obtain ⟨other, rest, afterSame, otherEmpty⟩ := tailIH final middle middleSame middleEmpty
    exact ⟨other, .cons first rest (.of_plain (usable.plain final)), afterSame, otherEmpty⟩
  | wildcard | binder | node | constantValue | patternsNil | patternsCons | armsNil | armsCons => trivial



/-- Actual reference-free results, not raw equality of potentially renamed handles. -/

theorem Evaluates.referenceFree_of_empty {before after : Environment} {core : Core} {value : Value}
    (evaluated : Evaluates program before core value after) : after.loans = [] → value.ReferenceFree := by
  induction evaluated using Evaluates.rec
    (motive_2 := fun _ _ _ _ _ _ => True)
    (motive_3 := fun _ _ _ _ => True)
    (motive_4 := fun _ _ _ _ => True)
    (motive_5 := fun _ _ _ _ => True) with
  | unit | integer | character => intro _; trivial
  | group _ ih | implicitMove _ ih => exact ih
  | read _ _ _ copied =>
    intro empty
    exact copied.referenceFree_of_empty empty
  | move _ _ usable taken =>
    intro empty
    exact usable.plain ((Environment.writeAddress_loans (Environment.takeAddress_eq_some.mp taken).2).symm.trans empty)
  | borrow | reborrow => intro empty; simp [Environment.addLoan] at empty
  | dereference _ _ _ _ _ _ _ copied => exact copied.referenceFree_of_empty
  | moveIndirect _ _ _ _ _ usable taken =>
    intro empty
    exact usable.plain ((Environment.writeAddress_loans (Environment.takeAddress_eq_some.mp taken).2).symm.trans empty)
  | assignIndirect _ _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | endOwn _ _ ih => exact ih
  | endAfter _ _ usable _ => exact usable.plain
  | sequence _ _ _ _ ih => exact ih
  | bind _ _ _ _ usable _ _ => exact usable.plain
  | assign _ _ _ _ _ _ _ _ _ ih => exact ih
  | tuple _ _ usable _ _ => exact usable.plain
  | array _ usable _ => exact usable.plain
  | constant _ _ plain _ => exact fun _ => plain
  | construct _ usable _ => exact usable.plain
  | field _ _ _ _ usable _ => exact usable.plain
  | call _ _ _ _ usable _ _ => exact usable.plain
  | applyPatterns _ _ _ _ _ _ usable _ _ _ => exact usable.plain
  | nil | cons | wildcard | binder | node | constantValue | patternsNil | patternsCons | armsNil | armsCons => trivial

/-- Conservative old-world specialization of the sole Core evaluator. Old worlds
may have distinct logical roots, supplies and hidden caller cells. The returned
value is owned data; evaluation and visible post-state agreement are proved,
not supplied by the restriction. Empty final history excludes even ended loans,
because the runtime retains records and `Evaluates.loans_mono` proves monotonicity. -/

theorem Evaluates.referenceFree_agreement {left right after : Environment} {core : Core} {value : Value}
    (evaluated : Evaluates program left core value after)
    (rightEmpty : right.loans = []) (same : left.Agrees right) (finalWorld : after.loans = []) :
    value.ReferenceFree ∧ ∃ other, Evaluates program right core value other ∧ after.Agrees other ∧
      other.loans = [] ∧ left.Evolution after ∧ right.Evolution other := by
  obtain ⟨other, transported, agreed, empty⟩ := evaluated.agrees finalWorld right same rightEmpty
  exact ⟨evaluated.referenceFree_of_empty finalWorld, other, transported, agreed, empty,
    (evaluated.storage same.leftValid).2, (transported.storage same.rightValid).2⟩

mutual
def Expr.ReferenceFree : Expr → Prop
  | .borrow _ _ | .dereference _ _ | .moveIndirect _ _ | .assignIndirect _ _ _ _ => False
  | .group body | .field body _ => body.ReferenceFree
  | .sequence first rest | .assign _ first rest | .bind _ _ _ first rest =>
      first.ReferenceFree ∧ rest.ReferenceFree
  | .tuple first rest => first.ReferenceFree ∧ expressionsReferenceFree rest
  | .array elements | .construct _ _ elements | .call _ elements => expressionsReferenceFree elements
  | .applyPatterns _ arguments arms => expressionsReferenceFree arguments ∧ armsReferenceFree arms
  | _ => True

def expressionsReferenceFree : List Expr → Prop
  | [] => True
  | head :: tail => head.ReferenceFree ∧ expressionsReferenceFree tail

def armsReferenceFree : List (PatternSource × Expr) → Prop
  | [] => True
  | (_, body) :: tail => body.ReferenceFree ∧ armsReferenceFree tail
end

def Program.ReferenceFree (program : Program) : Prop :=
  (∀ name declaration, program.constants name = some declaration → declaration.body.ReferenceFree) ∧
  (∀ identity declaration, program.functions identity = some declaration → declaration.body.ReferenceFree)

theorem NormalizesArms.referenceFree_bodies {sources plans normalized}
    (normalization : NormalizesArms program sources plans normalized)
    (plain : armsReferenceFree sources) : ∀ arm ∈ normalized, arm.2.source.ReferenceFree := by
  induction sources generalizing plans normalized with
  | nil => cases normalization; simp
  | cons entry rest ih =>
    cases normalization with
    | armsCons _ tail =>
      intro arm member
      rcases List.mem_cons.mp member with rfl | member
      · exact plain.1
      · exact ih tail plain.2 arm member

theorem ConsumesArm.referenceFree_body {before after : Environment} {value bindings body} {arms : List (Pattern × Core)}
    (selected : ConsumesArm program before value arms bindings body after)
    (plain : ∀ arm ∈ arms, arm.2.source.ReferenceFree) : body.source.ReferenceFree := by
  induction selected with
  | hit => exact plain _ (List.mem_cons_self)
  | miss _ _ ih => exact ih (fun arm member => plain arm (by simp [member]))

theorem Evaluates.empty_of_referenceFree {before after : Environment} {core : Core} {value : Value}
    (evaluated : Evaluates program before core value after) (declarations : program.ReferenceFree) :
    core.source.ReferenceFree → before.loans = [] → after.loans = [] := by
  induction evaluated using Evaluates.rec
    (motive_2 := fun before expressions _ _ after _ =>
      expressionsReferenceFree expressions → before.loans = [] → after.loans = [])
    (motive_3 := fun _ _ _ _ => True)
    (motive_4 := fun _ _ _ _ => True)
    (motive_5 := fun _ _ _ _ => True) with
  | unit | integer | character => exact fun _ empty => empty
  | group _ ih | implicitMove _ ih => exact ih
  | read _ _ _ copied =>
    intro _ empty
    exact copied.empty_after empty
  | move _ _ _ taken =>
    intro _ empty
    exact (Environment.writeAddress_loans (Environment.takeAddress_eq_some.mp taken).2).trans empty
  | borrow | dereference | moveIndirect | assignIndirect => intro impossible; exact False.elim impossible
  | reborrow resolved =>
    intro _ empty
    simp only [Environment.resolveAccess, Bind.bind, Option.bind_eq_some_iff] at resolved
    obtain ⟨carrier, _, resident, _, resolved⟩ := resolved
    cases resident <;> simp_all
  | endOwn ended _ _ => intro _ empty; exact False.elim (Environment.empty_endSlot empty ended)
  | endAfter _ ended _ ih =>
    intro plain empty
    exact False.elim (Environment.empty_endSlot (ih plain empty) ended)
  | sequence _ dispose _ first rest =>
    intro plain empty
    have middleEmpty := first plain.1 empty
    obtain ⟨rfl, _⟩ := dispose.empty middleEmpty
    exact rest plain.2 middleEmpty
  | bind _ _ _ cleanup _ first rest =>
    intro plain empty
    have localEmpty := rest plain.2 (first plain.1 empty)
    obtain ⟨trace, cleaned⟩ := cleanup
    exact empty_of_length_le (Nat.le_of_eq cleaned.loans_length) localEmpty
  | assign _ _ _ _ dispose _ written _ first rest =>
    intro plain empty
    have middleEmpty := first plain.1 empty
    have disposedEmpty := empty_of_length_le (Nat.le_of_eq dispose.loans_length) middleEmpty
    exact rest plain.2 ((Environment.writeAddress_loans written).trans disposedEmpty)
  | tuple _ _ _ first rest => exact fun plain empty => rest plain.2 (first plain.1 empty)
  | array _ _ ih => exact ih
  | constant declared _ _ ih => exact fun _ empty => ih (declarations.1 _ _ declared) empty
  | construct _ _ ih => exact ih
  | field _ _ _ dispose _ ih =>
    intro plain empty
    exact empty_of_length_le (Nat.le_of_eq dispose.loans_length) (ih plain empty)
  | call declared _ _ cleanup _ first rest =>
    intro plain empty
    have middleEmpty := first plain empty
    have localEmpty := rest (declarations.2 _ _ declared)
      (by simpa only [Environment.prepare_loans, Environment.hide] using middleEmpty)
    obtain ⟨trace, cleaned⟩ := cleanup
    exact empty_of_length_le (Nat.le_of_eq cleaned.loans_length) localEmpty
  | applyPatterns normalization _ _ selected _ cleanup _ _ first rest =>
    intro plain empty
    have middleEmpty := first plain.1 empty
    have consumedEmpty := empty_of_length_le (Nat.le_of_eq selected.loans_length) middleEmpty
    have localEmpty := rest (selected.referenceFree_body (normalization.referenceFree_bodies plain.2))
      (by simpa only [Environment.prepare_loans] using consumedEmpty)
    obtain ⟨trace, cleaned⟩ := cleanup
    exact empty_of_length_le (Nat.le_of_eq cleaned.loans_length) localEmpty
  | nil => rename_i plain empty; exact empty
  | cons _ _ _ first rest => rename_i plain empty; exact rest plain.2 (first plain.1 empty)
  | wildcard | binder | node | constantValue | patternsNil | patternsCons | armsNil | armsCons => trivial

/-- Prior-source conservation with no post-execution restriction among premises.
The syntax and declaration boundary produces the empty-history fact consumed
by actual evaluator transport. Open vacant cells and hidden caller stores need
no stronger condition than the pre-existing logical agreement relation. -/

theorem Evaluates.referenceFree_source_agreement {left right after : Environment} {core : Core} {value : Value}
    (evaluated : Evaluates program left core value after)
    (declarations : program.ReferenceFree) (source : core.source.ReferenceFree)
    (leftEmpty : left.loans = []) (rightEmpty : right.loans = []) (same : left.Agrees right) :
    value.ReferenceFree ∧ ∃ other, Evaluates program right core value other ∧ after.Agrees other ∧
      other.loans = [] ∧ left.Evolution after ∧ right.Evolution other :=
  evaluated.referenceFree_agreement rightEmpty same (evaluated.empty_of_referenceFree declarations source leftEmpty)

theorem Evaluates.dereference_copies {before after : Environment} {reference : Place} {fields : List FieldKey} {value : Value}
    (evaluated : Evaluates program before ⟨.dereference reference fields, .leaf⟩ value after) :
    ∃ access resident, before.resolveAccess program (.dereference reference fields) = some access ∧
      before.readAddress access.address = some resident ∧ before.ResultUsable resident ∧
      Environment.Copies before resident value after ∧ before.SameStorage after ∧ after.ResultUsable value := by
  cases evaluated with
  | dereference resolved _ _ _ _ selected usable copied =>
    exact ⟨_, _, resolved, selected, usable, copied, copied.storage, copied.result_usable usable⟩

theorem Evaluates.assignIndirect_in_place {before after : Environment} {reference : Place} {fields : List FieldKey}
    {expression rest : Expr} {expressionPlan restPlan : CorePlan} {value : Value}
    (evaluated : Evaluates program before ⟨.assignIndirect reference fields expression rest, .binary expressionPlan restPlan⟩ value after) :
    ∃ middle disposed updated access resident old,
      Evaluates program before ⟨expression, expressionPlan⟩ resident middle ∧
      middle.resolveAccess program (.dereference reference fields) = some access ∧
      middle.at access.address = some old ∧ Environment.Disposes program middle old disposed ∧
      middle.SameStorage disposed ∧ disposed.at access.address = some old ∧
      old.Destroys program old.destructionTrace .vacant ∧ disposed.ResultUsable resident ∧
      disposed.writeAddress access.address resident = some updated ∧
      Evaluates program updated ⟨rest, restPlan⟩ value after := by
  cases evaluated with
  | assignIndirect initial resolved _ _ _ previous dispose usable written continued =>
    exact ⟨_, _, _, _, _, _, initial, resolved, previous, dispose, dispose.storage,
      by simpa only [Environment.at, dispose.storage.store] using previous,
      dispose.logical, usable, written, continued⟩

theorem Environment.CarrierPermits.unique_apart {program : Program} {environment : Environment}
    {reference : Place} {fields : List FieldKey} {address : Address} {node : Nat} {loan : Loan}
    (permitted : environment.CarrierPermits program .unique (.dereference reference fields))
    (resolved : environment.resolvePlace program reference = some address)
    (found : environment.loans[node]? = some loan) (own : loan.own = true) : address.Apart loan.target := by
  obtain ⟨carrier, selected, allowed⟩ := permitted
  cases Option.some.inj (resolved.symm.trans selected)
  rcases allowed node loan found own with ⟨impossible, _⟩ | ⟨_, impossible, _⟩ | apart
  · cases impossible
  · cases impossible
  · exact apart

theorem Evaluates.endOwn_transparent {before after : Environment} {expression : Expr} {plan : CorePlan}
    {slot : Nat} {value : Value} {fields : List Nat}
    (evaluated : Evaluates program before ⟨expression, .endOwn slot plan fields⟩ value after) :
    ∃ ended, before.SameStorage ended ∧ Evaluates program ended ⟨expression, plan⟩ value after := by
  cases evaluated with
  | endOwn ended continued => exact ⟨_, Environment.endSlot_storage ended, continued⟩

theorem Evaluates.endAfter_transparent {before after : Environment} {expression : Expr} {plan : CorePlan}
    {slot : Nat} {value : Value} {fields : List Nat}
    (evaluated : Evaluates program before ⟨expression, .endAfter slot plan fields⟩ value after) :
    ∃ middle, Evaluates program before ⟨expression, plan⟩ value middle ∧ middle.SameStorage after ∧ after.ResultUsable value := by
  cases evaluated with
  | endAfter body ended usable => exact ⟨_, body, Environment.endSlot_storage ended, usable⟩

end Grounded

/- Section: ElaborationData -/
namespace Grounded.Elaboration
set_option autoImplicit false

inductive Phase where
  | checking
  | executable
  deriving DecidableEq

def Actual (phase : Phase) (type : Type) : Type :=
  match phase with
  | .checking => PUnit
  | .executable => type

/-- Only external resource obligations are phase-specific. Ordinary typing and
local resource checks remain premises of the common elaboration constructor. -/
def Required (phase : Phase) (condition : phase = .executable → Prop) : Prop :=
  ∀ executable, condition executable

structure Symbols where
  reference : Checked.Reference → Nat
  binder : Nat → Nat

mutual
/-- A masked interpretation relates the chosen symbolic payload product to the
canonical source product. It never asserts runtime existence or usable Own. -/
inductive PayloadMeaning (program : Program) (symbols : Symbols) :
    Initialization → Checked.Payload → Ty → SourcePayload → Prop where
  | vacant {payload : Checked.Payload} {type : Ty} :
      PayloadMeaning program symbols .vacant payload type .plain
  | plain {state : Initialization} {type : Ty}
      (free : ReferenceFreeLayout program.target program.data type) :
      PayloadMeaning program symbols state .plain type .plain
  | reference {state : Initialization} (reference : Checked.Reference) (referent : Ty) (mode : BorrowMode) :
      PayloadMeaning program symbols state (.reference reference referent mode)
        (.reference referent mode) (.reference (symbols.reference reference))
  | aggregate {state : Initialization} {head : Head} {payloads : List Checked.Payload}
      {type : Ty} {types : List Ty} {concrete : List SourcePayload}
      (source : head.Source) (shape : HeadType program head type types)
      (fields : PayloadMeanings program symbols state.child payloads types concrete) :
      PayloadMeaning program symbols state (.aggregate head payloads) type (.aggregate head concrete)
  | schemaPlain {state : Initialization} {owner : Nat} {path : List Checked.Component}
      {type : Ty} {copies : List Nat} {knowledge : Checked.SchemaKnowledge}
      (known : knowledge = .referenceFree ∨ ReferenceFreeLayout program.target program.data type)
      (notHandle : state.Complete → ∀ referent mode, type ≠ .reference referent mode) :
      PayloadMeaning program symbols state (.schema owner path type copies knowledge) type .plain
  | schemaReference {state : Initialization} {owner : Nat} {path : List Checked.Component}
      {referent : Ty} {mode : BorrowMode} {copies : List Nat} :
      PayloadMeaning program symbols state (.schema owner path (.reference referent mode) copies .unknown)
        (.reference referent mode)
        (.reference (symbols.reference ((Checked.Reference.parameter owner path).rename copies)))
  | schemaAggregate {state : Initialization} {owner : Nat} {path : List Checked.Component}
      {type : Ty} {copies : List Nat} {head : Head} {types : List Ty} {concrete : List SourcePayload}
      (source : head.Source) (shape : HeadType program head type types)
      (fields : PayloadMeanings program symbols state.child
        (types.zipIdx.map fun entry => Checked.Payload.input owner
          (path ++ [.constructor head, .field entry.2]) entry.1 copies) types concrete) :
      PayloadMeaning program symbols state (.schema owner path type copies) type (.aggregate head concrete)
inductive PayloadMeanings (program : Program) (symbols : Symbols) :
    (Nat → Initialization) → List Checked.Payload → List Ty → List SourcePayload → Prop where
  | nil (states : Nat → Initialization) : PayloadMeanings program symbols states [] [] []
  | cons {states : Nat → Initialization} {payload : Checked.Payload} {payloads : List Checked.Payload}
      {type : Ty} {types : List Ty} {concrete : SourcePayload} {concretes : List SourcePayload}
      (head : PayloadMeaning program symbols (states 0) payload type concrete)
      (tail : PayloadMeanings program symbols (fun index => states (index + 1)) payloads types concretes) :
      PayloadMeanings program symbols states (payload :: payloads) (type :: types) (concrete :: concretes)
end

/-- Opaque referent views are not additional authoritative owner cells. -/
def Symbols.base (symbols : Symbols) : Checked.Base → Option OriginBase
  | .binder identity => some (.binder (symbols.binder identity))
  | .referent _ => none

/-- An opaque referent may itself begin at a subaddress. Its prefix is retained. -/
def Symbols.address (symbols : Symbols) (context : Grounded.Context)
    (address : Checked.Address) : Option Origin :=
  match address.base with
  | .binder identity => some ⟨.binder (symbols.binder identity), address.fields⟩
  | .referent reference =>
      (context.loans[symbols.reference reference]?).map (fun loan => loan.target.extend address.fields)

/-- A root identity remains represented while its cell or a retained loan target
mentions it. Reference aliases do not introduce a second identity. -/
def _root_.Grounded.Checked.Context.RootRepresented (checked : Checked.Context) (identity : Nat) : Prop :=
  (∃ slot, checked.storage (.binder identity) = some slot) ∨
    ∃ loan ∈ checked.loans, loan.target.base = .binder identity

structure ContextMeaning (program : Program) (symbols : Symbols)
    (checked : Checked.Context) (concrete : Grounded.Context) : Prop where
  names : concrete.names = checked.names.map (fun entry => (entry.1, symbols.binder entry.2))
  binders : concrete.nextBinder = symbols.binder checked.nextBinder
  cells : ∀ base slot actualBase, checked.storage base = some slot →
    symbols.base base = some actualBase →
    ∃ actual, concrete.storage actualBase = some actual ∧ actual.type = slot.type ∧
      actual.mutable = slot.mutable ∧ actual.binder = symbols.binder slot.binder ∧
      actual.initialization = slot.initialization ∧
      PayloadMeaning program symbols slot.initialization slot.payload slot.type actual.payload
  /-- Executable references are lenses into binder cells, never mask caches. -/
  noOpaqueCells : ∀ reference, checked.storage (.referent reference) = none
  /-- Every existing source root is represented, including hidden roots. -/
  rootCoverage : ∀ binder slot, concrete.storage (.binder binder) = some slot →
    ∃ identity cell, checked.storage (.binder identity) = some cell ∧ symbols.binder identity = binder
  /-- Injectivity concerns represented roots, including historical loan targets,
  not references or their potentially aliased target paths. -/
  rootIdentity : ∀ first second, checked.RootRepresented first → checked.RootRepresented second →
    symbols.binder first = symbols.binder second → first = second
  loans : ∀ loan ∈ checked.loans, ∃ actual,
    concrete.loans[symbols.reference loan.reference]? = some actual ∧
      symbols.address concrete loan.target = some actual.target ∧
      actual.referent = loan.referent ∧ actual.mode = loan.mode ∧
      actual.parent = loan.parent.map symbols.reference ∧
      (actual.own = true ↔ checked.NotEnded (program := program) loan.reference)

structure Meaning (program : Program) (checked : Checked.Context) where
  context : Grounded.Context
  symbols : Symbols
  related : ContextMeaning program symbols checked context

structure Point (program : Program) (phase : Phase) where
  checked : Checked.Context
  meaning : Actual phase (Meaning program checked)

structure Payload (phase : Phase) where
  checked : Checked.Payload
  meaning : Actual phase SourcePayload

structure Result (phase : Phase) where
  type : Ty
  payload : Payload phase

def Point.source {program : Program} {phase : Phase} (point : Point program phase)
    (executable : phase = .executable) : Grounded.Context := by
  cases executable
  exact point.meaning.context

def Point.symbols {program : Program} {phase : Phase} (point : Point program phase)
    (executable : phase = .executable) : Symbols := by
  cases executable
  exact point.meaning.symbols

def Payload.source {phase : Phase} (payload : Payload phase)
    (executable : phase = .executable) : SourcePayload :=
  match phase, executable, payload.meaning with
  | .executable, rfl, meaning => meaning

def Result.checked {phase : Phase} (result : Result phase) : Checked.Result :=
  ⟨result.type, result.payload.checked⟩

def Result.source {phase : Phase} (result : Result phase) (executable : phase = .executable) : ResultType :=
  ⟨result.type, result.payload.source executable⟩

def Result.Interpreted {program : Program} {phase : Phase}
    (point : Point program phase) (result : Result phase) : Prop :=
  Required phase fun executable => PayloadMeaning program (point.symbols executable)
    .full result.payload.checked result.type (result.payload.source executable)

def Point.erase {program : Program} {phase : Phase} (point : Point program phase) : Point program .checking :=
  ⟨point.checked, PUnit.unit⟩

def Payload.erase {phase : Phase} (payload : Payload phase) : Payload .checking :=
  ⟨payload.checked, PUnit.unit⟩

def Result.erase {phase : Phase} (result : Result phase) : Result .checking :=
  ⟨result.type, result.payload.erase⟩

@[simp] theorem Point.erase_checked {program : Program} {phase : Phase} (point : Point program phase) :
    point.erase.checked = point.checked := rfl

@[simp] theorem Result.erase_checked {phase : Phase} (result : Result phase) :
    result.erase.checked = result.checked := rfl

end Grounded.Elaboration

/- Section: CheckedTransitions -/
namespace Grounded.Checked
set_option autoImplicit false
variable {program : Program}

/-- Positional resource projection uses the same product and declared heads as
ordinary field selection. It also supplies compiler-internal ending metadata. -/
inductive Payload.At (program : Program) : Payload → Ty → List Nat → Payload → Ty → Type where
  | here (payload : Payload) (type : Ty) : At program payload type [] payload type
  | aggregate {head : Head} {fields : List Payload} {type child target : Ty}
      {types : List Ty} {index : Nat} {indices : List Nat} {field result : Payload}
      (source : head.Source) (shape : HeadType program head type types)
      (fieldType : types[index]? = some child) (found : fields[index]? = some field)
      (rest : At program field child indices result target) :
      At program (.aggregate head fields) type (index :: indices) result target
  | schema {owner : Nat} {path : List Component} {type child target : Ty}
      {copies : List Nat} {knowledge : SchemaKnowledge} {head : Head} {types : List Ty} {index : Nat}
      {indices : List Nat} {result : Payload}
      (source : head.Source) (shape : HeadType program head type types)
      (fieldType : types[index]? = some child)
      (rest : At program (Payload.input owner (path ++ [.constructor head, .field index]) child copies knowledge)
        child indices result target) :
      At program (.schema owner path type copies knowledge) type (index :: indices) result target
  | plain {type child target : Ty} {head : Head} {types : List Ty} {index : Nat}
      {indices : List Nat} {result : Payload}
      (free : ReferenceFreeLayout program.target program.data type)
      (source : head.Source) (shape : HeadType program head type types)
      (fieldType : types[index]? = some child)
      (rest : At program .plain child indices result target) :
      At program .plain type (index :: indices) result target

/-- Clearing a selected resident changes only that product coordinate. The
mask separately prevents a cleared plain fragment from becoming a result. -/
inductive Payload.Write (program : Program) :
    Payload → Ty → List Nat → Payload → Payload → Type where
  | here (before replacement : Payload) (type : Ty) :
      Write program before type [] replacement replacement
  | aggregate {head : Head} {fields : List Payload} {type child : Ty} {types : List Ty}
      {index : Nat} {indices : List Nat} {field replacement updated : Payload}
      (source : head.Source) (shape : HeadType program head type types)
      (fieldType : types[index]? = some child) (found : fields[index]? = some field)
      (rest : Write program field child indices replacement updated) :
      Write program (.aggregate head fields) type (index :: indices) replacement
        (.aggregate head (fields.set index updated))
  | schema {owner : Nat} {path : List Component} {type child : Ty} {copies : List Nat}
      {knowledge : SchemaKnowledge} {head : Head} {types : List Ty} {index : Nat} {indices : List Nat}
      {replacement updated : Payload}
      (source : head.Source) (shape : HeadType program head type types)
      (fieldType : types[index]? = some child)
      (rest : Write program (Payload.input owner (path ++ [.constructor head, .field index]) child copies knowledge)
        child indices replacement updated) :
      Write program (.schema owner path type copies knowledge) type (index :: indices) replacement
        (.aggregate head ((types.zipIdx.map fun entry => Payload.input owner
          (path ++ [.constructor head, .field entry.2]) entry.1 copies knowledge).set index updated))
  | plain {type child : Ty} {head : Head} {types : List Ty} {index : Nat} {indices : List Nat}
      {replacement updated : Payload}
      (free : ReferenceFreeLayout program.target program.data type)
      (source : head.Source) (shape : HeadType program head type types)
      (fieldType : types[index]? = some child)
      (rest : Write program .plain child indices replacement updated) :
      Write program .plain type (index :: indices) replacement
        (.aggregate head ((List.replicate types.length Payload.plain).set index updated))

def heldOccurs (held : List Payload) (reference : Reference) : Prop :=
  ∃ payload ∈ held, payload.Occurs program reference

def Context.LocalFree (context : Context) (target : Address) : Prop :=
  context.LocalPermits (program := program) .unique none target

def Context.LocalUnobserved (context : Context) (reference : Reference) : Prop :=
  ∀ loan ∈ context.loans, context.NotEnded (program := program) loan.reference →
    loan.reference ≠ reference → ∀ slot payload,
    context.storage loan.target.base = some slot →
    Nonempty (Payload.At program slot.payload slot.type loan.target.fields payload loan.referent) →
    ¬ payload.Occurs program reference

def Context.CanEnd (context : Context) (held : List Payload) (reference : Reference) : Prop :=
  ¬ heldOccurs (program := program) held reference ∧
    context.NotKnownUnrestored reference ∧ context.LocalUnobserved (program := program) reference

def Context.retire (context : Context) (count : Nat) : Context :=
  { context with
    names := context.names.drop count
    storage := fun base =>
      if base ∈ (context.names.take count).map (fun entry => Base.binder entry.2)
      then none else context.storage base }

def Context.prepare : List (String × BindingType) → List Result → Context → Context
  | (name, parameter) :: parameters, result :: results, context =>
      Context.prepare parameters results (context.bind name parameter.mutable result)
  | _, _, context => context

end Grounded.Checked

/- Section: ElaborationProducts -/
namespace Grounded.Elaboration
set_option autoImplicit false

namespace Payload

def plain (phase : Phase) : Payload phase :=
  ⟨.plain, match phase with | .checking => PUnit.unit | .executable => SourcePayload.plain⟩

def aggregate {phase : Phase} (head : Head) (fields : List (Payload phase)) : Payload phase :=
  ⟨.aggregate head (fields.map Payload.checked),
    match phase, fields with
    | .checking, _ => PUnit.unit
    | .executable, fields => SourcePayload.aggregate head (fields.map (fun field => field.source rfl))⟩

@[simp] theorem plain_checked (phase : Phase) : (plain phase).checked = .plain := rfl
@[simp] theorem plain_source : (plain .executable).source rfl = SourcePayload.plain := rfl
@[simp] theorem aggregate_checked {phase : Phase} (head : Head) (fields : List (Payload phase)) :
    (aggregate head fields).checked = .aggregate head (fields.map Payload.checked) := rfl
@[simp] theorem aggregate_source (head : Head) (fields : List (Payload .executable)) :
    (aggregate head fields).source rfl = .aggregate head (fields.map (fun field => field.source rfl)) := rfl

end Payload

def Result.data (phase : Phase) (type : Ty) : Result phase := ⟨type, .plain phase⟩

def sourcePayloads {phase : Phase} (held : List (Payload phase))
    (executable : phase = .executable) : List SourcePayload := held.map (fun payload => payload.source executable)

def checkedPayloads {phase : Phase} (held : List (Payload phase)) : List Checked.Payload :=
  held.map Payload.checked

def sourceResults {phase : Phase} (results : List (Result phase))
    (executable : phase = .executable) : List ResultType := results.map (fun result => result.source executable)

def checkedResults {phase : Phase} (results : List (Result phase)) : List Checked.Result :=
  results.map Result.checked

@[simp] theorem sourcePayloads_append {phase : Phase} (left right : List (Payload phase))
    (executable : phase = .executable) :
    sourcePayloads (left ++ right) executable = sourcePayloads left executable ++ sourcePayloads right executable :=
  List.map_append

@[simp] theorem sourcePayloads_cons {phase : Phase} (first : Payload phase) (rest : List (Payload phase))
    (executable : phase = .executable) :
    sourcePayloads (first :: rest) executable = first.source executable :: sourcePayloads rest executable := rfl

@[simp] theorem sourcePayloads_nil {phase : Phase} (executable : phase = .executable) :
    sourcePayloads ([] : List (Payload phase)) executable = [] := rfl

@[simp] theorem Result.data_source (type : Ty) :
    (Result.data .executable type).source rfl = ⟨type, .plain⟩ := rfl

/-- Common typing is independent of actual world existence. Resource realization
is a separate phase-specific obligation of the same selected product. -/
def Result.Checked {phase : Phase} (program : Program) (result : Result phase) : Prop :=
  result.payload.checked.Typed program result.type

mutual
inductive Payload.NoHandles : Checked.Payload → Prop where
  | plain : Payload.NoHandles .plain
  | aggregate {head : Head} {fields : List Checked.Payload} (children : PayloadsNoHandles fields) :
      Payload.NoHandles (.aggregate head fields)
  | schema (owner : Nat) (path : List Checked.Component) (type : Ty) (copies : List Nat) :
      Payload.NoHandles (.schema owner path type copies .referenceFree)
inductive PayloadsNoHandles : List Checked.Payload → Prop where
  | nil : PayloadsNoHandles []
  | cons {head : Checked.Payload} {tail : List Checked.Payload}
      (first : Payload.NoHandles head) (rest : PayloadsNoHandles tail) : PayloadsNoHandles (head :: tail)
end

end Grounded.Elaboration

/- Section: ElaborationMeaning -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {symbols : Symbols}

/-- Source constructor products cannot inhabit a reference type. -/
theorem source_head_not_reference {head : Head} {type : Ty} {types : List Ty}
    (source : head.Source) (shape : HeadType program head type types)
    (referent : Ty) (mode : BorrowMode) : type ≠ .reference referent mode := by
  intro equal
  subst type
  cases shape
  exact source

/-- A complete explicit reference product fixes the actual handle number. -/
theorem PayloadMeaning.reference_full {reference : Checked.Reference} {referent : Ty}
    {mode : BorrowMode} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols .full (.reference reference referent mode)
      (.reference referent mode) concrete) :
    concrete = .reference (symbols.reference reference) := by
  cases meaning
  rfl

/-- Complete reference-typed schemas also expose an explicit symbolic identity. -/
theorem PayloadMeaning.full_reference_inv {payload : Checked.Payload} {referent : Ty}
    {mode : BorrowMode} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols .full payload (.reference referent mode) concrete) :
    ∃ reference, payload.Occurs program reference ∧ concrete = .reference (symbols.reference reference) := by
  cases meaning with
  | plain free => cases free
  | reference reference referent mode => exact ⟨reference, .reference .., rfl⟩
  | aggregate source shape fields => exact False.elim (source_head_not_reference source shape _ _ rfl)
  | schemaPlain _ notHandle => exact False.elim (notHandle .full _ _ rfl)
  | schemaReference => exact ⟨_, .schema (.here _ _), by simp⟩
  | schemaAggregate source shape fields => exact False.elim (source_head_not_reference source shape _ _ rfl)

theorem PayloadMeaning.aggregate_source {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {head : Head} {fields : List SourcePayload}
    (meaning : PayloadMeaning program symbols state payload type (.aggregate head fields)) : head.Source := by
  cases meaning with
  | aggregate source _ _ | schemaAggregate source _ _ => exact source

mutual
/-- Only leaves selected by this exact meaning are active. A schema's dormant
constructor alternatives are deliberately absent from this relation. -/
inductive PayloadMeaning.Active :
    {state : Initialization} → {payload : Checked.Payload} → {type : Ty} → {concrete : SourcePayload} →
    PayloadMeaning program symbols state payload type concrete → Checked.Reference → Prop where
  | reference {state : Initialization} (reference : Checked.Reference) (referent : Ty) (mode : BorrowMode) :
      PayloadMeaning.Active (PayloadMeaning.reference (state := state) reference referent mode) reference
  | aggregate {state : Initialization} {head : Head} {payloads : List Checked.Payload}
      {type : Ty} {types : List Ty} {concrete : List SourcePayload} {reference : Checked.Reference}
      {source : head.Source} {shape : HeadType program head type types}
      {fields : PayloadMeanings program symbols state.child payloads types concrete}
      (active : PayloadMeanings.Active fields reference) :
      PayloadMeaning.Active (PayloadMeaning.aggregate source shape fields) reference
  | schemaReference {state : Initialization} {owner : Nat} {path : List Checked.Component}
      {referent : Ty} {mode : BorrowMode} {copies : List Nat} :
      PayloadMeaning.Active (PayloadMeaning.schemaReference (state := state) (owner := owner) (path := path)
        (referent := referent) (mode := mode) (copies := copies))
        ((Checked.Reference.parameter owner path).rename copies)
  | schemaAggregate {state : Initialization} {owner : Nat} {path : List Checked.Component}
      {type : Ty} {copies : List Nat} {head : Head} {types : List Ty} {concrete : List SourcePayload}
      {reference : Checked.Reference} {source : head.Source} {shape : HeadType program head type types}
      {fields : PayloadMeanings program symbols state.child
        (types.zipIdx.map fun entry => Checked.Payload.input owner
          (path ++ [.constructor head, .field entry.2]) entry.1 copies) types concrete}
      (active : PayloadMeanings.Active fields reference) :
      PayloadMeaning.Active (PayloadMeaning.schemaAggregate source shape fields) reference
inductive PayloadMeanings.Active :
    {states : Nat → Initialization} → {payloads : List Checked.Payload} → {types : List Ty} →
    {concretes : List SourcePayload} →
    PayloadMeanings program symbols states payloads types concretes → Checked.Reference → Prop where
  | head {states : Nat → Initialization} {payload : Checked.Payload} {payloads : List Checked.Payload}
      {type : Ty} {types : List Ty} {concrete : SourcePayload} {concretes : List SourcePayload}
      {first : PayloadMeaning program symbols (states 0) payload type concrete}
      {rest : PayloadMeanings program symbols (fun index => states (index + 1)) payloads types concretes}
      {reference : Checked.Reference} (active : PayloadMeaning.Active first reference) :
      PayloadMeanings.Active (PayloadMeanings.cons first rest) reference
  | tail {states : Nat → Initialization} {payload : Checked.Payload} {payloads : List Checked.Payload}
      {type : Ty} {types : List Ty} {concrete : SourcePayload} {concretes : List SourcePayload}
      {first : PayloadMeaning program symbols (states 0) payload type concrete}
      {rest : PayloadMeanings program symbols (fun index => states (index + 1)) payloads types concretes}
      {reference : Checked.Reference} (active : PayloadMeanings.Active rest reference) :
      PayloadMeanings.Active (PayloadMeanings.cons first rest) reference
end

mutual
theorem PayloadMeaning.active_node {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols state payload type concrete) {node : Nat}
    (member : node ∈ concrete.nodes) :
    ∃ reference, meaning.Active reference ∧ symbols.reference reference = node := by
  cases meaning with
  | vacant | plain | schemaPlain => simp [SourcePayload.nodes] at member
  | reference reference referent mode =>
      simp only [SourcePayload.nodes, List.mem_singleton] at member
      exact ⟨reference, .reference .., member.symm⟩
  | aggregate source shape fields =>
      obtain ⟨reference, active, equal⟩ := fields.active_node member
      exact ⟨reference, .aggregate (source := source) (shape := shape) active, equal⟩
  | schemaReference =>
      simp only [SourcePayload.nodes, List.mem_singleton] at member
      exact ⟨_, .schemaReference, member.symm⟩
  | schemaAggregate source shape fields =>
      obtain ⟨reference, active, equal⟩ := fields.active_node member
      exact ⟨reference, .schemaAggregate (source := source) (shape := shape) active, equal⟩
theorem PayloadMeanings.active_node {states : Nat → Initialization} {payloads : List Checked.Payload}
    {types : List Ty} {concretes : List SourcePayload}
    (meaning : PayloadMeanings program symbols states payloads types concretes) {node : Nat}
    (member : node ∈ payloadNodes concretes) :
    ∃ reference, meaning.Active reference ∧ symbols.reference reference = node := by
  cases meaning with
  | nil => simp [payloadNodes] at member
  | cons first rest =>
      rcases List.mem_append.mp member with member | member
      · obtain ⟨reference, active, equal⟩ := first.active_node member
        exact ⟨reference, .head (rest := rest) active, equal⟩
      · obtain ⟨reference, active, equal⟩ := rest.active_node member
        exact ⟨reference, .tail (first := first) active, equal⟩
end

theorem PayloadMeaning.Active.node {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload} {meaning : PayloadMeaning program symbols state payload type concrete}
    {reference : Checked.Reference} (active : meaning.Active reference) :
    symbols.reference reference ∈ concrete.nodes := by
  induction active using PayloadMeaning.Active.rec
    (motive_2 := fun {_ _ _ concretes} _ reference _ => symbols.reference reference ∈ payloadNodes concretes) with
  | reference | schemaReference => exact List.mem_singleton_self _
  | aggregate _ ih | schemaAggregate _ ih => exact ih
  | head _ ih => exact List.mem_append_left _ ih
  | tail _ ih => exact List.mem_append_right _ ih

theorem PayloadMeanings.Active.node {states : Nat → Initialization} {payloads : List Checked.Payload}
    {types : List Ty} {concretes : List SourcePayload}
    {meaning : PayloadMeanings program symbols states payloads types concretes}
    {reference : Checked.Reference} (active : meaning.Active reference) :
    symbols.reference reference ∈ payloadNodes concretes := by
  induction active using PayloadMeanings.Active.rec
    (motive_1 := fun {_ _ _ concrete} _ reference _ => symbols.reference reference ∈ concrete.nodes) with
  | reference | schemaReference => exact List.mem_singleton_self _
  | aggregate _ ih | schemaAggregate _ ih => exact ih
  | head _ ih => exact List.mem_append_left _ ih
  | tail _ ih => exact List.mem_append_right _ ih

theorem input_occurs_path {owner : Nat} {path : List Checked.Component} {type : Ty}
    {copies : List Nat} {knowledge : Checked.SchemaKnowledge} {reference : Checked.Reference}
    (occurs : (Checked.Payload.input owner path type copies knowledge).Occurs program reference) :
    ∃ suffix referent mode, Checked.ReferencePath program type suffix referent mode ∧
      reference = (Checked.Reference.parameter owner (path ++ suffix)).rename copies := by
  cases type <;> simp only [Checked.Payload.input] at occurs
  all_goals cases occurs
  all_goals first
    | exact ⟨[], _, _, .here .., by simp⟩
    | exact ⟨_, _, _, by assumption, rfl⟩

theorem schema_child_occurs {owner : Nat} {path : List Checked.Component} {type : Ty}
    {copies : List Nat} {knowledge : Checked.SchemaKnowledge}
    {head : Head} {types : List Ty} {reference : Checked.Reference}
    (source : head.Source) (shape : HeadType program head type types)
    (selected : ∃ payload ∈ (types.zipIdx.map fun entry => Checked.Payload.input owner
      (path ++ [.constructor head, .field entry.2]) entry.1 copies knowledge), payload.Occurs program reference) :
    (Checked.Payload.schema owner path type copies knowledge).Occurs program reference := by
  obtain ⟨payload, member, occurs⟩ := selected
  obtain ⟨⟨child, index⟩, entryMember, equal⟩ := List.mem_map.mp member
  subst payload
  obtain ⟨_, bound, equal⟩ := List.mem_zipIdx entryMember
  simp only [Nat.zero_add, Nat.sub_zero] at bound equal
  have found : types[index]? = some child := List.getElem?_eq_some_iff.mpr ⟨bound, equal.symm⟩
  obtain ⟨suffix, referent, mode, nested, equal⟩ := input_occurs_path occurs
  subst reference
  simpa only [List.append_assoc, List.cons_append, List.nil_append] using
    (Checked.Payload.Occurs.schema (path := path) (copies := copies)
      (Checked.ReferencePath.child source shape found nested))

theorem PayloadMeaning.Active.occurs {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload} {meaning : PayloadMeaning program symbols state payload type concrete}
    {reference : Checked.Reference} (active : meaning.Active reference) : payload.Occurs program reference := by
  induction active using PayloadMeaning.Active.rec
    (motive_2 := fun {_ payloads _ _} _ reference _ =>
      ∃ payload ∈ payloads, payload.Occurs program reference) with
  | reference => exact .reference ..
  | aggregate active ih =>
      obtain ⟨payload, selected, nested⟩ := ih
      exact .child selected nested
  | schemaReference => simpa using (Checked.Payload.Occurs.schema (Checked.ReferencePath.here _ _))
  | @schemaAggregate state owner path type copies head types concrete reference source shape fields active ih =>
      exact schema_child_occurs source shape ih
  | head active ih => exact ⟨_, List.mem_cons_self, ih⟩
  | tail active ih =>
      obtain ⟨payload, selected, nested⟩ := ih
      exact ⟨payload, List.mem_cons_of_mem _ selected, nested⟩

theorem PayloadMeaning.node_mapped {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols state payload type concrete) {node : Nat}
    (member : node ∈ concrete.nodes) :
    ∃ reference, payload.Occurs program reference ∧ symbols.reference reference = node := by
  obtain ⟨reference, active, mapped⟩ := meaning.active_node member
  exact ⟨reference, active.occurs, mapped⟩

/-- The exact own/ended obligation is over realized leaves, not all possible
schema alternatives. It is independent of target restoration. -/
def PayloadMeaning.OwnCoupled {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols state payload type concrete)
    (checked : Checked.Context) (source : Grounded.Context) : Prop :=
  ∀ reference, meaning.Active reference →
    (source.Own (symbols.reference reference) ↔ checked.NotEnded (program := program) reference)

/-- A retained plain source product has no active leaves, even when its checked
schema still has hypothetical reference paths. -/
theorem PayloadMeaning.plain_no_active {state : Initialization} {payload : Checked.Payload} {type : Ty}
    (meaning : PayloadMeaning program symbols state payload type .plain)
    (reference : Checked.Reference) : ¬ meaning.Active reference := by
  intro active
  exact List.not_mem_nil active.node

/-- Retained reference-free knowledge fixes the actual source subtree to plain;
it makes no assertion that hypothetical schema occurrences disappear. -/
theorem PayloadMeaning.schema_referenceFree_plain {state : Initialization} {owner : Nat}
    {path : List Checked.Component} {type : Ty} {copies : List Nat} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols state
      (.schema owner path type copies .referenceFree) type concrete) : concrete = .plain := by
  cases meaning <;> rfl

theorem PayloadMeaning.schema_referenceFree_no_active {state : Initialization} {owner : Nat}
    {path : List Checked.Component} {type : Ty} {copies : List Nat} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols state
      (.schema owner path type copies .referenceFree) type concrete)
    (reference : Checked.Reference) : ¬ meaning.Active reference := by
  have plain := meaning.schema_referenceFree_plain
  subst concrete
  exact meaning.plain_no_active reference

theorem PayloadMeaning.OwnCoupled.of_plain {state : Initialization} {payload : Checked.Payload} {type : Ty}
    (meaning : PayloadMeaning program symbols state payload type .plain)
    (checked : Checked.Context) (source : Grounded.Context) : meaning.OwnCoupled checked source :=
  fun reference active => False.elim (meaning.plain_no_active reference active)

theorem PayloadMeaning.OwnCoupled.own {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload} {meaning : PayloadMeaning program symbols state payload type concrete}
    {checked : Checked.Context} {source : Grounded.Context}
    (coupled : meaning.OwnCoupled checked source) (available : checked.Available (program := program) payload)
    {node : Nat} (member : node ∈ concrete.nodes) : source.Own node := by
  obtain ⟨reference, active, mapped⟩ := meaning.active_node member
  exact mapped ▸ (coupled reference active).mpr (available reference active.occurs)

theorem PayloadMeaning.OwnCoupled.available {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload} {meaning : PayloadMeaning program symbols state payload type concrete}
    {checked : Checked.Context} {source : Grounded.Context}
    (coupled : meaning.OwnCoupled checked source) (available : checked.Available (program := program) payload)
    (restored : ∀ node ∈ concrete.nodes, source.Restored node) : source.PayloadAvailable concrete :=
  fun node member => ⟨coupled.own available member, restored node member⟩

theorem ContextMeaning.loan_own {checked : Checked.Context} {source : Grounded.Context}
    (meaning : ContextMeaning program symbols checked source) {loan : Checked.Loan}
    (member : loan ∈ checked.loans) :
    source.Own (symbols.reference loan.reference) ↔ checked.NotEnded (program := program) loan.reference := by
  obtain ⟨actual, found, _, _, _, _, coupled⟩ := meaning.loans loan member
  constructor
  · rintro ⟨other, stored, own⟩
    cases Option.some.inj (found.symm.trans stored)
    exact coupled.mp own
  · intro available
    exact ⟨actual, found, coupled.mpr available⟩

/-- Source parameter schemas and locally created identities share the checking
stamp supply. Fresh schema meanings can be assigned at their introducing step. -/
def ReferenceEstablished (supply : Nat) : Checked.Reference → Prop
  | .existing _ => True
  | .parameter owner _ => owner < supply
  | .borrowed identity => identity < supply
  | .copied identity parent => identity < supply ∧ ReferenceEstablished supply parent

theorem ReferenceEstablished.mono {before after : Nat} (growth : before ≤ after)
    {reference : Checked.Reference} (established : ReferenceEstablished before reference) :
    ReferenceEstablished after reference := by
  induction reference with
  | existing => trivial
  | parameter | borrowed => exact Nat.lt_of_lt_of_le established growth
  | copied identity parent ih => exact ⟨Nat.lt_of_lt_of_le established.1 growth, ih established.2⟩

/-- Point-to-point identity preservation. Aliased references retain their existing
canonical targets; only new local stamps may be remapped. -/
structure Symbols.Stable (checked : Checked.Context) (before after : Symbols) : Prop where
  reference : ∀ reference, ReferenceEstablished checked.nextSymbol reference →
    after.reference reference = before.reference reference
  binder : ∀ identity, identity < checked.nextBinder → after.binder identity = before.binder identity

theorem Symbols.Stable.refl (checked : Checked.Context) (symbols : Symbols) :
    Symbols.Stable checked symbols symbols := ⟨fun _ _ => rfl, fun _ _ => rfl⟩

theorem Symbols.Stable.trans {before middle : Checked.Context} {first second third : Symbols}
    (left : Symbols.Stable before first second) (right : Symbols.Stable middle second third)
    (symbols : before.nextSymbol ≤ middle.nextSymbol) (binders : before.nextBinder ≤ middle.nextBinder) :
    Symbols.Stable before first third := by
  refine ⟨?_, ?_⟩
  · intro reference established
    exact (right.reference reference (established.mono symbols)).trans (left.reference reference established)
  · intro identity established
    exact (right.binder identity (Nat.lt_of_lt_of_le established binders)).trans (left.binder identity established)

def PointsStable {phase : Phase} (before after : Point program phase) : Prop :=
  Required phase fun executable => Symbols.Stable before.checked
    (before.symbols executable) (after.symbols executable)

theorem PointsStable.refl {phase : Phase} (point : Point program phase) : PointsStable point point :=
  fun _ => Symbols.Stable.refl _ _

theorem PointsStable.trans {phase : Phase} {before middle after : Point program phase}
    (left : PointsStable before middle) (right : PointsStable middle after)
    (symbols : before.checked.nextSymbol ≤ middle.checked.nextSymbol)
    (binders : before.checked.nextBinder ≤ middle.checked.nextBinder) : PointsStable before after :=
  fun executable => (left executable).trans (right executable) symbols binders

theorem PointsStable.erase {phase : Phase} {before after : Point program phase} :
    PointsStable before.erase after.erase := by
  intro executable
  cases executable

mutual
/-- Transport uses only identities of realized leaves; no dormant schema map
agreement is required. -/
theorem PayloadMeaning.congr {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols state payload type concrete) {after : Symbols}
    (agrees : ∀ reference, meaning.Active reference → after.reference reference = symbols.reference reference) :
    PayloadMeaning program after state payload type concrete := by
  cases meaning with
  | vacant => exact .vacant
  | plain free => exact .plain free
  | reference reference referent mode =>
      simpa only [agrees reference (.reference ..)] using
        (PayloadMeaning.reference (symbols := after) (state := state) reference referent mode)
  | aggregate source shape fields =>
      exact .aggregate source shape (fields.congr fun reference active =>
        agrees reference (.aggregate (source := source) (shape := shape) active))
  | schemaPlain known notHandle => exact .schemaPlain known notHandle
  | @schemaReference state owner path referent mode copies =>
      simpa only [agrees _ .schemaReference] using
        (PayloadMeaning.schemaReference (symbols := after) (state := state) (owner := owner)
          (path := path) (referent := referent) (mode := mode) (copies := copies))
  | schemaAggregate source shape fields =>
      exact .schemaAggregate source shape (fields.congr fun reference active =>
        agrees reference (.schemaAggregate (source := source) (shape := shape) active))
theorem PayloadMeanings.congr {states : Nat → Initialization} {payloads : List Checked.Payload}
    {types : List Ty} {concretes : List SourcePayload}
    (meaning : PayloadMeanings program symbols states payloads types concretes) {after : Symbols}
    (agrees : ∀ reference, meaning.Active reference → after.reference reference = symbols.reference reference) :
    PayloadMeanings program after states payloads types concretes := by
  cases meaning with
  | nil => exact .nil _
  | cons first rest =>
      exact .cons
        (first.congr fun reference active => agrees reference (.head (rest := rest) active))
        (rest.congr fun reference active => agrees reference (.tail (first := first) active))
end

theorem Symbols.Stable.payload {checked : Checked.Context} {before after : Symbols}
    (stable : Symbols.Stable checked before after) {state : Initialization} {payload : Checked.Payload}
    {type : Ty} {concrete : SourcePayload}
    (meaning : PayloadMeaning program before state payload type concrete)
    (established : ∀ reference, meaning.Active reference → ReferenceEstablished checked.nextSymbol reference) :
    PayloadMeaning program after state payload type concrete :=
  meaning.congr fun reference active => stable.reference reference (established reference active)

/-- The source borrow constructor supplies the fresh node and its actual record.
There is no runtime allocation premise. -/
theorem source_borrow_fresh (context : Grounded.Context) (target : Origin) (referent : Ty)
    (parent : Option Nat) (mode : BorrowMode) :
    context.loans[context.loans.length]? = none ∧
    (context.borrow target referent parent mode).loans[context.loans.length]? =
      some ⟨target, referent, parent, true, mode⟩ :=
  ⟨by simp, Grounded.Context.borrow_last ..⟩

mutual
theorem source_copy_records {before after : Grounded.Context} {payload copied : SourcePayload}
    (copy : Grounded.Context.CopyPayload before payload copied after) :
    ∀ (node : Nat) (loan : SourceLoan), before.loans[node]? = some loan → after.loans[node]? = some loan := by
  cases copy with
  | plain => exact fun _ _ found => found
  | reference => exact fun _ _ found => Grounded.Context.borrow_found found
  | aggregate children => exact source_copies_records children
theorem source_copies_records {before after : Grounded.Context} {payloads copied : List SourcePayload}
    (copy : Grounded.Context.CopyPayloads before payloads copied after) :
    ∀ (node : Nat) (loan : SourceLoan), before.loans[node]? = some loan → after.loans[node]? = some loan := by
  cases copy with
  | nil => exact fun _ _ found => found
  | cons first rest => exact fun node loan found =>
      source_copies_records rest node loan (source_copy_records first node loan found)
end

mutual
/-- Every produced CopyPayload occurrence is newly allocated by the canonical
source traversal, including occurrences nested in schema-realized aggregates. -/
theorem source_copy_fresh {before after : Grounded.Context} {payload copied : SourcePayload}
    (copy : Grounded.Context.CopyPayload before payload copied after) :
    before.loans.length ≤ after.loans.length ∧
      ∀ node ∈ copied.nodes, before.loans.length ≤ node ∧ node < after.loans.length := by
  cases copy with
  | plain => exact ⟨Nat.le_refl _, by simp [SourcePayload.nodes]⟩
  | reference =>
      simp only [Grounded.Context.borrow, List.length_append, List.length_singleton,
        SourcePayload.nodes, List.mem_singleton]
      exact ⟨by omega, fun node equal => by subst node; exact ⟨Nat.le_refl _, by omega⟩⟩
  | aggregate children => exact source_copies_fresh children
theorem source_copies_fresh {before after : Grounded.Context} {payloads copied : List SourcePayload}
    (copy : Grounded.Context.CopyPayloads before payloads copied after) :
    before.loans.length ≤ after.loans.length ∧
      ∀ node ∈ payloadNodes copied, before.loans.length ≤ node ∧ node < after.loans.length := by
  cases copy with
  | nil => exact ⟨Nat.le_refl _, by simp [payloadNodes]⟩
  | cons first rest =>
      obtain ⟨firstGrowth, firstFresh⟩ := source_copy_fresh first
      obtain ⟨restGrowth, restFresh⟩ := source_copies_fresh rest
      refine ⟨Nat.le_trans firstGrowth restGrowth, ?_⟩
      intro node member
      rcases List.mem_append.mp member with member | member
      · obtain ⟨lower, upper⟩ := firstFresh node member
        exact ⟨lower, Nat.lt_of_lt_of_le upper restGrowth⟩
      · obtain ⟨lower, upper⟩ := restFresh node member
        exact ⟨Nat.le_trans firstGrowth lower, upper⟩
end

mutual
theorem source_copy_own {before after : Grounded.Context} {payload copied : SourcePayload}
    (copy : Grounded.Context.CopyPayload before payload copied after) :
    ∀ node ∈ copied.nodes, after.Own node := by
  cases copy with
  | plain => simp [SourcePayload.nodes]
  | reference =>
      intro node member
      simp only [SourcePayload.nodes, List.mem_singleton] at member
      subst node
      exact ⟨_, Grounded.Context.borrow_last .., rfl⟩
  | aggregate children => exact source_copies_own children
theorem source_copies_own {before after : Grounded.Context} {payloads copied : List SourcePayload}
    (copy : Grounded.Context.CopyPayloads before payloads copied after) :
    ∀ node ∈ payloadNodes copied, after.Own node := by
  cases copy with
  | nil => simp [payloadNodes]
  | cons first rest =>
      intro node member
      rcases List.mem_append.mp member with member | member
      · obtain ⟨loan, found, own⟩ := source_copy_own first node member
        exact ⟨loan, source_copies_records rest node loan found, own⟩
      · exact source_copies_own rest node member
end

theorem copied_symbol_fresh {before after : Grounded.Context} {payload copied : SourcePayload}
    (copy : Grounded.Context.CopyPayload before payload copied after)
    {state : Initialization} {checked : Checked.Payload} {type : Ty}
    {meaning : PayloadMeaning program symbols state checked type copied} {reference : Checked.Reference}
    (active : meaning.Active reference) :
    before.loans.length ≤ symbols.reference reference ∧
      symbols.reference reference < after.loans.length ∧ after.Own (symbols.reference reference) :=
  ⟨(source_copy_fresh copy).2 _ active.node |>.1,
    (source_copy_fresh copy).2 _ active.node |>.2, source_copy_own copy _ active.node⟩

end Grounded.Elaboration


/- Section: CheckedCopy -/
namespace Grounded.Checked
set_option autoImplicit false

mutual
/-- Copy creates local symbolic child records together with the result product.
An opaque declared schema remains a batch: its concrete occurrences and aliases
are discharged by interpretation of the same batch, not invented loan nodes. -/
inductive CopyPayload : Context → Payload → Payload → Context → Type where
  | plain (context : Context) : CopyPayload context .plain .plain context
  | reference (context : Context) (parent : Reference) (referent : Ty) :
      CopyPayload context (.reference parent referent .shared)
        (.reference (.copied context.nextSymbol parent) referent .shared)
        { context with
          loans := context.loans ++ [⟨.copied context.nextSymbol parent,
            context.referenceTarget parent, referent, .shared, some parent⟩]
          nextSymbol := context.nextSymbol + 1 }
  | aggregate {before after : Context} {head : Head} {fields copied : List Payload}
      (source : head.Source) (children : CopyPayloads before fields copied after) :
      CopyPayload before (.aggregate head fields) (.aggregate head copied) after
  | schema (context : Context) (owner : Nat) (path : List Component) (type : Ty)
      (copies : List Nat) (knowledge : SchemaKnowledge) :
      CopyPayload context (.schema owner path type copies knowledge)
        (.schema owner path type (copies ++ [context.nextSymbol]) knowledge)
        context.advanceSymbol
inductive CopyPayloads : Context → List Payload → List Payload → Context → Type where
  | nil (context : Context) : CopyPayloads context [] [] context
  | cons {before middle after : Context} {field copied : Payload} {fields copies : List Payload}
      (first : CopyPayload before field copied middle) (rest : CopyPayloads middle fields copies after) :
      CopyPayloads before (field :: fields) (copied :: copies) after
end

mutual
theorem CopyPayload.supply {before after : Context} {payload copied : Payload}
    (copy : CopyPayload before payload copied after) : before.nextSymbol ≤ after.nextSymbol := by
  cases copy with
  | plain => exact Nat.le_refl _
  | reference => exact Nat.le_succ _
  | aggregate _ children => exact children.supply
  | schema => exact Nat.le_succ _
theorem CopyPayloads.supply {before after : Context} {payloads copied : List Payload}
    (copy : CopyPayloads before payloads copied after) : before.nextSymbol ≤ after.nextSymbol := by
  cases copy with
  | nil => exact Nat.le_refl _
  | cons first rest => exact Nat.le_trans first.supply rest.supply
end

mutual
theorem CopyPayload.fields {before after : Context} {payload copied : Payload}
    (copy : CopyPayload before payload copied after) :
    after.names = before.names ∧ after.storage = before.storage ∧
      after.ended = before.ended ∧ after.nextBinder = before.nextBinder := by
  cases copy with
  | plain => exact ⟨rfl, rfl, rfl, rfl⟩
  | reference => exact ⟨rfl, rfl, rfl, rfl⟩
  | aggregate _ children => exact children.fields
  | schema => exact ⟨rfl, rfl, rfl, rfl⟩
theorem CopyPayloads.fields {before after : Context} {payloads copied : List Payload}
    (copy : CopyPayloads before payloads copied after) :
    after.names = before.names ∧ after.storage = before.storage ∧
      after.ended = before.ended ∧ after.nextBinder = before.nextBinder := by
  cases copy with
  | nil => exact ⟨rfl, rfl, rfl, rfl⟩
  | cons first rest =>
      exact ⟨rest.fields.1.trans first.fields.1,
        rest.fields.2.1.trans first.fields.2.1,
        rest.fields.2.2.1.trans first.fields.2.2.1,
        rest.fields.2.2.2.trans first.fields.2.2.2⟩
end

end Grounded.Checked

/- Section: CheckedDisposal -/
namespace Grounded.Checked
set_option autoImplicit false
variable {program : Program}

/-- Reverse declaration order on reference paths of a declared schema. Distinct
constructor alternatives are never ordered against one another. -/
inductive ReferenceOrder (program : Program) : Ty → List Component → List Component → Prop where
  | siblings {type first second firstReferent secondReferent : Ty} {head : Head} {types : List Ty}
      {firstIndex secondIndex : Nat} {firstPath secondPath : List Component}
      {firstMode secondMode : BorrowMode}
      (source : head.Source) (shape : HeadType program head type types)
      (firstField : types[firstIndex]? = some first) (secondField : types[secondIndex]? = some second)
      (later : secondIndex < firstIndex)
      (firstReference : ReferencePath program first firstPath firstReferent firstMode)
      (secondReference : ReferencePath program second secondPath secondReferent secondMode) :
      ReferenceOrder program type (.constructor head :: .field firstIndex :: firstPath)
        (.constructor head :: .field secondIndex :: secondPath)
  | child {type child : Ty} {head : Head} {types : List Ty} {index : Nat}
      {firstPath secondPath : List Component}
      (source : head.Source) (shape : HeadType program head type types)
      (selected : types[index]? = some child)
      (inside : ReferenceOrder program child firstPath secondPath) :
      ReferenceOrder program type (.constructor head :: .field index :: firstPath)
        (.constructor head :: .field index :: secondPath)

/-- This is an order projection of the authoritative product, not a second
resource inventory. Every endpoint must occur in that very product. -/
inductive Payload.EndsBefore (program : Program) : Payload → Reference → Reference → Prop where
  | siblings {head : Head} {fields : List Payload} {firstField secondField : Payload}
      {first second : Reference} {firstIndex secondIndex : Nat}
      (firstAt : fields[firstIndex]? = some firstField) (secondAt : fields[secondIndex]? = some secondField)
      (later : secondIndex < firstIndex)
      (firstOccurs : firstField.Occurs program first) (secondOccurs : secondField.Occurs program second) :
      EndsBefore program (.aggregate head fields) first second
  | child {head : Head} {fields : List Payload} {field : Payload} {first second : Reference}
      (member : field ∈ fields) (inside : EndsBefore program field first second) :
      EndsBefore program (.aggregate head fields) first second
  | schema {owner : Nat} {path firstPath secondPath : List Component} {type : Ty} {copies : List Nat}
      {knowledge : SchemaKnowledge}
      (ordered : ReferenceOrder program type firstPath secondPath) :
      EndsBefore program (.schema owner path type copies knowledge)
        ((Reference.parameter owner (path ++ firstPath)).rename copies)
        ((Reference.parameter owner (path ++ secondPath)).rename copies)

theorem ReferenceOrder.paths {type : Ty} {firstPath secondPath : List Component}
    (ordered : ReferenceOrder program type firstPath secondPath) :
    ∃ firstReferent firstMode secondReferent secondMode,
      ReferencePath program type firstPath firstReferent firstMode ∧
      ReferencePath program type secondPath secondReferent secondMode := by
  induction ordered with
  | siblings source shape firstField secondField _ firstReference secondReference =>
      exact ⟨_, _, _, _, .child source shape firstField firstReference,
        .child source shape secondField secondReference⟩
  | child source shape selected _ ih =>
      obtain ⟨_, _, _, _, first, second⟩ := ih
      exact ⟨_, _, _, _, .child source shape selected first, .child source shape selected second⟩

theorem Payload.EndsBefore.occurrences {payload : Payload} {first second : Reference}
    (ordered : payload.EndsBefore program first second) :
    payload.Occurs program first ∧ payload.Occurs program second := by
  induction ordered with
  | siblings firstAt secondAt _ firstOccurs secondOccurs =>
      exact ⟨.child (List.mem_of_getElem? firstAt) firstOccurs,
        .child (List.mem_of_getElem? secondAt) secondOccurs⟩
  | child member _ ih => exact ⟨.child member ih.1, .child member ih.2⟩
  | schema ordered =>
      obtain ⟨_, _, _, _, first, second⟩ := ordered.paths
      exact ⟨.schema first, .schema second⟩

/-- A known observer may be absent at this ending only when the same product
ends it earlier. Caller observers and actual pending values remain protected. -/
def Context.CanDispose (context : Context) (held : List Payload) (payload : Payload) : Prop :=
  ∀ reference, payload.Occurs program reference →
    ¬ heldOccurs (program := program) held reference ∧ context.NotKnownUnrestored reference ∧
    ∀ loan ∈ context.loans, context.NotEnded (program := program) loan.reference →
      loan.reference ≠ reference → ∀ slot observed,
      context.storage loan.target.base = some slot →
      Nonempty (Payload.At program slot.payload slot.type loan.target.fields observed loan.referent) →
      observed.Occurs program reference → payload.EndsBefore program loan.reference reference

end Grounded.Checked

/- Section: StateBorrow -/
namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

theorem StateTyped.borrowAccess {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {place : AccessPlace} {target : Origin} {referent : Ty} {parent : Option Nat} {mode : BorrowMode} {payload : SourcePayload}
    (access : AccessType program home context mode place target referent parent)
    (ready : context.AccessReady target parent) (permitted : context.Permits mode parent target)
    (finite : FiniteLayout program.target program.data referent)
    (provenance : context.TargetPayload program target referent payload) (available : context.PayloadAvailable payload) :
    ∃ resident,
      environment.resolveAccess program place = some ⟨interpretation.origin target, parent.map interpretation.node⟩ ∧
      environment.Authorizes mode ⟨interpretation.origin target, parent.map interpretation.node⟩ ∧
      environment.CarrierPermits program mode place ∧
      environment.Permits mode (parent.map interpretation.node) (interpretation.origin target) ∧
      environment.readAddress (interpretation.origin target) = some resident ∧ environment.ResultUsable resident ∧
      StateTyped program (interpretation.addNode context.loans.length environment.loans.length)
        (context.borrow target referent parent mode) (heldPayloads ++ [.reference context.loans.length])
        (environment.addLoan ⟨interpretation.origin target, parent.map interpretation.node⟩ mode)
        (held ++ [.reference environment.loans.length]) ∧
      ResultTyped program (interpretation.addNode context.loans.length environment.loans.length)
        (context.borrow target referent parent mode)
        ⟨.reference referent mode, .reference context.loans.length⟩ (.reference environment.loans.length) ∧
      StateProgress context (context.borrow target referent parent mode) environment
        (environment.addLoan ⟨interpretation.origin target, parent.map interpretation.node⟩ mode)
        interpretation (interpretation.addNode context.loans.length environment.loans.length) := by
  obtain ⟨known, bounded, ancestor, resident, resolved, authority, selected, residentTyped⟩ := typed.toStoreTyped.resolveAccess access ready
  have related := typed.toStoreTyped.targetPayloadCorresponds provenance (Environment.readAddress_at selected)
  have usable : environment.ResultUsable resident := by
    apply related.usable
    intro node member
    obtain ⟨loan, found, _⟩ := (available node member).1
    exact ⟨typed.toStoreTyped.usable (available node member).1,
      typed.toStoreTyped.restored found (available node member).2⟩
  refine ⟨resident, resolved, authority, typed.toStoreTyped.carrierPermits access,
    typed.toStoreTyped.permits known permitted, selected, usable, ?_, .newBorrow finite, .borrow typed.source known⟩
  exact typed.borrow known bounded finite ancestor access.parentMode (access.sourceTarget typed.toStoreTyped ready)
    ready.1 (fun other target node member =>
      (available node ((provenance.nodes_eq target).symm ▸ member)).1)

end Grounded

/- Section: StateMove -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem StateTyped.moveTarget {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {origin : Origin} {binder : Nat} {slot : Slot} {referent : Ty} {state : Initialization}
    {payload remainder : SourcePayload}
    (base : origin.base = .binder binder) (stored : context.storage (.binder binder) = some slot)
    (path : CanonicalPath program slot.type origin.fields referent)
    (access : slot.initialization.Access origin.fields state) (complete : state.Complete)
    (selected : slot.payload.select origin.fields = some payload) (available : context.PayloadAvailable payload)
    (cleared : SourcePayload.Write program slot.type origin.fields slot.payload .plain remainder)
    (separated : ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan → loan.own = true →
      (origin.Within loan.target ∧ loan.mode = .unique) ∨ origin.Apart loan.target)
    (pending : ∀ node ∈ payloadNodes (heldPayloads ++ [payload]), ∀ loan,
      context.loans[node]? = some loan → loan.own = true → origin.Apart loan.target) :
    ∃ value after, environment.takeAddress (interpretation.origin origin) = some (value, after) ∧
      StateTyped program interpretation (context.writeTarget origin .vacant remainder)
        (heldPayloads ++ [payload]) after (held ++ [value]) ∧
      ResultTyped program interpretation (context.writeTarget origin .vacant remainder) ⟨referent, payload⟩ value ∧
      StateProgress context (context.writeTarget origin .vacant remainder) environment after interpretation interpretation := by
  obtain ⟨root, rootStored, rootTyped, rootRelated⟩ := typed.cells binder slot stored
  obtain ⟨value, read, residentTyped⟩ := path.resident rootTyped access
  obtain ⟨resident, initialized⟩ := residentTyped.complete complete
  have actual : environment.at (interpretation.origin origin) = some value := by
    simp only [Environment.at, Interpretation.origin, base, rootStored, Bind.bind, Option.bind_some, read]
  have related := rootRelated.select selected read
  have payloadTyped := (typed.source.allocated binder slot stored).2.2.2.select path selected
  obtain ⟨after, written, afterTyped⟩ := typed.toStoreTyped.writeTarget_preserves base stored path access
    .vacant cleared (.plain referent) (.plain (by trivial : Value.ReferenceFree .vacant)) separated
  have taken : environment.takeAddress (interpretation.origin origin) = some (value, after) :=
    Environment.takeAddress_eq_some.mpr ⟨by simp [Environment.readAddress, actual, initialized], written⟩
  have target : context.Target program origin referent := by
    simpa only [Context.Target, base] using (show ∃ slot, context.storage (.binder binder) = some slot ∧
      CanonicalPath program slot.type origin.fields referent ∧ ∃ state, slot.initialization.Access origin.fields state from
      ⟨slot, stored, path, state, access⟩)
  have ownership : ∀ node ∈ payloadNodes (heldPayloads ++ [payload]), context.Own node := by
    intro node member
    simp only [payloadNodes_append, payloadNodes, List.append_nil, List.mem_append] at member
    exact member.elim (typed.heldOwn node) (fun inside => (available node inside).1)
  have readiness : ∀ node ∈ payloadNodes (heldPayloads ++ [payload]), context.Restored node := by
    intro node member
    simp only [payloadNodes_append, payloadNodes, List.append_nil, List.mem_append] at member
    exact member.elim (typed.heldReady node) (fun inside => (available node inside).2)
  refine ⟨value, after, taken, ?_, ⟨resident, payloadTyped, related⟩, StateProgress.writeTarget typed.source written⟩
  exact { afterTyped with
    heldShape := typed.heldShape.append (.cons related .nil)
    heldOwn := ownership
    heldReady := fun node member loan found own => Context.Ready.writeTarget_apart target base
      (readiness node member loan found own) (pending node member loan found own) .vacant remainder
    observedOwn := typed.observedOwn.writeTarget (base ▸ stored) cleared (by intro node member; cases member)
    custody := typed.custody.takeAddress taken }

theorem StateTyped.installTarget {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value} {replacement : ResultType} {value : Value}
    (typed : StateTyped program interpretation context (heldPayloads ++ [replacement.payload]) environment (held ++ [value]))
    (valueTyped : ResultTyped program interpretation context replacement value)
    {origin : Origin} {binder : Nat} {slot : Slot} {state : Initialization} {old updated : SourcePayload}
    (base : origin.base = .binder binder) (stored : context.storage (.binder binder) = some slot)
    (path : CanonicalPath program slot.type origin.fields replacement.type)
    (access : slot.initialization.Access origin.fields state)
    (selected : slot.payload.select origin.fields = some old) (empty : state = .vacant ∨ old.nodes = [])
    (write : SourcePayload.Write program slot.type origin.fields slot.payload replacement.payload updated)
    (separated : ∀ (node : Nat) (loan : SourceLoan), context.loans[node]? = some loan → loan.own = true →
      (origin.Within loan.target ∧ loan.mode = .unique) ∨ origin.Apart loan.target) :
    ∃ after, environment.writeAddress (interpretation.origin origin) value = some after ∧
      StateTyped program interpretation (context.writeTarget origin .full updated) heldPayloads after held ∧
      StateProgress context (context.writeTarget origin .full updated) environment after interpretation interpretation := by
  obtain ⟨root, rootStored, rootTyped, rootRelated⟩ := typed.cells binder slot stored
  obtain ⟨resident, read, residentTyped⟩ := path.resident rootTyped access
  have actual : environment.at (interpretation.origin origin) = some resident := by
    simp only [Environment.at, Interpretation.origin, base, rootStored, Bind.bind, Option.bind_some, read]
  have noReferences : resident.ReferenceFree := by
    rcases empty with vacant | plain
    · have absent : ResidentTyped program .vacant resident replacement.type := vacant ▸ residentTyped
      rw [absent.vacant_value]
      trivial
    · exact (rootRelated.select selected read).referenceFree_iff.mpr plain
  obtain ⟨after, written, afterTyped⟩ := typed.toStoreTyped.writeTarget_preserves base stored path access
    valueTyped.resident write valueTyped.payload valueTyped.corresponds separated
  have target : context.Target program origin replacement.type := by
    simpa only [Context.Target, base] using (show ∃ slot, context.storage (.binder binder) = some slot ∧
      CanonicalPath program slot.type origin.fields replacement.type ∧ ∃ state, slot.initialization.Access origin.fields state from
      ⟨slot, stored, path, state, access⟩)
  have available : context.PayloadAvailable replacement.payload := by
    intro node member
    have heldMember : node ∈ payloadNodes (heldPayloads ++ [replacement.payload]) := by simp [payloadNodes_append, payloadNodes, member]
    exact ⟨typed.heldOwn node heldMember, typed.heldReady node heldMember⟩
  have length : heldPayloads.length = held.length := by
    have total := typed.heldShape.length
    simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using total
  refine ⟨after, written, ?_, StateProgress.writeTarget typed.source written⟩
  exact { afterTyped with
    heldShape := (typed.heldShape.append_inv length).1
    heldOwn := fun node member => typed.heldOwn node (by simp [payloadNodes_append, member])
    heldReady := fun node member loan found own => Context.Ready.writeTarget_initialized target base
      (typed.heldReady node (by simp [payloadNodes_append, member]) loan found own) .full updated
    observedOwn := typed.observedOwn.writeTarget (base ▸ stored) write available
    custody := typed.custody.installSelected actual (fun node _ _ _ fields => noReferences.noReference fields node) written }

end Grounded

/- Section: ExecutionPrimitives -/

namespace Grounded
set_option autoImplicit false
variable {program : Program} {home : Module}

private theorem StoreTyped.availablePayloadUsable
    {interpretation : Interpretation} {context : Context} {environment : Environment}
    (typed : StoreTyped program interpretation context environment)
    {payload : SourcePayload} {value : Value}
    (related : payload.Corresponds interpretation.node value)
    (available : context.PayloadAvailable payload) : environment.ResultUsable value := by
  apply related.usable
  intro node member
  obtain ⟨loan, found, _⟩ := (available node member).1
  exact ⟨typed.usable (available node member).1, typed.restored found (available node member).2⟩

/-- A source read executes the recursive payload copy, including fresh shared
children at every aggregate depth, and retains the resulting custody state. -/
theorem StateTyped.executesRead
    {interpretation : Interpretation} {context afterCtx : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {place : Place} {slot : Slot} {type : Ty} {indices : List Nat} {state : Initialization}
    {payload copied : SourcePayload}
    (selected : lookup place.root context.bindings = some slot)
    (access : slot.initialization.Access indices state) (initialized : state.Complete)
    (path : PathType program home slot.type place.fields indices type)
    (provenance : slot.payload.select indices = some payload) (_available : context.PayloadAvailable payload)
    (_copyable : Duplicable program.data type)
    (permitted : context.Permits .shared none ⟨.binder slot.binder, indices⟩)
    (copy : Context.CopyPayload context payload copied afterCtx) :
    ∃ value after last,
      Evaluates program environment ⟨.read place, .leaf⟩ value after ∧
      ResultTyped program last afterCtx ⟨type, copied⟩ value ∧
      StateTyped program last afterCtx (heldPayloads ++ [copied]) after (held ++ [value]) ∧
      StateProgress context afterCtx environment after interpretation last := by
  obtain ⟨resident, resolved, raw, residentTyped⟩ := typed.toStoreTyped.resolvePlace selected access path
  obtain ⟨valueTyped, live⟩ := residentTyped.complete initialized
  have source : context.TargetPayload program ⟨.binder slot.binder, indices⟩ type payload :=
    .cell (typed.source.member_stored _ (lookup_member selected)) path.canonical provenance
  have related := typed.toStoreTyped.targetPayloadCorresponds source raw
  obtain ⟨after, last, value, copiedValue, stateTyped, resultTyped, progress⟩ :=
    typed.copyResult copy ⟨valueTyped, source.typed typed.source, related⟩
  exact ⟨value, after, last, .read resolved (by simp [Environment.readAddress, raw, live])
    (typed.toStoreTyped.permits (origin := ⟨.binder slot.binder, indices⟩)
      (typed.source.member_known _ (lookup_member selected)) permitted) copiedValue,
    resultTyped, stateTyped, progress⟩

/-- Explicit ownership transfer uses the canonical take and its custody theorem;
source freedom supplies both mutation separation and pending-result readiness. -/
theorem StateTyped.executesMove
    {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {place : Place} {slot : Slot} {type : Ty} {indices : List Nat} {state : Initialization}
    {payload remainder : SourcePayload}
    (selected : lookup place.root context.bindings = some slot)
    (access : slot.initialization.Access indices state) (initialized : state.Complete)
    (path : PathType program home slot.type place.fields indices type)
    (provenance : slot.payload.select indices = some payload) (available : context.PayloadAvailable payload)
    (free : context.Free ⟨.binder slot.binder, indices⟩)
    (cleared : SourcePayload.Write program slot.type indices slot.payload .plain remainder) :
    ∃ value after last,
      Evaluates program environment ⟨.move place, .leaf⟩ value after ∧
      ResultTyped program last (context.writeTarget ⟨.binder slot.binder, indices⟩ .vacant remainder)
        ⟨type, payload⟩ value ∧
      StateTyped program last (context.writeTarget ⟨.binder slot.binder, indices⟩ .vacant remainder)
        (heldPayloads ++ [payload]) after (held ++ [value]) ∧
      StateProgress context (context.writeTarget ⟨.binder slot.binder, indices⟩ .vacant remainder)
        environment after interpretation last := by
  obtain ⟨_, resolved, _, _⟩ := typed.toStoreTyped.resolvePlace selected access path
  obtain ⟨value, after, taken, stateTyped, resultTyped, progress⟩ :=
    typed.moveTarget (origin := ⟨.binder slot.binder, indices⟩) rfl
      (typed.source.member_stored _ (lookup_member selected)) path.canonical access initialized
      provenance available cleared (fun node loan found own => .inr (free node loan found own))
      (fun node _ loan found own => free node loan found own)
  exact ⟨value, after, interpretation, .move resolved
    (typed.toStoreTyped.ownerFree (origin := ⟨.binder slot.binder, indices⟩)
      (typed.source.member_known _ (lookup_member selected)) free)
    (typed.toStoreTyped.availablePayloadUsable resultTyped.corresponds available) taken,
    resultTyped, stateTyped, progress⟩

/-- Dereference copying resolves the actual carrier and target before recursively
copying the source payload. No successful runtime operation is assumed. -/
theorem StateTyped.executesDereference
    {interpretation : Interpretation} {context afterCtx : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {reference : Place} {fields : List FieldKey} {target : Origin} {type : Ty} {parent : Option Nat}
    {payload copied : SourcePayload}
    (access : AccessType program home context .shared (.dereference reference fields) target type parent)
    (ready : context.AccessReady target parent) (permitted : context.Permits .shared parent target)
    (provenance : context.TargetPayload program target type payload) (available : context.PayloadAvailable payload)
    (_copyable : Duplicable program.data type) (copy : Context.CopyPayload context payload copied afterCtx) :
    ∃ value after last,
      Evaluates program environment ⟨.dereference reference fields, .leaf⟩ value after ∧
      ResultTyped program last afterCtx ⟨type, copied⟩ value ∧
      StateTyped program last afterCtx (heldPayloads ++ [copied]) after (held ++ [value]) ∧
      StateProgress context afterCtx environment after interpretation last := by
  obtain ⟨known, _, _, resident, resolved, authority, selected, residentTyped⟩ :=
    typed.toStoreTyped.resolveAccess access ready
  have related := typed.toStoreTyped.targetPayloadCorresponds provenance
    (Environment.readAddress_at selected)
  obtain ⟨after, last, value, copiedValue, stateTyped, resultTyped, progress⟩ :=
    typed.copyResult copy ⟨residentTyped, provenance.typed typed.source, related⟩
  exact ⟨value, after, last, .dereference resolved (typed.toStoreTyped.carrierPermits access) authority
    (typed.toStoreTyped.permits known permitted) (typed.toStoreTyped.accessReady access ready) selected
    (typed.toStoreTyped.availablePayloadUsable related available) copiedValue,
    resultTyped, stateTyped, progress⟩

/-- Unique indirect transfer derives its mutable binder target and ancestor
separation from the checked access, not from a future write or state witness. -/
theorem StateTyped.executesMoveIndirect
    {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {reference : Place} {fields : List FieldKey} {target : Origin} {type : Ty} {node : Nat}
    {slot : Slot} {payload remainder : SourcePayload}
    (access : AccessType program home context .unique (.dereference reference fields) target type (some node))
    (ready : context.AccessReady target (some node)) (permitted : context.Permits .unique (some node) target)
    (stored : context.storage target.base = some slot)
    (path : CanonicalPath program slot.type target.fields type)
    (provenance : slot.payload.select target.fields = some payload) (available : context.PayloadAvailable payload)
    (pending : ∀ heldNode ∈ payloadNodes (heldPayloads ++ [payload]), ∀ loan,
      context.loans[heldNode]? = some loan → loan.own = true → target.Apart loan.target)
    (cleared : SourcePayload.Write program slot.type target.fields slot.payload .plain remainder) :
    ∃ value after last,
      Evaluates program environment ⟨.moveIndirect reference fields, .leaf⟩ value after ∧
      ResultTyped program last (context.writeTarget target .vacant remainder) ⟨type, payload⟩ value ∧
      StateTyped program last (context.writeTarget target .vacant remainder)
        (heldPayloads ++ [payload]) after (held ++ [value]) ∧
      StateProgress context (context.writeTarget target .vacant remainder)
        environment after interpretation last := by
  obtain ⟨loan, binder, found, _, unique, within, base⟩ := access.uniqueTarget typed.toStoreTyped
  have binderStored : context.storage (.binder binder) = some slot := by simpa only [base] using stored
  have completeAccess : ∃ state, slot.initialization.Access target.fields state ∧ state.Complete := by
    have targetReady := ready.1
    simp only [Context.Ready, base] at targetReady
    obtain ⟨resident, state, residentStored, selected, complete⟩ := targetReady
    cases Option.some.inj (residentStored.symm.trans binderStored)
    exact ⟨state, selected, complete⟩
  obtain ⟨state, selected, complete⟩ := completeAccess
  have separated : ∀ (other : Nat) (otherLoan : SourceLoan), context.loans[other]? = some otherLoan → otherLoan.own = true →
      (target.Within otherLoan.target ∧ otherLoan.mode = .unique) ∨ target.Apart otherLoan.target := by
    intro other otherLoan otherFound own
    rcases permitted other otherLoan otherFound own with shared | ancestral | apart
    · cases shared.1
    · obtain ⟨parent, same, derived⟩ := ancestral
      cases Option.some.inj same
      have ancestor := derived.targetWithin typed.source found otherFound
      exact .inl ⟨⟨within.1.trans ancestor.1, ancestor.2.trans within.2⟩,
        derived.unique typed.source found otherFound unique⟩
    · exact .inr apart
  obtain ⟨value, after, taken, stateTyped, resultTyped, progress⟩ :=
    typed.moveTarget base binderStored path selected complete provenance available cleared separated pending
  obtain ⟨known, _, _, resolved, authority, _⟩ := typed.toStoreTyped.resolveAccessMasked access
  exact ⟨value, after, interpretation, .moveIndirect resolved (typed.toStoreTyped.carrierPermits access) authority
    (typed.toStoreTyped.permits known permitted) (typed.toStoreTyped.accessReady access ready)
    (typed.toStoreTyped.availablePayloadUsable resultTyped.corresponds available) taken,
    resultTyped, stateTyped, progress⟩

/-- Explicit borrowing emits the fresh runtime node associated with the exact
source node allocated by the source borrow transition. -/
theorem StateTyped.executesBorrow
    {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {place : AccessPlace} {target : Origin} {referent : Ty} {parent : Option Nat}
    {mode : BorrowMode} {payload : SourcePayload}
    (access : AccessType program home context mode place target referent parent)
    (ready : context.AccessReady target parent) (permitted : context.Permits mode parent target)
    (finite : FiniteLayout program.target program.data referent)
    (provenance : context.TargetPayload program target referent payload) (available : context.PayloadAvailable payload) :
    ∃ value after last,
      Evaluates program environment ⟨.borrow mode place, .leaf⟩ value after ∧
      ResultTyped program last (context.borrow target referent parent mode)
        ⟨.reference referent mode, .reference context.loans.length⟩ value ∧
      StateTyped program last (context.borrow target referent parent mode)
        (heldPayloads ++ [.reference context.loans.length]) after (held ++ [value]) ∧
      StateProgress context (context.borrow target referent parent mode)
        environment after interpretation last := by
  obtain ⟨resident, resolved, authority, carrier, permission, selected, usable, stateTyped, resultTyped, progress⟩ :=
    typed.borrowAccess access ready permitted finite provenance available
  exact ⟨_, _, _, .borrow resolved carrier authority permission
    (typed.toStoreTyped.accessReady access ready) selected usable, resultTyped, stateTyped, progress⟩

/-- A reference-expected bare place uses the reborrow Core plan, preserving the
same exact fresh source payload and after-context as explicit borrowing. -/
theorem StateTyped.executesReborrow
    {interpretation : Interpretation} {context : Context} {environment : Environment}
    {heldPayloads : List SourcePayload} {held : List Value}
    (typed : StateTyped program interpretation context heldPayloads environment held)
    {place : Place} {target : Origin} {referent : Ty} {parent : Option Nat}
    {mode : BorrowMode} {payload : SourcePayload}
    (access : AccessType program home context mode (.dereference place []) target referent parent)
    (ready : context.AccessReady target parent) (permitted : context.Permits mode parent target)
    (finite : FiniteLayout program.target program.data referent)
    (provenance : context.TargetPayload program target referent payload) (available : context.PayloadAvailable payload) :
    ∃ value after last,
      Evaluates program environment ⟨.read place, .reborrow mode⟩ value after ∧
      ResultTyped program last (context.borrow target referent parent mode)
        ⟨.reference referent mode, .reference context.loans.length⟩ value ∧
      StateTyped program last (context.borrow target referent parent mode)
        (heldPayloads ++ [.reference context.loans.length]) after (held ++ [value]) ∧
      StateProgress context (context.borrow target referent parent mode)
        environment after interpretation last := by
  obtain ⟨resident, resolved, authority, carrier, permission, selected, usable, stateTyped, resultTyped, progress⟩ :=
    typed.borrowAccess access ready permitted finite provenance available
  exact ⟨_, _, _, .reborrow resolved carrier authority permission
    (typed.toStoreTyped.accessReady access ready) selected usable, resultTyped, stateTyped, progress⟩

end Grounded

/- Section: ElaborationPrimitives -/
namespace Grounded.Checked
set_option autoImplicit false

/-- Known masks remain ordinary checking obligations; an opaque absent root
carries an external obligation rather than a fabricated initialization bit. -/
def Context.TargetReady (context : Context) (target : Address) : Prop :=
  ∀ slot, context.storage target.base = some slot →
    ∃ state, slot.initialization.Access target.fields state ∧ state.Complete

inductive Access (program : Program) (home : Module) (context : Context) :
    BorrowMode → AccessPlace → Address → Ty → Option Reference → Type where
  | owned {mode : BorrowMode} {place : Place} {slot : Slot} {indices : List Nat} {type : Ty}
      (found : lookup place.root context.bindings = some slot)
      (path : PathType program home slot.type place.fields indices type)
      (writable : mode = .unique → slot.mutable = true) :
      Access program home context mode (.owner place) ⟨.binder slot.binder, indices⟩ type none
  | dereference {mode ownerMode : BorrowMode} {reference : Place} {fields : List FieldKey}
      {symbol : Reference} {referent type : Ty} {indices : List Nat}
      (carrier : PlaceSelection program home context reference
        ⟨.reference referent ownerMode, .reference symbol referent ownerMode⟩)
      (live : context.NotEnded (program := program) symbol)
      (authority : mode = .unique → ownerMode = .unique)
      (carrierPermits : context.LocalPermits (program := program) mode none
        ⟨.binder carrier.slot.binder, carrier.indices⟩)
      (path : PathType program home referent fields indices type) :
      Access program home context mode (.dereference reference fields)
        ((context.referenceTarget symbol).extend indices) type (some symbol)

end Grounded.Checked
namespace Grounded.Elaboration
set_option autoImplicit false

/-- These are concrete source premises, not assumptions about evaluation,
future storage or readiness of an execution. The evaluator bridges consume them. -/
structure SourceRead (program : Program) (home : Module) (before : Grounded.Context)
    (place : Place) (result : ResultType) (after : Grounded.Context) where
  slot : Grounded.Slot
  indices : List Nat
  state : Initialization
  payload : SourcePayload
  selected : lookup place.root before.bindings = some slot
  access : slot.initialization.Access indices state
  initialized : state.Complete
  path : PathType program home slot.type place.fields indices result.type
  provenance : slot.payload.select indices = some payload
  available : before.PayloadAvailable payload
  permission : Duplicable program.data result.type
  permitted : before.Permits .shared none ⟨.binder slot.binder, indices⟩
  copied : Grounded.Context.CopyPayload before payload result.payload after

structure SourceMove (program : Program) (home : Module) (before : Grounded.Context)
    (place : Place) (result : ResultType) (after : Grounded.Context) where
  slot : Grounded.Slot
  indices : List Nat
  state : Initialization
  remainder : SourcePayload
  selected : lookup place.root before.bindings = some slot
  access : slot.initialization.Access indices state
  initialized : state.Complete
  path : PathType program home slot.type place.fields indices result.type
  provenance : slot.payload.select indices = some result.payload
  available : before.PayloadAvailable result.payload
  free : before.Free ⟨.binder slot.binder, indices⟩
  cleared : SourcePayload.Write program slot.type indices slot.payload .plain remainder
  updated : after = before.writeTarget ⟨.binder slot.binder, indices⟩ .vacant remainder

structure SourceBorrow (program : Program) (home : Module) (before : Grounded.Context)
    (mode : BorrowMode) (place : AccessPlace) (referent : Ty)
    (result : ResultType) (after : Grounded.Context) where
  target : Origin
  parent : Option Nat
  payload : SourcePayload
  access : AccessType program home before mode place target referent parent
  ready : before.AccessReady target parent
  permitted : before.Permits mode parent target
  finite : FiniteLayout program.target program.data referent
  provenance : before.TargetPayload program target referent payload
  available : before.PayloadAvailable payload
  produced : result = ⟨.reference referent mode, .reference before.loans.length⟩
  updated : after = before.borrow target referent parent mode

structure SourceDereference (program : Program) (home : Module) (before : Grounded.Context)
    (reference : Place) (fields : List FieldKey) (result : ResultType) (after : Grounded.Context) where
  target : Origin
  parent : Option Nat
  payload : SourcePayload
  access : AccessType program home before .shared (.dereference reference fields) target result.type parent
  ready : before.AccessReady target parent
  permitted : before.Permits .shared parent target
  provenance : before.TargetPayload program target result.type payload
  available : before.PayloadAvailable payload
  permission : Duplicable program.data result.type
  copied : Grounded.Context.CopyPayload before payload result.payload after

structure SourceMoveIndirect (program : Program) (home : Module) (before : Grounded.Context)
    (held : List SourcePayload) (reference : Place) (fields : List FieldKey)
    (result : ResultType) (after : Grounded.Context) where
  target : Origin
  node : Nat
  slot : Grounded.Slot
  remainder : SourcePayload
  access : AccessType program home before .unique (.dereference reference fields) target result.type (some node)
  ready : before.AccessReady target (some node)
  permitted : before.Permits .unique (some node) target
  stored : before.storage target.base = some slot
  path : CanonicalPath program slot.type target.fields result.type
  provenance : slot.payload.select target.fields = some result.payload
  available : before.PayloadAvailable result.payload
  pending : ∀ heldNode ∈ payloadNodes (held ++ [result.payload]), ∀ loan,
    before.loans[heldNode]? = some loan → loan.own = true → target.Apart loan.target
  cleared : SourcePayload.Write program slot.type target.fields slot.payload .plain remainder
  updated : after = before.writeTarget target .vacant remainder

structure SourceEnding (program : Program) (before : Grounded.Context) (held : List SourcePayload)
    (slotIndex : Nat) (fields : List Nat) (after : Grounded.Context) where
  binding : String × Grounded.Slot
  node : Nat
  selected : before.bindings[slotIndex]? = some binding
  handle : binding.2.payload.select fields = some (.reference node)
  unprotected : node ∉ payloadNodes held
  ready : before.Restored node
  unobserved : before.Unobserved program node
  updated : after = before.endOwn node

end Grounded.Elaboration

/- Section: ElaborationPatterns -/
namespace Grounded.Elaboration
set_option autoImplicit false

variable {program : Program} {home : Module} {phase : Phase}

def bindingSources (bindings : List (String × Result phase)) (executable : phase = .executable) :
    List (String × ResultType) := bindings.map fun entry => (entry.1, entry.2.source executable)

def bindingProducts (bindings : List (String × Result phase)) : List (String × Checked.Result) :=
  bindings.map fun entry => (entry.1, entry.2.checked)

def bindingHeld (bindings : List (String × Result phase)) : List (Payload phase) :=
  bindings.map fun entry => entry.2.payload

/-- Local disposal obligations inspect the chosen symbolic product, including
all declared reference paths in a schema. Actual ownership guards stay below. -/
structure PatternDisposal (program : Program) (held : List (Payload phase))
    (before : Point program phase) (result : Result phase) (after : Point program phase) : Prop where
  typed : result.payload.checked.Typed program result.type
  interpreted : result.Interpreted before
  discard : MayDiscard program.data result.type
  available : before.checked.ResourcesAvailable (program := program) result.payload.checked
  disposable : before.checked.CanDispose (program := program) (held.map Payload.checked) result.payload.checked
  checked : after.checked = before.checked.endPayload result.payload.checked
  actual : Required phase fun executable =>
    (before.source executable).PayloadDisposable program
      (held.map fun payload => payload.source executable) (result.payload.source executable) ∧
    after.source executable = (before.source executable).dispose (result.payload.source executable) ∧
    after.symbols executable = before.symbols executable

/-- Decomposition is of the selected product, not a second pattern checker. -/
inductive PatternFields : Checked.Result → Head → List Ty → List Checked.Result → Prop where
  | plain (type : Ty) (head : Head) (types : List Ty) :
      PatternFields ⟨type, .plain⟩ head types (types.map fun type => ⟨type, .plain⟩)
  | aggregate (type : Ty) (head : Head) (fields : List Checked.Result) :
      PatternFields ⟨type, .aggregate head (fields.map Checked.Result.payload)⟩ head
        (fields.map Checked.Result.type) fields
  | schema (owner : Nat) (path : List Checked.Component) (type : Ty) (copies : List Nat)
      (knowledge : Checked.SchemaKnowledge) (head : Head) (types : List Ty) :
      PatternFields ⟨type, .schema owner path type copies knowledge⟩ head types
        (types.zipIdx.map fun entry =>
          ⟨entry.1, Checked.Payload.input owner (path ++ [.constructor head, .field entry.2]) entry.1 copies knowledge⟩)

structure PatternDecomposition (program : Program) (home : Module)
    (before : Point program phase) (result : Result phase) (head : Head)
    (types : List Ty) (fields : List (Result phase)) : Prop where
  typed : result.payload.checked.Typed program result.type
  interpreted : result.Interpreted before
  sourceHead : head.Source
  shape : HeadType program head result.type types
  access : head.Accessible program home
  checked : PatternFields result.checked head types (fields.map Result.checked)
  actual : Required phase fun executable =>
    (result.payload.source executable = .plain ∧
      fields.map (fun field => field.source executable) = plainResults types) ∨
    ∃ payloads, result.payload.source executable = .aggregate head payloads ∧
      fields.map (fun field => field.source executable) = fieldResults types payloads

mutual
/-- Both phases choose the same bindings and local state transitions. Inactive
arms use this very producer on declared inputs, not a shape-only admission. -/
inductive PatternProduces (program : Program) (home : Module) (phase : Phase) :
    List (Payload phase) → Point program phase → Pattern → Result phase →
      List (String × Result phase) → Point program phase → Type where
  | wildcard {held : List (Payload phase)} {before after : Point program phase} {result : Result phase}
      (disposal : PatternDisposal program held before result after) :
      PatternProduces program home phase held before .wildcard result [] after
  | binder {held : List (Payload phase)} (before : Point program phase) (name : String) (result : Result phase)
      (typed : result.payload.checked.Typed program result.type)
      (interpreted : result.Interpreted before)
      (available : before.checked.ResourcesAvailable (program := program) result.payload.checked) :
      PatternProduces program home phase held before (.binder name) result [(name, result)] before
  | literal {held : List (Payload phase)} {before after : Point program phase}
      {result : Result phase} {value : Value}
      (typed : ValueHasType program value result.type)
      (disposal : PatternDisposal program held before result after) :
      PatternProduces program home phase held before (.literal (some result.type) value) result [] after
  | node {held : List (Payload phase)} {before after : Point program phase}
      {result : Result phase} {head : Head} {types : List Ty} {fields : List (Result phase)}
      {patterns : List Pattern} {bindings : List (String × Result phase)}
      (decomposition : PatternDecomposition program home before result head types fields)
      (children : PatternsProduce program home phase held before patterns fields bindings after) :
      PatternProduces program home phase held before (.node head patterns) result bindings after
inductive PatternsProduce (program : Program) (home : Module) (phase : Phase) :
    List (Payload phase) → Point program phase → List Pattern → List (Result phase) →
      List (String × Result phase) → Point program phase → Type where
  | nil {held : List (Payload phase)} (before : Point program phase) :
      PatternsProduce program home phase held before [] [] [] before
  | cons {held : List (Payload phase)} {before middle after : Point program phase}
      {pattern : Pattern} {patterns : List Pattern} {result : Result phase} {results : List (Result phase)}
      {front back : List (String × Result phase)}
      (tail : PatternsProduce program home phase (result.payload :: held) before patterns results back middle)
      (first : PatternProduces program home phase (bindingHeld back ++ held) middle pattern result front after)
      (distinct : ((front ++ back).map Prod.fst).Nodup) :
      PatternsProduce program home phase held before (pattern :: patterns) (result :: results)
        (front ++ back) after
end

@[simp] theorem bindingSources_append (first second : List (String × Result phase))
    (executable : phase = .executable) :
    bindingSources (first ++ second) executable = bindingSources first executable ++ bindingSources second executable :=
  List.map_append

@[simp] theorem bindingHeld_sources (bindings : List (String × Result phase))
    (executable : phase = .executable) :
    (bindingHeld bindings).map (fun payload => payload.source executable) =
      bindingPayloads (bindingSources bindings executable) := by
  simp [bindingHeld, bindingSources, bindingPayloads, Result.source]

mutual
theorem PatternProduces.source {held : List (Payload phase)} {before after : Point program phase}
    {pattern : Pattern} {result : Result phase} {bindings : List (String × Result phase)}
    (product : PatternProduces program home phase held before pattern result bindings after)
    (executable : phase = .executable) :
    Grounded.PatternType program home (held.map fun payload => payload.source executable)
      (before.source executable) pattern (result.source executable)
      (.produced (bindingSources bindings executable) (after.source executable)) := by
  cases product with
  | wildcard disposal =>
    rw [(disposal.actual executable).2.1]
    exact .wildcard disposal.discard (disposal.actual executable).1
  | binder before name result _ _ _ => exact .binder _ _ _
  | literal typed disposal =>
    rw [(disposal.actual executable).2.1]
    exact .literal (result := result.source executable) typed disposal.discard (disposal.actual executable).1
  | @node held before after result head types fields patterns bindings decomposition children =>
    have childrenSource := children.source executable
    rcases decomposition.actual executable with ⟨plain, fields⟩ | ⟨payloads, aggregate, fields⟩
    · rw [fields] at childrenSource
      have resultEq : result.source executable = ⟨result.type, .plain⟩ := by
        simp only [Result.source, plain]
      rw [resultEq]
      exact .plain decomposition.shape decomposition.access childrenSource
    · rw [fields] at childrenSource
      have resultEq : result.source executable = ⟨result.type, .aggregate head payloads⟩ := by
        simp only [Result.source, aggregate]
      rw [resultEq]
      exact .aggregate decomposition.shape decomposition.access childrenSource

theorem PatternsProduce.source {held : List (Payload phase)} {before after : Point program phase}
    {patterns : List Pattern} {results : List (Result phase)} {bindings : List (String × Result phase)}
    (product : PatternsProduce program home phase held before patterns results bindings after)
    (executable : phase = .executable) :
    Grounded.PatternsType program home (held.map fun payload => payload.source executable)
      (before.source executable) patterns (results.map fun result => result.source executable)
      (.produced (bindingSources bindings executable) (after.source executable)) := by
  cases product with
  | nil before => exact .nil _
  | cons tail first _ =>
    have tailSource := tail.source executable
    have firstSource := first.source executable
    simp only [List.map_cons, List.map_append, bindingHeld_sources] at tailSource firstSource ⊢
    rw [bindingSources_append]
    exact .cons tailSource firstSource
end

/-- This is a consumer of the projected transition, not an executable premise.
The exact bindings and post-source context selected by the product occur in the
canonical state conclusion. -/
theorem PatternProduces.consume {heldPayloads : List (Payload .executable)}
    {before after : Point program .executable} {pattern : Pattern} {result : Result .executable}
    {types : List (String × Result .executable)}
    (product : PatternProduces program home .executable heldPayloads before pattern result types after)
    {interpretation : Interpretation} {environment : Environment} {held : List Value}
    {value : Value} {bindings : BindingValues}
    (state : StateTyped program interpretation (before.source rfl)
      (heldPayloads.map (fun payload => payload.source rfl) ++ [result.payload.source rfl]) environment (held ++ [value]))
    (subject : ResultTyped program interpretation (before.source rfl) (result.source rfl) value)
    (matched : pattern.matchValue value = some bindings) :
    ∃ final trace,
      Pattern.Consumes program environment pattern value bindings final trace ∧
      BindingResultsTyped program interpretation (after.source rfl) (bindingSources types rfl) bindings ∧
      StateTyped program interpretation (after.source rfl)
        (heldPayloads.map (fun payload => payload.source rfl) ++ bindingPayloads (bindingSources types rfl))
        final (held ++ bindings.map Prod.snd) ∧
      StateProgress (before.source rfl) (after.source rfl) environment final interpretation interpretation :=
  state.consumePattern (product.source rfl) subject matched



def bindingErase (bindings : List (String × Result phase)) : List (String × Result .checking) :=
  bindings.map fun entry => (entry.1, entry.2.erase)

@[simp] theorem bindingErase_append (first second : List (String × Result phase)) :
    bindingErase (first ++ second) = bindingErase first ++ bindingErase second := List.map_append

@[simp] theorem bindingErase_names (bindings : List (String × Result phase)) :
    (bindingErase bindings).map Prod.fst = bindings.map Prod.fst := by
  simp [bindingErase]

@[simp] theorem bindingErase_products (bindings : List (String × Result phase)) :
    bindingProducts (bindingErase bindings) = bindingProducts bindings := by
  simp [bindingProducts, bindingErase]

@[simp] theorem bindingHeld_erase (bindings : List (String × Result phase)) :
    bindingHeld (bindingErase bindings) = (bindingHeld bindings).map Payload.erase := by
  simp [bindingHeld, bindingErase, Result.erase]

theorem PatternDisposal.erase {held : List (Payload phase)} {before after : Point program phase}
    {result : Result phase} (disposal : PatternDisposal program held before result after) :
    PatternDisposal program (held.map Payload.erase) before.erase result.erase after.erase where
  typed := disposal.typed
  interpreted := fun executable => nomatch executable
  discard := disposal.discard
  available := disposal.available
  disposable := by simpa only [List.map_map, Function.comp_def, Point.erase, Result.erase, Payload.erase] using disposal.disposable
  checked := disposal.checked
  actual := fun executable => nomatch executable

theorem PatternDecomposition.erase {before : Point program phase} {result : Result phase}
    {head : Head} {types : List Ty} {fields : List (Result phase)}
    (decomposition : PatternDecomposition program home before result head types fields) :
    PatternDecomposition program home before.erase result.erase head types (fields.map Result.erase) where
  typed := decomposition.typed
  interpreted := fun executable => nomatch executable
  sourceHead := decomposition.sourceHead
  shape := decomposition.shape
  access := decomposition.access
  checked := by simpa only [List.map_map, Function.comp_def, Result.erase_checked] using decomposition.checked
  actual := fun executable => nomatch executable

mutual
def PatternProduces.erase {held : List (Payload phase)} {before after : Point program phase}
    {pattern : Pattern} {result : Result phase} {bindings : List (String × Result phase)}
    (product : PatternProduces program home phase held before pattern result bindings after) :
    PatternProduces program home .checking (held.map Payload.erase) before.erase pattern result.erase
      (bindingErase bindings) after.erase := by
  cases product with
  | wildcard disposal => exact .wildcard disposal.erase
  | binder before name result typed _ available =>
    exact .binder before.erase name result.erase typed (fun executable => nomatch executable) available
  | literal typed disposal => exact .literal (result := result.erase) typed disposal.erase
  | node decomposition children => exact .node decomposition.erase children.erase

def PatternsProduce.erase {held : List (Payload phase)} {before after : Point program phase}
    {patterns : List Pattern} {results : List (Result phase)} {bindings : List (String × Result phase)}
    (product : PatternsProduce program home phase held before patterns results bindings after) :
    PatternsProduce program home .checking (held.map Payload.erase) before.erase patterns (results.map Result.erase)
      (bindingErase bindings) after.erase := by
  cases product with
  | nil before => exact .nil before.erase
  | @cons held before middle after pattern patterns result results front back tail first distinct =>
    have firstErased := first.erase
    rw [List.map_append, ← bindingHeld_erase] at firstErased
    rw [bindingErase_append]
    exact .cons tail.erase firstErased (by simpa using distinct)
end

mutual
theorem PatternProduces.distinct {held : List (Payload phase)} {before after : Point program phase}
    {pattern : Pattern} {result : Result phase} {bindings : List (String × Result phase)}
    (product : PatternProduces program home phase held before pattern result bindings after) :
    (bindings.map Prod.fst).Nodup := by
  cases product with
  | wildcard | literal => exact .nil
  | binder => simp
  | node _ children => exact children.distinct

theorem PatternsProduce.distinct {held : List (Payload phase)} {before after : Point program phase}
    {patterns : List Pattern} {results : List (Result phase)} {bindings : List (String × Result phase)}
    (product : PatternsProduce program home phase held before patterns results bindings after) :
    (bindings.map Prod.fst).Nodup := by
  cases product with
  | nil => exact .nil
  | cons _ _ distinct => exact distinct
end

/-- Each declared input consumes one producer identity, not a guessed runtime
inhabitant. The complete caller resource state is retained. -/
def declareInput (caller : Checked.Context) (type : Ty) : Point program .checking × Result .checking :=
  (⟨caller.advanceSymbol, PUnit.unit⟩,
   ⟨type, ⟨Checked.Payload.input caller.nextSymbol [] type, PUnit.unit⟩⟩)

theorem declareInput_typed (caller : Checked.Context) (type : Ty) :
    (declareInput (program := program) caller type).2.payload.checked.Typed program type :=
  Checked.Payload.input_typed _ _ _ _

theorem declareInput_caller (caller : Checked.Context) (type : Ty) :
    (declareInput (program := program) caller type).1.checked.names = caller.names ∧
    (declareInput (program := program) caller type).1.checked.storage = caller.storage ∧
    (declareInput (program := program) caller type).1.checked.loans = caller.loans ∧
    (declareInput (program := program) caller type).1.checked.ended = caller.ended ∧
    (declareInput (program := program) caller type).1.checked.nextBinder = caller.nextBinder ∧
    (declareInput (program := program) caller type).1.checked.nextSymbol = caller.nextSymbol + 1 :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- Source-order introduction retains the caller rather than supplying a fresh
hypothetical frame. Bindings come from the selected common pattern product. -/
def declareBindings : Checked.Context → List (String × Checked.Result) → Checked.Context
  | caller, [] => caller
  | caller, (name, result) :: rest => declareBindings (caller.bind name false result) rest

theorem declareBindings_loans (caller : Checked.Context) (bindings : List (String × Checked.Result)) :
    (declareBindings caller bindings).loans = caller.loans := by
  induction bindings generalizing caller with
  | nil => rfl
  | cons entry rest ih => exact ih _

theorem declareBindings_ended (caller : Checked.Context) (bindings : List (String × Checked.Result)) :
    (declareBindings caller bindings).ended = caller.ended := by
  induction bindings generalizing caller with
  | nil => rfl
  | cons entry rest ih => exact ih _

theorem declareBindings_symbols (caller : Checked.Context) (bindings : List (String × Checked.Result)) :
    (declareBindings caller bindings).nextSymbol = caller.nextSymbol := by
  induction bindings generalizing caller with
  | nil => rfl
  | cons entry rest ih => exact ih _

theorem declareBindings_supply (caller : Checked.Context) (bindings : List (String × Checked.Result)) :
    (declareBindings caller bindings).nextBinder = caller.nextBinder + bindings.length := by
  induction bindings generalizing caller with
  | nil => simp [declareBindings]
  | cons entry rest ih => simpa [declareBindings, Checked.Context.bind, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ih (caller.bind entry.1 false entry.2)

theorem declareBindings_names (caller : Checked.Context) (bindings : List (String × Checked.Result)) :
    ∃ introduced, (declareBindings caller bindings).names = introduced ++ caller.names ∧
      introduced.map Prod.fst = bindings.reverse.map Prod.fst := by
  induction bindings generalizing caller with
  | nil => exact ⟨[], rfl, rfl⟩
  | cons entry rest ih =>
    obtain ⟨introduced, names, labels⟩ := ih (caller.bind entry.1 false entry.2)
    refine ⟨introduced ++ [(entry.1, caller.nextBinder)], ?_, ?_⟩
    · simpa [declareBindings, Checked.Context.bind, List.append_assoc] using names
    · simp [labels]

theorem declareBindings_storage (caller : Checked.Context) (bindings : List (String × Checked.Result))
    (base : Checked.Base)
    (outside : ∀ identity, caller.nextBinder ≤ identity → identity < caller.nextBinder + bindings.length →
      base ≠ .binder identity) :
    (declareBindings caller bindings).storage base = caller.storage base := by
  induction bindings generalizing caller with
  | nil => rfl
  | cons entry rest ih =>
    have first : base ≠ .binder caller.nextBinder := outside _ (Nat.le_refl _) (by simp)
    have remaining : ∀ identity, (caller.bind entry.1 false entry.2).nextBinder ≤ identity →
        identity < (caller.bind entry.1 false entry.2).nextBinder + rest.length → base ≠ .binder identity := by
      intro identity lower upper
      apply outside identity (Nat.le_trans (Nat.le_succ _) lower)
      simpa [Checked.Context.bind, List.length_cons, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using upper
    exact (ih _ remaining).trans (by simp [Checked.Context.bind, first])

def patternBodyPoint (after : Point program .checking) (bindings : List (String × Result .checking)) :
    Point program .checking := ⟨declareBindings after.checked (bindingProducts bindings), PUnit.unit⟩



theorem PatternFields.types {result : Checked.Result} {head : Head} {types : List Ty}
    {fields : List Checked.Result} (decomposition : PatternFields result head types fields) :
    fields.map Checked.Result.type = types := by
  cases decomposition with
  | plain => simp [Function.comp_def]
  | aggregate => rfl
  | schema => simp [Function.comp_def]

theorem PatternDecomposition.types {before : Point program phase} {result : Result phase}
    {head : Head} {types : List Ty} {fields : List (Result phase)}
    (decomposition : PatternDecomposition program home before result head types fields) :
    fields.map Result.type = types := by
  simpa [Function.comp_def, Result.checked] using decomposition.checked.types

private def plainBindings (bindings : List (String × Result phase)) : List (String × ResultType) :=
  bindings.map fun entry => (entry.1, ⟨entry.2.type, .plain⟩)

mutual
/-- A plain witness is used only below to build the canonical impossible branch.
It asserts no runtime inhabitance and is derived by following this product. -/
private theorem PatternProduces.plainTransition {held : List (Payload phase)}
    {before after : Point program phase} {pattern : Pattern} {result : Result phase}
    {bindings : List (String × Result phase)}
    (product : PatternProduces program home phase held before pattern result bindings after)
    (actualHeld : List SourcePayload) (actualBefore : Grounded.Context) :
    Grounded.PatternType program home actualHeld actualBefore pattern ⟨result.type, .plain⟩
      (.produced (plainBindings bindings) actualBefore) := by
  cases product with
  | wildcard disposal => exact .wildcard disposal.discard trivial
  | binder => exact .binder _ _ _
  | literal typed disposal => exact .literal (result := ⟨result.type, .plain⟩) typed disposal.discard trivial
  | node decomposition children =>
    have projected := children.plainTransition actualHeld actualBefore
    rw [decomposition.types] at projected
    exact .plain decomposition.shape decomposition.access projected

private theorem PatternsProduce.plainTransition {held : List (Payload phase)}
    {before after : Point program phase} {patterns : List Pattern} {results : List (Result phase)}
    {bindings : List (String × Result phase)}
    (product : PatternsProduce program home phase held before patterns results bindings after)
    (actualHeld : List SourcePayload) (actualBefore : Grounded.Context) :
    Grounded.PatternsType program home actualHeld actualBefore patterns (plainResults (results.map Result.type))
      (.produced (plainBindings bindings) actualBefore) := by
  cases product with
  | nil => exact .nil _
  | @cons held before middle after pattern patterns result results front back tail first _ =>
    have tailSource := tail.plainTransition (.plain :: actualHeld) actualBefore
    have firstSource := first.plainTransition (bindingPayloads (plainBindings back) ++ actualHeld) actualBefore
    simpa only [plainBindings, List.map_append, plainResults, List.map_cons] using Grounded.PatternsType.cons tailSource firstSource
end

/-- Inactive alternatives still carry the same complete checking product. Only
execution is excluded by the exact active source head. No new binding payload
or post-state is admitted on this impossible semantic transition. -/
theorem PatternProduces.impossibleSource {held : List (Payload .checking)}
    {before after : Point program .checking} {head active : Head} {patterns : List Pattern}
    {result : Result .checking} {bindings : List (String × Result .checking)}
    (product : PatternProduces program home .checking held before (.node head patterns) result bindings after)
    (actualHeld : List SourcePayload) (actualBefore : Grounded.Context) (payloads : List SourcePayload)
    (different : head ≠ active) :
    Grounded.PatternType program home actualHeld actualBefore (.node head patterns)
      ⟨result.type, .aggregate active payloads⟩ .impossible := by
  cases product with
  | node decomposition children =>
    have projected := children.plainTransition actualHeld actualBefore
    rw [decomposition.types] at projected
    exact .impossible different decomposition.shape decomposition.access projected

structure PatternCheckedEffects (before after : Checked.Context) : Prop where
  names : after.names = before.names
  storage : after.storage = before.storage
  loans : after.loans = before.loans
  binders : after.nextBinder = before.nextBinder
  symbols : after.nextSymbol = before.nextSymbol
  ended : ∃ discarded, after.ended = discarded ++ before.ended

theorem PatternCheckedEffects.refl (context : Checked.Context) : PatternCheckedEffects context context :=
  ⟨rfl, rfl, rfl, rfl, rfl, [], rfl⟩

theorem PatternCheckedEffects.dispose (context : Checked.Context) (payload : Checked.Payload) :
    PatternCheckedEffects context (context.endPayload payload) :=
  ⟨rfl, rfl, rfl, rfl, rfl, [payload], rfl⟩

theorem PatternCheckedEffects.trans {before middle after : Checked.Context}
    (first : PatternCheckedEffects before middle) (second : PatternCheckedEffects middle after) :
    PatternCheckedEffects before after := by
  obtain ⟨discarded, firstEnded⟩ := first.ended
  obtain ⟨more, secondEnded⟩ := second.ended
  exact ⟨second.names.trans first.names, second.storage.trans first.storage,
    second.loans.trans first.loans, second.binders.trans first.binders, second.symbols.trans first.symbols,
    more ++ discarded, by rw [secondEnded, firstEnded, List.append_assoc]⟩

mutual
theorem PatternProduces.checkedEffects {held : List (Payload phase)} {before after : Point program phase}
    {pattern : Pattern} {result : Result phase} {bindings : List (String × Result phase)}
    (product : PatternProduces program home phase held before pattern result bindings after) :
    PatternCheckedEffects before.checked after.checked := by
  cases product with
  | wildcard disposal | literal _ disposal => rw [disposal.checked]; exact .dispose _ _
  | binder => exact .refl _
  | node _ children => exact children.checkedEffects

theorem PatternsProduce.checkedEffects {held : List (Payload phase)} {before after : Point program phase}
    {patterns : List Pattern} {results : List (Result phase)} {bindings : List (String × Result phase)}
    (product : PatternsProduce program home phase held before patterns results bindings after) :
    PatternCheckedEffects before.checked after.checked := by
  cases product with
  | nil => exact .refl _
  | cons tail first _ => exact tail.checkedEffects.trans first.checkedEffects
end



mutual
/-- A path through the selected checking product witnessing why a canonical
plain source payload cannot match. It carries no alternate typing derivation. -/
inductive PatternProduces.PlainImpossible :
    {held : List (Payload phase)} → {before after : Point program phase} →
    {pattern : Pattern} → {result : Result phase} → {bindings : List (String × Result phase)} →
    PatternProduces program home phase held before pattern result bindings after → Prop where
  | reference {held : List (Payload phase)} {before after : Point program phase}
      {pattern : Pattern} {result : Result phase} {bindings : List (String × Result phase)}
      {product : PatternProduces program home phase held before pattern result bindings after}
      {referent : Ty} {mode : BorrowMode} (same : result.type = .reference referent mode) :
      PatternProduces.PlainImpossible product
  | node {held : List (Payload phase)} {before after : Point program phase}
      {result : Result phase} {head : Head} {types : List Ty} {fields : List (Result phase)}
      {patterns : List Pattern} {bindings : List (String × Result phase)}
      {decomposition : PatternDecomposition program home before result head types fields}
      {children : PatternsProduce program home phase held before patterns fields bindings after}
      (nested : PatternsProduce.PlainImpossible children) :
      PatternProduces.PlainImpossible (.node decomposition children)
inductive PatternsProduce.PlainImpossible :
    {held : List (Payload phase)} → {before after : Point program phase} →
    {patterns : List Pattern} → {results : List (Result phase)} → {bindings : List (String × Result phase)} →
    PatternsProduce program home phase held before patterns results bindings after → Prop where
  | head {held : List (Payload phase)} {before middle after : Point program phase}
      {pattern : Pattern} {patterns : List Pattern} {result : Result phase} {results : List (Result phase)}
      {front back : List (String × Result phase)}
      {tail : PatternsProduce program home phase (result.payload :: held) before patterns results back middle}
      {first : PatternProduces program home phase (bindingHeld back ++ held) middle pattern result front after}
      {distinct : ((front ++ back).map Prod.fst).Nodup}
      (nested : PatternProduces.PlainImpossible first) :
      PatternsProduce.PlainImpossible (.cons tail first distinct)
  | tail {held : List (Payload phase)} {before middle after : Point program phase}
      {pattern : Pattern} {patterns : List Pattern} {result : Result phase} {results : List (Result phase)}
      {front back : List (String × Result phase)}
      {tail : PatternsProduce program home phase (result.payload :: held) before patterns results back middle}
      {first : PatternProduces program home phase (bindingHeld back ++ held) middle pattern result front after}
      {distinct : ((front ++ back).map Prod.fst).Nodup}
      (nested : PatternsProduce.PlainImpossible tail) :
      PatternsProduce.PlainImpossible (.cons tail first distinct)
end

mutual
theorem PatternProduces.impossiblePlainSource {held : List (Payload phase)}
    {before after : Point program phase} {pattern : Pattern} {result : Result phase}
    {bindings : List (String × Result phase)}
    {product : PatternProduces program home phase held before pattern result bindings after}
    (failure : product.PlainImpossible) (actualHeld : List SourcePayload) (actualBefore : Grounded.Context) :
    Grounded.PatternType program home actualHeld actualBefore pattern ⟨result.type, .plain⟩ .impossible := by
  cases failure with
  | reference same => rw [same]; exact .plainReference
  | @node held before after result head types fields patterns bindings decomposition children nested =>
    have projected := PatternsProduce.impossiblePlainSource nested actualHeld actualBefore
    rw [decomposition.types] at projected
    exact .plain decomposition.shape decomposition.access projected

theorem PatternsProduce.impossiblePlainSource {held : List (Payload phase)}
    {before after : Point program phase} {patterns : List Pattern} {results : List (Result phase)}
    {bindings : List (String × Result phase)}
    {product : PatternsProduce program home phase held before patterns results bindings after}
    (failure : product.PlainImpossible) (actualHeld : List SourcePayload) (actualBefore : Grounded.Context) :
    Grounded.PatternsType program home actualHeld actualBefore patterns (plainResults (results.map Result.type)) .impossible := by
  cases failure with
  | @head held before middle after pattern patterns result results front back tail first distinct nested =>
    have tailSource := tail.plainTransition (.plain :: actualHeld) actualBefore
    have headSource := PatternProduces.impossiblePlainSource nested (bindingPayloads (plainBindings back) ++ actualHeld) actualBefore
    exact .impossibleHead tailSource headSource
  | @tail held before middle after pattern patterns result results front back tail first distinct nested =>
    have tailSource := PatternsProduce.impossiblePlainSource nested (.plain :: actualHeld) actualBefore
    have headSource := first.plainTransition actualHeld actualBefore
    exact .impossibleTail tailSource headSource
end



theorem PatternProduces.subjectTyped {held : List (Payload phase)} {before after : Point program phase}
    {pattern : Pattern} {result : Result phase} {bindings : List (String × Result phase)}
    (product : PatternProduces program home phase held before pattern result bindings after) :
    result.payload.checked.Typed program result.type := by
  cases product with
  | wildcard disposal | literal _ disposal => exact disposal.typed
  | binder _ _ _ typed _ _ => exact typed
  | node decomposition _ => exact decomposition.typed

mutual
theorem PatternProduces.bindingsTyped {held : List (Payload phase)} {before after : Point program phase}
    {pattern : Pattern} {result : Result phase} {bindings : List (String × Result phase)}
    (product : PatternProduces program home phase held before pattern result bindings after) :
    ∀ entry ∈ bindings, entry.2.payload.checked.Typed program entry.2.type := by
  cases product with
  | wildcard | literal => intro entry member; cases member
  | binder _ _ _ typed _ _ =>
    intro entry member
    have same := List.mem_singleton.mp member
    subst entry
    exact typed
  | node _ children => exact children.bindingsTyped

theorem PatternsProduce.bindingsTyped {held : List (Payload phase)} {before after : Point program phase}
    {patterns : List Pattern} {results : List (Result phase)} {bindings : List (String × Result phase)}
    (product : PatternsProduce program home phase held before patterns results bindings after) :
    ∀ entry ∈ bindings, entry.2.payload.checked.Typed program entry.2.type := by
  cases product with
  | nil => intro entry member; cases member
  | cons tail first _ =>
    intro entry member
    rcases List.mem_append.mp member with front | back
    · exact first.bindingsTyped entry front
    · exact tail.bindingsTyped entry back
end



mutual
theorem PatternProduces.symbols {held : List (Payload phase)} {before after : Point program phase}
    {pattern : Pattern} {result : Result phase} {bindings : List (String × Result phase)}
    (product : PatternProduces program home phase held before pattern result bindings after)
    (executable : phase = .executable) : after.symbols executable = before.symbols executable := by
  cases product with
  | wildcard disposal | literal _ disposal => exact (disposal.actual executable).2.2
  | binder => rfl
  | node _ children => exact children.symbols executable

theorem PatternsProduce.symbols {held : List (Payload phase)} {before after : Point program phase}
    {patterns : List Pattern} {results : List (Result phase)} {bindings : List (String × Result phase)}
    (product : PatternsProduce program home phase held before patterns results bindings after)
    (executable : phase = .executable) : after.symbols executable = before.symbols executable := by
  cases product with
  | nil => rfl
  | cons tail first _ => exact (first.symbols executable).trans (tail.symbols executable)
end

end Grounded.Elaboration

/- Section: StateResultScopes -/
namespace Grounded
set_option autoImplicit false
variable {program : Program}

theorem ResultTyped.resume {interpretation : Interpretation} {caller after : Context}
 {value : Value} {result : ResultType}
 (typed : ResultTyped program interpretation after result value) :
 ResultTyped program interpretation (caller.resume after) result value :=
 ⟨typed.resident, typed.payload, typed.corresponds⟩

theorem ResultTyped.hide {interpretation : Interpretation} {context : Context}
 {value : Value} {result : ResultType}
 (typed : ResultTyped program interpretation context result value) :
 ResultTyped program interpretation context.hide result value :=
 ⟨typed.resident, typed.payload, typed.corresponds⟩

theorem ResultsTyped.hide {interpretation : Interpretation} {context : Context}
 {values : List Value} {results : List ResultType}
 (typed : ResultsTyped program interpretation context results values) :
 ResultsTyped program interpretation context.hide results values := by
 induction typed with
 | nil => exact .nil
 | cons head tail ih => exact .cons head.hide ih

theorem StateProgress.resume {first last : Interpretation} {callerContext afterContext : Context}
 {caller after : Environment} (valid : callerContext.WellFormed program)
 (progress : StateProgress callerContext.hide afterContext caller.hide after first last) :
 StateProgress callerContext (callerContext.resume afterContext) caller (caller.resume after) first last := by
 refine ⟨progress.history.resume, progress.support.resume,
   ⟨progress.interpretation.binders, progress.interpretation.nodes⟩,
   ?_, progress.loanCount⟩
 intro binder fresh mentioned
 rcases Context.resume_mentions mentioned with old | new
 · exact False.elim (Nat.not_lt_of_ge fresh (valid.mentionedBound old))
 · exact progress.fresh binder fresh new

end Grounded

/- Section: StateAggregates -/

namespace Grounded
set_option autoImplicit false
variable {program : Program}

def argumentResult : List ResultType → ResultType
  | [] => ⟨.unit, .plain⟩
  | [result] => result
  | first :: next :: rest =>
      ⟨.tuple first.type ((next :: rest).map ResultType.type),
        .aggregate .tuple (first.payload :: (next :: rest).map ResultType.payload)⟩

theorem ResultTyped.tuple {interpretation : Interpretation} {context : Context}
    {first : ResultType} {rest : List ResultType} {value : Value} {values : List Value}
    (head : ResultTyped program interpretation context first value)
    (tail : ResultsTyped program interpretation context rest values) :
    ResultTyped program interpretation context
      ⟨.tuple first.type (rest.map ResultType.type),
        .aggregate .tuple (first.payload :: rest.map ResultType.payload)⟩ (.tuple value values) :=
  ⟨.tuple head.resident tail.residents,
    .aggregate (by trivial) (.tuple _ _) (.cons head.payload tail.payloads),
    .aggregate (by trivial) rfl (.cons head.corresponds tail.corresponds)⟩

theorem ResultsTyped.array {interpretation : Interpretation} {context : Context}
    {results : List ResultType} {values : List Value} {element : Ty} {length : Nat}
    (typed : ResultsTyped program interpretation context results values)
    (types : results.map ResultType.type = List.replicate length element)
    (finite : FiniteLayout program.target program.data element)
    (size : length < 2 ^ program.target.pointerBits) :
    ResultTyped program interpretation context
      ⟨.array element length, .aggregate .array (results.map ResultType.payload)⟩ (.array values) :=
  ⟨.array (types ▸ typed.residents) finite size,
    .aggregate (by trivial) (.array _ _) (types ▸ typed.payloads),
    .aggregate (by trivial) rfl typed.corresponds⟩

theorem ResultsTyped.nominal {interpretation : Interpretation} {context : Context}
    {results : List ResultType} {values : List Value} {identity : Nat} {tag : Option Nat}
    {declaration : DataDecl} {schema : Fields}
    (typed : ResultsTyped program interpretation context results values)
    (declared : program.data identity = some declaration)
    (chosen : declaration.constructor tag = some schema)
    (finite : FiniteLayout program.target program.data (.nominal identity))
    (types : results.map ResultType.type = schema.residents.map Field.type) :
    ResultTyped program interpretation context
      ⟨.nominal identity, .aggregate (.nominal identity tag) (results.map ResultType.payload)⟩
      (.nominal identity tag values) :=
  ⟨.nominal declared chosen finite (types ▸ typed.residents),
    .aggregate (by trivial) (.nominal declared chosen) (types ▸ typed.payloads),
    .aggregate (by trivial) rfl typed.corresponds⟩

theorem ResultsTyped.argument {interpretation : Interpretation} {context : Context}
    {results : List ResultType} {values : List Value}
    (typed : ResultsTyped program interpretation context results values) :
    ResultTyped program interpretation context (argumentResult results) (argumentValue values) := by
  cases typed with
  | nil => exact ⟨.unit, .plain _, .plain (by trivial)⟩
  | cons head tail =>
    cases tail with
    | nil => exact head
    | cons next rest => exact head.tuple (.cons next rest)

theorem argumentResult_type (results : List ResultType) :
    (argumentResult results).type = argumentType (results.map ResultType.type) := by
  cases results with
  | nil => rfl
  | cons first rest => cases rest <;> rfl

theorem StateTyped.packArgument {interpretation : Interpretation} {context : Context}
    {heldPayloads : List SourcePayload} {held values : List Value} {results : List ResultType}
    {environment : Environment}
    (typed : StateTyped program interpretation context (heldPayloads ++ results.map ResultType.payload)
      environment (held ++ values))
    (residents : ResultsTyped program interpretation context results values) :
    StateTyped program interpretation context (heldPayloads ++ [(argumentResult results).payload])
      environment (held ++ [argumentValue values]) := by
  cases residents with
  | nil => simpa [argumentResult, argumentValue] using typed.appendPlain (value := .unit) (by trivial)
  | cons first rest =>
    cases rest with
    | nil => exact typed
    | cons next tail => exact typed.pack (first.tuple (.cons next tail)).corresponds

theorem StateTyped.unpackArgument {interpretation : Interpretation} {context : Context}
    {heldPayloads : List SourcePayload} {held values : List Value} {results : List ResultType}
    {environment : Environment}
    (typed : StateTyped program interpretation context (heldPayloads ++ [(argumentResult results).payload])
      environment (held ++ [argumentValue values]))
    (residents : ResultsTyped program interpretation context results values) :
    StateTyped program interpretation context (heldPayloads ++ results.map ResultType.payload)
      environment (held ++ values) := by
  cases residents with
  | nil => simpa using typed.dropPlain
  | cons first rest =>
    cases rest with
    | nil => exact typed
    | cons next tail => exact typed.unpack

private theorem pending_extract {values : List Value} {index : Nat} {selected : Value}
    (found : values[index]? = some selected) :
    (values ++ [Value.vacant]).Perm (selected :: values.set index .vacant) := by
  induction values generalizing index with
  | nil => simp at found
  | cons first rest ih =>
    cases index with
    | zero =>
      cases Option.some.inj found
      exact (List.perm_append_comm (l₁ := rest) (l₂ := [Value.vacant])).cons selected
    | succ index =>
      exact ((ih found).cons first).trans (.swap _ _ _)

private theorem selected_nodes {parent selected : SourcePayload} {index node : Nat}
    (selection : parent.select [index] = some selected) (member : node ∈ selected.nodes) :
    node ∈ parent.nodes := by
  cases parent with
  | plain =>
    simp only [SourcePayload.select, Option.some.injEq] at selection
    subst selected
    exact member
  | reference identity => simp [SourcePayload.select] at selection
  | aggregate head fields =>
    have found : fields[index]? = some selected := by simpa [SourcePayload.select] using selection
    exact payloadNodes_mem.mpr ⟨selected, List.mem_of_getElem? found, member⟩

theorem StateTyped.field {interpretation : Interpretation} {context : Context} {home : Module}
    {heldPayloads : List SourcePayload} {held : List Value} {environment : Environment}
    {parent : ResultType} {value : Value} {key : FieldKey} {index : Nat} {type : Ty}
    {selected remainder : SourcePayload}
    (typed : StateTyped program interpretation context (heldPayloads ++ [parent.payload])
      environment (held ++ [value]))
    (resident : ResultTyped program interpretation context parent value)
    (projection : ProjectionType program home parent.type key index type)
    (selection : parent.payload.select [index] = some selected)
    (write : SourcePayload.Write program parent.type [index] parent.payload .plain remainder)
    (discard : StorageDisposition program (Initialization.full.setChild index .vacant) parent.type)
    (legal : context.PayloadDisposable program (heldPayloads ++ [selected]) remainder) :
    ∃ extracted residual after,
      value.readField program key = some extracted ∧
      value.takeField program key = some residual ∧
      value.writeIndices [index] .vacant = some residual ∧
      Environment.Disposes program environment residual after ∧
      ResultTyped program interpretation (context.dispose remainder) ⟨type, selected⟩ extracted ∧
      StateTyped program interpretation (context.dispose remainder) (heldPayloads ++ [selected])
        after (held ++ [extracted]) ∧
      StateProgress context (context.dispose remainder) environment after interpretation interpretation := by
  obtain ⟨extracted, indexed, found, selectedTyped, replace⟩ := projection.access resident.resident
  obtain ⟨residual, replaced, residualTyped⟩ := replace .vacant .vacant .vacant
  have canonical : CanonicalPath program parent.type [index] type := .cons projection (.nil _)
  have read : value.readIndices [index] = some extracted := by simp [Value.readIndices, found]
  have written : value.writeIndices [index] .vacant = some residual := by
    simp [Value.writeIndices, found, replaced]
  have selectedRelated := resident.corresponds.select selection read
  have selectedResult : ResultTyped program interpretation context ⟨type, selected⟩ extracted :=
    ⟨selectedTyped, resident.payload.select canonical selection, selectedRelated⟩
  have residualRelated := write.corresponds resident.resident (Initialization.Access.full [index])
    resident.corresponds (SourcePayload.Corresponds.plain (node := interpretation.node) (by trivial)) written
  have residualPayload := write.typed resident.payload canonical (.plain type)
  obtain ⟨after, disposed, stored⟩ := typed.toStoreTyped.dispose residualRelated
    (fun _ member => residualPayload.node_bound member) legal.restored (discard.realized residualTyped)
  have progress : StateProgress context (context.dispose remainder) environment after interpretation interpretation :=
    StateProgress.dispose typed.source disposed
  have length : heldPayloads.length = held.length := by
    simpa only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] using typed.heldShape.length
  have front := (typed.heldShape.append_inv length).1
  have memberBefore : ∀ node ∈ payloadNodes (heldPayloads ++ [selected]),
      node ∈ payloadNodes (heldPayloads ++ [parent.payload]) := by
    intro node member
    simp only [payloadNodes_append, payloadNodes, List.append_nil, List.mem_append] at member ⊢
    exact member.imp id (selected_nodes selection)
  obtain ⟨head, fields, signature⟩ := projection.signature
  obtain ⟨source, constructor, _⟩ := projection.payloadShell signature resident.resident (by trivial)
  have sourceValue : value.head.Source := constructor ▸ source
  have residualShape := Value.replaceChild_shape replaced
  have sourceResidual : residual.head.Source := residualShape.1 ▸ sourceValue
  have unpacked := typed.custody.unpack sourceValue
  have extended := unpacked.appendInactive (value := .vacant)
    (fun node _ _ _ path => (show Value.ReferenceFree .vacant from trivial).noReference path node)
  have rearranged : Custody environment ((held ++ [extracted]) ++ residual.children) := by
    rw [residualShape.2, List.append_assoc]
    exact extended.permPending (by
      simpa only [List.append_assoc, List.singleton_append] using
        (pending_extract found).append_left held)
  have custody := rearranged.pack sourceResidual
  refine ⟨extracted, residual, after, ?_, ?_, written, disposed,
    selectedResult.transport progress.history progress.interpretation, ?_, progress⟩
  · simp [Value.readField, indexed, found]
  · simp [Value.takeField, indexed, found, replaced]
  · exact { stored with
      heldShape := front.append (.cons selectedRelated .nil)
      heldOwn := fun node member => (typed.heldOwn node (memberBefore node member)).dispose_of_not_mem
        (fun old => legal.excludes node old member)
      heldReady := fun node member => (typed.heldReady node (memberBefore node member)).dispose remainder
      observedOwn := typed.observedOwn.dispose legal
      custody := custody.disposePending disposed }

end Grounded


/- Section: ElaborationCleanup -/
namespace Grounded.Checked
set_option autoImplicit false
variable {program : Program}

def Context.disposeBindings : Context → List (String × Slot) → Context
  | context, [] => context
  | context, (_, slot) :: bindings =>
      (context.endPayload slot.payload).disposeBindings bindings

def Context.cleanup (context : Context) (count : Nat) : Context :=
  (context.disposeBindings (context.bindings.take count)).retire count

inductive DisposeBindings (program : Program) (held : List Payload) :
    Context → List (String × Slot) → Context → Type where
  | nil (context : Context) : DisposeBindings program held context [] context
  | cons {context after : Context} {name : String} {slot : Slot}
      {bindings : List (String × Slot)}
      (disposition : StorageDisposition program slot.initialization slot.type)
      (free : context.LocalFree (program := program) ⟨.binder slot.binder, []⟩)
      (disposable : context.CanDispose (program := program) held slot.payload)
      (rest : DisposeBindings program held (context.endPayload slot.payload) bindings after) :
      DisposeBindings program held context ((name, slot) :: bindings) after

inductive Cleanup (program : Program) (before : Context) (held : List Payload)
    (count : Nat) : Context → Type where
  | retire {disposed : Context}
      (bindings : DisposeBindings program held before (before.bindings.take count) disposed) :
      Cleanup program before held count (disposed.retire count)

theorem DisposeBindings.result_eq {held : List Payload} {before after : Context}
    {bindings : List (String × Slot)}
    (product : DisposeBindings program held before bindings after) :
    after = before.disposeBindings bindings := by
  induction product with
  | nil => rfl
  | cons _ _ _ _ ih => exact ih

theorem DisposeBindings.deterministic {held : List Payload} {before first second : Context}
    {bindings : List (String × Slot)}
    (left : DisposeBindings program held before bindings first)
    (right : DisposeBindings program held before bindings second) : first = second :=
  left.result_eq.trans right.result_eq.symm

theorem Cleanup.result_eq {held : List Payload} {before after : Context} {count : Nat}
    (product : Cleanup program before held count after) : after = before.cleanup count := by
  cases product with
  | retire bindings => exact congrArg (fun context => context.retire count) bindings.result_eq

theorem Cleanup.deterministic {held : List Payload} {before first second : Context} {count : Nat}
    (left : Cleanup program before held count first)
    (right : Cleanup program before held count second) : first = second :=
  left.result_eq.trans right.result_eq.symm

end Grounded.Checked
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {phase : Phase}

structure CleanupStep (program : Program) {phase : Phase} (before after : Point program phase)
    (held : List (Payload phase)) (count : Nat) : Prop where
  checked : Nonempty (Checked.Cleanup program before.checked (checkedPayloads held) count after.checked)
  actual : Required phase fun executable =>
    (before.source executable).Cleanable program (sourcePayloads held executable)
      ((before.source executable).bindings.take count) ∧
    after.source executable = (before.source executable).cleanup count

theorem CleanupStep.erase {before after : Point program phase} {held : List (Payload phase)}
    {count : Nat} (step : CleanupStep program before after held count) :
    CleanupStep program before.erase after.erase (held.map Payload.erase) count where
  checked := by
    simpa only [checkedPayloads, List.map_map, Function.comp_def, Payload.erase, Point.erase]
      using step.checked
  actual := fun executable => nomatch executable

theorem CleanupStep.checked_eq {before after : Point program phase} {held : List (Payload phase)}
    {count : Nat} (step : CleanupStep program before after held count) :
    after.checked = before.checked.cleanup count := by
  obtain ⟨product⟩ := step.checked
  exact product.result_eq

theorem CleanupStep.source {before after : Point program phase} {held : List (Payload phase)}
    {count : Nat} (step : CleanupStep program before after held count)
    (executable : phase = .executable) :
    (before.source executable).Cleanable program (sourcePayloads held executable)
      ((before.source executable).bindings.take count) ∧
    after.source executable = (before.source executable).cleanup count :=
  step.actual executable

theorem CleanupStep.cleanup {before after : Point program phase} {held : List (Payload phase)}
    {count : Nat} (step : CleanupStep program before after held count)
    (executable : phase = .executable) {interpretation : Interpretation}
    {environment : Environment} {values : List Value}
    (typed : StateTyped program interpretation (before.source executable)
      (sourcePayloads held executable) environment values) :
    ∃ final trace, Cleans program count environment trace final ∧
      StateTyped program interpretation (after.source executable)
        (sourcePayloads held executable) final values := by
  obtain ⟨final, trace, cleaned, finalTyped⟩ := typed.cleanup count (step.source executable).1
  exact ⟨final, trace, cleaned, (step.source executable).2.symm ▸ finalTyped⟩

theorem CleanupStep.cleanup_heldUsable {before after : Point program phase}
    {held : List (Payload phase)} {count : Nat}
    (step : CleanupStep program before after held count) (executable : phase = .executable)
    {interpretation : Interpretation} {environment : Environment} {values : List Value}
    (typed : StateTyped program interpretation (before.source executable)
      (sourcePayloads held executable) environment values) :
    ∃ final trace, Cleans program count environment trace final ∧
      StateTyped program interpretation (after.source executable)
        (sourcePayloads held executable) final values ∧
      ∀ (index : Nat) (value : Value), values[index]? = some value → final.ResultUsable value := by
  obtain ⟨final, trace, cleaned, finalTyped⟩ := step.cleanup executable typed
  exact ⟨final, trace, cleaned, finalTyped, fun _ _ found => finalTyped.heldUsable found⟩

end Grounded.Elaboration

/- Section: ElaborationViews -/
namespace Grounded.Checked
set_option autoImplicit false

/-- Hypothetical checking metadata only. Executable ContextMeaning forbids
referent cells; actual views query existing canonical binder storage instead. -/
def Context.installView (context : Context) (original : Reference) (referent : Ty)
    (mutable : Bool) (payload : Payload) : Context :=
  { context with
    storage := fun base => if base = .referent original then
      some ⟨⟨referent, mutable, .full⟩, 0, payload⟩ else context.storage base }

@[simp] theorem Context.installView_storage_self (context : Context) (original : Reference)
    (referent : Ty) (mutable : Bool) (payload : Payload) :
    (context.installView original referent mutable payload).storage (.referent original) =
      some ⟨⟨referent, mutable, .full⟩, 0, payload⟩ := by
  simp [Context.installView]

@[simp] theorem Context.installView_storage_other (context : Context) (original : Reference)
    (referent : Ty) (mutable : Bool) (payload : Payload) (base : Base)
    (different : base ≠ .referent original) :
    (context.installView original referent mutable payload).storage base = context.storage base := by
  simp [Context.installView, different]

end Grounded.Checked
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {home : Module} {phase : Phase}

/-- Dormant checking can retain an abstract referent schema. Such a cell cannot
inhabit an executable Point: that Point's meaning forbids opaque mask caches. -/
structure OpaqueViewStep (program : Program) (home : Module) {phase : Phase}
    (before after : Point program phase) (referencePlace : Place) where
  symbol : Checked.Reference
  original : Checked.Reference
  referent : Ty
  mode : BorrowMode
  selection : Checked.PlaceSelection program home before.checked referencePlace
    ⟨.reference referent mode, .reference symbol referent mode⟩
  available : before.checked.ResourcesAvailable (program := program) (.reference symbol referent mode)
  canonical : before.checked.referenceTarget symbol = ⟨.referent original, []⟩
  absent : before.checked.storage (.referent original) = none
  checked : after.checked =
    (before.checked.installView original referent (mode == .unique)
      (Checked.Payload.input before.checked.nextSymbol [] referent [] .unknown)).advanceSymbol
  stable : PointsStable before after

/-- A canonical view is a lens into the already declared target of a selected
handle. Its whole root, prefix, and current mask are read, never chosen afresh or
reset. In particular, a unique target may be masked and aliases share one cell. -/
structure CanonicalView (program : Program) (home : Module) {phase : Phase}
    (point : Point program phase) (referencePlace : Place) where
  symbol : Checked.Reference
  referent : Ty
  mode : BorrowMode
  selection : Checked.PlaceSelection program home point.checked referencePlace
    ⟨.reference referent mode, .reference symbol referent mode⟩
  available : point.checked.NotEnded (program := program) symbol
  binder : Nat
  fields : List Nat
  root : Checked.Slot
  state : Initialization
  target : point.checked.referenceTarget symbol = ⟨.binder binder, fields⟩
  stored : point.checked.storage (.binder binder) = some root
  path : CanonicalPath program root.type fields referent
  mask : root.initialization.Access fields state

/-- Both branches are preserved by erasure. Only the canonical lens can occur
on an executable path; it changes no cell, target, name, history, or supply. -/
inductive ViewStep (program : Program) (home : Module) {phase : Phase} :
    Point program phase → Point program phase → Place → Type where
  | hypothetical {before after : Point program phase} {referencePlace : Place}
      (step : OpaqueViewStep program home before after referencePlace) :
      ViewStep program home before after referencePlace
  | canonical {point : Point program phase} {referencePlace : Place}
      (view : CanonicalView program home point referencePlace) :
      ViewStep program home point point referencePlace

namespace OpaqueViewStep
variable {before after : Point program phase} {referencePlace : Place}

def erase (step : OpaqueViewStep program home before after referencePlace) :
    OpaqueViewStep program home before.erase after.erase referencePlace where
  symbol := step.symbol
  original := step.original
  referent := step.referent
  mode := step.mode
  selection := step.selection
  available := step.available
  canonical := step.canonical
  absent := step.absent
  checked := step.checked
  stable := PointsStable.erase

theorem installed (step : OpaqueViewStep program home before after referencePlace) :
    after.checked.storage (.referent step.original) =
      some ⟨⟨step.referent, step.mode == .unique, .full⟩, 0,
        Checked.Payload.input before.checked.nextSymbol [] step.referent [] .unknown⟩ := by
  rw [step.checked]
  simp [Checked.Context.advanceSymbol]

theorem not_executable (step : OpaqueViewStep program home before after referencePlace)
    (executable : phase = .executable) : False := by
  cases executable
  have absent := after.meaning.related.noOpaqueCells step.original
  rw [step.installed] at absent
  cases absent

theorem storage_other (step : OpaqueViewStep program home before after referencePlace)
    (base : Checked.Base) (different : base ≠ .referent step.original) :
    after.checked.storage base = before.checked.storage base := by
  rw [step.checked]
  simp [Checked.Context.advanceSymbol, different]

theorem metadata_only (step : OpaqueViewStep program home before after referencePlace) :
    after.checked.names = before.checked.names ∧
    after.checked.loans = before.checked.loans ∧
    after.checked.ended = before.checked.ended ∧
    after.checked.nextBinder = before.checked.nextBinder ∧
    after.checked.nextSymbol = before.checked.nextSymbol + 1 ∧
    (∀ identity, after.checked.storage (.binder identity) = before.checked.storage (.binder identity)) := by
  rw [step.checked]
  simp [Checked.Context.advanceSymbol, Checked.Context.installView]

theorem notEnded_iff (step : OpaqueViewStep program home before after referencePlace)
    (reference : Checked.Reference) :
    after.checked.NotEnded (program := program) reference ↔
      before.checked.NotEnded (program := program) reference := by
  rw [step.checked]
  rfl

theorem no_reinstall (step : OpaqueViewStep program home before after referencePlace)
    {next : Point program phase} {otherPlace : Place}
    (nextStep : OpaqueViewStep program home after next otherPlace) :
    nextStep.original ≠ step.original := by
  intro equal
  have absent := nextStep.absent
  rw [equal, step.installed] at absent
  cases absent

theorem no_subfield (step : OpaqueViewStep program home before after referencePlace)
    {original : Checked.Reference} {fields : List Nat}
    (target : before.checked.referenceTarget step.symbol = ⟨.referent original, fields⟩) :
    original = step.original ∧ fields = [] := by
  have equal := target.symm.trans step.canonical
  cases equal
  exact ⟨rfl, rfl⟩
end OpaqueViewStep

namespace CanonicalView
variable {point : Point program phase} {referencePlace : Place}

def erase (view : CanonicalView program home point referencePlace) :
    CanonicalView program home point.erase referencePlace where
  symbol := view.symbol
  referent := view.referent
  mode := view.mode
  selection := view.selection
  available := view.available
  binder := view.binder
  fields := view.fields
  root := view.root
  state := view.state
  target := view.target
  stored := view.stored
  path := view.path
  mask := view.mask

/-- The lens reports the current authoritative whole-root mask, not a cached
per-reference mask. No restoration or complete-mask premise is required. -/
theorem exact_view (view : CanonicalView program home point referencePlace)
    (executable : phase = .executable) :
    ∃ actual, (point.source executable).storage (.binder ((point.symbols executable).binder view.binder)) = some actual ∧
      actual.type = view.root.type ∧ actual.initialization = view.root.initialization ∧
      actual.initialization.Access view.fields view.state := by
  cases executable
  obtain ⟨actual, stored, type, _, _, mask, _⟩ :=
    point.meaning.related.cells (.binder view.binder) view.root
      (.binder (point.meaning.symbols.binder view.binder)) view.stored rfl
  exact ⟨actual, stored, type, mask, mask ▸ view.mask⟩

/-- Two canonical lens roots denoting the same source root are the very same
checked cell. References and field paths need not be equal. -/
theorem aliased_root {otherPlace : Place}
    (left : CanonicalView program home point referencePlace)
    (right : CanonicalView program home point otherPlace)
    (executable : phase = .executable)
    (same : (point.symbols executable).binder left.binder = (point.symbols executable).binder right.binder) :
    left.binder = right.binder := by
  cases executable
  exact point.meaning.related.rootIdentity _ _ (.inl ⟨_, left.stored⟩) (.inl ⟨_, right.stored⟩) same
end CanonicalView

namespace ViewStep
variable {before after : Point program phase} {referencePlace : Place}

def erase (step : ViewStep program home before after referencePlace) :
    ViewStep program home before.erase after.erase referencePlace := by
  cases step with
  | hypothetical step => exact .hypothetical step.erase
  | canonical view => exact .canonical view.erase

theorem selection_found (step : ViewStep program home before after referencePlace) :
    ∃ slot, lookup referencePlace.root before.checked.bindings = some slot := by
  cases step with
  | hypothetical step => exact ⟨_, step.selection.found⟩
  | canonical view => exact ⟨_, view.selection.found⟩

/-- Every executable view is a lens-only query of an existing canonical cell. -/
theorem executable_lens (step : ViewStep program home before after referencePlace)
    (executable : phase = .executable) :
    after = before ∧ Nonempty (CanonicalView program home before referencePlace) := by
  cases step with
  | hypothetical step => exact False.elim (step.not_executable executable)
  | canonical view => exact ⟨rfl, ⟨view⟩⟩

theorem source_eq (step : ViewStep program home before after referencePlace)
    (executable : phase = .executable) : after.source executable = before.source executable := by
  rw [(step.executable_lens executable).1]

theorem source_transport (step : ViewStep program home before after referencePlace)
    (executable : phase = .executable) {motive : Grounded.Context → Prop}
    (consumer : motive (after.source executable)) : motive (before.source executable) := by
  simpa only [step.source_eq executable] using consumer

/-- Unlike a hypothetical opaque schema installation, an executable view leaves
all checking storage, targets, endings, and both identity supplies unchanged. -/
theorem metadata_only (step : ViewStep program home before after referencePlace)
    (executable : phase = .executable) : after.checked = before.checked := by
  rw [(step.executable_lens executable).1]
end ViewStep
end Grounded.Elaboration
/- Section: ElaborationDormant -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {home : Module} {symbols : Symbols}

mutual
/-- A failure path through the exact checking product, against the independently
chosen source-shape product. No execution, matching, or alternate typing is
admitted by this witness. -/
inductive PatternProduces.ImpossibleAgainst :
    {held : List (Payload .checking)} → {before after : Point program .checking} →
    {pattern : Pattern} → {result : Result .checking} →
    {bindings : List (String × Result .checking)} →
    PatternProduces program home .checking held before pattern result bindings after →
      Checked.Payload → Prop where
  | different {held : List (Payload .checking)} {before after : Point program .checking}
      {result : Result .checking} {head active : Head} {types : List Ty}
      {fields : List (Result .checking)} {patterns : List Pattern}
      {bindings : List (String × Result .checking)} {actualFields : List Checked.Payload}
      {decomposition : PatternDecomposition program home before result head types fields}
      {children : PatternsProduce program home .checking held before patterns fields bindings after}
      (different : head ≠ active) :
      PatternProduces.ImpossibleAgainst (.node decomposition children) (.aggregate active actualFields)
  | plain {held : List (Payload .checking)} {before after : Point program .checking}
      {pattern : Pattern} {result : Result .checking} {bindings : List (String × Result .checking)}
      {product : PatternProduces program home .checking held before pattern result bindings after}
      (failure : product.PlainImpossible) :
      PatternProduces.ImpossibleAgainst product .plain
  | schemaPlain {held : List (Payload .checking)} {before after : Point program .checking}
      {pattern : Pattern} {result : Result .checking} {bindings : List (String × Result .checking)}
      {product : PatternProduces program home .checking held before pattern result bindings after}
      {owner : Nat} {path : List Checked.Component} {copies : List Nat}
      (failure : product.PlainImpossible) :
      PatternProduces.ImpossibleAgainst product (.schema owner path result.type copies .referenceFree)
  | node {held : List (Payload .checking)} {before after : Point program .checking}
      {result : Result .checking} {head : Head} {types : List Ty}
      {fields : List (Result .checking)} {patterns : List Pattern}
      {bindings : List (String × Result .checking)} {actualFields : List Checked.Payload}
      {decomposition : PatternDecomposition program home before result head types fields}
      {children : PatternsProduce program home .checking held before patterns fields bindings after}
      (nested : PatternsProduce.ImpossibleAgainst children actualFields) :
      PatternProduces.ImpossibleAgainst (.node decomposition children) (.aggregate head actualFields)
/-- Failure follows the selected producer's tail-first tree. The sibling products
remain the original complete checking derivations. -/
inductive PatternsProduce.ImpossibleAgainst :
    {held : List (Payload .checking)} → {before after : Point program .checking} →
    {patterns : List Pattern} → {results : List (Result .checking)} →
    {bindings : List (String × Result .checking)} →
    PatternsProduce program home .checking held before patterns results bindings after →
      List Checked.Payload → Prop where
  | head {held : List (Payload .checking)} {before middle after : Point program .checking}
      {pattern : Pattern} {patterns : List Pattern} {result : Result .checking}
      {results : List (Result .checking)} {front back : List (String × Result .checking)}
      {tail : PatternsProduce program home .checking (result.payload :: held) before patterns results back middle}
      {first : PatternProduces program home .checking (bindingHeld back ++ held) middle pattern result front after}
      {distinct : ((front ++ back).map Prod.fst).Nodup}
      {actual : Checked.Payload} {actuals : List Checked.Payload}
      (nested : PatternProduces.ImpossibleAgainst first actual) :
      PatternsProduce.ImpossibleAgainst (.cons tail first distinct) (actual :: actuals)
  | tail {held : List (Payload .checking)} {before middle after : Point program .checking}
      {pattern : Pattern} {patterns : List Pattern} {result : Result .checking}
      {results : List (Result .checking)} {front back : List (String × Result .checking)}
      {tail : PatternsProduce program home .checking (result.payload :: held) before patterns results back middle}
      {first : PatternProduces program home .checking (bindingHeld back ++ held) middle pattern result front after}
      {distinct : ((front ++ back).map Prod.fst).Nodup}
      {actual : Checked.Payload} {actuals : List Checked.Payload}
      (nested : PatternsProduce.ImpossibleAgainst tail actuals) :
      PatternsProduce.ImpossibleAgainst (.cons tail first distinct) (actual :: actuals)
end

mutual
/-- Plain failure is a consequence of the checking product and the resident
 type, not an independent pattern admission. -/
theorem PatternProduces.plainImpossibleNoMatch
    {held : List (Payload .checking)} {before after : Point program .checking}
    {pattern : Pattern} {result : Result .checking} {bindings : List (String × Result .checking)}
    {product : PatternProduces program home .checking held before pattern result bindings after}
    (failure : product.PlainImpossible) {value : Value}
    (typed : ValueHasType program value result.type) (free : value.ReferenceFree) :
    pattern.matchValue value = none := by
  cases failure with
  | reference same =>
    rw [same] at typed
    cases typed
    cases free
  | @node held before after result head types fields patterns bindings decomposition children nested =>
    simp only [Pattern.matchValue]
    split
    next same =>
      obtain ⟨actual, actualShape, residents⟩ := typed.decompose
      rw [← same] at actualShape
      have aligned := decomposition.shape.fields_unique actualShape
      subst actual
      rw [← decomposition.types] at residents
      exact PatternsProduce.plainImpossibleNoMatch nested residents
        (valuesReferenceFree_iff.mp (Value.referenceFree_iff_head_children.mp free).2)
    next different => rfl

theorem PatternsProduce.plainImpossibleNoMatch
    {held : List (Payload .checking)} {before after : Point program .checking}
    {patterns : List Pattern} {results : List (Result .checking)}
    {bindings : List (String × Result .checking)}
    {product : PatternsProduce program home .checking held before patterns results bindings after}
    (failure : product.PlainImpossible) {values : List Value}
    (typed : ValuesHaveTypes program values (results.map Result.type))
    (free : ∀ value ∈ values, value.ReferenceFree) :
    matchPatterns patterns values = none := by
  cases failure with
  | head nested =>
    cases typed with
    | cons first rest =>
      have failed := PatternProduces.plainImpossibleNoMatch nested first (free _ (by simp))
      simp [matchPatterns, failed]
  | tail nested =>
    cases typed with
    | cons first rest =>
      have failed := PatternsProduce.plainImpossibleNoMatch nested rest
        (fun value member => free value (by simp [member]))
      simp [matchPatterns, failed]
end

mutual
/-- A dormant failure excludes the existing runtime matcher for every resident
of the selected concrete source product. Siblings need no disposal evidence:
the rejected branch never executes them. -/
theorem PatternProduces.impossibleAgainstNoMatch
    {held : List (Payload .checking)} {before after : Point program .checking}
    {pattern : Pattern} {result : Result .checking} {bindings : List (String × Result .checking)}
    {product : PatternProduces program home .checking held before pattern result bindings after}
    {actual : Checked.Payload} (failure : product.ImpossibleAgainst actual)
    {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols .full actual result.type concrete)
    {node : Nat → Nat} {value : Value}
    (typed : ValueHasType program value result.type)
    (corresponds : concrete.Corresponds node value) :
    pattern.matchValue value = none := by
  cases failure with
  | different different =>
    cases meaning with
    | aggregate source shape fields =>
      cases corresponds with
      | aggregate source constructor children =>
        simp [Pattern.matchValue, constructor, different]
  | plain failure =>
    cases meaning with
    | plain layout =>
      cases corresponds with
      | plain free => exact PatternProduces.plainImpossibleNoMatch failure typed free
  | schemaPlain failure =>
    have plain := meaning.schema_referenceFree_plain
    subst concrete
    cases corresponds with
    | plain free => exact PatternProduces.plainImpossibleNoMatch failure typed free
  | @node held before after result head types fields patterns bindings actualFields decomposition children nested =>
    cases meaning with
    | aggregate source shape fieldsMeaning =>
      have aligned := decomposition.shape.fields_unique shape
      cases aligned
      cases corresponds with
      | aggregate source constructor fieldCorresponds =>
        obtain ⟨actualTypes, actualShape, residents⟩ := typed.decompose
        rw [constructor] at actualShape
        have aligned := decomposition.shape.fields_unique actualShape
        subst actualTypes
        rw [← decomposition.types] at fieldsMeaning residents
        have failed := PatternsProduce.impossibleAgainstNoMatch nested fieldsMeaning residents fieldCorresponds
        simpa [Pattern.matchValue, constructor] using failed

theorem PatternsProduce.impossibleAgainstNoMatch
    {held : List (Payload .checking)} {before after : Point program .checking}
    {patterns : List Pattern} {results : List (Result .checking)}
    {bindings : List (String × Result .checking)}
    {product : PatternsProduce program home .checking held before patterns results bindings after}
    {actuals : List Checked.Payload} (failure : product.ImpossibleAgainst actuals)
    {concretes : List SourcePayload}
    (meaning : PayloadMeanings program symbols (fun _ => .full) actuals (results.map Result.type) concretes)
    {node : Nat → Nat} {values : List Value}
    (typed : ValuesHaveTypes program values (results.map Result.type))
    (corresponds : PayloadsCorrespond node concretes values) :
    matchPatterns patterns values = none := by
  cases failure with
  | head nested =>
    cases meaning with
    | cons firstMeaning restMeaning =>
      cases corresponds with
      | cons firstCorresponds restCorresponds =>
        cases typed with
        | cons first rest =>
          have failed := PatternProduces.impossibleAgainstNoMatch nested firstMeaning first firstCorresponds
          simp [matchPatterns, failed]
  | tail nested =>
    cases meaning with
    | cons firstMeaning restMeaning =>
      cases corresponds with
      | cons firstCorresponds restCorresponds =>
        cases typed with
        | cons first rest =>
          have failed := PatternsProduce.impossibleAgainstNoMatch nested restMeaning rest restCorresponds
          simp [matchPatterns, failed]
end

end Grounded.Elaboration

/- Section: ElaborationReturnContract -/
namespace Grounded.Elaboration
set_option autoImplicit false
variable {program : Program} {symbols : Symbols}

/-- Constructor alternatives are exclusive only below the same exact prefix.
Different field positions are simultaneous, even when their symbols alias. -/
inductive ConstructorExclusive : List Checked.Component → List Checked.Component → Prop where
  | choice {left right : Head} {first second : List Checked.Component}
      (different : left ≠ right) :
      ConstructorExclusive (.constructor left :: first) (.constructor right :: second)
  | common (component : Checked.Component) {first second : List Checked.Component}
      (nested : ConstructorExclusive first second) :
      ConstructorExclusive (component :: first) (component :: second)

private theorem ConstructorExclusive.strip {component : Checked.Component}
    {first second : List Checked.Component}
    (exclusive : ConstructorExclusive (component :: first) (component :: second)) :
    ConstructorExclusive first second := by
  cases exclusive with
  | choice different => exact False.elim (different rfl)
  | common _ nested => exact nested

private theorem ConstructorExclusive.field_eq {left right : Nat}
    {first second : List Checked.Component}
    (exclusive : ConstructorExclusive (.field left :: first) (.field right :: second)) :
    left = right := by
  cases exclusive
  rfl

/-- The declared paths may select different constructor alternatives, but cannot
select two different simultaneously resident reference occurrences. -/
def DeclaredReturnCapacity (program : Program) (type : Ty) : Prop :=
  ∀ {first second : List Checked.Component} {left right : Ty} {leftMode rightMode : BorrowMode},
    Checked.ReferencePath program type first left leftMode →
    Checked.ReferencePath program type second right rightMode →
    first = second ∨ ConstructorExclusive first second

private theorem DeclaredReturnCapacity.child {type child : Ty} {head : Head} {types : List Ty}
    {index : Nat} (capacity : DeclaredReturnCapacity program type)
    (source : head.Source) (shape : HeadType program head type types)
    (selected : types[index]? = some child) : DeclaredReturnCapacity program child := by
  intro first second left right leftMode rightMode firstPath secondPath
  rcases capacity (.child source shape selected firstPath) (.child source shape selected secondPath) with
    same | exclusive
  · exact Or.inl (List.cons.inj (List.cons.inj same).2).2
  · exact Or.inr exclusive.strip.strip

private theorem DeclaredReturnCapacity.field_unique {type left right : Ty} {head : Head}
    {types : List Ty} {first second : Nat} {leftPath rightPath : List Checked.Component}
    {leftReferent rightReferent : Ty} {leftMode rightMode : BorrowMode}
    (capacity : DeclaredReturnCapacity program type)
    (source : head.Source) (shape : HeadType program head type types)
    (leftSelected : types[first]? = some left) (rightSelected : types[second]? = some right)
    (leftFound : Checked.ReferencePath program left leftPath leftReferent leftMode)
    (rightFound : Checked.ReferencePath program right rightPath rightReferent rightMode) :
    first = second := by
  rcases capacity (.child source shape leftSelected leftFound)
      (.child source shape rightSelected rightFound) with same | exclusive
  · exact Checked.Component.field.inj (List.cons.inj (List.cons.inj same).2).1
  · exact exclusive.strip.field_eq

mutual
/-- Positive occurrence capacity. Source-empty knowledge counts zero, one
explicit reference counts one, and aggregate field positions are retained. -/
inductive Payload.ReturnCapacity (program : Program) : Checked.Payload → Prop where
  | empty {payload : Checked.Payload} (free : Payload.NoHandles payload) : Payload.ReturnCapacity program payload
  | reference (reference : Checked.Reference) (referent : Ty) (mode : BorrowMode) :
      Payload.ReturnCapacity program (.reference reference referent mode)
  | aggregate {head : Head} {fields : List Checked.Payload}
      (children : PayloadsReturnCapacity program fields) : Payload.ReturnCapacity program (.aggregate head fields)
  | schema {owner : Nat} {path : List Checked.Component} {type : Ty} {copies : List Nat}
      (declared : DeclaredReturnCapacity program type) :
      Payload.ReturnCapacity program (.schema owner path type copies .unknown)
inductive PayloadsReturnCapacity (program : Program) : List Checked.Payload → Prop where
  | nil : PayloadsReturnCapacity program []
  | head {first : Checked.Payload} {rest : List Checked.Payload}
      (capacity : Payload.ReturnCapacity program first) (free : PayloadsNoHandles rest) :
      PayloadsReturnCapacity program (first :: rest)
  | tail {first : Checked.Payload} {rest : List Checked.Payload}
      (free : Payload.NoHandles first) (capacity : PayloadsReturnCapacity program rest) :
      PayloadsReturnCapacity program (first :: rest)
end

mutual
theorem Payload.NoHandles.nodes_eq_nil {payload : Checked.Payload} {state : Initialization}
    {type : Ty} {concrete : SourcePayload} (free : Payload.NoHandles payload)
    (meaning : PayloadMeaning program symbols state payload type concrete) : concrete.nodes = [] := by
  cases free with
  | plain => cases meaning <;> rfl
  | aggregate children =>
      cases meaning with
      | vacant => rfl
      | aggregate _ _ fields => exact children.nodes_eq_nil fields
  | schema => cases meaning <;> rfl

theorem PayloadsNoHandles.nodes_eq_nil {payloads : List Checked.Payload} {states : Nat → Initialization}
    {types : List Ty} {concretes : List SourcePayload} (free : PayloadsNoHandles payloads)
    (meaning : PayloadMeanings program symbols states payloads types concretes) : payloadNodes concretes = [] := by
  cases free with
  | nil => cases meaning; rfl
  | cons first rest =>
      cases meaning with
      | cons head tail => simp [payloadNodes, first.nodes_eq_nil head, rest.nodes_eq_nil tail]
end

mutual
/-- Every actually resident node determines an existing declared path. This
follows the meaning derivation, not an independent scan of values or types. -/
theorem PayloadMeaning.node_declared {payload : Checked.Payload} {state : Initialization}
    {type : Ty} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols state payload type concrete)
    {node : Nat} (member : node ∈ concrete.nodes) :
    ∃ path referent mode, Checked.ReferencePath program type path referent mode := by
  cases meaning with
  | vacant | plain | schemaPlain => simp [SourcePayload.nodes] at member
  | reference | schemaReference => exact ⟨[], _, _, .here ..⟩
  | aggregate source shape fields | schemaAggregate source shape fields =>
      obtain ⟨index, child, path, referent, mode, selected, nested⟩ := fields.node_declared member
      exact ⟨_, _, _, .child source shape selected nested⟩

theorem PayloadMeanings.node_declared {payloads : List Checked.Payload} {states : Nat → Initialization}
    {types : List Ty} {concretes : List SourcePayload}
    (meaning : PayloadMeanings program symbols states payloads types concretes)
    {node : Nat} (member : node ∈ payloadNodes concretes) :
    ∃ (index : Nat), ∃ child path referent mode, types[index]? = some child ∧
      Checked.ReferencePath program child path referent mode := by
  cases meaning with
  | nil => simp [payloadNodes] at member
  | cons first rest =>
      rcases List.mem_append.mp member with member | member
      · obtain ⟨path, referent, mode, declared⟩ := first.node_declared member
        exact ⟨0, _, path, referent, mode, rfl, declared⟩
      · obtain ⟨index, child, path, referent, mode, selected, declared⟩ := rest.node_declared member
        exact ⟨index + 1, child, path, referent, mode, selected, declared⟩
end

mutual
/-- Declared capacity bounds occurrences, rather than distinct interpreted node
numbers. The proof therefore needs no injectivity of symbolic interpretation. -/
theorem PayloadMeaning.declared_nodes_length_le_one {payload : Checked.Payload} {state : Initialization}
    {type : Ty} {concrete : SourcePayload}
    (meaning : PayloadMeaning program symbols state payload type concrete)
    (capacity : DeclaredReturnCapacity program type) : concrete.nodes.length ≤ 1 := by
  cases meaning with
  | vacant | plain | schemaPlain => simp [SourcePayload.nodes]
  | reference | schemaReference => simp [SourcePayload.nodes]
  | aggregate source shape fields | schemaAggregate source shape fields =>
      exact fields.declared_nodes_length_le_one
        (fun _ _ selected => capacity.child source shape selected)
        (fun _ _ _ _ _ _ _ _ _ _ selectedLeft selectedRight leftPath rightPath =>
          capacity.field_unique source shape selectedLeft selectedRight leftPath rightPath)

private theorem PayloadMeanings.declared_nodes_length_le_one
    {payloads : List Checked.Payload} {states : Nat → Initialization}
    {types : List Ty} {concretes : List SourcePayload}
    (meaning : PayloadMeanings program symbols states payloads types concretes)
    (capacities : ∀ (index : Nat) child, types[index]? = some child → DeclaredReturnCapacity program child)
    (oneField : ∀ (first second : Nat) left right leftPath rightPath leftReferent rightReferent leftMode rightMode,
      types[first]? = some left → types[second]? = some right →
      Checked.ReferencePath program left leftPath leftReferent leftMode →
      Checked.ReferencePath program right rightPath rightReferent rightMode → first = second) :
    (payloadNodes concretes).length ≤ 1 := by
  cases meaning with
  | nil => simp [payloadNodes]
  | @cons states payload payloads type types concrete concretes first rest =>
      have firstBound := first.declared_nodes_length_le_one (capacities 0 type rfl)
      have restBound := rest.declared_nodes_length_le_one
        (fun index child selected => capacities (index + 1) child selected)
        (fun left right leftType rightType leftPath rightPath leftRef rightRef leftMode rightMode
            leftSelected rightSelected leftFound rightFound =>
          Nat.add_right_cancel (oneField (left + 1) (right + 1) leftType rightType
            leftPath rightPath leftRef rightRef leftMode rightMode leftSelected rightSelected leftFound rightFound))
      by_cases empty : concrete.nodes = []
      · simpa [payloadNodes, empty] using restBound
      · have restEmpty : payloadNodes concretes = [] := by
          apply Classical.byContradiction
          intro nonempty
          obtain ⟨firstNode, firstMember⟩ := List.exists_mem_of_ne_nil _ empty
          obtain ⟨restNode, restMember⟩ := List.exists_mem_of_ne_nil _ nonempty
          obtain ⟨leftPath, leftRef, leftMode, leftFound⟩ := first.node_declared firstMember
          obtain ⟨index, rightType, rightPath, rightRef, rightMode, selected, rightFound⟩ :=
            rest.node_declared restMember
          have impossible := oneField 0 (index + 1) type rightType leftPath rightPath leftRef rightRef
            leftMode rightMode rfl selected leftFound rightFound
          omega
        simpa [payloadNodes, restEmpty] using firstBound
end

mutual
theorem Payload.ReturnCapacity.nodes_length_le_one {payload : Checked.Payload} {state : Initialization}
    {type : Ty} {concrete : SourcePayload} (capacity : Payload.ReturnCapacity program payload)
    (meaning : PayloadMeaning program symbols state payload type concrete) : concrete.nodes.length ≤ 1 := by
  cases capacity with
  | empty free => simp [free.nodes_eq_nil meaning]
  | reference => cases meaning <;> simp [SourcePayload.nodes]
  | aggregate children =>
      cases meaning with
      | vacant => simp [SourcePayload.nodes]
      | aggregate _ _ fields => exact children.nodes_length_le_one fields
  | schema declared =>
      cases meaning with
      | vacant => simp [SourcePayload.nodes]
      | schemaPlain => simp [SourcePayload.nodes]
      | schemaReference => simp [SourcePayload.nodes]
      | schemaAggregate source shape fields =>
          exact (PayloadMeaning.schemaAggregate source shape fields).declared_nodes_length_le_one declared

theorem PayloadsReturnCapacity.nodes_length_le_one {payloads : List Checked.Payload}
    {states : Nat → Initialization} {types : List Ty} {concretes : List SourcePayload}
    (capacity : PayloadsReturnCapacity program payloads)
    (meaning : PayloadMeanings program symbols states payloads types concretes) :
    (payloadNodes concretes).length ≤ 1 := by
  cases capacity with
  | nil => cases meaning; simp [payloadNodes]
  | head first rest =>
      cases meaning with
      | cons head tail => simpa [payloadNodes, rest.nodes_eq_nil tail] using first.nodes_length_le_one head
  | tail first rest =>
      cases meaning with
      | cons head tail => simpa [payloadNodes, first.nodes_eq_nil head] using rest.nodes_length_le_one tail
end

/-- A witnessed member turns an occurrence bound into the exact argument
inventory required by concrete return checking, even when symbols alias. -/
theorem singleton_of_length_le_one_of_mem {α : Type} {items : List α} {item : α}
    (capacity : items.length ≤ 1) (member : item ∈ items) : items = [item] := by
  cases items with
  | nil => simp at member
  | cons first rest =>
      cases rest with
      | nil => have same := List.mem_singleton.mp member; subst item; rfl
      | cons next tail => simp only [List.length_cons] at capacity; omega

theorem PayloadsReturnCapacity.nodes_eq_singleton {payloads : List Checked.Payload}
    {states : Nat → Initialization} {types : List Ty} {concretes : List SourcePayload} {node : Nat}
    (capacity : PayloadsReturnCapacity program payloads)
    (meaning : PayloadMeanings program symbols states payloads types concretes)
    (member : node ∈ payloadNodes concretes) : payloadNodes concretes = [node] :=
  singleton_of_length_le_one_of_mem (capacity.nodes_length_le_one meaning) member

end Grounded.Elaboration

/- Section: ElaborationTyping -/
namespace Grounded.Elaboration
set_option autoImplicit false

/-- Context transitions constrain the sole checked store and its actual source
interpretation. They contain no runtime state or evaluation judgment. -/
structure BindStep (program : Program) {phase : Phase} (before after : Point program phase)
    (name : String) (mutable : Bool) (result : Result phase) : Prop where
  checked : after.checked = before.checked.bind name mutable result.checked
  actual : Required phase fun executable => after.source executable =
    (before.source executable).bind name mutable (result.source executable)

structure PrepareStep (program : Program) {phase : Phase} (before after : Point program phase)
    (parameters : List (String × BindingType)) (arguments : List (Result phase)) : Prop where
  checked : after.checked = before.checked.prepare parameters (checkedResults arguments)
  actual : Required phase fun executable => after.source executable =
    (before.source executable).prepare parameters (sourceResults arguments executable)



structure ResultEvidence (program : Program) {phase : Phase}
    (before after : Point program phase) (result : Result phase) : Prop where
  typed : result.Checked program
  interpreted : result.Interpreted after
  stable : PointsStable before after

inductive ExpectedAtom : Expr → Prop where
  | unit : ExpectedAtom .unit
  | integer (type : IntegerType) (magnitude : Nat) : ExpectedAtom (.integer type magnitude)
  | character (number : Nat) : ExpectedAtom (.character number)
  | constant (name : String) : ExpectedAtom (.constant name)
  | read (place : Place) : ExpectedAtom (.read place)
  | construct (identity : Nat) (tag : Option Nat) (fields : List Expr) : ExpectedAtom (.construct identity tag fields)

def NotReference : Ty → Prop
  | .reference _ _ => False
  | _ => True



inductive PayloadJoin : Checked.Payload → Checked.Payload → Prop where
  | same (payload : Checked.Payload) : PayloadJoin payload payload
  | empty {before after : Checked.Payload} (first : Payload.NoHandles before)
      (last : Payload.NoHandles after) : PayloadJoin before after

inductive CellJoin (program : Program) : Option Checked.Slot → Option Checked.Slot → Prop where
  | absent : CellJoin program none none
  | resident {type : Ty} {mutable : Bool} {before after : Initialization} {binder : Nat}
      {first last : Checked.Payload}
      (masks : Initialization.Joins program.data type before after) (payloads : PayloadJoin first last) :
      CellJoin program (some ⟨⟨type, mutable, before⟩, binder, first⟩)
        (some ⟨⟨type, mutable, after⟩, binder, last⟩)

structure JoinStep (program : Program) {phase : Phase} (before after : Point program phase) : Prop where
  names : before.checked.names = after.checked.names
  storage : ∀ base, CellJoin program (before.checked.storage base) (after.checked.storage base)
  loans : before.checked.loans = after.checked.loans
  ended : before.checked.ended = after.checked.ended
  binders : before.checked.nextBinder ≤ after.checked.nextBinder
  symbols : before.checked.nextSymbol ≤ after.checked.nextSymbol
  stable : PointsStable before after
  actual : Required phase fun executable => (before.source executable).Joins program (after.source executable)

structure HideStep (program : Program) {phase : Phase} (before after : Point program phase) : Prop where
  checked : after.checked = before.checked.hide
  stable : PointsStable before after
  actual : Required phase fun executable => after.source executable = (before.source executable).hide

structure ResumeStep (program : Program) {phase : Phase} (caller callee after : Point program phase) : Prop where
  checked : after.checked = caller.checked.resume callee.checked
  stable : PointsStable callee after
  actual : Required phase fun executable => after.source executable =
    (caller.source executable).resume (callee.source executable)

structure EndingStep (program : Program) {phase : Phase} (before after : Point program phase)
    (held : List (Payload phase)) (slotIndex : Nat) (fields : List Nat) where
  binding : String × Checked.Slot
  symbol : Checked.Reference
  referent : Ty
  mode : BorrowMode
  selected : before.checked.bindings[slotIndex]? = some binding
  handle : Checked.Payload.At program binding.2.payload binding.2.type fields
    (.reference symbol referent mode) (.reference referent mode)
  permitted : before.checked.CanEnd (program := program) (checkedPayloads held) symbol
  updated : after.checked = before.checked.endPayload (.reference symbol referent mode)
  stable : PointsStable before after
  actual : Required phase fun executable => Nonempty (SourceEnding program
    (before.source executable) (sourcePayloads held executable) slotIndex fields (after.source executable))

structure SourceWrite (program : Program) (home : Module) (before : Grounded.Context)
    (held : List SourcePayload) (place : AccessPlace) (replacement : ResultType) (after : Grounded.Context) where
  target : Origin
  parent : Option Nat
  slot : Grounded.Slot
  state : Initialization
  old : SourcePayload
  updatedPayload : SourcePayload
  access : AccessType program home before .unique place target replacement.type parent
  permitted : before.Permits .unique parent target
  stored : before.storage target.base = some slot
  mask : slot.initialization.Access target.fields state
  path : CanonicalPath program slot.type target.fields replacement.type
  selected : slot.payload.select target.fields = some old
  discard : StorageDisposition program state replacement.type
  unprotected : ∀ node ∈ old.nodes, node ∉ payloadNodes (held ++ [replacement.payload])
  ready : ∀ node ∈ old.nodes, before.Restored node
  written : SourcePayload.Write program slot.type target.fields slot.payload replacement.payload updatedPayload
  updated : after = (before.dispose old).writeTarget target .full updatedPayload

structure WriteStep (program : Program) (home : Module) {phase : Phase}
    (before after : Point program phase) (held : List (Payload phase)) (place : AccessPlace)
    (replacement : Result phase) where
  target : Checked.Address
  parent : Option Checked.Reference
  slot : Checked.Slot
  state : Initialization
  old : Checked.Payload
  updatedPayload : Checked.Payload
  access : Checked.Access program home before.checked .unique place target replacement.type parent
  permitted : before.checked.LocalPermits (program := program) .unique parent target
  stored : before.checked.storage target.base = some slot
  mask : slot.initialization.Access target.fields state
  selected : Checked.Payload.At program slot.payload slot.type target.fields old replacement.type
  discard : StorageDisposition program state replacement.type
  unprotected : ∀ reference, old.Occurs program reference →
    ¬ Checked.heldOccurs (program := program) (checkedPayloads (held ++ [replacement.payload])) reference
  ready : ∀ reference, old.Occurs program reference → before.checked.NotKnownUnrestored reference
  written : Checked.Payload.Write program slot.payload slot.type target.fields replacement.payload.checked updatedPayload
  updated : after.checked = (before.checked.endPayload old).writeTarget target .full updatedPayload
  stable : PointsStable before after
  actual : Required phase fun executable => Nonempty (SourceWrite program home
    (before.source executable) (sourcePayloads held executable) place
    (replacement.source executable) (after.source executable))

structure ProjectionStep (program : Program) (home : Module) {phase : Phase}
    (before after : Point program phase) (held : List (Payload phase))
    (parent : Result phase) (key : FieldKey) (result : Result phase) where
  index : Nat
  remainder : Checked.Payload
  selected : ProjectionType program home parent.type key index result.type
  source : Checked.Payload.At program parent.payload.checked parent.type [index] result.payload.checked result.type
  cleared : Checked.Payload.Write program parent.payload.checked parent.type [index] .plain remainder
  discard : StorageDisposition program (Initialization.full.setChild index .vacant) parent.type
  disposable : before.checked.CanDispose (program := program) (checkedPayloads (held ++ [result.payload])) remainder
  updated : after.checked = before.checked.endPayload remainder
  stable : PointsStable before after
  actual : Required phase fun executable => ∃ rest,
    (parent.payload.source executable).select [index] = some (result.payload.source executable) ∧
    SourcePayload.Write program parent.type [index] (parent.payload.source executable) .plain rest ∧
    (before.source executable).PayloadDisposable program (sourcePayloads (held ++ [result.payload]) executable) rest ∧
    after.source executable = (before.source executable).dispose rest

structure ReturnStep (program : Program) {phase : Phase} (before : Point program phase)
    (arguments : List (Result phase)) (result : Result phase) : Prop where
  checked : Payload.NoHandles result.payload.checked ∨
    (PayloadsReturnCapacity program (arguments.map fun argument => argument.payload.checked) ∧
      ∀ reference, result.payload.checked.Occurs program reference →
        ∃ argument ∈ arguments, ∃ ancestor, argument.payload.checked.Occurs program ancestor ∧
          before.checked.Derived reference ancestor)
  actual : Required phase fun executable => ∀ node ∈ (result.payload.source executable).nodes,
    ∃ input, payloadNodes ((sourceResults arguments executable).map ResultType.payload) = [input] ∧
      (before.source executable).Derived node input

def argumentResult {phase : Phase} : List (Result phase) → Result phase
  | [] => .data phase .unit
  | [result] => result
  | first :: second :: rest => ⟨.tuple first.type ((second :: rest).map Result.type),
      .aggregate .tuple (first.payload :: (second :: rest).map Result.payload)⟩

mutual
/-- One producer owns ordinary checking, source products and executable
realization. Phase is an index so dormant bodies use the same checking producer. -/
inductive HasType (program : Program) : (phase : Phase) → Module → Point program phase →
    List (Payload phase) → Expr → Result phase → Point program phase → CorePlan → Option Ty → Type where
  | unit {phase : Phase} {home : Module} {before : Point program phase} {held : List (Payload phase)} :
      HasType program phase home before held .unit (.data phase .unit) before .leaf none
  | integer {phase : Phase} {home : Module} {before : Point program phase} {held : List (Payload phase)}
      {type : IntegerType} {magnitude : Nat} (fits : type.Contains program.target magnitude) :
      HasType program phase home before held (.integer type magnitude) (.data phase (.integer type)) before .leaf none
  | character {phase : Phase} {home : Module} {before : Point program phase} {held : List (Payload phase)}
      {number : Nat} (valid : UnicodeScalar number) :
      HasType program phase home before held (.character number) (.data phase .character) before .leaf none
  | group {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {body : Expr} {result : Result phase} {plan : CorePlan} {expected : Option Ty}
      (bodyTyped : HasType program phase home before held body result after plan expected) :
      HasType program phase home before held (.group body) result after (.unary plan) expected
  | read {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {place : Place} {selected result : Result phase}
      (selection : Checked.CopySelection program home before.checked place selected.checked)
      (sameType : result.type = selected.type)
      (copy : Checked.CopyPayload before.checked selected.payload.checked result.payload.checked after.checked)
      (evidence : ResultEvidence program before after result)
      (actual : Required phase fun executable => Nonempty (SourceRead program home
        (before.source executable) place (result.source executable) (after.source executable))) :
      HasType program phase home before held (.read place) result after .leaf none
  | move {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {place : Place} {result : Result phase} {remainder : Checked.Payload}
      (selection : Checked.PlaceSelection program home before.checked place result.checked)
      (available : before.checked.ResourcesAvailable (program := program) result.payload.checked)
      (free : before.checked.LocalFree (program := program) ⟨.binder selection.slot.binder, selection.indices⟩)
      (cleared : Checked.Payload.Write program selection.slot.payload selection.slot.type selection.indices .plain remainder)
      (updated : after.checked = before.checked.writeTarget ⟨.binder selection.slot.binder, selection.indices⟩ .vacant remainder)
      (evidence : ResultEvidence program before after result)
      (actual : Required phase fun executable => Nonempty (SourceMove program home
        (before.source executable) place (result.source executable) (after.source executable))) :
      HasType program phase home before held (.move place) result after .leaf none
  | implicitMove {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {place : Place} {result : Result phase}
      (move : HasType program phase home before held (.move place) result after .leaf none)
      (noncopy : Nonduplicable program.data result.type) :
      HasType program phase home before held (.read place) result after .implicitMove none
  | borrow {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {mode : BorrowMode} {place : AccessPlace} {target : Checked.Address} {parent : Option Checked.Reference}
      {referent : Ty} {result : Result phase} {slot : Checked.Slot} {payload : Checked.Payload}
      (access : Checked.Access program home before.checked mode place target referent parent)
      (ready : before.checked.TargetReady target)
      (stored : before.checked.storage target.base = some slot)
      (selected : Checked.Payload.At program slot.payload slot.type target.fields payload referent)
      (available : before.checked.ResourcesAvailable (program := program) payload)
      (finite : FiniteLayout program.target program.data referent)
      (permitted : before.checked.LocalPermits (program := program) mode parent target)
      (produced : result.checked = ⟨.reference referent mode, .reference (.borrowed before.checked.nextSymbol) referent mode⟩)
      (updated : after.checked = before.checked.borrow target referent mode parent)
      (evidence : ResultEvidence program before after result)
      (actual : Required phase fun executable => Nonempty (SourceBorrow program home
        (before.source executable) mode place referent (result.source executable) (after.source executable))) :
      HasType program phase home before held (.borrow mode place) result after .leaf none
  | reborrow {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {mode : BorrowMode} {place : Place} {referent : Ty} {result : Result phase}
      (borrow : HasType program phase home before held (.borrow mode (.dereference place [])) result after .leaf none)
      (type : result.type = .reference referent mode) :
      HasType program phase home before held (.read place) result after (.reborrow mode) (some (.reference referent mode))
  | dereference {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {reference : Place} {fields : List FieldKey} {target : Checked.Address} {parent : Option Checked.Reference}
      {selected result : Result phase} {slot : Checked.Slot}
      (access : Checked.Access program home before.checked .shared (.dereference reference fields) target selected.type parent)
      (ready : before.checked.TargetReady target)
      (stored : before.checked.storage target.base = some slot)
      (provenance : Checked.Payload.At program slot.payload slot.type target.fields selected.payload.checked selected.type)
      (permission : Duplicable program.data selected.type)
      (available : before.checked.ResourcesAvailable (program := program) selected.payload.checked)
      (permitted : before.checked.LocalPermits (program := program) .shared parent target)
      (sameType : result.type = selected.type)
      (copy : Checked.CopyPayload before.checked selected.payload.checked result.payload.checked after.checked)
      (evidence : ResultEvidence program before after result)
      (actual : Required phase fun executable => Nonempty (SourceDereference program home
        (before.source executable) reference fields (result.source executable) (after.source executable))) :
      HasType program phase home before held (.dereference reference fields) result after .leaf none
  | moveIndirect {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {reference : Place} {fields : List FieldKey} {target : Checked.Address} {parent : Checked.Reference}
      {slot : Checked.Slot} {result : Result phase} {remainder : Checked.Payload}
      (access : Checked.Access program home before.checked .unique (.dereference reference fields) target result.type (some parent))
      (ready : before.checked.TargetReady target)
      (permitted : before.checked.LocalPermits (program := program) .unique (some parent) target)
      (stored : before.checked.storage target.base = some slot)
      (selected : Checked.Payload.At program slot.payload slot.type target.fields result.payload.checked result.type)
      (available : before.checked.ResourcesAvailable (program := program) result.payload.checked)
      (cleared : Checked.Payload.Write program slot.payload slot.type target.fields .plain remainder)
      (updated : after.checked = before.checked.writeTarget target .vacant remainder)
      (evidence : ResultEvidence program before after result)
      (actual : Required phase fun executable => Nonempty (SourceMoveIndirect program home
        (before.source executable) (sourcePayloads held executable) reference fields
        (result.source executable) (after.source executable))) :
      HasType program phase home before held (.moveIndirect reference fields) result after .leaf none
  | tuple {phase : Phase} {home : Module} {before middle after : Point program phase} {held : List (Payload phase)}
      {head : Expr} {tail : List Expr} {first : Result phase} {rest : List (Result phase)}
      {headPlan : CorePlan} {tailPlans : List CorePlan} {expected : Option Ty}
      (contextual : expected = none ∨ expected = some (.tuple first.type (rest.map Result.type)))
      (headTyped : HasType program phase home before held head first middle headPlan (expected.map fun _ => first.type))
      (tailTyped : HasTypes program phase home middle (held ++ [first.payload]) tail rest after tailPlans
        (expected.map fun _ => rest.map Result.type))
      (supported : StorageType program.target program.data (.tuple first.type (rest.map Result.type))) :
      HasType program phase home before held (.tuple head tail)
        ⟨.tuple first.type (rest.map Result.type), .aggregate .tuple (first.payload :: rest.map Result.payload)⟩
        after (.batch (headPlan :: tailPlans)) expected
  | array {phase : Phase} {home : Module} {before after : Point program phase} {held : List (Payload phase)}
      {element : Ty} {elements : List Expr} {results : List (Result phase)} {plans : List CorePlan} {expected : Option Ty}
      (contextual : expected = none ∨ expected = some (.array element elements.length))
      (typed : HasTypes program phase home before held elements results after plans
        (expected.map fun _ => List.replicate elements.length element))
      (types : results.map Result.type = List.replicate elements.length element)
      (elementValid : FiniteLayout program.target program.data element)
      (size : elements.length < 2 ^ program.target.pointerBits) :
