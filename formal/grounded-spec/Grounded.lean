  | applyPatterns {phase : Phase} {home : Module} {before middle after : Point program phase} {held : List (Payload phase)}
      {inputs : List Ty} {arguments : List Expr} {argumentTypes : List (Result phase)} {arms : List (PatternSource × Expr)}
      {result : Result phase} {argumentPlans : List CorePlan} {armPlans : List (PatternPlan × CorePlan)} {expected : Option Ty}
      (argumentsTyped : HasTypes program phase home before held arguments argumentTypes middle argumentPlans (some inputs))
      (nonempty : arms ≠ [])
      (constants : ArmConstantsTyped program phase home arms armPlans)
      (covered : ∀ normalized, NormalizesArms program arms armPlans normalized →
        Covers program [argumentType inputs] (normalized.map fun arm => [arm.1]))
      (bodies : ∀ normalized, NormalizesArms program arms armPlans normalized →
