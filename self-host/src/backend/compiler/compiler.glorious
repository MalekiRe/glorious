// The first self-hosted compiler driver: source through typed Core, Stage-A
// ownership lowering, and canonical verified-bytecode emission.

use super::super::frontend::elaboration::InterfaceTypeView;
use super::super::frontend::elaboration::InterfaceNominalView;
use super::super::frontend::elaboration::ElaborationError;
use super::super::frontend::resolution::ResolutionError;
use super::super::frontend::headers::HeaderError;
use super::super::frontend::scanner::ScanError;
use super::super::frontend::bodies::BodyError;
use super::super::frontend::lexer::LexError;
use super::lowering::LoweringError;
use super::emission::EmissionError;

pub enum CompileError {
    Lex(LexError),
    Scan(ScanError),
    Headers(HeaderError),
    ResolutionIndex(ResolutionError),
    InterfaceCollection(ElaborationError),
    DeclarationName(u32),
    BodyParse(u32, BodyError),
    BodyResolution(u32, ResolutionError),
    BodyElaboration(u32, ElaborationError),
    Lowering(u32, LoweringError),
    InterfaceName(u32),
    UnsupportedInterfaceType(usize),
    Emission(EmissionError)
}

checked_u32(value: usize) -> u32 {
    handle checked_usize_to_u32(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

usize_from_u32(value: u32) -> usize {
    wrapping_convert_to_usize(value)
}

function_name(
    headers:
        &super::super::frontend::headers::ParsedHeaders,
    declarations:
        &super::super::frontend::scanner::DeclarationIndex,
    shell: u32
) -> Result<String, CompileError> {
    handle super::super::frontend::scanner::shell_at(
        declarations,
        usize_from_u32(shell)
    ) {
        Result::Err(_) =>
            Result::Err(CompileError::DeclarationName(shell)),
        Result::Ok(declaration) => handle
            *super::super::frontend::scanner::shell_name(declaration) {
            Result::Err(_) =>
                Result::Err(CompileError::DeclarationName(shell)),
            Result::Ok(name) => handle
                super::super::frontend::lexer::lexeme(
                    super::super::frontend::headers::parsed_source(headers),
                    name
                ) {
                Result::Err(_) =>
                    Result::Err(CompileError::DeclarationName(shell)),
                Result::Ok(found) => Result::Ok(*found)
            }
        }
    }
}

lower_functions(
    original: &String,
    headers:
        &super::super::frontend::headers::ParsedHeaders,
    resolution_index:
        &super::super::frontend::resolution::ResolutionIndex,
    declarations:
        &super::super::frontend::scanner::DeclarationIndex,
    interfaces:
        &mut super::super::frontend::elaboration::TypedInterfaces,
    index: usize,
    output: &mut Arena<
        super::lowering::StageFunctionTag,
        super::lowering::StageFunction
    >
) -> Result<(), CompileError> {
    try_for_range(Range::new(
        index,
        super::super::frontend::elaboration::
            interface_callable_count(&*interfaces)
    ), { current => {
        let shell =
            super::super::frontend::elaboration::
                interface_callable_shell_at(&*interfaces, current);
        let name = try(
            function_name(headers, declarations, shell),
            @lower_functions
        );
        let parsed = try(
            Result::map_err(
                super::super::frontend::bodies::parse_function_body(
                    original,
                    headers,
                    declarations,
                    usize_from_u32(shell)
                ),
                { found => CompileError::BodyParse(shell, found) }
            ),
            @lower_functions
        );
        let resolved = try(
            Result::map_err(
                super::super::frontend::resolution::
                    resolve_function_body_indexed(
                        resolution_index,
                        headers,
                        declarations,
                        &parsed
                    ),
                { found => CompileError::BodyResolution(shell, found) }
            ),
            @lower_functions
        );
        let body = try(
            Result::map_err(
                super::super::frontend::elaboration::
                    elaborate_function_body(
                        original,
                        headers,
                        declarations,
                        interfaces,
                        &parsed,
                        &resolved
                    ),
                { found =>
                    CompileError::BodyElaboration(shell, found)
                }
            ),
            @lower_functions
        );
        let function = try(
            Result::map_err(
                super::lowering::lower_function(
                    name,
                    &*interfaces,
                    &body,
                    current
                ),
                { found => CompileError::Lowering(shell, found) }
            ),
            @lower_functions
        );
        handle Arena::alloc(&mut *output, function) {
            Result::Err(_) => unreachable(),
            Result::Ok(_) => ()
        };
        Result::Ok(())
    } })
}

find_entry(
    program: &super::lowering::StageProgram,
    index: usize
) -> Option<super::lowering::StageFunctionId> {
    let count = super::lowering::stage_program_function_count(program);
    handle find_range(Range::new(index, count), { current => {
        let function =
            super::lowering::stage_program_function_at(
                program,
                super::lowering::stage_function_id_from_usize(current)
            );
        String::eq(
            super::lowering::stage_function_name(function),
            &"main"
        ) and {
            super::lowering::stage_function_parameter_count(function)
                == 0
        } and {
            super::lowering::artifact_type_raw(
                super::lowering::stage_function_result(function)
            ) == 0
        }
    } }) {
        Option::Some(found) => Option::Some(
            super::lowering::stage_function_id_from_usize(found)
        ),
        None => None
    }
}

interface_name(
    headers:
        &super::super::frontend::headers::ParsedHeaders,
    raw: u32,
    detail: u32
) -> Result<String, CompileError> {
    handle super::super::frontend::lexer::lexeme(
        super::super::frontend::headers::parsed_source(headers),
        Id::from_u32(raw)
    ) {
        Result::Err(_) =>
            Result::Err(CompileError::InterfaceName(detail)),
        Result::Ok(found) => Result::Ok(*found)
    }
}

collect_struct_fields(
    headers:
        &super::super::frontend::headers::ParsedHeaders,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    start: u32,
    count: u32,
    ordinal: u32,
    type_names: &mut Vec<String>,
    names: &mut Vec<u32>,
    types: &mut Vec<super::lowering::ArtifactTypeId>
) -> Result<(), CompileError> {
    try_for_range(Range::new(
        usize_from_u32(ordinal),
        usize_from_u32(count)
    ), { current => {
        let current_ordinal = checked_u32(current);
        let field =
            super::super::frontend::elaboration::interface_field_at_view(
                interfaces,
                usize_from_u32(start + current_ordinal)
            );
        let name = try(interface_name(
            headers,
            super::super::frontend::elaboration::
                interface_field_view_name(&field),
            start + current_ordinal
        ), @collect_struct_fields);
        Vec::push(
            &mut *names,
            checked_u32(Vec::len(&*type_names))
        );
        Vec::push(&mut *type_names, name);
        Vec::push(
            &mut *types,
            super::lowering::artifact_type_id(
                super::super::frontend::elaboration::
                    interface_field_view_type(&field)
            )
        );
        Result::Ok(())
    } })
}

ordinal_name(value: usize) -> String {
    let output = Formatter::new();
    Formatter::append_u64(
        &mut output,
        wrapping_convert_to_u64(value)
    );
    handle Formatter::finish(output) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

collect_variant_payloads<'a>(
    payloads:
        Slice<'a, super::super::frontend::elaboration::TypeId>,
    type_names: &mut Vec<String>,
    names: &mut Vec<u32>,
    types: &mut Vec<super::lowering::ArtifactTypeId>
) {
    Slice::for_each(payloads, { payload => {
        Vec::push(
            &mut *names,
            checked_u32(Vec::len(&*type_names))
        );
        Vec::push(
            &mut *type_names,
            ordinal_name(Vec::len(&*types))
        );
        Vec::push(
            &mut *types,
            super::lowering::artifact_type_id(Id::to_u32(*payload))
        )
    } })
}

collect_enum_variants(
    headers:
        &super::super::frontend::headers::ParsedHeaders,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    start: u32,
    count: u32,
    ordinal: u32,
    type_names: &mut Vec<String>,
    output: &mut Vec<super::lowering::StageVariant>
) -> Result<(), CompileError> {
    try_for_range(Range::new(
        usize_from_u32(ordinal),
        usize_from_u32(count)
    ), { current => {
        let current_ordinal = checked_u32(current);
        let variant = usize_from_u32(start + current_ordinal);
        let name = try(interface_name(
            headers,
            super::super::frontend::elaboration::
                interface_variant_name_at(interfaces, variant),
            start + current_ordinal
        ), @collect_enum_variants);
        let name_index = checked_u32(Vec::len(&*type_names));
        Vec::push(&mut *type_names, name);
        let field_names = Vec::new();
        let field_types = Vec::new();
        collect_variant_payloads(
            super::super::frontend::elaboration::
                interface_variant_payloads_at(interfaces, variant),
            type_names,
            &mut field_names,
            &mut field_types
        );
        Vec::push(
            &mut *output,
            super::lowering::enum_variant(
                name_index,
                field_names,
                field_types
            )
        );
        Result::Ok(())
    } })
}

collect_types(
    headers:
        &super::super::frontend::headers::ParsedHeaders,
    declarations:
        &super::super::frontend::scanner::DeclarationIndex,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    index: usize,
    output: &mut Arena<
        super::lowering::StageTypeTag,
        super::lowering::StageType
    >,
    type_names: &mut Vec<String>
) -> Result<(), CompileError> {
    if(index <
        super::super::frontend::elaboration::interface_type_count(interfaces)
    ) {
        handle super::super::frontend::elaboration::interface_type_at(
            interfaces,
            index
        ) {
            InterfaceTypeView::Tuple(elements) => {
                let fields = Vec::new();
                Slice::for_each(elements, { element =>
                    Vec::push(
                        &mut fields,
                        super::lowering::artifact_type_id(
                            Id::to_u32(*element)
                        )
                    )
                });
                handle Arena::alloc(
                    &mut *output,
                    super::lowering::tuple_type(
                        fields,
                        if(
                            super::super::frontend::elaboration::
                                interface_type_flags_at(interfaces, index)
                                    % 2 == 1
                        ) { 1 } else { 0 }
                    )
                ) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(_) => ()
                };
                collect_types(
                    headers,
                    declarations,
                    interfaces,
                    index + 1,
                    output,
                    type_names
                )
            },
            InterfaceTypeView::Nominal(nominal) => handle
                super::super::frontend::elaboration::
                    interface_nominal_at_view(
                        interfaces,
                        usize_from_u32(nominal)
                    ) {
                InterfaceNominalView::Struct(shell, start, count) => {
                    let name = try(
                        function_name(headers, declarations, shell),
                        @collect_types
                    );
                    let name_index = checked_u32(Vec::len(&*type_names));
                    Vec::push(&mut *type_names, name);
                    let field_names = Vec::new();
                    let field_types = Vec::new();
                    try(collect_struct_fields(
                        headers,
                        interfaces,
                        start,
                        count,
                        0,
                        type_names,
                        &mut field_names,
                        &mut field_types
                    ), @collect_types);
                    handle Arena::alloc(
                        &mut *output,
                        super::lowering::struct_type(
                            name_index,
                            field_names,
                            field_types,
                            if(
                                super::super::frontend::elaboration::
                                    interface_type_flags_at(
                                        interfaces,
                                        index
                                    ) % 2 == 1
                            ) { 1 } else { 0 }
                        )
                    ) {
                        Result::Err(_) => unreachable(),
                        Result::Ok(_) => ()
                    };
                    collect_types(
                        headers,
                        declarations,
                        interfaces,
                        index + 1,
                        output,
                        type_names
                    )
                },
                InterfaceNominalView::Enum(shell, start, count) => {
                    let name = try(
                        function_name(headers, declarations, shell),
                        @collect_types
                    );
                    let name_index = checked_u32(Vec::len(&*type_names));
                    Vec::push(&mut *type_names, name);
                    let variants = Vec::new();
                    try(collect_enum_variants(
                        headers,
                        interfaces,
                        start,
                        count,
                        0,
                        type_names,
                        &mut variants
                    ), @collect_types);
                    handle Arena::alloc(
                        &mut *output,
                        super::lowering::enum_type(
                            name_index,
                            variants,
                            if(
                                super::super::frontend::elaboration::
                                    interface_type_flags_at(
                                        interfaces,
                                        index
                                    ) % 2 == 1
                            ) { 1 } else { 0 }
                        )
                    ) {
                        Result::Err(_) => unreachable(),
                        Result::Ok(_) => ()
                    };
                    collect_types(
                        headers,
                        declarations,
                        interfaces,
                        index + 1,
                        output,
                        type_names
                    )
                }
            },
            _ => Result::Err(
                CompileError::UnsupportedInterfaceType(index)
            )
        }
    } else {
        Result::Ok(())
    }
}

compile_interfaces(
    original: &String,
    headers:
        &super::super::frontend::headers::ParsedHeaders,
    resolution_index:
        &super::super::frontend::resolution::ResolutionIndex,
    declarations:
        &super::super::frontend::scanner::DeclarationIndex,
    interfaces:
        super::super::frontend::elaboration::TypedInterfaces
) -> Result<Bytes, CompileError> {
    let functions = Arena::new();
    let types = Arena::new();
    let type_names = Vec::new();
    try(lower_functions(
        original,
        headers,
        resolution_index,
        declarations,
        &mut interfaces,
        0,
        &mut functions
    ), @compile_interfaces);
    // Body elaboration interns structural types into the shared interface
    // arena, so freeze the emitted type table only after every body is typed.
    try(collect_types(
        headers,
        declarations,
        &interfaces,
        14,
        &mut types,
        &mut type_names
    ), @compile_interfaces);
    let program = super::lowering::finish_program(
        functions,
        types,
        type_names
    );
    let entry = find_entry(&program, 0);
    Result::map_err(
        super::emission::encode(&program, entry),
        { found => CompileError::Emission(found) }
    )
}

compile_headers(
    original: &String,
    headers:
        super::super::frontend::headers::ParsedHeaders,
    declarations:
        &super::super::frontend::scanner::DeclarationIndex
) -> Result<Bytes, CompileError> {
    let resolution_index = try(
        Result::map_err(
            super::super::frontend::resolution::build_resolution_index(
                &headers,
                declarations
            ),
            { found => CompileError::ResolutionIndex(found) }
        ),
        @compile_headers
    );
    let interfaces = try(
        Result::map_err(
            super::super::frontend::elaboration::collect_interfaces(
                &headers,
                declarations
            ),
            { found => CompileError::InterfaceCollection(found) }
        ),
        @compile_headers
    );
    compile_interfaces(
        original,
        &headers,
        &resolution_index,
        declarations,
        interfaces
    )
}

compile_declarations(
    original: &String,
    source: super::super::frontend::lexer::LexedSource,
    declarations:
        super::super::frontend::scanner::DeclarationIndex
) -> Result<Bytes, CompileError> {
    let headers = try(
        Result::map_err(
            super::super::frontend::headers::parse(
                original,
                source,
                &declarations
            ),
            { found => CompileError::Headers(found) }
        ),
        @compile_declarations
    );
    compile_headers(original, headers, &declarations)
}

pub compile_source(original: &String) -> Result<Bytes, CompileError> {
    let source = try(
        Result::map_err(
            super::super::frontend::lexer::lex(original),
            { found => CompileError::Lex(found) }
        ),
        @compile_source
    );
    let declarations = try(
        Result::map_err(
            super::super::frontend::scanner::scan(&source),
            { found => CompileError::Scan(found) }
        ),
        @compile_source
    );
    compile_declarations(original, source, declarations)
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    if(Vec::len(&arguments) < 2) {
        write_diagnostic(
            "usage: grandiose-self-host-compiler <output.grbc> <input.glorious>"
        )
    } else {
        let output_path = *Vec::index(&arguments, 0);
        let input_path = *Vec::index(&arguments, 1);
        let bytes = read_file(input_path);
        handle String::from_utf8(bytes) {
            Result::Err(_) =>
                write_diagnostic("self-host compiler: input is not UTF-8"),
            Result::Ok(source) => handle compile_source(&source) {
                Result::Err(_) =>
                    write_diagnostic("self-host compiler: compilation failed"),
                Result::Ok(artifact) =>
                    write_file(output_path, artifact)
            }
        }
    }
}
