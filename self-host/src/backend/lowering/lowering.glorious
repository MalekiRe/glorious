pub mir_types() -> MirTypes {
    Arena::new()
}

alloc_mir_type(value: &mut MirTypes, mir_type: MirType) -> MirTypeId {
    handle Arena::alloc(&mut *value, mir_type) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

absent_type_name_index() -> u32 { 4294967295 }

pub reserve_mir_type(value: &mut MirTypes) -> MirTypeId {
    alloc_mir_type(value, MirType {
        kind: MirTypeKind::Pending,
        name_index: absent_type_name_index(),
        field_names: Vec::new(),
        fields: Vec::new(),
        variants: Vec::new(),
        copy_flag: 0,
        effect_signature: mir_signature(
            Vec::new(), artifact_type_id(0), Vec::new()
        ),
        resumption_lower: 0,
        resumption_upper: Option::Some(0)
    })
}

set_mir_type(
    value: &mut MirTypes,
    id: MirTypeId,
    kind: MirTypeKind,
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>,
    variants: Vec<MirVariant>,
    copy_flag: u32
) {
    let slot = Arena::index_mut(&mut *value, id);
    (*slot).kind = kind;
    (*slot).name_index = name_index;
    (*slot).field_names = field_names;
    (*slot).fields = fields;
    (*slot).variants = variants;
    (*slot).copy_flag = copy_flag;
    (*slot).effect_signature = mir_signature(
        Vec::new(), artifact_type_id(0), Vec::new()
    );
    (*slot).resumption_lower = 0;
    (*slot).resumption_upper = Option::Some(0);
    ()
}

pub set_resumption_type(
    value: &mut MirTypes,
    id: MirTypeId,
    identity_name_index: u32,
    input: ArtifactTypeId,
    output: ArtifactTypeId,
    effect_signature: MirSignature,
    lower_uses: u32,
    upper_uses: Option<u32>,
    copy_flag: u32
) {
    let fields = Vec::new();
    Vec::push(&mut fields, input);
    Vec::push(&mut fields, output);
    let slot = Arena::index_mut(&mut *value, id);
    (*slot).kind = MirTypeKind::Resumption;
    (*slot).name_index = identity_name_index;
    (*slot).field_names = Vec::new();
    (*slot).fields = fields;
    (*slot).variants = Vec::new();
    (*slot).copy_flag = copy_flag;
    (*slot).effect_signature = effect_signature;
    (*slot).resumption_lower = lower_uses;
    (*slot).resumption_upper = upper_uses;
    ()
}

pub set_tuple_type(
    value: &mut MirTypes,
    id: MirTypeId,
    fields: Vec<ArtifactTypeId>,
    copy_flag: u32
) {
    set_mir_type(
        value,
        id,
        MirTypeKind::Tuple,
        absent_type_name_index(),
        Vec::new(),
        fields,
        Vec::new(),
        copy_flag
    )
}

pub set_unary_structural_type(
    value: &mut MirTypes,
    id: MirTypeId,
    kind: MirTypeKind,
    element: ArtifactTypeId,
    copy_flag: u32
) {
    let fields = Vec::new();
    Vec::push(&mut fields, element);
    set_mir_type(
        value,
        id,
        kind,
        absent_type_name_index(),
        Vec::new(),
        fields,
        Vec::new(),
        copy_flag
    )
}

pub set_struct_type(
    value: &mut MirTypes,
