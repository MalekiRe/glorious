mir_function_has_block_start(
    value: &MirFunction,
    offset: u32,
    index: usize
) -> Bool {
    if(index < Arena::len(&value.blocks)) {
        handle *Arena::index(&value.blocks, Id::from_u32(checked_u32(index))) {
            None => mir_function_has_block_start(value, offset, index + 1),
            Option::Some(found) => if(found == offset) {
                true
            } else {
                mir_function_has_block_start(value, offset, index + 1)
            }
        }
    } else { false }
}

pub mir_function_instruction_ends_block(
    value: &MirFunction,
    index: usize
) -> Bool {
    if(index + 1 == Vec::len(&value.instructions)) {
        true
    } else {
        mir_function_has_block_start(value, checked_u32(index + 1), 0)
    }
}

mir_function_host_role_at(
    value: &MirFunction,
    index: usize
) -> Option<u32> {
    if(index < Vec::len(&value.instructions)) {
        handle Vec::index(&value.instructions, index) {
            MirInstruction::HostCall(_, role, _) => Option::Some(role),
            _ => mir_function_host_role_at(value, index + 1)
        }
    } else { None }
}

pub mir_program_host_function(
    value: &MirProgram,
    role: u32,
    index: usize
) -> Option<MirFunctionId> {
    if(index < mir_program_function_count(value)) {
        let id = mir_function_id_from_usize(index);
        handle mir_function_host_role_at(
            mir_program_function_at(value, id),
            0
        ) {
            Option::Some(found) => if(found == role) {
                Option::Some(id)
            } else { mir_program_host_function(value, role, index + 1) },
            None => mir_program_host_function(value, role, index + 1)
        }
    } else { None }
}

