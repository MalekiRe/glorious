pub push_resumption_type(
    value: &mut MirTypes,
    identity_name_index: u32,
    input: ArtifactTypeId,
    output: ArtifactTypeId,
    effect_signature: MirSignature,
    lower_uses: u32,
    upper_uses: Option<u32>,
    copy_flag: u32
) -> MirTypeId {
    let id = reserve_mir_type(value);
    set_resumption_type(
        value,
        id,
        identity_name_index,
        input,
        output,
        effect_signature,
        lower_uses,
        upper_uses,
        copy_flag
