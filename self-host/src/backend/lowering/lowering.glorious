        MirTypeKind::Enum,
        name_index,
        Vec::new(),
        Vec::new(),
        variants,
        copy_flag
    )
}

pub push_tuple_type(
    value: &mut MirTypes,
    fields: Vec<ArtifactTypeId>,
    copy_flag: u32
) -> MirTypeId {
    let id = reserve_mir_type(value);
    set_tuple_type(value, id, fields, copy_flag);
    id
}

pub push_struct_type(
    value: &mut MirTypes,
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>,
