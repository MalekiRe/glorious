                instance
            )
        ) {
            None => unreachable(),
            Option::Some(found) => found
        },
        outward_protocols: Vec::new(),
        register_count: parameter_count + 1,
        instructions: instructions,
        cleanups: Vec::new(),
        register_packs: Arena::new(),
        function_packs: Arena::new(),
        blocks: Arena::new(),
        switch_packs: Arena::new()
    };
    try(validate_final_mir_walkers(
        &output
    ), @lower_abort_function);
    Result::Ok(output)
}

pub lower_host_function<'a>(
    name: String,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    instance: super::super::frontend::elaboration::CallableInstanceId,
    import: u32,
    type_map: &'a ArtifactTypeMap
) -> Result<MirFunction, LoweringError> {
    let parameter_count =
        super::super::frontend::elaboration::
            callable_instance_parameter_count(interfaces, instance);
    let parameters = Vec::new();
    instance_parameter_types(
        interfaces,
        instance,
        type_map,
        0,
        parameter_count,
        &mut parameters
    );
    let result_semantic =
        super::super::frontend::elaboration::callable_instance_result(
            interfaces,
            instance
        );
    let builder = MirBuilder {
        type_map: type_map,
        locals: Vec::new(),
        place_flow: PlaceFlowFacts {
            final_transfers: IndexVec::new(),
            matches: Vec::new()
        },
        live_order: Vec::new(),
        instructions: Vec::new(),
        cleanups: Vec::new(),
        register_packs: Arena::new(),
        blocks: Arena::new(),
        switch_packs: Arena::new(),
        register_count: parameter_count + 1
    };
    push_parameter_locals(
        &mut builder.locals,
        &mut builder.live_order,
        0,
        parameter_count
    );
    let arguments = Vec::new();
    for_range(Range::new(0, usize_from_u32(parameter_count)), { index =>
        Vec::push(&mut arguments, Id::from_u32(checked_u32(index) + 1))
    });
    let target = if(Id::to_u32(result_semantic) == 0) {
        None
    } else {
        Option::Some(alloc_register(&mut builder))
    };
    emit_host_call(&mut builder, target, import, arguments);
    emit_return(&mut builder, target);
    try(validate_mir_builder(
        &builder,
        interfaces
    ), @lower_host_function);
    let output = MirFunction {
        name: name,
        parameters: parameters,
        result: handle mapped_artifact_type(type_map, result_semantic) {
            None => unreachable(),
            Option::Some(found) => found
        },
        outward_protocols: Vec::new(),
        register_count: builder.register_count,
        instructions: builder.instructions,
        cleanups: builder.cleanups,
        register_packs: builder.register_packs,
        function_packs: Arena::new(),
        blocks: builder.blocks,
        switch_packs: builder.switch_packs
    };
    try(validate_final_mir_walkers(
        &output
    ), @lower_host_function);
    Result::Ok(output)
}

collect_instruction_constants(
    function: &MirFunction,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    for_range(Range::new(
        index,
        Vec::len(&function.instructions)
    ), { current => {
        handle Vec::index(&function.instructions, current) {
            MirInstruction::Const(_, key) =>
                Vec::push(&mut *output, Bytes::to_vec(key)),
            MirInstruction::Switch(_, pack, _) =>
                collect_switch_case_constants(
                    function,
                    pack,
                    0,
                    output
                ),
            _ => ()
        }
    } })
}

collect_switch_case_constants(
    value: &MirFunction,
    pack: MirSwitchPackId,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    let cases = Arena::index(&value.switch_packs, pack);
    for_range(Range::new(
        index,
        Vec::len(&cases.cases)
    ), { current => {
        let case = Vec::index(&cases.cases, current);
        let key = mir_switch_case_key(case);
        Vec::push(
            &mut *output,
            Bytes::to_vec(*key)
        )
    } })
}

collect_function_constants(
    functions: &Arena<MirFunctionTag, MirFunction>,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    for_range(Range::new(index, Arena::len(functions)), { current => {
        let function = Arena::index(
            functions,
            mir_function_id_from_usize(current)
        );
        collect_instruction_constants(
            function,
            0,
            output
        )
    } })
}

store_constants(
    values: VecIntoIter<Vec<u8>>,
    output: &mut Arena<MirConstantTag, Vec<u8>>
) {
    handle VecIntoIter::next(values) {
        None => (),
        Option::Some((value, remaining)) => {
            handle Arena::alloc(&mut *output, value) {
                Result::Err(_) => unreachable(),
                Result::Ok(_) => ()
            };
            store_constants(remaining, output)
        }
    }
}

artifact_zero_sized(
    facts: &Vec<MirTypeFacts>,
    type_id: ArtifactTypeId
) -> Bool {
    let raw = artifact_type_raw(type_id);
    if(raw < 19) {
        raw == 0 or { raw == 1 }
    } else {
        Vec::index(
            facts,
            wrapping_convert_to_usize(raw - 19)
        ).zero_sized
    }
}

artifact_permits_zero_use(
    facts: &Vec<MirTypeFacts>,
    type_id: ArtifactTypeId
) -> Bool {
    let raw = artifact_type_raw(type_id);
    if(raw < 19) {
        raw != 1
    } else {
        Vec::index(
            facts,
            wrapping_convert_to_usize(raw - 19)
        ).permits_zero_use
    }
}

fields_zero_sized(
    fields: &Vec<ArtifactTypeId>,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Vec::len(fields)) {
        artifact_zero_sized(facts, *Vec::index(fields, index)) and {
            fields_zero_sized(fields, facts, index + 1)
        }
    } else { true }
}

fields_permit_zero_use(
    fields: &Vec<ArtifactTypeId>,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Vec::len(fields)) {
        artifact_permits_zero_use(facts, *Vec::index(fields, index)) and {
            fields_permit_zero_use(fields, facts, index + 1)
        }
    } else { true }
}

variants_zero_sized(
    variants: &Vec<MirVariant>,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Vec::len(variants)) {
        let variant = Vec::index(variants, index);
        fields_zero_sized(
            &variant.fields,
            facts,
            0
        ) and { variants_zero_sized(variants, facts, index + 1) }
    } else { true }
}

variants_permit_zero_use(
    variants: &Vec<MirVariant>,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Vec::len(variants)) {
        let variant = Vec::index(variants, index);
        fields_permit_zero_use(
            &variant.fields,
            facts,
            0
        ) and { variants_permit_zero_use(variants, facts, index + 1) }
    } else { true }
}

derive_type_facts(
    types: &MirTypes,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> MirTypeFacts {
    let mir_type = Arena::index(types, mir_type_id_from_usize(index));
    handle mir_type.kind {
        MirTypeKind::Pending => MirTypeFacts {
            zero_sized: false,
            permits_zero_use: false
        },
        MirTypeKind::Tuple => MirTypeFacts {
            zero_sized: fields_zero_sized(&mir_type.fields, facts, 0),
            permits_zero_use: fields_permit_zero_use(
                &mir_type.fields,
                facts,
                0
            )
        },
        MirTypeKind::Array => MirTypeFacts {
            zero_sized: false,
            permits_zero_use: false
        },
        MirTypeKind::SharedReference => MirTypeFacts {
            zero_sized: false,
            permits_zero_use: true
        },
        MirTypeKind::UniqueReference => MirTypeFacts {
            zero_sized: false,
            permits_zero_use: true
        },
        MirTypeKind::Struct => MirTypeFacts {
            zero_sized: fields_zero_sized(&mir_type.fields, facts, 0),
            permits_zero_use: fields_permit_zero_use(
                &mir_type.fields,
                facts,
                0
            )
        },
        MirTypeKind::Enum => MirTypeFacts {
            zero_sized: Vec::len(&mir_type.variants) <= 1 and {
                variants_zero_sized(&mir_type.variants, facts, 0)
            },
            permits_zero_use: variants_permit_zero_use(
                &mir_type.variants,
                facts,
                0
            )
        },
        MirTypeKind::Resumption => MirTypeFacts {
            zero_sized: false,
            permits_zero_use: mir_type.resumption_lower == 0
        }
    }
}

initialize_type_facts(
    types: &MirTypes,
    facts: &mut Vec<MirTypeFacts>,
    index: usize
) {
    if(index < Arena::len(types)) {
        Vec::push(
            &mut *facts,
            MirTypeFacts {
                zero_sized: true,
                permits_zero_use: true
            }
        );
        initialize_type_facts(types, facts, index + 1)
    } else { () }
}

fact_changed(previous: Bool, next: Bool) -> Bool {
    if(previous) {
        if(next) { false } else { true }
    } else { false }
}

update_type_fact(
    facts: &mut Vec<MirTypeFacts>,
    index: usize,
    derived: MirTypeFacts
) -> Bool {
    let current = Vec::index_mut(&mut *facts, index);
    let zero_sized_changed = fact_changed(
        current.zero_sized,
        derived.zero_sized
    );
    let zero_use_changed = fact_changed(
        current.permits_zero_use,
        derived.permits_zero_use
    );
    let changed = if(zero_sized_changed) {
        true
    } else { zero_use_changed };
    current.zero_sized = derived.zero_sized;
    current.permits_zero_use = derived.permits_zero_use;
    changed
}

refine_type_facts(
    types: &MirTypes,
    facts: &mut Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Arena::len(types)) {
        let derived = derive_type_facts(types, &*facts, index);
        let changed = update_type_fact(facts, index, derived);
        let following_changed = refine_type_facts(types, facts, index + 1);
        if(following_changed) { true } else { changed }
    } else { false }
}

stabilize_type_facts(types: &MirTypes, facts: &mut Vec<MirTypeFacts>) {
    if(refine_type_facts(types, facts, 0)) {
        stabilize_type_facts(types, facts)
    } else { () }
}

compute_type_facts(types: &MirTypes) -> Vec<MirTypeFacts> {
    let facts = Vec::with_capacity(Arena::len(types));
    initialize_type_facts(types, &mut facts, 0);
    stabilize_type_facts(types, &mut facts);
    facts
}

pub finish_program(
    functions: Arena<MirFunctionTag, MirFunction>,
    types: MirTypes,
    type_names: Vec<String>
) -> MirProgram {
    let canonical_constants = Vec::new();
    collect_function_constants(&functions, 0, &mut canonical_constants);
    Vec::sort(&mut canonical_constants);
    Vec::dedup(&mut canonical_constants);
    let constants = Arena::new();
    store_constants(
        Vec::into_iter(canonical_constants),
        &mut constants
    );
    let type_facts = compute_type_facts(&types);
    MirProgram {
        functions: functions,
        constants: constants,
        types: types,
        type_facts: type_facts,
        type_names: type_names,
        protocols: Arena::new(),
        handler_definitions: Arena::new()
    }
}

// Backend integration boundary for effect-aware lowering. Continuation
// capture is deliberately not serialized here: the Core-to-MIR ownership pass
// must use its capture facts to construct each instruction's cleanup entry.
// The emitted cleanup table is the VM contract for cancellation and terminal
// abandonment.
pub finish_effect_program(
    functions: Arena<MirFunctionTag, MirFunction>,
    types: MirTypes,
    type_names: Vec<String>,
    protocols: Arena<MirProtocolTag, MirProtocol>,
    handler_definitions:
        Arena<MirHandlerDefinitionTag, MirHandlerDefinition>
) -> MirProgram {
    let value = finish_program(functions, types, type_names);
    value.protocols = protocols;
    value.handler_definitions = handler_definitions;
    value
}

pub new_mir_function(
    name: String,
    parameters: Vec<ArtifactTypeId>,
    result: ArtifactTypeId,
    outward_protocols: Vec<u32>,
    register_count: u32
) -> MirFunction {
    MirFunction {
        name: name,
        parameters: parameters,
        result: result,
        outward_protocols: outward_protocols,
        register_count: register_count,
        instructions: Vec::new(),
        cleanups: Vec::new(),
        register_packs: Arena::new(),
        function_packs: Arena::new(),
        blocks: Arena::new(),
        switch_packs: Arena::new()
    }
}

pub alloc_mir_register_pack(
    value: &mut MirFunction,
    registers: Vec<RegisterId>
) -> RegisterPackId {
    handle Arena::alloc(
        &mut value.register_packs,
        RegisterPack { registers: registers }
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub alloc_mir_function_pack(
    value: &mut MirFunction,
    functions: Vec<MirFunctionId>
) -> MirFunctionPackId {
    handle Arena::alloc(
        &mut value.function_packs,
        MirFunctionPack { functions: functions }
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub push_mir_instruction(
    value: &mut MirFunction,
    instruction: MirInstruction
) {
    Vec::push(&mut value.instructions, instruction)
}

pub push_mir_cleanup(
    value: &mut MirFunction,
    first_instruction: u32,
    end_instruction: u32,
    registers: Vec<RegisterId>
) {
    Vec::push(&mut value.cleanups, MirCleanup {
        first_instruction: first_instruction,
        end_instruction: end_instruction,
        registers: registers
    })
}
