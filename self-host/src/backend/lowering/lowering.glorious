// MIR ownership-aware lowering from the finalized self-hosted Core.
//
// This module intentionally stops before the GRBC container layer.  Its
// instructions retain semantic constant keys and argument lists; the artifact
// writer canonicalizes the shared constant and operand tables afterwards.

use super::super::frontend::elaboration::CoreComputationView;
use super::super::frontend::elaboration::CoreComputationId;
use super::super::frontend::elaboration::CoreLocalId;
use super::super::frontend::elaboration::CoreMatchArm;
use super::super::frontend::elaboration::CoreMatchBinding;
use super::super::frontend::elaboration::CoreValueView;
use super::super::frontend::elaboration::CoreValueId;
use super::super::frontend::elaboration::CoreValueTag;
use super::super::frontend::elaboration::ConstructionField;
use super::super::frontend::elaboration::ConstructionFlavor;
use super::super::frontend::elaboration::IntegerConstantId;
use super::super::frontend::elaboration::InterfaceCallableId;
use super::super::frontend::elaboration::InterfaceCallableTag;
use super::super::frontend::elaboration::InterfaceNominalView;
use super::super::frontend::elaboration::InterfaceTypeView;
use super::super::frontend::elaboration::TypeId;
use super::super::frontend::scanner::ShellId;

pub struct RegisterTag {}
pub type RegisterId = Id<RegisterTag>;

pub struct RegisterPackTag {}
pub type RegisterPackId = Id<RegisterPackTag>;

// Every interface callable has exactly one MIR function. Sharing the tag
// makes that identity structural: calls cannot accidentally index a separately
// ordered function arena.
pub type MirFunctionTag = InterfaceCallableTag;
pub type MirFunctionId = InterfaceCallableId;

pub struct MirTypeTag {}
pub type MirTypeId = Id<MirTypeTag>;

pub struct ArtifactTypeTag {}
pub type ArtifactTypeId = Id<ArtifactTypeTag>;

pub struct MirConstantTag {}
pub type MirConstantId = Id<MirConstantTag>;

pub struct MirBlockTag {}
pub type MirBlockId = Id<MirBlockTag>;

pub struct MirSwitchPackTag {}
pub type MirSwitchPackId = Id<MirSwitchPackTag>;

pub enum MirInstruction {
    Const(RegisterId, Bytes),
    Move(RegisterId, RegisterId),
    Copy(RegisterId, RegisterId),
    Construct(RegisterId, ArtifactTypeId, Option<u32>, RegisterPackId),
    ProjectMove(RegisterId, RegisterId, u32),
    ProjectCopy(RegisterId, RegisterId, u32),
    EnumTag(RegisterId, RegisterId),
    Drop(RegisterId),
    Deconstruct(RegisterId),
    Jump(MirBlockId),
    Switch(RegisterId, MirSwitchPackId, MirBlockId),
    Call(Option<RegisterId>, MirFunctionId, RegisterPackId),
    Return(Option<RegisterId>)
}

pub struct MirSwitchCase {
    key: Bytes,
    target: MirBlockId
}

pub struct MirSwitchPack { cases: Vec<MirSwitchCase> }

pub struct MirVariant {
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>
}

pub enum MirTypeKind {
    Tuple,
    Struct,
    Enum
}

impl Use<[0, *]> for MirTypeKind {}

pub struct MirType {
    kind: MirTypeKind,
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>,
    variants: Vec<MirVariant>,
    copy_flag: u32
}

struct MirTypeFacts {
    zero_sized: Bool,
    permits_zero_use: Bool
}

impl Use<[0, *]> for MirTypeFacts {}

pub type MirTypes = Arena<MirTypeTag, MirType>;

pub enum MirVariantView<'a> {
    Variant(
        u32,
        Slice<'a, u32>,
        Slice<'a, ArtifactTypeId>
    )
}

impl<'a> Use<[0, *]> for MirVariantView<'a> {}

pub struct RegisterPack { registers: Vec<RegisterId> }

pub struct MirCleanup {
    first_instruction: u32,
    end_instruction: u32,
    registers: Vec<RegisterId>
}

pub struct MirFunction {
    name: String,
    parameters: Vec<ArtifactTypeId>,
    result: ArtifactTypeId,
    register_count: u32,
    instructions: Vec<MirInstruction>,
    cleanups: Vec<MirCleanup>,
    register_packs: Arena<RegisterPackTag, RegisterPack>,
    blocks: Arena<MirBlockTag, Option<u32>>,
    switch_packs: Arena<MirSwitchPackTag, MirSwitchPack>
}

pub struct MirProgram {
    functions: Arena<MirFunctionTag, MirFunction>,
    constants: Arena<MirConstantTag, Vec<u8>>,
    types: MirTypes,
    type_facts: Vec<MirTypeFacts>,
    type_names: Vec<String>
}

pub enum LoweringError {
    UnsupportedScalar(TypeId),
    MissingLocal(CoreLocalId),
    MissingProjectionSource(CoreValueId),
    MissingValue(CoreValueId),
    UnknownCallable(ShellId),
    InvalidConstructionType(TypeId),
    ConstructionFieldCount(TypeId, u32, u32),
    UnexpectedVariant(TypeId, u32),
    MissingVariant(TypeId),
    VariantOutOfRange(TypeId, u32),
    ConstructionFieldOrder(u32, u32),
    MissingResult(TypeId),
    MissingMatchSubject(CoreValueId),
    MissingMatchResult(CoreComputationId),
    InvalidMatchType(TypeId),
    MatchBindingCount(TypeId, u32, u32),
    MissingMatchFlow(CoreComputationId),
    MatchStateMismatch,
    MirCleanupCount(u32, u32),
    InvalidMirCleanup(u32),
    InvalidMirRegister(RegisterId),
    UnboundMirBlock(MirBlockId),
    InvalidMirRegisterPack(RegisterPackId),
    InvalidMirSwitchPack(MirSwitchPackId),
    InvalidMirFunction(MirFunctionId)
}

struct MatchFlow {
    computation: CoreComputationId,
    live_out: Vec<Bool>
}

struct PlaceFlowFacts {
    final_transfers: IndexVec<CoreValueTag, Bool>,
    matches: Vec<MatchFlow>
}

struct MirBuilder {
    locals: Vec<Option<RegisterId>>,
    place_flow: PlaceFlowFacts,
    live_order: Vec<RegisterId>,
    instructions: Vec<MirInstruction>,
    cleanups: Vec<MirCleanup>,
    register_packs: Arena<RegisterPackTag, RegisterPack>,
    blocks: Arena<MirBlockTag, Option<u32>>,
    switch_packs: Arena<MirSwitchPackTag, MirSwitchPack>,
    register_count: u32
}

pub mir_program_function_count(value: &MirProgram) -> usize {
    Arena::len(&value.functions)
}

pub mir_program_function_at<'a>(
    value: &'a MirProgram,
    id: MirFunctionId
) -> &'a MirFunction {
    Arena::index(&value.functions, id)
}

pub mir_program_constant_count(value: &MirProgram) -> usize {
    Arena::len(&value.constants)
}

pub mir_program_constant_at<'a>(
    value: &'a MirProgram,
    id: MirConstantId
) -> &'a Vec<u8> {
    Arena::index(&value.constants, id)
}

pub mir_program_type_count(value: &MirProgram) -> usize {
    Arena::len(&value.types)
}

pub mir_program_type_kind(
    value: &MirProgram,
    id: MirTypeId
) -> MirTypeKind {
    Arena::index(&value.types, id).kind
}

pub mir_program_type_name_at(
    value: &MirProgram,
    index: usize
) -> &String {
    Vec::index(&value.type_names, index)
}

pub mir_types() -> MirTypes {
    Arena::new()
}

alloc_mir_type(value: &mut MirTypes, mir_type: MirType) -> MirTypeId {
    handle Arena::alloc(&mut *value, mir_type) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

absent_type_name_index() -> u32 { 4294967295 }

pub push_tuple_type(
    value: &mut MirTypes,
    fields: Vec<ArtifactTypeId>,
    copy_flag: u32
) -> MirTypeId {
    alloc_mir_type(value, MirType {
        kind: MirTypeKind::Tuple,
        name_index: absent_type_name_index(),
        field_names: Vec::new(),
        fields: fields,
        variants: Vec::new(),
        copy_flag: copy_flag
    })
}

pub push_struct_type(
    value: &mut MirTypes,
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>,
    copy_flag: u32
) -> MirTypeId {
    alloc_mir_type(value, MirType {
        kind: MirTypeKind::Struct,
        name_index: name_index,
        field_names: field_names,
        fields: fields,
        variants: Vec::new(),
        copy_flag: copy_flag
    })
}

pub enum_variant(
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>
) -> MirVariant {
    MirVariant {
        name_index: name_index,
        field_names: field_names,
        fields: fields
    }
}

pub push_enum_type(
    value: &mut MirTypes,
    name_index: u32,
    variants: Vec<MirVariant>,
    copy_flag: u32
) -> MirTypeId {
    alloc_mir_type(value, MirType {
        kind: MirTypeKind::Enum,
        name_index: name_index,
        field_names: Vec::new(),
        fields: Vec::new(),
        variants: variants,
        copy_flag: copy_flag
    })
}

pub mir_program_tuple_fields<'a>(
    value: &'a MirProgram,
    id: MirTypeId
) -> Slice<'a, ArtifactTypeId> {
    let found = Arena::index(&value.types, id);
    Vec::as_slice(&found.fields)
}

pub mir_program_struct_name(value: &MirProgram, id: MirTypeId) -> u32 {
    Arena::index(&value.types, id).name_index
}

pub mir_program_struct_field_names<'a>(
    value: &'a MirProgram,
    id: MirTypeId
) -> Slice<'a, u32> {
    let found = Arena::index(&value.types, id);
    Vec::as_slice(&found.field_names)
}

pub mir_program_struct_fields<'a>(
    value: &'a MirProgram,
    id: MirTypeId
) -> Slice<'a, ArtifactTypeId> {
    let found = Arena::index(&value.types, id);
    Vec::as_slice(&found.fields)
}

pub mir_program_enum_name(value: &MirProgram, id: MirTypeId) -> u32 {
    Arena::index(&value.types, id).name_index
}

pub mir_program_enum_variants<'a>(
    value: &'a MirProgram,
    id: MirTypeId
) -> Slice<'a, MirVariant> {
    let found = Arena::index(&value.types, id);
    Vec::as_slice(&found.variants)
}

pub mir_program_type_copy_flag(value: &MirProgram, id: MirTypeId) -> u32 {
    Arena::index(&value.types, id).copy_flag
}

pub mir_program_type_zero_sized_flag(
    value: &MirProgram,
    id: MirTypeId
) -> u32 {
    if(Vec::index(&value.type_facts, Id::to_usize(id)).zero_sized) {
        2
    } else { 0 }
}

pub mir_program_type_zero_use_flag(
    value: &MirProgram,
    id: MirTypeId
) -> u32 {
    if(Vec::index(&value.type_facts, Id::to_usize(id)).permits_zero_use) {
        16
    } else { 0 }
}

pub mir_variant_view<'a>(
    value: &'a MirVariant
) -> MirVariantView<'a> {
    MirVariantView::Variant(
        value.name_index,
        Vec::as_slice(&value.field_names),
        Vec::as_slice(&value.fields)
    )
}

pub mir_function_name(value: &MirFunction) -> &String { &value.name }

pub mir_function_parameter_count(value: &MirFunction) -> usize {
    Vec::len(&value.parameters)
}

pub mir_function_parameter_at(
    value: &MirFunction,
    index: usize
) -> ArtifactTypeId {
    *Vec::index(&value.parameters, index)
}

pub mir_function_result(value: &MirFunction) -> ArtifactTypeId {
    value.result
}

pub mir_function_register_count(value: &MirFunction) -> u32 {
    value.register_count
}

pub mir_function_instruction_count(value: &MirFunction) -> usize {
    Vec::len(&value.instructions)
}

pub mir_function_instruction_at<'a>(
    value: &'a MirFunction,
    index: usize
) -> &'a MirInstruction {
    Vec::index(&value.instructions, index)
}

pub mir_function_cleanup_count(value: &MirFunction) -> usize {
    Vec::len(&value.cleanups)
}

pub mir_function_cleanup_at<'a>(
    value: &'a MirFunction,
    index: usize
) -> &'a MirCleanup {
    Vec::index(&value.cleanups, index)
}

pub mir_cleanup_first(value: &MirCleanup) -> u32 {
    value.first_instruction
}

pub mir_cleanup_end(value: &MirCleanup) -> u32 {
    value.end_instruction
}

pub mir_cleanup_register_count(value: &MirCleanup) -> usize {
    Vec::len(&value.registers)
}

pub mir_cleanup_register_at(
    value: &MirCleanup,
    index: usize
) -> RegisterId {
    *Vec::index(&value.registers, index)
}

pub mir_function_register_pack<'a>(
    value: &'a MirFunction,
    id: RegisterPackId
) -> &'a RegisterPack {
    Arena::index(&value.register_packs, id)
}

pub register_pack_count(value: &RegisterPack) -> u32 {
    checked_u32(Vec::len(&value.registers))
}

pub register_pack_at(value: &RegisterPack, index: usize) -> RegisterId {
    *Vec::index(&value.registers, index)
}

pub mir_function_block_offset(
    value: &MirFunction,
    id: MirBlockId
) -> u32 {
    handle *Arena::index(&value.blocks, id) {
        Result::Err(_) => unreachable(),
        Result::Ok(offset) => offset
    }
}

pub mir_function_switch_pack<'a>(
    value: &'a MirFunction,
    id: MirSwitchPackId
) -> &'a MirSwitchPack {
    Arena::index(&value.switch_packs, id)
}

pub mir_switch_pack_count(value: &MirSwitchPack) -> usize {
    Vec::len(&value.cases)
}

pub mir_switch_pack_at<'a>(
    value: &'a MirSwitchPack,
    index: usize
) -> &'a MirSwitchCase {
    Vec::index(&value.cases, index)
}

pub mir_switch_case_key(value: &MirSwitchCase) -> &Bytes {
    &value.key
}

pub mir_switch_case_target(value: &MirSwitchCase) -> MirBlockId {
    value.target
}

pub register_raw(value: RegisterId) -> u32 { Id::to_u32(value) }

checked_u32(value: usize) -> u32 {
    handle checked_usize_to_u32(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

usize_from_u32(value: u32) -> usize {
    wrapping_convert_to_usize(value)
}

pub mir_function_id_from_usize(value: usize) -> MirFunctionId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub mir_type_id_from_usize(value: usize) -> MirTypeId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub mir_constant_id_from_usize(value: usize) -> MirConstantId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub mir_function_raw(value: MirFunctionId) -> u32 {
    Id::to_u32(value)
}

pub artifact_type_raw(value: ArtifactTypeId) -> u32 {
    Id::to_u32(value)
}

pub mir_constant_raw(value: MirConstantId) -> u32 {
    Id::to_u32(value)
}

pub artifact_type_id(value: u32) -> ArtifactTypeId {
    Id::from_u32(if(value < 14) {
        value
    } else {
        value + 5
    })
}

pub mir_type_artifact_id(value: MirTypeId) -> ArtifactTypeId {
    Id::from_u32(
        Id::to_u32(value) + wrapping_convert_to_u32(19)
    )
}

append_u32_bytes(output: &mut Vec<u8>, value: u32, count: usize) {
    if(count == 0) {
        ()
    } else {
        Vec::push(&mut *output, wrapping_convert_to_u8(value));
        append_u32_bytes(
            output,
            shift_right(value, 8),
            count - 1
        )
    }
}

append_constant_words(
    output: &mut Vec<u8>,
    value: &super::super::frontend::elaboration::IntegerConstantView,
    word: usize,
    bytes: usize
) {
    if(bytes == 0) {
        ()
    } else {
        let take = if(bytes < 4) { bytes } else { 4 };
        append_u32_bytes(
            output,
            super::super::frontend::elaboration::integer_constant_view_word(
                value,
                word
            ),
            take
        );
        append_constant_words(
            output,
            value,
            word + 1,
            bytes - take
        )
    }
}

scalar_width(type_id: u32) -> Option<usize> {
    handle type_id {
        0 => Option::Some(0),
        2 => Option::Some(1),
        3 => Option::Some(2),
        4 => Option::Some(4),
        5 => Option::Some(8),
        6 => Option::Some(16),
        7 => Option::Some(1),
        8 => Option::Some(2),
        9 => Option::Some(4),
        10 => Option::Some(8),
        11 => Option::Some(16),
        12 => Option::Some(8),
        13 => Option::Some(8),
        _ => None
    }
}

constant_key(
    body: &super::super::frontend::elaboration::TypedBody,
    type_id: TypeId,
    constant: IntegerConstantId
) -> Result<Bytes, LoweringError> {
    let type_raw = Id::to_u32(type_id);
    handle scalar_width(type_raw) {
        Result::Err(_) =>
            Result::Err(LoweringError::UnsupportedScalar(type_id)),
        Result::Ok(width) => {
            let output = Vec::new();
            Vec::push(&mut output, wrapping_convert_to_u8(
                artifact_type_raw(artifact_type_id(type_raw))
            ));
            let words =
                super::super::frontend::elaboration::
                    typed_body_integer_constant_at(
                        body,
                        constant
            );
            append_constant_words(&mut output, &words, 0, width);
            Result::Ok(Bytes::from_vec(output))
        }
    }
}

u32_constant_key(value: u32) -> Bytes {
    let output = Vec::new();
    Vec::push(&mut output, 4);
    Vec::push(&mut output, wrapping_convert_to_u8(value));
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 256)
    );
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 65536)
    );
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 16777216)
    );
    Bytes::from_vec(output)
}

push_missing_locals(
    output: &mut Vec<Option<RegisterId>>,
    remaining: usize
) {
    for_range(Range::new(0, remaining), { _ => {
        Vec::push(&mut *output, None);
        ()
    } })
}

push_liveness_flags(output: &mut Vec<Bool>, remaining: usize) {
    for_range(Range::new(0, remaining), { _ =>
        Vec::push(&mut *output, false)
    })
}

push_transfer_flags(
    output: &mut IndexVec<CoreValueTag, Bool>,
    remaining: usize
) {
    for_range(Range::new(0, remaining), { _ => {
        handle IndexVec::push(&mut *output, false) {
            Result::Err(_) => unreachable(),
            Result::Ok(_) => ()
        }
    } })
}

struct PlaceFlowAnalysis {
    live: Vec<Bool>,
    facts: PlaceFlowFacts
}

copy_liveness(source: &Vec<Bool>) -> Vec<Bool> {
    let output = Vec::new();
    for_range(Range::new(0, Vec::len(source)), { index =>
        Vec::push(&mut output, *Vec::index(source, index))
    });
    output
}

union_liveness(output: &mut Vec<Bool>, source: &Vec<Bool>) {
    for_range(Range::new(0, Vec::len(source)), { index => {
        if(*Vec::index(source, index)) {
            *Vec::index_mut(&mut *output, index) = true;
            ()
        } else { () }
    } })
}

analyze_value(
    body: &super::super::frontend::elaboration::TypedBody,
    id: CoreValueId,
    output: &mut PlaceFlowAnalysis,
    allow_transfer: Bool
) {
    handle super::super::frontend::elaboration::typed_body_value_at(body, id) {
        CoreValueView::Local(_, local, _) => {
            let live = Vec::index_mut(
                &mut output.live,
                Id::to_usize(local)
            );
            if(allow_transfer and {
                super::super::frontend::elaboration::
                    typed_body_transfer_candidate(body, id)
            }) {
                if(*live) { () } else {
                    *IndexVec::index_mut(
                        &mut output.facts.final_transfers,
                        id
                    ) = true;
                    ()
                }
            } else { () };
            *live = true;
            ()
        },
        CoreValueView::Projection(_, source, _) =>
            analyze_value(body, source, output, allow_transfer),
        CoreValueView::Embedded(_, computation) =>
            analyze_computation(
                body,
                computation,
                output,
                allow_transfer
            ),
        _ => ()
    }
}

analyze_values_reverse<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    values: Slice<'a, CoreValueId>,
    remaining: usize,
    output: &mut PlaceFlowAnalysis,
    allow_transfer: Bool
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let value = handle Slice::get(values, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => *found
        };
        analyze_value(body, value, output, allow_transfer);
        analyze_values_reverse(
            body,
            values,
            index,
            output,
            allow_transfer
        )
    }
}

analyze_fields_reverse<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    fields: Slice<'a, ConstructionField>,
    remaining: usize,
    output: &mut PlaceFlowAnalysis,
    allow_transfer: Bool
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let field = handle Slice::get(fields, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        analyze_value(
            body,
            super::super::frontend::elaboration::
                construction_field_value(field),
            output,
            allow_transfer
        );
        analyze_fields_reverse(
            body,
            fields,
            index,
            output,
            allow_transfer
        )
    }
}

remove_match_bindings<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    arm: &CoreMatchArm,
    output: &mut PlaceFlowAnalysis
) {
    let bindings = super::super::frontend::elaboration::
        core_match_arm_bindings(body, arm);
    Slice::for_each(bindings, { binding =>
        handle super::super::frontend::elaboration::
            core_match_binding_local(binding) {
            None => (),
            Option::Some(local) => {
                *Vec::index_mut(
                    &mut output.live,
                    Id::to_usize(local)
                ) = false;
                ()
            }
        }
    })
}

analyze_match_arms<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    arms: Slice<'a, CoreMatchArm>,
    live_out: &Vec<Bool>,
    joined: &mut Vec<Bool>,
    ordinal: usize,
    output: &mut PlaceFlowAnalysis
) {
    if(ordinal < Slice::len(arms)) {
        let arm = handle Slice::get(arms, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        output.live = copy_liveness(live_out);
        analyze_computation(
            body,
            super::super::frontend::elaboration::core_match_arm_body(arm),
            output,
            true
        );
        remove_match_bindings(body, arm, output);
        union_liveness(joined, &output.live);
        analyze_match_arms(
            body,
            arms,
            live_out,
            joined,
            ordinal + 1,
            output
        )
    } else { () }
}

analyze_computation(
    body: &super::super::frontend::elaboration::TypedBody,
    id: CoreComputationId,
    output: &mut PlaceFlowAnalysis,
    allow_transfer: Bool
) {
    handle super::super::frontend::elaboration::
        typed_body_computation_at(body, id) {
        CoreComputationView::Pure(_, value) =>
            analyze_value(body, value, output, allow_transfer),
        CoreComputationView::Let(_, local, initializer, remainder) => {
            analyze_computation(body, remainder, output, allow_transfer);
            *Vec::index_mut(&mut output.live, Id::to_usize(local)) = false;
            analyze_computation(body, initializer, output, allow_transfer)
        },
        CoreComputationView::Call(_, _, operands) =>
            analyze_values_reverse(
                body,
                operands,
                Slice::len(operands),
                output,
                allow_transfer
            ),
        CoreComputationView::Construct(_, _, fields) =>
            analyze_fields_reverse(
                body,
                fields,
                Slice::len(fields),
                output,
                allow_transfer
            ),
        CoreComputationView::VariantDispatch(_, subject, arms) => {
            let live_out = copy_liveness(&output.live);
            Vec::push(&mut output.facts.matches, MatchFlow {
                computation: id,
                live_out: copy_liveness(&live_out)
            });
            let joined = copy_liveness(&live_out);
            analyze_match_arms(
                body,
                arms,
                &live_out,
                &mut joined,
                0,
                output
            );
            output.live = joined;
            analyze_value(body, subject, output, allow_transfer)
        }
    }
}

analyze_place_flow(
    body: &super::super::frontend::elaboration::TypedBody
) -> PlaceFlowFacts {
    let live = Vec::new();
    push_liveness_flags(
        &mut live,
        super::super::frontend::elaboration::typed_body_local_count(body)
    );
    let final_transfers = IndexVec::new();
    push_transfer_flags(
        &mut final_transfers,
        super::super::frontend::elaboration::typed_body_value_count(body)
    );
    let output = PlaceFlowAnalysis {
        live: live,
        facts: PlaceFlowFacts {
            final_transfers: final_transfers,
            matches: Vec::new()
        }
    };
    analyze_computation(
        body,
        super::super::frontend::elaboration::typed_body_root(body),
        &mut output,
        true
    );
    output.facts
}

push_parameter_locals(
    output: &mut Vec<Option<RegisterId>>,
    live: &mut Vec<RegisterId>,
    index: u32,
    count: u32
) {
    for_range(Range::new(
        usize_from_u32(index),
        usize_from_u32(count)
    ), { current => {
        let register = Id::from_u32(checked_u32(current) + 1);
        Vec::push(&mut *output, Option::Some(register));
        Vec::push(&mut *live, register)
    } })
}

reverse_registers(
    source: &Vec<RegisterId>,
    output: &mut Vec<RegisterId>,
    remaining: usize
) {
    for_range(Range::new(0, remaining), { current =>
        Vec::push(
            &mut *output,
            *Vec::index(source, remaining - current - 1)
        )
    })
}

record_cleanup(value: &mut MirBuilder) {
    let instruction = checked_u32(Vec::len(&value.instructions));
    let registers = Vec::new();
    reverse_registers(
        &value.live_order,
        &mut registers,
        Vec::len(&value.live_order)
    );
    Vec::push(&mut value.cleanups, MirCleanup {
        first_instruction: instruction,
        end_instruction: instruction + 1,
        registers: registers
    })
}

alloc_register(value: &mut MirBuilder) -> RegisterId {
    let found = value.register_count;
    value.register_count = found + 1;
    Id::from_u32(found)
}

alloc_register_pack(
    value: &mut MirBuilder,
    registers: Vec<RegisterId>
) -> RegisterPackId {
    handle Arena::alloc(
        &mut value.register_packs,
        RegisterPack { registers: registers }
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

alloc_block(value: &mut MirBuilder) -> MirBlockId {
    handle Arena::alloc(&mut value.blocks, None) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

bind_block(value: &mut MirBuilder, id: MirBlockId) {
    *Arena::index_mut(&mut value.blocks, id) =
        Option::Some(checked_u32(Vec::len(&value.instructions)));
    ()
}

alloc_switch_pack(
    value: &mut MirBuilder,
    cases: Vec<MirSwitchCase>
) -> MirSwitchPackId {
    handle Arena::alloc(
        &mut value.switch_packs,
        MirSwitchPack { cases: cases }
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

find_live(
    value: &Vec<RegisterId>,
    register: RegisterId,
    index: usize
) -> Option<usize> {
    if(index < Vec::len(value)) {
        if(*Vec::index(value, index) == register) {
            Option::Some(index)
        } else {
            find_live(value, register, index + 1)
        }
    } else { None }
}

move_live(
    value: &mut MirBuilder,
    source: RegisterId,
    target: RegisterId
) {
    handle find_live(&value.live_order, source, 0) {
        Result::Err(_) => unreachable(),
        Result::Ok(index) => {
            *Vec::index_mut(&mut value.live_order, index) = target;
            ()
        }
    }
}

consume_live(value: &mut MirBuilder, register: RegisterId) {
    handle find_live(&value.live_order, register, 0) {
        Result::Err(_) => unreachable(),
        Result::Ok(index) => {
            Vec::remove(&mut value.live_order, index);
            ()
        }
    }
}

emit_const(value: &mut MirBuilder, target: RegisterId, key: Bytes) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Const(
        target,
        key
    ));
    Vec::push(&mut value.live_order, target)
}

emit_move(
    value: &mut MirBuilder,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Move(
        target,
        source
    ));
    move_live(value, source, target)
}

emit_copy(
    value: &mut MirBuilder,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Copy(
        target,
        source
    ));
    Vec::push(&mut value.live_order, target)
}

emit_construct(
    value: &mut MirBuilder,
    target: RegisterId,
    ty: ArtifactTypeId,
    variant: Option<u32>,
    fields: Vec<RegisterId>
) {
    record_cleanup(value);
    consume_arguments(value, &fields, 0);
    let pack = alloc_register_pack(value, fields);
    Vec::push(&mut value.instructions, MirInstruction::Construct(
        target,
        ty,
        variant,
        pack
    ));
    Vec::push(&mut value.live_order, target)
}

emit_project_move(
    value: &mut MirBuilder,
    target: RegisterId,
    source: RegisterId,
    field: u32
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::ProjectMove(
        target,
        source,
        field
    ));
    Vec::push(&mut value.live_order, target)
}

emit_project_copy(
    value: &mut MirBuilder,
    target: RegisterId,
    source: RegisterId,
    field: u32
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::ProjectCopy(
        target,
        source,
        field
    ));
    Vec::push(&mut value.live_order, target)
}

emit_enum_tag(
    value: &mut MirBuilder,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::EnumTag(
        target,
        source
    ));
    Vec::push(&mut value.live_order, target)
}

emit_drop(value: &mut MirBuilder, register: RegisterId) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Drop(register));
    consume_live(value, register)
}

emit_deconstruct(value: &mut MirBuilder, register: RegisterId) {
    record_cleanup(value);
    Vec::push(
        &mut value.instructions,
        MirInstruction::Deconstruct(register)
    );
    consume_live(value, register)
}

emit_jump(value: &mut MirBuilder, target: MirBlockId) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Jump(target))
}

emit_switch(
    value: &mut MirBuilder,
    discriminant: RegisterId,
    cases: Vec<MirSwitchCase>,
    otherwise: MirBlockId
) {
    record_cleanup(value);
    let pack = alloc_switch_pack(value, cases);
    Vec::push(&mut value.instructions, MirInstruction::Switch(
        discriminant,
        pack,
        otherwise
    ))
}

consume_arguments(
    value: &mut MirBuilder,
    arguments: &Vec<RegisterId>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(arguments)), { current =>
        consume_live(value, *Vec::index(arguments, current))
    })
}

emit_call(
    value: &mut MirBuilder,
    target: Option<RegisterId>,
    function: MirFunctionId,
    arguments: Vec<RegisterId>
) {
    record_cleanup(value);
    consume_arguments(value, &arguments, 0);
    let pack = alloc_register_pack(value, arguments);
    Vec::push(&mut value.instructions, MirInstruction::Call(
        target,
        function,
        pack
    ));
    let inserted = target;
    if(inserted is Result::Ok(register)) {
        Vec::push(&mut value.live_order, register)
    } else { () }
}

emit_return(value: &mut MirBuilder, source: Option<RegisterId>) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Return(source))
}

local_register(
    value: &MirBuilder,
    local: CoreLocalId
) -> Option<RegisterId> {
    *Vec::index(&value.locals, Id::to_usize(local))
}

set_local(
    value: &mut MirBuilder,
    local: CoreLocalId,
    register: Option<RegisterId>
) {
    *Vec::index_mut(&mut value.locals, Id::to_usize(local)) = register;
    ()
}

lower_value(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder,
    id: CoreValueId
) -> Result<Option<RegisterId>, LoweringError> {
    handle super::super::frontend::elaboration::typed_body_value_at(
        body,
        id
    ) {
        CoreValueView::Unit(_) => {
            let target = alloc_register(value);
            let key = Vec::new();
            Vec::push(&mut key, 0);
            emit_const(value, target, Bytes::from_vec(key));
            Result::Ok(Option::Some(target))
        },
        CoreValueView::Integer(type_id, constant) => {
            let target = alloc_register(value);
            let key = try(
                constant_key(body, type_id, constant),
                @lower_value
            );
            emit_const(value, target, key);
            Result::Ok(Option::Some(target))
        },
        CoreValueView::Local(type_id, local, _) => {
            type_id;
            let transfer = *IndexVec::index(
                &value.place_flow.final_transfers,
                id
            );
            handle local_register(value, local) {
                Result::Err(_) =>
                    Result::Err(LoweringError::MissingLocal(local)),
                Result::Ok(source) => {
                    let target = alloc_register(value);
                    if(transfer) {
                        emit_move(value, target, source);
                        set_local(value, local, None)
                    } else {
                        emit_copy(value, target, source)
                    };
                    Result::Ok(Option::Some(target))
                }
            }
        },
        CoreValueView::Projection(_, source, field) => {
            let lowered = try(
                lower_value(interfaces, body, value, source),
                @lower_value
            );
            handle lowered {
                Result::Err(_) =>
                    Result::Err(
                        LoweringError::MissingProjectionSource(id)
                    ),
                Result::Ok(source_register) => {
                    let target = alloc_register(value);
                    emit_project_copy(
                        value,
                        target,
                        source_register,
                        field
                    );
                    emit_drop(value, source_register);
                    Result::Ok(Option::Some(target))
                }
            }
        },
        CoreValueView::Embedded(_, computation) =>
            lower_computation(interfaces, body, value, computation)
    }
}

lower_arguments<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder,
    operands: Slice<'a, CoreValueId>,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    Slice::try_for_each(operands, { operand => {
        let id = *operand;
        let lowered = try(
            lower_value(interfaces, body, value, id),
            @lower_arguments
        );
        handle lowered {
            Result::Err(_) =>
                Result::Err(LoweringError::MissingValue(id)),
            Result::Ok(register) => {
                Vec::push(&mut *output, register);
                Result::Ok(())
            }
        }
    } })
}

append_optional_registers(
    source: &Vec<Option<RegisterId>>,
    output: &mut Vec<Option<RegisterId>>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(source)), { current =>
        Vec::push(&mut *output, *Vec::index(source, current))
    })
}

append_registers(
    source: &Vec<RegisterId>,
    output: &mut Vec<RegisterId>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(source)), { current =>
        Vec::push(&mut *output, *Vec::index(source, current))
    })
}

snapshot_locals(value: &MirBuilder) -> Vec<Option<RegisterId>> {
    let output = Vec::new();
    append_optional_registers(&value.locals, &mut output, 0);
    output
}

snapshot_live(value: &MirBuilder) -> Vec<RegisterId> {
    let output = Vec::new();
    append_registers(&value.live_order, &mut output, 0);
    output
}

restore_match_state(
    value: &mut MirBuilder,
    locals: &Vec<Option<RegisterId>>,
    live: &Vec<RegisterId>
) {
    Vec::clear(&mut value.locals);
    append_optional_registers(locals, &mut value.locals, 0);
    Vec::clear(&mut value.live_order);
    append_registers(live, &mut value.live_order, 0)
}

optional_registers_equal(
    left: &Vec<Option<RegisterId>>,
    right: &Vec<Option<RegisterId>>,
    index: usize
) -> Bool {
    if(Vec::len(left) == Vec::len(right)) {
        if(index < Vec::len(left)) {
            if(Eq::eq(
                Vec::index(left, index),
                Vec::index(right, index)
            )) {
                optional_registers_equal(left, right, index + 1)
            } else { false }
        } else { true }
    } else { false }
}

registers_equal(
    left: &Vec<RegisterId>,
    right: &Vec<RegisterId>,
    index: usize
) -> Bool {
    if(Vec::len(left) == Vec::len(right)) {
        if(index < Vec::len(left)) {
            if(*Vec::index(left, index) == *Vec::index(right, index)) {
                registers_equal(left, right, index + 1)
            } else { false }
        } else { true }
    } else { false }
}

alloc_match_blocks(
    value: &mut MirBuilder,
    count: usize,
    index: usize,
    output: &mut Vec<MirBlockId>
) {
    for_range(Range::new(index, count), { _ =>
        Vec::push(&mut *output, alloc_block(value))
    })
}

build_match_switch_cases<'a>(
    arms: Slice<'a, CoreMatchArm>,
    blocks: &Vec<MirBlockId>,
    count: usize,
    index: usize,
    output: &mut Vec<MirSwitchCase>
) {
    for_range(Range::new(index, count), { current => {
        let arm = handle Slice::get(arms, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        Vec::push(&mut *output, MirSwitchCase {
            key: u32_constant_key(
                super::super::frontend::elaboration::
                    core_match_arm_variant(arm)
            ),
            target: *Vec::index(blocks, current)
        })
    } })
}

project_match_fields<'a>(
    value: &mut MirBuilder,
    subject: RegisterId,
    bindings: Slice<'a, CoreMatchBinding>,
    index: usize,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    try_for_range(Range::new(index, Slice::len(bindings)), { current => {
        let binding = handle Slice::get(bindings, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let field =
            super::super::frontend::elaboration::
                core_match_binding_field(binding);
        if(field == checked_u32(current)) {
            let target = alloc_register(value);
            emit_project_move(value, target, subject, field);
            Vec::push(&mut *output, target);
            Result::Ok(())
        } else {
            Result::Err(LoweringError::ConstructionFieldOrder(
                checked_u32(current),
                field
            ))
        }
    } })
}

install_match_bindings_reverse<'a>(
    value: &mut MirBuilder,
    bindings: Slice<'a, CoreMatchBinding>,
    registers: &Vec<RegisterId>,
    remaining: usize
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let binding = handle Slice::get(bindings, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let register = *Vec::index(registers, index);
        handle
            super::super::frontend::elaboration::
                core_match_binding_local(binding) {
            Result::Err(_) => emit_drop(value, register),
            Result::Ok(local) =>
                set_local(value, local, Option::Some(register))
        };
        install_match_bindings_reverse(
            value,
            bindings,
            registers,
            index
        )
    }
}

drop_match_locals_reverse<'a>(
    value: &mut MirBuilder,
    bindings: Slice<'a, CoreMatchBinding>,
    remaining: usize
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let binding = handle Slice::get(bindings, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        handle
            super::super::frontend::elaboration::
                core_match_binding_local(binding) {
            Result::Err(_) => (),
            Result::Ok(local) => handle local_register(value, local) {
                Result::Err(_) => (),
                Result::Ok(register) => {
                    emit_drop(value, register);
                    set_local(value, local, None)
                }
            }
        };
        drop_match_locals_reverse(value, bindings, index)
    }
}

match_flow_index(
    facts: &PlaceFlowFacts,
    computation: CoreComputationId,
    index: usize
) -> Option<usize> {
    if(index < Vec::len(&facts.matches)) {
        let found = Vec::index(&facts.matches, index);
        if(found.computation == computation) {
            Option::Some(index)
        } else {
            match_flow_index(facts, computation, index + 1)
        }
    } else { None }
}

retire_dead_match_locals(
    value: &mut MirBuilder,
    baseline: &Vec<Option<RegisterId>>,
    live_out: &Vec<Bool>,
    index: usize
) {
    if(index < Vec::len(baseline)) {
        if(*Vec::index(live_out, index)) { () } else {
            handle *Vec::index(baseline, index) {
                None => (),
                Option::Some(_) => {
                    let local = Id::from_u32(checked_u32(index));
                    handle local_register(value, local) {
                        None => (),
                        Option::Some(register) => {
                            emit_drop(value, register);
                            set_local(value, local, None)
                        }
                    }
                }
            }
        };
        retire_dead_match_locals(
            value,
            baseline,
            live_out,
            index + 1
        )
    } else { () }
}

lower_match_arms<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder,
    arms: Slice<'a, CoreMatchArm>,
    blocks: &Vec<MirBlockId>,
    subject: RegisterId,
    tag: RegisterId,
    result: RegisterId,
    join: MirBlockId,
    baseline_locals: &Vec<Option<RegisterId>>,
    baseline_live: &Vec<RegisterId>,
    match_live_out: &Vec<Bool>,
    canonical_locals: &mut Vec<Option<RegisterId>>,
    canonical_live: &mut Vec<RegisterId>,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Slice::len(arms)) {
        restore_match_state(value, baseline_locals, baseline_live);
        bind_block(value, *Vec::index(blocks, index));
        emit_drop(value, tag);
        let arm = handle Slice::get(arms, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let bindings =
            super::super::frontend::elaboration::
                core_match_arm_bindings(body, arm);
        let registers = Vec::new();
        try(project_match_fields(
            value,
            subject,
            bindings,
            0,
            &mut registers
        ), @lower_match_arms);
        emit_deconstruct(value, subject);
        install_match_bindings_reverse(
            value,
            bindings,
            &registers,
            Vec::len(&registers)
        );
        let arm_computation =
            super::super::frontend::elaboration::
                core_match_arm_body(arm);
        let lowered = try(lower_computation(
            interfaces,
            body,
            value,
            arm_computation
        ), @lower_match_arms);
        drop_match_locals_reverse(
            value,
            bindings,
            Slice::len(bindings)
        );
        retire_dead_match_locals(
            value,
            baseline_locals,
            match_live_out,
            0
        );
        handle lowered {
            Result::Err(_) => Result::Err(
                LoweringError::MissingMatchResult(arm_computation)
            ),
            Result::Ok(branch_result) => {
                emit_move(value, result, branch_result);
                emit_jump(value, join);
                if(index == 0) {
                    Vec::clear(canonical_locals);
                    append_optional_registers(
                        &value.locals,
                        canonical_locals,
                        0
                    );
                    Vec::clear(canonical_live);
                    append_registers(
                        &value.live_order,
                        canonical_live,
                        0
                    );
                    lower_match_arms(
                        interfaces,
                        body,
                        value,
                        arms,
                        blocks,
                        subject,
                        tag,
                        result,
                        join,
                        baseline_locals,
                        baseline_live,
                        match_live_out,
                        canonical_locals,
                        canonical_live,
                        index + 1
                    )
                } else {
                    let locals_match = optional_registers_equal(
                        &value.locals,
                        canonical_locals,
                        0
                    );
                    let live_match = if(locals_match) {
                        registers_equal(
                            &value.live_order,
                            canonical_live,
                            0
                        )
                    } else { false };
                    if(live_match) {
                        lower_match_arms(
                            interfaces,
                            body,
                            value,
                            arms,
                            blocks,
                            subject,
                            tag,
                            result,
                            join,
                            baseline_locals,
                            baseline_live,
                            match_live_out,
                            canonical_locals,
                            canonical_live,
                            index + 1
                        )
                    } else {
                        Result::Err(LoweringError::MatchStateMismatch)
                    }
                }
            }
        }
    } else { Result::Ok(()) }
}

lower_match<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder,
    computation: CoreComputationId,
    subject: CoreValueId,
    arms: Slice<'a, CoreMatchArm>
) -> Result<Option<RegisterId>, LoweringError> {
    let flow_index = handle match_flow_index(
        &value.place_flow,
        computation,
        0
    ) {
        None => @lower_match(Result::Err(
            LoweringError::MissingMatchFlow(computation)
        )),
        Option::Some(found) => found
    };
    let flow = Vec::index(&value.place_flow.matches, flow_index);
    let match_live = copy_liveness(&flow.live_out);
    let lowered_subject = try(lower_value(
        interfaces,
        body,
        value,
        subject
    ), @lower_match);
    handle lowered_subject {
        Result::Err(_) =>
            Result::Err(LoweringError::MissingMatchSubject(subject)),
        Result::Ok(subject_register) => {
            if(Slice::len(arms) == 0) {
                Result::Err(LoweringError::MatchStateMismatch)
            } else {
                let tag = alloc_register(value);
                emit_enum_tag(value, tag, subject_register);
                let result = alloc_register(value);
                let blocks = Vec::new();
                alloc_match_blocks(
                    value,
                    Slice::len(arms),
                    0,
                    &mut blocks
                );
                let join = alloc_block(value);
                let explicit_count = Slice::len(arms) - 1;
                let cases = Vec::new();
                build_match_switch_cases(
                    arms,
                    &blocks,
                    explicit_count,
                    0,
                    &mut cases
                );
                emit_switch(
                    value,
                    tag,
                    cases,
                    *Vec::index(&blocks, explicit_count)
                );
                let baseline_locals = snapshot_locals(&*value);
                let baseline_live = snapshot_live(&*value);
                let canonical_locals = Vec::new();
                let canonical_live = Vec::new();
                try(lower_match_arms(
                    interfaces,
                    body,
                    value,
                    arms,
                    &blocks,
                    subject_register,
                    tag,
                    result,
                    join,
                    &baseline_locals,
                    &baseline_live,
                    &match_live,
                    &mut canonical_locals,
                    &mut canonical_live,
                    0
                ), @lower_match);
                restore_match_state(
                    value,
                    &canonical_locals,
                    &canonical_live
                );
                bind_block(value, join);
                Result::Ok(Option::Some(result))
            }
        }
    }
}

lower_computation(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder,
    id: CoreComputationId
) -> Result<Option<RegisterId>, LoweringError> {
    handle
        super::super::frontend::elaboration::typed_body_computation_at(
            body,
            id
        ) {
        CoreComputationView::Pure(_, found) =>
            lower_value(interfaces, body, value, found),
        CoreComputationView::Let(_, local, initializer, remainder) => {
            let initialized = try(
                lower_computation(
                    interfaces,
                    body,
                    value,
                    initializer
                ),
                @lower_computation
            );
            set_local(value, local, initialized);
            lower_computation(interfaces, body, value, remainder)
        },
        CoreComputationView::Call(type_id, shell, operands) => {
            let arguments = Vec::new();
            try(lower_arguments(
                interfaces,
                body,
                value,
                operands,
                &mut arguments
            ), @lower_computation);
            handle
                super::super::frontend::elaboration::
                    interface_callable_for_shell(interfaces, shell) {
                Result::Err(_) =>
                    Result::Err(LoweringError::UnknownCallable(shell)),
                Result::Ok(function) => {
                    let target = Option::Some(alloc_register(value));
                    emit_call(
                        value,
                        target,
                        function,
                        arguments
                    );
                    Result::Ok(target)
                }
            }
        },
        CoreComputationView::Construct(type_id, flavor, fields) => {
            handle super::super::frontend::elaboration::interface_type_at(
                interfaces,
                Id::to_usize(type_id)
            ) {
                InterfaceTypeView::Tuple(elements) => handle flavor {
                    ConstructionFlavor::Product => lower_aggregate(
                        interfaces,
                        body,
                        value,
                        type_id,
                        None,
                        fields,
                        checked_u32(Slice::len(elements))
                    ),
                    ConstructionFlavor::Variant(ordinal) =>
                        Result::Err(
                            LoweringError::UnexpectedVariant(
                                type_id,
                                ordinal
                            )
                        )
                },
                InterfaceTypeView::Nominal(nominal) => handle
                    super::super::frontend::elaboration::
                        interface_nominal_at_view(
                            interfaces,
                            usize_from_u32(nominal)
                        ) {
                    InterfaceNominalView::Struct(_, _, expected) =>
                        handle flavor {
                            ConstructionFlavor::Product =>
                                lower_aggregate(
                                    interfaces,
                                    body,
                                    value,
                                    type_id,
                                    None,
                                    fields,
                                    expected
                                ),
                            ConstructionFlavor::Variant(ordinal) =>
                                Result::Err(
                                    LoweringError::UnexpectedVariant(
                                        type_id,
                                        ordinal
                                    )
                                )
                        },
                    InterfaceNominalView::Enum(_, start, count) =>
                        handle flavor {
                            ConstructionFlavor::Product =>
                                Result::Err(
                                    LoweringError::MissingVariant(type_id)
                                ),
                            ConstructionFlavor::Variant(ordinal) =>
                                if(ordinal < count) {
                                    let payloads =
                                        super::super::frontend::elaboration::
                                            interface_variant_payloads_at(
                                                interfaces,
                                                usize_from_u32(
                                                    start + ordinal
                                                )
                                            );
                                    lower_aggregate(
                                        interfaces,
                                        body,
                                        value,
                                        type_id,
                                        Option::Some(ordinal),
                                        fields,
                                        checked_u32(Slice::len(payloads))
                                    )
                                } else {
                                    Result::Err(
                                        LoweringError::VariantOutOfRange(
                                            type_id,
                                            ordinal
                                        )
                                    )
                                }
                },
                },
                _ => Result::Err(
                    LoweringError::InvalidConstructionType(type_id)
                )
            }
        },
        CoreComputationView::VariantDispatch(_, subject, arms) =>
            lower_match(interfaces, body, value, id, subject, arms)
    }
}

lower_aggregate<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder,
    type_id: TypeId,
    variant: Option<u32>,
    fields: Slice<'a, ConstructionField>,
    expected: u32
) -> Result<Option<RegisterId>, LoweringError> {
    if(checked_u32(Slice::len(fields)) == expected) {
            let registers = Vec::new();
            try(lower_product_fields(
                interfaces,
                body,
                value,
                fields,
                &mut registers
            ), @lower_aggregate);
            let target = alloc_register(value);
            emit_construct(
                value,
                target,
                artifact_type_id(Id::to_u32(type_id)),
                variant,
                registers
            );
            Result::Ok(Option::Some(target))
        } else {
            Result::Err(LoweringError::ConstructionFieldCount(
                type_id,
                expected,
                checked_u32(Slice::len(fields))
            ))
        }
}

lower_product_fields<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder,
    fields: Slice<'a, ConstructionField>,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    Slice::try_for_each(fields, { entry => {
        let field =
            super::super::frontend::elaboration::
                construction_field_ordinal(entry);
        let operand =
            super::super::frontend::elaboration::
                construction_field_value(entry);
        if(field == checked_u32(Vec::len(output))) {
            let lowered = try(
                lower_value(interfaces, body, value, operand),
                @lower_product_fields
            );
            handle lowered {
                Result::Err(_) =>
                    Result::Err(LoweringError::MissingValue(operand)),
                Result::Ok(register) => {
                    Vec::push(&mut *output, register);
                    Result::Ok(())
                }
            }
        } else {
            Result::Err(LoweringError::ConstructionFieldOrder(
                checked_u32(Vec::len(output)),
                field
            ))
        }
    } })
}

parameter_types(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    function: InterfaceCallableId,
    index: u32,
    count: u32,
    output: &mut Vec<ArtifactTypeId>
) {
    for_range(Range::new(
        usize_from_u32(index),
        usize_from_u32(count)
    ), { current =>
        Vec::push(
            &mut *output,
            artifact_type_id(
                Id::to_u32(super::super::frontend::elaboration::
                    interface_callable_parameter_at(
                        interfaces,
                        function,
                        current
                    ))
            )
        )
    })
}

validate_mir_register(
    value: &MirBuilder,
    register: RegisterId
) -> Result<(), LoweringError> {
    if(Id::to_u32(register) < value.register_count) {
        Result::Ok(())
    } else {
        Result::Err(LoweringError::InvalidMirRegister(register))
    }
}

validate_optional_mir_register(
    value: &MirBuilder,
    register: Option<RegisterId>
) -> Result<(), LoweringError> {
    handle register {
        None => Result::Ok(()),
        Option::Some(found) => validate_mir_register(value, found)
    }
}

validate_mir_register_pack(
    value: &MirBuilder,
    pack: RegisterPackId,
    index: usize
) -> Result<(), LoweringError> {
    if(Id::to_usize(pack) < Arena::len(&value.register_packs)) {
        let found = Arena::index(&value.register_packs, pack);
        if(index < Vec::len(&found.registers)) {
            try(validate_mir_register(
                value,
                *Vec::index(&found.registers, index)
            ), @validate_mir_register_pack);
            validate_mir_register_pack(value, pack, index + 1)
        } else {
            Result::Ok(())
        }
    } else {
        Result::Err(LoweringError::InvalidMirRegisterPack(pack))
    }
}

validate_mir_block(
    value: &MirBuilder,
    block: MirBlockId
) -> Result<(), LoweringError> {
    if(Id::to_usize(block) < Arena::len(&value.blocks)) {
        handle *Arena::index(&value.blocks, block) {
            None => Result::Err(LoweringError::UnboundMirBlock(block)),
            Option::Some(offset) => if(
                usize_from_u32(offset) <= Vec::len(&value.instructions)
            ) {
                Result::Ok(())
            } else {
                Result::Err(LoweringError::UnboundMirBlock(block))
            }
        }
    } else {
        Result::Err(LoweringError::UnboundMirBlock(block))
    }
}

validate_mir_switch_pack(
    value: &MirBuilder,
    pack: MirSwitchPackId,
    index: usize
) -> Result<(), LoweringError> {
    if(Id::to_usize(pack) < Arena::len(&value.switch_packs)) {
        let found = Arena::index(&value.switch_packs, pack);
        if(index < Vec::len(&found.cases)) {
            try(validate_mir_block(
                value,
                Vec::index(&found.cases, index).target
            ), @validate_mir_switch_pack);
            validate_mir_switch_pack(value, pack, index + 1)
        } else {
            Result::Ok(())
        }
    } else {
        Result::Err(LoweringError::InvalidMirSwitchPack(pack))
    }
}

validate_mir_instruction(
    value: &MirBuilder,
    interfaces: &super::super::frontend::elaboration::TypedInterfaces,
    instruction: &MirInstruction
) -> Result<(), LoweringError> {
    if(*instruction is MirInstruction::Const(target, _)) {
        validate_mir_register(value, target)
    } else if(*instruction is MirInstruction::Move(target, source)) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::Copy(target, source)) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::Construct(
        target,
        _,
        _,
        pack
    )) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register_pack(value, pack, 0)
    } else if(*instruction is MirInstruction::ProjectMove(
        target,
        source,
        _
    )) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::ProjectCopy(
        target,
        source,
        _
    )) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::EnumTag(target, source)) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::Drop(register)) {
        validate_mir_register(value, register)
    } else if(*instruction is MirInstruction::Deconstruct(register)) {
        validate_mir_register(value, register)
    } else if(*instruction is MirInstruction::Jump(block)) {
        validate_mir_block(value, block)
    } else if(*instruction is MirInstruction::Switch(
        register,
        pack,
        otherwise
    )) {
        try(validate_mir_register(
            value,
            register
        ), @validate_mir_instruction);
        try(validate_mir_switch_pack(
            value,
            pack,
            0
        ), @validate_mir_instruction);
        validate_mir_block(value, otherwise)
    } else if(*instruction is MirInstruction::Call(target, function, pack)) {
        try(validate_optional_mir_register(
            value,
            target
        ), @validate_mir_instruction);
        try(validate_mir_register_pack(
            value,
            pack,
            0
        ), @validate_mir_instruction);
        if(Id::to_usize(function) <
            super::super::frontend::elaboration::
                interface_callable_count(interfaces)) {
            Result::Ok(())
        } else {
            Result::Err(LoweringError::InvalidMirFunction(function))
        }
    } else if(*instruction is MirInstruction::Return(source)) {
        validate_optional_mir_register(value, source)
    } else {
        unreachable()
    }
}

validate_mir_instructions(
    value: &MirBuilder,
    interfaces: &super::super::frontend::elaboration::TypedInterfaces,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Vec::len(&value.instructions)) {
        try(validate_mir_instruction(
            value,
            interfaces,
            Vec::index(&value.instructions, index)
        ), @validate_mir_instructions);
        validate_mir_instructions(value, interfaces, index + 1)
    } else {
        Result::Ok(())
    }
}

validate_mir_cleanup_registers(
    value: &MirBuilder,
    cleanup: &MirCleanup,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Vec::len(&cleanup.registers)) {
        try(validate_mir_register(
            value,
            *Vec::index(&cleanup.registers, index)
        ), @validate_mir_cleanup_registers);
        validate_mir_cleanup_registers(value, cleanup, index + 1)
    } else {
        Result::Ok(())
    }
}

validate_mir_cleanups(
    value: &MirBuilder,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Vec::len(&value.cleanups)) {
        let cleanup = Vec::index(&value.cleanups, index);
        let instruction = checked_u32(index);
        if(cleanup.first_instruction == instruction and {
            cleanup.end_instruction == instruction + 1
        }) {
            try(validate_mir_cleanup_registers(
                value,
                cleanup,
                0
            ), @validate_mir_cleanups);
            validate_mir_cleanups(value, index + 1)
        } else {
            Result::Err(LoweringError::InvalidMirCleanup(instruction))
        }
    } else {
        Result::Ok(())
    }
}

validate_mir_blocks(
    value: &MirBuilder,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Arena::len(&value.blocks)) {
        try(validate_mir_block(
            value,
            Id::from_u32(checked_u32(index))
        ), @validate_mir_blocks);
        validate_mir_blocks(value, index + 1)
    } else {
        Result::Ok(())
    }
}

validate_mir_builder(
    value: &MirBuilder,
    interfaces: &super::super::frontend::elaboration::TypedInterfaces
) -> Result<(), LoweringError> {
    let instruction_count = Vec::len(&value.instructions);
    let cleanup_count = Vec::len(&value.cleanups);
    if(instruction_count == cleanup_count) {
        try(validate_mir_instructions(
            value,
            interfaces,
            0
        ), @validate_mir_builder);
        try(validate_mir_cleanups(value, 0), @validate_mir_builder);
        validate_mir_blocks(value, 0)
    } else {
        Result::Err(LoweringError::MirCleanupCount(
            checked_u32(instruction_count),
            checked_u32(cleanup_count)
        ))
    }
}

pub lower_function(
    name: String,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    function: InterfaceCallableId
) -> Result<MirFunction, LoweringError> {
    let parameter_count =
        super::super::frontend::elaboration::
            interface_callable_parameter_count(interfaces, function);
    let parameters = Vec::new();
    parameter_types(
        interfaces,
        function,
        0,
        parameter_count,
        &mut parameters
    );
    let local_count =
        super::super::frontend::elaboration::typed_body_local_count(body);
    let place_flow = analyze_place_flow(body);
    let builder = MirBuilder {
        locals: Vec::new(),
        place_flow: place_flow,
        live_order: Vec::new(),
        instructions: Vec::new(),
        cleanups: Vec::new(),
        register_packs: Arena::new(),
        blocks: Arena::new(),
        switch_packs: Arena::new(),
        register_count: parameter_count + 1
    };
    push_parameter_locals(
        &mut builder.locals,
        &mut builder.live_order,
        0,
        parameter_count
    );
    push_missing_locals(
        &mut builder.locals,
        local_count - usize_from_u32(parameter_count)
    );
    let result = try(lower_computation(
        interfaces,
        body,
        &mut builder,
        super::super::frontend::elaboration::typed_body_root(body)
    ), @lower_function);
    let core_result_type =
        super::super::frontend::elaboration::typed_body_result_type(body);
    let result_type = artifact_type_id(Id::to_u32(core_result_type));
    handle result {
        Result::Err(_) =>
            Result::Err(LoweringError::MissingResult(core_result_type)),
        Result::Ok(register) => {
            emit_return(&mut builder, Option::Some(register));
            try(validate_mir_builder(
                &builder,
                interfaces
            ), @lower_function);
            Result::Ok(MirFunction {
                name: name,
                parameters: parameters,
                result: result_type,
                register_count: builder.register_count,
                instructions: builder.instructions,
                cleanups: builder.cleanups,
                register_packs: builder.register_packs,
                blocks: builder.blocks,
                switch_packs: builder.switch_packs
            })
        }
    }
}

collect_instruction_constants(
    function: &MirFunction,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    for_range(Range::new(
        index,
        Vec::len(&function.instructions)
    ), { current => {
        handle Vec::index(&function.instructions, current) {
            MirInstruction::Const(_, key) =>
                Vec::push(&mut *output, Bytes::to_vec(key)),
            MirInstruction::Switch(_, pack, _) =>
                collect_switch_case_constants(
                    function,
                    pack,
                    0,
                    output
                ),
            _ => ()
        }
    } })
}

collect_switch_case_constants(
    value: &MirFunction,
    pack: MirSwitchPackId,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    let cases = Arena::index(&value.switch_packs, pack);
    for_range(Range::new(
        index,
        Vec::len(&cases.cases)
    ), { current => {
        let case = Vec::index(&cases.cases, current);
        let key = mir_switch_case_key(case);
        Vec::push(
            &mut *output,
            Bytes::to_vec(*key)
        )
    } })
}

collect_function_constants(
    functions: &Arena<MirFunctionTag, MirFunction>,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    for_range(Range::new(index, Arena::len(functions)), { current => {
        let function = Arena::index(
            functions,
            mir_function_id_from_usize(current)
        );
        collect_instruction_constants(
            function,
            0,
            output
        )
    } })
}

store_constants(
    values: VecIntoIter<Vec<u8>>,
    output: &mut Arena<MirConstantTag, Vec<u8>>
) {
    handle VecIntoIter::next(values) {
        None => (),
        Option::Some((value, remaining)) => {
            handle Arena::alloc(&mut *output, value) {
                Result::Err(_) => unreachable(),
                Result::Ok(_) => ()
            };
            store_constants(remaining, output)
        }
    }
}

artifact_zero_sized(
    facts: &Vec<MirTypeFacts>,
    type_id: ArtifactTypeId
) -> Bool {
    let raw = artifact_type_raw(type_id);
    if(raw < 19) {
        raw == 0 or { raw == 1 }
    } else {
        Vec::index(
            facts,
            wrapping_convert_to_usize(raw - 19)
        ).zero_sized
    }
}

artifact_permits_zero_use(
    facts: &Vec<MirTypeFacts>,
    type_id: ArtifactTypeId
) -> Bool {
    let raw = artifact_type_raw(type_id);
    if(raw < 19) {
        raw != 1
    } else {
        Vec::index(
            facts,
            wrapping_convert_to_usize(raw - 19)
        ).permits_zero_use
    }
}

fields_zero_sized(
    fields: &Vec<ArtifactTypeId>,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Vec::len(fields)) {
        artifact_zero_sized(facts, *Vec::index(fields, index)) and {
            fields_zero_sized(fields, facts, index + 1)
        }
    } else { true }
}

fields_permit_zero_use(
    fields: &Vec<ArtifactTypeId>,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Vec::len(fields)) {
        artifact_permits_zero_use(facts, *Vec::index(fields, index)) and {
            fields_permit_zero_use(fields, facts, index + 1)
        }
    } else { true }
}

variants_zero_sized(
    variants: &Vec<MirVariant>,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Vec::len(variants)) {
        let variant = Vec::index(variants, index);
        fields_zero_sized(
            &variant.fields,
            facts,
            0
        ) and { variants_zero_sized(variants, facts, index + 1) }
    } else { true }
}

variants_permit_zero_use(
    variants: &Vec<MirVariant>,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Vec::len(variants)) {
        let variant = Vec::index(variants, index);
        fields_permit_zero_use(
            &variant.fields,
            facts,
            0
        ) and { variants_permit_zero_use(variants, facts, index + 1) }
    } else { true }
}

derive_type_facts(
    types: &MirTypes,
    facts: &Vec<MirTypeFacts>,
    index: usize
) -> MirTypeFacts {
    let mir_type = Arena::index(types, mir_type_id_from_usize(index));
    handle mir_type.kind {
        MirTypeKind::Tuple => MirTypeFacts {
            zero_sized: fields_zero_sized(&mir_type.fields, facts, 0),
            permits_zero_use: fields_permit_zero_use(
                &mir_type.fields,
                facts,
                0
            )
        },
        MirTypeKind::Struct => MirTypeFacts {
            zero_sized: fields_zero_sized(&mir_type.fields, facts, 0),
            permits_zero_use: fields_permit_zero_use(
                &mir_type.fields,
                facts,
                0
            )
        },
        MirTypeKind::Enum => MirTypeFacts {
            zero_sized: Vec::len(&mir_type.variants) <= 1 and {
                variants_zero_sized(&mir_type.variants, facts, 0)
            },
            permits_zero_use: variants_permit_zero_use(
                &mir_type.variants,
                facts,
                0
            )
        }
    }
}

initialize_type_facts(
    types: &MirTypes,
    facts: &mut Vec<MirTypeFacts>,
    index: usize
) {
    if(index < Arena::len(types)) {
        Vec::push(
            &mut *facts,
            MirTypeFacts {
                zero_sized: true,
                permits_zero_use: true
            }
        );
        initialize_type_facts(types, facts, index + 1)
    } else { () }
}

fact_changed(previous: Bool, next: Bool) -> Bool {
    if(previous) {
        if(next) { false } else { true }
    } else { false }
}

update_type_fact(
    facts: &mut Vec<MirTypeFacts>,
    index: usize,
    derived: MirTypeFacts
) -> Bool {
    let current = Vec::index_mut(&mut *facts, index);
    let zero_sized_changed = fact_changed(
        current.zero_sized,
        derived.zero_sized
    );
    let zero_use_changed = fact_changed(
        current.permits_zero_use,
        derived.permits_zero_use
    );
    let changed = if(zero_sized_changed) {
        true
    } else { zero_use_changed };
    current.zero_sized = derived.zero_sized;
    current.permits_zero_use = derived.permits_zero_use;
    changed
}

refine_type_facts(
    types: &MirTypes,
    facts: &mut Vec<MirTypeFacts>,
    index: usize
) -> Bool {
    if(index < Arena::len(types)) {
        let derived = derive_type_facts(types, &*facts, index);
        let changed = update_type_fact(facts, index, derived);
        let following_changed = refine_type_facts(types, facts, index + 1);
        if(following_changed) { true } else { changed }
    } else { false }
}

stabilize_type_facts(types: &MirTypes, facts: &mut Vec<MirTypeFacts>) {
    if(refine_type_facts(types, facts, 0)) {
        stabilize_type_facts(types, facts)
    } else { () }
}

compute_type_facts(types: &MirTypes) -> Vec<MirTypeFacts> {
    let facts = Vec::with_capacity(Arena::len(types));
    initialize_type_facts(types, &mut facts, 0);
    stabilize_type_facts(types, &mut facts);
    facts
}

pub finish_program(
    functions: Arena<MirFunctionTag, MirFunction>,
    types: MirTypes,
    type_names: Vec<String>
) -> MirProgram {
    let canonical_constants = Vec::new();
    collect_function_constants(&functions, 0, &mut canonical_constants);
    Vec::sort(&mut canonical_constants);
    Vec::dedup(&mut canonical_constants);
    let constants = Arena::new();
    store_constants(
        Vec::into_iter(canonical_constants),
        &mut constants
    );
    let type_facts = compute_type_facts(&types);
    MirProgram {
        functions: functions,
        constants: constants,
        types: types,
        type_facts: type_facts,
        type_names: type_names
    }
}
