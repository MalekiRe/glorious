// Stage-A ownership-aware lowering from the finalized self-hosted Core.
//
// This module intentionally stops before the GRBC container layer.  Its
// instructions retain semantic constant keys and argument lists; the artifact
// writer canonicalizes the shared constant and operand tables afterwards.

use super::super::frontend::elaboration::CoreComputationView;
use super::super::frontend::elaboration::CoreComputationId;
use super::super::frontend::elaboration::CoreLocalId;
use super::super::frontend::elaboration::CoreMatchArm;
use super::super::frontend::elaboration::CoreMatchBinding;
use super::super::frontend::elaboration::CoreValueView;
use super::super::frontend::elaboration::CoreValueId;
use super::super::frontend::elaboration::ConstructionField;
use super::super::frontend::elaboration::ConstructionFlavor;
use super::super::frontend::elaboration::IntegerConstantId;
use super::super::frontend::elaboration::InterfaceNominalView;
use super::super::frontend::elaboration::InterfaceTypeView;
use super::super::frontend::elaboration::TypeId;

pub struct RegisterTag {}
pub type RegisterId = Id<RegisterTag>;

pub struct RegisterPackTag {}
pub type RegisterPackId = Id<RegisterPackTag>;

pub struct StageFunctionTag {}
pub type StageFunctionId = Id<StageFunctionTag>;

pub struct StageTypeTag {}
pub type StageTypeId = Id<StageTypeTag>;

pub struct ArtifactTypeTag {}
pub type ArtifactTypeId = Id<ArtifactTypeTag>;

pub struct StageConstantTag {}
pub type StageConstantId = Id<StageConstantTag>;

pub struct StageBlockTag {}
pub type StageBlockId = Id<StageBlockTag>;

pub struct StageSwitchPackTag {}
pub type StageSwitchPackId = Id<StageSwitchPackTag>;

pub enum StageInstruction {
    Const(RegisterId, Bytes),
    Move(RegisterId, RegisterId),
    Copy(RegisterId, RegisterId),
    Construct(RegisterId, ArtifactTypeId, Option<u32>, RegisterPackId),
    ProjectMove(RegisterId, RegisterId, u32),
    ProjectCopy(RegisterId, RegisterId, u32),
    EnumTag(RegisterId, RegisterId),
    Drop(RegisterId),
    Deconstruct(RegisterId),
    Jump(StageBlockId),
    Switch(RegisterId, StageSwitchPackId, StageBlockId),
    Call(Option<RegisterId>, StageFunctionId, RegisterPackId),
    Return(Option<RegisterId>)
}

pub struct StageSwitchCase {
    key: Bytes,
    target: StageBlockId
}

pub struct StageSwitchPack { cases: Vec<StageSwitchCase> }

pub struct StageVariant {
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>
}

pub struct StageType {
    tag: u8,
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>,
    variants: Vec<StageVariant>,
    copy_flag: u32
}

pub enum StageTypeView<'a> {
    Tuple(Slice<'a, ArtifactTypeId>, u32),
    Struct(
        u32,
        Slice<'a, u32>,
        Slice<'a, ArtifactTypeId>,
        u32
    ),
    Enum(u32, Slice<'a, StageVariant>, u32),
    Unsupported(u8)
}

impl<'a> Use<[0, *]> for StageTypeView<'a> {}

pub enum StageVariantView<'a> {
    Variant(
        u32,
        Slice<'a, u32>,
        Slice<'a, ArtifactTypeId>
    )
}

impl<'a> Use<[0, *]> for StageVariantView<'a> {}

pub struct RegisterPack { registers: Vec<RegisterId> }

pub struct StageCleanup {
    first_instruction: u32,
    end_instruction: u32,
    registers: Vec<RegisterId>
}

pub struct StageFunction {
    name: String,
    parameters: Vec<ArtifactTypeId>,
    result: ArtifactTypeId,
    register_count: u32,
    instructions: Vec<StageInstruction>,
    cleanups: Vec<StageCleanup>,
    register_packs: Arena<RegisterPackTag, RegisterPack>,
    blocks: Arena<StageBlockTag, Option<u32>>,
    switch_packs: Arena<StageSwitchPackTag, StageSwitchPack>
}

pub struct StageProgram {
    functions: Arena<StageFunctionTag, StageFunction>,
    constants: Arena<StageConstantTag, Vec<u8>>,
    types: Arena<StageTypeTag, StageType>,
    type_names: Vec<String>
}

pub enum LoweringError {
    UnsupportedScalar(TypeId),
    MissingLocal(CoreLocalId),
    MissingProjectionSource(CoreValueId),
    MissingValue(CoreValueId),
    UnknownCallable(u32),
    InvalidConstructionType(TypeId),
    ConstructionFieldCount(TypeId, u32, u32),
    UnexpectedVariant(TypeId, u32),
    MissingVariant(TypeId),
    VariantOutOfRange(TypeId, u32),
    ConstructionFieldOrder(u32, u32),
    MissingResult(TypeId),
    MissingMatchSubject(CoreValueId),
    MissingMatchResult(CoreComputationId),
    InvalidMatchType(TypeId),
    MatchBindingCount(TypeId, u32, u32),
    MatchStateMismatch
}

struct FunctionBuilder {
    locals: Vec<Option<RegisterId>>,
    live_order: Vec<RegisterId>,
    instructions: Vec<StageInstruction>,
    cleanups: Vec<StageCleanup>,
    register_packs: Arena<RegisterPackTag, RegisterPack>,
    blocks: Arena<StageBlockTag, Option<u32>>,
    switch_packs: Arena<StageSwitchPackTag, StageSwitchPack>,
    register_count: u32
}

pub stage_program_function_count(value: &StageProgram) -> usize {
    Arena::len(&value.functions)
}

pub stage_program_function_at<'a>(
    value: &'a StageProgram,
    id: StageFunctionId
) -> &'a StageFunction {
    Arena::index(&value.functions, id)
}

pub stage_program_constant_count(value: &StageProgram) -> usize {
    Arena::len(&value.constants)
}

pub stage_program_constant_at<'a>(
    value: &'a StageProgram,
    id: StageConstantId
) -> &'a Vec<u8> {
    Arena::index(&value.constants, id)
}

pub stage_program_type_count(value: &StageProgram) -> usize {
    Arena::len(&value.types)
}

pub stage_program_type_view<'a>(
    value: &'a StageProgram,
    id: StageTypeId
) -> StageTypeView<'a> {
    stage_type_view(Arena::index(&value.types, id))
}

pub stage_program_type_name_at(
    value: &StageProgram,
    index: usize
) -> &String {
    Vec::index(&value.type_names, index)
}

pub tuple_type(
    fields: Vec<ArtifactTypeId>,
    copy_flag: u32
) -> StageType {
    StageType {
        tag: 0,
        name_index: 4294967295,
        field_names: Vec::new(),
        fields: fields,
        variants: Vec::new(),
        copy_flag: copy_flag
    }
}

pub struct_type(
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>,
    copy_flag: u32
) -> StageType {
    StageType {
        tag: 1,
        name_index: name_index,
        field_names: field_names,
        fields: fields,
        variants: Vec::new(),
        copy_flag: copy_flag
    }
}

pub enum_variant(
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>
) -> StageVariant {
    StageVariant {
        name_index: name_index,
        field_names: field_names,
        fields: fields
    }
}

pub enum_type(
    name_index: u32,
    variants: Vec<StageVariant>,
    copy_flag: u32
) -> StageType {
    StageType {
        tag: 2,
        name_index: name_index,
        field_names: Vec::new(),
        fields: Vec::new(),
        variants: variants,
        copy_flag: copy_flag
    }
}

stage_type_view<'a>(value: &'a StageType) -> StageTypeView<'a> {
    handle value.tag {
        0 => StageTypeView::Tuple(
            Vec::as_slice(&value.fields),
            value.copy_flag
        ),
        1 => StageTypeView::Struct(
            value.name_index,
            Vec::as_slice(&value.field_names),
            Vec::as_slice(&value.fields),
            value.copy_flag
        ),
        2 => StageTypeView::Enum(
            value.name_index,
            Vec::as_slice(&value.variants),
            value.copy_flag
        ),
        tag => StageTypeView::Unsupported(tag)
    }
}

pub stage_variant_view<'a>(
    value: &'a StageVariant
) -> StageVariantView<'a> {
    StageVariantView::Variant(
        value.name_index,
        Vec::as_slice(&value.field_names),
        Vec::as_slice(&value.fields)
    )
}

pub stage_function_name(value: &StageFunction) -> &String { &value.name }

pub stage_function_parameter_count(value: &StageFunction) -> usize {
    Vec::len(&value.parameters)
}

pub stage_function_parameter_at(
    value: &StageFunction,
    index: usize
) -> ArtifactTypeId {
    *Vec::index(&value.parameters, index)
}

pub stage_function_result(value: &StageFunction) -> ArtifactTypeId {
    value.result
}

pub stage_function_register_count(value: &StageFunction) -> u32 {
    value.register_count
}

pub stage_function_instruction_count(value: &StageFunction) -> usize {
    Vec::len(&value.instructions)
}

pub stage_function_instruction_at<'a>(
    value: &'a StageFunction,
    index: usize
) -> &'a StageInstruction {
    Vec::index(&value.instructions, index)
}

pub stage_function_cleanup_count(value: &StageFunction) -> usize {
    Vec::len(&value.cleanups)
}

pub stage_function_cleanup_at<'a>(
    value: &'a StageFunction,
    index: usize
) -> &'a StageCleanup {
    Vec::index(&value.cleanups, index)
}

pub stage_cleanup_first(value: &StageCleanup) -> u32 {
    value.first_instruction
}

pub stage_cleanup_end(value: &StageCleanup) -> u32 {
    value.end_instruction
}

pub stage_cleanup_register_count(value: &StageCleanup) -> usize {
    Vec::len(&value.registers)
}

pub stage_cleanup_register_at(
    value: &StageCleanup,
    index: usize
) -> RegisterId {
    *Vec::index(&value.registers, index)
}

pub stage_function_register_pack<'a>(
    value: &'a StageFunction,
    id: RegisterPackId
) -> &'a RegisterPack {
    Arena::index(&value.register_packs, id)
}

pub register_pack_count(value: &RegisterPack) -> u32 {
    checked_u32(Vec::len(&value.registers))
}

pub register_pack_at(value: &RegisterPack, index: usize) -> RegisterId {
    *Vec::index(&value.registers, index)
}

pub stage_function_block_offset(
    value: &StageFunction,
    id: StageBlockId
) -> u32 {
    handle *Arena::index(&value.blocks, id) {
        Result::Err(_) => unreachable(),
        Result::Ok(offset) => offset
    }
}

pub stage_function_switch_pack<'a>(
    value: &'a StageFunction,
    id: StageSwitchPackId
) -> &'a StageSwitchPack {
    Arena::index(&value.switch_packs, id)
}

pub stage_switch_pack_count(value: &StageSwitchPack) -> usize {
    Vec::len(&value.cases)
}

pub stage_switch_pack_at<'a>(
    value: &'a StageSwitchPack,
    index: usize
) -> &'a StageSwitchCase {
    Vec::index(&value.cases, index)
}

pub stage_switch_case_key(value: &StageSwitchCase) -> &Bytes {
    &value.key
}

pub stage_switch_case_target(value: &StageSwitchCase) -> StageBlockId {
    value.target
}

pub register_raw(value: RegisterId) -> u32 { Id::to_u32(value) }

checked_u32(value: usize) -> u32 {
    handle checked_usize_to_u32(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

usize_from_u32(value: u32) -> usize {
    wrapping_convert_to_usize(value)
}

pub stage_function_id_from_usize(value: usize) -> StageFunctionId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub stage_type_id_from_usize(value: usize) -> StageTypeId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub stage_constant_id_from_usize(value: usize) -> StageConstantId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub stage_function_raw(value: StageFunctionId) -> u32 {
    Id::to_u32(value)
}

pub artifact_type_raw(value: ArtifactTypeId) -> u32 {
    Id::to_u32(value)
}

pub stage_constant_raw(value: StageConstantId) -> u32 {
    Id::to_u32(value)
}

pub artifact_type_id(value: u32) -> ArtifactTypeId {
    Id::from_u32(if(value < 14) {
        value
    } else {
        value + 5
    })
}

pub stage_type_artifact_id(value: StageTypeId) -> ArtifactTypeId {
    Id::from_u32(
        Id::to_u32(value) + wrapping_convert_to_u32(19)
    )
}

append_u32_bytes(output: &mut Vec<u8>, value: u32, count: usize) {
    if(count == 0) {
        ()
    } else {
        Vec::push(&mut *output, wrapping_convert_to_u8(value));
        append_u32_bytes(
            output,
            shift_right(value, 8),
            count - 1
        )
    }
}

append_constant_words(
    output: &mut Vec<u8>,
    value: &super::super::frontend::elaboration::IntegerConstantView,
    word: usize,
    bytes: usize
) {
    if(bytes == 0) {
        ()
    } else {
        let take = if(bytes < 4) { bytes } else { 4 };
        append_u32_bytes(
            output,
            super::super::frontend::elaboration::integer_constant_view_word(
                value,
                word
            ),
            take
        );
        append_constant_words(
            output,
            value,
            word + 1,
            bytes - take
        )
    }
}

scalar_width(type_id: u32) -> Option<usize> {
    handle type_id {
        0 => Option::Some(0),
        2 => Option::Some(1),
        3 => Option::Some(2),
        4 => Option::Some(4),
        5 => Option::Some(8),
        6 => Option::Some(16),
        7 => Option::Some(1),
        8 => Option::Some(2),
        9 => Option::Some(4),
        10 => Option::Some(8),
        11 => Option::Some(16),
        12 => Option::Some(8),
        13 => Option::Some(8),
        _ => None
    }
}

constant_key(
    body: &super::super::frontend::elaboration::TypedBody,
    type_id: TypeId,
    constant: IntegerConstantId
) -> Result<Bytes, LoweringError> {
    let type_raw = Id::to_u32(type_id);
    handle scalar_width(type_raw) {
        Result::Err(_) =>
            Result::Err(LoweringError::UnsupportedScalar(type_id)),
        Result::Ok(width) => {
            let output = Vec::new();
            Vec::push(&mut output, wrapping_convert_to_u8(
                artifact_type_raw(artifact_type_id(type_raw))
            ));
            let words =
                super::super::frontend::elaboration::
                    typed_body_integer_constant_at(
                        body,
                        constant
            );
            append_constant_words(&mut output, &words, 0, width);
            Result::Ok(Bytes::from_vec(output))
        }
    }
}

u32_constant_key(value: u32) -> Bytes {
    let output = Vec::new();
    Vec::push(&mut output, 4);
    Vec::push(&mut output, wrapping_convert_to_u8(value));
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 256)
    );
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 65536)
    );
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 16777216)
    );
    Bytes::from_vec(output)
}

push_missing_locals(
    output: &mut Vec<Option<RegisterId>>,
    remaining: usize
) {
    if(remaining == 0) {
        ()
    } else {
        Vec::push(&mut *output, None);
        push_missing_locals(output, remaining - 1)
    }
}

push_parameter_locals(
    output: &mut Vec<Option<RegisterId>>,
    live: &mut Vec<RegisterId>,
    index: u32,
    count: u32
) {
    if(index < count) {
        let register = Id::from_u32(index + 1);
        Vec::push(&mut *output, Option::Some(register));
        Vec::push(&mut *live, register);
        push_parameter_locals(
            output,
            live,
            index + 1,
            count
        )
    } else { () }
}

reverse_registers(
    source: &Vec<RegisterId>,
    output: &mut Vec<RegisterId>,
    remaining: usize
) {
    if(remaining == 0) {
        ()
    } else {
        Vec::push(
            &mut *output,
            *Vec::index(source, remaining - 1)
        );
        reverse_registers(
            source,
            output,
            remaining - 1
        )
    }
}

record_cleanup(value: &mut FunctionBuilder) {
    let instruction = checked_u32(Vec::len(&value.instructions));
    let registers = Vec::new();
    reverse_registers(
        &value.live_order,
        &mut registers,
        Vec::len(&value.live_order)
    );
    Vec::push(&mut value.cleanups, StageCleanup {
        first_instruction: instruction,
        end_instruction: instruction + 1,
        registers: registers
    })
}

alloc_register(value: &mut FunctionBuilder) -> RegisterId {
    let found = value.register_count;
    value.register_count = found + 1;
    Id::from_u32(found)
}

alloc_register_pack(
    value: &mut FunctionBuilder,
    registers: Vec<RegisterId>
) -> RegisterPackId {
    handle Arena::alloc(
        &mut value.register_packs,
        RegisterPack { registers: registers }
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

alloc_block(value: &mut FunctionBuilder) -> StageBlockId {
    handle Arena::alloc(&mut value.blocks, None) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

bind_block(value: &mut FunctionBuilder, id: StageBlockId) {
    *Arena::index_mut(&mut value.blocks, id) =
        Option::Some(checked_u32(Vec::len(&value.instructions)));
    ()
}

alloc_switch_pack(
    value: &mut FunctionBuilder,
    cases: Vec<StageSwitchCase>
) -> StageSwitchPackId {
    handle Arena::alloc(
        &mut value.switch_packs,
        StageSwitchPack { cases: cases }
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

find_live(
    value: &Vec<RegisterId>,
    register: RegisterId,
    index: usize
) -> Option<usize> {
    if(index < Vec::len(value)) {
        if(*Vec::index(value, index) == register) {
            Option::Some(index)
        } else {
            find_live(value, register, index + 1)
        }
    } else { None }
}

move_live(
    value: &mut FunctionBuilder,
    source: RegisterId,
    target: RegisterId
) {
    handle find_live(&value.live_order, source, 0) {
        Result::Err(_) => unreachable(),
        Result::Ok(index) => {
            *Vec::index_mut(&mut value.live_order, index) = target;
            ()
        }
    }
}

consume_live(value: &mut FunctionBuilder, register: RegisterId) {
    handle find_live(&value.live_order, register, 0) {
        Result::Err(_) => unreachable(),
        Result::Ok(index) => {
            Vec::remove(&mut value.live_order, index);
            ()
        }
    }
}

emit_const(value: &mut FunctionBuilder, target: RegisterId, key: Bytes) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::Const(
        target,
        key
    ));
    Vec::push(&mut value.live_order, target)
}

emit_move(
    value: &mut FunctionBuilder,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::Move(
        target,
        source
    ));
    move_live(value, source, target)
}

emit_copy(
    value: &mut FunctionBuilder,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::Copy(
        target,
        source
    ));
    Vec::push(&mut value.live_order, target)
}

emit_construct(
    value: &mut FunctionBuilder,
    target: RegisterId,
    ty: ArtifactTypeId,
    variant: Option<u32>,
    fields: Vec<RegisterId>
) {
    record_cleanup(value);
    consume_arguments(value, &fields, 0);
    let pack = alloc_register_pack(value, fields);
    Vec::push(&mut value.instructions, StageInstruction::Construct(
        target,
        ty,
        variant,
        pack
    ));
    Vec::push(&mut value.live_order, target)
}

emit_project_move(
    value: &mut FunctionBuilder,
    target: RegisterId,
    source: RegisterId,
    field: u32
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::ProjectMove(
        target,
        source,
        field
    ));
    Vec::push(&mut value.live_order, target)
}

emit_project_copy(
    value: &mut FunctionBuilder,
    target: RegisterId,
    source: RegisterId,
    field: u32
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::ProjectCopy(
        target,
        source,
        field
    ));
    Vec::push(&mut value.live_order, target)
}

emit_enum_tag(
    value: &mut FunctionBuilder,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::EnumTag(
        target,
        source
    ));
    Vec::push(&mut value.live_order, target)
}

emit_drop(value: &mut FunctionBuilder, register: RegisterId) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::Drop(register));
    consume_live(value, register)
}

emit_deconstruct(value: &mut FunctionBuilder, register: RegisterId) {
    record_cleanup(value);
    Vec::push(
        &mut value.instructions,
        StageInstruction::Deconstruct(register)
    );
    consume_live(value, register)
}

emit_jump(value: &mut FunctionBuilder, target: StageBlockId) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::Jump(target))
}

emit_switch(
    value: &mut FunctionBuilder,
    discriminant: RegisterId,
    cases: Vec<StageSwitchCase>,
    otherwise: StageBlockId
) {
    record_cleanup(value);
    let pack = alloc_switch_pack(value, cases);
    Vec::push(&mut value.instructions, StageInstruction::Switch(
        discriminant,
        pack,
        otherwise
    ))
}

consume_arguments(
    value: &mut FunctionBuilder,
    arguments: &Vec<RegisterId>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(arguments)), { current =>
        consume_live(value, *Vec::index(arguments, current))
    })
}

emit_call(
    value: &mut FunctionBuilder,
    target: Option<RegisterId>,
    function: StageFunctionId,
    arguments: Vec<RegisterId>
) {
    record_cleanup(value);
    consume_arguments(value, &arguments, 0);
    let pack = alloc_register_pack(value, arguments);
    Vec::push(&mut value.instructions, StageInstruction::Call(
        target,
        function,
        pack
    ));
    let inserted = target;
    if(inserted is Result::Ok(register)) {
        Vec::push(&mut value.live_order, register)
    } else { () }
}

emit_return(value: &mut FunctionBuilder, source: Option<RegisterId>) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, StageInstruction::Return(source))
}

local_register(
    value: &FunctionBuilder,
    local: CoreLocalId
) -> Option<RegisterId> {
    *Vec::index(&value.locals, Id::to_usize(local))
}

set_local(
    value: &mut FunctionBuilder,
    local: CoreLocalId,
    register: Option<RegisterId>
) {
    *Vec::index_mut(&mut value.locals, Id::to_usize(local)) = register;
    ()
}

lower_value(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut FunctionBuilder,
    id: CoreValueId
) -> Result<Option<RegisterId>, LoweringError> {
    handle super::super::frontend::elaboration::typed_body_value_at(
        body,
        id
    ) {
        CoreValueView::Unit(_) => {
            let target = alloc_register(value);
            let key = Vec::new();
            Vec::push(&mut key, 0);
            emit_const(value, target, Bytes::from_vec(key));
            Result::Ok(Option::Some(target))
        },
        CoreValueView::Integer(type_id, constant) => {
            let target = alloc_register(value);
            let key = try(
                constant_key(body, type_id, constant),
                @lower_value
            );
            emit_const(value, target, key);
            Result::Ok(Option::Some(target))
        },
        CoreValueView::Local(type_id, local, copy) => {
            handle local_register(value, local) {
                Result::Err(_) =>
                    Result::Err(LoweringError::MissingLocal(local)),
                Result::Ok(source) => {
                    let target = alloc_register(value);
                    if(copy) {
                        emit_copy(value, target, source)
                    } else {
                        emit_move(value, target, source);
                        set_local(value, local, None)
                    };
                    Result::Ok(Option::Some(target))
                }
            }
        },
        CoreValueView::Projection(_, source, field) => {
            let lowered = try(
                lower_value(interfaces, body, value, source),
                @lower_value
            );
            handle lowered {
                Result::Err(_) =>
                    Result::Err(
                        LoweringError::MissingProjectionSource(id)
                    ),
                Result::Ok(source_register) => {
                    let target = alloc_register(value);
                    emit_project_copy(
                        value,
                        target,
                        source_register,
                        field
                    );
                    emit_drop(value, source_register);
                    Result::Ok(Option::Some(target))
                }
            }
        },
        CoreValueView::Embedded(_, computation) =>
            lower_computation(interfaces, body, value, computation)
    }
}

lower_arguments<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut FunctionBuilder,
    operands: Slice<'a, CoreValueId>,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    Slice::try_for_each(operands, { operand => {
        let id = *operand;
        let lowered = try(
            lower_value(interfaces, body, value, id),
            @lower_arguments
        );
        handle lowered {
            Result::Err(_) =>
                Result::Err(LoweringError::MissingValue(id)),
            Result::Ok(register) => {
                Vec::push(&mut *output, register);
                Result::Ok(())
            }
        }
    } })
}

append_optional_registers(
    source: &Vec<Option<RegisterId>>,
    output: &mut Vec<Option<RegisterId>>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(source)), { current =>
        Vec::push(&mut *output, *Vec::index(source, current))
    })
}

append_registers(
    source: &Vec<RegisterId>,
    output: &mut Vec<RegisterId>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(source)), { current =>
        Vec::push(&mut *output, *Vec::index(source, current))
    })
}

snapshot_locals(value: &FunctionBuilder) -> Vec<Option<RegisterId>> {
    let output = Vec::new();
    append_optional_registers(&value.locals, &mut output, 0);
    output
}

snapshot_live(value: &FunctionBuilder) -> Vec<RegisterId> {
    let output = Vec::new();
    append_registers(&value.live_order, &mut output, 0);
    output
}

restore_match_state(
    value: &mut FunctionBuilder,
    locals: &Vec<Option<RegisterId>>,
    live: &Vec<RegisterId>
) {
    Vec::clear(&mut value.locals);
    append_optional_registers(locals, &mut value.locals, 0);
    Vec::clear(&mut value.live_order);
    append_registers(live, &mut value.live_order, 0)
}

optional_registers_equal(
    left: &Vec<Option<RegisterId>>,
    right: &Vec<Option<RegisterId>>,
    index: usize
) -> Bool {
    if(Vec::len(left) == Vec::len(right)) {
        if(index < Vec::len(left)) {
            if(Eq::eq(
                Vec::index(left, index),
                Vec::index(right, index)
            )) {
                optional_registers_equal(left, right, index + 1)
            } else { false }
        } else { true }
    } else { false }
}

registers_equal(
    left: &Vec<RegisterId>,
    right: &Vec<RegisterId>,
    index: usize
) -> Bool {
    if(Vec::len(left) == Vec::len(right)) {
        if(index < Vec::len(left)) {
            if(*Vec::index(left, index) == *Vec::index(right, index)) {
                registers_equal(left, right, index + 1)
            } else { false }
        } else { true }
    } else { false }
}

alloc_match_blocks(
    value: &mut FunctionBuilder,
    count: usize,
    index: usize,
    output: &mut Vec<StageBlockId>
) {
    for_range(Range::new(index, count), { _ =>
        Vec::push(&mut *output, alloc_block(value))
    })
}

build_match_switch_cases<'a>(
    arms: Slice<'a, CoreMatchArm>,
    blocks: &Vec<StageBlockId>,
    count: usize,
    index: usize,
    output: &mut Vec<StageSwitchCase>
) {
    if(index < count) {
        let arm = handle Slice::get(arms, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        Vec::push(&mut *output, StageSwitchCase {
            key: u32_constant_key(
                super::super::frontend::elaboration::
                    core_match_arm_variant(arm)
            ),
            target: *Vec::index(blocks, index)
        });
        build_match_switch_cases(
            arms,
            blocks,
            count,
            index + 1,
            output
        )
    } else { () }
}

project_match_fields<'a>(
    value: &mut FunctionBuilder,
    subject: RegisterId,
    bindings: Slice<'a, CoreMatchBinding>,
    index: usize,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    try_for_range(Range::new(index, Slice::len(bindings)), { current => {
        let binding = handle Slice::get(bindings, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let field =
            super::super::frontend::elaboration::
                core_match_binding_field(binding);
        if(field == checked_u32(current)) {
            let target = alloc_register(value);
            emit_project_move(value, target, subject, field);
            Vec::push(&mut *output, target);
            Result::Ok(())
        } else {
            Result::Err(LoweringError::ConstructionFieldOrder(
                checked_u32(current),
                field
            ))
        }
    } })
}

install_match_bindings_reverse<'a>(
    value: &mut FunctionBuilder,
    bindings: Slice<'a, CoreMatchBinding>,
    registers: &Vec<RegisterId>,
    remaining: usize
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let binding = handle Slice::get(bindings, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let register = *Vec::index(registers, index);
        handle
            super::super::frontend::elaboration::
                core_match_binding_local(binding) {
            Result::Err(_) => emit_drop(value, register),
            Result::Ok(local) =>
                set_local(value, local, Option::Some(register))
        };
        install_match_bindings_reverse(
            value,
            bindings,
            registers,
            index
        )
    }
}

drop_match_locals_reverse<'a>(
    value: &mut FunctionBuilder,
    bindings: Slice<'a, CoreMatchBinding>,
    remaining: usize
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let binding = handle Slice::get(bindings, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        handle
            super::super::frontend::elaboration::
                core_match_binding_local(binding) {
            Result::Err(_) => (),
            Result::Ok(local) => handle local_register(value, local) {
                Result::Err(_) => (),
                Result::Ok(register) => {
                    emit_drop(value, register);
                    set_local(value, local, None)
                }
            }
        };
        drop_match_locals_reverse(value, bindings, index)
    }
}

lower_match_arms<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut FunctionBuilder,
    arms: Slice<'a, CoreMatchArm>,
    blocks: &Vec<StageBlockId>,
    subject: RegisterId,
    tag: RegisterId,
    result: RegisterId,
    join: StageBlockId,
    baseline_locals: &Vec<Option<RegisterId>>,
    baseline_live: &Vec<RegisterId>,
    canonical_locals: &mut Vec<Option<RegisterId>>,
    canonical_live: &mut Vec<RegisterId>,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Slice::len(arms)) {
        restore_match_state(value, baseline_locals, baseline_live);
        bind_block(value, *Vec::index(blocks, index));
        emit_drop(value, tag);
        let arm = handle Slice::get(arms, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let bindings =
            super::super::frontend::elaboration::
                core_match_arm_bindings(body, arm);
        let registers = Vec::new();
        try(project_match_fields(
            value,
            subject,
            bindings,
            0,
            &mut registers
        ), @lower_match_arms);
        emit_deconstruct(value, subject);
        install_match_bindings_reverse(
            value,
            bindings,
            &registers,
            Vec::len(&registers)
        );
        let arm_computation =
            super::super::frontend::elaboration::
                core_match_arm_body(arm);
        let lowered = try(lower_computation(
            interfaces,
            body,
            value,
            arm_computation
        ), @lower_match_arms);
        drop_match_locals_reverse(
            value,
            bindings,
            Slice::len(bindings)
        );
        handle lowered {
            Result::Err(_) => Result::Err(
                LoweringError::MissingMatchResult(arm_computation)
            ),
            Result::Ok(branch_result) => {
                emit_move(value, result, branch_result);
                emit_jump(value, join);
                if(index == 0) {
                    Vec::clear(canonical_locals);
                    append_optional_registers(
                        &value.locals,
                        canonical_locals,
                        0
                    );
                    Vec::clear(canonical_live);
                    append_registers(
                        &value.live_order,
                        canonical_live,
                        0
                    );
                    lower_match_arms(
                        interfaces,
                        body,
                        value,
                        arms,
                        blocks,
                        subject,
                        tag,
                        result,
                        join,
                        baseline_locals,
                        baseline_live,
                        canonical_locals,
                        canonical_live,
                        index + 1
                    )
                } else {
                    if(optional_registers_equal(
                        &value.locals,
                        canonical_locals,
                        0
                    ) and {
                        registers_equal(
                            &value.live_order,
                            canonical_live,
                            0
                        )
                    }) {
                        lower_match_arms(
                            interfaces,
                            body,
                            value,
                            arms,
                            blocks,
                            subject,
                            tag,
                            result,
                            join,
                            baseline_locals,
                            baseline_live,
                            canonical_locals,
                            canonical_live,
                            index + 1
                        )
                    } else {
                        Result::Err(LoweringError::MatchStateMismatch)
                    }
                }
            }
        }
    } else { Result::Ok(()) }
}

lower_match<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut FunctionBuilder,
    subject: CoreValueId,
    arms: Slice<'a, CoreMatchArm>
) -> Result<Option<RegisterId>, LoweringError> {
    let lowered_subject = try(lower_value(
        interfaces,
        body,
        value,
        subject
    ), @lower_match);
    handle lowered_subject {
        Result::Err(_) =>
            Result::Err(LoweringError::MissingMatchSubject(subject)),
        Result::Ok(subject_register) => {
            if(Slice::len(arms) == 0) {
                Result::Err(LoweringError::MatchStateMismatch)
            } else {
                let tag = alloc_register(value);
                emit_enum_tag(value, tag, subject_register);
                let result = alloc_register(value);
                let blocks = Vec::new();
                alloc_match_blocks(
                    value,
                    Slice::len(arms),
                    0,
                    &mut blocks
                );
                let join = alloc_block(value);
                let explicit_count = Slice::len(arms) - 1;
                let cases = Vec::new();
                build_match_switch_cases(
                    arms,
                    &blocks,
                    explicit_count,
                    0,
                    &mut cases
                );
                emit_switch(
                    value,
                    tag,
                    cases,
                    *Vec::index(&blocks, explicit_count)
                );
                let baseline_locals = snapshot_locals(&*value);
                let baseline_live = snapshot_live(&*value);
                let canonical_locals = Vec::new();
                let canonical_live = Vec::new();
                try(lower_match_arms(
                    interfaces,
                    body,
                    value,
                    arms,
                    &blocks,
                    subject_register,
                    tag,
                    result,
                    join,
                    &baseline_locals,
                    &baseline_live,
                    &mut canonical_locals,
                    &mut canonical_live,
                    0
                ), @lower_match);
                restore_match_state(
                    value,
                    &canonical_locals,
                    &canonical_live
                );
                bind_block(value, join);
                Result::Ok(Option::Some(result))
            }
        }
    }
}

lower_computation(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut FunctionBuilder,
    id: CoreComputationId
) -> Result<Option<RegisterId>, LoweringError> {
    handle
        super::super::frontend::elaboration::typed_body_computation_at(
            body,
            id
        ) {
        CoreComputationView::Pure(_, found) =>
            lower_value(interfaces, body, value, found),
        CoreComputationView::Let(_, local, initializer, remainder) => {
            let initialized = try(
                lower_computation(
                    interfaces,
                    body,
                    value,
                    initializer
                ),
                @lower_computation
            );
            set_local(value, local, initialized);
            lower_computation(interfaces, body, value, remainder)
        },
        CoreComputationView::Call(type_id, shell, operands) => {
            let arguments = Vec::new();
            try(lower_arguments(
                interfaces,
                body,
                value,
                operands,
                &mut arguments
            ), @lower_computation);
            handle
                super::super::frontend::elaboration::
                    interface_callable_for_shell(interfaces, shell) {
                Result::Err(_) =>
                    Result::Err(LoweringError::UnknownCallable(shell)),
                Result::Ok(function) => {
                    let target = Option::Some(alloc_register(value));
                    emit_call(
                        value,
                        target,
                        Id::from_u32(function),
                        arguments
                    );
                    Result::Ok(target)
                }
            }
        },
        CoreComputationView::Construct(type_id, flavor, fields) => {
            handle super::super::frontend::elaboration::interface_type_at(
                interfaces,
                Id::to_usize(type_id)
            ) {
                InterfaceTypeView::Tuple(elements) => handle flavor {
                    ConstructionFlavor::Product => lower_aggregate(
                        interfaces,
                        body,
                        value,
                        type_id,
                        None,
                        fields,
                        checked_u32(Slice::len(elements))
                    ),
                    ConstructionFlavor::Variant(ordinal) =>
                        Result::Err(
                            LoweringError::UnexpectedVariant(
                                type_id,
                                ordinal
                            )
                        )
                },
                InterfaceTypeView::Nominal(nominal) => handle
                    super::super::frontend::elaboration::
                        interface_nominal_at_view(
                            interfaces,
                            usize_from_u32(nominal)
                        ) {
                    InterfaceNominalView::Struct(_, _, expected) =>
                        handle flavor {
                            ConstructionFlavor::Product =>
                                lower_aggregate(
                                    interfaces,
                                    body,
                                    value,
                                    type_id,
                                    None,
                                    fields,
                                    expected
                                ),
                            ConstructionFlavor::Variant(ordinal) =>
                                Result::Err(
                                    LoweringError::UnexpectedVariant(
                                        type_id,
                                        ordinal
                                    )
                                )
                        },
                    InterfaceNominalView::Enum(_, start, count) =>
                        handle flavor {
                            ConstructionFlavor::Product =>
                                Result::Err(
                                    LoweringError::MissingVariant(type_id)
                                ),
                            ConstructionFlavor::Variant(ordinal) =>
                                if(ordinal < count) {
                                    let payloads =
                                        super::super::frontend::elaboration::
                                            interface_variant_payloads_at(
                                                interfaces,
                                                usize_from_u32(
                                                    start + ordinal
                                                )
                                            );
                                    lower_aggregate(
                                        interfaces,
                                        body,
                                        value,
                                        type_id,
                                        Option::Some(ordinal),
                                        fields,
                                        checked_u32(Slice::len(payloads))
                                    )
                                } else {
                                    Result::Err(
                                        LoweringError::VariantOutOfRange(
                                            type_id,
                                            ordinal
                                        )
                                    )
                                }
                },
                },
                _ => Result::Err(
                    LoweringError::InvalidConstructionType(type_id)
                )
            }
        },
        CoreComputationView::Match(_, subject, arms) =>
            lower_match(interfaces, body, value, subject, arms)
    }
}

lower_aggregate<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut FunctionBuilder,
    type_id: TypeId,
    variant: Option<u32>,
    fields: Slice<'a, ConstructionField>,
    expected: u32
) -> Result<Option<RegisterId>, LoweringError> {
    if(checked_u32(Slice::len(fields)) == expected) {
            let registers = Vec::new();
            try(lower_product_fields(
                interfaces,
                body,
                value,
                fields,
                &mut registers
            ), @lower_aggregate);
            let target = alloc_register(value);
            emit_construct(
                value,
                target,
                artifact_type_id(Id::to_u32(type_id)),
                variant,
                registers
            );
            Result::Ok(Option::Some(target))
        } else {
            Result::Err(LoweringError::ConstructionFieldCount(
                type_id,
                expected,
                checked_u32(Slice::len(fields))
            ))
        }
}

lower_product_fields<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    value: &mut FunctionBuilder,
    fields: Slice<'a, ConstructionField>,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    Slice::try_for_each(fields, { entry => {
        let field =
            super::super::frontend::elaboration::
                construction_field_ordinal(entry);
        let operand =
            super::super::frontend::elaboration::
                construction_field_value(entry);
        if(field == checked_u32(Vec::len(output))) {
            handle lower_value(interfaces, body, value, operand) {
                Result::Err(found) => Result::Err(found),
                Result::Ok(lowered) => handle lowered {
                    Result::Err(_) =>
                        Result::Err(LoweringError::MissingValue(operand)),
                    Result::Ok(register) => {
                        Vec::push(&mut *output, register);
                        Result::Ok(())
                    }
                }
            }
        } else {
            Result::Err(LoweringError::ConstructionFieldOrder(
                checked_u32(Vec::len(output)),
                field
            ))
        }
    } })
}

parameter_types(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    function: usize,
    index: u32,
    count: u32,
    output: &mut Vec<ArtifactTypeId>
) {
    if(index < count) {
        let start =
            super::super::frontend::elaboration::
                interface_callable_parameter_start_at(
                    interfaces,
                    function
                );
        Vec::push(
            &mut *output,
            artifact_type_id(
                super::super::frontend::elaboration::
                    interface_callable_parameter_at(
                        interfaces,
                        usize_from_u32(start + index)
                    )
            )
        );
        parameter_types(
            interfaces,
            function,
            index + 1,
            count,
            output
        )
    } else { () }
}

pub lower_function(
    name: String,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &super::super::frontend::elaboration::TypedBody,
    function: usize
) -> Result<StageFunction, LoweringError> {
    let parameter_count =
        super::super::frontend::elaboration::
            interface_callable_parameter_count_at(interfaces, function);
    let parameters = Vec::new();
    parameter_types(
        interfaces,
        function,
        0,
        parameter_count,
        &mut parameters
    );
    let builder = FunctionBuilder {
        locals: Vec::new(),
        live_order: Vec::new(),
        instructions: Vec::new(),
        cleanups: Vec::new(),
        register_packs: Arena::new(),
        blocks: Arena::new(),
        switch_packs: Arena::new(),
        register_count: parameter_count + 1
    };
    push_parameter_locals(
        &mut builder.locals,
        &mut builder.live_order,
        0,
        parameter_count
    );
    let local_count =
        super::super::frontend::elaboration::typed_body_local_count(body);
    push_missing_locals(
        &mut builder.locals,
        local_count - usize_from_u32(parameter_count)
    );
    let result = try(lower_computation(
        interfaces,
        body,
        &mut builder,
        super::super::frontend::elaboration::typed_body_root(body)
    ), @lower_function);
    let core_result_type =
        super::super::frontend::elaboration::typed_body_result_type(body);
    let result_type = artifact_type_id(Id::to_u32(core_result_type));
    handle result {
        Result::Err(_) =>
            Result::Err(LoweringError::MissingResult(core_result_type)),
        Result::Ok(register) => {
            emit_return(&mut builder, Option::Some(register));
            Result::Ok(StageFunction {
                name: name,
                parameters: parameters,
                result: result_type,
                register_count: builder.register_count,
                instructions: builder.instructions,
                cleanups: builder.cleanups,
                register_packs: builder.register_packs,
                blocks: builder.blocks,
                switch_packs: builder.switch_packs
            })
        }
    }
}

collect_instruction_constants(
    function: &StageFunction,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    if(index < Vec::len(&function.instructions)) {
        handle Vec::index(&function.instructions, index) {
            StageInstruction::Const(_, key) =>
                Vec::push(&mut *output, Bytes::to_vec(key)),
            StageInstruction::Switch(_, pack, _) =>
                collect_switch_case_constants(
                    function,
                    pack,
                    0,
                    output
                ),
            _ => ()
        };
        collect_instruction_constants(
            function,
            index + 1,
            output
        )
    } else { () }
}

collect_switch_case_constants(
    value: &StageFunction,
    pack: StageSwitchPackId,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    let cases = Arena::index(&value.switch_packs, pack);
    if(index < Vec::len(&cases.cases)) {
        let case = Vec::index(&cases.cases, index);
        let key = stage_switch_case_key(case);
        Vec::push(
            &mut *output,
            Bytes::to_vec(*key)
        );
        collect_switch_case_constants(
            value,
            pack,
            index + 1,
            output
        )
    } else { () }
}

collect_function_constants(
    functions: &Arena<StageFunctionTag, StageFunction>,
    index: usize,
    output: &mut Vec<Vec<u8>>
) {
    if(index < Arena::len(functions)) {
        let function = Arena::index(
            functions,
            stage_function_id_from_usize(index)
        );
        collect_instruction_constants(
            function,
            0,
            output
        );
        collect_function_constants(
            functions,
            index + 1,
            output
        )
    } else { () }
}

store_constants(
    values: VecIntoIter<Vec<u8>>,
    output: &mut Arena<StageConstantTag, Vec<u8>>
) {
    handle VecIntoIter::next(values) {
        None => (),
        Option::Some((value, remaining)) => {
            handle Arena::alloc(&mut *output, value) {
                Result::Err(_) => unreachable(),
                Result::Ok(_) => ()
            };
            store_constants(remaining, output)
        }
    }
}

pub finish_program(
    functions: Arena<StageFunctionTag, StageFunction>,
    types: Arena<StageTypeTag, StageType>,
    type_names: Vec<String>
) -> StageProgram {
    let canonical_constants = Vec::new();
    collect_function_constants(&functions, 0, &mut canonical_constants);
    Vec::sort(&mut canonical_constants);
    Vec::dedup(&mut canonical_constants);
    let constants = Arena::new();
    store_constants(
        Vec::into_iter(canonical_constants),
        &mut constants
    );
    StageProgram {
        functions: functions,
        constants: constants,
        types: types,
        type_names: type_names
    }
}
