}

pub mir_constant_raw(value: MirConstantId) -> u32 {
    Id::to_u32(value)
}

pub artifact_type_id(value: u32) -> ArtifactTypeId {
    // Typed interfaces and the VM artifact share the complete predefined
    // scalar ordering (Unit through Bytes at IDs 0 through 18). Custom types
    // therefore retain their semantic IDs as well.
    Id::from_u32(value)
}

pub mir_type_artifact_id(value: MirTypeId) -> ArtifactTypeId {
    Id::from_u32(
        Id::to_u32(value) + wrapping_convert_to_u32(19)
    )
}

append_u32_bytes(output: &mut Vec<u8>, value: u32, count: usize) {
    if(count == 0) {
        ()
    } else {
        Vec::push(&mut *output, wrapping_convert_to_u8(value));
        append_u32_bytes(
            output,
            shift_right(value, 8),
            count - 1
        )
    }
}

append_constant_words(
    output: &mut Vec<u8>,
    value: &super::super::frontend::elaboration::IntegerConstantView,
    word: usize,
    bytes: usize
) {
    if(bytes == 0) {
        ()
    } else {
        let take = if(bytes < 4) { bytes } else { 4 };
        append_u32_bytes(
            output,
            super::super::frontend::elaboration::integer_constant_view_word(
                value,
                word
            ),
            take
        );
        append_constant_words(
            output,
            value,
            word + 1,
            bytes - take
        )
    }
}

scalar_width(type_id: u32) -> Option<usize> {
    handle type_id {
        0 => Option::Some(0),
        2 => Option::Some(1),
        3 => Option::Some(2),
        4 => Option::Some(4),
        5 => Option::Some(8),
        6 => Option::Some(16),
        7 => Option::Some(1),
        8 => Option::Some(2),
        9 => Option::Some(4),
        10 => Option::Some(8),
        11 => Option::Some(16),
        12 => Option::Some(8),
        13 => Option::Some(8),
        // `char` is encoded as its Unicode scalar value, matching the
        // four-byte representation used by the VM artifact's predefined
        // character type.
        16 => Option::Some(4),
        _ => None
    }
}

constant_key(
    body: &super::super::frontend::elaboration::TypedBody,
    type_id: TypeId,
    constant: IntegerConstantId
) -> Result<Bytes, LoweringError> {
    let type_raw = Id::to_u32(type_id);
    handle scalar_width(type_raw) {
        Result::Err(_) =>
            Result::Err(LoweringError::UnsupportedScalar(type_id)),
        Result::Ok(width) => {
            let output = Vec::new();
            Vec::push(&mut output, wrapping_convert_to_u8(
                artifact_type_raw(artifact_type_id(type_raw))
            ));
            let words =
                super::super::frontend::elaboration::
                    typed_body_integer_constant_at(
                        body,
                        constant
            );
            append_constant_words(&mut output, &words, 0, width);
            Result::Ok(Bytes::from_vec(output))
        }
    }
}

u32_constant_key(value: u32) -> Bytes {
    let output = Vec::new();
    Vec::push(&mut output, 4);
    Vec::push(&mut output, wrapping_convert_to_u8(value));
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 256)
    );
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 65536)
    );
    Vec::push(
        &mut output,
        wrapping_convert_to_u8(value / 16777216)
    );
    Bytes::from_vec(output)
}

push_missing_locals(
    output: &mut Vec<Option<RegisterId>>,
    remaining: usize
) {
    for_range(Range::new(0, remaining), { _ => {
        Vec::push(&mut *output, None);
        ()
    } })
}

push_liveness_flags(output: &mut Vec<Bool>, remaining: usize) {
    for_range(Range::new(0, remaining), { _ =>
        Vec::push(&mut *output, false)
    })
}

push_transfer_flags(
    output: &mut IndexVec<CoreValueTag, Bool>,
    remaining: usize
) {
    for_range(Range::new(0, remaining), { _ => {
        handle IndexVec::push(&mut *output, false) {
            Result::Err(_) => unreachable(),
            Result::Ok(_) => ()
        }
    } })
}

struct PlaceFlowAnalysis {
    live: Vec<Bool>,
    facts: PlaceFlowFacts
}

copy_liveness(source: &Vec<Bool>) -> Vec<Bool> {
    let output = Vec::new();
    for_range(Range::new(0, Vec::len(source)), { index =>
        Vec::push(&mut output, *Vec::index(source, index))
    });
    output
}

union_liveness(output: &mut Vec<Bool>, source: &Vec<Bool>) {
    for_range(Range::new(0, Vec::len(source)), { index => {
        if(*Vec::index(source, index)) {
            *Vec::index_mut(&mut *output, index) = true;
            ()
        } else { () }
    } })
}

analyze_value(
    body: &super::super::frontend::elaboration::TypedBody,
    id: CoreValueId,
    output: &mut PlaceFlowAnalysis,
    allow_transfer: Bool
) {
    handle super::super::frontend::elaboration::typed_body_value_at(body, id) {
        CoreValueView::Local(_, local, _, forced_transfer) => {
            let live = Vec::index_mut(
                &mut output.live,
                Id::to_usize(local)
            );
            if(forced_transfer) {
                *IndexVec::index_mut(
                    &mut output.facts.final_transfers,
                    id
                ) = true;
                ()
            } else if(allow_transfer and {
                super::super::frontend::elaboration::
                    typed_body_transfer_candidate(body, id)
            }) {
                if(*live) { () } else {
                    *IndexVec::index_mut(
                        &mut output.facts.final_transfers,
                        id
                    ) = true;
                    ()
                }
            } else { () };
            *live = true;
            ()
        },
        CoreValueView::Projection(_, source, _) =>
            analyze_value(body, source, output, allow_transfer),
        CoreValueView::Embedded(_, computation) =>
            analyze_computation(
                body,
                computation,
                output,
                allow_transfer
            ),
        _ => ()
    }
}

analyze_values_reverse<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    values: Slice<'a, CoreValueId>,
    remaining: usize,
    output: &mut PlaceFlowAnalysis,
    allow_transfer: Bool
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let value = handle Slice::get(values, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => *found
        };
        analyze_value(body, value, output, allow_transfer);
        analyze_values_reverse(
            body,
            values,
            index,
            output,
            allow_transfer
        )
    }
}

analyze_fields_reverse<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    fields: Slice<'a, ConstructionField>,
    remaining: usize,
    output: &mut PlaceFlowAnalysis,
    allow_transfer: Bool
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let field = handle Slice::get(fields, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        analyze_value(
            body,
            super::super::frontend::elaboration::
                construction_field_value(field),
            output,
            allow_transfer
        );
        analyze_fields_reverse(
            body,
            fields,
            index,
            output,
            allow_transfer
        )
    }
}

remove_match_bindings<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    arm: &CoreMatchArm,
    output: &mut PlaceFlowAnalysis
) {
    let bindings = super::super::frontend::elaboration::
        core_match_arm_bindings(body, arm);
    Slice::for_each(bindings, { binding =>
        handle super::super::frontend::elaboration::
            core_match_binding_local(binding) {
            None => (),
            Option::Some(local) => {
                *Vec::index_mut(
                    &mut output.live,
                    Id::to_usize(local)
                ) = false;
                ()
            }
        }
    })
}

analyze_match_arms<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    arms: Slice<'a, CoreMatchArm>,
    live_out: &Vec<Bool>,
    joined: &mut Vec<Bool>,
    ordinal: usize,
    output: &mut PlaceFlowAnalysis
) {
    if(ordinal < Slice::len(arms)) {
        let arm = handle Slice::get(arms, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        output.live = copy_liveness(live_out);
        analyze_computation(
            body,
            super::super::frontend::elaboration::core_match_arm_body(arm),
            output,
            true
        );
        remove_match_bindings(body, arm, output);
        union_liveness(joined, &output.live);
        analyze_match_arms(
            body,
            arms,
            live_out,
            joined,
            ordinal + 1,
            output
        )
    } else { () }
}

analyze_computation(
    body: &super::super::frontend::elaboration::TypedBody,
    id: CoreComputationId,
    output: &mut PlaceFlowAnalysis,
    allow_transfer: Bool
) {
    handle super::super::frontend::elaboration::
        typed_body_computation_at(body, id) {
        CoreComputationView::Pure(_, value) =>
            analyze_value(body, value, output, allow_transfer),
        CoreComputationView::Let(_, local, initializer, remainder) => {
            analyze_computation(body, remainder, output, allow_transfer);
            *Vec::index_mut(&mut output.live, Id::to_usize(local)) = false;
            analyze_computation(body, initializer, output, allow_transfer)
        },
        CoreComputationView::Call(_, _, _, operands) =>
            analyze_values_reverse(
                body,
                operands,
                Slice::len(operands),
                output,
                allow_transfer
            ),
        CoreComputationView::Primitive(_, _, operands) =>
            analyze_values_reverse(
                body,
                operands,
                Slice::len(operands),
                output,
                allow_transfer
            ),
        CoreComputationView::Construct(_, _, fields) =>
            analyze_fields_reverse(
                body,
                fields,
                Slice::len(fields),
                output,
                allow_transfer
            ),
        CoreComputationView::VariantDispatch(_, subject, arms) => {
            let live_out = copy_liveness(&output.live);
            Vec::push(&mut output.facts.matches, MatchFlow {
                computation: id,
                live_out: copy_liveness(&live_out)
            });
            let joined = copy_liveness(&live_out);
            analyze_match_arms(
                body,
                arms,
                &live_out,
                &mut joined,
                0,
                output
            );
            output.live = joined;
            analyze_value(body, subject, output, allow_transfer)
        },
        // No source elaboration produces these yet. Keeping this explicit
        // makes place-flow non-authoritative until effect MIR lowering exists.
        CoreComputationView::Perform(_, _, _) => unreachable(),
        CoreComputationView::Resume(_, _, _) => unreachable(),
        CoreComputationView::Handle(_, _, _) => unreachable()
    }
}

analyze_place_flow(
    body: &super::super::frontend::elaboration::TypedBody
) -> PlaceFlowFacts {
    let live = Vec::new();
    push_liveness_flags(
        &mut live,
        super::super::frontend::elaboration::typed_body_local_count(body)
    );
    let final_transfers = IndexVec::new();
    push_transfer_flags(
        &mut final_transfers,
        super::super::frontend::elaboration::typed_body_value_count(body)
    );
    let output = PlaceFlowAnalysis {
        live: live,
        facts: PlaceFlowFacts {
            final_transfers: final_transfers,
            matches: Vec::new()
        }
    };
    analyze_computation(
        body,
        super::super::frontend::elaboration::typed_body_root(body),
        &mut output,
        true
    );
    output.facts
}

push_parameter_locals(
    output: &mut Vec<Option<RegisterId>>,
    live: &mut Vec<RegisterId>,
    index: u32,
    count: u32
) {
    for_range(Range::new(
        usize_from_u32(index),
        usize_from_u32(count)
    ), { current => {
        let register = Id::from_u32(checked_u32(current) + 1);
        Vec::push(&mut *output, Option::Some(register));
        Vec::push(&mut *live, register)
    } })
}

reverse_registers(
    source: &Vec<RegisterId>,
    output: &mut Vec<RegisterId>,
    remaining: usize
) {
    for_range(Range::new(0, remaining), { current =>
        Vec::push(
            &mut *output,
            *Vec::index(source, remaining - current - 1)
        )
    })
}

record_cleanup<'a>(value: &mut MirBuilder<'a>) {
    let instruction = checked_u32(Vec::len(&value.instructions));
    let registers = Vec::new();
    reverse_registers(
        &value.live_order,
        &mut registers,
        Vec::len(&value.live_order)
    );
    Vec::push(&mut value.cleanups, MirCleanup {
        first_instruction: instruction,
        end_instruction: instruction + 1,
        registers: registers
    })
}

alloc_register<'a>(value: &mut MirBuilder<'a>) -> RegisterId {
    let found = value.register_count;
    value.register_count = found + 1;
    Id::from_u32(found)
}

alloc_register_pack<'a>(
    value: &mut MirBuilder<'a>,
    registers: Vec<RegisterId>
) -> RegisterPackId {
    handle Arena::alloc(
        &mut value.register_packs,
        RegisterPack { registers: registers }
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

alloc_block<'a>(value: &mut MirBuilder<'a>) -> MirBlockId {
    handle Arena::alloc(&mut value.blocks, None) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

bind_block<'a>(value: &mut MirBuilder<'a>, id: MirBlockId) {
    *Arena::index_mut(&mut value.blocks, id) =
        Option::Some(checked_u32(Vec::len(&value.instructions)));
    ()
}

alloc_switch_pack<'a>(
    value: &mut MirBuilder<'a>,
    cases: Vec<MirSwitchCase>
) -> MirSwitchPackId {
    handle Arena::alloc(
        &mut value.switch_packs,
        MirSwitchPack { cases: cases }
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

find_live(
    value: &Vec<RegisterId>,
    register: RegisterId,
    index: usize
) -> Option<usize> {
    if(index < Vec::len(value)) {
        if(*Vec::index(value, index) == register) {
            Option::Some(index)
        } else {
            find_live(value, register, index + 1)
        }
    } else { None }
}

move_live<'a>(
    value: &mut MirBuilder<'a>,
    source: RegisterId,
    target: RegisterId
) {
    handle find_live(&value.live_order, source, 0) {
        Result::Err(_) => unreachable(),
        Result::Ok(index) => {
            *Vec::index_mut(&mut value.live_order, index) = target;
            ()
        }
    }
}

consume_live<'a>(value: &mut MirBuilder<'a>, register: RegisterId) {
    handle find_live(&value.live_order, register, 0) {
        Result::Err(_) => unreachable(),
        Result::Ok(index) => {
            Vec::remove(&mut value.live_order, index);
            ()
        }
    }
}

emit_const<'a>(value: &mut MirBuilder<'a>, target: RegisterId, key: Bytes) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Const(
        target,
        key
    ));
    Vec::push(&mut value.live_order, target)
}

emit_move<'a>(
    value: &mut MirBuilder<'a>,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Move(
        target,
        source
    ));
    move_live(value, source, target)
}

emit_copy<'a>(
    value: &mut MirBuilder<'a>,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Copy(
        target,
        source
    ));
    Vec::push(&mut value.live_order, target)
}

emit_construct<'a>(
    value: &mut MirBuilder<'a>,
    target: RegisterId,
    ty: ArtifactTypeId,
    variant: Option<u32>,
    fields: Vec<RegisterId>
) {
    record_cleanup(value);
    consume_arguments(value, &fields, 0);
    let pack = alloc_register_pack(value, fields);
    Vec::push(&mut value.instructions, MirInstruction::Construct(
        target,
        ty,
        variant,
        pack
    ));
    Vec::push(&mut value.live_order, target)
}

emit_project_move<'a>(
    value: &mut MirBuilder<'a>,
    target: RegisterId,
    source: RegisterId,
    field: u32
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::ProjectMove(
        target,
        source,
        field
    ));
    Vec::push(&mut value.live_order, target)
}

emit_project_copy<'a>(
    value: &mut MirBuilder<'a>,
    target: RegisterId,
    source: RegisterId,
    field: u32
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::ProjectCopy(
        target,
        source,
        field
    ));
    Vec::push(&mut value.live_order, target)
}

emit_enum_tag<'a>(
    value: &mut MirBuilder<'a>,
    target: RegisterId,
    source: RegisterId
) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::EnumTag(
        target,
        source
    ));
    Vec::push(&mut value.live_order, target)
}

emit_drop<'a>(value: &mut MirBuilder<'a>, register: RegisterId) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Drop(register));
    consume_live(value, register)
}

emit_deconstruct<'a>(value: &mut MirBuilder<'a>, register: RegisterId) {
    record_cleanup(value);
    Vec::push(
        &mut value.instructions,
        MirInstruction::Deconstruct(register)
    );
    consume_live(value, register)
}

emit_primitive<'a>(
    value: &mut MirBuilder<'a>,
    target: RegisterId,
    primitive: u32,
    arguments: Vec<RegisterId>
) {
    record_cleanup(value);
    consume_arguments(value, &arguments, 0);
    let pack = alloc_register_pack(value, arguments);
    Vec::push(&mut value.instructions, MirInstruction::Primitive(
        target,
        primitive,
        pack
    ));
    Vec::push(&mut value.live_order, target)
}

emit_host_call<'a>(
    value: &mut MirBuilder<'a>,
    target: Option<RegisterId>,
    import: u32,
    arguments: Vec<RegisterId>
) {
    record_cleanup(value);
    consume_arguments(value, &arguments, 0);
    let pack = alloc_register_pack(value, arguments);
    Vec::push(&mut value.instructions, MirInstruction::HostCall(
        target,
        import,
        pack
    ));
    handle target {
        None => (),
        Option::Some(found) => Vec::push(&mut value.live_order, found)
    }
}

emit_jump<'a>(value: &mut MirBuilder<'a>, target: MirBlockId) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Jump(target))
}

emit_switch<'a>(
    value: &mut MirBuilder<'a>,
    discriminant: RegisterId,
    cases: Vec<MirSwitchCase>,
    otherwise: MirBlockId
) {
    record_cleanup(value);
    let pack = alloc_switch_pack(value, cases);
    Vec::push(&mut value.instructions, MirInstruction::Switch(
        discriminant,
        pack,
        otherwise
    ))
}

consume_arguments<'a>(
    value: &mut MirBuilder<'a>,
    arguments: &Vec<RegisterId>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(arguments)), { current =>
        consume_live(value, *Vec::index(arguments, current))
    })
}

emit_call<'a>(
    value: &mut MirBuilder<'a>,
    target: Option<RegisterId>,
    function: MirFunctionId,
    arguments: Vec<RegisterId>
) {
    record_cleanup(value);
    consume_arguments(value, &arguments, 0);
    let pack = alloc_register_pack(value, arguments);
    Vec::push(&mut value.instructions, MirInstruction::Call(
        target,
        function,
        pack
    ));
    let inserted = target;
    if(inserted is Result::Ok(register)) {
        Vec::push(&mut value.live_order, register)
    } else { () }
}

emit_unreachable<'a>(value: &mut MirBuilder<'a>) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Unreachable)
}

emit_return<'a>(value: &mut MirBuilder<'a>, source: Option<RegisterId>) {
    record_cleanup(value);
    Vec::push(&mut value.instructions, MirInstruction::Return(source))
}

local_register<'a>(
    value: &MirBuilder<'a>,
    local: CoreLocalId
) -> Option<RegisterId> {
    *Vec::index(&value.locals, Id::to_usize(local))
}

set_local<'a>(
    value: &mut MirBuilder<'a>,
    local: CoreLocalId,
    register: Option<RegisterId>
) {
    *Vec::index_mut(&mut value.locals, Id::to_usize(local)) = register;
    ()
}

lower_value<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    id: CoreValueId
) -> Result<Option<RegisterId>, LoweringError> {
    handle super::super::frontend::elaboration::typed_body_value_at(
        body,
        id
    ) {
        CoreValueView::Unit(_) => {
            let target = alloc_register(value);
            let key = Vec::new();
            Vec::push(&mut key, 0);
            emit_const(value, target, Bytes::from_vec(key));
            Result::Ok(Option::Some(target))
        },
        CoreValueView::Integer(type_id, constant) => {
            let target = alloc_register(value);
            let key = try(
                constant_key(body, type_id, constant),
                @lower_value
            );
            emit_const(value, target, key);
            Result::Ok(Option::Some(target))
        },
        CoreValueView::Local(type_id, local, _, _) => {
            type_id;
            let transfer = *IndexVec::index(
                &value.place_flow.final_transfers,
                id
            );
            handle local_register(value, local) {
                Result::Err(_) =>
                    Result::Err(LoweringError::MissingLocal(local)),
                Result::Ok(source) => {
                    let target = alloc_register(value);
                    if(transfer) {
                        emit_move(value, target, source);
                        set_local(value, local, None)
                    } else {
                        emit_copy(value, target, source)
                    };
                    Result::Ok(Option::Some(target))
                }
            }
        },
        CoreValueView::Projection(_, source, field) => {
            let lowered = try(
                lower_value(interfaces, body, value, source),
                @lower_value
            );
            handle lowered {
                Result::Err(_) =>
                    Result::Err(
                        LoweringError::MissingProjectionSource(id)
                    ),
                Result::Ok(source_register) => {
                    let target = alloc_register(value);
                    emit_project_copy(
                        value,
                        target,
                        source_register,
                        field
                    );
                    emit_drop(value, source_register);
                    Result::Ok(Option::Some(target))
                }
            }
        },
        CoreValueView::Embedded(_, computation) =>
            lower_computation(interfaces, body, value, computation)
    }
}

lower_arguments<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    operands: Slice<'a, CoreValueId>,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    Slice::try_for_each(operands, { operand => {
        let id = *operand;
        let lowered = try(
            lower_value(interfaces, body, value, id),
            @lower_arguments
        );
        handle lowered {
            Result::Err(_) =>
                Result::Err(LoweringError::MissingValue(id)),
            Result::Ok(register) => {
                Vec::push(&mut *output, register);
                Result::Ok(())
            }
        }
    } })
}

append_optional_registers(
    source: &Vec<Option<RegisterId>>,
    output: &mut Vec<Option<RegisterId>>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(source)), { current =>
        Vec::push(&mut *output, *Vec::index(source, current))
    })
}

append_registers(
    source: &Vec<RegisterId>,
    output: &mut Vec<RegisterId>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(source)), { current =>
        Vec::push(&mut *output, *Vec::index(source, current))
    })
}

snapshot_locals<'a>(value: &MirBuilder<'a>) -> Vec<Option<RegisterId>> {
    let output = Vec::new();
    append_optional_registers(&value.locals, &mut output, 0);
    output
}

snapshot_live<'a>(value: &MirBuilder<'a>) -> Vec<RegisterId> {
    let output = Vec::new();
    append_registers(&value.live_order, &mut output, 0);
    output
}

restore_match_state<'a>(
    value: &mut MirBuilder<'a>,
    locals: &Vec<Option<RegisterId>>,
    live: &Vec<RegisterId>
) {
    Vec::clear(&mut value.locals);
    append_optional_registers(locals, &mut value.locals, 0);
    Vec::clear(&mut value.live_order);
    append_registers(live, &mut value.live_order, 0)
}

optional_registers_equal(
    left: &Vec<Option<RegisterId>>,
    right: &Vec<Option<RegisterId>>,
    index: usize
) -> Bool {
    if(Vec::len(left) == Vec::len(right)) {
        if(index < Vec::len(left)) {
            if(Eq::eq(
                Vec::index(left, index),
                Vec::index(right, index)
            )) {
                optional_registers_equal(left, right, index + 1)
            } else { false }
        } else { true }
    } else { false }
}

registers_equal(
    left: &Vec<RegisterId>,
    right: &Vec<RegisterId>,
    index: usize
) -> Bool {
    if(Vec::len(left) == Vec::len(right)) {
        if(index < Vec::len(left)) {
            if(*Vec::index(left, index) == *Vec::index(right, index)) {
                registers_equal(left, right, index + 1)
            } else { false }
        } else { true }
    } else { false }
}

alloc_match_blocks<'a>(
    value: &mut MirBuilder<'a>,
    count: usize,
    index: usize,
    output: &mut Vec<MirBlockId>
) {
    for_range(Range::new(index, count), { _ =>
        Vec::push(&mut *output, alloc_block(value))
    })
}

build_match_switch_cases<'a>(
    arms: Slice<'a, CoreMatchArm>,
    blocks: &Vec<MirBlockId>,
    count: usize,
    index: usize,
    output: &mut Vec<MirSwitchCase>
) {
    for_range(Range::new(index, count), { current => {
        let arm = handle Slice::get(arms, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        Vec::push(&mut *output, MirSwitchCase {
            key: u32_constant_key(
                super::super::frontend::elaboration::
                    core_match_arm_variant(arm)
            ),
            target: *Vec::index(blocks, current)
        })
    } })
}

project_match_fields<'a>(
    value: &mut MirBuilder<'a>,
    subject: RegisterId,
    bindings: Slice<'a, CoreMatchBinding>,
    index: usize,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    try_for_range(Range::new(index, Slice::len(bindings)), { current => {
        let binding = handle Slice::get(bindings, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let field =
            super::super::frontend::elaboration::
                core_match_binding_field(binding);
        if(field == checked_u32(current)) {
            let target = alloc_register(value);
            emit_project_move(value, target, subject, field);
            Vec::push(&mut *output, target);
            Result::Ok(())
        } else {
            Result::Err(LoweringError::ConstructionFieldOrder(
                checked_u32(current),
                field
            ))
        }
    } })
}

install_match_bindings_reverse<'a>(
    value: &mut MirBuilder<'a>,
    bindings: Slice<'a, CoreMatchBinding>,
    registers: &Vec<RegisterId>,
    remaining: usize
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let binding = handle Slice::get(bindings, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let register = *Vec::index(registers, index);
        handle
            super::super::frontend::elaboration::
                core_match_binding_local(binding) {
            Result::Err(_) => emit_drop(value, register),
            Result::Ok(local) =>
                set_local(value, local, Option::Some(register))
        };
        install_match_bindings_reverse(
            value,
            bindings,
            registers,
            index
        )
    }
}

drop_match_locals_reverse<'a>(
    value: &mut MirBuilder<'a>,
    bindings: Slice<'a, CoreMatchBinding>,
    remaining: usize
) {
    if(remaining == 0) { () } else {
        let index = remaining - 1;
        let binding = handle Slice::get(bindings, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        handle
            super::super::frontend::elaboration::
                core_match_binding_local(binding) {
            Result::Err(_) => (),
            Result::Ok(local) => handle local_register(value, local) {
                Result::Err(_) => (),
                Result::Ok(register) => {
                    emit_drop(value, register);
                    set_local(value, local, None)
                }
            }
        };
        drop_match_locals_reverse(value, bindings, index)
    }
}

match_binding_at<'a>(
    bindings: Slice<'a, CoreMatchBinding>,
    index: usize
) -> CoreMatchBinding {
    *handle Slice::get(bindings, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

match_bindings_refutable<'a>(
    bindings: Slice<'a, CoreMatchBinding>,
    index: usize
) -> Bool {
    if(index < Slice::len(bindings)) {
        let binding = match_binding_at(bindings, index);
        handle super::super::frontend::elaboration::
            core_match_binding_integer_test(binding) {
            None => match_bindings_refutable(bindings, index + 1),
            Option::Some(_) => true
        }
    } else { false }
}

next_variant_block<'a>(
    arms: Slice<'a, CoreMatchArm>,
    blocks: &Vec<MirBlockId>,
    variant: u32,
    index: usize
) -> Option<MirBlockId> {
    if(index < Slice::len(arms)) {
        let arm = handle Slice::get(arms, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        if(super::super::frontend::elaboration::
            core_match_arm_variant(arm) == variant) {
            Option::Some(*Vec::index(blocks, index))
        } else { next_variant_block(arms, blocks, variant, index + 1) }
    } else { None }
}

lower_match_binding_tests<'a>(
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    subject: RegisterId,
    bindings: Slice<'a, CoreMatchBinding>,
    failure: MirBlockId,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Slice::len(bindings)) {
        let binding = match_binding_at(bindings, index);
        handle super::super::frontend::elaboration::
            core_match_binding_integer_test(binding) {
            None => lower_match_binding_tests(
                body, value, subject, bindings, failure, index + 1
            ),
            Option::Some(test_parts) => {
                let (field, ty, constant) = test_parts;
                let test = alloc_register(value);
                emit_project_copy(
                    value,
                    test,
                    subject,
                    field
                );
                let passed = alloc_block(value);
                let failed = alloc_block(value);
                let key = try(constant_key(
                    body,
                    ty,
                    constant
                ), @lower_match_binding_tests);
                let cases = Vec::new();
                Vec::push(&mut cases, MirSwitchCase {
                    key: key,
                    target: passed
                });
                emit_switch(value, test, cases, failed);
                bind_block(value, failed);
                emit_drop(value, test);
                emit_jump(value, failure);
                // The failed edge changes only the last-allocated test
                // register. Restore the builder's linear state for the
                // success edge without retaining borrowed state snapshots.
                Vec::push(&mut value.live_order, test);
                bind_block(value, passed);
                emit_drop(value, test);
                lower_match_binding_tests(
                    body, value, subject, bindings, failure, index + 1
                )
            }
        }
    } else { Result::Ok(()) }
}

match_flow_index(
    facts: &PlaceFlowFacts,
    computation: CoreComputationId,
    index: usize
) -> Option<usize> {
    if(index < Vec::len(&facts.matches)) {
        let found = Vec::index(&facts.matches, index);
        if(found.computation == computation) {
            Option::Some(index)
        } else {
            match_flow_index(facts, computation, index + 1)
        }
    } else { None }
}

retire_dead_match_locals<'a>(
    value: &mut MirBuilder<'a>,
    baseline: &Vec<Option<RegisterId>>,
    live_out: &Vec<Bool>,
    index: usize
) {
    if(index < Vec::len(baseline)) {
        if(*Vec::index(live_out, index)) { () } else {
            handle *Vec::index(baseline, index) {
                None => (),
                Option::Some(_) => {
                    let local = Id::from_u32(checked_u32(index));
                    handle local_register(value, local) {
                        None => (),
                        Option::Some(register) => {
                            emit_drop(value, register);
                            set_local(value, local, None)
                        }
                    }
                }
            }
        };
        retire_dead_match_locals(
            value,
            baseline,
            live_out,
            index + 1
        )
    } else { () }
}

lower_match_arms<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    arms: Slice<'a, CoreMatchArm>,
    blocks: &Vec<MirBlockId>,
    subject: RegisterId,
    tag: RegisterId,
    result: Option<RegisterId>,
    join: MirBlockId,
    baseline_locals: &Vec<Option<RegisterId>>,
    baseline_live: &Vec<RegisterId>,
    match_live_out: &Vec<Bool>,
    canonical_locals: &mut Vec<Option<RegisterId>>,
    canonical_live: &mut Vec<RegisterId>,
    canonical_set: &mut Bool,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Slice::len(arms)) {
        restore_match_state(value, baseline_locals, baseline_live);
        bind_block(value, *Vec::index(blocks, index));
        let arm = handle Slice::get(arms, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let bindings =
            super::super::frontend::elaboration::
                core_match_arm_bindings(body, arm);
        if(match_bindings_refutable(bindings, 0)) {
            let variant = super::super::frontend::elaboration::
                core_match_arm_variant(arm);
            handle next_variant_block(
                arms,
                blocks,
                variant,
                index + 1
            ) {
                None => @lower_match_arms(Result::Err(
                    LoweringError::MatchStateMismatch
                )),
                Option::Some(failure) => try(lower_match_binding_tests(
                    body,
                    value,
                    subject,
                    bindings,
                    failure,
                    0
                ), @lower_match_arms)
            }
        } else { () };
        emit_drop(value, tag);
        let registers = Vec::new();
        try(project_match_fields(
            value,
            subject,
            bindings,
            0,
            &mut registers
        ), @lower_match_arms);
        emit_deconstruct(value, subject);
        install_match_bindings_reverse(
            value,
            bindings,
            &registers,
            Vec::len(&registers)
        );
        let arm_computation =
            super::super::frontend::elaboration::
                core_match_arm_body(arm);
        let lowered = try(lower_computation(
            interfaces,
            body,
            value,
            arm_computation
        ), @lower_match_arms);
        handle lowered {
            Result::Err(_) => lower_match_arms(
                interfaces,
                body,
                value,
                arms,
                blocks,
                subject,
                tag,
                result,
                join,
                baseline_locals,
                baseline_live,
                match_live_out,
                canonical_locals,
                canonical_live,
                canonical_set,
                index + 1
            ),
            Result::Ok(branch_result) => {
                let result_register = handle result {
                    None => @lower_match_arms(Result::Err(
                        LoweringError::MissingMatchResult(arm_computation)
                    )),
                    Option::Some(found) => found
                };
                drop_match_locals_reverse(
                    value,
                    bindings,
                    Slice::len(bindings)
                );
                retire_dead_match_locals(
                    value,
                    baseline_locals,
                    match_live_out,
                    0
                );
                emit_move(value, result_register, branch_result);
                emit_jump(value, join);
                if(*canonical_set) {
                    let locals_match = optional_registers_equal(
                        &value.locals,
                        canonical_locals,
                        0
                    );
                    let live_match = if(locals_match) {
                        registers_equal(
                            &value.live_order,
                            canonical_live,
                            0
                        )
                    } else { false };
                    if(live_match) {
                        lower_match_arms(
                            interfaces,
                            body,
                            value,
                            arms,
                            blocks,
                            subject,
                            tag,
                            result,
                            join,
                            baseline_locals,
                            baseline_live,
                            match_live_out,
                            canonical_locals,
                            canonical_live,
                            canonical_set,
                            index + 1
                        )
                    } else {
                        Result::Err(LoweringError::MatchStateMismatch)
                    }
                } else {
                    Vec::clear(canonical_locals);
                    append_optional_registers(
                        &value.locals,
                        canonical_locals,
                        0
                    );
                    Vec::clear(canonical_live);
                    append_registers(
                        &value.live_order,
                        canonical_live,
                        0
                    );
                    *canonical_set = true;
                    lower_match_arms(
                        interfaces,
                        body,
                        value,
                        arms,
                        blocks,
                        subject,
                        tag,
                        result,
                        join,
                        baseline_locals,
                        baseline_live,
                        match_live_out,
                        canonical_locals,
                        canonical_live,
                        canonical_set,
                        index + 1
                    )
                }
            }
        }
    } else { Result::Ok(()) }
}

match_has_returning_arm<'a>(
    body: &super::super::frontend::elaboration::TypedBody,
    arms: Slice<'a, CoreMatchArm>,
    index: usize
) -> Bool {
    if(index < Slice::len(arms)) {
        let arm = handle Slice::get(arms, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let computation = super::super::frontend::elaboration::
            core_match_arm_body(arm);
        if(Id::to_u32(
            super::super::frontend::elaboration::
                typed_body_computation_type(body, computation)
        ) == 1) {
            match_has_returning_arm(body, arms, index + 1)
        } else {
            true
        }
    } else { false }
}

lower_match<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    computation: CoreComputationId,
    subject: CoreValueId,
    arms: Slice<'a, CoreMatchArm>
) -> Result<Option<RegisterId>, LoweringError> {
    let flow_index = handle match_flow_index(
        &value.place_flow,
        computation,
        0
    ) {
        None => @lower_match(Result::Err(
            LoweringError::MissingMatchFlow(computation)
        )),
        Option::Some(found) => found
    };
    let flow = Vec::index(&value.place_flow.matches, flow_index);
    let match_live = copy_liveness(&flow.live_out);
    let lowered_subject = try(lower_value(
        interfaces,
        body,
        value,
        subject
    ), @lower_match);
    handle lowered_subject {
        Result::Err(_) =>
            Result::Err(LoweringError::MissingMatchSubject(subject)),
        Result::Ok(subject_register) => {
            if(Slice::len(arms) == 0) {
                Result::Err(LoweringError::MatchStateMismatch)
            } else {
                let tag = alloc_register(value);
                emit_enum_tag(value, tag, subject_register);
                let result = if(match_has_returning_arm(body, arms, 0)) {
                    Option::Some(alloc_register(value))
                } else {
                    None
                };
                let blocks = Vec::new();
                alloc_match_blocks(
                    value,
                    Slice::len(arms),
                    0,
                    &mut blocks
                );
                let join = alloc_block(value);
                let explicit_count = Slice::len(arms) - 1;
                let cases = Vec::new();
                build_match_switch_cases(
                    arms,
                    &blocks,
                    explicit_count,
                    0,
                    &mut cases
                );
                emit_switch(
                    value,
                    tag,
                    cases,
                    *Vec::index(&blocks, explicit_count)
                );
                let baseline_locals = snapshot_locals(&*value);
                let baseline_live = snapshot_live(&*value);
                let canonical_locals = Vec::new();
                let canonical_live = Vec::new();
                let canonical_set = false;
                try(lower_match_arms(
                    interfaces,
                    body,
                    value,
                    arms,
                    &blocks,
                    subject_register,
                    tag,
                    result,
                    join,
                    &baseline_locals,
                    &baseline_live,
                    &match_live,
                    &mut canonical_locals,
                    &mut canonical_live,
                    &mut canonical_set,
                    0
                ), @lower_match);
                if(canonical_set) {
                    restore_match_state(
                        value,
                        &canonical_locals,
                        &canonical_live
                    )
                } else {
                    restore_match_state(
                        value,
                        &baseline_locals,
                        &baseline_live
                    )
                };
                bind_block(value, join);
                if(canonical_set) {
                    Result::Ok(result)
                } else {
                    Result::Ok(None)
                }
            }
        }
    }
}

lower_nominal_construct<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    type_id: TypeId,
    nominal: u32,
    flavor: ConstructionFlavor,
    fields: Slice<'a, ConstructionField>
) -> Result<Option<RegisterId>, LoweringError> {
    handle super::super::frontend::elaboration::interface_nominal_at_view(
        interfaces,
        usize_from_u32(nominal)
    ) {
        InterfaceNominalView::Struct(_, _, expected) => handle flavor {
            ConstructionFlavor::Product => lower_aggregate(
                interfaces,
                body,
                value,
                type_id,
                None,
                fields,
                expected
            ),
            ConstructionFlavor::Variant(ordinal) => Result::Err(
                LoweringError::UnexpectedVariant(type_id, ordinal)
            )
        },
        InterfaceNominalView::Enum(_, start, count) => handle flavor {
            ConstructionFlavor::Product => Result::Err(
                LoweringError::MissingVariant(type_id)
            ),
            ConstructionFlavor::Variant(ordinal) => if(ordinal < count) {
                let payloads = super::super::frontend::elaboration::
                    interface_variant_payloads_at(
                        interfaces,
                        usize_from_u32(start + ordinal)
                    );
                lower_aggregate(
                    interfaces,
                    body,
                    value,
                    type_id,
                    Option::Some(ordinal),
                    fields,
                    checked_u32(Slice::len(payloads))
                )
            } else { Result::Err(LoweringError::VariantOutOfRange(
                type_id,
                ordinal
            )) }
        }
    }
}

lower_computation<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    id: CoreComputationId
) -> Result<Option<RegisterId>, LoweringError> {
    handle
        super::super::frontend::elaboration::typed_body_computation_at(
            body,
            id
        ) {
        CoreComputationView::Pure(_, found) =>
            lower_value(interfaces, body, value, found),
        CoreComputationView::Let(_, local, initializer, remainder) => {
            let initialized = try(
                lower_computation(
                    interfaces,
                    body,
                    value,
                    initializer
                ),
                @lower_computation
            );
            handle initialized {
                None => Result::Ok(None),
                Option::Some(register) => {
                    set_local(value, local, Option::Some(register));
                    lower_computation(interfaces, body, value, remainder)
                }
            }
        },
        CoreComputationView::Call(type_id, shell, instance, operands) => {
            let arguments = Vec::new();
            try(lower_arguments(
                interfaces,
                body,
                value,
                operands,
                &mut arguments
            ), @lower_computation);
            let callable =
                super::super::frontend::elaboration::
                    callable_instance_callable(interfaces, instance);
            if(
                super::super::frontend::elaboration::
                    interface_callable_shell(interfaces, callable) == shell
            ) {
                    let target = if(Id::to_u32(type_id) == 1) {
                        None
                    } else {
                        Option::Some(alloc_register(value))
                    };
                    emit_call(
                        value,
                        target,
                        mir_function_id_from_u32(Id::to_u32(instance)),
                        arguments
                    );
                    if(Id::to_u32(type_id) == 1) {
                        emit_unreachable(value)
                    } else { () };
                    Result::Ok(target)
            } else { Result::Err(LoweringError::UnknownCallable(shell)) }
        },
        CoreComputationView::Primitive(_, primitive, operands) => {
            let arguments = Vec::new();
            try(lower_arguments(
                interfaces,
                body,
                value,
                operands,
                &mut arguments
            ), @lower_computation);
            let target = alloc_register(value);
            emit_primitive(value, target, primitive, arguments);
            Result::Ok(Option::Some(target))
        },
        CoreComputationView::Construct(type_id, flavor, fields) => {
            handle super::super::frontend::elaboration::interface_type_at(
                interfaces,
                Id::to_usize(type_id)
            ) {
                InterfaceTypeView::Tuple(elements) => handle flavor {
                    ConstructionFlavor::Product => lower_aggregate(
                        interfaces,
                        body,
                        value,
                        type_id,
                        None,
                        fields,
                        checked_u32(Slice::len(elements))
                    ),
                    ConstructionFlavor::Variant(ordinal) =>
                        Result::Err(
                            LoweringError::UnexpectedVariant(
                                type_id,
                                ordinal
                            )
                        )
                },
                InterfaceTypeView::Nominal(nominal) =>
                    lower_nominal_construct(
                        interfaces,
                        body,
                        value,
                        type_id,
                        nominal,
                        flavor,
                        fields
                    ),
                InterfaceTypeView::Application(_, _) => handle
                    super::super::frontend::elaboration::
                        interface_application_nominal(
                            interfaces,
                            type_id
                        ) {
                    None => Result::Err(
                        LoweringError::InvalidConstructionType(type_id)
                    ),
                    Option::Some(nominal) => lower_nominal_construct(
                        interfaces,
                        body,
                        value,
                        type_id,
                        nominal,
                        flavor,
                        fields
                    )
                },
                InterfaceTypeView::Scalar(kind) => if(kind ==
                    wrapping_convert_to_u8(16)
                ) {
                    handle flavor {
                        // Focused-arena Bool literals elaborate as a variant
                        // construct over the Bool scalar marker (kind 16;
                        // `Result<Unit, Unit>`: two nullary variants).
                        ConstructionFlavor::Variant(ordinal) => {
                            let registers = Vec::new();
                            let target = alloc_register(value);
                            emit_construct(
                                value,
                                target,
                                handle mapped_artifact_type(
                                    value.type_map, type_id
                                ) {
                                    None => unreachable(),
                                    Option::Some(found) => found
                                },
                                Option::Some(ordinal),
                                registers
                            );
                            Result::Ok(Option::Some(target))
                        },
                        ConstructionFlavor::Product => Result::Err(
                            LoweringError::UnexpectedVariant(type_id, 0)
                        )
                    }
                } else { Result::Err(
                    LoweringError::InvalidConstructionType(type_id)
                ) },
                _ => Result::Err(
                    LoweringError::InvalidConstructionType(type_id)
                )
            }
        },
        CoreComputationView::VariantDispatch(_, subject, arms) =>
            lower_match(interfaces, body, value, id, subject, arms),
        CoreComputationView::Perform(_, _, _) =>
            Result::Err(LoweringError::EffectControlNotLowered(id)),
        CoreComputationView::Resume(_, _, _) =>
            Result::Err(LoweringError::EffectControlNotLowered(id)),
        CoreComputationView::Handle(_, _, _) =>
            Result::Err(LoweringError::EffectControlNotLowered(id))
    }
}

lower_aggregate<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    type_id: TypeId,
    variant: Option<u32>,
    fields: Slice<'a, ConstructionField>,
    expected: u32
) -> Result<Option<RegisterId>, LoweringError> {
    if(checked_u32(Slice::len(fields)) == expected) {
            let registers = Vec::new();
            try(lower_product_fields(
                interfaces,
                body,
                value,
                fields,
                &mut registers
            ), @lower_aggregate);
            let target = alloc_register(value);
            emit_construct(
                value,
                target,
                handle mapped_artifact_type(value.type_map, type_id) {
                    None => unreachable(),
                    Option::Some(found) => found
                },
                variant,
                registers
            );
            Result::Ok(Option::Some(target))
        } else {
            Result::Err(LoweringError::ConstructionFieldCount(
                type_id,
                expected,
                checked_u32(Slice::len(fields))
            ))
        }
}

lower_product_fields<'a>(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    value: &mut MirBuilder<'a>,
    fields: Slice<'a, ConstructionField>,
    output: &mut Vec<RegisterId>
) -> Result<(), LoweringError> {
    Slice::try_for_each(fields, { entry => {
        let field =
            super::super::frontend::elaboration::
                construction_field_ordinal(entry);
        let operand =
            super::super::frontend::elaboration::
                construction_field_value(entry);
        if(field == checked_u32(Vec::len(output))) {
            let lowered = try(
                lower_value(interfaces, body, value, operand),
                @lower_product_fields
            );
            handle lowered {
                Result::Err(_) =>
                    Result::Err(LoweringError::MissingValue(operand)),
                Result::Ok(register) => {
                    Vec::push(&mut *output, register);
                    Result::Ok(())
                }
            }
        } else {
            Result::Err(LoweringError::ConstructionFieldOrder(
                checked_u32(Vec::len(output)),
                field
            ))
        }
    } })
}

parameter_types(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    function: InterfaceCallableId,
    index: u32,
    count: u32,
    output: &mut Vec<ArtifactTypeId>
) {
    for_range(Range::new(
        usize_from_u32(index),
        usize_from_u32(count)
    ), { current =>
        Vec::push(
            &mut *output,
            artifact_type_id(
                Id::to_u32(super::super::frontend::elaboration::
                    interface_callable_parameter_at(
                        interfaces,
                        function,
                        current
                    ))
            )
        )
    })
}

instance_parameter_types(
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    instance: super::super::frontend::elaboration::CallableInstanceId,
    type_map: &ArtifactTypeMap,
    index: u32,
    count: u32,
    output: &mut Vec<ArtifactTypeId>
) {
    for_range(Range::new(
        usize_from_u32(index),
        usize_from_u32(count)
    ), { current =>
        Vec::push(
            &mut *output,
            handle mapped_artifact_type(
                type_map,
                super::super::frontend::elaboration::
                    callable_instance_parameter_at(
                        interfaces,
                        instance,
                        current
                    )
            ) {
                None => unreachable(),
                Option::Some(found) => found
            }
        )
    })
}

validate_mir_register<'a>(
    value: &MirBuilder<'a>,
    register: RegisterId
) -> Result<(), LoweringError> {
    if(Id::to_u32(register) < value.register_count) {
        Result::Ok(())
    } else {
        Result::Err(LoweringError::InvalidMirRegister(register))
    }
}

validate_optional_mir_register<'a>(
    value: &MirBuilder<'a>,
    register: Option<RegisterId>
) -> Result<(), LoweringError> {
    handle register {
        None => Result::Ok(()),
        Option::Some(found) => validate_mir_register(value, found)
    }
}

validate_mir_register_pack<'a>(
    value: &MirBuilder<'a>,
    pack: RegisterPackId,
    index: usize
) -> Result<(), LoweringError> {
    if(Id::to_usize(pack) < Arena::len(&value.register_packs)) {
        let found = Arena::index(&value.register_packs, pack);
        if(index < Vec::len(&found.registers)) {
            try(validate_mir_register(
                value,
                *Vec::index(&found.registers, index)
            ), @validate_mir_register_pack);
            validate_mir_register_pack(value, pack, index + 1)
        } else {
            Result::Ok(())
        }
    } else {
        Result::Err(LoweringError::InvalidMirRegisterPack(pack))
    }
}

validate_mir_block<'a>(
    value: &MirBuilder<'a>,
    block: MirBlockId
) -> Result<(), LoweringError> {
    if(Id::to_usize(block) < Arena::len(&value.blocks)) {
        handle *Arena::index(&value.blocks, block) {
            None => Result::Err(LoweringError::UnboundMirBlock(block)),
            Option::Some(offset) => if(
                usize_from_u32(offset) <= Vec::len(&value.instructions)
            ) {
                Result::Ok(())
            } else {
                Result::Err(LoweringError::UnboundMirBlock(block))
            }
        }
    } else {
        Result::Err(LoweringError::UnboundMirBlock(block))
    }
}

validate_mir_switch_pack<'a>(
    value: &MirBuilder<'a>,
    pack: MirSwitchPackId,
    index: usize
) -> Result<(), LoweringError> {
    if(Id::to_usize(pack) < Arena::len(&value.switch_packs)) {
        let found = Arena::index(&value.switch_packs, pack);
        if(index < Vec::len(&found.cases)) {
            try(validate_mir_block(
                value,
                Vec::index(&found.cases, index).target
            ), @validate_mir_switch_pack);
            validate_mir_switch_pack(value, pack, index + 1)
        } else {
            Result::Ok(())
        }
    } else {
        Result::Err(LoweringError::InvalidMirSwitchPack(pack))
    }
}

validate_mir_instruction<'a>(
    value: &MirBuilder<'a>,
    interfaces: &super::super::frontend::elaboration::TypedInterfaces,
    instruction: &MirInstruction
) -> Result<(), LoweringError> {
    if(*instruction is MirInstruction::Const(target, _)) {
        validate_mir_register(value, target)
    } else if(*instruction is MirInstruction::Move(target, source)) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::Copy(target, source)) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::Construct(
        target,
        _,
        _,
        pack
    )) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register_pack(value, pack, 0)
    } else if(*instruction is MirInstruction::ProjectMove(
        target,
        source,
        _
    )) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::ProjectCopy(
        target,
        source,
        _
    )) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::EnumTag(target, source)) {
        try(validate_mir_register(value, target), @validate_mir_instruction);
        validate_mir_register(value, source)
    } else if(*instruction is MirInstruction::Drop(register)) {
        validate_mir_register(value, register)
    } else if(*instruction is MirInstruction::Deconstruct(register)) {
        validate_mir_register(value, register)
    } else if(*instruction is MirInstruction::Primitive(target, _, pack)) {
        try(validate_mir_register(
            value,
            target
        ), @validate_mir_instruction);
        validate_mir_register_pack(value, pack, 0)
    } else if(*instruction is MirInstruction::HostCall(target, _, pack)) {
        handle target {
            None => (),
            Option::Some(found) => try(validate_mir_register(
                value,
                found
            ), @validate_mir_instruction)
        };
        validate_mir_register_pack(value, pack, 0)
    } else if(*instruction is MirInstruction::Abort) {
        Result::Ok(())
    } else if(*instruction is MirInstruction::Unreachable) {
        Result::Ok(())
    } else if(*instruction is MirInstruction::Jump(block)) {
        validate_mir_block(value, block)
    } else if(*instruction is MirInstruction::Switch(
        register,
        pack,
        otherwise
    )) {
        try(validate_mir_register(
            value,
            register
        ), @validate_mir_instruction);
        try(validate_mir_switch_pack(
            value,
            pack,
            0
        ), @validate_mir_instruction);
        validate_mir_block(value, otherwise)
    } else if(*instruction is MirInstruction::Call(target, function, pack)) {
        try(validate_optional_mir_register(
            value,
            target
        ), @validate_mir_instruction);
        try(validate_mir_register_pack(
            value,
            pack,
            0
        ), @validate_mir_instruction);
        if(Id::to_usize(function) <
            super::super::frontend::elaboration::
                interface_callable_count(interfaces)) {
            Result::Ok(())
        } else {
            Result::Err(LoweringError::InvalidMirFunction(function))
        }
    } else if(*instruction is MirInstruction::Return(source)) {
        validate_optional_mir_register(value, source)
    } else {
        unreachable()
    }
}

validate_mir_instructions<'a>(
    value: &MirBuilder<'a>,
    interfaces: &super::super::frontend::elaboration::TypedInterfaces,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Vec::len(&value.instructions)) {
        try(validate_mir_instruction(
            value,
            interfaces,
            Vec::index(&value.instructions, index)
        ), @validate_mir_instructions);
        validate_mir_instructions(value, interfaces, index + 1)
    } else {
        Result::Ok(())
    }
}

validate_mir_cleanup_registers<'a>(
    value: &MirBuilder<'a>,
    cleanup: &MirCleanup,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Vec::len(&cleanup.registers)) {
        try(validate_mir_register(
            value,
            *Vec::index(&cleanup.registers, index)
        ), @validate_mir_cleanup_registers);
        validate_mir_cleanup_registers(value, cleanup, index + 1)
    } else {
        Result::Ok(())
    }
}

validate_mir_cleanups<'a>(
    value: &MirBuilder<'a>,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Vec::len(&value.cleanups)) {
        let cleanup = Vec::index(&value.cleanups, index);
        let instruction = checked_u32(index);
        if(cleanup.first_instruction == instruction and {
            cleanup.end_instruction == instruction + 1
        }) {
            try(validate_mir_cleanup_registers(
                value,
                cleanup,
                0
            ), @validate_mir_cleanups);
            validate_mir_cleanups(value, index + 1)
        } else {
            Result::Err(LoweringError::InvalidMirCleanup(instruction))
        }
    } else {
        Result::Ok(())
    }
}

validate_mir_blocks<'a>(
    value: &MirBuilder<'a>,
    index: usize
) -> Result<(), LoweringError> {
    if(index < Arena::len(&value.blocks)) {
        try(validate_mir_block(
            value,
            Id::from_u32(checked_u32(index))
        ), @validate_mir_blocks);
        validate_mir_blocks(value, index + 1)
    } else {
        Result::Ok(())
    }
}

validate_mir_builder<'a>(
    value: &MirBuilder<'a>,
    interfaces: &super::super::frontend::elaboration::TypedInterfaces
) -> Result<(), LoweringError> {
    let instruction_count = Vec::len(&value.instructions);
    let cleanup_count = Vec::len(&value.cleanups);
    if(instruction_count == cleanup_count) {
        try(validate_mir_instructions(
            value,
            interfaces,
            0
        ), @validate_mir_builder);
        try(validate_mir_cleanups(value, 0), @validate_mir_builder);
        validate_mir_blocks(value, 0)
    } else {
        Result::Err(LoweringError::MirCleanupCount(
            checked_u32(instruction_count),
            checked_u32(cleanup_count)
        ))
    }
}

pub lower_function<'a>(
    name: String,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    body: &'a super::super::frontend::elaboration::TypedBody,
    instance: super::super::frontend::elaboration::CallableInstanceId,
    type_map: &'a ArtifactTypeMap
) -> Result<MirFunction, LoweringError> {
    let parameter_count =
        super::super::frontend::elaboration::
            callable_instance_parameter_count(interfaces, instance);
    let parameters = Vec::new();
    instance_parameter_types(
        interfaces,
        instance,
        type_map,
        0,
        parameter_count,
        &mut parameters
    );
    let local_count =
        super::super::frontend::elaboration::typed_body_local_count(body);
    let place_flow = analyze_place_flow(body);
    let builder = MirBuilder {
        type_map: type_map,
        locals: Vec::new(),
        place_flow: place_flow,
        live_order: Vec::new(),
        instructions: Vec::new(),
        cleanups: Vec::new(),
        register_packs: Arena::new(),
        blocks: Arena::new(),
        switch_packs: Arena::new(),
        register_count: parameter_count + 1
    };
    push_parameter_locals(
        &mut builder.locals,
        &mut builder.live_order,
        0,
        parameter_count
    );
    push_missing_locals(
        &mut builder.locals,
        local_count - usize_from_u32(parameter_count)
    );
    let result = try(lower_computation(
        interfaces,
        body,
        &mut builder,
        super::super::frontend::elaboration::typed_body_root(body)
    ), @lower_function);
    let core_result_type =
        super::super::frontend::elaboration::typed_body_result_type(body);
    let result_type = handle mapped_artifact_type(
        type_map, core_result_type
    ) {
        None => unreachable(),
        Option::Some(found) => found
    };
    handle result {
        Result::Err(_) => {
            try(validate_mir_builder(
                &builder,
                interfaces
            ), @lower_function);
            let output = MirFunction {
                name: name,
                parameters: parameters,
                result: result_type,
                outward_protocols: Vec::new(),
                register_count: builder.register_count,
                instructions: builder.instructions,
                cleanups: builder.cleanups,
                register_packs: builder.register_packs,
                function_packs: Arena::new(),
                blocks: builder.blocks,
                switch_packs: builder.switch_packs
            };
            try(validate_final_mir_walkers(
                &output
            ), @lower_function);
            Result::Ok(output)
        },
        Result::Ok(register) => {
            emit_return(&mut builder, Option::Some(register));
            try(validate_mir_builder(
                &builder,
                interfaces
            ), @lower_function);
            let output = MirFunction {
                name: name,
                parameters: parameters,
                result: result_type,
                outward_protocols: Vec::new(),
                register_count: builder.register_count,
                instructions: builder.instructions,
                cleanups: builder.cleanups,
                register_packs: builder.register_packs,
                function_packs: Arena::new(),
                blocks: builder.blocks,
                switch_packs: builder.switch_packs
            };
            try(validate_final_mir_walkers(
                &output
            ), @lower_function);
            Result::Ok(output)
        }
    }
}

pub lower_primitive_function<'a>(
    name: String,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    instance: super::super::frontend::elaboration::CallableInstanceId,
    primitive: u32,
    type_map: &'a ArtifactTypeMap
) -> Result<MirFunction, LoweringError> {
    let parameter_count =
        super::super::frontend::elaboration::
            callable_instance_parameter_count(interfaces, instance);
    let parameters = Vec::new();
    instance_parameter_types(
        interfaces,
        instance,
        type_map,
        0,
        parameter_count,
        &mut parameters
    );
    let builder = MirBuilder {
        type_map: type_map,
        locals: Vec::new(),
        place_flow: PlaceFlowFacts {
            final_transfers: IndexVec::new(),
            matches: Vec::new()
        },
        live_order: Vec::new(),
        instructions: Vec::new(),
        cleanups: Vec::new(),
        register_packs: Arena::new(),
        blocks: Arena::new(),
        switch_packs: Arena::new(),
        register_count: parameter_count + 1
    };
    push_parameter_locals(
        &mut builder.locals,
        &mut builder.live_order,
        0,
        parameter_count
    );
    let arguments = Vec::new();
    for_range(Range::new(0, usize_from_u32(parameter_count)), { index =>
        Vec::push(&mut arguments, Id::from_u32(checked_u32(index) + 1))
    });
    let target = alloc_register(&mut builder);
    emit_primitive(&mut builder, target, primitive, arguments);
    emit_return(&mut builder, Option::Some(target));
    try(validate_mir_builder(
        &builder,
        interfaces
    ), @lower_primitive_function);
    let output = MirFunction {
        name: name,
        parameters: parameters,
        result: handle mapped_artifact_type(
            type_map,
            super::super::frontend::elaboration::callable_instance_result(
                interfaces,
                instance
            )
        ) {
            None => unreachable(),
            Option::Some(found) => found
        },
        outward_protocols: Vec::new(),
        register_count: builder.register_count,
        instructions: builder.instructions,
        cleanups: builder.cleanups,
        register_packs: builder.register_packs,
        function_packs: Arena::new(),
        blocks: builder.blocks,
        switch_packs: builder.switch_packs
    };
    try(validate_final_mir_walkers(
        &output
    ), @lower_primitive_function);
    Result::Ok(output)
}

pub lower_abort_function(
    name: String,
    interfaces:
        &super::super::frontend::elaboration::TypedInterfaces,
    instance: super::super::frontend::elaboration::CallableInstanceId,
    type_map: &ArtifactTypeMap
) -> Result<MirFunction, LoweringError> {
    let parameter_count =
