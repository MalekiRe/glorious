// MIR ownership-aware lowering from the finalized self-hosted Core.
//
// This module intentionally stops before the GRBC container layer.  Its
// instructions retain semantic constant keys and argument lists; the artifact
// writer canonicalizes the shared constant and operand tables afterwards.

use super::super::frontend::elaboration::CoreComputationView;
use super::super::frontend::elaboration::CoreComputationId;
use super::super::frontend::elaboration::CoreLocalId;
use super::super::frontend::elaboration::CoreMatchArm;
use super::super::frontend::elaboration::CoreMatchBinding;
use super::super::frontend::elaboration::CoreValueView;
use super::super::frontend::elaboration::CoreValueId;
use super::super::frontend::elaboration::CoreValueTag;
use super::super::frontend::elaboration::ConstructionField;
use super::super::frontend::elaboration::ConstructionFlavor;
use super::super::frontend::elaboration::IntegerConstantId;
use super::super::frontend::elaboration::CallableInstanceTag;
use super::super::frontend::elaboration::InterfaceCallableId;
use super::super::frontend::elaboration::InterfaceNominalView;
use super::super::frontend::elaboration::InterfaceTypeView;
use super::super::frontend::elaboration::TypeId;
use super::super::frontend::scanner::ShellId;
use super::super::frontend::bodies::Visit;

pub struct RegisterTag {}
pub type RegisterId = Id<RegisterTag>;

pub struct RegisterPackTag {}
pub type RegisterPackId = Id<RegisterPackTag>;

// Demand-specialized callable instances and MIR functions share one identity.
// The compiler allocates MIR functions in instance-discovery order, so a Core
// call cannot accidentally index the declaration-scheme arena.
pub type MirFunctionTag = CallableInstanceTag;
pub type MirFunctionId = Id<MirFunctionTag>;

pub struct MirTypeTag {}
pub type MirTypeId = Id<MirTypeTag>;

pub struct ArtifactTypeTag {}
pub type ArtifactTypeId = Id<ArtifactTypeTag>;

pub struct MirConstantTag {}
pub type MirConstantId = Id<MirConstantTag>;

pub struct MirBlockTag {}
pub type MirBlockId = Id<MirBlockTag>;

pub struct MirSwitchPackTag {}
pub type MirSwitchPackId = Id<MirSwitchPackTag>;

pub struct MirFunctionPackTag {}
pub type MirFunctionPackId = Id<MirFunctionPackTag>;

pub struct MirProtocolTag {}
pub type MirProtocolId = Id<MirProtocolTag>;

pub struct MirHandlerDefinitionTag {}
pub type MirHandlerDefinitionId = Id<MirHandlerDefinitionTag>;

pub struct MirSignature {
    parameters: Vec<ArtifactTypeId>,
    result: ArtifactTypeId,
    outward_protocols: Vec<u32>
}

pub struct MirOperation {
    name: String,
    payload_signature: MirSignature,
    result: ArtifactTypeId,
    resumption_lower: u32,
    resumption_upper: Option<u32>,
    terminal: Bool
}

pub struct MirProtocol {
    display_name: String,
    type_arguments: Vec<ArtifactTypeId>,
    operations: Vec<MirOperation>
}

pub struct MirHandlerClause {
    protocol: MirProtocolId,
    operation: u32,
    callable_signature: MirSignature,
    resumption_type: Option<ArtifactTypeId>
}

pub struct MirHandlerDefinition {
    result: ArtifactTypeId,
    clauses: Vec<MirHandlerClause>,
    partial: Bool
}

pub enum MirInstruction {
    Const(RegisterId, Bytes),
    Move(RegisterId, RegisterId),
    Copy(RegisterId, RegisterId),
    Construct(RegisterId, ArtifactTypeId, Option<u32>, RegisterPackId),
    ProjectMove(RegisterId, RegisterId, u32),
    ProjectCopy(RegisterId, RegisterId, u32),
    EnumTag(RegisterId, RegisterId),
    Drop(RegisterId),
    Deconstruct(RegisterId),
    Primitive(RegisterId, u32, RegisterPackId),
    HostCall(Option<RegisterId>, u32, RegisterPackId),
    Abort,
    Unreachable,
    Jump(MirBlockId),
    Switch(RegisterId, MirSwitchPackId, MirBlockId),
    Call(Option<RegisterId>, MirFunctionId, RegisterPackId),
    MakeHandler(
        RegisterId,
        MirHandlerDefinitionId,
        RegisterPackId
    ),
    MakeHandlerShared(
        RegisterId,
        MirHandlerDefinitionId,
        MirFunctionPackId,
        RegisterPackId
    ),
    Handle(RegisterId, RegisterId, RegisterId, RegisterPackId),
    Perform(
        Option<RegisterId>,
        MirProtocolId,
        u32,
        RegisterPackId
    ),
    Resume(RegisterId, RegisterId, u32, RegisterId),
    TailResume(RegisterId, u32, RegisterId),
    Cancel(RegisterId, RegisterId),
    Return(Option<RegisterId>)
}

pub enum MirPlaceRole {
    Definition,
    Read,
    Transfer,
    Destroy
}

impl Use<[0, *]> for MirPlaceRole {}

pub struct MirSwitchCase {
    key: Bytes,
    target: MirBlockId
}

pub struct MirSwitchPack { cases: Vec<MirSwitchCase> }

pub struct MirVariant {
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>
}

pub enum MirTypeKind {
    Pending,
    Tuple,
    Array,
    SharedReference,
    UniqueReference,
    Struct,
    Enum,
    Resumption
}

impl Use<[0, *]> for MirTypeKind {}

pub struct MirType {
    kind: MirTypeKind,
    name_index: u32,
    field_names: Vec<u32>,
    fields: Vec<ArtifactTypeId>,
    variants: Vec<MirVariant>,
    copy_flag: u32,
    effect_signature: MirSignature,
    resumption_lower: u32,
    resumption_upper: Option<u32>
}

struct MirTypeFacts {
    zero_sized: Bool,
    permits_zero_use: Bool
}

impl Use<[0, *]> for MirTypeFacts {}

pub type MirTypes = Arena<MirTypeTag, MirType>;

pub struct ArtifactTypeMap {
    entries: Vec<Option<ArtifactTypeId>>,
    copyable: Vec<Bool>
}

push_predefined_type_mappings(
    entries: &mut Vec<Option<ArtifactTypeId>>,
    copyable: &mut Vec<Bool>,
    raw: u32
) {
    if(raw < 19) {
        Vec::push(&mut *entries, Option::Some(Id::from_u32(raw)));
        Vec::push(&mut *copyable, raw != 1 and { raw < 17 });
        push_predefined_type_mappings(entries, copyable, raw + 1)
    } else { () }
}

pub artifact_type_map() -> ArtifactTypeMap {
    let entries = Vec::new();
    let copyable = Vec::new();
    push_predefined_type_mappings(&mut entries, &mut copyable, 0);
    ArtifactTypeMap { entries: entries, copyable: copyable }
}

extend_artifact_type_map(
    value: &mut ArtifactTypeMap,
    semantic_count: usize
) {
    if(Vec::len(&value.entries) < semantic_count) {
        Vec::push(&mut value.entries, None);
        Vec::push(&mut value.copyable, false);
        extend_artifact_type_map(value, semantic_count)
    } else { () }
}

pub mapped_artifact_type(
    value: &ArtifactTypeMap,
    semantic: TypeId
) -> Option<ArtifactTypeId> {
    let index = Id::to_usize(semantic);
    if(index < Vec::len(&value.entries)) {
        *Vec::index(&value.entries, index)
    } else { None }
}

pub bind_artifact_type(
    value: &mut ArtifactTypeMap,
    semantic_count: usize,
    semantic: TypeId,
    artifact: ArtifactTypeId
) {
    extend_artifact_type_map(value, semantic_count);
    *Vec::index_mut(
        &mut value.entries,
        Id::to_usize(semantic)
    ) = Option::Some(artifact);
    ()
}

pub set_mapped_type_copyable(
    value: &mut ArtifactTypeMap,
    semantic: TypeId,
    copyable: Bool
) {
    *Vec::index_mut(
        &mut value.copyable,
        Id::to_usize(semantic)
    ) = copyable;
    ()
}

pub mapped_type_copyable(
    value: &ArtifactTypeMap,
    semantic: TypeId
) -> Bool {
    *Vec::index(&value.copyable, Id::to_usize(semantic))
}

pub enum MirVariantView<'a> {
    Variant(
        u32,
        Slice<'a, u32>,
        Slice<'a, ArtifactTypeId>
    )
}

impl<'a> Use<[0, *]> for MirVariantView<'a> {}

pub struct RegisterPack { registers: Vec<RegisterId> }

pub struct MirFunctionPack { functions: Vec<MirFunctionId> }

pub struct MirCleanup {
    first_instruction: u32,
    end_instruction: u32,
    registers: Vec<RegisterId>
}

pub struct MirFunction {
    name: String,
    parameters: Vec<ArtifactTypeId>,
    result: ArtifactTypeId,
    outward_protocols: Vec<u32>,
    register_count: u32,
    instructions: Vec<MirInstruction>,
    cleanups: Vec<MirCleanup>,
    register_packs: Arena<RegisterPackTag, RegisterPack>,
    function_packs: Arena<MirFunctionPackTag, MirFunctionPack>,
    blocks: Arena<MirBlockTag, Option<u32>>,
    switch_packs: Arena<MirSwitchPackTag, MirSwitchPack>
}

pub struct MirProgram {
    functions: Arena<MirFunctionTag, MirFunction>,
    constants: Arena<MirConstantTag, Vec<u8>>,
    types: MirTypes,
    type_facts: Vec<MirTypeFacts>,
    type_names: Vec<String>,
    protocols: Arena<MirProtocolTag, MirProtocol>,
    handler_definitions:
        Arena<MirHandlerDefinitionTag, MirHandlerDefinition>
}

__g1_walk_mir_register_pack<L, R, F, e: EffectRow>(
    function: &MirFunction,
    instruction: usize,
    pack: RegisterPackId,
    role: MirPlaceRole,
    index: usize,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(usize, RegisterId, MirPlaceRole, L), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    let registers = mir_function_register_pack(function, pack);
    if(index < usize_from_u32(register_pack_count(registers))) {
        visitor(instruction, register_pack_at(registers, index), role, stop);
        __g1_walk_mir_register_pack(
            function, instruction, pack, role, index + 1, stop, visitor
        )
    } else { () }
}

__g1_walk_mir_instruction_places<L, R, F, e: EffectRow>(
    function: &MirFunction,
    instruction: usize,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(usize, RegisterId, MirPlaceRole, L), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    let value = mir_function_instruction_at(function, instruction);
    handle *value {
        MirInstruction::Const(target, _) =>
            visitor(instruction, target, MirPlaceRole::Definition, stop),
        MirInstruction::Move(target, source) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            visitor(instruction, source, MirPlaceRole::Transfer, stop)
        },
        MirInstruction::Copy(target, source) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            visitor(instruction, source, MirPlaceRole::Read, stop)
        },
        MirInstruction::Construct(target, _, _, pack) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            __g1_walk_mir_register_pack(
                function,
                instruction,
                pack,
                MirPlaceRole::Transfer,
                0,
                stop,
                visitor
            )
        },
        MirInstruction::ProjectMove(target, source, _) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            visitor(instruction, source, MirPlaceRole::Transfer, stop)
        },
        MirInstruction::ProjectCopy(target, source, _) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            visitor(instruction, source, MirPlaceRole::Read, stop)
        },
        MirInstruction::EnumTag(target, source) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            visitor(instruction, source, MirPlaceRole::Read, stop)
        },
        MirInstruction::Drop(register) =>
            visitor(instruction, register, MirPlaceRole::Destroy, stop),
        MirInstruction::Deconstruct(register) =>
            visitor(instruction, register, MirPlaceRole::Destroy, stop),
        MirInstruction::Primitive(target, _, pack) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            __g1_walk_mir_register_pack(
                function,
                instruction,
                pack,
                MirPlaceRole::Transfer,
                0,
                stop,
                visitor
            )
        },
        MirInstruction::HostCall(target, _, pack) => {
            handle target {
                None => (),
                Option::Some(found) => visitor(
                    instruction, found, MirPlaceRole::Definition, stop
                )
            };
            __g1_walk_mir_register_pack(
                function,
                instruction,
                pack,
                MirPlaceRole::Transfer,
                0,
                stop,
                visitor
            )
        },
        MirInstruction::Abort => (),
        MirInstruction::Unreachable => (),
        MirInstruction::Switch(register, _, _) =>
            visitor(instruction, register, MirPlaceRole::Read, stop),
        MirInstruction::Call(target, _, pack) => {
            handle target {
                None => (),
                Option::Some(found) => visitor(
                    instruction, found, MirPlaceRole::Definition, stop
                )
            };
            __g1_walk_mir_register_pack(
                function,
                instruction,
                pack,
                MirPlaceRole::Transfer,
                0,
                stop,
                visitor
            )
        },
        MirInstruction::MakeHandler(target, _, clauses) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            __g1_walk_mir_register_pack(
                function, instruction, clauses,
                MirPlaceRole::Transfer, 0, stop, visitor
            )
        },
        MirInstruction::MakeHandlerShared(target, _, _, captures) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            __g1_walk_mir_register_pack(
                function, instruction, captures,
                MirPlaceRole::Transfer, 0, stop, visitor
            )
        },
        MirInstruction::Handle(target, handler, body, arguments) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            visitor(instruction, handler, MirPlaceRole::Transfer, stop);
            visitor(instruction, body, MirPlaceRole::Transfer, stop);
            __g1_walk_mir_register_pack(
                function, instruction, arguments,
                MirPlaceRole::Transfer, 0, stop, visitor
            )
        },
        MirInstruction::Perform(target, _, _, payloads) => {
            handle target {
                None => (),
                Option::Some(found) => visitor(
                    instruction, found, MirPlaceRole::Definition, stop
                )
            };
            __g1_walk_mir_register_pack(
                function, instruction, payloads,
                MirPlaceRole::Transfer, 0, stop, visitor
            )
        },
        MirInstruction::Resume(target, resumption, _, resumed) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            visitor(instruction, resumption, MirPlaceRole::Transfer, stop);
            visitor(instruction, resumed, MirPlaceRole::Transfer, stop)
        },
        MirInstruction::TailResume(resumption, _, resumed) => {
            visitor(instruction, resumption, MirPlaceRole::Transfer, stop);
            visitor(instruction, resumed, MirPlaceRole::Transfer, stop)
        },
        MirInstruction::Cancel(target, resumption) => {
            visitor(instruction, target, MirPlaceRole::Definition, stop);
            visitor(instruction, resumption, MirPlaceRole::Transfer, stop)
        },
        MirInstruction::Return(source) => handle source {
            None => (),
            Option::Some(found) => visitor(
                instruction, found, MirPlaceRole::Transfer, stop
            )
        },
        _ => ()
    }
}

__g1_walk_mir_places<L, R, F, e: EffectRow>(
    function: &MirFunction,
    instruction: usize,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(usize, RegisterId, MirPlaceRole, L), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    if(instruction < mir_function_instruction_count(function)) {
        __g1_walk_mir_instruction_places(function, instruction, stop, visitor);
        __g1_walk_mir_places(function, instruction + 1, stop, visitor)
    } else { () }
}

pub walk_mir_places<L, R, F, e: EffectRow>(
    function: &MirFunction,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(usize, RegisterId, MirPlaceRole, L), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    __g1_walk_mir_places(function, 0, stop, visitor)
}

pub walk_mir_operands<L, R, F, e: EffectRow>(
    function: &MirFunction,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(usize, RegisterId, L), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    walk_mir_places(function, stop, {
        instruction, register, role, destination => handle role {
            MirPlaceRole::Definition => (),
            _ => visitor(instruction, register, destination)
        }
    })
}

__g1_mir_cfg_block_end(
    function: &MirFunction,
    start: usize,
    index: usize,
    end: usize
) -> usize {
    handle index < Arena::len(&function.blocks) {
      Result::Ok(_) => {
        let candidate = handle *Arena::index(
            &function.blocks,
            Id::from_u32(checked_u32(index))
        ) {
            None => end,
            Option::Some(offset) => usize_from_u32(offset)
        };
        let next = handle start < candidate {
            Result::Err(_) => end,
            Result::Ok(_) => handle candidate < end {
                Result::Ok(_) => candidate,
                Result::Err(_) => end
            }
        };
        __g1_mir_cfg_block_end(function, start, index + 1, next)
      },
      Result::Err(_) => end
    }
}

__g1_push_cfg_switch(
    pack: &MirSwitchPack,
    index: usize,
    pending: &mut Stack<MirBlockId>
) {
    handle index < mir_switch_pack_count(pack) {
      Result::Ok(_) => {
        Stack::push(
            &mut *pending,
            mir_switch_case_target(mir_switch_pack_at(pack, index)),
        );
        __g1_push_cfg_switch(pack, index + 1, pending)
      },
      Result::Err(_) => ()
    }
}

__g1_push_cfg_successors(
    function: &MirFunction,
    block: MirBlockId,
    pending: &mut Stack<MirBlockId>
) {
    let start = usize_from_u32(mir_function_block_offset(function, block));
    let end = __g1_mir_cfg_block_end(
        function,
        start,
        0,
        mir_function_instruction_count(function)
    );
    handle start < end {
      Result::Ok(_) => {
        let terminator = mir_function_instruction_at(function, end - 1);
        handle *terminator {
          MirInstruction::Jump(target) =>
              Stack::push(&mut *pending, target),
          MirInstruction::Switch(_, pack, otherwise) => {
              Stack::push(&mut *pending, otherwise);
              __g1_push_cfg_switch(
                mir_function_switch_pack(function, pack),
                0,
                pending
              )
          },
          _ => ()
        }
      },
      Result::Err(_) => ()
    }
}

__g1_empty_cfg_visited() -> Vec<Bool> { Vec::new() }

__g1_empty_cfg_pending() -> Stack<MirBlockId> { Stack::new() }

struct __CfgWalkState {
    pending: Stack<MirBlockId>,
    visited: Vec<Bool>
}

__g1_walk_cfg_loop<L, R, F, e: EffectRow>(
    function: &MirFunction,
    state: __CfgWalkState,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(MirBlockId, u32, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    let __CfgWalkState { pending, visited } = move state;
    handle Stack::pop(&mut pending) {
        Result::Err(_) => { pending; visited; () },
        Result::Ok(block) => {
            let index = Id::to_usize(block);
            handle *Vec::index(&visited, index) {
                Result::Ok(_) => (),
                Result::Err(_) => {
                    *Vec::index_mut(&mut visited, index) = true;
                    let offset = mir_function_block_offset(function, block);
                    handle visitor(block, offset, stop) {
                        Visit::Descend => __g1_push_cfg_successors(
                            function, block, &mut pending
                        ),
                        Visit::SkipChildren => ()
                    }
                }
            };
            __g1_walk_cfg_loop(
                function,
                __CfgWalkState {
                    pending: move pending,
                    visited: move visited
                },
                stop,
                visitor
            )
        }
    }
}

__g1_push_cfg_visited(output: &mut Vec<Bool>, remaining: usize) {
    handle remaining == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            Vec::push(&mut *output, false);
            __g1_push_cfg_visited(output, remaining - 1)
        }
    }
}

pub walk_cfg<L, R, F, e: EffectRow>(
    function: &MirFunction,
    entry: MirBlockId,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(MirBlockId, u32, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    let visited = __g1_empty_cfg_visited();
    let pending = __g1_empty_cfg_pending();
    __g1_push_cfg_visited(&mut visited, Arena::len(&function.blocks));
    Stack::push(&mut pending, entry);
    __g1_walk_cfg_loop(
        function,
        __CfgWalkState { pending: pending, visited: visited },
        stop,
        visitor
    )
}

pub enum LoweringError {
    UnsupportedScalar(TypeId),
    MissingLocal(CoreLocalId),
    MissingProjectionSource(CoreValueId),
    MissingValue(CoreValueId),
    UnknownCallable(ShellId),
    InvalidConstructionType(TypeId),
    ConstructionFieldCount(TypeId, u32, u32),
    UnexpectedVariant(TypeId, u32),
    MissingVariant(TypeId),
    VariantOutOfRange(TypeId, u32),
    ConstructionFieldOrder(u32, u32),
    MissingResult(TypeId),
    MissingMatchSubject(CoreValueId),
    MissingMatchResult(CoreComputationId),
    InvalidMatchType(TypeId),
    MatchBindingCount(TypeId, u32, u32),
    MissingMatchFlow(CoreComputationId),
    MatchStateMismatch,
    MirCleanupCount(u32, u32),
    InvalidMirCleanup(u32),
    InvalidMirRegister(RegisterId),
    UnboundMirBlock(MirBlockId),
    InvalidMirRegisterPack(RegisterPackId),
    InvalidMirSwitchPack(MirSwitchPackId),
    InvalidMirFunction(MirFunctionId),
    // Typed Core can retain effect control before MIR learns its one-shot
    // cleanup semantics. Reject it here rather than emitting ordinary calls.
    EffectControlNotLowered(CoreComputationId)
}

invalid_mir_register_result(
    register: RegisterId
) -> Result<(), LoweringError> {
    Result::Err(LoweringError::InvalidMirRegister(register))
}

unbound_mir_block_result(
    block: MirBlockId
) -> Result<(), LoweringError> {
    Result::Err(LoweringError::UnboundMirBlock(block))
}

validate_final_mir_definitions(
    value: &MirFunction
) -> Result<(), LoweringError> {
    let register_count = mir_function_register_count(value);
    walk_mir_places(value, @validate_final_mir_definitions, {
        _, register, role, invalid => {
            handle role {
                MirPlaceRole::Definition => handle
                    Id::to_u32(register) < register_count {
                    Result::Ok(_) => (),
                    Result::Err(_) =>
                        invalid(invalid_mir_register_result(register))
                },
                _ => ()
            }
        }
    });
    Result::Ok(())
}

validate_final_mir_operands(
    value: &MirFunction
) -> Result<(), LoweringError> {
    let register_count = mir_function_register_count(value);
    walk_mir_operands(value, @validate_final_mir_operands, {
        _, register, invalid => {
            handle Id::to_u32(register) < register_count {
                Result::Ok(_) => (),
                Result::Err(_) =>
                    invalid(invalid_mir_register_result(register))
            }
        }
    });
    Result::Ok(())
}

validate_final_mir_cfg(
    value: &MirFunction
) -> Result<(), LoweringError> {
    handle Arena::len(&value.blocks) == 0 {
        Result::Ok(_) => (),
        Result::Err(_) => {
            let instruction_count = checked_u32(
                mir_function_instruction_count(value)
            );
            walk_cfg(
                value,
                Id::from_u32(0),
                @validate_final_mir_cfg,
                { block, offset, invalid => {
                    handle offset <= instruction_count {
                        Result::Ok(_) => Visit::Descend,
                        Result::Err(_) =>
                            invalid(unbound_mir_block_result(block))
                    }
                }}
            )
        }
    };
    Result::Ok(())
}

validate_final_mir_walkers(
    value: &MirFunction
) -> Result<(), LoweringError> {
    try(validate_final_mir_definitions(
        value
    ), @validate_final_mir_walkers);
    try(validate_final_mir_operands(
        value
    ), @validate_final_mir_walkers);
    validate_final_mir_cfg(value)
}

struct MatchFlow {
    computation: CoreComputationId,
    live_out: Vec<Bool>
}

struct PlaceFlowFacts {
    final_transfers: IndexVec<CoreValueTag, Bool>,
    matches: Vec<MatchFlow>
}

struct MirBuilder<'a> {
    type_map: &'a ArtifactTypeMap,
    locals: Vec<Option<RegisterId>>,
    place_flow: PlaceFlowFacts,
    live_order: Vec<RegisterId>,
    instructions: Vec<MirInstruction>,
    cleanups: Vec<MirCleanup>,
    register_packs: Arena<RegisterPackTag, RegisterPack>,
    blocks: Arena<MirBlockTag, Option<u32>>,
    switch_packs: Arena<MirSwitchPackTag, MirSwitchPack>,
    register_count: u32
}

pub mir_program_function_count(value: &MirProgram) -> usize {
    Arena::len(&value.functions)
}

pub mir_program_protocol_count(value: &MirProgram) -> usize {
    Arena::len(&value.protocols)
}

