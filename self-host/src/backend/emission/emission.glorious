// Canonical assembly of straight-line MIR bytecode into GRBC sections.

use super::lowering::MirInstruction;
use super::lowering::MirTypeKind;
use super::lowering::MirVariantView;

enum Opcode {
    Constant,
    Move,
    Copy,
    Construct,
    ProjectMove,
    ProjectCopy,
    EnumTag,
    Drop,
    Deconstruct,
    Primitive,
    HostCall,
    Abort,
    Unreachable,
    Jump,
    Switch,
    Call,
    MakeHandler,
    MakeHandlerShared,
    Handle,
    Perform,
    Resume,
    TailResume,
    Cancel,
    Return
}

struct OpcodeSpec {
    code: u32,
    operand_words: u32
}

opcode_spec(opcode: Opcode) -> OpcodeSpec {
    handle opcode {
        Opcode::Constant => OpcodeSpec { code: 1, operand_words: 2 },
        Opcode::Move => OpcodeSpec { code: 2, operand_words: 2 },
        Opcode::Copy => OpcodeSpec { code: 3, operand_words: 2 },
        Opcode::Construct => OpcodeSpec { code: 9, operand_words: 5 },
        Opcode::ProjectMove => OpcodeSpec { code: 10, operand_words: 3 },
        Opcode::ProjectCopy => OpcodeSpec { code: 11, operand_words: 3 },
        Opcode::EnumTag => OpcodeSpec { code: 14, operand_words: 2 },
        Opcode::Drop => OpcodeSpec { code: 17, operand_words: 1 },
        Opcode::Deconstruct => OpcodeSpec { code: 19, operand_words: 1 },
        Opcode::Primitive => OpcodeSpec { code: 69, operand_words: 4 },
        Opcode::HostCall => OpcodeSpec { code: 68, operand_words: 4 },
        Opcode::Abort => OpcodeSpec { code: 70, operand_words: 1 },
        Opcode::Unreachable => OpcodeSpec { code: 39, operand_words: 0 },
        Opcode::Jump => OpcodeSpec { code: 32, operand_words: 1 },
        Opcode::Switch => OpcodeSpec { code: 33, operand_words: 4 },
        Opcode::Call => OpcodeSpec { code: 34, operand_words: 4 },
        Opcode::MakeHandler => OpcodeSpec { code: 16, operand_words: 4 },
        Opcode::MakeHandlerShared => OpcodeSpec { code: 71, operand_words: 6 },
        Opcode::Handle => OpcodeSpec { code: 64, operand_words: 5 },
        Opcode::Perform => OpcodeSpec { code: 65, operand_words: 5 },
        Opcode::Resume => OpcodeSpec { code: 66, operand_words: 4 },
        Opcode::TailResume => OpcodeSpec { code: 72, operand_words: 3 },
        Opcode::Cancel => OpcodeSpec { code: 67, operand_words: 2 },
        Opcode::Return => OpcodeSpec { code: 38, operand_words: 1 }
    }
}

write_opcode(output: &mut ByteBuf, opcode: Opcode) {
    let spec = opcode_spec(opcode);
    ByteBuf::write_u32_le(
        output,
        bit_or(spec.code, shift_left(spec.operand_words, 12))
    )
}

struct CanonicalPool<K> {
    values: Vec<K>,
    ids: HashMap<K, u32>
}

index_canonical_values<K>(
    values: &Vec<K>,
    ids: &mut HashMap<K, u32>,
    index: usize
) where K: Eq,
K: Hash,
K: Use<[0, *]> {
    for_range(Range::new(index, Vec::len(values)), { current => {
        let previous = HashMap::insert(
            &mut *ids,
            *Vec::index(values, current),
            checked_u32(current)
        );
        handle previous {
            Result::Err(_) => (),
            Result::Ok(_) => unreachable()
        }
    } })
}

freeze_canonical_pool<K>(values: Vec<K>) -> CanonicalPool<K> where K: Ord,
K: Eq,
K: Hash,
K: Use<[0, *]> {
    let values = values;
    Vec::sort(&mut values);
    Vec::dedup(&mut values);
    let ids = HashMap::new();
    index_canonical_values(&values, &mut ids, 0);
    CanonicalPool { values: values, ids: ids }
}

index_stable_values<K>(
    values: &Vec<K>,
    unique: &mut Vec<K>,
    ids: &mut HashMap<K, u32>,
    index: usize
) where K: Eq,
K: Hash,
K: Use<[0, *]> {
    for_range(Range::new(index, Vec::len(values)), { current => {
        let key = Vec::index(values, current);
        if(HashMap::contains_key(&*ids, key)) {
            ()
        } else {
            let id = checked_u32(Vec::len(&*unique));
            let previous = HashMap::insert(&mut *ids, *key, id);
            handle previous {
                Result::Err(_) => (),
                Result::Ok(_) => unreachable()
            };
            Vec::push(&mut *unique, *key)
        }
    } })
}

freeze_stable_pool<K>(values: Vec<K>) -> CanonicalPool<K> where K: Eq,
K: Hash,
K: Use<[0, *]> {
    let unique = Vec::new();
    let ids = HashMap::new();
    index_stable_values(&values, &mut unique, &mut ids, 0);
    CanonicalPool { values: unique, ids: ids }
}

canonical_id<K>(value: &CanonicalPool<K>, key: &K) -> Option<u32> where K: Eq,
K: Hash {
    handle HashMap::get(&value.ids, key) {
        Result::Err(_) => None,
        Result::Ok(found) => Option::Some(*found)
    }
}

canonical_bytes_id(
    value: &CanonicalPool<Bytes>,
    key: &Bytes
) -> Option<u32> {
    canonical_id(value, key)
}

struct FunctionSpans {
    code_start: u32,
    code_length: u32,
    cleanup_start: u32,
    cleanup_count: u32
}

struct EmissionContext<'a> {
    program: &'a super::lowering::MirProgram,
    names: CanonicalPool<String>,
    signatures: CanonicalPool<Bytes>,
    constants: CanonicalPool<Bytes>,
    operands: Vec<u32>,
    spans: Vec<FunctionSpans>,
    writer: super::artifact::ArtifactWriter
}

pub enum EmissionError {
    MissingConstant(super::lowering::RegisterId),
    MissingSwitchConstant(
        super::lowering::MirSwitchPackId,
        usize
    ),
    UnsupportedInstruction,
    MissingName(EmissionName),
    MissingSignature(super::lowering::MirFunctionId),
    StructFieldNameCount(
        super::lowering::MirTypeId,
        usize,
        usize
    ),
    VariantFieldNameCount(
        super::lowering::MirTypeId,
        usize,
        usize,
        usize
    ),
    // Retained as a diagnostic compatibility case until MIR cleanup anchors
    // are remapped across dead-function elimination. MirType construction
    // itself cannot produce an unsupported semantic kind.
    UnsupportedType(super::lowering::MirTypeId, u8),
    InvalidProtocol(u32, ProtocolValidationError),
    InvalidHandlerDefinition(u32, HandlerValidationError),
    InvalidEffectInstruction(
        super::lowering::MirFunctionId,
        u32,
        EffectInstructionValidationError
    ),
    ArtifactWrite(super::artifact::ArtifactWriteError)
}

pub enum ProtocolValidationError {
    CanonicalOrder,
    Signature,
    ResultType,
    TerminalContract,
    Quantity,
    TypeArgument
}

pub enum HandlerValidationError {
    ResultType,
    UnknownProtocol,
    UnknownOperation,
    DuplicateClause,
    CallableSignature,
    TerminalResumption,
    ResumptionTypeUnavailable
}

pub enum EffectInstructionValidationError {
    UnknownHandler,
    ClauseCount,
    SharedClauseFunctions,
    UnknownProtocol,
    UnknownOperation,
    PerformContract,
    TailResumeControl,
    ReceiverMode,
    FunctionEffectRow
}

pub enum EmissionName {
    Type(super::lowering::MirTypeId),
    StructField(super::lowering::MirTypeId, usize),
    Variant(super::lowering::MirTypeId, usize),
    VariantField(super::lowering::MirTypeId, usize, usize),
    Function(super::lowering::MirFunctionId),
    HostCapability(u32),
    HostSymbol(u32)
}

require_program_name(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    name_index: u32,
    origin: EmissionName
) -> Result<u32, EmissionError> {
    require_name_value(
        names,
        *super::lowering::mir_program_type_name_at(
            program,
            usize_from_u32(name_index)
        ),
        origin
    )
}

checked_u32(value: usize) -> u32 {
    handle checked_usize_to_u32(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

usize_from_u32(value: u32) -> usize {
    wrapping_convert_to_usize(value)
}

slice_at<'a, T>(value: Slice<'a, T>, index: usize) -> &'a T {
    handle Slice::get(value, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

copy_bytes_after(
    source: &Vec<u8>,
    index: usize,
    output: &mut Vec<u8>
) {
    for_range(Range::new(index, Vec::len(source)), { current =>
        Vec::push(&mut *output, *Vec::index(source, current))
    })
}

constant_records(
    constants: &CanonicalPool<Bytes>,
    index: usize,
    output: &mut Vec<super::artifact::Record>
) {
    for_range(Range::new(
        index,
        Vec::len(&constants.values)
    ), { current => {
        let key = Bytes::to_vec(*Vec::index(&constants.values, current));
        let payload = Vec::new();
        copy_bytes_after(&key, 1, &mut payload);
        Vec::push(
            &mut *output,
            super::artifact::record(
                *Vec::index(&key, 0),
                0,
                Bytes::from_vec(payload)
            )
        )
    } })
}

collect_constant_values(
    program: &super::lowering::MirProgram,
    index: usize,
    output: &mut Vec<Bytes>
) {
    for_range(Range::new(
        index,
        super::lowering::mir_program_constant_count(program)
    ), { current => {
        let key = Vec::new();
        copy_bytes_after(
            super::lowering::mir_program_constant_at(
                program,
                super::lowering::mir_constant_id_from_usize(current)
            ),
            0,
            &mut key
        );
        Vec::push(
            &mut *output,
            Bytes::from_vec(key)
        )
    } })
}

collect_names(
    program: &super::lowering::MirProgram,
    index: usize,
    output: &mut Vec<String>
) {
    let end = super::lowering::mir_program_function_count(program);
    for_range(Range::new(index, end), { current =>
        Vec::push(
            &mut *output,
            *super::lowering::mir_function_name(
                super::lowering::mir_program_function_at(
                    program,
                    super::lowering::mir_function_id_from_usize(current)
                )
            )
        )
    })
}

collect_operation_names(
    protocol: &super::lowering::MirProtocol,
    index: usize,
    output: &mut Vec<String>
) {
    for_range(Range::new(
        index,
        super::lowering::mir_protocol_operation_count(protocol)
    ), { current =>
        Vec::push(
            &mut *output,
            *super::lowering::mir_operation_name(
                super::lowering::mir_protocol_operation_at(protocol, current)
            )
        )
    })
}

collect_protocol_names(
    program: &super::lowering::MirProgram,
    index: usize,
    output: &mut Vec<String>
) {
    for_range(Range::new(
        index,
        super::lowering::mir_program_protocol_count(program)
    ), { current => {
        let protocol = super::lowering::mir_program_protocol_at(
            program, Id::from_u32(checked_u32(current))
        );
        Vec::push(
            &mut *output,
            *super::lowering::mir_protocol_display_name(protocol)
        );
        collect_operation_names(protocol, 0, output)
    } })
}

host_import_count(program: &super::lowering::MirProgram) -> u32 {
    handle super::lowering::mir_program_host_function(program, 0, 0) {
        None => 0,
        Option::Some(_) => 4
    }
}

collect_host_names(
    program: &super::lowering::MirProgram,
    output: &mut Vec<String>
) {
    if(host_import_count(program) == 0) { () } else {
        Vec::push(&mut *output, "diagnostic");
        Vec::push(&mut *output, "write");
        Vec::push(&mut *output, "fs.read");
        Vec::push(&mut *output, "read");
        Vec::push(&mut *output, "fs.write");
        Vec::push(&mut *output, "write");
        Vec::push(&mut *output, "process.args");
        Vec::push(&mut *output, "get")
    }
}

collect_stage_field_names<'a>(
    program: &super::lowering::MirProgram,
    field_names: Slice<'a, u32>,
    index: usize,
    output: &mut Vec<String>
) {
    let end = Slice::len(field_names);
    for_range(Range::new(index, end), { current =>
        Vec::push(
            &mut *output,
            *super::lowering::mir_program_type_name_at(
                program,
                usize_from_u32(*slice_at(field_names, current))
            )
        )
    })
}

collect_mir_variant_names<'a>(
    program: &super::lowering::MirProgram,
    variants: Slice<'a, super::lowering::MirVariant>,
    index: usize,
    output: &mut Vec<String>
) {
    let end = Slice::len(variants);
    for_range(Range::new(index, end), { current =>
        handle super::lowering::mir_variant_view(
            slice_at(variants, current)
        ) {
            super::lowering::MirVariantView::Variant(
                name_index,
                field_names,
                _
            ) => {
                Vec::push(
                    &mut *output,
                    *super::lowering::mir_program_type_name_at(
                        program,
                        usize_from_u32(name_index)
                    )
                );
                collect_stage_field_names(
                    program,
                    field_names,
                    0,
                    output
                )
            }
        }
    })
}

collect_type_names(
    program: &super::lowering::MirProgram,
    index: usize,
    output: &mut Vec<String>
) {
    let end = super::lowering::mir_program_type_count(program);
    for_range(Range::new(index, end), { current => {
        let type_id = super::lowering::mir_type_id_from_usize(current);
        handle super::lowering::mir_program_type_kind(program, type_id) {
            MirTypeKind::Pending => (),
            MirTypeKind::Tuple => (),
            MirTypeKind::Array => (),
            MirTypeKind::SharedReference => (),
            MirTypeKind::UniqueReference => (),
            MirTypeKind::Struct => {
                let name_index =
                    super::lowering::mir_program_struct_name(program, type_id);
                Vec::push(
                    &mut *output,
                    *super::lowering::mir_program_type_name_at(
                        program,
                        usize_from_u32(name_index)
                    )
                );
                collect_stage_field_names(
                    program,
                    super::lowering::mir_program_struct_field_names(
                        program,
                        type_id
                    ),
                    0,
                    output
                )
            },
            MirTypeKind::Enum => {
                let name_index =
                    super::lowering::mir_program_enum_name(program, type_id);
                Vec::push(
                    &mut *output,
                    *super::lowering::mir_program_type_name_at(
                        program,
                        usize_from_u32(name_index)
                    )
                );
                collect_mir_variant_names(
                    program,
                    super::lowering::mir_program_enum_variants(
                        program,
                        type_id
                    ),
                    0,
                    output
                )
            }
        }
    } })
}

unary_structural_type_record(
    program: &super::lowering::MirProgram,
    index: usize,
    tag: u8,
    element: super::lowering::ArtifactTypeId,
    copy_flag: u32
) -> super::artifact::Record {
    let payload = ByteBuf::new();
    ByteBuf::write_u32_le(
        &mut payload,
        super::lowering::artifact_type_raw(element)
    );
    super::artifact::record(
        tag,
        wrapping_convert_to_u8(custom_type_flags(
            program, index, copy_flag
        )),
        ByteBuf::finish(payload)
    )
}

write_type_fields<'a>(
    output: &mut ByteBuf,
    fields: Slice<'a, super::lowering::ArtifactTypeId>,
    field_index: usize
) {
    let end = Slice::len(fields);
    for_range(Range::new(field_index, end), { current =>
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::artifact_type_raw(
                *slice_at(fields, current)
            )
        )
    })
}

write_named_type_fields<'a>(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    type_id: super::lowering::MirTypeId,
    field_names: Slice<'a, u32>,
    fields: Slice<'a, super::lowering::ArtifactTypeId>,
    field_index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    let end = Slice::len(fields);
    try_for_range(Range::new(field_index, end), { current => {
        let field_name = try(require_program_name(
            program,
            names,
            *slice_at(field_names, current),
            EmissionName::StructField(type_id, current)
        ), @write_named_type_fields);
        ByteBuf::write_u32_le(&mut *output, field_name);
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::artifact_type_raw(
                *slice_at(fields, current)
            )
        );
        Result::Ok(())
    } })
}

custom_type_flags(
    program: &super::lowering::MirProgram,
    index: usize,
    copy_flag: u32
) -> u32 {
    let type_id = super::lowering::mir_type_id_from_usize(index);
    copy_flag
        + super::lowering::mir_program_type_zero_sized_flag(
            program,
            type_id
        )
        + super::lowering::mir_program_type_zero_use_flag(program, type_id)
}

tuple_type_record<'a>(
    program: &super::lowering::MirProgram,
    index: usize,
    fields: Slice<'a, super::lowering::ArtifactTypeId>,
    copy_flag: u32
) -> super::artifact::Record {
    let payload = ByteBuf::new();
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(Slice::len(fields))
    );
    write_type_fields(&mut payload, fields, 0);
    super::artifact::record(
        32,
        wrapping_convert_to_u8(custom_type_flags(program, index, copy_flag)),
        ByteBuf::finish(payload)
    )
}

valid_struct_type_record<'a>(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    index: usize,
    name_index: u32,
    field_names: Slice<'a, u32>,
    fields: Slice<'a, super::lowering::ArtifactTypeId>,
    copy_flag: u32
) -> Result<super::artifact::Record, EmissionError> {
    let mir_type_id = super::lowering::mir_type_id_from_usize(index);
    let type_name = try(require_program_name(
        program,
        names,
        name_index,
        EmissionName::Type(mir_type_id)
    ), @valid_struct_type_record);
    let payload = ByteBuf::new();
    ByteBuf::write_u32_le(&mut payload, type_name);
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(Slice::len(fields))
    );
    try(write_named_type_fields(
        program,
        names,
        mir_type_id,
        field_names,
        fields,
        0,
        &mut payload
    ), @valid_struct_type_record);
    let payload_bytes = ByteBuf::finish( payload);
    Result::Ok(super::artifact::record(
        34,
        wrapping_convert_to_u8(custom_type_flags(program, index, copy_flag)),
        payload_bytes
    ))
}

struct_type_record<'a>(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    index: usize,
    name_index: u32,
    field_names: Slice<'a, u32>,
    fields: Slice<'a, super::lowering::ArtifactTypeId>,
    copy_flag: u32
) -> Result<super::artifact::Record, EmissionError> {
    if(Slice::len(field_names) == Slice::len(fields)) {
        valid_struct_type_record(
            program,
            names,
            index,
            name_index,
            field_names,
            fields,
            copy_flag
        )
    } else {
        Result::Err(EmissionError::StructFieldNameCount(
            super::lowering::mir_type_id_from_usize(index),
            Slice::len(fields),
            Slice::len(field_names)
        ))
    }
}

write_enum_variant_fields<'a>(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    type_id: super::lowering::MirTypeId,
    variant_index: usize,
    field_names: Slice<'a, u32>,
    fields: Slice<'a, super::lowering::ArtifactTypeId>,
    index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    let end = Slice::len(fields);
    try_for_range(Range::new(index, end), { current => {
        let field_name = try(require_program_name(
            program,
            names,
            *slice_at(field_names, current),
            EmissionName::VariantField(
                type_id,
                variant_index,
                current
            )
        ), @write_enum_variant_fields);
        ByteBuf::write_u32_le(&mut *output, field_name);
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::artifact_type_raw(
                *slice_at(fields, current)
            )
        );
        Result::Ok(())
    } })
}

write_enum_variants<'a>(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    type_id: super::lowering::MirTypeId,
    variants: Slice<'a, super::lowering::MirVariant>,
    index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    try_for_range(Range::new(index, Slice::len(variants)), { current => {
        handle super::lowering::mir_variant_view(
            slice_at(variants, current)
        ) {
            super::lowering::MirVariantView::Variant(
                name_index,
                field_names,
                fields
            ) => if(Slice::len(field_names) == Slice::len(fields)) {
                let variant_name = try(require_program_name(
                    program,
                    names,
                    name_index,
                    EmissionName::Variant(type_id, current)
                ), @write_enum_variants);
                ByteBuf::write_u32_le(&mut *output, variant_name);
                ByteBuf::write_u32_le(
                    &mut *output,
                    checked_u32(Slice::len(fields))
                );
                try(write_enum_variant_fields(
                    program,
                    names,
                    type_id,
                    current,
                    field_names,
                    fields,
                    0,
                    output
                ), @write_enum_variants);
                Result::Ok(())
            } else {
                Result::Err(EmissionError::VariantFieldNameCount(
                    type_id,
                    current,
                    Slice::len(fields),
                    Slice::len(field_names)
                ))
            }
        }
    } })
}

enum_type_record<'a>(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    index: usize,
    name_index: u32,
    variants: Slice<'a, super::lowering::MirVariant>,
    copy_flag: u32
) -> Result<super::artifact::Record, EmissionError> {
    let mir_type_id = super::lowering::mir_type_id_from_usize(index);
    let type_name = try(require_program_name(
        program,
        names,
        name_index,
        EmissionName::Type(mir_type_id)
    ), @enum_type_record);
    let payload = ByteBuf::new();
    ByteBuf::write_u32_le(&mut payload, type_name);
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(Slice::len(variants))
    );
    try(write_enum_variants(
        program,
        names,
        mir_type_id,
        variants,
        0,
        &mut payload
    ), @enum_type_record);
    Result::Ok(super::artifact::record(
        35,
        wrapping_convert_to_u8(custom_type_flags(program, index, copy_flag)),
        ByteBuf::finish(payload)
    ))
}

custom_type_record(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    index: usize
) -> Result<super::artifact::Record, EmissionError> {
    let mir_type = super::lowering::mir_type_id_from_usize(index);
    let copy_flag =
        super::lowering::mir_program_type_copy_flag(program, mir_type);
    handle super::lowering::mir_program_type_kind(program, mir_type) {
        MirTypeKind::Pending => Result::Err(
            EmissionError::UnsupportedType(mir_type, 0)
        ),
        MirTypeKind::Tuple =>
            Result::Ok(tuple_type_record(
                program,
                index,
                super::lowering::mir_program_tuple_fields(
                    program,
                    mir_type
                ),
                copy_flag
            )),
        MirTypeKind::Array => Result::Ok(unary_structural_type_record(
            program,
            index,
            33,
            super::lowering::mir_program_unary_element(program, mir_type),
            copy_flag
        )),
        MirTypeKind::SharedReference => Result::Ok(
            unary_structural_type_record(
                program,
                index,
                36,
                super::lowering::mir_program_unary_element(program, mir_type),
                copy_flag
            )
        ),
        MirTypeKind::UniqueReference => Result::Ok(
            unary_structural_type_record(
                program,
                index,
                37,
                super::lowering::mir_program_unary_element(program, mir_type),
                copy_flag
            )
        ),
        MirTypeKind::Struct => struct_type_record(
            program,
            names,
            index,
            super::lowering::mir_program_struct_name(program, mir_type),
            super::lowering::mir_program_struct_field_names(
                program,
                mir_type
            ),
            super::lowering::mir_program_struct_fields(program, mir_type),
            copy_flag
        ),
        MirTypeKind::Enum => enum_type_record(
            program,
            names,
            index,
            super::lowering::mir_program_enum_name(program, mir_type),
            super::lowering::mir_program_enum_variants(program, mir_type),
            copy_flag
        )
    }
}

custom_type_records(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    index: usize,
    output: &mut Vec<super::artifact::Record>
) -> Result<(), EmissionError> {
    let end = super::lowering::mir_program_type_count(program);
    try_for_range(Range::new(index, end), { current => {
        let record = try(custom_type_record(
            program,
            names,
            current
        ), @custom_type_records);
        Vec::push(&mut *output, record);
        Result::Ok(())
    } })
}

type_section(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>
) -> Result<super::artifact::Section, EmissionError> {
    let records = Vec::new();
    super::artifact::append_predefined_scalar_records(&mut records);
    try(custom_type_records(
        program,
        names,
        0,
        &mut records
    ), @type_section);
    Result::Ok(super::artifact::variable_section(&records))
}

require_name(
    names: &CanonicalPool<String>,
    name: &String,
    origin: EmissionName
) -> Result<u32, EmissionError> {
    handle canonical_id(names, name) {
        Result::Err(_) =>
            Result::Err(EmissionError::MissingName(origin)),
        Result::Ok(found) => Result::Ok(found)
    }
}

require_name_value(
    names: &CanonicalPool<String>,
    name: String,
    origin: EmissionName
) -> Result<u32, EmissionError> {
    handle canonical_id(names, &name) {
        Result::Err(_) =>
            Result::Err(EmissionError::MissingName(origin)),
        Result::Ok(found) => Result::Ok(found)
    }
}

signature_key(
    function: &super::lowering::MirFunction
) -> Bytes {
    let output = ByteBuf::new();
    ByteBuf::write_u32_le(
        &mut output,
        checked_u32(
            super::lowering::mir_function_parameter_count(function)
        )
    );
    ByteBuf::write_u32_le(
        &mut output,
        super::lowering::artifact_type_raw(
            super::lowering::mir_function_result(function)
        )
    );
    ByteBuf::write_u32_le(
        &mut output,
        checked_u32(
            super::lowering::mir_function_outward_protocol_count(function)
        )
    );
    append_parameter_types(function, 0, &mut output);
    append_function_outward_protocols(function, 0, &mut output);
    ByteBuf::finish(output)
}

mir_signature_key(value: &super::lowering::MirSignature) -> Bytes {
    let output = ByteBuf::new();
    ByteBuf::write_u32_le(
        &mut output,
        checked_u32(super::lowering::mir_signature_parameter_count(value))
    );
    ByteBuf::write_u32_le(
        &mut output,
        super::lowering::artifact_type_raw(
            super::lowering::mir_signature_result(value)
        )
    );
    ByteBuf::write_u32_le(
        &mut output,
        checked_u32(super::lowering::mir_signature_outward_count(value))
    );
    append_mir_signature_parameters(value, 0, &mut output);
    append_mir_signature_outward(value, 0, &mut output);
    ByteBuf::finish(output)
}

append_mir_signature_parameters(
    value: &super::lowering::MirSignature,
    index: usize,
    output: &mut ByteBuf
) {
    if(index < super::lowering::mir_signature_parameter_count(value)) {
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::artifact_type_raw(
                super::lowering::mir_signature_parameter_at(value, index)
            )
        );
        append_mir_signature_parameters(value, index + 1, output)
    } else { () }
}

append_mir_signature_outward(
    value: &super::lowering::MirSignature,
    index: usize,
    output: &mut ByteBuf
) {
    if(index < super::lowering::mir_signature_outward_count(value)) {
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::mir_signature_outward_at(value, index)
        );
        append_mir_signature_outward(value, index + 1, output)
    } else { () }
}

collect_protocol_signatures(
    program: &super::lowering::MirProgram,
    index: usize,
    output: &mut Vec<Bytes>
) {
    for_range(Range::new(
        index,
        super::lowering::mir_program_protocol_count(program)
    ), { protocol_index => {
        let protocol = super::lowering::mir_program_protocol_at(
            program, Id::from_u32(checked_u32(protocol_index))
        );
        for_range(Range::new(
            0,
            super::lowering::mir_protocol_operation_count(protocol)
        ), { operation_index =>
            Vec::push(
                &mut *output,
                mir_signature_key(
                    super::lowering::mir_operation_payload_signature(
                        super::lowering::mir_protocol_operation_at(
                            protocol, operation_index
                        )
                    )
                )
            )
        })
    } })
}

collect_handler_signatures(
    program: &super::lowering::MirProgram,
    index: usize,
    output: &mut Vec<Bytes>
) {
    for_range(Range::new(
        index,
        super::lowering::mir_program_handler_definition_count(program)
    ), { definition_index => {
        let definition =
            super::lowering::mir_program_handler_definition_at(
                program, Id::from_u32(checked_u32(definition_index))
            );
        for_range(Range::new(
            0,
            super::lowering::mir_handler_definition_clause_count(definition)
        ), { clause_index =>
            Vec::push(
                &mut *output,
                mir_signature_key(
                    super::lowering::mir_handler_clause_signature(
                        super::lowering::mir_handler_definition_clause_at(
                            definition, clause_index
                        )
                    )
                )
            )
        })
    } })
}

append_parameter_types(
    function: &super::lowering::MirFunction,
    index: usize,
    output: &mut ByteBuf
) {
    let end = super::lowering::mir_function_parameter_count(function);
    for_range(Range::new(index, end), { current =>
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::artifact_type_raw(
                super::lowering::mir_function_parameter_at(
                    function,
                    current
                )
            )
        )
    })
}

append_function_outward_protocols(
    function: &super::lowering::MirFunction,
    index: usize,
    output: &mut ByteBuf
) {
    if(index
        < super::lowering::mir_function_outward_protocol_count(function)) {
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::mir_function_outward_protocol_at(function, index)
        );
        append_function_outward_protocols(function, index + 1, output)
    } else { () }
}

require_signature(
    signatures: &CanonicalPool<Bytes>,
    key: &Bytes,
    function: super::lowering::MirFunctionId
) -> Result<u32, EmissionError> {
    handle canonical_id(signatures, key) {
        Result::Err(_) =>
            Result::Err(EmissionError::MissingSignature(function)),
        Result::Ok(found) => Result::Ok(found)
    }
}

collect_signatures(
    program: &super::lowering::MirProgram,
    index: usize,
    output: &mut Vec<Bytes>
) {
    for_range(Range::new(
        index,
        super::lowering::mir_program_function_count(program)
    ), { current => {
        let key = signature_key(
            super::lowering::mir_program_function_at(
                program,
                super::lowering::mir_function_id_from_usize(current)
            )
        );
        Vec::push(&mut *output, key)
    } });
    collect_protocol_signatures(program, 0, output);
    collect_handler_signatures(program, 0, output)
}

host_role_at(index: usize) -> u32 {
    handle index {
        0 => 3,
        1 => 1,
        2 => 2,
        _ => 0
    }
}

host_capability(role: u32) -> String {
    handle role {
        3 => "diagnostic",
        1 => "fs.read",
        2 => "fs.write",
        _ => "process.args"
    }
}

host_symbol(role: u32) -> String {
    handle role {
        3 => "write",
        1 => "read",
        2 => "write",
        _ => "get"
    }
}

write_host_imports(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    signatures: &CanonicalPool<Bytes>,
    index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    try_for_range(Range::new(
        index,
        usize_from_u32(host_import_count(program))
    ), { current => {
        let role = host_role_at(current);
        let function = handle super::lowering::mir_program_host_function(
            program,
            role,
            0
        ) {
            None => unreachable(),
            Option::Some(found) => found
        };
        let capability = try(require_name_value(
            names,
            host_capability(role),
            EmissionName::HostCapability(role)
        ), @write_host_imports);
        let symbol = try(require_name_value(
            names,
            host_symbol(role),
            EmissionName::HostSymbol(role)
        ), @write_host_imports);
        let signature = try(require_signature(
            signatures,
            &signature_key(super::lowering::mir_program_function_at(
                program,
                function
            )),
            function
        ), @write_host_imports);
        ByteBuf::write_u32_le(&mut *output, capability);
        ByteBuf::write_u32_le(&mut *output, symbol);
        ByteBuf::write_u32_le(&mut *output, signature);
        ByteBuf::write_u32_le(&mut *output, 1);
        ByteBuf::write_u64_le(&mut *output, 0);
        Result::Ok(())
    } })
}

signature_records(
    signatures: &CanonicalPool<Bytes>,
    index: usize,
    output: &mut Vec<super::artifact::Record>
) {
    for_range(Range::new(index, Vec::len(&signatures.values)), { current => {
        Vec::push(
            &mut *output,
            super::artifact::record(
                0,
                0,
                *Vec::index(&signatures.values, current)
            )
        )
    } })
}

byte_at(bytes: &Bytes, index: usize) -> u32 {
    handle Bytes::get(bytes, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => wrapping_convert_to_u32(found)
    }
}

append_arguments(
    arguments: &super::lowering::RegisterPack,
    ordinal: u32,
    output: &mut Vec<u32>
) {
    let count = super::lowering::register_pack_count(arguments);
    for_range(Range::new(
        usize_from_u32(ordinal),
        usize_from_u32(count)
    ), { current =>
        Vec::push(
            &mut *output,
            super::lowering::register_raw(
                super::lowering::register_pack_at(
                    arguments,
                    current
                )
            )
        )
    })
}

append_functions(
    functions: &super::lowering::MirFunctionPack,
    ordinal: u32,
    output: &mut Vec<u32>
) {
    let count = super::lowering::mir_function_pack_count(functions);
    for_range(Range::new(
        usize_from_u32(ordinal),
        usize_from_u32(count)
    ), { current =>
        Vec::push(
            &mut *output,
            super::lowering::mir_function_raw(
                super::lowering::mir_function_pack_at(functions, current)
            )
        )
    })
}

append_switch_cases(
    program: &super::lowering::MirProgram,
    constants: &CanonicalPool<Bytes>,
    function: &super::lowering::MirFunction,
    pack_id: super::lowering::MirSwitchPackId,
    index: usize,
    output: &mut Vec<u32>
) -> Result<(), EmissionError> {
    let pack = super::lowering::mir_function_switch_pack(
        function,
        pack_id
    );
    let end = super::lowering::mir_switch_pack_count(pack);
    try_for_range(Range::new(index, end), { current => {
        let case = super::lowering::mir_switch_pack_at(pack, current);
        let key = super::lowering::mir_switch_case_key(case);
        handle canonical_bytes_id(constants, key) {
            Result::Err(_) => Result::Err(
                EmissionError::MissingSwitchConstant(pack_id, current)
            ),
            Result::Ok(constant) => {
                Vec::push(
                    &mut *output,
                    constant
                );
                Vec::push(
                    &mut *output,
                    super::lowering::mir_function_block_offset(
                        function,
                        super::lowering::mir_switch_case_target(case)
                    )
                );
                Result::Ok(())
            }
        }
    } })
}

write_instruction(
    program: &super::lowering::MirProgram,
    constants: &CanonicalPool<Bytes>,
    mir_function: &super::lowering::MirFunction,
    instruction: &MirInstruction,
    code: &mut ByteBuf,
    operands: &mut Vec<u32>
) -> Result<(), EmissionError> {
    if(*instruction is MirInstruction::Const(target, key)) {
        let target_raw = super::lowering::register_raw(target);
        handle canonical_bytes_id(constants, &key) {
            Result::Err(_) =>
                Result::Err(EmissionError::MissingConstant(target)),
            Result::Ok(constant) => {
                write_opcode(&mut *code, Opcode::Constant);
                ByteBuf::write_u32_le(&mut *code, target_raw);
                ByteBuf::write_u32_le(
                    code,
                    constant
                );
                Result::Ok(())
            }
        }
    } else if(*instruction is MirInstruction::Move(target, source)) {
        write_opcode(&mut *code, Opcode::Move);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_raw(source)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Copy(target, source)) {
        write_opcode(&mut *code, Opcode::Copy);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_raw(source)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Construct(
        target,
        ty,
        variant,
        fields_id
    )) {
        let fields = super::lowering::mir_function_register_pack(
            mir_function,
            fields_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(fields, 0, operands);
        write_opcode(&mut *code, Opcode::Construct);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::artifact_type_raw(ty)
        );
        ByteBuf::write_u32_le(
            &mut *code,
            handle variant {
                Result::Err(_) => super::artifact::absent_id(),
                Result::Ok(found) => found
            }
        );
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_pack_count(fields)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::ProjectMove(
        target,
        source,
        field
    )) {
        write_opcode(&mut *code, Opcode::ProjectMove);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(source)
        );
        ByteBuf::write_u32_le(code, field);
        Result::Ok(())
    } else if(*instruction is MirInstruction::ProjectCopy(
        target,
        source,
        field
    )) {
        write_opcode(&mut *code, Opcode::ProjectCopy);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(source)
        );
        ByteBuf::write_u32_le(code, field);
        Result::Ok(())
    } else if(*instruction is MirInstruction::EnumTag(
        target,
        source
    )) {
        write_opcode(&mut *code, Opcode::EnumTag);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_raw(source)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Drop(register)) {
        write_opcode(&mut *code, Opcode::Drop);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_raw(register)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Deconstruct(register)) {
        write_opcode(&mut *code, Opcode::Deconstruct);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_raw(register)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Primitive(
        target,
        primitive,
        arguments_id
    )) {
        let arguments = super::lowering::mir_function_register_pack(
            mir_function,
            arguments_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(arguments, 0, operands);
        write_opcode(&mut *code, Opcode::Primitive);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(&mut *code, primitive);
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_pack_count(arguments)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::HostCall(
        target,
        role,
        arguments_id
    )) {
        let arguments = super::lowering::mir_function_register_pack(
            mir_function,
            arguments_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(arguments, 0, operands);
        let destination = handle target {
            None => super::artifact::absent_id(),
            Option::Some(found) => super::lowering::register_raw(found)
        };
        let import = handle role {
            3 => 0,
            1 => 1,
            2 => 2,
            _ => 3
        };
        write_opcode(&mut *code, Opcode::HostCall);
        ByteBuf::write_u32_le(&mut *code, destination);
        ByteBuf::write_u32_le(&mut *code, import);
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_pack_count(arguments)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Abort) {
        write_opcode(&mut *code, Opcode::Abort);
        ByteBuf::write_u32_le(code, super::artifact::absent_id());
        Result::Ok(())
    } else if(*instruction is MirInstruction::Unreachable) {
        write_opcode(&mut *code, Opcode::Unreachable);
        Result::Ok(())
    } else if(*instruction is MirInstruction::Jump(target)) {
        write_opcode(&mut *code, Opcode::Jump);
        ByteBuf::write_u32_le(
            code,
            super::lowering::mir_function_block_offset(
                mir_function,
                target
            )
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Switch(
        discriminant,
        pack_id,
        otherwise
    )) {
        let pack = super::lowering::mir_function_switch_pack(
            mir_function,
            pack_id
        );
        let operand_start = checked_u32(Vec::len(&*operands));
        try(append_switch_cases(
            program,
            constants,
            mir_function,
            pack_id,
            0,
            operands
        ), @write_instruction);
        write_opcode(&mut *code, Opcode::Switch);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(discriminant)
        );
        ByteBuf::write_u32_le(&mut *code, operand_start);
        ByteBuf::write_u32_le(
            &mut *code,
            checked_u32(
                super::lowering::mir_switch_pack_count(pack)
            )
        );
        ByteBuf::write_u32_le(
            code,
            super::lowering::mir_function_block_offset(
                mir_function,
                otherwise
            )
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Call(
        target,
        function,
        arguments_id
    )) {
        let arguments = super::lowering::mir_function_register_pack(
            mir_function,
            arguments_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(arguments, 0, operands);
        write_opcode(&mut *code, Opcode::Call);
        ByteBuf::write_u32_le(
            &mut *code,
            handle target {
                Result::Err(_) => super::artifact::absent_id(),
                Result::Ok(found) =>
                    super::lowering::register_raw(found)
            }
        );
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::mir_function_raw(function)
        );
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_pack_count(arguments)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::MakeHandler(
        target,
        definition,
        clauses_id
    )) {
        let clauses = super::lowering::mir_function_register_pack(
            mir_function, clauses_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(clauses, 0, operands);
        write_opcode(&mut *code, Opcode::MakeHandler);
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(&mut *code, Id::to_u32(definition));
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code, super::lowering::register_pack_count(clauses)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::MakeHandlerShared(
        target,
        definition,
        functions_id,
        captures_id
    )) {
        let functions = super::lowering::mir_function_function_pack(
            mir_function, functions_id
        );
        let captures = super::lowering::mir_function_register_pack(
            mir_function, captures_id
        );
        let function_start = checked_u32(Vec::len(&*operands));
        append_functions(functions, 0, operands);
        let capture_start = checked_u32(Vec::len(&*operands));
        append_arguments(captures, 0, operands);
        write_opcode(&mut *code, Opcode::MakeHandlerShared);
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(&mut *code, Id::to_u32(definition));
        ByteBuf::write_u32_le(&mut *code, function_start);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::mir_function_pack_count(functions)
        );
        ByteBuf::write_u32_le(&mut *code, capture_start);
        ByteBuf::write_u32_le(
            code, super::lowering::register_pack_count(captures)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Handle(
        target,
        handler,
        body,
        arguments_id
    )) {
        let arguments = super::lowering::mir_function_register_pack(
            mir_function, arguments_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(arguments, 0, operands);
        write_opcode(&mut *code, Opcode::Handle);
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(handler)
        );
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(body)
        );
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code, super::lowering::register_pack_count(arguments)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Perform(
        target,
        protocol,
        operation,
        payloads_id
    )) {
        let payloads = super::lowering::mir_function_register_pack(
            mir_function, payloads_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(payloads, 0, operands);
        write_opcode(&mut *code, Opcode::Perform);
        ByteBuf::write_u32_le(
            &mut *code,
            handle target {
                None => super::artifact::absent_id(),
                Option::Some(found) => super::lowering::register_raw(found)
            }
        );
        ByteBuf::write_u32_le(&mut *code, Id::to_u32(protocol));
        ByteBuf::write_u32_le(&mut *code, operation);
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code, super::lowering::register_pack_count(payloads)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Resume(
        target,
        resumption,
        receiver_mode,
        resumed
    )) {
        write_opcode(&mut *code, Opcode::Resume);
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(resumption)
        );
        ByteBuf::write_u32_le(&mut *code, receiver_mode);
        ByteBuf::write_u32_le(
            code, super::lowering::register_raw(resumed)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::TailResume(
        resumption,
        receiver_mode,
        resumed
    )) {
        write_opcode(&mut *code, Opcode::TailResume);
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(resumption)
        );
        ByteBuf::write_u32_le(&mut *code, receiver_mode);
        ByteBuf::write_u32_le(
            code, super::lowering::register_raw(resumed)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Cancel(target, resumption)) {
        write_opcode(&mut *code, Opcode::Cancel);
        ByteBuf::write_u32_le(
            &mut *code, super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            code, super::lowering::register_raw(resumption)
        );
        Result::Ok(())
    } else if(*instruction is MirInstruction::Return(source)) {
        write_opcode(&mut *code, Opcode::Return);
        ByteBuf::write_u32_le(
            code,
            handle source {
                Result::Err(_) => super::artifact::absent_id(),
                Result::Ok(found) =>
                    super::lowering::register_raw(found)
            }
        );
        Result::Ok(())
    } else {
        Result::Err(EmissionError::UnsupportedInstruction)
    }
}

write_function_code(
    program: &super::lowering::MirProgram,
    constants: &CanonicalPool<Bytes>,
    function: &super::lowering::MirFunction,
    index: usize,
    code: &mut ByteBuf,
    operands: &mut Vec<u32>
) -> Result<(), EmissionError> {
    let end = super::lowering::mir_function_instruction_count(function);
    try_for_range(Range::new(index, end), { current =>
        write_instruction(
            program,
            constants,
            function,
            super::lowering::mir_function_instruction_at(
                function,
                current
            ),
            code,
            operands
        )
    })
}

write_all_code(
    program: &super::lowering::MirProgram,
    constants: &CanonicalPool<Bytes>,
    index: usize,
    code: &mut ByteBuf,
    operands: &mut Vec<u32>,
    spans: &mut Vec<FunctionSpans>
) -> Result<(), EmissionError> {
    let end = super::lowering::mir_program_function_count(program);
    try_for_range(Range::new(index, end), { current => {
        let function =
            super::lowering::mir_program_function_at(
                program,
                super::lowering::mir_function_id_from_usize(current)
            );
        let start = checked_u32(ByteBuf::len(&*code) / 4);
        try(write_function_code(
            program,
            constants,
            function,
            0,
            code,
            operands
        ), @write_all_code);
        let end = checked_u32(ByteBuf::len(&*code) / 4);
        Vec::push(&mut *spans, FunctionSpans {
            code_start: start,
            code_length: end - start,
            cleanup_start: 0,
            cleanup_count: 0
        });
        Result::Ok(())
    } })
}

append_cleanup_registers(
    cleanup: &super::lowering::MirCleanup,
    index: usize,
    operands: &mut Vec<u32>
) {
    let end = super::lowering::mir_cleanup_register_count(cleanup);
    for_range(Range::new(index, end), { current =>
        Vec::push(
            &mut *operands,
            super::lowering::register_raw(
                super::lowering::mir_cleanup_register_at(
                    cleanup,
                    current
                )
            )
        )
    })
}

write_function_cleanups(
    function: &super::lowering::MirFunction,
    function_id: u32,
    index: usize,
    output: &mut ByteBuf,
    operands: &mut Vec<u32>
) {
    for_range(Range::new(
        index,
        super::lowering::mir_function_cleanup_count(function)
    ), { current => {
        let cleanup =
            super::lowering::mir_function_cleanup_at(function, current);
        let operand_start = checked_u32(Vec::len(&*operands));
        append_cleanup_registers(cleanup, 0, operands);
        ByteBuf::write_u32_le(&mut *output, function_id);
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::mir_cleanup_first(cleanup)
        );
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::mir_cleanup_end(cleanup)
        );
        ByteBuf::write_u32_le(&mut *output, operand_start);
        ByteBuf::write_u32_le(
            &mut *output,
            checked_u32(
                super::lowering::mir_cleanup_register_count(cleanup)
            )
        );
        ByteBuf::write_u32_le(&mut *output, 0);
    } })
}

write_all_cleanups(
    program: &super::lowering::MirProgram,
    index: usize,
    output: &mut ByteBuf,
    operands: &mut Vec<u32>,
    spans: &mut Vec<FunctionSpans>
) {
    for_range(Range::new(
        index,
        super::lowering::mir_program_function_count(program)
    ), { current => {
        let function =
            super::lowering::mir_program_function_at(
                program,
                super::lowering::mir_function_id_from_usize(current)
            );
        let start = checked_u32(ByteBuf::len(&*output) / 24);
        write_function_cleanups(
            function,
            checked_u32(current),
            0,
            output,
            operands
        );
        let end = checked_u32(ByteBuf::len(&*output) / 24);
        set_cleanup_span(spans, current, start, end - start)
    } })
}

set_cleanup_span(
    spans: &mut Vec<FunctionSpans>,
    index: usize,
    start: u32,
    count: u32
) {
    let span = Vec::index_mut(&mut *spans, index);
    (*span).cleanup_start = start;
    (*span).cleanup_count = count;
    ()
}

write_operand_words(
    operands: &Vec<u32>,
    index: usize,
    output: &mut ByteBuf
) {
    for_range(Range::new(index, Vec::len(operands)), { current =>
        ByteBuf::write_u32_le(&mut *output, *Vec::index(operands, current))
    })
}

write_functions(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    signatures: &CanonicalPool<Bytes>,
    spans: &Vec<FunctionSpans>,
    index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    let end = super::lowering::mir_program_function_count(program);
    try_for_range(Range::new(index, end), { current => {
        let function =
            super::lowering::mir_program_function_at(
                program,
                super::lowering::mir_function_id_from_usize(current)
            );
        let signature = signature_key(function);
        let function_id =
            super::lowering::mir_function_id_from_usize(current);
        let name = try(require_name(
            names,
            super::lowering::mir_function_name(function),
            EmissionName::Function(function_id)
        ), @write_functions);
        let signature_id = try(require_signature(
            signatures,
            &signature,
            function_id
        ), @write_functions);
        let span = Vec::index(spans, current);
        ByteBuf::write_u32_le(&mut *output, name);
        ByteBuf::write_u32_le(&mut *output, signature_id);
        ByteBuf::write_u32_le(&mut *output, 0);
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::mir_function_register_count(function)
        );
        ByteBuf::write_u32_le(&mut *output, span.code_start);
        ByteBuf::write_u32_le(&mut *output, span.code_length);
        ByteBuf::write_u32_le(
            &mut *output,
            checked_u32(
                super::lowering::mir_function_instruction_count(function)
            )
        );
        ByteBuf::write_u32_le(&mut *output, span.cleanup_start);
        ByteBuf::write_u32_le(&mut *output, span.cleanup_count);
        ByteBuf::write_u32_le(&mut *output, 0);
        ByteBuf::write_u32_le(&mut *output, 0);
        ByteBuf::write_u32_le(
            &mut *output,
            super::artifact::absent_id()
        );
        ByteBuf::write_u64_le(&mut *output, 0);
        ByteBuf::write_u64_le(&mut *output, 0);
        Result::Ok(())
    } })
}

new_emission_context<'a>(
    program: &'a super::lowering::MirProgram
) -> EmissionContext<'a> {
    let name_values = Vec::new();
    collect_names(program, 0, &mut name_values);
    collect_protocol_names(program, 0, &mut name_values);
    collect_type_names(program, 0, &mut name_values);
    collect_host_names(program, &mut name_values);
    let signature_values = Vec::new();
    collect_signatures(program, 0, &mut signature_values);
    let constant_values = Vec::new();
    collect_constant_values(program, 0, &mut constant_values);
    EmissionContext {
        program: program,
        names: freeze_canonical_pool(name_values),
        signatures: freeze_stable_pool(signature_values),
        constants: freeze_canonical_pool(constant_values),
        operands: Vec::new(),
        spans: Vec::new(),
        writer: super::artifact::new_writer()
    }
}

write_context_code<'a>(
    value: &mut EmissionContext<'a>,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    write_all_code(
        value.program,
        &value.constants,
        0,
        output,
        &mut value.operands,
        &mut value.spans
    )
}

write_context_cleanups<'a>(
    value: &mut EmissionContext<'a>,
    output: &mut ByteBuf
) {
    write_all_cleanups(
        value.program,
        0,
        output,
        &mut value.operands,
        &mut value.spans
    )
}

write_context_functions<'a>(
    value: &EmissionContext<'a>,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    write_functions(
        value.program,
        &value.names,
        &value.signatures,
        &value.spans,
        0,
        output
    )
}

canonical_string_position(
    names: &CanonicalPool<String>,
    key: &String,
    index: usize
) -> u32 {
    if(*Vec::index(&names.values, index) == *key) {
        checked_u32(index)
    } else {
        canonical_string_position(names, key, index + 1)
    }
}

// These record writers are intentionally direct recursion rather than
// `for_range` callbacks. The current bootstrap ownership/control-fusion path
// mis-models a mutable ByteBuf captured by the equivalent callback and emits a
// duplicate Drop after the borrow is transferred. Keep this boundary local;
// once mutable-capture fusion is fixed, control-plan tests may migrate it back
// to the standard traversal kernel without changing the wire schema.
write_protocol_type_arguments(
    protocol: &super::lowering::MirProtocol,
    index: usize,
    payload: &mut ByteBuf
) {
    if(index < super::lowering::mir_protocol_type_argument_count(protocol)) {
        ByteBuf::write_u32_le(
            &mut *payload,
            super::lowering::artifact_type_raw(
                super::lowering::mir_protocol_type_argument_at(protocol, index)
            )
        );
        write_protocol_type_arguments(protocol, index + 1, payload)
    } else { () }
}

write_protocol_operations(
    protocol: &super::lowering::MirProtocol,
    index: usize,
    names: &CanonicalPool<String>,
    signatures: &CanonicalPool<Bytes>,
    payload: &mut ByteBuf
) {
    if(index < super::lowering::mir_protocol_operation_count(protocol)) {
        let operation = super::lowering::mir_protocol_operation_at(
            protocol, index
        );
        let operation_name = canonical_string_position(
            names,
            super::lowering::mir_operation_name(operation),
            0
        );
        let signature = handle canonical_bytes_id(
            signatures,
            &mir_signature_key(
                super::lowering::mir_operation_payload_signature(operation)
            )
        ) {
            None => unreachable(),
            Option::Some(found) => found
        };
        ByteBuf::write_u32_le(&mut *payload, operation_name);
        ByteBuf::write_u32_le(&mut *payload, signature);
        ByteBuf::write_u32_le(
            &mut *payload,
            super::lowering::artifact_type_raw(
                super::lowering::mir_operation_result(operation)
            )
        );
        ByteBuf::write_u32_le(
            &mut *payload,
            super::lowering::mir_operation_resumption_lower(operation)
        );
        ByteBuf::write_u32_le(
            &mut *payload,
            handle super::lowering::mir_operation_resumption_upper(operation) {
                None => super::artifact::absent_id(),
                Option::Some(found) => found
            }
        );
        ByteBuf::write_u32_le(
            &mut *payload,
            if(super::lowering::mir_operation_terminal(operation)) { 1 } else { 0 }
        );
        write_protocol_operations(
            protocol, index + 1, names, signatures, payload
        )
    } else { () }
}

protocol_record(
    protocol: &super::lowering::MirProtocol,
    names: &CanonicalPool<String>,
    signatures: &CanonicalPool<Bytes>
) -> super::artifact::Record {
    let payload = ByteBuf::new();
    let name = canonical_string_position(
        names,
        super::lowering::mir_protocol_display_name(protocol),
        0
    );
    ByteBuf::write_u32_le(&mut payload, name);
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(super::lowering::mir_protocol_type_argument_count(protocol))
    );
    write_protocol_type_arguments(protocol, 0, &mut payload);
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(super::lowering::mir_protocol_operation_count(protocol))
    );
    write_protocol_operations(protocol, 0, names, signatures, &mut payload);
    super::artifact::record(0, 0, ByteBuf::finish(payload))
}

protocol_records(
    program: &super::lowering::MirProgram,
    names: &CanonicalPool<String>,
    signatures: &CanonicalPool<Bytes>,
    output: &mut Vec<super::artifact::Record>
) {
    for_range(Range::new(
        0,
        super::lowering::mir_program_protocol_count(program)
    ), { current =>
        Vec::push(
            &mut *output,
            protocol_record(
                super::lowering::mir_program_protocol_at(
                    program, Id::from_u32(checked_u32(current))
                ),
                names,
                signatures
            )
        )
    })
}

handler_definition_record(
    definition: &super::lowering::MirHandlerDefinition,
    signatures: &CanonicalPool<Bytes>
) -> super::artifact::Record {
    let payload = ByteBuf::new();
    ByteBuf::write_u32_le(
        &mut payload,
        super::lowering::artifact_type_raw(
            super::lowering::mir_handler_definition_result(definition)
        )
    );
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(
            super::lowering::mir_handler_definition_clause_count(definition)
        )
    );
    write_handler_definition_clauses(
        definition, 0, signatures, &mut payload
    );
    super::artifact::record(
        0,
        if(super::lowering::mir_handler_definition_partial(definition)) {
            1
        } else { 0 },
        ByteBuf::finish(payload)
    )
}

write_handler_definition_clauses(
    definition: &super::lowering::MirHandlerDefinition,
    index: usize,
    signatures: &CanonicalPool<Bytes>,
    payload: &mut ByteBuf
) {
    if(index < super::lowering::mir_handler_definition_clause_count(definition)) {
        let clause = super::lowering::mir_handler_definition_clause_at(
            definition, index
        );
        let signature = handle canonical_bytes_id(
            signatures,
            &mir_signature_key(
                super::lowering::mir_handler_clause_signature(clause)
            )
        ) {
            None => unreachable(),
            Option::Some(found) => found
        };
        ByteBuf::write_u32_le(
            &mut *payload,
            Id::to_u32(super::lowering::mir_handler_clause_protocol(clause))
        );
        ByteBuf::write_u32_le(
            &mut *payload,
            super::lowering::mir_handler_clause_operation(clause)
        );
        ByteBuf::write_u32_le(&mut *payload, signature);
        ByteBuf::write_u32_le(
            &mut *payload,
            handle super::lowering::mir_handler_clause_resumption_type(clause) {
                None => super::artifact::absent_id(),
                Option::Some(found) => super::lowering::artifact_type_raw(found)
            }
        );
        write_handler_definition_clauses(
            definition, index + 1, signatures, payload
        )
    } else { () }
}

handler_definition_records(
    program: &super::lowering::MirProgram,
    signatures: &CanonicalPool<Bytes>,
    output: &mut Vec<super::artifact::Record>
) {
    for_range(Range::new(
        0,
        super::lowering::mir_program_handler_definition_count(program)
    ), { current =>
        Vec::push(
            &mut *output,
            handler_definition_record(
                super::lowering::mir_program_handler_definition_at(
                    program, Id::from_u32(checked_u32(current))
                ),
                signatures
            )
        )
    })
}

function_has_effect_instruction(
    function: &super::lowering::MirFunction,
    index: usize
) -> Bool {
    if(index < super::lowering::mir_function_instruction_count(function)) {
        let instruction = super::lowering::mir_function_instruction_at(
            function, index
        );
        let found = handle *instruction {
            MirInstruction::MakeHandler(_, _, _) => true,
            MirInstruction::MakeHandlerShared(_, _, _, _) => true,
            MirInstruction::Handle(_, _, _, _) => true,
            MirInstruction::Perform(_, _, _, _) => true,
            MirInstruction::Resume(_, _, _, _) => true,
            MirInstruction::TailResume(_, _, _) => true,
            MirInstruction::Cancel(_, _) => true,
            _ => false
        };
        if(found) { true } else {
            function_has_effect_instruction(function, index + 1)
        }
    } else { false }
}

program_has_effect_instruction(
    program: &super::lowering::MirProgram,
    index: usize
) -> Bool {
    if(index < super::lowering::mir_program_function_count(program)) {
        if(function_has_effect_instruction(
            super::lowering::mir_program_function_at(
                program,
                super::lowering::mir_function_id_from_usize(index)
            ),
            0
        )) { true } else {
            program_has_effect_instruction(program, index + 1)
        }
    } else { false }
}

valid_artifact_type(
    program: &super::lowering::MirProgram,
    value: super::lowering::ArtifactTypeId
) -> Bool {
    usize_from_u32(super::lowering::artifact_type_raw(value))
        < 19 + super::lowering::mir_program_type_count(program)
}

valid_signature_row(
    program: &super::lowering::MirProgram,
    signature: &super::lowering::MirSignature,
    index: usize,
    previous: Option<u32>
) -> Bool {
    if(index < super::lowering::mir_signature_outward_count(signature)) {
        let protocol = super::lowering::mir_signature_outward_at(
            signature, index
        );
        if(usize_from_u32(protocol)
            >= super::lowering::mir_program_protocol_count(program)) {
            false
        } else {
            handle previous {
                None => valid_signature_row(
                    program, signature, index + 1, Option::Some(protocol)
                ),
                Option::Some(found) => if(found < protocol) {
                    valid_signature_row(
                        program, signature, index + 1,
                        Option::Some(protocol)
                    )
                } else { false }
            }
        }
    } else { true }
}

valid_signature_types(
    program: &super::lowering::MirProgram,
    signature: &super::lowering::MirSignature,
    index: usize
) -> Bool {
    if(index < super::lowering::mir_signature_parameter_count(signature)) {
        if(valid_artifact_type(
            program,
            super::lowering::mir_signature_parameter_at(signature, index)
        )) {
            valid_signature_types(program, signature, index + 1)
        } else { false }
    } else {
        valid_artifact_type(
            program, super::lowering::mir_signature_result(signature)
        ) and { valid_signature_row(program, signature, 0, None) }
    }
}

type_arguments_less(
    left: &super::lowering::MirProtocol,
    right: &super::lowering::MirProtocol,
    index: usize
) -> Bool {
    let left_count = super::lowering::mir_protocol_type_argument_count(left);
    let right_count = super::lowering::mir_protocol_type_argument_count(right);
    if(index < left_count and { index < right_count }) {
        let left_value = super::lowering::artifact_type_raw(
            super::lowering::mir_protocol_type_argument_at(left, index)
        );
        let right_value = super::lowering::artifact_type_raw(
            super::lowering::mir_protocol_type_argument_at(right, index)
        );
        if(left_value < right_value) { true } else if(left_value == right_value) {
            type_arguments_less(left, right, index + 1)
        } else { false }
    } else { left_count < right_count }
}

string_bytes_order(
    left: &Bytes,
    right: &Bytes,
    index: usize
) -> u32 {
    if(index < Bytes::len(left) and { index < Bytes::len(right) }) {
        let left_byte = handle Bytes::get(left, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => wrapping_convert_to_u32(found)
        };
        let right_byte = handle Bytes::get(right, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => wrapping_convert_to_u32(found)
        };
        if(left_byte < right_byte) { 1 } else if(left_byte == right_byte) {
            string_bytes_order(left, right, index + 1)
        } else { 2 }
    } else if(Bytes::len(left) < Bytes::len(right)) {
        1
    } else if(Bytes::len(left) == Bytes::len(right)) { 0 } else { 2 }
}

protocol_identity_less(
    left: &super::lowering::MirProtocol,
    right: &super::lowering::MirProtocol
) -> Bool {
    let order = string_bytes_order(
        &String::as_bytes(super::lowering::mir_protocol_display_name(left)),
        &String::as_bytes(super::lowering::mir_protocol_display_name(right)),
        0
    );
    if(order == 1) { true } else if(order == 0) {
        type_arguments_less(left, right, 0)
    } else { false }
}

validate_protocol_operation(
    program: &super::lowering::MirProgram,
    protocol: u32,
    operation: u32
) -> Result<(), EmissionError> {
    let value = super::lowering::mir_protocol_operation_at(
        super::lowering::mir_program_protocol_at(
            program, Id::from_u32(protocol)
        ),
        usize_from_u32(operation)
    );
    let signature = super::lowering::mir_operation_payload_signature(value);
    if(not(valid_signature_types(program, signature, 0))) {
        Result::Err(EmissionError::InvalidProtocol(protocol, ProtocolValidationError::Signature))
    } else if(not(valid_artifact_type(
        program, super::lowering::mir_operation_result(value)
    ))) {
        Result::Err(EmissionError::InvalidProtocol(protocol, ProtocolValidationError::ResultType))
    } else {
        let lower = super::lowering::mir_operation_resumption_lower(value);
        let upper = super::lowering::mir_operation_resumption_upper(value);
        let terminal = super::lowering::mir_operation_terminal(value);
        if(terminal) {
            if(
                super::lowering::artifact_type_raw(
                    super::lowering::mir_operation_result(value)
                ) == 1
                and { lower == 0 }
                and { upper == Option::Some(0) }
            ) { Result::Ok(()) } else {
                Result::Err(EmissionError::InvalidProtocol(protocol, ProtocolValidationError::TerminalContract))
            }
        } else {
            handle upper {
                None => Result::Ok(()),
                Option::Some(found) => if(lower <= found) {
                    Result::Ok(())
                } else {
                    Result::Err(EmissionError::InvalidProtocol(protocol, ProtocolValidationError::Quantity))
                }
            }
        }
    }
}

validate_protocol_operations(
    program: &super::lowering::MirProgram,
    protocol: u32,
    index: usize
) -> Result<(), EmissionError> {
    let value = super::lowering::mir_program_protocol_at(
        program, Id::from_u32(protocol)
    );
    try_for_range(Range::new(
        index,
        super::lowering::mir_protocol_operation_count(value)
    ), { current => validate_protocol_operation(
        program, protocol, checked_u32(current)
    ) })
}

validate_protocols(
    program: &super::lowering::MirProgram,
    index: usize
) -> Result<(), EmissionError> {
    try_for_range(Range::new(
        index,
        super::lowering::mir_program_protocol_count(program)
    ), { current => {
        let id = checked_u32(current);
        let protocol = super::lowering::mir_program_protocol_at(
            program, Id::from_u32(id)
        );
        if(current > 0 and {
            not(protocol_identity_less(
                super::lowering::mir_program_protocol_at(
                    program, Id::from_u32(id - 1)
                ),
                protocol
            ))
        }) {
            Result::Err(EmissionError::InvalidProtocol(id, ProtocolValidationError::CanonicalOrder))
        } else {
            let bad_type = find_range(Range::new(
                0,
                super::lowering::mir_protocol_type_argument_count(protocol)
            ), { argument => not(valid_artifact_type(
                program,
                super::lowering::mir_protocol_type_argument_at(
                    protocol, argument
                )
            )) });
            handle bad_type {
                Option::Some(_) =>
                    Result::Err(EmissionError::InvalidProtocol(id, ProtocolValidationError::TypeArgument)),
                None => validate_protocol_operations(program, id, 0)
            }
        }
    } })
}

same_signature_parameter_prefix(
    left: &super::lowering::MirSignature,
    right: &super::lowering::MirSignature,
    index: usize
) -> Bool {
    if(index < super::lowering::mir_signature_parameter_count(left)) {
        if(
            super::lowering::mir_signature_parameter_at(left, index)
                == super::lowering::mir_signature_parameter_at(right, index)
        ) {
            same_signature_parameter_prefix(left, right, index + 1)
        } else { false }
    } else { true }
}

handler_has_prior_target(
    definition: &super::lowering::MirHandlerDefinition,
    clause: &super::lowering::MirHandlerClause,
    index: usize,
    end: usize
) -> Bool {
    if(index < end) {
        let candidate = super::lowering::mir_handler_definition_clause_at(
            definition, index
        );
        if(
            super::lowering::mir_handler_clause_protocol(candidate)
                == super::lowering::mir_handler_clause_protocol(clause)
            and {
                super::lowering::mir_handler_clause_operation(candidate)
                    == super::lowering::mir_handler_clause_operation(clause)
            }
        ) { true } else {
            handler_has_prior_target(definition, clause, index + 1, end)
        }
    } else { false }
}

validate_handler_clause(
    program: &super::lowering::MirProgram,
    definition_id: u32,
    clause_index: usize
) -> Result<(), EmissionError> {
    let definition = super::lowering::mir_program_handler_definition_at(
        program, Id::from_u32(definition_id)
    );
    let clause = super::lowering::mir_handler_definition_clause_at(
        definition, clause_index
    );
    let protocol_id = Id::to_u32(
        super::lowering::mir_handler_clause_protocol(clause)
    );
    if(usize_from_u32(protocol_id)
        >= super::lowering::mir_program_protocol_count(program)) {
        Result::Err(EmissionError::InvalidHandlerDefinition(definition_id, HandlerValidationError::UnknownProtocol))
    } else {
        let protocol = super::lowering::mir_program_protocol_at(
            program, Id::from_u32(protocol_id)
        );
        let operation_index =
            super::lowering::mir_handler_clause_operation(clause);
        if(usize_from_u32(operation_index)
            >= super::lowering::mir_protocol_operation_count(protocol)) {
            Result::Err(
                EmissionError::InvalidHandlerDefinition(definition_id, HandlerValidationError::UnknownOperation)
            )
        } else if(handler_has_prior_target(
            definition, clause, 0, clause_index
        )) {
            Result::Err(
                EmissionError::InvalidHandlerDefinition(definition_id, HandlerValidationError::DuplicateClause)
            )
        } else {
            let operation = super::lowering::mir_protocol_operation_at(
                protocol, usize_from_u32(operation_index)
            );
            let payload =
                super::lowering::mir_operation_payload_signature(operation);
            let callable = super::lowering::mir_handler_clause_signature(clause);
            let payload_count =
                super::lowering::mir_signature_parameter_count(payload);
            let terminal = super::lowering::mir_operation_terminal(operation);
            let expected_count = if(terminal) {
                payload_count
            } else { payload_count + 1 };
            if(not(valid_signature_types(program, callable, 0))
                or {
                    super::lowering::mir_signature_parameter_count(callable)
                        != expected_count
                }
                or { not(same_signature_parameter_prefix(payload, callable, 0)) }
                or {
                    super::lowering::artifact_type_raw(
                        super::lowering::mir_signature_result(callable)
                    ) != super::lowering::artifact_type_raw(
                        super::lowering::mir_handler_definition_result(
                            definition
                        )
                    )
                }
            ) {
                Result::Err(
                    EmissionError::InvalidHandlerDefinition(definition_id, HandlerValidationError::CallableSignature)
                )
            } else if(terminal) {
                handle super::lowering::mir_handler_clause_resumption_type(clause) {
                    None => Result::Ok(()),
                    Option::Some(_) => Result::Err(
                        EmissionError::InvalidHandlerDefinition(definition_id, HandlerValidationError::TerminalResumption)
                    )
                }
            } else {
                // Resumption descriptors require the Resumption MirTypeKind.
                // Reject explicitly until that structural type is available;
                // emitting an arbitrary aggregate type would violate the VM ABI.
                Result::Err(
                    EmissionError::InvalidHandlerDefinition(definition_id, HandlerValidationError::ResumptionTypeUnavailable)
                )
            }
        }
    }
}

validate_handler_definitions(
    program: &super::lowering::MirProgram,
    index: usize
) -> Result<(), EmissionError> {
    try_for_range(Range::new(
        index,
        super::lowering::mir_program_handler_definition_count(program)
    ), { current => {
        let id = checked_u32(current);
        let definition =
            super::lowering::mir_program_handler_definition_at(
                program, Id::from_u32(id)
            );
        if(not(valid_artifact_type(
            program,
            super::lowering::mir_handler_definition_result(definition)
        ))) {
            Result::Err(EmissionError::InvalidHandlerDefinition(id, HandlerValidationError::ResultType))
        } else {
            try_for_range(Range::new(
                0,
                super::lowering::mir_handler_definition_clause_count(definition)
            ), { clause => validate_handler_clause(program, id, clause) })
        }
    } })
}

validate_effect_instruction(
    program: &super::lowering::MirProgram,
    function_id: super::lowering::MirFunctionId,
    function: &super::lowering::MirFunction,
    index: usize
) -> Result<(), EmissionError> {
    let instruction = super::lowering::mir_function_instruction_at(
        function, index
    );
    if(*instruction is MirInstruction::MakeHandler(_, definition, clauses)) {
        let definition_index = Id::to_usize(definition);
        if(definition_index
            >= super::lowering::mir_program_handler_definition_count(program)) {
            Result::Err(EmissionError::InvalidEffectInstruction(
                function_id, checked_u32(index), EffectInstructionValidationError::UnknownHandler
            ))
        } else {
            let expected =
                super::lowering::mir_handler_definition_clause_count(
                    super::lowering::mir_program_handler_definition_at(
                        program, definition
                    )
                );
            let found = usize_from_u32(
                super::lowering::register_pack_count(
                    super::lowering::mir_function_register_pack(
                        function, clauses
                    )
                )
            );
            if(expected == found) { Result::Ok(()) } else {
                Result::Err(EmissionError::InvalidEffectInstruction(
                    function_id, checked_u32(index), EffectInstructionValidationError::ClauseCount
                ))
            }
        }
    } else if(*instruction is MirInstruction::MakeHandlerShared(
        _, definition, functions, _
    )) {
        let definition_index = Id::to_usize(definition);
        if(definition_index
            >= super::lowering::mir_program_handler_definition_count(program)) {
            Result::Err(EmissionError::InvalidEffectInstruction(
                function_id, checked_u32(index), EffectInstructionValidationError::UnknownHandler
            ))
        } else {
            let expected =
                super::lowering::mir_handler_definition_clause_count(
                    super::lowering::mir_program_handler_definition_at(
                        program, definition
                    )
                );
            let pack = super::lowering::mir_function_function_pack(
                function, functions
            );
            let found = usize_from_u32(
                super::lowering::mir_function_pack_count(pack)
            );
            let bad_function = find_range(Range::new(0, found), { current =>
                Id::to_usize(super::lowering::mir_function_pack_at(pack, current))
                    >= super::lowering::mir_program_function_count(program)
            });
            if(expected == found and { found > 0 } and { bad_function is None }) {
                Result::Ok(())
            } else {
                Result::Err(EmissionError::InvalidEffectInstruction(
                    function_id, checked_u32(index), EffectInstructionValidationError::SharedClauseFunctions
                ))
            }
        }
    } else if(*instruction is MirInstruction::Perform(
        target, protocol, operation, payloads
    )) {
        if(Id::to_usize(protocol)
            >= super::lowering::mir_program_protocol_count(program)) {
            Result::Err(EmissionError::InvalidEffectInstruction(
                function_id, checked_u32(index), EffectInstructionValidationError::UnknownProtocol
            ))
        } else if(not(function_declares_protocol(function, Id::to_u32(protocol), 0))) {
            Result::Err(EmissionError::InvalidEffectInstruction(
                function_id,
                checked_u32(index),
                EffectInstructionValidationError::FunctionEffectRow
            ))
        } else {
            let protocol_value = super::lowering::mir_program_protocol_at(
                program, protocol
            );
            if(usize_from_u32(operation)
                >= super::lowering::mir_protocol_operation_count(protocol_value)) {
                Result::Err(EmissionError::InvalidEffectInstruction(
                    function_id, checked_u32(index), EffectInstructionValidationError::UnknownOperation
                ))
            } else {
                let operation_value =
                    super::lowering::mir_protocol_operation_at(
                        protocol_value, usize_from_u32(operation)
                    );
                let expected =
                    super::lowering::mir_signature_parameter_count(
                        super::lowering::mir_operation_payload_signature(
                            operation_value
                        )
                    );
                let found = usize_from_u32(
                    super::lowering::register_pack_count(
                        super::lowering::mir_function_register_pack(
                            function, payloads
                        )
                    )
                );
                let terminal =
                    super::lowering::mir_operation_terminal(operation_value);
                let destination_valid = if(terminal) {
                    target is None
                } else { target is Option::Some(_) };
                let control_valid = if(terminal) {
                    super::lowering::mir_function_instruction_ends_block(
                        function, index
                    )
                } else { true };
                if(expected != found) {
                    Result::Err(EmissionError::InvalidEffectInstruction(
                        function_id, checked_u32(index), EffectInstructionValidationError::PerformContract
                    ))
                } else if(not(destination_valid)) {
                    Result::Err(EmissionError::InvalidEffectInstruction(
                        function_id, checked_u32(index), EffectInstructionValidationError::PerformContract
                    ))
                } else if(not(control_valid)) {
                    Result::Err(EmissionError::InvalidEffectInstruction(
                        function_id, checked_u32(index), EffectInstructionValidationError::PerformContract
                    ))
                } else { Result::Ok(()) }
            }
        }
    } else if(*instruction is MirInstruction::TailResume(_, mode, _)) {
        if(mode <= 2 and {
            super::lowering::mir_function_instruction_ends_block(
                function, index
            )
        }) { Result::Ok(()) } else {
            Result::Err(EmissionError::InvalidEffectInstruction(
                function_id, checked_u32(index), EffectInstructionValidationError::TailResumeControl
            ))
        }
    } else if(*instruction is MirInstruction::Resume(_, _, mode, _)) {
        if(mode <= 2) { Result::Ok(()) } else {
            Result::Err(EmissionError::InvalidEffectInstruction(
                function_id, checked_u32(index), EffectInstructionValidationError::ReceiverMode
            ))
        }
    } else { Result::Ok(()) }
}

function_declares_protocol(
    function: &super::lowering::MirFunction,
    protocol: u32,
    index: usize
) -> Bool {
    if(index < super::lowering::mir_function_outward_protocol_count(function)) {
        if(super::lowering::mir_function_outward_protocol_at(
            function, index
        ) == protocol) { true } else {
            function_declares_protocol(function, protocol, index + 1)
        }
    } else { false }
}

validate_effect_instructions(
    program: &super::lowering::MirProgram,
    function_index: usize
) -> Result<(), EmissionError> {
    try_for_range(Range::new(
        function_index,
        super::lowering::mir_program_function_count(program)
    ), { current => {
        let id = super::lowering::mir_function_id_from_usize(current);
        let function = super::lowering::mir_program_function_at(program, id);
        if(not(valid_function_effect_row(program, function, 0, None))) {
            Result::Err(EmissionError::InvalidEffectInstruction(
                id,
                0,
                EffectInstructionValidationError::FunctionEffectRow
            ))
        } else {
            try_for_range(Range::new(
                0,
                super::lowering::mir_function_instruction_count(function)
            ), { instruction => validate_effect_instruction(
                program, id, function, instruction
            ) })
        }
    } })
}

valid_function_effect_row(
    program: &super::lowering::MirProgram,
    function: &super::lowering::MirFunction,
    index: usize,
    previous: Option<u32>
) -> Bool {
    if(index < super::lowering::mir_function_outward_protocol_count(function)) {
        let protocol = super::lowering::mir_function_outward_protocol_at(
            function, index
        );
        if(usize_from_u32(protocol)
            >= super::lowering::mir_program_protocol_count(program)) {
            false
        } else {
            handle previous {
                None => valid_function_effect_row(
                    program, function, index + 1, Option::Some(protocol)
                ),
                Option::Some(found) => if(found < protocol) {
                    valid_function_effect_row(
                        program, function, index + 1,
                        Option::Some(protocol)
                    )
                } else { false }
            }
        }
    } else { true }
}

pub encode(
    program: &super::lowering::MirProgram,
    entry: Option<super::lowering::MirFunctionId>
) -> Result<Bytes, EmissionError> {
    let context = new_emission_context(program);
    try(validate_protocols(program, 0), @encode);
    try(validate_handler_definitions(program, 0), @encode);
    try(validate_effect_instructions(program, 0), @encode);
    let signature_table_records = Vec::new();
    signature_records(
        &context.signatures,
        0,
        &mut signature_table_records
    );

    let constant_table_records = Vec::new();
    constant_records(
        &context.constants,
        0,
        &mut constant_table_records
    );

    let protocol_table_records = Vec::new();
    protocol_records(
        program,
        &context.names,
        &context.signatures,
        &mut protocol_table_records
    );
    let handler_definition_table_records = Vec::new();
    handler_definition_records(
        program,
        &context.signatures,
        &mut handler_definition_table_records
    );

    let code = ByteBuf::new();
    try(write_context_code(&mut context, &mut code), @encode);

    let cleanups = ByteBuf::new();
    write_context_cleanups(&mut context, &mut cleanups);
    let operand_bytes = ByteBuf::new();
    write_operand_words(&context.operands, 0, &mut operand_bytes);
    let functions = ByteBuf::new();
    try(write_context_functions(&context, &mut functions), @encode);
    let imports = ByteBuf::new();
    try(write_host_imports(
        context.program,
        &context.names,
        &context.signatures,
        0,
        &mut imports
    ), @encode);
    let code_count = checked_u32(ByteBuf::len(&code) / 4);
    let code_bytes = ByteBuf::finish(code);
    let cleanup_count =
        checked_u32(ByteBuf::len(&cleanups) / 24);
    let cleanup_bytes = ByteBuf::finish(cleanups);
    let types = try(type_section(
        context.program,
        &context.names
    ), @encode);

    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Strings,
        super::artifact::sorted_string_section(&context.names.values)
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Constants,
        super::artifact::variable_section(&constant_table_records)
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Types,
        types
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Signatures,
        super::artifact::variable_section(&signature_table_records)
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Imports,
        super::artifact::section(
            ByteBuf::finish(imports),
            host_import_count(context.program)
        )
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Protocols,
        super::artifact::variable_section(&protocol_table_records)
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::HandlerDefinitions,
        super::artifact::variable_section(
            &handler_definition_table_records
        )
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Functions,
        super::artifact::section(
            ByteBuf::finish(functions),
            checked_u32(
                super::lowering::mir_program_function_count(context.program)
            )
        )
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Code,
        super::artifact::section(
            code_bytes,
            code_count
        )
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Operands,
        super::artifact::section(
            ByteBuf::finish(operand_bytes),
            checked_u32(Vec::len(&context.operands))
        )
    );
    super::artifact::set_section(
        &mut context.writer,
        super::artifact::SectionId::Cleanups,
        super::artifact::section(
            cleanup_bytes,
            cleanup_count
        )
    );
    let raw_entry = Option::map(entry, {
        found => super::lowering::mir_function_raw(found)
    });
    let handler_features = if(
        super::lowering::mir_program_protocol_count(context.program) == 0
        and {
            super::lowering::mir_program_handler_definition_count(
                context.program
            ) == 0
        }
        and { not(program_has_effect_instruction(context.program, 0)) }
    ) {
            0
    } else { 8 };
    let host_features = if(host_import_count(context.program) == 0) {
        0
    } else { 32 };
    let required_features = 1
        + wrapping_convert_to_u64(handler_features)
        + wrapping_convert_to_u64(host_features);
    handle super::artifact::encode_writer(
        &context.writer,
        raw_entry,
        required_features
    ) {
        Result::Err(error) =>
            Result::Err(EmissionError::ArtifactWrite(error)),
        Result::Ok(bytes) => Result::Ok(bytes)
    }
}
