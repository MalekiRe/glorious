// Canonical assembly of straight-line Stage-A bytecode into GRBC sections.

use super::lowering::StageInstruction;

struct FunctionSpans {
    code_start: u32,
    code_length: u32,
    cleanup_start: u32,
    cleanup_count: u32
}

pub enum EmissionError {
    MissingConstant(super::lowering::RegisterId),
    UnsupportedInstruction,
    MissingName(EmissionName),
    MissingSignature(super::lowering::StageFunctionId),
    StructFieldNameCount(
        super::lowering::StageTypeId,
        usize,
        usize
    ),
    VariantFieldNameCount(
        super::lowering::StageTypeId,
        usize,
        usize,
        usize
    ),
    UnsupportedType(super::lowering::StageTypeId, u8),
    ArtifactWrite(super::artifact::ArtifactWriteError)
}

pub enum EmissionName {
    Type(super::lowering::StageTypeId),
    StructField(super::lowering::StageTypeId, usize),
    Variant(super::lowering::StageTypeId, usize),
    VariantField(super::lowering::StageTypeId, usize, usize),
    Function(super::lowering::StageFunctionId)
}

require_program_name(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    name_index: u32,
    origin: EmissionName
) -> Result<u32, EmissionError> {
    require_name_value(
        names,
        *super::lowering::stage_program_type_name_at(
            program,
            usize_from_u32(name_index)
        ),
        origin
    )
}

checked_u32(value: usize) -> u32 {
    handle checked_usize_to_u32(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

usize_from_u32(value: u32) -> usize {
    wrapping_convert_to_usize(value)
}

copy_bytes_after(
    source: &Vec<u8>,
    index: usize,
    output: &mut Vec<u8>
) {
    for_range(Range::new(index, Vec::len(source)), { current =>
        Vec::push(&mut *output, *Vec::index(source, current))
    })
}

constant_records(
    program: &super::lowering::StageProgram,
    index: usize,
    output: &mut Vec<super::artifact::Record>
) {
    if(index < super::lowering::stage_program_constant_count(program)) {
        let key = super::lowering::stage_program_constant_at(
            program,
            super::lowering::stage_constant_id_from_usize(index)
        );
        let payload = Vec::new();
        copy_bytes_after(key, 1, &mut payload);
        Vec::push(
            &mut *output,
            super::artifact::record(
                *Vec::index(key, 0),
                0,
                Bytes::from_vec(payload)
            )
        );
        constant_records(program, index + 1, output)
    } else { () }
}

find_constant(
    program: &super::lowering::StageProgram,
    key: &Vec<u8>,
    index: usize
) -> Option<super::lowering::StageConstantId> {
    if(index < super::lowering::stage_program_constant_count(program)) {
        if(Eq::eq(
            super::lowering::stage_program_constant_at(
                program,
                super::lowering::stage_constant_id_from_usize(index)
            ),
            key
        )) {
            Option::Some(
                super::lowering::stage_constant_id_from_usize(index)
            )
        } else {
            find_constant(program, key, index + 1)
        }
    } else { None }
}

collect_names(
    program: &super::lowering::StageProgram,
    index: usize,
    output: &mut Vec<String>
) {
    let end = super::lowering::stage_program_function_count(program);
    for_range(Range::new(index, end), { current =>
        Vec::push(
            &mut *output,
            *super::lowering::stage_function_name(
                super::lowering::stage_program_function_at(
                    program,
                    super::lowering::stage_function_id_from_usize(current)
                )
            )
        )
    })
}

collect_stage_field_names(
    program: &super::lowering::StageProgram,
    stage_type: &super::lowering::StageType,
    index: usize,
    output: &mut Vec<String>
) {
    if(index <
        super::lowering::stage_type_field_name_count(stage_type)
    ) {
        Vec::push(
            &mut *output,
            *super::lowering::stage_program_type_name_at(
                program,
                usize_from_u32(
                    super::lowering::stage_type_field_name_index_at(
                        stage_type,
                        index
                    )
                )
            )
        );
        collect_stage_field_names(
            program,
            stage_type,
            index + 1,
            output
        )
    } else { () }
}

collect_stage_variant_field_names(
    program: &super::lowering::StageProgram,
    variant: &super::lowering::StageVariant,
    index: usize,
    output: &mut Vec<String>
) {
    if(index <
        super::lowering::stage_variant_field_name_count(variant)
    ) {
        Vec::push(
            &mut *output,
            *super::lowering::stage_program_type_name_at(
                program,
                usize_from_u32(
                    super::lowering::stage_variant_field_name_index_at(
                        variant,
                        index
                    )
                )
            )
        );
        collect_stage_variant_field_names(
            program,
            variant,
            index + 1,
            output
        )
    } else { () }
}

collect_stage_variant_names(
    program: &super::lowering::StageProgram,
    type_index: usize,
    index: usize,
    output: &mut Vec<String>
) {
    if(index <
        super::lowering::stage_program_type_variant_count_at(
            program,
            type_index
        )
    ) {
        let variant =
            super::lowering::stage_program_type_variant_at(
                program,
                type_index,
                index
            );
        Vec::push(
            &mut *output,
            *super::lowering::stage_program_type_name_at(
                program,
                usize_from_u32(
                    super::lowering::stage_variant_name_index(variant)
                )
            )
        );
        collect_stage_variant_field_names(
            program,
            variant,
            0,
            output
        );
        collect_stage_variant_names(
            program,
            type_index,
            index + 1,
            output
        )
    } else { () }
}

collect_type_names(
    program: &super::lowering::StageProgram,
    index: usize,
    output: &mut Vec<String>
) {
    if(index < super::lowering::stage_program_type_count(program)) {
        let stage_type =
            super::lowering::stage_program_type_at(
                program,
                super::lowering::stage_type_id_from_usize(index)
            );
        let tag = super::lowering::stage_type_tag(stage_type);
        if(tag == 1 or { tag == 2 }) {
            Vec::push(
                &mut *output,
                *super::lowering::stage_program_type_name_at(
                    program,
                    usize_from_u32(
                        super::lowering::stage_type_name_index(stage_type)
                    )
                )
            );
            if(tag == 1) {
                collect_stage_field_names(program, stage_type, 0, output)
            } else {
                collect_stage_variant_names(program, index, 0, output)
            }
        } else {
            ()
        };
        collect_type_names(
            program,
            index + 1,
            output
        )
    } else { () }
}

aggregate_zero_sized_flag(
    program: &super::lowering::StageProgram,
    fields: &Vec<super::lowering::ArtifactTypeId>,
    index: usize
) -> u32 {
    if(index < Vec::len(fields)) {
        if(type_zero_sized_flag(
            program,
            *Vec::index(fields, index)
        ) == 2) {
            aggregate_zero_sized_flag(
                program,
                fields,
                index + 1
            )
        } else { 0 }
    } else { 2 }
}

enum_variants_zero_sized_flag(
    program: &super::lowering::StageProgram,
    stage_type: &super::lowering::StageType,
    index: usize
) -> u32 {
    if(index < super::lowering::stage_type_variant_count(stage_type)) {
        if(aggregate_zero_sized_flag(
            program,
            super::lowering::stage_variant_fields(
                super::lowering::stage_type_variant_at(stage_type, index)
            ),
            0
        ) == 2) {
            enum_variants_zero_sized_flag(
                program,
                stage_type,
                index + 1
            )
        } else { 0 }
    } else { 2 }
}

type_zero_sized_flag(
    program: &super::lowering::StageProgram,
    type_id: super::lowering::ArtifactTypeId
) -> u32 {
    let raw = super::lowering::artifact_type_raw(type_id);
    if(raw < 19) {
        if(raw == 0) {
            2
        } else {
            if(raw == 1) { 2 } else { 0 }
        }
    } else {
        let stage_type =
            super::lowering::stage_program_type_at(
                program,
                super::lowering::stage_type_id_from_usize(
                    usize_from_u32(raw - 19)
                )
            );
        if(super::lowering::stage_type_tag(stage_type) == 2) {
            if(super::lowering::stage_type_variant_count(stage_type) <= 1) {
                enum_variants_zero_sized_flag(program, stage_type, 0)
            } else { 0 }
        } else {
            aggregate_zero_sized_flag(
                program,
                super::lowering::stage_type_fields(stage_type),
                0
            )
        }
    }
}

aggregate_zero_use_flag(
    program: &super::lowering::StageProgram,
    fields: &Vec<super::lowering::ArtifactTypeId>,
    index: usize
) -> u32 {
    if(index < Vec::len(fields)) {
        if(type_zero_use_flag(
            program,
            *Vec::index(fields, index)
        ) == 16) {
            aggregate_zero_use_flag(
                program,
                fields,
                index + 1
            )
        } else { 0 }
    } else { 16 }
}

enum_variants_zero_use_flag(
    program: &super::lowering::StageProgram,
    stage_type: &super::lowering::StageType,
    index: usize
) -> u32 {
    if(index < super::lowering::stage_type_variant_count(stage_type)) {
        if(aggregate_zero_use_flag(
            program,
            super::lowering::stage_variant_fields(
                super::lowering::stage_type_variant_at(stage_type, index)
            ),
            0
        ) == 16) {
            enum_variants_zero_use_flag(
                program,
                stage_type,
                index + 1
            )
        } else { 0 }
    } else { 16 }
}

type_zero_use_flag(
    program: &super::lowering::StageProgram,
    type_id: super::lowering::ArtifactTypeId
) -> u32 {
    let raw = super::lowering::artifact_type_raw(type_id);
    if(raw < 19) {
        if(raw == 1) { 0 } else { 16 }
    } else {
        let stage_type =
            super::lowering::stage_program_type_at(
                program,
                super::lowering::stage_type_id_from_usize(
                    usize_from_u32(raw - 19)
                )
            );
        if(super::lowering::stage_type_tag(stage_type) == 2) {
            enum_variants_zero_use_flag(program, stage_type, 0)
        } else {
            aggregate_zero_use_flag(
                program,
                super::lowering::stage_type_fields(stage_type),
                0
            )
        }
    }
}

write_type_fields(
    output: &mut ByteBuf,
    program: &super::lowering::StageProgram,
    type_index: usize,
    field_index: usize
) {
    let end =
        super::lowering::stage_program_type_field_count_at(program, type_index);
    for_range(Range::new(field_index, end), { current =>
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::artifact_type_raw(
                super::lowering::stage_program_type_field_type_at(
                    program,
                    type_index,
                    current
                )
            )
        )
    })
}

write_named_type_fields(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    type_index: usize,
    field_index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    let end =
        super::lowering::stage_program_type_field_count_at(program, type_index);
    let type_id =
        super::lowering::stage_type_id_from_usize(type_index);
    try_for_range(Range::new(field_index, end), { current =>
        handle require_program_name(
            program,
            names,
            super::lowering::stage_program_type_field_name_index_at(
                program,
                type_index,
                current
            ),
            EmissionName::StructField(type_id, current)
        ) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(field_name) => {
                ByteBuf::write_u32_le(&mut *output, field_name);
                ByteBuf::write_u32_le(
                    &mut *output,
                    super::lowering::artifact_type_raw(
                        super::lowering::stage_program_type_field_type_at(
                            program,
                            type_index,
                            current
                        )
                    )
                );
                Result::Ok(())
            }
        }
    })
}

custom_type_flags(
    program: &super::lowering::StageProgram,
    index: usize
) -> u32 {
    let type_id = super::lowering::stage_type_artifact_id(
        super::lowering::stage_type_id_from_usize(index)
    );
    super::lowering::stage_program_type_copy_flag_at(program, index)
        + type_zero_sized_flag(program, type_id)
        + type_zero_use_flag(program, type_id)
}

tuple_type_record(
    program: &super::lowering::StageProgram,
    index: usize
) -> super::artifact::Record {
    let payload = ByteBuf::new();
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(
            super::lowering::
                stage_program_type_field_count_at(program, index)
        )
    );
    write_type_fields(&mut payload, program, index, 0);
    super::artifact::record(
        32,
        wrapping_convert_to_u8(custom_type_flags(program, index)),
        ByteBuf::finish(payload)
    )
}

valid_struct_type_record(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    index: usize
) -> Result<super::artifact::Record, EmissionError> {
    let type_id = super::lowering::stage_type_artifact_id(
        super::lowering::stage_type_id_from_usize(index)
    );
    let type_name = try(require_program_name(
        program,
        names,
        super::lowering::stage_program_type_name_index_at(
            program,
            index
        ),
        EmissionName::Type(
            super::lowering::stage_type_id_from_usize(index)
        )
    ), @valid_struct_type_record);
    let payload = ByteBuf::new();
    ByteBuf::write_u32_le(&mut payload, type_name);
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(
            super::lowering::
                stage_program_type_field_count_at(program, index)
        )
    );
    try(write_named_type_fields(
        program,
        names,
        index,
        0,
        &mut payload
    ), @valid_struct_type_record);
    let payload_bytes = ByteBuf::finish( payload);
    Result::Ok(super::artifact::record(
        34,
        wrapping_convert_to_u8(custom_type_flags(program, index)),
        payload_bytes
    ))
}

struct_type_record(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    index: usize
) -> Result<super::artifact::Record, EmissionError> {
    if(
        super::lowering::stage_program_type_field_name_count_at(
            program,
            index
        ) == super::lowering::stage_program_type_field_count_at(
            program,
            index
        )
    ) {
        valid_struct_type_record(program, names, index)
    } else {
        Result::Err(EmissionError::StructFieldNameCount(
            super::lowering::stage_type_id_from_usize(index),
            super::lowering::stage_program_type_field_count_at(
                program,
                index
            ),
            super::lowering::stage_program_type_field_name_count_at(
                program,
                index
            )
        ))
    }
}

write_enum_variant_fields(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    variant: &super::lowering::StageVariant,
    type_id: super::lowering::StageTypeId,
    variant_index: usize,
    index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    let end = super::lowering::stage_variant_field_count(variant);
    try_for_range(Range::new(index, end), { current =>
        handle require_program_name(
            program,
            names,
            super::lowering::stage_variant_field_name_index_at(
                variant,
                current
            ),
            EmissionName::VariantField(
                type_id,
                variant_index,
                current
            )
        ) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(field_name) => {
                ByteBuf::write_u32_le(&mut *output, field_name);
                ByteBuf::write_u32_le(
                    &mut *output,
                    super::lowering::artifact_type_raw(
                        super::lowering::stage_variant_field_type_at(
                            variant,
                            current
                        )
                    )
                );
                Result::Ok(())
            }
        }
    })
}

write_enum_variants(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    type_index: usize,
    index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    if(index <
        super::lowering::stage_program_type_variant_count_at(
            program,
            type_index
        )
    ) {
        let type_id =
            super::lowering::stage_type_id_from_usize(type_index);
        let variant =
            super::lowering::stage_program_type_variant_at(
                program,
                type_index,
                index
            );
        if(
            super::lowering::stage_variant_field_name_count(variant)
                == super::lowering::stage_variant_field_count(variant)
        ) {
            let variant_name = try(require_program_name(
                program,
                names,
                super::lowering::stage_variant_name_index(variant),
                EmissionName::Variant(type_id, index)
            ), @write_enum_variants);
            ByteBuf::write_u32_le(&mut *output, variant_name);
            ByteBuf::write_u32_le(
                &mut *output,
                checked_u32(
                    super::lowering::stage_variant_field_count(variant)
                )
            );
            try(write_enum_variant_fields(
                program,
                names,
                variant,
                type_id,
                index,
                0,
                output
            ), @write_enum_variants);
            write_enum_variants(
                program,
                names,
                type_index,
                index + 1,
                output
            )
        } else {
            Result::Err(EmissionError::VariantFieldNameCount(
                type_id,
                index,
                super::lowering::stage_variant_field_count(variant),
                super::lowering::stage_variant_field_name_count(variant)
            ))
        }
    } else {
        Result::Ok(())
    }
}

enum_type_record(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    index: usize
) -> Result<super::artifact::Record, EmissionError> {
    let type_id = super::lowering::stage_type_artifact_id(
        super::lowering::stage_type_id_from_usize(index)
    );
    let type_name = try(require_program_name(
        program,
        names,
        super::lowering::stage_program_type_name_index_at(
            program,
            index
        ),
        EmissionName::Type(
            super::lowering::stage_type_id_from_usize(index)
        )
    ), @enum_type_record);
    let payload = ByteBuf::new();
    ByteBuf::write_u32_le(&mut payload, type_name);
    ByteBuf::write_u32_le(
        &mut payload,
        checked_u32(
            super::lowering::stage_program_type_variant_count_at(
                program,
                index
            )
        )
    );
    try(write_enum_variants(
        program,
        names,
        index,
        0,
        &mut payload
    ), @enum_type_record);
    Result::Ok(super::artifact::record(
        35,
        wrapping_convert_to_u8(custom_type_flags(program, index)),
        ByteBuf::finish(payload)
    ))
}

custom_type_record(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    index: usize
) -> Result<super::artifact::Record, EmissionError> {
    let tag = super::lowering::stage_program_type_tag_at(program, index);
    handle tag {
        0 => Result::Ok(tuple_type_record(program, index)),
        1 => struct_type_record(program, names, index),
        2 => enum_type_record(program, names, index),
        _ => Result::Err(EmissionError::UnsupportedType(
            super::lowering::stage_type_id_from_usize(index),
            tag
        ))
    }
}

custom_type_records(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    index: usize,
    output: &mut Vec<super::artifact::Record>
) -> Result<(), EmissionError> {
    let end = super::lowering::stage_program_type_count(program);
    try_for_range(Range::new(index, end), { current =>
        handle custom_type_record(program, names, current) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(record) => {
                Vec::push(&mut *output, record);
                Result::Ok(())
            }
        }
    })
}

type_section(
    program: &super::lowering::StageProgram,
    names: &Vec<String>
) -> Result<super::artifact::Section, EmissionError> {
    let records = Vec::new();
    super::artifact::append_predefined_scalar_records(&mut records);
    try(custom_type_records(
        program,
        names,
        0,
        &mut records
    ), @type_section);
    Result::Ok(super::artifact::variable_section(&records))
}

find_name(names: &Vec<String>, name: &String, index: usize) -> Option<u32> {
    if(index < Vec::len(names)) {
        if(String::eq(Vec::index(names, index), name)) {
            Option::Some(checked_u32(index))
        } else {
            find_name(names, name, index + 1)
        }
    } else { None }
}

require_name(
    names: &Vec<String>,
    name: &String,
    origin: EmissionName
) -> Result<u32, EmissionError> {
    handle find_name(names, name, 0) {
        Result::Err(_) =>
            Result::Err(EmissionError::MissingName(origin)),
        Result::Ok(found) => Result::Ok(found)
    }
}

find_name_value(
    names: &Vec<String>,
    name: String,
    index: usize
) -> Option<u32> {
    if(index < Vec::len(names)) {
        if(String::eq(Vec::index(names, index), &name)) {
            Option::Some(checked_u32(index))
        } else {
            find_name_value(names, name, index + 1)
        }
    } else { None }
}

require_name_value(
    names: &Vec<String>,
    name: String,
    origin: EmissionName
) -> Result<u32, EmissionError> {
    handle find_name_value(names, name, 0) {
        Result::Err(_) =>
            Result::Err(EmissionError::MissingName(origin)),
        Result::Ok(found) => Result::Ok(found)
    }
}

signature_key(
    function: &super::lowering::StageFunction
) -> Vec<u32> {
    let output = Vec::new();
    Vec::push(
        &mut output,
        checked_u32(
            super::lowering::stage_function_parameter_count(function)
        )
    );
    Vec::push(
        &mut output,
        super::lowering::artifact_type_raw(
            super::lowering::stage_function_result(function)
        )
    );
    Vec::push(&mut output, 0);
    append_parameter_types(function, 0, &mut output);
    output
}

append_parameter_types(
    function: &super::lowering::StageFunction,
    index: usize,
    output: &mut Vec<u32>
) {
    let end = super::lowering::stage_function_parameter_count(function);
    for_range(Range::new(index, end), { current =>
        Vec::push(
            &mut *output,
            super::lowering::artifact_type_raw(
                super::lowering::stage_function_parameter_at(
                    function,
                    current
                )
            )
        )
    })
}

find_signature(
    signatures: &Vec<Vec<u32>>,
    key: &Vec<u32>,
    index: usize
) -> Option<u32> {
    if(index < Vec::len(signatures)) {
        if(Eq::eq(Vec::index(signatures, index), key)) {
            Option::Some(checked_u32(index))
        } else {
            find_signature(signatures, key, index + 1)
        }
    } else { None }
}

require_signature(
    signatures: &Vec<Vec<u32>>,
    key: &Vec<u32>,
    function: super::lowering::StageFunctionId
) -> Result<u32, EmissionError> {
    handle find_signature(signatures, key, 0) {
        Result::Err(_) =>
            Result::Err(EmissionError::MissingSignature(function)),
        Result::Ok(found) => Result::Ok(found)
    }
}

collect_signatures(
    program: &super::lowering::StageProgram,
    index: usize,
    output: &mut Vec<Vec<u32>>
) {
    if(index < super::lowering::stage_program_function_count(program)) {
        let key = signature_key(
            super::lowering::stage_program_function_at(
                program,
                super::lowering::stage_function_id_from_usize(index)
            )
        );
        handle find_signature(output, &key, 0) {
            Result::Err(_) => Vec::push(&mut *output, key),
            Result::Ok(_) => {
                key;
                ()
            }
        };
        collect_signatures(program, index + 1, output)
    } else { () }
}

write_words(
    output: &mut ByteBuf,
    words: &Vec<u32>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(words)), { current =>
        ByteBuf::write_u32_le(&mut *output, *Vec::index(words, current))
    })
}

signature_records(
    signatures: &Vec<Vec<u32>>,
    index: usize,
    output: &mut Vec<super::artifact::Record>
) {
    if(index < Vec::len(signatures)) {
        let payload = ByteBuf::new();
        write_words(
            &mut payload,
            Vec::index(signatures, index),
            0
        );
        Vec::push(
            &mut *output,
            super::artifact::record(
                0,
                0,
                ByteBuf::finish(payload)
            )
        );
        signature_records(
            signatures,
            index + 1,
            output
        )
    } else { () }
}

byte_at(bytes: &Bytes, index: usize) -> u32 {
    handle Bytes::get(bytes, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => wrapping_convert_to_u32(found)
    }
}

append_arguments(
    arguments: &super::lowering::RegisterPack,
    ordinal: u32,
    output: &mut Vec<u32>
) {
    let count = super::lowering::register_pack_count(arguments);
    if(ordinal < count) {
        Vec::push(
            &mut *output,
            super::lowering::register_raw(
                super::lowering::register_pack_at(
                    arguments,
                    usize_from_u32(ordinal)
                )
            )
        );
        append_arguments(
            arguments,
            ordinal + 1,
            output
        )
    } else { () }
}

write_instruction(
    program: &super::lowering::StageProgram,
    stage_function: &super::lowering::StageFunction,
    instruction: &StageInstruction,
    code: &mut ByteBuf,
    operands: &mut Vec<u32>
) -> Result<(), EmissionError> {
    if(*instruction is StageInstruction::Const(target, key)) {
        let target_raw = super::lowering::register_raw(target);
        let words = Bytes::to_vec(key);
        handle find_constant(program, &words, 0) {
            Result::Err(_) =>
                Result::Err(EmissionError::MissingConstant(target)),
            Result::Ok(constant) => {
                ByteBuf::write_u32_le(&mut *code, 8193);
                ByteBuf::write_u32_le(&mut *code, target_raw);
                ByteBuf::write_u32_le(
                    code,
                    super::lowering::stage_constant_raw(constant)
                );
                Result::Ok(())
            }
        }
    } else if(*instruction is StageInstruction::Move(target, source)) {
        ByteBuf::write_u32_le(&mut *code, 8194);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_raw(source)
        );
        Result::Ok(())
    } else if(*instruction is StageInstruction::Copy(target, source)) {
        ByteBuf::write_u32_le(&mut *code, 8195);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_raw(source)
        );
        Result::Ok(())
    } else if(*instruction is StageInstruction::Construct(
        target,
        ty,
        variant,
        fields_id
    )) {
        let fields = super::lowering::stage_function_register_pack(
            stage_function,
            fields_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(fields, 0, operands);
        ByteBuf::write_u32_le(&mut *code, 20489);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::artifact_type_raw(ty)
        );
        ByteBuf::write_u32_le(
            &mut *code,
            handle variant {
                Result::Err(_) => 4294967295,
                Result::Ok(found) => found
            }
        );
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_pack_count(fields)
        );
        Result::Ok(())
    } else if(*instruction is StageInstruction::ProjectCopy(
        target,
        source,
        field
    )) {
        ByteBuf::write_u32_le(&mut *code, 12299);
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(target)
        );
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::register_raw(source)
        );
        ByteBuf::write_u32_le(code, field);
        Result::Ok(())
    } else if(*instruction is StageInstruction::Drop(register)) {
        ByteBuf::write_u32_le(&mut *code, 4113);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_raw(register)
        );
        Result::Ok(())
    } else if(*instruction is StageInstruction::Call(
        target,
        function,
        arguments_id
    )) {
        let arguments = super::lowering::stage_function_register_pack(
            stage_function,
            arguments_id
        );
        let start = checked_u32(Vec::len(&*operands));
        append_arguments(arguments, 0, operands);
        ByteBuf::write_u32_le(&mut *code, 16418);
        ByteBuf::write_u32_le(
            &mut *code,
            handle target {
                Result::Err(_) => 4294967295,
                Result::Ok(found) =>
                    super::lowering::register_raw(found)
            }
        );
        ByteBuf::write_u32_le(
            &mut *code,
            super::lowering::stage_function_raw(function)
        );
        ByteBuf::write_u32_le(&mut *code, start);
        ByteBuf::write_u32_le(
            code,
            super::lowering::register_pack_count(arguments)
        );
        Result::Ok(())
    } else if(*instruction is StageInstruction::Return(source)) {
        ByteBuf::write_u32_le(&mut *code, 4134);
        ByteBuf::write_u32_le(
            code,
            handle source {
                Result::Err(_) => 4294967295,
                Result::Ok(found) =>
                    super::lowering::register_raw(found)
            }
        );
        Result::Ok(())
    } else {
        Result::Err(EmissionError::UnsupportedInstruction)
    }
}

write_function_code(
    program: &super::lowering::StageProgram,
    function: &super::lowering::StageFunction,
    index: usize,
    code: &mut ByteBuf,
    operands: &mut Vec<u32>
) -> Result<(), EmissionError> {
    let end = super::lowering::stage_function_instruction_count(function);
    try_for_range(Range::new(index, end), { current =>
        write_instruction(
            program,
            function,
            super::lowering::stage_function_instruction_at(
                function,
                current
            ),
            code,
            operands
        )
    })
}

write_all_code(
    program: &super::lowering::StageProgram,
    index: usize,
    code: &mut ByteBuf,
    operands: &mut Vec<u32>,
    spans: &mut Vec<FunctionSpans>
) -> Result<(), EmissionError> {
    if(index < super::lowering::stage_program_function_count(program)) {
        let function =
            super::lowering::stage_program_function_at(
                program,
                super::lowering::stage_function_id_from_usize(index)
            );
        let start = checked_u32(ByteBuf::len(&*code) / 4);
        try(write_function_code(
            program,
            function,
            0,
            code,
            operands
        ), @write_all_code);
        let end = checked_u32(ByteBuf::len(&*code) / 4);
        Vec::push(&mut *spans, FunctionSpans {
            code_start: start,
            code_length: end - start,
            cleanup_start: 0,
            cleanup_count: 0
        });
        write_all_code(
            program,
            index + 1,
            code,
            operands,
            spans
        )
    } else { Result::Ok(()) }
}

append_cleanup_registers(
    cleanup: &super::lowering::StageCleanup,
    index: usize,
    operands: &mut Vec<u32>
) {
    let end = super::lowering::stage_cleanup_register_count(cleanup);
    for_range(Range::new(index, end), { current =>
        Vec::push(
            &mut *operands,
            super::lowering::register_raw(
                super::lowering::stage_cleanup_register_at(
                    cleanup,
                    current
                )
            )
        )
    })
}

write_function_cleanups(
    function: &super::lowering::StageFunction,
    function_id: u32,
    index: usize,
    output: &mut ByteBuf,
    operands: &mut Vec<u32>
) {
    if(index < super::lowering::stage_function_cleanup_count(function)) {
        let cleanup =
            super::lowering::stage_function_cleanup_at(function, index);
        let operand_start = checked_u32(Vec::len(&*operands));
        append_cleanup_registers(cleanup, 0, operands);
        ByteBuf::write_u32_le(&mut *output, function_id);
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::stage_cleanup_first(cleanup)
        );
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::stage_cleanup_end(cleanup)
        );
        ByteBuf::write_u32_le(&mut *output, operand_start);
        ByteBuf::write_u32_le(
            &mut *output,
            checked_u32(
                super::lowering::stage_cleanup_register_count(cleanup)
            )
        );
        ByteBuf::write_u32_le(&mut *output, 0);
        write_function_cleanups(
            function,
            function_id,
            index + 1,
            output,
            operands
        )
    } else { () }
}

write_all_cleanups(
    program: &super::lowering::StageProgram,
    index: usize,
    output: &mut ByteBuf,
    operands: &mut Vec<u32>,
    spans: &mut Vec<FunctionSpans>
) {
    if(index < super::lowering::stage_program_function_count(program)) {
        let function =
            super::lowering::stage_program_function_at(
                program,
                super::lowering::stage_function_id_from_usize(index)
            );
        let start = checked_u32(ByteBuf::len(&*output) / 24);
        write_function_cleanups(
            function,
            checked_u32(index),
            0,
            output,
            operands
        );
        let end = checked_u32(ByteBuf::len(&*output) / 24);
        set_cleanup_span(spans, index, start, end - start);
        write_all_cleanups(
            program,
            index + 1,
            output,
            operands,
            spans
        )
    } else { () }
}

set_cleanup_span(
    spans: &mut Vec<FunctionSpans>,
    index: usize,
    start: u32,
    count: u32
) {
    let span = Vec::index_mut(&mut *spans, index);
    (*span).cleanup_start = start;
    (*span).cleanup_count = count;
    ()
}

write_operand_words(
    operands: &Vec<u32>,
    index: usize,
    output: &mut ByteBuf
) {
    for_range(Range::new(index, Vec::len(operands)), { current =>
        ByteBuf::write_u32_le(&mut *output, *Vec::index(operands, current))
    })
}

write_functions(
    program: &super::lowering::StageProgram,
    names: &Vec<String>,
    signatures: &Vec<Vec<u32>>,
    spans: &Vec<FunctionSpans>,
    index: usize,
    output: &mut ByteBuf
) -> Result<(), EmissionError> {
    if(index < super::lowering::stage_program_function_count(program)) {
        let function =
            super::lowering::stage_program_function_at(
                program,
                super::lowering::stage_function_id_from_usize(index)
            );
        let signature = signature_key(function);
        let function_id =
            super::lowering::stage_function_id_from_usize(index);
        let name = try(require_name(
            names,
            super::lowering::stage_function_name(function),
            EmissionName::Function(function_id)
        ), @write_functions);
        let signature_id = try(require_signature(
            signatures,
            &signature,
            function_id
        ), @write_functions);
        let span = Vec::index(spans, index);
        ByteBuf::write_u32_le(&mut *output, name);
        ByteBuf::write_u32_le(&mut *output, signature_id);
        ByteBuf::write_u32_le(&mut *output, 0);
        ByteBuf::write_u32_le(
            &mut *output,
            super::lowering::stage_function_register_count(function)
        );
        ByteBuf::write_u32_le(&mut *output, span.code_start);
        ByteBuf::write_u32_le(&mut *output, span.code_length);
        ByteBuf::write_u32_le(
            &mut *output,
            checked_u32(
                super::lowering::stage_function_instruction_count(function)
            )
        );
        ByteBuf::write_u32_le(&mut *output, span.cleanup_start);
        ByteBuf::write_u32_le(&mut *output, span.cleanup_count);
        ByteBuf::write_u32_le(&mut *output, 0);
        ByteBuf::write_u32_le(&mut *output, 0);
        ByteBuf::write_u32_le(&mut *output, 4294967295);
        ByteBuf::write_u64_le(&mut *output, 0);
        ByteBuf::write_u64_le(&mut *output, 0);
        write_functions(
            program,
            names,
            signatures,
            spans,
            index + 1,
            output
        )
    } else { Result::Ok(()) }
}

pub encode(
    program: &super::lowering::StageProgram,
    entry: Option<super::lowering::StageFunctionId>
) -> Result<Bytes, EmissionError> {
    let names = Vec::new();
    collect_names(program, 0, &mut names);
    collect_type_names(program, 0, &mut names);
    Vec::sort(&mut names);
    Vec::dedup(&mut names);

    let signatures = Vec::new();
    collect_signatures(program, 0, &mut signatures);
    let signature_table_records = Vec::new();
    signature_records(&signatures, 0, &mut signature_table_records);

    let constant_table_records = Vec::new();
    constant_records(program, 0, &mut constant_table_records);

    let code = ByteBuf::new();
    let operands = Vec::new();
    let spans = Vec::new();
    try(write_all_code(
        program,
        0,
        &mut code,
        &mut operands,
        &mut spans
    ), @encode);

    let cleanups = ByteBuf::new();
    write_all_cleanups(
        program,
        0,
        &mut cleanups,
        &mut operands,
        &mut spans
    );
    let operand_bytes = ByteBuf::new();
    write_operand_words(&operands, 0, &mut operand_bytes);
    let functions = ByteBuf::new();
    try(write_functions(
        program,
        &names,
        &signatures,
        &spans,
        0,
        &mut functions
    ), @encode);
    let code_count = checked_u32(ByteBuf::len(&code) / 4);
    let code_bytes = ByteBuf::finish(code);
    let cleanup_count =
        checked_u32(ByteBuf::len(&cleanups) / 24);
    let cleanup_bytes = ByteBuf::finish(cleanups);
    let types = try(type_section(program, &names), @encode);

    let writer = super::artifact::new_writer();
    super::artifact::set_section(
        &mut writer,
        super::artifact::SectionId::Strings,
        super::artifact::sorted_string_section(&names)
    );
    super::artifact::set_section(
        &mut writer,
        super::artifact::SectionId::Constants,
        super::artifact::variable_section(&constant_table_records)
    );
    super::artifact::set_section(
        &mut writer,
        super::artifact::SectionId::Types,
        types
    );
    super::artifact::set_section(
        &mut writer,
        super::artifact::SectionId::Signatures,
        super::artifact::variable_section(&signature_table_records)
    );
    super::artifact::set_section(
        &mut writer,
        super::artifact::SectionId::Functions,
        super::artifact::section(
            ByteBuf::finish(functions),
            checked_u32(
                super::lowering::stage_program_function_count(program)
            )
        )
    );
    super::artifact::set_section(
        &mut writer,
        super::artifact::SectionId::Code,
        super::artifact::section(
            code_bytes,
            code_count
        )
    );
    super::artifact::set_section(
        &mut writer,
        super::artifact::SectionId::Operands,
        super::artifact::section(
            ByteBuf::finish(operand_bytes),
            checked_u32(Vec::len(&operands))
        )
    );
    super::artifact::set_section(
        &mut writer,
        super::artifact::SectionId::Cleanups,
        super::artifact::section(
            cleanup_bytes,
            cleanup_count
        )
    );
    let raw_entry = Option::map(entry, {
        found => super::lowering::stage_function_raw(found)
    });
    handle super::artifact::encode_writer(&writer, raw_entry, 1) {
        Result::Err(error) =>
            Result::Err(EmissionError::ArtifactWrite(error)),
        Result::Ok(bytes) => Result::Ok(bytes)
    }
}
