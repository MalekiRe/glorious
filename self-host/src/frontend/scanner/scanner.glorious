// Structural declaration scanning over one precomputed delimiter map.
// Bodies remain exact half-open token spans and are not parsed here.

use super::lexer::{Keyword, TokenKind};
use super::syntax::{DelimiterError, DelimiterMap, TokenSpan};

pub type TokenRange = TokenSpan;

pub enum DeclarationKind {
    Module,
    Import,
    TypeAlias,
    EffectRowAlias,
    Global,
    Fixity,
    Effect,
    Struct,
    Enum,
    Trait,
    Impl,
    Function
}

impl Use<[0, *]> for DeclarationKind {}

pub struct ShellTag {}
pub type ShellId = Id<ShellTag>;

pub struct DeclarationShell {
    kind: DeclarationKind,
    public: Bool,
    name: Option<Id<String>>,
    header: TokenSpan,
    body: Option<TokenSpan>,
    whole: TokenSpan,
    parent: Option<ShellId>
}

pub struct DeclarationIndex {
    shells: IndexVec<ShellTag, DeclarationShell>,
    delimiters: DelimiterMap
}

pub enum ScanError {
    UnexpectedClosingDelimiter(usize, usize),
    MismatchedClosingDelimiter(usize, usize),
    UnclosedDelimiter(usize, usize),
    InvalidDeclarationStart(usize, usize),
    IncompleteDeclaration(usize, usize),
    ExpectedDeclarationName(usize, usize),
    DeclarationIdExhausted(usize, usize)
}

pub enum DeclarationStyle {
    Semicolon,
    Braced,
    FunctionBody,
    Module
}

impl Use<[0, *]> for DeclarationStyle {}

struct Classification {
    kind: DeclarationKind,
    name: Option<Id<String>>,
    style: DeclarationStyle
}

struct ScanStep {
    next: usize,
    nested: Option<TokenSpan>,
    declaration: DeclarationShell
}

struct ScanScope {
    cursor: usize,
    limit: usize,
    parent: Option<ShellId>
}

struct ScanState {
    cursor: usize,
    limit: usize,
    parent: Option<ShellId>,
    scopes: Vec<ScanScope>,
    output: IndexVec<ShellTag, DeclarationShell>,
    delimiters: DelimiterMap
}

pub range_start(value: &TokenRange) -> usize {
    super::syntax::token_start(value)
}

pub range_end(value: &TokenRange) -> usize {
    super::syntax::token_end(value)
}

pub shell_count(value: &DeclarationIndex) -> usize {
    IndexVec::len(&value.shells)
}

pub shell_id_at_ordinal(
    value: &DeclarationIndex,
    index: usize
) -> Option<ShellId> {
    let id = try(Id::from_usize(index), @shell_id_at_ordinal);
    handle IndexVec::get(&value.shells, id) {
        Result::Err(_) => None,
        Result::Ok(_) => Option::Some(id)
    }
}

pub shell_at<'a>(
    value: &'a DeclarationIndex,
    id: ShellId
) -> Option<&'a DeclarationShell> {
    IndexVec::get(&value.shells, id)
}

pub delimiter_map(value: &DeclarationIndex) -> &DelimiterMap {
    &value.delimiters
}

pub for_each_shell<'a, F, e: EffectRow>(
    value: &'a DeclarationIndex,
    body: F
)
where F: Fn<(ShellId, &'a DeclarationShell), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    IndexVec::for_each(&value.shells, body)
}

pub try_for_each_shell<'a, E, F, e: EffectRow>(
    value: &'a DeclarationIndex,
    body: F
) -> Result<(), E>
where F: Fn<
    (ShellId, &'a DeclarationShell),
    Output=Result<(), E>,
    Effects={| e}
>,
F: Use<[0, 0]> {
    IndexVec::try_for_each(&value.shells, body)
}

pub fold_shells<'a, A, F, e: EffectRow>(
    value: &'a DeclarationIndex,
    initial: A,
    body: F
) -> A
where F: Fn<
    (A, ShellId, &'a DeclarationShell),
    Output=A,
    Effects={| e}
>,
F: Use<[0, 0]> {
    IndexVec::fold(&value.shells, initial, body)
}

pub shell_kind(value: &DeclarationShell) -> DeclarationKind { value.kind }

pub shell_kind_code(value: &DeclarationShell) -> u8 {
    handle value.kind {
        DeclarationKind::Module => 1,
        DeclarationKind::Import => 2,
        DeclarationKind::TypeAlias => 3,
        DeclarationKind::EffectRowAlias => 4,
        DeclarationKind::Global => 5,
        DeclarationKind::Fixity => 6,
        DeclarationKind::Effect => 7,
        DeclarationKind::Struct => 8,
        DeclarationKind::Enum => 9,
        DeclarationKind::Trait => 10,
        DeclarationKind::Impl => 11,
        DeclarationKind::Function => 12
    }
}

pub shell_is_function(value: &DeclarationShell) -> Bool {
    value.kind is DeclarationKind::Function
}

pub shell_is_public(value: &DeclarationShell) -> Bool { value.public }
pub shell_name(value: &DeclarationShell) -> &Option<Id<String>> { &value.name }
pub shell_header(value: &DeclarationShell) -> &TokenSpan { &value.header }
pub shell_body(value: &DeclarationShell) -> &Option<TokenSpan> { &value.body }
pub shell_body_span(value: &DeclarationShell) -> Option<TokenSpan> { value.body }
pub shell_body_range(value: &DeclarationShell) -> Option<TokenRange> { value.body }
pub shell_whole(value: &DeclarationShell) -> &TokenSpan { &value.whole }
pub shell_parent(value: &DeclarationShell) -> &Option<ShellId> { &value.parent }

pub scan_error_code(value: &ScanError) -> u8 {
    handle *value {
        ScanError::UnexpectedClosingDelimiter(_, _) => 1,
        ScanError::MismatchedClosingDelimiter(_, _) => 2,
        ScanError::UnclosedDelimiter(_, _) => 3,
        ScanError::InvalidDeclarationStart(_, _) => 4,
        ScanError::IncompleteDeclaration(_, _) => 5,
        ScanError::ExpectedDeclarationName(_, _) => 6,
        ScanError::DeclarationIdExhausted(_, _) => 7
    }
}

pub scan_error_token(value: &ScanError) -> usize {
    handle *value {
        ScanError::UnexpectedClosingDelimiter(token, _) => token,
        ScanError::MismatchedClosingDelimiter(token, _) => token,
        ScanError::UnclosedDelimiter(token, _) => token,
        ScanError::InvalidDeclarationStart(token, _) => token,
        ScanError::IncompleteDeclaration(token, _) => token,
        ScanError::ExpectedDeclarationName(token, _) => token,
        ScanError::DeclarationIdExhausted(token, _) => token
    }
}

pub scan_error_related(value: &ScanError) -> usize {
    handle *value {
        ScanError::UnexpectedClosingDelimiter(_, related) => related,
        ScanError::MismatchedClosingDelimiter(_, related) => related,
        ScanError::UnclosedDelimiter(_, related) => related,
        ScanError::InvalidDeclarationStart(_, related) => related,
        ScanError::IncompleteDeclaration(_, related) => related,
        ScanError::ExpectedDeclarationName(_, related) => related,
        ScanError::DeclarationIdExhausted(_, related) => related
    }
}

token_kind_at(value: &super::lexer::LexedSource, index: usize) -> TokenKind {
    super::lexer::token_kind_at(value, index)
}

token_ident(
    value: &super::lexer::LexedSource,
    index: usize
) -> Option<Id<String>> {
    handle token_kind_at(value, index) {
        TokenKind::Ident(name) => Option::Some(name),
        _ => None
    }
}

ident_is(
    value: &super::lexer::LexedSource,
    index: usize,
    expected: &String
) -> Bool {
    handle token_ident(value, index) {
        None => false,
        Option::Some(name) => handle super::lexer::lexeme(value, name) {
            Result::Err(_) => false,
            Result::Ok(found) => *found == *expected
        }
    }
}

token_is_number(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::Number(_)
}

token_is_semicolon(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::Semicolon
}

token_is_eof(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::Eof
}

token_is_close(value: &super::lexer::LexedSource, index: usize) -> Bool {
    handle token_kind_at(value, index) {
        TokenKind::RParen => true,
        TokenKind::RBrace => true,
        TokenKind::RBracket => true,
        _ => false
    }
}

token_is_brace_open(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::LBrace
}

matching_close(
    delimiters: &DelimiterMap,
    open: usize
) -> Result<usize, ScanError> {
    handle super::syntax::delimiter_partner(delimiters, open) {
        None => Result::Err(ScanError::IncompleteDeclaration(open, open)),
        Option::Some(close) => Result::Ok(close)
    }
}

find_semicolon(
    value: &super::lexer::LexedSource,
    delimiters: &DelimiterMap,
    index: usize,
    limit: usize,
    start: usize
) -> Result<usize, ScanError> {
    if(index < limit) {
        if(token_is_eof(value, index)) {
            Result::Err(ScanError::IncompleteDeclaration(index, start))
        } else if(token_is_semicolon(value, index)) {
            Result::Ok(index)
        } else if(super::syntax::delimiter_is_open(delimiters, index)) {
            let close = try(matching_close(delimiters, index), @find_semicolon);
            find_semicolon(value, delimiters, close + 1, limit, start)
        } else if(token_is_close(value, index)) {
            Result::Err(ScanError::UnexpectedClosingDelimiter(
                index,
                super::lexer::token_count(value)
            ))
        } else {
            find_semicolon(value, delimiters, index + 1, limit, start)
        }
    } else {
        Result::Err(ScanError::IncompleteDeclaration(limit, start))
    }
}

body_span(
    delimiters: &DelimiterMap,
    open: usize,
    limit: usize,
    start: usize
) -> Result<TokenSpan, ScanError> {
    let close = try(matching_close(delimiters, open), @body_span);
    if(close < limit) {
        Result::Ok(super::syntax::token_span(open, close))
    } else {
        Result::Err(ScanError::IncompleteDeclaration(limit, start))
    }
}

find_body(
    value: &super::lexer::LexedSource,
    delimiters: &DelimiterMap,
    index: usize,
    limit: usize,
    start: usize,
    function: Bool
) -> Result<TokenSpan, ScanError> {
    if(index < limit) {
        if(token_is_eof(value, index)) {
            Result::Err(ScanError::IncompleteDeclaration(index, start))
        } else if(super::syntax::delimiter_is_open(delimiters, index)) {
            if(token_is_brace_open(value, index)) {
                let skip_handler_body = function
                    and { index > start }
                    and { token_kind_at(value, index - 1) is TokenKind::Slash };
                if(skip_handler_body) {
                    let close = try(matching_close(delimiters, index), @find_body);
                    find_body(value, delimiters, close + 1, limit, start, function)
                } else {
                    body_span(delimiters, index, limit, start)
                }
            } else {
                let close = try(matching_close(delimiters, index), @find_body);
                find_body(value, delimiters, close + 1, limit, start, function)
            }
        } else if(token_is_close(value, index)) {
            Result::Err(ScanError::UnexpectedClosingDelimiter(
                index,
                super::lexer::token_count(value)
            ))
        } else {
            find_body(value, delimiters, index + 1, limit, start, function)
        }
    } else {
        Result::Err(ScanError::IncompleteDeclaration(limit, start))
    }
}

find_top_level_eq(
    value: &super::lexer::LexedSource,
    delimiters: &DelimiterMap,
    index: usize,
    end: usize
) -> Option<usize> {
    if(index < end) {
        if(token_kind_at(value, index) is TokenKind::Eq) {
            Option::Some(index)
        } else if(super::syntax::delimiter_is_open(delimiters, index)) {
            handle super::syntax::delimiter_partner(delimiters, index) {
                None => None,
                Option::Some(close) =>
                    find_top_level_eq(value, delimiters, close + 1, end)
            }
        } else {
            find_top_level_eq(value, delimiters, index + 1, end)
        }
    } else { None }
}

name_at(
    value: &super::lexer::LexedSource,
    index: usize,
    start: usize
) -> Result<Id<String>, ScanError> {
    handle token_ident(value, index) {
        Option::Some(name) => Result::Ok(name),
        None => Result::Err(ScanError::ExpectedDeclarationName(index, start))
    }
}

named(
    value: &super::lexer::LexedSource,
    name_index: usize,
    start: usize,
    kind: DeclarationKind,
    style: DeclarationStyle
) -> Result<Classification, ScanError> {
    let name = try(name_at(value, name_index, start), @named);
    Result::Ok(Classification {
        kind: kind,
        name: Option::Some(name),
        style: style
    })
}

function_classification(name: Id<String>) -> Classification {
    Classification {
        kind: DeclarationKind::Function,
        name: Option::Some(name),
        style: DeclarationStyle::FunctionBody
    }
}

import_declaration(value: &super::lexer::LexedSource, cursor: usize) -> Bool {
    handle token_kind_at(value, cursor + 1) {
        TokenKind::LParen => false,
        TokenKind::Lt => false,
        _ => true
    }
}

fixity_declaration(value: &super::lexer::LexedSource, cursor: usize) -> Bool {
    (
        ident_is(value, cursor, &"infixl")
            or { ident_is(value, cursor, &"infixr") }
            or { ident_is(value, cursor, &"infix") }
            or { ident_is(value, cursor, &"prefix") }
    ) and { token_is_number(value, cursor + 1) }
}

classify_ident(
    value: &super::lexer::LexedSource,
    cursor: usize,
    start: usize,
    name: Id<String>
) -> Result<Classification, ScanError> {
    if(ident_is(value, cursor, &"mod")) {
        named(
            value,
            cursor + 1,
            start,
            DeclarationKind::Module,
            DeclarationStyle::Module
        )
    } else if(ident_is(value, cursor, &"use")
        and { import_declaration(value, cursor) }) {
        Result::Ok(Classification {
            kind: DeclarationKind::Import,
            name: token_ident(value, cursor + 1),
            style: DeclarationStyle::Semicolon
        })
    } else if(ident_is(value, cursor, &"cases")) {
        named(
            value,
            cursor + 1,
            start,
            DeclarationKind::EffectRowAlias,
            DeclarationStyle::Semicolon
        )
    } else if(fixity_declaration(value, cursor)) {
        Result::Ok(Classification {
            kind: DeclarationKind::Fixity,
            name: token_ident(value, cursor + 2),
            style: DeclarationStyle::Semicolon
        })
    } else {
        Result::Ok(function_classification(name))
    }
}

classify(
    value: &super::lexer::LexedSource,
    cursor: usize,
    start: usize
) -> Result<Classification, ScanError> {
    handle token_kind_at(value, cursor) {
        TokenKind::Keyword(Keyword::Type) => named(
            value,
            cursor + 1,
            start,
            DeclarationKind::TypeAlias,
            DeclarationStyle::Semicolon
        ),
        TokenKind::Keyword(Keyword::Let) => named(
            value,
            cursor + 1,
            start,
            DeclarationKind::Global,
            DeclarationStyle::Semicolon
        ),
        TokenKind::Keyword(Keyword::Effect) => named(
            value,
            cursor + 1,
            start,
            DeclarationKind::Effect,
            DeclarationStyle::Braced
        ),
        TokenKind::Keyword(Keyword::Struct) => named(
            value,
            cursor + 1,
            start,
            DeclarationKind::Struct,
            DeclarationStyle::Braced
        ),
        TokenKind::Keyword(Keyword::Enum) => named(
            value,
            cursor + 1,
            start,
            DeclarationKind::Enum,
            DeclarationStyle::Braced
        ),
        TokenKind::Keyword(Keyword::Trait) => named(
            value,
            cursor + 1,
            start,
            DeclarationKind::Trait,
            DeclarationStyle::Braced
        ),
        TokenKind::Keyword(Keyword::Impl) => Result::Ok(Classification {
            kind: DeclarationKind::Impl,
            name: None,
            style: DeclarationStyle::Braced
        }),
        TokenKind::Ident(name) => classify_ident(value, cursor, start, name),
        _ => Result::Err(ScanError::InvalidDeclarationStart(
            cursor,
            super::lexer::token_count(value)
        ))
    }
}

find_module_style(
    value: &super::lexer::LexedSource,
    index: usize,
    limit: usize,
    start: usize
) -> Result<DeclarationStyle, ScanError> {
    if(index < limit) {
        if(token_is_semicolon(value, index)) {
            Result::Ok(DeclarationStyle::Semicolon)
        } else if(token_is_brace_open(value, index)) {
            Result::Ok(DeclarationStyle::Braced)
        } else if(token_is_close(value, index)) {
            Result::Err(ScanError::UnexpectedClosingDelimiter(
                index,
                super::lexer::token_count(value)
            ))
        } else {
            find_module_style(value, index + 1, limit, start)
        }
    } else {
        Result::Err(ScanError::IncompleteDeclaration(limit, start))
    }
}

scan_semicolon_shell(
    value: &super::lexer::LexedSource,
    delimiters: &DelimiterMap,
    start: usize,
    cursor: usize,
    limit: usize,
    public: Bool,
    classification: Classification,
    parent: Option<ShellId>
) -> Result<ScanStep, ScanError> {
    let Classification { kind, name, style: _ } = classification;
    let end = try(
        find_semicolon(value, delimiters, cursor, limit, start),
        @scan_semicolon_shell
    );
    let whole = super::syntax::token_span(start, end + 1);
    if(kind is DeclarationKind::Global) {
        handle find_top_level_eq(value, delimiters, cursor, end) {
            None => Result::Err(ScanError::IncompleteDeclaration(end, start)),
            Option::Some(equal) => Result::Ok(ScanStep {
                next: end + 1,
                nested: None,
                declaration: DeclarationShell {
                    kind: kind,
                    public: public,
                    name: name,
                    header: super::syntax::token_span(start, equal + 1),
                    body: Option::Some(super::syntax::token_span(equal + 1, end)),
                    whole: whole,
                    parent: parent
                }
            })
        }
    } else {
        Result::Ok(ScanStep {
            next: end + 1,
            nested: None,
            declaration: DeclarationShell {
                kind: kind,
                public: public,
                name: name,
                header: whole,
                body: None,
                whole: whole,
                parent: parent
            }
        })
    }
}

scan_braced_shell(
    value: &super::lexer::LexedSource,
    delimiters: &DelimiterMap,
    start: usize,
    cursor: usize,
    limit: usize,
    public: Bool,
    classification: Classification,
    parent: Option<ShellId>,
    function: Bool
) -> Result<ScanStep, ScanError> {
    let Classification { kind, name, style: _ } = classification;
    let bounds = try(
        find_body(value, delimiters, cursor, limit, start, function),
        @scan_braced_shell
    );
    let open = super::syntax::token_start(&bounds);
    let close = super::syntax::token_end(&bounds);
    let body = super::syntax::token_span(open + 1, close);
    Result::Ok(ScanStep {
        next: close + 1,
        nested: if(kind is DeclarationKind::Module) {
            Option::Some(body)
        } else { None },
        declaration: DeclarationShell {
            kind: kind,
            public: public,
            name: name,
            header: super::syntax::token_span(start, open),
            body: Option::Some(body),
            whole: super::syntax::token_span(start, close + 1),
            parent: parent
        }
    })
}

scan_one(
    value: &super::lexer::LexedSource,
    delimiters: &DelimiterMap,
    start: usize,
    limit: usize,
    parent: Option<ShellId>
) -> Result<ScanStep, ScanError> {
    let public = ident_is(value, start, &"pub");
    let cursor = if(public) { start + 1 } else { start };
    let classification = try(classify(value, cursor, start), @scan_one);
    let style = handle classification.style {
        DeclarationStyle::Module => try(
            find_module_style(value, cursor + 1, limit, start),
            @scan_one
        ),
        found => found
    };
    handle style {
        DeclarationStyle::Semicolon => scan_semicolon_shell(
            value,
            delimiters,
            start,
            cursor + 1,
            limit,
            public,
            classification,
            parent
        ),
        DeclarationStyle::Braced => scan_braced_shell(
            value,
            delimiters,
            start,
            cursor + 1,
            limit,
            public,
            classification,
            parent,
            false
        ),
        DeclarationStyle::FunctionBody => scan_braced_shell(
            value,
            delimiters,
            start,
            cursor + 1,
            limit,
            public,
            classification,
            parent,
            true
        ),
        DeclarationStyle::Module => unreachable()
    }
}

scan_complete(
    value: &super::lexer::LexedSource,
    scopes: Vec<ScanScope>,
    output: IndexVec<ShellTag, DeclarationShell>,
    delimiters: DelimiterMap
) -> Result<DeclarationIndex, ScanError> {
    let remaining = scopes;
    handle Vec::pop(&mut remaining) {
        Result::Err(_) => Result::Ok(DeclarationIndex {
            shells: output,
            delimiters: delimiters
        }),
        Result::Ok(scope) => scan_loop(value, ScanState {
            cursor: scope.cursor,
            limit: scope.limit,
            parent: scope.parent,
            scopes: remaining,
            output: output,
            delimiters: delimiters
        })
    }
}

scan_loop(
    value: &super::lexer::LexedSource,
    state: ScanState
) -> Result<DeclarationIndex, ScanError> {
    let ScanState {
        cursor,
        limit,
        parent,
        scopes,
        output,
        delimiters
    } = state;
    if(cursor >= limit or { token_is_eof(value, cursor) }) {
        scan_complete(value, scopes, output, delimiters)
    } else {
        let step = try(
            scan_one(value, &delimiters, cursor, limit, parent),
            @scan_loop
        );
        let ScanStep { next, nested, declaration } = step;
        handle IndexVec::push(&mut output, declaration) {
            Result::Err(rejected) => {
                let token = super::syntax::token_start(&rejected.whole);
                Result::Err(ScanError::DeclarationIdExhausted(token, token))
            },
            Result::Ok(shell) => handle nested {
                None => scan_loop(value, ScanState {
                    cursor: next,
                    limit: limit,
                    parent: parent,
                    scopes: scopes,
                    output: output,
                    delimiters: delimiters
                }),
                Option::Some(span) => {
                    Vec::push(&mut scopes, ScanScope {
                        cursor: next,
                        limit: limit,
                        parent: parent
                    });
                    scan_loop(value, ScanState {
                        cursor: super::syntax::token_start(&span),
                        limit: super::syntax::token_end(&span),
                        parent: Option::Some(shell),
                        scopes: scopes,
                        output: output,
                        delimiters: delimiters
                    })
                }
            }
        }
    }
}

map_delimiter_error(value: DelimiterError) -> ScanError {
    handle value {
        DelimiterError::UnexpectedClose(token, related) =>
            ScanError::UnexpectedClosingDelimiter(token, related),
        DelimiterError::MismatchedClose(token, related) =>
            ScanError::MismatchedClosingDelimiter(token, related),
        DelimiterError::Unclosed(token, related) =>
            ScanError::UnclosedDelimiter(token, related)
    }
}

pub scan(
    value: &super::lexer::LexedSource
) -> Result<DeclarationIndex, ScanError> {
    let delimiters = handle super::syntax::build_delimiter_map(value) {
        Result::Err(error) => @scan(Result::Err(map_delimiter_error(error))),
        Result::Ok(found) => found
    };
    scan_loop(value, ScanState {
        cursor: 0,
        limit: super::lexer::token_count(value),
        parent: None,
        scopes: Vec::new(),
        output: IndexVec::new(),
        delimiters: delimiters
    })
}

bool_code(value: Bool) -> u8 {
    if(value) { 1 } else { 0 }
}

write_string(output: &mut ByteBuf, value: &String) {
    let bytes = String::as_bytes(value);
    ByteBuf::write_u32_le(
        output,
        wrapping_convert_to_u32(Bytes::len(&bytes))
    );
    ByteBuf::append_bytes(output, &bytes)
}

write_optional_name(
    output: &mut ByteBuf,
    lexed: &super::lexer::LexedSource,
    value: &Option<Id<String>>
) {
    handle *value {
        None => ByteBuf::push(output, 0),
        Option::Some(name) => {
            ByteBuf::push(output, 1);
            handle super::lexer::lexeme(lexed, name) {
                Result::Err(_) => unreachable(),
                Result::Ok(text) => write_string(output, text)
            }
        }
    }
}

write_range(output: &mut ByteBuf, value: &TokenRange) {
    ByteBuf::write_u32_le(output, wrapping_convert_to_u32(range_start(value)));
    ByteBuf::write_u32_le(output, wrapping_convert_to_u32(range_end(value)))
}

write_optional_range(output: &mut ByteBuf, value: &Option<TokenRange>) {
    handle *value {
        None => ByteBuf::push(output, 0),
        Option::Some(range) => {
            ByteBuf::push(output, 1);
            write_range(output, &range)
        }
    }
}

write_optional_parent(output: &mut ByteBuf, value: &Option<ShellId>) {
    handle *value {
        None => ByteBuf::push(output, 0),
        Option::Some(parent) => {
            ByteBuf::push(output, 1);
            ByteBuf::write_u32_le(output, Id::to_u32(parent))
        }
    }
}

write_shells(
    output: &mut ByteBuf,
    lexed: &super::lexer::LexedSource,
    value: &DeclarationIndex
) {
    for_each_shell(value, { _, shell => {
        ByteBuf::push(output, shell_kind_code(shell));
        ByteBuf::push(output, bool_code(shell.public));
        write_optional_name(output, lexed, &shell.name);
        write_range(output, &shell.header);
        write_optional_range(output, &shell.body);
        write_range(output, &shell.whole);
        write_optional_parent(output, &shell.parent)
    } })
}

encode_scan(output: &mut ByteBuf, lexed: super::lexer::LexedSource) {
    handle scan(&lexed) {
        Result::Err(error) => {
            ByteBuf::push(output, 2);
            ByteBuf::push(output, scan_error_code(&error));
            ByteBuf::write_u32_le(
                output,
                wrapping_convert_to_u32(scan_error_token(&error))
            );
            ByteBuf::write_u32_le(
                output,
                wrapping_convert_to_u32(scan_error_related(&error))
            )
        },
        Result::Ok(index) => {
            ByteBuf::push(output, 0);
            ByteBuf::write_u32_le(
                output,
                wrapping_convert_to_u32(shell_count(&index))
            );
            write_shells(output, &lexed, &index)
        }
    }
}

process_inputs(
    arguments: &Vec<String>,
    index: usize,
    output: &mut ByteBuf
) / FileRead {
    for_range(Range::new(index, Vec::len(arguments)), { current => {
        let path = *Vec::index(arguments, current);
        let bytes = read_file(path);
        handle String::from_utf8(bytes) {
            Result::Err(_) => ByteBuf::push(output, 1),
            Result::Ok(source) => handle super::lexer::lex(&source) {
                Result::Err(_) => ByteBuf::push(output, 1),
                Result::Ok(lexed) => encode_scan(output, lexed)
            }
        }
    } })
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    let count = Vec::len(&arguments);
    if(count < 2) {
        write_diagnostic(
            "usage: grandiose-self-host-scanner <output> <input>..."
        )
    } else {
        let output_path = *Vec::index(&arguments, 0);
        let encoded = ByteBuf::new();
        ByteBuf::write_u32_le(
            &mut encoded,
            wrapping_convert_to_u32(count - 1)
        );
        process_inputs(&arguments, 1, &mut encoded);
        write_file(output_path, ByteBuf::finish(encoded))
    }
}
