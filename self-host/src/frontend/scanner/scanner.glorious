// A compact structural pass between lexing and semantic header parsing.
// Bodies remain exact half-open token ranges and are not parsed here.

use super::lexer::{Keyword, TokenKind};

pub struct TokenRange { start: usize, end: usize }

impl Use<[0, *]> for TokenRange {}

pub enum DeclarationKind {
    Module,
    Import,
    TypeAlias,
    EffectRowAlias,
    Global,
    Fixity,
    Effect,
    Struct,
    Enum,
    Trait,
    Impl,
    Function
}

impl Use<[0, *]> for DeclarationKind {}

pub struct ShellTag {}

pub type ShellId = Id<ShellTag>;

pub struct DeclarationShell {
    kind: DeclarationKind,
    kind_code: u8,
    public: Bool,
    name: Option<Id<String>>,
    header: TokenRange,
    body: Option<TokenRange>,
    whole: TokenRange,
    parent: Option<ShellId>
}

pub struct DeclarationIndex {
    shells: IndexVec<ShellTag, DeclarationShell>
}

pub enum ScanError {
    UnexpectedClosingDelimiter(usize, usize),
    MismatchedClosingDelimiter(usize, usize),
    UnclosedDelimiter(usize, usize),
    InvalidDeclarationStart(usize, usize),
    IncompleteDeclaration(usize, usize),
    ExpectedDeclarationName(usize, usize),
    DeclarationIdExhausted(usize, usize)
}

struct OpenDelimiter { kind: u8, token: usize }

struct Classification {
    kind: DeclarationKind,
    kind_code: u8,
    name: Option<Id<String>>,
    style: u8
}

struct ScanStep {
    next: usize,
    nested_start: Option<usize>,
    nested_end: usize,
    declaration: DeclarationShell
}

struct ScanScope {
    cursor: usize,
    limit: usize,
    parent: Option<ShellId>
}

struct ScanState {
    cursor: usize,
    limit: usize,
    parent: Option<ShellId>,
    scopes: Vec<ScanScope>,
    output: IndexVec<ShellTag, DeclarationShell>
}

pub range_start(value: &TokenRange) -> usize { value.start }

pub range_end(value: &TokenRange) -> usize { value.end }

pub shell_count(value: &DeclarationIndex) -> usize {
    IndexVec::len(&value.shells)
}

pub shell_id_at_ordinal(
    value: &DeclarationIndex,
    index: usize
) -> Option<ShellId> {
    let id = try(Id::from_usize(index), @shell_id_at_ordinal);
    handle IndexVec::get(&value.shells, id) {
        Result::Err(_) => None,
        Result::Ok(_) => Option::Some(id)
    }
}

pub shell_at<'a>(
    value: &'a DeclarationIndex,
    id: ShellId
) -> Option<&'a DeclarationShell> {
    IndexVec::get(&value.shells, id)
}

pub for_each_shell<'a, F, e: EffectRow>(
    value: &'a DeclarationIndex,
    body: F
)
where F: Fn<(ShellId, &'a DeclarationShell), Output=(), Effects={| e}>,
F: Use<[0, 0]> {
    IndexVec::for_each(&value.shells, body)
}

pub try_for_each_shell<'a, E, F, e: EffectRow>(
    value: &'a DeclarationIndex,
    body: F
) -> Result<(), E>
where F: Fn<
    (ShellId, &'a DeclarationShell),
    Output=Result<(), E>,
    Effects={| e}
>,
F: Use<[0, 0]> {
    IndexVec::try_for_each(&value.shells, body)
}

pub fold_shells<'a, A, F, e: EffectRow>(
    value: &'a DeclarationIndex,
    initial: A,
    body: F
) -> A
where F: Fn<
    (A, ShellId, &'a DeclarationShell),
    Output=A,
    Effects={| e}
>,
F: Use<[0, 0]> {
    IndexVec::fold(&value.shells, initial, body)
}

pub shell_kind(value: &DeclarationShell) -> &DeclarationKind { &value.kind }

pub shell_kind_code(value: &DeclarationShell) -> u8 { value.kind_code }

pub shell_is_public(value: &DeclarationShell) -> Bool { value.public }

pub shell_name(value: &DeclarationShell) -> &Option<Id<String>> { &value.name }

pub shell_header(value: &DeclarationShell) -> &TokenRange { &value.header }

pub shell_body(value: &DeclarationShell) -> &Option<TokenRange> { &value.body }

pub shell_body_range(value: &DeclarationShell) -> Option<TokenRange> {
    let found = try(Option::as_ref(&value.body), @shell_body_range);
    Result::Ok(*found)
}

pub shell_whole(value: &DeclarationShell) -> &TokenRange { &value.whole }

pub shell_parent(value: &DeclarationShell) -> &Option<ShellId> {
    &value.parent
}

pub scan_error_code(value: &ScanError) -> u8 {
    handle *value {
        ScanError::UnexpectedClosingDelimiter(_, _) => 1,
        ScanError::MismatchedClosingDelimiter(_, _) => 2,
        ScanError::UnclosedDelimiter(_, _) => 3,
        ScanError::InvalidDeclarationStart(_, _) => 4,
        ScanError::IncompleteDeclaration(_, _) => 5,
        ScanError::ExpectedDeclarationName(_, _) => 6,
        ScanError::DeclarationIdExhausted(_, _) => 7
    }
}

pub scan_error_token(value: &ScanError) -> usize {
    handle *value {
        ScanError::UnexpectedClosingDelimiter(token, _) => token,
        ScanError::MismatchedClosingDelimiter(token, _) => token,
        ScanError::UnclosedDelimiter(token, _) => token,
        ScanError::InvalidDeclarationStart(token, _) => token,
        ScanError::IncompleteDeclaration(token, _) => token,
        ScanError::ExpectedDeclarationName(token, _) => token,
        ScanError::DeclarationIdExhausted(token, _) => token
    }
}

pub scan_error_related(value: &ScanError) -> usize {
    handle *value {
        ScanError::UnexpectedClosingDelimiter(_, related) => related,
        ScanError::MismatchedClosingDelimiter(_, related) => related,
        ScanError::UnclosedDelimiter(_, related) => related,
        ScanError::InvalidDeclarationStart(_, related) => related,
        ScanError::IncompleteDeclaration(_, related) => related,
        ScanError::ExpectedDeclarationName(_, related) => related,
        ScanError::DeclarationIdExhausted(_, related) => related
    }
}

u8_equal(left: u8, right: u8) -> Bool {  left ==  right }

delimiter_open(value: TokenKind) -> u8 {
    handle value {
        TokenKind::LParen => 1,
        TokenKind::LBrace => 2,
        TokenKind::LBracket => 3,
        _ => 0
    }
}

delimiter_close(value: TokenKind) -> u8 {
    handle value {
        TokenKind::RParen => 1,
        TokenKind::RBrace => 2,
        TokenKind::RBracket => 3,
        _ => 0
    }
}

token_kind_at(
    value: &super::lexer::LexedSource,
    index: usize
) -> TokenKind {
    super::lexer::token_kind_at(value, index)
}

token_ident(
    value: &super::lexer::LexedSource,
    index: usize
) -> Option<Id<String>> {
    handle token_kind_at(value, index) {
        TokenKind::Ident(name) => Result::Ok( name),
        _ => Result::Err(())
    }
}

ident_is(
    value: &super::lexer::LexedSource,
    index: usize,
    expected: &String
) -> Bool {
    if(token_ident(value, index) is Result::Ok(name)) {
        if(super::lexer::lexeme(value, name) is Result::Ok(found)) {
            *found == *expected
        } else { false }
    } else { false }
}

token_is_number(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::Number(_)
}

token_is_slash(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::Slash
}

token_is_eq(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::Eq
}

token_is_semicolon(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::Semicolon
}

token_is_eof(value: &super::lexer::LexedSource, index: usize) -> Bool {
    token_kind_at(value, index) is TokenKind::Eof
}

matching_close_walk(
    value: &super::lexer::LexedSource,
    index: usize,
    stack: Vec<OpenDelimiter>
) -> Result<usize, ScanError> {
    let count = super::lexer::token_count(value);
    if(index < count) { if(token_is_eof(value, index)) {
            handle Vec::last(&stack) {
                Result::Ok(open) => Result::Err(
                    ScanError::UnclosedDelimiter(index, open.token)
                ),
                Result::Err(_) => Result::Err(
                    ScanError::IncompleteDeclaration(index, count)
                )
            }
        } else {
                let kind = token_kind_at(value, index);
                let opening = delimiter_open(kind);
                let closing = delimiter_close(kind);
                if(u8_equal(opening, 0)) { if(u8_equal(closing, 0)) { matching_close_walk(
                            value,
                            index + 1,
                             stack
                        ) } else {
                        let next =  stack;
                        handle Vec::pop(&mut next) {
                            Result::Err(_) => Result::Err(
                                ScanError::UnexpectedClosingDelimiter(
                                    index,
                                    count
                                )
                            ),
                            Result::Ok(open) => if(u8_equal(open.kind, closing)) { if(Vec::is_empty(&next)) { Result::Ok(index) } else { matching_close_walk(
                                        value,
                                        index + 1,
                                        next
                                    ) } } else { Result::Err(
                                    ScanError::MismatchedClosingDelimiter(
                                        index,
                                        open.token
                                    )
                                ) }
                        }
                    } } else {
                    let next =  stack;
                    Vec::push(
                        &mut next,
                        OpenDelimiter { kind: opening, token: index }
                    );
                    matching_close_walk(value, index + 1, next)
                }
        } } else { handle Vec::last(&stack) {
            Result::Ok(open) => Result::Err(
                ScanError::UnclosedDelimiter(count, open.token)
            ),
            Result::Err(_) => Result::Err(
                ScanError::IncompleteDeclaration(count, count)
            )
        } }
}

matching_close(
    value: &super::lexer::LexedSource,
    open: usize
) -> Result<usize, ScanError> {
    let kind = delimiter_open(token_kind_at(value, open));
    if(u8_equal(kind, 0)) {
        Result::Err(ScanError::IncompleteDeclaration(open, open))
    } else {
        let stack = Vec::new();
        Vec::push(
            &mut stack,
            OpenDelimiter { kind: kind, token: open }
        );
        matching_close_walk(value, open + 1,  stack)
    }
}

find_semicolon(
    value: &super::lexer::LexedSource,
    index: usize,
    limit: usize,
    start: usize
) -> Result<usize, ScanError> {
    if(index < limit) { if(token_is_eof(value, index)) { Result::Err(
        ScanError::IncompleteDeclaration(index, start)
    ) } else {
            let kind = token_kind_at(value, index);
            let opening = delimiter_open(kind);
            let closing = delimiter_close(kind);
            if(token_is_semicolon(value, index)) { Result::Ok(index) } else { if(u8_equal(opening, 0)) { if(u8_equal(closing, 0)) { find_semicolon(
                            value,
                            index + 1,
                            limit,
                            start
                        ) } else { Result::Err(
                            ScanError::UnexpectedClosingDelimiter(
                                index,
                                super::lexer::token_count(value)
                            )
                        ) } } else {
                    let close = try(
                        matching_close(value, index),
                        @find_semicolon
                    );
                    find_semicolon(
                        value,
                        close + 1,
                        limit,
                        start
                    )
                } }
        } } else { Result::Err(
            ScanError::IncompleteDeclaration(limit, start)
        ) }
}

find_body(
    value: &super::lexer::LexedSource,
    index: usize,
    limit: usize,
    start: usize,
    function: Bool
) -> Result<TokenRange, ScanError> {
    if(index < limit) { if(token_is_eof(value, index)) { Result::Err(
        ScanError::IncompleteDeclaration(index, start)
    ) } else {
            let kind = token_kind_at(value, index);
            let opening = delimiter_open(kind);
            let closing = delimiter_close(kind);
            if(u8_equal(opening, 0)) { if(u8_equal(closing, 0)) { find_body(
                        value,
                        index + 1,
                        limit,
                        start,
                        function
                    ) } else { Result::Err(
                        ScanError::UnexpectedClosingDelimiter(
                            index,
                            super::lexer::token_count(value)
                        )
                    ) } } else { if(opening != 2) {
                    let close = try(
                        matching_close(value, index),
                        @find_body
                    );
                    find_body(
                        value,
                        close + 1,
                        limit,
                        start,
                        function
                    )
                } else {
                    if(function) { if(index > start) { if(token_is_slash(
                                value,
                                index - 1
                            )) {
                                let close = try(
                                    matching_close(value, index),
                                    @find_body
                                );
                                find_body(
                                    value,
                                    close + 1,
                                    limit,
                                    start,
                                    function
                                )
                            } else { body_range(
                                    value,
                                    index,
                                    limit,
                                    start
                                ) } } else { body_range(
                                value,
                                index,
                                limit,
                                start
                            ) } } else { body_range(
                            value,
                            index,
                            limit,
                            start
                        ) }
                } }
        } } else { Result::Err(
            ScanError::IncompleteDeclaration(limit, start)
        ) }
}

body_range(
    value: &super::lexer::LexedSource,
    open: usize,
    limit: usize,
    start: usize
) -> Result<TokenRange, ScanError> {
    let close = try(matching_close(value, open), @body_range);
    if(close < limit) { Result::Ok(
            TokenRange { start: open, end: close }
        ) } else { Result::Err(
            ScanError::IncompleteDeclaration(limit, start)
        ) }
}

find_top_level_eq(
    value: &super::lexer::LexedSource,
    index: usize,
    end: usize
) -> Option<usize> {
    if(index < end) { if(token_is_eq(value, index)) {
            Result::Ok(index)
        } else {
                let opening = delimiter_open(token_kind_at(value, index));
                if(u8_equal(opening, 0)) { find_top_level_eq(
                        value,
                        index + 1,
                        end
                    ) } else { handle matching_close(value, index) {
                        Result::Err(_) => Result::Err(()),
                        Result::Ok(close) => find_top_level_eq(
                            value,
                            close + 1,
                            end
                        )
                    } }
        } } else { Result::Err(()) }
}

name_at(
    value: &super::lexer::LexedSource,
    index: usize,
    start: usize
) -> Result<Id<String>, ScanError> {
    handle token_ident(value, index) {
        Result::Ok(name) => Result::Ok( name),
        Result::Err(_) => Result::Err(
            ScanError::ExpectedDeclarationName(index, start)
        )
    }
}

classify(
    value: &super::lexer::LexedSource,
    cursor: usize,
    start: usize
) -> Result<Classification, ScanError> {
    handle token_kind_at(value, cursor) {
        TokenKind::Keyword(Keyword::Type) => {
            let name = try(
                name_at(value, cursor + 1, start),
                @classify
            );
            Result::Ok(Classification {
                kind: DeclarationKind::TypeAlias,
                kind_code: 3,
                name: Result::Ok(name),
                style: 1
            })
        },
        TokenKind::Keyword(Keyword::Let) => {
            let name = try(
                name_at(value, cursor + 1, start),
                @classify
            );
            Result::Ok(Classification {
                kind: DeclarationKind::Global,
                kind_code: 5,
                name: Result::Ok(name),
                style: 1
            })
        },
        TokenKind::Keyword(Keyword::Effect) => {
            named_braced(
                value,
                cursor + 1,
                start,
                DeclarationKind::Effect,
                7
            )
        },
        TokenKind::Keyword(Keyword::Struct) => {
            named_braced(
                value,
                cursor + 1,
                start,
                DeclarationKind::Struct,
                8
            )
        },
        TokenKind::Keyword(Keyword::Enum) => {
            named_braced(
                value,
                cursor + 1,
                start,
                DeclarationKind::Enum,
                9
            )
        },
        TokenKind::Keyword(Keyword::Trait) => {
            named_braced(
                value,
                cursor + 1,
                start,
                DeclarationKind::Trait,
                10
            )
        },
        TokenKind::Keyword(Keyword::Impl) => {
            Result::Ok(Classification {
                kind: DeclarationKind::Impl,
                kind_code: 11,
                name: Result::Err(()),
                style: 2
            })
        },
        TokenKind::Ident(name) => classify_ident(
            value,
            cursor,
            start,
             name
        ),
        _ => Result::Err(ScanError::InvalidDeclarationStart(
            cursor,
            super::lexer::token_count(value)
        ))
    }
}

named_braced(
    value: &super::lexer::LexedSource,
    name_index: usize,
    start: usize,
    kind: DeclarationKind,
    kind_code: u8
) -> Result<Classification, ScanError> {
    let name = try(name_at(value, name_index, start), @named_braced);
    Result::Ok(Classification {
        kind: kind,
        kind_code: kind_code,
        name: Result::Ok( name),
        style: 2
    })
}

classify_ident(
    value: &super::lexer::LexedSource,
    cursor: usize,
    start: usize,
    name: Id<String>
) -> Result<Classification, ScanError> {
    if(ident_is(value, cursor, &"mod")) {
        let found = try(
            name_at(value, cursor + 1, start),
            @classify_ident
        );
        Result::Ok(Classification {
            kind: DeclarationKind::Module,
            kind_code: 1,
            name: Result::Ok(found),
            style: 4
        })
    } else { if(ident_is(value, cursor, &"use")) { if(import_declaration(value, cursor)) {
                Result::Ok(Classification {
                    kind: DeclarationKind::Import,
                    kind_code: 2,
                    name: token_ident(value, cursor + 1),
                    style: 1
                })
            } else { function_classification(name) } } else { if(ident_is(value, cursor, &"cases")) {
                let found = try(
                    name_at(value, cursor + 1, start),
                    @classify_ident
                );
                Result::Ok(Classification {
                    kind: DeclarationKind::EffectRowAlias,
                    kind_code: 4,
                    name: Result::Ok(found),
                    style: 1
                })
            } else { if(fixity_declaration(value, cursor)) {
                    Result::Ok(Classification {
                        kind: DeclarationKind::Fixity,
                        kind_code: 6,
                        name: token_ident(value, cursor + 2),
                        style: 1
                    })
                } else { function_classification(name) } } } }
}

function_classification(name: Id<String>) -> Result<Classification, ScanError> {
    Result::Ok(Classification {
        kind: DeclarationKind::Function,
        kind_code: 12,
        name: Result::Ok( name),
        style: 3
    })
}

import_declaration(value: &super::lexer::LexedSource, cursor: usize) -> Bool {
    handle token_kind_at(value, cursor + 1) {
        TokenKind::LParen => false,
        TokenKind::Lt => false,
        _ => true
    }
}

fixity_declaration(value: &super::lexer::LexedSource, cursor: usize) -> Bool {
    (
        ident_is(value, cursor, &"infixl")
            or { ident_is(value, cursor, &"infixr") }
            or { ident_is(value, cursor, &"infix") }
            or { ident_is(value, cursor, &"prefix") }
    ) and { token_is_number(value, cursor + 1) }
}

scan_state_error(
    kind: DeclarationKind,
    name: Option<Id<String>>,
    error: ScanError
) -> Result<ScanStep, ScanError> {
    Result::Err( error)
}

scan_semicolon_shell(
    value: &super::lexer::LexedSource,
    start: usize,
    cursor: usize,
    limit: usize,
    public: Bool,
    classification: Classification,
    parent: Option<ShellId>
) -> Result<ScanStep, ScanError> {
    let Classification {
        kind,
        kind_code,
        name,
        style: _
    } = classification;
    handle find_semicolon(value, cursor, limit, start) {
        Result::Err(error) => scan_state_error(
            kind,
            name,
             error
        ),
        Result::Ok(end) => {
            if(u8_equal(kind_code, 5)) { handle find_top_level_eq(
                    value,
                    cursor,
                    end
                ) {
                    Result::Err(_) => scan_state_error(
                        kind,
                        name,
                        ScanError::IncompleteDeclaration(end, start)
                    ),
                    Result::Ok(equal) => {
                        let whole = TokenRange {
                            start: start,
                            end: end + 1
                        };
                        Result::Ok(ScanStep {
                            next: end + 1,
                            nested_start: Result::Err(()),
                            nested_end: 0,
                            declaration: DeclarationShell {
                                kind: kind,
                                kind_code: kind_code,
                                public: public,
                                name: name,
                                header: TokenRange {
                                    start: start,
                                    end: equal + 1
                                },
                                body: Result::Ok(TokenRange {
                                    start: equal + 1,
                                    end: end
                                }),
                                whole: whole,
                                parent: parent
                            }
                        })
                    }
                } } else {
                let whole = TokenRange { start: start, end: end + 1 };
                Result::Ok(ScanStep {
                    next: end + 1,
                    nested_start: Result::Err(()),
                    nested_end: 0,
                    declaration: DeclarationShell {
                        kind: kind,
                        kind_code: kind_code,
                        public: public,
                        name: name,
                        header: TokenRange {
                            start: whole.start,
                            end: whole.end
                        },
                        body: Result::Err(()),
                        whole: whole,
                        parent: parent
                    }
                })
            }
        }
    }
}

scan_braced_shell(
    value: &super::lexer::LexedSource,
    start: usize,
    cursor: usize,
    limit: usize,
    public: Bool,
    classification: Classification,
    parent: Option<ShellId>,
    function: Bool
) -> Result<ScanStep, ScanError> {
    let Classification {
        kind,
        kind_code,
        name,
        style: _
    } = classification;
    handle find_body(value, cursor, limit, start, function) {
        Result::Err(error) => scan_state_error(
            kind,
            name,
             error
        ),
        Result::Ok(bounds) => {
            let open = bounds.start;
            let close = bounds.end;
            Result::Ok(ScanStep {
                next: close + 1,
                nested_start: if(u8_equal(kind_code, 1)) {
                    Result::Ok(open + 1)
                } else { Result::Err(()) },
                nested_end: close,
                declaration: DeclarationShell {
                    kind: kind,
                    kind_code: kind_code,
                    public: public,
                    name: name,
                    header: TokenRange { start: start, end: open },
                    body: Result::Ok(TokenRange {
                        start: open + 1,
                        end: close
                    }),
                    whole: TokenRange {
                        start: start,
                        end: close + 1
                    },
                    parent: parent
                }
            })
        }
    }
}

scan_one(
    value: &super::lexer::LexedSource,
    start: usize,
    limit: usize,
    parent: Option<ShellId>
) -> Result<ScanStep, ScanError> {
    let public = ident_is(value, start, &"pub");
    let cursor = if(public) {
        start + 1
    } else { start };
    let classification = try(classify(value, cursor, start), @scan_one);
    let style = classification.style;
    if(u8_equal(style, 1)) { scan_semicolon_shell(
            value,
            start,
            cursor + 1,
            limit,
            public,
            classification,
            parent
        ) } else { if(u8_equal(style, 4)) {
            let style = try(
                find_module_style(value, cursor, limit, start),
                @scan_one
            );
            if(u8_equal(style, 1)) { scan_semicolon_shell(
                    value,
                    start,
                    cursor + 1,
                    limit,
                    public,
                    classification,
                    parent
                ) } else { scan_braced_shell(
                    value,
                    start,
                    cursor + 1,
                    limit,
                    public,
                    classification,
                    parent,
                    false
                ) }
        } else { scan_braced_shell(
                value,
                start,
                cursor + 1,
                limit,
                public,
                classification,
                parent,
                u8_equal(style, 3)
            ) } }
}

find_module_style(
    value: &super::lexer::LexedSource,
    index: usize,
    limit: usize,
    start: usize
) -> Result<u8, ScanError> {
    if(index < limit) { if(token_is_semicolon(value, index)) { Result::Ok(1) } else { if(u8_equal(
                delimiter_open(token_kind_at(value, index)),
                2
            )) { Result::Ok(2) } else { if(u8_equal(
                    delimiter_close(token_kind_at(value, index)),
                    0
                )) { find_module_style(
                        value,
                        index + 1,
                        limit,
                        start
                    ) } else { Result::Err(
                        ScanError::UnexpectedClosingDelimiter(
                        index,
                        super::lexer::token_count(value)
                    )) } } } } else { Result::Err(
                        ScanError::IncompleteDeclaration(limit, start)
                    ) }
}

scan_loop_error(
    scopes: Vec<ScanScope>,
    output: IndexVec<ShellTag, DeclarationShell>,
    error: ScanError
) -> Result<DeclarationIndex, ScanError> {
    Result::Err( error)
}

scan_complete(
    value: &super::lexer::LexedSource,
    scopes: Vec<ScanScope>,
    output: IndexVec<ShellTag, DeclarationShell>
) -> Result<DeclarationIndex, ScanError> {
    let remaining =  scopes;
    handle Vec::pop(&mut remaining) {
        Result::Err(_) => Result::Ok(DeclarationIndex { shells:  output }),
        Result::Ok(scope) => {
            let ScanScope { cursor, limit, parent } = scope;
            scan_loop(value, ScanState {
                cursor: cursor,
                limit: limit,
                parent: parent,
                scopes: remaining,
                output: output
            })
        }
    }
}

scan_loop(
    value: &super::lexer::LexedSource,
    state: ScanState
) -> Result<DeclarationIndex, ScanError> {
    let ScanState {
        cursor,
        limit,
        parent,
        scopes,
        output
    } = state;
    if(cursor < limit) { if(token_is_eof(value, cursor)) { scan_complete(value,  scopes,  output) } else { handle scan_one(
                value,
                cursor,
                limit,
                parent
            ) {
                Result::Err(error) => scan_loop_error(
                     scopes,
                     output,
                     error
                ),
                Result::Ok(step) => {
                    let ScanStep {
                        next,
                        nested_start,
                        nested_end,
                        declaration
                    } = step;
                    handle IndexVec::push(&mut output, declaration) {
                        Result::Err(rejected) => {
                            let token = rejected.whole.start;
                            scan_loop_error(
                                scopes,
                                output,
                                ScanError::DeclarationIdExhausted(token, token)
                            )
                        },
                        Result::Ok(shell) => handle nested_start {
                            Result::Err(_) => scan_loop(value, ScanState {
                                cursor: next,
                                limit: limit,
                                parent: parent,
                                scopes:  scopes,
                                output:  output
                            }),
                            Result::Ok(nested) => {
                                Vec::push(&mut scopes, ScanScope {
                                    cursor: next,
                                    limit: limit,
                                    parent: parent
                                });
                                scan_loop(
                                    value,
                                    ScanState {
                                        cursor: nested,
                                        limit: nested_end,
                                        parent: Option::Some(shell),
                                        scopes:  scopes,
                                        output:  output
                                    }
                                )
                            }
                        }
                    }
                }
            } } } else { scan_complete(value,  scopes,  output) }
}

pub scan(
    value: &super::lexer::LexedSource
) -> Result<DeclarationIndex, ScanError> {
    scan_loop(value, ScanState {
        cursor: 0,
        limit: super::lexer::token_count(value),
        parent: Result::Err(()),
        scopes: Vec::new(),
        output: IndexVec::new()
    })
}

bool_code(value: Bool) -> u8 {
    if(value) { 1 } else { 0 }
}

write_string(output: &mut ByteBuf, value: &String) {
    let bytes = String::as_bytes(value);
    ByteBuf::write_u32_le(
        &mut *output,
        wrapping_convert_to_u32(Bytes::len(&bytes))
    );
    ByteBuf::append_bytes( output, &bytes)
}

write_optional_name(
    output: &mut ByteBuf,
    lexed: &super::lexer::LexedSource,
    value: &Option<Id<String>>
) {
    handle Option::as_ref(value) {
        Result::Err(_) => ByteBuf::push( output, 0),
        Result::Ok(name) => {
            ByteBuf::push(&mut *output, 1);
            handle super::lexer::lexeme(lexed, *name) {
                Result::Err(_) => unreachable(),
                Result::Ok(text) => write_string( output,  text)
            }
        }
    }
}

write_range(output: &mut ByteBuf, value: &TokenRange) {
    ByteBuf::write_u32_le(
        &mut *output,
        wrapping_convert_to_u32(value.start)
    );
    ByteBuf::write_u32_le(
         output,
        wrapping_convert_to_u32(value.end)
    )
}

write_optional_range(output: &mut ByteBuf, value: &Option<TokenRange>) {
    handle Option::as_ref(value) {
        Result::Err(_) => ByteBuf::push( output, 0),
        Result::Ok(range) => {
            ByteBuf::push(&mut *output, 1);
            write_range( output, range)
        }
    }
}

write_optional_parent(output: &mut ByteBuf, value: &Option<ShellId>) {
    handle Option::as_ref(value) {
        Result::Err(_) => ByteBuf::push( output, 0),
        Result::Ok(parent) => {
            ByteBuf::push(&mut *output, 1);
            ByteBuf::write_u32_le(
                 output,
                Id::to_u32(*parent)
            )
        }
    }
}

write_shells(
    output: &mut ByteBuf,
    lexed: &super::lexer::LexedSource,
    value: &DeclarationIndex
) {
    for_each_shell(value, { _, shell => {
        ByteBuf::push(&mut *output, shell.kind_code);
        ByteBuf::push(&mut *output, bool_code(shell.public));
        write_optional_name(&mut *output, lexed, &shell.name);
        write_range(&mut *output, &shell.header);
        write_optional_range(&mut *output, &shell.body);
        write_range(&mut *output, &shell.whole);
        write_optional_parent(&mut *output, &shell.parent)
    }})
}

encode_scan(
    output: &mut ByteBuf,
    lexed: super::lexer::LexedSource
) {
    handle scan(&lexed) {
        Result::Err(error) => {
            ByteBuf::push(&mut *output, 2);
            ByteBuf::push(&mut *output, scan_error_code(&error));
            ByteBuf::write_u32_le(
                &mut *output,
                wrapping_convert_to_u32(scan_error_token(&error))
            );
            ByteBuf::write_u32_le(
                 output,
                wrapping_convert_to_u32(scan_error_related(&error))
            )
        },
        Result::Ok(index) => {
            ByteBuf::push(&mut *output, 0);
            ByteBuf::write_u32_le(
                &mut *output,
                wrapping_convert_to_u32(shell_count(&index))
            );
            write_shells(output, &lexed, &index)
        }
    }
}

process_inputs(arguments: &Vec<String>, index: usize, output: &mut ByteBuf) / FileRead {
    for_range(Range::new(index, Vec::len(arguments)), { current => {
        let path = *Vec::index(arguments, current);
        let bytes = read_file(path);
        handle String::from_utf8(bytes) {
            Result::Err(_) => ByteBuf::push(&mut *output, 1),
            Result::Ok(source) => handle super::lexer::lex(&source) {
                Result::Err(_) => ByteBuf::push(&mut *output, 1),
                Result::Ok(lexed) => encode_scan(&mut *output, lexed)
            }
        }
    }})
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    let argument_count = Vec::len(&arguments);
    if(argument_count < 2) {
        write_diagnostic(
            "usage: grandiose-self-host-scanner <output> <input>..."
        )
    } else {
        let output_path = *Vec::index(&arguments, 0);
        let encoded = ByteBuf::new();
        ByteBuf::write_u32_le(
            &mut encoded,
            wrapping_convert_to_u32(argument_count - 1)
        );
        process_inputs(&arguments, 1, &mut encoded);
        write_file(output_path, ByteBuf::finish( encoded))
    }
}
