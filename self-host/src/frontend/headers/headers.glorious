header_range(start: usize, end: usize) -> HeaderRange {
    super::syntax::id_range(start, end)
}

token_range(start: usize, end: usize) -> HeaderTokenRange {
    super::syntax::token_span(start, end)
}

next_index(value: usize) -> usize { value + 1 }

previous_index(value: usize) -> usize { value - 1 }

record_header(
    order: &mut ParsedDefTable,
    shell: ShellId,
    header: HeaderOrder
) {
    Vec::push(&mut order.order, Def { shell: shell, kind: header });
    handle HashMap::insert(&mut order.by_shell, shell, header) {
        Result::Err(_) => (),
        Result::Ok(previous) => { previous; () }
    }
}

index_enum_members(
    definitions: &mut ParsedDefTable,
    variants: &VariantArena,
    owner: EnumHeaderId,
    index: usize,
    end: usize
) {
    if(index < end) {
        let variant = Vec::index(&variants.values, index);
        let key = (owner, variant.name);
        let member = handle HashMap::remove(
            &mut definitions.enum_members,
            &key
        ) {
            Result::Err(_) => typed_header_id(index),
            Result::Ok(previous) => previous
        };
        handle HashMap::insert(
            &mut definitions.enum_members,
            key,
            member
        ) {
            Result::Err(_) => (),
            Result::Ok(previous) => { previous; () }
        };
        index_enum_members(definitions, variants, owner, index + 1, end)
    } else { () }
}

fixity_name(
    original: &String,
    parser: &Parser,
    operator: &HeaderTokenRange
) -> Id<String> {
    let first = token_span_at(parser, operator.start);
    let last = token_span_at(parser, operator.end - 1);
    let spelling = source_text(
        original,
        super::lexer::span_start(&first),
        super::lexer::span_end(&last)
    );
    handle super::lexer::lexeme_id(&parser.source, &spelling) {
        None => unreachable(),
        Option::Some(found) => found
    }
}

index_fixity(
    definitions: &mut ParsedDefTable,
    fixities: &FixityArena,
    owner: Option<ShellId>,
    name: Id<String>,
    id: FixityHeaderId
) {
    let current = Vec::index(&fixities.values, Id::to_usize(id));
    let key = (owner, name, current.form == 1);
    handle HashMap::insert(&mut definitions.fixities, key, FixitySearch {
        selected: id,
        conflict: None
    }) {
        Result::Err(_) => (),
        Result::Ok(previous) => {
            let selected_id = previous.selected;
            let selected = Vec::index(
                &fixities.values,
                Id::to_usize(selected_id)
            );
            let conflict = if(Option::is_some(&previous.conflict)) {
                previous.conflict
            } else {
                let compatible = if(selected.form == current.form) {
                    selected.precedence == current.precedence
                } else {
                    false
                };
                if(compatible) {
                    None
                } else {
                    Option::Some(id)
                }
            };
            handle HashMap::insert(
                &mut definitions.fixities,
                (owner, name, current.form == 1),
                FixitySearch {
                    selected: selected_id,
                    conflict: conflict
                }
            ) {
                Result::Err(_) => (),
                Result::Ok(replaced) => { replaced; () }
            }
        }
    }
}

header_bounds(value: &super::scanner::DeclarationShell) -> HeaderBounds {
    let range = super::scanner::shell_header(value);
    HeaderBounds {
        start: super::scanner::range_start(range),
        end: super::scanner::range_end(range)
    }
}

whole_bounds(value: &super::scanner::DeclarationShell) -> HeaderBounds {
    let range = super::scanner::shell_whole(value);
    HeaderBounds {
        start: super::scanner::range_start(range),
        end: super::scanner::range_end(range)
    }
}

token_span_at(value: &Parser, index: usize) -> super::lexer::Span {
    handle super::lexer::token_at(&value.source, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::lexer::token_span(token)
    }
}

source_text(value: &String, start: usize, end: usize) -> String {
    handle String::slice(value, Range { start: start, end: end }) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) =>  found
    }
}

at_token(value: &Parser, pattern: TokenPattern) -> Bool {
    let tokens = &value.tokens;
    super::syntax::cursor_at(tokens, &value.source, pattern)
}

eat_token(value: &mut Parser, pattern: TokenPattern) -> Bool {
    let tokens = &mut value.tokens;
    super::syntax::cursor_eat(tokens, &value.source, pattern)
}

expect_left_parenthesis(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    if(eat_token(value, TokenPattern::LParen)) {
        Result::Ok(())
    } else {
        Result::Err(HeaderError::ExpectedLeftParenthesis(token, related))
    }
}

expect_right_parenthesis(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    if(eat_token(value, TokenPattern::RParen)) {
        Result::Ok(())
    } else {
        Result::Err(HeaderError::ExpectedRightParenthesis(token, related))
    }
}

expect_right_angle(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    if(eat_token(value, TokenPattern::Gt)) {
        Result::Ok(())
    } else {
        Result::Err(HeaderError::ExpectedRightAngle(token, related))
    }
}

expect_colon(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    if(eat_token(value, TokenPattern::Colon)) {
        Result::Ok(())
    } else {
        Result::Err(HeaderError::ExpectedColon(token, related))
    }
}

expect_right_brace(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    if(eat_token(value, TokenPattern::RBrace)) {
        Result::Ok(())
    } else {
        Result::Err(HeaderError::ExpectedRightBrace(token, related))
    }
}

expect_semicolon(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    if(eat_token(value, TokenPattern::Semicolon)) {
        Result::Ok(())
    } else {
        Result::Err(HeaderError::ExpectedSemicolon(token, related))
    }
}

expect_equals(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    if(eat_token(value, TokenPattern::Eq)) {
        Result::Ok(())
    } else {
        Result::Err(HeaderError::ExpectedEquals(token, related))
    }
}

ident(value: &mut Parser, related: usize) -> Result<NameUse, HeaderError> {
    let token = value.tokens.position;
    if(value.tokens.position < value.tokens.limit) { handle super::lexer::token_kind_at(&value.source, token) {
            TokenKind::Ident(name) => {
                value.tokens.position = token + 1;
                Result::Ok(NameUse { name: name, token: token })
            },
            _ => Result::Err(HeaderError::ExpectedIdentifier(token, related))
        } } else {
            Result::Err(HeaderError::ExpectedIdentifier(token, related))
        }
}

at_ident(value: &Parser, expected: &String) -> Bool {
    if(value.tokens.position < value.tokens.limit) {
        handle super::lexer::token_kind_at(
            &value.source,
            value.tokens.position
        ) {
            TokenKind::Ident(name) => if(super::lexer::lexeme(
                &value.source,
                name
            ) is Result::Ok(found)) {
                *found == *expected
            } else { false },
            _ => false
        }
    } else { false }
}

next_is_ident(value: &Parser) -> Bool {
    let next = value.tokens.position + 1;
    next < value.tokens.limit
        and {
            super::lexer::token_matches_at(
                &value.source,
                next,
                TokenPattern::Ident
            )
        }
}

push_type(
    value: &mut Parser,
    kind: HeaderTypeKind,
    start: usize,
    related: usize
) -> Result<TypeId, HeaderError> {
    let end = value.tokens.position;
    handle Arena::alloc(
        &mut value.output.types,
        TypeNode {
            kind: kind,
            tokens: token_range(start, end)
        }
    ) {
        Result::Err(_) => Result::Err(
            HeaderError::TypeArenaExhausted(start, related)
        ),
        Result::Ok(id) => Result::Ok(id)
    }
}

copy_type_kind(
    types: &Arena<TypeTag, TypeNode>,
    id: TypeId
) -> HeaderTypeKind {
    let node = Arena::index(types, id);
    handle node.kind {
        HeaderTypeKind::Path(names) => HeaderTypeKind::Path(names),
        HeaderTypeKind::SharedReference(lifetime, referent) =>
            HeaderTypeKind::SharedReference(lifetime, referent),
        HeaderTypeKind::UniqueReference(lifetime, referent) =>
            HeaderTypeKind::UniqueReference(lifetime, referent),
        HeaderTypeKind::Tuple(elements) => HeaderTypeKind::Tuple(elements),
        HeaderTypeKind::Application(constructor, lifetimes, arguments, const_arguments) =>
            HeaderTypeKind::Application(constructor, lifetimes, arguments, const_arguments),
        HeaderTypeKind::Never => HeaderTypeKind::Never
    }
}

append_edges(
    output: &mut Vec<TypeEdge>,
    values: &Vec<TypeId>,
    index: usize,
    position: u32
) {
    for_range(Range::new(index, Vec::len(values)), { current => {
        Vec::push(
            &mut *output,
            TypeEdge {
                value: *Vec::index(values, current),
                position: position + wrapping_convert_to_u32(current - index)
            }
        )
    }})
}

append_name_uses(
    output: &mut Vec<NameUse>,
    values: &Vec<NameUse>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(values)), { current => {
        Vec::push(&mut *output, *Vec::index(values, current))
    }})
}

parse_lifetime_arguments(
    value: &mut Parser,
    related: usize,
    values: &mut Vec<NameUse>
) -> Result<(), HeaderError> {
    let leading_lifetime = take_lifetime(value);
    handle leading_lifetime {
        Result::Err(_) => Result::Ok(()),
        Result::Ok(found) => {
            Vec::push(&mut *values, found);
            if(eat_token(value, TokenPattern::Comma)) {
                if(at_token(&*value, TokenPattern::Gt)) {
                    Result::Ok(())
                } else {
                    parse_lifetime_arguments(value, related, values)
                }
            } else { Result::Ok(()) }
        }
    }
}

parse_application_arguments(
    value: &mut Parser,
    closing: TokenPattern,
    related: usize,
    lifetimes: &mut Vec<NameUse>,
    types: &mut Vec<TypeEdge>,
    const_arguments: &mut u32,
    position: u32
) -> Result<(), HeaderError> {
    if(at_token(&*value, closing)) {
        Result::Ok(())
    } else {
        let token = value.tokens.position;
        handle super::lexer::token_kind_at(&value.source, token) {
            TokenKind::Number(number) => if(integer_number(&number)) {
                value.tokens.position = token + 1;
                *const_arguments = *const_arguments + 1;
                parse_application_argument_separator(
                    value, closing, related, lifetimes, types, const_arguments, position + 1
                )
            } else { Result::Err(HeaderError::ExpectedIdentifier(token, related)) },
            _ => {
        let lifetime = take_lifetime(value);
        handle lifetime {
            Result::Ok(found) => {
                Vec::push(lifetimes, found);
                parse_application_argument_separator(
                    value, closing, related, lifetimes, types, const_arguments, position + 1
                )
            },
            Result::Err(_) => {
                let ty = try(parse_type(value, related), @parse_application_arguments);
                Vec::push(
                    types,
                    TypeEdge { value: ty, position: position }
                );
                parse_application_argument_separator(
                    value, closing, related, lifetimes, types, const_arguments, position + 1
                )
            }
        }
            }
        }
    }
}

parse_application_argument_separator(
    value: &mut Parser,
    closing: TokenPattern,
    related: usize,
    lifetimes: &mut Vec<NameUse>,
    types: &mut Vec<TypeEdge>,
    const_arguments: &mut u32,
    position: u32
) -> Result<(), HeaderError> {
    if(eat_token(value, TokenPattern::Comma)) {
        parse_application_arguments(
            value, closing, related, lifetimes, types, const_arguments, position
        )
    } else { Result::Ok(()) }
}

parse_type_values(
    value: &mut Parser,
    closing: TokenPattern,
    related: usize,
    values: &mut Vec<TypeId>
) -> Result<(), HeaderError> {
    if(at_token(&*value, closing)) {
        Result::Ok(())
    } else {
        let ty = try(parse_type(value, related), @parse_type_values);
        Vec::push(&mut *values, ty);
        if(eat_token(value, TokenPattern::Comma)) { if(at_token(&*value, closing)) { Result::Ok(()) } else { parse_type_values(
                    value,
                    closing,
                    related,
                     values
                ) } } else { Result::Ok(()) }
    }
}

parse_path(value: &mut Parser, related: usize) -> Result<TypeId, HeaderError> {
    let start = value.tokens.position;
    let name_start = super::syntax::range_mark(&value.output.names);
    let name = try(ident(value, related), @parse_path);
    Vec::push(&mut value.output.names, name);
    parse_path_tail(value, related, start, name_start)
}

parse_path_tail(
    value: &mut Parser,
    related: usize,
    start: usize,
    name_start: usize
) -> Result<TypeId, HeaderError> {
    if(eat_token(value, TokenPattern::DoubleColon)) {
        let name = try(ident(value, related), @parse_path_tail);
        Vec::push(&mut value.output.names, name);
        parse_path_tail(value, related, start, name_start)
    } else {
        let name_end = Vec::len(&value.output.names);
        let names = header_range(name_start, name_end);
        let path = try(
            push_type(
                value,
                HeaderTypeKind::Path(names),
                start,
                related
            ),
            @parse_path_tail
        );
        parse_application(value, related, start, path)
    }
}

parse_application(
    value: &mut Parser,
    related: usize,
    start: usize,
    constructor: TypeId
) -> Result<TypeId, HeaderError> {
    if(eat_token(value, TokenPattern::Lt)) { if(at_token(&*value, TokenPattern::Gt)) { Result::Err(
                HeaderError::EmptyTypeArguments(value.tokens.position, related)
            ) } else {
        let lifetime_values = Vec::new();
        let arguments = Vec::new();
        let const_arguments = 0;
        try(
            parse_application_arguments(
                value,
                TokenPattern::Gt,
                related,
                &mut lifetime_values,
                &mut arguments,
                &mut const_arguments,
                0
            ),
            @parse_application
        );
        try(expect_right_angle(value, related), @parse_application);
        let lifetime_start = super::syntax::range_mark(
            &value.output.lifetime_arguments
        );
        append_name_uses(
            &mut value.output.lifetime_arguments,
            &lifetime_values,
            0
        );
        let lifetime_end = Vec::len(&value.output.lifetime_arguments);
        let lifetimes = header_range(lifetime_start, lifetime_end);
        let edge_start = super::syntax::range_mark(&value.output.type_edges);
        for_range(Range::new(0, Vec::len(&arguments)), { current => {
            Vec::push(
                &mut value.output.type_edges,
                *Vec::index(&arguments, current)
            )
        }});
        let edge_end = Vec::len(&value.output.type_edges);
        let arguments = header_range(edge_start, edge_end);
        push_type(
            value,
            HeaderTypeKind::Application(constructor, lifetimes, arguments, const_arguments),
            start,
            related
        )
        } } else { Result::Ok(constructor) }
}

parse_reference(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<TypeId, HeaderError> {
    let lifetime = take_lifetime(value);
    parse_reference_referent(value, related, start,  lifetime)
}

take_lifetime(value: &mut Parser) -> Option<NameUse> {
    let cursor = value.tokens.position;
    let limit = value.tokens.limit;
    let kind = if(cursor < limit) { super::lexer::token_kind_at(&value.source, cursor) } else { TokenKind::Eof };
    if(cursor < limit) {
        handle kind {
            TokenKind::Lifetime(name) => {
                let token = cursor;
                value.tokens.position = token + 1;
                Result::Ok(NameUse { name: name, token: token })
            },
            _ => Result::Err(())
        }
    } else { Result::Err(()) }
}

parse_reference_referent(
    value: &mut Parser,
    related: usize,
    start: usize,
    lifetime: Option<NameUse>
) -> Result<TypeId, HeaderError> {
    if(at_ident(&*value, &"mut")) {
        value.tokens.position = value.tokens.position + 1;
        parse_reference_kind(
            value,
            related,
            start,
            lifetime,
            true
        )
    } else { parse_reference_kind(
            value,
            related,
            start,
            lifetime,
            false
        ) }
}

parse_reference_kind(
    value: &mut Parser,
    related: usize,
    start: usize,
    lifetime: Option<NameUse>,
    unique: Bool
) -> Result<TypeId, HeaderError> {
    let referent = try(parse_type(value, related), @parse_reference_kind);
    let kind = if(unique) {
        HeaderTypeKind::UniqueReference(lifetime, referent)
    } else {
        HeaderTypeKind::SharedReference(lifetime, referent)
    };
    push_type(
        value,
        kind,
        start,
        related
    )
}

parse_tuple(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<TypeId, HeaderError> {
    if(eat_token(value, TokenPattern::RParen)) {
        finish_tuple(value, start, related, Vec::new())
    } else {
        let first = try(parse_type(value, related), @parse_tuple);
        if(eat_token(value, TokenPattern::Comma)) {
            let elements = Vec::new();
            Vec::push(&mut elements, first);
            try(
                parse_type_values(
                    value,
                    TokenPattern::RParen,
                    related,
                    &mut elements
                ),
                @parse_tuple
            );
            try(expect_right_parenthesis(value, related), @parse_tuple);
            finish_tuple(value, start, related, elements)
        } else {
            try(expect_right_parenthesis(value, related), @parse_tuple);
            let kind = copy_type_kind(&value.output.types, first);
            push_type(value, kind, start, related)
        }
    }
}

finish_tuple(
    value: &mut Parser,
    start: usize,
    related: usize,
    elements: Vec<TypeId>
) -> Result<TypeId, HeaderError> {
    let edge_start = super::syntax::range_mark(&value.output.type_edges);
    append_edges(&mut value.output.type_edges, &elements, 0, 0);
    let edge_end = Vec::len(&value.output.type_edges);
    let elements = header_range(edge_start, edge_end);
    push_type(
        value,
        HeaderTypeKind::Tuple(elements),
        start,
        related
    )
}

parse_type(value: &mut Parser, related: usize) -> Result<TypeId, HeaderError> {
    let start = value.tokens.position;
    if(eat_token(value, TokenPattern::Amp)) { parse_reference(value, related, start) } else { if(eat_token(value, TokenPattern::LParen)) { parse_tuple(value, related, start) } else { if(eat_token(value, TokenPattern::Bang)) { push_type(
                    value,
                    HeaderTypeKind::Never,
                    start,
                    related
                ) } else { parse_path(value, related) } } }
}

parse_generics(value: &mut Parser, related: usize) -> Result<HeaderRange, HeaderError> {
    let start = super::syntax::range_mark(&value.output.generic_params);
    if(eat_token(value, TokenPattern::Lt)) { parse_generic_items(value, related, start) } else { Result::Ok(header_range(start, start)) }
}

parse_generic_items(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<HeaderRange, HeaderError> {
    if(at_token(&*value, TokenPattern::Gt)) {
        Result::Err(
            HeaderError::EmptyGenericParameters(value.tokens.position, related)
        )
    } else {
        let found = try(parse_one_generic(value, related), @parse_generic_items);
        Vec::push(&mut value.output.generic_params, found);
        if(eat_token(value, TokenPattern::Comma)) { if(at_token(&*value, TokenPattern::Gt)) { finish_generics(value, related, start) } else { parse_generic_items(
                    value,
                    related,
                    start
                ) } } else { finish_generics(value, related, start) }
    }
}

parse_one_generic(
    value: &mut Parser,
    related: usize
) -> Result<GenericParam, HeaderError> {
    let token = value.tokens.position;
    handle super::lexer::token_kind_at(&value.source, token) {
        TokenKind::Lifetime(name) => {
            value.tokens.position = token + 1;
            Result::Ok(GenericParam {
                name: name,
                kind: GenericParamKind::Lifetime,
                tokens: token_range(token, value.tokens.position)
            })
        },
        _ => {
            if(at_ident(&*value, &"const")) {
                value.tokens.position = value.tokens.position + 1;
                let name = try(ident(value, related), @parse_one_generic);
                if(eat_token(value, TokenPattern::Colon)) {
                    try(parse_type(value, related), @parse_one_generic);
                    Result::Ok(GenericParam {
                        name: name.name,
                        kind: GenericParamKind::Const,
                        tokens: token_range(token, value.tokens.position)
                    })
                } else {
                    Result::Err(HeaderError::UnsupportedGenericParameterKind(
                        value.tokens.position,
                        related
                    ))
                }
            } else {
                let name = try(ident(value, related), @parse_one_generic);
                if(eat_token(value, TokenPattern::Colon)) {
                    if(at_ident(&*value, &"EffectRow")) {
                        value.tokens.position = value.tokens.position + 1;
                        Result::Ok(GenericParam {
                            name: name.name,
                            kind: GenericParamKind::EffectRow,
                            tokens: token_range(token, value.tokens.position)
                        })
                    } else {
                        Result::Err(
                        HeaderError::UnsupportedGenericParameterKind(
                            value.tokens.position,
                            related
                        )
                        )
                    }
                } else {
                    Result::Ok(GenericParam {
                        name: name.name,
                        kind: GenericParamKind::Type,
                        tokens: token_range(token, value.tokens.position)
                    })
                }
            }
        }

    }
}

finish_generics(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<HeaderRange, HeaderError> {
    try(expect_right_angle(value, related), @finish_generics);
    let end = Vec::len(&value.output.generic_params);
    Result::Ok(header_range(start, end))
}

parse_parameters(
    value: &mut Parser,
    related: usize
) -> Result<HeaderRange, HeaderError> {
    let start = super::syntax::range_mark(&value.output.parameters);
    if(at_token(&*value, TokenPattern::RParen)) { Result::Ok(header_range(start, start)) } else { parse_parameter_items(value, related, start) }
}

parse_parameter_items(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<HeaderRange, HeaderError> {
    let name = try(ident(value, related), @parse_parameter_items);
    try(expect_colon(value, related), @parse_parameter_items);
    let ty = try(parse_type(value, related), @parse_parameter_items);
    Vec::push(
        &mut value.output.parameters,
        Parameter {
            name: name.name,
            name_token: name.token,
            ty: ty
        }
    );
    if(eat_token(value, TokenPattern::Comma)) {
        if(at_token(&*value, TokenPattern::RParen)) {
            let end = Vec::len(&value.output.parameters);
            Result::Ok(header_range(start, end))
        } else {
            parse_parameter_items(value, related, start)
        }
    } else {
        let end = Vec::len(&value.output.parameters);
        Result::Ok(header_range(start, end))
    }
}

parse_effect_row(value: &mut Parser, related: usize) -> Result<EffectRow, HeaderError> {
    let start = value.tokens.position;
    let effects = Vec::new();
    if(eat_token(value, TokenPattern::LBrace)) { parse_effect_items(value, related, start,  effects) } else {
        let found_effect = try(parse_type(value, related), @parse_effect_row);
        Vec::push(&mut effects, found_effect);
        finish_effects(
            value,
            start,
             effects,
            Result::Err(())
        )
    }
}

parse_effect_items(
    value: &mut Parser,
    related: usize,
    start: usize,
    effects: Vec<TypeId>
) -> Result<EffectRow, HeaderError> {
    if(eat_token(value, TokenPattern::Pipe)) {
        let row_tail = try(ident(value, related), @parse_effect_items);
        try(expect_right_brace(value, related), @parse_effect_items);
        finish_effects(
            value,
            start,
             effects,
            Result::Ok(row_tail)
        )
    } else { if(eat_token(value, TokenPattern::RBrace)) { finish_effects(
                value,
                start,
                 effects,
                Result::Err(())
            ) } else {
            let found_effect = try(
                parse_type(value, related),
                @parse_effect_items
            );
            let next =  effects;
            Vec::push(&mut next, found_effect);
            if(eat_token(value, TokenPattern::Comma)) { parse_effect_items(
                    value,
                    related,
                    start,
                     next
                ) } else { parse_effect_items(
                    value,
                    related,
                    start,
                     next
                ) }
        } }
}

finish_effects(
    value: &mut Parser,
    start: usize,
    effects: Vec<TypeId>,
    row_tail: Option<NameUse>
) -> Result<EffectRow, HeaderError> {
    let edge_start = super::syntax::range_mark(&value.output.type_edges);
    append_edges(
        &mut value.output.type_edges,
        &effects,
        0,
        0
    );
    let edge_end = Vec::len(&value.output.type_edges);
    Result::Ok(EffectRow {
        effects: header_range(edge_start, edge_end),
        row_tail: row_tail,
        tokens: token_range(start, value.tokens.position)
    })
}

parse_callable(
    original: &String,
    value: &mut Parser,
    shell: ShellId,
    public: Bool,
    start: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start;
    if(public) {
        value.tokens.position = value.tokens.position + 1;
    } else { () };
    let name = try(ident(value, start), @parse_callable);
    let generic_token_start = value.tokens.position;
    let generics = try(parse_generics(value, start), @parse_callable);
    let generic_tokens = token_range(generic_token_start, value.tokens.position);
    try(expect_left_parenthesis(value, start), @parse_callable);
    let parameters = try(parse_parameters(value, start), @parse_callable);
    try(expect_right_parenthesis(value, start), @parse_callable);
    parse_callable_suffix(
        original,
        value,
        shell,
         public,
        start,
        name,
        generics,
        generic_tokens,
        parameters
    )
}

parse_callable_suffix(
    original: &String,
    value: &mut Parser,
    shell: ShellId,
    public: Bool,
    start: usize,
    name: NameUse,
    generics: HeaderRange,
    generic_tokens: HeaderTokenRange,
    parameters: HeaderRange
) -> Result<(), HeaderError> {
    if(eat_token(value, TokenPattern::Arrow)) { if(at_token(&*value, TokenPattern::Slash)) { parse_callable_effects(
                original, value,
                shell,
                public,
                start,
                name,
                generics,
                generic_tokens,
                parameters,
                Result::Err(())
            ) } else if(value.tokens.position == value.tokens.limit) {
            parse_callable_effects(
                original, value,
                shell,
                public,
                start,
                name,
                generics,
                generic_tokens,
                parameters,
                Result::Err(())
            )
        } else {
            let parsed_result = try(
                parse_type(value, start),
                @parse_callable_suffix
            );
            parse_callable_effects(
                original, value,
                shell,
                public,
                start,
                name,
                generics,
                generic_tokens,
                parameters,
                Result::Ok(parsed_result)
            )
        } } else { parse_callable_effects(
            original, value,
            shell,
            public,
            start,
            name,
            generics,
            generic_tokens,
            parameters,
            Result::Err(())
        ) }
}

parse_callable_effects(
    original: &String,
    value: &mut Parser,
    shell: ShellId,
    public: Bool,
    start: usize,
    name: NameUse,
    generics: HeaderRange,
    generic_tokens: HeaderTokenRange,
    parameters: HeaderRange,
    result: Option<TypeId>
) -> Result<(), HeaderError> {
    if(eat_token(value, TokenPattern::Slash)) {
        let parsed_effects = try(
            parse_effect_row(value, start),
            @parse_callable_effects
        );
        finish_callable(
            original,
            value,
            shell,
            public,
            start,
        name,
        generics,
        generic_tokens,
        parameters,
            result,
            Result::Ok(parsed_effects)
        )
    } else { finish_callable(
        original,
        value,
            shell,
            public,
            start,
            name,
            generics,
            generic_tokens,
            parameters,
            result,
            Result::Err(())
        ) }
}

finish_callable(
    original: &String,
    value: &mut Parser,
    shell: ShellId,
    public: Bool,
    start: usize,
    name: NameUse,
    generics: HeaderRange,
    generic_tokens: HeaderTokenRange,
    parameters: HeaderRange,
    result: Option<TypeId>,
    effects: Option<EffectRow>
) -> Result<(), HeaderError> {
    let where_start = value.tokens.position;
    let where_tokens = if(where_start < value.tokens.limit) {
        handle super::lexer::token_kind_at(&value.source, where_start) {
            TokenKind::Keyword(super::lexer::Keyword::Where) => {
                // Constraint grammar is intentionally retained as a bounded
                // syntax range here. Generic interface elaboration owns its
                // semantic parsing because relation arguments are not merely
                // types (`Use<[0, *]>`, associated bindings, lifetimes).
                if(where_start + 1 < value.tokens.limit) {
                    value.tokens.position = value.tokens.limit;
                    token_range(where_start, value.tokens.limit)
                } else {
                    @finish_callable(Result::Err(
                        HeaderError::EmptyWhereClause(value.tokens.limit, start)
                    ))
                }
            },
            _ => token_range(where_start, where_start)
        }
    } else { token_range(where_start, where_start) };
    let where_clause = try(parse_structured_where_clause(
        original, value, start, where_tokens
    ), @finish_callable);
    if(value.tokens.position == value.tokens.limit) {
        let limit = value.tokens.limit;
        Vec::push(
            &mut value.output.callables,
            CallableHeader {
                shell: shell,
                name: name.name,
                public: public,
                generics: generics,
                generic_tokens: generic_tokens,
                parameters: parameters,
                result: result,
                effects: effects,
                where_tokens: where_tokens,
                where_clause: where_clause,
                tokens: token_range(start, limit)
            }
        );
        Result::Ok(())
    } else { Result::Err(
            HeaderError::UnexpectedTrailingHeaderToken(value.tokens.position, start)
        ) }
}

fixity_form(value: &Parser) -> u8 {
    if(at_ident(value, &"prefix")) { 1 } else { if(at_ident(value, &"infixl")) { 2 } else { if(at_ident(value, &"infixr")) { 3 } else { if(at_ident(value, &"infix")) {
                    4
                } else { 0 } } } }
}

integer_number(value: &super::lexer::NumberToken) -> Bool {
    not(Option::as_ref(super::lexer::number_fraction(value)) is Option::Some(_))
        and {
            not(
                Option::as_ref(super::lexer::number_exponent(value))
                    is Option::Some(_)
            )
        }
}

parse_precedence(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<u8, HeaderError> {
    let token = value.tokens.position;
    handle super::lexer::token_kind_at(&value.source, token) {
        super::lexer::TokenKind::Number(number) => if(integer_number(&number)) {
            let spelling = super::lexer::number_spelling(&number);
            let text = source_text(
                original,
                super::lexer::span_start(&spelling),
                super::lexer::span_end(&spelling)
            );
            handle parse_u64(&text) {
                Result::Err(_) => Result::Err(
                    HeaderError::PrecedenceOutOfRange(token, related)
                ),
                Result::Ok(found) => if(found <= 255) {
                    value.tokens.position = token + 1;
                    Result::Ok(wrapping_convert_to_u8(found))
                } else { Result::Err(
                        HeaderError::PrecedenceOutOfRange(token, related)
                    ) }
            }
        } else {
            Result::Err(
                HeaderError::ExpectedIntegerPrecedence(token, related)
            )
        },
        _ => Result::Err(
            HeaderError::ExpectedIntegerPrecedence(token, related)
        )
    }
}

operator_symbol(value: &Parser, index: usize) -> Bool {
    super::lexer::operator_symbol_at(&value.source, index)
}

operator_tail(value: &Parser, cursor: usize, previous_end: usize) -> usize {
    super::lexer::operator_end(
        &value.source,
        cursor,
        value.tokens.limit,
        previous_end
    )
}

take_operator(
    value: &mut Parser,
    related: usize
) -> Result<HeaderTokenRange, HeaderError> {
    let start = value.tokens.position;
    if(start < value.tokens.limit) { if(super::lexer::token_matches_at(
        &value.source,
        start,
        TokenPattern::Ident
    )) {
            value.tokens.position = start + 1;
            Result::Ok(token_range(start, value.tokens.position))
        } else { if(operator_symbol(&*value, start)) {
                let first = token_span_at(&*value, start);
                let end = operator_tail(
                    &*value,
                    start + 1,
                    super::lexer::span_end(&first)
                );
                value.tokens.position = end;
                Result::Ok(token_range(start, end))
            } else {
                Result::Err(HeaderError::ExpectedOperator(start, related))
            } } } else {
                Result::Err(HeaderError::ExpectedOperator(start, related))
            }
}

parse_fixity(
    original: &String,
    declarations: &super::scanner::DeclarationIndex,
    value: &mut Parser,
    fixities: &mut FixityArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start;
    value.tokens.limit = whole_end;
    if(public) {
        value.tokens.position = value.tokens.position + 1;
    } else { () };
    let form = fixity_form(&*value);
    if(form == 0) { Result::Err(
        HeaderError::InvalidFixityForm(value.tokens.position, start)
    ) } else {
        value.tokens.position = value.tokens.position + 1;
        let precedence = try(
            parse_precedence(original, value, start),
            @parse_fixity
        );
        let operator = try(take_operator(value, start), @parse_fixity);
        try(expect_semicolon(value, start), @parse_fixity);
        if(value.tokens.position == value.tokens.limit) {
            let name = fixity_name(original, &*value, &operator);
            Vec::push(
                &mut fixities.values,
                FixityHeader {
                    shell: shell,
                    public: public,
                    form: form,
                    precedence: precedence,
                    operator: operator,
                    tokens: token_range(start, whole_end)
                }
            );
            let index = Vec::len(&fixities.values) - 1;
            let id = typed_header_id(index);
            let owner = handle super::scanner::shell_at(
                declarations,
                shell
            ) {
                Result::Err(_) => None,
                Result::Ok(found) => *super::scanner::shell_parent(found)
            };
            record_header(
                order,
                shell,
                HeaderOrder::Fixity(id)
            );
            index_fixity(order, &*fixities, owner, name, id);
            Result::Ok(())
        } else { Result::Err(
                HeaderError::UnexpectedTrailingHeaderToken(value.tokens.position, start)
            ) }
    }
}

parse_alias(
    value: &mut Parser,
    aliases: &mut AliasArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start;
    if(public) {
        value.tokens.position = value.tokens.position + 1;
    } else { () };
    parse_alias_name(
        value,
        aliases,
        order,
        shell,
         public,
        start,
        whole_end
    )
}

parse_alias_name(
    value: &mut Parser,
    aliases: &mut AliasArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = value.tokens.position + 1;
    let name = try(ident(value, start), @parse_alias_name);
    let generics = try(parse_generics(value, start), @parse_alias_name);
    try(expect_equals(value, start), @parse_alias_name);
    value.tokens.limit = whole_end - 1;
    let target = try(parse_type(value, start), @parse_alias_name);
    if(value.tokens.position == value.tokens.limit) { finish_alias(
            aliases,
            order,
            shell,
            public,
            start,
            whole_end,
            name,
            generics,
            target
        ) } else { Result::Err(
            HeaderError::UnexpectedTrailingHeaderToken(value.tokens.position, start)
        ) }
}

parse_effect_row_alias(
    value: &mut Parser,
    aliases: &mut EffectRowAliasArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start;
    if(public) {
        value.tokens.position = value.tokens.position + 1;
    } else { () };
    value.tokens.position = value.tokens.position + 1;
    let name = try(ident(value, start), @parse_effect_row_alias);
    try(expect_equals(value, start), @parse_effect_row_alias);
    value.tokens.limit = whole_end - 1;
    let row = try(parse_effect_row(value, start), @parse_effect_row_alias);
    if(value.tokens.position == value.tokens.limit) {
        Vec::push(&mut aliases.values, EffectRowAliasHeader {
            shell: shell,
            name: name.name,
            public: public,
            row: row,
            tokens: token_range(start, whole_end)
        });
        let index = Vec::len(&aliases.values) - 1;
        record_header(order, shell, HeaderOrder::EffectRowAlias(typed_header_id(index)));
        Result::Ok(())
    } else { Result::Err(
        HeaderError::UnexpectedTrailingHeaderToken(value.tokens.position, start)
    ) }
}

finish_alias(
    aliases: &mut AliasArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize,
    name: NameUse,
    generics: HeaderRange,
    target: TypeId
) -> Result<(), HeaderError> {
    Vec::push(
        &mut aliases.values,
        TypeAliasHeader {
            shell: shell,
            name: name.name,
            public: public,
            generics: generics,
            target: target,
            tokens: token_range(start, whole_end)
        }
    );
    let index = Vec::len(&aliases.values) - 1;
    record_header(
        order,
        shell,
        HeaderOrder::Alias(typed_header_id(index))
    );
    Result::Ok(())
}

parse_struct(
    value: &mut Parser,
    structs: &mut StructArena,
    fields: &mut FieldArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start;
    if(public) {
        value.tokens.position = value.tokens.position + 1;
    } else { () };
    value.tokens.position = value.tokens.position + 1;
    let name = try(ident(value, start), @parse_struct);
    let generics = try(parse_generics(value, start), @parse_struct);
    if(value.tokens.position == header_end) {
        value.tokens.position = header_end + 1;
        value.tokens.limit = whole_end - 1;
        let field_start = super::syntax::range_mark(&fields.values);
        try(parse_fields(value, fields, start), @parse_struct);
        finish_struct(
            structs,
            fields,
            order,
            shell,
            public,
            start,
            whole_end,
            name,
            generics,
            field_start
        )
    } else { Result::Err(
            HeaderError::UnexpectedTrailingHeaderToken(value.tokens.position, start)
        ) }
}

parse_fields(
    value: &mut Parser,
    fields: &mut FieldArena,
    related: usize
) -> Result<(), HeaderError> {
    if(value.tokens.position < value.tokens.limit) {
            let field_start = value.tokens.position;
            let private = at_ident(&*value, &"private")
                and { next_is_ident(&*value) };
            if(private) {
                value.tokens.position = value.tokens.position + 1;
            } else { () };
            let name = try(ident(value, related), @parse_fields);
            try(expect_colon(value, related), @parse_fields);
            let ty = try(parse_type(value, related), @parse_fields);
            Vec::push(
                &mut fields.values,
                FieldHeader {
                    name: name.name,
                    name_token: name.token,
                    tokens: token_range(field_start, value.tokens.position),
                    private: private,
                    ty: ty
                }
            );
            eat_token(value, TokenPattern::Comma);
            eat_token(value, TokenPattern::Semicolon);
            parse_fields(value, fields, related)
    } else { Result::Ok(()) }
}

finish_struct(
    structs: &mut StructArena,
    fields: &mut FieldArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize,
    name: NameUse,
    generics: HeaderRange,
    field_start: usize
) -> Result<(), HeaderError> {
    let field_end = Vec::len(&fields.values);
    Vec::push(
        &mut structs.values,
        StructHeader {
            shell: shell,
            name: name.name,
            public: public,
            generics: generics,
            fields: header_range(field_start, field_end),
            tokens: token_range(start, whole_end)
        }
    );
    let index = Vec::len(&structs.values) - 1;
    record_header(
        order,
        shell,
        HeaderOrder::Struct(typed_header_id(index))
    );
    Result::Ok(())
}

parse_sum_header(
    value: &mut Parser,
    enums: &mut EnumArena,
    variants: &mut VariantArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start;
    if(public) {
        value.tokens.position = value.tokens.position + 1;
    } else { () };
    value.tokens.position = value.tokens.position + 1;
    let name = try(ident(value, start), @parse_sum_header);
    let generics = try(parse_generics(value, start), @parse_sum_header);
    if(value.tokens.position == header_end) { parse_sum_body(
            value,
            enums,
            variants,
            order,
            shell,
            public,
            start,
            header_end,
            whole_end,
            name,
            generics
        ) } else { Result::Err(
            HeaderError::UnexpectedTrailingHeaderToken(value.tokens.position, start)
        ) }
}

parse_sum_body(
    value: &mut Parser,
    enums: &mut EnumArena,
    variants: &mut VariantArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize,
    name: NameUse,
    generics: HeaderRange
) -> Result<(), HeaderError> {
    value.tokens.position = next_index(header_end);
    value.tokens.limit = previous_index(whole_end);
    let variant_start = variant_arena_count(&*variants);
    try(parse_variants(value, variants, start), @parse_sum_body);
    finish_enum(
        enums,
        variants,
        order,
        shell,
         public,
        start,
        whole_end,
         name,
         generics,
        variant_start
    );
    Result::Ok(())
}

parse_variants(
    value: &mut Parser,
    variants: &mut VariantArena,
    related: usize
) -> Result<(), HeaderError> {
    if(value.tokens.position < value.tokens.limit) {
            let name = try(ident(value, related), @parse_variants);
            let fields = Vec::new();
            if(eat_token(value, TokenPattern::LParen)) {
                try(
                    parse_type_values(
                        value,
                        TokenPattern::RParen,
                        related,
                        &mut fields
                    ),
                    @parse_variants
                );
                try(
                    expect_right_parenthesis(value, related),
                    @parse_variants
                );
                finish_variant(
                    value,
                    variants,
                    related,
                    name,
                     fields
                )
            } else { finish_variant(
                    value,
                    variants,
                    related,
                    name,
                     fields
                ) }
    } else { Result::Ok(()) }
}

finish_variant(
    value: &mut Parser,
    variants: &mut VariantArena,
    related: usize,
    name: NameUse,
    fields: Vec<TypeId>
) -> Result<(), HeaderError> {
    let edge_start = super::syntax::range_mark(&value.output.type_edges);
    append_edges(
        &mut value.output.type_edges,
        &fields,
        0,
        0
    );
    let edge_end = Vec::len(&value.output.type_edges);
    Vec::push(
        &mut variants.values,
        VariantHeader {
            name: name.name,
            name_token: name.token,
            fields: header_range(edge_start, edge_end)
        }
    );
    eat_token(value, TokenPattern::Comma);
    eat_token(value, TokenPattern::Semicolon);
    parse_variants(value, variants, related)
}

finish_enum(
    enums: &mut EnumArena,
    variants: &mut VariantArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize,
    name: NameUse,
    generics: HeaderRange,
    variant_start: usize
) {
    let variant_end = variant_arena_count(&*variants);
    Vec::push(
        &mut enums.values,
        EnumHeader {
            shell: shell,
            name: name.name,
            public: public,
            generics: generics,
            variants: header_range(variant_start, variant_end),
            tokens: token_range(start, whole_end)
        }
    );
    let index = Vec::len(&enums.values) - 1;
    let enum_id = typed_header_id(index);
    record_header(
        order,
        shell,
        HeaderOrder::Enum(enum_id)
    );
    index_enum_members(
        order,
        variants,
        enum_id,
        variant_start,
        variant_end
    )
}

parse_resumption_bound(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<usize, HeaderError> {
    let token = value.tokens.position;
    handle super::lexer::token_kind_at(&value.source, token) {
        TokenKind::Number(number) => if(integer_number(&number)) {
            let spelling = super::lexer::number_spelling(&number);
            let text = source_text(
                original,
                super::lexer::span_start(&spelling),
                super::lexer::span_end(&spelling)
            );
            handle parse_u64(&text) {
                Result::Err(_) => Result::Err(
                    HeaderError::InvalidResumptionBound(token, related)
                ),
                Result::Ok(found) => {
                    value.tokens.position = token + 1;
                    Result::Ok(wrapping_convert_to_usize(found))
                }
            }
        } else { Result::Err(
            HeaderError::InvalidResumptionBound(token, related)
        ) },
        _ => Result::Err(HeaderError::InvalidResumptionBound(token, related))
    }
}

parse_resumption_quantity(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<(usize, Option<usize>, Bool), HeaderError> {
    let cursor = value.tokens.position;
    handle super::lexer::token_kind_at(&value.source, cursor) {
        TokenKind::LBracket => {
            value.tokens.position = cursor + 1;
            let lower = try(
                parse_resumption_bound(original, value, related),
                @parse_resumption_quantity
            );
            try(expect_resumption_comma(value, related), @parse_resumption_quantity);
            let upper = try(
                parse_resumption_upper(original, value, related),
                @parse_resumption_quantity
            );
            try(
                expect_resumption_right_bracket(value, related),
                @parse_resumption_quantity
            );
            Result::Ok((lower, upper, true))
        },
        _ => Result::Ok((1, Option::Some(1), false))
    }
}

expect_resumption_comma(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    handle super::lexer::token_kind_at(&value.source, token) {
        TokenKind::Comma => {
            value.tokens.position = token + 1;
            Result::Ok(())
        },
        _ => Result::Err(HeaderError::ExpectedResumptionComma(token, related))
    }
}

parse_resumption_upper(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<Option<usize>, HeaderError> {
    let token = value.tokens.position;
    handle super::lexer::token_kind_at(&value.source, token) {
        TokenKind::Star => {
            value.tokens.position = token + 1;
            Result::Ok(None)
        },
        TokenKind::Ident(_) => if(at_ident(&*value, &"infinity")) {
                value.tokens.position = token + 1;
                Result::Ok(None)
            } else { Result::Err(
                HeaderError::ExpectedResumptionUpper(token, related)
            ) },
        TokenKind::Number(_) => Result::Ok(Option::Some(try(
            parse_resumption_bound(original, value, related),
            @parse_resumption_upper
        ))),
        _ => Result::Err(HeaderError::ExpectedResumptionUpper(token, related))
    }
}

expect_resumption_right_bracket(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.tokens.position;
    handle super::lexer::token_kind_at(&value.source, token) {
        TokenKind::RBracket => {
            value.tokens.position = token + 1;
            Result::Ok(())
        },
        _ => Result::Err(
            HeaderError::ExpectedResumptionRightBracket(token, related)
        )
    }
}

parse_bounded_where_clause(
    value: &mut Parser,
    related: usize,
    end: usize
) -> Result<HeaderTokenRange, HeaderError> {
    let start = value.tokens.position;
    if(start < end) {
        handle super::lexer::token_kind_at(&value.source, start) {
            TokenKind::Keyword(super::lexer::Keyword::Where) => {
                if(start + 1 == end) {
                    Result::Err(HeaderError::EmptyWhereClause(end, related))
                } else {
                    value.tokens.position = end;
                    Result::Ok(token_range(start, end))
                }
            },
            _ => Result::Err(
                HeaderError::UnexpectedTrailingHeaderToken(start, related)
            )
        }
    } else { Result::Ok(token_range(start, start)) }
}

parse_where_quantity(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<GoalArgument, HeaderError> {
    let start = value.tokens.position;
    if(not(eat_where_bracket(value, true))) {
        @parse_where_quantity(Result::Err(
            HeaderError::InvalidWhereQuantity(start, related)
        ))
    } else { () };
    let lower = try(
        parse_resumption_bound(original, value, related),
        @parse_where_quantity
    );
    if(not(eat_token(value, TokenPattern::Comma))) {
        @parse_where_quantity(Result::Err(HeaderError::InvalidWhereQuantity(
            value.tokens.position, related
        )))
    } else { () };
    let upper = try(
        parse_where_upper(original, value, related), @parse_where_quantity
    );
    let end_token = value.tokens.position;
    if(not(eat_where_bracket(value, false))) {
        @parse_where_quantity(Result::Err(HeaderError::InvalidWhereQuantity(
            end_token, related
        )))
    } else { () };
    Result::Ok(GoalArgument::Quantity(
        lower, upper, token_range(start, value.tokens.position)
    ))
}

parse_where_upper(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<Option<usize>, HeaderError> {
    let token = value.tokens.position;
    if(token >= value.tokens.limit) {
        Result::Err(HeaderError::InvalidWhereQuantity(token, related))
    } else if(at_ident(&*value, &"infinity")) {
        value.tokens.position = token + 1;
        Result::Ok(None)
    } else {
        handle super::lexer::token_kind_at(&value.source, token) {
            TokenKind::Star => {
                value.tokens.position = token + 1;
                Result::Ok(None)
            },
            _ => Result::Ok(Option::Some(try(
                parse_resumption_bound(original, value, related),
                @parse_where_upper
            )))
        }
    }
}

eat_where_bracket(value: &mut Parser, left: Bool) -> Bool {
    let cursor = value.tokens.position;
    if(cursor < value.tokens.limit) {
        let matches = handle super::lexer::token_kind_at(&value.source, cursor) {
            TokenKind::LBracket => left,
            TokenKind::RBracket => not(left),
            _ => false
        };
        if(matches) {
            value.tokens.position = cursor + 1;
            true
        } else { false }
    } else { false }
}

at_where_left_bracket(value: &Parser) -> Bool {
    if(value.tokens.position < value.tokens.limit) {
        handle super::lexer::token_kind_at(
            &value.source, value.tokens.position
        ) {
            TokenKind::LBracket => true,
            _ => false
        }
    } else { false }
}

parse_where_u32(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<GoalArgument, HeaderError> {
    let token = value.tokens.position;
    let parsed = try(
        parse_resumption_bound(original, value, related),
        @parse_where_u32
    );
    Result::Ok(GoalArgument::U32(parsed, token))
}

parse_goal_argument(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<GoalArgument, HeaderError> {
    if(at_where_left_bracket(&*value)) {
        parse_where_quantity(original, value, related)
    } else if(where_item_starts_with_lifetime(&*value)) {
        Result::Ok(GoalArgument::Lifetime(try(
            require_where_lifetime(value, related), @parse_goal_argument
        )))
    } else if(where_item_starts_with_number(&*value)) {
        parse_where_u32(original, value, related)
    } else {
        Result::Ok(GoalArgument::Type(try(
            parse_type(value, related), @parse_goal_argument
        )))
    }
}

where_item_starts_with_number(value: &Parser) -> Bool {
    if(value.tokens.position < value.tokens.limit) {
        handle super::lexer::token_kind_at(
            &value.source, value.tokens.position
        ) {
            TokenKind::Number(_) => true,
            _ => false
        }
    } else { false }
}

parse_associated_binding(
    original: &String,
    value: &mut Parser,
    related: usize,
    relation_binding_start: usize
) -> Result<(), HeaderError> {
    let start = value.tokens.position;
    let name = try(ident(value, related), @parse_associated_binding);
    // Parameterized associated bindings use a distinct structural argument
    // arena so their source positions cannot contaminate the relation's own
    // ordered argument range.
    let argument_start = Vec::len(&value.output.associated_arguments);
    if(eat_token(value, TokenPattern::Lt)) {
        try(parse_associated_argument_items(
            original, value, related
        ), @parse_associated_binding);
        try(expect_right_angle(value, related), @parse_associated_binding)
    } else { () };
    if(not(eat_token(value, TokenPattern::Eq))) {
        @parse_associated_binding(Result::Err(HeaderError::InvalidWhereGoal(
            value.tokens.position, related
        )))
    } else { () };
    let argument_end = Vec::len(&value.output.associated_arguments);
    let duplicate = find_simple_duplicate_binding(
        &value.output,
        relation_binding_start,
        name.name,
        header_range(argument_start, argument_end)
    );
    handle duplicate {
        Result::Err(_) => (),
        Result::Ok(previous) => @parse_associated_binding(Result::Err(
            HeaderError::DuplicateAssociatedBinding(name.token, previous)
        ))
    };
    let (binding_value, end) = try(
        parse_associated_binding_value(value, related),
        @parse_associated_binding
    );
    Vec::push(
        &mut value.output.associated_bindings,
        AssociatedBinding {
            name: name,
            arguments: header_range(argument_start, argument_end),
            value: binding_value,
            tokens: token_range(start, end)
        }
    );
    Result::Ok(())
}

find_simple_duplicate_binding(
    value: &HeaderIndex,
    start: usize,
    name: Id<String>,
    arguments: HeaderRange
) -> Option<usize> {
    if(start < Vec::len(&value.associated_bindings)) {
        let existing = Vec::index(&value.associated_bindings, start);
        if(existing.name.name == name
            and { same_associated_argument_range(
                value, existing.arguments, arguments, 0
            ) }) {
            Option::Some(existing.name.token)
        } else {
            find_simple_duplicate_binding(
                value, start + 1, name, arguments
            )
        }
    } else { None }
}

same_associated_argument_range(
    value: &HeaderIndex,
    left: HeaderRange,
    right: HeaderRange,
    ordinal: u32
) -> Bool {
    if(left.count != right.count) { false } else if(ordinal < left.count) {
        same_goal_argument(
            value,
            Vec::index(
                &value.associated_arguments,
                wrapping_convert_to_usize(left.start + ordinal)
            ),
            Vec::index(
                &value.associated_arguments,
                wrapping_convert_to_usize(right.start + ordinal)
            )
        ) and { same_associated_argument_range(
            value, left, right, ordinal + 1
        ) }
    } else { true }
}

same_goal_argument_range(
    value: &HeaderIndex,
    left: HeaderRange,
    right: HeaderRange,
    ordinal: u32
) -> Bool {
    if(left.count != right.count) { false } else if(ordinal < left.count) {
        same_goal_argument(
            value,
            Vec::index(
                &value.goal_arguments,
                wrapping_convert_to_usize(left.start + ordinal)
            ),
            Vec::index(
                &value.goal_arguments,
                wrapping_convert_to_usize(right.start + ordinal)
            )
        ) and { same_goal_argument_range(
            value, left, right, ordinal + 1
        ) }
    } else { true }
}

same_goal_argument(
    value: &HeaderIndex,
    left: &GoalArgument,
    right: &GoalArgument
) -> Bool {
    handle left {
        GoalArgument::Type(left_type) => handle right {
            GoalArgument::Type(right_type) => same_header_type(
                value, left_type, right_type
            ),
            _ => false
        },
        GoalArgument::Lifetime(left_name) => handle right {
            GoalArgument::Lifetime(right_name) =>
                left_name.name == right_name.name,
            _ => false
        },
        GoalArgument::Quantity(left_lower, left_upper, _) => handle right {
            GoalArgument::Quantity(right_lower, right_upper, _) =>
                same_usize_value(left_lower, right_lower) and {
                    same_optional_usize(
                    left_upper, right_upper
                ) },
            _ => false
        },
        GoalArgument::U32(left_value, _) => handle right {
            GoalArgument::U32(right_value, _) => same_usize_value(
                left_value, right_value
            ),
            _ => false
        }
    }
}

same_usize_value(left: usize, right: usize) -> Bool { left == right }

same_optional_usize(left: Option<usize>, right: Option<usize>) -> Bool {
    handle left {
        Result::Err(_) => Option::is_none(&right),
        Result::Ok(left_value) => handle right {
            Result::Err(_) => false,
            Result::Ok(right_value) => left_value == right_value
        }
    }
}

same_header_type(
    value: &HeaderIndex,
    left: TypeId,
    right: TypeId
) -> Bool {
    let left_node = Arena::index(&value.types, left);
    let right_node = Arena::index(&value.types, right);
    handle left_node.kind {
        HeaderTypeKind::Never => right_node.kind is HeaderTypeKind::Never,
        HeaderTypeKind::Path(left_names) => handle right_node.kind {
            HeaderTypeKind::Path(right_names) => same_name_range(
                value, left_names, right_names, 0
            ),
            _ => false
        },
        HeaderTypeKind::Tuple(left_types) => handle right_node.kind {
            HeaderTypeKind::Tuple(right_types) => same_type_edge_range(
                value, left_types, right_types, 0
            ),
            _ => false
        },
        HeaderTypeKind::SharedReference(left_lifetime, left_type) =>
            handle right_node.kind {
            HeaderTypeKind::SharedReference(right_lifetime, right_type) =>
                same_optional_name(left_lifetime, right_lifetime)
                    and { same_header_type(value, left_type, right_type) },
            _ => false
        },
        HeaderTypeKind::UniqueReference(left_lifetime, left_type) =>
            handle right_node.kind {
            HeaderTypeKind::UniqueReference(right_lifetime, right_type) =>
                same_optional_name(left_lifetime, right_lifetime)
                    and { same_header_type(value, left_type, right_type) },
            _ => false
        },
        HeaderTypeKind::Application(
            left_constructor, left_lifetimes, left_types, left_const_arguments
        ) => handle right_node.kind {
            HeaderTypeKind::Application(
                right_constructor, right_lifetimes, right_types, right_const_arguments
            ) => left_const_arguments == right_const_arguments and { same_header_type(
                value, left_constructor, right_constructor
            ) and { same_lifetime_range(
                value, left_lifetimes, right_lifetimes, 0
            ) } and { same_type_edge_range(
                value, left_types, right_types, 0
            ) } },
            _ => false
        }
    }
}

same_lifetime_range(
    value: &HeaderIndex,
    left: HeaderRange,
    right: HeaderRange,
    ordinal: u32
) -> Bool {
    if(left.count != right.count) { false } else if(ordinal < left.count) {
        Vec::index(
            &value.lifetime_arguments,
            wrapping_convert_to_usize(left.start + ordinal)
        ).name == Vec::index(
            &value.lifetime_arguments,
            wrapping_convert_to_usize(right.start + ordinal)
        ).name and { same_lifetime_range(value, left, right, ordinal + 1) }
    } else { true }
}

same_optional_name(left: Option<NameUse>, right: Option<NameUse>) -> Bool {
    handle left {
        Result::Err(_) => Option::is_none(&right),
        Result::Ok(left_name) => handle right {
            Result::Err(_) => false,
            Result::Ok(right_name) => left_name.name == right_name.name
        }
    }
}

same_name_range(
    value: &HeaderIndex,
    left: HeaderRange,
    right: HeaderRange,
    ordinal: u32
) -> Bool {
    if(left.count != right.count) { false } else if(ordinal < left.count) {
        Vec::index(
            &value.names,
            wrapping_convert_to_usize(left.start + ordinal)
        ).name == Vec::index(
            &value.names,
            wrapping_convert_to_usize(right.start + ordinal)
        ).name and { same_name_range(value, left, right, ordinal + 1) }
    } else { true }
}

same_type_edge_range(
    value: &HeaderIndex,
    left: HeaderRange,
    right: HeaderRange,
    ordinal: u32
) -> Bool {
    if(left.count != right.count) { false } else if(ordinal < left.count) {
        same_header_type(
            value,
            Vec::index(
                &value.type_edges,
                wrapping_convert_to_usize(left.start + ordinal)
            ).value,
            Vec::index(
                &value.type_edges,
                wrapping_convert_to_usize(right.start + ordinal)
            ).value
        ) and { same_type_edge_range(value, left, right, ordinal + 1) }
    } else { true }
}

parse_associated_binding_value(
    value: &mut Parser,
    related: usize
) -> Result<(AssociatedBindingValue, usize), HeaderError> {
    let result = if(at_token(&*value, TokenPattern::LBrace)) {
        AssociatedBindingValue::EffectRow(try(
            parse_effect_row(value, related), @parse_associated_binding_value
        ))
    } else {
        AssociatedBindingValue::Type(try(
            parse_type(value, related), @parse_associated_binding_value
        ))
    };
    Result::Ok((result, value.tokens.position))
}

parse_associated_argument_items(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    if(at_token(&*value, TokenPattern::Gt)) { Result::Ok(()) } else {
        let argument = try(
            parse_goal_argument(original, value, related),
            @parse_associated_argument_items
        );
        Vec::push(&mut value.output.associated_arguments, argument);
        if(eat_token(value, TokenPattern::Comma)) {
            parse_associated_argument_items(original, value, related)
        } else { Result::Ok(()) }
    }
}

binding_starts_here(value: &Parser) -> Bool {
    if(value.tokens.position + 1 < value.tokens.limit) {
        handle super::lexer::token_kind_at(
            &value.source, value.tokens.position
        ) {
            TokenKind::Ident(_) => binding_equals_at(
                value, value.tokens.position + 1, 0
            ),
            _ => false
        }
    } else { false }
}

binding_equals_at(value: &Parser, cursor: usize, angles: usize) -> Bool {
    if(cursor < value.tokens.limit) {
        handle super::lexer::token_kind_at(&value.source, cursor) {
            TokenKind::Eq => angles == 0,
            TokenKind::Lt => binding_equals_at(value, cursor + 1, angles + 1),
            TokenKind::Gt => if(angles == 0) { false } else {
                binding_equals_at(value, cursor + 1, angles - 1)
            },
            TokenKind::Comma => if(angles == 0) { false } else {
                binding_equals_at(value, cursor + 1, angles)
            },
            _ => binding_equals_at(value, cursor + 1, angles)
        }
    } else { false }
}

parse_relation_arguments(
    original: &String,
    value: &mut Parser,
    related: usize,
    argument_start: usize,
    binding_start: usize
) -> Result<(HeaderRange, HeaderRange), HeaderError> {
    if(at_token(&*value, TokenPattern::Gt)) {
        @parse_relation_arguments(Result::Err(HeaderError::InvalidWhereGoal(
            value.tokens.position, related
        )))
    } else { () };
    if(binding_starts_here(&*value)) {
        try(
            parse_associated_binding(
                original, value, related, binding_start
            ),
            @parse_relation_arguments
        )
    } else {
        let argument = try(
            parse_goal_argument(original, value, related),
            @parse_relation_arguments
        );
        Vec::push(&mut value.output.goal_arguments, argument)
    };
    if(eat_token(value, TokenPattern::Comma)) {
        if(at_token(&*value, TokenPattern::Gt)) {
            finish_relation_arguments(
                value, related, argument_start, binding_start
            )
        } else {
            parse_relation_arguments(
                original, value, related, argument_start, binding_start
            )
        }
    } else {
        finish_relation_arguments(value, related, argument_start, binding_start)
    }
}

finish_relation_arguments(
    value: &mut Parser,
    related: usize,
    argument_start: usize,
    binding_start: usize
) -> Result<(HeaderRange, HeaderRange), HeaderError> {
    try(expect_right_angle(value, related), @finish_relation_arguments);
    Result::Ok((
        header_range(argument_start, Vec::len(&value.output.goal_arguments)),
        header_range(binding_start, Vec::len(&value.output.associated_bindings))
    ))
}

parse_where_relation(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<(HeaderRange, HeaderRange, HeaderRange, usize), HeaderError> {
    let relation_start = Vec::len(&value.output.names);
    let first = try(ident(value, related), @parse_where_relation);
    Vec::push(&mut value.output.names, first);
    try(parse_relation_path_tail(value, related), @parse_where_relation);
    let relation = header_range(relation_start, Vec::len(&value.output.names));
    let argument_start = Vec::len(&value.output.goal_arguments);
    let binding_start = Vec::len(&value.output.associated_bindings);
    let (arguments, bindings) = if(eat_token(value, TokenPattern::Lt)) {
        try(parse_relation_arguments(
            original, value, related, argument_start, binding_start
        ), @parse_where_relation)
    } else {
        (header_range(argument_start, argument_start),
         header_range(binding_start, binding_start))
    };
    Result::Ok((relation, arguments, bindings, value.tokens.position))
}

parse_relation_path_tail(
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    if(eat_token(value, TokenPattern::DoubleColon)) {
        let next = try(ident(value, related), @parse_relation_path_tail);
        Vec::push(&mut value.output.names, next);
        parse_relation_path_tail(value, related)
    } else { Result::Ok(()) }
}

parse_where_item(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    let higher_ranked = if(at_ident(&*value, &"for")) {
        value.tokens.position = value.tokens.position + 1;
        try(parse_generics(value, related), @parse_where_item)
    } else {
        let at = Vec::len(&value.output.generic_params);
        header_range(at, at)
    };
    let predicate_start = value.tokens.position;
    let starts_with_lifetime = where_item_starts_with_lifetime(&*value);
    if(starts_with_lifetime) {
        parse_lifetime_where_item(value, related, predicate_start, higher_ranked)
    } else {
        parse_trait_where_item(
            original, value, related, predicate_start, higher_ranked
        )
    }
}

parse_lifetime_where_item(
    value: &mut Parser,
    related: usize,
    start: usize,
    higher_ranked: HeaderRange
) -> Result<(), HeaderError> {
    let (longer, shorter, end) = try(
        parse_lifetime_where_pair(value, related), @parse_lifetime_where_item
    );
    Vec::push(
        &mut value.output.lifetime_outlives,
        LifetimeOutlives {
            higher_ranked_lifetimes: higher_ranked,
            longer: longer,
            shorter: shorter,
            tokens: token_range(start, end)
        }
    );
    Result::Ok(())
}

parse_lifetime_where_pair(
    value: &mut Parser,
    related: usize
) -> Result<(NameUse, NameUse, usize), HeaderError> {
    let longer = try(
        require_where_lifetime(value, related), @parse_lifetime_where_pair
    );
    try(expect_colon(value, related), @parse_lifetime_where_pair);
    let shorter = try(
        require_where_lifetime(value, related), @parse_lifetime_where_pair
    );
    Result::Ok((longer, shorter, value.tokens.position))
}

parse_trait_where_item(
    original: &String,
    value: &mut Parser,
    related: usize,
    start: usize,
    higher_ranked: HeaderRange
) -> Result<(), HeaderError> {
    let subject = try(parse_type(value, related), @parse_trait_where_item);
    try(expect_colon(value, related), @parse_trait_where_item);
    let negative = eat_token(value, TokenPattern::Bang);
    let (relation, arguments, bindings, end) = try(
        parse_where_relation(original, value, related),
        @parse_trait_where_item
    );
    Vec::push(
        &mut value.output.where_goals,
        WhereGoal {
            higher_ranked_lifetimes: higher_ranked,
            subject: subject,
            negative: negative,
            relation: relation,
            arguments: arguments,
            bindings: bindings,
            tokens: token_range(start, end)
        }
    );
    Result::Ok(())
}

where_item_starts_with_lifetime(value: &Parser) -> Bool {
    if(value.tokens.position < value.tokens.limit) {
        handle super::lexer::token_kind_at(
            &value.source, value.tokens.position
        ) {
            TokenKind::Lifetime(_) => true,
            _ => false
        }
    } else { false }
}

require_where_lifetime(
    value: &mut Parser,
    related: usize
) -> Result<NameUse, HeaderError> {
    let token = value.tokens.position;
    handle take_lifetime(value) {
        Result::Err(_) => Result::Err(
            HeaderError::InvalidWhereGoal(token, related)
        ),
        Result::Ok(found) => Result::Ok(found)
    }
}

parse_where_items(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<(), HeaderError> {
    try(parse_where_item(original, value, related), @parse_where_items);
    if(eat_token(value, TokenPattern::Comma)) {
        if(value.tokens.position == value.tokens.limit) {
            Result::Ok(())
        } else { parse_where_items(original, value, related) }
    } else if(value.tokens.position == value.tokens.limit) {
        Result::Ok(())
    } else {
        Result::Err(HeaderError::InvalidWhereGoal(
            value.tokens.position, related
        ))
    }
}

parse_structured_where_clause(
    original: &String,
    value: &mut Parser,
    related: usize,
    tokens: HeaderTokenRange
) -> Result<Option<WhereClause>, HeaderError> {
    if(super::syntax::token_is_empty(&tokens)) { Result::Ok(None) } else {
        let previous = value.tokens;
        value.tokens = super::syntax::cursor(tokens.start, tokens.end);
        let start = value.tokens.position;
        if(not(at_token(&*value, TokenPattern::Ident)) and {
            not(handle super::lexer::token_kind_at(&value.source, start) {
                TokenKind::Keyword(super::lexer::Keyword::Where) => true,
                _ => false
            })
        }) {
            value.tokens = previous;
            @parse_structured_where_clause(Result::Err(
                HeaderError::InvalidWhereGoal(start, related)
            ))
        } else { () };
        value.tokens.position = start + 1;
        let goal_start = Vec::len(&value.output.where_goals);
        let lifetime_start = Vec::len(&value.output.lifetime_outlives);
        let parsed = parse_where_items(original, value, related);
        let end = value.tokens.position;
        value.tokens = previous;
        try(parsed, @parse_structured_where_clause);
        Result::Ok(Option::Some(WhereClause {
            goals: header_range(goal_start, Vec::len(&value.output.where_goals)),
            lifetime_outlives: header_range(
                lifetime_start, Vec::len(&value.output.lifetime_outlives)
            ),
            tokens: token_range(start, end)
        }))
    }
}

operation_end(value: &Parser) -> usize {
    operation_end_from(value, value.tokens.position)
}

parse_operation_where_clause(
    value: &mut Parser,
    related: usize
) -> Result<HeaderTokenRange, HeaderError> {
    let start = value.tokens.position;
    if(start < value.tokens.limit) {
        handle super::lexer::token_kind_at(&value.source, start) {
            TokenKind::Keyword(super::lexer::Keyword::Where) => {
                let end = operation_where_end(&*value, start + 1, 0, 0, 0);
                parse_bounded_where_clause(value, related, end)
            },
            _ => Result::Ok(token_range(start, start))
        }
    } else { Result::Ok(token_range(start, start)) }
}

generic_operation_tail(value: &Parser, cursor: usize, depth: usize) -> Bool {
    if(cursor < value.tokens.limit) {
        handle super::lexer::token_kind_at(&value.source, cursor) {
            TokenKind::Lt => generic_operation_tail(value, cursor + 1, depth + 1),
            TokenKind::Gt => if(depth == 1) {
                if(cursor + 1 < value.tokens.limit) {
                    handle super::lexer::token_kind_at(&value.source, cursor + 1) {
                        TokenKind::LParen => true,
                        _ => false
                    }
                } else { false }
            } else { generic_operation_tail(value, cursor + 1, depth - 1) },
            _ => generic_operation_tail(value, cursor + 1, depth)
        }
    } else { false }
}

operation_starts_at(value: &Parser, cursor: usize) -> Bool {
    if(cursor + 1 < value.tokens.limit) {
        handle super::lexer::token_kind_at(&value.source, cursor) {
            TokenKind::LBracket => true,
            TokenKind::Ident(_) => handle super::lexer::token_kind_at(
                &value.source,
                cursor + 1
            ) {
                TokenKind::LParen => true,
                TokenKind::Lt => generic_operation_tail(value, cursor + 1, 0),
                _ => false
            },
            _ => false
        }
    } else { false }
}

operation_where_end(
    value: &Parser,
    cursor: usize,
    parentheses: usize,
    angles: usize,
    brackets: usize
) -> usize {
    if(cursor < value.tokens.limit) {
        let top = parentheses == 0 and { angles == 0 } and { brackets == 0 };
        if(top and { operation_starts_at(value, cursor) }) { cursor } else {
            handle super::lexer::token_kind_at(&value.source, cursor) {
                TokenKind::Semicolon => if(top) { cursor } else {
                    operation_where_end(
                        value, cursor + 1, parentheses, angles, brackets
                    )
                },
                TokenKind::LParen => operation_where_end(
                    value, cursor + 1, parentheses + 1, angles, brackets
                ),
                TokenKind::RParen => if(parentheses == 0) {
                    operation_where_end(
                        value, cursor + 1, parentheses, angles, brackets
                    )
                } else { operation_where_end(
                    value, cursor + 1, parentheses - 1, angles, brackets
                ) },
                TokenKind::Lt => operation_where_end(
                    value, cursor + 1, parentheses, angles + 1, brackets
                ),
                TokenKind::Gt => if(angles == 0) {
                    operation_where_end(
                        value, cursor + 1, parentheses, angles, brackets
                    )
                } else { operation_where_end(
                    value, cursor + 1, parentheses, angles - 1, brackets
                ) },
                TokenKind::LBracket => operation_where_end(
                    value, cursor + 1, parentheses, angles, brackets + 1
                ),
                TokenKind::RBracket => if(brackets == 0) {
                    operation_where_end(
                        value, cursor + 1, parentheses, angles, brackets
                    )
                } else { operation_where_end(
                    value, cursor + 1, parentheses, angles, brackets - 1
                ) },
                _ => operation_where_end(
                    value, cursor + 1, parentheses, angles, brackets
                )
            }
        }
    } else { value.tokens.limit }
}

operation_end_from(value: &Parser, cursor: usize) -> usize {
    if(cursor < value.tokens.limit) {
        handle super::lexer::token_kind_at(&value.source, cursor) {
            TokenKind::Semicolon => cursor,
            _ => operation_end_from(value, cursor + 1)
        }
    } else { value.tokens.limit }
}

parse_effect_operations(
    original: &String,
    value: &mut Parser,
    operations: &mut EffectOperationArena,
    related: usize
) -> Result<(), HeaderError> {
    if(value.tokens.position < value.tokens.limit) {
        let start = value.tokens.position;
        let quantity = try(
            parse_resumption_quantity(original, value, related),
            @parse_effect_operations
        );
        let name = try(ident(value, related), @parse_effect_operations);
        let generics = try(parse_generics(value, related), @parse_effect_operations);
        try(expect_left_parenthesis(value, related), @parse_effect_operations);
        let parameters = try(
            parse_parameters(value, related),
            @parse_effect_operations
        );
        try(expect_right_parenthesis(value, related), @parse_effect_operations);
        let has_arrow = eat_token(value, TokenPattern::Arrow);
        let terminal = has_arrow and {
            at_token(&*value, TokenPattern::Bang)
        };
        let result = if(has_arrow) {
            if(value.tokens.position == value.tokens.limit) { None } else {
                if(at_token(&*value, TokenPattern::Semicolon)) { None } else {
                    Option::Some(try(
                        parse_type(value, related),
                        @parse_effect_operations
                    ))
                }
            }
        } else { None };
        let where_tokens = try(
            parse_operation_where_clause(value, related),
            @parse_effect_operations
        );
        let where_clause = try(parse_structured_where_clause(
            original, value, related, where_tokens
        ), @parse_effect_operations);
        eat_token(value, TokenPattern::Semicolon);
        let end = value.tokens.position;
        Vec::push(
            &mut operations.values,
            EffectOperationHeader {
                name: name.name,
                name_token: name.token,
                generics: generics,
                parameters: parameters,
                result: result,
                terminal: terminal,
                resumption_lower: quantity.0,
                resumption_upper: quantity.1,
                has_resumption_quantity: quantity.2,
                where_tokens: where_tokens,
                where_clause: where_clause,
                tokens: token_range(start, end)
            }
        );
        parse_effect_operations(original, value, operations, related)
    } else { Result::Ok(()) }
}

parse_effect_header(
    original: &String,
    value: &mut Parser,
    effects: &mut EffectArena,
    operations: &mut EffectOperationArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start;
    if(public) {
        value.tokens.position = value.tokens.position + 1;
    } else { () };
    value.tokens.position = value.tokens.position + 1;
    let name = try(ident(value, start), @parse_effect_header);
    let generics = try(parse_generics(value, start), @parse_effect_header);
    let where_tokens = try(
        parse_bounded_where_clause(value, start, header_end),
        @parse_effect_header
    );
    let where_clause = try(parse_structured_where_clause(
        original, value, start, where_tokens
    ), @parse_effect_header);
    if(value.tokens.position == header_end) {
        value.tokens.position = next_index(header_end);
        value.tokens.limit = previous_index(whole_end);
        let operation_start = Vec::len(&operations.values);
        try(
            parse_effect_operations(original, value, operations, start),
            @parse_effect_header
        );
        let operation_end = Vec::len(&operations.values);
        Vec::push(
            &mut effects.values,
            EffectHeader {
                shell: shell,
                name: name.name,
                public: public,
                generics: generics,
                where_tokens: where_tokens,
                where_clause: where_clause,
                operations: header_range(operation_start, operation_end),
                tokens: token_range(start, whole_end)
            }
        );
        let effect_index = Vec::len(&effects.values) - 1;
        record_header(
            order,
            shell,
            HeaderOrder::Effect(typed_header_id(effect_index))
        );
        Result::Ok(())
    } else { Result::Err(
        HeaderError::ExpectedEffectBody(value.tokens.position, start)
    ) }
}

parse_impl_header(
    original: &String,
    value: &mut Parser,
    drops: &mut DropArena,
    uses: &mut UseArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start + 1;
    value.tokens.limit = header_end;
    let generics = try(parse_generics(value, start), @parse_impl_header);
    if(at_ident(&*value, &"Drop")) {
        value.tokens.position = value.tokens.position + 1;
        if(not(at_ident(&*value, &"for"))) {
            Result::Err(HeaderError::ExpectedIdentifier(value.tokens.position, start))
        } else {
            value.tokens.position = value.tokens.position + 1;
            let target = try(parse_type(value, start), @parse_impl_header);
            let where_tokens = try(
                parse_bounded_where_clause(value, start, header_end),
                @parse_impl_header
            );
            let where_clause = try(parse_structured_where_clause(
                original, value, start, where_tokens
            ), @parse_impl_header);
            Vec::push(&mut drops.values, DropHeader {
                shell: shell,
                generics: generics,
                target: target,
                where_tokens: where_tokens,
                where_clause: where_clause,
                tokens: token_range(start, whole_end)
            });
            record_header(order, shell, HeaderOrder::Drop(typed_header_id(Vec::len(&drops.values) - 1)));
            Result::Ok(())
        }
    } else if(at_ident(&*value, &"Use")) {
        value.tokens.position = value.tokens.position + 1;
        if(not(eat_token(value, TokenPattern::Lt))) {
            Result::Err(HeaderError::ExpectedRightAngle(value.tokens.position, start))
        } else {
        let quantity = try(parse_resumption_quantity(original, value, start), @parse_impl_header);
        try(expect_right_angle(value, start), @parse_impl_header);
        if(not(at_ident(&*value, &"for"))) {
            Result::Err(HeaderError::ExpectedIdentifier(value.tokens.position, start))
        } else {
            value.tokens.position = value.tokens.position + 1;
            let target = try(parse_type(value, start), @parse_impl_header);
            let where_tokens = try(
                parse_bounded_where_clause(value, start, header_end),
                @parse_impl_header
            );
            let where_clause = try(parse_structured_where_clause(
                original, value, start, where_tokens
            ), @parse_impl_header);
            Vec::push(&mut uses.values, UseHeader {
                shell: shell,
                generics: generics,
                lower: quantity.0,
                upper: quantity.1,
                target: target,
                where_tokens: where_tokens,
                where_clause: where_clause,
                tokens: token_range(start, whole_end)
            });
            record_header(order, shell, HeaderOrder::Use(typed_header_id(Vec::len(&uses.values) - 1)));
            Result::Ok(())
        }
        }
    } else { Result::Err(HeaderError::UnexpectedTrailingHeaderToken(value.tokens.position, start)) }
}

// Trait bodies are not otherwise parsed by this header pass. Preserve the
// declaration-level terminator rule so a trailing trait signature is not
// mistaken for a complete interface.
validate_trait_body_terminator(
    value: &Parser,
    header_end: usize,
    whole_end: usize,
    related: usize
) -> Result<(), HeaderError> {
    if(header_end + 2 < whole_end) {
        let terminal = whole_end - 2;
        if(super::lexer::token_kind_at(&value.source, terminal)
            is TokenKind::Semicolon) {
            Result::Ok(())
        } else { Result::Err(HeaderError::ExpectedSemicolon(terminal, related)) }
    } else { Result::Ok(()) }
}

parse_trait_header(
    value: &mut Parser,
    traits: &mut TraitArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    try(validate_trait_body_terminator(
        &*value, header_end, whole_end, start
    ), @parse_trait_header);
    value.tokens.position = start;
    if(public) { value.tokens.position = value.tokens.position + 1; } else { () };
    value.tokens.position = value.tokens.position + 1;
    let name = try(ident(value, start), @parse_trait_header);
    let generics = try(parse_generics(value, start), @parse_trait_header);
    if(value.tokens.position == header_end) {
        Vec::push(&mut traits.values, TraitHeader {
            shell: shell, name: name.name, public: public, generics: generics,
            tokens: token_range(start, whole_end)
        });
        record_header(order, shell, HeaderOrder::Trait(typed_header_id(Vec::len(&traits.values) - 1)));
        Result::Ok(())
    } else { Result::Err(HeaderError::UnexpectedTrailingHeaderToken(value.tokens.position, start)) }
}

parse_trait_impl_header(
    original: &String,
    value: &mut Parser,
    impls: &mut ImplArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start + 1;
    value.tokens.limit = header_end;
    let generics = try(parse_generics(value, start), @parse_trait_impl_header);
    let path_start = Vec::len(&value.output.names);
    let first = try(ident(value, start), @parse_trait_impl_header);
    Vec::push(&mut value.output.names, first);
    try(parse_relation_path_tail(value, start), @parse_trait_impl_header);
    let trait_path = header_range(path_start, Vec::len(&value.output.names));
    if(not(at_ident(&*value, &"for"))) {
        Result::Err(HeaderError::ExpectedIdentifier(value.tokens.position, start))
    } else {
        value.tokens.position = value.tokens.position + 1;
        let self_ty = try(parse_type(value, start), @parse_trait_impl_header);
        let where_tokens = try(parse_bounded_where_clause(value, start, header_end), @parse_trait_impl_header);
        let where_clause = try(parse_structured_where_clause(original, value, start, where_tokens), @parse_trait_impl_header);
        Vec::push(&mut impls.values, ImplHeader {
            shell: shell, generics: generics, trait_path: trait_path, self_ty: self_ty,
            where_tokens: where_tokens, where_clause: where_clause,
            tokens: token_range(start, whole_end)
        });
        record_header(order, shell, HeaderOrder::Impl(typed_header_id(Vec::len(&impls.values) - 1)));
        Result::Ok(())
    }
}

parse_shells(
    original: &String,
    declarations: &super::scanner::DeclarationIndex,
    index: usize,
    parser: Parser,
    nominal: NominalIndex
) -> Result<ParsedHeaders, HeaderError> {
    if(index < super::scanner::shell_count(declarations)) {
        let shell_id = handle
            super::scanner::shell_id_at_ordinal(declarations, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        handle super::scanner::shell_at(declarations, shell_id) {
            Result::Err(_) => Result::Ok(
                finish_parser( parser,  nominal)
            ),
            Result::Ok(shell) => {
                let bounds = header_bounds(shell);
                let whole = whole_bounds(shell);
                let start = bounds.start;
                let limit = bounds.end;
                let whole_end = whole.end;
                let Parser {
                    source,
                    tokens: _,
                    output
                } = parser;
                let next = Parser {
                    source: source,
                    tokens: super::syntax::cursor(start, limit),
                    output: output
                };
                let parsed = handle super::scanner::shell_kind(shell) {
                    super::scanner::DeclarationKind::Function => {
                        let callable_index = Vec::len(&next.output.callables);
                        record_header(
                            &mut nominal.definitions,
                            shell_id,
                            HeaderOrder::Callable(typed_header_id(callable_index))
                        );
                        parse_callable(
                            original,
                            &mut next,
                            shell_id,
                            super::scanner::shell_is_public(shell),
                            start
                        )
                    },
                    super::scanner::DeclarationKind::Fixity => parse_fixity(
                        original,
                        declarations,
                        &mut next,
                        &mut nominal.fixities,
                        &mut nominal.definitions,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        whole_end
                    ),
                    super::scanner::DeclarationKind::TypeAlias => parse_alias(
                        &mut next,
                        &mut nominal.aliases,
                        &mut nominal.definitions,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        whole_end
                    ),
                    super::scanner::DeclarationKind::EffectRowAlias => parse_effect_row_alias(
                        &mut next,
                        &mut nominal.effect_row_aliases,
                        &mut nominal.definitions,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        whole_end
                    ),
                    super::scanner::DeclarationKind::Struct => parse_struct(
                        &mut next,
                        &mut nominal.structs,
                        &mut nominal.fields,
                        &mut nominal.definitions,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        limit,
                        whole_end
                    ),
                    super::scanner::DeclarationKind::Enum => parse_sum_header(
                        &mut next,
                        &mut nominal.enums,
                        &mut nominal.variants,
                        &mut nominal.definitions,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        limit,
                        whole_end
                    ),
                    super::scanner::DeclarationKind::Effect => parse_effect_header(
                        original,
                        &mut next,
                        &mut nominal.effects,
                        &mut nominal.effect_operations,
                        &mut nominal.definitions,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        limit,
                        whole_end
                    ),
                    super::scanner::DeclarationKind::Trait => parse_trait_header(
                        &mut next,
                        &mut nominal.traits,
                        &mut nominal.definitions,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        limit,
                        whole_end
                    ),
                    super::scanner::DeclarationKind::Impl => parse_impl_dispatch(
                        original,
                        &mut next,
                        &mut nominal.impls,
                        &mut nominal.drops,
                        &mut nominal.uses,
                        &mut nominal.definitions,
                        shell_id,
                        start,
                        limit,
                        whole_end
                    ),
                    _ => Result::Ok(())
                };
                try(parsed, @parse_shells);
                parse_shells(
                    original,
                    declarations,
                    index + 1,
                     next,
                     nominal
                )
            }
        }
    } else { Result::Ok(finish_parser( parser,  nominal)) }
}

// The declaration kind is selected before the header parser consumes its
// generic parameters.  Inspect through a balanced generic list so built-in
// Drop and Use implementations take the same path whether or not they are
// generic.
impl_dispatch_head_is(
    value: &Parser,
    cursor: usize,
    depth: usize,
    expected: &String
) -> Bool {
    if(cursor < value.tokens.limit) {
        handle super::lexer::token_kind_at(&value.source, cursor) {
            TokenKind::Lt => impl_dispatch_head_is(
                value, cursor + 1, depth + 1, expected
            ),
            TokenKind::Gt => if(depth == 1) {
                if(cursor + 1 < value.tokens.limit) {
                    handle super::lexer::token_kind_at(&value.source, cursor + 1) {
                        TokenKind::Ident(name) => if(super::lexer::lexeme(
                            &value.source, name
                        ) is Result::Ok(found)) { *found == *expected } else { false },
                        _ => false
                    }
                } else { false }
            } else if(depth == 0) { false } else {
                impl_dispatch_head_is(value, cursor + 1, depth - 1, expected)
            },
            _ => impl_dispatch_head_is(value, cursor + 1, depth, expected)
        }
    } else { false }
}

parse_impl_dispatch(
    original: &String,
    value: &mut Parser,
    impls: &mut ImplArena,
    drops: &mut DropArena,
    uses: &mut UseArena,
    order: &mut ParsedDefTable,
    shell: ShellId,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.tokens.position = start + 1;
    value.tokens.limit = header_end;
    if(at_ident(&*value, &"Drop")
        or { at_ident(&*value, &"Use") }
        or { impl_dispatch_head_is(&*value, start + 1, 0, &"Drop") }
        or { impl_dispatch_head_is(&*value, start + 1, 0, &"Use") }) {
        parse_impl_header(original, value, drops, uses, order, shell, start, header_end, whole_end)
    } else {
        value.tokens.position = start + 1;
        parse_trait_impl_header(original, value, impls, order, shell, start, header_end, whole_end)
    }
}

finish_parser(value: Parser, nominal: NominalIndex) -> ParsedHeaders {
    let Parser {
        source,
        tokens: _,
        output
    } = value;
    ParsedHeaders {
        source: source,
        index: output,
        nominal:  nominal
    }
}

pub parse(
    original: &String,
    source: super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex
) -> Result<ParsedHeaders, HeaderError> {
    parse_shells(
        original,
        declarations,
        0,
        Parser {
            source:  source,
            tokens: super::syntax::cursor(0, 0),
            output: HeaderIndex {
                callables: Vec::new(),
                generic_params: Vec::new(),
                parameters: Vec::new(),
                types: Arena::new(),
                names: Vec::new(),
                lifetime_arguments: Vec::new(),
                type_edges: Vec::new(),
                where_goals: Vec::new(),
                lifetime_outlives: Vec::new(),
                goal_arguments: Vec::new(),
                associated_arguments: Vec::new(),
                associated_bindings: Vec::new()
            }
        },
        NominalIndex {
                definitions: ParsedDefTable {
                    order: Vec::new(),
                    by_shell: HashMap::new(),
                    enum_members: HashMap::new(),
                    fixities: HashMap::new()
                },
                aliases: AliasArena { values: Vec::new() },
                effect_row_aliases: EffectRowAliasArena { values: Vec::new() },
                structs: StructArena { values: Vec::new() },
                fields: FieldArena { values: Vec::new() },
                enums: EnumArena { values: Vec::new() },
                variants: VariantArena { values: Vec::new() },
                effects: EffectArena { values: Vec::new() },
                effect_operations: EffectOperationArena { values: Vec::new() },
                fixities: FixityArena { values: Vec::new() },
                drops: DropArena { values: Vec::new() },
                uses: UseArena { values: Vec::new() },
                traits: TraitArena { values: Vec::new() },
                impls: ImplArena { values: Vec::new() }
        }
    )
}
