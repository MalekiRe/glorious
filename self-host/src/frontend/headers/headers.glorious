header_slice<'a, T>(
    values: &'a Vec<T>,
    range: &HeaderRange
) -> Slice<'a, T> {
    handle Slice::subslice(
        Vec::as_slice(values),
        wrapping_convert_to_usize(range.start),
        wrapping_convert_to_usize(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

header_slice_value<'a, T>(
    values: &'a Vec<T>,
    range: HeaderRange
) -> Slice<'a, T> {
    handle Slice::subslice(
        Vec::as_slice(values),
        wrapping_convert_to_usize(range.start),
        wrapping_convert_to_usize(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

type_edges<'a>(
    value: &'a HeaderIndex,
    range: &HeaderRange
) -> Slice<'a, TypeEdge> {
    header_slice(&value.type_edges, range)
}

lifetime_arguments<'a>(
    value: &'a HeaderIndex,
    range: &HeaderRange
) -> Slice<'a, NameUse> {
    header_slice(&value.lifetime_arguments, range)
}

pub type_edge_range<'a>(
    value: &'a HeaderIndex,
    range: &HeaderRange
) -> Slice<'a, TypeEdge> {
    type_edges(value, range)
}

reference_type<'a>(value: Slice<'a, TypeEdge>) -> TypeId {
    handle Slice::first(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(edge) => edge.value
    }
}

pub header_type_view<'a>(
    value: &'a HeaderIndex,
    id: TypeId
) -> HeaderTypeView<'a> {
    let node = Arena::index(&value.types, id);
    let token = node.tokens.start;
    let end = node.tokens.end;
    handle node.kind {
        HeaderTypeKind::Path(names) => HeaderTypeView::Path(
            token,
            end,
            header_slice(&value.names, &names)
        ),
        HeaderTypeKind::SharedReference(lifetime, referent) =>
            HeaderTypeView::SharedReference(
            token,
            end,
            handle Option::as_ref(&lifetime) {
                Result::Err(_) => None,
                Result::Ok(found) => Option::Some(found.token)
            },
            referent
        ),
        HeaderTypeKind::UniqueReference(lifetime, referent) =>
            HeaderTypeView::UniqueReference(
            token,
            end,
            handle Option::as_ref(&lifetime) {
                Result::Err(_) => None,
                Result::Ok(found) => Option::Some(found.token)
            },
            referent
        ),
        HeaderTypeKind::Tuple(children) => HeaderTypeView::Tuple(
            token,
            end,
            type_edges(value, &children)
        ),
        HeaderTypeKind::Application(constructor, lifetimes, children, const_arguments) =>
            HeaderTypeView::Application(
            token,
            end,
            constructor,
            lifetime_arguments(value, &lifetimes),
            type_edges(value, &children),
            const_arguments
        ),
        HeaderTypeKind::Never => HeaderTypeView::Never(token, end)
    }
}

