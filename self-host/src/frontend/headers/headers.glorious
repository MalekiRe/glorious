pub goal_argument_kind_code(value: &GoalArgument) -> u8 {
    handle *value {
        GoalArgument::Type(_) => 1,
        GoalArgument::Lifetime(_) => 2,
        GoalArgument::Quantity(_, _, _) => 3,
        GoalArgument::U32(_, _) => 4
    }
}

pub goal_argument_type(value: &GoalArgument) -> Option<TypeId> {
    handle *value {
        GoalArgument::Type(found) => Option::Some(found),
        _ => None
    }
}

pub goal_argument_name(value: &GoalArgument) -> Option<u32> {
    handle value {
        GoalArgument::Lifetime(found) => Option::Some(Id::to_u32(found.name)),
        _ => None
    }
}

pub goal_argument_lower(value: &GoalArgument) -> Option<usize> {
    handle *value {
        GoalArgument::Quantity(lower, _, _) => Option::Some(lower),
        GoalArgument::U32(found, _) => Option::Some(found),
        _ => None
    }
}

pub goal_argument_upper(value: &GoalArgument) -> Option<usize> {
    handle *value {
        GoalArgument::Quantity(_, upper, _) => upper,
        GoalArgument::U32(found, _) => Option::Some(found),
        _ => None
    }
}

pub goal_argument_token(index: &HeaderIndex, value: &GoalArgument) -> usize {
    handle *value {
        GoalArgument::Type(ty) => Arena::index(&index.types, ty).tokens.start,
        GoalArgument::Lifetime(name) => name.token,
        GoalArgument::Quantity(_, _, tokens) => tokens.start,
        GoalArgument::U32(_, token) => token
    }
}

