// Flat declaration interfaces parsed from scanner-owned token ranges.
// Ordinary callables and type aliases are the first consumers of the shared
// generic/type arenas. Bodies remain unparsed.

use super::lexer::TokenKind;

pub struct HeaderRange { start: u32, count: u32 }

pub struct HeaderTokenRange { start: usize, end: usize }

pub struct TypeId { index: u32 }

impl Use<[0, *]> for TypeId {}

pub struct NameUse { name: Id<String>, token: usize }

pub struct TypeEdge { value: TypeId, position: u32 }

// kind_code:
// 1 path, 2 shared reference, 3 unique reference, 4 tuple,
// 5 application, 6 never.
pub struct TypeNode {
    kind_code: u8,
    tokens: HeaderTokenRange,
    names: HeaderRange,
    children: HeaderRange,
    constructor: Option<TypeId>,
    lifetime: Option<NameUse>
}

// kind_code: 1 type, 2 lifetime, 3 effect row.
pub struct GenericParam {
    name: Id<String>,
    kind_code: u8,
    tokens: HeaderTokenRange
}

pub struct Parameter {
    name: Id<String>,
    name_token: usize,
    ty: TypeId
}

pub struct EffectRow {
    effects: HeaderRange,
    row_tail: Option<NameUse>,
    tokens: HeaderTokenRange
}

pub struct CallableHeader {
    shell: u32,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    parameters: HeaderRange,
    result: Option<TypeId>,
    effects: Option<EffectRow>,
    tokens: HeaderTokenRange
}

pub struct TypeAliasHeader {
    shell: u32,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    target: TypeId,
    tokens: HeaderTokenRange
}

pub struct FieldHeader {
    name: Id<String>,
    name_token: usize,
    private: Bool,
    ty: TypeId
}

pub struct StructHeader {
    shell: u32,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    fields: HeaderRange,
    tokens: HeaderTokenRange
}

pub struct VariantHeader {
    name: Id<String>,
    name_token: usize,
    fields: HeaderRange
}

pub struct EnumHeader {
    shell: u32,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    variants: HeaderRange,
    tokens: HeaderTokenRange
}

pub struct FixityHeader {
    shell: u32,
    public: Bool,
    form: u8,
    precedence: u8,
    operator: HeaderTokenRange,
    tokens: HeaderTokenRange
}

struct AliasArena { values: Vec<TypeAliasHeader> }
struct StructArena { values: Vec<StructHeader> }
struct FieldArena { values: Vec<FieldHeader> }
struct EnumArena { values: Vec<EnumHeader> }
struct VariantArena { values: Vec<VariantHeader> }
struct FixityArena { values: Vec<FixityHeader> }

pub struct HeaderIndex {
    callables: Vec<CallableHeader>,
    generic_params: Vec<GenericParam>,
    parameters: Vec<Parameter>,
    types: Vec<TypeNode>,
    names: Vec<NameUse>,
    type_edges: Vec<TypeEdge>
}

pub struct NominalIndex {
    order_kinds: Vec<u8>,
    order_indices: Vec<u32>,
    aliases: AliasArena,
    structs: StructArena,
    fields: FieldArena,
    enums: EnumArena,
    variants: VariantArena,
    fixities: FixityArena
}

pub struct ParsedHeaders {
    source: super::lexer::LexedSource,
    index: HeaderIndex,
    nominal: NominalIndex
}

pub struct HeaderError { code: u8, token: usize, related: usize }

struct HeaderBounds { start: usize, end: usize }

struct Parser {
    source: super::lexer::LexedSource,
    cursor: usize,
    limit: usize,
    output: HeaderIndex
}

pub range_start(value: &HeaderRange) -> u32 { value.start }

pub range_count(value: &HeaderRange) -> u32 { value.count }

pub type_index(value: &TypeId) -> u32 { value.index }

pub callable_count(value: &HeaderIndex) -> usize { Vec::len(&value.callables) }

pub header_count(value: &NominalIndex) -> usize { Vec::len(&value.order_kinds) }

pub header_kind(value: &NominalIndex, index: usize) -> u8 {
    *Vec::index(&value.order_kinds, index)
}

pub header_index(value: &NominalIndex, index: usize) -> u32 {
    *Vec::index(&value.order_indices, index)
}

pub alias_count(value: &NominalIndex) -> usize { Vec::len(&value.aliases.values) }

pub struct_count(value: &NominalIndex) -> usize { Vec::len(&value.structs.values) }

pub field_count(value: &NominalIndex) -> usize { Vec::len(&value.fields.values) }

pub enum_count(value: &NominalIndex) -> usize { Vec::len(&value.enums.values) }

pub variant_count(value: &NominalIndex) -> usize { Vec::len(&value.variants.values) }

pub fixity_count(value: &NominalIndex) -> usize { Vec::len(&value.fixities.values) }

variant_arena_count(value: &VariantArena) -> usize { Vec::len(&value.values) }

pub type_count(value: &HeaderIndex) -> usize { Vec::len(&value.types) }

pub parameter_count(value: &HeaderIndex) -> usize { Vec::len(&value.parameters) }

pub generic_param_count(value: &HeaderIndex) -> usize {
    Vec::len(&value.generic_params)
}

pub callable_at<'a>(
    value: &'a HeaderIndex,
    index: usize
) -> Option<&'a CallableHeader> {
    Vec::get(&value.callables, index)
}

pub alias_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a TypeAliasHeader> {
    Vec::get(&value.aliases.values, index)
}

pub struct_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a StructHeader> {
    Vec::get(&value.structs.values, index)
}

pub field_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a FieldHeader> {
    Vec::get(&value.fields.values, index)
}

pub enum_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a EnumHeader> {
    Vec::get(&value.enums.values, index)
}

pub variant_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a VariantHeader> {
    Vec::get(&value.variants.values, index)
}

pub fixity_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a FixityHeader> {
    Vec::get(&value.fixities.values, index)
}

pub fixity_form_at(value: &NominalIndex, index: usize) -> u8 {
    let found = Vec::index(&value.fixities.values, index);
    found.form
}

pub fixity_precedence_at(value: &NominalIndex, index: usize) -> u8 {
    let found = Vec::index(&value.fixities.values, index);
    found.precedence
}

pub fixity_operator_start_at(value: &NominalIndex, index: usize) -> usize {
    let found = Vec::index(&value.fixities.values, index);
    found.operator.start
}

pub parsed_source(value: &ParsedHeaders) -> &super::lexer::LexedSource {
    &value.source
}

pub parsed_index(value: &ParsedHeaders) -> &HeaderIndex { &value.index }

pub nominal_index(value: &ParsedHeaders) -> &NominalIndex { &value.nominal }

pub callable_shell(value: &CallableHeader) -> u32 { value.shell }

pub callable_name_raw(value: &CallableHeader) -> u32 {
    Id::to_u32(value.name)
}

pub callable_parameters(value: &CallableHeader) -> &HeaderRange {
    &value.parameters
}

pub parameter_at<'a>(
    value: &'a HeaderIndex,
    index: usize
) -> Option<&'a Parameter> {
    Vec::get(&value.parameters, index)
}

pub parameter_name_raw(value: &Parameter) -> u32 {
    Id::to_u32(value.name)
}

pub parameter_name_token(value: &Parameter) -> usize { value.name_token }

pub parameter_type_index(value: &Parameter) -> u32 { value.ty.index }

pub callable_generic_count(value: &CallableHeader) -> u32 {
    value.generics.count
}

pub callable_has_effects(value: &CallableHeader) -> Bool {
    Option::is_some(&value.effects)
}

pub callable_result_index_plus_one(value: &CallableHeader) -> u32 {
    handle Option::as_ref(&value.result) {
        Result::Err(_) => 0,
        Result::Ok(result) => result.index + wrapping_convert_to_u32(1)
    }
}

pub type_kind_code_at(value: &HeaderIndex, index: u32) -> u8 {
    let node = Vec::index(&value.types, wrapping_convert_to_usize(index));
    node.kind_code
}

pub type_child_count_at(value: &HeaderIndex, index: u32) -> u32 {
    let node = Vec::index(&value.types, wrapping_convert_to_usize(index));
    node.children.count
}

pub type_name_count_at(value: &HeaderIndex, index: u32) -> u32 {
    let node = Vec::index(&value.types, wrapping_convert_to_usize(index));
    node.names.count
}

pub type_name_raw_at(
    value: &HeaderIndex,
    index: u32,
    ordinal: u32
) -> u32 {
    let node = Vec::index(&value.types, wrapping_convert_to_usize(index));
    let name = Vec::index(
        &value.names,
        wrapping_convert_to_usize(node.names.start + ordinal)
    );
    Id::to_u32(name.name)
}

pub type_name_token_at(
    value: &HeaderIndex,
    index: u32,
    ordinal: u32
) -> usize {
    let node = Vec::index(&value.types, wrapping_convert_to_usize(index));
    let name = Vec::index(
        &value.names,
        wrapping_convert_to_usize(node.names.start + ordinal)
    );
    name.token
}

pub token_range_start(value: &HeaderTokenRange) -> usize { value.start }

pub token_range_end(value: &HeaderTokenRange) -> usize { value.end }

pub fixity_shell(value: &FixityHeader) -> u32 { value.shell }

pub fixity_form_code(value: &FixityHeader) -> u8 { value.form }

pub fixity_precedence(value: &FixityHeader) -> u8 { value.precedence }

pub fixity_operator_start(value: &FixityHeader) -> usize {
    value.operator.start
}

pub fixity_operator_end(value: &FixityHeader) -> usize { value.operator.end }

pub type_at<'a>(value: &'a HeaderIndex, index: usize) -> Option<&'a TypeNode> {
    Vec::get(&value.types, index)
}

pub alias_generics(value: &TypeAliasHeader) -> &HeaderRange { &value.generics }

pub alias_target(value: &TypeAliasHeader) -> &TypeId { &value.target }

pub struct_generics(value: &StructHeader) -> &HeaderRange { &value.generics }

pub struct_fields(value: &StructHeader) -> &HeaderRange { &value.fields }

pub field_type(value: &FieldHeader) -> &TypeId { &value.ty }

pub field_is_private(value: &FieldHeader) -> Bool { value.private }

pub enum_generics(value: &EnumHeader) -> &HeaderRange { &value.generics }

pub enum_variants(value: &EnumHeader) -> &HeaderRange { &value.variants }

pub variant_fields(value: &VariantHeader) -> &HeaderRange { &value.fields }

pub error_code(value: &HeaderError) -> u8 { value.code }

pub error_token(value: &HeaderError) -> usize { value.token }

pub error_related(value: &HeaderError) -> usize { value.related }

header_range(start: usize, end: usize) -> HeaderRange {
    HeaderRange {
        start: wrapping_convert_to_u32(start),
        count: wrapping_convert_to_u32(end - start)
    }
}

empty_range(value: &Vec<TypeEdge>) -> HeaderRange {
    let start = Vec::len(value);
    header_range(start, start)
}

token_range(start: usize, end: usize) -> HeaderTokenRange {
    HeaderTokenRange { start: move start, end: move end }
}

header_error(code: u8, token: usize, related: usize) -> HeaderError {
    HeaderError { code: code, token: move token, related: related }
}

next_index(value: usize) -> usize { value + usize_value(1) }

previous_index(value: usize) -> usize { value - usize_value(1) }

record_header(
    kinds: &mut Vec<u8>,
    indices: &mut Vec<u32>,
    kind_code: u8,
    index: usize
) {
    Vec::push(kinds, kind_code);
    Vec::push(indices, wrapping_convert_to_u32(index))
}

header_bounds(value: &super::scanner::DeclarationShell) -> HeaderBounds {
    let range = super::scanner::shell_header(value);
    HeaderBounds {
        start: super::scanner::range_start(range),
        end: super::scanner::range_end(range)
    }
}

whole_bounds(value: &super::scanner::DeclarationShell) -> HeaderBounds {
    let range = super::scanner::shell_whole(value);
    HeaderBounds {
        start: super::scanner::range_start(range),
        end: super::scanner::range_end(range)
    }
}

token_code(value: &Parser, index: usize) -> u16 {
    super::lexer::token_code_at(&value.source, move index)
}

token_span_at(value: &Parser, index: usize) -> super::lexer::Span {
    handle super::lexer::token_at(&value.source, move index) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::lexer::token_span(token)
    }
}

source_text(value: &String, start: usize, end: usize) -> String {
    handle String::slice(value, Range { start: move start, end: move end }) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => move found
    }
}

at_code(value: &Parser, code: u16) -> Bool {
    handle value.cursor < value.limit {
        Result::Err(_) => false,
        Result::Ok(_) => token_code(value, value.cursor) == code
    }
}

eat_code(value: &mut Parser, code: u16) -> Bool {
    handle at_code(&*value, code) {
        Result::Err(_) => false,
        Result::Ok(_) => {
            value.cursor = value.cursor + usize_value(1);
            true
        }
    }
}

expect_code(
    value: &mut Parser,
    code: u16,
    error_code: u8,
    related: usize
) -> Result<(), HeaderError> {
    let token = value.cursor;
    handle eat_code(value, code) {
        Result::Err(_) => Result::Err(
            header_error(error_code, token, related)
        ),
        Result::Ok(_) => Result::Ok(())
    }
}

ident(value: &mut Parser, related: usize) -> Result<NameUse, HeaderError> {
    let token = value.cursor;
    handle value.cursor < value.limit {
        Result::Err(_) => Result::Err(header_error(1, token, related)),
        Result::Ok(_) => handle super::lexer::token_kind_at(&value.source, token) {
            TokenKind::Ident(name) => {
                value.cursor = token + usize_value(1);
                Result::Ok(NameUse { name: move name, token: token })
            },
            _ => Result::Err(header_error(1, token, related))
        }
    }
}

at_ident(value: &Parser, expected: &String) -> Bool {
    handle value.cursor < value.limit {
        Result::Err(_) => false,
        Result::Ok(_) => handle super::lexer::token_kind_at(
            &value.source,
            value.cursor
        ) {
            TokenKind::Ident(name) => handle super::lexer::lexeme(
                &value.source,
                move name
            ) {
                Result::Err(_) => false,
                Result::Ok(found) => *found == *expected
            },
            _ => false
        }
    }
}

next_is_ident(value: &Parser) -> Bool {
    let next = value.cursor + usize_value(1);
    handle next < value.limit {
        Result::Err(_) => false,
        Result::Ok(_) => super::lexer::token_code_at(&value.source, next) == 1
    }
}

push_type(
    value: &mut Parser,
    kind_code: u8,
    start: usize,
    names: HeaderRange,
    children: HeaderRange,
    constructor: Option<TypeId>,
    lifetime: Option<NameUse>
) -> TypeId {
    let index = Vec::len(&value.output.types);
    let end = value.cursor;
    Vec::push(
        &mut value.output.types,
        TypeNode {
            kind_code: kind_code,
            tokens: token_range(start, end),
            names: move names,
            children: move children,
            constructor: move constructor,
            lifetime: move lifetime
        }
    );
    TypeId { index: wrapping_convert_to_u32(index) }
}

append_edges(
    output: &mut Vec<TypeEdge>,
    values: &Vec<TypeId>,
    index: usize,
    position: u32
) {
    handle index < Vec::len(values) {
        Result::Err(_) => (),
        Result::Ok(_) => {
            Vec::push(
                &mut *output,
                TypeEdge {
                    value: *Vec::index(values, index),
                    position: position
                }
            );
            append_edges(
                move output,
                values,
                index + usize_value(1),
                position + wrapping_convert_to_u32(1)
            )
        }
    }
}

parse_type_values(
    value: &mut Parser,
    closing_code: u16,
    related: usize,
    values: &mut Vec<TypeId>
) -> Result<(), HeaderError> {
    handle at_code(&*value, closing_code) {
        Result::Ok(_) => Result::Ok(()),
        Result::Err(_) => handle parse_type(value, related) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(ty) => {
                Vec::push(&mut *values, move ty);
                handle eat_code(value, 17) {
                    Result::Err(_) => Result::Ok(()),
                    Result::Ok(_) => handle at_code(&*value, closing_code) {
                        Result::Ok(_) => Result::Ok(()),
                        Result::Err(_) => parse_type_values(
                            value,
                            closing_code,
                            related,
                            move values
                        )
                    }
                }
            }
        }
    }
}

parse_path(value: &mut Parser, related: usize) -> Result<TypeId, HeaderError> {
    let start = value.cursor;
    let name_start = Vec::len(&value.output.names);
    handle ident(value, related) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(name) => {
            Vec::push(&mut value.output.names, move name);
            parse_path_tail(value, related, start, name_start)
        }
    }
}

parse_path_tail(
    value: &mut Parser,
    related: usize,
    start: usize,
    name_start: usize
) -> Result<TypeId, HeaderError> {
    handle eat_code(value, 19) {
        Result::Ok(_) => handle ident(value, related) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(name) => {
                Vec::push(&mut value.output.names, move name);
                parse_path_tail(value, related, start, name_start)
            }
        },
        Result::Err(_) => {
            let name_end = Vec::len(&value.output.names);
            let edge_position = Vec::len(&value.output.type_edges);
            let path = push_type(
                value,
                1,
                start,
                header_range(name_start, name_end),
                header_range(edge_position, edge_position),
                Result::Err(()),
                Result::Err(())
            );
            parse_application(value, related, start, move path)
        }
    }
}

parse_application(
    value: &mut Parser,
    related: usize,
    start: usize,
    constructor: TypeId
) -> Result<TypeId, HeaderError> {
    handle eat_code(value, 34) {
        Result::Err(_) => Result::Ok(move constructor),
        Result::Ok(_) => handle at_code(&*value, 36) {
            Result::Ok(_) => Result::Err(
                header_error(5, value.cursor, related)
            ),
            Result::Err(_) => {
            let arguments = Vec::new();
            handle parse_type_values(value, 36, related, &mut arguments) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(_) => handle expect_code(value, 36, 4, related) {
                    Result::Err(error) => Result::Err(move error),
                    Result::Ok(_) => {
                        let edge_start = Vec::len(&value.output.type_edges);
                        append_edges(
                            &mut value.output.type_edges,
                            &arguments,
                            0,
                            0
                        );
                        Result::Ok(push_type(
                            value,
                            5,
                            start,
                            header_range(0, 0),
                            header_range(
                                edge_start,
                                Vec::len(&value.output.type_edges)
                            ),
                            Result::Ok(move constructor),
                            Result::Err(())
                        ))
                    }
                }
            }
            }
        }
    }
}

parse_reference(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<TypeId, HeaderError> {
    let lifetime = take_lifetime(value);
    parse_reference_referent(value, related, start, move lifetime)
}

take_lifetime(value: &mut Parser) -> Option<NameUse> {
    let cursor = value.cursor;
    let limit = value.limit;
    let kind = handle cursor < limit {
        Result::Err(_) => TokenKind::Eof,
        Result::Ok(_) => super::lexer::token_kind_at(&value.source, cursor)
    };
    handle cursor < limit {
        Result::Err(_) => Result::Err(()),
        Result::Ok(_) => handle move kind {
            TokenKind::Lifetime(name) => {
                let token = cursor;
                value.cursor = token + usize_value(1);
                Result::Ok(NameUse { name: move name, token: token })
            },
            _ => Result::Err(())
        }
    }
}

parse_reference_referent(
    value: &mut Parser,
    related: usize,
    start: usize,
    lifetime: Option<NameUse>
) -> Result<TypeId, HeaderError> {
    handle at_ident(&*value, &"mut") {
        Result::Ok(_) => {
            value.cursor = value.cursor + usize_value(1);
            parse_reference_kind(
                value,
                related,
                start,
                move lifetime,
                3
            )
        },
        Result::Err(_) => parse_reference_kind(
            value,
            related,
            start,
            move lifetime,
            2
        )
    }
}

parse_reference_kind(
    value: &mut Parser,
    related: usize,
    start: usize,
    lifetime: Option<NameUse>,
    kind_code: u8
) -> Result<TypeId, HeaderError> {
    handle parse_type(value, related) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(referent) => {
            let edge_start = Vec::len(&value.output.type_edges);
            Vec::push(
                &mut value.output.type_edges,
                TypeEdge { value: move referent, position: 0 }
            );
            Result::Ok(push_type(
                value,
                kind_code,
                start,
                header_range(0, 0),
                header_range(edge_start, edge_start + usize_value(1)),
                Result::Err(()),
                move lifetime
            ))
        }
    }
}

parse_tuple(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<TypeId, HeaderError> {
    handle eat_code(value, 12) {
        Result::Ok(_) => finish_tuple(value, start, Vec::new()),
        Result::Err(_) => handle parse_type(value, related) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(first) => handle eat_code(value, 17) {
                Result::Err(_) => handle expect_code(value, 12, 3, related) {
                    Result::Err(error) => Result::Err(move error),
                    Result::Ok(_) => Result::Ok(move first)
                },
                Result::Ok(_) => {
                    let elements = Vec::new();
                    Vec::push(&mut elements, move first);
                    handle parse_type_values(value, 12, related, &mut elements) {
                        Result::Err(error) => Result::Err(move error),
                        Result::Ok(_) => handle expect_code(value, 12, 3, related) {
                            Result::Err(error) => Result::Err(move error),
                            Result::Ok(_) => finish_tuple(value, start, move elements)
                        }
                    }
                }
            }
        }
    }
}

finish_tuple(
    value: &mut Parser,
    start: usize,
    elements: Vec<TypeId>
) -> Result<TypeId, HeaderError> {
    let edge_start = Vec::len(&value.output.type_edges);
    append_edges(&mut value.output.type_edges, &elements, 0, 0);
    Result::Ok(push_type(
        value,
        4,
        start,
        header_range(0, 0),
        header_range(edge_start, Vec::len(&value.output.type_edges)),
        Result::Err(()),
        Result::Err(())
    ))
}

parse_type(value: &mut Parser, related: usize) -> Result<TypeId, HeaderError> {
    let start = value.cursor;
    handle eat_code(value, 38) {
        Result::Ok(_) => parse_reference(value, related, start),
        Result::Err(_) => handle eat_code(value, 11) {
            Result::Ok(_) => parse_tuple(value, related, start),
            Result::Err(_) => handle eat_code(value, 39) {
                Result::Ok(_) => Result::Ok(push_type(
                    value,
                    6,
                    start,
                    header_range(0, 0),
                    empty_range(&value.output.type_edges),
                    Result::Err(()),
                    Result::Err(())
                )),
                Result::Err(_) => parse_path(value, related)
            }
        }
    }
}

parse_generics(value: &mut Parser, related: usize) -> Result<HeaderRange, HeaderError> {
    let start = Vec::len(&value.output.generic_params);
    handle eat_code(value, 34) {
        Result::Err(_) => Result::Ok(header_range(start, start)),
        Result::Ok(_) => parse_generic_items(value, related, start)
    }
}

parse_generic_items(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<HeaderRange, HeaderError> {
    handle at_code(&*value, 36) {
        Result::Ok(_) => Result::Err(header_error(5, value.cursor, related)),
        Result::Err(_) => handle parse_one_generic(value, related) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(found) => {
                    Vec::push(&mut value.output.generic_params, move found);
                    handle eat_code(value, 17) {
                        Result::Ok(_) => handle at_code(&*value, 36) {
                            Result::Ok(_) => finish_generics(value, related, start),
                            Result::Err(_) => parse_generic_items(
                                value,
                                related,
                                start
                            )
                        },
                        Result::Err(_) => finish_generics(value, related, start)
                    }
                }
        }
    }
}

parse_one_generic(
    value: &mut Parser,
    related: usize
) -> Result<GenericParam, HeaderError> {
    let token = value.cursor;
    handle super::lexer::token_kind_at(&value.source, token) {
        TokenKind::Lifetime(name) => {
            value.cursor = token + usize_value(1);
            Result::Ok(GenericParam {
                name: move name,
                kind_code: 2,
                tokens: token_range(token, value.cursor)
            })
        },
        _ => handle ident(value, related) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(name) => {
                let kind = handle eat_code(value, 18) {
                    Result::Err(_) => u8_value(1),
                    Result::Ok(_) => handle at_ident(&*value, &"EffectRow") {
                        Result::Err(_) => u8_value(0),
                        Result::Ok(_) => {
                            value.cursor = value.cursor + usize_value(1);
                            u8_value(3)
                        }
                    }
                };
                handle kind == u8_value(0) {
                    Result::Ok(_) => Result::Err(
                        header_error(6, value.cursor, related)
                    ),
                    Result::Err(_) => Result::Ok(GenericParam {
                        name: name.name,
                        kind_code: kind,
                        tokens: token_range(token, value.cursor)
                    })
                }
            }
        }
    }
}

finish_generics(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<HeaderRange, HeaderError> {
    handle expect_code(value, 36, 4, related) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(_) => Result::Ok(
            header_range(start, Vec::len(&value.output.generic_params))
        )
    }
}

parse_parameters(
    value: &mut Parser,
    related: usize
) -> Result<HeaderRange, HeaderError> {
    let start = Vec::len(&value.output.parameters);
    handle at_code(&*value, 12) {
        Result::Ok(_) => Result::Ok(header_range(start, start)),
        Result::Err(_) => parse_parameter_items(value, related, start)
    }
}

parse_parameter_items(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<HeaderRange, HeaderError> {
    handle ident(value, related) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(name) => handle expect_code(value, 18, 7, related) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(_) => handle parse_type(value, related) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(ty) => {
                    Vec::push(
                        &mut value.output.parameters,
                        Parameter {
                            name: name.name,
                            name_token: name.token,
                            ty: move ty
                        }
                    );
                    handle eat_code(value, 17) {
                        Result::Ok(_) => handle at_code(&*value, 12) {
                            Result::Ok(_) => Result::Ok(header_range(
                                start,
                                Vec::len(&value.output.parameters)
                            )),
                            Result::Err(_) => parse_parameter_items(
                                value,
                                related,
                                start
                            )
                        },
                        Result::Err(_) => Result::Ok(header_range(
                            start,
                            Vec::len(&value.output.parameters)
                        ))
                    }
                }
            }
        }
    }
}

parse_effect_row(value: &mut Parser, related: usize) -> Result<EffectRow, HeaderError> {
    let start = value.cursor;
    let effects = Vec::new();
    handle eat_code(value, 13) {
        Result::Err(_) => handle parse_type(value, related) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(found_effect) => {
                Vec::push(&mut effects, move found_effect);
                finish_effects(
                    value,
                    start,
                    move effects,
                    Result::Err(())
                )
            }
        },
        Result::Ok(_) => parse_effect_items(value, related, start, move effects)
    }
}

parse_effect_items(
    value: &mut Parser,
    related: usize,
    start: usize,
    effects: Vec<TypeId>
) -> Result<EffectRow, HeaderError> {
    handle eat_code(value, 30) {
        Result::Ok(_) => handle ident(value, related) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(row_tail) => handle expect_code(value, 14, 8, related) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(_) => finish_effects(
                    value,
                    start,
                    move effects,
                    Result::Ok(move row_tail)
                )
            }
        },
        Result::Err(_) => handle eat_code(value, 14) {
            Result::Ok(_) => finish_effects(
                value,
                start,
                move effects,
                Result::Err(())
            ),
            Result::Err(_) => handle parse_type(value, related) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(found_effect) => {
                    let next = move effects;
                    Vec::push(&mut next, move found_effect);
                    handle eat_code(value, 17) {
                        Result::Ok(_) => parse_effect_items(
                            value,
                            related,
                            start,
                            move next
                        ),
                        Result::Err(_) => parse_effect_items(
                            value,
                            related,
                            start,
                            move next
                        )
                    }
                }
            }
        }
    }
}

finish_effects(
    value: &mut Parser,
    start: usize,
    effects: Vec<TypeId>,
    row_tail: Option<NameUse>
) -> Result<EffectRow, HeaderError> {
    let edge_start = Vec::len(&value.output.type_edges);
    append_edges(
        &mut value.output.type_edges,
        &effects,
        0,
        0
    );
    Result::Ok(EffectRow {
        effects: header_range(edge_start, Vec::len(&value.output.type_edges)),
        row_tail: move row_tail,
        tokens: token_range(start, value.cursor)
    })
}

parse_callable(
    value: &mut Parser,
    shell: u32,
    public: Bool,
    start: usize
) -> Result<(), HeaderError> {
    value.cursor = start;
    handle public {
        Result::Ok(_) => { value.cursor = value.cursor + usize_value(1); },
        Result::Err(_) => ()
    };
    handle ident(value, start) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(name) => handle parse_generics(value, start) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(generics) => handle expect_code(value, 11, 2, start) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(_) => handle parse_parameters(value, start) {
                    Result::Err(error) => Result::Err(move error),
                    Result::Ok(parameters) => handle expect_code(
                        value,
                        12,
                        3,
                        start
                    ) {
                        Result::Err(error) => Result::Err(move error),
                        Result::Ok(_) => parse_callable_suffix(
                            value,
                            shell,
                            move public,
                            start,
                            move name,
                            move generics,
                            move parameters
                        )
                    }
                }
            }
        }
    }
}

parse_callable_suffix(
    value: &mut Parser,
    shell: u32,
    public: Bool,
    start: usize,
    name: NameUse,
    generics: HeaderRange,
    parameters: HeaderRange
) -> Result<(), HeaderError> {
    handle eat_code(value, 23) {
        Result::Err(_) => parse_callable_effects(
            value,
            shell,
            move public,
            start,
            move name,
            move generics,
            move parameters,
            Result::Err(())
        ),
        Result::Ok(_) => handle at_code(&*value, 25) {
            Result::Ok(_) => parse_callable_effects(
                value,
                shell,
                move public,
                start,
                move name,
                move generics,
                move parameters,
                Result::Err(())
            ),
            Result::Err(_) => handle parse_type(value, start) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(parsed_result) => parse_callable_effects(
                    value,
                    shell,
                    move public,
                    start,
                    move name,
                    move generics,
                    move parameters,
                    Result::Ok(move parsed_result)
                )
            }
        }
    }
}

parse_callable_effects(
    value: &mut Parser,
    shell: u32,
    public: Bool,
    start: usize,
    name: NameUse,
    generics: HeaderRange,
    parameters: HeaderRange,
    result: Option<TypeId>
) -> Result<(), HeaderError> {
    handle eat_code(value, 25) {
        Result::Err(_) => finish_callable(
            value,
            shell,
            move public,
            start,
            move name,
            move generics,
            move parameters,
            move result,
            Result::Err(())
        ),
        Result::Ok(_) => handle parse_effect_row(value, start) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(parsed_effects) => finish_callable(
                value,
                shell,
                move public,
                start,
                move name,
                move generics,
                move parameters,
                move result,
                Result::Ok(move parsed_effects)
            )
        }
    }
}

finish_callable(
    value: &mut Parser,
    shell: u32,
    public: Bool,
    start: usize,
    name: NameUse,
    generics: HeaderRange,
    parameters: HeaderRange,
    result: Option<TypeId>,
    effects: Option<EffectRow>
) -> Result<(), HeaderError> {
    handle value.cursor == value.limit {
        Result::Err(_) => Result::Err(
            header_error(9, value.cursor, start)
        ),
        Result::Ok(_) => {
            let limit = value.limit;
            Vec::push(
                &mut value.output.callables,
                CallableHeader {
                    shell: shell,
                    name: name.name,
                    public: move public,
                    generics: move generics,
                    parameters: move parameters,
                    result: move result,
                    effects: move effects,
                    tokens: token_range(start, limit)
                }
            );
            Result::Ok(())
        }
    }
}

fixity_form(value: &Parser) -> u8 {
    handle at_ident(value, &"prefix") {
        Result::Ok(_) => u8_value(1),
        Result::Err(_) => handle at_ident(value, &"infixl") {
            Result::Ok(_) => u8_value(2),
            Result::Err(_) => handle at_ident(value, &"infixr") {
                Result::Ok(_) => u8_value(3),
                Result::Err(_) => handle at_ident(value, &"infix") {
                    Result::Ok(_) => u8_value(4),
                    Result::Err(_) => u8_value(0)
                }
            }
        }
    }
}

integer_number(value: &super::lexer::NumberToken) -> Bool {
    handle Option::as_ref(super::lexer::number_fraction(value)) {
        Result::Ok(_) => false,
        Result::Err(_) => handle Option::as_ref(
            super::lexer::number_exponent(value)
        ) {
            Result::Ok(_) => false,
            Result::Err(_) => true
        }
    }
}

parse_precedence(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<u8, HeaderError> {
    let token = value.cursor;
    handle super::lexer::token_kind_at(&value.source, token) {
        super::lexer::TokenKind::Number(number) => handle integer_number(&number) {
            Result::Err(_) => Result::Err(header_error(11, token, related)),
            Result::Ok(_) => {
                let spelling = super::lexer::number_spelling(&number);
                let text = source_text(
                    original,
                    super::lexer::span_start(&spelling),
                    super::lexer::span_end(&spelling)
                );
                handle parse_u64(&text) {
                    Result::Err(_) => Result::Err(
                        header_error(11, token, related)
                    ),
                    Result::Ok(found) => handle found <= u64_value(255) {
                        Result::Err(_) => Result::Err(
                            header_error(11, token, related)
                        ),
                        Result::Ok(_) => {
                            value.cursor = token + usize_value(1);
                            Result::Ok(wrapping_convert_to_u8(found))
                        }
                    }
                }
            }
        },
        _ => Result::Err(header_error(11, token, related))
    }
}

operator_symbol(value: &Parser, index: usize) -> Bool {
    super::lexer::operator_symbol_at(&value.source, index)
}

operator_tail(value: &Parser, cursor: usize, previous_end: usize) -> usize {
    super::lexer::operator_end(
        &value.source,
        cursor,
        value.limit,
        previous_end
    )
}

take_operator(
    value: &mut Parser,
    related: usize
) -> Result<HeaderTokenRange, HeaderError> {
    let start = value.cursor;
    handle start < value.limit {
        Result::Err(_) => Result::Err(header_error(12, start, related)),
        Result::Ok(_) => handle token_code(&*value, start) == u16_value(1) {
            Result::Ok(_) => {
                value.cursor = start + usize_value(1);
                Result::Ok(token_range(start, value.cursor))
            },
            Result::Err(_) => handle operator_symbol(&*value, start) {
                Result::Err(_) => Result::Err(header_error(12, start, related)),
                Result::Ok(_) => {
                    let first = token_span_at(&*value, start);
                    let end = operator_tail(
                        &*value,
                        start + usize_value(1),
                        super::lexer::span_end(&first)
                    );
                    value.cursor = end;
                    Result::Ok(token_range(start, end))
                }
            }
        }
    }
}

parse_fixity(
    original: &String,
    value: &mut Parser,
    fixities: &mut FixityArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.cursor = start;
    value.limit = whole_end;
    handle public {
        Result::Ok(_) => { value.cursor = value.cursor + usize_value(1); },
        Result::Err(_) => ()
    };
    let form = fixity_form(&*value);
    handle form == u8_value(0) {
        Result::Ok(_) => Result::Err(header_error(13, value.cursor, start)),
        Result::Err(_) => {
            value.cursor = value.cursor + usize_value(1);
            handle parse_precedence(original, value, start) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(precedence) => handle take_operator(value, start) {
                    Result::Err(error) => Result::Err(move error),
                    Result::Ok(operator) => handle expect_code(
                        value,
                        22,
                        8,
                        start
                    ) {
                        Result::Err(error) => Result::Err(move error),
                        Result::Ok(_) => handle value.cursor == value.limit {
                            Result::Err(_) => Result::Err(
                                header_error(9, value.cursor, start)
                            ),
                            Result::Ok(_) => {
                                Vec::push(
                                    &mut fixities.values,
                                    FixityHeader {
                                        shell: shell,
                                        public: move public,
                                        form: form,
                                        precedence: precedence,
                                        operator: move operator,
                                        tokens: token_range(start, whole_end)
                                    }
                                );
                                let index = Vec::len(&fixities.values)
                                    - usize_value(1);
                                record_header(
                                    order_kinds,
                                    order_indices,
                                    6,
                                    index
                                );
                                Result::Ok(())
                            }
                        }
                    }
                }
            }
        }
    }
}

parse_alias(
    value: &mut Parser,
    aliases: &mut AliasArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.cursor = start;
    handle public {
        Result::Ok(_) => { value.cursor = value.cursor + usize_value(1); },
        Result::Err(_) => ()
    };
    parse_alias_name(
        value,
        aliases,
        order_kinds,
        order_indices,
        shell,
        move public,
        start,
        whole_end
    )
}

parse_alias_name(
    value: &mut Parser,
    aliases: &mut AliasArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.cursor = value.cursor + usize_value(1);
    handle ident(value, start) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(name) => handle parse_generics(value, start) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(generics) => handle expect_code(value, 31, 10, start) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(_) => {
                    value.limit = whole_end - usize_value(1);
                    handle parse_type(value, start) {
                        Result::Err(error) => Result::Err(move error),
                        Result::Ok(target) => handle value.cursor == value.limit {
                            Result::Err(_) => Result::Err(
                                header_error(9, value.cursor, start)
                            ),
                            Result::Ok(_) => finish_alias(
                                aliases,
                                order_kinds,
                                order_indices,
                                shell,
                                move public,
                                start,
                                whole_end,
                                move name,
                                move generics,
                                move target
                            )
                        }
                    }
                }
            }
        }
    }
}

finish_alias(
    aliases: &mut AliasArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    whole_end: usize,
    name: NameUse,
    generics: HeaderRange,
    target: TypeId
) -> Result<(), HeaderError> {
    Vec::push(
        &mut aliases.values,
        TypeAliasHeader {
            shell: shell,
            name: name.name,
            public: move public,
            generics: move generics,
            target: move target,
            tokens: token_range(start, whole_end)
        }
    );
    let index = Vec::len(&aliases.values) - usize_value(1);
    record_header(order_kinds, order_indices, 3, index);
    Result::Ok(())
}

parse_struct(
    value: &mut Parser,
    structs: &mut StructArena,
    fields: &mut FieldArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.cursor = start;
    handle public {
        Result::Ok(_) => { value.cursor = value.cursor + usize_value(1); },
        Result::Err(_) => ()
    };
    value.cursor = value.cursor + usize_value(1);
    handle ident(value, start) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(name) => handle parse_generics(value, start) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(generics) => handle value.cursor == header_end {
                Result::Err(_) => Result::Err(
                    header_error(9, value.cursor, start)
                ),
                Result::Ok(_) => {
                    value.cursor = header_end + usize_value(1);
                    value.limit = whole_end - usize_value(1);
                    let field_start = Vec::len(&fields.values);
                    handle parse_fields(value, fields, start) {
                        Result::Err(error) => Result::Err(move error),
                        Result::Ok(_) => finish_struct(
                            structs,
                            fields,
                            order_kinds,
                            order_indices,
                            shell,
                            move public,
                            start,
                            whole_end,
                            move name,
                            move generics,
                            field_start
                        )
                    }
                }
            }
        }
    }
}

parse_fields(
    value: &mut Parser,
    fields: &mut FieldArena,
    related: usize
) -> Result<(), HeaderError> {
    handle value.cursor < value.limit {
        Result::Err(_) => Result::Ok(()),
        Result::Ok(_) => {
            let private = handle at_ident(&*value, &"private") {
                Result::Err(_) => false,
                Result::Ok(_) => next_is_ident(&*value)
            };
            handle private {
                Result::Ok(_) => {
                    value.cursor = value.cursor + usize_value(1);
                },
                Result::Err(_) => ()
            };
            handle ident(value, related) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(name) => handle expect_code(
                    value,
                    18,
                    7,
                    related
                ) {
                    Result::Err(error) => Result::Err(move error),
                    Result::Ok(_) => handle parse_type(value, related) {
                        Result::Err(error) => Result::Err(move error),
                        Result::Ok(ty) => {
                            Vec::push(
                                &mut fields.values,
                                FieldHeader {
                                    name: name.name,
                                    name_token: name.token,
                                    private: private,
                                    ty: move ty
                                }
                            );
                            eat_code(value, 17);
                            eat_code(value, 22);
                            parse_fields(value, fields, related)
                        }
                    }
                }
            }
        }
    }
}

finish_struct(
    structs: &mut StructArena,
    fields: &mut FieldArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    whole_end: usize,
    name: NameUse,
    generics: HeaderRange,
    field_start: usize
) -> Result<(), HeaderError> {
    let field_end = Vec::len(&fields.values);
    Vec::push(
        &mut structs.values,
        StructHeader {
            shell: shell,
            name: name.name,
            public: move public,
            generics: move generics,
            fields: header_range(field_start, field_end),
            tokens: token_range(start, whole_end)
        }
    );
    let index = Vec::len(&structs.values) - usize_value(1);
    record_header(order_kinds, order_indices, 8, index);
    Result::Ok(())
}

parse_sum_header(
    value: &mut Parser,
    enums: &mut EnumArena,
    variants: &mut VariantArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    value.cursor = start;
    handle public {
        Result::Ok(_) => { value.cursor = value.cursor + usize_value(1); },
        Result::Err(_) => ()
    };
    value.cursor = value.cursor + usize_value(1);
    handle ident(value, start) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(name) => handle parse_generics(value, start) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(generics) => handle value.cursor == header_end {
                Result::Err(_) => Result::Err(
                    header_error(9, value.cursor, start)
                ),
                Result::Ok(_) => parse_sum_body(
                    value,
                    enums,
                    variants,
                    order_kinds,
                    order_indices,
                    shell,
                    move public,
                    start,
                    header_end,
                    whole_end,
                    move name,
                    move generics
                )
            }
        }
    }
}

parse_sum_body(
    value: &mut Parser,
    enums: &mut EnumArena,
    variants: &mut VariantArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize,
    name: NameUse,
    generics: HeaderRange
) -> Result<(), HeaderError> {
    value.cursor = next_index(header_end);
    value.limit = previous_index(whole_end);
    let variant_start = variant_arena_count(&*variants);
    handle parse_variants(value, variants, start) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(_) => {
            finish_enum(
                enums,
                variants,
                order_kinds,
                order_indices,
                shell,
                move public,
                start,
                whole_end,
                move name,
                move generics,
                variant_start
            );
            Result::Ok(())
        }
    }
}

parse_variants(
    value: &mut Parser,
    variants: &mut VariantArena,
    related: usize
) -> Result<(), HeaderError> {
    handle value.cursor < value.limit {
        Result::Err(_) => Result::Ok(()),
        Result::Ok(_) => handle ident(value, related) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(name) => {
                let fields = Vec::new();
                handle eat_code(value, 11) {
                    Result::Err(_) => finish_variant(
                        value,
                        variants,
                        related,
                        move name,
                        move fields
                    ),
                    Result::Ok(_) => handle parse_type_values(
                        value,
                        12,
                        related,
                        &mut fields
                    ) {
                        Result::Err(error) => Result::Err(move error),
                        Result::Ok(_) => handle expect_code(
                            value,
                            12,
                            3,
                            related
                        ) {
                            Result::Err(error) => Result::Err(move error),
                            Result::Ok(_) => finish_variant(
                                value,
                                variants,
                                related,
                                move name,
                                move fields
                            )
                        }
                    }
                }
            }
        }
    }
}

finish_variant(
    value: &mut Parser,
    variants: &mut VariantArena,
    related: usize,
    name: NameUse,
    fields: Vec<TypeId>
) -> Result<(), HeaderError> {
    let edge_start = Vec::len(&value.output.type_edges);
    append_edges(
        &mut value.output.type_edges,
        &fields,
        0,
        0
    );
    let edge_end = Vec::len(&value.output.type_edges);
    Vec::push(
        &mut variants.values,
        VariantHeader {
            name: name.name,
            name_token: name.token,
            fields: header_range(edge_start, edge_end)
        }
    );
    eat_code(value, 17);
    eat_code(value, 22);
    parse_variants(value, variants, related)
}

finish_enum(
    enums: &mut EnumArena,
    variants: &mut VariantArena,
    order_kinds: &mut Vec<u8>,
    order_indices: &mut Vec<u32>,
    shell: u32,
    public: Bool,
    start: usize,
    whole_end: usize,
    name: NameUse,
    generics: HeaderRange,
    variant_start: usize
) {
    let variant_end = variant_arena_count(&*variants);
    Vec::push(
        &mut enums.values,
        EnumHeader {
            shell: shell,
            name: name.name,
            public: move public,
            generics: move generics,
            variants: header_range(variant_start, variant_end),
            tokens: token_range(start, whole_end)
        }
    );
    let index = Vec::len(&enums.values) - usize_value(1);
    record_header(order_kinds, order_indices, 9, index)
}

parse_shells(
    original: &String,
    declarations: &super::scanner::DeclarationIndex,
    index: usize,
    parser: Parser,
    nominal: NominalIndex
) -> Result<ParsedHeaders, HeaderError> {
    handle index < super::scanner::shell_count(declarations) {
        Result::Err(_) => Result::Ok(finish_parser(move parser, move nominal)),
        Result::Ok(_) => handle super::scanner::shell_at(declarations, index) {
            Result::Err(_) => Result::Ok(
                finish_parser(move parser, move nominal)
            ),
            Result::Ok(shell) => {
                let bounds = header_bounds(shell);
                let whole = whole_bounds(shell);
                let start = bounds.start;
                let limit = bounds.end;
                let whole_end = whole.end;
                let next = Parser {
                    source: move parser.source,
                    cursor: start,
                    limit: limit,
                    output: move parser.output
                };
                let parsed = handle super::scanner::shell_kind_code(shell) {
                    12 => {
                        let callable_index = Vec::len(&next.output.callables);
                        record_header(
                            &mut nominal.order_kinds,
                            &mut nominal.order_indices,
                            12,
                            callable_index
                        );
                        parse_callable(
                            &mut next,
                            wrapping_convert_to_u32(index),
                            super::scanner::shell_is_public(shell),
                            start
                        )
                    },
                    6 => parse_fixity(
                        original,
                        &mut next,
                        &mut nominal.fixities,
                        &mut nominal.order_kinds,
                        &mut nominal.order_indices,
                        wrapping_convert_to_u32(index),
                        super::scanner::shell_is_public(shell),
                        start,
                        whole_end
                    ),
                    3 => parse_alias(
                        &mut next,
                        &mut nominal.aliases,
                        &mut nominal.order_kinds,
                        &mut nominal.order_indices,
                        wrapping_convert_to_u32(index),
                        super::scanner::shell_is_public(shell),
                        start,
                        whole_end
                    ),
                    8 => parse_struct(
                        &mut next,
                        &mut nominal.structs,
                        &mut nominal.fields,
                        &mut nominal.order_kinds,
                        &mut nominal.order_indices,
                        wrapping_convert_to_u32(index),
                        super::scanner::shell_is_public(shell),
                        start,
                        limit,
                        whole_end
                    ),
                    9 => parse_sum_header(
                        &mut next,
                        &mut nominal.enums,
                        &mut nominal.variants,
                        &mut nominal.order_kinds,
                        &mut nominal.order_indices,
                        wrapping_convert_to_u32(index),
                        super::scanner::shell_is_public(shell),
                        start,
                        limit,
                        whole_end
                    ),
                    _ => Result::Ok(())
                };
                handle move parsed {
                    Result::Err(error) => Result::Err(move error),
                    Result::Ok(_) => parse_shells(
                        original,
                        declarations,
                        index + usize_value(1),
                        move next,
                        move nominal
                    )
                }
            }
        }
    }
}

finish_parser(value: Parser, nominal: NominalIndex) -> ParsedHeaders {
    ParsedHeaders {
        source: move value.source,
        index: move value.output,
        nominal: move nominal
    }
}

pub parse(
    original: &String,
    source: super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex
) -> Result<ParsedHeaders, HeaderError> {
    parse_shells(
        original,
        declarations,
        0,
        Parser {
            source: move source,
            cursor: 0,
            limit: 0,
            output: HeaderIndex {
                callables: Vec::new(),
                generic_params: Vec::new(),
                parameters: Vec::new(),
                types: Vec::new(),
                names: Vec::new(),
                type_edges: Vec::new()
            }
        },
        NominalIndex {
                order_kinds: Vec::new(),
                order_indices: Vec::new(),
                aliases: AliasArena { values: Vec::new() },
                structs: StructArena { values: Vec::new() },
                fields: FieldArena { values: Vec::new() },
                enums: EnumArena { values: Vec::new() },
                variants: VariantArena { values: Vec::new() },
                fixities: FixityArena { values: Vec::new() }
        }
    )
}

write_string(output: &mut ByteBuf, value: &String) {
    let bytes = String::as_bytes(value);
    ByteBuf::write_u32_le(
        &mut *output,
        wrapping_convert_to_u32(Bytes::len(&bytes))
    );
    ByteBuf::append_bytes(move output, &bytes)
}

write_name(
    output: &mut ByteBuf,
    source: &super::lexer::LexedSource,
    name: Id<String>
) {
    handle super::lexer::lexeme(source, move name) {
        Result::Err(_) => unreachable(),
        Result::Ok(text) => write_string(move output, text)
    }
}

write_optional_name(
    output: &mut ByteBuf,
    source: &super::lexer::LexedSource,
    value: &Option<NameUse>
) {
    handle Option::as_ref(value) {
        Result::Err(_) => ByteBuf::push(move output, 0),
        Result::Ok(name) => {
            ByteBuf::push(&mut *output, 1);
            write_name(move output, source, name.name)
        }
    }
}

write_type_edges(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    range: &HeaderRange,
    index: u32
) {
    handle index < range.count {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let edge = Vec::index(
                &parsed.index.type_edges,
                wrapping_convert_to_usize(range.start + index)
            );
            write_type(output, parsed, &edge.value);
            write_type_edges(
                move output,
                parsed,
                range,
                index + wrapping_convert_to_u32(1)
            )
        }
    }
}

write_path_names(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    range: &HeaderRange,
    index: u32
) {
    handle index < range.count {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let name = Vec::index(
                &parsed.index.names,
                wrapping_convert_to_usize(range.start + index)
            );
            write_name(&mut *output, &parsed.source, name.name);
            write_path_names(
                move output,
                parsed,
                range,
                index + wrapping_convert_to_u32(1)
            )
        }
    }
}

write_type(output: &mut ByteBuf, parsed: &ParsedHeaders, id: &TypeId) {
    let node = Vec::index(
        &parsed.index.types,
        wrapping_convert_to_usize(id.index)
    );
    ByteBuf::push(&mut *output, node.kind_code);
    handle node.kind_code {
        1 => {
            ByteBuf::write_u32_le(&mut *output, node.names.count);
            write_path_names(move output, parsed, &node.names, 0)
        },
        2 => {
            write_optional_name(&mut *output, &parsed.source, &node.lifetime);
            write_type_edges(move output, parsed, &node.children, 0)
        },
        3 => {
            write_optional_name(&mut *output, &parsed.source, &node.lifetime);
            write_type_edges(move output, parsed, &node.children, 0)
        },
        4 => {
            ByteBuf::write_u32_le(&mut *output, node.children.count);
            write_type_edges(move output, parsed, &node.children, 0)
        },
        5 => {
            handle Option::as_ref(&node.constructor) {
                Result::Err(_) => (),
                Result::Ok(constructor) => write_type(
                    &mut *output,
                    parsed,
                    constructor
                )
            };
            ByteBuf::write_u32_le(&mut *output, node.children.count);
            write_type_edges(move output, parsed, &node.children, 0)
        },
        _ => ()
    }
}

write_generics(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    range: &HeaderRange,
    index: u32
) {
    handle index < range.count {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let parameter = Vec::index(
                &parsed.index.generic_params,
                wrapping_convert_to_usize(range.start + index)
            );
            ByteBuf::push(&mut *output, parameter.kind_code);
            write_name(&mut *output, &parsed.source, parameter.name);
            write_generics(
                move output,
                parsed,
                range,
                index + wrapping_convert_to_u32(1)
            )
        }
    }
}

write_parameters(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    range: &HeaderRange,
    index: u32
) {
    handle index < range.count {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let parameter = Vec::index(
                &parsed.index.parameters,
                wrapping_convert_to_usize(range.start + index)
            );
            write_name(&mut *output, &parsed.source, parameter.name);
            write_type(&mut *output, parsed, &parameter.ty);
            write_parameters(
                move output,
                parsed,
                range,
                index + wrapping_convert_to_u32(1)
            )
        }
    }
}

write_callable(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &CallableHeader
) {
    ByteBuf::push(&mut *output, bool_code(value.public));
    write_name(&mut *output, &parsed.source, value.name);
    ByteBuf::write_u32_le(&mut *output, value.generics.count);
    write_generics(&mut *output, parsed, &value.generics, 0);
    ByteBuf::write_u32_le(&mut *output, value.parameters.count);
    write_parameters(&mut *output, parsed, &value.parameters, 0);
    handle Option::as_ref(&value.result) {
        Result::Err(_) => ByteBuf::push(&mut *output, 0),
        Result::Ok(result) => {
            ByteBuf::push(&mut *output, 1);
            write_type(&mut *output, parsed, result)
        }
    };
    handle Option::as_ref(&value.effects) {
        Result::Err(_) => ByteBuf::push(move output, 0),
        Result::Ok(row) => {
            ByteBuf::push(&mut *output, 1);
            write_effect_row(move output, parsed, row)
        }
    }
}

write_effect_row(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    row: &EffectRow
) {
    ByteBuf::write_u32_le(&mut *output, row.effects.count);
    write_type_edges(&mut *output, parsed, &row.effects, 0);
    write_optional_name(move output, &parsed.source, &row.row_tail)
}

write_callables(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    index: usize
) {
    handle index < Vec::len(&parsed.index.callables) {
        Result::Err(_) => (),
        Result::Ok(_) => {
            write_callable(
                &mut *output,
                parsed,
                Vec::index(&parsed.index.callables, index)
            );
            write_callables(
                move output,
                parsed,
                index + usize_value(1)
            )
        }
    }
}

write_common(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    public: Bool,
    name: Id<String>,
    generics: &HeaderRange
) {
    ByteBuf::push(&mut *output, bool_code(move public));
    write_name(&mut *output, &parsed.source, move name);
    ByteBuf::write_u32_le(&mut *output, generics.count);
    write_generics(move output, parsed, generics, 0)
}

write_alias(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &TypeAliasHeader
) {
    write_common(
        &mut *output,
        parsed,
        value.public,
        value.name,
        &value.generics
    );
    write_type(move output, parsed, &value.target)
}

write_fields(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    range: &HeaderRange,
    index: u32
) {
    handle index < range.count {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let field = Vec::index(
                &parsed.nominal.fields.values,
                wrapping_convert_to_usize(range.start + index)
            );
            handle field.private {
                Result::Err(_) => ByteBuf::push(&mut *output, 1),
                Result::Ok(_) => ByteBuf::push(&mut *output, 0)
            };
            write_name(&mut *output, &parsed.source, field.name);
            write_type(&mut *output, parsed, &field.ty);
            write_fields(
                move output,
                parsed,
                range,
                index + wrapping_convert_to_u32(1)
            )
        }
    }
}

write_struct(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &StructHeader
) {
    write_common(
        &mut *output,
        parsed,
        value.public,
        value.name,
        &value.generics
    );
    ByteBuf::write_u32_le(&mut *output, value.fields.count);
    write_fields(move output, parsed, &value.fields, 0)
}

write_variants(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    range: &HeaderRange,
    index: u32
) {
    handle index < range.count {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let variant = Vec::index(
                &parsed.nominal.variants.values,
                wrapping_convert_to_usize(range.start + index)
            );
            write_name(&mut *output, &parsed.source, variant.name);
            ByteBuf::write_u32_le(&mut *output, variant.fields.count);
            write_type_edges(&mut *output, parsed, &variant.fields, 0);
            write_variants(
                move output,
                parsed,
                range,
                index + wrapping_convert_to_u32(1)
            )
        }
    }
}

write_enum(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &EnumHeader
) {
    write_common(
        &mut *output,
        parsed,
        value.public,
        value.name,
        &value.generics
    );
    ByteBuf::write_u32_le(&mut *output, value.variants.count);
    write_variants(move output, parsed, &value.variants, 0)
}

parsed_token_span(
    value: &ParsedHeaders,
    index: usize
) -> super::lexer::Span {
    handle super::lexer::token_at(&value.source, move index) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::lexer::token_span(token)
    }
}

write_fixity(
    output: &mut ByteBuf,
    original: &String,
    parsed: &ParsedHeaders,
    value: &FixityHeader
) {
    ByteBuf::push(&mut *output, bool_code(value.public));
    ByteBuf::push(&mut *output, value.form);
    ByteBuf::push(&mut *output, value.precedence);
    let first = parsed_token_span(parsed, value.operator.start);
    let last = parsed_token_span(
        parsed,
        previous_index(value.operator.end)
    );
    let spelling = source_text(
        original,
        super::lexer::span_start(&first),
        super::lexer::span_end(&last)
    );
    write_string(move output, &spelling)
}

write_interfaces(
    output: &mut ByteBuf,
    original: &String,
    parsed: &ParsedHeaders,
    index: usize
) {
    handle index < header_count(&parsed.nominal) {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let kind = header_kind(&parsed.nominal, index);
            let declaration = wrapping_convert_to_usize(
                header_index(&parsed.nominal, index)
            );
            ByteBuf::push(&mut *output, kind);
            handle kind {
                3 => write_alias(
                    &mut *output,
                    parsed,
                    Vec::index(&parsed.nominal.aliases.values, declaration)
                ),
                6 => write_fixity(
                    &mut *output,
                    original,
                    parsed,
                    Vec::index(&parsed.nominal.fixities.values, declaration)
                ),
                8 => write_struct(
                    &mut *output,
                    parsed,
                    Vec::index(&parsed.nominal.structs.values, declaration)
                ),
                9 => write_enum(
                    &mut *output,
                    parsed,
                    Vec::index(&parsed.nominal.enums.values, declaration)
                ),
                12 => write_callable(
                    &mut *output,
                    parsed,
                    Vec::index(&parsed.index.callables, declaration)
                ),
                _ => unreachable()
            };
            write_interfaces(
                move output,
                original,
                parsed,
                index + usize_value(1)
            )
        }
    }
}

encode_source(output: &mut ByteBuf, source: String) {
    handle super::lexer::lex(&source) {
        Result::Err(_) => ByteBuf::push(move output, 1),
        Result::Ok(lexed) => handle super::scanner::scan(&lexed) {
            Result::Err(_) => ByteBuf::push(move output, 2),
            Result::Ok(declarations) => handle parse(
                &source,
                move lexed,
                &declarations
            ) {
                Result::Err(_) => ByteBuf::push(move output, 3),
                Result::Ok(parsed) => {
                    ByteBuf::push(&mut *output, 0);
                    ByteBuf::write_u32_le(
                        &mut *output,
                        wrapping_convert_to_u32(
                            Vec::len(&parsed.index.callables)
                        )
                    );
                    write_callables(move output, &parsed, 0)
                }
            }
        }
    }
}

encode_interface_source(output: &mut ByteBuf, source: String) {
    handle super::lexer::lex(&source) {
        Result::Err(_) => ByteBuf::push(move output, 1),
        Result::Ok(lexed) => handle super::scanner::scan(&lexed) {
            Result::Err(_) => ByteBuf::push(move output, 2),
            Result::Ok(declarations) => handle parse(
                &source,
                move lexed,
                &declarations
            ) {
                Result::Err(_) => ByteBuf::push(move output, 3),
                Result::Ok(parsed) => {
                    ByteBuf::push(&mut *output, 0);
                    ByteBuf::write_u32_le(
                        &mut *output,
                        wrapping_convert_to_u32(header_count(&parsed.nominal))
                    );
                    write_interfaces(move output, &source, &parsed, 0)
                }
            }
        }
    }
}

process_inputs(
    arguments: &Vec<String>,
    index: usize,
    output: &mut ByteBuf
) / FileRead {
    handle index < Vec::len(arguments) {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let path = *Vec::index(arguments, index);
            let bytes = read_file(move path);
            handle String::from_utf8(move bytes) {
                Result::Err(_) => ByteBuf::push(&mut *output, 1),
                Result::Ok(source) => encode_source(&mut *output, move source)
            };
            process_inputs(
                arguments,
                index + usize_value(1),
                move output
            )
        }
    }
}

process_interface_inputs(
    arguments: &Vec<String>,
    index: usize,
    output: &mut ByteBuf
) / FileRead {
    handle index < Vec::len(arguments) {
        Result::Err(_) => (),
        Result::Ok(_) => {
            let path = *Vec::index(arguments, index);
            let bytes = read_file(move path);
            handle String::from_utf8(move bytes) {
                Result::Err(_) => ByteBuf::push(&mut *output, 1),
                Result::Ok(source) => encode_interface_source(
                    &mut *output,
                    move source
                )
            };
            process_interface_inputs(
                arguments,
                index + usize_value(1),
                move output
            )
        }
    }
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    let count = Vec::len(&arguments);
    handle count < usize_value(2) {
        Result::Ok(_) => write_diagnostic(
            "usage: grandiose-self-host-headers <output> <input>..."
        ),
        Result::Err(_) => {
            let output_path = *Vec::index(&arguments, 0);
            let encoded = ByteBuf::new();
            ByteBuf::write_u32_le(
                &mut encoded,
                wrapping_convert_to_u32(count - usize_value(1))
            );
            process_inputs(&arguments, 1, &mut encoded);
            write_file(move output_path, ByteBuf::finish(move encoded))
        }
    }
}

pub interface_application() / {
    ProcessArgs,
    FileRead,
    FileWrite,
    Diagnostic
} {
    let arguments = process_args();
    let count = Vec::len(&arguments);
    handle count < usize_value(2) {
        Result::Ok(_) => write_diagnostic(
            "usage: grandiose-self-host-interfaces <output> <input>..."
        ),
        Result::Err(_) => {
            let output_path = *Vec::index(&arguments, 0);
            let encoded = ByteBuf::new();
            ByteBuf::write_u32_le(
                &mut encoded,
                wrapping_convert_to_u32(count - usize_value(1))
            );
            process_interface_inputs(&arguments, 1, &mut encoded);
            write_file(move output_path, ByteBuf::finish(move encoded))
        }
    }
}

bool_code(value: Bool) -> u8 {
    handle move value { Result::Ok(_) => 1, Result::Err(_) => 0 }
}

usize_value(value: usize) -> usize { move value }

u8_value(value: u8) -> u8 { move value }

u16_value(value: u16) -> u16 { move value }

u64_value(value: u64) -> u64 { move value }
