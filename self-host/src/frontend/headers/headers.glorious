pub trait_count(value: &NominalIndex) -> usize { Vec::len(&value.traits.values) }
pub impl_count(value: &NominalIndex) -> usize { Vec::len(&value.impls.values) }
pub trait_at<'a>(value: &'a NominalIndex, index: usize) -> Option<&'a TraitHeader> {
    Vec::get(&value.traits.values, index)
}
pub impl_at<'a>(value: &'a NominalIndex, index: usize) -> Option<&'a ImplHeader> {
    Vec::get(&value.impls.values, index)
}
pub trait_name(value: &TraitHeader) -> Id<String> { value.name }
pub trait_public(value: &TraitHeader) -> Bool { value.public }
pub trait_generics(value: &TraitHeader) -> &HeaderRange { &value.generics }
pub trait_tokens(value: &TraitHeader) -> &HeaderTokenRange { &value.tokens }
pub impl_generics(value: &ImplHeader) -> &HeaderRange { &value.generics }
pub impl_trait_path(value: &ImplHeader) -> &HeaderRange { &value.trait_path }
pub impl_trait_path_count(value: &ImplHeader) -> u32 { value.trait_path.count }
pub impl_trait_path_name(value: &HeaderIndex, value_impl: &ImplHeader, index: usize) -> Id<String> {
    let ordinal = wrapping_convert_to_usize(value_impl.trait_path.start) + index;
    name_use_name(Vec::index(&value.names, ordinal))
}
pub impl_self_type(value: &ImplHeader) -> TypeId { value.self_ty }
pub impl_where_clause(value: &ImplHeader) -> &Option<WhereClause> { &value.where_clause }
pub impl_tokens(value: &ImplHeader) -> &HeaderTokenRange { &value.tokens }

pub drop_generics(value: &DropHeader) -> &HeaderRange { &value.generics }
pub drop_tokens(value: &DropHeader) -> &HeaderTokenRange { &value.tokens }
pub drop_target(value: &DropHeader) -> TypeId { value.target }
pub drop_where_clause(value: &DropHeader) -> &Option<WhereClause> { &value.where_clause }
pub drop_where_tokens(value: &DropHeader) -> &HeaderTokenRange { &value.where_tokens }

pub use_generics(value: &UseHeader) -> &HeaderRange { &value.generics }
pub use_tokens(value: &UseHeader) -> &HeaderTokenRange { &value.tokens }
pub use_lower(value: &UseHeader) -> usize { value.lower }
pub use_upper(value: &UseHeader) -> Option<usize> { value.upper }
pub use_target(value: &UseHeader) -> TypeId { value.target }
pub use_where_clause(value: &UseHeader) -> &Option<WhereClause> { &value.where_clause }
pub use_where_tokens(value: &UseHeader) -> &HeaderTokenRange { &value.where_tokens }
pub drop_count(value: &NominalIndex) -> usize { Vec::len(&value.drops.values) }
pub use_count(value: &NominalIndex) -> usize { Vec::len(&value.uses.values) }

pub effect_operation_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a EffectOperationHeader> {
    Vec::get(&value.effect_operations.values, index)
}

pub effect_operation_id_at(
    owner: &EffectHeader,
    ordinal: usize
) -> EffectOperationHeaderId {
    typed_header_id(
        wrapping_convert_to_usize(owner.operations.start) + ordinal
    )
}

pub effect_operation_by_id<'a>(
    value: &'a NominalIndex,
    id: EffectOperationHeaderId
) -> Option<&'a EffectOperationHeader> {
    Vec::get(&value.effect_operations.values, Id::to_usize(id))
}

pub variant_for_enum(
    value: &NominalIndex,
    owner: EnumHeaderId,
    name: Id<String>
) -> Option<VariantHeaderId> {
    handle HashMap::get(
        &value.definitions.enum_members,
        &(owner, name)
    ) {
        Result::Err(_) => None,
        Result::Ok(found) => Option::Some(*found)
    }
}

pub fixity_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a FixityHeader> {
    Vec::get(&value.fixities.values, index)
}

pub fixity_search(
    value: &NominalIndex,
    owner: Option<ShellId>,
    name: Id<String>,
    prefix: Bool
) -> Option<FixitySearch> {
    let key = (owner, name, prefix);
    handle HashMap::get(&value.definitions.fixities, &key) {
        Result::Err(_) => None,
        Result::Ok(found) => Option::Some(FixitySearch {
            selected: found.selected,
            conflict: found.conflict
        })
    }
}

pub fixity_search_selected(value: &FixitySearch) -> FixityHeaderId {
    value.selected
}

pub fixity_search_conflict(
    value: &FixitySearch
) -> Option<FixityHeaderId> {
    value.conflict
}

pub fixity_form_at(value: &NominalIndex, index: usize) -> u8 {
    let found = Vec::index(&value.fixities.values, index);
    found.form
}

pub fixity_precedence_at(value: &NominalIndex, index: usize) -> u8 {
    let found = Vec::index(&value.fixities.values, index);
    found.precedence
}

pub fixity_operator_start_at(value: &NominalIndex, index: usize) -> usize {
