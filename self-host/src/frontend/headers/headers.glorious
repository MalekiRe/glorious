// Declaration interfaces parsed from scanner-owned token spans.
// Type syntax and nominal source order have one semantic representation each;
// numeric codes are derived only at the remaining internal adapter boundary.

use super::lexer::TokenKind;
use super::scanner::{DeclarationKind, ShellId};
use super::syntax::{IdRange, TokenCursor, TokenSpan};

pub struct TypeTag {}
pub type TypeId = Id<TypeTag>;

// Header arenas now share the generic contiguous range representation. The
// aliases retain domain names for readability without duplicating storage.
pub struct HeaderRangeTag {}
pub type HeaderRange = IdRange<HeaderRangeTag>;
pub type NameUseRange = HeaderRange;
pub type TypeEdgeRange = HeaderRange;
pub type GenericParamRange = HeaderRange;
pub type ParameterRange = HeaderRange;
pub type FieldRange = HeaderRange;
pub type VariantRange = HeaderRange;
pub type HeaderTokenRange = TokenSpan;

pub struct NameUse { name: Id<String>, token: usize }
pub struct TypeEdge { value: TypeId, position: u32 }

pub enum HeaderTypeKind {
    Path(NameUseRange),
    SharedReference(Option<NameUse>, TypeId),
    UniqueReference(Option<NameUse>, TypeId),
    Tuple(TypeEdgeRange),
    Application(TypeId, TypeEdgeRange),
    Never
}

impl Use<[0, *]> for HeaderTypeKind {}

struct TypeNode {
    tokens: TokenSpan,
    kind: HeaderTypeKind
}

pub enum HeaderTypeView<'a> {
    Path(usize, Slice<'a, NameUse>),
    SharedReference(usize, Option<usize>, TypeId),
    UniqueReference(usize, Option<usize>, TypeId),
    Tuple(usize, Slice<'a, TypeEdge>),
    Application(usize, TypeId, Slice<'a, TypeEdge>),
    Never(usize)
}

impl<'a> Use<[0, *]> for HeaderTypeView<'a> {}

pub enum GenericParamKind {
    Type,
    Lifetime,
    EffectRow
}

impl Use<[0, *]> for GenericParamKind {}

pub struct GenericParam {
    name: Id<String>,
    kind: GenericParamKind,
    tokens: TokenSpan
}

pub struct Parameter {
    name: Id<String>,
    name_token: usize,
    ty: TypeId
}

pub struct EffectRow {
    effects: TypeEdgeRange,
    row_tail: Option<NameUse>,
    tokens: TokenSpan
}

pub struct CallableHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: GenericParamRange,
    parameters: ParameterRange,
    result: Option<TypeId>,
    effects: Option<EffectRow>,
    tokens: TokenSpan
}

pub struct TypeAliasHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: GenericParamRange,
    target: TypeId,
    tokens: TokenSpan
}

pub struct FieldHeader {
    name: Id<String>,
    name_token: usize,
    private: Bool,
    ty: TypeId
}

pub struct StructHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: GenericParamRange,
    fields: FieldRange,
    tokens: TokenSpan
}

pub struct VariantHeader {
    name: Id<String>,
    name_token: usize,
    fields: TypeEdgeRange
}

pub struct EnumHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: GenericParamRange,
    variants: VariantRange,
    tokens: TokenSpan
}

pub struct FixityHeader {
    shell: ShellId,
    public: Bool,
    form: u8,
    precedence: u8,
    operator: TokenSpan,
    tokens: TokenSpan
}

pub enum NominalHeader {
    Alias(u32),
    Fixity(u32),
    Struct(u32),
    Enum(u32),
    Callable(u32)
}

impl Use<[0, *]> for NominalHeader {}

struct AliasArena { values: Vec<TypeAliasHeader> }
struct StructArena { values: Vec<StructHeader> }
struct FieldArena { values: Vec<FieldHeader> }
struct EnumArena { values: Vec<EnumHeader> }
struct VariantArena { values: Vec<VariantHeader> }
struct FixityArena { values: Vec<FixityHeader> }

pub struct HeaderIndex {
    callables: Vec<CallableHeader>,
    generic_params: Vec<GenericParam>,
    parameters: Vec<Parameter>,
    types: Arena<TypeTag, TypeNode>,
    names: Vec<NameUse>,
    type_edges: Vec<TypeEdge>
}

pub struct NominalIndex {
    order: Vec<NominalHeader>,
    aliases: AliasArena,
    structs: StructArena,
    fields: FieldArena,
    enums: EnumArena,
    variants: VariantArena,
    fixities: FixityArena
}

pub struct ParsedHeaders {
    source: super::lexer::LexedSource,
    index: HeaderIndex,
    nominal: NominalIndex
}

pub enum HeaderError {
    ExpectedIdentifier(usize, usize),
    ExpectedLeftParenthesis(usize, usize),
    ExpectedRightParenthesis(usize, usize),
    ExpectedRightAngle(usize, usize),
    EmptyTypeArguments(usize, usize),
    EmptyGenericParameters(usize, usize),
    UnsupportedGenericParameterKind(usize, usize),
    ExpectedColon(usize, usize),
    ExpectedRightBrace(usize, usize),
    ExpectedSemicolon(usize, usize),
    UnexpectedTrailingHeaderToken(usize, usize),
    ExpectedEquals(usize, usize),
    ExpectedIntegerPrecedence(usize, usize),
    PrecedenceOutOfRange(usize, usize),
    ExpectedOperator(usize, usize),
    InvalidFixityForm(usize, usize),
    TypeArenaExhausted(usize, usize)
}

struct Parser {
    source: super::lexer::LexedSource,
    cursor: TokenCursor,
    output: HeaderIndex
}

pub range_start(value: &HeaderRange) -> u32 {
    super::syntax::id_range_start(value)
}

pub range_count(value: &HeaderRange) -> u32 {
    super::syntax::id_range_count(value)
}

pub callable_count(value: &HeaderIndex) -> usize { Vec::len(&value.callables) }
pub header_count(value: &NominalIndex) -> usize { Vec::len(&value.order) }
pub nominal_header_at(value: &NominalIndex, index: usize) -> NominalHeader {
    *Vec::index(&value.order, index)
}

// These two adapters keep untouched semantic consumers source-compatible while
// the stored representation remains a single enum rather than parallel arrays.
pub header_kind(value: &NominalIndex, index: usize) -> u8 {
    handle nominal_header_at(value, index) {
        NominalHeader::Alias(_) => 3,
        NominalHeader::Fixity(_) => 6,
        NominalHeader::Struct(_) => 8,
        NominalHeader::Enum(_) => 9,
        NominalHeader::Callable(_) => 12
    }
}

pub header_index(value: &NominalIndex, index: usize) -> u32 {
    handle nominal_header_at(value, index) {
        NominalHeader::Alias(found) => found,
        NominalHeader::Fixity(found) => found,
        NominalHeader::Struct(found) => found,
        NominalHeader::Enum(found) => found,
        NominalHeader::Callable(found) => found
    }
}

pub alias_count(value: &NominalIndex) -> usize { Vec::len(&value.aliases.values) }
pub struct_count(value: &NominalIndex) -> usize { Vec::len(&value.structs.values) }
pub field_count(value: &NominalIndex) -> usize { Vec::len(&value.fields.values) }
pub enum_count(value: &NominalIndex) -> usize { Vec::len(&value.enums.values) }
pub variant_count(value: &NominalIndex) -> usize { Vec::len(&value.variants.values) }
pub fixity_count(value: &NominalIndex) -> usize { Vec::len(&value.fixities.values) }
pub type_count(value: &HeaderIndex) -> usize { Arena::len(&value.types) }
pub parameter_count(value: &HeaderIndex) -> usize { Vec::len(&value.parameters) }
pub generic_param_count(value: &HeaderIndex) -> usize {
    Vec::len(&value.generic_params)
}

pub callable_at<'a>(value: &'a HeaderIndex, index: usize) -> Option<&'a CallableHeader> {
    Vec::get(&value.callables, index)
}
pub alias_at<'a>(value: &'a NominalIndex, index: usize) -> Option<&'a TypeAliasHeader> {
    Vec::get(&value.aliases.values, index)
}
pub struct_at<'a>(value: &'a NominalIndex, index: usize) -> Option<&'a StructHeader> {
    Vec::get(&value.structs.values, index)
}
pub field_at<'a>(value: &'a NominalIndex, index: usize) -> Option<&'a FieldHeader> {
    Vec::get(&value.fields.values, index)
}
pub enum_at<'a>(value: &'a NominalIndex, index: usize) -> Option<&'a EnumHeader> {
    Vec::get(&value.enums.values, index)
}
pub variant_at<'a>(value: &'a NominalIndex, index: usize) -> Option<&'a VariantHeader> {
    Vec::get(&value.variants.values, index)
}
pub fixity_at<'a>(value: &'a NominalIndex, index: usize) -> Option<&'a FixityHeader> {
    Vec::get(&value.fixities.values, index)
}

pub parsed_source(value: &ParsedHeaders) -> &super::lexer::LexedSource { &value.source }
pub parsed_index(value: &ParsedHeaders) -> &HeaderIndex { &value.index }
pub nominal_index(value: &ParsedHeaders) -> &NominalIndex { &value.nominal }

pub callable_shell(value: &CallableHeader) -> ShellId { value.shell }
pub callable_name_raw(value: &CallableHeader) -> u32 { Id::to_u32(value.name) }
pub callable_parameters(value: &CallableHeader) -> &ParameterRange { &value.parameters }
pub callable_generic_count(value: &CallableHeader) -> u32 {
    range_count(&value.generics)
}
pub callable_has_effects(value: &CallableHeader) -> Bool {
    Option::is_some(&value.effects)
}
pub callable_result(value: &CallableHeader) -> Option<TypeId> { value.result }

pub parameter_at<'a>(value: &'a HeaderIndex, index: usize) -> Option<&'a Parameter> {
    Vec::get(&value.parameters, index)
}
pub parameter_name_raw(value: &Parameter) -> u32 { Id::to_u32(value.name) }
pub parameter_name_token(value: &Parameter) -> usize { value.name_token }
pub parameter_type(value: &Parameter) -> TypeId { value.ty }

pub name_use_name(value: &NameUse) -> Id<String> { value.name }
pub name_use_token(value: &NameUse) -> usize { value.token }
pub type_edge_type(value: &TypeEdge) -> TypeId { value.value }

pub token_range_start(value: &TokenSpan) -> usize {
    super::syntax::token_start(value)
}
pub token_range_end(value: &TokenSpan) -> usize {
    super::syntax::token_end(value)
}

pub fixity_shell(value: &FixityHeader) -> ShellId { value.shell }
pub fixity_form_code(value: &FixityHeader) -> u8 { value.form }
pub fixity_precedence(value: &FixityHeader) -> u8 { value.precedence }
pub fixity_operator_start(value: &FixityHeader) -> usize {
    token_range_start(&value.operator)
}
pub fixity_operator_end(value: &FixityHeader) -> usize {
    token_range_end(&value.operator)
}
pub fixity_form_at(value: &NominalIndex, index: usize) -> u8 {
    Vec::index(&value.fixities.values, index).form
}
pub fixity_precedence_at(value: &NominalIndex, index: usize) -> u8 {
    Vec::index(&value.fixities.values, index).precedence
}
pub fixity_operator_start_at(value: &NominalIndex, index: usize) -> usize {
    fixity_operator_start(Vec::index(&value.fixities.values, index))
}

pub alias_generics(value: &TypeAliasHeader) -> &GenericParamRange { &value.generics }
pub alias_shell(value: &TypeAliasHeader) -> ShellId { value.shell }
pub alias_name_raw(value: &TypeAliasHeader) -> u32 { Id::to_u32(value.name) }
pub alias_target(value: &TypeAliasHeader) -> &TypeId { &value.target }

pub struct_shell(value: &StructHeader) -> ShellId { value.shell }
pub struct_name_raw(value: &StructHeader) -> u32 { Id::to_u32(value.name) }
pub struct_is_public(value: &StructHeader) -> Bool { value.public }
pub struct_generics(value: &StructHeader) -> &GenericParamRange { &value.generics }
pub struct_fields(value: &StructHeader) -> &FieldRange { &value.fields }

pub field_name_raw(value: &FieldHeader) -> u32 { Id::to_u32(value.name) }
pub field_name_token(value: &FieldHeader) -> usize { value.name_token }
pub field_type(value: &FieldHeader) -> &TypeId { &value.ty }
pub field_is_private(value: &FieldHeader) -> Bool { value.private }

pub enum_shell(value: &EnumHeader) -> ShellId { value.shell }
pub enum_name_raw(value: &EnumHeader) -> u32 { Id::to_u32(value.name) }
pub enum_is_public(value: &EnumHeader) -> Bool { value.public }
pub enum_generics(value: &EnumHeader) -> &GenericParamRange { &value.generics }
pub enum_variants(value: &EnumHeader) -> &VariantRange { &value.variants }
pub variant_name_raw(value: &VariantHeader) -> u32 { Id::to_u32(value.name) }
pub variant_name_token(value: &VariantHeader) -> usize { value.name_token }

pub variant_payloads<'a>(
    value: &'a HeaderIndex,
    variant: &VariantHeader
) -> Slice<'a, TypeEdge> {
    super::syntax::id_range_slice(&value.type_edges, &variant.fields)
}

pub header_type_view<'a>(
    value: &'a HeaderIndex,
    id: TypeId
) -> HeaderTypeView<'a> {
    let node = Arena::index(&value.types, id);
    let token = token_range_start(&node.tokens);
    handle node.kind {
        HeaderTypeKind::Path(range) => HeaderTypeView::Path(
            token,
            super::syntax::id_range_slice(&value.names, &range)
        ),
        HeaderTypeKind::SharedReference(lifetime, referent) =>
            HeaderTypeView::SharedReference(
                token,
                handle lifetime {
                    None => None,
                    Option::Some(found) => Option::Some(found.token)
                },
                referent
            ),
        HeaderTypeKind::UniqueReference(lifetime, referent) =>
            HeaderTypeView::UniqueReference(
                token,
                handle lifetime {
                    None => None,
                    Option::Some(found) => Option::Some(found.token)
                },
                referent
            ),
        HeaderTypeKind::Tuple(range) => HeaderTypeView::Tuple(
            token,
            super::syntax::id_range_slice(&value.type_edges, &range)
        ),
        HeaderTypeKind::Application(constructor, range) =>
            HeaderTypeView::Application(
                token,
                constructor,
                super::syntax::id_range_slice(&value.type_edges, &range)
            ),
        HeaderTypeKind::Never => HeaderTypeView::Never(token)
    }
}

pub error_code(value: &HeaderError) -> u8 {
    handle *value {
        HeaderError::ExpectedIdentifier(_, _) => 1,
        HeaderError::ExpectedLeftParenthesis(_, _) => 2,
        HeaderError::ExpectedRightParenthesis(_, _) => 3,
        HeaderError::ExpectedRightAngle(_, _) => 4,
        HeaderError::EmptyTypeArguments(_, _) => 5,
        HeaderError::EmptyGenericParameters(_, _) => 5,
        HeaderError::UnsupportedGenericParameterKind(_, _) => 6,
        HeaderError::ExpectedColon(_, _) => 7,
        HeaderError::ExpectedRightBrace(_, _) => 8,
        HeaderError::ExpectedSemicolon(_, _) => 8,
        HeaderError::UnexpectedTrailingHeaderToken(_, _) => 9,
        HeaderError::ExpectedEquals(_, _) => 10,
        HeaderError::ExpectedIntegerPrecedence(_, _) => 11,
        HeaderError::PrecedenceOutOfRange(_, _) => 11,
        HeaderError::ExpectedOperator(_, _) => 12,
        HeaderError::InvalidFixityForm(_, _) => 13,
        HeaderError::TypeArenaExhausted(_, _) => 14
    }
}

pub error_token(value: &HeaderError) -> usize {
    handle *value {
        HeaderError::ExpectedIdentifier(token, _) => token,
        HeaderError::ExpectedLeftParenthesis(token, _) => token,
        HeaderError::ExpectedRightParenthesis(token, _) => token,
        HeaderError::ExpectedRightAngle(token, _) => token,
        HeaderError::EmptyTypeArguments(token, _) => token,
        HeaderError::EmptyGenericParameters(token, _) => token,
        HeaderError::UnsupportedGenericParameterKind(token, _) => token,
        HeaderError::ExpectedColon(token, _) => token,
        HeaderError::ExpectedRightBrace(token, _) => token,
        HeaderError::ExpectedSemicolon(token, _) => token,
        HeaderError::UnexpectedTrailingHeaderToken(token, _) => token,
        HeaderError::ExpectedEquals(token, _) => token,
        HeaderError::ExpectedIntegerPrecedence(token, _) => token,
        HeaderError::PrecedenceOutOfRange(token, _) => token,
        HeaderError::ExpectedOperator(token, _) => token,
        HeaderError::InvalidFixityForm(token, _) => token,
        HeaderError::TypeArenaExhausted(token, _) => token
    }
}

pub error_related(value: &HeaderError) -> usize {
    handle *value {
        HeaderError::ExpectedIdentifier(_, related) => related,
        HeaderError::ExpectedLeftParenthesis(_, related) => related,
        HeaderError::ExpectedRightParenthesis(_, related) => related,
        HeaderError::ExpectedRightAngle(_, related) => related,
        HeaderError::EmptyTypeArguments(_, related) => related,
        HeaderError::EmptyGenericParameters(_, related) => related,
        HeaderError::UnsupportedGenericParameterKind(_, related) => related,
        HeaderError::ExpectedColon(_, related) => related,
        HeaderError::ExpectedRightBrace(_, related) => related,
        HeaderError::ExpectedSemicolon(_, related) => related,
        HeaderError::UnexpectedTrailingHeaderToken(_, related) => related,
        HeaderError::ExpectedEquals(_, related) => related,
        HeaderError::ExpectedIntegerPrecedence(_, related) => related,
        HeaderError::PrecedenceOutOfRange(_, related) => related,
        HeaderError::ExpectedOperator(_, related) => related,
        HeaderError::InvalidFixityForm(_, related) => related,
        HeaderError::TypeArenaExhausted(_, related) => related
    }
}

position(value: &Parser) -> usize {
    super::syntax::cursor_position(&value.cursor)
}

limit(value: &Parser) -> usize {
    super::syntax::cursor_limit(&value.cursor)
}

reset(value: &mut Parser, start: usize, end: usize) {
    super::syntax::cursor_reset(&mut value.cursor, start, end)
}

set_position(value: &mut Parser, at: usize) {
    super::syntax::cursor_set(&mut value.cursor, at)
}

advance(value: &mut Parser) {
    let next = position(&*value) + 1;
    set_position(value, next)
}

token_code(value: &Parser, index: usize) -> u16 {
    super::lexer::token_code_at(&value.source, index)
}

at_code(value: &Parser, code: u16) -> Bool {
    super::syntax::cursor_at_code(&value.cursor, &value.source, code)
}

eat_code(value: &mut Parser, code: u16) -> Bool {
    super::syntax::cursor_eat_code(&mut value.cursor, &value.source, code)
}

expect_code(
    value: &mut Parser,
    code: u16,
    related: usize,
    kind: u8
) -> Result<(), HeaderError> {
    let token = position(value);
    if(eat_code(value, code)) {
        Result::Ok(())
    } else {
        Result::Err(handle kind {
            1 => HeaderError::ExpectedLeftParenthesis(token, related),
            2 => HeaderError::ExpectedRightParenthesis(token, related),
            3 => HeaderError::ExpectedRightAngle(token, related),
            4 => HeaderError::ExpectedColon(token, related),
            5 => HeaderError::ExpectedRightBrace(token, related),
            6 => HeaderError::ExpectedSemicolon(token, related),
            _ => HeaderError::ExpectedEquals(token, related)
        })
    }
}

ident(value: &mut Parser, related: usize) -> Result<NameUse, HeaderError> {
    let token = position(value);
    if(token < limit(value)) {
        handle super::lexer::token_kind_at(&value.source, token) {
            TokenKind::Ident(name) => {
                set_position(value, token + 1);
                Result::Ok(NameUse { name: name, token: token })
            },
            _ => Result::Err(HeaderError::ExpectedIdentifier(token, related))
        }
    } else {
        Result::Err(HeaderError::ExpectedIdentifier(token, related))
    }
}

at_ident(value: &Parser, expected: &String) -> Bool {
    let token = position(value);
    if(token < limit(value)) {
        handle super::lexer::token_kind_at(&value.source, token) {
            TokenKind::Ident(name) => handle super::lexer::lexeme(&value.source, name) {
                Result::Err(_) => false,
                Result::Ok(found) => *found == *expected
            },
            _ => false
        }
    } else { false }
}

next_is_ident(value: &Parser) -> Bool {
    let next = position(value) + 1;
    next < limit(value) and { token_code(value, next) == 1 }
}

push_type(
    value: &mut Parser,
    kind: HeaderTypeKind,
    start: usize,
    related: usize
) -> Result<TypeId, HeaderError> {
    let node = TypeNode {
        tokens: super::syntax::token_span(start, position(value)),
        kind: kind
    };
    handle Arena::alloc(&mut value.output.types, node) {
        Result::Err(_) => Result::Err(
            HeaderError::TypeArenaExhausted(start, related)
        ),
        Result::Ok(id) => Result::Ok(id)
    }
}

append_edges(
    output: &mut Vec<TypeEdge>,
    values: &Vec<TypeId>,
    index: usize,
    position_start: u32
) {
    for_range(Range::new(index, Vec::len(values)), { current =>
        Vec::push(output, TypeEdge {
            value: *Vec::index(values, current),
            position: position_start + wrapping_convert_to_u32(current - index)
        })
    })
}

parse_type_values(
    value: &mut Parser,
    closing_code: u16,
    related: usize,
    values: &mut Vec<TypeId>
) -> Result<(), HeaderError> {
    if(at_code(&*value, closing_code)) {
        Result::Ok(())
    } else {
        let found = try(parse_type(value, related), @parse_type_values);
        Vec::push(values, found);
        if(eat_code(value, 17) and { not(at_code(&*value, closing_code)) }) {
            parse_type_values(value, closing_code, related, values)
        } else { Result::Ok(()) }
    }
}

parse_path(value: &mut Parser, related: usize) -> Result<TypeId, HeaderError> {
    let start = position(value);
    let name_start = Vec::len(&value.output.names);
    let name = try(ident(value, related), @parse_path);
    Vec::push(&mut value.output.names, name);
    parse_path_tail(value, related, start, name_start)
}

parse_path_tail(
    value: &mut Parser,
    related: usize,
    start: usize,
    name_start: usize
) -> Result<TypeId, HeaderError> {
    if(eat_code(value, 19)) {
        let name = try(ident(value, related), @parse_path_tail);
        Vec::push(&mut value.output.names, name);
        parse_path_tail(value, related, start, name_start)
    } else {
        let name_end = Vec::len(&value.output.names);
        let names = super::syntax::id_range(name_start, name_end);
        let path = try(push_type(
            value,
            HeaderTypeKind::Path(names),
            start,
            related
        ), @parse_path_tail);
        parse_application(value, related, start, path)
    }
}

parse_application(
    value: &mut Parser,
    related: usize,
    start: usize,
    constructor: TypeId
) -> Result<TypeId, HeaderError> {
    if(eat_code(value, 34)) {
        if(at_code(&*value, 36)) {
            Result::Err(HeaderError::EmptyTypeArguments(position(value), related))
        } else {
            let arguments = Vec::new();
            try(parse_type_values(value, 36, related, &mut arguments), @parse_application);
            try(expect_code(value, 36, related, 3), @parse_application);
            let edge_start = Vec::len(&value.output.type_edges);
            append_edges(&mut value.output.type_edges, &arguments, 0, 0);
            let edge_end = Vec::len(&value.output.type_edges);
            let argument_range = super::syntax::id_range(edge_start, edge_end);
            push_type(
                value,
                HeaderTypeKind::Application(constructor, argument_range),
                start,
                related
            )
        }
    } else { Result::Ok(constructor) }
}

take_lifetime(value: &mut Parser) -> Option<NameUse> {
    let token = position(value);
    if(token < limit(value)) {
        handle super::lexer::token_kind_at(&value.source, token) {
            TokenKind::Lifetime(name) => {
                set_position(value, token + 1);
                Option::Some(NameUse { name: name, token: token })
            },
            _ => None
        }
    } else { None }
}

parse_reference(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<TypeId, HeaderError> {
    let lifetime = take_lifetime(value);
    let unique = at_ident(&*value, &"mut");
    if(unique) { advance(value) } else { () };
    let referent = try(parse_type(value, related), @parse_reference);
    push_type(
        value,
        if(unique) {
            HeaderTypeKind::UniqueReference(lifetime, referent)
        } else {
            HeaderTypeKind::SharedReference(lifetime, referent)
        },
        start,
        related
    )
}

finish_tuple(
    value: &mut Parser,
    start: usize,
    related: usize,
    elements: Vec<TypeId>
) -> Result<TypeId, HeaderError> {
    let edge_start = Vec::len(&value.output.type_edges);
    append_edges(&mut value.output.type_edges, &elements, 0, 0);
    let edge_end = Vec::len(&value.output.type_edges);
    let element_range = super::syntax::id_range(edge_start, edge_end);
    push_type(
        value,
        HeaderTypeKind::Tuple(element_range),
        start,
        related
    )
}

parse_tuple(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<TypeId, HeaderError> {
    if(eat_code(value, 12)) {
        finish_tuple(value, start, related, Vec::new())
    } else {
        let first = try(parse_type(value, related), @parse_tuple);
        if(eat_code(value, 17)) {
            let elements = Vec::new();
            Vec::push(&mut elements, first);
            try(parse_type_values(value, 12, related, &mut elements), @parse_tuple);
            try(expect_code(value, 12, related, 2), @parse_tuple);
            finish_tuple(value, start, related, elements)
        } else {
            try(expect_code(value, 12, related, 2), @parse_tuple);
            Result::Ok(first)
        }
    }
}

parse_type(value: &mut Parser, related: usize) -> Result<TypeId, HeaderError> {
    let start = position(value);
    if(eat_code(value, 38)) {
        parse_reference(value, related, start)
    } else if(eat_code(value, 11)) {
        parse_tuple(value, related, start)
    } else if(eat_code(value, 39)) {
        push_type(value, HeaderTypeKind::Never, start, related)
    } else {
        parse_path(value, related)
    }
}

parse_generics(value: &mut Parser, related: usize) -> Result<GenericParamRange, HeaderError> {
    let start = Vec::len(&value.output.generic_params);
    if(eat_code(value, 34)) {
        parse_generic_items(value, related, start)
    } else {
        Result::Ok(super::syntax::id_range(start, start))
    }
}

parse_generic_items(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<GenericParamRange, HeaderError> {
    if(at_code(&*value, 36)) {
        Result::Err(HeaderError::EmptyGenericParameters(position(value), related))
    } else {
        let parameter = try(
            parse_one_generic(value, related),
            @parse_generic_items
        );
        Vec::push(&mut value.output.generic_params, parameter);
        if(eat_code(value, 17) and { not(at_code(&*value, 36)) }) {
            parse_generic_items(value, related, start)
        } else {
            try(expect_code(value, 36, related, 3), @parse_generic_items);
            Result::Ok(super::syntax::id_range(
                start,
                Vec::len(&value.output.generic_params)
            ))
        }
    }
}

parse_one_generic(value: &mut Parser, related: usize) -> Result<GenericParam, HeaderError> {
    let token = position(value);
    handle super::lexer::token_kind_at(&value.source, token) {
        TokenKind::Lifetime(name) => {
            set_position(value, token + 1);
            Result::Ok(GenericParam {
                name: name,
                kind: GenericParamKind::Lifetime,
                tokens: super::syntax::token_span(token, position(value))
            })
        },
        _ => {
            let name = try(ident(value, related), @parse_one_generic);
            let kind = if(eat_code(value, 18)) {
                if(at_ident(&*value, &"EffectRow")) {
                    advance(value);
                    GenericParamKind::EffectRow
                } else {
                    @parse_one_generic(Result::Err(
                        HeaderError::UnsupportedGenericParameterKind(
                            position(value),
                            related
                        )
                    ))
                }
            } else { GenericParamKind::Type };
            Result::Ok(GenericParam {
                name: name.name,
                kind: kind,
                tokens: super::syntax::token_span(token, position(value))
            })
        }
    }
}

parse_parameters(value: &mut Parser, related: usize) -> Result<ParameterRange, HeaderError> {
    let start = Vec::len(&value.output.parameters);
    if(at_code(&*value, 12)) {
        Result::Ok(super::syntax::id_range(start, start))
    } else {
        parse_parameter_items(value, related, start)
    }
}

parse_parameter_items(
    value: &mut Parser,
    related: usize,
    start: usize
) -> Result<ParameterRange, HeaderError> {
    let name = try(ident(value, related), @parse_parameter_items);
    try(expect_code(value, 18, related, 4), @parse_parameter_items);
    let ty = try(parse_type(value, related), @parse_parameter_items);
    Vec::push(&mut value.output.parameters, Parameter {
        name: name.name,
        name_token: name.token,
        ty: ty
    });
    if(eat_code(value, 17) and { not(at_code(&*value, 12)) }) {
        parse_parameter_items(value, related, start)
    } else {
        Result::Ok(super::syntax::id_range(
            start,
            Vec::len(&value.output.parameters)
        ))
    }
}

finish_effects(
    value: &mut Parser,
    start: usize,
    effects: Vec<TypeId>,
    row_tail: Option<NameUse>
) -> EffectRow {
    let edge_start = Vec::len(&value.output.type_edges);
    append_edges(&mut value.output.type_edges, &effects, 0, 0);
    EffectRow {
        effects: super::syntax::id_range(
            edge_start,
            Vec::len(&value.output.type_edges)
        ),
        row_tail: row_tail,
        tokens: super::syntax::token_span(start, position(value))
    }
}

parse_effect_items(
    value: &mut Parser,
    related: usize,
    start: usize,
    effects: Vec<TypeId>
) -> Result<EffectRow, HeaderError> {
    if(eat_code(value, 30)) {
        let row_tail = try(ident(value, related), @parse_effect_items);
        try(expect_code(value, 14, related, 5), @parse_effect_items);
        Result::Ok(finish_effects(value, start, effects, Option::Some(row_tail)))
    } else if(eat_code(value, 14)) {
        Result::Ok(finish_effects(value, start, effects, None))
    } else {
        let next = effects;
        let effect = try(parse_type(value, related), @parse_effect_items);
        Vec::push(&mut next, effect);
        eat_code(value, 17);
        parse_effect_items(value, related, start, next)
    }
}

parse_effect_row(value: &mut Parser, related: usize) -> Result<EffectRow, HeaderError> {
    let start = position(value);
    if(eat_code(value, 13)) {
        parse_effect_items(value, related, start, Vec::new())
    } else {
        let effects = Vec::new();
        let effect = try(parse_type(value, related), @parse_effect_row);
        Vec::push(&mut effects, effect);
        Result::Ok(finish_effects(value, start, effects, None))
    }
}

finish_callable(
    value: &mut Parser,
    shell: ShellId,
    public: Bool,
    start: usize,
    name: NameUse,
    generics: GenericParamRange,
    parameters: ParameterRange,
    result: Option<TypeId>,
    effects: Option<EffectRow>
) -> Result<(), HeaderError> {
    if(position(value) == limit(value)) {
        let token_end = limit(&*value);
        let tokens = super::syntax::token_span(start, token_end);
        Vec::push(&mut value.output.callables, CallableHeader {
            shell: shell,
            name: name.name,
            public: public,
            generics: generics,
            parameters: parameters,
            result: result,
            effects: effects,
            tokens: tokens
        });
        Result::Ok(())
    } else {
        Result::Err(HeaderError::UnexpectedTrailingHeaderToken(
            position(value),
            start
        ))
    }
}

parse_callable(
    value: &mut Parser,
    shell: ShellId,
    public: Bool,
    start: usize
) -> Result<(), HeaderError> {
    set_position(value, if(public) { start + 1 } else { start });
    let name = try(ident(value, start), @parse_callable);
    let generics = try(parse_generics(value, start), @parse_callable);
    try(expect_code(value, 11, start, 1), @parse_callable);
    let parameters = try(parse_parameters(value, start), @parse_callable);
    try(expect_code(value, 12, start, 2), @parse_callable);
    let result = if(eat_code(value, 23) and { not(at_code(&*value, 25)) }) {
        Option::Some(try(parse_type(value, start), @parse_callable))
    } else { None };
    let effects = if(eat_code(value, 25)) {
        Option::Some(try(parse_effect_row(value, start), @parse_callable))
    } else { None };
    finish_callable(
        value,
        shell,
        public,
        start,
        name,
        generics,
        parameters,
        result,
        effects
    )
}

source_text(value: &String, start: usize, end: usize) -> String {
    handle String::slice(value, Range { start: start, end: end }) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

fixity_form(value: &Parser) -> u8 {
    if(at_ident(value, &"prefix")) { 1 }
    else if(at_ident(value, &"infixl")) { 2 }
    else if(at_ident(value, &"infixr")) { 3 }
    else if(at_ident(value, &"infix")) { 4 }
    else { 0 }
}

integer_number(value: &super::lexer::NumberToken) -> Bool {
    Option::is_none(super::lexer::number_fraction(value))
        and { Option::is_none(super::lexer::number_exponent(value)) }
}

parse_precedence(
    original: &String,
    value: &mut Parser,
    related: usize
) -> Result<u8, HeaderError> {
    let token = position(value);
    handle super::lexer::token_kind_at(&value.source, token) {
        super::lexer::TokenKind::Number(number) => if(integer_number(&number)) {
            let spelling = super::lexer::number_spelling(&number);
            let text = source_text(
                original,
                super::lexer::span_start(&spelling),
                super::lexer::span_end(&spelling)
            );
            handle parse_u64(&text) {
                Result::Err(_) => Result::Err(
                    HeaderError::PrecedenceOutOfRange(token, related)
                ),
                Result::Ok(found) => if(found <= 255) {
                    set_position(value, token + 1);
                    Result::Ok(wrapping_convert_to_u8(found))
                } else {
                    Result::Err(HeaderError::PrecedenceOutOfRange(token, related))
                }
            }
        } else {
            Result::Err(HeaderError::ExpectedIntegerPrecedence(token, related))
        },
        _ => Result::Err(HeaderError::ExpectedIntegerPrecedence(token, related))
    }
}

token_span_at(value: &Parser, index: usize) -> super::lexer::Span {
    handle super::lexer::token_at(&value.source, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::lexer::token_span(token)
    }
}

take_operator(value: &mut Parser, related: usize) -> Result<TokenSpan, HeaderError> {
    let start = position(value);
    if(start < limit(value)) {
        if(token_code(value, start) == 1) {
            set_position(value, start + 1);
            Result::Ok(super::syntax::token_span(start, position(value)))
        } else if(super::lexer::operator_symbol_at(&value.source, start)) {
            let first = token_span_at(&*value, start);
            let end = super::lexer::operator_end(
                &value.source,
                start + 1,
                limit(value),
                super::lexer::span_end(&first)
            );
            set_position(value, end);
            Result::Ok(super::syntax::token_span(start, end))
        } else {
            Result::Err(HeaderError::ExpectedOperator(start, related))
        }
    } else {
        Result::Err(HeaderError::ExpectedOperator(start, related))
    }
}

record_header(value: &mut NominalIndex, header: NominalHeader) {
    Vec::push(&mut value.order, header)
}

parse_fixity(
    original: &String,
    value: &mut Parser,
    nominal: &mut NominalIndex,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    reset(value, start, whole_end);
    if(public) { advance(value) } else { () };
    let form = fixity_form(&*value);
    if(form == 0) {
        Result::Err(HeaderError::InvalidFixityForm(position(value), start))
    } else {
        advance(value);
        let precedence = try(parse_precedence(original, value, start), @parse_fixity);
        let operator = try(take_operator(value, start), @parse_fixity);
        try(expect_code(value, 22, start, 6), @parse_fixity);
        if(position(value) == limit(value)) {
            Vec::push(&mut nominal.fixities.values, FixityHeader {
                shell: shell,
                public: public,
                form: form,
                precedence: precedence,
                operator: operator,
                tokens: super::syntax::token_span(start, whole_end)
            });
            let ordinal = wrapping_convert_to_u32(
                Vec::len(&nominal.fixities.values) - 1
            );
            record_header(nominal, NominalHeader::Fixity(ordinal));
            Result::Ok(())
        } else {
            Result::Err(HeaderError::UnexpectedTrailingHeaderToken(
                position(value),
                start
            ))
        }
    }
}

parse_alias(
    value: &mut Parser,
    nominal: &mut NominalIndex,
    shell: ShellId,
    public: Bool,
    start: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    reset(value, start, whole_end - 1);
    if(public) { advance(value) } else { () };
    advance(value);
    let name = try(ident(value, start), @parse_alias);
    let generics = try(parse_generics(value, start), @parse_alias);
    try(expect_code(value, 31, start, 7), @parse_alias);
    let target = try(parse_type(value, start), @parse_alias);
    if(position(value) == limit(value)) {
        Vec::push(&mut nominal.aliases.values, TypeAliasHeader {
            shell: shell,
            name: name.name,
            public: public,
            generics: generics,
            target: target,
            tokens: super::syntax::token_span(start, whole_end)
        });
        let ordinal = wrapping_convert_to_u32(
            Vec::len(&nominal.aliases.values) - 1
        );
        record_header(nominal, NominalHeader::Alias(ordinal));
        Result::Ok(())
    } else {
        Result::Err(HeaderError::UnexpectedTrailingHeaderToken(
            position(value),
            start
        ))
    }
}

parse_fields(
    value: &mut Parser,
    fields: &mut FieldArena,
    related: usize
) -> Result<(), HeaderError> {
    if(position(value) < limit(value)) {
        let private = at_ident(&*value, &"private") and { next_is_ident(&*value) };
        if(private) { advance(value) } else { () };
        let name = try(ident(value, related), @parse_fields);
        try(expect_code(value, 18, related, 4), @parse_fields);
        let ty = try(parse_type(value, related), @parse_fields);
        Vec::push(&mut fields.values, FieldHeader {
            name: name.name,
            name_token: name.token,
            private: private,
            ty: ty
        });
        eat_code(value, 17);
        eat_code(value, 22);
        parse_fields(value, fields, related)
    } else { Result::Ok(()) }
}

parse_struct(
    value: &mut Parser,
    nominal: &mut NominalIndex,
    shell: ShellId,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    reset(value, start, header_end);
    if(public) { advance(value) } else { () };
    advance(value);
    let name = try(ident(value, start), @parse_struct);
    let generics = try(parse_generics(value, start), @parse_struct);
    if(position(value) == header_end) {
        reset(value, header_end + 1, whole_end - 1);
        let field_start = Vec::len(&nominal.fields.values);
        try(parse_fields(value, &mut nominal.fields, start), @parse_struct);
        let field_end = Vec::len(&nominal.fields.values);
        let field_range = super::syntax::id_range(field_start, field_end);
        Vec::push(&mut nominal.structs.values, StructHeader {
            shell: shell,
            name: name.name,
            public: public,
            generics: generics,
            fields: field_range,
            tokens: super::syntax::token_span(start, whole_end)
        });
        let ordinal = wrapping_convert_to_u32(
            Vec::len(&nominal.structs.values) - 1
        );
        record_header(nominal, NominalHeader::Struct(ordinal));
        Result::Ok(())
    } else {
        Result::Err(HeaderError::UnexpectedTrailingHeaderToken(
            position(value),
            start
        ))
    }
}

parse_variants(
    value: &mut Parser,
    variants: &mut VariantArena,
    related: usize
) -> Result<(), HeaderError> {
    if(position(value) < limit(value)) {
        let name = try(ident(value, related), @parse_variants);
        let fields = Vec::new();
        if(eat_code(value, 11)) {
            try(parse_type_values(value, 12, related, &mut fields), @parse_variants);
            try(expect_code(value, 12, related, 2), @parse_variants)
        } else { () };
        let edge_start = Vec::len(&value.output.type_edges);
        append_edges(&mut value.output.type_edges, &fields, 0, 0);
        let edge_end = Vec::len(&value.output.type_edges);
        let field_range = super::syntax::id_range(edge_start, edge_end);
        Vec::push(&mut variants.values, VariantHeader {
            name: name.name,
            name_token: name.token,
            fields: field_range
        });
        eat_code(value, 17);
        eat_code(value, 22);
        parse_variants(value, variants, related)
    } else { Result::Ok(()) }
}

parse_enum(
    value: &mut Parser,
    nominal: &mut NominalIndex,
    shell: ShellId,
    public: Bool,
    start: usize,
    header_end: usize,
    whole_end: usize
) -> Result<(), HeaderError> {
    reset(value, start, header_end);
    if(public) { advance(value) } else { () };
    advance(value);
    let name = try(ident(value, start), @parse_enum);
    let generics = try(parse_generics(value, start), @parse_enum);
    if(position(value) == header_end) {
        reset(value, header_end + 1, whole_end - 1);
        let variant_start = Vec::len(&nominal.variants.values);
        try(parse_variants(&mut *value, &mut nominal.variants, start), @parse_enum);
        let variant_end = Vec::len(&nominal.variants.values);
        let variant_range = super::syntax::id_range(variant_start, variant_end);
        Vec::push(&mut nominal.enums.values, EnumHeader {
            shell: shell,
            name: name.name,
            public: public,
            generics: generics,
            variants: variant_range,
            tokens: super::syntax::token_span(start, whole_end)
        });
        let ordinal = wrapping_convert_to_u32(
            Vec::len(&nominal.enums.values) - 1
        );
        record_header(nominal, NominalHeader::Enum(ordinal));
        Result::Ok(())
    } else {
        Result::Err(HeaderError::UnexpectedTrailingHeaderToken(
            position(value),
            start
        ))
    }
}

parse_shells(
    original: &String,
    declarations: &super::scanner::DeclarationIndex,
    index: usize,
    parser: Parser,
    nominal: NominalIndex
) -> Result<ParsedHeaders, HeaderError> {
    if(index < super::scanner::shell_count(declarations)) {
        let shell_id = handle super::scanner::shell_id_at_ordinal(declarations, index) {
            None => @parse_shells(Result::Ok(finish_parser(parser, nominal))),
            Option::Some(found) => found
        };
        handle super::scanner::shell_at(declarations, shell_id) {
            None => Result::Ok(finish_parser(parser, nominal)),
            Option::Some(shell) => {
                let header = super::scanner::shell_header(shell);
                let whole = super::scanner::shell_whole(shell);
                let start = super::syntax::token_start(header);
                let header_end = super::syntax::token_end(header);
                let whole_end = super::syntax::token_end(whole);
                let Parser { source, cursor: _, output } = parser;
                let next = Parser {
                    source: source,
                    cursor: super::syntax::cursor(start, header_end),
                    output: output
                };
                let parsed = handle super::scanner::shell_kind(shell) {
                    DeclarationKind::Function => {
                        let ordinal = Vec::len(&next.output.callables);
                        try(parse_callable(
                            &mut next,
                            shell_id,
                            super::scanner::shell_is_public(shell),
                            start
                        ), @parse_shells);
                        record_header(&mut nominal, NominalHeader::Callable(
                            wrapping_convert_to_u32(ordinal)
                        ));
                        Result::Ok(())
                    },
                    DeclarationKind::Fixity => parse_fixity(
                        original,
                        &mut next,
                        &mut nominal,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        whole_end
                    ),
                    DeclarationKind::TypeAlias => parse_alias(
                        &mut next,
                        &mut nominal,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        whole_end
                    ),
                    DeclarationKind::Struct => parse_struct(
                        &mut next,
                        &mut nominal,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        header_end,
                        whole_end
                    ),
                    DeclarationKind::Enum => parse_enum(
                        &mut next,
                        &mut nominal,
                        shell_id,
                        super::scanner::shell_is_public(shell),
                        start,
                        header_end,
                        whole_end
                    ),
                    _ => Result::Ok(())
                };
                try(parsed, @parse_shells);
                parse_shells(
                    original,
                    declarations,
                    index + 1,
                    next,
                    nominal
                )
            }
        }
    } else {
        Result::Ok(finish_parser(parser, nominal))
    }
}

finish_parser(value: Parser, nominal: NominalIndex) -> ParsedHeaders {
    let Parser { source, cursor: _, output } = value;
    ParsedHeaders {
        source: source,
        index: output,
        nominal: nominal
    }
}

pub parse(
    original: &String,
    source: super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex
) -> Result<ParsedHeaders, HeaderError> {
    parse_shells(
        original,
        declarations,
        0,
        Parser {
            source: source,
            cursor: super::syntax::cursor(0, 0),
            output: HeaderIndex {
                callables: Vec::new(),
                generic_params: Vec::new(),
                parameters: Vec::new(),
                types: Arena::new(),
                names: Vec::new(),
                type_edges: Vec::new()
            }
        },
        NominalIndex {
            order: Vec::new(),
            aliases: AliasArena { values: Vec::new() },
            structs: StructArena { values: Vec::new() },
            fields: FieldArena { values: Vec::new() },
            enums: EnumArena { values: Vec::new() },
            variants: VariantArena { values: Vec::new() },
            fixities: FixityArena { values: Vec::new() }
        }
    )
}
