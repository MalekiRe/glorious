// Flat declaration interfaces parsed from scanner-owned token ranges.
// Ordinary callables and type aliases are the first consumers of the shared
// generic/type arenas. Bodies remain unparsed.

use super::lexer::{TokenKind, TokenPattern};
use super::scanner::ShellId;

pub struct HeaderRangeTag {}
pub type HeaderRange = super::syntax::IdRange<HeaderRangeTag>;

pub type HeaderTokenRange = super::syntax::TokenSpan;

pub struct TypeTag {}

pub type TypeId = Id<TypeTag>;

pub struct NameUse { name: Id<String>, token: usize }

pub struct TypeEdge { value: TypeId, position: u32 }

enum HeaderTypeKind {
    Path(HeaderRange),
    SharedReference(Option<NameUse>, TypeId),
    UniqueReference(Option<NameUse>, TypeId),
    Tuple(HeaderRange),
    Application(TypeId, HeaderRange, HeaderRange, u32),
    Never
}

impl Use<[0, *]> for HeaderTypeKind {}

struct TypeNode {
    kind: HeaderTypeKind,
    tokens: HeaderTokenRange
}

// Semantic consumers borrow the parsed type graph through this view rather
// than depending on its arena kind codes and packed ranges.
pub enum HeaderTypeView<'a> {
    Path(usize, usize, Slice<'a, NameUse>),
    SharedReference(usize, usize, Option<usize>, TypeId),
    UniqueReference(usize, usize, Option<usize>, TypeId),
    Tuple(usize, usize, Slice<'a, TypeEdge>),
    Application(usize, usize, TypeId, Slice<'a, NameUse>, Slice<'a, TypeEdge>, u32),
    Never(usize, usize)
}

impl<'a> Use<[0, *]> for HeaderTypeView<'a> {}

enum GenericParamKind { Type, Lifetime, EffectRow, Const }

impl Use<[0, *]> for GenericParamKind {}

pub struct GenericParam {
    name: Id<String>,
    kind: GenericParamKind,
    tokens: HeaderTokenRange
}

pub struct Parameter {
    name: Id<String>,
    name_token: usize,
    ty: TypeId
}

pub struct EffectRow {
    effects: HeaderRange,
    row_tail: Option<NameUse>,
    tokens: HeaderTokenRange
}

impl Use<[0, *]> for EffectRow {}

// Where syntax is parsed once into the same header type/name arenas used by
// every declaration kind.  Owners retain only a range, so callables, nominal
// declarations, effects, and effect operations can share this grammar without
// embedding owner-specific syntax in the goal records.
pub enum GoalArgument {
    Type(TypeId),
    Lifetime(NameUse),
    Quantity(usize, Option<usize>, HeaderTokenRange),
    U32(usize, usize)
}

impl Use<[0, *]> for GoalArgument {}

pub enum AssociatedBindingValue {
    Type(TypeId),
    EffectRow(EffectRow)
}

impl Use<[0, *]> for AssociatedBindingValue {}

pub struct AssociatedBinding {
    name: NameUse,
    arguments: HeaderRange,
    value: AssociatedBindingValue,
    tokens: HeaderTokenRange
}

impl Use<[0, *]> for AssociatedBinding {}

pub struct WhereGoal {
    higher_ranked_lifetimes: HeaderRange,
    subject: TypeId,
    negative: Bool,
    relation: HeaderRange,
    arguments: HeaderRange,
    bindings: HeaderRange,
    tokens: HeaderTokenRange
}

impl Use<[0, *]> for WhereGoal {}

pub struct LifetimeOutlives {
    higher_ranked_lifetimes: HeaderRange,
    longer: NameUse,
    shorter: NameUse,
    tokens: HeaderTokenRange
}

impl Use<[0, *]> for LifetimeOutlives {}

pub struct WhereClause {
    goals: HeaderRange,
    lifetime_outlives: HeaderRange,
    tokens: HeaderTokenRange
}

impl Use<[0, *]> for WhereClause {}

pub struct CallableHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    generic_tokens: HeaderTokenRange,
    parameters: HeaderRange,
    result: Option<TypeId>,
    effects: Option<EffectRow>,
    // Keep exact source provenance beside the shared structured clause. The
    // scanner has already bounded this range before the body.
    where_tokens: HeaderTokenRange,
    where_clause: Option<WhereClause>,
    tokens: HeaderTokenRange
}

pub struct TypeAliasHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    target: TypeId,
    tokens: HeaderTokenRange
}

pub struct EffectRowAliasHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    row: EffectRow,
    tokens: HeaderTokenRange
}

pub struct FieldHeader {
    name: Id<String>,
    name_token: usize,
    tokens: HeaderTokenRange,
    private: Bool,
    ty: TypeId
}

pub struct StructHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    fields: HeaderRange,
    tokens: HeaderTokenRange
}

pub struct VariantHeader {
    name: Id<String>,
    name_token: usize,
    fields: HeaderRange
}

pub struct EnumHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    variants: HeaderRange,
    tokens: HeaderTokenRange
}

pub struct EffectOperationHeader {
    name: Id<String>,
    name_token: usize,
    generics: HeaderRange,
    parameters: HeaderRange,
    result: Option<TypeId>,
    terminal: Bool,
    resumption_lower: usize,
    resumption_upper: Option<usize>,
    has_resumption_quantity: Bool,
    where_tokens: HeaderTokenRange,
    where_clause: Option<WhereClause>,
    tokens: HeaderTokenRange
}

pub struct EffectHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    where_tokens: HeaderTokenRange,
    where_clause: Option<WhereClause>,
    operations: HeaderRange,
    tokens: HeaderTokenRange
}

pub struct DropHeader {
    shell: ShellId,
    generics: HeaderRange,
    target: TypeId,
    where_tokens: HeaderTokenRange,
    where_clause: Option<WhereClause>,
    tokens: HeaderTokenRange
}

pub struct UseHeader {
    shell: ShellId,
    generics: HeaderRange,
    lower: usize,
    upper: Option<usize>,
    target: TypeId,
    where_tokens: HeaderTokenRange,
    where_clause: Option<WhereClause>,
    tokens: HeaderTokenRange
}

pub struct TraitHeader {
    shell: ShellId,
    name: Id<String>,
    public: Bool,
    generics: HeaderRange,
    tokens: HeaderTokenRange
}

pub struct ImplHeader {
    shell: ShellId,
    generics: HeaderRange,
    trait_path: HeaderRange,
    self_ty: TypeId,
    where_tokens: HeaderTokenRange,
    where_clause: Option<WhereClause>,
    tokens: HeaderTokenRange
}

pub struct FixityHeader {
    shell: ShellId,
    public: Bool,
    form: u8,
    precedence: u8,
    operator: HeaderTokenRange,
    tokens: HeaderTokenRange
}

struct AliasArena { values: Vec<TypeAliasHeader> }
struct EffectRowAliasArena { values: Vec<EffectRowAliasHeader> }
struct StructArena { values: Vec<StructHeader> }
struct FieldArena { values: Vec<FieldHeader> }
struct EnumArena { values: Vec<EnumHeader> }
struct VariantArena { values: Vec<VariantHeader> }
struct EffectArena { values: Vec<EffectHeader> }
struct EffectOperationArena { values: Vec<EffectOperationHeader> }
struct FixityArena { values: Vec<FixityHeader> }
struct DropArena { values: Vec<DropHeader> }
struct UseArena { values: Vec<UseHeader> }
struct TraitArena { values: Vec<TraitHeader> }
struct ImplArena { values: Vec<ImplHeader> }

pub struct CallableHeaderTag {}
pub type CallableHeaderId = Id<CallableHeaderTag>;
pub struct AliasHeaderTag {}
pub type AliasHeaderId = Id<AliasHeaderTag>;
pub struct EffectRowAliasHeaderTag {}
pub type EffectRowAliasHeaderId = Id<EffectRowAliasHeaderTag>;
pub struct FixityHeaderTag {}
pub type FixityHeaderId = Id<FixityHeaderTag>;
pub struct StructHeaderTag {}
pub type StructHeaderId = Id<StructHeaderTag>;
pub struct EnumHeaderTag {}
pub type EnumHeaderId = Id<EnumHeaderTag>;
pub struct VariantHeaderTag {}
pub type VariantHeaderId = Id<VariantHeaderTag>;
pub struct EffectHeaderTag {}
pub type EffectHeaderId = Id<EffectHeaderTag>;
pub struct EffectOperationHeaderTag {}
pub type EffectOperationHeaderId = Id<EffectOperationHeaderTag>;
pub struct DropHeaderTag {}
pub type DropHeaderId = Id<DropHeaderTag>;
pub struct UseHeaderTag {}
pub type UseHeaderId = Id<UseHeaderTag>;
pub struct TraitHeaderTag {}
pub type TraitHeaderId = Id<TraitHeaderTag>;
pub struct ImplHeaderTag {}
pub type ImplHeaderId = Id<ImplHeaderTag>;

pub enum HeaderOrder {
    Callable(CallableHeaderId),
    Alias(AliasHeaderId),
    EffectRowAlias(EffectRowAliasHeaderId),
    Fixity(FixityHeaderId),
    Struct(StructHeaderId),
    Enum(EnumHeaderId),
    Effect(EffectHeaderId),
    Drop(DropHeaderId),
    Use(UseHeaderId),
    Trait(TraitHeaderId),
    Impl(ImplHeaderId)
}

impl Use<[0, *]> for HeaderOrder {}

typed_header_id<Tag>(index: usize) -> Id<Tag> {
    handle Id::from_usize(index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub struct Def {
    shell: ShellId,
    kind: HeaderOrder
}

pub struct ParsedDefTable {
    order: Vec<Def>,
    by_shell: HashMap<ShellId, HeaderOrder>,
    enum_members: HashMap<(EnumHeaderId, Id<String>), VariantHeaderId>,
    fixities: HashMap<(Option<ShellId>, Id<String>, Bool), FixitySearch>
}

pub struct FixitySearch {
    selected: FixityHeaderId,
    conflict: Option<FixityHeaderId>
}

impl Use<[0, *]> for FixitySearch {}

pub struct HeaderIndex {
    callables: Vec<CallableHeader>,
    generic_params: Vec<GenericParam>,
    parameters: Vec<Parameter>,
    types: Arena<TypeTag, TypeNode>,
    names: Vec<NameUse>,
    lifetime_arguments: Vec<NameUse>,
    type_edges: Vec<TypeEdge>,
    where_goals: Vec<WhereGoal>,
    lifetime_outlives: Vec<LifetimeOutlives>,
    goal_arguments: Vec<GoalArgument>,
    associated_arguments: Vec<GoalArgument>,
    associated_bindings: Vec<AssociatedBinding>
}

pub struct NominalIndex {
    definitions: ParsedDefTable,
    aliases: AliasArena,
    effect_row_aliases: EffectRowAliasArena,
    structs: StructArena,
    fields: FieldArena,
    enums: EnumArena,
    variants: VariantArena,
    effects: EffectArena,
    effect_operations: EffectOperationArena,
    fixities: FixityArena,
    drops: DropArena,
    uses: UseArena,
    traits: TraitArena,
    impls: ImplArena
}

pub struct ParsedHeaders {
    source: super::lexer::LexedSource,
    index: HeaderIndex,
    nominal: NominalIndex
}

pub enum HeaderError {
    ExpectedIdentifier(usize, usize),
    ExpectedLeftParenthesis(usize, usize),
    ExpectedRightParenthesis(usize, usize),
    ExpectedRightAngle(usize, usize),
    EmptyTypeArguments(usize, usize),
    EmptyGenericParameters(usize, usize),
    UnsupportedGenericParameterKind(usize, usize),
    ExpectedColon(usize, usize),
    ExpectedRightBrace(usize, usize),
    ExpectedSemicolon(usize, usize),
    UnexpectedTrailingHeaderToken(usize, usize),
    ExpectedEquals(usize, usize),
    ExpectedIntegerPrecedence(usize, usize),
    PrecedenceOutOfRange(usize, usize),
    ExpectedOperator(usize, usize),
    InvalidFixityForm(usize, usize),
    ExpectedEffectBody(usize, usize),
    ExpectedResumptionComma(usize, usize),
    ExpectedResumptionUpper(usize, usize),
    ExpectedResumptionRightBracket(usize, usize),
    InvalidResumptionBound(usize, usize),
    EmptyWhereClause(usize, usize),
    InvalidWhereGoal(usize, usize),
    InvalidWhereQuantity(usize, usize),
    DuplicateAssociatedBinding(usize, usize),
    TypeArenaExhausted(usize, usize)
}

// Keep the structural header identity available to the small conformance
// probes without making them depend on the diagnostics/compiler layers.
pub header_error_code(error: &HeaderError) -> u32 {
    handle *error {
        HeaderError::ExpectedIdentifier(_, _) => 1,
        HeaderError::ExpectedLeftParenthesis(_, _) => 2,
        HeaderError::ExpectedRightParenthesis(_, _) => 3,
        HeaderError::ExpectedRightAngle(_, _) => 4,
        HeaderError::EmptyTypeArguments(_, _) => 5,
        HeaderError::EmptyGenericParameters(_, _) => 15,
        HeaderError::UnsupportedGenericParameterKind(_, _) => 6,
        HeaderError::ExpectedColon(_, _) => 7,
        HeaderError::ExpectedRightBrace(_, _) => 8,
        HeaderError::ExpectedSemicolon(_, _) => 16,
        HeaderError::UnexpectedTrailingHeaderToken(_, _) => 9,
        HeaderError::ExpectedEquals(_, _) => 10,
        HeaderError::ExpectedIntegerPrecedence(_, _) => 11,
        HeaderError::PrecedenceOutOfRange(_, _) => 17,
        HeaderError::ExpectedOperator(_, _) => 12,
        HeaderError::InvalidFixityForm(_, _) => 13,
        HeaderError::ExpectedEffectBody(_, _) => 18,
        HeaderError::ExpectedResumptionComma(_, _) => 19,
        HeaderError::ExpectedResumptionUpper(_, _) => 20,
        HeaderError::ExpectedResumptionRightBracket(_, _) => 21,
        HeaderError::InvalidResumptionBound(_, _) => 22,
        HeaderError::EmptyWhereClause(_, _) => 23,
        HeaderError::InvalidWhereGoal(_, _) => 24,
        HeaderError::InvalidWhereQuantity(_, _) => 25,
        HeaderError::DuplicateAssociatedBinding(_, _) => 26,
        HeaderError::TypeArenaExhausted(_, _) => 14
    }
}

pub header_error_token(error: &HeaderError) -> usize {
    handle *error {
        HeaderError::ExpectedIdentifier(token, _) => token,
        HeaderError::ExpectedLeftParenthesis(token, _) => token,
        HeaderError::ExpectedRightParenthesis(token, _) => token,
        HeaderError::ExpectedRightAngle(token, _) => token,
        HeaderError::EmptyTypeArguments(token, _) => token,
        HeaderError::EmptyGenericParameters(token, _) => token,
        HeaderError::UnsupportedGenericParameterKind(token, _) => token,
        HeaderError::ExpectedColon(token, _) => token,
        HeaderError::ExpectedRightBrace(token, _) => token,
        HeaderError::ExpectedSemicolon(token, _) => token,
        HeaderError::UnexpectedTrailingHeaderToken(token, _) => token,
        HeaderError::ExpectedEquals(token, _) => token,
        HeaderError::ExpectedIntegerPrecedence(token, _) => token,
        HeaderError::PrecedenceOutOfRange(token, _) => token,
        HeaderError::ExpectedOperator(token, _) => token,
        HeaderError::InvalidFixityForm(token, _) => token,
        HeaderError::ExpectedEffectBody(token, _) => token,
        HeaderError::ExpectedResumptionComma(token, _) => token,
        HeaderError::ExpectedResumptionUpper(token, _) => token,
        HeaderError::ExpectedResumptionRightBracket(token, _) => token,
        HeaderError::InvalidResumptionBound(token, _) => token,
        HeaderError::EmptyWhereClause(token, _) => token,
        HeaderError::InvalidWhereGoal(token, _) => token,
        HeaderError::InvalidWhereQuantity(token, _) => token,
        HeaderError::DuplicateAssociatedBinding(token, _) => token,
        HeaderError::TypeArenaExhausted(token, _) => token
    }
}

struct HeaderBounds { start: usize, end: usize }

struct Parser {
    source: super::lexer::LexedSource,
    tokens: super::syntax::TokenCursor,
    output: HeaderIndex
}

pub range_start(value: &HeaderRange) -> u32 { value.start }

pub range_count(value: &HeaderRange) -> u32 { value.count }

pub callable_count(value: &HeaderIndex) -> usize { Vec::len(&value.callables) }

pub header_count(value: &NominalIndex) -> usize {
    Vec::len(&value.definitions.order)
}

pub header_at(value: &NominalIndex, index: usize) -> HeaderOrder {
    Vec::index(&value.definitions.order, index).kind
}

pub header_kind(value: &NominalIndex, index: usize) -> u8 {
    handle Vec::index(&value.definitions.order, index).kind {
        HeaderOrder::Callable(_) => 12,
        HeaderOrder::Alias(_) => 3,
        HeaderOrder::EffectRowAlias(_) => 4,
        HeaderOrder::Fixity(_) => 6,
        HeaderOrder::Struct(_) => 8,
        HeaderOrder::Enum(_) => 9,
        HeaderOrder::Effect(_) => 7,
        HeaderOrder::Drop(_) => 13,
        HeaderOrder::Use(_) => 14,
        HeaderOrder::Trait(_) => 15,
        HeaderOrder::Impl(_) => 16
    }
}

pub header_index(value: &NominalIndex, index: usize) -> u32 {
    handle Vec::index(&value.definitions.order, index).kind {
        HeaderOrder::Callable(found) => Id::to_u32(found),
        HeaderOrder::Alias(found) => Id::to_u32(found),
        HeaderOrder::EffectRowAlias(found) => Id::to_u32(found),
        HeaderOrder::Fixity(found) => Id::to_u32(found),
        HeaderOrder::Struct(found) => Id::to_u32(found),
        HeaderOrder::Enum(found) => Id::to_u32(found),
        HeaderOrder::Effect(found) => Id::to_u32(found),
        HeaderOrder::Drop(found) => Id::to_u32(found),
        HeaderOrder::Use(found) => Id::to_u32(found),
        HeaderOrder::Trait(found) => Id::to_u32(found),
        HeaderOrder::Impl(found) => Id::to_u32(found)
    }
}

pub def_shell(value: &NominalIndex, index: usize) -> ShellId {
    Vec::index(&value.definitions.order, index).shell
}

pub def_kind_for_shell(
    value: &NominalIndex,
    shell: ShellId
) -> Option<HeaderOrder> {
    handle HashMap::get(&value.definitions.by_shell, &shell) {
        Result::Err(_) => None,
        Result::Ok(found) => Option::Some(*found)
    }
}

pub alias_count(value: &NominalIndex) -> usize { Vec::len(&value.aliases.values) }

pub struct_count(value: &NominalIndex) -> usize { Vec::len(&value.structs.values) }

pub field_count(value: &NominalIndex) -> usize { Vec::len(&value.fields.values) }

pub enum_count(value: &NominalIndex) -> usize { Vec::len(&value.enums.values) }

pub effect_count(value: &NominalIndex) -> usize { Vec::len(&value.effects.values) }

pub effect_operation_count(value: &NominalIndex) -> usize {
    Vec::len(&value.effect_operations.values)
}

pub variant_count(value: &NominalIndex) -> usize { Vec::len(&value.variants.values) }

pub fixity_count(value: &NominalIndex) -> usize { Vec::len(&value.fixities.values) }

variant_arena_count(value: &VariantArena) -> usize { Vec::len(&value.values) }

pub type_count(value: &HeaderIndex) -> usize { Arena::len(&value.types) }

pub parameter_count(value: &HeaderIndex) -> usize { Vec::len(&value.parameters) }

pub generic_param_count(value: &HeaderIndex) -> usize {
    Vec::len(&value.generic_params)
}

pub callable_at<'a>(
    value: &'a HeaderIndex,
    index: usize
) -> Option<&'a CallableHeader> {
    Vec::get(&value.callables, index)
}

pub alias_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a TypeAliasHeader> {
    Vec::get(&value.aliases.values, index)
}

pub effect_row_alias_count(value: &NominalIndex) -> usize {
    Vec::len(&value.effect_row_aliases.values)
}

pub effect_row_alias_at<'a>(
    value: &'a NominalIndex,
    index: usize
) -> Option<&'a EffectRowAliasHeader> {
    Vec::get(&value.effect_row_aliases.values, index)
}

pub struct_at<'a>(
