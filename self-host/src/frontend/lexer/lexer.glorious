// The first executable slice of the self-hosted compiler. This is the source
// ingestion boundary used by the future declaration scanner and body parser.

pub struct Span { start: usize, end: usize }

pub enum Keyword {
    Cancel,
    Effect,
    Enum,
    Handle,
    Impl,
    Is,
    Let,
    Perform,
    Resume,
    Struct,
    Tail,
    Trait,
    Type,
    Where
}

pub enum NumberBase { Binary, Octal, Decimal, Hex }

pub struct NumberExponent {
    negative: Bool,
    digits: Span
}

pub struct NumberToken {
    spelling: Span,
    base: NumberBase,
    base_code: u8,
    digits: Span,
    fraction: Option<Span>,
    exponent: Option<NumberExponent>
}

pub enum TokenKind {
    Ident(Id<String>),
    Keyword(Keyword),
    Lifetime(Id<String>),
    Number(NumberToken),
    String(Id<String>),
    Char(char),
    Byte(u8),
    ByteString(Bytes),
    Label(Id<String>),
    Operator(Id<String>),
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Colon,
    DoubleColon,
    DotDot,
    Dot,
    Semicolon,
    Arrow,
    FatArrow,
    Slash,
    Plus,
    Minus,
    Star,
    Percent,
    Pipe,
    Eq,
    EqEq,
    BangEq,
    Lt,
    LtEq,
    Gt,
    GtEq,
    Amp,
    Bang,
    Dollar,
    Eof
}

impl Use<[0, *]> for TokenKind {}

pub struct Token { kind: TokenKind, code: u16, keyword_code: u8, span: Span }

struct CodedTokenKind { kind: TokenKind, code: u16 }

struct RecognizedKeyword { value: Keyword, code: u8 }

coded_token_kind(kind: TokenKind, code: u16) -> CodedTokenKind {
    CodedTokenKind { kind: move kind, code: move code }
}

recognized_keyword(value: Keyword, code: u8) -> RecognizedKeyword {
    RecognizedKeyword { value: move value, code: move code }
}

pub struct LexedSource {
    tokens: Vec<Token>,
    lexemes: Interner<String>
}

pub enum LexErrorKind {
    UnexpectedCharacter,
    UnfinishedComment,
    InvalidLabel,
    InvalidDigit,
    MisplacedDigitSeparator,
    ExpectedDigits,
    MalformedFloatExponent,
    UnfinishedEscape,
    InvalidCharacterEscape,
    UnknownEscape,
    MalformedHexEscape,
    MalformedUnicodeEscape,
    UnfinishedUnicodeEscape,
    InvalidUnicodeScalar,
    InvalidByteEscape,
    UnfinishedString,
    InvalidByteStringCharacter,
    UnfinishedByteString,
    EmptyByteLiteral,
    InvalidByteLiteral,
    UnfinishedByteLiteral,
    UnfinishedCharacterLiteral,
    EmptyCharacterLiteral,
    InvalidLifetimeIdentifier,
    InvalidCharacterLiteral,
    ResourceLimit
}

pub struct LexError { kind: LexErrorKind, code: u16, span: Span }

pub token_count(value: &LexedSource) -> usize { Vec::len(&value.tokens) }

pub token_at<'a>(value: &'a LexedSource, index: usize) -> Option<&'a Token> {
    Vec::get(&value.tokens, move index)
}

pub token_kind(value: &Token) -> &TokenKind { &value.kind }

pub token_code(value: &Token) -> u16 { value.code }

pub token_span(value: &Token) -> Span {
    Span { start: value.span.start, end: value.span.end }
}

pub span_start(value: &Span) -> usize { value.start }

pub span_end(value: &Span) -> usize { value.end }

pub number_spelling(value: &NumberToken) -> Span {
    Span { start: value.spelling.start, end: value.spelling.end }
}

pub number_base(value: &NumberToken) -> &NumberBase { &value.base }

pub number_digits(value: &NumberToken) -> Span {
    Span { start: value.digits.start, end: value.digits.end }
}

pub number_fraction(value: &NumberToken) -> &Option<Span> { &value.fraction }

pub number_exponent(value: &NumberToken) -> &Option<NumberExponent> {
    &value.exponent
}

pub exponent_negative(value: &NumberExponent) -> Bool { value.negative }

pub exponent_digits(value: &NumberExponent) -> Span {
    Span { start: value.digits.start, end: value.digits.end }
}

pub lexeme<'a>(value: &'a LexedSource, id: Id<String>) -> Option<&'a String> {
    Interner::get(&value.lexemes, move id)
}

pub error_kind(value: &LexError) -> &LexErrorKind { &value.kind }

pub error_code(value: &LexError) -> u16 { value.code }

pub error_span(value: &LexError) -> Span {
    Span { start: value.span.start, end: value.span.end }
}

struct Lexer {
    source: String,
    bytes: Bytes,
    cursor: usize,
    tokens: Vec<Token>,
    lexemes: Interner<String>,
    after_projection_dot: Bool
}

span(start: usize, end: usize) -> Span { Span { start: move start, end: move end } }

lex_error(kind: LexErrorKind, code: u16, start: usize, end: usize) -> LexError {
    LexError {
        kind: move kind,
        code: move code,
        span: span(move start, move end)
    }
}

bool_value(value: Bool) -> u32 {
    handle move value { Result::Ok(_) => 1, Result::Err(_) => 0 }
}

byte_value(value: u8) -> u8 { move value }

u16_value(value: u16) -> u16 { move value }

u32_value(value: u32) -> u32 { move value }

u16_is(value: &u16, expected: u16) -> Bool {
    *value == expected
}

byte_at_most(value: &u8, upper: u8) -> Bool {
    *value <= upper
}

split_byte(value: u8, upper: u8) -> Result<u8, u8> {
    let retained = value;
    handle byte_at_most(&value, upper) {
        Result::Ok(_) => Result::Ok(move retained),
        Result::Err(_) => Result::Err(move retained)
    }
}

byte_is_between(value: u8, low: u8, high: u8) -> Bool {
    handle low <= value {
        Result::Ok(_) => value <= high,
        Result::Err(_) => false
    }
}

byte_is_digit(value: u8) -> Bool { byte_is_between(value, 48, 57) }

byte_is_lower(value: u8) -> Bool { byte_is_between(value, 97, 122) }

byte_is_upper(value: u8) -> Bool { byte_is_between(value, 65, 90) }

byte_is_alpha(value: u8) -> Bool {
    handle byte_is_lower(value) {
        Result::Ok(_) => true,
        Result::Err(_) => byte_is_upper(value)
    }
}

byte_is_alphanumeric(value: u8) -> Bool {
    handle byte_is_alpha(value) {
        Result::Ok(_) => true,
        Result::Err(_) => byte_is_digit(value)
    }
}

byte_is_word_start(value: u8) -> Bool {
    handle byte_is_alpha(value) {
        Result::Ok(_) => true,
        Result::Err(_) => value == 95
    }
}

byte_is_hex(value: u8) -> Bool {
    handle byte_is_digit(value) {
        Result::Ok(_) => true,
        Result::Err(_) => {
            handle byte_is_between(value, 97, 102) {
                Result::Ok(_) => true,
                Result::Err(_) => byte_is_between(value, 65, 70)
            }
        }
    }
}

byte_is_whitespace(value: u8) -> Bool {
    handle value == 32 {
        Result::Ok(_) => true,
        Result::Err(_) => {
            handle value == 9 {
                Result::Ok(_) => true,
                Result::Err(_) => {
                    handle value == 10 {
                        Result::Ok(_) => true,
                        Result::Err(_) => {
                            handle value == 13 {
                                Result::Ok(_) => true,
                                Result::Err(_) => {
                                    handle value == 11 {
                                        Result::Ok(_) => true,
                                        Result::Err(_) => value == 12
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

operator_byte_mask() -> u128 {
    106338239682600310478164731729926946816
}

byte_is_operator(value: u8) -> Bool {
    handle value <= 126 {
        Result::Ok(_) => bit_and(
            shift_right(operator_byte_mask(), wrapping_convert_to_u32(value)),
            1
        ) != 0,
        Result::Err(_) => false
    }
}

peek(value: &Lexer, offset: usize) -> Option<u8> {
    handle Bytes::get(&value.bytes, value.cursor + move offset) {
        Result::Ok(found) => Option::Some(move found),
        Result::Err(_) => None
    }
}

peek_is(value: &Lexer, offset: usize, expected: u8) -> Bool {
    handle peek(value, move offset) {
        Result::Ok(actual) => move actual == move expected,
        Result::Err(_) => false
    }
}

advance(value: &mut Lexer, amount: usize) {
    (*value).cursor = value.cursor + move amount;
}

text_slice(source: &String, start: usize, end: usize) -> String {
    handle String::slice(source, Range { start: move start, end: move end }) {
        Result::Ok(text) => move text,
        Result::Err(_) => unreachable()
    }
}

source_slice(value: &Lexer, start: usize, end: usize) -> String {
    text_slice(&value.source, move start, move end)
}

intern_slice(value: &mut Lexer, start: usize, end: usize) -> Id<String> {
    let text = source_slice(&*value, move start, move end);
    handle Interner::intern_string(&mut value.lexemes, move text) {
        Result::Ok(id) => move id,
        // `lex` rejects a source longer than the u32 ID space. There can be no
        // more distinct source lexemes than source bytes, so exhaustion here
        // would contradict that checked boundary.
        Result::Err(_) => unreachable()
    }
}

intern_text(value: &mut Lexer, text: String) -> Id<String> {
    handle Interner::intern_string(&mut value.lexemes, move text) {
        Result::Ok(id) => move id,
        Result::Err(_) => unreachable()
    }
}

push_with_metadata(
    value: &mut Lexer,
    kind: TokenKind,
    code: u16,
    keyword_code: u8,
    start: usize
) {
    let after_dot = u16_is(&code, u16_value(21));
    let end = value.cursor;
    Vec::push(
        &mut value.tokens,
        Token {
            kind: move kind,
            code: move code,
            keyword_code: move keyword_code,
            span: span(move start, move end)
        }
    );
    (*value).after_projection_dot = move after_dot;
}

push(value: &mut Lexer, kind: TokenKind, code: u16, start: usize) {
    push_with_metadata(move value, move kind, move code, 0, move start)
}

push_keyword(value: &mut Lexer, found: RecognizedKeyword, start: usize) {
    push_with_metadata(
        move value,
        TokenKind::Keyword(move found.value),
        2,
        found.code,
        move start
    )
}

keyword_named(
    value: &String,
    spelling: &String,
    found: Keyword,
    code: u8
) -> Option<RecognizedKeyword> {
    handle String::eq(value, spelling) {
        Result::Ok(_) => Option::Some(recognized_keyword(move found, move code)),
        Result::Err(_) => None
    }
}

keyword(value: &String) -> Option<RecognizedKeyword> {
    let bytes = String::as_bytes(value);
    handle Bytes::get(&bytes, 0) {
        Result::Ok(99) => keyword_named(value, &"cancel", Keyword::Cancel, 1),
        Result::Ok(101) => handle String::eq(value, &"enum") {
            Result::Ok(_) => Option::Some(recognized_keyword(Keyword::Enum, 3)),
            Result::Err(_) => keyword_named(value, &"effect", Keyword::Effect, 2)
        },
        Result::Ok(104) => keyword_named(value, &"handle", Keyword::Handle, 4),
        Result::Ok(105) => handle String::eq(value, &"is") {
            Result::Ok(_) => Option::Some(recognized_keyword(Keyword::Is, 6)),
            Result::Err(_) => keyword_named(value, &"impl", Keyword::Impl, 5)
        },
        Result::Ok(108) => keyword_named(value, &"let", Keyword::Let, 7),
        Result::Ok(112) => keyword_named(value, &"perform", Keyword::Perform, 8),
        Result::Ok(114) => keyword_named(value, &"resume", Keyword::Resume, 9),
        Result::Ok(115) => keyword_named(value, &"struct", Keyword::Struct, 10),
        Result::Ok(116) => handle String::eq(value, &"tail") {
            Result::Ok(_) => Option::Some(recognized_keyword(Keyword::Tail, 11)),
            Result::Err(_) => handle String::eq(value, &"trait") {
                Result::Ok(_) => Option::Some(recognized_keyword(Keyword::Trait, 12)),
                Result::Err(_) => keyword_named(value, &"type", Keyword::Type, 13)
            }
        },
        Result::Ok(119) => keyword_named(value, &"where", Keyword::Where, 14),
        _ => None
    }
}

scan_word(value: &mut Lexer) {
    let start = value.cursor;
    advance(&mut *value, 1);
    scan_word_tail(&mut *value);
    let end = value.cursor;
    let text = source_slice(&*value, start, move end);
    handle keyword(&text) {
        Result::Ok(found) => push_keyword(move value, move found, start),
        Result::Err(_) => {
            let end = value.cursor;
            let id = intern_slice(&mut *value, start, move end);
            push(move value, TokenKind::Ident(move id), 1, start)
        }
    }
}

scan_word_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            handle byte_is_alphanumeric(byte) {
                Result::Ok(_) => {
                    advance(&mut *value, 1);
                    scan_word_tail(move value)
                },
                Result::Err(_) => {
                    handle byte == byte_value(95) {
                        Result::Ok(_) => {
                            advance(&mut *value, 1);
                            scan_word_tail(move value)
                        },
                        Result::Err(_) => {
                            handle byte == byte_value(45) {
                                Result::Ok(_) => {
                                    handle peek(&*value, 1) {
                                        Result::Ok(next) => {
                                            handle byte_is_alphanumeric(next) {
                                                Result::Ok(_) => {
                                                    advance(&mut *value, 2);
                                                    scan_word_tail(move value)
                                                },
                                                Result::Err(_) => {
                                                    handle next == byte_value(95) {
                                                        Result::Ok(_) => {
                                                            advance(&mut *value, 2);
                                                            scan_word_tail(move value)
                                                        },
                                                        Result::Err(_) => ()
                                                    }
                                                }
                                            }
                                        },
                                        Result::Err(_) => ()
                                    }
                                },
                                Result::Err(_) => ()
                            }
                        }
                    }
                }
            }
        },
        Result::Err(_) => ()
    }
}

scan_line_comment(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            handle byte == byte_value(10) {
                Result::Ok(_) => (),
                Result::Err(_) => {
                    advance(&mut *value, 1);
                    scan_line_comment(move value)
                }
            }
        },
        Result::Err(_) => ()
    }
}

scan_block_comment(value: &mut Lexer, start: usize, depth: usize) -> Result<(), LexError> {
    handle depth == 0 {
        Result::Ok(_) => Result::Ok(()),
        Result::Err(_) => {
            handle value.cursor < Bytes::len(&value.bytes) {
                Result::Ok(_) => {
                    handle peek_is(&*value, 0, 47) {
                        Result::Ok(_) => handle peek_is(&*value, 1, 42) {
                            Result::Ok(_) => {
                                advance(&mut *value, 2);
                                scan_block_comment(move value, start, depth + 1)
                            },
                            Result::Err(_) => {
                                advance(&mut *value, 1);
                                scan_block_comment(move value, start, move depth)
                            }
                        },
                        Result::Err(_) => handle peek_is(&*value, 0, 42) {
                            Result::Ok(_) => handle peek_is(&*value, 1, 47) {
                                Result::Ok(_) => {
                                    advance(&mut *value, 2);
                                    scan_block_comment(move value, start, depth - 1)
                                },
                                Result::Err(_) => {
                                    advance(&mut *value, 1);
                                    scan_block_comment(move value, start, move depth)
                                }
                            },
                            Result::Err(_) => {
                                advance(&mut *value, 1);
                                scan_block_comment(move value, start, move depth)
                            }
                        }
                    }
                },
                Result::Err(_) => Result::Err(
                    lex_error(LexErrorKind::UnfinishedComment, 2, start, Bytes::len(&value.bytes))
                )
            }
        }
    }
}

scan_label_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            handle byte_is_alphanumeric(byte) {
                Result::Ok(_) => {
                    advance(&mut *value, 1);
                    scan_label_tail(move value)
                },
                Result::Err(_) => handle byte == byte_value(95) {
                    Result::Ok(_) => {
                        advance(&mut *value, 1);
                        scan_label_tail(move value)
                    },
                    Result::Err(_) => ()
                }
            }
        },
        Result::Err(_) => ()
    }
}

scan_label(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 1);
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            handle byte_is_word_start(byte) {
                Result::Ok(_) => {
                    let name_start = value.cursor;
                    advance(&mut *value, 1);
                    scan_label_tail(&mut *value);
                    let name_end = value.cursor;
                    let id = intern_slice(&mut *value, name_start, move name_end);
                    push(move value, TokenKind::Label(move id), 9, start);
                    Result::Ok(())
                },
                Result::Err(_) => Result::Err(
                    lex_error(LexErrorKind::InvalidLabel, 3, start, value.cursor)
                )
            }
        },
        Result::Err(_) => Result::Err(
            lex_error(LexErrorKind::InvalidLabel, 3, start, value.cursor)
        )
    }
}

structural_two(first: u8, second: u8) -> Option<CodedTokenKind> {
    handle first {
        45 => handle second == byte_value(62) {
            Result::Ok(_) => Option::Some(
                CodedTokenKind { kind: TokenKind::Arrow, code: 23 }
            ),
            Result::Err(_) => None
        },
        61 => handle second {
            62 => Option::Some(
                CodedTokenKind { kind: TokenKind::FatArrow, code: 24 }
            ),
            61 => Option::Some(
                CodedTokenKind { kind: TokenKind::EqEq, code: 32 }
            ),
            _ => None
        },
        46 => handle second == byte_value(46) {
            Result::Ok(_) => Option::Some(
                CodedTokenKind { kind: TokenKind::DotDot, code: 20 }
            ),
            Result::Err(_) => None
        },
        33 => handle second == byte_value(61) {
            Result::Ok(_) => Option::Some(
                CodedTokenKind { kind: TokenKind::BangEq, code: 33 }
            ),
            Result::Err(_) => None
        },
        60 => handle second == byte_value(61) {
            Result::Ok(_) => Option::Some(
                CodedTokenKind { kind: TokenKind::LtEq, code: 35 }
            ),
            Result::Err(_) => None
        },
        62 => handle second == byte_value(61) {
            Result::Ok(_) => Option::Some(
                CodedTokenKind { kind: TokenKind::GtEq, code: 37 }
            ),
            Result::Err(_) => None
        },
        _ => None
    }
}

structural_one(value: u8) -> Option<CodedTokenKind> {
    handle move value {
        46 => Option::Some(CodedTokenKind { kind: TokenKind::Dot, code: 21 }),
        47 => Option::Some(CodedTokenKind { kind: TokenKind::Slash, code: 25 }),
        43 => Option::Some(CodedTokenKind { kind: TokenKind::Plus, code: 26 }),
        45 => Option::Some(CodedTokenKind { kind: TokenKind::Minus, code: 27 }),
        42 => Option::Some(CodedTokenKind { kind: TokenKind::Star, code: 28 }),
        37 => Option::Some(CodedTokenKind { kind: TokenKind::Percent, code: 29 }),
        124 => Option::Some(CodedTokenKind { kind: TokenKind::Pipe, code: 30 }),
        61 => Option::Some(CodedTokenKind { kind: TokenKind::Eq, code: 31 }),
        60 => Option::Some(CodedTokenKind { kind: TokenKind::Lt, code: 34 }),
        62 => Option::Some(CodedTokenKind { kind: TokenKind::Gt, code: 36 }),
        38 => Option::Some(CodedTokenKind { kind: TokenKind::Amp, code: 38 }),
        33 => Option::Some(CodedTokenKind { kind: TokenKind::Bang, code: 39 }),
        _ => None
    }
}

structural_two_exists(first: u8, second: u8) -> Bool {
    handle move second {
        46 => move first == byte_value(46),
        61 => handle move first {
            33 => true,
            60 => true,
            61 => true,
            62 => true,
            _ => false
        },
        62 => handle move first {
            45 => true,
            61 => true,
            _ => false
        },
        _ => false
    }
}

scan_operator_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(first) => {
            handle byte_is_operator(first) {
                Result::Ok(_) => {
                    handle structural_one(first) {
                        Result::Ok(_) => (),
                        Result::Err(_) => {
                            let pair_structural = handle peek(&*value, 1) {
                                Result::Ok(second) => structural_two_exists(
                                    first,
                                    move second
                                ),
                                Result::Err(_) => false
                            };
                            handle move pair_structural {
                                Result::Ok(_) => (),
                                Result::Err(_) => {
                                    advance(&mut *value, 1);
                                    scan_operator_tail(move value)
                                }
                            }
                        }
                    }
                },
                Result::Err(_) => ()
            }
        },
        Result::Err(_) => ()
    }
}

scan_operator(value: &mut Lexer) {
    let start = value.cursor;
    let first = handle peek(&*value, 0) {
        Result::Ok(byte) => move byte,
        Result::Err(_) => unreachable()
    };
    let pair = handle peek(&*value, 1) {
        Result::Ok(second) => structural_two(first, move second),
        Result::Err(_) => None
    };
    handle move pair {
        Result::Ok(coded) => {
            advance(&mut *value, 2);
            push(move value, move coded.kind, coded.code, start)
        },
        Result::Err(_) => handle structural_one(first) {
            Result::Ok(coded) => {
                advance(&mut *value, 1);
                push(move value, move coded.kind, coded.code, start)
            },
            Result::Err(_) => {
                scan_operator_tail(&mut *value);
                let end = value.cursor;
                let id = intern_slice(&mut *value, start, move end);
                push(move value, TokenKind::Operator(move id), 10, start)
            }
        }
    }
}

digit_valid(byte: u8, base_code: u8) -> Bool {
    handle base_code {
        1 => handle byte {
            48 => true,
            49 => true,
            _ => false
        },
        2 => byte_is_between(byte, 48, 55),
        3 => byte_is_digit(byte),
        _ => byte_is_hex(byte)
    }
}

scan_digit_tail(
    value: &mut Lexer,
    base_code: u8,
    last_separator: Option<usize>
) -> Result<Option<usize>, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            handle byte == byte_value(95) {
                Result::Ok(_) => {
                    let separator = value.cursor;
                    advance(&mut *value, 1);
                    scan_digit_tail(move value, base_code, Option::Some(move separator))
                },
                Result::Err(_) => handle digit_valid(byte, base_code) {
                    Result::Ok(_) => {
                        advance(&mut *value, 1);
                        scan_digit_tail(move value, base_code, None)
                    },
                    Result::Err(_) => {
                        handle byte_is_digit(byte) {
                            Result::Ok(_) => Result::Err(
                                lex_error(
                                    LexErrorKind::InvalidDigit, 4,
                                    value.cursor,
                                    value.cursor + usize_value(1)
                                )
                            ),
                            Result::Err(_) => Result::Ok(move last_separator)
                        }
                    }
                }
            }
        },
        Result::Err(_) => Result::Ok(move last_separator)
    }
}

scan_digits(
    value: &mut Lexer,
    base_code: u8,
    component_start: usize
) -> Result<Span, LexError> {
    handle scan_digit_tail(&mut *value, base_code, None) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(last_separator) => handle move last_separator {
            Result::Ok(position) => Result::Err(
                lex_error(
                    LexErrorKind::MisplacedDigitSeparator, 5,
                    position,
                    position + usize_value(1)
                )
            ),
            Result::Err(_) => handle value.cursor == component_start {
                Result::Ok(_) => Result::Err(
                    lex_error(
                        LexErrorKind::ExpectedDigits, 6,
                        component_start,
                        component_start
                    )
                ),
                Result::Err(_) => Result::Ok(span(component_start, value.cursor))
            }
        }
    }
}

skip_underscores(value: &mut Lexer) {
    handle peek_is(&*value, 0, 95) {
        Result::Ok(_) => {
            advance(&mut *value, 1);
            skip_underscores(move value)
        },
        Result::Err(_) => ()
    }
}

scan_number(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    let after_projection_dot = value.after_projection_dot;
    let base_code = handle peek(&*value, 0) {
        Result::Ok(48) => handle peek(&*value, 1) {
            Result::Ok(98) => byte_value(1),
            Result::Ok(111) => byte_value(2),
            Result::Ok(120) => byte_value(4),
            _ => byte_value(3)
        },
        _ => byte_value(3)
    };
    let base = handle base_code {
        1 => NumberBase::Binary,
        2 => NumberBase::Octal,
        3 => NumberBase::Decimal,
        _ => NumberBase::Hex
    };
    let non_decimal = base_code != byte_value(3);
    let digits = handle move non_decimal {
        Result::Ok(_) => {
            advance(&mut *value, 2);
            skip_underscores(&mut *value);
            let digits_start = value.cursor;
            handle peek(&*value, 0) {
                Result::Ok(byte) => handle digit_valid(byte, base_code) {
                    Result::Ok(_) => scan_digits(&mut *value, base_code, digits_start),
                    Result::Err(_) => Result::Err(
                        lex_error(LexErrorKind::ExpectedDigits, 6, start, value.cursor)
                    )
                },
                Result::Err(_) => Result::Err(
                    lex_error(LexErrorKind::ExpectedDigits, 6, start, value.cursor)
                )
            }
        },
        Result::Err(_) => scan_digits(&mut *value, base_code, start)
    };
    handle move digits {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(digit_span) => {
            let fraction = scan_fraction(&mut *value, base_code, move after_projection_dot);
            handle move fraction {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(fraction_span) => {
                    let exponent = scan_exponent(&mut *value, base_code);
                    handle move exponent {
                        Result::Err(error) => Result::Err(move error),
                        Result::Ok(exponent_span) => {
                            handle peek(&*value, 0) {
                                Result::Ok(byte) => {
                                    handle byte_is_alphanumeric(byte) {
                                        Result::Ok(_) => Result::Err(
                                            lex_error(
                                                LexErrorKind::InvalidDigit, 4,
                                                value.cursor,
                                                value.cursor + usize_value(1)
                                            )
                                        ),
                                        Result::Err(_) => handle byte == byte_value(95) {
                                            Result::Ok(_) => Result::Err(
                                                lex_error(
                                                    LexErrorKind::InvalidDigit, 4,
                                                    value.cursor,
                                                    value.cursor + usize_value(1)
                                                )
                                            ),
                                            Result::Err(_) => finish_number(
                                                move value,
                                                start,
                                                move base,
                                                base_code,
                                                move digit_span,
                                                move fraction_span,
                                                move exponent_span
                                            )
                                        }
                                    }
                                },
                                Result::Err(_) => finish_number(
                                    move value,
                                    start,
                                    move base,
                                    base_code,
                                    move digit_span,
                                    move fraction_span,
                                    move exponent_span
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}

scan_fraction(
    value: &mut Lexer,
    base_code: u8,
    after_projection_dot: Bool
) -> Result<Option<Span>, LexError> {
    let decimal = base_code == byte_value(3);
    handle move decimal {
        Result::Err(_) => Result::Ok(None),
        Result::Ok(_) => handle move after_projection_dot {
            Result::Ok(_) => Result::Ok(None),
            Result::Err(_) => handle peek_is(&*value, 0, 46) {
                Result::Ok(_) => handle peek(&*value, 1) {
                    Result::Ok(next) => handle byte_is_digit(move next) {
                        Result::Ok(_) => {
                            advance(&mut *value, 1);
                            let start = value.cursor;
                            handle scan_digits(move value, base_code, start) {
                                Result::Ok(found) => Result::Ok(Option::Some(move found)),
                                Result::Err(error) => Result::Err(move error)
                            }
                        },
                        Result::Err(_) => Result::Ok(None)
                    },
                    Result::Err(_) => Result::Ok(None)
                },
                Result::Err(_) => Result::Ok(None)
            }
        }
    }
}

scan_exponent(
    value: &mut Lexer,
    base_code: u8
) -> Result<Option<NumberExponent>, LexError> {
    let decimal = base_code == byte_value(3);
    handle move decimal {
        Result::Err(_) => Result::Ok(None),
        Result::Ok(_) => handle peek(&*value, 0) {
            Result::Ok(marker) => handle marker {
                101 => scan_exponent_after_marker(move value),
                69 => scan_exponent_after_marker(move value),
                _ => Result::Ok(None)
            },
            Result::Err(_) => Result::Ok(None)
        }
    }
}

scan_exponent_after_marker(value: &mut Lexer) -> Result<Option<NumberExponent>, LexError> {
    let marker = value.cursor;
    let sign = handle peek(&*value, 1) {
        Result::Ok(byte) => handle byte {
            43 => usize_value(1),
            45 => usize_value(1),
            _ => usize_value(0)
        },
        Result::Err(_) => usize_value(0)
    };
    let candidate = handle peek(&*value, usize_value(1) + sign) {
        Result::Ok(byte) => handle byte_is_digit(byte) {
            Result::Ok(_) => true,
            Result::Err(_) => byte == byte_value(95)
        },
        Result::Err(_) => false
    };
    handle move candidate {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::MalformedFloatExponent, 7,
                marker,
                marker + usize_value(1) + sign
            )
        ),
        Result::Ok(_) => {
            advance(&mut *value, 1);
            let negative = handle peek_is(&*value, 0, 45) {
                Result::Ok(_) => true,
                Result::Err(_) => false
            };
            advance(&mut *value, move sign);
            let start = value.cursor;
            handle scan_digits(move value, 3, start) {
                Result::Ok(found) => Result::Ok(
                    Option::Some(NumberExponent {
                        negative: move negative,
                        digits: move found
                    })
                ),
                Result::Err(error) => Result::Err(move error)
            }
        }
    }
}

finish_number(
    value: &mut Lexer,
    start: usize,
    base: NumberBase,
    base_code: u8,
    digits: Span,
    fraction: Option<Span>,
    exponent: Option<NumberExponent>
) -> Result<(), LexError> {
    let spelling = span(start, value.cursor);
    push(
        move value,
        TokenKind::Number(NumberToken {
            spelling: move spelling,
            base: move base,
            base_code: base_code,
            digits: move digits,
            fraction: move fraction,
            exponent: move exponent
        }),
        4,
        start
    );
    Result::Ok(())
}
hex_value(value: u8) -> u32 {
    handle byte_is_digit(value) {
        Result::Ok(_) => wrapping_convert_to_u32(value - 48),
        Result::Err(_) => handle byte_is_lower(value) {
            Result::Ok(_) => wrapping_convert_to_u32(value - 97) + u32_value(10),
            Result::Err(_) => wrapping_convert_to_u32(value - 65) + u32_value(10)
        }
    }
}

hex_pair(value: &mut Lexer, backslash: usize) -> Result<u8, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(first) => handle byte_is_hex(first) {
            Result::Ok(_) => handle peek(&*value, 1) {
                Result::Ok(second) => handle byte_is_hex(second) {
                    Result::Ok(_) => {
                        advance(move value, 2);
                        Result::Ok(
                            wrapping_convert_to_u8(
                                hex_value(first) * u32_value(16) + hex_value(second)
                            )
                        )
                    },
                    Result::Err(_) => Result::Err(
                        lex_error(
                            LexErrorKind::MalformedHexEscape, 11,
                            backslash,
                            value.cursor + usize_value(1)
                        )
                    )
                },
                Result::Err(_) => Result::Err(
                    lex_error(
                        LexErrorKind::MalformedHexEscape, 11,
                        backslash,
                        value.cursor
                    )
                )
            },
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::MalformedHexEscape, 11,
                    backslash,
                    value.cursor
                )
            )
        },
        Result::Err(_) => Result::Err(
            lex_error(LexErrorKind::MalformedHexEscape, 11, backslash, value.cursor)
        )
    }
}

unicode_digits(
    value: &mut Lexer,
    backslash: usize,
    scalar: u32,
    digits: usize
) -> Result<char, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(125) => {
            advance(&mut *value, 1);
            handle digits == 0 {
                Result::Ok(_) => Result::Err(
                    lex_error(
                        LexErrorKind::MalformedUnicodeEscape, 12,
                        backslash,
                        value.cursor
                    )
                ),
                Result::Err(_) => handle char_from_u32(move scalar) {
                    Result::Ok(character) => scalar_ok(move character),
                    Result::Err(_) => Result::Err(
                        lex_error(
                            LexErrorKind::InvalidUnicodeScalar, 14,
                            backslash,
                            value.cursor
                        )
                    )
                }
            }
        },
        Result::Ok(byte) => handle byte_is_hex(byte) {
            Result::Ok(_) => handle digits == 6 {
                Result::Ok(_) => Result::Err(
                    lex_error(
                        LexErrorKind::MalformedUnicodeEscape, 12,
                        backslash,
                        value.cursor + usize_value(1)
                    )
                ),
                Result::Err(_) => {
                    advance(&mut *value, 1);
                    unicode_digits(
                        move value,
                        backslash,
                        scalar * 16 + hex_value(byte),
                        digits + 1
                    )
                }
            },
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::MalformedUnicodeEscape, 12,
                    value.cursor,
                    value.cursor + usize_value(1)
                )
            )
        },
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedUnicodeEscape, 13,
                backslash,
                Bytes::len(&value.bytes)
            )
        )
    }
}

unicode_escape(value: &mut Lexer, backslash: usize) -> Result<char, LexError> {
    handle peek_is(&*value, 0, 123) {
        Result::Ok(_) => {
            advance(&mut *value, 1);
            unicode_digits(move value, backslash, 0, 0)
        },
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::MalformedUnicodeEscape, 12,
                backslash,
                value.cursor
            )
        )
    }
}

scalar_ok(value: char) -> Result<char, LexError> { Result::Ok(move value) }

scalar_escape(value: &mut Lexer, backslash: usize) -> Result<char, LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedEscape, 8,
                backslash,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(selector) => {
            advance(&mut *value, 1);
            handle move selector {
                110 => scalar_ok('\n'),
                114 => scalar_ok('\r'),
                116 => scalar_ok('\t'),
                48 => scalar_ok('\0'),
                34 => scalar_ok('"'),
                39 => scalar_ok('\''),
                92 => scalar_ok('\\'),
                120 => handle hex_pair(&mut *value, backslash) {
                    Result::Ok(byte) => handle split_byte(move byte, byte_value(127)) {
                        Result::Ok(byte) => handle char_from_u32(
                            wrapping_convert_to_u32(move byte)
                        ) {
                            Result::Ok(character) => scalar_ok(move character),
                            Result::Err(_) => unreachable()
                        },
                        Result::Err(_) => Result::Err(
                            lex_error(
                                LexErrorKind::InvalidCharacterEscape, 9,
                                backslash,
                                value.cursor
                            )
                        )
                    },
                    Result::Err(error) => Result::Err(move error)
                },
                117 => unicode_escape(move value, backslash),
                _ => Result::Err(
                    lex_error(
                        LexErrorKind::UnknownEscape, 10,
                        backslash,
                        value.cursor
                    )
                )
            }
        }
    }
}

byte_ok(value: u8) -> Result<u8, LexError> { Result::Ok(move value) }

byte_escape(value: &mut Lexer, backslash: usize) -> Result<u8, LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedEscape, 8,
                backslash,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(selector) => {
            advance(&mut *value, 1);
            handle move selector {
                110 => byte_ok(10),
                114 => byte_ok(13),
                116 => byte_ok(9),
                48 => byte_ok(0),
                34 => byte_ok(34),
                39 => byte_ok(39),
                92 => byte_ok(92),
                120 => hex_pair(move value, backslash),
                117 => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteEscape, 15,
                        backslash,
                        value.cursor
                    )
                ),
                _ => Result::Err(
                    lex_error(
                        LexErrorKind::UnknownEscape, 10,
                        backslash,
                        value.cursor
                    )
                )
            }
        }
    }
}

scan_string_tail(
    value: &mut Lexer,
    start: usize,
    decoded: &mut StringBuilder
) -> Result<(), LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedString, 16,
                start,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(34) => {
            advance(move value, 1);
            Result::Ok(())
        },
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            handle scalar_escape(&mut *value, move backslash) {
                Result::Ok(character) => {
                    StringBuilder::append_char(&mut *decoded, move character);
                    scan_string_tail(move value, start, move decoded)
                },
                Result::Err(error) => Result::Err(move error)
            }
        },
        Result::Ok(_) => {
            let cursor = value.cursor;
            let bytes = value.bytes;
            handle char_decode_utf8(&bytes, cursor) {
            Result::Ok(decoded_char) => {
                (*value).cursor = decoded_char.next;
                StringBuilder::append_char(&mut *decoded, move decoded_char.value);
                scan_string_tail(move value, start, move decoded)
            },
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::UnexpectedCharacter, 1,
                    value.cursor,
                    value.cursor + usize_value(1)
                )
            )
            }
        }
    }
}

scan_string(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 1);
    let decoded = StringBuilder::new();
    handle scan_string_tail(&mut *value, start, &mut decoded) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(_) => handle StringBuilder::finish(move decoded) {
            Result::Ok(text) => {
                let id = intern_text(&mut *value, move text);
                push(move value, TokenKind::String(move id), 5, start);
                Result::Ok(())
            },
            Result::Err(_) => unreachable()
        }
    }
}

scan_byte_string_tail(
    value: &mut Lexer,
    start: usize,
    decoded: &mut Vec<u8>
) -> Result<(), LexError> {
    let bytes = value.bytes;
    let cursor = value.cursor;
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedByteString, 18,
                start,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(34) => {
            advance(move value, 1);
            Result::Ok(())
        },
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            handle byte_escape(&mut *value, move backslash) {
                Result::Ok(byte) => {
                    Vec::push(&mut *decoded, move byte);
                    scan_byte_string_tail(move value, start, move decoded)
                },
                Result::Err(error) => Result::Err(move error)
            }
        },
        Result::Ok(byte) => handle split_byte(move byte, byte_value(127)) {
            Result::Ok(byte) => {
                advance(&mut *value, 1);
                Vec::push(&mut *decoded, move byte);
                scan_byte_string_tail(move value, start, move decoded)
            },
            Result::Err(_) => handle char_decode_utf8(&bytes, cursor) {
                Result::Ok(character) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteStringCharacter, 17,
                        value.cursor,
                        character.next
                    )
                ),
                Result::Err(_) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteStringCharacter, 17,
                        value.cursor,
                        value.cursor + usize_value(1)
                    )
                )
            }
        }
    }
}

scan_byte_string(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 2);
    let decoded = Vec::new();
    handle scan_byte_string_tail(&mut *value, start, &mut decoded) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(_) => {
            push(
                move value,
                TokenKind::ByteString(Bytes::from_vec(move decoded)),
                8,
                start
            );
            Result::Ok(())
        }
    }
}

scan_byte_literal(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 2);
    let bytes = value.bytes;
    let content_cursor = value.cursor;
    let decoded = handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedByteLiteral, 21,
                start,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(39) => Result::Err(
            lex_error(
                LexErrorKind::EmptyByteLiteral, 19,
                start,
                value.cursor + usize_value(1)
            )
        ),
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            byte_escape(&mut *value, move backslash)
        },
        Result::Ok(byte) => handle split_byte(move byte, byte_value(127)) {
            Result::Ok(byte) => {
                advance(&mut *value, 1);
                byte_ok(move byte)
            },
            Result::Err(_) => handle char_decode_utf8(&bytes, content_cursor) {
                Result::Ok(character) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteLiteral, 20,
                        value.cursor,
                        character.next
                    )
                ),
                Result::Err(_) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteLiteral, 20,
                        value.cursor,
                        value.cursor + usize_value(1)
                    )
                )
            }
        }
    };
    handle move decoded {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(byte) => handle peek_is(&*value, 0, 39) {
            Result::Ok(_) => {
                advance(&mut *value, 1);
                push(move value, TokenKind::Byte(move byte), 7, start);
                Result::Ok(())
            },
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::UnfinishedByteLiteral, 21,
                    start,
                    value.cursor
                )
            )
        }
    }
}

scan_char_or_lifetime(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    handle peek(&*value, 1) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::InvalidLifetimeIdentifier, 24,
                start,
                start + usize_value(1)
            )
        ),
        Result::Ok(92) => {
            advance(&mut *value, 2);
            handle scalar_escape(&mut *value, start + usize_value(1)) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(character) => handle peek_is(&*value, 0, 39) {
                    Result::Ok(_) => {
                        advance(&mut *value, 1);
                        push(move value, TokenKind::Char(move character), 6, start);
                        Result::Ok(())
                    },
                    Result::Err(_) => Result::Err(
                        lex_error(
                            LexErrorKind::UnfinishedCharacterLiteral, 22,
                            start,
                            value.cursor
                        )
                    )
                }
            }
        },
        Result::Ok(39) => Result::Err(
            lex_error(
                LexErrorKind::EmptyCharacterLiteral, 23,
                start,
                start + usize_value(2)
            )
        ),
        Result::Ok(_) => {
            let bytes = value.bytes;
            handle char_decode_utf8(&bytes, start + usize_value(1)) {
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::InvalidLifetimeIdentifier, 24,
                    start,
                    start + usize_value(1)
                )
            ),
            Result::Ok(character) => handle Bytes::get(&bytes, character.next) {
                Result::Ok(39) => {
                    (*value).cursor = character.next + 1;
                    push(move value, TokenKind::Char(move character.value), 6, start);
                    Result::Ok(())
                },
                _ => scan_lifetime(move value, start)
            }
            }
        }
    }
}

scan_lifetime_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => handle byte_is_alphanumeric(byte) {
            Result::Ok(_) => {
                advance(&mut *value, 1);
                scan_lifetime_tail(move value)
            },
            Result::Err(_) => handle byte == byte_value(95) {
                Result::Ok(_) => {
                    advance(&mut *value, 1);
                    scan_lifetime_tail(move value)
                },
                Result::Err(_) => ()
            }
        },
        Result::Err(_) => ()
    }
}

scan_lifetime(value: &mut Lexer, start: usize) -> Result<(), LexError> {
    (*value).cursor = start + usize_value(1);
    handle peek(&*value, 0) {
        Result::Ok(byte) => handle byte_is_word_start(byte) {
            Result::Ok(_) => {
                advance(&mut *value, 1);
                scan_lifetime_tail(&mut *value);
                handle peek_is(&*value, 0, 39) {
                    Result::Ok(_) => Result::Err(
                        lex_error(
                            LexErrorKind::InvalidCharacterLiteral, 25,
                            start,
                            value.cursor + usize_value(1)
                        )
                    ),
                    Result::Err(_) => {
                        let end = value.cursor;
                        let id = intern_slice(&mut *value, start, move end);
                        push(move value, TokenKind::Lifetime(move id), 3, start);
                        Result::Ok(())
                    }
                }
            },
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::InvalidLifetimeIdentifier, 24,
                    start,
                    value.cursor
                )
            )
        },
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::InvalidLifetimeIdentifier, 24,
                start,
                value.cursor
            )
        )
    }
}

// Keeping the driver in this file makes this slice independently executable by
// both backends.

pub lex(source: &String) -> Result<LexedSource, LexError> {
    let bytes = String::as_bytes(source);
    handle checked_usize_to_u32(Bytes::len(&bytes)) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::ResourceLimit, 26,
                0,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(_) => {
            let lexer = Lexer {
                source: *source,
                bytes: move bytes,
                cursor: 0,
                tokens: Vec::new(),
                lexemes: Interner::new(),
                after_projection_dot: false
            };
            run(move lexer)
        }
    }
}

run(value: Lexer) -> Result<LexedSource, LexError> {
    let length = Bytes::len(&value.bytes);
    handle value.cursor < length {
        Result::Ok(_) => run_one(move value),
        Result::Err(_) => {
            let eof = Token {
                kind: TokenKind::Eof,
                code: 41,
                keyword_code: 0,
                span: span(
                    Bytes::len(&value.bytes),
                    Bytes::len(&value.bytes)
                )
            };
            Vec::push(&mut value.tokens, move eof);
            Result::Ok(LexedSource {
                tokens: move value.tokens,
                lexemes: move value.lexemes
            })
        }
    }
}

run_one(value: Lexer) -> Result<LexedSource, LexError> {
    let start = value.cursor;
    let byte = handle peek(&value, 0) {
        Result::Ok(found) => move found,
        Result::Err(_) => unreachable()
    };
    handle byte_is_whitespace(byte) {
        Result::Ok(_) => {
            advance(&mut value, 1);
            run(move value)
        },
        Result::Err(_) => run_byte(move value, move byte, move start)
    }
}

run_byte(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(58)) {
        Result::Ok(byte) => run_byte_low(move value, move byte, move start),
        Result::Err(byte) => run_byte_high(move value, move byte, move start)
    }
}

run_byte_low(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(39)) {
        Result::Ok(byte) => run_byte_low_39(move value, move byte, move start),
        Result::Err(byte) => handle split_byte(move byte, byte_value(47)) {
            Result::Ok(byte) => run_byte_low_47(move value, move byte, move start),
            Result::Err(byte) => run_byte_low_58(move value, move byte, move start)
        }
    }
}

run_byte_low_39(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        34 => run_string_token(move value),
        36 => run_dollar_token(move value, move start),
        39 => run_char_or_lifetime_token(move value),
        _ => run_general_byte(move value, move byte, move start)
    }
}

run_byte_low_47(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(44)) {
        Result::Ok(byte) => run_byte_low_44(move value, move byte, move start),
        Result::Err(byte) => handle byte {
            47 => run_slash_token(move value, move start),
            _ => run_general_byte(move value, move byte, move start)
        }
    }
}

run_byte_low_44(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        40 => run_structural(move value, TokenKind::LParen, 11, move start),
        41 => run_structural(move value, TokenKind::RParen, 12, move start),
        44 => run_structural(move value, TokenKind::Comma, 17, move start),
        _ => run_general_byte(move value, move byte, move start)
    }
}

run_byte_low_58(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        58 => run_colon_token(move value, move start),
        _ => run_general_byte(move value, move byte, move start)
    }
}

run_byte_high(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(93)) {
        Result::Ok(byte) => run_byte_high_93(move value, move byte, move start),
        Result::Err(byte) => run_byte_above_93(move value, move byte, move start)
    }
}

run_byte_high_93(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(64)) {
        Result::Ok(byte) => handle byte {
            59 => run_structural(move value, TokenKind::Semicolon, 22, move start),
            64 => run_label_token(move value),
            _ => run_general_byte(move value, move byte, move start)
        },
        Result::Err(byte) => handle byte {
            91 => run_structural(move value, TokenKind::LBracket, 15, move start),
            93 => run_structural(move value, TokenKind::RBracket, 16, move start),
            _ => run_general_byte(move value, move byte, move start)
        }
    }
}

run_byte_above_93(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(98)) {
        Result::Ok(byte) => handle byte {
            98 => run_byte_prefix(move value),
            _ => run_general_byte(move value, move byte, move start)
        },
        Result::Err(byte) => handle byte {
            123 => run_structural(move value, TokenKind::LBrace, 13, move start),
            125 => run_structural(move value, TokenKind::RBrace, 14, move start),
            _ => run_general_byte(move value, move byte, move start)
        }
    }
}

run_slash_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    handle peek_is(&value, 1, 47) {
        Result::Ok(_) => {
            scan_line_comment(&mut value);
            run(move value)
        },
        Result::Err(_) => handle peek_is(&value, 1, 42) {
            Result::Ok(_) => {
                advance(&mut value, 2);
                handle scan_block_comment(&mut value, move start, 1) {
                    Result::Ok(_) => run(move value),
                    Result::Err(error) => Result::Err(move error)
                }
            },
            Result::Err(_) => run_structural(
                move value,
                TokenKind::Slash,
                25,
                move start
            )
        }
    }
}

run_dollar_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    run_structural(move value, TokenKind::Dollar, 40, move start)
}

run_colon_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    advance(&mut value, 1);
    handle peek_is(&value, 0, 58) {
        Result::Ok(_) => {
            advance(&mut value, 1);
            push(&mut value, TokenKind::DoubleColon, 19, move start)
        },
        Result::Err(_) => push(&mut value, TokenKind::Colon, 18, move start)
    };
    run(move value)
}

run_label_token(value: Lexer) -> Result<LexedSource, LexError> {
    handle scan_label(&mut value) {
        Result::Ok(_) => run(move value),
        Result::Err(error) => Result::Err(move error)
    }
}

run_string_token(value: Lexer) -> Result<LexedSource, LexError> {
    handle scan_string(&mut value) {
        Result::Ok(_) => run(move value),
        Result::Err(error) => Result::Err(move error)
    }
}

run_char_or_lifetime_token(value: Lexer) -> Result<LexedSource, LexError> {
    handle scan_char_or_lifetime(&mut value) {
        Result::Ok(_) => run(move value),
        Result::Err(error) => Result::Err(move error)
    }
}

run_byte_prefix(value: Lexer) -> Result<LexedSource, LexError> {
    handle peek(&value, 1) {
        Result::Ok(34) => handle scan_byte_string(&mut value) {
            Result::Ok(_) => run(move value),
            Result::Err(error) => Result::Err(move error)
        },
        Result::Ok(39) => handle scan_byte_literal(&mut value) {
            Result::Ok(_) => run(move value),
            Result::Err(error) => Result::Err(move error)
        },
        _ => {
            scan_word(&mut value);
            run(move value)
        }
    }
}

run_general_byte(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte_is_digit(byte) {
        Result::Ok(_) => handle scan_number(&mut value) {
            Result::Ok(_) => run(move value),
            Result::Err(error) => Result::Err(move error)
        },
        Result::Err(_) => handle byte_is_word_start(byte) {
            Result::Ok(_) => {
                scan_word(&mut value);
                run(move value)
            },
            Result::Err(_) => handle byte_is_operator(byte) {
                Result::Ok(_) => {
                    scan_operator(&mut value);
                    run(move value)
                },
                Result::Err(_) => handle char_decode_utf8(&value.bytes, start) {
                    Result::Ok(character) => Result::Err(
                        lex_error(
                            LexErrorKind::UnexpectedCharacter, 1,
                            start,
                            character.next
                        )
                    ),
                    Result::Err(_) => Result::Err(
                        lex_error(
                            LexErrorKind::UnexpectedCharacter, 1,
                            start,
                            start + usize_value(1)
                        )
                    )
                }
            }
        }
    }
}

run_structural(
    value: Lexer,
    kind: TokenKind,
    code: u16,
    start: usize
) -> Result<LexedSource, LexError> {
    advance(&mut value, 1);
    push(&mut value, move kind, move code, move start);
    run(move value)
}

write_bytes(output: &mut ByteBuf, bytes: &Bytes) {
    ByteBuf::write_u32_le(
        &mut *output,
        wrapping_convert_to_u32(Bytes::len(bytes))
    );
    ByteBuf::append_bytes(move output, bytes)
}

write_string(output: &mut ByteBuf, text: &String) {
    let bytes = String::as_bytes(text);
    write_bytes(move output, &bytes)
}

write_source_span(output: &mut ByteBuf, source: &String, value: &Span) {
    let text = text_slice(source, value.start, value.end);
    write_string(move output, &text)
}

normalized_span_len(bytes: &Bytes, cursor: usize, end: usize, count: usize) -> usize {
    handle cursor < end {
        Result::Ok(_) => {
            let byte = handle Bytes::get(bytes, cursor) {
                Result::Ok(found) => byte_value(move found),
                Result::Err(_) => unreachable()
            };
            let next = handle byte == byte_value(95) {
                Result::Ok(_) => move count,
                Result::Err(_) => count + usize_value(1)
            };
            normalized_span_len(bytes, cursor + usize_value(1), end, move next)
        },
        Result::Err(_) => move count
    }
}

write_normalized_span_bytes(
    output: &mut ByteBuf,
    bytes: &Bytes,
    cursor: usize,
    end: usize
) {
    handle cursor < end {
        Result::Ok(_) => {
            let byte = handle Bytes::get(bytes, cursor) {
                Result::Ok(found) => byte_value(move found),
                Result::Err(_) => unreachable()
            };
            handle byte == byte_value(95) {
                Result::Ok(_) => (),
                Result::Err(_) => ByteBuf::push(&mut *output, move byte)
            };
            write_normalized_span_bytes(
                move output,
                bytes,
                cursor + usize_value(1),
                end
            )
        },
        Result::Err(_) => ()
    }
}

write_normalized_span(
    output: &mut ByteBuf,
    source: &String,
    value: &Span
) {
    let bytes = String::as_bytes(source);
    ByteBuf::write_u32_le(
        &mut *output,
        wrapping_convert_to_u32(
            normalized_span_len(&bytes, value.start, value.end, 0)
        )
    );
    write_normalized_span_bytes(move output, &bytes, value.start, value.end)
}

base_code(value: &NumberToken) -> u8 {
    value.base_code
}

lexeme_text(value: &LexedSource, id: &Id<String>) -> String {
    handle Interner::get(&value.lexemes, *id) {
        Result::Ok(text) => *text,
        Result::Err(_) => unreachable()
    }
}

write_lexeme(output: &mut ByteBuf, value: &LexedSource, id: &Id<String>) {
    let text = lexeme_text(value, id);
    write_string(move output, &text)
}

write_number(
    output: &mut ByteBuf,
    source: &String,
    value: &NumberToken
) {
    write_source_span(&mut *output, source, &value.spelling);
    ByteBuf::push(&mut *output, base_code(value));
    write_normalized_span(&mut *output, source, &value.digits);
    handle Option::as_ref(&value.fraction) {
        Result::Ok(fraction) => {
            ByteBuf::push(&mut *output, 1);
            write_normalized_span(&mut *output, source, move fraction)
        },
        Result::Err(_) => ByteBuf::push(&mut *output, 0)
    };
    handle Option::as_ref(&value.exponent) {
        Result::Ok(exponent) => {
            let negative = exponent_negative(exponent);
            let digits = exponent_digits(exponent);
            ByteBuf::push(&mut *output, 1);
            ByteBuf::push(&mut *output, wrapping_convert_to_u8(
                bool_value(move negative)
            ));
            write_normalized_span(move output, source, &digits)
        },
        Result::Err(_) => ByteBuf::push(move output, 0)
    }
}

write_token_payload(
    output: &mut ByteBuf,
    source: &String,
    lexed: &LexedSource,
    token: &Token
) {
    handle token.code <= 9 {
        Result::Ok(_) => handle *token_kind(token) {
            TokenKind::Ident(id) => write_lexeme(move output, lexed, &id),
            TokenKind::Keyword(_) => ByteBuf::push(move output, token.keyword_code),
            TokenKind::Lifetime(id) => write_lexeme(move output, lexed, &id),
            TokenKind::Number(number) => write_number(move output, source, &number),
            TokenKind::String(id) => write_lexeme(move output, lexed, &id),
            TokenKind::Char(character) => ByteBuf::write_u32_le(
                move output,
                char_to_u32(move character)
            ),
            TokenKind::Byte(byte) => ByteBuf::push(move output, move byte),
            TokenKind::ByteString(bytes) => write_bytes(move output, &bytes),
            TokenKind::Label(id) => write_lexeme(move output, lexed, &id),
            _ => unreachable()
        },
        Result::Err(_) => handle token.code == 10 {
            Result::Ok(_) => handle *token_kind(token) {
                TokenKind::Operator(id) => write_lexeme(move output, lexed, &id),
                _ => unreachable()
            },
            Result::Err(_) => ()
        }
    }
}

write_tokens(
    output: &mut ByteBuf,
    source: &String,
    value: &LexedSource,
    index: usize
) {
    handle index < Vec::len(&value.tokens) {
        Result::Ok(_) => {
            let token = Vec::index(&value.tokens, index);
            ByteBuf::write_u16_le(&mut *output, token.code);
            ByteBuf::write_u64_le(
                &mut *output,
                wrapping_convert_to_u64(token.span.start)
            );
            ByteBuf::write_u64_le(
                &mut *output,
                wrapping_convert_to_u64(token.span.end)
            );
            write_token_payload(&mut *output, source, value, move token);
            write_tokens(move output, source, value, index + usize_value(1))
        },
        Result::Err(_) => ()
    }
}

encode_result(
    output: &mut ByteBuf,
    source: &String,
    result: Result<LexedSource, LexError>
) {
    handle move result {
        Result::Err(error) => {
            ByteBuf::push(&mut *output, 1);
            ByteBuf::write_u16_le(&mut *output, error.code);
            ByteBuf::write_u64_le(&mut *output, wrapping_convert_to_u64(error.span.start));
            ByteBuf::write_u64_le(move output, wrapping_convert_to_u64(error.span.end))
        },
        Result::Ok(lexed) => {
            ByteBuf::push(&mut *output, 0);
            ByteBuf::write_u32_le(
                &mut *output,
                wrapping_convert_to_u32(Vec::len(&lexed.tokens))
            );
            write_tokens(move output, source, &lexed, 0)
        }
    }
}

process_inputs(arguments: &Vec<String>, index: usize, output: &mut ByteBuf) / FileRead {
    handle index < Vec::len(arguments) {
        Result::Ok(_) => {
            let path = *Vec::index(arguments, index);
            let bytes = read_file(move path);
            handle String::from_utf8(move bytes) {
                Result::Ok(source) => encode_result(
                    &mut *output,
                    &source,
                    lex(&source)
                ),
                Result::Err(_) => {
                    ByteBuf::push(&mut *output, 2)
                }
            };
            process_inputs(arguments, index + usize_value(1), move output)
        },
        Result::Err(_) => ()
    }
}

usize_value(value: usize) -> usize {
    value
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    let argument_count = Vec::len(&arguments);
    handle argument_count < usize_value(2) {
        Result::Ok(_) => write_diagnostic(
            "usage: grandiose-self-host <output> <input>..."
        ),
        Result::Err(_) => {
            let output_path = *Vec::index(&arguments, 0);
            let encoded = ByteBuf::new();
            ByteBuf::write_u32_le(
                &mut encoded,
                wrapping_convert_to_u32(
                    argument_count - usize_value(1)
                )
            );
            process_inputs(&arguments, 1, &mut encoded);
            write_file(move output_path, ByteBuf::finish(move encoded))
        }
    }
}
