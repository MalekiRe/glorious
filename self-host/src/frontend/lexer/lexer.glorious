// The first executable slice of the self-hosted compiler. This is the source
// ingestion boundary used by the future declaration scanner and body parser.

pub struct Span { start: usize, end: usize }

impl Use<[0, *]> for Span {}

pub enum Keyword {
    Cancel,
    Effect,
    Enum,
    Handle,
    Impl,
    Is,
    Let,
    Perform,
    Resume,
    Struct,
    Tail,
    Trait,
    Type,
    Where
}

pub enum NumberBase { Binary, Octal, Decimal, Hex }

pub struct NumberExponent {
    negative: Bool,
    digits: Span
}

pub struct NumberToken {
    spelling: Span,
    base: NumberBase,
    digits: Span,
    fraction: Option<Span>,
    exponent: Option<NumberExponent>
}

pub enum TokenKind {
    Ident(Id<String>),
    Keyword(Keyword),
    Lifetime(Id<String>),
    Number(NumberToken),
    String(Id<String>),
    Char(char),
    Byte(u8),
    ByteString(Bytes),
    Label(Id<String>),
    Operator(Id<String>),
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Colon,
    DoubleColon,
    DotDot,
    Dot,
    Semicolon,
    Arrow,
    FatArrow,
    Slash,
    Plus,
    Minus,
    Star,
    Percent,
    Pipe,
    Eq,
    EqEq,
    BangEq,
    Lt,
    LtEq,
    Gt,
    GtEq,
    Amp,
    Bang,
    Dollar,
    Eof
}

impl Use<[0, *]> for TokenKind {}

pub enum TokenPattern {
    Ident,
    LParen,
    RParen,
    LBrace,
    RBrace,
    Comma,
    Colon,
    DoubleColon,
    Dot,
    Semicolon,
    Arrow,
    FatArrow,
    Slash,
    Pipe,
    Eq,
    Lt,
    Gt,
    Amp,
    Bang
}

impl Use<[0, *]> for TokenPattern {}

token_pattern_code(pattern: TokenPattern) -> u16 {
    handle pattern {
        TokenPattern::Ident => 1,
        TokenPattern::LParen => 11,
        TokenPattern::RParen => 12,
        TokenPattern::LBrace => 13,
        TokenPattern::RBrace => 14,
        TokenPattern::Comma => 17,
        TokenPattern::Colon => 18,
        TokenPattern::DoubleColon => 19,
        TokenPattern::Dot => 21,
        TokenPattern::Semicolon => 22,
        TokenPattern::Arrow => 23,
        TokenPattern::FatArrow => 24,
        TokenPattern::Slash => 25,
        TokenPattern::Pipe => 30,
        TokenPattern::Eq => 31,
        TokenPattern::Lt => 34,
        TokenPattern::Gt => 36,
        TokenPattern::Amp => 38,
        TokenPattern::Bang => 39
    }
}

pub struct Token { kind: TokenKind, span: Span }

pub struct LexedSource {
    tokens: Vec<Token>,
    lexemes: Interner<String>
}

pub enum LexErrorKind {
    UnexpectedCharacter,
    UnfinishedComment,
    InvalidLabel,
    InvalidDigit,
    MisplacedDigitSeparator,
    ExpectedDigits,
    MalformedFloatExponent,
    UnfinishedEscape,
    InvalidCharacterEscape,
    UnknownEscape,
    MalformedHexEscape,
    MalformedUnicodeEscape,
    UnfinishedUnicodeEscape,
    InvalidUnicodeScalar,
    InvalidByteEscape,
    UnfinishedString,
    InvalidByteStringCharacter,
    UnfinishedByteString,
    EmptyByteLiteral,
    InvalidByteLiteral,
    UnfinishedByteLiteral,
    UnfinishedCharacterLiteral,
    EmptyCharacterLiteral,
    InvalidLifetimeIdentifier,
    InvalidCharacterLiteral,
    ResourceLimit
}

pub struct LexError { kind: LexErrorKind, span: Span }

pub token_count(value: &LexedSource) -> usize { Vec::len(&value.tokens) }

pub token_at<'a>(value: &'a LexedSource, index: usize) -> Option<&'a Token> {
    Vec::get(&value.tokens, index)
}

pub token_kind(value: &Token) -> &TokenKind { &value.kind }

pub token_kind_at(value: &LexedSource, index: usize) -> TokenKind {
    let token = Vec::index(&value.tokens, index);
    *token_kind( token)
}

pub token_matches(value: &Token, pattern: TokenPattern) -> Bool {
    token_code(value) == token_pattern_code(pattern)
}

pub token_matches_at(
    value: &LexedSource,
    index: usize,
    pattern: TokenPattern
) -> Bool {
    handle token_at(value, index) {
        Result::Err(_) => false,
        Result::Ok(found) => token_matches(found, pattern)
    }
}

keyword_code(value: &Keyword) -> u8 {
    handle *value {
        Keyword::Cancel => 1,
        Keyword::Effect => 2,
        Keyword::Enum => 3,
        Keyword::Handle => 4,
        Keyword::Impl => 5,
        Keyword::Is => 6,
        Keyword::Let => 7,
        Keyword::Perform => 8,
        Keyword::Resume => 9,
        Keyword::Struct => 10,
        Keyword::Tail => 11,
        Keyword::Trait => 12,
        Keyword::Type => 13,
        Keyword::Where => 14
    }
}

pub token_code(value: &Token) -> u16 {
    handle value.kind {
        TokenKind::Ident(_) => 1,
        TokenKind::Keyword(_) => 2,
        TokenKind::Lifetime(_) => 3,
        TokenKind::Number(_) => 4,
        TokenKind::String(_) => 5,
        TokenKind::Char(_) => 6,
        TokenKind::Byte(_) => 7,
        TokenKind::ByteString(_) => 8,
        TokenKind::Label(_) => 9,
        TokenKind::Operator(_) => 10,
        TokenKind::LParen => 11,
        TokenKind::RParen => 12,
        TokenKind::LBrace => 13,
        TokenKind::RBrace => 14,
        TokenKind::LBracket => 15,
        TokenKind::RBracket => 16,
        TokenKind::Comma => 17,
        TokenKind::Colon => 18,
        TokenKind::DoubleColon => 19,
        TokenKind::DotDot => 20,
        TokenKind::Dot => 21,
        TokenKind::Semicolon => 22,
        TokenKind::Arrow => 23,
        TokenKind::FatArrow => 24,
        TokenKind::Slash => 25,
        TokenKind::Plus => 26,
        TokenKind::Minus => 27,
        TokenKind::Star => 28,
        TokenKind::Percent => 29,
        TokenKind::Pipe => 30,
        TokenKind::Eq => 31,
        TokenKind::EqEq => 32,
        TokenKind::BangEq => 33,
        TokenKind::Lt => 34,
        TokenKind::LtEq => 35,
        TokenKind::Gt => 36,
        TokenKind::GtEq => 37,
        TokenKind::Amp => 38,
        TokenKind::Bang => 39,
        TokenKind::Dollar => 40,
        TokenKind::Eof => 41
    }
}

pub token_keyword_code(value: &Token) -> u8 {
    handle value.kind {
        TokenKind::Keyword(found) => keyword_code(&found),
        _ => 0
    }
}

pub operator_symbol_at(value: &LexedSource, index: usize) -> Bool {
    handle token_kind_at(value, index) {
        TokenKind::Operator(_) => true,
        TokenKind::Slash => true,
        TokenKind::Plus => true,
        TokenKind::Minus => true,
        TokenKind::Star => true,
        TokenKind::Percent => true,
        TokenKind::Pipe => true,
        TokenKind::Eq => true,
        TokenKind::EqEq => true,
        TokenKind::BangEq => true,
        TokenKind::Lt => true,
        TokenKind::LtEq => true,
        TokenKind::Gt => true,
        TokenKind::GtEq => true,
        TokenKind::Amp => true,
        TokenKind::Bang => true,
        _ => false
    }
}

pub operator_end(
    value: &LexedSource,
    cursor: usize,
    limit: usize,
    previous_end: usize
) -> usize {
    if(cursor < limit) {
        if(operator_symbol_at(value, cursor)) {
        let token = Vec::index(&value.tokens, cursor);
        if(previous_end == token.span.start) {
        operator_end(
        value,
        cursor + 1,
        limit,
        token.span.end
        )
        } else {
        cursor
        }

        } else {
        cursor
        }
    } else {
        cursor
    }
}

pub token_span(value: &Token) -> Span {
    Span { start: value.span.start, end: value.span.end }
}

pub span_start(value: &Span) -> usize { value.start }

pub span_end(value: &Span) -> usize { value.end }

pub number_spelling(value: &NumberToken) -> Span {
    Span { start: value.spelling.start, end: value.spelling.end }
}

pub number_base(value: &NumberToken) -> &NumberBase { &value.base }

pub number_base_code(value: &NumberToken) -> u8 {
    handle value.base {
        NumberBase::Binary => 1,
        NumberBase::Octal => 2,
        NumberBase::Decimal => 3,
        NumberBase::Hex => 4
    }
}

pub number_is_float(value: &NumberToken) -> Bool {
    (Option::as_ref(&value.fraction) is Result::Ok(_))
        or { (Option::as_ref(&value.exponent) is Result::Ok(_)) }
}

pub number_digits(value: &NumberToken) -> Span {
    Span { start: value.digits.start, end: value.digits.end }
}

pub number_fraction(value: &NumberToken) -> &Option<Span> { &value.fraction }

pub number_exponent(value: &NumberToken) -> &Option<NumberExponent> {
    &value.exponent
}

pub exponent_negative(value: &NumberExponent) -> Bool { value.negative }

pub exponent_digits(value: &NumberExponent) -> Span {
    Span { start: value.digits.start, end: value.digits.end }
}

pub lexeme<'a>(value: &'a LexedSource, id: Id<String>) -> Option<&'a String> {
    Interner::get(&value.lexemes, id)
}

pub lexeme_id(value: &LexedSource, spelling: &String) -> Option<Id<String>> {
    let index = Interner::string_index_or_len(&value.lexemes, spelling);
    if(index < Interner::len(&value.lexemes)) {
        Id::from_usize(index)
    } else {
        None
    }
}

pub error_kind(value: &LexError) -> &LexErrorKind { &value.kind }

pub error_span(value: &LexError) -> Span {
    Span { start: value.span.start, end: value.span.end }
}

struct Lexer {
    source: String,
    bytes: Bytes,
    cursor: usize,
    tokens: Vec<Token>,
    lexemes: Interner<String>,
    after_projection_dot: Bool
}

pub span(start: usize, end: usize) -> Span {
    Span { start: start, end: end }
}

lex_error(kind: LexErrorKind, start: usize, end: usize) -> LexError {
    LexError {
        kind:  kind,
        span: span( start,  end)
    }
}

bool_value(value: Bool) -> u32 {
    if(value) { 1 } else { 0 }
}

byte_value(value: u8) -> u8 {  value }

byte_at_most(value: &u8, upper: u8) -> Bool {
    *value <= upper
}

split_byte(value: u8, upper: u8) -> Result<u8, u8> {
    let retained = value;
    if(byte_at_most(&value, upper)) {
        Result::Ok(retained)
    } else {
        Result::Err(retained)
    }
}

byte_is_between(value: u8, low: u8, high: u8) -> Bool {
    low <= value and { value <= high }
}

byte_is_digit(value: u8) -> Bool { byte_is_between(value, 48, 57) }

byte_is_lower(value: u8) -> Bool { byte_is_between(value, 97, 122) }

byte_is_upper(value: u8) -> Bool { byte_is_between(value, 65, 90) }

byte_is_alpha(value: u8) -> Bool {
    byte_is_lower(value) or { byte_is_upper(value) }
}

byte_is_alphanumeric(value: u8) -> Bool {
    byte_is_alpha(value) or { byte_is_digit(value) }
}

byte_is_word_start(value: u8) -> Bool {
    byte_is_alpha(value) or { value == 95 }
}

byte_is_hex(value: u8) -> Bool {
    byte_is_digit(value)
        or { byte_is_between(value, 97, 102) }
        or { byte_is_between(value, 65, 70) }
}

byte_is_whitespace(value: u8) -> Bool {
    value == 32
        or { value == 9 }
        or { value == 10 }
        or { value == 13 }
        or { value == 11 }
        or { value == 12 }
}

operator_byte_mask() -> u128 {
    106338239682600310478164731729926946816
}

byte_is_operator(value: u8) -> Bool {
    if(value <= 126) {
        bit_and(
            shift_right(operator_byte_mask(), wrapping_convert_to_u32(value)),
            1
        ) != 0
    } else { false }
}

peek(value: &Lexer, offset: usize) -> Option<u8> {
    handle Bytes::get(&value.bytes, value.cursor + offset) {
        Result::Ok(found) => Option::Some( found),
        Result::Err(_) => None
    }
}

peek_is(value: &Lexer, offset: usize, expected: u8) -> Bool {
    if(peek(value, offset) is Result::Ok(actual)) {
        actual == expected
    } else {
        false
    }
}

advance(value: &mut Lexer, amount: usize) {
    (*value).cursor = value.cursor + amount;
}

text_slice_result(result: Result<String, TextRangeError>) -> String {
    handle result {
        Result::Ok(text) =>  text,
        Result::Err(_) => unreachable()
    }
}

interned_id(result: Result<Id<String>, String>) -> Id<String> {
    handle result {
        Result::Ok(id) =>  id,
        Result::Err(_) => unreachable()
    }
}

present_byte(result: Option<u8>) -> u8 {
    handle result {
        Result::Ok(byte) =>  byte,
        Result::Err(_) => unreachable()
    }
}

pub text_slice(source: &String, start: usize, end: usize) -> String {
    text_slice_result(
        String::slice(source, Range { start:  start, end:  end })
    )
}

source_slice(value: &Lexer, start: usize, end: usize) -> String {
    text_slice(&value.source, start, end)
}

intern_slice(value: &mut Lexer, start: usize, end: usize) -> Id<String> {
    let text = source_slice(&*value,  start,  end);
    handle Interner::intern_string(&mut value.lexemes, text) {
        Result::Ok(id) =>  id,
        // `lex` rejects a source longer than the u32 ID space. There can be no
        // more distinct source lexemes than source bytes, so exhaustion here
        // would contradict that checked boundary.
        Result::Err(_) => unreachable()
    }
}

intern_text(value: &mut Lexer, text: String) -> Id<String> {
    interned_id(Interner::intern_string(&mut value.lexemes, text))
}

push(value: &mut Lexer, kind: TokenKind, start: usize) {
    let after_dot = kind is TokenKind::Dot;
    let end = value.cursor;
    Vec::push(
        &mut value.tokens,
        Token {
            kind: kind,
            span: span(start, end)
        }
    );
    (*value).after_projection_dot =  after_dot;
}

push_keyword(value: &mut Lexer, found: Keyword, start: usize) {
    push(value, TokenKind::Keyword(found), start)
}

keyword_named(
    value: &String,
    spelling: &String,
    found: Keyword
) -> Option<Keyword> {
    if(String::eq(value, spelling)) {
        Option::Some(found)
    } else {
        None
    }
}

keyword(value: &String) -> Option<Keyword> {
    let bytes = String::as_bytes(value);
    handle Bytes::get(&bytes, 0) {
        Result::Ok(99) => keyword_named(value, &"cancel", Keyword::Cancel),
        Result::Ok(101) => if(String::eq(value, &"enum")) {
                               Option::Some(Keyword::Enum)
                           } else {
                               keyword_named(value, &"effect", Keyword::Effect)
                           },
        Result::Ok(104) => keyword_named(value, &"handle", Keyword::Handle),
        Result::Ok(105) => if(String::eq(value, &"is")) {
                               Option::Some(Keyword::Is)
                           } else {
                               keyword_named(value, &"impl", Keyword::Impl)
                           },
        Result::Ok(108) => keyword_named(value, &"let", Keyword::Let),
        Result::Ok(112) => keyword_named(value, &"perform", Keyword::Perform),
        Result::Ok(114) => keyword_named(value, &"resume", Keyword::Resume),
        Result::Ok(115) => keyword_named(value, &"struct", Keyword::Struct),
        Result::Ok(116) => if(String::eq(value, &"tail")) {
                               Option::Some(Keyword::Tail)
                           } else {
                               if(String::eq(value, &"trait")) {
                               Option::Some(Keyword::Trait)
                               } else {
                               keyword_named(value, &"type", Keyword::Type)
                               }
                           },
        Result::Ok(119) => keyword_named(value, &"where", Keyword::Where),
        _ => None
    }
}

scan_word(value: &mut Lexer) {
    let start = value.cursor;
    advance(&mut *value, 1);
    scan_word_tail(&mut *value);
    let end = value.cursor;
    let text = source_slice(&*value, start,  end);
    handle keyword(&text) {
        Result::Ok(found) => push_keyword( value,  found, start),
        Result::Err(_) => {
            let end = value.cursor;
            let id = intern_slice(&mut *value, start, end);
            push(value, TokenKind::Ident(id), start)
        }
    }
}

scan_word_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte_is_alphanumeric(byte)) {
                    advance(&mut *value, 1);
                    scan_word_tail( value)

            } else {
                    if(byte == byte_value(95)) {
                            advance(&mut *value, 1);
                            scan_word_tail( value)

                    } else {
                            if(byte == byte_value(45)) {
                                    handle peek(&*value, 1) {
                                        Result::Ok(next) => {
                                            if(byte_is_alphanumeric(next)) {
                                                    advance(&mut *value, 2);
                                                    scan_word_tail( value)

                                            } else {
                                                    if(next == byte_value(95)) {
                                                            advance(&mut *value, 2);
                                                            scan_word_tail( value)

                                                    } else {
                                                        ()
                                                    }

                                            }
                                        },
                                        Result::Err(_) => ()
                                    }

                            } else {
                                ()
                            }

                    }

            }
        },
        Result::Err(_) => ()
    }
}

scan_line_comment(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte == byte_value(10)) {
                ()
            } else {
                    advance(&mut *value, 1);
                    scan_line_comment( value)

            }
        },
        Result::Err(_) => ()
    }
}

scan_block_comment(value: &mut Lexer, start: usize, depth: usize) -> Result<(), LexError> {
    if(depth == 0) {
        Result::Ok(())
    } else {
            if(value.cursor < Bytes::len(&value.bytes)) {
                    if(peek_is(&*value, 0, 47)) {
                        if(peek_is(&*value, 1, 42)) {
                        advance(&mut *value, 2);
                        scan_block_comment( value, start, depth + 1)

                        } else {
                        advance(&mut *value, 1);
                        scan_block_comment( value, start, depth)

                        }
                    } else {
                        if(peek_is(&*value, 0, 42)) {
                        if(peek_is(&*value, 1, 47)) {
                        advance(&mut *value, 2);
                        scan_block_comment( value, start, depth - 1)

                        } else {
                        advance(&mut *value, 1);
                        scan_block_comment( value, start, depth)

                        }
                        } else {
                        advance(&mut *value, 1);
                        scan_block_comment( value, start, depth)

                        }
                    }

            } else {
                Result::Err(
                lex_error(LexErrorKind::UnfinishedComment, start, Bytes::len(&value.bytes))
                )
            }

    }
}

scan_label_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte_is_alphanumeric(byte)) {
                    advance(&mut *value, 1);
                    scan_label_tail( value)

            } else {
                if(byte == byte_value(95)) {
                advance(&mut *value, 1);
                scan_label_tail( value)

                } else {
                ()
                }
            }
        },
        Result::Err(_) => ()
    }
}

scan_label(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 1);
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte_is_word_start(byte)) {
                    let name_start = value.cursor;
                    advance(&mut *value, 1);
                    scan_label_tail(&mut *value);
                    let name_end = value.cursor;
                    let id = intern_slice(&mut *value, name_start, name_end);
                    push(value, TokenKind::Label(id), start);
                    Result::Ok(())

            } else {
                Result::Err(
                lex_error(LexErrorKind::InvalidLabel, start, value.cursor)
                )
            }
        },
        Result::Err(_) => Result::Err(
            lex_error(LexErrorKind::InvalidLabel, start, value.cursor)
        )
    }
}

structural_two(first: u8, second: u8) -> Option<TokenKind> {
    handle first {
        45 => if(second == byte_value(62)) {
            Option::Some(TokenKind::Arrow)
        } else { None },
        61 => handle second {
            62 => Option::Some(TokenKind::FatArrow),
            61 => Option::Some(TokenKind::EqEq),
            _ => None
        },
        46 => if(second == byte_value(46)) {
            Option::Some(TokenKind::DotDot)
        } else { None },
        33 => if(second == byte_value(61)) {
            Option::Some(TokenKind::BangEq)
        } else { None },
        60 => if(second == byte_value(61)) {
            Option::Some(TokenKind::LtEq)
        } else { None },
        62 => if(second == byte_value(61)) {
            Option::Some(TokenKind::GtEq)
        } else { None },
        _ => None
    }
}

structural_one(value: u8) -> Option<TokenKind> {
    handle value {
        46 => Option::Some(TokenKind::Dot),
        47 => Option::Some(TokenKind::Slash),
        43 => Option::Some(TokenKind::Plus),
        45 => Option::Some(TokenKind::Minus),
        42 => Option::Some(TokenKind::Star),
        37 => Option::Some(TokenKind::Percent),
        124 => Option::Some(TokenKind::Pipe),
        61 => Option::Some(TokenKind::Eq),
        60 => Option::Some(TokenKind::Lt),
        62 => Option::Some(TokenKind::Gt),
        38 => Option::Some(TokenKind::Amp),
        33 => Option::Some(TokenKind::Bang),
        _ => None
    }
}

structural_two_exists(first: u8, second: u8) -> Bool {
    handle second {
        46 => first == byte_value(46),
        61 => handle first {
            33 => true,
            60 => true,
            61 => true,
            62 => true,
            _ => false
        },
        62 => handle first {
            45 => true,
            61 => true,
            _ => false
        },
        _ => false
    }
}

scan_operator_tail(value: &mut Lexer) {
    if(peek(&*value, 0) is Result::Ok(first)) {
        if(byte_is_operator(first)) {
            if(structural_one(first)) {
                ()
            } else {
                let pair_structural = if(
                    peek(&*value, 1) is Result::Ok(second)
                ) {
                    structural_two_exists(first, second)
                } else {
                    false
                };
                if(pair_structural) {
                    ()
                } else {
                    advance(&mut *value, 1);
                    scan_operator_tail(value)
                }
            }
        } else {
            ()
        }
    } else {
        ()
    }
}

operator_run_end(value: &Lexer, offset: usize) -> usize {
    handle peek(value, offset) {
        Result::Ok(byte) => if(byte_is_operator(byte)) {
            operator_run_end(value, offset + 1)
        } else {
            value.cursor + offset
        },
        Result::Err(_) => value.cursor + offset
    }
}

intern_operator_run(value: &mut Lexer, start: usize) {
    let end = operator_run_end(&*value, 0);
    let id = intern_slice(&mut *value, start, end);
    id;
    ()
}

scan_operator(value: &mut Lexer) {
    let start = value.cursor;
    intern_operator_run(&mut *value, start);
    let first = present_byte(peek(&*value, 0));
    let pair = handle peek(&*value, 1) {
        Result::Ok(second) => structural_two(first,  second),
        Result::Err(_) => None
    };
    handle pair {
        Result::Ok(kind) => {
            advance(&mut *value, 2);
            push(value, kind, start)
        },
        Result::Err(_) => handle structural_one(first) {
            Result::Ok(kind) => {
                advance(&mut *value, 1);
                push(value, kind, start)
            },
            Result::Err(_) => {
                scan_operator_tail(&mut *value);
                let end = value.cursor;
                let id = intern_slice(&mut *value, start, end);
                push(value, TokenKind::Operator(id), start)
            }
        }
    }
}

digit_valid(byte: u8, base_code: u8) -> Bool {
    handle base_code {
        1 => handle byte {
            48 => true,
            49 => true,
            _ => false
        },
        2 => byte_is_between(byte, 48, 55),
        3 => byte_is_digit(byte),
        _ => byte_is_hex(byte)
    }
}

scan_digit_tail(
    value: &mut Lexer,
    base_code: u8,
    last_separator: Option<usize>
) -> Result<Option<usize>, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte == byte_value(95)) {
                    let separator = value.cursor;
                    advance(&mut *value, 1);
                    scan_digit_tail( value, base_code, Option::Some(separator))

            } else {
                if(digit_valid(byte, base_code)) {
                advance(&mut *value, 1);
                scan_digit_tail( value, base_code, None)

                } else {
                if(byte_is_digit(byte)) {
                Result::Err(
                lex_error(
                LexErrorKind::InvalidDigit,
                value.cursor,
                value.cursor + 1
                )
                )
                } else {
                Result::Ok(last_separator)
                }

                }
            }
        },
        Result::Err(_) => Result::Ok(last_separator)
    }
}

scan_digits(
    value: &mut Lexer,
    base_code: u8,
    component_start: usize
) -> Result<Span, LexError> {
    let last_separator = try(
        scan_digit_tail(&mut *value, base_code, None),
        @scan_digits
    );
    handle last_separator {
        Result::Ok(position) => Result::Err(
            lex_error(
                LexErrorKind::MisplacedDigitSeparator,
                position,
                position + 1
            )
        ),
        Result::Err(_) => if(value.cursor == component_start) {
                              Result::Err(
                              lex_error(
                              LexErrorKind::ExpectedDigits,
                              component_start,
                              component_start
                              )
                              )
                          } else {
                              Result::Ok(span(component_start, value.cursor))
                          }
    }
}

skip_underscores(value: &mut Lexer) {
    if(peek_is(&*value, 0, 95)) {
            advance(&mut *value, 1);
            skip_underscores( value)

    } else {
        ()
    }
}

scan_number(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    let after_projection_dot = value.after_projection_dot;
    let base_code = handle peek(&*value, 0) {
        Result::Ok(48) => handle peek(&*value, 1) {
            Result::Ok(98) => byte_value(1),
            Result::Ok(111) => byte_value(2),
            Result::Ok(120) => byte_value(4),
            _ => byte_value(3)
        },
        _ => byte_value(3)
    };
    let base = handle base_code {
        1 => NumberBase::Binary,
        2 => NumberBase::Octal,
        3 => NumberBase::Decimal,
        _ => NumberBase::Hex
    };
    let non_decimal = base_code != byte_value(3);
    let digits = if(non_decimal) {
            advance(&mut *value, 2);
            skip_underscores(&mut *value);
            let digits_start = value.cursor;
            handle peek(&*value, 0) {
                Result::Ok(byte) => if(digit_valid(byte, base_code)) {
                                        scan_digits(&mut *value, base_code, digits_start)
                                    } else {
                                        Result::Err(
                                        lex_error(LexErrorKind::ExpectedDigits, start, value.cursor)
                                        )
                                    },
                Result::Err(_) => Result::Err(
                    lex_error(LexErrorKind::ExpectedDigits, start, value.cursor)
                )
            }

                 } else {
                     scan_digits(&mut *value, base_code, start)
                 };
    let digit_span = try( digits, @scan_number);
    let fraction_span = try(
        scan_fraction(&mut *value, base_code,  after_projection_dot),
        @scan_number
    );
    let exponent_span = try(
        scan_exponent(&mut *value, base_code),
        @scan_number
    );
    {
                            handle peek(&*value, 0) {
                                Result::Ok(byte) => {
                                    if(byte_is_alphanumeric(byte)) {
                                        Result::Err(
                                        lex_error(
                                        LexErrorKind::InvalidDigit,
                                        value.cursor,
                                        value.cursor + 1
                                        )
                                        )
                                    } else {
                                        if(byte == byte_value(95)) {
                                        Result::Err(
                                        lex_error(
                                        LexErrorKind::InvalidDigit,
                                        value.cursor,
                                        value.cursor + 1
                                        )
                                        )
                                        } else {
                                        finish_number(
                                        value,
                                        start,
                                        base,
                                        digit_span,
                                        fraction_span,
                                        exponent_span
                                        )
                                        }
                                    }
                                },
                                Result::Err(_) => finish_number(
                                     value,
                                    start,
                                    base,
                                    digit_span,
                                    fraction_span,
                                    exponent_span
                                )
                            }
    }
}

scan_fraction(
    value: &mut Lexer,
    base_code: u8,
    after_projection_dot: Bool
) -> Result<Option<Span>, LexError> {
    let decimal = base_code == byte_value(3);
    if(decimal) {
        if(after_projection_dot) {
        Result::Ok(None)
        } else {
        if(peek_is(&*value, 0, 46)) {
        handle peek(&*value, 1) {
        Result::Ok(next) => if(byte_is_digit(next)) {
        advance(&mut *value, 1);
        let start = value.cursor;
        let found = try(
        scan_digits( value, base_code, start),
        @scan_fraction
        );
        Result::Ok(Option::Some(found))

        } else {
        Result::Ok(None)
        },
        Result::Err(_) => Result::Ok(None)
        }
        } else {
        Result::Ok(None)
        }
        }
    } else {
        Result::Ok(None)
    }
}

scan_exponent(
    value: &mut Lexer,
    base_code: u8
) -> Result<Option<NumberExponent>, LexError> {
    let decimal = base_code == byte_value(3);
    if(decimal) {
        handle peek(&*value, 0) {
        Result::Ok(marker) => handle marker {
        101 => scan_exponent_after_marker( value),
        69 => scan_exponent_after_marker( value),
        _ => Result::Ok(None)
        },
        Result::Err(_) => Result::Ok(None)
        }
    } else {
        Result::Ok(None)
    }
}

scan_exponent_after_marker(value: &mut Lexer) -> Result<Option<NumberExponent>, LexError> {
    let marker = value.cursor;
    let sign = if(peek(&*value, 1) is Result::Ok(byte)) {
        handle byte {
            43 => 1,
            45 => 1,
            _ => 0
        }
    } else {
        0
    };
    let candidate = if(
        peek(&*value, 1 + sign) is Result::Ok(byte)
    ) {
        byte_is_digit(byte) or { byte == byte_value(95) }
    } else {
        false
    };
    if(candidate) {
            advance(&mut *value, 1);
            let negative = peek_is(&*value, 0, 45);
            advance(&mut *value, sign);
            let start = value.cursor;
            let found = try(
                scan_digits( value, 3, start),
                @scan_exponent_after_marker
            );
            Result::Ok(
                Option::Some(NumberExponent {
                    negative: negative,
                    digits: found
                })
            )

    } else {
        Result::Err(
        lex_error(
        LexErrorKind::MalformedFloatExponent,
        marker,
        marker + 1 + sign
        )
        )
    }
}

finish_number(
    value: &mut Lexer,
    start: usize,
    base: NumberBase,
    digits: Span,
    fraction: Option<Span>,
    exponent: Option<NumberExponent>
) -> Result<(), LexError> {
    let spelling = span(start, value.cursor);
    push(
         value,
        TokenKind::Number(NumberToken {
            spelling:  spelling,
            base:  base,
            digits:  digits,
            fraction:  fraction,
            exponent:  exponent
        }),
        start
    );
    Result::Ok(())
}
hex_value(value: u8) -> u32 {
    if(byte_is_digit(value)) {
        wrapping_convert_to_u32(value - 48)
    } else {
        if(byte_is_lower(value)) {
        wrapping_convert_to_u32(value - 97) + 10
        } else {
        wrapping_convert_to_u32(value - 65) + 10
        }
    }
}

hex_pair(value: &mut Lexer, backslash: usize) -> Result<u8, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(first) => if(byte_is_hex(first)) {
                                 handle peek(&*value, 1) {
                                 Result::Ok(second) => if(byte_is_hex(second)) {
                                 advance( value, 2);
                                 Result::Ok(
                                 wrapping_convert_to_u8(
                                 hex_value(first) * 16 + hex_value(second)
                                 )
                                 )

                                 } else {
                                 Result::Err(
                                 lex_error(
                                 LexErrorKind::MalformedHexEscape,
                                 backslash,
                                 value.cursor + 1
                                 )
                                 )
                                 },
                                 Result::Err(_) => Result::Err(
                                 lex_error(
                                 LexErrorKind::MalformedHexEscape,
                                 backslash,
                                 value.cursor
                                 )
                                 )
                                 }
                             } else {
                                 Result::Err(
                                 lex_error(
                                 LexErrorKind::MalformedHexEscape,
                                 backslash,
                                 value.cursor
                                 )
                                 )
                             },
        Result::Err(_) => Result::Err(
            lex_error(LexErrorKind::MalformedHexEscape, backslash, value.cursor)
        )
    }
}

unicode_digits(
    value: &mut Lexer,
    backslash: usize,
    scalar: u32,
    digits: usize
) -> Result<char, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(125) => {
            advance(&mut *value, 1);
            if(digits == 0) {
                Result::Err(
                lex_error(
                LexErrorKind::MalformedUnicodeEscape,
                backslash,
                value.cursor
                )
                )
            } else {
                handle char_from_u32(scalar) {
                Result::Ok(character) => scalar_ok( character),
                Result::Err(_) => Result::Err(
                lex_error(
                LexErrorKind::InvalidUnicodeScalar,
                backslash,
                value.cursor
                )
                )
                }
            }
        },
        Result::Ok(byte) => if(byte_is_hex(byte)) {
                                if(digits == 6) {
                                Result::Err(
                                lex_error(
                                LexErrorKind::MalformedUnicodeEscape,
                                backslash,
                                value.cursor + 1
                                )
                                )
                                } else {
                                advance(&mut *value, 1);
                                unicode_digits(
                                value,
                                backslash,
                                scalar * 16 + hex_value(byte),
                                digits + 1
                                )

                                }
                            } else {
                                Result::Err(
                                lex_error(
                                LexErrorKind::MalformedUnicodeEscape,
                                value.cursor,
                                value.cursor + 1
                                )
                                )
                            },
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedUnicodeEscape,
                backslash,
                Bytes::len(&value.bytes)
            )
        )
    }
}

unicode_escape(value: &mut Lexer, backslash: usize) -> Result<char, LexError> {
    if(peek_is(&*value, 0, 123)) {
            advance(&mut *value, 1);
            unicode_digits( value, backslash, 0, 0)

    } else {
        Result::Err(
        lex_error(
        LexErrorKind::MalformedUnicodeEscape,
        backslash,
        value.cursor
        )
        )
    }
}

scalar_ok(value: char) -> Result<char, LexError> { Result::Ok( value) }

scalar_escape(value: &mut Lexer, backslash: usize) -> Result<char, LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedEscape,
                backslash,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(selector) => {
            advance(&mut *value, 1);
            handle selector {
                110 => scalar_ok('\n'),
                114 => scalar_ok('\r'),
                116 => scalar_ok('\t'),
                48 => scalar_ok('\0'),
                34 => scalar_ok('"'),
                39 => scalar_ok('\''),
                92 => scalar_ok('\\'),
                120 => {
                    let byte = try(
                        hex_pair(&mut *value, backslash),
                        @scalar_escape
                    );
                    handle split_byte(byte, byte_value(127)) {
                        Result::Ok(byte) => handle char_from_u32(
                            wrapping_convert_to_u32(byte)
                        ) {
                            Result::Ok(character) => scalar_ok( character),
                            Result::Err(_) => unreachable()
                        },
                        Result::Err(_) => Result::Err(
                            lex_error(
                                LexErrorKind::InvalidCharacterEscape,
                                backslash,
                                value.cursor
                            )
                        )
                    }
                },
                117 => unicode_escape( value, backslash),
                _ => Result::Err(
                    lex_error(
                        LexErrorKind::UnknownEscape,
                        backslash,
                        value.cursor
                    )
                )
            }
        }
    }
}

byte_ok(value: u8) -> Result<u8, LexError> { Result::Ok( value) }

byte_escape(value: &mut Lexer, backslash: usize) -> Result<u8, LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedEscape,
                backslash,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(selector) => {
            advance(&mut *value, 1);
            handle selector {
                110 => byte_ok(10),
                114 => byte_ok(13),
                116 => byte_ok(9),
                48 => byte_ok(0),
                34 => byte_ok(34),
                39 => byte_ok(39),
                92 => byte_ok(92),
                120 => hex_pair( value, backslash),
                117 => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteEscape,
                        backslash,
                        value.cursor
                    )
                ),
                _ => Result::Err(
                    lex_error(
                        LexErrorKind::UnknownEscape,
                        backslash,
                        value.cursor
                    )
                )
            }
        }
    }
}

scan_string_tail(
    value: &mut Lexer,
    start: usize,
    decoded: &mut StringBuilder
) -> Result<(), LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedString,
                start,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(34) => {
            advance( value, 1);
            Result::Ok(())
        },
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            let character = try(
                scalar_escape(&mut *value, backslash),
                @scan_string_tail
            );
            StringBuilder::append_char(&mut *decoded, character);
            scan_string_tail( value, start,  decoded)
        },
        Result::Ok(_) => {
            let cursor = value.cursor;
            let bytes = value.bytes;
            handle char_decode_utf8(&bytes, cursor) {
            Result::Ok(decoded_char) => {
                (*value).cursor = decoded_char.next;
                StringBuilder::append_char(&mut *decoded, decoded_char.value);
                scan_string_tail( value, start,  decoded)
            },
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::UnexpectedCharacter,
                    value.cursor,
                    value.cursor + 1
                )
            )
            }
        }
    }
}

scan_string(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 1);
    let decoded = StringBuilder::new();
    try(scan_string_tail(&mut *value, start, &mut decoded), @scan_string);
    handle StringBuilder::finish( decoded) {
        Result::Ok(text) => {
            let id = intern_text(&mut *value, text);
            push(value, TokenKind::String(id), start);
            Result::Ok(())
        },
        Result::Err(_) => unreachable()
    }
}

scan_byte_string_tail(
    value: &mut Lexer,
    start: usize,
    decoded: &mut Vec<u8>
) -> Result<(), LexError> {
    let bytes = value.bytes;
    let cursor = value.cursor;
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedByteString,
                start,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(34) => {
            advance( value, 1);
            Result::Ok(())
        },
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            let byte = try(
                byte_escape(&mut *value, backslash),
                @scan_byte_string_tail
            );
            Vec::push(&mut *decoded, byte);
            scan_byte_string_tail( value, start,  decoded)
        },
        Result::Ok(byte) => handle split_byte(byte, byte_value(127)) {
            Result::Ok(byte) => {
                advance(&mut *value, 1);
                Vec::push(&mut *decoded, byte);
                scan_byte_string_tail( value, start,  decoded)
            },
            Result::Err(_) => handle char_decode_utf8(&bytes, cursor) {
                Result::Ok(character) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteStringCharacter,
                        value.cursor,
                        character.next
                    )
                ),
                Result::Err(_) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteStringCharacter,
                        value.cursor,
                        value.cursor + 1
                    )
                )
            }
        }
    }
}

scan_byte_string(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 2);
    let decoded = Vec::new();
    try(
        scan_byte_string_tail(&mut *value, start, &mut decoded),
        @scan_byte_string
    );
    push(
         value,
        TokenKind::ByteString(Bytes::from_vec( decoded)),
        start
    );
    Result::Ok(())
}

scan_byte_literal(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 2);
    let bytes = value.bytes;
    let content_cursor = value.cursor;
    let decoded = handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedByteLiteral,
                start,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(39) => Result::Err(
            lex_error(
                LexErrorKind::EmptyByteLiteral,
                start,
                value.cursor + 1
            )
        ),
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            byte_escape(&mut *value, backslash)
        },
        Result::Ok(byte) => handle split_byte(byte, byte_value(127)) {
            Result::Ok(byte) => {
                advance(&mut *value, 1);
                byte_ok(byte)
            },
            Result::Err(_) => handle char_decode_utf8(&bytes, content_cursor) {
                Result::Ok(character) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteLiteral,
                        value.cursor,
                        character.next
                    )
                ),
                Result::Err(_) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteLiteral,
                        value.cursor,
                        value.cursor + 1
                    )
                )
            }
        }
    };
    let byte = try( decoded, @scan_byte_literal);
    if(peek_is(&*value, 0, 39)) {
            advance(&mut *value, 1);
            push(value, TokenKind::Byte(byte), start);
            Result::Ok(())

    } else {
        Result::Err(
        lex_error(
        LexErrorKind::UnfinishedByteLiteral,
        start,
        value.cursor
        )
        )
    }
}

scan_char_or_lifetime(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    handle peek(&*value, 1) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::InvalidLifetimeIdentifier,
                start,
                start + 1
            )
        ),
        Result::Ok(92) => {
            advance(&mut *value, 2);
            let character = try(
                scalar_escape(&mut *value, start + 1),
                @scan_char_or_lifetime
            );
            if(peek_is(&*value, 0, 39)) {
                    advance(&mut *value, 1);
                    push(value, TokenKind::Char(character), start);
                    Result::Ok(())

            } else {
                Result::Err(
                lex_error(
                LexErrorKind::UnfinishedCharacterLiteral,
                start,
                value.cursor
                )
                )
            }
        },
        Result::Ok(39) => Result::Err(
            lex_error(
                LexErrorKind::EmptyCharacterLiteral,
                start,
                start + 2
            )
        ),
        Result::Ok(_) => {
            let bytes = value.bytes;
            handle char_decode_utf8(&bytes, start + 1) {
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::InvalidLifetimeIdentifier,
                    start,
                    start + 1
                )
            ),
            Result::Ok(character) => handle Bytes::get(&bytes, character.next) {
                Result::Ok(39) => {
                    (*value).cursor = character.next + 1;
                    push(value, TokenKind::Char(character.value), start);
                    Result::Ok(())
                },
                _ => scan_lifetime( value, start)
            }
            }
        }
    }
}

scan_lifetime_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => if(byte_is_alphanumeric(byte)) {
                advance(&mut *value, 1);
                scan_lifetime_tail( value)

                            } else {
                                if(byte == byte_value(95)) {
                                advance(&mut *value, 1);
                                scan_lifetime_tail( value)

                                } else {
                                ()
                                }
                            },
        Result::Err(_) => ()
    }
}

scan_lifetime(value: &mut Lexer, start: usize) -> Result<(), LexError> {
    (*value).cursor = start + 1;
    handle peek(&*value, 0) {
        Result::Ok(byte) => if(byte_is_word_start(byte)) {
                advance(&mut *value, 1);
                scan_lifetime_tail(&mut *value);
                if(peek_is(&*value, 0, 39)) {
                    Result::Err(
                    lex_error(
                    LexErrorKind::InvalidCharacterLiteral,
                    start,
                    value.cursor + 1
                    )
                    )
                } else {
                        let end = value.cursor;
                        let id = intern_slice(&mut *value, start, end);
                        push(value, TokenKind::Lifetime(id), start);
                        Result::Ok(())

                }

                            } else {
                                Result::Err(
                                lex_error(
                                LexErrorKind::InvalidLifetimeIdentifier,
                                start,
                                value.cursor
                                )
                                )
                            },
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::InvalidLifetimeIdentifier,
                start,
                value.cursor
            )
        )
    }
}

// Keeping the driver in this file makes this slice independently executable by
// both backends.

pub lex(source: &String) -> Result<LexedSource, LexError> {
    let bytes = String::as_bytes(source);
    handle checked_usize_to_u32(Bytes::len(&bytes)) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::ResourceLimit,
                0,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(_) => {
            let lexer = Lexer {
                source: *source,
                bytes: bytes,
                cursor: 0,
                tokens: Vec::new(),
                lexemes: Interner::new(),
                after_projection_dot: false
            };
            run( lexer)
        }
    }
}

run(value: Lexer) -> Result<LexedSource, LexError> {
    let length = Bytes::len(&value.bytes);
    if(value.cursor < length) {
        run_one( value)
    } else {
            let eof = Token {
                kind: TokenKind::Eof,
                span: span(
                    Bytes::len(&value.bytes),
                    Bytes::len(&value.bytes)
                )
            };
            Vec::push(&mut value.tokens, eof);
            let Lexer {
                source: _,
                bytes: _,
                cursor: _,
                tokens,
                lexemes,
                after_projection_dot: _
            } = value;
            Result::Ok(LexedSource {
                tokens: tokens,
                lexemes: lexemes
            })

    }
}

run_one(value: Lexer) -> Result<LexedSource, LexError> {
    let start = value.cursor;
    let byte = present_byte(peek(&value, 0));
    if(byte_is_whitespace(byte)) {
            advance(&mut value, 1);
            run( value)

    } else {
        run_byte( value, byte, start)
    }
}

run_byte(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(byte, byte_value(58)) {
        Result::Ok(byte) => run_byte_low( value,  byte, start),
        Result::Err(byte) => run_byte_high( value,  byte, start)
    }
}

run_byte_low(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(byte, byte_value(39)) {
        Result::Ok(byte) => run_byte_low_39( value,  byte, start),
        Result::Err(byte) => handle split_byte(byte, byte_value(47)) {
            Result::Ok(byte) => run_byte_low_47( value,  byte, start),
            Result::Err(byte) => run_byte_low_58( value,  byte, start)
        }
    }
}

run_byte_low_39(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        34 => run_string_token( value),
        36 => run_dollar_token( value, start),
        39 => run_char_or_lifetime_token( value),
        _ => run_general_byte( value, byte, start)
    }
}

run_byte_low_47(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(byte, byte_value(44)) {
        Result::Ok(byte) => run_byte_low_44( value,  byte, start),
        Result::Err(byte) => handle byte {
            47 => run_slash_token( value, start),
            _ => run_general_byte( value, byte, start)
        }
    }
}

run_byte_low_44(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        40 => run_structural(value, TokenKind::LParen, start),
        41 => run_structural(value, TokenKind::RParen, start),
        44 => run_structural(value, TokenKind::Comma, start),
        _ => run_general_byte( value, byte, start)
    }
}

run_byte_low_58(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        58 => run_colon_token( value, start),
        _ => run_general_byte( value, byte, start)
    }
}

run_byte_high(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(byte, byte_value(93)) {
        Result::Ok(byte) => run_byte_high_93( value,  byte, start),
        Result::Err(byte) => run_byte_above_93( value,  byte, start)
    }
}

run_byte_high_93(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(byte, byte_value(64)) {
        Result::Ok(byte) => handle byte {
            59 => run_structural(value, TokenKind::Semicolon, start),
            64 => run_label_token( value),
            _ => run_general_byte( value, byte, start)
        },
        Result::Err(byte) => handle byte {
            91 => run_structural(value, TokenKind::LBracket, start),
            93 => run_structural(value, TokenKind::RBracket, start),
            _ => run_general_byte( value, byte, start)
        }
    }
}

run_byte_above_93(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(byte, byte_value(98)) {
        Result::Ok(byte) => handle byte {
            98 => run_byte_prefix( value),
            _ => run_general_byte( value, byte, start)
        },
        Result::Err(byte) => handle byte {
            123 => run_structural(value, TokenKind::LBrace, start),
            125 => run_structural(value, TokenKind::RBrace, start),
            _ => run_general_byte( value, byte, start)
        }
    }
}

run_slash_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    if(peek_is(&value, 1, 47)) {
            scan_line_comment(&mut value);
            run( value)

    } else {
        if(peek_is(&value, 1, 42)) {
        advance(&mut value, 2);
        try(
        scan_block_comment(&mut value, start, 1),
        @run_slash_token
        );
        run( value)

        } else {
        intern_operator_run(&mut value, start);
        run_structural(
        value,
        TokenKind::Slash,
        start
        )
        }
    }
}

run_dollar_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    run_structural(value, TokenKind::Dollar, start)
}

run_colon_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    advance(&mut value, 1);
    if(peek_is(&value, 0, 58)) {
            advance(&mut value, 1);
            push(&mut value, TokenKind::DoubleColon, start)

    } else {
        push(&mut value, TokenKind::Colon, start)
    };
    run( value)
}

run_label_token(value: Lexer) -> Result<LexedSource, LexError> {
    try(scan_label(&mut value), @run_label_token);
    run( value)
}

run_string_token(value: Lexer) -> Result<LexedSource, LexError> {
    try(scan_string(&mut value), @run_string_token);
    run( value)
}

run_char_or_lifetime_token(value: Lexer) -> Result<LexedSource, LexError> {
    try(
        scan_char_or_lifetime(&mut value),
        @run_char_or_lifetime_token
    );
    run( value)
}

run_byte_prefix(value: Lexer) -> Result<LexedSource, LexError> {
    handle peek(&value, 1) {
        Result::Ok(34) => {
            try(scan_byte_string(&mut value), @run_byte_prefix);
            run( value)
        },
        Result::Ok(39) => {
            try(scan_byte_literal(&mut value), @run_byte_prefix);
            run( value)
        },
        _ => {
            scan_word(&mut value);
            run( value)
        }
    }
}

run_general_byte(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    if(byte_is_digit(byte)) {
            try(scan_number(&mut value), @run_general_byte);
            run( value)

    } else {
        if(byte_is_word_start(byte)) {
        scan_word(&mut value);
        run( value)

        } else {
        if(byte_is_operator(byte)) {
        scan_operator(&mut value);
        run( value)

        } else {
        handle char_decode_utf8(&value.bytes, start) {
        Result::Ok(character) => Result::Err(
        lex_error(
        LexErrorKind::UnexpectedCharacter,
        start,
        character.next
        )
        ),
        Result::Err(_) => Result::Err(
        lex_error(
        LexErrorKind::UnexpectedCharacter,
        start,
        start + 1
        )
        )
        }
        }
        }
    }
}

run_structural(
    value: Lexer,
    kind: TokenKind,
    start: usize
) -> Result<LexedSource, LexError> {
    advance(&mut value, 1);
    push(&mut value, kind, start);
    run( value)
}
