// The first executable slice of the self-hosted compiler. This is the source
// ingestion boundary used by the future declaration scanner and body parser.

pub struct Span { start: usize, end: usize }

pub enum Keyword {
    Cancel,
    Effect,
    Enum,
    Handle,
    Impl,
    Is,
    Let,
    Perform,
    Resume,
    Struct,
    Tail,
    Trait,
    Type,
    Where
}

pub enum NumberBase { Binary, Octal, Decimal, Hex }

pub struct NumberExponent {
    negative: Bool,
    digits: Span
}

pub struct NumberToken {
    spelling: Span,
    base: NumberBase,
    base_code: u8,
    digits: Span,
    fraction: Option<Span>,
    exponent: Option<NumberExponent>
}

pub enum TokenKind {
    Ident(Id<String>),
    Keyword(Keyword),
    Lifetime(Id<String>),
    Number(NumberToken),
    String(Id<String>),
    Char(char),
    Byte(u8),
    ByteString(Bytes),
    Label(Id<String>),
    Operator(Id<String>),
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Colon,
    DoubleColon,
    DotDot,
    Dot,
    Semicolon,
    Arrow,
    FatArrow,
    Slash,
    Plus,
    Minus,
    Star,
    Percent,
    Pipe,
    Eq,
    EqEq,
    BangEq,
    Lt,
    LtEq,
    Gt,
    GtEq,
    Amp,
    Bang,
    Dollar,
    Eof
}

impl Use<[0, *]> for TokenKind {}

pub struct Token { kind: TokenKind, code: u16, keyword_code: u8, span: Span }

struct CodedTokenKind { kind: TokenKind, code: u16 }

struct RecognizedKeyword { value: Keyword, code: u8 }

coded_token_kind(kind: TokenKind, code: u16) -> CodedTokenKind {
    CodedTokenKind { kind:  kind, code:  code }
}

recognized_keyword(value: Keyword, code: u8) -> RecognizedKeyword {
    RecognizedKeyword { value:  value, code:  code }
}

pub struct LexedSource {
    tokens: Vec<Token>,
    lexemes: Interner<String>
}

pub enum LexErrorKind {
    UnexpectedCharacter,
    UnfinishedComment,
    InvalidLabel,
    InvalidDigit,
    MisplacedDigitSeparator,
    ExpectedDigits,
    MalformedFloatExponent,
    UnfinishedEscape,
    InvalidCharacterEscape,
    UnknownEscape,
    MalformedHexEscape,
    MalformedUnicodeEscape,
    UnfinishedUnicodeEscape,
    InvalidUnicodeScalar,
    InvalidByteEscape,
    UnfinishedString,
    InvalidByteStringCharacter,
    UnfinishedByteString,
    EmptyByteLiteral,
    InvalidByteLiteral,
    UnfinishedByteLiteral,
    UnfinishedCharacterLiteral,
    EmptyCharacterLiteral,
    InvalidLifetimeIdentifier,
    InvalidCharacterLiteral,
    ResourceLimit
}

pub struct LexError { kind: LexErrorKind, code: u16, span: Span }

pub token_count(value: &LexedSource) -> usize { Vec::len(&value.tokens) }

pub token_at<'a>(value: &'a LexedSource, index: usize) -> Option<&'a Token> {
    Vec::get(&value.tokens, move index)
}

pub token_kind(value: &Token) -> &TokenKind { &value.kind }

pub token_kind_at(value: &LexedSource, index: usize) -> TokenKind {
    let token = Vec::index(&value.tokens, move index);
    *token_kind( token)
}

pub token_code(value: &Token) -> u16 { value.code }

pub token_code_at(value: &LexedSource, index: usize) -> u16 {
    token_code(Vec::index(&value.tokens, move index))
}

pub operator_symbol_at(value: &LexedSource, index: usize) -> Bool {
    let code = token_code_at(value, index);
    code == u16_value(10) or {
        u16_value(25) <= code and { code <= u16_value(39) }
    }
}

pub operator_end(
    value: &LexedSource,
    cursor: usize,
    limit: usize,
    previous_end: usize
) -> usize {
    if(cursor < limit) {
        if(operator_symbol_at(value, cursor)) {
        let token = Vec::index(&value.tokens, cursor);
        if(previous_end == token.span.start) {
        operator_end(
        value,
        cursor + usize_value(1),
        limit,
        token.span.end
        )
        } else {
        cursor
        }

        } else {
        cursor
        }
    } else {
        cursor
    }
}

pub token_span(value: &Token) -> Span {
    Span { start: value.span.start, end: value.span.end }
}

pub span_start(value: &Span) -> usize { value.start }

pub span_end(value: &Span) -> usize { value.end }

pub number_spelling(value: &NumberToken) -> Span {
    Span { start: value.spelling.start, end: value.spelling.end }
}

pub number_base(value: &NumberToken) -> &NumberBase { &value.base }

pub number_base_code(value: &NumberToken) -> u8 { value.base_code }

pub number_is_float(value: &NumberToken) -> Bool {
    handle Option::as_ref(&value.fraction) {
        Result::Ok(_) => true,
        Result::Err(_) => handle Option::as_ref(&value.exponent) {
            Result::Ok(_) => true,
            Result::Err(_) => false
        }
    }
}

pub number_digits(value: &NumberToken) -> Span {
    Span { start: value.digits.start, end: value.digits.end }
}

pub number_fraction(value: &NumberToken) -> &Option<Span> { &value.fraction }

pub number_exponent(value: &NumberToken) -> &Option<NumberExponent> {
    &value.exponent
}

pub exponent_negative(value: &NumberExponent) -> Bool { value.negative }

pub exponent_digits(value: &NumberExponent) -> Span {
    Span { start: value.digits.start, end: value.digits.end }
}

pub lexeme<'a>(value: &'a LexedSource, id: Id<String>) -> Option<&'a String> {
    Interner::get(&value.lexemes, move id)
}

pub error_kind(value: &LexError) -> &LexErrorKind { &value.kind }

pub error_code(value: &LexError) -> u16 { value.code }

pub error_span(value: &LexError) -> Span {
    Span { start: value.span.start, end: value.span.end }
}

struct Lexer {
    source: String,
    bytes: Bytes,
    cursor: usize,
    tokens: Vec<Token>,
    lexemes: Interner<String>,
    after_projection_dot: Bool
}

span(start: usize, end: usize) -> Span { Span { start:  start, end:  end } }

lex_error(kind: LexErrorKind, code: u16, start: usize, end: usize) -> LexError {
    LexError {
        kind:  kind,
        code:  code,
        span: span( start,  end)
    }
}

bool_value(value: Bool) -> u32 {
    if(move value) { 1 } else { 0 }
}

byte_value(value: u8) -> u8 {  value }

u16_value(value: u16) -> u16 {  value }

u32_value(value: u32) -> u32 {  value }

u16_is(value: &u16, expected: u16) -> Bool {
    *value == expected
}

byte_at_most(value: &u8, upper: u8) -> Bool {
    *value <= upper
}

split_byte(value: u8, upper: u8) -> Result<u8, u8> {
    let retained = value;
    if(byte_at_most(&value, upper)) {
        Result::Ok(move retained)
    } else {
        Result::Err(move retained)
    }
}

byte_is_between(value: u8, low: u8, high: u8) -> Bool {
    low <= value and { value <= high }
}

byte_is_digit(value: u8) -> Bool { byte_is_between(value, 48, 57) }

byte_is_lower(value: u8) -> Bool { byte_is_between(value, 97, 122) }

byte_is_upper(value: u8) -> Bool { byte_is_between(value, 65, 90) }

byte_is_alpha(value: u8) -> Bool {
    byte_is_lower(value) or { byte_is_upper(value) }
}

byte_is_alphanumeric(value: u8) -> Bool {
    byte_is_alpha(value) or { byte_is_digit(value) }
}

byte_is_word_start(value: u8) -> Bool {
    byte_is_alpha(value) or { value == 95 }
}

byte_is_hex(value: u8) -> Bool {
    byte_is_digit(value)
        or { byte_is_between(value, 97, 102) }
        or { byte_is_between(value, 65, 70) }
}

byte_is_whitespace(value: u8) -> Bool {
    value == 32
        or { value == 9 }
        or { value == 10 }
        or { value == 13 }
        or { value == 11 }
        or { value == 12 }
}

operator_byte_mask() -> u128 {
    106338239682600310478164731729926946816
}

byte_is_operator(value: u8) -> Bool {
    if(value <= 126) {
        bit_and(
            shift_right(operator_byte_mask(), wrapping_convert_to_u32(value)),
            1
        ) != 0
    } else { false }
}

peek(value: &Lexer, offset: usize) -> Option<u8> {
    handle Bytes::get(&value.bytes, value.cursor + move offset) {
        Result::Ok(found) => Option::Some( found),
        Result::Err(_) => None
    }
}

peek_is(value: &Lexer, offset: usize, expected: u8) -> Bool {
    handle peek(value, move offset) {
        Result::Ok(actual) =>  actual == move expected,
        Result::Err(_) => false
    }
}

advance(value: &mut Lexer, amount: usize) {
    (*value).cursor = value.cursor + move amount;
}

text_slice_result(result: Result<String, TextRangeError>) -> String {
    handle move result {
        Result::Ok(text) =>  text,
        Result::Err(_) => unreachable()
    }
}

interned_id(result: Result<Id<String>, String>) -> Id<String> {
    handle move result {
        Result::Ok(id) =>  id,
        Result::Err(_) => unreachable()
    }
}

present_byte(result: Option<u8>) -> u8 {
    handle move result {
        Result::Ok(byte) =>  byte,
        Result::Err(_) => unreachable()
    }
}

text_slice(source: &String, start: usize, end: usize) -> String {
    text_slice_result(
        String::slice(source, Range { start:  start, end:  end })
    )
}

source_slice(value: &Lexer, start: usize, end: usize) -> String {
    text_slice(&value.source, move start, move end)
}

intern_slice(value: &mut Lexer, start: usize, end: usize) -> Id<String> {
    let text = source_slice(&*value,  start,  end);
    handle Interner::intern_string(&mut value.lexemes, move text) {
        Result::Ok(id) =>  id,
        // `lex` rejects a source longer than the u32 ID space. There can be no
        // more distinct source lexemes than source bytes, so exhaustion here
        // would contradict that checked boundary.
        Result::Err(_) => unreachable()
    }
}

intern_text(value: &mut Lexer, text: String) -> Id<String> {
    interned_id(Interner::intern_string(&mut value.lexemes, move text))
}

push_with_metadata(
    value: &mut Lexer,
    kind: TokenKind,
    code: u16,
    keyword_code: u8,
    start: usize
) {
    let after_dot = u16_is(&code, u16_value(21));
    let end = value.cursor;
    Vec::push(
        &mut value.tokens,
        Token {
            kind: move kind,
            code: move code,
            keyword_code: move keyword_code,
            span: span(move start, move end)
        }
    );
    (*value).after_projection_dot =  after_dot;
}

push(value: &mut Lexer, kind: TokenKind, code: u16, start: usize) {
    push_with_metadata( value,  kind,  code, 0,  start)
}

push_keyword(value: &mut Lexer, found: RecognizedKeyword, start: usize) {
    push_with_metadata(
         value,
        TokenKind::Keyword(move found.value),
        2,
        found.code,
        move start
    )
}

keyword_named(
    value: &String,
    spelling: &String,
    found: Keyword,
    code: u8
) -> Option<RecognizedKeyword> {
    if(String::eq(value, spelling)) {
        Option::Some(recognized_keyword(move found, move code))
    } else {
        None
    }
}

keyword(value: &String) -> Option<RecognizedKeyword> {
    let bytes = String::as_bytes(value);
    handle Bytes::get(&bytes, 0) {
        Result::Ok(99) => keyword_named(value, &"cancel", Keyword::Cancel, 1),
        Result::Ok(101) => if(String::eq(value, &"enum")) {
                               Option::Some(recognized_keyword(Keyword::Enum, 3))
                           } else {
                               keyword_named(value, &"effect", Keyword::Effect, 2)
                           },
        Result::Ok(104) => keyword_named(value, &"handle", Keyword::Handle, 4),
        Result::Ok(105) => if(String::eq(value, &"is")) {
                               Option::Some(recognized_keyword(Keyword::Is, 6))
                           } else {
                               keyword_named(value, &"impl", Keyword::Impl, 5)
                           },
        Result::Ok(108) => keyword_named(value, &"let", Keyword::Let, 7),
        Result::Ok(112) => keyword_named(value, &"perform", Keyword::Perform, 8),
        Result::Ok(114) => keyword_named(value, &"resume", Keyword::Resume, 9),
        Result::Ok(115) => keyword_named(value, &"struct", Keyword::Struct, 10),
        Result::Ok(116) => if(String::eq(value, &"tail")) {
                               Option::Some(recognized_keyword(Keyword::Tail, 11))
                           } else {
                               if(String::eq(value, &"trait")) {
                               Option::Some(recognized_keyword(Keyword::Trait, 12))
                               } else {
                               keyword_named(value, &"type", Keyword::Type, 13)
                               }
                           },
        Result::Ok(119) => keyword_named(value, &"where", Keyword::Where, 14),
        _ => None
    }
}

scan_word(value: &mut Lexer) {
    let start = value.cursor;
    advance(&mut *value, 1);
    scan_word_tail(&mut *value);
    let end = value.cursor;
    let text = source_slice(&*value, start,  end);
    handle keyword(&text) {
        Result::Ok(found) => push_keyword( value,  found, start),
        Result::Err(_) => {
            let end = value.cursor;
            let id = intern_slice(&mut *value, start, move end);
            push( value, TokenKind::Ident(move id), 1, start)
        }
    }
}

scan_word_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte_is_alphanumeric(byte)) {
                    advance(&mut *value, 1);
                    scan_word_tail( value)

            } else {
                    if(byte == byte_value(95)) {
                            advance(&mut *value, 1);
                            scan_word_tail( value)

                    } else {
                            if(byte == byte_value(45)) {
                                    handle peek(&*value, 1) {
                                        Result::Ok(next) => {
                                            if(byte_is_alphanumeric(next)) {
                                                    advance(&mut *value, 2);
                                                    scan_word_tail( value)

                                            } else {
                                                    if(next == byte_value(95)) {
                                                            advance(&mut *value, 2);
                                                            scan_word_tail( value)

                                                    } else {
                                                        ()
                                                    }

                                            }
                                        },
                                        Result::Err(_) => ()
                                    }

                            } else {
                                ()
                            }

                    }

            }
        },
        Result::Err(_) => ()
    }
}

scan_line_comment(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte == byte_value(10)) {
                ()
            } else {
                    advance(&mut *value, 1);
                    scan_line_comment( value)

            }
        },
        Result::Err(_) => ()
    }
}

scan_block_comment(value: &mut Lexer, start: usize, depth: usize) -> Result<(), LexError> {
    if(depth == 0) {
        Result::Ok(())
    } else {
            if(value.cursor < Bytes::len(&value.bytes)) {
                    if(peek_is(&*value, 0, 47)) {
                        if(peek_is(&*value, 1, 42)) {
                        advance(&mut *value, 2);
                        scan_block_comment( value, start, depth + 1)

                        } else {
                        advance(&mut *value, 1);
                        scan_block_comment( value, start, move depth)

                        }
                    } else {
                        if(peek_is(&*value, 0, 42)) {
                        if(peek_is(&*value, 1, 47)) {
                        advance(&mut *value, 2);
                        scan_block_comment( value, start, depth - 1)

                        } else {
                        advance(&mut *value, 1);
                        scan_block_comment( value, start, move depth)

                        }
                        } else {
                        advance(&mut *value, 1);
                        scan_block_comment( value, start, move depth)

                        }
                    }

            } else {
                Result::Err(
                lex_error(LexErrorKind::UnfinishedComment, 2, start, Bytes::len(&value.bytes))
                )
            }

    }
}

scan_label_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte_is_alphanumeric(byte)) {
                    advance(&mut *value, 1);
                    scan_label_tail( value)

            } else {
                if(byte == byte_value(95)) {
                advance(&mut *value, 1);
                scan_label_tail( value)

                } else {
                ()
                }
            }
        },
        Result::Err(_) => ()
    }
}

scan_label(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 1);
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte_is_word_start(byte)) {
                    let name_start = value.cursor;
                    advance(&mut *value, 1);
                    scan_label_tail(&mut *value);
                    let name_end = value.cursor;
                    let id = intern_slice(&mut *value, name_start, move name_end);
                    push( value, TokenKind::Label(move id), 9, start);
                    Result::Ok(())

            } else {
                Result::Err(
                lex_error(LexErrorKind::InvalidLabel, 3, start, value.cursor)
                )
            }
        },
        Result::Err(_) => Result::Err(
            lex_error(LexErrorKind::InvalidLabel, 3, start, value.cursor)
        )
    }
}

structural_two(first: u8, second: u8) -> Option<CodedTokenKind> {
    handle first {
        45 => if(second == byte_value(62)) {
            Option::Some(
                CodedTokenKind { kind: TokenKind::Arrow, code: 23 }
            )
        } else { None },
        61 => handle second {
            62 => Option::Some(
                CodedTokenKind { kind: TokenKind::FatArrow, code: 24 }
            ),
            61 => Option::Some(
                CodedTokenKind { kind: TokenKind::EqEq, code: 32 }
            ),
            _ => None
        },
        46 => if(second == byte_value(46)) {
            Option::Some(
                CodedTokenKind { kind: TokenKind::DotDot, code: 20 }
            )
        } else { None },
        33 => if(second == byte_value(61)) {
            Option::Some(
                CodedTokenKind { kind: TokenKind::BangEq, code: 33 }
            )
        } else { None },
        60 => if(second == byte_value(61)) {
            Option::Some(
                CodedTokenKind { kind: TokenKind::LtEq, code: 35 }
            )
        } else { None },
        62 => if(second == byte_value(61)) {
            Option::Some(
                CodedTokenKind { kind: TokenKind::GtEq, code: 37 }
            )
        } else { None },
        _ => None
    }
}

structural_one(value: u8) -> Option<CodedTokenKind> {
    handle move value {
        46 => Option::Some(CodedTokenKind { kind: TokenKind::Dot, code: 21 }),
        47 => Option::Some(CodedTokenKind { kind: TokenKind::Slash, code: 25 }),
        43 => Option::Some(CodedTokenKind { kind: TokenKind::Plus, code: 26 }),
        45 => Option::Some(CodedTokenKind { kind: TokenKind::Minus, code: 27 }),
        42 => Option::Some(CodedTokenKind { kind: TokenKind::Star, code: 28 }),
        37 => Option::Some(CodedTokenKind { kind: TokenKind::Percent, code: 29 }),
        124 => Option::Some(CodedTokenKind { kind: TokenKind::Pipe, code: 30 }),
        61 => Option::Some(CodedTokenKind { kind: TokenKind::Eq, code: 31 }),
        60 => Option::Some(CodedTokenKind { kind: TokenKind::Lt, code: 34 }),
        62 => Option::Some(CodedTokenKind { kind: TokenKind::Gt, code: 36 }),
        38 => Option::Some(CodedTokenKind { kind: TokenKind::Amp, code: 38 }),
        33 => Option::Some(CodedTokenKind { kind: TokenKind::Bang, code: 39 }),
        _ => None
    }
}

structural_two_exists(first: u8, second: u8) -> Bool {
    handle move second {
        46 => move first == byte_value(46),
        61 => handle move first {
            33 => true,
            60 => true,
            61 => true,
            62 => true,
            _ => false
        },
        62 => handle move first {
            45 => true,
            61 => true,
            _ => false
        },
        _ => false
    }
}

scan_operator_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(first) => {
            if(byte_is_operator(first)) {
                    if(structural_one(first)) {
                        ()
                    } else {
                            let pair_structural = handle peek(&*value, 1) {
                                Result::Ok(second) => structural_two_exists(
                                    first,
                                     second
                                ),
                                Result::Err(_) => false
                            };
                            if(move pair_structural) {
                                ()
                            } else {
                                    advance(&mut *value, 1);
                                    scan_operator_tail( value)

                            }

                    }

            } else {
                ()
            }
        },
        Result::Err(_) => ()
    }
}

scan_operator(value: &mut Lexer) {
    let start = value.cursor;
    let first = present_byte(peek(&*value, 0));
    let pair = handle peek(&*value, 1) {
        Result::Ok(second) => structural_two(first,  second),
        Result::Err(_) => None
    };
    handle move pair {
        Result::Ok(coded) => {
            advance(&mut *value, 2);
            push( value, move coded.kind, coded.code, start)
        },
        Result::Err(_) => handle structural_one(first) {
            Result::Ok(coded) => {
                advance(&mut *value, 1);
                push( value, move coded.kind, coded.code, start)
            },
            Result::Err(_) => {
                scan_operator_tail(&mut *value);
                let end = value.cursor;
                let id = intern_slice(&mut *value, start, move end);
                push( value, TokenKind::Operator(move id), 10, start)
            }
        }
    }
}

digit_valid(byte: u8, base_code: u8) -> Bool {
    handle base_code {
        1 => handle byte {
            48 => true,
            49 => true,
            _ => false
        },
        2 => byte_is_between(byte, 48, 55),
        3 => byte_is_digit(byte),
        _ => byte_is_hex(byte)
    }
}

scan_digit_tail(
    value: &mut Lexer,
    base_code: u8,
    last_separator: Option<usize>
) -> Result<Option<usize>, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(byte) => {
            if(byte == byte_value(95)) {
                    let separator = value.cursor;
                    advance(&mut *value, 1);
                    scan_digit_tail( value, base_code, Option::Some(move separator))

            } else {
                if(digit_valid(byte, base_code)) {
                advance(&mut *value, 1);
                scan_digit_tail( value, base_code, None)

                } else {
                if(byte_is_digit(byte)) {
                Result::Err(
                lex_error(
                LexErrorKind::InvalidDigit, 4,
                value.cursor,
                value.cursor + usize_value(1)
                )
                )
                } else {
                Result::Ok(move last_separator)
                }

                }
            }
        },
        Result::Err(_) => Result::Ok(move last_separator)
    }
}

scan_digits(
    value: &mut Lexer,
    base_code: u8,
    component_start: usize
) -> Result<Span, LexError> {
    let last_separator = try(
        scan_digit_tail(&mut *value, base_code, None),
        @scan_digits
    );
    handle move last_separator {
        Result::Ok(position) => Result::Err(
            lex_error(
                LexErrorKind::MisplacedDigitSeparator, 5,
                position,
                position + usize_value(1)
            )
        ),
        Result::Err(_) => if(value.cursor == component_start) {
                              Result::Err(
                              lex_error(
                              LexErrorKind::ExpectedDigits, 6,
                              component_start,
                              component_start
                              )
                              )
                          } else {
                              Result::Ok(span(component_start, value.cursor))
                          }
    }
}

skip_underscores(value: &mut Lexer) {
    if(peek_is(&*value, 0, 95)) {
            advance(&mut *value, 1);
            skip_underscores( value)

    } else {
        ()
    }
}

scan_number(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    let after_projection_dot = value.after_projection_dot;
    let base_code = handle peek(&*value, 0) {
        Result::Ok(48) => handle peek(&*value, 1) {
            Result::Ok(98) => byte_value(1),
            Result::Ok(111) => byte_value(2),
            Result::Ok(120) => byte_value(4),
            _ => byte_value(3)
        },
        _ => byte_value(3)
    };
    let base = handle base_code {
        1 => NumberBase::Binary,
        2 => NumberBase::Octal,
        3 => NumberBase::Decimal,
        _ => NumberBase::Hex
    };
    let non_decimal = base_code != byte_value(3);
    let digits = if(move non_decimal) {
            advance(&mut *value, 2);
            skip_underscores(&mut *value);
            let digits_start = value.cursor;
            handle peek(&*value, 0) {
                Result::Ok(byte) => if(digit_valid(byte, base_code)) {
                                        scan_digits(&mut *value, base_code, digits_start)
                                    } else {
                                        Result::Err(
                                        lex_error(LexErrorKind::ExpectedDigits, 6, start, value.cursor)
                                        )
                                    },
                Result::Err(_) => Result::Err(
                    lex_error(LexErrorKind::ExpectedDigits, 6, start, value.cursor)
                )
            }

                 } else {
                     scan_digits(&mut *value, base_code, start)
                 };
    let digit_span = try(move digits, @scan_number);
    let fraction_span = try(
        scan_fraction(&mut *value, base_code, move after_projection_dot),
        @scan_number
    );
    let exponent_span = try(
        scan_exponent(&mut *value, base_code),
        @scan_number
    );
    {
                            handle peek(&*value, 0) {
                                Result::Ok(byte) => {
                                    if(byte_is_alphanumeric(byte)) {
                                        Result::Err(
                                        lex_error(
                                        LexErrorKind::InvalidDigit, 4,
                                        value.cursor,
                                        value.cursor + usize_value(1)
                                        )
                                        )
                                    } else {
                                        if(byte == byte_value(95)) {
                                        Result::Err(
                                        lex_error(
                                        LexErrorKind::InvalidDigit, 4,
                                        value.cursor,
                                        value.cursor + usize_value(1)
                                        )
                                        )
                                        } else {
                                        finish_number(
                                        value,
                                        start,
                                        move base,
                                        base_code,
                                        move digit_span,
                                        move fraction_span,
                                        move exponent_span
                                        )
                                        }
                                    }
                                },
                                Result::Err(_) => finish_number(
                                     value,
                                    start,
                                    move base,
                                    base_code,
                                    move digit_span,
                                    move fraction_span,
                                    move exponent_span
                                )
                            }
    }
}

scan_fraction(
    value: &mut Lexer,
    base_code: u8,
    after_projection_dot: Bool
) -> Result<Option<Span>, LexError> {
    let decimal = base_code == byte_value(3);
    if(move decimal) {
        if(move after_projection_dot) {
        Result::Ok(None)
        } else {
        if(peek_is(&*value, 0, 46)) {
        handle peek(&*value, 1) {
        Result::Ok(next) => if(byte_is_digit(move next)) {
        advance(&mut *value, 1);
        let start = value.cursor;
        let found = try(
        scan_digits( value, base_code, start),
        @scan_fraction
        );
        Result::Ok(Option::Some(move found))

        } else {
        Result::Ok(None)
        },
        Result::Err(_) => Result::Ok(None)
        }
        } else {
        Result::Ok(None)
        }
        }
    } else {
        Result::Ok(None)
    }
}

scan_exponent(
    value: &mut Lexer,
    base_code: u8
) -> Result<Option<NumberExponent>, LexError> {
    let decimal = base_code == byte_value(3);
    if(move decimal) {
        handle peek(&*value, 0) {
        Result::Ok(marker) => handle marker {
        101 => scan_exponent_after_marker( value),
        69 => scan_exponent_after_marker( value),
        _ => Result::Ok(None)
        },
        Result::Err(_) => Result::Ok(None)
        }
    } else {
        Result::Ok(None)
    }
}

scan_exponent_after_marker(value: &mut Lexer) -> Result<Option<NumberExponent>, LexError> {
    let marker = value.cursor;
    let sign = handle peek(&*value, 1) {
        Result::Ok(byte) => handle byte {
            43 => usize_value(1),
            45 => usize_value(1),
            _ => usize_value(0)
        },
        Result::Err(_) => usize_value(0)
    };
    let candidate = handle peek(&*value, usize_value(1) + sign) {
        Result::Ok(byte) =>
            byte_is_digit(byte) or { byte == byte_value(95) },
        Result::Err(_) => false
    };
    if(move candidate) {
            advance(&mut *value, 1);
            let negative = peek_is(&*value, 0, 45);
            advance(&mut *value, move sign);
            let start = value.cursor;
            let found = try(
                scan_digits( value, 3, start),
                @scan_exponent_after_marker
            );
            Result::Ok(
                Option::Some(NumberExponent {
                    negative: move negative,
                    digits: move found
                })
            )

    } else {
        Result::Err(
        lex_error(
        LexErrorKind::MalformedFloatExponent, 7,
        marker,
        marker + usize_value(1) + sign
        )
        )
    }
}

finish_number(
    value: &mut Lexer,
    start: usize,
    base: NumberBase,
    base_code: u8,
    digits: Span,
    fraction: Option<Span>,
    exponent: Option<NumberExponent>
) -> Result<(), LexError> {
    let spelling = span(start, value.cursor);
    push(
         value,
        TokenKind::Number(NumberToken {
            spelling:  spelling,
            base:  base,
            base_code: base_code,
            digits:  digits,
            fraction:  fraction,
            exponent:  exponent
        }),
        4,
        start
    );
    Result::Ok(())
}
hex_value(value: u8) -> u32 {
    if(byte_is_digit(value)) {
        wrapping_convert_to_u32(value - 48)
    } else {
        if(byte_is_lower(value)) {
        wrapping_convert_to_u32(value - 97) + u32_value(10)
        } else {
        wrapping_convert_to_u32(value - 65) + u32_value(10)
        }
    }
}

hex_pair(value: &mut Lexer, backslash: usize) -> Result<u8, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(first) => if(byte_is_hex(first)) {
                                 handle peek(&*value, 1) {
                                 Result::Ok(second) => if(byte_is_hex(second)) {
                                 advance( value, 2);
                                 Result::Ok(
                                 wrapping_convert_to_u8(
                                 hex_value(first) * u32_value(16) + hex_value(second)
                                 )
                                 )

                                 } else {
                                 Result::Err(
                                 lex_error(
                                 LexErrorKind::MalformedHexEscape, 11,
                                 backslash,
                                 value.cursor + usize_value(1)
                                 )
                                 )
                                 },
                                 Result::Err(_) => Result::Err(
                                 lex_error(
                                 LexErrorKind::MalformedHexEscape, 11,
                                 backslash,
                                 value.cursor
                                 )
                                 )
                                 }
                             } else {
                                 Result::Err(
                                 lex_error(
                                 LexErrorKind::MalformedHexEscape, 11,
                                 backslash,
                                 value.cursor
                                 )
                                 )
                             },
        Result::Err(_) => Result::Err(
            lex_error(LexErrorKind::MalformedHexEscape, 11, backslash, value.cursor)
        )
    }
}

unicode_digits(
    value: &mut Lexer,
    backslash: usize,
    scalar: u32,
    digits: usize
) -> Result<char, LexError> {
    handle peek(&*value, 0) {
        Result::Ok(125) => {
            advance(&mut *value, 1);
            if(digits == 0) {
                Result::Err(
                lex_error(
                LexErrorKind::MalformedUnicodeEscape, 12,
                backslash,
                value.cursor
                )
                )
            } else {
                handle char_from_u32(move scalar) {
                Result::Ok(character) => scalar_ok( character),
                Result::Err(_) => Result::Err(
                lex_error(
                LexErrorKind::InvalidUnicodeScalar, 14,
                backslash,
                value.cursor
                )
                )
                }
            }
        },
        Result::Ok(byte) => if(byte_is_hex(byte)) {
                                if(digits == 6) {
                                Result::Err(
                                lex_error(
                                LexErrorKind::MalformedUnicodeEscape, 12,
                                backslash,
                                value.cursor + usize_value(1)
                                )
                                )
                                } else {
                                advance(&mut *value, 1);
                                unicode_digits(
                                value,
                                backslash,
                                scalar * 16 + hex_value(byte),
                                digits + 1
                                )

                                }
                            } else {
                                Result::Err(
                                lex_error(
                                LexErrorKind::MalformedUnicodeEscape, 12,
                                value.cursor,
                                value.cursor + usize_value(1)
                                )
                                )
                            },
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedUnicodeEscape, 13,
                backslash,
                Bytes::len(&value.bytes)
            )
        )
    }
}

unicode_escape(value: &mut Lexer, backslash: usize) -> Result<char, LexError> {
    if(peek_is(&*value, 0, 123)) {
            advance(&mut *value, 1);
            unicode_digits( value, backslash, 0, 0)

    } else {
        Result::Err(
        lex_error(
        LexErrorKind::MalformedUnicodeEscape, 12,
        backslash,
        value.cursor
        )
        )
    }
}

scalar_ok(value: char) -> Result<char, LexError> { Result::Ok( value) }

scalar_escape(value: &mut Lexer, backslash: usize) -> Result<char, LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedEscape, 8,
                backslash,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(selector) => {
            advance(&mut *value, 1);
            handle move selector {
                110 => scalar_ok('\n'),
                114 => scalar_ok('\r'),
                116 => scalar_ok('\t'),
                48 => scalar_ok('\0'),
                34 => scalar_ok('"'),
                39 => scalar_ok('\''),
                92 => scalar_ok('\\'),
                120 => {
                    let byte = try(
                        hex_pair(&mut *value, backslash),
                        @scalar_escape
                    );
                    handle split_byte(move byte, byte_value(127)) {
                        Result::Ok(byte) => handle char_from_u32(
                            wrapping_convert_to_u32(move byte)
                        ) {
                            Result::Ok(character) => scalar_ok( character),
                            Result::Err(_) => unreachable()
                        },
                        Result::Err(_) => Result::Err(
                            lex_error(
                                LexErrorKind::InvalidCharacterEscape, 9,
                                backslash,
                                value.cursor
                            )
                        )
                    }
                },
                117 => unicode_escape( value, backslash),
                _ => Result::Err(
                    lex_error(
                        LexErrorKind::UnknownEscape, 10,
                        backslash,
                        value.cursor
                    )
                )
            }
        }
    }
}

byte_ok(value: u8) -> Result<u8, LexError> { Result::Ok( value) }

byte_escape(value: &mut Lexer, backslash: usize) -> Result<u8, LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedEscape, 8,
                backslash,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(selector) => {
            advance(&mut *value, 1);
            handle move selector {
                110 => byte_ok(10),
                114 => byte_ok(13),
                116 => byte_ok(9),
                48 => byte_ok(0),
                34 => byte_ok(34),
                39 => byte_ok(39),
                92 => byte_ok(92),
                120 => hex_pair( value, backslash),
                117 => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteEscape, 15,
                        backslash,
                        value.cursor
                    )
                ),
                _ => Result::Err(
                    lex_error(
                        LexErrorKind::UnknownEscape, 10,
                        backslash,
                        value.cursor
                    )
                )
            }
        }
    }
}

scan_string_tail(
    value: &mut Lexer,
    start: usize,
    decoded: &mut StringBuilder
) -> Result<(), LexError> {
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedString, 16,
                start,
                Bytes::len(&value.bytes)
            )
        ),
        Result::Ok(34) => {
            advance( value, 1);
            Result::Ok(())
        },
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            let character = try(
                scalar_escape(&mut *value, move backslash),
                @scan_string_tail
            );
            StringBuilder::append_char(&mut *decoded, move character);
            scan_string_tail( value, start,  decoded)
        },
        Result::Ok(_) => {
            let cursor = value.cursor;
            let bytes = value.bytes;
            handle char_decode_utf8(&bytes, cursor) {
            Result::Ok(decoded_char) => {
                (*value).cursor = decoded_char.next;
                StringBuilder::append_char(&mut *decoded, move decoded_char.value);
                scan_string_tail( value, start,  decoded)
            },
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::UnexpectedCharacter, 1,
                    value.cursor,
                    value.cursor + usize_value(1)
                )
            )
            }
        }
    }
}

scan_string(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 1);
    let decoded = StringBuilder::new();
    try(scan_string_tail(&mut *value, start, &mut decoded), @scan_string);
    handle StringBuilder::finish( decoded) {
        Result::Ok(text) => {
            let id = intern_text(&mut *value, move text);
            push( value, TokenKind::String(move id), 5, start);
            Result::Ok(())
        },
        Result::Err(_) => unreachable()
    }
}

scan_byte_string_tail(
    value: &mut Lexer,
    start: usize,
    decoded: &mut Vec<u8>
) -> Result<(), LexError> {
    let bytes = value.bytes;
    let cursor = value.cursor;
    handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedByteString, 18,
                start,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(34) => {
            advance( value, 1);
            Result::Ok(())
        },
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            let byte = try(
                byte_escape(&mut *value, move backslash),
                @scan_byte_string_tail
            );
            Vec::push(&mut *decoded, move byte);
            scan_byte_string_tail( value, start,  decoded)
        },
        Result::Ok(byte) => handle split_byte(move byte, byte_value(127)) {
            Result::Ok(byte) => {
                advance(&mut *value, 1);
                Vec::push(&mut *decoded, move byte);
                scan_byte_string_tail( value, start,  decoded)
            },
            Result::Err(_) => handle char_decode_utf8(&bytes, cursor) {
                Result::Ok(character) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteStringCharacter, 17,
                        value.cursor,
                        character.next
                    )
                ),
                Result::Err(_) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteStringCharacter, 17,
                        value.cursor,
                        value.cursor + usize_value(1)
                    )
                )
            }
        }
    }
}

scan_byte_string(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 2);
    let decoded = Vec::new();
    try(
        scan_byte_string_tail(&mut *value, start, &mut decoded),
        @scan_byte_string
    );
    push(
         value,
        TokenKind::ByteString(Bytes::from_vec( decoded)),
        8,
        start
    );
    Result::Ok(())
}

scan_byte_literal(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    advance(&mut *value, 2);
    let bytes = value.bytes;
    let content_cursor = value.cursor;
    let decoded = handle peek(&*value, 0) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::UnfinishedByteLiteral, 21,
                start,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(39) => Result::Err(
            lex_error(
                LexErrorKind::EmptyByteLiteral, 19,
                start,
                value.cursor + usize_value(1)
            )
        ),
        Result::Ok(92) => {
            let backslash = value.cursor;
            advance(&mut *value, 1);
            byte_escape(&mut *value, move backslash)
        },
        Result::Ok(byte) => handle split_byte(move byte, byte_value(127)) {
            Result::Ok(byte) => {
                advance(&mut *value, 1);
                byte_ok(move byte)
            },
            Result::Err(_) => handle char_decode_utf8(&bytes, content_cursor) {
                Result::Ok(character) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteLiteral, 20,
                        value.cursor,
                        character.next
                    )
                ),
                Result::Err(_) => Result::Err(
                    lex_error(
                        LexErrorKind::InvalidByteLiteral, 20,
                        value.cursor,
                        value.cursor + usize_value(1)
                    )
                )
            }
        }
    };
    let byte = try(move decoded, @scan_byte_literal);
    if(peek_is(&*value, 0, 39)) {
            advance(&mut *value, 1);
            push( value, TokenKind::Byte(move byte), 7, start);
            Result::Ok(())

    } else {
        Result::Err(
        lex_error(
        LexErrorKind::UnfinishedByteLiteral, 21,
        start,
        value.cursor
        )
        )
    }
}

scan_char_or_lifetime(value: &mut Lexer) -> Result<(), LexError> {
    let start = value.cursor;
    handle peek(&*value, 1) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::InvalidLifetimeIdentifier, 24,
                start,
                start + usize_value(1)
            )
        ),
        Result::Ok(92) => {
            advance(&mut *value, 2);
            let character = try(
                scalar_escape(&mut *value, start + usize_value(1)),
                @scan_char_or_lifetime
            );
            if(peek_is(&*value, 0, 39)) {
                    advance(&mut *value, 1);
                    push( value, TokenKind::Char(move character), 6, start);
                    Result::Ok(())

            } else {
                Result::Err(
                lex_error(
                LexErrorKind::UnfinishedCharacterLiteral, 22,
                start,
                value.cursor
                )
                )
            }
        },
        Result::Ok(39) => Result::Err(
            lex_error(
                LexErrorKind::EmptyCharacterLiteral, 23,
                start,
                start + usize_value(2)
            )
        ),
        Result::Ok(_) => {
            let bytes = value.bytes;
            handle char_decode_utf8(&bytes, start + usize_value(1)) {
            Result::Err(_) => Result::Err(
                lex_error(
                    LexErrorKind::InvalidLifetimeIdentifier, 24,
                    start,
                    start + usize_value(1)
                )
            ),
            Result::Ok(character) => handle Bytes::get(&bytes, character.next) {
                Result::Ok(39) => {
                    (*value).cursor = character.next + 1;
                    push( value, TokenKind::Char(move character.value), 6, start);
                    Result::Ok(())
                },
                _ => scan_lifetime( value, start)
            }
            }
        }
    }
}

scan_lifetime_tail(value: &mut Lexer) {
    handle peek(&*value, 0) {
        Result::Ok(byte) => if(byte_is_alphanumeric(byte)) {
                advance(&mut *value, 1);
                scan_lifetime_tail( value)

                            } else {
                                if(byte == byte_value(95)) {
                                advance(&mut *value, 1);
                                scan_lifetime_tail( value)

                                } else {
                                ()
                                }
                            },
        Result::Err(_) => ()
    }
}

scan_lifetime(value: &mut Lexer, start: usize) -> Result<(), LexError> {
    (*value).cursor = start + usize_value(1);
    handle peek(&*value, 0) {
        Result::Ok(byte) => if(byte_is_word_start(byte)) {
                advance(&mut *value, 1);
                scan_lifetime_tail(&mut *value);
                if(peek_is(&*value, 0, 39)) {
                    Result::Err(
                    lex_error(
                    LexErrorKind::InvalidCharacterLiteral, 25,
                    start,
                    value.cursor + usize_value(1)
                    )
                    )
                } else {
                        let end = value.cursor;
                        let id = intern_slice(&mut *value, start, move end);
                        push( value, TokenKind::Lifetime(move id), 3, start);
                        Result::Ok(())

                }

                            } else {
                                Result::Err(
                                lex_error(
                                LexErrorKind::InvalidLifetimeIdentifier, 24,
                                start,
                                value.cursor
                                )
                                )
                            },
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::InvalidLifetimeIdentifier, 24,
                start,
                value.cursor
            )
        )
    }
}

// Keeping the driver in this file makes this slice independently executable by
// both backends.

pub lex(source: &String) -> Result<LexedSource, LexError> {
    let bytes = String::as_bytes(source);
    handle checked_usize_to_u32(Bytes::len(&bytes)) {
        Result::Err(_) => Result::Err(
            lex_error(
                LexErrorKind::ResourceLimit, 26,
                0,
                Bytes::len(&bytes)
            )
        ),
        Result::Ok(_) => {
            let lexer = Lexer {
                source: *source,
                bytes: move bytes,
                cursor: 0,
                tokens: Vec::new(),
                lexemes: Interner::new(),
                after_projection_dot: false
            };
            run( lexer)
        }
    }
}

run(value: Lexer) -> Result<LexedSource, LexError> {
    let length = Bytes::len(&value.bytes);
    if(value.cursor < length) {
        run_one( value)
    } else {
            let eof = Token {
                kind: TokenKind::Eof,
                code: 41,
                keyword_code: 0,
                span: span(
                    Bytes::len(&value.bytes),
                    Bytes::len(&value.bytes)
                )
            };
            Vec::push(&mut value.tokens, move eof);
            Result::Ok(LexedSource {
                tokens: move value.tokens,
                lexemes: move value.lexemes
            })

    }
}

run_one(value: Lexer) -> Result<LexedSource, LexError> {
    let start = value.cursor;
    let byte = present_byte(peek(&value, 0));
    if(byte_is_whitespace(byte)) {
            advance(&mut value, 1);
            run( value)

    } else {
        run_byte( value, move byte, move start)
    }
}

run_byte(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(58)) {
        Result::Ok(byte) => run_byte_low( value,  byte, move start),
        Result::Err(byte) => run_byte_high( value,  byte, move start)
    }
}

run_byte_low(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(39)) {
        Result::Ok(byte) => run_byte_low_39( value,  byte, move start),
        Result::Err(byte) => handle split_byte(move byte, byte_value(47)) {
            Result::Ok(byte) => run_byte_low_47( value,  byte, move start),
            Result::Err(byte) => run_byte_low_58( value,  byte, move start)
        }
    }
}

run_byte_low_39(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        34 => run_string_token( value),
        36 => run_dollar_token( value, move start),
        39 => run_char_or_lifetime_token( value),
        _ => run_general_byte( value, move byte, move start)
    }
}

run_byte_low_47(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(44)) {
        Result::Ok(byte) => run_byte_low_44( value,  byte, move start),
        Result::Err(byte) => handle byte {
            47 => run_slash_token( value, move start),
            _ => run_general_byte( value, move byte, move start)
        }
    }
}

run_byte_low_44(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        40 => run_structural( value, TokenKind::LParen, 11, move start),
        41 => run_structural( value, TokenKind::RParen, 12, move start),
        44 => run_structural( value, TokenKind::Comma, 17, move start),
        _ => run_general_byte( value, move byte, move start)
    }
}

run_byte_low_58(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle byte {
        58 => run_colon_token( value, move start),
        _ => run_general_byte( value, move byte, move start)
    }
}

run_byte_high(value: Lexer, byte: u8, start: usize) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(93)) {
        Result::Ok(byte) => run_byte_high_93( value,  byte, move start),
        Result::Err(byte) => run_byte_above_93( value,  byte, move start)
    }
}

run_byte_high_93(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(64)) {
        Result::Ok(byte) => handle byte {
            59 => run_structural( value, TokenKind::Semicolon, 22, move start),
            64 => run_label_token( value),
            _ => run_general_byte( value, move byte, move start)
        },
        Result::Err(byte) => handle byte {
            91 => run_structural( value, TokenKind::LBracket, 15, move start),
            93 => run_structural( value, TokenKind::RBracket, 16, move start),
            _ => run_general_byte( value, move byte, move start)
        }
    }
}

run_byte_above_93(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    handle split_byte(move byte, byte_value(98)) {
        Result::Ok(byte) => handle byte {
            98 => run_byte_prefix( value),
            _ => run_general_byte( value, move byte, move start)
        },
        Result::Err(byte) => handle byte {
            123 => run_structural( value, TokenKind::LBrace, 13, move start),
            125 => run_structural( value, TokenKind::RBrace, 14, move start),
            _ => run_general_byte( value, move byte, move start)
        }
    }
}

run_slash_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    if(peek_is(&value, 1, 47)) {
            scan_line_comment(&mut value);
            run( value)

    } else {
        if(peek_is(&value, 1, 42)) {
        advance(&mut value, 2);
        try(
        scan_block_comment(&mut value, move start, 1),
        @run_slash_token
        );
        run( value)

        } else {
        run_structural(
        value,
        TokenKind::Slash,
        25,
        move start
        )
        }
    }
}

run_dollar_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    run_structural( value, TokenKind::Dollar, 40,  start)
}

run_colon_token(value: Lexer, start: usize) -> Result<LexedSource, LexError> {
    advance(&mut value, 1);
    if(peek_is(&value, 0, 58)) {
            advance(&mut value, 1);
            push(&mut value, TokenKind::DoubleColon, 19, move start)

    } else {
        push(&mut value, TokenKind::Colon, 18, move start)
    };
    run( value)
}

run_label_token(value: Lexer) -> Result<LexedSource, LexError> {
    try(scan_label(&mut value), @run_label_token);
    run( value)
}

run_string_token(value: Lexer) -> Result<LexedSource, LexError> {
    try(scan_string(&mut value), @run_string_token);
    run( value)
}

run_char_or_lifetime_token(value: Lexer) -> Result<LexedSource, LexError> {
    try(
        scan_char_or_lifetime(&mut value),
        @run_char_or_lifetime_token
    );
    run( value)
}

run_byte_prefix(value: Lexer) -> Result<LexedSource, LexError> {
    handle peek(&value, 1) {
        Result::Ok(34) => {
            try(scan_byte_string(&mut value), @run_byte_prefix);
            run( value)
        },
        Result::Ok(39) => {
            try(scan_byte_literal(&mut value), @run_byte_prefix);
            run( value)
        },
        _ => {
            scan_word(&mut value);
            run( value)
        }
    }
}

run_general_byte(
    value: Lexer,
    byte: u8,
    start: usize
) -> Result<LexedSource, LexError> {
    if(byte_is_digit(byte)) {
            try(scan_number(&mut value), @run_general_byte);
            run( value)

    } else {
        if(byte_is_word_start(byte)) {
        scan_word(&mut value);
        run( value)

        } else {
        if(byte_is_operator(byte)) {
        scan_operator(&mut value);
        run( value)

        } else {
        handle char_decode_utf8(&value.bytes, start) {
        Result::Ok(character) => Result::Err(
        lex_error(
        LexErrorKind::UnexpectedCharacter, 1,
        start,
        character.next
        )
        ),
        Result::Err(_) => Result::Err(
        lex_error(
        LexErrorKind::UnexpectedCharacter, 1,
        start,
        start + usize_value(1)
        )
        )
        }
        }
        }
    }
}

run_structural(
    value: Lexer,
    kind: TokenKind,
    code: u16,
    start: usize
) -> Result<LexedSource, LexError> {
    advance(&mut value, 1);
    push(&mut value,  kind,  code,  start);
    run( value)
}

write_bytes(output: &mut ByteBuf, bytes: &Bytes) {
    ByteBuf::write_u32_le(
        &mut *output,
        wrapping_convert_to_u32(Bytes::len(bytes))
    );
    ByteBuf::append_bytes( output, bytes)
}

write_string(output: &mut ByteBuf, text: &String) {
    let bytes = String::as_bytes(text);
    write_bytes( output, &bytes)
}

write_source_span(output: &mut ByteBuf, source: &String, value: &Span) {
    let text = text_slice(source, value.start, value.end);
    write_string( output, &text)
}

normalized_span_len(bytes: &Bytes, cursor: usize, end: usize, count: usize) -> usize {
    if(cursor < end) {
            let byte = handle Bytes::get(bytes, cursor) {
                Result::Ok(found) => byte_value( found),
                Result::Err(_) => unreachable()
            };
            let next = if(byte == byte_value(95)) {
                           move count
                       } else {
                           count + usize_value(1)
                       };
            normalized_span_len(bytes, cursor + usize_value(1), end, move next)

    } else {
        move count
    }
}

write_normalized_span_bytes(
    output: &mut ByteBuf,
    bytes: &Bytes,
    cursor: usize,
    end: usize
) {
    if(cursor < end) {
            let byte = handle Bytes::get(bytes, cursor) {
                Result::Ok(found) => byte_value( found),
                Result::Err(_) => unreachable()
            };
            if(byte == byte_value(95)) {
                ()
            } else {
                ByteBuf::push(&mut *output, move byte)
            };
            write_normalized_span_bytes(
                 output,
                bytes,
                cursor + usize_value(1),
                end
            )

    } else {
        ()
    }
}

write_normalized_span(
    output: &mut ByteBuf,
    source: &String,
    value: &Span
) {
    let bytes = String::as_bytes(source);
    ByteBuf::write_u32_le(
        &mut *output,
        wrapping_convert_to_u32(
            normalized_span_len(&bytes, value.start, value.end, 0)
        )
    );
    write_normalized_span_bytes( output, &bytes, value.start, value.end)
}

base_code(value: &NumberToken) -> u8 {
    value.base_code
}

lexeme_text(value: &LexedSource, id: &Id<String>) -> String {
    handle Interner::get(&value.lexemes, *id) {
        Result::Ok(text) => *text,
        Result::Err(_) => unreachable()
    }
}

write_lexeme(output: &mut ByteBuf, value: &LexedSource, id: &Id<String>) {
    let text = lexeme_text(value, id);
    write_string( output, &text)
}

write_number(
    output: &mut ByteBuf,
    source: &String,
    value: &NumberToken
) {
    write_source_span(&mut *output, source, &value.spelling);
    ByteBuf::push(&mut *output, base_code(value));
    write_normalized_span(&mut *output, source, &value.digits);
    handle Option::as_ref(&value.fraction) {
        Result::Ok(fraction) => {
            ByteBuf::push(&mut *output, 1);
            write_normalized_span(&mut *output, source, move fraction)
        },
        Result::Err(_) => ByteBuf::push(&mut *output, 0)
    };
    handle Option::as_ref(&value.exponent) {
        Result::Ok(exponent) => {
            let negative = exponent_negative(exponent);
            let digits = exponent_digits(exponent);
            ByteBuf::push(&mut *output, 1);
            ByteBuf::push(&mut *output, wrapping_convert_to_u8(
                bool_value(move negative)
            ));
            write_normalized_span( output, source, &digits)
        },
        Result::Err(_) => ByteBuf::push( output, 0)
    }
}

write_token_payload(
    output: &mut ByteBuf,
    source: &String,
    lexed: &LexedSource,
    token: &Token
) {
    if(token.code <= 9) {
        handle *token_kind(token) {
        TokenKind::Ident(id) => write_lexeme( output, lexed, &id),
        TokenKind::Keyword(_) => ByteBuf::push( output, token.keyword_code),
        TokenKind::Lifetime(id) => write_lexeme( output, lexed, &id),
        TokenKind::Number(number) => write_number( output, source, &number),
        TokenKind::String(id) => write_lexeme( output, lexed, &id),
        TokenKind::Char(character) => ByteBuf::write_u32_le(
        output,
        char_to_u32( character)
        ),
        TokenKind::Byte(byte) => ByteBuf::push( output,  byte),
        TokenKind::ByteString(bytes) => write_bytes( output, &bytes),
        TokenKind::Label(id) => write_lexeme( output, lexed, &id),
        _ => unreachable()
        }
    } else {
        if(token.code == 10) {
        handle *token_kind(token) {
        TokenKind::Operator(id) => write_lexeme( output, lexed, &id),
        _ => unreachable()
        }
        } else {
        ()
        }
    }
}

write_tokens(
    output: &mut ByteBuf,
    source: &String,
    value: &LexedSource,
    index: usize
) {
    if(index < Vec::len(&value.tokens)) {
            let token = Vec::index(&value.tokens, index);
            ByteBuf::write_u16_le(&mut *output, token.code);
            ByteBuf::write_u64_le(
                &mut *output,
                wrapping_convert_to_u64(token.span.start)
            );
            ByteBuf::write_u64_le(
                &mut *output,
                wrapping_convert_to_u64(token.span.end)
            );
            write_token_payload(&mut *output, source, value, move token);
            write_tokens( output, source, value, index + usize_value(1))

    } else {
        ()
    }
}

encode_result(
    output: &mut ByteBuf,
    source: &String,
    result: Result<LexedSource, LexError>
) {
    handle  result {
        Result::Err(error) => {
            ByteBuf::push(&mut *output, 1);
            ByteBuf::write_u16_le(&mut *output, error.code);
            ByteBuf::write_u64_le(&mut *output, wrapping_convert_to_u64(error.span.start));
            ByteBuf::write_u64_le( output, wrapping_convert_to_u64(error.span.end))
        },
        Result::Ok(lexed) => {
            ByteBuf::push(&mut *output, 0);
            ByteBuf::write_u32_le(
                &mut *output,
                wrapping_convert_to_u32(Vec::len(&lexed.tokens))
            );
            write_tokens( output, source, &lexed, 0)
        }
    }
}

process_inputs(arguments: &Vec<String>, index: usize, output: &mut ByteBuf) / FileRead {
    if(index < Vec::len(arguments)) {
            let path = *Vec::index(arguments, index);
            let bytes = read_file(move path);
            handle String::from_utf8(move bytes) {
                Result::Ok(source) => encode_result(
                    &mut *output,
                    &source,
                    lex(&source)
                ),
                Result::Err(_) => {
                    ByteBuf::push(&mut *output, 2)
                }
            };
            process_inputs(arguments, index + usize_value(1),  output)

    } else {
        ()
    }
}

usize_value(value: usize) -> usize {
    value
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    let argument_count = Vec::len(&arguments);
    if(argument_count < usize_value(2)) {
        write_diagnostic(
        "usage: grandiose-self-host <output> <input>..."
        )
    } else {
            let output_path = *Vec::index(&arguments, 0);
            let encoded = ByteBuf::new();
            ByteBuf::write_u32_le(
                &mut encoded,
                wrapping_convert_to_u32(
                    argument_count - usize_value(1)
                )
            );
            process_inputs(&arguments, 1, &mut encoded);
            write_file(move output_path, ByteBuf::finish( encoded))

    }
}
