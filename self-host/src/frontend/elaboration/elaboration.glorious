) -> InterfaceFieldView {
    let field = interface_field_at(
        value,
        interface_field_id_from_usize(index)
    );
    InterfaceFieldView {
        name: field.name,
        ty: Id::to_u32(field.ty)
    }
}

pub interface_field_view_name(value: &InterfaceFieldView) -> u32 {
