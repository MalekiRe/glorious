type_id_from_usize(value: usize) -> TypeId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

type_id_from_u32(value: u32) -> TypeId { Id::from_u32(value) }

interface_nominal_id_from_u32(value: u32) -> InterfaceNominalId {
    Id::from_u32(value)
}

interface_nominal_id_from_usize(value: usize) -> InterfaceNominalId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_field_id_from_u32(value: u32) -> InterfaceFieldId {
    Id::from_u32(value)
}

interface_field_id_from_usize(value: usize) -> InterfaceFieldId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_variant_id_from_u32(value: u32) -> InterfaceVariantId {
    Id::from_u32(value)
}

interface_variant_id_from_usize(value: usize) -> InterfaceVariantId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_effect_operation_id_from_usize(
    value: usize
) -> InterfaceEffectOperationId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_nominal_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceNominalId
) -> &'a InterfaceNominal {
    Arena::index(&value.nominals, id)
}

interface_field_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceFieldId
) -> &'a InterfaceField {
    Arena::index(&value.fields, id)
}

interface_variant_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceVariantId
) -> &'a InterfaceVariant {
    Arena::index(&value.variants, id)
}

interface_callable_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceCallableId
) -> &'a InterfaceCallable {
    Arena::index(&value.callables, id)
}

interface_effect_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceEffectId
) -> &'a InterfaceEffect {
    Arena::index(&value.effects, id)
}

interface_effect_operation_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceEffectOperationId
) -> &'a InterfaceEffectOperation {
    Arena::index(&value.effect_operations, id)
}

pub interface_effect_count(value: &TypedInterfaces) -> usize {
    Arena::len(&value.effects)
}

pub interface_effect_id_at(
    value: &TypedInterfaces,
    index: usize
) -> Option<InterfaceEffectId> {
    let id = try(Id::from_usize(index), @interface_effect_id_at);
    handle Arena::get(&value.effects, id) {
        Result::Err(_) => None,
        Result::Ok(_) => Option::Some(id)
    }
}

pub interface_effect_for_shell(
    value: &TypedInterfaces,
    shell: ShellId
) -> Option<InterfaceEffectId> {
    handle IndexVec::get(&value.shell_to_effect, shell) {
        Result::Err(_) => None,
        Result::Ok(found) => *found
    }
}

pub interface_effect_shell(
    value: &TypedInterfaces,
    id: InterfaceEffectId
) -> ShellId {
    interface_effect_at(value, id).shell
}

pub interface_effect_generic_count(
    value: &TypedInterfaces,
    id: InterfaceEffectId
) -> u32 {
    interface_effect_at(value, id).generics.count
}

pub interface_effect_constraint_start(
    value: &TypedInterfaces,
    id: InterfaceEffectId
) -> usize {
    interface_effect_at(value, id).constraints.start
}

pub interface_effect_constraint_end(
    value: &TypedInterfaces,
    id: InterfaceEffectId
) -> usize {
    interface_effect_at(value, id).constraints.end
}

pub interface_effect_constraint_goal_count(
    value: &TypedInterfaces,
    id: InterfaceEffectId
) -> u32 {
    interface_effect_at(value, id).constraints.goals.count
}

pub interface_effect_constraint_goal_id(
    value: &TypedInterfaces,
    id: InterfaceEffectId,
    ordinal: u32
) -> Option<ConstraintGoalId> {
    let range = interface_effect_at(value, id).constraints.goals;
    if(ordinal < range.count) {
        Option::Some(Id::from_u32(range.start + ordinal))
    } else { None }
}

pub interface_effect_constraint_lifetime_count(
    value: &TypedInterfaces,
    id: InterfaceEffectId
) -> u32 {
    interface_effect_at(value, id).constraints.lifetime_outlives.count
}

pub interface_effect_operation_count(
    value: &TypedInterfaces,
    id: InterfaceEffectId
) -> u32 {
    interface_effect_at(value, id).operations.count
}

pub interface_effect_operation_id(
    value: &TypedInterfaces,
    id: InterfaceEffectId,
    ordinal: u32
) -> Option<InterfaceEffectOperationId> {
    let range = interface_effect_at(value, id).operations;
    if(ordinal < range.count) {
        Option::Some(Id::from_u32(range.start + ordinal))
    } else { None }
}

