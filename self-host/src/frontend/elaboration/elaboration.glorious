pub typed_body_computation_at<'a>(
    value: &'a TypedBody,
    id: CoreComputationId
) -> CoreComputationView<'a> {
    let node = core_computation_at(&value.computations, id);
    let ty = node.ty;
    handle node.kind {
        CoreComputationKind::Pure(found) =>
            CoreComputationView::Pure(ty, found),
        CoreComputationKind::Let(local, initializer, remainder) =>
            CoreComputationView::Let(
                ty,
                local,
                initializer,
                remainder
            ),
        CoreComputationKind::Call(shell, instance, range) =>
            CoreComputationView::Call(
                ty,
                shell,
                instance,
                typed_body_operands(value, range)
            ),
        CoreComputationKind::Primitive(primitive, range) =>
            CoreComputationView::Primitive(
                ty,
                primitive,
                typed_body_operands(value, range)
            ),
        CoreComputationKind::Construct(flavor, range) =>
            CoreComputationView::Construct(
                ty,
                flavor,
                typed_body_construction_fields(value, range)
            ),
        CoreComputationKind::VariantDispatch(subject, range) =>
            CoreComputationView::VariantDispatch(
                ty,
                subject,
                typed_body_match_arms(value, range)
            ),
        CoreComputationKind::IntegerDispatch(subject, range) =>
            CoreComputationView::IntegerDispatch(
                ty,
                subject,
                typed_body_integer_arms(value, range)
            ),
        CoreComputationKind::Perform(operation, range) =>
            CoreComputationView::Perform(ty, operation, typed_body_operands(value, range)),
        CoreComputationKind::Resume(resumption, result) =>
            CoreComputationView::Resume(ty, resumption, result),
        CoreComputationKind::Handle(handled, range) => CoreComputationView::Handle(
            ty, handled, typed_body_handler_clauses(value, range)
        )
    }
}

pub typed_body_computation_type(
    value: &TypedBody,
    id: CoreComputationId
) -> TypeId {
    core_computation_at(&value.computations, id).ty
}

