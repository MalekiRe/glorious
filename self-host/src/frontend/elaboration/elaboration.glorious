// Minimal finalized Typed Core for pure unit/integer functions.
// All persistent identities and arena references are compact u32 words.

use super::lexer::TokenKind;
use super::resolution::ResolvedTarget;
use super::resolution::ResolvedPatternBinder;
use super::resolution::ResolutionError;

pub struct TypeTag {}
pub type TypeId = Id<TypeTag>;

pub struct InterfaceNominalTag {}
pub type InterfaceNominalId = Id<InterfaceNominalTag>;

struct TypeElementRange { start: u32, count: u32 }

impl Use<[0, *]> for TypeElementRange {}

enum TypeKind {
    Unit,
    Never,
    Scalar(u8),
    Tuple(TypeElementRange),
    Nominal(InterfaceNominalId),
    SharedReference(TypeId),
    UniqueReference(TypeId)
}

impl Use<[0, *]> for TypeKind {}

struct TypeNode { kind: TypeKind, copyable: Bool }

impl Use<[0, *]> for TypeNode {}

pub struct InterfaceFieldTag {}
pub type InterfaceFieldId = Id<InterfaceFieldTag>;

pub struct InterfaceVariantTag {}
pub type InterfaceVariantId = Id<InterfaceVariantTag>;

pub struct InterfaceCallableTag {}
pub type InterfaceCallableId = Id<InterfaceCallableTag>;

struct InterfaceFieldRange { start: u32, count: u32 }

impl Use<[0, *]> for InterfaceFieldRange {}

struct InterfaceVariantRange { start: u32, count: u32 }

impl Use<[0, *]> for InterfaceVariantRange {}

struct VariantPayloadRange { start: u32, count: u32 }

impl Use<[0, *]> for VariantPayloadRange {}

struct CallableParameterRange { start: u32, count: u32 }

impl Use<[0, *]> for CallableParameterRange {}

enum InterfaceNominalKind {
    Struct(InterfaceFieldRange),
    Enum(InterfaceVariantRange)
}

impl Use<[0, *]> for InterfaceNominalKind {}

enum NominalCopyState { Unresolved, Resolving, Resolved }

impl Use<[0, *]> for NominalCopyState {}

enum AliasResolutionState {
    Unresolved,
    Resolving,
    Resolved(TypeId)
}

impl Use<[0, *]> for AliasResolutionState {}

struct InterfaceNominal {
    shell: u32,
    kind: InterfaceNominalKind,
    copy_state: NominalCopyState
}

impl Use<[0, *]> for InterfaceNominal {}

struct InterfaceField {
    owner: InterfaceNominalId,
    name: u32,
    ty: TypeId,
    private: Bool,
    name_token: usize
}

impl Use<[0, *]> for InterfaceField {}

struct InterfaceVariant {
    owner: InterfaceNominalId,
    name: u32,
    payloads: VariantPayloadRange,
    name_token: usize
}

impl Use<[0, *]> for InterfaceVariant {}

struct InterfaceCallable {
    shell: u32,
    result: TypeId,
    parameters: CallableParameterRange
}

impl Use<[0, *]> for InterfaceCallable {}

pub struct TypedInterfaces {
    types: Arena<TypeTag, TypeNode>,
    type_elements: Vec<TypeId>,
    nominals: Arena<InterfaceNominalTag, InterfaceNominal>,
    fields: Arena<InterfaceFieldTag, InterfaceField>,
    variants: Arena<InterfaceVariantTag, InterfaceVariant>,
    variant_payloads: Vec<TypeId>,
    callables: Arena<InterfaceCallableTag, InterfaceCallable>,
    callable_parameters: Vec<TypeId>,
    // Indexed by declaration shell.
    shell_to_callable: Vec<Option<InterfaceCallableId>>,
    // Dense declaration maps keep semantic lookup independent of arena order.
    shell_to_nominal: Vec<Option<InterfaceNominalId>>,
    shell_to_type: Vec<Option<TypeId>>,
    // Collection-only memo state retained for deterministic diagnostics.
    alias_states: Vec<AliasResolutionState>
}

pub struct CoreValueTag {}
pub type CoreValueId = Id<CoreValueTag>;

pub struct CoreComputationTag {}
pub type CoreComputationId = Id<CoreComputationTag>;

pub struct CoreLocalTag {}
pub type CoreLocalId = Id<CoreLocalTag>;

pub struct IntegerConstantTag {}
pub type IntegerConstantId = Id<IntegerConstantTag>;

enum CoreLocalAccess { Move, Copy }

impl Use<[0, *]> for CoreLocalAccess {}

enum CoreValueKind {
    Unit,
    Integer(IntegerConstantId),
    Local(CoreLocalId, CoreLocalAccess),
    Projection(CoreValueId, u32),
    Embedded(CoreComputationId)
}

impl Use<[0, *]> for CoreValueKind {}

struct CoreValue { ty: TypeId, kind: CoreValueKind }

impl Use<[0, *]> for CoreValue {}

struct OperandRange { start: u32, count: u32 }

impl Use<[0, *]> for OperandRange {}

struct ConstructionFieldRange { start: u32, count: u32 }

impl Use<[0, *]> for ConstructionFieldRange {}

struct MatchArmRange { start: u32, count: u32 }

impl Use<[0, *]> for MatchArmRange {}

struct MatchBindingRange { start: u32, count: u32 }

impl Use<[0, *]> for MatchBindingRange {}

struct CheckedRangeWords { start: u32, count: u32 }

impl Use<[0, *]> for CheckedRangeWords {}

pub enum ConstructionFlavor {
    Product,
    Variant(u32)
}

impl Use<[0, *]> for ConstructionFlavor {}

enum CoreComputationKind {
    Pure(CoreValueId),
    Let(CoreLocalId, CoreComputationId, CoreComputationId),
    Call(u32, OperandRange),
    Construct(ConstructionFlavor, ConstructionFieldRange),
    Match(CoreValueId, MatchArmRange)
}

impl Use<[0, *]> for CoreComputationKind {}

struct CoreComputation { ty: TypeId, kind: CoreComputationKind }

impl Use<[0, *]> for CoreComputation {}

pub struct ConstructionField { field: u32, value: CoreValueId }

impl Use<[0, *]> for ConstructionField {}

pub struct CoreMatchArm {
    variant: u32,
    bindings: MatchBindingRange,
    body: CoreComputationId
}

impl Use<[0, *]> for CoreMatchArm {}

pub struct CoreMatchBinding {
    field: u32,
    local: Option<CoreLocalId>,
    ty: TypeId
}

impl Use<[0, *]> for CoreMatchBinding {}

struct IntegerConstant { low0: u32, low1: u32, high0: u32, high1: u32 }

impl Use<[0, *]> for IntegerConstant {}

pub struct TypedBody {
    shell: u32,
    result_type: TypeId,
    root: CoreComputationId,
    local_types: IndexVec<CoreLocalTag, TypeId>,
    values: Arena<CoreValueTag, CoreValue>,
    computations: Arena<CoreComputationTag, CoreComputation>,
    operands: Vec<CoreValueId>,
    construction_fields: Vec<ConstructionField>,
    match_arms: Vec<CoreMatchArm>,
    match_bindings: Vec<CoreMatchBinding>,
    integer_constants: Arena<IntegerConstantTag, IntegerConstant>
}

pub enum ElaborationError {
    CyclicTypeAlias(usize),
    MissingAliasHeader(usize),
    MissingDeclarationShell(usize),
    GenericTypeAliasUnsupported(usize),
    MissingNominalType(usize),
    UnknownTypeName(usize),
    UnknownTypeModule(usize),
    NamedReferenceLifetimeUnsupported(usize),
    InvalidSignatureType(usize),
    MissingParameterHeader(usize),
    MissingCallableHeader(usize),
    UnsupportedCallableSignature(usize),
    MissingCallableType(usize),
    MissingNominalDeclaration(usize),
    MissingFieldHeader(usize),
    MissingVariantHeader(usize),
    MissingStructHeader(usize),
    MissingEnumHeader(usize),
    CyclicNominalType(usize, u32),
    InvalidResolvedExpression(usize, usize),
    TypeMismatch(usize, u32, u32),
    FloatLiteralUnsupported(usize),
    IntegerLiteralOutOfRange(usize, u32),
    UnexpectedExpressionToken(usize),
    FunctionUsedAsValue(usize),
    MissingLocalType(usize),
    MissingCallableInterface(usize, u32),
    ArgumentCountMismatch(usize, u32, u32),
    InvalidCallTarget(usize, u32),
    InvalidTupleElement(usize, usize),
    MissingTupleElement(usize, u32),
    ExpectedTupleType(usize, u32),
    UnknownStructField(usize, u32),
    DuplicateOrInaccessibleField(usize, u32),
    StructFieldCountMismatch(usize, u32, u32),
    InvalidStructTarget(usize, u32),
    VariantPayloadCountMismatch(usize, u32, u32),
    MissingVariant(usize, u32),
    UnknownProjectionField(usize, u32, u32),
    DuplicateMatchVariant(usize, u32, u32),
    VariantOwnerMismatch(usize, u32, u32),
    MissingMatchVariants(usize, u32, u32),
    ExpectedEnumType(usize, u32),
    UnsupportedExpression(usize),
    MissingBodyCallable(usize, u32),
    IntegerEncodingOverflow(usize, u32),
    InvalidLocalReference(usize, u32, u32),
    EmbeddedValueSerializationUnsupported(usize),
    MatchSerializationUnsupported(usize)
}

// Backend-facing views keep the finalized Core representation semantic.
// They deliberately expose identities and checked borrowed slices, not the
// storage layout of the arenas that own them.
pub enum InterfaceTypeView<'a> {
    Unit,
    Never,
    Scalar(u8),
    Tuple(Slice<'a, TypeId>),
    Nominal(u32),
    SharedReference(u32),
    UniqueReference(u32)
}

impl<'a> Use<[0, *]> for InterfaceTypeView<'a> {}

pub enum InterfaceNominalView {
    Struct(u32, u32, u32),
    Enum(u32, u32, u32)
}

impl Use<[0, *]> for InterfaceNominalView {}

pub struct InterfaceFieldView { name: u32, ty: u32 }

impl Use<[0, *]> for InterfaceFieldView {}

pub enum CoreValueView {
    Unit(TypeId),
    Integer(TypeId, IntegerConstantId),
    Local(TypeId, CoreLocalId, Bool),
    Projection(TypeId, CoreValueId, u32),
    Embedded(TypeId, CoreComputationId)
}

impl Use<[0, *]> for CoreValueView {}

pub enum CoreComputationView<'a> {
    Pure(TypeId, CoreValueId),
    Let(TypeId, CoreLocalId, CoreComputationId, CoreComputationId),
    Call(TypeId, u32, Slice<'a, CoreValueId>),
    Construct(TypeId, ConstructionFlavor, Slice<'a, ConstructionField>),
    Match(TypeId, CoreValueId, Slice<'a, CoreMatchArm>)
}

impl<'a> Use<[0, *]> for CoreComputationView<'a> {}

pub struct IntegerConstantView {
    low0: u32,
    low1: u32,
    high0: u32,
    high1: u32
}

impl Use<[0, *]> for IntegerConstantView {}

enum ElaborationTarget {
    Missing,
    Parameter(super::resolution::ParameterId),
    Local(super::resolution::LocalId),
    Function(u32),
    Struct(u32),
    Variant(u32)
}

impl Use<[0, *]> for ElaborationTarget {}

struct ElaborationBinderRange { start: u32, count: u32 }

impl Use<[0, *]> for ElaborationBinderRange {}

struct ElaborationHandleArm {
    variant: u32,
    binders: ElaborationBinderRange
}

impl Use<[0, *]> for ElaborationHandleArm {}

struct ResolutionMap {
    targets: Vec<ElaborationTarget>,
    handle_arms:
        IndexVec<super::bodies::HandleArmTag, ElaborationHandleArm>,
    pattern_binders: Vec<super::resolution::ResolvedPatternBinder>
}

struct BodyBuilder {
    parameter_count: u32,
    next_source_local: u32,
    final_transfer_expressions:
        IndexVec<super::bodies::ExprTag, Bool>,
    local_types: IndexVec<CoreLocalTag, Option<TypeId>>,
    values: Arena<CoreValueTag, CoreValue>,
    computations: Arena<CoreComputationTag, CoreComputation>,
    operands: Vec<CoreValueId>,
    construction_fields: Vec<ConstructionField>,
    match_arms: Vec<CoreMatchArm>,
    match_bindings: Vec<CoreMatchBinding>,
    integer_constants: Arena<IntegerConstantTag, IntegerConstant>
}

enum ElaboratedForm {
    Value(CoreValueId),
    Computation(CoreComputationId)
}

impl Use<[0, *]> for ElaboratedForm {}

struct Elaborated {
    type_id: TypeId,
    form: ElaboratedForm
}

impl Use<[0, *]> for Elaborated {}

struct LetWrapper {
    local: CoreLocalId,
    initializer: CoreComputationId
}

impl Use<[0, *]> for LetWrapper {}

struct TypeNameTarget { kind: u8, index: u32 }

type_id_from_usize(value: usize) -> TypeId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

type_id_from_u32(value: u32) -> TypeId { Id::from_u32(value) }

interface_nominal_id_from_u32(value: u32) -> InterfaceNominalId {
    Id::from_u32(value)
}

interface_nominal_id_from_usize(value: usize) -> InterfaceNominalId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_field_id_from_u32(value: u32) -> InterfaceFieldId {
    Id::from_u32(value)
}

interface_field_id_from_usize(value: usize) -> InterfaceFieldId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_variant_id_from_u32(value: u32) -> InterfaceVariantId {
    Id::from_u32(value)
}

interface_variant_id_from_usize(value: usize) -> InterfaceVariantId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_callable_id_from_usize(value: usize) -> InterfaceCallableId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_nominal_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceNominalId
) -> &'a InterfaceNominal {
    Arena::index(&value.nominals, id)
}

interface_field_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceFieldId
) -> &'a InterfaceField {
    Arena::index(&value.fields, id)
}

interface_variant_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceVariantId
) -> &'a InterfaceVariant {
    Arena::index(&value.variants, id)
}

interface_callable_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceCallableId
) -> &'a InterfaceCallable {
    Arena::index(&value.callables, id)
}

interface_callable_result(
    value: &TypedInterfaces,
    id: InterfaceCallableId
) -> TypeId {
    interface_callable_at(value, id).result
}

interface_callable_parameters(
    value: &TypedInterfaces,
    id: InterfaceCallableId
) -> CallableParameterRange {
    interface_callable_at(value, id).parameters
}

interface_callable_for_shell_id(
    value: &TypedInterfaces,
    shell: u32
) -> Option<InterfaceCallableId> {
    if(usize_from_u32(shell) < Vec::len(&value.shell_to_callable)) {
        *Vec::index(&value.shell_to_callable, usize_from_u32(shell))
    } else { None }
}

interface_type_for_shell(
    value: &TypedInterfaces,
    shell: u32
) -> Option<TypeId> {
    if(usize_from_u32(shell) < Vec::len(&value.shell_to_type)) {
        *Vec::index(&value.shell_to_type, usize_from_u32(shell))
    } else { None }
}

callable_parameter_type_at(
    value: &TypedInterfaces,
    index: usize
) -> TypeId {
    *Vec::index(&value.callable_parameters, index)
}

interface_nominal_is_struct(
    value: &TypedInterfaces,
    id: InterfaceNominalId
) -> Bool {
    handle interface_nominal_at(value, id).kind {
        InterfaceNominalKind::Struct(_) => true,
        InterfaceNominalKind::Enum(_) => false
    }
}

interface_field_type(
    value: &TypedInterfaces,
    id: InterfaceFieldId
) -> TypeId {
    interface_field_at(value, id).ty
}

variant_payload_type_at(
    value: &TypedInterfaces,
    index: usize
) -> TypeId {
    *Vec::index(&value.variant_payloads, index)
}

alloc_interface_nominal(
    value: &mut TypedInterfaces,
    nominal: InterfaceNominal
) -> InterfaceNominalId {
    handle Arena::alloc(&mut value.nominals, nominal) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

alloc_interface_field(
    value: &mut TypedInterfaces,
    field: InterfaceField
) -> InterfaceFieldId {
    handle Arena::alloc(&mut value.fields, field) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

alloc_interface_variant(
    value: &mut TypedInterfaces,
    variant: InterfaceVariant
) -> InterfaceVariantId {
    handle Arena::alloc(&mut value.variants, variant) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

alloc_interface_callable(
    value: &mut TypedInterfaces,
    callable: InterfaceCallable
) -> InterfaceCallableId {
    handle Arena::alloc(&mut value.callables, callable) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

set_interface_nominal_kind(
    value: &mut TypedInterfaces,
    id: InterfaceNominalId,
    kind: InterfaceNominalKind
) {
    let nominal = Arena::index_mut(&mut value.nominals, id);
    (*nominal).kind = kind;
}

set_nominal_copy_state(
    value: &mut TypedInterfaces,
    id: InterfaceNominalId,
    state: NominalCopyState
) {
    let nominal = Arena::index_mut(&mut value.nominals, id);
    (*nominal).copy_state = state;
}

type_node_at<'a>(
    value: &'a TypedInterfaces,
    id: TypeId
) -> &'a TypeNode {
    Arena::index(&value.types, id)
}

type_kind_at(value: &TypedInterfaces, id: TypeId) -> TypeKind {
    type_node_at(value, id).kind
}

type_is_copyable(value: &TypedInterfaces, id: TypeId) -> Bool {
    type_node_at(value, id).copyable
}

set_type_copyable(value: &mut TypedInterfaces, id: TypeId, flag: Bool) {
    let node = Arena::index_mut(&mut value.types, id);
    (*node).copyable = flag;
}

alloc_type(value: &mut TypedInterfaces, node: TypeNode) -> TypeId {
    handle Arena::alloc(&mut value.types, node) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

core_value_id_from_usize(value: usize) -> CoreValueId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

core_computation_id_from_usize(value: usize) -> CoreComputationId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

core_local_id_from_usize(value: usize) -> CoreLocalId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

core_local_id_from_u32(value: u32) -> CoreLocalId {
    Id::from_u32(value)
}

integer_constant_id_from_usize(value: usize) -> IntegerConstantId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

handle_arm_id_from_usize(
    value: usize
) -> super::bodies::HandleArmId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

core_value_at<'a>(
    values: &'a Arena<CoreValueTag, CoreValue>,
    id: CoreValueId
) -> &'a CoreValue {
    Arena::index(values, id)
}

core_computation_at<'a>(
    computations: &'a Arena<CoreComputationTag, CoreComputation>,
    id: CoreComputationId
) -> &'a CoreComputation {
    Arena::index(computations, id)
}

integer_constant_at<'a>(
    constants: &'a Arena<IntegerConstantTag, IntegerConstant>,
    id: IntegerConstantId
) -> &'a IntegerConstant {
    Arena::index(constants, id)
}

construction_field_at<'a>(
    fields: &'a Vec<ConstructionField>,
    index: usize
) -> &'a ConstructionField {
    Vec::index(fields, index)
}

let_wrapper_at(value: &Vec<LetWrapper>, index: usize) -> LetWrapper {
    *Vec::index(value, index)
}

optional_core_value_at(
    value: &Vec<Option<CoreValueId>>,
    index: usize
) -> Option<CoreValueId> {
    *Vec::index(value, index)
}

construction_flavor_word(value: ConstructionFlavor) -> u32 {
    handle value {
        ConstructionFlavor::Product => 0,
        ConstructionFlavor::Variant(ordinal) =>
            ordinal + 1
    }
}

pub elaboration_error_code(value: &ElaborationError) -> u8 {
    handle *value {
        ElaborationError::CyclicTypeAlias(_) => 1,
        ElaborationError::GenericTypeAliasUnsupported(_) => 1,
        ElaborationError::UnknownTypeName(_) => 1,
        ElaborationError::UnknownTypeModule(_) => 1,
        ElaborationError::NamedReferenceLifetimeUnsupported(_) => 1,
        ElaborationError::InvalidSignatureType(_) => 1,
        ElaborationError::UnsupportedCallableSignature(_) => 1,
        ElaborationError::MissingNominalDeclaration(_) => 1,
        ElaborationError::CyclicNominalType(_, _) => 1,
        ElaborationError::ExpectedTupleType(_, _) => 1,
        ElaborationError::FloatLiteralUnsupported(_) => 2,
        ElaborationError::FunctionUsedAsValue(_) => 2,
        ElaborationError::UnsupportedExpression(_) => 2,
        ElaborationError::MatchSerializationUnsupported(_) => 2,
        ElaborationError::TypeMismatch(_, _, _) => 3,
        ElaborationError::VariantOwnerMismatch(_, _, _) => 3,
        ElaborationError::ExpectedEnumType(_, _) => 3,
        ElaborationError::ArgumentCountMismatch(_, _, _) => 4,
        ElaborationError::StructFieldCountMismatch(_, _, _) => 4,
        ElaborationError::VariantPayloadCountMismatch(_, _, _) => 4,
        ElaborationError::DuplicateMatchVariant(_, _, _) => 4,
        ElaborationError::MissingMatchVariants(_, _, _) => 4,
        ElaborationError::IntegerLiteralOutOfRange(_, _) => 5,
        ElaborationError::InvalidCallTarget(_, _) => 6,
        ElaborationError::UnknownStructField(_, _) => 6,
        ElaborationError::DuplicateOrInaccessibleField(_, _) => 6,
        ElaborationError::InvalidStructTarget(_, _) => 6,
        ElaborationError::UnknownProjectionField(_, _, _) => 6,
        _ => 7
    }
}

pub elaboration_error_token(value: &ElaborationError) -> usize {
    handle *value {
        ElaborationError::CyclicTypeAlias(token) => token,
        ElaborationError::MissingAliasHeader(token) => token,
        ElaborationError::MissingDeclarationShell(token) => token,
        ElaborationError::GenericTypeAliasUnsupported(token) => token,
        ElaborationError::MissingNominalType(token) => token,
        ElaborationError::UnknownTypeName(token) => token,
        ElaborationError::UnknownTypeModule(token) => token,
        ElaborationError::NamedReferenceLifetimeUnsupported(token) => token,
        ElaborationError::InvalidSignatureType(token) => token,
        ElaborationError::MissingParameterHeader(index) => index,
        ElaborationError::MissingCallableHeader(index) => index,
        ElaborationError::UnsupportedCallableSignature(shell) => shell,
        ElaborationError::MissingCallableType(shell) => shell,
        ElaborationError::MissingNominalDeclaration(ordinal) => ordinal,
        ElaborationError::MissingFieldHeader(index) => index,
        ElaborationError::MissingVariantHeader(index) => index,
        ElaborationError::MissingStructHeader(shell) => shell,
        ElaborationError::MissingEnumHeader(shell) => shell,
        ElaborationError::CyclicNominalType(token, _) => token,
        ElaborationError::InvalidResolvedExpression(expression, _) =>
            expression,
        ElaborationError::TypeMismatch(token, _, _) => token,
        ElaborationError::FloatLiteralUnsupported(token) => token,
        ElaborationError::IntegerLiteralOutOfRange(token, _) => token,
        ElaborationError::UnexpectedExpressionToken(token) => token,
        ElaborationError::FunctionUsedAsValue(token) => token,
        ElaborationError::MissingLocalType(token) => token,
        ElaborationError::MissingCallableInterface(token, _) => token,
        ElaborationError::ArgumentCountMismatch(token, _, _) => token,
        ElaborationError::InvalidCallTarget(token, _) => token,
        ElaborationError::InvalidTupleElement(token, _) => token,
        ElaborationError::MissingTupleElement(token, _) => token,
        ElaborationError::ExpectedTupleType(token, _) => token,
        ElaborationError::UnknownStructField(token, _) => token,
        ElaborationError::DuplicateOrInaccessibleField(token, _) => token,
        ElaborationError::StructFieldCountMismatch(token, _, _) => token,
        ElaborationError::InvalidStructTarget(token, _) => token,
        ElaborationError::VariantPayloadCountMismatch(token, _, _) => token,
        ElaborationError::MissingVariant(token, _) => token,
        ElaborationError::UnknownProjectionField(token, _, _) => token,
        ElaborationError::DuplicateMatchVariant(token, _, _) => token,
        ElaborationError::VariantOwnerMismatch(token, _, _) => token,
        ElaborationError::MissingMatchVariants(token, _, _) => token,
        ElaborationError::ExpectedEnumType(token, _) => token,
        ElaborationError::UnsupportedExpression(token) => token,
        ElaborationError::MissingBodyCallable(shell, _) => shell,
        ElaborationError::IntegerEncodingOverflow(at, _) => at,
        ElaborationError::InvalidLocalReference(local, _, _) => local,
        ElaborationError::EmbeddedValueSerializationUnsupported(value) =>
            value,
        ElaborationError::MatchSerializationUnsupported(computation) =>
            computation
    }
}

pub elaboration_error_related(value: &ElaborationError) -> usize {
    handle *value {
        ElaborationError::InvalidResolvedExpression(_, occurrence) =>
            occurrence,
        ElaborationError::InvalidTupleElement(_, position) => position,
        _ => elaboration_error_token(value)
    }
}

pub elaboration_error_expected(value: &ElaborationError) -> u32 {
    handle *value {
        ElaborationError::CyclicNominalType(_, nominal) => nominal,
        ElaborationError::TypeMismatch(_, expected, _) => expected,
        ElaborationError::IntegerLiteralOutOfRange(_, ty) => ty,
        ElaborationError::ArgumentCountMismatch(_, expected, _) => expected,
        ElaborationError::MissingTupleElement(_, expected) => expected,
        ElaborationError::ExpectedTupleType(_, ty) => ty,
        ElaborationError::DuplicateOrInaccessibleField(_, field) => field,
        ElaborationError::StructFieldCountMismatch(_, expected, _) =>
            expected,
        ElaborationError::InvalidStructTarget(_, _) => 4,
        ElaborationError::VariantPayloadCountMismatch(_, expected, _) =>
            expected,
        ElaborationError::UnknownProjectionField(_, subject, _) => subject,
        ElaborationError::DuplicateMatchVariant(_, expected, _) => expected,
        ElaborationError::VariantOwnerMismatch(_, expected, _) => expected,
        ElaborationError::MissingMatchVariants(_, expected, _) => expected,
        ElaborationError::InvalidLocalReference(_, limit, _) => limit,
        _ => 0
    }
}

pub elaboration_error_found(value: &ElaborationError) -> u32 {
    handle *value {
        ElaborationError::CyclicNominalType(_, nominal) => nominal,
        ElaborationError::TypeMismatch(_, _, found) => found,
        ElaborationError::IntegerLiteralOutOfRange(_, ty) => ty,
        ElaborationError::MissingCallableInterface(_, shell) => shell,
        ElaborationError::ArgumentCountMismatch(_, _, found) => found,
        ElaborationError::InvalidCallTarget(_, found) => found,
        ElaborationError::ExpectedTupleType(_, ty) => ty,
        ElaborationError::UnknownStructField(_, name) => name,
        ElaborationError::DuplicateOrInaccessibleField(_, field) => field,
        ElaborationError::StructFieldCountMismatch(_, _, found) => found,
        ElaborationError::InvalidStructTarget(_, found) => found,
        ElaborationError::VariantPayloadCountMismatch(_, _, found) => found,
        ElaborationError::MissingVariant(_, variant) => variant,
        ElaborationError::UnknownProjectionField(_, _, name) => name,
        ElaborationError::DuplicateMatchVariant(_, _, found) => found,
        ElaborationError::VariantOwnerMismatch(_, _, found) => found,
        ElaborationError::MissingMatchVariants(_, _, found) => found,
        ElaborationError::ExpectedEnumType(_, found) => found,
        ElaborationError::MissingBodyCallable(_, shell) => shell,
        ElaborationError::IntegerEncodingOverflow(_, ty) => ty,
        ElaborationError::InvalidLocalReference(_, _, local) => local,
        ElaborationError::EmbeddedValueSerializationUnsupported(_) => 5,
        ElaborationError::MatchSerializationUnsupported(_) => 12,
        _ => 0
    }
}

pub interface_type_count(value: &TypedInterfaces) -> usize {
    Arena::len(&value.types)
}

pub interface_type_at<'a>(
    value: &'a TypedInterfaces,
    index: usize
) -> InterfaceTypeView<'a> {
    handle type_kind_at(value, type_id_from_usize(index)) {
        TypeKind::Unit => InterfaceTypeView::Unit,
        TypeKind::Never => InterfaceTypeView::Never,
        TypeKind::Scalar(kind) => InterfaceTypeView::Scalar(kind),
        TypeKind::Tuple(range) => InterfaceTypeView::Tuple(
            handle Slice::subslice(
                Vec::as_slice(&value.type_elements),
                usize_from_u32(range.start),
                usize_from_u32(range.count)
            ) {
                Result::Err(_) => unreachable(),
                Result::Ok(elements) => elements
            }
        ),
        TypeKind::Nominal(id) =>
            InterfaceTypeView::Nominal(Id::to_u32(id)),
        TypeKind::SharedReference(id) =>
            InterfaceTypeView::SharedReference(Id::to_u32(id)),
        TypeKind::UniqueReference(id) =>
            InterfaceTypeView::UniqueReference(Id::to_u32(id))
    }
}

pub interface_type_tag_at(value: &TypedInterfaces, index: usize) -> u8 {
    handle type_kind_at(value, type_id_from_usize(index)) {
        TypeKind::Unit => 1,
        TypeKind::Never => 2,
        TypeKind::Scalar(_) => 3,
        TypeKind::Tuple(_) => 4,
        TypeKind::Nominal(_) => 5,
        TypeKind::SharedReference(_) => 6,
        TypeKind::UniqueReference(_) => 7
    }
}

pub interface_type_a_at(value: &TypedInterfaces, index: usize) -> u32 {
    handle type_kind_at(value, type_id_from_usize(index)) {
        TypeKind::Scalar(kind) => u32_from_u8(kind),
        TypeKind::Tuple(range) => range.start,
        TypeKind::Nominal(id) => Id::to_u32(id),
        TypeKind::SharedReference(id) => Id::to_u32(id),
        TypeKind::UniqueReference(id) => Id::to_u32(id),
        _ => 0
    }
}

pub interface_type_b_at(value: &TypedInterfaces, index: usize) -> u32 {
    handle type_kind_at(value, type_id_from_usize(index)) {
        TypeKind::Tuple(range) => range.count,
        _ => 0
    }
}

pub interface_type_c_at(value: &TypedInterfaces, index: usize) -> u32 {
    value;
    index;
    0
}

pub interface_type_flags_at(value: &TypedInterfaces, index: usize) -> u32 {
    if(type_is_copyable(value, type_id_from_usize(index))) { 1 } else { 0 }
}

pub interface_type_element_count(value: &TypedInterfaces) -> usize {
    Vec::len(&value.type_elements)
}

checked_u32_from_usize(value: usize) -> u32 {
    handle checked_usize_to_u32(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub interface_nominal_count(value: &TypedInterfaces) -> usize {
    Arena::len(&value.nominals)
}

pub interface_nominal_at_view(
    value: &TypedInterfaces,
    index: usize
) -> InterfaceNominalView {
    let nominal = interface_nominal_at(
        value,
        interface_nominal_id_from_usize(index)
    );
    handle nominal.kind {
        InterfaceNominalKind::Struct(range) =>
            InterfaceNominalView::Struct(
                nominal.shell,
                range.start,
                range.count
            ),
        InterfaceNominalKind::Enum(range) =>
            InterfaceNominalView::Enum(
                nominal.shell,
                range.start,
                range.count
            )
    }
}

pub interface_nominal_word_at(
    value: &TypedInterfaces,
    index: usize,
    word: usize
) -> u32 {
    let nominal = interface_nominal_at(
        value,
        interface_nominal_id_from_usize(index)
    );
    handle word {
        0 => nominal.shell,
        1 => handle nominal.kind {
            InterfaceNominalKind::Struct(_) => 1,
            InterfaceNominalKind::Enum(_) => 2
        },
        2 => handle nominal.kind {
            InterfaceNominalKind::Struct(range) => range.start,
            InterfaceNominalKind::Enum(range) => range.start
        },
        _ => handle nominal.kind {
            InterfaceNominalKind::Struct(range) => range.count,
            InterfaceNominalKind::Enum(range) => range.count
        }
    }
}

pub interface_field_count(value: &TypedInterfaces) -> usize {
