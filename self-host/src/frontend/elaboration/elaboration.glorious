pub interface_field_word_at(
    value: &TypedInterfaces,
    index: usize,
    word: usize
) -> u32 {
    let field = interface_field_at(
        value,
        interface_field_id_from_usize(index)
    );
    handle word {
        0 => Id::to_u32(field.owner),
        1 => field.name,
        2 => Id::to_u32(field.ty),
        3 => if(field.private) { 1 } else { 0 },
        _ => u32_from_usize(field.name_token)
    }
}

