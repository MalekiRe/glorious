pub struct TypedInterfaces {
    types: Arena<TypeTag, TypeNode>,
    type_elements: Vec<TypeId>,
    nominals: Arena<InterfaceNominalTag, InterfaceNominal>,
    fields: Arena<InterfaceFieldTag, InterfaceField>,
    variants: Arena<InterfaceVariantTag, InterfaceVariant>,
    variant_payloads: Vec<TypeId>,
    callables: Arena<InterfaceCallableTag, InterfaceCallable>,
    callable_parameters: Vec<TypeId>,
    instances: Arena<CallableInstanceTag, CallableInstance>,
    instance_parameters: Vec<TypeId>,
    instance_substitutions: Vec<Option<TypeId>>,
    callable_effects: Vec<TypeId>,
    effects: Arena<InterfaceEffectTag, InterfaceEffect>,
    effect_operations:
        Arena<InterfaceEffectOperationTag, InterfaceEffectOperation>,
    effect_payloads: Vec<TypeId>,
    constraint_goals: Vec<ConstraintGoal>,
    constraint_arguments: Vec<ConstraintArgument>,
    constraint_bindings: Vec<ConstraintBinding>,
    constraint_effects: Vec<TypeId>,
    constraint_lifetimes: Vec<ConstraintLifetime>,
    constraint_binders: Vec<ConstraintBinder>,
    // Indexed by declaration shell.
    shell_to_callable:
        IndexVec<ShellTag, Option<InterfaceCallableId>>,
    // Dense declaration maps keep semantic lookup independent of arena order.
    shell_to_nominal:
        IndexVec<ShellTag, Option<InterfaceNominalId>>,
    shell_to_type: IndexVec<ShellTag, Option<TypeId>>,
    shell_to_effect: IndexVec<ShellTag, Option<InterfaceEffectId>>,
    // Collection-only memo state retained for deterministic diagnostics.
    alias_states: Vec<AliasResolutionState>
}

pub struct CoreValueTag {}
pub type CoreValueId = Id<CoreValueTag>;

pub struct CoreComputationTag {}
pub type CoreComputationId = Id<CoreComputationTag>;

pub struct CoreLocalTag {}
pub type CoreLocalId = Id<CoreLocalTag>;

pub struct IntegerConstantTag {}
pub type IntegerConstantId = Id<IntegerConstantTag>;

enum CoreValueKind {
    Unit,
    Integer(IntegerConstantId),
    // Retain decoded UTF-8 bytes rather than a lexer-local interner ID. Typed
    // Core outlives parsed syntax during backend lowering, where the lexed
    // source is intentionally unavailable.
    Text(Bytes),
    // Byte strings retain their decoded bytes directly.  Unlike text they may
    // contain non-UTF-8 data, so they cannot share the source text interner.
    Bytes(Bytes),
    Local(CoreLocalId, Bool),
    Projection(CoreValueId, u32),
    Embedded(CoreComputationId)
}

impl Use<[0, *]> for CoreValueKind {}

struct CoreValue { ty: TypeId, kind: CoreValueKind }

impl Use<[0, *]> for CoreValue {}

struct OperandRangeTag {}
type OperandRange = super::syntax::IdRange<OperandRangeTag>;

struct ConstructionFieldRangeTag {}
type ConstructionFieldRange =
    super::syntax::IdRange<ConstructionFieldRangeTag>;

struct MatchArmRangeTag {}
type MatchArmRange = super::syntax::IdRange<MatchArmRangeTag>;

struct MatchBindingRangeTag {}
type MatchBindingRange = super::syntax::IdRange<MatchBindingRangeTag>;

struct IntegerArmRangeTag {}
type IntegerArmRange = super::syntax::IdRange<IntegerArmRangeTag>;

pub enum ConstructionFlavor {
    Product,
    Variant(u32)
}

impl Use<[0, *]> for ConstructionFlavor {}

enum CoreComputationKind {
    Pure(CoreValueId),
    Let(CoreLocalId, CoreComputationId, CoreComputationId),
    Call(ShellId, CallableInstanceId, OperandRange),
    Primitive(u32, OperandRange),
    Construct(ConstructionFlavor, ConstructionFieldRange),
    VariantDispatch(CoreValueId, MatchArmRange),
    // A constrained terminal u32 handler is erased into an ordinary scalar
    // switch before effect lowering.  Its final arm is the required wildcard.
    IntegerDispatch(CoreValueId, IntegerArmRange),
    // Operation identity is an interface identity, never a spelling or a
    // callable shell. This keeps a future lowering from accidentally treating
    // `perform` as an ordinary call.
    Perform(InterfaceEffectOperationId, OperandRange),
    // A resume consumes the resumption value exactly once. Quantity checking
    // and MIR cleanup remain deliberately unimplemented in this foundation.
    Resume(CoreValueId, CoreValueId),
    // `handle body { ... }`: each clause owns fresh payload/resumption locals
    // and its typed computation. The body is a computation to preserve its
    // suspension point rather than embedding it as a value.
    Handle(CoreComputationId, CoreHandlerClauseRange)
}


struct CoreComputation { ty: TypeId, kind: CoreComputationKind }

impl Use<[0, *]> for CoreComputation {}

