    Call(TypeId, ShellId, CallableInstanceId, Slice<'a, CoreValueId>),
    Primitive(TypeId, u32, Slice<'a, CoreValueId>),
    Construct(TypeId, ConstructionFlavor, Slice<'a, ConstructionField>),
    VariantDispatch(TypeId, CoreValueId, Slice<'a, CoreMatchArm>),
    IntegerDispatch(TypeId, CoreValueId, Slice<'a, CoreIntegerArm>),
    Perform(TypeId, InterfaceEffectOperationId, Slice<'a, CoreValueId>),
    Resume(TypeId, CoreValueId, CoreValueId),
    Handle(TypeId, CoreComputationId, Slice<'a, CoreHandlerClause>)
