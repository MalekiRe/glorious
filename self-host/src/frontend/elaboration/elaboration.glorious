    let id = integer_constant_id_from_usize(index);
    let found = integer_constant_at(&value.integer_constants, id);
    handle word {
        0 => found.low0,
        1 => found.low1,
        2 => found.high0,
        3 => found.high1,
        _ => unreachable()
    }
}

push_word(value: &mut Vec<u32>, word: u32) {
    Vec::push(&mut *value,  word)
}

push_zeroes(value: &mut Vec<u32>, remaining: usize) {
    for_range(Range::new(0, remaining), { _ =>
        push_word(&mut *value, 0)
    })
}

push_missing_nominal_ids(
    value:
        &mut IndexVec<
            ShellTag,
            Option<InterfaceNominalId>
        >,
    remaining: usize
) {
    for_range(Range::new(0, remaining), { _ =>
        handle IndexVec::push(&mut *value, None) {
            Result::Err(_) => unreachable(),
            Result::Ok(_) => ()
        }
    })
}

push_missing_callable_ids(
