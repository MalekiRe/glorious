// Typed Core retains effect-control identities rather than encoding them as
// ordinary calls.  These ranges are deliberately separate from match arms:
// handler clauses bind payload and one-shot resumption locals, while a match
// arm binds only data projections.
pub struct CoreHandlerClauseTag {}
type CoreHandlerClauseRange = super::syntax::IdRange<CoreHandlerClauseTag>;

struct InterfaceEffectOperationRangeTag {}
type InterfaceEffectOperationRange =
    super::syntax::IdRange<InterfaceEffectOperationRangeTag>;

struct EffectPayloadRangeTag {}
type EffectPayloadRange = super::syntax::IdRange<EffectPayloadRangeTag>;

