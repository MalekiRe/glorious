pub enum CoreNodeId {
    Value(CoreValueId),
    Computation(CoreComputationId)
}

impl Use<[0, *]> for CoreNodeId {}

pub enum CoreNodeView<'a> {
    Value(CoreValueView),
    Computation(CoreComputationView<'a>)
}

impl<'a> Use<[0, *]> for CoreNodeView<'a> {}

pub core_node_view_type<'a>(value: CoreNodeView<'a>) -> TypeId {
    handle value {
        CoreNodeView::Value(found) => handle found {
            CoreValueView::Unit(ty) => ty,
            CoreValueView::Integer(ty, _) => ty,
            CoreValueView::Text(ty, _) => ty,
            CoreValueView::Bytes(ty, _) => ty,
            CoreValueView::Local(ty, _, _, _) => ty,
            CoreValueView::Projection(ty, _, _) => ty,
            CoreValueView::Embedded(ty, _) => ty
        },
        CoreNodeView::Computation(found) => handle found {
            CoreComputationView::Pure(ty, _) => ty,
            CoreComputationView::Let(ty, _, _, _) => ty,
            CoreComputationView::Call(ty, _, _, _) => ty,
            CoreComputationView::Primitive(ty, _, _) => ty,
            CoreComputationView::Construct(ty, _, _) => ty,
            CoreComputationView::VariantDispatch(ty, _, _) => ty,
            CoreComputationView::IntegerDispatch(ty, _, _) => ty,
            CoreComputationView::Perform(ty, _, _) => ty,
            CoreComputationView::Resume(ty, _, _) => ty,
            CoreComputationView::Handle(ty, _, _) => ty
        }
    }
}

core_node_view<'a>(
    body: &'a TypedBody,
    node: CoreNodeId
) -> CoreNodeView<'a> {
    handle node {
        CoreNodeId::Value(id) =>
            CoreNodeView::Value(typed_body_value_at(body, id)),
        CoreNodeId::Computation(id) => CoreNodeView::Computation(
            typed_body_computation_at(body, id)
        )
    }
}

core_node_child_count(
    body: &TypedBody,
    node: CoreNodeId
) -> usize {
    handle core_node_view(body, node) {
        CoreNodeView::Value(view) => handle view {
            CoreValueView::Projection(_, _, _) => 1,
            CoreValueView::Embedded(_, _) => 1,
            _ => 0
        },
        CoreNodeView::Computation(view) => handle view {
            CoreComputationView::Pure(_, _) => 1,
            CoreComputationView::Let(_, _, _, _) => 2,
            CoreComputationView::Call(_, _, _, operands) => Slice::len(operands),
            CoreComputationView::Primitive(_, _, operands) =>
                Slice::len(operands),
            CoreComputationView::Construct(_, _, fields) => Slice::len(fields),
            CoreComputationView::VariantDispatch(_, _, arms) =>
                Slice::len(arms) + 1,
            CoreComputationView::IntegerDispatch(_, _, arms) =>
                Slice::len(arms) + 1,
            CoreComputationView::Perform(_, _, operands) => Slice::len(operands),
            CoreComputationView::Resume(_, _, _) => 2,
            CoreComputationView::Handle(_, _, clauses) => Slice::len(clauses) + 1
        }
    }
}

core_node_child_at(
    body: &TypedBody,
    node: CoreNodeId,
    index: usize
) -> CoreNodeId {
    handle core_node_view(body, node) {
        CoreNodeView::Value(view) => handle view {
            CoreValueView::Projection(_, source, _) =>
                CoreNodeId::Value(source),
            CoreValueView::Embedded(_, computation) =>
                CoreNodeId::Computation(computation),
            _ => unreachable()
        },
        CoreNodeView::Computation(view) => handle view {
            CoreComputationView::Pure(_, value) => CoreNodeId::Value(value),
            CoreComputationView::Let(_, _, initializer, remainder) => {
                if(index == 0) {
                    CoreNodeId::Computation(initializer)
                } else { CoreNodeId::Computation(remainder) }
            },
            CoreComputationView::Call(_, _, _, operands) => {
                let value = handle Slice::get(operands, index) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => *found
                };
                CoreNodeId::Value(value)
            },
            CoreComputationView::Primitive(_, _, operands) => {
                let value = handle Slice::get(operands, index) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => *found
                };
                CoreNodeId::Value(value)
            },
            CoreComputationView::Construct(_, _, fields) => {
                let field = handle Slice::get(fields, index) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => found
                };
                CoreNodeId::Value(construction_field_value(field))
            },
            CoreComputationView::VariantDispatch(_, subject, arms) => {
                if(index == 0) { CoreNodeId::Value(subject) } else {
                    let arm = handle Slice::get(arms, index - 1) {
                        Result::Err(_) => unreachable(),
                        Result::Ok(found) => found
                    };
                    CoreNodeId::Computation(core_match_arm_body(arm))
                }
            },
            CoreComputationView::IntegerDispatch(_, subject, arms) => {
                if(index == 0) { CoreNodeId::Value(subject) } else {
                    let arm = handle Slice::get(arms, index - 1) {
                        Result::Err(_) => unreachable(),
                        Result::Ok(found) => found
                    };
                    CoreNodeId::Computation(core_integer_arm_body(arm))
                }
            },
            CoreComputationView::Perform(_, _, operands) => {
                let value = handle Slice::get(operands, index) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => *found
                };
                CoreNodeId::Value(value)
            },
            CoreComputationView::Resume(_, resumption, result) => if(index == 0) {
                CoreNodeId::Value(resumption)
            } else { CoreNodeId::Value(result) },
            CoreComputationView::Handle(_, handled, clauses) => if(index == 0) {
                CoreNodeId::Computation(handled)
            } else {
                let clause = handle Slice::get(clauses, index - 1) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => found
                };
                CoreNodeId::Computation(core_handler_clause_body(clause))
            }
        }
    }
}

__g1_push_core_walk_children(
    body: &TypedBody,
    work: &mut Vec<CoreNodeId>,
    node: CoreNodeId,
    count: usize
) {
    if(count > 0) {
        let child = count - 1;
        Vec::push(
            &mut *work,
            core_node_child_at(body, node, child)
        );
        __g1_push_core_walk_children(
            body,
            &mut *work,
            node,
            child
        )
    } else { () }
}

__g1_new_core_walk_work() -> Vec<CoreNodeId> { Vec::new() }

__g1_walk_core_work<'a, L, R, F, e: EffectRow>(
    body: &'a TypedBody,
    work: Vec<CoreNodeId>,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(CoreNodeId, CoreNodeView<'a>, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    handle Vec::pop(&mut work) {
        Result::Err(_) => { work; () },
        Result::Ok(node) => {
            handle visitor(node, core_node_view(body, node), stop) {
                Visit::Descend => __g1_push_core_walk_children(
                    body,
                    &mut work,
                    node,
                    core_node_child_count(body, node)
                ),
                Visit::SkipChildren => ()
            };
            __g1_walk_core_work(body, work, stop, visitor)
        }
    }
}

pub walk_core<'a, L, R, F, e: EffectRow>(
    body: &'a TypedBody,
    root: CoreComputationId,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(CoreNodeId, CoreNodeView<'a>, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    let work = __g1_new_core_walk_work();
    Vec::push(&mut work, CoreNodeId::Computation(root));
    __g1_walk_core_work(
        body,
        work,
        stop,
        visitor
    )
}

pub enum CoreRewriteVisit {
    Descend(CoreNodeId),
    SkipChildren(CoreNodeId)
}

impl Use<[0, *]> for CoreRewriteVisit {}

core_rewrite_value(value: CoreNodeId) -> CoreValueId {
    handle value {
        CoreNodeId::Value(found) => found,
        CoreNodeId::Computation(_) => unreachable()
    }
}

core_rewrite_computation(value: CoreNodeId) -> CoreComputationId {
    handle value {
        CoreNodeId::Computation(found) => found,
        CoreNodeId::Value(_) => unreachable()
    }
}

core_value_set_kind(value: &mut CoreValue, kind: CoreValueKind) {
    (*value).kind = move kind;
    ()
}

core_value_kind_copy(body: &TypedBody, id: CoreValueId) -> CoreValueKind {
    (Arena::index(&body.values, id)).kind
}

core_computation_set_kind(
    value: &mut CoreComputation,
    kind: CoreComputationKind
) {
    (*value).kind = move kind;
    ()
}

core_computation_kind_copy(
    body: &TypedBody,
    id: CoreComputationId
) -> CoreComputationKind {
    (Arena::index(&body.computations, id)).kind
}

construction_field_set_value(value: &mut ConstructionField, replacement: CoreValueId) {
    (*value).value = replacement;
    ()
}

core_match_arm_set_body(value: &mut CoreMatchArm, replacement: CoreComputationId) {
    (*value).body = replacement;
    ()
}

core_handler_clause_set_body(
    value: &mut CoreHandlerClause,
    replacement: CoreComputationId
) {
    (*value).body = replacement;
    ()
}


typed_body_set_root(value: &mut TypedBody, replacement: CoreComputationId) {
    (*value).root = replacement;
    ()
}

core_node_child_set(
    body: &mut TypedBody,
    node: CoreNodeId,
    index: usize,
    replacement: CoreNodeId
) {
    handle node {
        CoreNodeId::Value(id) => {
            let current = core_value_kind_copy(&*body, id);
            let next = handle current {
                CoreValueKind::Projection(_, field) => CoreValueKind::Projection(
                    core_rewrite_value(replacement),
                    field
                ),
                CoreValueKind::Embedded(_) => CoreValueKind::Embedded(
                    core_rewrite_computation(replacement)
                ),
                other => { replacement; index; other }
            };
            core_value_set_kind(
                Arena::index_mut(&mut body.values, id),
                move next
            )
        },
        CoreNodeId::Computation(id) => {
            let current = core_computation_kind_copy(&*body, id);
            let next = handle current {
                CoreComputationKind::Pure(_) => CoreComputationKind::Pure(
                    core_rewrite_value(replacement)
                ),
                CoreComputationKind::Let(local, initializer, remainder) => {
                    if(index == 0) {
                        CoreComputationKind::Let(
                            local,
                            core_rewrite_computation(replacement),
                            remainder
                        )
                    } else {
                        CoreComputationKind::Let(
                            local,
                            initializer,
                            core_rewrite_computation(replacement)
                        )
                    }
                },
                CoreComputationKind::Call(target, instance, operands) => {
                    *Vec::index_mut(
                        &mut body.operands,
                        usize_from_u32(operands.start) + index
                    ) = core_rewrite_value(replacement);
                    CoreComputationKind::Call(target, instance, operands)
                },
                CoreComputationKind::Primitive(primitive, operands) => {
                    *Vec::index_mut(
                        &mut body.operands,
                        usize_from_u32(operands.start) + index
                    ) = core_rewrite_value(replacement);
                    CoreComputationKind::Primitive(primitive, operands)
                },
                CoreComputationKind::Construct(flavor, fields) => {
                    construction_field_set_value(
                        Vec::index_mut(
                            &mut body.construction_fields,
                            usize_from_u32(fields.start) + index
                        ),
                        core_rewrite_value(replacement)
                    );
                    CoreComputationKind::Construct(flavor, fields)
                },
                CoreComputationKind::Perform(operation, operands) => {
                    *Vec::index_mut(
                        &mut body.operands,
                        usize_from_u32(operands.start) + index
                    ) = core_rewrite_value(replacement);
                    CoreComputationKind::Perform(operation, operands)
                },
                CoreComputationKind::Resume(resumption, result) => if(index == 0) {
                    CoreComputationKind::Resume(core_rewrite_value(replacement), result)
                } else { CoreComputationKind::Resume(resumption, core_rewrite_value(replacement)) },
                CoreComputationKind::Handle(handled, clauses) => {
                    if(index == 0) {
                        CoreComputationKind::Handle(core_rewrite_computation(replacement), clauses)
                    } else {
                        core_handler_clause_set_body(
                            Vec::index_mut(&mut body.handler_clauses,
                                usize_from_u32(clauses.start) + index - 1),
                            core_rewrite_computation(replacement)
                        );
                        CoreComputationKind::Handle(handled, clauses)
                    }
                },
                CoreComputationKind::VariantDispatch(subject, arms) => {
                    if(index == 0) {
                        CoreComputationKind::VariantDispatch(
                            core_rewrite_value(replacement),
                            arms
                        )
                    } else {
                        core_match_arm_set_body(
                            Vec::index_mut(
                                &mut body.match_arms,
                                usize_from_u32(arms.start) + index - 1
                            ),
                            core_rewrite_computation(replacement)
                        );
                        CoreComputationKind::VariantDispatch(subject, arms)
                    }
                },
                CoreComputationKind::IntegerDispatch(subject, arms) => {
                    if(index == 0) {
                        CoreComputationKind::IntegerDispatch(
                            core_rewrite_value(replacement), arms
                        )
                    } else {
                        core_integer_arm_set_body(
                            Vec::index_mut(
                                &mut body.integer_arms,
                                usize_from_u32(arms.start) + index - 1
                            ),
                            core_rewrite_computation(replacement)
                        );
                        CoreComputationKind::IntegerDispatch(subject, arms)
                    }
                }
            };
            core_computation_set_kind(
                Arena::index_mut(&mut body.computations, id),
                move next
            )
        }
    }
}

struct __CoreRewriteEdge { parent: CoreNodeId, child: usize }
struct __CoreRewriteDecision { replacement: CoreNodeId, descend: Bool }

__g1_new_core_rewrite_work() -> Vec<__CoreRewriteEdge> { Vec::new() }

__g1_core_rewrite_decision(value: CoreRewriteVisit) -> __CoreRewriteDecision {
    handle move value {
        CoreRewriteVisit::SkipChildren(replacement) =>
            __CoreRewriteDecision { replacement: replacement, descend: false },
        CoreRewriteVisit::Descend(replacement) =>
            __CoreRewriteDecision { replacement: replacement, descend: true }
    }
}

__g1_push_core_rewrite_children(
    work: &mut Vec<__CoreRewriteEdge>,
    node: CoreNodeId,
    count: usize
) {
    if(count > 0) {
        let child = count - 1;
        Vec::push(
            &mut *work,
            __CoreRewriteEdge { parent: node, child: child }
        );
        __g1_push_core_rewrite_children(&mut *work, node, child)
    } else { () }
}

__g1_rewrite_core_work<L, R, F, e: EffectRow>(
    body: &mut TypedBody,
    work: Vec<__CoreRewriteEdge>,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(&mut TypedBody, CoreNodeId, L), Output=CoreRewriteVisit, Effects={| e}>,
F: Use<[0, 0]> {
    handle Vec::pop(&mut work) {
        Result::Err(_) => { work; () },
        Result::Ok(edge) => {
            let __CoreRewriteEdge { parent, child } = move edge;
            let original = core_node_child_at(&*body, parent, child);
            let __CoreRewriteDecision { replacement, descend } =
                __g1_core_rewrite_decision(visitor(&mut *body, original, stop));
            core_node_child_set(&mut *body, parent, child, replacement);
            if(descend) {
                __g1_push_core_rewrite_children(
                    &mut work,
                    replacement,
                    core_node_child_count(&*body, replacement)
                )
            } else { () };
            __g1_rewrite_core_work(move body, move work, stop, visitor)
        }
    }
}

pub rewrite_core<L, R, F, e: EffectRow>(
    body: &mut TypedBody,
    root: CoreComputationId,
    stop: L,
    visitor: F
) -> CoreComputationId
where L: Label<R>,
F: Fn<(&mut TypedBody, CoreNodeId, L), Output=CoreRewriteVisit, Effects={| e}>,
F: Use<[0, 0]> {
    let __CoreRewriteDecision { replacement, descend } =
        __g1_core_rewrite_decision(
            visitor(&mut *body, CoreNodeId::Computation(root), stop)
        );
    let work = __g1_new_core_rewrite_work();
    if(descend) {
        __g1_push_core_rewrite_children(
            &mut work,
            replacement,
            core_node_child_count(&*body, replacement)
        )
    } else { () };
    __g1_rewrite_core_work(move body, move work, stop, visitor);
    core_rewrite_computation(replacement)
}

__g1_identity_rewrite_core<L, R>(body: TypedBody, stop: L) -> TypedBody
where L: Label<R> {
    let root = body.root;
    let rewritten = rewrite_core(
        &mut body,
        root,
        stop,
        { _, node, _ => CoreRewriteVisit::Descend(node) }
    );
    typed_body_set_root(&mut body, rewritten);
    move body
}

pub struct IntegerConstantView {
    low0: u32,
    low1: u32,
    high0: u32,
