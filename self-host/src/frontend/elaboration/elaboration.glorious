    NamedReferenceLifetimeUnsupported(usize),
    InvalidSignatureType(usize),
    MissingParameterHeader(usize),
    MissingCallableHeader(usize),
    UnsupportedCallableSignature(ShellId),
    MissingCallableType(ShellId),
    MissingEffectHeader(usize),
    MissingEffectOperationHeader(usize),
    MissingEffectType(ShellId),
    DuplicateEffectGeneric(usize, usize),
    DuplicateEffectOperation(usize, usize),
    DuplicateEffectOperationGeneric(usize, usize),
    MissingConstraintGoal(usize),
    MissingConstraintArgument(usize),
    MissingConstraintBinding(usize),
    UnknownConstraintRelation(usize),
    InvalidConstraintRelation(usize, ShellId),
    InvalidHigherRankedConstraintBinder(usize),
    ConstraintIntegerOverflow(usize),
    UnknownConstraintLifetime(usize),
    TerminalOperationResumptionQuantity(usize),
    InvalidResumptionInterval(usize),
    ResumptionQuantityOverflow(usize),
    MissingNominalDeclaration(usize),
    MissingFieldHeader(usize),
    MissingVariantHeader(usize),
    MissingStructHeader(ShellId),
    MissingEnumHeader(ShellId),
    CyclicNominalType(usize, u32),
    InvalidResolvedExpression(usize, usize),
    TypeMismatch(usize, u32, u32),
    FloatLiteralUnsupported(usize),
    IntegerLiteralOutOfRange(usize, u32),
    UnexpectedExpressionToken(usize),
    FunctionUsedAsValue(usize),
    MissingLocalType(usize),
    MissingCallableInterface(usize, ShellId),
    ArgumentCountMismatch(usize, u32, u32),
    InvalidCallTarget(usize, u32),
    InvalidTupleElement(usize, usize),
    MissingTupleElement(usize, u32),
    ExpectedTupleType(usize, u32),
    UnknownStructField(usize, u32),
    DuplicateOrInaccessibleField(usize, u32),
    StructFieldCountMismatch(usize, u32, u32),
    InvalidStructTarget(usize, u32),
    VariantPayloadCountMismatch(usize, u32, u32),
    MissingVariant(usize, u32),
    UnknownProjectionField(usize, u32, u32),
    DuplicateMatchVariant(usize, u32, u32),
    VariantOwnerMismatch(usize, u32, u32),
    MissingMatchVariants(usize, u32, u32),
    ExpectedEnumType(usize, u32),
    UnsupportedExpression(usize),
    MissingBodyCallable(ShellId),
    IntegerEncodingOverflow(usize, u32),
    InvalidLocalReference(usize, u32, u32),
    EmbeddedValueSerializationUnsupported(usize),
    VariantDispatchSerializationUnsupported(usize)
}

// Backend-facing views keep the finalized Core representation semantic.
// They deliberately expose identities and checked borrowed slices, not the
// storage layout of the arenas that own them.
pub enum InterfaceTypeView<'a> {
    Unit,
    Never,
    Scalar(u8),
    TypeParameter(u8, u32, u32),
    Tuple(Slice<'a, TypeId>),
    Text,
    Bytes,
    Array(u32),
    Application(u32, Slice<'a, TypeId>),
    Effect(u32),
    Nominal(u32),
    SharedReference(u32),
    UniqueReference(u32)
}

impl<'a> Use<[0, *]> for InterfaceTypeView<'a> {}

__g1_walk_type_elements<'a, L, R, F, e: EffectRow>(
    interfaces: &'a TypedInterfaces,
    elements: Slice<'a, TypeId>,
    index: usize,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(TypeId, InterfaceTypeView<'a>, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < Slice::len(elements)) {
        let child = handle Slice::get(elements, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => *found
        };
        walk_type(interfaces, child, stop, visitor);
        __g1_walk_type_elements(interfaces, elements, index + 1, stop, visitor)
    } else { () }
}

__g1_walk_type_children<'a, L, R, F, e: EffectRow>(
    interfaces: &'a TypedInterfaces,
    ty: TypeId,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(TypeId, InterfaceTypeView<'a>, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    handle interface_type_at(interfaces, Id::to_usize(ty)) {
        InterfaceTypeView::Tuple(elements) =>
            __g1_walk_type_elements(interfaces, elements, 0, stop, visitor),
        InterfaceTypeView::Array(element) =>
            walk_type(interfaces, Id::from_u32(element), stop, visitor),
        InterfaceTypeView::Application(constructor, elements) => {
            walk_type(interfaces, Id::from_u32(constructor), stop, visitor);
            __g1_walk_type_elements(interfaces, elements, 0, stop, visitor)
        },
        InterfaceTypeView::SharedReference(child) =>
            walk_type(interfaces, Id::from_u32(child), stop, visitor),
        InterfaceTypeView::UniqueReference(child) =>
            walk_type(interfaces, Id::from_u32(child), stop, visitor),
        _ => ()
    }
}

pub walk_type<'a, L, R, F, e: EffectRow>(
    interfaces: &'a TypedInterfaces,
    ty: TypeId,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(TypeId, InterfaceTypeView<'a>, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    handle visitor(
        ty,
        interface_type_at(interfaces, Id::to_usize(ty)),
        stop
    ) {
        Visit::Descend =>
            __g1_walk_type_children(interfaces, ty, stop, visitor),
        Visit::SkipChildren => ()
    }
}

__g1_fold_type_elements<'a, L, R, A, F, e: EffectRow>(
    interfaces: &'a TypedInterfaces,
    elements: Slice<'a, TypeId>,
    index: usize,
    accumulator: A,
    stop: L,
    visitor: F
) -> A
where L: Label<R>,
F: Fn<(A, TypeId, InterfaceTypeView<'a>, L), Output=FoldVisit<A>, Effects={| e}>,
F: Use<[0, 0]> {
    if(index < Slice::len(elements)) {
        let child = handle Slice::get(elements, index) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => *found
        };
        __g1_fold_type_elements(
            interfaces,
            elements,
            index + 1,
            fold_type(interfaces, child, accumulator, stop, visitor),
            stop,
            visitor
        )
    } else { accumulator }
}

__g1_fold_type_children<'a, L, R, A, F, e: EffectRow>(
    interfaces: &'a TypedInterfaces,
    ty: TypeId,
    accumulator: A,
    stop: L,
    visitor: F
) -> A
where L: Label<R>,
F: Fn<(A, TypeId, InterfaceTypeView<'a>, L), Output=FoldVisit<A>, Effects={| e}>,
F: Use<[0, 0]> {
    handle interface_type_at(interfaces, Id::to_usize(ty)) {
        InterfaceTypeView::Tuple(elements) => __g1_fold_type_elements(
            interfaces, elements, 0, accumulator, stop, visitor
        ),
        InterfaceTypeView::Array(element) => fold_type(
            interfaces, Id::from_u32(element), accumulator, stop, visitor
        ),
        InterfaceTypeView::Application(constructor, elements) =>
            __g1_fold_type_elements(
                interfaces,
                elements,
                0,
                fold_type(
                    interfaces,
                    Id::from_u32(constructor),
                    accumulator,
                    stop,
                    visitor
                ),
                stop,
                visitor
            ),
        InterfaceTypeView::SharedReference(child) => fold_type(
            interfaces, Id::from_u32(child), accumulator, stop, visitor
        ),
        InterfaceTypeView::UniqueReference(child) => fold_type(
            interfaces, Id::from_u32(child), accumulator, stop, visitor
        ),
        _ => accumulator
    }
}

pub fold_type<'a, L, R, A, F, e: EffectRow>(
    interfaces: &'a TypedInterfaces,
    ty: TypeId,
    accumulator: A,
    stop: L,
    visitor: F
) -> A
where L: Label<R>,
F: Fn<(A, TypeId, InterfaceTypeView<'a>, L), Output=FoldVisit<A>, Effects={| e}>,
F: Use<[0, 0]> {
    handle visitor(
        accumulator,
        ty,
        interface_type_at(interfaces, Id::to_usize(ty)),
        stop
    ) {
        FoldVisit::Descend(next) =>
            __g1_fold_type_children(interfaces, ty, next, stop, visitor),
        FoldVisit::SkipChildren(next) => next
    }
}

