    ty: TypeId
}

impl Use<[0, *]> for CoreMatchBinding {}

struct IntegerConstant { low0: u32, low1: u32, high0: u32, high1: u32 }

impl Use<[0, *]> for IntegerConstant {}

pub struct TypedBody {
    shell: ShellId,
    result_type: TypeId,
    root: CoreComputationId,
    local_types: IndexVec<CoreLocalTag, TypeId>,
    values: Arena<CoreValueTag, CoreValue>,
    transfer_candidates: IndexVec<CoreValueTag, Bool>,
    computations: Arena<CoreComputationTag, CoreComputation>,
    operands: Vec<CoreValueId>,
    construction_fields: Vec<ConstructionField>,
    match_arms: Vec<CoreMatchArm>,
    match_bindings: Vec<CoreMatchBinding>,
    integer_constants: Arena<IntegerConstantTag, IntegerConstant>
}

pub enum ElaborationError {
    CyclicTypeAlias(usize),
    MissingAliasHeader(usize),
    MissingDeclarationShell(usize),
    GenericTypeAliasUnsupported(usize),
    MissingNominalType(usize),
    UnknownTypeName(usize),
    UnknownTypeModule(usize),
    NamedReferenceLifetimeUnsupported(usize),
    InvalidSignatureType(usize),
    MissingParameterHeader(usize),
    MissingCallableHeader(usize),
    UnsupportedCallableSignature(ShellId),
    MissingCallableType(ShellId),
    MissingNominalDeclaration(usize),
    MissingFieldHeader(usize),
    MissingVariantHeader(usize),
    MissingStructHeader(ShellId),
    MissingEnumHeader(ShellId),
    CyclicNominalType(usize, u32),
    InvalidResolvedExpression(usize, usize),
    TypeMismatch(usize, u32, u32),
    FloatLiteralUnsupported(usize),
    IntegerLiteralOutOfRange(usize, u32),
    UnexpectedExpressionToken(usize),
    FunctionUsedAsValue(usize),
    MissingLocalType(usize),
    MissingCallableInterface(usize, ShellId),
    ArgumentCountMismatch(usize, u32, u32),
    InvalidCallTarget(usize, u32),
    InvalidTupleElement(usize, usize),
    MissingTupleElement(usize, u32),
    ExpectedTupleType(usize, u32),
    UnknownStructField(usize, u32),
    DuplicateOrInaccessibleField(usize, u32),
    StructFieldCountMismatch(usize, u32, u32),
    InvalidStructTarget(usize, u32),
    VariantPayloadCountMismatch(usize, u32, u32),
    MissingVariant(usize, u32),
    UnknownProjectionField(usize, u32, u32),
    DuplicateMatchVariant(usize, u32, u32),
    VariantOwnerMismatch(usize, u32, u32),
    MissingMatchVariants(usize, u32, u32),
    ExpectedEnumType(usize, u32),
    UnsupportedExpression(usize),
    MissingBodyCallable(ShellId),
    IntegerEncodingOverflow(usize, u32),
    InvalidLocalReference(usize, u32, u32),
    EmbeddedValueSerializationUnsupported(usize),
    VariantDispatchSerializationUnsupported(usize)
}

// Backend-facing views keep the finalized Core representation semantic.
// They deliberately expose identities and checked borrowed slices, not the
// storage layout of the arenas that own them.
pub enum InterfaceTypeView<'a> {
    Unit,
    Never,
    Scalar(u8),
    Tuple(Slice<'a, TypeId>),
    Nominal(u32),
    SharedReference(u32),
    UniqueReference(u32)
}

impl<'a> Use<[0, *]> for InterfaceTypeView<'a> {}

pub enum InterfaceNominalView {
    Struct(ShellId, u32, u32),
    Enum(ShellId, u32, u32)
}

impl Use<[0, *]> for InterfaceNominalView {}

pub struct InterfaceFieldView { name: u32, ty: u32 }

impl Use<[0, *]> for InterfaceFieldView {}

pub enum CoreValueView {
    Unit(TypeId),
    Integer(TypeId, IntegerConstantId),
    Local(TypeId, CoreLocalId, Bool),
    Projection(TypeId, CoreValueId, u32),
    Embedded(TypeId, CoreComputationId)
}

impl Use<[0, *]> for CoreValueView {}

pub enum CoreComputationView<'a> {
    Pure(TypeId, CoreValueId),
    Let(TypeId, CoreLocalId, CoreComputationId, CoreComputationId),
    Call(TypeId, ShellId, Slice<'a, CoreValueId>),
    Construct(TypeId, ConstructionFlavor, Slice<'a, ConstructionField>),
    VariantDispatch(TypeId, CoreValueId, Slice<'a, CoreMatchArm>)
}

impl<'a> Use<[0, *]> for CoreComputationView<'a> {}

pub struct IntegerConstantView {
    low0: u32,
    low1: u32,
    high0: u32,
    high1: u32
}

impl Use<[0, *]> for IntegerConstantView {}

enum PredeclaredNominal {
    Skip,
    Struct,
    Enum
}

impl Use<[0, *]> for PredeclaredNominal {}

interface_variant_range_start(value: InterfaceVariantRange) -> u32 {
    value.start
}

interface_variant_range_count(value: InterfaceVariantRange) -> u32 {
    value.count
}

variant_payload_range_count(value: VariantPayloadRange) -> u32 {
    value.count
}

variant_range_contains(
    value: InterfaceVariantRange,
    variant: u32
) -> Bool {
    let start = interface_variant_range_start(value);
    let count = interface_variant_range_count(value);
    start <= variant and { variant < start + count }
}

type ResolutionMap = super::resolution::ResolvedBody;

struct PlaceUse {
    expression: super::bodies::ExprId,
    local: CoreLocalId
}

impl Use<[0, *]> for PlaceUse {}

struct PlaceFlow {
    uses: Vec<PlaceUse>,
    transfer_eligible: IndexVec<super::bodies::ExprTag, Bool>
}

struct BodyContext {
    parameter_count: u32,
    next_source_local: u32,
    place_flow: PlaceFlow,
    core: CoreBuilder
}

struct CoreBuilder {
    local_types: IndexVec<CoreLocalTag, Option<TypeId>>,
    values: Arena<CoreValueTag, CoreValue>,
    transfer_candidates: IndexVec<CoreValueTag, Bool>,
    computations: Arena<CoreComputationTag, CoreComputation>,
    operands: Vec<CoreValueId>,
    construction_fields: Vec<ConstructionField>,
    match_arms: Vec<CoreMatchArm>,
    match_bindings: Vec<CoreMatchBinding>,
    integer_constants: Arena<IntegerConstantTag, IntegerConstant>
}

new_core_builder(
    local_types: IndexVec<CoreLocalTag, Option<TypeId>>
) -> CoreBuilder {
    CoreBuilder {
        local_types: local_types,
        values: Arena::new(),
        transfer_candidates: IndexVec::new(),
        computations: Arena::new(),
        operands: Vec::new(),
        construction_fields: Vec::new(),
        match_arms: Vec::new(),
        match_bindings: Vec::new(),
        integer_constants: Arena::new()
    }
}

new_body_context(
    parameter_count: u32,
    place_flow: PlaceFlow,
    local_types: IndexVec<CoreLocalTag, Option<TypeId>>
) -> BodyContext {
    BodyContext {
        parameter_count: parameter_count,
        next_source_local: 0,
        place_flow: place_flow,
        core: new_core_builder(local_types)
    }
}

enum ElaboratedForm {
    Value(CoreValueId),
    Computation(CoreComputationId)
}

impl Use<[0, *]> for ElaboratedForm {}

struct Elaborated {
    type_id: TypeId,
    form: ElaboratedForm
}

impl Use<[0, *]> for Elaborated {}

struct CoreBinding {
    local: CoreLocalId,
    initializer: CoreComputationId
}

impl Use<[0, *]> for CoreBinding {}

struct CorePrefix {
    lets: Vec<CoreBinding>
}

new_core_prefix() -> CorePrefix { CorePrefix { lets: Vec::new() } }

push_core_binding(
    prefix: &mut CorePrefix,
    local: CoreLocalId,
    initializer: CoreComputationId
) {
    Vec::push(&mut prefix.lets, CoreBinding {
        local: local,
        initializer: initializer
    })
}

enum TypeNameTarget {
    Alias(super::headers::AliasHeaderId),
    Struct(super::headers::StructHeaderId),
    Enum(super::headers::EnumHeaderId)
}

impl Use<[0, *]> for TypeNameTarget {}

type_id_from_usize(value: usize) -> TypeId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

type_id_from_u32(value: u32) -> TypeId { Id::from_u32(value) }

interface_nominal_id_from_u32(value: u32) -> InterfaceNominalId {
    Id::from_u32(value)
}

interface_nominal_id_from_usize(value: usize) -> InterfaceNominalId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_field_id_from_u32(value: u32) -> InterfaceFieldId {
    Id::from_u32(value)
}

interface_field_id_from_usize(value: usize) -> InterfaceFieldId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_variant_id_from_u32(value: u32) -> InterfaceVariantId {
    Id::from_u32(value)
}

interface_variant_id_from_usize(value: usize) -> InterfaceVariantId {
    handle Id::from_usize(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

interface_nominal_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceNominalId
) -> &'a InterfaceNominal {
    Arena::index(&value.nominals, id)
}

interface_field_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceFieldId
) -> &'a InterfaceField {
    Arena::index(&value.fields, id)
}

interface_variant_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceVariantId
) -> &'a InterfaceVariant {
    Arena::index(&value.variants, id)
}

interface_callable_at<'a>(
    value: &'a TypedInterfaces,
    id: InterfaceCallableId
) -> &'a InterfaceCallable {
    Arena::index(&value.callables, id)
}

pub interface_callable_result(
    value: &TypedInterfaces,
    id: InterfaceCallableId
) -> TypeId {
    interface_callable_at(value, id).result
}

interface_callable_parameters(
    value: &TypedInterfaces,
    id: InterfaceCallableId
) -> CallableParameterRange {
    interface_callable_at(value, id).parameters
}

pub interface_callable_id_at(
    value: &TypedInterfaces,
    index: usize
) -> Option<InterfaceCallableId> {
    let id = try(Id::from_usize(index), @interface_callable_id_at);
    handle Arena::get(&value.callables, id) {
        Result::Err(_) => None,
        Result::Ok(_) => Option::Some(id)
    }
}

interface_callable_for_shell_id(
    value: &TypedInterfaces,
    shell: ShellId
) -> Option<InterfaceCallableId> {
    handle IndexVec::get(&value.shell_to_callable, shell) {
        Result::Err(_) => None,
        Result::Ok(found) => *found
    }
}

interface_type_for_shell(
    value: &TypedInterfaces,
    shell: ShellId
) -> Option<TypeId> {
    handle IndexVec::get(&value.shell_to_type, shell) {
        Result::Err(_) => None,
        Result::Ok(found) => *found
    }
}

callable_parameter_type_at(
    value: &TypedInterfaces,
    index: usize
) -> TypeId {
    *Vec::index(&value.callable_parameters, index)
}

interface_nominal_is_struct(
    value: &TypedInterfaces,
    id: InterfaceNominalId
) -> Bool {
    handle interface_nominal_at(value, id).kind {
        InterfaceNominalKind::Struct(_) => true,
        InterfaceNominalKind::Enum(_) => false
    }
}

interface_field_type(
    value: &TypedInterfaces,
    id: InterfaceFieldId
) -> TypeId {
    interface_field_at(value, id).ty
}

variant_payload_type_at(
    value: &TypedInterfaces,
    index: usize
) -> TypeId {
    *Vec::index(&value.variant_payloads, index)
}

alloc_interface_nominal(
    value: &mut TypedInterfaces,
    nominal: InterfaceNominal
) -> InterfaceNominalId {
    handle Arena::alloc(&mut value.nominals, nominal) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

alloc_interface_field(
    value: &mut TypedInterfaces,
    field: InterfaceField
) -> InterfaceFieldId {
    handle Arena::alloc(&mut value.fields, field) {
        Result::Err(_) => unreachable(),
