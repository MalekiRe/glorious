pub typed_body_shell(value: &TypedBody) -> u32 { value.shell }

pub typed_body_result_type(value: &TypedBody) -> TypeId { value.result_type }

pub typed_body_root(value: &TypedBody) -> CoreComputationId { value.root }

pub typed_body_local_count(value: &TypedBody) -> usize {
    IndexVec::len(&value.local_types)
}

pub typed_body_value_at(
    value: &TypedBody,
    id: CoreValueId
) -> CoreValueView {
    let node = core_value_at(&value.values, id);
    let ty = node.ty;
    handle node.kind {
        CoreValueKind::Unit => CoreValueView::Unit(ty),
        CoreValueKind::Integer(constant) =>
            CoreValueView::Integer(ty, constant),
        CoreValueKind::Local(local, access) => CoreValueView::Local(
            ty,
            local,
            handle access {
                CoreLocalAccess::Move => false,
                CoreLocalAccess::Copy => true
            }
        ),
        CoreValueKind::Projection(source, field) =>
            CoreValueView::Projection(
                ty,
                source,
                field
            ),
        CoreValueKind::Embedded(computation) =>
            CoreValueView::Embedded(ty, computation)
    }
}

typed_body_operands<'a>(
    value: &'a TypedBody,
    range: OperandRange
) -> Slice<'a, CoreValueId> {
    handle Slice::subslice(
        Vec::as_slice(&value.operands),
        usize_from_u32(range.start),
        usize_from_u32(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

typed_body_construction_fields<'a>(
    value: &'a TypedBody,
    range: ConstructionFieldRange
) -> Slice<'a, ConstructionField> {
    handle Slice::subslice(
        Vec::as_slice(&value.construction_fields),
        usize_from_u32(range.start),
        usize_from_u32(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

typed_body_match_arms<'a>(
    value: &'a TypedBody,
    range: MatchArmRange
) -> Slice<'a, CoreMatchArm> {
    handle Slice::subslice(
        Vec::as_slice(&value.match_arms),
        usize_from_u32(range.start),
        usize_from_u32(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub core_match_arm_variant(value: &CoreMatchArm) -> u32 {
    value.variant
}

pub core_match_arm_body(value: &CoreMatchArm) -> CoreComputationId {
    value.body
}

pub core_match_arm_bindings<'a>(
    body: &'a TypedBody,
    value: &CoreMatchArm
) -> Slice<'a, CoreMatchBinding> {
    handle Slice::subslice(
        Vec::as_slice(&body.match_bindings),
        usize_from_u32(value.bindings.start),
        usize_from_u32(value.bindings.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub core_match_binding_field(value: &CoreMatchBinding) -> u32 {
    value.field
}

pub core_match_binding_local(
    value: &CoreMatchBinding
) -> Option<CoreLocalId> {
    value.local
}

pub core_match_binding_type(value: &CoreMatchBinding) -> TypeId {
    value.ty
}

pub typed_body_computation_at<'a>(
    value: &'a TypedBody,
    id: CoreComputationId
) -> CoreComputationView<'a> {
    let node = core_computation_at(&value.computations, id);
    let ty = node.ty;
    handle node.kind {
        CoreComputationKind::Pure(found) =>
            CoreComputationView::Pure(ty, found),
        CoreComputationKind::Let(local, initializer, remainder) =>
            CoreComputationView::Let(
                ty,
                local,
                initializer,
                remainder
            ),
        CoreComputationKind::Call(shell, range) =>
            CoreComputationView::Call(
                ty,
                shell,
                typed_body_operands(value, range)
            ),
        CoreComputationKind::Construct(flavor, range) =>
            CoreComputationView::Construct(
                ty,
                flavor,
                typed_body_construction_fields(value, range)
            ),
        CoreComputationKind::Match(subject, range) =>
            CoreComputationView::Match(
                ty,
                subject,
                typed_body_match_arms(value, range)
            )
    }
}

pub construction_field_ordinal(value: &ConstructionField) -> u32 {
    value.field
}

pub construction_field_value(
    value: &ConstructionField
) -> CoreValueId {
    value.value
}

