pub typed_body_value_at(
    value: &TypedBody,
    id: CoreValueId
) -> CoreValueView {
    let node = core_value_at(&value.values, id);
    let ty = node.ty;
    handle node.kind {
        CoreValueKind::Unit => CoreValueView::Unit(ty),
        CoreValueKind::Integer(constant) =>
            CoreValueView::Integer(ty, constant),
        CoreValueKind::Text(bytes) => CoreValueView::Text(ty, bytes),
        CoreValueKind::Bytes(bytes) => CoreValueView::Bytes(ty, bytes),
        CoreValueKind::Local(local, forced) => CoreValueView::Local(
            ty,
            local,
            if(*IndexVec::index(&value.transfer_candidates, id)) {
                false
            } else { true },
            forced
        ),
        CoreValueKind::Projection(source, field) =>
            CoreValueView::Projection(
                ty,
                source,
                field
            ),
        CoreValueKind::Embedded(computation) =>
            CoreValueView::Embedded(ty, computation)
    }
}

pub typed_body_transfer_candidate(
    value: &TypedBody,
    id: CoreValueId
) -> Bool {
    *IndexVec::index(&value.transfer_candidates, id)
}

