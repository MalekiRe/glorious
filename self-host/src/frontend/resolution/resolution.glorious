// Compact ordinary value-name resolution for one parsed function body.
// Bindings and results retain interned identities, never source strings.

use super::lexer::TokenKind;
use super::bodies::PatternBinder;
use super::scanner::{ShellId, ShellTag};

pub struct ParameterTag {}
pub type ParameterId = Id<ParameterTag>;

pub struct LocalTag {}
pub type LocalId = Id<LocalTag>;

// Effect shells are generative declaration identities. The operation ordinal
// is local to that shell, so this pair cannot collide with an enum variant or
// with a same-spelled operation in another effect/module.
pub struct EffectOperationIdentity {
    protocol: ShellId,
    operation: u32
}

impl Use<[0, *]> for EffectOperationIdentity {}

pub effect_operation_effect(value: &EffectOperationIdentity) -> ShellId {
    value.protocol
}

pub effect_operation_ordinal(value: &EffectOperationIdentity) -> u32 {
    value.operation
}

pub enum ResolvedTarget {
    Parameter(ParameterId),
    Local(LocalId),
    Function(ShellId),
    FunctionAlias(ShellId),
    Struct(super::headers::StructHeaderId),
    Variant(super::headers::VariantHeaderId),
    EffectOperation(EffectOperationIdentity)
}

// Header generic names are lexical binders, not entries in the declaration
// search table. Keep their identity as the ordinal in the owning callable's
// generic range so a same-spelled global type/effect name cannot win.
pub enum ResolvedGenericTarget {
    TypeParameter(u32),
    EffectRowParameter(u32),
    GlobalType(ShellId),
    Unknown
}

impl Use<[0, *]> for ResolvedGenericTarget {}

pub generic_parameter_at(
    headers: &super::headers::HeaderIndex,
    index: usize
) -> &super::headers::GenericParam {
    handle super::headers::generic_param_at(headers, index) {
        None => unreachable(),
        Option::Some(found) => found
    }
}


impl Use<[0, *]> for ResolvedTarget {}

pub struct LocalBinding {
    name_token: usize,
    block_expression: super::bodies::ExprId
}

pub enum ResolvedPatternBinder {
    Wildcard,
    Local(LocalId),
    Integer(usize),
    Boolean(usize, Bool)
}

impl Use<[0, *]> for ResolvedPatternBinder {}

pub struct ResolvedBinderRangeTag {}
pub type ResolvedBinderRange =
    super::syntax::IdRange<ResolvedBinderRangeTag>;

pub enum ResolvedHandleTarget {
    Variant(super::headers::VariantHeaderId),
    EffectOperation(EffectOperationIdentity)
}

impl Use<[0, *]> for ResolvedHandleTarget {}

pub struct ResolvedHandleArm {
    target: ResolvedHandleTarget,
    binders: ResolvedBinderRange
}

impl Use<[0, *]> for ResolvedHandleArm {}

pub struct ResolvedBody {
    targets:
        IndexVec<super::bodies::ExprTag, Option<ResolvedTarget>>,
    occurrence_order: Vec<super::bodies::ExprId>,
    locals: Vec<LocalBinding>,
    handle_arms:
        IndexVec<super::bodies::HandleArmTag, Option<ResolvedHandleArm>>,
    pattern_binders: Vec<ResolvedPatternBinder>
}

pub enum ResolutionError {
    UnknownFunction(usize),
    UnknownStruct(usize),
    UnknownEnum(usize),
    UnknownVariant(usize),
    UnknownEffect(usize),
    UnknownOperation(usize, usize),
    InvalidEffectTarget(usize, usize),
    InvalidNamePath(usize),
    AmbiguousFunction(usize, ShellId),
    AmbiguousStruct(usize, usize),
    AmbiguousEnum(usize, usize),
    AmbiguousEffect(usize, ShellId),
    DuplicateParameter(usize, usize),
    MissingCallableHeader(usize),
    MissingDeclarationShell(usize, ShellId),
    MissingStructHeader(usize, usize),
    MissingEnumHeader(usize, usize),
    MissingVariantHeader(usize, usize),
    CorruptFunctionSearch(usize),
    CorruptStructSearch(usize),
    CorruptEnumSearch(usize),
    LocalIdExhausted(usize, usize),
    ExpectedBindingIdentifier(usize),
    UnexpectedHandleTarget(usize, usize),
    MissingParameterHeader(usize),
    MissingBodyShell(ShellId),
    MissingBodyCallable(ShellId),
    MissingParameterRange(ShellId),
    BodyParseFailure(ShellId)
}

pub resolve_callable_generic_name(
    headers: &super::headers::HeaderIndex,
    declarations: &super::scanner::DeclarationIndex,
    callable: &super::headers::CallableHeader,
    name: Id<String>,
    kind: u8,
    module: Option<ShellId>,
    token: usize
) -> ResolvedGenericTarget {
    let generics = super::headers::callable_generics(callable);
    resolve_callable_generic_name_at(
        headers,
        declarations,
        generics,
        name,
        kind,
        module,
        token,
        0
    )
}

resolve_callable_generic_name_at(
    headers: &super::headers::HeaderIndex,
    declarations: &super::scanner::DeclarationIndex,
    generics: &super::headers::HeaderRange,
    name: Id<String>,
    kind: u8,
    module: Option<ShellId>,
    token: usize,
    ordinal: u32
) -> ResolvedGenericTarget {
    if(ordinal < super::headers::range_count(generics)) {
        let index = super::headers::range_start(generics) + ordinal;
        let parameter = generic_parameter_at(
            headers,
            usize_from_u32(index)
        );
        if(super::headers::generic_param_name(parameter) == name
            and { super::headers::generic_param_kind_code(parameter) == kind }) {
            handle kind {
                1 => ResolvedGenericTarget::TypeParameter(ordinal),
                3 => ResolvedGenericTarget::EffectRowParameter(ordinal),
                _ => ResolvedGenericTarget::Unknown
            }
        } else {
            resolve_callable_generic_name_at(
                headers,
                declarations,
                generics,
                name,
                kind,
                module,
                token,
                ordinal + 1
            )
        }
    } else {
        let found = super::scanner::def_search(
            declarations,
            module,
            name,
            super::scanner::Namespace::Type
        );
        if(super::scanner::def_search_count(&found) == 0
            and { Option::is_some(&module) }) {
            let root = super::scanner::def_search(
                declarations,
                None,
                name,
                super::scanner::Namespace::Type
            );
            handle super::scanner::def_search_first(&root) {
                None => ResolvedGenericTarget::Unknown,
                Option::Some(shell) => ResolvedGenericTarget::GlobalType(shell)
            }
        } else {
            handle super::scanner::def_search_first(&found) {
                None => ResolvedGenericTarget::Unknown,
                Option::Some(shell) => ResolvedGenericTarget::GlobalType(shell)
            }
        }
    }
}

struct ScopeBinding {
    name: Id<String>,
    previous: Option<ResolvedTarget>
}
struct ScopeMap {
    values: HashMap<Id<String>, ResolvedTarget>,
    journal: Vec<ScopeBinding>
}
pub struct ResolutionIndex {
    callable_by_shell:
        IndexVec<ShellTag, Option<u32>>
}

impl Use<[0, *]> for ScopeBinding {}

resolved_binder_range(start: usize, end: usize) -> ResolvedBinderRange {
    super::syntax::id_range(start, end)
}

pub resolved_name_count(value: &ResolvedBody) -> usize {
    Vec::len(&value.occurrence_order)
}

pub resolved_name_expression_id_at(
    value: &ResolvedBody,
    index: usize
) -> super::bodies::ExprId {
    *Vec::index(&value.occurrence_order, index)
}

pub resolved_name_target_at(
    value: &ResolvedBody,
    index: usize
) -> ResolvedTarget {
    let expression = resolved_name_expression_id_at(value, index);
    handle *IndexVec::index(&value.targets, expression) {
        None => unreachable(),
        Option::Some(found) => found
    }
}

pub resolved_target(
    value: &ResolvedBody,
    expression: super::bodies::ExprId
) -> Option<ResolvedTarget> {
    *IndexVec::index(&value.targets, expression)
}

pub local_count(value: &ResolvedBody) -> usize {
    Vec::len(&value.locals)
}

pub local_name_token_at(value: &ResolvedBody, index: usize) -> usize {
    Vec::index(&value.locals, index).name_token
}

pub local_block_expression_at(value: &ResolvedBody, index: usize) -> u32 {
    Id::to_u32(Vec::index(&value.locals, index).block_expression)
}

pub resolved_handle_arm<'a>(
    value: &'a ResolvedBody,
    id: super::bodies::HandleArmId
) -> &'a ResolvedHandleArm {
    handle Option::as_ref(IndexVec::index(&value.handle_arms, id)) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub resolved_handle_variant(
    value: &ResolvedHandleArm
) -> Option<super::headers::VariantHeaderId> {
    handle value.target {
        ResolvedHandleTarget::Variant(found) => Option::Some(found),
        ResolvedHandleTarget::EffectOperation(_) => None
    }
}

pub resolved_handle_target(value: &ResolvedHandleArm) -> ResolvedHandleTarget {
    value.target
}

pub resolved_handle_binders<'a>(
    value: &'a ResolvedBody,
    arm: &ResolvedHandleArm
) -> Slice<'a, ResolvedPatternBinder> {
    handle Slice::subslice(
        Vec::as_slice(&value.pattern_binders),
        usize_from_u32(arm.binders.start),
        usize_from_u32(arm.binders.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

shell_parent_module(
    shell: &super::scanner::DeclarationShell
) -> Option<ShellId> {
    *super::scanner::shell_parent(shell)
}

same_module(
    left: Option<ShellId>,
    right: Option<ShellId>
) -> Bool {
    left == right
}

local_id_from_usize(value: usize) -> Option<LocalId> {
    Id::from_usize(value)
}

scope_mark(scope: &ScopeMap) -> usize {
    Vec::len(&scope.journal)
}

scope_push(
    scope: &mut ScopeMap,
    name: Id<String>,
    target: ResolvedTarget
) {
    let previous = HashMap::insert(&mut scope.values, name, target);
    Vec::push(&mut scope.journal, ScopeBinding {
        name: name,
        previous: previous
    })
}

scope_restore(scope: &mut ScopeMap, mark: usize) {
    if(Vec::len(&scope.journal) <= mark) {
        ()
    } else {
        handle Vec::pop(&mut scope.journal) {
            Result::Err(_) => (),
            Result::Ok(binding) => {
                let removed = HashMap::remove(&mut scope.values, &binding.name);
                removed;
                handle binding.previous {
                    Result::Err(_) => (),
                    Result::Ok(previous) => {
                        let replaced = HashMap::insert(
                            &mut scope.values,
                            binding.name,
                            previous
                        );
                        replaced;
                        ()
                    }
                };
                scope_restore(scope, mark)
            }
        }
    }
}

// A lexical binding transaction. The frame deliberately remains armed during
// normal resolution: bindings introduced by a nested block are never meant to
// escape it. Label propagation runs Drop before LEAVE, so error exits restore
// precisely the same journal prefix as successful returns.
// One journal-backed transaction implements both lexical scope frames and
// temporary map overrides. Restoring the journal re-establishes overwritten
// entries as well as removing newly introduced bindings.
struct TemporaryMapOverride<'a> {
    scope: &'a mut ScopeMap,
    mark: usize,
    armed: Bool
}

impl<'a> Drop for TemporaryMapOverride<'a> {
    drop(&mut self) -> {
        if(self.armed) {
            scope_restore(&mut *self.scope, self.mark)
        } else { () }
    }
}

type ScopeFrame<'a> = TemporaryMapOverride<'a>;
type BindingFrame<'a> = ScopeFrame<'a>;

temporary_map_override<'a>(scope: &'a mut ScopeMap) -> TemporaryMapOverride<'a> {
    let mark = scope_mark(&*scope);
    TemporaryMapOverride { scope: move scope, mark: move mark, armed: true }
}

temporary_map_override_commit<'a>(frame: &mut TemporaryMapOverride<'a>) {
    (*frame).armed = false;
    ()
}

scope_frame<'a>(scope: &'a mut ScopeMap) -> ScopeFrame<'a> {
    temporary_map_override(move scope)
}

scope_frame_commit<'a>(frame: &mut ScopeFrame<'a>) {
    temporary_map_override_commit(move frame)
}

push_resolution(
    output: &mut ResolvedBody,
    expression: super::bodies::ExprId,
    target: ResolvedTarget
) {
    let missing = Option::is_none(IndexVec::index(
        &output.targets,
        expression
    ));
    if(missing) {
        Vec::push(&mut output.occurrence_order, expression);
        ()
    } else { () };
    *IndexVec::index_mut(
        &mut output.targets,
        expression
    ) = Option::Some(target);
    ()
}

push_missing_targets(
    values: &mut IndexVec<super::bodies::ExprTag, Option<ResolvedTarget>>,
    count: usize
) {
    for_range(Range::new(IndexVec::len(&*values), count), { _ => handle
        IndexVec::push(&mut *values, None) {
        Result::Err(_) => unreachable(),
        Result::Ok(_) => ()
    }})
}

scope_lookup(scope: &ScopeMap, name: Id<String>) -> Option<ResolvedTarget> {
    handle HashMap::get(&scope.values, &name) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(found) => Result::Ok(*found)
    }
}

index_callable(
    index: &mut ResolutionIndex,
    headers: &super::headers::HeaderIndex,
    declarations: &super::scanner::DeclarationIndex,
    ordinal: usize
) -> Result<(), ResolutionError> {
    let callable = handle super::headers::callable_at(headers, ordinal) {
        Result::Err(_) =>
            @index_callable(Result::Err(
                ResolutionError::MissingCallableHeader(ordinal)
            )),
        Result::Ok(callable) => callable
    };
    let shell_index = super::headers::callable_shell(callable);
    handle super::scanner::shell_at(
        declarations,
        shell_index
    ) {
        Result::Err(_) =>
            @index_callable(Result::Err(
                ResolutionError::MissingDeclarationShell(
                    Id::to_usize(shell_index),
                    shell_index
                )
            )),
        Result::Ok(_) => ()
    };
    let slot = IndexVec::index_mut(
        &mut index.callable_by_shell,
        shell_index
    );
    if(*slot is Result::Err(_)) {
        *slot = Result::Ok(u32_from_usize(ordinal));
        ()
    } else {
        ()
    };
    Result::Ok(())
}

fill_callable_slots(index: &mut ResolutionIndex, count: usize) {
    for_range(Range::new(0, count), { _ => handle
        IndexVec::push(&mut index.callable_by_shell, Result::Err(())) {
        Result::Err(_) => unreachable(),
        Result::Ok(_) => ()
    } })
}

index_callables(
    index: &mut ResolutionIndex,
    headers: &super::headers::HeaderIndex,
    declarations: &super::scanner::DeclarationIndex,
    ordinal: usize
) -> Result<(), ResolutionError> {
    try_for_range(Range::new(
        ordinal,
        super::headers::callable_count(headers)
    ), { current =>
        index_callable(index, headers, declarations, current)
    })
}

pub build_resolution_index(
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex
) -> Result<ResolutionIndex, ResolutionError> {
    let index = ResolutionIndex {
        callable_by_shell: IndexVec::new()
    };
    fill_callable_slots(
        &mut index,
        super::scanner::shell_count(declarations)
    );
    try(
        index_callables(
            &mut index,
            super::headers::parsed_index(headers),
            declarations,
            0
        ),
        @build_resolution_index
    );
    Result::Ok(index)
}

resolve_function_name_in(
    declarations: &super::scanner::DeclarationIndex,
    name: u32,
    module: Option<ShellId>
) -> super::scanner::DefSearch {
    super::scanner::def_search(
        declarations,
        module,
        Id::from_u32(name),
        super::scanner::Namespace::Value
    )
}

finish_function_name(
    declarations: &super::scanner::DeclarationIndex,
    found: super::scanner::DefSearch,
    token: usize
) -> Result<ResolvedTarget, ResolutionError> {
    handle super::scanner::def_search_count(&found) {
        0 => Result::Err(ResolutionError::UnknownFunction(token)),
        1 => handle super::scanner::def_search_first(&found) {
            Result::Err(_) =>
                Result::Err(ResolutionError::CorruptFunctionSearch(token)),
            Result::Ok(shell_index) => {
                handle super::scanner::shell_at(
                    declarations,
                    shell_index
                ) {
                    Result::Err(_) => Result::Err(
                        ResolutionError::MissingDeclarationShell(
                            token,
                            shell_index
                        )
                    ),
                    Result::Ok(shell) => if(
                        super::scanner::shell_kind(shell)
                            is super::scanner::DeclarationKind::Function
                    ) {
                        Result::Ok(ResolvedTarget::Function(shell_index))
                    } else {
                        Result::Err(ResolutionError::UnknownFunction(token))
                    }
                }
            }
        },
        _ => handle super::scanner::def_search_first(&found) {
            Result::Err(_) =>
                Result::Err(ResolutionError::CorruptFunctionSearch(token)),
            Result::Ok(shell_index) => Result::Err(
                ResolutionError::AmbiguousFunction(
                    token,
                    shell_index
                )
            )
        }
    }
}

resolve_function_name(
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    name: u32,
    module: Option<ShellId>,
    token: usize
) -> Result<ResolvedTarget, ResolutionError> {
    index;
    let found = resolve_function_name_in(declarations, name, module);
    if(super::scanner::def_search_count(&found) == 0
        and { Option::is_some(&module) }) {
        let root = resolve_function_name_in(
            declarations,
            name,
            Result::Err(())
        );
        finish_function_name(
            declarations,
            root,
            token
        )
    } else {
        finish_function_name(
            declarations,
            found,
            token
        )
    }
}

finish_struct_name(
    nominal: &super::headers::NominalIndex,
    found: super::scanner::DefSearch,
    token: usize
) -> Result<ResolvedTarget, ResolutionError> {
    handle super::scanner::def_search_count(&found) {
        0 => Result::Err(ResolutionError::UnknownStruct(token)),
        1 => handle super::scanner::def_search_first(&found) {
            Result::Err(_) =>
                Result::Err(ResolutionError::CorruptStructSearch(token)),
            Result::Ok(shell) => handle
                super::headers::def_kind_for_shell(nominal, shell) {
                Result::Err(_) =>
                    Result::Err(ResolutionError::UnknownStruct(token)),
                Result::Ok(kind) => handle kind {
                    super::headers::HeaderOrder::Struct(index) => handle
                        super::headers::struct_at(
                            nominal,
                            Id::to_usize(index)
                        ) {
                        Result::Err(_) => Result::Err(
                            ResolutionError::MissingStructHeader(
                                token,
                                Id::to_usize(index)
                            )
                        ),
                        Result::Ok(_) => Result::Ok(
                            ResolvedTarget::Struct(index)
                        )
                    },
                    _ => Result::Err(ResolutionError::UnknownStruct(token))
                }
            }
        },
        _ => handle super::scanner::def_search_first(&found) {
            Result::Err(_) =>
                Result::Err(ResolutionError::CorruptStructSearch(token)),
            Result::Ok(shell) => Result::Err(
                ResolutionError::AmbiguousStruct(
                    token,
                    Id::to_usize(shell)
                )
            )
        }
    }
}

resolve_struct_name_in(
    nominal: &super::headers::NominalIndex,
    declarations: &super::scanner::DeclarationIndex,
    name: u32,
    module: Option<ShellId>,
    token: usize
) -> Result<super::scanner::DefSearch, ResolutionError> {
    nominal;
    token;
    Result::Ok(super::scanner::def_search(
        declarations,
        module,
        Id::from_u32(name),
        super::scanner::Namespace::Type
    ))
}

resolve_struct_name(
    nominal: &super::headers::NominalIndex,
    declarations: &super::scanner::DeclarationIndex,
    name: u32,
    module: Option<ShellId>,
    token: usize
) -> Result<ResolvedTarget, ResolutionError> {
    let found = try(resolve_struct_name_in(
        nominal,
        declarations,
        name,
        module,
        token
    ), @resolve_struct_name);
    if(super::scanner::def_search_count(&found) == 0
        and { Option::is_some(&module) }) {
        let root = try(resolve_struct_name_in(
            nominal,
            declarations,
            name,
            Result::Err(()),
            token
        ), @resolve_struct_name);
        finish_struct_name(nominal, root, token)
    } else {
        finish_struct_name(nominal, found, token)
    }
}

finish_variant_name(
    nominal: &super::headers::NominalIndex,
    found: super::scanner::DefSearch,
    variant_name: u32,
    enum_token: usize,
    variant_token: usize
) -> Result<ResolvedTarget, ResolutionError> {
    handle super::scanner::def_search_count(&found) {
        0 => Result::Err(ResolutionError::UnknownEnum(enum_token)),
        1 => handle super::scanner::def_search_first(&found) {
            Result::Err(_) =>
                Result::Err(ResolutionError::CorruptEnumSearch(enum_token)),
            Result::Ok(shell) => handle
                super::headers::def_kind_for_shell(nominal, shell) {
                Result::Err(_) =>
                    Result::Err(ResolutionError::UnknownEnum(enum_token)),
                Result::Ok(kind) => handle kind {
                    super::headers::HeaderOrder::Enum(enum_index) => handle
                        super::headers::enum_at(
                            nominal,
                            Id::to_usize(enum_index)
                        ) {
                        Result::Err(_) => Result::Err(
                            ResolutionError::MissingEnumHeader(
                                enum_token,
                                Id::to_usize(enum_index)
                            )
                        ),
                        Result::Ok(_) => handle
                            super::headers::variant_for_enum(
                                nominal,
                                enum_index,
                                Id::from_u32(variant_name)
                            ) {
                            None => Result::Err(
                                ResolutionError::UnknownVariant(variant_token)
                            ),
                            Option::Some(variant) => Result::Ok(
                                ResolvedTarget::Variant(variant)
                            )
                        }
                    },
                    _ => Result::Err(ResolutionError::UnknownEnum(enum_token))
                    }
            }
        },
        _ => handle super::scanner::def_search_first(&found) {
            Result::Err(_) =>
                Result::Err(ResolutionError::CorruptEnumSearch(enum_token)),
            Result::Ok(shell) => Result::Err(
                ResolutionError::AmbiguousEnum(
                    enum_token,
                    Id::to_usize(shell)
                )
            )
        }
    }
}

resolve_variant_name(
    nominal: &super::headers::NominalIndex,
    declarations: &super::scanner::DeclarationIndex,
    enum_name: u32,
    variant_name: u32,
    module: Option<ShellId>,
    enum_token: usize,
    variant_token: usize
) -> Result<ResolvedTarget, ResolutionError> {
    let found = super::scanner::def_search(
        declarations,
        module,
        Id::from_u32(enum_name),
        super::scanner::Namespace::Type
    );
    if(super::scanner::def_search_count(&found) == 0
        and { Option::is_some(&module) }) {
        let root = super::scanner::def_search(
            declarations,
            Result::Err(()),
            Id::from_u32(enum_name),
            super::scanner::Namespace::Type
        );
        finish_variant_name(
            nominal,
            root,
            variant_name,
            enum_token,
            variant_token
        )
    } else {
        finish_variant_name(
            nominal,
            found,
            variant_name,
            enum_token,
            variant_token
        )
    }
}

finish_effect_name(
    nominal: &super::headers::NominalIndex,
    declarations: &super::scanner::DeclarationIndex,
    found: super::scanner::DefSearch,
    token: usize
) -> Result<(ShellId, super::headers::EffectHeaderId), ResolutionError> {
    handle super::scanner::def_search_count(&found) {
        0 => Result::Err(ResolutionError::UnknownEffect(token)),
        1 => {
            let shell = handle super::scanner::def_search_first(&found) {
                None => @finish_effect_name(Result::Err(
                    ResolutionError::UnknownEffect(token)
                )),
                Option::Some(value) => value
            };
            let declaration = handle super::scanner::shell_at(
                declarations, shell
            ) {
                None => @finish_effect_name(Result::Err(
                    ResolutionError::MissingDeclarationShell(token, shell)
                )),
                Option::Some(value) => value
            };
            if(not(super::scanner::shell_kind(declaration)
                is super::scanner::DeclarationKind::Effect)) {
                @finish_effect_name(Result::Err(
                    ResolutionError::InvalidEffectTarget(token, token)
                ))
            } else { () };
            handle super::headers::def_kind_for_shell(nominal, shell) {
                Option::Some(super::headers::HeaderOrder::Effect(protocol)) =>
                    Result::Ok((shell, protocol)),
                _ => Result::Err(ResolutionError::UnknownEffect(token))
            }
        },
        _ => handle super::scanner::def_search_first(&found) {
            None => Result::Err(ResolutionError::UnknownEffect(token)),
            Option::Some(first) => Result::Err(
                ResolutionError::AmbiguousEffect(token, first)
            )
        }
    }
}

resolve_effect_name(
    nominal: &super::headers::NominalIndex,
    declarations: &super::scanner::DeclarationIndex,
    name: Id<String>,
    module: Option<ShellId>,
    token: usize
) -> Result<(ShellId, super::headers::EffectHeaderId), ResolutionError> {
    let local = super::scanner::def_search(
        declarations, module, name, super::scanner::Namespace::Type
    );
    if(super::scanner::def_search_count(&local) == 0
        and { Option::is_some(&module) }) {
        finish_effect_name(
            nominal,
            declarations,
            super::scanner::def_search(
                declarations,
                None,
                name,
                super::scanner::Namespace::Type
            ),
            token
        )
    } else {
        finish_effect_name(nominal, declarations, local, token)
    }
}

find_effect_operation(
    headers: &super::headers::ParsedHeaders,
    protocol: super::headers::EffectHeaderId,
    expected: Id<String>,
    ordinal: u32,
    token: usize
) -> Result<EffectOperationIdentity, ResolutionError> {
    let nominal = super::headers::nominal_index(headers);
    let declaration = handle super::headers::effect_at(
        nominal, Id::to_usize(protocol)
    ) {
        None => @find_effect_operation(Result::Err(
            ResolutionError::UnknownEffect(token)
        )),
        Option::Some(value) => value
    };
    let operations = super::headers::effect_operations(declaration);
    if(ordinal < super::headers::range_count(operations)) {
        let index = super::headers::range_start(operations) + ordinal;
        let operation = handle super::headers::effect_operation_at(
            nominal, usize_from_u32(index)
        ) {
            None => @find_effect_operation(Result::Err(
                ResolutionError::UnknownOperation(token, token)
            )),
            Option::Some(value) => value
        };
        if(super::headers::effect_operation_name(operation) == expected) {
            Result::Ok(EffectOperationIdentity {
                protocol: super::headers::effect_shell(declaration),
                operation: ordinal
            })
        } else {
            find_effect_operation(
                headers, protocol, expected, ordinal + 1, token
            )
        }
    } else {
        Result::Err(ResolutionError::UnknownOperation(token, token))
    }
}

resolve_effect_operation(
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    effect_name: Id<String>,
    operation_name: Id<String>,
    module: Option<ShellId>,
    effect_token: usize,
    operation_token: usize
) -> Result<EffectOperationIdentity, ResolutionError> {
    let (_, protocol) = try(resolve_effect_name(
        super::headers::nominal_index(headers),
        declarations,
        effect_name,
        module,
        effect_token
    ), @resolve_effect_operation);
    handle find_effect_operation(
        headers, protocol, operation_name, 0, operation_token
    ) {
        Result::Err(ResolutionError::UnknownOperation(_, _)) => Result::Err(
            ResolutionError::UnknownOperation(operation_token, effect_token)
        ),
        other => other
    }
}

resolve_qualified_handle_target(
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    owner_name: Id<String>,
    member_name: Id<String>,
    module: Option<ShellId>,
    owner_token: usize,
    member_token: usize
) -> Result<ResolvedHandleTarget, ResolutionError> {
    let local = super::scanner::def_search(
        declarations,
        module,
        owner_name,
        super::scanner::Namespace::Type
    );
    let found = if(super::scanner::def_search_count(&local) == 0
        and { Option::is_some(&module) }) {
        super::scanner::def_search(
            declarations,
            None,
            owner_name,
            super::scanner::Namespace::Type
        )
    } else { local };
    if(super::scanner::def_search_count(&found) != 1) {
        @resolve_qualified_handle_target(Result::Err(
            ResolutionError::UnexpectedHandleTarget(
                member_token, owner_token
            )
        ))
    } else { () };
    let shell = handle super::scanner::def_search_first(&found) {
        None => @resolve_qualified_handle_target(Result::Err(
            ResolutionError::UnexpectedHandleTarget(
                member_token, owner_token
            )
        )),
        Option::Some(value) => value
    };
    let declaration = handle super::scanner::shell_at(declarations, shell) {
        None => @resolve_qualified_handle_target(Result::Err(
            ResolutionError::MissingDeclarationShell(owner_token, shell)
        )),
        Option::Some(value) => value
    };
    handle super::scanner::shell_kind(declaration) {
        super::scanner::DeclarationKind::Effect => Result::map(
            resolve_effect_operation(
                headers,
                declarations,
                owner_name,
                member_name,
                module,
                owner_token,
                member_token
            ),
            { operation => ResolvedHandleTarget::EffectOperation(operation) }
        ),
        super::scanner::DeclarationKind::Enum => handle resolve_variant_name(
            super::headers::nominal_index(headers),
            declarations,
            Id::to_u32(owner_name),
            Id::to_u32(member_name),
            module,
            owner_token,
            member_token
        ) {
            Result::Ok(ResolvedTarget::Variant(variant)) =>
                Result::Ok(ResolvedHandleTarget::Variant(variant)),
            Result::Err(error) => Result::Err(error),
            _ => Result::Err(ResolutionError::UnexpectedHandleTarget(
                member_token, owner_token
            ))
        },
        _ => Result::Err(ResolutionError::UnexpectedHandleTarget(
            member_token, owner_token
        ))
    }
}

global_let_token(
    source: &super::lexer::LexedSource,
    start: usize,
    end: usize
) -> Option<usize> {
    if(start < end and { start < end and {
        super::lexer::token_kind_at(source, start)
            is TokenKind::Keyword(super::lexer::Keyword::Let)
    } }) {
        Option::Some(start)
    } else { if(start + 1 < end and {
        super::lexer::token_kind_at(source, start + 1)
            is TokenKind::Keyword(super::lexer::Keyword::Let)
    }) {
        Option::Some(start + 1)
    } else { None } }
}

global_alias_path_matches(
    source: &super::lexer::LexedSource,
    shell: &super::scanner::DeclarationShell,
    first: u32,
    second: Option<u32>
) -> Bool {
    if(super::scanner::shell_kind(shell)
        is super::scanner::DeclarationKind::Global) {
        let header = super::scanner::shell_header(shell);
        let let_token = global_let_token(
            source,
            super::syntax::token_start(header),
            super::syntax::token_end(header)
        );
        handle let_token {
            None => false,
            Option::Some(found) => {
                let first_token = found + 1;
                handle super::lexer::token_kind_at(source, first_token) {
                    TokenKind::Ident(name) => if(Id::to_u32(name) == first) {
                        handle second {
                            None => super::lexer::token_kind_at(
                                source, first_token + 1
                            ) is TokenKind::Eq,
                            Option::Some(expected) => if(
                                super::lexer::token_kind_at(
                                    source, first_token + 1
                                ) is TokenKind::DoubleColon
                            ) {
                                handle super::lexer::token_kind_at(
                                    source, first_token + 2
                                ) {
                                    TokenKind::Ident(found) =>
                                        Id::to_u32(found) == expected,
                                    _ => false
                                }
                            } else { false }
                        }
                    } else { false },
                    _ => false
                }
            }
        }
    } else { false }
}

find_global_alias(
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    first: u32,
    second: Option<u32>,
    module: Option<ShellId>,
    index: usize
) -> Option<ShellId> {
    if(index < super::scanner::shell_count(declarations)) {
        let id = Id::from_u32(wrapping_convert_to_u32(index));
        let shell = handle super::scanner::shell_at(declarations, id) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        if(*super::scanner::shell_parent(shell) == module and {
            global_alias_path_matches(source, shell, first, second)
        }) {
            Option::Some(id)
        } else {
            find_global_alias(
                source,
                declarations,
                first,
                second,
                module,
                index + 1
            )
        }
    } else { None }
}

resolve_global_alias_body(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    shell_id: ShellId,
    token: usize,
    depth: usize
) -> Result<ResolvedTarget, ResolutionError> {
    if(depth >= super::scanner::shell_count(declarations)) {
        Result::Err(ResolutionError::UnknownFunction(token))
    } else {
        let shell = handle super::scanner::shell_at(declarations, shell_id) {
            Result::Err(_) => @resolve_global_alias_body(Result::Err(
                ResolutionError::MissingDeclarationShell(token, shell_id)
            )),
            Result::Ok(found) => found
        };
        let body = handle super::scanner::shell_body_span(shell) {
            None => @resolve_global_alias_body(Result::Err(
                ResolutionError::UnknownFunction(token)
            )),
            Option::Some(found) => found
        };
        let start = super::syntax::token_start(&body);
        let end = super::syntax::token_end(&body);
        let name = handle super::lexer::token_kind_at(
            super::headers::parsed_source(headers), start
        ) {
            TokenKind::Ident(found) => Id::to_u32(found),
            _ => @resolve_global_alias_body(Result::Err(
                ResolutionError::UnknownFunction(token)
            ))
        };
        let module = *super::scanner::shell_parent(shell);
        if(start + 2 < end and {
            super::lexer::token_kind_at(
                super::headers::parsed_source(headers), start + 1
            ) is TokenKind::DoubleColon
        }) {
            let member = handle super::lexer::token_kind_at(
                super::headers::parsed_source(headers), start + 2
            ) {
                TokenKind::Ident(found) => Id::to_u32(found),
                _ => @resolve_global_alias_body(Result::Err(
                    ResolutionError::UnknownFunction(token)
                ))
            };
            resolve_variant_name(
                super::headers::nominal_index(headers),
                declarations,
                name,
                member,
                module,
                start,
                start + 2
            )
        } else {
            handle find_global_alias(
                super::headers::parsed_source(headers),
                declarations,
                name,
                None,
                module,
                0
            ) {
                Option::Some(alias) => resolve_global_alias_body(
                    headers,
                    index,
                    declarations,
                    alias,
                    token,
                    depth + 1
                ),
                None => resolve_function_name(
                    index, declarations, name, module, start
                )
            }
        }
    }
}

resolve_global_alias(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    first: u32,
    second: Option<u32>,
    module: Option<ShellId>,
    token: usize
) -> Option<ResolvedTarget> {
    let local = find_global_alias(
        super::headers::parsed_source(headers),
        declarations,
        first,
        second,
        module,
        0
    );
    let alias = handle local {
        Option::Some(found) => Option::Some(found),
        None => if(Option::is_some(&module)) {
            find_global_alias(
                super::headers::parsed_source(headers),
                declarations,
                first,
                second,
                None,
                0
            )
        } else { None }
    };
    handle alias {
        None => None,
        Option::Some(found) => handle resolve_global_alias_body(
            headers, index, declarations, found, token, 0
        ) {
            Result::Err(_) => None,
            Result::Ok(target) => Option::Some(handle target {
                ResolvedTarget::Function(function) =>
                    ResolvedTarget::FunctionAlias(function),
                other => other
            })
        }
    }
}

function_pattern_variant(
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    function: ShellId,
    token: usize
) -> Result<super::headers::VariantHeaderId, ResolutionError> {
    let shell = handle super::scanner::shell_at(declarations, function) {
        Result::Err(_) => @function_pattern_variant(Result::Err(
            ResolutionError::MissingDeclarationShell(token, function)
        )),
        Result::Ok(found) => found
    };
    let body = handle super::scanner::shell_body_span(shell) {
        None => @function_pattern_variant(Result::Err(
            ResolutionError::UnexpectedHandleTarget(token, token)
        )),
        Option::Some(found) => found
    };
    let start = super::syntax::token_start(&body);
    let source = super::headers::parsed_source(headers);
    let owner = handle super::lexer::token_kind_at(source, start) {
        TokenKind::Ident(found) => Id::to_u32(found),
        _ => @function_pattern_variant(Result::Err(
            ResolutionError::UnexpectedHandleTarget(token, token)
        ))
    };
    let member = handle super::lexer::token_kind_at(source, start + 2) {
        TokenKind::Ident(found) => Id::to_u32(found),
        _ => @function_pattern_variant(Result::Err(
            ResolutionError::UnexpectedHandleTarget(token, token)
        ))
    };
    handle resolve_variant_name(
        super::headers::nominal_index(headers),
        declarations,
        owner,
        member,
        *super::scanner::shell_parent(shell),
        start,
        start + 2
    ) {
        Result::Ok(ResolvedTarget::Variant(found)) => Result::Ok(found),
        _ => Result::Err(ResolutionError::UnexpectedHandleTarget(token, token))
    }
}

bare_bool_literal(
    headers: &super::headers::ParsedHeaders,
    raw: u32
) -> Bool {
    handle super::lexer::lexeme(
        super::headers::parsed_source(headers), Id::from_u32(raw)
    ) {
        Result::Ok(name) => String::eq(name, &"true")
            or { String::eq(name, &"false") },
        Result::Err(_) => false
    }
}

resolve_identifier(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    let count = super::bodies::expression_name_count_at(body, expression);
    let token = super::bodies::expression_name_token_at(body, expression, 0);
    handle count {
        1 => {
            let raw =
                super::bodies::expression_name_value_at(body, expression, 0);
            handle scope_lookup(bindings, Id::from_u32(raw)) {
                Result::Ok(found) => {
                    push_resolution(
                        output,
                        Id::from_u32(expression),
                        found
                    );
                    Result::Ok(())
                },
                Result::Err(_) => handle resolve_global_alias(
                    headers,
                    index,
                    declarations,
                    raw,
                    None,
                    module,
                    token
                ) {
                    // The distributed prelude binds `true` and `false` to
                    // Result-backed global factories. Prefer that binding so
                    // their type stays identical to the declared Bool alias.
                    Option::Some(found) => {
                        push_resolution(
                            output,
                            Id::from_u32(expression),
                            found
                        );
                        Result::Ok(())
                    },
                    None => if(bare_bool_literal(headers, raw)) {
                        // Focused self-host probes intentionally omit the
                        // prelude. Preserve their unresolved literal path.
                        Result::Ok(())
                    } else {
                        let found = try(resolve_function_name(
                            index,
                            declarations,
                            raw,
                            module,
                            token
                        ), @resolve_identifier);
                        push_resolution(
                            output,
                            Id::from_u32(expression),
                            found
                        );
                        Result::Ok(())
                    }
                }
            }
        },
        2 => {
            let variant_token =
                super::bodies::expression_name_token_at(body, expression, 1);
            let owner = super::bodies::expression_name_value_at(
                body, expression, 0
            );
            let member = super::bodies::expression_name_value_at(
                body, expression, 1
            );
            let found = handle resolve_global_alias(
                headers,
                index,
                declarations,
                owner,
                Option::Some(member),
                module,
                token
            ) {
                Option::Some(found) => found,
                None => try(resolve_variant_name(
                    super::headers::nominal_index(headers),
                    declarations,
                    owner,
                    member,
                    module,
                    token,
                    variant_token
                ), @resolve_identifier)
            };
            push_resolution(
                output,
                Id::from_u32(expression),
                found
            );
            Result::Ok(())
        },
        _ => Result::Err(ResolutionError::InvalidNamePath(token))
    }
}

resolve_struct_constructor<'a>(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    name: super::bodies::ExpressionNameView,
    children: Slice<'a, super::bodies::ExprEdge>,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    let (raw, token) = handle name {
        super::bodies::ExpressionNameView::Identifier(found, at) =>
            (Id::to_u32(found), at),
        super::bodies::ExpressionNameView::TupleField(_, _) => unreachable()
    };
    let found = try(resolve_struct_name(
        super::headers::nominal_index(headers),
        declarations,
        raw,
        module,
        token
    ), @resolve_struct_constructor);
    push_resolution(
        output,
        Id::from_u32(expression),
        found
    );
    resolve_edges(
        headers,
        index,
        declarations,
        body,
        bindings,
        output,
        children,
        module
    )
}

resolve_edges<'a>(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    children: Slice<'a, super::bodies::ExprEdge>,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    Slice::try_for_each(
        children,
        { edge =>
            resolve_expression(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                Id::to_u32(
                    super::bodies::expression_edge_value(edge)
                ),
                module
            )
        }
    )
}

resolve_block_children<'a>(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    children: Slice<'a, super::bodies::ExprEdge>,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    Slice::try_for_each(
        children,
        { edge => {
            handle super::bodies::block_statement_view(edge) {
                super::bodies::BlockStatementView::Let(id, token) => {
                    let value = Id::to_u32(id);
                        handle super::lexer::token_kind_at(
                            super::headers::parsed_source(headers),
                            token
                        ) {
                            TokenKind::Ident(name) => {
                                // Allocate the source binder identity when its
                                // declaration is encountered, but do not add it
                                // to lexical lookup until its initializer has
                                // resolved. Nested initializer lets therefore
                                // cannot steal an earlier local ID.
                                handle local_id_from_usize(
                                    Vec::len(&output.locals)
                                ) {
                                    Result::Err(_) => Result::Err(
                                        ResolutionError::LocalIdExhausted(
                                            token,
                                            Vec::len(&output.locals)
                                        )
                                    ),
                                    Result::Ok(local) => {
                                        Vec::push(
                                            &mut output.locals,
                                            LocalBinding {
                                                name_token: token,
                                                block_expression:
                                                    Id::from_u32(expression)
                                            }
                                        );
                                        resolve_expression(
                                            headers,
                                            index,
                                            declarations,
                                            body,
                                            bindings,
                                            output,
                                            value,
                                            module
                                        ) and {
                                            scope_push(
                                                bindings,
                                                name,
                                                ResolvedTarget::Local(local)
                                            );
                                            Result::Ok(())
                                        }
                                    }
                                }
                            },
                            _ => Result::Err(
                                ResolutionError::ExpectedBindingIdentifier(
                                    token
                                )
                            )
                        }
                },
                super::bodies::BlockStatementView::Expression(id) => {
                    resolve_expression(
                        headers,
                        index,
                        declarations,
                        body,
                        bindings,
                        output,
                        Id::to_u32(id),
                        module
                    )
                }
            }
        } }
    )
}

resolve_block<'a>(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    children: Slice<'a, super::bodies::ExprEdge>,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    let frame = scope_frame(move bindings);
    resolve_block_children(
        headers,
        index,
        declarations,
        body,
        &mut *frame.scope,
        output,
        expression,
        children,
        module
    )
}

resolve_closure<'a>(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    parameters: Slice<'a, super::bodies::ClosureParameter>,
    closure_body: super::bodies::ExprId,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    let frame = scope_frame(move bindings);
    try(Slice::try_for_each(parameters, { parameter => {
        let token = super::bodies::closure_parameter_token(parameter);
        let local = handle local_id_from_usize(Vec::len(&output.locals)) {
            Result::Err(_) => @resolve_closure(Result::Err(
                ResolutionError::LocalIdExhausted(token, Vec::len(&output.locals))
            )),
            Result::Ok(found) => found
        };
        Vec::push(&mut output.locals, LocalBinding {
            name_token: token,
            block_expression: Id::from_u32(expression)
        });
        scope_push(
            &mut *frame.scope,
            super::bodies::closure_parameter_name(parameter),
            ResolvedTarget::Local(local)
        );
        Result::Ok(())
    }}), @resolve_closure);
    resolve_expression(
        headers,
        index,
        declarations,
        body,
        &mut *frame.scope,
        output,
        Id::to_u32(closure_body),
        module
    )
}

resolve_pattern_binders<'a>(
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    scope: super::bodies::ExprId,
    values: Slice<'a, super::bodies::PatternBinder>,
    index: usize
) -> Result<(), ResolutionError> {
    try_for_range(Range::new(index, Slice::len(values)), { current => {
        let value = handle Slice::get(values, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        handle *value {
            PatternBinder::Wildcard(_) =>
                Vec::push(
                    &mut output.pattern_binders,
                    ResolvedPatternBinder::Wildcard
                ),
            PatternBinder::Integer(token) =>
                Vec::push(
                    &mut output.pattern_binders,
                    ResolvedPatternBinder::Integer(token)
                ),
            PatternBinder::Boolean(token, flag) =>
                Vec::push(
                    &mut output.pattern_binders,
                    ResolvedPatternBinder::Boolean(token, flag)
                ),
            PatternBinder::Binding(name, token) => {
                let local = try(
                    Result::map_err(
                        local_id_from_usize(Vec::len(&output.locals)),
                        { _ => ResolutionError::LocalIdExhausted(
                                token,
                                Vec::len(&output.locals)
                        ) }
                    ),
                    @resolve_pattern_binders
                );
                Vec::push(&mut output.locals, LocalBinding {
                    name_token: token,
                    block_expression: scope
                });
                scope_push(
                    bindings,
                    name,
                    ResolvedTarget::Local(local)
                );
                Vec::push(
                    &mut output.pattern_binders,
                    ResolvedPatternBinder::Local(local)
                )
            }
        };
        Result::Ok(())
    }})
}

push_resolved_wildcards(
    output: &mut Vec<ResolvedPatternBinder>,
    count: usize,
    ordinal: usize
) {
    for_range(Range::new(ordinal, count), { _ =>
        Vec::push(&mut *output, ResolvedPatternBinder::Wildcard)
    })
}

resolve_handle_arm(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    arm_id: super::bodies::HandleArmId,
    arm: &super::bodies::HandleArm,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    let enum_token = super::bodies::handle_arm_enum_token(arm);
    let variant_token = super::bodies::handle_arm_variant_token(arm);
    let bare_alias = enum_token == variant_token;
    let target = if(bare_alias) {
        handle resolve_global_alias(
            headers,
            index,
            declarations,
            Id::to_u32(super::bodies::handle_arm_enum_name(arm)),
            None,
            module,
            enum_token
        ) {
            None => @resolve_handle_arm(Result::Err(
                ResolutionError::UnexpectedHandleTarget(
                    variant_token, enum_token
                )
            )),
            Option::Some(found) => handle found {
                ResolvedTarget::Variant(variant) =>
                    ResolvedHandleTarget::Variant(variant),
                ResolvedTarget::FunctionAlias(function) =>
                    ResolvedHandleTarget::Variant(try(
                        function_pattern_variant(
                            headers, declarations, function, enum_token
                        ),
                        @resolve_handle_arm
                    )),
                _ => @resolve_handle_arm(Result::Err(
                    ResolutionError::UnexpectedHandleTarget(
                        variant_token, enum_token
                    )
                ))
            }
        }
    } else {
        handle resolve_global_alias(
            headers,
            index,
            declarations,
            Id::to_u32(super::bodies::handle_arm_enum_name(arm)),
            Option::Some(Id::to_u32(
                super::bodies::handle_arm_variant_name(arm)
            )),
            module,
            enum_token
        ) {
            Option::Some(ResolvedTarget::Variant(variant)) =>
                ResolvedHandleTarget::Variant(variant),
            Option::Some(_) => @resolve_handle_arm(Result::Err(
                ResolutionError::UnexpectedHandleTarget(
                    variant_token, enum_token
                )
            )),
            None => try(resolve_qualified_handle_target(
                headers,
                declarations,
                super::bodies::handle_arm_enum_name(arm),
                super::bodies::handle_arm_variant_name(arm),
                module,
                enum_token,
                variant_token
            ), @resolve_handle_arm)
        }
    };
    let frame = scope_frame(move bindings);
    let binder_start = super::syntax::range_mark(&output.pattern_binders);
    let source_binders = super::bodies::handle_arm_binders(body, arm);
    try(resolve_pattern_binders(
        &mut *frame.scope,
        output,
        Id::from_u32(expression),
        source_binders,
        0
    ), @resolve_handle_arm);
    if(bare_alias) {
        let variant = handle target {
            ResolvedHandleTarget::Variant(found) => found,
            ResolvedHandleTarget::EffectOperation(_) => unreachable()
        };
        let header = handle super::headers::variant_at(
            super::headers::nominal_index(headers),
            Id::to_usize(variant)
        ) {
            Result::Err(_) => @resolve_handle_arm(Result::Err(
                ResolutionError::UnexpectedHandleTarget(
                    variant_token, enum_token
                )
            )),
            Result::Ok(found) => found
        };
        let payload_count = Slice::len(super::headers::variant_payloads(
            super::headers::parsed_index(headers),
            header
        ));
        push_resolved_wildcards(
            &mut output.pattern_binders,
            payload_count,
            Slice::len(source_binders)
        )
    } else { () };
    // Seal the parent arm's contiguous binder range before resolving its
    // body. Nested handles append their own binders to the same flat arena
    // and must not become part of this arm's payload pattern.
    let binder_end = Vec::len(&output.pattern_binders);
    let resolved_binders = resolved_binder_range(binder_start, binder_end);
    *IndexVec::index_mut(&mut output.handle_arms, arm_id) =
        Option::Some(ResolvedHandleArm {
            target: target,
            binders: resolved_binders
        });
    try(resolve_expression(
        headers,
        index,
        declarations,
        body,
        &mut *frame.scope,
        output,
        Id::to_u32(super::bodies::handle_arm_body(arm)),
        module
    ), @resolve_handle_arm);
    Result::Ok(())
}

resolve_handle_arms<'a>(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    arms: Slice<'a, super::bodies::HandleArm>,
    ordinal: usize,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    if(ordinal < Slice::len(arms)) {
        let arm = handle Slice::get(arms, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        try(resolve_handle_arm(
            headers,
            index,
            declarations,
            body,
            bindings,
            output,
            expression,
            super::bodies::expression_handle_arm_id(
                body,
                expression,
                ordinal
            ),
            arm,
            module
        ), @resolve_handle_arms);
        resolve_handle_arms(
            headers,
            index,
            declarations,
            body,
            bindings,
            output,
            expression,
            arms,
            ordinal + 1,
            module
        )
    } else { Result::Ok(()) }
}

resolve_handle<'a>(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    target: super::bodies::ExprId,
    arms: Slice<'a, super::bodies::HandleArm>,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    try(resolve_expression(
        headers,
        index,
        declarations,
        body,
        bindings,
        output,
        Id::to_u32(target),
        module
    ), @resolve_handle);
    resolve_handle_arms(
        headers,
        index,
        declarations,
        body,
        bindings,
        output,
        expression,
        arms,
        0,
        module
    )
}

resolve_expression(
    headers: &super::headers::ParsedHeaders,
    index: &ResolutionIndex,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody,
    bindings: &mut ScopeMap,
    output: &mut ResolvedBody,
    expression: u32,
    module: Option<ShellId>
) -> Result<(), ResolutionError> {
    handle super::bodies::expression_view(body, expression) {
        super::bodies::BodyExpressionView::Identifier(_) => resolve_identifier(
            headers,
            index,
            declarations,
            body,
            &*bindings,
            output,
            expression,
            module
        ),
        super::bodies::BodyExpressionView::Number(_) => Result::Ok(()),
        super::bodies::BodyExpressionView::Float(_) => Result::Ok(()),
        super::bodies::BodyExpressionView::Text(_, _) => Result::Ok(()),
        super::bodies::BodyExpressionView::Character(_, _) => Result::Ok(()),
        super::bodies::BodyExpressionView::Byte(_, _) => Result::Ok(()),
        super::bodies::BodyExpressionView::ByteString(_, _) => Result::Ok(()),
        super::bodies::BodyExpressionView::Unit(_) => Result::Ok(()),
        super::bodies::BodyExpressionView::Grouping(child) =>
            resolve_expression(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                Id::to_u32(child),
                module
            ),
        super::bodies::BodyExpressionView::Move(child) =>
            resolve_expression(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                Id::to_u32(child),
                module
            ),
        super::bodies::BodyExpressionView::Prefix(_, child) =>
            resolve_expression(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                Id::to_u32(child),
                module
            ),
        super::bodies::BodyExpressionView::Infix(_, left, right) => {
            try(resolve_expression(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                Id::to_u32(left),
                module
            ), @resolve_expression);
            resolve_expression(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                Id::to_u32(right),
                module
            )
        },
        super::bodies::BodyExpressionView::Call(callee, arguments) => {
            try(resolve_expression(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                Id::to_u32(callee),
                module
            ), @resolve_expression);
            resolve_edges(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                arguments,
                module
            )
        },
        super::bodies::BodyExpressionView::Perform(path, arguments) => {
            let operation = try(resolve_effect_operation(
                headers,
                declarations,
                super::bodies::effect_operation_effect_name(&path),
                super::bodies::effect_operation_name(&path),
                module,
                super::bodies::effect_operation_effect_token(&path),
                super::bodies::effect_operation_token(&path)
            ), @resolve_expression);
            push_resolution(
                output,
                Id::from_u32(expression),
                ResolvedTarget::EffectOperation(operation)
            );
            resolve_edges(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                arguments,
                module
            )
        },
        super::bodies::BodyExpressionView::Block(children) => resolve_block(
            headers,
            index,
            declarations,
            body,
            bindings,
            output,
            expression,
            children,
            module
        ),
        super::bodies::BodyExpressionView::Tuple(children) => resolve_edges(
            headers,
            index,
            declarations,
            body,
            bindings,
            output,
            children,
            module
        ),
        super::bodies::BodyExpressionView::Construction(name, children) =>
            resolve_struct_constructor(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                expression,
                name,
                children,
                module
            ),
        super::bodies::BodyExpressionView::Projection(child, _) =>
            resolve_expression(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                Id::to_u32(child),
                module
            ),
        super::bodies::BodyExpressionView::Closure(parameters, closure_body) =>
            resolve_closure(
                headers,
                index,
                declarations,
                body,
                bindings,
                output,
                expression,
                parameters,
                closure_body,
                module
            ),
        super::bodies::BodyExpressionView::Handle(target, arms) => resolve_handle(
            headers,
            index,
            declarations,
            body,
            bindings,
            output,
            expression,
            target,
            arms,
            module
        ),
        // Labels are resolved structurally by the control-flow lowering pass;
        // unlike identifiers they do not enter lexical name resolution.
        super::bodies::BodyExpressionView::LabelReference(_) => Result::Ok(()),
        super::bodies::BodyExpressionView::LabelDestination(_, _, child) =>
            resolve_expression(
                headers, index, declarations, body, bindings, output,
                Id::to_u32(child), module
            )
    }
}

add_parameters(
    headers: &super::headers::HeaderIndex,
    callable: &super::headers::CallableHeader,
    bindings: &mut ScopeMap,
    ordinal: u32
) -> Result<(), ResolutionError> {
    let parameters = super::headers::callable_parameters(callable);
    if(ordinal < super::headers::range_count(parameters)) {
        let index = super::headers::range_start(parameters) + ordinal;
            handle super::headers::parameter_at(headers, usize_from_u32(index)) {
                Result::Err(_) => Result::Err(
                    ResolutionError::MissingParameterHeader(
                        usize_from_u32(index)
                    )
                ),
                Result::Ok(parameter) => handle duplicate_parameter_token(
                    headers,
                    super::headers::range_start(parameters),
                    super::headers::parameter_name_raw(parameter),
                    ordinal
                ) {
                    Result::Ok(earlier) => Result::Err(
                        ResolutionError::DuplicateParameter(
                            super::headers::parameter_name_token(parameter),
                            earlier
                        )
                    ),
                    Result::Err(_) => {
                        scope_push(
                            bindings,
                            Id::from_u32(
                                super::headers::parameter_name_raw(parameter)
                            ),
                            ResolvedTarget::Parameter(Id::from_u32(ordinal))
                        );
                        add_parameters(
                            headers,
                            callable,
                            bindings,
                            ordinal + 1
                        )
                    }
                }
            }
    } else {
        Result::Ok(())
    }
}

duplicate_parameter_token(
    headers: &super::headers::HeaderIndex,
    start: u32,
    name: u32,
    count: u32
) -> Option<usize> {
    if(count == 0) {
        Result::Err(())
    } else {
        let index = start + count - 1;
        let parameter = try(
            super::headers::parameter_at(headers, usize_from_u32(index)),
            @duplicate_parameter_token
        );
        if(super::headers::parameter_name_raw(parameter) == name) {
            Result::Ok(
                super::headers::parameter_name_token(parameter)
            )
        } else {
            duplicate_parameter_token(
                headers,
                start,
                name,
                count - 1
            )
        }
    }
}

body_callable<'a>(
    index: &ResolutionIndex,
    headers: &'a super::headers::HeaderIndex,
    shell: ShellId
) -> Option<&'a super::headers::CallableHeader> {
    handle *IndexVec::index(&index.callable_by_shell, shell) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(ordinal) => super::headers::callable_at(
            headers,
            usize_from_u32(ordinal)
        )
    }
}

push_missing_resolved_handle_arms(
    output:
        &mut IndexVec<
            super::bodies::HandleArmTag,
            Option<ResolvedHandleArm>
        >,
    remaining: usize
) {
    if(remaining == 0) {
        ()
    } else {
        IndexVec::push(&mut *output, None);
        push_missing_resolved_handle_arms(output, remaining - 1)
    }
}

body_callable_for_parsed_body<'a>(
    index: &ResolutionIndex,
    headers: &'a super::headers::HeaderIndex,
    body: &super::bodies::ParsedBody
) -> Option<&'a super::headers::CallableHeader> {
    handle super::bodies::body_callable_index(body) {
        // Nominal members share their enclosing shell. Their parsed body
        // therefore carries the exact header selected by the method parser.
        Result::Ok(method) => super::headers::callable_at(headers, method),
        Result::Err(_) => body_callable(
            index, headers, super::bodies::body_shell(body)
        )
    }
}

pub resolve_function_body_indexed(
    index: &ResolutionIndex,
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody
) -> Result<ResolvedBody, ResolutionError> {
    let shell_index = super::bodies::body_shell(body);
    let headers_index = super::headers::parsed_index(headers);
    handle super::scanner::shell_at(
        declarations,
        shell_index
    ) {
        Result::Err(_) => Result::Err(
            ResolutionError::MissingBodyShell(
                shell_index
            )
        ),
        Result::Ok(shell) => handle body_callable_for_parsed_body(
            index,
            headers_index,
            body
        ) {
            Result::Err(_) => Result::Err(
                ResolutionError::MissingBodyCallable(
                    shell_index
                )
            ),
            Result::Ok(callable) => {
                let bindings = ScopeMap {
                    values: HashMap::new(),
                    journal: Vec::new()
                };
                let output = ResolvedBody {
                    targets: IndexVec::new(),
                    occurrence_order: Vec::new(),
                    locals: Vec::new(),
                    handle_arms: IndexVec::new(),
                    pattern_binders: Vec::new()
                };
                push_missing_targets(
                    &mut output.targets,
                    super::bodies::expression_count(body)
                );
                push_missing_resolved_handle_arms(
                    &mut output.handle_arms,
                    super::bodies::handle_arm_count(body)
                );
                try(
                    add_parameters(
                        headers_index,
                        callable,
                        &mut bindings,
                        0
                    ),
                    @resolve_function_body_indexed
                );
                try(
                    resolve_expression(
                        headers,
                        index,
                        declarations,
                        body,
                        &mut bindings,
                        &mut output,
                        super::bodies::body_root_index(body),
                        shell_parent_module(shell)
                    ),
                    @resolve_function_body_indexed
                );
                Result::Ok( output)
            }
        }
    }
}

pub resolve_function_body(
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    body: &super::bodies::ParsedBody
) -> Result<ResolvedBody, ResolutionError> {
    let index = try(
        build_resolution_index(headers, declarations),
        @resolve_function_body
    );
    resolve_function_body_indexed(&index, headers, declarations, body)
}


u32_from_usize(value: usize) -> u32 { wrapping_convert_to_u32( value) }

usize_from_u32(value: u32) -> usize { wrapping_convert_to_usize( value) }

u32_from_u8(value: u8) -> u32 { wrapping_convert_to_u32( value) }

u8_from_u32(value: u32) -> u8 { wrapping_convert_to_u8( value) }
