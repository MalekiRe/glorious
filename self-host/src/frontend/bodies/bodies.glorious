// One-body-at-a-time expression parsing and source-fixity grouping.
// This slice supports eager blocks, simple local bindings, explicit calls,
// identifiers, integer/float number tokens, unit, tuples, nominal
// construction, projection, grouping, and declared prefix/infix operators.

use super::lexer::{Keyword, TokenKind, TokenPattern};
use super::scanner::ShellId;

pub struct ExprTag {}

pub type ExprId = Id<ExprTag>;

expr_id_from_u32(raw: u32) -> ExprId { Id::from_u32(raw) }

pub struct HandleArmTag {}

pub type HandleArmId = Id<HandleArmTag>;

pub struct BodyTypeTag {}
pub type BodyTypeId = Id<BodyTypeTag>;

struct BodyTypeRangeTag {}
type BodyTypeRange = super::syntax::IdRange<BodyTypeRangeTag>;

struct ClosureParameterRangeTag {}
type ClosureParameterRange = super::syntax::IdRange<ClosureParameterRangeTag>;

struct ExpressionNameRangeTag {}
type ExpressionNameRange = super::syntax::IdRange<ExpressionNameRangeTag>;

struct ExprEdgeRangeTag {}
type ExprEdgeRange = super::syntax::IdRange<ExprEdgeRangeTag>;

struct PatternBinderRangeTag {}
type PatternBinderRange = super::syntax::IdRange<PatternBinderRangeTag>;

pub struct PatternTag {}
pub type PatternId = Id<PatternTag>;

type HandleArmRange = super::syntax::IdRange<HandleArmTag>;

enum ExprEdgeKind {
    Argument,
    Element(u32),
    ConstructionField(u32),
    Let(usize),
    Statement
}

impl Use<[0, *]> for ExprEdgeKind {}

pub struct ExprEdge { value: ExprId, kind: ExprEdgeKind }

pub enum BlockStatementView {
    Let(ExprId, usize),
    Expression(ExprId)
}

impl Use<[0, *]> for BlockStatementView {}

pub enum ExpressionNameView {
    Identifier(Id<String>, usize),
    TupleField(u32, usize)
}

impl Use<[0, *]> for ExpressionNameView {}

pub type BodyTokenRange = super::syntax::TokenSpan;

pub enum PatternBinder {
    Wildcard(usize),
    Binding(Id<String>, usize),
    Integer(usize)
}

impl Use<[0, *]> for PatternBinder {}

pub struct HandleArm {
    enum_name: Id<String>,
    enum_token: usize,
    variant_name: Id<String>,
    variant_token: usize,
    effect_type: Option<BodyTypeId>,
    binders: PatternBinderRange,
    body: ExprId
}

pub struct ClosureParameter { name: Id<String>, token: usize }

enum BodyTypeKind {
    Path(Id<String>, usize),
    Application(BodyTypeId, BodyTypeRange)
}

impl Use<[0, *]> for BodyTypeKind {}

struct BodyTypeNode { kind: BodyTypeKind, tokens: BodyTokenRange }

pub enum BodyTypeView<'a> {
    Path(Id<String>, usize),
    Application(BodyTypeId, Slice<'a, BodyTypeId>)
}

impl<'a> Use<[0, *]> for BodyTypeView<'a> {}

// A source effect-operation path deliberately lives outside the ordinary
// expression-name arena. `perform E::op(...)` is control syntax, not a call
// through a value named `E::op`, and retaining both tokens lets resolution
// diagnose the owner and member independently.
pub struct EffectOperationSyntax {
    effect_name: Id<String>,
    effect_token: usize,
    effect_type: BodyTypeId,
    operation_name: Id<String>,
    operation_token: usize
}

impl Use<[0, *]> for EffectOperationSyntax {}

enum ExpressionName {
    Identifier(Id<String>, usize),
    TupleField(u32, usize)
}

impl Use<[0, *]> for ExpressionName {}

enum ExprKind {
    Identifier(ExpressionNameRange),
    Number,
    Is(ExprId, PatternId),
    Unit,
    Grouping(ExprId),
    Move(ExprId),
    Prefix(BodyTokenRange, ExprId),
    Infix(BodyTokenRange, ExprId, ExprId),
    Call(ExprId, ExprEdgeRange),
    Perform(EffectOperationSyntax, ExprEdgeRange),
    Block(ExprEdgeRange),
    Tuple(ExprEdgeRange),
    Construction(ExpressionNameRange, ExprEdgeRange),
    Projection(ExprId, ExpressionNameRange),
    Closure(ClosureParameterRange, ExprId),
    Handle(ExprId, HandleArmRange)
}

impl Use<[0, *]> for ExprKind {}

enum PatternKind {
    Integer(usize),
    Float(usize),
    Text(Id<String>, usize),
    Character(char, usize),
    Byte(u8, usize),
    Unit(usize)
}

impl Use<[0, *]> for PatternKind {}

struct PatternNode { kind: PatternKind, tokens: BodyTokenRange }

pub enum PatternView {
    Integer(usize),
    Float(usize),
    Text(Id<String>, usize),
    Character(char, usize),
    Byte(u8, usize),
    Unit(usize)
}

impl Use<[0, *]> for PatternView {}

pub struct ExprNode { kind: ExprKind, tokens: BodyTokenRange }

pub struct ParsedBody {
    shell: ShellId,
    root: ExprId,
    nodes: Arena<ExprTag, ExprNode>,
    edges: Vec<ExprEdge>,
    names: Vec<ExpressionName>,
    types: Arena<BodyTypeTag, BodyTypeNode>,
    type_arguments: Vec<BodyTypeId>,
    closure_parameters: Vec<ClosureParameter>,
    handle_arms: Vec<HandleArm>,
    pattern_binders: Vec<PatternBinder>,
    patterns: Arena<PatternTag, PatternNode>
}

pub enum BodyExpressionView<'a> {
    Identifier(BodyTokenRange),
    Number(BodyTokenRange),
    Is(ExprId, PatternId),
    Unit(BodyTokenRange),
    Grouping(ExprId),
    Move(ExprId),
    Prefix(BodyTokenRange, ExprId),
    Infix(BodyTokenRange, ExprId, ExprId),
    Call(ExprId, Slice<'a, ExprEdge>),
    Perform(EffectOperationSyntax, Slice<'a, ExprEdge>),
    Block(Slice<'a, ExprEdge>),
    Tuple(Slice<'a, ExprEdge>),
    Construction(ExpressionNameView, Slice<'a, ExprEdge>),
    Projection(ExprId, ExpressionNameView),
    Closure(Slice<'a, ClosureParameter>, ExprId),
    Handle(ExprId, Slice<'a, HandleArm>)
}

impl<'a> Use<[0, *]> for BodyExpressionView<'a> {}

// Control-aware preorder traversal. The callback chooses whether the current
// node's children are visited and may invoke `stop` from any nested helper to
// leave the complete walk with a typed result.
pub enum Visit { Descend, SkipChildren }

impl Use<[0, *]> for Visit {}

pub enum FoldVisit<A> { Descend(A), SkipChildren(A) }

__g1_walk_expr_children<'a, L, R, F, e: EffectRow>(
    body: &'a ParsedBody,
    expression: ExprId,
    child: u32,
    count: u32,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(ExprId, BodyExpressionView<'a>, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    expression;
    if(child < count) {
        walk_expr(
            body,
            Id::from_u32(expression_child_at(body, Id::to_u32(expression), child)),
            stop,
            visitor
        );
        __g1_walk_expr_children(body, expression, child + 1, count, stop, visitor)
    } else {
        ()
    }
}

pub walk_expr<'a, L, R, F, e: EffectRow>(
    body: &'a ParsedBody,
    expression: ExprId,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(ExprId, BodyExpressionView<'a>, L), Output=Visit, Effects={| e}>,
F: Use<[0, 0]> {
    handle visitor(expression, expression_view(body, Id::to_u32(expression)), stop) {
        Visit::Descend => __g1_walk_expr_children(
            body,
            expression,
            0,
            expression_child_count_at(body, Id::to_u32(expression)),
            stop,
            visitor
        ),
        Visit::SkipChildren => ()
    }
}

__g1_fold_expr_children<'a, L, R, A, F, e: EffectRow>(
    body: &'a ParsedBody,
    expression: ExprId,
    child: u32,
    count: u32,
    accumulator: A,
    stop: L,
    visitor: F
) -> A
where L: Label<R>,
F: Fn<(A, ExprId, BodyExpressionView<'a>, L), Output=FoldVisit<A>, Effects={| e}>,
F: Use<[0, 0]> {
    expression;
    if(child < count) {
        __g1_fold_expr_children(
            body,
            expression,
            child + 1,
            count,
            fold_expr(
                body,
                Id::from_u32(expression_child_at(body, Id::to_u32(expression), child)),
                accumulator,
                stop,
                visitor
            ),
            stop,
            visitor
        )
    } else {
        accumulator
    }
}

pub fold_expr<'a, L, R, A, F, e: EffectRow>(
    body: &'a ParsedBody,
    expression: ExprId,
    accumulator: A,
    stop: L,
    visitor: F
) -> A
where L: Label<R>,
F: Fn<(A, ExprId, BodyExpressionView<'a>, L), Output=FoldVisit<A>, Effects={| e}>,
F: Use<[0, 0]> {
    handle visitor(
        accumulator,
        expression,
        expression_view(body, Id::to_u32(expression)),
        stop
    ) {
        FoldVisit::Descend(next) => __g1_fold_expr_children(
            body,
            expression,
            0,
            expression_child_count_at(body, Id::to_u32(expression)),
            next,
            stop,
            visitor
        ),
        FoldVisit::SkipChildren(next) => next
    }
}

// A structural rewrite returns the node that should occupy the current slot
// and independently chooses whether that node's children are rewritten. The
// replacement is an arena ID, so callbacks can reuse an existing subtree or
// allocate a new one through the ordinary body builder without exposing a
// dynamic visitor object.
pub enum RewriteVisit {
    Descend(ExprId),
    SkipChildren(ExprId)
}

impl Use<[0, *]> for RewriteVisit {}

expression_edge_set_value(value: &mut ExprEdge, replacement: ExprId) {
    (*value).value = replacement;
    ()
}

handle_arm_set_body(value: &mut HandleArm, replacement: ExprId) {
    (*value).body = replacement;
    ()
}

expr_node_set_kind(value: &mut ExprNode, replacement: ExprKind) {
    (*value).kind = move replacement;
    ()
}

parsed_body_set_root(value: &mut ParsedBody, replacement: ExprId) {
    (*value).root = replacement;
    ()
}

expression_child_set(
    value: &mut ParsedBody,
    expression: ExprId,
    child: u32,
    replacement: ExprId
) {
    let kind = {
        let node = Arena::index_mut(&mut value.nodes, expression);
        replace(&mut (*node).kind, ExprKind::Unit)
    };
    let next = handle move kind {
        ExprKind::Grouping(_) => ExprKind::Grouping(replacement),
        ExprKind::Prefix(operator, _) => ExprKind::Prefix(operator, replacement),
        ExprKind::Infix(operator, left, right) => if(child == 0) {
            ExprKind::Infix(operator, replacement, right)
        } else {
            ExprKind::Infix(operator, left, replacement)
        },
        ExprKind::Call(callee, range) => if(child == 0) {
            ExprKind::Call(replacement, range)
        } else {
            expression_edge_set_value(Vec::index_mut(
                &mut value.edges,
                usize_from_u32(range.start + child - 1)
            ), replacement);
            ExprKind::Call(callee, range)
        },
        ExprKind::Perform(path, range) => {
            expression_edge_set_value(Vec::index_mut(
                &mut value.edges,
                usize_from_u32(range.start + child)
            ), replacement);
            ExprKind::Perform(path, range)
        },
        ExprKind::Block(range) => {
            expression_edge_set_value(Vec::index_mut(
                &mut value.edges,
                usize_from_u32(range.start + child)
            ), replacement);
            ExprKind::Block(range)
        },
        ExprKind::Tuple(range) => {
            expression_edge_set_value(Vec::index_mut(
                &mut value.edges,
                usize_from_u32(range.start + child)
            ), replacement);
            ExprKind::Tuple(range)
        },
        ExprKind::Construction(names, range) => {
            expression_edge_set_value(Vec::index_mut(
                &mut value.edges,
                usize_from_u32(range.start + child)
            ), replacement);
            ExprKind::Construction(names, range)
        },
        ExprKind::Projection(_, names) => ExprKind::Projection(replacement, names),
        ExprKind::Closure(parameters, _) =>
            ExprKind::Closure(parameters, replacement),
        ExprKind::Handle(subject, arms) => if(child == 0) {
            ExprKind::Handle(replacement, arms)
        } else {
            handle_arm_set_body(Vec::index_mut(
                &mut value.handle_arms,
                usize_from_u32(arms.start + child - 1)
            ), replacement);
            ExprKind::Handle(subject, arms)
        },
        ExprKind::Is(subject, pattern) => if(child == 0) {
            ExprKind::Is(replacement, pattern)
        } else { ExprKind::Is(subject, pattern) },
        other => { replacement; other }
    };
    expr_node_set_kind(
        Arena::index_mut(&mut value.nodes, expression),
        move next
    );
    ()
}

struct __ExprRewriteEdge { parent: ExprId, child: u32 }
struct __ExprRewriteDecision { replacement: ExprId, descend: Bool }

__g1_new_expr_rewrite_work() -> Vec<__ExprRewriteEdge> { Vec::new() }

__g1_expr_rewrite_decision(value: RewriteVisit) -> __ExprRewriteDecision {
    handle move value {
        RewriteVisit::SkipChildren(replacement) =>
            __ExprRewriteDecision { replacement: replacement, descend: false },
        RewriteVisit::Descend(replacement) =>
            __ExprRewriteDecision { replacement: replacement, descend: true }
    }
}

__g1_push_expr_rewrite_children(
    work: &mut Vec<__ExprRewriteEdge>,
    expression: ExprId,
    count: u32
) {
    if(count > 0) {
        let child = count - 1;
        Vec::push(
            &mut *work,
            __ExprRewriteEdge { parent: expression, child: child }
        );
        __g1_push_expr_rewrite_children(&mut *work, expression, child)
    } else { () }
}

__g1_rewrite_expr_work<L, R, F, e: EffectRow>(
    body: &mut ParsedBody,
    work: Vec<__ExprRewriteEdge>,
    stop: L,
    visitor: F
)
where L: Label<R>,
F: Fn<(&mut ParsedBody, ExprId, L), Output=RewriteVisit, Effects={| e}>,
F: Use<[0, 0]> {
    handle Vec::pop(&mut work) {
        Result::Err(_) => { work; () },
        Result::Ok(edge) => {
            let __ExprRewriteEdge { parent, child } = move edge;
            let original = expr_id_from_u32(expression_child_at(
                &*body,
                Id::to_u32(parent),
                child
            ));
            let __ExprRewriteDecision { replacement, descend } =
                __g1_expr_rewrite_decision(visitor(&mut *body, original, stop));
            expression_child_set(&mut *body, parent, child, replacement);
            if(descend) {
                let count = expression_child_count_at(
                    &*body,
                    Id::to_u32(replacement)
                );
                __g1_push_expr_rewrite_children(&mut work, replacement, count)
            } else { () };
            __g1_rewrite_expr_work(move body, move work, stop, visitor)
        }
    }
}

pub rewrite_expr<L, R, F, e: EffectRow>(
    body: &mut ParsedBody,
    root: ExprId,
    stop: L,
    visitor: F
) -> ExprId
where L: Label<R>,
F: Fn<(&mut ParsedBody, ExprId, L), Output=RewriteVisit, Effects={| e}>,
F: Use<[0, 0]> {
    let __ExprRewriteDecision { replacement, descend } =
        __g1_expr_rewrite_decision(visitor(&mut *body, root, stop));
    let work = __g1_new_expr_rewrite_work();
    if(descend) {
        __g1_push_expr_rewrite_children(
            &mut work,
            replacement,
            expression_child_count_at(&*body, Id::to_u32(replacement))
        )
    } else { () };
    __g1_rewrite_expr_work(move body, move work, stop, visitor);
    replacement
}

__g1_identity_rewrite_expr<L, R>(body: ParsedBody, stop: L) -> ParsedBody
where L: Label<R> {
    let root = body.root;
    let rewritten = rewrite_expr(
        &mut body,
        root,
        stop,
        { _, expression, _ => RewriteVisit::Descend(expression) }
    );
    parsed_body_set_root(&mut body, rewritten);
    move body
}

pub enum BodyError {
    ExpectedExpression(usize, usize),
    ExpectedGroupingClose(usize, usize),
    DuplicatePatternBinder(usize, usize),
    IncompatibleAssociativity(usize, usize),
    NonAssociativeChain(usize, usize),
    ConflictingFixity(usize, usize),
    ExpressionDepthLimit(usize, usize),
    MissingBodyShell(ShellId),
    InvalidEncodedExpression(usize, usize),
    ExpectedCallClose(usize, usize),
    InvalidLetSyntax(usize, usize),
    MissingEncodedName(usize, usize),
    ExpectedBlockClose(usize, usize),
    ExpectedIdentifier(usize, usize),
    ExpectedTupleDelimiter(usize, usize),
    InvalidHandleArm(usize, usize),
    InvalidStructField(usize, usize),
    ExpectedProjectionName(usize, usize),
    ExpectedPattern(usize, usize)
}

struct BodyParser {
    tokens: super::syntax::TokenCursor,
    nodes: Arena<ExprTag, ExprNode>,
    edges: Vec<ExprEdge>,
    names: Vec<ExpressionName>,
    types: Arena<BodyTypeTag, BodyTypeNode>,
    type_arguments: Vec<BodyTypeId>,
    closure_parameters: Vec<ClosureParameter>,
    handle_arms: Vec<HandleArm>,
    pattern_binders: Vec<PatternBinder>,
    patterns: Arena<PatternTag, PatternNode>
}

// A speculative parse owns one transaction over every mutable component of a
// body. Any labeled transfer, propagated error, or ordinary early return drops
// this guard and restores a state in which no partially allocated expression
// can remain reachable.
// The reusable cursor transaction owns every append-only arena coupled to the
// cursor. `BodyParserCheckpoint` below is the compiler-specific spelling used
// by parser combinators; keeping the generic name primary makes the cleanup
// protocol visible to other bounded cursor consumers.
pub struct CursorCheckpoint<'a> {
    value: &'a mut BodyParser,
    token_position: usize,
    node_mark: usize,
    edge_length: usize,
    name_length: usize,
    type_mark: usize,
    type_argument_length: usize,
    closure_parameter_length: usize,
    arm_length: usize,
    binder_length: usize,
    pattern_mark: usize,
    armed: Bool
}

impl<'a> Drop for CursorCheckpoint<'a> {
    drop(&mut self) -> {
        if(self.armed) {
            let value = &mut *self.value;
            super::syntax::cursor_set(
                &mut (*value).tokens,
                self.token_position
            );
            Vec::truncate(
                &mut (*value).pattern_binders,
                self.binder_length
            );
            Arena::truncate(&mut (*value).patterns, self.pattern_mark);
            Vec::truncate(&mut (*value).handle_arms, self.arm_length);
            Vec::truncate(&mut (*value).names, self.name_length);
            Vec::truncate(
                &mut (*value).closure_parameters,
                self.closure_parameter_length
            );
            Vec::truncate(
                &mut (*value).type_arguments,
                self.type_argument_length
            );
            Arena::truncate(&mut (*value).types, self.type_mark);
            Vec::truncate(&mut (*value).edges, self.edge_length);
            Arena::truncate(&mut (*value).nodes, self.node_mark)
        } else {
            ()
        }
    }
}

pub type BodyParserCheckpoint<'a> = CursorCheckpoint<'a>;

body_parser_checkpoint<'a>(
    value: &'a mut BodyParser
) -> BodyParserCheckpoint<'a> {
    let token_position = super::syntax::cursor_position(&value.tokens);
    let node_mark = Arena::mark(&value.nodes);
    let edge_length = Vec::len(&value.edges);
    let name_length = Vec::len(&value.names);
    let type_mark = Arena::mark(&value.types);
    let type_argument_length = Vec::len(&value.type_arguments);
    let closure_parameter_length = Vec::len(&value.closure_parameters);
    let arm_length = Vec::len(&value.handle_arms);
    let binder_length = Vec::len(&value.pattern_binders);
    let pattern_mark = Arena::mark(&value.patterns);
    CursorCheckpoint {
        token_position: move token_position,
        node_mark: move node_mark,
        edge_length: move edge_length,
        name_length: move name_length,
        type_mark: move type_mark,
        type_argument_length: move type_argument_length,
        closure_parameter_length: move closure_parameter_length,
        arm_length: move arm_length,
        binder_length: move binder_length,
        pattern_mark: move pattern_mark,
        value: move value,
        armed: true
    }
}

body_parser_checkpoint_commit<'a>(value: &mut BodyParserCheckpoint<'a>) {
    (*value).armed = false;
    ()
}

enum ParseAttempt<T, E> {
    NoMatch,
    Parsed(T),
    Diagnostic(E)
}

impl<T, E> Use<[0, *]> for ParseAttempt<T, E>
where T: Use<[0, *]>, E: Use<[0, *]> {}

// `miss` is supplied by the caller so its generative label type remains in
// lexical scope. Invoking it from any nested parser/helper drops the armed
// checkpoint before leaving the alternative.
attempt<L, T, E, F, e: EffectRow>(
    value: &mut BodyParser,
    miss: L,
    body: F
) -> ParseAttempt<T, E>
where L: Label<ParseAttempt<T, E>>,
F: Fn<(&mut BodyParser, L), Output=Result<T, E>, Effects={| e}>,
F: Use<[0, 0]> {
    let checkpoint = body_parser_checkpoint(move value);
    handle body(&mut *checkpoint.value, miss) {
        Result::Err(error) => ParseAttempt::Diagnostic(move error),
        Result::Ok(parsed) => {
            body_parser_checkpoint_commit(&mut checkpoint);
            ParseAttempt::Parsed(move parsed)
        }
    }
}

// Internal combinators use a value-returning alternative in places where the
// language cannot express a higher-ranked callback over the fresh label made
// by `attempt`. It has the same transaction boundary: only `Parsed` commits;
// both a recoverable miss and an authoritative diagnostic roll back every body
// arena and cursor mutation.
attempt_value<T, F, e: EffectRow>(
    value: &mut BodyParser,
    body: F
) -> ParseAttempt<T, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, 0]> {
    let checkpoint = body_parser_checkpoint(move value);
    handle body(&mut *checkpoint.value) {
        ParseAttempt::NoMatch => ParseAttempt::NoMatch,
        ParseAttempt::Diagnostic(error) => ParseAttempt::Diagnostic(move error),
        ParseAttempt::Parsed(parsed) => {
            body_parser_checkpoint_commit(&mut checkpoint);
            ParseAttempt::Parsed(move parsed)
        }
    }
}

attempt_item<T, F, e: EffectRow>(
    value: &mut BodyParser,
    body: F
) -> ParseAttempt<T, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, 0]> {
    attempt_value(value, body)
}

attempt_unit<F, e: EffectRow>(
    value: &mut BodyParser,
    body: F
) -> ParseAttempt<(), BodyError>
where F: Fn<(&mut BodyParser,), Output=ParseAttempt<(), BodyError>, Effects={| e}>,
F: Use<[0, 0]> {
    attempt_value(value, body)
}

// Try the second alternative only after the first has reported `NoMatch` and
// its checkpoint has restored the complete parser state.
choice<T, F, G, e: EffectRow>(
    value: &mut BodyParser,
    first: F,
    second: G
) -> ParseAttempt<T, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, 0]>,
G: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
G: Use<[0, 0]> {
    handle attempt_value(value, first) {
        ParseAttempt::NoMatch => attempt_value(value, second),
        ParseAttempt::Diagnostic(error) => ParseAttempt::Diagnostic(move error),
        ParseAttempt::Parsed(parsed) => ParseAttempt::Parsed(move parsed)
    }
}

optional<T, F, e: EffectRow>(
    value: &mut BodyParser,
    body: F
) -> ParseAttempt<Option<T>, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, 0]> {
    handle attempt_value(value, body) {
        ParseAttempt::NoMatch => ParseAttempt::Parsed(None),
        ParseAttempt::Diagnostic(error) => ParseAttempt::Diagnostic(move error),
        ParseAttempt::Parsed(parsed) =>
            ParseAttempt::Parsed(Option::Some(move parsed))
    }
}

// Crossing a grammar commit point turns absence into an authoritative error.
commit<T, E>(value: ParseAttempt<T, E>, error: E) -> ParseAttempt<T, E>
where T: Use<[0, *]>, E: Use<[0, *]> {
    handle move value {
        ParseAttempt::NoMatch => ParseAttempt::Diagnostic(move error),
        ParseAttempt::Diagnostic(found) => ParseAttempt::Diagnostic(move found),
        ParseAttempt::Parsed(parsed) => ParseAttempt::Parsed(move parsed)
    }
}

require_token<L, T>(
    value: &mut BodyParser,
    source: &super::lexer::LexedSource,
    pattern: TokenPattern,
    miss: L
) -> Result<usize, BodyError>
where L: Label<ParseAttempt<T, BodyError>> {
    let token = super::syntax::cursor_position(&value.tokens);
    if(super::syntax::cursor_eat(&mut value.tokens, source, pattern)) {
        Result::Ok(move token)
    } else {
        miss(ParseAttempt::NoMatch)
    }
}

struct RequiredIdent {
    name: Id<String>,
    token: usize
}

require_ident<L, T>(
    value: &mut BodyParser,
    source: &super::lexer::LexedSource,
    miss: L
) -> Result<RequiredIdent, BodyError>
where L: Label<ParseAttempt<T, BodyError>> {
    let token = super::syntax::cursor_position(&value.tokens);
    if(token < super::syntax::cursor_limit(&value.tokens)) {
        handle super::lexer::token_kind_at(source, token) {
            TokenKind::Ident(name) => {
                super::syntax::cursor_advance(&mut value.tokens);
                Result::Ok(RequiredIdent { name: move name, token: move token })
            },
            _ => miss(ParseAttempt::NoMatch)
        }
    } else {
        miss(ParseAttempt::NoMatch)
    }
}

// `expect` is used only after a construct has committed to its grammar. Unlike
// `require_token`, absence therefore becomes a diagnostic rather than a miss.
expect(
    value: &mut BodyParser,
    source: &super::lexer::LexedSource,
    pattern: TokenPattern,
    error: BodyError
) -> Result<usize, BodyError> {
    let token = super::syntax::cursor_position(&value.tokens);
    if(super::syntax::cursor_eat(&mut value.tokens, source, pattern)) {
        Result::Ok(move token)
    } else {
        Result::Err(move error)
    }
}

delimited<T, F, e: EffectRow>(
    value: &mut BodyParser,
    source: &super::lexer::LexedSource,
    open: TokenPattern,
    close: TokenPattern,
    open_error: BodyError,
    close_error: BodyError,
    body: F
) -> Result<T, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=Result<T, BodyError>, Effects={| e}>,
F: Use<[0, 0]> {
    let checkpoint = body_parser_checkpoint(move value);
    handle expect(&mut *checkpoint.value, source, open, open_error) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(_) => handle body(&mut *checkpoint.value) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(parsed) => handle expect(
                &mut *checkpoint.value,
                source,
                close,
                close_error
            ) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(_) => {
                    body_parser_checkpoint_commit(&mut checkpoint);
                    Result::Ok(move parsed)
                }
            }
        }
    }
}

__many<T, F, e: EffectRow>(
    value: &mut BodyParser,
    body: F,
    output: Vec<T>
) -> ParseAttempt<Vec<T>, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, *]> {
    let before = super::syntax::cursor_position(&value.tokens);
    handle attempt_value(value, body) {
        ParseAttempt::NoMatch => ParseAttempt::Parsed(move output),
        ParseAttempt::Diagnostic(error) => ParseAttempt::Diagnostic(move error),
        ParseAttempt::Parsed(parsed) => {
            let after = super::syntax::cursor_position(&value.tokens);
            if(before < after) {
                Vec::push(&mut output, move parsed);
                __many(value, body, move output)
            } else {
                parsed;
                ParseAttempt::Parsed(move output)
            }
        }
    }
}

many<T, F, e: EffectRow>(
    value: &mut BodyParser,
    body: F
) -> ParseAttempt<Vec<T>, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, *]> {
    __many(value, body, Vec::new())
}

many1<T, F, e: EffectRow>(
    value: &mut BodyParser,
    body: F
) -> ParseAttempt<Vec<T>, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, *]> {
    handle many(value, body) {
        ParseAttempt::Parsed(parsed) => if(Vec::is_empty(&parsed)) {
            ParseAttempt::NoMatch
        } else {
            ParseAttempt::Parsed(move parsed)
        },
        ParseAttempt::NoMatch => ParseAttempt::NoMatch,
        ParseAttempt::Diagnostic(error) => ParseAttempt::Diagnostic(move error)
    }
}

__separated<T, F, G, e: EffectRow>(
    value: &mut BodyParser,
    item: F,
    separator: G,
    missing: BodyError,
    output: Vec<T>
) -> ParseAttempt<Vec<T>, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, *]>,
G: Fn<(&mut BodyParser,), Output=ParseAttempt<(), BodyError>, Effects={| e}>,
G: Use<[0, *]> {
    handle attempt_unit(value, separator) {
        ParseAttempt::NoMatch => ParseAttempt::Parsed(move output),
        ParseAttempt::Diagnostic(error) => ParseAttempt::Diagnostic(move error),
        ParseAttempt::Parsed(_) => handle attempt_item(value, item) {
            ParseAttempt::Parsed(parsed) => {
                Vec::push(&mut output, move parsed);
                __separated(
                    value,
                    item,
                    separator,
                    missing,
                    move output
                )
            },
            // A separator commits the grammar to another item. The error is
            // consumed only on that terminal branch, so successful recursive
            // iterations retain the same diagnostic value.
            ParseAttempt::NoMatch => ParseAttempt::Diagnostic(move missing),
            ParseAttempt::Diagnostic(error) => ParseAttempt::Diagnostic(move error)
        }
    }
}

separated<T, F, G, e: EffectRow>(
    value: &mut BodyParser,
    item: F,
    separator: G,
    missing: BodyError
) -> ParseAttempt<Vec<T>, BodyError>
where T: Use<[0, *]>,
F: Fn<(&mut BodyParser,), Output=ParseAttempt<T, BodyError>, Effects={| e}>,
F: Use<[0, *]>,
G: Fn<(&mut BodyParser,), Output=ParseAttempt<(), BodyError>, Effects={| e}>,
G: Use<[0, *]> {
    handle attempt_item(value, item) {
        ParseAttempt::NoMatch => ParseAttempt::Parsed(Vec::new()),
        ParseAttempt::Diagnostic(error) => ParseAttempt::Diagnostic(move error),
        ParseAttempt::Parsed(parsed) => {
            let output = Vec::new();
            Vec::push(&mut output, move parsed);
            __separated(
                value,
                item,
                separator,
                missing,
                move output
            )
        }
    }
}

// Recovery is deliberately single-shot and bounded by the cursor limit. It
// leaves the synchronization token unconsumed so the enclosing parser decides
// whether that token closes the current construct or starts the next one.
recover_until(
    value: &mut BodyParser,
    source: &super::lexer::LexedSource,
    pattern: TokenPattern
) -> usize {
    if(super::syntax::cursor_at(&value.tokens, source, pattern)) {
        super::syntax::cursor_position(&value.tokens)
    } else if(super::syntax::cursor_at_end(&value.tokens)) {
        super::syntax::cursor_position(&value.tokens)
    } else {
        super::syntax::cursor_advance(&mut value.tokens);
        recover_until(value, source, pattern)
    }
}

struct OperatorUse {
    fixity: u32,
    start: usize,
    end: usize,
    form: u8,
    precedence: u8
}

struct PendingField {
    name: Id<String>,
    name_token: usize,
    expression: ExprId
}

enum PendingStatement {
    Let(usize, ExprId),
    Expression(ExprId)
}

parse_statement_no_match() -> ParseAttempt<PendingStatement, BodyError> {
    ParseAttempt::NoMatch
}

struct PendingHandleArm {
    enum_name: Id<String>,
    enum_token: usize,
    variant_name: Id<String>,
    variant_token: usize,
    effect_type: Option<BodyTypeId>,
    binders: Vec<PatternBinder>,
    body: ExprId
}

impl Use<[0, *]> for OperatorUse {}
impl Use<[0, *]> for PendingField {}
impl Use<[0, *]> for PendingStatement {}

arena_node_at_raw<'a>(
    value: &'a Arena<ExprTag, ExprNode>,
    raw: u32
) -> &'a ExprNode {
    Arena::index(value, Id::from_u32(raw))
}

alloc_node(
    value: &mut Arena<ExprTag, ExprNode>,
    node: ExprNode
) -> ExprId {
    handle Arena::alloc(value, node) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub expression_count(value: &ParsedBody) -> usize { Arena::len(&value.nodes) }

pub expression_at<'a>(
    value: &'a ParsedBody,
    index: usize
) -> Option<&'a ExprNode> {
    handle Id::from_usize(index) {
        Result::Err(_) => None,
        Result::Ok(id) => Arena::get(&value.nodes, id)
    }
}

pub body_shell(value: &ParsedBody) -> ShellId { value.shell }

pub body_root_index(value: &ParsedBody) -> u32 { Id::to_u32(value.root) }

pub expression_token_start_at(value: &ParsedBody, index: u32) -> usize {
    arena_node_at_raw(&value.nodes, index).tokens.start
}

pub expression_token_end_at(value: &ParsedBody, index: u32) -> usize {
    arena_node_at_raw(&value.nodes, index).tokens.end
}

pub expression_name_count_at(value: &ParsedBody, index: u32) -> u32 {
    node_name_range(arena_node_at_raw(&value.nodes, index)).count
}

pub effect_operation_effect_name(value: &EffectOperationSyntax) -> Id<String> {
    value.effect_name
}

pub effect_operation_effect_token(value: &EffectOperationSyntax) -> usize {
    value.effect_token
}

pub effect_operation_effect_type(value: &EffectOperationSyntax) -> BodyTypeId {
    value.effect_type
}

pub handle_arm_effect_type(value: &HandleArm) -> Option<BodyTypeId> {
    value.effect_type
}

pub body_type_token_start(value: &ParsedBody, ty: BodyTypeId) -> usize {
    Arena::index(&value.types, ty).tokens.start
}

pub body_type_token_end(value: &ParsedBody, ty: BodyTypeId) -> usize {
    Arena::index(&value.types, ty).tokens.end
}

body_type_arguments<'a>(
    value: &'a ParsedBody,
    range: BodyTypeRange
) -> Slice<'a, BodyTypeId> {
    handle Slice::subslice(
        Vec::as_slice(&value.type_arguments),
        usize_from_u32(range.start),
        usize_from_u32(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub body_type_view<'a>(
    value: &'a ParsedBody,
    ty: BodyTypeId
) -> BodyTypeView<'a> {
    let node = Arena::index(&value.types, ty);
    handle node.kind {
        BodyTypeKind::Path(name, token) => BodyTypeView::Path(name, token),
        BodyTypeKind::Application(constructor, arguments) =>
            BodyTypeView::Application(
                constructor,
                body_type_arguments(value, arguments)
            )
    }
}

pub closure_parameter_name(value: &ClosureParameter) -> Id<String> { value.name }
pub closure_parameter_token(value: &ClosureParameter) -> usize { value.token }

pub effect_operation_name(value: &EffectOperationSyntax) -> Id<String> {
    value.operation_name
}

pub effect_operation_token(value: &EffectOperationSyntax) -> usize {
    value.operation_token
}

node_name_range(value: &ExprNode) -> ExpressionNameRange {
    handle value.kind {
        ExprKind::Identifier(range) => range,
        ExprKind::Construction(range, _) => range,
        ExprKind::Projection(_, range) => range,
        _ => super::syntax::empty_id_range(0)
    }
}

pub expression_name_kind_at(
    value: &ParsedBody,
    index: u32,
    ordinal: u32
) -> u8 {
    let node = arena_node_at_raw(&value.nodes, index);
    let names = node_name_range(node);
    handle *Vec::index(
        &value.names,
        usize_from_u32(names.start + ordinal)
    ) {
        ExpressionName::Identifier(_, _) => 1,
        ExpressionName::TupleField(_, _) => 2
    }
}

pub expression_name_value_at(
    value: &ParsedBody,
    index: u32,
    ordinal: u32
) -> u32 {
    let node = arena_node_at_raw(&value.nodes, index);
    let names = node_name_range(node);
    handle *Vec::index(
        &value.names,
        usize_from_u32(names.start + ordinal)
    ) {
        ExpressionName::Identifier(name, _) => Id::to_u32(name),
        ExpressionName::TupleField(field, _) => field
    }
}

pub expression_name_token_at(
    value: &ParsedBody,
    index: u32,
    ordinal: u32
) -> usize {
    let node = arena_node_at_raw(&value.nodes, index);
    let names = node_name_range(node);
    handle *Vec::index(
        &value.names,
        usize_from_u32(names.start + ordinal)
    ) {
        ExpressionName::Identifier(_, token) => token,
        ExpressionName::TupleField(_, token) => token
    }
}

expression_edges<'a>(
    value: &'a ParsedBody,
    range: ExprEdgeRange
) -> Slice<'a, ExprEdge> {
    handle Slice::subslice(
        Vec::as_slice(&value.edges),
        usize_from_u32(range.start),
        usize_from_u32(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

slice_handle_arms<'a>(
    value: &'a ParsedBody,
    range: HandleArmRange
) -> Slice<'a, HandleArm> {
    handle Slice::subslice(
        Vec::as_slice(&value.handle_arms),
        usize_from_u32(range.start),
        usize_from_u32(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub expression_handle_arms<'a>(
    value: &'a ParsedBody,
    expression: u32
) -> Slice<'a, HandleArm> {
    let node = arena_node_at_raw(&value.nodes, expression);
    handle node.kind {
        ExprKind::Handle(_, range) => slice_handle_arms(value, range),
        _ => slice_handle_arms(value, super::syntax::empty_id_range(0))
    }
}

pub handle_arm_count(value: &ParsedBody) -> usize {
    Vec::len(&value.handle_arms)
}

pub expression_handle_arm_id(
    value: &ParsedBody,
    expression: u32,
    ordinal: usize
) -> HandleArmId {
    let node = arena_node_at_raw(&value.nodes, expression);
    handle node.kind {
        ExprKind::Handle(_, range) =>
            Id::from_u32(range.start + u32_from_usize(ordinal)),
        _ => unreachable()
    }
}

pub handle_arm_enum_name(value: &HandleArm) -> Id<String> {
    value.enum_name
}

pub handle_arm_enum_token(value: &HandleArm) -> usize {
    value.enum_token
}

pub handle_arm_variant_name(value: &HandleArm) -> Id<String> {
    value.variant_name
}

pub handle_arm_variant_token(value: &HandleArm) -> usize {
    value.variant_token
}

pub handle_arm_body(value: &HandleArm) -> ExprId { value.body }

closure_parameters<'a>(
    value: &'a ParsedBody,
    range: ClosureParameterRange
) -> Slice<'a, ClosureParameter> {
    handle Slice::subslice(
        Vec::as_slice(&value.closure_parameters),
        usize_from_u32(range.start),
        usize_from_u32(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub handle_arm_binders<'a>(
    body: &'a ParsedBody,
    value: &HandleArm
) -> Slice<'a, PatternBinder> {
    handle Slice::subslice(
        Vec::as_slice(&body.pattern_binders),
        usize_from_u32(value.binders.start),
        usize_from_u32(value.binders.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub expression_edge_value(value: &ExprEdge) -> ExprId {
    value.value
}

pub expression_edge_metadata(value: &ExprEdge) -> u32 {
    handle value.kind {
        ExprEdgeKind::Argument => 0,
        ExprEdgeKind::Element(ordinal) => ordinal,
        ExprEdgeKind::ConstructionField(ordinal) => ordinal,
        ExprEdgeKind::Let(token) => u32_from_usize(token),
        ExprEdgeKind::Statement => 0
    }
}

pub block_statement_view(value: &ExprEdge) -> BlockStatementView {
    handle value.kind {
        ExprEdgeKind::Let(token) => BlockStatementView::Let(
            value.value,
            token
        ),
        ExprEdgeKind::Statement => BlockStatementView::Expression(value.value),
        _ => unreachable()
    }
}

// Transitional scalar accessors remain for elaboration's ordinal-sensitive
// walks. Serialization and resolution consume the borrowed view directly.
pub expression_child_count_at(
    value: &ParsedBody,
    expression: u32
) -> u32 {
    handle expression_view(value, expression) {
        BodyExpressionView::Identifier(_) => 0,
        BodyExpressionView::Number(_) => 0,
        BodyExpressionView::Is(_, _) => 1,
        BodyExpressionView::Unit(_) => 0,
        BodyExpressionView::Grouping(_) => 1,
        BodyExpressionView::Move(_) => 1,
        BodyExpressionView::Prefix(_, _) => 1,
        BodyExpressionView::Infix(_, _, _) => 2,
        BodyExpressionView::Call(_, arguments) =>
            u32_from_usize(Slice::len(arguments)) + 1,
        BodyExpressionView::Perform(_, arguments) =>
            u32_from_usize(Slice::len(arguments)),
        BodyExpressionView::Block(children) =>
            u32_from_usize(Slice::len(children)),
        BodyExpressionView::Tuple(children) =>
            u32_from_usize(Slice::len(children)),
        BodyExpressionView::Construction(_, children) =>
            u32_from_usize(Slice::len(children)),
        BodyExpressionView::Projection(_, _) => 1,
        BodyExpressionView::Closure(_, _) => 1,
        BodyExpressionView::Handle(_, arms) =>
            u32_from_usize(Slice::len(arms)) + 1
    }
}

pub expression_child_at(
    value: &ParsedBody,
    expression: u32,
    child: u32
) -> u32 {
    handle expression_view(value, expression) {
        BodyExpressionView::Is(subject, _) => Id::to_u32(subject),
        BodyExpressionView::Grouping(found) => Id::to_u32(found),
        BodyExpressionView::Move(found) => Id::to_u32(found),
        BodyExpressionView::Prefix(_, found) => Id::to_u32(found),
        BodyExpressionView::Infix(_, left, right) =>
            if(child == 0) { Id::to_u32(left) } else { Id::to_u32(right) },
        BodyExpressionView::Call(callee, arguments) => if(child == 0) {
            Id::to_u32(callee)
        } else {
            Id::to_u32(expression_edge_value(edge_in_slice(
                arguments,
                usize_from_u32(child - 1)
            )))
        },
        BodyExpressionView::Perform(_, arguments) =>
            Id::to_u32(expression_edge_value(edge_in_slice(
                arguments,
                usize_from_u32(child)
            ))),
        BodyExpressionView::Block(children) =>
            Id::to_u32(expression_edge_value(edge_in_slice(
                children,
                usize_from_u32(child)
            ))),
        BodyExpressionView::Tuple(children) =>
            Id::to_u32(expression_edge_value(edge_in_slice(
                children,
                usize_from_u32(child)
            ))),
        BodyExpressionView::Construction(_, children) =>
            Id::to_u32(expression_edge_value(edge_in_slice(
                children,
                usize_from_u32(child)
            ))),
        BodyExpressionView::Projection(subject, _) => Id::to_u32(subject),
        BodyExpressionView::Closure(_, body) => Id::to_u32(body),
        BodyExpressionView::Handle(subject, arms) => if(child == 0) {
            Id::to_u32(subject)
        } else {
            Id::to_u32(handle_arm_body(handle Slice::get(
                arms,
                usize_from_u32(child - 1)
            ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }))
        },
        _ => unreachable()
    }
}

edge_in_slice<'a>(
    value: Slice<'a, ExprEdge>,
    index: usize
) -> &'a ExprEdge {
    handle Slice::get(value, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

expression_name_view(
    value: &ParsedBody,
    node: &ExprNode,
    ordinal: u32
) -> ExpressionNameView {
    let at = node_name_range(node).start + ordinal;
    handle *Vec::index(&value.names, usize_from_u32(at)) {
        ExpressionName::Identifier(name, token) =>
            ExpressionNameView::Identifier(name, token),
        ExpressionName::TupleField(field, token) =>
            ExpressionNameView::TupleField(field, token)
    }
}

pub expression_name_view_at(
    value: &ParsedBody,
    expression: u32,
    ordinal: u32
) -> ExpressionNameView {
    expression_name_view(
        value,
        arena_node_at_raw(&value.nodes, expression),
        ordinal
    )
}

pattern_alloc(value: &mut BodyParser, node: PatternNode) -> PatternId {
    handle Arena::alloc(&mut value.patterns, node) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub pattern_token_start(value: &ParsedBody, pattern: PatternId) -> usize {
    Arena::index(&value.patterns, pattern).tokens.start
}

pub pattern_token_end(value: &ParsedBody, pattern: PatternId) -> usize {
    Arena::index(&value.patterns, pattern).tokens.end
}

pub pattern_view(value: &ParsedBody, pattern: PatternId) -> PatternView {
    let node = Arena::index(&value.patterns, pattern);
    handle node.kind {
        PatternKind::Integer(token) => PatternView::Integer(token),
        PatternKind::Float(token) => PatternView::Float(token),
        PatternKind::Text(name, token) => PatternView::Text(name, token),
        PatternKind::Character(found, token) =>
            PatternView::Character(found, token),
        PatternKind::Byte(found, token) => PatternView::Byte(found, token),
        PatternKind::Unit(token) => PatternView::Unit(token)
    }
}

pub expression_view<'a>(
    value: &'a ParsedBody,
    expression: u32
) -> BodyExpressionView<'a> {
    let node = arena_node_at_raw(&value.nodes, expression);
    handle node.kind {
        ExprKind::Identifier(_) => BodyExpressionView::Identifier(node.tokens),
        ExprKind::Number => BodyExpressionView::Number(node.tokens),
        ExprKind::Is(subject, pattern) => BodyExpressionView::Is(
            subject,
            pattern
        ),
        ExprKind::Unit => BodyExpressionView::Unit(node.tokens),
        ExprKind::Grouping(child) => BodyExpressionView::Grouping(child),
        ExprKind::Move(child) => BodyExpressionView::Move(child),
        ExprKind::Prefix(operator, child) =>
            BodyExpressionView::Prefix(operator, child),
        ExprKind::Infix(operator, left, right) =>
            BodyExpressionView::Infix(operator, left, right),
        ExprKind::Call(callee, arguments) => BodyExpressionView::Call(
            callee,
            expression_edges(value, arguments)
        ),
        ExprKind::Perform(path, arguments) => BodyExpressionView::Perform(
            path,
            expression_edges(value, arguments)
        ),
        ExprKind::Block(children) =>
            BodyExpressionView::Block(expression_edges(value, children)),
        ExprKind::Tuple(children) =>
            BodyExpressionView::Tuple(expression_edges(value, children)),
        ExprKind::Construction(_, children) => BodyExpressionView::Construction(
            expression_name_view(value, node, 0),
            expression_edges(value, children)
        ),
        ExprKind::Projection(subject, _) => BodyExpressionView::Projection(
            subject,
            expression_name_view(value, node, 0)
        ),
        ExprKind::Closure(parameters, body) => BodyExpressionView::Closure(
            closure_parameters(value, parameters),
            body
        ),
        ExprKind::Handle(subject, arms) => BodyExpressionView::Handle(
            subject,
            slice_handle_arms(value, arms)
        )
    }
}

token_range(start: usize, end: usize) -> BodyTokenRange {
    super::syntax::token_span(start, end)
}

name_range(start: usize, end: usize) -> ExpressionNameRange {
    super::syntax::id_range(start, end)
}

edge_range(start: usize, end: usize) -> ExprEdgeRange {
    super::syntax::id_range(start, end)
}

binder_range(start: usize, end: usize) -> PatternBinderRange {
    super::syntax::id_range(start, end)
}

handle_arm_range(start: usize, end: usize) -> HandleArmRange {
    super::syntax::id_range(start, end)
}

at_token(
    value: &BodyParser,
    source: &super::lexer::LexedSource,
    pattern: TokenPattern
) -> Bool {
    let tokens = &value.tokens;
    super::syntax::cursor_at(tokens, source, pattern)
}

token_is_contextual_ident(
    source: &super::lexer::LexedSource,
    token: usize,
    expected: &String
) -> Bool {
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => handle super::lexer::lexeme(source, name) {
            None => false,
            Option::Some(found) => String::eq(found, expected)
        },
        _ => false
    }
}

eat_token(
    value: &mut BodyParser,
    source: &super::lexer::LexedSource,
    pattern: TokenPattern
) -> Bool {
    let tokens = &mut value.tokens;
    super::syntax::cursor_eat(tokens, source, pattern)
}

push_name(value: &mut Vec<ExpressionName>, name: ExpressionName) {
    Vec::push(&mut *value, name)
}

pop_operator(value: &mut Vec<OperatorUse>) -> OperatorUse {
    handle Vec::pop(&mut *value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pop_expr(value: &mut Vec<ExprId>) -> ExprId {
    handle Vec::pop(&mut *value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

last_operator(value: &Vec<OperatorUse>) -> OperatorUse {
    *Vec::index(value, Vec::len(value) - 1)
}

last_expr(value: &Vec<ExprId>) -> ExprId {
    *Vec::index(value, Vec::len(value) - 1)
}

source_text(value: &String, start: usize, end: usize) -> String {
    handle String::slice(value, Range { start: start, end: end }) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) =>  found
    }
}

token_span(
    source: &super::lexer::LexedSource,
    index: usize
) -> super::lexer::Span {
    handle super::lexer::token_at(source, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::lexer::token_span(token)
    }
}

range_text(
    original: &String,
    source: &super::lexer::LexedSource,
    start: usize,
    end: usize
) -> String {
    let first = token_span(source, start);
    let last = token_span(source, end - 1);
    source_text(
        original,
        super::lexer::span_start(&first),
        super::lexer::span_end(&last)
    )
}

node_tokens(value: &BodyParser, id: ExprId) -> BodyTokenRange {
    let node = Arena::index(&value.nodes, id);
    node.tokens
}

node_is_identifier(value: &BodyParser, id: ExprId) -> Bool {
    Arena::index(&value.nodes, id).kind is ExprKind::Identifier(_)
}

push_node(
    value: &mut BodyParser,
    kind: ExprKind,
    tokens: BodyTokenRange
) -> ExprId {
    alloc_node(
        &mut value.nodes,
        ExprNode { kind: kind, tokens: tokens }
    )
}

push_leaf(
    value: &mut BodyParser,
    kind: ExprKind,
    start: usize,
    end: usize
) -> ExprId {
    push_node(value, kind, token_range(start, end))
}

parse_scalar_pattern(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    related: usize
) -> Result<PatternId, BodyError> {
    let start = value.tokens.position;
    if(start >= value.tokens.limit) {
        Result::Err(BodyError::ExpectedPattern(start, related))
    } else {
        handle super::lexer::token_kind_at(source, start) {
            TokenKind::Number(number) => {
                value.tokens.position = start + 1;
                let kind = if(super::lexer::number_is_float(&number)) {
                    PatternKind::Float(start)
                } else { PatternKind::Integer(start) };
                Result::Ok(pattern_alloc(value, PatternNode {
                    kind: kind,
                    tokens: token_range(start, value.tokens.position)
                }))
            },
            TokenKind::String(name) => {
                value.tokens.position = start + 1;
                Result::Ok(pattern_alloc(value, PatternNode {
                    kind: PatternKind::Text(name, start),
                    tokens: token_range(start, value.tokens.position)
                }))
            },
            TokenKind::Char(found) => {
                value.tokens.position = start + 1;
                Result::Ok(pattern_alloc(value, PatternNode {
                    kind: PatternKind::Character(found, start),
                    tokens: token_range(start, value.tokens.position)
                }))
            },
            TokenKind::Byte(found) => {
                value.tokens.position = start + 1;
                Result::Ok(pattern_alloc(value, PatternNode {
                    kind: PatternKind::Byte(found, start),
                    tokens: token_range(start, value.tokens.position)
                }))
            },
            TokenKind::LParen => if(start + 1 < value.tokens.limit
                and { super::lexer::token_matches_at(
                    source, start + 1, TokenPattern::RParen
                ) }) {
                value.tokens.position = start + 2;
                Result::Ok(pattern_alloc(value, PatternNode {
                    kind: PatternKind::Unit(start),
                    tokens: token_range(start, value.tokens.position)
                }))
            } else {
                Result::Err(BodyError::ExpectedPattern(start, related))
            },
            _ => Result::Err(BodyError::ExpectedPattern(start, related))
        }
    }
}

push_pattern_test(
    value: &mut BodyParser,
    subject: ExprId,
    pattern: PatternId,
    start: usize,
    end: usize
) -> ExprId {
    push_node(value, ExprKind::Is(subject, pattern), token_range(start, end))
}

push_identifier(
    value: &mut BodyParser,
    start: usize,
    end: usize,
    name_start: usize
) -> ExprId {
    let name_end = Vec::len(&value.names);
    push_node(
        value,
        ExprKind::Identifier(name_range(
            name_start,
            name_end
        )),
        token_range(start, end)
    )
}

node_name_at(
    value: &BodyParser,
    id: ExprId,
    ordinal: u32
) -> &ExpressionName {
    let node = Arena::index(&value.nodes, id);
    let names = node_name_range(node);
    Vec::index(
        &value.names,
        usize_from_u32(names.start + ordinal)
    )
}

node_name_count(value: &BodyParser, id: ExprId) -> u32 {
    node_name_range(Arena::index(&value.nodes, id)).count
}

push_prefix(
    value: &mut BodyParser,
    operator: OperatorUse,
    child: ExprId,
    start: usize,
    end: usize
) -> ExprId {
    push_node(
        value,
        ExprKind::Prefix(token_range(operator.start, operator.end), child),
        token_range(start, end)
    )
}

push_grouping(
    value: &mut BodyParser,
    child: ExprId,
    start: usize,
    end: usize
) -> ExprId {
    push_node(value, ExprKind::Grouping(child), token_range(start, end))
}

push_move(
    value: &mut BodyParser,
    child: ExprId,
    start: usize,
    end: usize
) -> ExprId {
    push_node(value, ExprKind::Move(child), token_range(start, end))
}

push_binary(
    value: &mut BodyParser,
    operator: OperatorUse,
    left: ExprId,
    right: ExprId
) -> ExprId {
    let start = node_tokens(&*value, left).start;
    let end = node_tokens(&*value, right).end;
    push_node(
        value,
        ExprKind::Infix(
            token_range(operator.start, operator.end),
            left,
            right
        ),
        token_range(start, end)
    )
}

push_argument_edges(
    value: &mut BodyParser,
    arguments: &Vec<ExprId>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(arguments)), { current =>
        Vec::push(
            &mut value.edges,
            ExprEdge {
                value: *Vec::index(arguments, current),
                kind: ExprEdgeKind::Argument
            }
        )
    })
}

push_call(
    value: &mut BodyParser,
    callee: ExprId,
    arguments: &Vec<ExprId>,
    start: usize,
    end: usize
) -> ExprId {
    let edge_start = super::syntax::range_mark(&value.edges);
    push_argument_edges(value, arguments, 0);
    let edge_end = Vec::len(&value.edges);
    let edges = edge_range(edge_start, edge_end);
    push_node(
        value,
        ExprKind::Call(callee, edges),
        token_range(start, end)
    )
}

effect_name_is_declared(
    declarations: &super::scanner::DeclarationIndex,
    name: Id<String>,
    module: Option<ShellId>
) -> Bool {
    let local = super::scanner::def_search(
        declarations, module, name, super::scanner::Namespace::Type
    );
    let found = if(super::scanner::def_search_count(&local) == 0
        and { Option::is_some(&module) }) {
        super::scanner::def_search(
            declarations, None, name, super::scanner::Namespace::Type
        )
    } else { local };
    if(super::scanner::def_search_count(&found) == 1) {
        handle super::scanner::def_search_first(&found) {
            None => false,
            Option::Some(shell) => handle super::scanner::shell_at(
                declarations, shell
            ) {
                None => false,
                Option::Some(declaration) => super::scanner::shell_kind(
                    declaration
                ) is super::scanner::DeclarationKind::Effect
            }
        }
    } else { false }
}

implicit_effect_operation(
    declarations: &super::scanner::DeclarationIndex,
    value: &mut BodyParser,
    callee: ExprId,
    module: Option<ShellId>
) -> Option<EffectOperationSyntax> {
    let node = Arena::index(&value.nodes, callee);
    let callee_tokens = node.tokens;
    let names = handle node.kind {
        ExprKind::Identifier(found) => found,
        _ => @implicit_effect_operation(None)
    };
    if(names.count == 2) {
        let owner = *Vec::index(
            &value.names, usize_from_u32(names.start)
        );
        let member = *Vec::index(
            &value.names, usize_from_u32(names.start + 1)
        );
        handle (owner, member) {
            (
                ExpressionName::Identifier(effect_name, effect_token),
                ExpressionName::Identifier(operation_name, operation_token)
            ) => if(effect_name_is_declared(
                declarations, effect_name, module
            )) {
                let effect_type = alloc_body_type(value, BodyTypeNode {
                    kind: BodyTypeKind::Path(effect_name, effect_token),
                    // Bootstrap normalization synthesizes this sidecar from
                    // the complete qualified callee rather than reparsing an
                    // explicit type path, so preserve that compatibility span.
                    tokens: callee_tokens
                });
                Option::Some(EffectOperationSyntax {
                    effect_name: effect_name,
                    effect_token: effect_token,
                    effect_type: effect_type,
                    operation_name: operation_name,
                    operation_token: operation_token
                })
            } else { None },
            _ => None
        }
    } else { None }
}

push_call_or_perform(
    declarations: &super::scanner::DeclarationIndex,
    value: &mut BodyParser,
    module: Option<ShellId>,
    callee: ExprId,
    arguments: &Vec<ExprId>,
    start: usize,
    end: usize
) -> ExprId {
    handle implicit_effect_operation(
        declarations, value, callee, module
    ) {
        None => push_call(value, callee, arguments, start, end),
        Option::Some(path) => push_perform(
            value, path, arguments, start, end
        )
    }
}

push_perform(
    value: &mut BodyParser,
    path: EffectOperationSyntax,
    arguments: &Vec<ExprId>,
    start: usize,
    end: usize
) -> ExprId {
    let edge_start = super::syntax::range_mark(&value.edges);
    push_argument_edges(value, arguments, 0);
    let edge_end = Vec::len(&value.edges);
    push_node(
        value,
        ExprKind::Perform(path, edge_range(edge_start, edge_end)),
        token_range(start, end)
    )
}

push_expression_edges(
    value: &mut BodyParser,
    expressions: &Vec<ExprId>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(expressions)), { current =>
        Vec::push(
            &mut value.edges,
            ExprEdge {
                value: *Vec::index(expressions, current),
                kind: ExprEdgeKind::Element(u32_from_usize(current))
            }
        )
    })
}

push_tuple(
    value: &mut BodyParser,
    elements: &Vec<ExprId>,
    start: usize,
    end: usize
) -> ExprId {
    let edge_start = super::syntax::range_mark(&value.edges);
    push_expression_edges(value, elements, 0);
    let edge_end = Vec::len(&value.edges);
    let edges = edge_range(edge_start, edge_end);
    push_node(
        value,
        ExprKind::Tuple(edges),
        token_range(start, end)
    )
}

push_struct_fields(
    value: &mut BodyParser,
    fields: &Vec<PendingField>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(fields)), { current => {
        let field = Vec::index(fields, current);
        push_name(&mut value.names, ExpressionName::Identifier(
            field.name,
            field.name_token
        ));
        Vec::push(
            &mut value.edges,
            ExprEdge {
                value: field.expression,
                // Name zero is the constructed nominal.
                kind: ExprEdgeKind::ConstructionField(
                    u32_from_usize(current) + 1
                )
            }
        )
    } })
}

push_struct(
    value: &mut BodyParser,
    constructor: ExprId,
    fields: &Vec<PendingField>,
    start: usize,
    end: usize
) -> ExprId {
    let name_start = super::syntax::range_mark(&value.names);
    let constructor_name = *node_name_at(&*value, constructor, 0);
    push_name(&mut value.names, constructor_name);
    let edge_start = super::syntax::range_mark(&value.edges);
    push_struct_fields(value, fields, 0);
    let name_end = Vec::len(&value.names);
    let edge_end = Vec::len(&value.edges);
    let names = name_range(name_start, name_end);
    let edges = edge_range(edge_start, edge_end);
    push_node(
        value,
        ExprKind::Construction(names, edges),
        token_range(start, end)
    )
}

push_projection(
    value: &mut BodyParser,
    subject: ExprId,
    name: ExpressionName,
    end: usize
) -> ExprId {
    let start = node_tokens(&*value, subject).start;
    let name_start = super::syntax::range_mark(&value.names);
    push_name(&mut value.names, name);
    let name_end = Vec::len(&value.names);
    let names = name_range(name_start, name_end);
    push_node(
        value,
        ExprKind::Projection(subject, names),
        token_range(start, end)
    )
}

push_statement_edges(
    value: &mut BodyParser,
    statements: &Vec<PendingStatement>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(statements)), { current => {
        let statement = Vec::index(statements, current);
        handle *statement {
            PendingStatement::Let(token, expression) => Vec::push(
                &mut value.edges,
                ExprEdge {
                    value: expression,
                    kind: ExprEdgeKind::Let(token)
                }
            ),
            PendingStatement::Expression(expression) => Vec::push(
                &mut value.edges,
                ExprEdge {
                    value: expression,
                    kind: ExprEdgeKind::Statement
                }
            )
        }
    } })
}

push_block(
    value: &mut BodyParser,
    statements: &Vec<PendingStatement>,
    start: usize,
    end: usize
) -> ExprId {
    let edge_start = super::syntax::range_mark(&value.edges);
    push_statement_edges(value, statements, 0);
    let edge_end = Vec::len(&value.edges);
    let edges = edge_range(edge_start, edge_end);
    push_node(
        value,
        ExprKind::Block(edges),
        token_range(start, end)
    )
}

shell_owner(
    declarations: &super::scanner::DeclarationIndex,
    shell: ShellId
) -> Option<ShellId> {
    handle super::scanner::shell_at(declarations, shell) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(found) => *super::scanner::shell_parent(found)
    }
}

operator_range(
    source: &super::lexer::LexedSource,
    cursor: usize,
    limit: usize
) -> Option<BodyTokenRange> {
    if(cursor < limit) {
        if(super::lexer::token_matches_at(
            source,
            cursor,
            TokenPattern::Ident
        )) {
            Result::Ok(
                token_range(cursor, cursor + 1)
            )
        } else {
            if(super::lexer::operator_symbol_at(
                source,
                cursor
            )) {
                let first = token_span(source, cursor);
                let end = super::lexer::operator_end(
                    source,
                    cursor + 1,
                    limit,
                    super::lexer::span_end(&first)
                );
                Result::Ok(token_range(cursor, end))
            } else {
                Result::Err(())
            }
        }
    } else {
        Result::Err(())
    }
}

lookup_fixity_scope(
    original: &String,
    source: &super::lexer::LexedSource,
    nominal: &super::headers::NominalIndex,
    operator: &BodyTokenRange,
    prefix: Bool,
    owner: Option<ShellId>
) -> Result<Option<u32>, BodyError> {
    let spelling = range_text(
        original,
        source,
        operator.start,
        operator.end
    );
    handle super::lexer::lexeme_id(source, &spelling) {
        None => Result::Ok(None),
        Option::Some(name) => handle super::headers::fixity_search(
            nominal,
            owner,
            name,
            prefix
        ) {
            None => Result::Ok(None),
            Option::Some(found) => {
                let selected =
                    super::headers::fixity_search_selected(&found);
                handle super::headers::fixity_search_conflict(&found) {
                    None => Result::Ok(Option::Some(Id::to_u32(selected))),
                    Option::Some(_) => Result::Err(
                        BodyError::ConflictingFixity(
                            operator.start,
                            super::headers::fixity_operator_start_at(
                                nominal,
                                Id::to_usize(selected)
                            )
                        )
                    )
                }
            }
        }
    }
}

lookup_fixity(
    original: &String,
    source: &super::lexer::LexedSource,
    nominal: &super::headers::NominalIndex,
    operator: &BodyTokenRange,
    prefix: Bool,
    owner: Option<ShellId>
) -> Result<Option<u32>, BodyError> {
    let found = try(
        lookup_fixity_scope(
            original,
            source,
            nominal,
            operator,
            prefix,
            owner
        ),
        @lookup_fixity
    );
    handle found {
        Result::Ok(index) => Result::Ok(Result::Ok(index)),
        Result::Err(_) => if(Option::is_none(&owner)) {
            Result::Ok(Result::Err(()))
        } else {
            lookup_fixity_scope(
                original,
                source,
                nominal,
                operator,
                prefix,
                Result::Err(())
            )
        }
    }
}

peek_operator(
    original: &String,
    source: &super::lexer::LexedSource,
    nominal: &super::headers::NominalIndex,
    value: &BodyParser,
    prefix: Bool,
    owner: Option<ShellId>
) -> Result<Option<OperatorUse>, BodyError> {
    handle operator_range(source, value.tokens.position, value.tokens.limit) {
        Result::Err(_) => Result::Ok(Result::Err(())),
        Result::Ok(range) => {
            let found = try(
                lookup_fixity(
                    original,
                    source,
                    nominal,
                    &range,
                    prefix,
                    owner
                ),
                @peek_operator
            );
            handle found {
                Result::Err(_) => Result::Ok(Result::Err(())),
                Result::Ok(index) => {
                    let header_index = usize_from_u32(index);
                    Result::Ok(Result::Ok(OperatorUse {
                        fixity: index,
                        start: range.start,
                        end: range.end,
                        form: super::headers::fixity_form_at(
                            nominal,
                            header_index
                        ),
                        precedence: super::headers::fixity_precedence_at(
                            nominal,
                            header_index
                        )
                    }))
                }
            }
        }
    }
}

parse_primary(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16
) -> Result<ExprId, BodyError> {
    if(depth < 128) {
        let start = value.tokens.position;
        if(token_is_contextual_ident(source, start, &"move")) {
            value.tokens.position = start + 1;
            let child = try(parse_primary(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth + 1
            ), @parse_primary);
            Result::Ok(push_move(
                value,
                child,
                start,
                node_tokens(&*value, child).end
            ))
        } else {
            let prefix = try(
                peek_operator(
                    original,
                    source,
                    nominal,
                    &*value,
                    true,
                    owner
                ),
                @parse_primary
            );
            handle prefix {
                Result::Ok(operator) => {
                    value.tokens.position = operator.end;
                    let child = try(
                        parse_expression(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            operator.precedence,
                            depth + 1
                        ),
                        @parse_primary
                    );
                    let end = node_tokens(&*value, child).end;
                    Result::Ok(push_prefix(
                        value,
                        operator,
                        child,
                        operator.start,
                        end
                    ))
                },
                Result::Err(_) => {
                    let atom = try(
                        parse_atom(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            depth
                        ),
                        @parse_primary
                    );
                    parse_postfix(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth,
                        atom
                    )
                }
            }
        }
    } else {
        Result::Err(BodyError::ExpressionDepthLimit(
            value.tokens.position,
            value.tokens.position
        ))
    }
}

push_identifier_name(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    token: usize,
    related: usize
) -> Result<(), BodyError> {
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => {
            push_name(
                &mut value.names,
                ExpressionName::Identifier(name, token)
            );
            Result::Ok(())
        },
        _ => Result::Err(BodyError::ExpectedIdentifier(token, related))
    }
}

parse_identifier_tail(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    start: usize,
    name_start: usize
) -> Result<ExprId, BodyError> {
    if(value.tokens.position < value.tokens.limit) {
        if(at_token(&*value, source, TokenPattern::DoubleColon)) {
            let separator = value.tokens.position;
                let token = separator + 1;
                if(token < value.tokens.limit) {
                    try(
                            push_identifier_name(
                                source,
                                value,
                                token,
                                separator
                            ),
                            @parse_identifier_tail
                        );
                        value.tokens.position = token + 1;
                        parse_identifier_tail(
                            source,
                            value,
                            start,
                            name_start
                        )
                } else {
                    Result::Err(
                        BodyError::ExpectedIdentifier(token, separator)
                    )
                }
        } else {
            Result::Ok(push_identifier(
                value,
                start,
                value.tokens.position,
                name_start
            ))
        }
    } else {
        Result::Ok(push_identifier(
            value,
            start,
            value.tokens.position,
            name_start
        ))
    }
}

parse_identifier(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    start: usize
) -> Result<ExprId, BodyError> {
    let name_start = super::syntax::range_mark(&value.names);
    try(
        push_identifier_name(source, value, start, start),
        @parse_identifier
    );
    value.tokens.position = start + 1;
    parse_identifier_tail(source, value, start, name_start)
}

parse_tuple_tail(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize,
    elements: &mut Vec<ExprId>
) -> Result<ExprId, BodyError> {
    if(value.tokens.position < value.tokens.limit) {
        if(eat_token(value, source, TokenPattern::RParen)) {
            Result::Ok(push_tuple(
                value,
                &*elements,
                start,
                value.tokens.position
            ))
        } else {
            let element = try(
                parse_expression(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    0,
                    depth
                ),
                @parse_tuple_tail
            );
            Vec::push(&mut *elements, element);
            if(value.tokens.position < value.tokens.limit) {
                handle super::lexer::token_kind_at(
                    source,
                    value.tokens.position
                ) {
                    TokenKind::RParen => {
                        value.tokens.position = value.tokens.position + 1;
                        Result::Ok(push_tuple(
                            value,
                            &*elements,
                            start,
                            value.tokens.position
                        ))
                    },
                    TokenKind::Comma => {
                        value.tokens.position = value.tokens.position + 1;
                        parse_tuple_tail(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            depth,
                            start,
                            elements
                        )
                    },
                    _ => Result::Err(
                        BodyError::ExpectedTupleDelimiter(
                            value.tokens.position,
                            start
                        )
                    )
                }
            } else {
                Result::Err(
                    BodyError::ExpectedTupleDelimiter(value.tokens.position, start)
                )
            }
        }
    } else {
        Result::Err(
            BodyError::ExpectedTupleDelimiter(value.tokens.position, start)
        )
    }
}

pattern_binder_named(
    value: &Vec<PatternBinder>,
    name: Id<String>,
    index: usize
) -> Bool {
    if(index < Vec::len(value)) {
        handle *Vec::index(value, index) {
            PatternBinder::Wildcard(_) =>
                pattern_binder_named(value, name, index + 1),
            PatternBinder::Integer(_) =>
                pattern_binder_named(value, name, index + 1),
            PatternBinder::Binding(found, _) =>
                if(found == name) {
                    true
                } else {
                    pattern_binder_named(value, name, index + 1)
                }
        }
    } else { false }
}

parse_pattern_binder(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    binders: &mut Vec<PatternBinder>,
    related: usize
) -> Result<(), BodyError> {
    let token = value.tokens.position;
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => handle super::lexer::lexeme(source, name) {
            Result::Err(_) =>
                Result::Err(BodyError::ExpectedIdentifier(token, related)),
            Result::Ok(text) => {
                if(String::eq(text, &"_")) {
                    Vec::push(
                        &mut *binders,
                        PatternBinder::Wildcard(token)
                    );
                    value.tokens.position = token + 1;
                    Result::Ok(())
                } else {
                    if(pattern_binder_named(&*binders, name, 0)) {
                        Result::Err(
                            BodyError::DuplicatePatternBinder(token, related)
                        )
                    } else {
                        Vec::push(
                            &mut *binders,
                            PatternBinder::Binding(name, token)
                        );
                        value.tokens.position = token + 1;
                        Result::Ok(())
                    }
                }
            }
        },
        TokenKind::Number(number) => if(super::lexer::number_is_float(&number)) {
            Result::Err(BodyError::ExpectedIdentifier(token, related))
        } else {
            Vec::push(&mut *binders, PatternBinder::Integer(token));
            value.tokens.position = token + 1;
            Result::Ok(())
        },
        _ => Result::Err(BodyError::ExpectedIdentifier(token, related))
    }
}

parse_pattern_binders(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    binders: &mut Vec<PatternBinder>,
    open: usize
) -> Result<(), BodyError> {
    if(value.tokens.position < value.tokens.limit) {
        if(eat_token(value, source, TokenPattern::RParen)) {
            Result::Ok(())
        } else {
            try(parse_pattern_binder(
                source,
                value,
                binders,
                open
            ), @parse_pattern_binders);
            if(value.tokens.position < value.tokens.limit) {
                handle super::lexer::token_kind_at(
                    source,
                    value.tokens.position
                ) {
                    TokenKind::RParen => {
                        value.tokens.position = value.tokens.position + 1;
                        Result::Ok(())
                    },
                    TokenKind::Comma => {
                        value.tokens.position = value.tokens.position + 1;
                        parse_pattern_binders(
                            source,
                            value,
                            binders,
                            open
                        )
                    },
                    _ => Result::Err(BodyError::ExpectedCallClose(
                        value.tokens.position,
                        open
                    ))
                }
            } else {
                Result::Err(BodyError::ExpectedCallClose(
                    value.tokens.position,
                    open
                ))
            }
        }
    } else {
        Result::Err(BodyError::ExpectedCallClose(value.tokens.position, open))
    }
}

identifier_name(
    source: &super::lexer::LexedSource,
    token: usize,
    related: usize
) -> Result<Id<String>, BodyError> {
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => Result::Ok(name),
        _ => Result::Err(BodyError::ExpectedIdentifier(token, related))
    }
}

body_type_range(start: usize, end: usize) -> BodyTypeRange {
    super::syntax::id_range(start, end)
}

alloc_body_type(value: &mut BodyParser, node: BodyTypeNode) -> BodyTypeId {
    handle Arena::alloc(&mut value.types, node) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

parse_body_type(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    related: usize
) -> Result<BodyTypeId, BodyError> {
    let start = value.tokens.position;
    let name = try(identifier_name(source, start, related), @parse_body_type);
    value.tokens.position = start + 1;
    let path = alloc_body_type(value, BodyTypeNode {
        kind: BodyTypeKind::Path(name, start),
        tokens: token_range(start, start + 1)
    });
    if(eat_token(value, source, TokenPattern::Lt)) {
        if(value.tokens.position >= value.tokens.limit or {
            super::lexer::token_matches_at(
                source, value.tokens.position, TokenPattern::Gt
            )
        }) {
            @parse_body_type(Result::Err(BodyError::ExpectedIdentifier(
                value.tokens.position, start
            )))
        } else { () };
        let parsed_arguments = Vec::new();
        try(parse_body_type_arguments(
            source, value, start, &mut parsed_arguments
        ), @parse_body_type);
        let argument_start = super::syntax::range_mark(&value.type_arguments);
        for_range(Range::new(0, Vec::len(&parsed_arguments)), { index =>
            Vec::push(
                &mut value.type_arguments,
                *Vec::index(&parsed_arguments, index)
            )
        });
        if(not(eat_token(value, source, TokenPattern::Gt))) {
            @parse_body_type(Result::Err(BodyError::ExpectedGroupingClose(
                value.tokens.position, start
            )))
        } else { () };
        let argument_end = Vec::len(&value.type_arguments);
        Result::Ok(alloc_body_type(value, BodyTypeNode {
            kind: BodyTypeKind::Application(
                path, body_type_range(argument_start, argument_end)
            ),
            tokens: token_range(start, value.tokens.position)
        }))
    } else { Result::Ok(path) }
}

parse_body_type_arguments(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    related: usize,
    output: &mut Vec<BodyTypeId>
) -> Result<(), BodyError> {
    let argument = try(parse_body_type(source, value, related), @parse_body_type_arguments);
    Vec::push(&mut *output, argument);
    if(eat_token(value, source, TokenPattern::Comma)) {
        if(value.tokens.position < value.tokens.limit and {
            super::lexer::token_matches_at(
                source, value.tokens.position, TokenPattern::Gt
            )
        }) {
            Result::Ok(())
        } else {
            parse_body_type_arguments(source, value, related, output)
        }
    } else { Result::Ok(()) }
}

parse_handle_arm(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16
) -> Result<PendingHandleArm, BodyError> {
    let enum_token = value.tokens.position;
    let owner_type = try(parse_body_type(
        source, value, enum_token
    ), @parse_handle_arm);
    let enum_name = try(identifier_name(source, enum_token, enum_token), @parse_handle_arm);
    let effect_type = if(effect_name_is_declared(
        declarations, enum_name, owner
    )) { Option::Some(owner_type) } else { None };
    let separator = value.tokens.position;
    if(separator < value.tokens.limit
        and {
            super::lexer::token_matches_at(
                source,
                separator,
                TokenPattern::DoubleColon
            )
        }) {
        let variant_token = separator + 1;
        if(variant_token < value.tokens.limit) {
            let variant_name = try(identifier_name(
                source,
                variant_token,
                separator
            ), @parse_handle_arm);
            value.tokens.position = variant_token + 1;
            let binders = Vec::new();
            if(value.tokens.position < value.tokens.limit
                and {
                    super::lexer::token_matches_at(
                        source,
                        value.tokens.position,
                        TokenPattern::LParen
                    )
                }) {
                let open = value.tokens.position;
                value.tokens.position = open + 1;
                try(parse_pattern_binders(
                    source,
                    value,
                    &mut binders,
                    open
                ), @parse_handle_arm)
            } else { () };
            if(value.tokens.position < value.tokens.limit
                and {
                    super::lexer::token_matches_at(
                        source,
                        value.tokens.position,
                        TokenPattern::FatArrow
                    )
                }) {
                value.tokens.position = value.tokens.position + 1;
                let body = try(parse_expression(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    0,
                    depth + 1
                ), @parse_handle_arm);
                Result::Ok(PendingHandleArm {
                    enum_name: enum_name,
                    enum_token: enum_token,
                    variant_name: variant_name,
                    variant_token: variant_token,
                    effect_type: effect_type,
                    binders: binders,
                    body: body
                })
            } else {
                Result::Err(BodyError::InvalidHandleArm(
                    value.tokens.position,
                    variant_token
                ))
            }
        } else {
            Result::Err(BodyError::ExpectedIdentifier(
                variant_token,
                separator
            ))
        }
    } else {
        // A bare arm name may denote a source-level pattern alias such as
        // `true`, `false`, or `None`. Resolution canonicalizes that global
        // alias to its enum variant; identical name/token pairs preserve the
        // distinction from an explicitly qualified `Enum::Variant` arm.
        if(separator < value.tokens.limit
            and { super::lexer::token_matches_at(
                source,
                separator,
                TokenPattern::FatArrow
            ) }) {
            value.tokens.position = separator + 1;
            let body = try(parse_expression(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                0,
                depth + 1
            ), @parse_handle_arm);
            Result::Ok(PendingHandleArm {
                enum_name: enum_name,
                enum_token: enum_token,
                variant_name: enum_name,
                variant_token: enum_token,
                effect_type: None,
                binders: Vec::new(),
                body: body
            })
        } else {
            Result::Err(BodyError::ExpectedIdentifier(separator, enum_token))
        }
    }
}

parse_handle_arms(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    open: usize,
    output: &mut Vec<PendingHandleArm>
) -> Result<(), BodyError> {
    if(value.tokens.position < value.tokens.limit) {
        if(eat_token(value, source, TokenPattern::RBrace)) {
            Result::Ok(())
        } else {
            let arm = try(parse_handle_arm(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth
            ), @parse_handle_arms);
            Vec::push(&mut *output, arm);
            if(value.tokens.position < value.tokens.limit) {
                let separator = super::lexer::token_kind_at(
                    source,
                    value.tokens.position
                );
                if((separator is TokenKind::Comma)
                    or { separator is TokenKind::Semicolon }) {
                    value.tokens.position = value.tokens.position + 1;
                    ()
                } else { () };
                parse_handle_arms(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    open,
                    output
                )
            } else {
                Result::Err(BodyError::ExpectedBlockClose(
                    value.tokens.position,
                    open
                ))
            }
        }
    } else {
        Result::Err(BodyError::ExpectedBlockClose(value.tokens.position, open))
    }
}

append_pattern_binders(
    values: VecIntoIter<PatternBinder>,
    output: &mut Vec<PatternBinder>
) {
    handle VecIntoIter::next(values) {
        None => (),
        Option::Some((value, remaining)) => {
            Vec::push(&mut *output, value);
            append_pattern_binders(remaining, output)
        }
    }
}

append_handle_arms(
    values: VecIntoIter<PendingHandleArm>,
    value: &mut BodyParser
) {
    handle VecIntoIter::next(values) {
        None => (),
        Option::Some((arm, remaining)) => {
            let PendingHandleArm {
                enum_name,
                enum_token,
                variant_name,
                variant_token,
                effect_type,
                binders,
                body
            } = arm;
            let binder_start =
                super::syntax::range_mark(&value.pattern_binders);
            append_pattern_binders(
                Vec::into_iter(binders),
                &mut value.pattern_binders
            );
            let binder_end = Vec::len(&value.pattern_binders);
            let binders_range = binder_range(
                binder_start,
                binder_end
            );
            Vec::push(&mut value.handle_arms, HandleArm {
                enum_name: enum_name,
                enum_token: enum_token,
                variant_name: variant_name,
                variant_token: variant_token,
                effect_type: effect_type,
                binders: binders_range,
                body: body
            });
            append_handle_arms(remaining, value)
        }
    }
}

push_handle(
    value: &mut BodyParser,
    subject: ExprId,
    arms: Vec<PendingHandleArm>,
    start: usize,
    end: usize
) -> ExprId {
    let arm_start = super::syntax::range_mark(&value.handle_arms);
    append_handle_arms(Vec::into_iter(arms), value);
    let arm_end = Vec::len(&value.handle_arms);
    let arm_range = handle_arm_range(arm_start, arm_end);
    push_node(
        value,
        ExprKind::Handle(subject, arm_range),
        token_range(start, end)
    )
}

parse_handle(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize
) -> Result<ExprId, BodyError> {
    value.tokens.position = start + 1;
    let subject = try(parse_expression(
        original,
        source,
        declarations,
        nominal,
        value,
        owner,
        0,
        depth + 1
    ), @parse_handle);
    let open = value.tokens.position;
    if(open < value.tokens.limit
        and {
            super::lexer::token_matches_at(
                source,
                open,
                TokenPattern::LBrace
            )
        }) {
        value.tokens.position = open + 1;
        let arms = Vec::new();
        try(parse_handle_arms(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth + 1,
            open,
            &mut arms
        ), @parse_handle);
        Result::Ok(push_handle(
            value,
            subject,
            arms,
            start,
            value.tokens.position
        ))
    } else {
        Result::Err(BodyError::ExpectedBlockClose(open, start))
    }
}

parse_perform(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize
) -> Result<ExprId, BodyError> {
    let effect_token = start + 1;
    value.tokens.position = effect_token;
    let effect_type = try(parse_body_type(source, value, start), @parse_perform);
    let effect_name = try(identifier_name(source, effect_token, start), @parse_perform);
    let separator = value.tokens.position;
    if(separator >= value.tokens.limit or {
        not(super::lexer::token_matches_at(
            source, separator, TokenPattern::DoubleColon
        ))
    }) {
        @parse_perform(Result::Err(BodyError::ExpectedIdentifier(
            separator, effect_token
        )))
    } else { () };
    let operation_token = separator + 1;
    let operation_name = try(identifier_name(
        source, operation_token, separator
    ), @parse_perform);
    let open = operation_token + 1;
    if(open >= value.tokens.limit or {
        not(super::lexer::token_matches_at(source, open, TokenPattern::LParen))
    }) {
        @parse_perform(Result::Err(BodyError::ExpectedCallClose(
            open, operation_token
        )))
    } else { () };
    value.tokens.position = open + 1;
    let arguments = Vec::new();
    try(parse_call_arguments(
        original,
        source,
        declarations,
        nominal,
        value,
        owner,
        depth + 1,
        &mut arguments,
        open
    ), @parse_perform);
    Result::Ok(push_perform(
        value,
        EffectOperationSyntax {
            effect_name: effect_name,
            effect_token: effect_token,
            effect_type: effect_type,
            operation_name: operation_name,
            operation_token: operation_token
        },
        &arguments,
        start,
        value.tokens.position
    ))
}

compact_closure_ahead(
    source: &super::lexer::LexedSource,
    value: &BodyParser,
    start: usize
) -> Bool {
    if(start + 1 >= value.tokens.limit) { false } else {
        let first = super::lexer::token_kind_at(source, start + 1);
        if(first is TokenKind::FatArrow) { true } else {
            if(first is TokenKind::Ident(_)) {
                if(start + 2 >= value.tokens.limit) { false } else {
                    let second = super::lexer::token_kind_at(source, start + 2);
                    (second is TokenKind::FatArrow) or { second is TokenKind::Comma }
                }
            } else { false }
        }
    }
}

parse_closure_parameters(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    related: usize
) -> Result<(), BodyError> {
    if(eat_token(value, source, TokenPattern::FatArrow)) {
        Result::Ok(())
    } else {
        let token = value.tokens.position;
        let name = try(identifier_name(source, token, related), @parse_closure_parameters);
        value.tokens.position = token + 1;
        Vec::push(&mut value.closure_parameters, ClosureParameter {
            name: name, token: token
        });
        if(eat_token(value, source, TokenPattern::Comma)) {
            parse_closure_parameters(source, value, related)
        } else {
            if(eat_token(value, source, TokenPattern::FatArrow)) {
                Result::Ok(())
            } else {
                Result::Err(BodyError::ExpectedIdentifier(
                    value.tokens.position, related
                ))
            }
        }
    }
}

parse_closure(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize
) -> Result<ExprId, BodyError> {
    value.tokens.position = start + 1;
    let parameter_start = super::syntax::range_mark(&value.closure_parameters);
    try(parse_closure_parameters(source, value, start), @parse_closure);
    let parameter_end = Vec::len(&value.closure_parameters);
    let body = try(parse_expression(
        original, source, declarations, nominal, value, owner, 0, depth + 1
    ), @parse_closure);
    if(not(eat_token(value, source, TokenPattern::RBrace))) {
        @parse_closure(Result::Err(BodyError::ExpectedBlockClose(
            value.tokens.position, start
        )))
    } else { () };
    Result::Ok(push_node(
        value,
        ExprKind::Closure(
            super::syntax::id_range(parameter_start, parameter_end),
            body
        ),
        token_range(start, value.tokens.position)
    ))
}

parse_atom(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16
) -> Result<ExprId, BodyError> {
    let start = value.tokens.position;
    if(start < value.tokens.limit) {
        handle super::lexer::token_kind_at(source, start) {
            TokenKind::Keyword(Keyword::Handle) => parse_handle(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                start
            ),
            TokenKind::Keyword(Keyword::Perform) => parse_perform(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                start
            ),
            TokenKind::Ident(_) => parse_identifier(source, value, start),
            TokenKind::Number(_) => {
                value.tokens.position = start + 1;
                Result::Ok(push_leaf(
                    value,
                    ExprKind::Number,
                    start,
                    value.tokens.position
                ))
            },
            TokenKind::LParen => if(start + 1 < value.tokens.limit) {
                if(super::lexer::token_matches_at(
                    source,
                    start + 1,
                    TokenPattern::RParen
                )) {
                    value.tokens.position = start + 2;
                        Result::Ok(push_leaf(
                            value,
                            ExprKind::Unit,
                            start,
                            value.tokens.position
                        ))
                } else {
                    value.tokens.position = start + 1;
                        let child = try(
                            parse_expression(
                                original,
                                source,
                                declarations,
                                nominal,
                                value,
                                owner,
                                0,
                                depth + 1
                            ),
                            @parse_atom
                        );
                        if(value.tokens.position < value.tokens.limit) {
                            handle super::lexer::token_kind_at(
                                source,
                                value.tokens.position
                            ) {
                                    TokenKind::RParen => {
                                        value.tokens.position = value.tokens.position
                                            + 1;
                                        Result::Ok(push_grouping(
                                            value,
                                            child,
                                            start,
                                            value.tokens.position
                                        ))
                                    },
                                    TokenKind::Comma => {
                                        let elements = Vec::new();
                                        Vec::push(&mut elements, child);
                                        value.tokens.position = value.tokens.position
                                            + 1;
                                        parse_tuple_tail(
                                            original,
                                            source,
                                            declarations,
                                            nominal,
                                            value,
                                            owner,
                                            depth + 1,
                                            start,
                                            &mut elements
                                        )
                                    },
                                    _ => Result::Err(
                                        BodyError::ExpectedGroupingClose(
                                            value.tokens.position,
                                            start
                                        )
                                    )
                                }
                        } else {
                            Result::Err(
                                    BodyError::ExpectedGroupingClose(
                                        value.tokens.position,
                                        start
                                    )
                                )
                        }
                }
            } else {
                Result::Err(BodyError::ExpectedGroupingClose(start, start))
            },
            TokenKind::LBrace => if(compact_closure_ahead(source, &*value, start)) {
                parse_closure(
                    original, source, declarations, nominal, value,
                    owner, depth, start
                )
            } else {
                value.tokens.position = start + 1;
                let statements = Vec::new();
                parse_block_contents(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth + 1,
                    start,
                    true,
                    &mut statements
                )
            },
            _ => Result::Err(BodyError::ExpectedExpression(start, start))
        }
    } else {
        Result::Err(BodyError::ExpectedExpression(start, start))
    }
}

parse_call_argument_no_match() -> ParseAttempt<ExprId, BodyError> {
    ParseAttempt::NoMatch
}

parse_call_argument_attempt(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16
) -> ParseAttempt<ExprId, BodyError> {
    if(super::syntax::cursor_at(
        &value.tokens,
        source,
        TokenPattern::RParen
    )) {
        parse_call_argument_no_match()
    } else {
        handle parse_expression(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            0,
            depth
        ) {
            Result::Err(error) => ParseAttempt::Diagnostic(move error),
            Result::Ok(argument) => ParseAttempt::Parsed(move argument)
        }
    }
}

parse_call_separator_attempt(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser
) -> ParseAttempt<(), BodyError> {
    let comma = super::syntax::cursor_position(&value.tokens);
    if(super::syntax::cursor_at(&value.tokens, source, TokenPattern::Comma)) {
        let following = comma + 1;
        if(following < super::syntax::cursor_limit(&value.tokens)) {
            if(super::lexer::token_matches_at(
                source,
                following,
                TokenPattern::RParen
            )) {
                ParseAttempt::NoMatch
            } else {
                super::syntax::cursor_advance(&mut value.tokens);
                ParseAttempt::Parsed(())
            }
        } else {
            super::syntax::cursor_advance(&mut value.tokens);
            ParseAttempt::Parsed(())
        }
    } else {
        ParseAttempt::NoMatch
    }
}

parse_call_arguments(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    arguments: &mut Vec<ExprId>,
    open: usize
) -> Result<(), BodyError> {
    let missing_position = super::syntax::cursor_position(&value.tokens);
    handle separated(
        &mut *value,
        { parser => parse_call_argument_attempt(
            original,
            source,
            declarations,
            nominal,
            parser,
            owner,
            depth
        )},
        { parser => parse_call_separator_attempt(source, parser) },
        BodyError::ExpectedCallClose(missing_position, open)
    ) {
        ParseAttempt::NoMatch => unreachable(),
        ParseAttempt::Diagnostic(error) => Result::Err(move error),
        ParseAttempt::Parsed(parsed) => {
            Vec::append(&mut *arguments, move parsed);
            // Consume the optional trailing comma, then make the closing
            // delimiter authoritative. `try` preserves the precise parser
            // diagnostic instead of silently discarding `expect`'s result.
            super::syntax::cursor_eat(
                &mut value.tokens,
                source,
                TokenPattern::Comma
            );
            let close_position = super::syntax::cursor_position(&value.tokens);
            try(expect(
                &mut *value,
                source,
                TokenPattern::RParen,
                BodyError::ExpectedCallClose(close_position, open)
            ), @parse_call_arguments);
            Result::Ok(())
        }
    }
}

parse_struct_fields(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    constructor: ExprId,
    start: usize,
    open: usize,
    fields: &mut Vec<PendingField>
) -> Result<ExprId, BodyError> {
    if(value.tokens.position < value.tokens.limit) {
        if(eat_token(value, source, TokenPattern::RBrace)) {
            Result::Ok(push_struct(
                value,
                constructor,
                &*fields,
                start,
                value.tokens.position
            ))
        } else {
            let name_token = value.tokens.position;
            handle super::lexer::token_kind_at(source, name_token) {
                TokenKind::Ident(name) => {
                    let colon = name_token + 1;
                    if(colon < value.tokens.limit) {
                        if(super::lexer::token_matches_at(
                            source,
                            colon,
                            TokenPattern::Colon
                        )) {
                            value.tokens.position = colon + 1;
                            let field = try(
                                parse_expression(
                                    original,
                                    source,
                                    declarations,
                                    nominal,
                                    value,
                                    owner,
                                    0,
                                    depth
                                ),
                                @parse_struct_fields
                            );
                            Vec::push(
                                &mut *fields,
                                PendingField {
                                    name: name,
                                    name_token: name_token,
                                    expression: field
                                }
                            );
                            if(value.tokens.position < value.tokens.limit) {
                                handle super::lexer::token_kind_at(
                                    source,
                                    value.tokens.position
                                ) {
                                    TokenKind::RBrace => {
                                        value.tokens.position =
                                            value.tokens.position + 1;
                                        Result::Ok(push_struct(
                                            value,
                                            constructor,
                                            &*fields,
                                            start,
                                            value.tokens.position
                                        ))
                                    },
                                    TokenKind::Comma => {
                                        value.tokens.position =
                                            value.tokens.position + 1;
                                        parse_struct_fields(
                                            original,
                                            source,
                                            declarations,
                                            nominal,
                                            value,
                                            owner,
                                            depth,
                                            constructor,
                                            start,
                                            open,
                                            fields
                                        )
                                    },
                                    _ => Result::Err(
                                        BodyError::InvalidStructField(
                                            value.tokens.position,
                                            open
                                        )
                                    )
                                }
                            } else {
                                Result::Err(BodyError::InvalidStructField(
                                    value.tokens.position,
                                    open
                                ))
                            }
                        } else {
                            Result::Err(BodyError::InvalidStructField(
                                colon,
                                name_token
                            ))
                        }
                    } else {
                        Result::Err(BodyError::InvalidStructField(colon, open))
                    }
                },
                _ => Result::Err(BodyError::InvalidStructField(
                    name_token,
                    open
                ))
            }
        }
    } else {
        Result::Err(BodyError::InvalidStructField(
            value.tokens.position,
            open
        ))
    }
}

parse_projection_name(
    original: &String,
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    subject: ExprId,
    dot: usize
) -> Result<ExprId, BodyError> {
    let token = dot + 1;
    if(token < value.tokens.limit) {
        handle super::lexer::token_kind_at(source, token) {
            TokenKind::Ident(name) => {
                value.tokens.position = token + 1;
                Result::Ok(push_projection(
                    value,
                    subject,
                    ExpressionName::Identifier(name, token),
                    value.tokens.position
                ))
            },
            TokenKind::Number(number) => if(super::lexer::number_is_float(&number)) {
                Result::Err(BodyError::ExpectedProjectionName(token, dot))
            } else {
                let text = range_text(
                        original,
                        source,
                        token,
                        token + 1
                    );
                    handle parse_u64(&text) {
                        Result::Err(_) =>
                            Result::Err(BodyError::ExpectedProjectionName(
                                token,
                                dot
                            )),
                        Result::Ok(field) => if(field <= 4294967295) {
                            value.tokens.position = token + 1;
                                Result::Ok(push_projection(
                                    value,
                                    subject,
                                    ExpressionName::TupleField(
                                        wrapping_convert_to_u32(field),
                                        token
                                    ),
                                    value.tokens.position
                                ))
                        } else {
                            Result::Err(BodyError::ExpectedProjectionName(
                                token,
                                dot
                            ))
                        }
                    }
            },
            _ => Result::Err(BodyError::ExpectedProjectionName(token, dot))
        }
    } else {
        Result::Err(BodyError::ExpectedProjectionName(token, dot))
    }
}

handler_clause_brace(
    source: &super::lexer::LexedSource,
    cursor: usize,
    limit: usize,
    depth: u16
) -> Bool {
    if(cursor < limit) {
        let kind = super::lexer::token_kind_at(source, cursor);
        if((kind is TokenKind::FatArrow) and { depth == 0 }) {
            true
        } else {
            if((kind is TokenKind::RBrace) and { depth == 0 }) {
                false
            } else {
                let next_depth =
                    if((kind is TokenKind::LParen)
                        or { (kind is TokenKind::LBrace)
                        or { kind is TokenKind::LBracket } }) {
                        depth + 1
                    } else {
                        if((kind is TokenKind::RParen)
                            or { (kind is TokenKind::RBrace)
                            or { kind is TokenKind::RBracket } }) {
                            if(depth == 0) { 0 } else { depth - 1 }
                        } else { depth }
                    };
                handler_clause_brace(
                    source,
                    cursor + 1,
                    limit,
                    next_depth
                )
            }
        }
    } else { false }
}

parse_postfix(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    callee: ExprId
) -> Result<ExprId, BodyError> {
    if(value.tokens.position < value.tokens.limit) {
        if(depth < 128) {
            handle super::lexer::token_kind_at(
                source,
                value.tokens.position
            ) {
                TokenKind::LParen => {
                    let start = node_tokens(&*value, callee).start;
                    let open = value.tokens.position;
                    let arguments = Vec::new();
                    value.tokens.position = open + 1;
                    try(
                        parse_call_arguments(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            depth + 1,
                            &mut arguments,
                            open
                        ),
                        @parse_postfix
                    );
                    let end = value.tokens.position;
                    let call = push_call_or_perform(
                        declarations,
                        value,
                        owner,
                        callee,
                        &arguments,
                        start,
                        end
                    );
                    parse_postfix(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth + 1,
                        call
                    )
                },
                TokenKind::LBrace => if(handler_clause_brace(
                    source,
                    value.tokens.position + 1,
                    value.tokens.limit,
                    0
                )) {
                    Result::Ok(callee)
                } else {
                    let start = node_tokens(&*value, callee).start;
                    if(node_is_identifier(&*value, callee)) {
                        if(node_name_count(&*value, callee)
                                == 1) {
                            let open = value.tokens.position;
                            let fields = Vec::new();
                            value.tokens.position = open + 1;
                            let found = try(
                                parse_struct_fields(
                                    original,
                                    source,
                                    declarations,
                                    nominal,
                                    value,
                                    owner,
                                    depth + 1,
                                    callee,
                                    start,
                                    open,
                                    &mut fields
                                ),
                                @parse_postfix
                            );
                            parse_postfix(
                                original,
                                source,
                                declarations,
                                nominal,
                                value,
                                owner,
                                depth + 1,
                                found
                            )
                        } else {
                            Result::Ok(callee)
                        }
                    } else {
                        Result::Ok(callee)
                    }
                },
                TokenKind::Dot => {
                    let dot = value.tokens.position;
                    let found = try(
                        parse_projection_name(
                            original,
                            source,
                            value,
                            callee,
                            dot
                        ),
                        @parse_postfix
                    );
                    parse_postfix(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth + 1,
                        found
                    )
                },
                _ => Result::Ok(callee)
            }
        } else {
            Result::Err(
                BodyError::ExpressionDepthLimit(value.tokens.position, value.tokens.position)
            )
        }
    } else {
        Result::Ok(callee)
    }
}

infix_separated(
    source: &super::lexer::LexedSource,
    value: &BodyParser,
    left: ExprId,
    operator: OperatorUse
) -> Bool {
    super::lexer::token_matches_at(
        source,
        operator.start,
        TokenPattern::Ident
    )
        or {
            let left_end = node_tokens(value, left).end;
            let left_span = token_span(source, left_end - 1);
            let operator_span = token_span(source, operator.start);
            super::lexer::span_end(&left_span)
                != super::lexer::span_start(&operator_span)
                and { operator.end < value.tokens.limit }
                and {
                        let last = token_span(
                            source,
                            operator.end - 1
                        );
                        let next = token_span(source, operator.end);
                        super::lexer::span_end(&last)
                            != super::lexer::span_start(&next)
                }
        }
}

parse_chain(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    minimum: u8,
    depth: u16,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) -> Result<ExprId, BodyError> {
    let found = try(
        peek_operator(
            original,
            source,
            nominal,
            &*value,
            false,
            owner
        ),
        @parse_chain
    );
    handle found {
            Result::Err(_) => finish_chain(value, output, pending),
            Result::Ok(operator) => if(operator.precedence < minimum) {
                finish_chain(value, output, pending)
            } else {
                let left = last_expr(output);
                    if(infix_separated(source, &*value, left, operator)) {
                        value.tokens.position = operator.end;
                            let operand = try(
                                parse_primary(
                                    original,
                                    source,
                                    declarations,
                                    nominal,
                                    value,
                                    owner,
                                    depth
                                ),
                                @parse_chain
                            );
                            try(
                                prepare_operator(
                                    &mut *value,
                                    &mut *output,
                                    &mut *pending,
                                    operator
                                ),
                                @parse_chain
                            );
                            Vec::push(&mut *pending, operator);
                            Vec::push(&mut *output, operand);
                            parse_chain(
                                original,
                                source,
                                declarations,
                                nominal,
                                value,
                                owner,
                                minimum,
                                depth,
                                output,
                                pending
                            )
                    } else {
                        finish_chain(value, output, pending)
                    }
            }
    }
}

reduce_once(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) {
    let operator = pop_operator(&mut *pending);
    let right = pop_expr(&mut *output);
    let left = pop_expr(&mut *output);
    let grouped = push_binary(value, operator, left, right);
    Vec::push(&mut *output, grouped)
}

prepare_operator(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>,
    incoming: OperatorUse
) -> Result<(), BodyError> {
    if(Vec::len(&*pending) == 0) {
        Result::Ok(())
    } else {
        let top = last_operator(&*pending);
            if(top.precedence > incoming.precedence) {
                reduce_once(&mut *value, &mut *output, &mut *pending);
                    prepare_operator(value, output, pending, incoming)
            } else {
                if(top.precedence == incoming.precedence) {
                    if(top.form == incoming.form) {
                        handle incoming.form {
                            2 => {
                                reduce_once(
                                    &mut *value,
                                    &mut *output,
                                    &mut *pending
                                );
                                prepare_operator(
                                    value,
                                    output,
                                    pending,
                                    incoming
                                )
                            },
                            3 => Result::Ok(()),
                            _ => Result::Err(
                                BodyError::NonAssociativeChain(
                                    incoming.start,
                                    top.start
                                )
                            )
                        }
                    } else {
                        Result::Err(
                            BodyError::IncompatibleAssociativity(
                                incoming.start,
                                top.start
                            )
                        )
                    }
                } else {
                    Result::Ok(())
                }
            }
    }
}

finish_chain(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) -> Result<ExprId, BodyError> {
    if(Vec::len(&*pending) == 0) {
        Result::Ok(pop_expr(&mut *output))
    } else {
        reduce_once(&mut *value, &mut *output, &mut *pending);
            finish_chain(value, output, pending)
    }
}

parse_expression(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    minimum: u8,
    depth: u16
) -> Result<ExprId, BodyError> {
    let first = try(
        parse_primary(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth
        ),
        @parse_expression
    );
    let output = Vec::new();
    let pending = Vec::new();
    Vec::push(&mut output, first);
    let grouped = try(parse_chain(
        original,
        source,
        declarations,
        nominal,
        value,
        owner,
        minimum,
        depth,
        &mut output,
        &mut pending
    ), @parse_expression);
    if(value.tokens.position < value.tokens.limit
        and { super::lexer::token_kind_at(
            source, value.tokens.position
        ) is TokenKind::Keyword(Keyword::Is) }) {
        let is_token = value.tokens.position;
        value.tokens.position = is_token + 1;
        let pattern = try(
            parse_scalar_pattern(source, value, is_token),
            @parse_expression
        );
        Result::Ok(push_pattern_test(
            value,
            grouped,
            pattern,
            node_tokens(&*value, grouped).start,
            value.tokens.position
        ))
    } else { Result::Ok(grouped) }
}

parse_let_statement_alternative<L>(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    parser: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    miss: L
) -> Result<PendingStatement, BodyError>
where L: Label<ParseAttempt<PendingStatement, BodyError>> {
    let alternative_start = super::syntax::cursor_position(&parser.tokens);
    handle super::lexer::token_kind_at(source, alternative_start) {
        TokenKind::Keyword(Keyword::Let) =>
            super::syntax::cursor_advance(&mut parser.tokens),
        _ => miss(parse_statement_no_match())
    };
    let name_position = super::syntax::cursor_position(&parser.tokens);
    handle expect(
        &mut *parser,
        source,
        TokenPattern::Ident,
        BodyError::InvalidLetSyntax(name_position, alternative_start)
    ) {
        Result::Err(error) => Result::Err(move error),
        Result::Ok(name_token) => {
            let equals_position = super::syntax::cursor_position(&parser.tokens);
            handle expect(
                &mut *parser,
                source,
                TokenPattern::Eq,
                BodyError::InvalidLetSyntax(equals_position, alternative_start)
            ) {
            Result::Err(error) => Result::Err(move error),
            Result::Ok(_) => handle parse_expression(
                original,
                source,
                declarations,
                nominal,
                &mut *parser,
                owner,
                0,
                depth
            ) {
                Result::Err(error) => Result::Err(move error),
                Result::Ok(initializer) => Result::Ok(
                    PendingStatement::Let(name_token, initializer)
                )
            }
        }}
    }
}

attempt_let_statement(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16
) -> ParseAttempt<PendingStatement, BodyError> {
    attempt(&mut *value, @attempt_let_statement, { parser, destination => {
        parse_let_statement_alternative(
            original,
            source,
            declarations,
            nominal,
            parser,
            owner,
            depth,
            destination
        )
    }})
}

parse_block_statement(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    statements: &mut Vec<PendingStatement>
) -> Result<(), BodyError> {
    let parsed_let = attempt_let_statement(
        original,
        source,
        declarations,
        nominal,
        &mut *value,
        owner,
        depth
    );
    handle move parsed_let {
        ParseAttempt::Diagnostic(error) => Result::Err(move error),
        ParseAttempt::Parsed(statement) => {
            Vec::push(&mut *statements, move statement);
            Result::Ok(())
        },
        ParseAttempt::NoMatch => {
            let start = super::syntax::cursor_position(&value.tokens);
            let expression = try(
                parse_expression(
                    original,
                    source,
                    declarations,
                    nominal,
                    &mut *value,
                    owner,
                    0,
                    depth
                ),
                @parse_block_statement
            );
            Vec::push(
                &mut *statements,
                PendingStatement::Expression(expression)
            );
            Result::Ok(())
        }
    }
}

parse_block_after_statement(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize,
    requires_close: Bool,
    statements: &mut Vec<PendingStatement>
) -> Result<ExprId, BodyError> {
    if(value.tokens.position < value.tokens.limit) {
        handle super::lexer::token_kind_at(
            source,
            value.tokens.position
        ) {
            TokenKind::Semicolon => {
                value.tokens.position = value.tokens.position + 1;
                parse_block_contents(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    start,
                    requires_close,
                    statements
                )
            },
            TokenKind::RBrace => if(requires_close) {
                parse_block_contents(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    start,
                    requires_close,
                    statements
                )
            } else {
                Result::Err(
                    BodyError::ExpectedBlockClose(value.tokens.position, start)
                )
            },
            _ => Result::Err(BodyError::ExpectedBlockClose(
                value.tokens.position,
                start
            ))
        }
    } else {
        parse_block_contents(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth,
            start,
            requires_close,
            statements
        )
    }
}

parse_block_contents(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize,
    requires_close: Bool,
    statements: &mut Vec<PendingStatement>
) -> Result<ExprId, BodyError> {
    if(value.tokens.position < value.tokens.limit) {
        if(requires_close) {
            if(super::lexer::token_matches_at(
                source,
                value.tokens.position,
                TokenPattern::RBrace
            )) {
                value.tokens.position = value.tokens.position + 1;
                    Result::Ok(push_block(
                        value,
                        statements,
                        start,
                        value.tokens.position
                    ))
            } else {
                try(
                        parse_block_statement(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            depth,
                            statements
                        ),
                        @parse_block_contents
                    );
                    parse_block_after_statement(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth,
                        start,
                        requires_close,
                        statements
                    )
            }
        } else {
            try(
                    parse_block_statement(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth,
                        statements
                    ),
                    @parse_block_contents
                );
                parse_block_after_statement(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    start,
                    requires_close,
                    statements
                )
        }
    } else {
        if(not(requires_close)) {
            Result::Ok(
                push_block(value, statements, start, value.tokens.position)
            )
        } else {
            Result::Err(
                BodyError::ExpectedBlockClose(value.tokens.position, start)
            )
        }
    }
}

pub parse_function_body(
    original: &String,
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    shell: ShellId
) -> Result<ParsedBody, BodyError> {
    handle super::scanner::shell_at(declarations, shell) {
        Result::Err(_) =>
            Result::Err(BodyError::MissingBodyShell(shell)),
        Result::Ok(declaration) => if(
            super::scanner::shell_is_function(declaration)
        ) {
            handle
                super::scanner::shell_body_range(declaration) {
                Result::Err(_) =>
                    Result::Err(BodyError::MissingBodyShell(shell)),
                Result::Ok(body) => {
                    let start = super::scanner::range_start(&body);
                    let end = super::scanner::range_end(&body);
                    let parser = BodyParser {
                        tokens: super::syntax::cursor(start, end),
                        nodes: Arena::new(),
                        edges: Vec::new(),
                        names: Vec::new(),
                        types: Arena::new(),
                        type_arguments: Vec::new(),
                        closure_parameters: Vec::new(),
                        handle_arms: Vec::new(),
                        pattern_binders: Vec::new(),
                        patterns: Arena::new()
                    };
                    let source = super::headers::parsed_source(headers);
                    let nominal = super::headers::nominal_index(headers);
                    let statements = Vec::new();
                    let root = try(
                        parse_block_contents(
                            original,
                            source,
                            declarations,
                            nominal,
                            &mut parser,
                            shell_owner(declarations, shell),
                            0,
                            start,
                            false,
                            &mut statements
                        ),
                        @parse_function_body
                    );
                    let BodyParser {
                        tokens: _,
                        nodes,
                        edges,
                        names,
                        types,
                        type_arguments,
                        closure_parameters,
                        handle_arms,
                        pattern_binders,
                        patterns
                    } = parser;
                    let output = ParsedBody {
                        shell: shell,
                        root: root,
                        nodes: nodes,
                        edges: edges,
                        names: names,
                        types: types,
                        type_arguments: type_arguments,
                        closure_parameters: closure_parameters,
                        handle_arms: handle_arms,
                        pattern_binders: pattern_binders,
                        patterns: patterns
                    };
                    Result::Ok(__g1_identity_rewrite_expr(
                        move output,
                        @parse_function_body
                    ))
                }
            }
        } else {
            Result::Err(BodyError::MissingBodyShell(shell))
        }
    }
}


u32_from_usize(value: usize) -> u32 { wrapping_convert_to_u32( value) }

usize_from_u32(value: u32) -> usize { wrapping_convert_to_usize( value) }

u32_from_u8(value: u8) -> u32 { wrapping_convert_to_u32( value) }

u8_from_u32(value: u32) -> u8 { wrapping_convert_to_u8( value) }
