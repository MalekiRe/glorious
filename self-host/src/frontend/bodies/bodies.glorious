// One-body-at-a-time expression parsing and source-fixity grouping.
// This slice supports eager blocks, simple local bindings, explicit calls,
// identifiers, integer/float number tokens, unit, tuples, nominal
// construction, projection, grouping, and declared prefix/infix operators.

use super::lexer::{Keyword, TokenKind};

pub struct ExprTag {}

pub type ExprId = Id<ExprTag>;

pub struct HandleArmTag {}

pub type HandleArmId = Id<HandleArmTag>;

pub struct ExprRange { start: u32, count: u32 }

pub struct ExprEdge { value: ExprId, position: u8, metadata: u32 }

pub struct BodyTokenRange { start: usize, end: usize }

impl Use<[0, *]> for BodyTokenRange {}

pub enum PatternBinder {
    Wildcard(usize),
    Binding(Id<String>, usize)
}

impl Use<[0, *]> for PatternBinder {}

pub struct HandleArm {
    enum_name: Id<String>,
    enum_token: usize,
    variant_name: Id<String>,
    variant_token: usize,
    binders: ExprRange,
    body: ExprId
}

enum ExpressionName {
    Identifier(Id<String>, usize),
    TupleField(u32, usize)
}

impl Use<[0, *]> for ExpressionName {}

pub struct ExprNode {
    kind_code: u8,
    tokens: BodyTokenRange,
    operator: BodyTokenRange,
    names: ExprRange,
    children: ExprRange,
    handle_arms: ExprRange
}

pub struct ParsedBody {
    shell: u32,
    root: ExprId,
    nodes: Arena<ExprTag, ExprNode>,
    edges: Vec<ExprEdge>,
    names: Vec<ExpressionName>,
    handle_arms: Vec<HandleArm>,
    pattern_binders: Vec<PatternBinder>
}

pub enum BodyError {
    ExpectedExpression(usize, usize),
    ExpectedGroupingClose(usize, usize),
    DuplicatePatternBinder(usize, usize),
    IncompatibleAssociativity(usize, usize),
    NonAssociativeChain(usize, usize),
    ConflictingFixity(usize, usize),
    ExpressionDepthLimit(usize, usize),
    MissingBodyShell(usize, usize),
    InvalidEncodedExpression(usize, usize),
    ExpectedCallClose(usize, usize),
    InvalidLetSyntax(usize, usize),
    MissingEncodedName(usize, usize),
    ExpectedBlockClose(usize, usize),
    ExpectedIdentifier(usize, usize),
    ExpectedTupleDelimiter(usize, usize),
    InvalidHandleArm(usize, usize),
    InvalidStructField(usize, usize),
    ExpectedProjectionName(usize, usize)
}

struct BodyParser {
    cursor: usize,
    limit: usize,
    nodes: Arena<ExprTag, ExprNode>,
    edges: Vec<ExprEdge>,
    names: Vec<ExpressionName>,
    handle_arms: Vec<HandleArm>,
    pattern_binders: Vec<PatternBinder>
}

struct OperatorUse {
    fixity: u32,
    start: usize,
    end: usize,
    form: u8,
    precedence: u8
}

struct PendingStatement {
    position: u8,
    binding_token: Option<usize>,
    expression: ExprId
}

struct PendingHandleArm {
    enum_name: Id<String>,
    enum_token: usize,
    variant_name: Id<String>,
    variant_token: usize,
    binders: Vec<PatternBinder>,
    body: ExprId
}

impl Use<[0, *]> for OperatorUse {}
impl Use<[0, *]> for PendingStatement {}

pub error_code(value: &BodyError) -> u8 {
    handle *value {
        BodyError::ExpectedExpression(_, _) => 1,
        BodyError::ExpectedGroupingClose(_, _) => 2,
        BodyError::DuplicatePatternBinder(_, _) => 2,
        BodyError::IncompatibleAssociativity(_, _) => 3,
        BodyError::NonAssociativeChain(_, _) => 4,
        BodyError::ConflictingFixity(_, _) => 5,
        BodyError::ExpressionDepthLimit(_, _) => 6,
        BodyError::MissingBodyShell(_, _) => 7,
        BodyError::InvalidEncodedExpression(_, _) => 9,
        BodyError::ExpectedCallClose(_, _) => 10,
        BodyError::InvalidLetSyntax(_, _) => 11,
        BodyError::MissingEncodedName(_, _) => 11,
        BodyError::ExpectedBlockClose(_, _) => 12,
        BodyError::ExpectedIdentifier(_, _) => 13,
        BodyError::ExpectedTupleDelimiter(_, _) => 14,
        BodyError::InvalidHandleArm(_, _) => 15,
        BodyError::InvalidStructField(_, _) => 15,
        BodyError::ExpectedProjectionName(_, _) => 16
    }
}

pub error_token(value: &BodyError) -> usize {
    handle *value {
        BodyError::ExpectedExpression(token, _) => token,
        BodyError::ExpectedGroupingClose(token, _) => token,
        BodyError::DuplicatePatternBinder(token, _) => token,
        BodyError::IncompatibleAssociativity(token, _) => token,
        BodyError::NonAssociativeChain(token, _) => token,
        BodyError::ConflictingFixity(token, _) => token,
        BodyError::ExpressionDepthLimit(token, _) => token,
        BodyError::MissingBodyShell(token, _) => token,
        BodyError::InvalidEncodedExpression(token, _) => token,
        BodyError::ExpectedCallClose(token, _) => token,
        BodyError::InvalidLetSyntax(token, _) => token,
        BodyError::MissingEncodedName(token, _) => token,
        BodyError::ExpectedBlockClose(token, _) => token,
        BodyError::ExpectedIdentifier(token, _) => token,
        BodyError::ExpectedTupleDelimiter(token, _) => token,
        BodyError::InvalidHandleArm(token, _) => token,
        BodyError::InvalidStructField(token, _) => token,
        BodyError::ExpectedProjectionName(token, _) => token
    }
}

pub error_related(value: &BodyError) -> usize {
    handle *value {
        BodyError::ExpectedExpression(_, related) => related,
        BodyError::ExpectedGroupingClose(_, related) => related,
        BodyError::DuplicatePatternBinder(_, related) => related,
        BodyError::IncompatibleAssociativity(_, related) => related,
        BodyError::NonAssociativeChain(_, related) => related,
        BodyError::ConflictingFixity(_, related) => related,
        BodyError::ExpressionDepthLimit(_, related) => related,
        BodyError::MissingBodyShell(_, related) => related,
        BodyError::InvalidEncodedExpression(_, related) => related,
        BodyError::ExpectedCallClose(_, related) => related,
        BodyError::InvalidLetSyntax(_, related) => related,
        BodyError::MissingEncodedName(_, related) => related,
        BodyError::ExpectedBlockClose(_, related) => related,
        BodyError::ExpectedIdentifier(_, related) => related,
        BodyError::ExpectedTupleDelimiter(_, related) => related,
        BodyError::InvalidHandleArm(_, related) => related,
        BodyError::InvalidStructField(_, related) => related,
        BodyError::ExpectedProjectionName(_, related) => related
    }
}

arena_node_at_raw<'a>(
    value: &'a Arena<ExprTag, ExprNode>,
    raw: u32
) -> &'a ExprNode {
    Arena::index(value, Id::from_u32(raw))
}

alloc_node(
    value: &mut Arena<ExprTag, ExprNode>,
    node: ExprNode
) -> ExprId {
    handle Arena::alloc(value, node) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub expression_count(value: &ParsedBody) -> usize { Arena::len(&value.nodes) }

pub expression_at<'a>(
    value: &'a ParsedBody,
    index: usize
) -> Option<&'a ExprNode> {
    handle Id::from_usize(index) {
        Result::Err(_) => None,
        Result::Ok(id) => Arena::get(&value.nodes, id)
    }
}

pub body_shell(value: &ParsedBody) -> u32 { value.shell }

pub body_root_index(value: &ParsedBody) -> u32 { Id::to_u32(value.root) }

pub expression_kind_at(value: &ParsedBody, index: u32) -> u8 {
    arena_node_at_raw(&value.nodes, index).kind_code
}

pub expression_token_start_at(value: &ParsedBody, index: u32) -> usize {
    arena_node_at_raw(&value.nodes, index).tokens.start
}

pub expression_token_end_at(value: &ParsedBody, index: u32) -> usize {
    arena_node_at_raw(&value.nodes, index).tokens.end
}

pub expression_name_count_at(value: &ParsedBody, index: u32) -> u32 {
    arena_node_at_raw(&value.nodes, index).names.count
}

pub expression_name_kind_at(
    value: &ParsedBody,
    index: u32,
    ordinal: u32
) -> u8 {
    let node = arena_node_at_raw(&value.nodes, index);
    handle *Vec::index(
        &value.names,
        usize_from_u32(node.names.start + ordinal)
    ) {
        ExpressionName::Identifier(_, _) => 1,
        ExpressionName::TupleField(_, _) => 2
    }
}

pub expression_name_value_at(
    value: &ParsedBody,
    index: u32,
    ordinal: u32
) -> u32 {
    let node = arena_node_at_raw(&value.nodes, index);
    handle *Vec::index(
        &value.names,
        usize_from_u32(node.names.start + ordinal)
    ) {
        ExpressionName::Identifier(name, _) => Id::to_u32(name),
        ExpressionName::TupleField(field, _) => field
    }
}

pub expression_name_token_at(
    value: &ParsedBody,
    index: u32,
    ordinal: u32
) -> usize {
    let node = arena_node_at_raw(&value.nodes, index);
    handle *Vec::index(
        &value.names,
        usize_from_u32(node.names.start + ordinal)
    ) {
        ExpressionName::Identifier(_, token) => token,
        ExpressionName::TupleField(_, token) => token
    }
}

expression_edges<'a>(
    value: &'a ParsedBody,
    node: &ExprNode
) -> Slice<'a, ExprEdge> {
    handle Slice::subslice(
        Vec::as_slice(&value.edges),
        usize_from_u32(node.children.start),
        usize_from_u32(node.children.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub expression_children<'a>(
    value: &'a ParsedBody,
    expression: u32
) -> Slice<'a, ExprEdge> {
    let node = arena_node_at_raw(&value.nodes, expression);
    expression_edges(value, node)
}

slice_handle_arms<'a>(
    value: &'a ParsedBody,
    range: &ExprRange
) -> Slice<'a, HandleArm> {
    handle Slice::subslice(
        Vec::as_slice(&value.handle_arms),
        usize_from_u32(range.start),
        usize_from_u32(range.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub expression_handle_arms<'a>(
    value: &'a ParsedBody,
    expression: u32
) -> Slice<'a, HandleArm> {
    let node = arena_node_at_raw(&value.nodes, expression);
    slice_handle_arms(value, &node.handle_arms)
}

pub handle_arm_count(value: &ParsedBody) -> usize {
    Vec::len(&value.handle_arms)
}

pub expression_handle_arm_id(
    value: &ParsedBody,
    expression: u32,
    ordinal: usize
) -> HandleArmId {
    let node = arena_node_at_raw(&value.nodes, expression);
    Id::from_u32(node.handle_arms.start + u32_from_usize(ordinal))
}

pub handle_arm_enum_name(value: &HandleArm) -> Id<String> {
    value.enum_name
}

pub handle_arm_enum_token(value: &HandleArm) -> usize {
    value.enum_token
}

pub handle_arm_variant_name(value: &HandleArm) -> Id<String> {
    value.variant_name
}

pub handle_arm_variant_token(value: &HandleArm) -> usize {
    value.variant_token
}

pub handle_arm_body(value: &HandleArm) -> ExprId { value.body }

pub handle_arm_binders<'a>(
    body: &'a ParsedBody,
    value: &HandleArm
) -> Slice<'a, PatternBinder> {
    handle Slice::subslice(
        Vec::as_slice(&body.pattern_binders),
        usize_from_u32(value.binders.start),
        usize_from_u32(value.binders.count)
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pub expression_edge_value(value: &ExprEdge) -> ExprId {
    value.value
}

pub expression_edge_position(value: &ExprEdge) -> u8 {
    value.position
}

pub expression_edge_metadata(value: &ExprEdge) -> u32 {
    value.metadata
}

// Transitional scalar accessors remain for elaboration's ordinal-sensitive
// walks. Serialization and resolution consume the borrowed view directly.
pub expression_child_count_at(
    value: &ParsedBody,
    expression: u32
) -> u32 {
    u32_from_usize(Slice::len(expression_children(value, expression)))
}

pub expression_child_at(
    value: &ParsedBody,
    expression: u32,
    child: u32
) -> u32 {
    Id::to_u32(expression_edge_value(edge_in_slice(
        expression_children(value, expression),
        usize_from_u32(child)
    )))
}

pub expression_child_position_at(
    value: &ParsedBody,
    expression: u32,
    child: u32
) -> u8 {
    expression_edge_position(edge_in_slice(
        expression_children(value, expression),
        usize_from_u32(child)
    ))
}

pub expression_child_metadata_at(
    value: &ParsedBody,
    expression: u32,
    child: u32
) -> u32 {
    expression_edge_metadata(edge_in_slice(
        expression_children(value, expression),
        usize_from_u32(child)
    ))
}

edge_in_slice<'a>(
    value: Slice<'a, ExprEdge>,
    index: usize
) -> &'a ExprEdge {
    handle Slice::get(value, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

edge_suffix<'a>(
    value: Slice<'a, ExprEdge>,
    start: usize
) -> Slice<'a, ExprEdge> {
    handle Slice::subslice(
        value,
        start,
        Slice::len(value) - start
    ) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

token_range(start: usize, end: usize) -> BodyTokenRange {
    BodyTokenRange { start:  start, end:  end }
}

empty_tokens(at: usize) -> BodyTokenRange { token_range(at, at) }

expression_range(start: usize, end: usize) -> ExprRange {
    ExprRange {
        start: u32_from_usize(start),
        count: u32_from_usize(end - start)
    }
}

name_count(value: &Vec<ExpressionName>) -> usize {
    Vec::len(value)
}

push_name(value: &mut Vec<ExpressionName>, name: ExpressionName) {
    Vec::push(&mut *value, name)
}

word_count(value: &Vec<u32>) -> usize { Vec::len(value) }

word_at(value: &Vec<u32>, index: usize) -> u32 {
    *Vec::index(value, index)
}

push_word(value: &mut Vec<u32>, word: u32) {
    Vec::push(&mut *value,  word)
}

pop_word(value: &mut Vec<u32>) -> u32 {
    handle Vec::pop(&mut *value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

expr_id_at(value: &Vec<u32>, index: usize) -> ExprId {
    Id::from_u32(word_at(value, index))
}

pop_operator(value: &mut Vec<OperatorUse>) -> OperatorUse {
    let index = Vec::len(&*value) - 1;
    handle Vec::remove(&mut *value, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

pop_expr(value: &mut Vec<ExprId>) -> ExprId {
    let index = Vec::len(&*value) - 1;
    handle Vec::remove(&mut *value, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

last_operator(value: &Vec<OperatorUse>) -> OperatorUse {
    *Vec::index(value, Vec::len(value) - 1)
}

last_expr(value: &Vec<ExprId>) -> ExprId {
    *Vec::index(value, Vec::len(value) - 1)
}

source_text(value: &String, start: usize, end: usize) -> String {
    handle String::slice(value, Range { start: start, end: end }) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) =>  found
    }
}

token_span(
    source: &super::lexer::LexedSource,
    index: usize
) -> super::lexer::Span {
    handle super::lexer::token_at(source, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::lexer::token_span(token)
    }
}

range_text(
    original: &String,
    source: &super::lexer::LexedSource,
    start: usize,
    end: usize
) -> String {
    let first = token_span(source, start);
    let last = token_span(source, end - 1);
    source_text(
        original,
        super::lexer::span_start(&first),
        super::lexer::span_end(&last)
    )
}

node_tokens(value: &BodyParser, id: ExprId) -> BodyTokenRange {
    let node = Arena::index(&value.nodes, id);
    node.tokens
}

node_kind(value: &BodyParser, id: ExprId) -> u8 {
    Arena::index(&value.nodes, id).kind_code
}

push_node(
    value: &mut BodyParser,
    kind_code: u8,
    tokens: BodyTokenRange,
    operator: BodyTokenRange,
    name_start: usize,
    edge_start: usize
) -> ExprId {
    let name_end = name_count(&value.names);
    let edge_end = Vec::len(&value.edges);
    alloc_node(
        &mut value.nodes,
        ExprNode {
            kind_code: kind_code,
            tokens: tokens,
            operator: operator,
            names: expression_range(name_start, name_end),
            children: expression_range(edge_start, edge_end),
            handle_arms: ExprRange { start: 0, count: 0 }
        }
    )
}

push_leaf(
    value: &mut BodyParser,
    kind_code: u8,
    start: usize,
    end: usize
) -> ExprId {
    let name_start = name_count(&value.names);
    let edge_start = Vec::len(&value.edges);
    push_node(
        value,
        kind_code,
        token_range(start, end),
        empty_tokens(start),
        name_start,
        edge_start
    )
}

push_named_leaf(
    value: &mut BodyParser,
    kind_code: u8,
    start: usize,
    end: usize,
    name_start: usize
) -> ExprId {
    let edge_start = Vec::len(&value.edges);
    push_node(
        value,
        kind_code,
        token_range(start, end),
        empty_tokens(start),
        name_start,
        edge_start
    )
}

node_name_at(
    value: &BodyParser,
    id: ExprId,
    ordinal: u32
) -> &ExpressionName {
    let node = Arena::index(&value.nodes, id);
    Vec::index(
        &value.names,
        usize_from_u32(node.names.start + ordinal)
    )
}

node_name_count(value: &BodyParser, id: ExprId) -> u32 {
    Arena::index(&value.nodes, id).names.count
}

push_unary(
    value: &mut BodyParser,
    kind_code: u8,
    operator: OperatorUse,
    child: ExprId,
    start: usize,
    end: usize
) -> ExprId {
    let name_start = name_count(&value.names);
    let edge_start = Vec::len(&value.edges);
    Vec::push(
        &mut value.edges,
        ExprEdge { value: child, position: 0, metadata: 0 }
    );
    push_node(
        value,
        kind_code,
        token_range(start, end),
        token_range(operator.start, operator.end),
        name_start,
        edge_start
    )
}

push_binary(
    value: &mut BodyParser,
    operator: OperatorUse,
    left: ExprId,
    right: ExprId
) -> ExprId {
    let start = node_tokens(&*value, left).start;
    let end = node_tokens(&*value, right).end;
    let name_start = name_count(&value.names);
    let edge_start = Vec::len(&value.edges);
    Vec::push(
        &mut value.edges,
        ExprEdge { value: left, position: 0, metadata: 0 }
    );
    Vec::push(
        &mut value.edges,
        ExprEdge { value: right, position: 1, metadata: 0 }
    );
    push_node(
        value,
        6,
        token_range(start, end),
        token_range(operator.start, operator.end),
        name_start,
        edge_start
    )
}

push_argument_edges(
    value: &mut BodyParser,
    arguments: &Vec<u32>,
    index: usize
) {
    for_range(Range::new(index, word_count(arguments)), { current =>
        Vec::push(
            &mut value.edges,
            ExprEdge {
                value: expr_id_at(arguments, current),
                position: 1,
                metadata: 0
            }
        )
    })
}

push_call(
    value: &mut BodyParser,
    callee: ExprId,
    arguments: &Vec<u32>,
    start: usize,
    end: usize
) -> ExprId {
    let name_start = name_count(&value.names);
    let edge_start = Vec::len(&value.edges);
    Vec::push(
        &mut value.edges,
        ExprEdge { value: callee, position: 0, metadata: 0 }
    );
    push_argument_edges(value, arguments, 0);
    push_node(
        value,
        7,
        token_range(start, end),
        empty_tokens(start),
        name_start,
        edge_start
    )
}

push_expression_edges(
    value: &mut BodyParser,
    expressions: &Vec<u32>,
    index: usize,
    position: u8
) {
    for_range(Range::new(index, word_count(expressions)), { current =>
        Vec::push(
            &mut value.edges,
            ExprEdge {
                value: expr_id_at(expressions, current),
                position: position,
                metadata: u32_from_usize(current)
            }
        )
    })
}

push_tuple(
    value: &mut BodyParser,
    elements: &Vec<u32>,
    start: usize,
    end: usize
) -> ExprId {
    let name_start = name_count(&value.names);
    let edge_start = Vec::len(&value.edges);
    push_expression_edges(value, elements, 0, 0);
    push_node(
        value,
        9,
        token_range(start, end),
        empty_tokens(start),
        name_start,
        edge_start
    )
}

field_count(value: &Vec<u32>) -> usize {
    word_count(value) / 3
}

push_struct_fields(
    value: &mut BodyParser,
    fields: &Vec<u32>,
    index: usize
) {
    for_range(Range::new(index, field_count(fields)), { current => {
        let base = current * 3;
        push_name(&mut value.names, ExpressionName::Identifier(
            Id::from_u32(word_at(fields, base)),
            usize_from_u32(word_at(fields, base + 1))
        ));
        Vec::push(
            &mut value.edges,
            ExprEdge {
                value: Id::from_u32(word_at(fields, base + 2)),
                position: 1,
                // Name zero is the constructed nominal.
                metadata: u32_from_usize(current) + 1
            }
        )
    } })
}

push_struct(
    value: &mut BodyParser,
    constructor: ExprId,
    fields: &Vec<u32>,
    start: usize,
    end: usize
) -> ExprId {
    let name_start = name_count(&value.names);
    let constructor_name = *node_name_at(&*value, constructor, 0);
    push_name(&mut value.names, constructor_name);
    let edge_start = Vec::len(&value.edges);
    push_struct_fields(value, fields, 0);
    push_node(
        value,
        10,
        token_range(start, end),
        empty_tokens(start),
        name_start,
        edge_start
    )
}

push_projection(
    value: &mut BodyParser,
    subject: ExprId,
    name: ExpressionName,
    end: usize
) -> ExprId {
    let start = node_tokens(&*value, subject).start;
    let name_start = name_count(&value.names);
    let name_token = handle name {
        ExpressionName::Identifier(_, token) => token,
        ExpressionName::TupleField(_, token) => token
    };
    push_name(&mut value.names, name);
    let edge_start = Vec::len(&value.edges);
    Vec::push(
        &mut value.edges,
        ExprEdge { value: subject, position: 0, metadata: 0 }
    );
    push_node(
        value,
        11,
        token_range(start, end),
        empty_tokens(name_token),
        name_start,
        edge_start
    )
}

push_statement(
    value: &mut Vec<PendingStatement>,
    position: u8,
    binding_token: Option<usize>,
    expression: ExprId
) {
    Vec::push(
        &mut *value,
        PendingStatement {
            position: position,
            binding_token: binding_token,
            expression: expression
        }
    )
}

statement_metadata(value: &Option<usize>) -> u32 {
    handle Option::as_ref(value) {
        Result::Err(_) => 0,
        Result::Ok(token) => u32_from_usize(*token) + 1
    }
}

push_statement_edges(
    value: &mut BodyParser,
    statements: &Vec<PendingStatement>,
    index: usize
) {
    for_range(Range::new(index, Vec::len(statements)), { current => {
        let statement = Vec::index(statements, current);
        Vec::push(
            &mut value.edges,
            ExprEdge {
                value: statement.expression,
                position: statement.position,
                metadata: statement_metadata(&statement.binding_token)
            }
        )
    } })
}

push_block(
    value: &mut BodyParser,
    statements: &Vec<PendingStatement>,
    start: usize,
    end: usize
) -> ExprId {
    let name_start = name_count(&value.names);
    let edge_start = Vec::len(&value.edges);
    push_statement_edges(value, statements, 0);
    push_node(
        value,
        8,
        token_range(start, end),
        empty_tokens(start),
        name_start,
        edge_start
    )
}

shell_owner(
    declarations: &super::scanner::DeclarationIndex,
    shell: usize
) -> Option<usize> {
    handle super::scanner::shell_at(declarations, shell) {
        Result::Err(_) => Result::Err(()),
        Result::Ok(found) => *super::scanner::shell_parent(found)
    }
}

fixity_owner(
    declarations: &super::scanner::DeclarationIndex,
    value: &super::headers::FixityHeader
) -> Option<usize> {
    shell_owner(
        declarations,
        usize_from_u32(super::headers::fixity_shell(value))
    )
}

same_owner(left: Option<usize>, right: Option<usize>) -> Bool {
    left == right
}

operator_range(
    source: &super::lexer::LexedSource,
    cursor: usize,
    limit: usize
) -> Option<BodyTokenRange> {
    if(cursor < limit) {
        if(super::lexer::token_code_at(source, cursor) == 1) {
            Result::Ok(
                token_range(cursor, cursor + 1)
            )
        } else {
            if(super::lexer::operator_symbol_at(
                source,
                cursor
            )) {
                let first = token_span(source, cursor);
                let end = super::lexer::operator_end(
                    source,
                    cursor + 1,
                    limit,
                    super::lexer::span_end(&first)
                );
                Result::Ok(token_range(cursor, end))
            } else {
                Result::Err(())
            }
        }
    } else {
        Result::Err(())
    }
}

same_operator(
    original: &String,
    source: &super::lexer::LexedSource,
    found: &BodyTokenRange,
    declared_start: usize,
    declared_end: usize
) -> Bool {
    let left = range_text(original, source, found.start, found.end);
    let right = range_text(
        original,
        source,
        declared_start,
        declared_end
    );
    String::eq(&left, &right)
}

form_matches(form: u8, prefix: Bool) -> Bool {
    if(prefix) {
        form == 1
    } else {
        form != 1
    }
}

lookup_scope(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    operator: &BodyTokenRange,
    prefix: Bool,
    owner: Option<usize>,
    index: usize,
    selected: Option<u32>
) -> Result<Option<u32>, BodyError> {
    if(index < super::headers::fixity_count(nominal)) {
        handle super::headers::fixity_at(nominal, index) {
            Result::Err(_) => Result::Ok(selected),
            Result::Ok(fixity) => {
                let form = super::headers::fixity_form_code(fixity);
                let fixity_scope = fixity_owner(declarations, fixity);
                let matches = same_owner(fixity_scope, owner)
                    and { form_matches(form, prefix) }
                    and {
                        same_operator(
                            original,
                            source,
                            operator,
                            super::headers::fixity_operator_start(fixity),
                            super::headers::fixity_operator_end(fixity)
                        )
                    };
                if(matches) {
                    handle selected {
                        Result::Err(_) => lookup_scope(
                            original,
                            source,
                            declarations,
                            nominal,
                            operator,
                            prefix,
                            owner,
                            index + 1,
                            Result::Ok(u32_from_usize(index))
                        ),
                        Result::Ok(previous) => {
                            let old_index = usize_from_u32(previous);
                            if(super::headers::fixity_form_at(
                                nominal,
                                old_index
                            ) == form) {
                                if(super::headers::fixity_precedence_at(
                                    nominal,
                                    old_index
                                ) == super::headers::fixity_precedence(fixity)) {
                                    lookup_scope(
                                        original,
                                        source,
                                        declarations,
                                        nominal,
                                        operator,
                                        prefix,
                                        owner,
                                        index + 1,
                                        Result::Ok(previous)
                                    )
                                } else {
                                    Result::Err(BodyError::ConflictingFixity(
                                        operator.start,
                                        super::headers::fixity_operator_start_at(
                                            nominal,
                                            old_index
                                        )
                                    ))
                                }
                            } else {
                                Result::Err(BodyError::ConflictingFixity(
                                    operator.start,
                                    super::headers::fixity_operator_start_at(
                                        nominal,
                                        old_index
                                    )
                                ))
                            }
                        }
                    }
                } else {
                    lookup_scope(
                        original,
                        source,
                        declarations,
                        nominal,
                        operator,
                        prefix,
                        owner,
                        index + 1,
                        selected
                    )
                }
            }
        }
    } else {
        Result::Ok(selected)
    }
}

lookup_fixity(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    operator: &BodyTokenRange,
    prefix: Bool,
    owner: Option<usize>
) -> Result<Option<u32>, BodyError> {
    let found = try(
        lookup_scope(
            original,
            source,
            declarations,
            nominal,
            operator,
            prefix,
            owner,
            0,
            Result::Err(())
        ),
        @lookup_fixity
    );
    handle found {
        Result::Ok(index) => Result::Ok(Result::Ok(index)),
        Result::Err(_) => if(Option::is_none(&owner)) {
            Result::Ok(Result::Err(()))
        } else {
            lookup_scope(
                original,
                source,
                declarations,
                nominal,
                operator,
                prefix,
                Result::Err(()),
                0,
                Result::Err(())
            )
        }
    }
}

peek_operator(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &BodyParser,
    prefix: Bool,
    owner: Option<usize>
) -> Result<Option<OperatorUse>, BodyError> {
    handle operator_range(source, value.cursor, value.limit) {
        Result::Err(_) => Result::Ok(Result::Err(())),
        Result::Ok(range) => {
            let found = try(
                lookup_fixity(
                    original,
                    source,
                    declarations,
                    nominal,
                    &range,
                    prefix,
                    owner
                ),
                @peek_operator
            );
            handle found {
                Result::Err(_) => Result::Ok(Result::Err(())),
                Result::Ok(index) => {
                    let header_index = usize_from_u32(index);
                    Result::Ok(Result::Ok(OperatorUse {
                        fixity: index,
                        start: range.start,
                        end: range.end,
                        form: super::headers::fixity_form_at(
                            nominal,
                            header_index
                        ),
                        precedence: super::headers::fixity_precedence_at(
                            nominal,
                            header_index
                        )
                    }))
                }
            }
        }
    }
}

parse_primary(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16
) -> Result<ExprId, BodyError> {
    if(depth < 128) {
            let prefix = try(
                peek_operator(
                    original,
                    source,
                    declarations,
                    nominal,
                    &*value,
                    true,
                    owner
                ),
                @parse_primary
            );
            handle prefix {
                Result::Ok(operator) => {
                    value.cursor = operator.end;
                    let child = try(
                        parse_expression(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            operator.precedence,
                            depth + 1
                        ),
                        @parse_primary
                    );
                    let end = node_tokens(&*value, child).end;
                    Result::Ok(push_unary(
                        value,
                        5,
                        operator,
                        child,
                        operator.start,
                        end
                    ))
                },
                Result::Err(_) => {
                    let atom = try(
                        parse_atom(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            depth
                        ),
                        @parse_primary
                    );
                    parse_postfix(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth,
                        atom
                    )
                }
            }
    } else {
        Result::Err(BodyError::ExpressionDepthLimit(
            value.cursor,
            value.cursor
        ))
    }
}

push_identifier_name(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    token: usize,
    related: usize
) -> Result<(), BodyError> {
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => {
            push_name(
                &mut value.names,
                ExpressionName::Identifier(name, token)
            );
            Result::Ok(())
        },
        _ => Result::Err(BodyError::ExpectedIdentifier(token, related))
    }
}

parse_identifier_tail(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    start: usize,
    name_start: usize
) -> Result<ExprId, BodyError> {
    if(value.cursor < value.limit) {
        if(super::lexer::token_code_at(source, value.cursor)
                == 19) {
            let separator = value.cursor;
                let token = separator + 1;
                if(token < value.limit) {
                    try(
                            push_identifier_name(
                                source,
                                value,
                                token,
                                separator
                            ),
                            @parse_identifier_tail
                        );
                        value.cursor = token + 1;
                        parse_identifier_tail(
                            source,
                            value,
                            start,
                            name_start
                        )
                } else {
                    Result::Err(
                        BodyError::ExpectedIdentifier(token, separator)
                    )
                }
        } else {
            Result::Ok(push_named_leaf(
                value,
                1,
                start,
                value.cursor,
                name_start
            ))
        }
    } else {
        Result::Ok(push_named_leaf(
            value,
            1,
            start,
            value.cursor,
            name_start
        ))
    }
}

parse_identifier(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    start: usize
) -> Result<ExprId, BodyError> {
    let name_start = name_count(&value.names);
    try(
        push_identifier_name(source, value, start, start),
        @parse_identifier
    );
    value.cursor = start + 1;
    parse_identifier_tail(source, value, start, name_start)
}

parse_tuple_tail(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    start: usize,
    elements: &mut Vec<u32>
) -> Result<ExprId, BodyError> {
    if(value.cursor < value.limit) {
        if(super::lexer::token_code_at(source, value.cursor)
                == 12) {
            value.cursor = value.cursor + 1;
                Result::Ok(push_tuple(
                    value,
                    &*elements,
                    start,
                    value.cursor
                ))
        } else {
            let element = try(
                    parse_expression(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        0,
                        depth
                    ),
                    @parse_tuple_tail
                );
                push_word(&mut *elements, Id::to_u32(element));
                if(value.cursor < value.limit) {
                    handle
                        super::lexer::token_code_at(source, value.cursor) {
                        12 => {
                            value.cursor = value.cursor + 1;
                            Result::Ok(push_tuple(
                                value,
                                &*elements,
                                start,
                                value.cursor
                            ))
                        },
                        17 => {
                            value.cursor = value.cursor + 1;
                            parse_tuple_tail(
                                original,
                                source,
                                declarations,
                                nominal,
                                value,
                                owner,
                                depth,
                                start,
                                elements
                            )
                        },
                        _ => Result::Err(
                            BodyError::ExpectedTupleDelimiter(
                                value.cursor,
                                start
                            )
                        )
                    }
                } else {
                    Result::Err(
                        BodyError::ExpectedTupleDelimiter(value.cursor, start)
                    )
                }
        }
    } else {
        Result::Err(BodyError::ExpectedTupleDelimiter(value.cursor, start))
    }
}

pattern_binder_named(
    value: &Vec<PatternBinder>,
    name: Id<String>,
    index: usize
) -> Bool {
    if(index < Vec::len(value)) {
        handle *Vec::index(value, index) {
            PatternBinder::Wildcard(_) =>
                pattern_binder_named(value, name, index + 1),
            PatternBinder::Binding(found, _) =>
                if(found == name) {
                    true
                } else {
                    pattern_binder_named(value, name, index + 1)
                }
        }
    } else { false }
}

parse_pattern_binder(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    binders: &mut Vec<PatternBinder>,
    related: usize
) -> Result<(), BodyError> {
    let token = value.cursor;
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => handle super::lexer::lexeme(source, name) {
            Result::Err(_) =>
                Result::Err(BodyError::ExpectedIdentifier(token, related)),
            Result::Ok(text) => {
                if(String::eq(text, &"_")) {
                    Vec::push(
                        &mut *binders,
                        PatternBinder::Wildcard(token)
                    );
                    value.cursor = token + 1;
                    Result::Ok(())
                } else {
                    if(pattern_binder_named(&*binders, name, 0)) {
                        Result::Err(
                            BodyError::DuplicatePatternBinder(token, related)
                        )
                    } else {
                        Vec::push(
                            &mut *binders,
                            PatternBinder::Binding(name, token)
                        );
                        value.cursor = token + 1;
                        Result::Ok(())
                    }
                }
            }
        },
        _ => Result::Err(BodyError::ExpectedIdentifier(token, related))
    }
}

parse_pattern_binders(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    binders: &mut Vec<PatternBinder>,
    open: usize
) -> Result<(), BodyError> {
    if(value.cursor < value.limit) {
        if(super::lexer::token_code_at(source, value.cursor) == 12) {
            value.cursor = value.cursor + 1;
            Result::Ok(())
        } else {
            try(parse_pattern_binder(
                source,
                value,
                binders,
                open
            ), @parse_pattern_binders);
            if(value.cursor < value.limit) {
                handle super::lexer::token_code_at(
                    source,
                    value.cursor
                ) {
                    12 => {
                        value.cursor = value.cursor + 1;
                        Result::Ok(())
                    },
                    17 => {
                        value.cursor = value.cursor + 1;
                        parse_pattern_binders(
                            source,
                            value,
                            binders,
                            open
                        )
                    },
                    _ => Result::Err(BodyError::ExpectedCallClose(
                        value.cursor,
                        open
                    ))
                }
            } else {
                Result::Err(BodyError::ExpectedCallClose(value.cursor, open))
            }
        }
    } else {
        Result::Err(BodyError::ExpectedCallClose(value.cursor, open))
    }
}

identifier_name(
    source: &super::lexer::LexedSource,
    token: usize,
    related: usize
) -> Result<Id<String>, BodyError> {
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => Result::Ok(name),
        _ => Result::Err(BodyError::ExpectedIdentifier(token, related))
    }
}

parse_handle_arm(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16
) -> Result<PendingHandleArm, BodyError> {
    let enum_token = value.cursor;
    let enum_name = try(identifier_name(
        source,
        enum_token,
        enum_token
    ), @parse_handle_arm);
    let separator = enum_token + 1;
    if(separator < value.limit
        and {
            super::lexer::token_code_at(source, separator) == 19
        }) {
        let variant_token = separator + 1;
        if(variant_token < value.limit) {
            let variant_name = try(identifier_name(
                source,
                variant_token,
                separator
            ), @parse_handle_arm);
            value.cursor = variant_token + 1;
            let binders = Vec::new();
            if(value.cursor < value.limit
                and {
                    super::lexer::token_code_at(
                        source,
                        value.cursor
                    ) == 11
                }) {
                let open = value.cursor;
                value.cursor = open + 1;
                try(parse_pattern_binders(
                    source,
                    value,
                    &mut binders,
                    open
                ), @parse_handle_arm)
            } else { () };
            if(value.cursor < value.limit
                and {
                    super::lexer::token_code_at(
                        source,
                        value.cursor
                    ) == 24
                }) {
                value.cursor = value.cursor + 1;
                let body = try(parse_expression(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    0,
                    depth + 1
                ), @parse_handle_arm);
                Result::Ok(PendingHandleArm {
                    enum_name: enum_name,
                    enum_token: enum_token,
                    variant_name: variant_name,
                    variant_token: variant_token,
                    binders: binders,
                    body: body
                })
            } else {
                Result::Err(BodyError::InvalidHandleArm(
                    value.cursor,
                    variant_token
                ))
            }
        } else {
            Result::Err(BodyError::ExpectedIdentifier(
                variant_token,
                separator
            ))
        }
    } else {
        Result::Err(BodyError::ExpectedIdentifier(separator, enum_token))
    }
}

parse_handle_arms(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    open: usize,
    output: &mut Vec<PendingHandleArm>
) -> Result<(), BodyError> {
    if(value.cursor < value.limit) {
        if(super::lexer::token_code_at(source, value.cursor) == 14) {
            value.cursor = value.cursor + 1;
            Result::Ok(())
        } else {
            let arm = try(parse_handle_arm(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth
            ), @parse_handle_arms);
            Vec::push(&mut *output, arm);
            if(value.cursor < value.limit) {
                let separator =
                    super::lexer::token_code_at(source, value.cursor);
                if(separator == 17 or { separator == 22 }) {
                    value.cursor = value.cursor + 1;
                    ()
                } else { () };
                parse_handle_arms(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    open,
                    output
                )
            } else {
                Result::Err(BodyError::ExpectedBlockClose(value.cursor, open))
            }
        }
    } else {
        Result::Err(BodyError::ExpectedBlockClose(value.cursor, open))
    }
}

append_pattern_binders(
    values: VecIntoIter<PatternBinder>,
    output: &mut Vec<PatternBinder>
) {
    handle VecIntoIter::next(values) {
        None => (),
        Option::Some((value, remaining)) => {
            Vec::push(&mut *output, value);
            append_pattern_binders(remaining, output)
        }
    }
}

append_handle_arms(
    values: VecIntoIter<PendingHandleArm>,
    value: &mut BodyParser
) {
    handle VecIntoIter::next(values) {
        None => (),
        Option::Some((arm, remaining)) => {
            let PendingHandleArm {
                enum_name,
                enum_token,
                variant_name,
                variant_token,
                binders,
                body
            } = arm;
            let binder_start = Vec::len(&value.pattern_binders);
            let binder_count = Vec::len(&binders);
            append_pattern_binders(
                Vec::into_iter(binders),
                &mut value.pattern_binders
            );
            let arm_ordinal = Vec::len(&value.handle_arms);
            Vec::push(&mut value.handle_arms, HandleArm {
                enum_name: enum_name,
                enum_token: enum_token,
                variant_name: variant_name,
                variant_token: variant_token,
                binders: expression_range(
                    binder_start,
                    binder_start + binder_count
                ),
                body: body
            });
            Vec::push(&mut value.edges, ExprEdge {
                value: body,
                position: 1,
                metadata: u32_from_usize(arm_ordinal)
            });
            append_handle_arms(remaining, value)
        }
    }
}

push_handle(
    value: &mut BodyParser,
    subject: ExprId,
    arms: Vec<PendingHandleArm>,
    start: usize,
    end: usize
) -> ExprId {
    let name_start = name_count(&value.names);
    let edge_start = Vec::len(&value.edges);
    let arm_start = Vec::len(&value.handle_arms);
    Vec::push(&mut value.edges, ExprEdge {
        value: subject,
        position: 0,
        metadata: 0
    });
    append_handle_arms(Vec::into_iter(arms), value);
    let edge_end = Vec::len(&value.edges);
    let arm_end = Vec::len(&value.handle_arms);
    alloc_node(&mut value.nodes, ExprNode {
        kind_code: 12,
        tokens: token_range(start, end),
        operator: empty_tokens(start),
        names: expression_range(name_start, name_start),
        children: expression_range(edge_start, edge_end),
        handle_arms: expression_range(arm_start, arm_end)
    })
}

parse_handle(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    start: usize
) -> Result<ExprId, BodyError> {
    value.cursor = start + 1;
    let subject = try(parse_expression(
        original,
        source,
        declarations,
        nominal,
        value,
        owner,
        0,
        depth + 1
    ), @parse_handle);
    let open = value.cursor;
    if(open < value.limit
        and { super::lexer::token_code_at(source, open) == 13 }) {
        value.cursor = open + 1;
        let arms = Vec::new();
        try(parse_handle_arms(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth + 1,
            open,
            &mut arms
        ), @parse_handle);
        Result::Ok(push_handle(
            value,
            subject,
            arms,
            start,
            value.cursor
        ))
    } else {
        Result::Err(BodyError::ExpectedBlockClose(open, start))
    }
}

parse_atom(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16
) -> Result<ExprId, BodyError> {
    let start = value.cursor;
    if(start < value.limit) {
        handle super::lexer::token_kind_at(source, start) {
            TokenKind::Keyword(Keyword::Handle) => parse_handle(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                start
            ),
            _ => handle super::lexer::token_code_at(source, start) {
            1 => parse_identifier(source, value, start),
            4 => {
                value.cursor = start + 1;
                Result::Ok(push_leaf(value, 2, start, value.cursor))
            },
            11 => if(start + 1 < value.limit) {
                if(super::lexer::token_code_at(
                    source,
                    start + 1
                ) == 12) {
                    value.cursor = start + 2;
                        Result::Ok(push_leaf(value, 3, start, value.cursor))
                } else {
                    value.cursor = start + 1;
                        let child = try(
                            parse_expression(
                                original,
                                source,
                                declarations,
                                nominal,
                                value,
                                owner,
                                0,
                                depth + 1
                            ),
                            @parse_atom
                        );
                        if(value.cursor < value.limit) {
                            handle
                                    super::lexer::token_code_at(
                                        source,
                                        value.cursor
                                    ) {
                                    12 => {
                                        value.cursor = value.cursor
                                            + 1;
                                        Result::Ok(push_unary(
                                            value,
                                            4,
                                            OperatorUse {
                                                fixity: 0,
                                                start: start,
                                                end: start,
                                                form: 0,
                                                precedence: 0
                                            },
                                            child,
                                            start,
                                            value.cursor
                                        ))
                                    },
                                    17 => {
                                        let elements = Vec::new();
                                        push_word(
                                            &mut elements,
                                            Id::to_u32(child)
                                        );
                                        value.cursor = value.cursor
                                            + 1;
                                        parse_tuple_tail(
                                            original,
                                            source,
                                            declarations,
                                            nominal,
                                            value,
                                            owner,
                                            depth + 1,
                                            start,
                                            &mut elements
                                        )
                                    },
                                    _ => Result::Err(
                                        BodyError::ExpectedGroupingClose(
                                            value.cursor,
                                            start
                                        )
                                    )
                                }
                        } else {
                            Result::Err(
                                    BodyError::ExpectedGroupingClose(
                                        value.cursor,
                                        start
                                    )
                                )
                        }
                }
            } else {
                Result::Err(BodyError::ExpectedGroupingClose(start, start))
            },
            13 => {
                value.cursor = start + 1;
                let statements = Vec::new();
                parse_block_contents(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth + 1,
                    start,
                    14,
                    &mut statements
                )
            },
            _ => Result::Err(BodyError::ExpectedExpression(start, start))
            }
        }
    } else {
        Result::Err(BodyError::ExpectedExpression(start, start))
    }
}

parse_call_arguments(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    arguments: &mut Vec<u32>,
    open: usize
) -> Result<(), BodyError> {
    if(value.cursor < value.limit) {
        if(super::lexer::token_code_at(
            source,
            value.cursor
        ) == 12) {
            value.cursor = value.cursor + 1;
                Result::Ok(())
        } else {
            let argument = try(
                    parse_expression(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        0,
                        depth
                    ),
                    @parse_call_arguments
                );
                push_word(&mut *arguments, Id::to_u32(argument));
                if(value.cursor < value.limit) {
                    handle
                        super::lexer::token_code_at(source, value.cursor) {
                        12 => {
                            value.cursor = value.cursor + 1;
                            Result::Ok(())
                        },
                        17 => {
                            value.cursor = value.cursor + 1;
                            parse_call_arguments(
                                original,
                                source,
                                declarations,
                                nominal,
                                value,
                                owner,
                                depth,
                                arguments,
                                open
                            )
                        },
                        _ => Result::Err(
                            BodyError::ExpectedCallClose(value.cursor, open)
                        )
                    }
                } else {
                    Result::Err(
                        BodyError::ExpectedCallClose(value.cursor, open)
                    )
                }
        }
    } else {
        Result::Err(BodyError::ExpectedCallClose(value.cursor, open))
    }
}

parse_struct_fields(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    constructor: ExprId,
    start: usize,
    open: usize,
    fields: &mut Vec<u32>
) -> Result<ExprId, BodyError> {
    if(value.cursor < value.limit) {
        if(super::lexer::token_code_at(source, value.cursor)
                == 14) {
            value.cursor = value.cursor + 1;
                Result::Ok(push_struct(
                    value,
                    constructor,
                    &*fields,
                    start,
                    value.cursor
                ))
        } else {
            let name_token = value.cursor;
                handle super::lexer::token_kind_at(source, name_token) {
                    TokenKind::Ident(name) => {
                        let colon = name_token + 1;
                        if(colon < value.limit) {
                            if(super::lexer::token_code_at(source, colon)
                                    == 18) {
                                value.cursor = colon + 1;
                                    let field = try(
                                        parse_expression(
                                            original,
                                            source,
                                            declarations,
                                            nominal,
                                            value,
                                            owner,
                                            0,
                                            depth
                                        ),
                                        @parse_struct_fields
                                    );
                                    push_word(
                                        &mut *fields,
                                        Id::to_u32(name)
                                    );
                                    push_word(
                                        &mut *fields,
                                        u32_from_usize(name_token)
                                    );
                                    push_word(
                                        &mut *fields,
                                        Id::to_u32(field)
                                    );
                                    if(value.cursor < value.limit) {
                                        handle
                                            super::lexer::token_code_at(
                                                source,
                                                value.cursor
                                            ) {
                                            14 => {
                                                value.cursor =
                                                    value.cursor
                                                    + 1;
                                                Result::Ok(push_struct(
                                                    value,
                                                    constructor,
                                                    &*fields,
                                                    start,
                                                    value.cursor
                                                ))
                                            },
                                            17 => {
                                                value.cursor =
                                                    value.cursor
                                                    + 1;
                                                parse_struct_fields(
                                                    original,
                                                    source,
                                                    declarations,
                                                    nominal,
                                                    value,
                                                    owner,
                                                    depth,
                                                    constructor,
                                                    start,
                                                    open,
                                                    fields
                                                )
                                            },
                                            _ => Result::Err(
                                                BodyError::InvalidStructField(
                                                    value.cursor,
                                                    open
                                                )
                                            )
                                        }
                                    } else {
                                        Result::Err(
                                            BodyError::InvalidStructField(
                                                value.cursor,
                                                open
                                            )
                                        )
                                    }
                            } else {
                                Result::Err(
                                    BodyError::InvalidStructField(
                                        colon,
                                        name_token
                                    )
                                )
                            }
                        } else {
                            Result::Err(
                                BodyError::InvalidStructField(colon, open)
                            )
                        }
                    },
                    _ => Result::Err(BodyError::InvalidStructField(
                        name_token,
                        open
                    ))
                }
        }
    } else {
        Result::Err(BodyError::InvalidStructField(value.cursor, open))
    }
}

parse_projection_name(
    original: &String,
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    subject: ExprId,
    dot: usize
) -> Result<ExprId, BodyError> {
    let token = dot + 1;
    if(token < value.limit) {
        handle super::lexer::token_kind_at(source, token) {
            TokenKind::Ident(name) => {
                value.cursor = token + 1;
                Result::Ok(push_projection(
                    value,
                    subject,
                    ExpressionName::Identifier(name, token),
                    value.cursor
                ))
            },
            TokenKind::Number(number) => if(super::lexer::number_is_float(&number)) {
                Result::Err(BodyError::ExpectedProjectionName(token, dot))
            } else {
                let text = range_text(
                        original,
                        source,
                        token,
                        token + 1
                    );
                    handle parse_u64(&text) {
                        Result::Err(_) =>
                            Result::Err(BodyError::ExpectedProjectionName(
                                token,
                                dot
                            )),
                        Result::Ok(field) => if(field <= 4294967295) {
                            value.cursor = token + 1;
                                Result::Ok(push_projection(
                                    value,
                                    subject,
                                    ExpressionName::TupleField(
                                        wrapping_convert_to_u32(field),
                                        token
                                    ),
                                    value.cursor
                                ))
                        } else {
                            Result::Err(BodyError::ExpectedProjectionName(
                                token,
                                dot
                            ))
                        }
                    }
            },
            _ => Result::Err(BodyError::ExpectedProjectionName(token, dot))
        }
    } else {
        Result::Err(BodyError::ExpectedProjectionName(token, dot))
    }
}

handler_clause_brace(
    source: &super::lexer::LexedSource,
    cursor: usize,
    limit: usize,
    depth: u16
) -> Bool {
    if(cursor < limit) {
        let code = super::lexer::token_code_at(source, cursor);
        if(code == 24 and { depth == 0 }) {
            true
        } else {
            if(code == 14 and { depth == 0 }) {
                false
            } else {
                let next_depth =
                    if(code == 11 or { code == 13 or { code == 15 } }) {
                        depth + 1
                    } else {
                        if(code == 12 or { code == 14 or { code == 16 } }) {
                            if(depth == 0) { 0 } else { depth - 1 }
                        } else { depth }
                    };
                handler_clause_brace(
                    source,
                    cursor + 1,
                    limit,
                    next_depth
                )
            }
        }
    } else { false }
}

parse_postfix(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    callee: ExprId
) -> Result<ExprId, BodyError> {
    if(value.cursor < value.limit) {
        if(depth < 128) {
            handle
                super::lexer::token_code_at(source, value.cursor) {
                11 => {
                    let start = node_tokens(&*value, callee).start;
                    let open = value.cursor;
                    let arguments = Vec::new();
                    value.cursor = open + 1;
                    try(
                        parse_call_arguments(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            depth + 1,
                            &mut arguments,
                            open
                        ),
                        @parse_postfix
                    );
                    let end = value.cursor;
                    let call = push_call(
                        value,
                        callee,
                        &arguments,
                        start,
                        end
                    );
                    parse_postfix(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth + 1,
                        call
                    )
                },
                13 => if(handler_clause_brace(
                    source,
                    value.cursor + 1,
                    value.limit,
                    0
                )) {
                    Result::Ok(callee)
                } else {
                    let found_kind = node_kind(&*value, callee);
                    let start = node_tokens(&*value, callee).start;
                    if(found_kind == 1) {
                        if(node_name_count(&*value, callee)
                                == 1) {
                            let open = value.cursor;
                            let fields = Vec::new();
                            value.cursor = open + 1;
                            let found = try(
                                parse_struct_fields(
                                    original,
                                    source,
                                    declarations,
                                    nominal,
                                    value,
                                    owner,
                                    depth + 1,
                                    callee,
                                    start,
                                    open,
                                    &mut fields
                                ),
                                @parse_postfix
                            );
                            parse_postfix(
                                original,
                                source,
                                declarations,
                                nominal,
                                value,
                                owner,
                                depth + 1,
                                found
                            )
                        } else {
                            Result::Ok(callee)
                        }
                    } else {
                        Result::Ok(callee)
                    }
                },
                21 => {
                    let dot = value.cursor;
                    let found = try(
                        parse_projection_name(
                            original,
                            source,
                            value,
                            callee,
                            dot
                        ),
                        @parse_postfix
                    );
                    parse_postfix(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth + 1,
                        found
                    )
                },
                _ => Result::Ok(callee)
            }
        } else {
            Result::Err(
                BodyError::ExpressionDepthLimit(value.cursor, value.cursor)
            )
        }
    } else {
        Result::Ok(callee)
    }
}

infix_separated(
    source: &super::lexer::LexedSource,
    value: &BodyParser,
    left: ExprId,
    operator: OperatorUse
) -> Bool {
    super::lexer::token_code_at(source, operator.start) == 1
        or {
            let left_end = node_tokens(value, left).end;
            let left_span = token_span(source, left_end - 1);
            let operator_span = token_span(source, operator.start);
            super::lexer::span_end(&left_span)
                != super::lexer::span_start(&operator_span)
                and { operator.end < value.limit }
                and {
                        let last = token_span(
                            source,
                            operator.end - 1
                        );
                        let next = token_span(source, operator.end);
                        super::lexer::span_end(&last)
                            != super::lexer::span_start(&next)
                }
        }
}

parse_chain(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    minimum: u8,
    depth: u16,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) -> Result<ExprId, BodyError> {
    let found = try(
        peek_operator(
            original,
            source,
            declarations,
            nominal,
            &*value,
            false,
            owner
        ),
        @parse_chain
    );
    handle found {
            Result::Err(_) => finish_chain(value, output, pending),
            Result::Ok(operator) => if(operator.precedence < minimum) {
                finish_chain(value, output, pending)
            } else {
                let left = last_expr(output);
                    if(infix_separated(source, &*value, left, operator)) {
                        value.cursor = operator.end;
                            let operand = try(
                                parse_primary(
                                    original,
                                    source,
                                    declarations,
                                    nominal,
                                    value,
                                    owner,
                                    depth
                                ),
                                @parse_chain
                            );
                            try(
                                prepare_operator(
                                    &mut *value,
                                    &mut *output,
                                    &mut *pending,
                                    operator
                                ),
                                @parse_chain
                            );
                            Vec::push(&mut *pending, operator);
                            Vec::push(&mut *output, operand);
                            parse_chain(
                                original,
                                source,
                                declarations,
                                nominal,
                                value,
                                owner,
                                minimum,
                                depth,
                                output,
                                pending
                            )
                    } else {
                        finish_chain(value, output, pending)
                    }
            }
    }
}

reduce_once(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) {
    let operator = pop_operator(&mut *pending);
    let right = pop_expr(&mut *output);
    let left = pop_expr(&mut *output);
    let grouped = push_binary(value, operator, left, right);
    Vec::push(&mut *output, grouped)
}

prepare_operator(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>,
    incoming: OperatorUse
) -> Result<(), BodyError> {
    if(Vec::len(&*pending) == 0) {
        Result::Ok(())
    } else {
        let top = last_operator(&*pending);
            if(top.precedence > incoming.precedence) {
                reduce_once(&mut *value, &mut *output, &mut *pending);
                    prepare_operator(value, output, pending, incoming)
            } else {
                if(top.precedence == incoming.precedence) {
                    if(top.form == incoming.form) {
                        handle incoming.form {
                            2 => {
                                reduce_once(
                                    &mut *value,
                                    &mut *output,
                                    &mut *pending
                                );
                                prepare_operator(
                                    value,
                                    output,
                                    pending,
                                    incoming
                                )
                            },
                            3 => Result::Ok(()),
                            _ => Result::Err(
                                BodyError::NonAssociativeChain(
                                    incoming.start,
                                    top.start
                                )
                            )
                        }
                    } else {
                        Result::Err(
                            BodyError::IncompatibleAssociativity(
                                incoming.start,
                                top.start
                            )
                        )
                    }
                } else {
                    Result::Ok(())
                }
            }
    }
}

finish_chain(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) -> Result<ExprId, BodyError> {
    if(Vec::len(&*pending) == 0) {
        Result::Ok(pop_expr(&mut *output))
    } else {
        reduce_once(&mut *value, &mut *output, &mut *pending);
            finish_chain(value, output, pending)
    }
}

parse_expression(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    minimum: u8,
    depth: u16
) -> Result<ExprId, BodyError> {
    let first = try(
        parse_primary(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth
        ),
        @parse_expression
    );
    let output = Vec::new();
    let pending = Vec::new();
    Vec::push(&mut output, first);
    parse_chain(
        original,
        source,
        declarations,
        nominal,
        value,
        owner,
        minimum,
        depth,
        &mut output,
        &mut pending
    )
}

parse_block_statement(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    statements: &mut Vec<PendingStatement>
) -> Result<(), BodyError> {
    let start = value.cursor;
    handle super::lexer::token_kind_at(source, start) {
        TokenKind::Keyword(Keyword::Let) => {
            let name_token = start + 1;
            if(name_token < value.limit) {
                if(super::lexer::token_code_at(
                    source,
                    name_token
                ) == 1) {
                    let equals = name_token + 1;
                        if(equals < value.limit) {
                            if(super::lexer::token_code_at(source, equals)
                                    == 31) {
                                value.cursor = equals + 1;
                                    let initializer = try(
                                        parse_expression(
                                            original,
                                            source,
                                            declarations,
                                            nominal,
                                            value,
                                            owner,
                                            0,
                                            depth
                                        ),
                                        @parse_block_statement
                                    );
                                    push_statement(
                                        &mut *statements,
                                        1,
                                        Option::Some(name_token),
                                        initializer
                                    );
                                    Result::Ok(())
                            } else {
                                Result::Err(
                                    BodyError::InvalidLetSyntax(equals, start)
                                )
                            }
                        } else {
                            Result::Err(
                                BodyError::InvalidLetSyntax(equals, start)
                            )
                        }
                } else {
                    Result::Err(
                        BodyError::InvalidLetSyntax(name_token, start)
                    )
                }
            } else {
                Result::Err(BodyError::InvalidLetSyntax(name_token, start))
            }
        },
        _ => {
            let expression = try(
                parse_expression(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    0,
                    depth
                ),
                @parse_block_statement
            );
            push_statement(&mut *statements, 2, None, expression);
            Result::Ok(())
        }
    }
}

parse_block_after_statement(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    start: usize,
    close_code: u16,
    statements: &mut Vec<PendingStatement>
) -> Result<ExprId, BodyError> {
    if(value.cursor < value.limit) {
        handle super::lexer::token_code_at(
            source,
            value.cursor
        ) {
            22 => {
                value.cursor = value.cursor + 1;
                parse_block_contents(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    start,
                    close_code,
                    statements
                )
            },
            14 => if(close_code == 14) {
                parse_block_contents(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    start,
                    close_code,
                    statements
                )
            } else {
                Result::Err(
                    BodyError::ExpectedBlockClose(value.cursor, start)
                )
            },
            _ => Result::Err(BodyError::ExpectedBlockClose(
                value.cursor,
                start
            ))
        }
    } else {
        parse_block_contents(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth,
            start,
            close_code,
            statements
        )
    }
}

parse_block_contents(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<usize>,
    depth: u16,
    start: usize,
    close_code: u16,
    statements: &mut Vec<PendingStatement>
) -> Result<ExprId, BodyError> {
    if(value.cursor < value.limit) {
        if(close_code == 14) {
            if(super::lexer::token_code_at(
                source,
                value.cursor
            ) == 14) {
                value.cursor = value.cursor + 1;
                    Result::Ok(push_block(
                        value,
                        statements,
                        start,
                        value.cursor
                    ))
            } else {
                try(
                        parse_block_statement(
                            original,
                            source,
                            declarations,
                            nominal,
                            value,
                            owner,
                            depth,
                            statements
                        ),
                        @parse_block_contents
                    );
                    parse_block_after_statement(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth,
                        start,
                        close_code,
                        statements
                    )
            }
        } else {
            try(
                    parse_block_statement(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth,
                        statements
                    ),
                    @parse_block_contents
                );
                parse_block_after_statement(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    start,
                    close_code,
                    statements
                )
        }
    } else {
        if(close_code == 0) {
            Result::Ok(
                push_block(value, statements, start, value.cursor)
            )
        } else {
            Result::Err(
                BodyError::ExpectedBlockClose(value.cursor, start)
            )
        }
    }
}

pub parse_function_body(
    original: &String,
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    shell: usize
) -> Result<ParsedBody, BodyError> {
    handle super::scanner::shell_at(declarations, shell) {
        Result::Err(_) =>
            Result::Err(BodyError::MissingBodyShell(shell, shell)),
        Result::Ok(declaration) => if(super::scanner::shell_kind_code(declaration) == 12) {
            handle
                super::scanner::shell_body_range(declaration) {
                Result::Err(_) =>
                    Result::Err(BodyError::MissingBodyShell(shell, shell)),
                Result::Ok(body) => {
                    let start = super::scanner::range_start(&body);
                    let end = super::scanner::range_end(&body);
                    let parser = BodyParser {
                        cursor: start,
                        limit: end,
                        nodes: Arena::new(),
                        edges: Vec::new(),
                        names: Vec::new(),
                        handle_arms: Vec::new(),
                        pattern_binders: Vec::new()
                    };
                    let source = super::headers::parsed_source(headers);
                    let nominal = super::headers::nominal_index(headers);
                    let statements = Vec::new();
                    let root = try(
                        parse_block_contents(
                            original,
                            source,
                            declarations,
                            nominal,
                            &mut parser,
                            shell_owner(declarations, shell),
                            0,
                            start,
                            0,
                            &mut statements
                        ),
                        @parse_function_body
                    );
                    let BodyParser {
                        cursor: _,
                        limit: _,
                        nodes,
                        edges,
                        names,
                        handle_arms,
                        pattern_binders
                    } = parser;
                    Result::Ok(ParsedBody {
                        shell: u32_from_usize(shell),
                        root: root,
                        nodes: nodes,
                        edges: edges,
                        names: names,
                        handle_arms: handle_arms,
                        pattern_binders: pattern_binders
                    })
                }
            }
        } else {
            Result::Err(BodyError::MissingBodyShell(shell, shell))
        }
    }
}

write_string(output: &mut ByteBuf, value: &String) {
    let bytes = String::as_bytes(value);
    ByteBuf::write_u32_le(
        &mut *output,
        u32_from_usize(Bytes::len(&bytes))
    );
    ByteBuf::append_bytes( output, &bytes)
}

write_name_token(
    output: &mut ByteBuf,
    source: &super::lexer::LexedSource,
    token: usize
) -> Result<(), BodyError> {
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => handle super::lexer::lexeme(source, name) {
            Result::Err(_) =>
                Result::Err(BodyError::MissingEncodedName(token, token)),
            Result::Ok(text) => {
                write_string( output, text);
                Result::Ok(())
            }
        },
        _ => Result::Err(BodyError::MissingEncodedName(token, token))
    }
}

write_node_name(
    output: &mut ByteBuf,
    original: &String,
    source: &super::lexer::LexedSource,
    value: &ParsedBody,
    node: &ExprNode,
    ordinal: u32
) -> Result<(), BodyError> {
    let at = node.names.start + ordinal;
    handle *Vec::index(&value.names, usize_from_u32(at)) {
        ExpressionName::Identifier(name, token) =>
            handle super::lexer::lexeme(source, name) {
            Result::Err(_) =>
                Result::Err(BodyError::MissingEncodedName(token, token)),
            Result::Ok(text) => {
                write_string( output, text);
                Result::Ok(())
            }
        },
        ExpressionName::TupleField(_, token) => {
            let text = range_text(
                original,
                source,
                token,
                token + 1
            );
            write_string( output, &text);
            Result::Ok(())
        }
    }
}

write_children<'a>(
    output: &mut ByteBuf,
    original: &String,
    source: &super::lexer::LexedSource,
    value: &ParsedBody,
    children: Slice<'a, ExprEdge>
) -> Result<(), BodyError> {
    Slice::try_for_each(children, { edge =>
        write_expression(
            &mut *output,
            original,
            source,
            value,
            expression_edge_value(edge)
        )
    })
}

write_struct_fields<'a>(
    output: &mut ByteBuf,
    original: &String,
    source: &super::lexer::LexedSource,
    value: &ParsedBody,
    node: &ExprNode,
    fields: Slice<'a, ExprEdge>
) -> Result<(), BodyError> {
    Slice::try_for_each(fields, { edge =>
        write_node_name(
            &mut *output,
            original,
            source,
            value,
            node,
            expression_edge_metadata(edge)
        ) and {
            write_expression(
                &mut *output,
                original,
                source,
                value,
                expression_edge_value(edge)
            )
        }
    })
}

write_pattern_binders<'a>(
    output: &mut ByteBuf,
    source: &super::lexer::LexedSource,
    binders: Slice<'a, PatternBinder>
) -> Result<(), BodyError> {
    Slice::try_for_each(binders, { binder =>
        handle *binder {
            PatternBinder::Wildcard(_) => {
                ByteBuf::push(&mut *output, 0);
                Result::Ok(())
            },
            PatternBinder::Binding(name, token) => {
                ByteBuf::push(&mut *output, 1);
                handle super::lexer::lexeme(source, name) {
                    Result::Err(_) =>
                        Result::Err(BodyError::MissingEncodedName(
                            token,
                            token
                        )),
                    Result::Ok(text) => {
                        write_string(&mut *output, text);
                        Result::Ok(())
                    }
                }
            }
        }
    })
}

write_handle_arms<'a>(
    output: &mut ByteBuf,
    original: &String,
    source: &super::lexer::LexedSource,
    value: &ParsedBody,
    arms: Slice<'a, HandleArm>
) -> Result<(), BodyError> {
    Slice::try_for_each(arms, { arm =>
        handle super::lexer::lexeme(source, arm.enum_name) {
            Result::Err(_) => Result::Err(BodyError::MissingEncodedName(
                arm.enum_token,
                arm.enum_token
            )),
            Result::Ok(enum_name) => {
                write_string(&mut *output, enum_name);
                handle super::lexer::lexeme(source, arm.variant_name) {
                    Result::Err(_) => Result::Err(BodyError::MissingEncodedName(
                        arm.variant_token,
                        arm.variant_token
                    )),
                    Result::Ok(variant_name) => {
                        write_string(&mut *output, variant_name);
                        let binders = handle_arm_binders(value, arm);
                        ByteBuf::write_u32_le(
                            &mut *output,
                            u32_from_usize(Slice::len(binders))
                        );
                        try(write_pattern_binders(
                            &mut *output,
                            source,
                            binders
                        ), @write_handle_arms);
                        try(write_expression(
                            &mut *output,
                            original,
                            source,
                            value,
                            arm.body
                        ), @write_handle_arms);
                        Result::Ok(())
                    }
                }
            }
        }
    })
}

write_block_statements<'a>(
    output: &mut ByteBuf,
    original: &String,
    source: &super::lexer::LexedSource,
    value: &ParsedBody,
    statements: Slice<'a, ExprEdge>
) -> Result<(), BodyError> {
    Slice::try_for_each(statements, { statement =>
        handle expression_edge_position(statement) {
            1 => {
                ByteBuf::push(&mut *output, 1);
                let metadata = expression_edge_metadata(statement);
                write_name_token(
                    &mut *output,
                    source,
                    usize_from_u32(metadata - 1)
                ) and {
                    write_expression(
                        &mut *output,
                        original,
                        source,
                        value,
                        expression_edge_value(statement)
                    )
                }
            },
            _ => {
                ByteBuf::push(&mut *output, 2);
                write_expression(
                            &mut *output,
                            original,
                            source,
                            value,
                    expression_edge_value(statement)
                )
            }
        }
    })
}

write_expression(
    output: &mut ByteBuf,
    original: &String,
    source: &super::lexer::LexedSource,
    value: &ParsedBody,
    id: ExprId
) -> Result<(), BodyError> {
    let node = Arena::index(&value.nodes, id);
    let children = expression_edges(value, node);
    handle node.kind_code {
        1 => {
            ByteBuf::push(&mut *output, 1);
            let spelling = range_text(
                original,
                source,
                node.tokens.start,
                node.tokens.end
            );
            write_string( output, &spelling);
            Result::Ok(())
        },
        2 => {
            let text = range_text(
                original,
                source,
                node.tokens.start,
                node.tokens.end
            );
            handle parse_u64(&text) {
                Result::Err(_) => Result::Err(
                    BodyError::InvalidEncodedExpression(
                        node.tokens.start,
                        node.tokens.start
                    )
                ),
                Result::Ok(number) => {
                    ByteBuf::push(&mut *output, 2);
                    ByteBuf::write_u64_le( output, number);
                    Result::Ok(())
                }
            }
        },
        3 => {
            ByteBuf::push( output, 3);
            Result::Ok(())
        },
        4 => write_expression(
            output,
            original,
            source,
            value,
            expression_edge_value(edge_in_slice(children, 0))
        ),
        5 => {
            ByteBuf::push(&mut *output, 5);
            let spelling = range_text(
                original,
                source,
                node.operator.start,
                node.operator.end
            );
            write_string(&mut *output, &spelling);
            write_expression(
                 output,
                original,
                source,
                value,
                expression_edge_value(edge_in_slice(children, 0))
            )
        },
        6 => {
            ByteBuf::push(&mut *output, 6);
            let spelling = range_text(
                original,
                source,
                node.operator.start,
                node.operator.end
            );
            write_string(&mut *output, &spelling);
            try(
                write_expression(
                    &mut *output,
                    original,
                    source,
                    value,
                    expression_edge_value(edge_in_slice(children, 0))
                ),
                @write_expression
            );
            write_expression(
                 output,
                original,
                source,
                value,
                expression_edge_value(edge_in_slice(children, 1))
            )
        },
        7 => {
            ByteBuf::push(&mut *output, 7);
            try(
                write_expression(
                    &mut *output,
                    original,
                    source,
                    value,
                    expression_edge_value(edge_in_slice(children, 0))
                ),
                @write_expression
            );
            ByteBuf::write_u32_le(
                &mut *output,
                node.children.count - 1
            );
            write_children(
                 output,
                original,
                source,
                value,
                edge_suffix(children, 1)
            )
        },
        8 => {
            ByteBuf::push(&mut *output, 8);
            ByteBuf::write_u32_le(&mut *output, node.children.count);
            write_block_statements(
                 output,
                original,
                source,
                value,
                children
            )
        },
        9 => {
            ByteBuf::push(&mut *output, 9);
            ByteBuf::write_u32_le(&mut *output, node.children.count);
            write_children(output, original, source, value, children)
        },
        10 => {
            ByteBuf::push(&mut *output, 10);
            try(
                write_node_name(
                    &mut *output,
                    original,
                    source,
                    value,
                    node,
                    0
                ),
                @write_expression
            );
            ByteBuf::write_u32_le(
                &mut *output,
                node.children.count
            );
            write_struct_fields(
                 output,
                original,
                source,
                value,
                node,
                children
            )
        },
        11 => {
            ByteBuf::push(&mut *output, 11);
            try(
                write_expression(
                    &mut *output,
                    original,
                    source,
                    value,
                    expression_edge_value(edge_in_slice(children, 0))
                ),
                @write_expression
            );
            write_node_name(
                 output,
                original,
                source,
                value,
                node,
                0
            )
        },
        12 => {
            ByteBuf::push(&mut *output, 12);
            try(write_expression(
                &mut *output,
                original,
                source,
                value,
                expression_edge_value(edge_in_slice(children, 0))
            ), @write_expression);
            let arms = slice_handle_arms(value, &node.handle_arms);
            ByteBuf::write_u32_le(
                &mut *output,
                u32_from_usize(Slice::len(arms))
            );
            write_handle_arms(
                output,
                original,
                source,
                value,
                arms
            )
        },
        _ => Result::Err(BodyError::InvalidEncodedExpression(
            node.tokens.start,
            node.tokens.start
        ))
    }
}

function_count(
    declarations: &super::scanner::DeclarationIndex,
    index: usize,
    count: usize
) -> usize {
    if(index < super::scanner::shell_count(declarations)) {
        handle super::scanner::shell_at(declarations, index) {
            Result::Err(_) => count,
            Result::Ok(shell) => function_count(
                declarations,
                index + 1,
                if(super::scanner::shell_kind_code(shell) == 12) {
                    count + 1
                } else {
                    count
                }
            )
        }
    } else {
        count
    }
}

write_function_name(
    output: &mut ByteBuf,
    source: &super::lexer::LexedSource,
    shell: &super::scanner::DeclarationShell
) {
    handle Option::as_ref(super::scanner::shell_name(shell)) {
        Result::Err(_) => unreachable(),
        Result::Ok(name) => handle super::lexer::lexeme(source, *name) {
            Result::Err(_) => unreachable(),
            Result::Ok(text) => write_string( output, text)
        }
    }
}

write_functions(
    output: &mut ByteBuf,
    original: &String,
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    index: usize
) -> Result<(), BodyError> {
    if(index < super::scanner::shell_count(declarations)) {
        handle super::scanner::shell_at(declarations, index) {
            Result::Err(_) => Result::Ok(()),
            Result::Ok(shell) => if(super::scanner::shell_kind_code(shell) == 12) {
                let body = try(
                        parse_function_body(
                            original,
                            headers,
                            declarations,
                            index
                        ),
                        @write_functions
                    );
                    let source = super::headers::parsed_source(headers);
                    write_function_name(&mut *output, source, shell);
                    try(
                        write_expression(
                            &mut *output,
                            original,
                            source,
                            &body,
                            body.root
                        ),
                        @write_functions
                    );
                    write_functions(
                         output,
                        original,
                        headers,
                        declarations,
                        index + 1
                    )
            } else {
                write_functions(
                    output,
                    original,
                    headers,
                    declarations,
                    index + 1
                )
            }
        }
    } else {
        Result::Ok(())
    }
}

encode_source(output: &mut ByteBuf, source_text_value: String) {
    handle super::lexer::lex(&source_text_value) {
        Result::Err(_) => ByteBuf::push( output, 1),
        Result::Ok(lexed) => handle super::scanner::scan(&lexed) {
            Result::Err(_) => ByteBuf::push( output, 2),
            Result::Ok(declarations) => handle super::headers::parse(
                &source_text_value,
                 lexed,
                &declarations
            ) {
                Result::Err(_) => ByteBuf::push( output, 3),
                Result::Ok(headers) => {
                    let encoded = ByteBuf::new();
                    ByteBuf::write_u32_le(
                        &mut encoded,
                        u32_from_usize(
                            function_count(&declarations, 0, 0)
                        )
                    );
                    handle write_functions(
                        &mut encoded,
                        &source_text_value,
                        &headers,
                        &declarations,
                        0
                    ) {
                        Result::Err(_) => ByteBuf::push( output, 3),
                        Result::Ok(_) => {
                            ByteBuf::push(&mut *output, 0);
                            ByteBuf::append_bytes(
                                 output,
                                &ByteBuf::finish( encoded)
                            )
                        }
                    }
                }
            }
        }
    }
}

process_inputs(
    arguments: &Vec<String>,
    index: usize,
    output: &mut ByteBuf
) / FileRead {
    for_range(Range::new(index, Vec::len(arguments)), { current => {
        let path = *Vec::index(arguments, current);
        let bytes = read_file(path);
        handle String::from_utf8(bytes) {
            Result::Err(_) => ByteBuf::push(&mut *output, 1),
            Result::Ok(source) => encode_source(&mut *output, source)
        }
    }})
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    let count = Vec::len(&arguments);
    if(count < 2) {
        write_diagnostic(
            "usage: grandiose-self-host-bodies <output> <input>..."
        )
    } else {
        let output_path = *Vec::index(&arguments, 0);
            let encoded = ByteBuf::new();
            ByteBuf::write_u32_le(
                &mut encoded,
                u32_from_usize(count - 1)
            );
            process_inputs(&arguments, 1, &mut encoded);
            write_file(output_path, ByteBuf::finish( encoded))
    }
}

u32_from_usize(value: usize) -> u32 { wrapping_convert_to_u32( value) }

usize_from_u32(value: u32) -> usize { wrapping_convert_to_usize( value) }

u32_from_u8(value: u8) -> u32 { wrapping_convert_to_u32( value) }

u8_from_u32(value: u32) -> u8 { wrapping_convert_to_u8( value) }
