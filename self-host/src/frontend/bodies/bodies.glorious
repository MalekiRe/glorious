// One-body-at-a-time expression parsing and source-fixity grouping.
// Every node stores one semantic ExprKind; child roles are represented by
// typed side ranges rather than numeric node and edge tags.

use super::lexer::{Keyword, TokenKind};
use super::scanner::ShellId;
use super::syntax::{IdRange, TokenCursor, TokenSpan};

pub struct ExprTag {}
pub type ExprId = Id<ExprTag>;

pub struct HandleArmTag {}
pub type HandleArmId = Id<HandleArmTag>;

pub struct NameUseTag {}
pub struct ExprUseTag {}
pub struct BlockStatementTag {}
pub struct StructFieldTag {}
pub struct PatternBinderTag {}

pub type NameUseRange = IdRange<NameUseTag>;
pub type ExprUseRange = IdRange<ExprUseTag>;
pub type BlockStatementRange = IdRange<BlockStatementTag>;
pub type StructFieldRange = IdRange<StructFieldTag>;
pub type HandleArmRange = IdRange<HandleArmTag>;
pub type PatternBinderRange = IdRange<PatternBinderTag>;

pub enum ExpressionName {
    Identifier(Id<String>, usize),
    TupleField(u32, usize)
}

impl Use<[0, *]> for ExpressionName {}

pub enum PatternBinder {
    Wildcard(usize),
    Binding(Id<String>, usize)
}

impl Use<[0, *]> for PatternBinder {}

pub enum BlockStatement {
    Let(ExprId, usize),
    Expression(ExprId)
}

impl Use<[0, *]> for BlockStatement {}

pub struct StructField {
    name: Id<String>,
    name_token: usize,
    expression: ExprId
}

impl Use<[0, *]> for StructField {}

pub struct HandleArm {
    enum_name: Id<String>,
    enum_token: usize,
    variant_name: Id<String>,
    variant_token: usize,
    binders: PatternBinderRange,
    body: ExprId
}

impl Use<[0, *]> for HandleArm {}

pub enum ExprKind {
    Identifier(NameUseRange),
    Number,
    Unit,
    Group(ExprId),
    Prefix(TokenSpan, ExprId),
    Infix(TokenSpan, ExprId, ExprId),
    Call(ExprId, ExprUseRange),
    Block(BlockStatementRange),
    Tuple(ExprUseRange),
    Struct(ExpressionName, StructFieldRange),
    Projection(ExprId, ExpressionName),
    Handle(ExprId, HandleArmRange)
}

impl Use<[0, *]> for ExprKind {}

pub struct ExprNode {
    tokens: TokenSpan,
    kind: ExprKind
}

pub struct ParsedBody {
    shell: ShellId,
    root: ExprId,
    nodes: Arena<ExprTag, ExprNode>,
    names: Vec<ExpressionName>,
    expression_uses: Vec<ExprId>,
    block_statements: Vec<BlockStatement>,
    struct_fields: Vec<StructField>,
    handle_arms: Vec<HandleArm>,
    pattern_binders: Vec<PatternBinder>
}

pub enum ExprView<'a> {
    Identifier(TokenSpan, Slice<'a, ExpressionName>),
    Number(TokenSpan),
    Unit(TokenSpan),
    Group(TokenSpan, ExprId),
    Prefix(TokenSpan, TokenSpan, ExprId),
    Infix(TokenSpan, TokenSpan, ExprId, ExprId),
    Call(TokenSpan, ExprId, Slice<'a, ExprId>),
    Block(TokenSpan, Slice<'a, BlockStatement>),
    Tuple(TokenSpan, Slice<'a, ExprId>),
    Struct(TokenSpan, ExpressionName, Slice<'a, StructField>),
    Projection(TokenSpan, ExprId, ExpressionName),
    Handle(TokenSpan, ExprId, Slice<'a, HandleArm>)
}

impl<'a> Use<[0, *]> for ExprView<'a> {}

pub enum BodyError {
    ExpectedExpression(usize, usize),
    ExpectedGroupingClose(usize, usize),
    DuplicatePatternBinder(usize, usize),
    IncompatibleAssociativity(usize, usize),
    NonAssociativeChain(usize, usize),
    ConflictingFixity(usize, usize),
    ExpressionDepthLimit(usize, usize),
    MissingBodyShell(ShellId),
    InvalidEncodedExpression(usize, usize),
    ExpectedCallClose(usize, usize),
    InvalidLetSyntax(usize, usize),
    MissingEncodedName(usize, usize),
    ExpectedBlockClose(usize, usize),
    ExpectedIdentifier(usize, usize),
    ExpectedTupleDelimiter(usize, usize),
    InvalidHandleArm(usize, usize),
    InvalidStructField(usize, usize),
    ExpectedProjectionName(usize, usize)
}

struct BodyParser {
    cursor: TokenCursor,
    nodes: Arena<ExprTag, ExprNode>,
    names: Vec<ExpressionName>,
    expression_uses: Vec<ExprId>,
    block_statements: Vec<BlockStatement>,
    struct_fields: Vec<StructField>,
    handle_arms: Vec<HandleArm>,
    pattern_binders: Vec<PatternBinder>
}

struct OperatorUse {
    start: usize,
    end: usize,
    form: u8,
    precedence: u8
}

impl Use<[0, *]> for OperatorUse {}

pub error_code(value: &BodyError) -> u8 {
    handle *value {
        BodyError::ExpectedExpression(_, _) => 1,
        BodyError::ExpectedGroupingClose(_, _) => 2,
        BodyError::DuplicatePatternBinder(_, _) => 2,
        BodyError::IncompatibleAssociativity(_, _) => 3,
        BodyError::NonAssociativeChain(_, _) => 4,
        BodyError::ConflictingFixity(_, _) => 5,
        BodyError::ExpressionDepthLimit(_, _) => 6,
        BodyError::MissingBodyShell(_) => 7,
        BodyError::InvalidEncodedExpression(_, _) => 9,
        BodyError::ExpectedCallClose(_, _) => 10,
        BodyError::InvalidLetSyntax(_, _) => 11,
        BodyError::MissingEncodedName(_, _) => 11,
        BodyError::ExpectedBlockClose(_, _) => 12,
        BodyError::ExpectedIdentifier(_, _) => 13,
        BodyError::ExpectedTupleDelimiter(_, _) => 14,
        BodyError::InvalidHandleArm(_, _) => 15,
        BodyError::InvalidStructField(_, _) => 15,
        BodyError::ExpectedProjectionName(_, _) => 16
    }
}

pub error_token(value: &BodyError) -> usize {
    handle *value {
        BodyError::ExpectedExpression(token, _) => token,
        BodyError::ExpectedGroupingClose(token, _) => token,
        BodyError::DuplicatePatternBinder(token, _) => token,
        BodyError::IncompatibleAssociativity(token, _) => token,
        BodyError::NonAssociativeChain(token, _) => token,
        BodyError::ConflictingFixity(token, _) => token,
        BodyError::ExpressionDepthLimit(token, _) => token,
        BodyError::MissingBodyShell(shell) => Id::to_usize(shell),
        BodyError::InvalidEncodedExpression(token, _) => token,
        BodyError::ExpectedCallClose(token, _) => token,
        BodyError::InvalidLetSyntax(token, _) => token,
        BodyError::MissingEncodedName(token, _) => token,
        BodyError::ExpectedBlockClose(token, _) => token,
        BodyError::ExpectedIdentifier(token, _) => token,
        BodyError::ExpectedTupleDelimiter(token, _) => token,
        BodyError::InvalidHandleArm(token, _) => token,
        BodyError::InvalidStructField(token, _) => token,
        BodyError::ExpectedProjectionName(token, _) => token
    }
}

pub error_related(value: &BodyError) -> usize {
    handle *value {
        BodyError::ExpectedExpression(_, related) => related,
        BodyError::ExpectedGroupingClose(_, related) => related,
        BodyError::DuplicatePatternBinder(_, related) => related,
        BodyError::IncompatibleAssociativity(_, related) => related,
        BodyError::NonAssociativeChain(_, related) => related,
        BodyError::ConflictingFixity(_, related) => related,
        BodyError::ExpressionDepthLimit(_, related) => related,
        BodyError::MissingBodyShell(shell) => Id::to_usize(shell),
        BodyError::InvalidEncodedExpression(_, related) => related,
        BodyError::ExpectedCallClose(_, related) => related,
        BodyError::InvalidLetSyntax(_, related) => related,
        BodyError::MissingEncodedName(_, related) => related,
        BodyError::ExpectedBlockClose(_, related) => related,
        BodyError::ExpectedIdentifier(_, related) => related,
        BodyError::ExpectedTupleDelimiter(_, related) => related,
        BodyError::InvalidHandleArm(_, related) => related,
        BodyError::InvalidStructField(_, related) => related,
        BodyError::ExpectedProjectionName(_, related) => related
    }
}

alloc_node(value: &mut BodyParser, tokens: TokenSpan, kind: ExprKind) -> ExprId {
    handle Arena::alloc(&mut value.nodes, ExprNode {
        tokens: tokens,
        kind: kind
    }) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}

pub expression_count(value: &ParsedBody) -> usize { Arena::len(&value.nodes) }
pub body_shell(value: &ParsedBody) -> ShellId { value.shell }
pub body_root(value: &ParsedBody) -> ExprId { value.root }
pub expression_at<'a>(value: &'a ParsedBody, id: ExprId) -> &'a ExprNode {
    Arena::index(&value.nodes, id)
}
pub expression_tokens(value: &ParsedBody, id: ExprId) -> TokenSpan {
    expression_at(value, id).tokens
}
pub expression_token_start(value: &ParsedBody, id: ExprId) -> usize {
    super::syntax::token_start(&expression_at(value, id).tokens)
}
pub expression_token_end(value: &ParsedBody, id: ExprId) -> usize {
    super::syntax::token_end(&expression_at(value, id).tokens)
}

pub expression_view<'a>(value: &'a ParsedBody, id: ExprId) -> ExprView<'a> {
    let node = expression_at(value, id);
    handle node.kind {
        ExprKind::Identifier(range) => ExprView::Identifier(
            node.tokens,
            super::syntax::id_range_slice(&value.names, &range)
        ),
        ExprKind::Number => ExprView::Number(node.tokens),
        ExprKind::Unit => ExprView::Unit(node.tokens),
        ExprKind::Group(child) => ExprView::Group(node.tokens, child),
        ExprKind::Prefix(operator, child) =>
            ExprView::Prefix(node.tokens, operator, child),
        ExprKind::Infix(operator, left, right) =>
            ExprView::Infix(node.tokens, operator, left, right),
        ExprKind::Call(callee, arguments) => ExprView::Call(
            node.tokens,
            callee,
            super::syntax::id_range_slice(&value.expression_uses, &arguments)
        ),
        ExprKind::Block(statements) => ExprView::Block(
            node.tokens,
            super::syntax::id_range_slice(&value.block_statements, &statements)
        ),
        ExprKind::Tuple(elements) => ExprView::Tuple(
            node.tokens,
            super::syntax::id_range_slice(&value.expression_uses, &elements)
        ),
        ExprKind::Struct(name, fields) => ExprView::Struct(
            node.tokens,
            name,
            super::syntax::id_range_slice(&value.struct_fields, &fields)
        ),
        ExprKind::Projection(subject, name) =>
            ExprView::Projection(node.tokens, subject, name),
        ExprKind::Handle(subject, arms) => ExprView::Handle(
            node.tokens,
            subject,
            super::syntax::id_range_slice(&value.handle_arms, &arms)
        )
    }
}

pub handle_arm_count(value: &ParsedBody) -> usize { Vec::len(&value.handle_arms) }
pub handle_arm_id_at(index: usize) -> HandleArmId {
    handle Id::from_usize(index) {
        Result::Err(_) => unreachable(),
        Result::Ok(id) => id
    }
}
pub handle_arm_at<'a>(value: &'a ParsedBody, id: HandleArmId) -> &'a HandleArm {
    Vec::index(&value.handle_arms, Id::to_usize(id))
}
pub handle_arm_enum_name(value: &HandleArm) -> Id<String> { value.enum_name }
pub handle_arm_enum_token(value: &HandleArm) -> usize { value.enum_token }
pub handle_arm_variant_name(value: &HandleArm) -> Id<String> { value.variant_name }
pub handle_arm_variant_token(value: &HandleArm) -> usize { value.variant_token }
pub handle_arm_body(value: &HandleArm) -> ExprId { value.body }
pub handle_arm_binders<'a>(
    body: &'a ParsedBody,
    value: &HandleArm
) -> Slice<'a, PatternBinder> {
    super::syntax::id_range_slice(&body.pattern_binders, &value.binders)
}

pub expression_name_id(value: ExpressionName) -> Option<Id<String>> {
    handle value {
        ExpressionName::Identifier(name, _) => Some(name),
        ExpressionName::TupleField(_, _) => None
    }
}
pub expression_name_value(value: ExpressionName) -> u32 {
    handle value {
        ExpressionName::Identifier(name, _) => Id::to_u32(name),
        ExpressionName::TupleField(field, _) => field
    }
}
pub expression_name_token(value: ExpressionName) -> usize {
    handle value {
        ExpressionName::Identifier(_, token) => token,
        ExpressionName::TupleField(_, token) => token
    }
}
pub struct_field_name(value: &StructField) -> Id<String> { value.name }
pub struct_field_name_token(value: &StructField) -> usize { value.name_token }
pub struct_field_expression(value: &StructField) -> ExprId { value.expression }

position(value: &BodyParser) -> usize {
    super::syntax::cursor_position(&value.cursor)
}
limit(value: &BodyParser) -> usize {
    super::syntax::cursor_limit(&value.cursor)
}
set_position(value: &mut BodyParser, at: usize) {
    super::syntax::cursor_set(&mut value.cursor, at)
}

pop_operator(value: &mut Vec<OperatorUse>) -> OperatorUse {
    handle Vec::pop(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}
pop_expr(value: &mut Vec<ExprId>) -> ExprId {
    handle Vec::pop(value) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}
last_operator(value: &Vec<OperatorUse>) -> OperatorUse {
    *Vec::index(value, Vec::len(value) - 1)
}
last_expr(value: &Vec<ExprId>) -> ExprId {
    *Vec::index(value, Vec::len(value) - 1)
}

source_text(value: &String, start: usize, end: usize) -> String {
    handle String::slice(value, Range { start: start, end: end }) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

token_span(source: &super::lexer::LexedSource, index: usize) -> super::lexer::Span {
    handle super::lexer::token_at(source, index) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::lexer::token_span(token)
    }
}

range_text(
    original: &String,
    source: &super::lexer::LexedSource,
    span: &TokenSpan
) -> String {
    let start = super::syntax::token_start(span);
    let end = super::syntax::token_end(span);
    let first = token_span(source, start);
    let last = token_span(source, end - 1);
    source_text(
        original,
        super::lexer::span_start(&first),
        super::lexer::span_end(&last)
    )
}

node_tokens(value: &BodyParser, id: ExprId) -> TokenSpan {
    Arena::index(&value.nodes, id).tokens
}

node_is_single_identifier(value: &BodyParser, id: ExprId) -> Bool {
    handle Arena::index(&value.nodes, id).kind {
        ExprKind::Identifier(range) => super::syntax::id_range_count(&range) == 1,
        _ => false
    }
}

single_identifier_name(value: &BodyParser, id: ExprId) -> ExpressionName {
    handle Arena::index(&value.nodes, id).kind {
        ExprKind::Identifier(range) => *Slice::index(
            super::syntax::id_range_slice(&value.names, &range),
            0
        ),
        _ => unreachable()
    }
}

append_exprs(output: &mut Vec<ExprId>, values: &Vec<ExprId>) -> ExprUseRange {
    let start = Vec::len(output);
    for_range(Range::new(0, Vec::len(values)), { index =>
        Vec::push(output, *Vec::index(values, index))
    });
    super::syntax::id_range(start, Vec::len(output))
}

push_identifier(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    start: usize
) -> Result<ExprId, BodyError> {
    let name_start = Vec::len(&value.names);
    let cursor = start;
    let current = cursor;
    handle super::lexer::token_kind_at(source, current) {
        TokenKind::Ident(name) => Vec::push(
            &mut value.names,
            ExpressionName::Identifier(name, current)
        ),
        _ => @push_identifier(Result::Err(
            BodyError::ExpectedIdentifier(current, start)
        ))
    };
    set_position(value, current + 1);
    while_identifier_tail(source, value, start, name_start)
}

while_identifier_tail(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    start: usize,
    name_start: usize
) -> Result<ExprId, BodyError> {
    if(position(value) < limit(value)
        and { super::lexer::token_code_at(source, position(value)) == 19 }) {
        let separator = position(value);
        let token = separator + 1;
        if(token < limit(value)) {
            handle super::lexer::token_kind_at(source, token) {
                TokenKind::Ident(name) => Vec::push(
                    &mut value.names,
                    ExpressionName::Identifier(name, token)
                ),
                _ => @while_identifier_tail(Result::Err(
                    BodyError::ExpectedIdentifier(token, separator)
                ))
            };
            set_position(value, token + 1);
            while_identifier_tail(source, value, start, name_start)
        } else {
            Result::Err(BodyError::ExpectedIdentifier(token, separator))
        }
    } else {
        Result::Ok(alloc_node(
            value,
            super::syntax::token_span(start, position(value)),
            ExprKind::Identifier(super::syntax::id_range(
                name_start,
                Vec::len(&value.names)
            ))
        ))
    }
}

push_number(value: &mut BodyParser, start: usize, end: usize) -> ExprId {
    alloc_node(value, super::syntax::token_span(start, end), ExprKind::Number)
}
push_unit(value: &mut BodyParser, start: usize, end: usize) -> ExprId {
    alloc_node(value, super::syntax::token_span(start, end), ExprKind::Unit)
}
push_group(value: &mut BodyParser, child: ExprId, start: usize, end: usize) -> ExprId {
    alloc_node(value, super::syntax::token_span(start, end), ExprKind::Group(child))
}
push_prefix(
    value: &mut BodyParser,
    operator: OperatorUse,
    child: ExprId,
    start: usize,
    end: usize
) -> ExprId {
    alloc_node(
        value,
        super::syntax::token_span(start, end),
        ExprKind::Prefix(
            super::syntax::token_span(operator.start, operator.end),
            child
        )
    )
}
push_infix(
    value: &mut BodyParser,
    operator: OperatorUse,
    left: ExprId,
    right: ExprId
) -> ExprId {
    alloc_node(
        value,
        super::syntax::token_span(
            super::syntax::token_start(&node_tokens(&*value, left)),
            super::syntax::token_end(&node_tokens(&*value, right))
        ),
        ExprKind::Infix(
            super::syntax::token_span(operator.start, operator.end),
            left,
            right
        )
    )
}
push_call(
    value: &mut BodyParser,
    callee: ExprId,
    arguments: &Vec<ExprId>,
    start: usize,
    end: usize
) -> ExprId {
    let range = append_exprs(&mut value.expression_uses, arguments);
    alloc_node(
        value,
        super::syntax::token_span(start, end),
        ExprKind::Call(callee, range)
    )
}
push_tuple(
    value: &mut BodyParser,
    elements: &Vec<ExprId>,
    start: usize,
    end: usize
) -> ExprId {
    let range = append_exprs(&mut value.expression_uses, elements);
    alloc_node(
        value,
        super::syntax::token_span(start, end),
        ExprKind::Tuple(range)
    )
}
push_struct(
    value: &mut BodyParser,
    constructor: ExprId,
    fields: &Vec<StructField>,
    start: usize,
    end: usize
) -> ExprId {
    let field_start = Vec::len(&value.struct_fields);
    for_range(Range::new(0, Vec::len(fields)), { index =>
        Vec::push(&mut value.struct_fields, *Vec::index(fields, index))
    });
    alloc_node(
        value,
        super::syntax::token_span(start, end),
        ExprKind::Struct(
            single_identifier_name(&*value, constructor),
            super::syntax::id_range(field_start, Vec::len(&value.struct_fields))
        )
    )
}
push_projection(
    value: &mut BodyParser,
    subject: ExprId,
    name: ExpressionName,
    end: usize
) -> ExprId {
    let start = super::syntax::token_start(&node_tokens(&*value, subject));
    alloc_node(
        value,
        super::syntax::token_span(start, end),
        ExprKind::Projection(subject, name)
    )
}
push_block(
    value: &mut BodyParser,
    statements: &Vec<BlockStatement>,
    start: usize,
    end: usize
) -> ExprId {
    let statement_start = Vec::len(&value.block_statements);
    for_range(Range::new(0, Vec::len(statements)), { index =>
        Vec::push(&mut value.block_statements, *Vec::index(statements, index))
    });
    alloc_node(
        value,
        super::syntax::token_span(start, end),
        ExprKind::Block(super::syntax::id_range(
            statement_start,
            Vec::len(&value.block_statements)
        ))
    )
}

append_pattern_binders(
    values: VecIntoIter<PatternBinder>,
    output: &mut Vec<PatternBinder>
) {
    handle VecIntoIter::next(values) {
        None => (),
        Some((found, remaining)) => {
            Vec::push(output, found);
            append_pattern_binders(remaining, output)
        }
    }
}

push_handle(
    value: &mut BodyParser,
    subject: ExprId,
    arms: Vec<HandleArm>,
    start: usize,
    end: usize
) -> ExprId {
    let arm_start = Vec::len(&value.handle_arms);
    let remaining = Vec::into_iter(arms);
    append_handle_values(remaining, &mut value.handle_arms);
    alloc_node(
        value,
        super::syntax::token_span(start, end),
        ExprKind::Handle(subject, super::syntax::id_range(
            arm_start,
            Vec::len(&value.handle_arms)
        ))
    )
}

append_handle_values(values: VecIntoIter<HandleArm>, output: &mut Vec<HandleArm>) {
    handle VecIntoIter::next(values) {
        None => (),
        Some((found, remaining)) => {
            Vec::push(output, found);
            append_handle_values(remaining, output)
        }
    }
}

shell_owner(
    declarations: &super::scanner::DeclarationIndex,
    shell: ShellId
) -> Option<ShellId> {
    handle super::scanner::shell_at(declarations, shell) {
        None => None,
        Some(found) => *super::scanner::shell_parent(found)
    }
}

fixity_owner(
    declarations: &super::scanner::DeclarationIndex,
    value: &super::headers::FixityHeader
) -> Option<ShellId> {
    shell_owner(declarations, super::headers::fixity_shell(value))
}

operator_range(
    source: &super::lexer::LexedSource,
    cursor: usize,
    limit: usize
) -> Option<TokenSpan> {
    if(cursor < limit) {
        if(super::lexer::token_code_at(source, cursor) == 1) {
            Some(super::syntax::token_span(cursor, cursor + 1))
        } else if(super::lexer::operator_symbol_at(source, cursor)) {
            let first = token_span(source, cursor);
            let end = super::lexer::operator_end(
                source,
                cursor + 1,
                limit,
                super::lexer::span_end(&first)
            );
            Some(super::syntax::token_span(cursor, end))
        } else { None }
    } else { None }
}

same_operator(
    original: &String,
    source: &super::lexer::LexedSource,
    found: &TokenSpan,
    declared_start: usize,
    declared_end: usize
) -> Bool {
    range_text(original, source, found)
        == range_text(
            original,
            source,
            &super::syntax::token_span(declared_start, declared_end)
        )
}

form_matches(form: u8, prefix: Bool) -> Bool {
    if(prefix) { form == 1 } else { form != 1 }
}

lookup_scope(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    operator: &TokenSpan,
    prefix: Bool,
    owner: Option<ShellId>,
    index: usize,
    selected: Option<u32>
) -> Result<Option<u32>, BodyError> {
    if(index < super::headers::fixity_count(nominal)) {
        handle super::headers::fixity_at(nominal, index) {
            None => Result::Ok(selected),
            Some(fixity) => {
                let form = super::headers::fixity_form_code(fixity);
                let matches = fixity_owner(declarations, fixity) == owner
                    and { form_matches(form, prefix) }
                    and { same_operator(
                        original,
                        source,
                        operator,
                        super::headers::fixity_operator_start(fixity),
                        super::headers::fixity_operator_end(fixity)
                    ) };
                if(matches) {
                    handle selected {
                        None => lookup_scope(
                            original,
                            source,
                            declarations,
                            nominal,
                            operator,
                            prefix,
                            owner,
                            index + 1,
                            Some(wrapping_convert_to_u32(index))
                        ),
                        Some(previous) => {
                            let old = wrapping_convert_to_usize(previous);
                            if(super::headers::fixity_form_at(nominal, old) == form
                                and {
                                    super::headers::fixity_precedence_at(nominal, old)
                                        == super::headers::fixity_precedence(fixity)
                                }) {
                                lookup_scope(
                                    original,
                                    source,
                                    declarations,
                                    nominal,
                                    operator,
                                    prefix,
                                    owner,
                                    index + 1,
                                    Some(previous)
                                )
                            } else {
                                Result::Err(BodyError::ConflictingFixity(
                                    super::syntax::token_start(operator),
                                    super::headers::fixity_operator_start_at(nominal, old)
                                ))
                            }
                        }
                    }
                } else {
                    lookup_scope(
                        original,
                        source,
                        declarations,
                        nominal,
                        operator,
                        prefix,
                        owner,
                        index + 1,
                        selected
                    )
                }
            }
        }
    } else { Result::Ok(selected) }
}

lookup_fixity(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    operator: &TokenSpan,
    prefix: Bool,
    owner: Option<ShellId>
) -> Result<Option<u32>, BodyError> {
    let local = try(lookup_scope(
        original,
        source,
        declarations,
        nominal,
        operator,
        prefix,
        owner,
        0,
        None
    ), @lookup_fixity);
    handle local {
        Some(_) => Result::Ok(local),
        None => if(Option::is_none(&owner)) {
            Result::Ok(None)
        } else {
            lookup_scope(
                original,
                source,
                declarations,
                nominal,
                operator,
                prefix,
                None,
                0,
                None
            )
        }
    }
}

peek_operator(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &BodyParser,
    prefix: Bool,
    owner: Option<ShellId>
) -> Result<Option<OperatorUse>, BodyError> {
    handle operator_range(source, position(value), limit(value)) {
        None => Result::Ok(None),
        Some(range) => handle try(lookup_fixity(
            original,
            source,
            declarations,
            nominal,
            &range,
            prefix,
            owner
        ), @peek_operator) {
            None => Result::Ok(None),
            Some(index) => {
                let ordinal = wrapping_convert_to_usize(index);
                Result::Ok(Some(OperatorUse {
                    start: super::syntax::token_start(&range),
                    end: super::syntax::token_end(&range),
                    form: super::headers::fixity_form_at(nominal, ordinal),
                    precedence: super::headers::fixity_precedence_at(nominal, ordinal)
                }))
            }
        }
    }
}

parse_primary(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16
) -> Result<ExprId, BodyError> {
    if(depth >= 128) {
        Result::Err(BodyError::ExpressionDepthLimit(position(value), position(value)))
    } else {
        handle try(peek_operator(
            original,
            source,
            declarations,
            nominal,
            &*value,
            true,
            owner
        ), @parse_primary) {
            Some(operator) => {
                set_position(value, operator.end);
                let child = try(parse_expression(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    operator.precedence,
                    depth + 1
                ), @parse_primary);
                Result::Ok(push_prefix(
                    value,
                    operator,
                    child,
                    operator.start,
                    super::syntax::token_end(&node_tokens(&*value, child))
                ))
            },
            None => {
                let atom = try(parse_atom(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth
                ), @parse_primary);
                parse_postfix(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth,
                    atom
                )
            }
        }
    }
}

parse_tuple_tail(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize,
    elements: &mut Vec<ExprId>
) -> Result<ExprId, BodyError> {
    if(position(value) >= limit(value)) {
        Result::Err(BodyError::ExpectedTupleDelimiter(position(value), start))
    } else if(super::lexer::token_code_at(source, position(value)) == 12) {
        set_position(value, position(value) + 1);
        Result::Ok(push_tuple(value, elements, start, position(value)))
    } else {
        Vec::push(elements, try(parse_expression(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            0,
            depth
        ), @parse_tuple_tail));
        if(position(value) < limit(value)) {
            handle super::lexer::token_code_at(source, position(value)) {
                12 => {
                    set_position(value, position(value) + 1);
                    Result::Ok(push_tuple(value, elements, start, position(value)))
                },
                17 => {
                    set_position(value, position(value) + 1);
                    parse_tuple_tail(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth,
                        start,
                        elements
                    )
                },
                _ => Result::Err(
                    BodyError::ExpectedTupleDelimiter(position(value), start)
                )
            }
        } else {
            Result::Err(BodyError::ExpectedTupleDelimiter(position(value), start))
        }
    }
}

pattern_binder_named(
    value: &Vec<PatternBinder>,
    name: Id<String>,
    index: usize
) -> Bool {
    if(index < Vec::len(value)) {
        handle *Vec::index(value, index) {
            PatternBinder::Wildcard(_) => pattern_binder_named(value, name, index + 1),
            PatternBinder::Binding(found, _) => if(found == name) {
                true
            } else { pattern_binder_named(value, name, index + 1) }
        }
    } else { false }
}

parse_pattern_binder(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    binders: &mut Vec<PatternBinder>,
    related: usize
) -> Result<(), BodyError> {
    let token = position(value);
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => handle super::lexer::lexeme(source, name) {
            Result::Err(_) => Result::Err(BodyError::ExpectedIdentifier(token, related)),
            Result::Ok(text) => if(*text == "_") {
                Vec::push(binders, PatternBinder::Wildcard(token));
                set_position(value, token + 1);
                Result::Ok(())
            } else if(pattern_binder_named(&*binders, name, 0)) {
                Result::Err(BodyError::DuplicatePatternBinder(token, related))
            } else {
                Vec::push(binders, PatternBinder::Binding(name, token));
                set_position(value, token + 1);
                Result::Ok(())
            }
        },
        _ => Result::Err(BodyError::ExpectedIdentifier(token, related))
    }
}

parse_pattern_binders(
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    binders: &mut Vec<PatternBinder>,
    open: usize
) -> Result<(), BodyError> {
    if(position(value) >= limit(value)) {
        Result::Err(BodyError::ExpectedCallClose(position(value), open))
    } else if(super::lexer::token_code_at(source, position(value)) == 12) {
        set_position(value, position(value) + 1);
        Result::Ok(())
    } else {
        try(parse_pattern_binder(source, value, binders, open), @parse_pattern_binders);
        if(position(value) < limit(value)) {
            handle super::lexer::token_code_at(source, position(value)) {
                12 => {
                    set_position(value, position(value) + 1);
                    Result::Ok(())
                },
                17 => {
                    set_position(value, position(value) + 1);
                    parse_pattern_binders(source, value, binders, open)
                },
                _ => Result::Err(BodyError::ExpectedCallClose(position(value), open))
            }
        } else {
            Result::Err(BodyError::ExpectedCallClose(position(value), open))
        }
    }
}

identifier_name(
    source: &super::lexer::LexedSource,
    token: usize,
    related: usize
) -> Result<Id<String>, BodyError> {
    handle super::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => Result::Ok(name),
        _ => Result::Err(BodyError::ExpectedIdentifier(token, related))
    }
}

parse_handle_arm(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16
) -> Result<HandleArm, BodyError> {
    let enum_token = position(value);
    let enum_name = try(identifier_name(source, enum_token, enum_token), @parse_handle_arm);
    let separator = enum_token + 1;
    if(separator >= limit(value)
        or { super::lexer::token_code_at(source, separator) != 19 }) {
        Result::Err(BodyError::ExpectedIdentifier(separator, enum_token))
    } else {
        let variant_token = separator + 1;
        let variant_name = try(identifier_name(
            source,
            variant_token,
            separator
        ), @parse_handle_arm);
        set_position(value, variant_token + 1);
        let binders = Vec::new();
        if(position(value) < limit(value)
            and { super::lexer::token_code_at(source, position(value)) == 11 }) {
            let open = position(value);
            set_position(value, open + 1);
            try(parse_pattern_binders(source, value, &mut binders, open), @parse_handle_arm)
        } else { () };
        if(position(value) >= limit(value)
            or { super::lexer::token_code_at(source, position(value)) != 24 }) {
            Result::Err(BodyError::InvalidHandleArm(position(value), variant_token))
        } else {
            set_position(value, position(value) + 1);
            let body = try(parse_expression(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                0,
                depth + 1
            ), @parse_handle_arm);
            let binder_start = Vec::len(&value.pattern_binders);
            let binder_count = Vec::len(&binders);
            append_pattern_binders(Vec::into_iter(binders), &mut value.pattern_binders);
            Result::Ok(HandleArm {
                enum_name: enum_name,
                enum_token: enum_token,
                variant_name: variant_name,
                variant_token: variant_token,
                binders: super::syntax::id_range(
                    binder_start,
                    binder_start + binder_count
                ),
                body: body
            })
        }
    }
}

parse_handle_arms(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    open: usize,
    output: &mut Vec<HandleArm>
) -> Result<(), BodyError> {
    if(position(value) >= limit(value)) {
        Result::Err(BodyError::ExpectedBlockClose(position(value), open))
    } else if(super::lexer::token_code_at(source, position(value)) == 14) {
        set_position(value, position(value) + 1);
        Result::Ok(())
    } else {
        Vec::push(output, try(parse_handle_arm(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth
        ), @parse_handle_arms));
        if(position(value) < limit(value)) {
            let separator = super::lexer::token_code_at(source, position(value));
            if(separator == 17 or { separator == 22 }) {
                set_position(value, position(value) + 1)
            } else { () };
            parse_handle_arms(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                open,
                output
            )
        } else {
            Result::Err(BodyError::ExpectedBlockClose(position(value), open))
        }
    }
}

parse_handle(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize
) -> Result<ExprId, BodyError> {
    set_position(value, start + 1);
    let subject = try(parse_expression(
        original,
        source,
        declarations,
        nominal,
        value,
        owner,
        0,
        depth + 1
    ), @parse_handle);
    let open = position(value);
    if(open < limit(value)
        and { super::lexer::token_code_at(source, open) == 13 }) {
        set_position(value, open + 1);
        let arms = Vec::new();
        try(parse_handle_arms(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth + 1,
            open,
            &mut arms
        ), @parse_handle);
        Result::Ok(push_handle(value, subject, arms, start, position(value)))
    } else {
        Result::Err(BodyError::ExpectedBlockClose(open, start))
    }
}

parse_atom(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16
) -> Result<ExprId, BodyError> {
    let start = position(value);
    if(start >= limit(value)) {
        Result::Err(BodyError::ExpectedExpression(start, start))
    } else {
        handle super::lexer::token_kind_at(source, start) {
            TokenKind::Keyword(Keyword::Handle) => parse_handle(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                start
            ),
            _ => handle super::lexer::token_code_at(source, start) {
                1 => push_identifier(source, value, start),
                4 => {
                    set_position(value, start + 1);
                    Result::Ok(push_number(value, start, position(value)))
                },
                11 => if(start + 1 < limit(value)
                    and { super::lexer::token_code_at(source, start + 1) == 12 }) {
                    set_position(value, start + 2);
                    Result::Ok(push_unit(value, start, position(value)))
                } else {
                    set_position(value, start + 1);
                    let child = try(parse_expression(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        0,
                        depth + 1
                    ), @parse_atom);
                    if(position(value) < limit(value)) {
                        handle super::lexer::token_code_at(source, position(value)) {
                            12 => {
                                set_position(value, position(value) + 1);
                                Result::Ok(push_group(value, child, start, position(value)))
                            },
                            17 => {
                                let elements = Vec::new();
                                Vec::push(&mut elements, child);
                                set_position(value, position(value) + 1);
                                parse_tuple_tail(
                                    original,
                                    source,
                                    declarations,
                                    nominal,
                                    value,
                                    owner,
                                    depth + 1,
                                    start,
                                    &mut elements
                                )
                            },
                            _ => Result::Err(
                                BodyError::ExpectedGroupingClose(position(value), start)
                            )
                        }
                    } else {
                        Result::Err(BodyError::ExpectedGroupingClose(position(value), start))
                    }
                },
                13 => {
                    set_position(value, start + 1);
                    let statements = Vec::new();
                    parse_block_contents(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth + 1,
                        start,
                        14,
                        &mut statements
                    )
                },
                _ => Result::Err(BodyError::ExpectedExpression(start, start))
            }
        }
    }
}

parse_call_arguments(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    arguments: &mut Vec<ExprId>,
    open: usize
) -> Result<(), BodyError> {
    if(position(value) >= limit(value)) {
        Result::Err(BodyError::ExpectedCallClose(position(value), open))
    } else if(super::lexer::token_code_at(source, position(value)) == 12) {
        set_position(value, position(value) + 1);
        Result::Ok(())
    } else {
        Vec::push(arguments, try(parse_expression(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            0,
            depth
        ), @parse_call_arguments));
        if(position(value) < limit(value)) {
            handle super::lexer::token_code_at(source, position(value)) {
                12 => {
                    set_position(value, position(value) + 1);
                    Result::Ok(())
                },
                17 => {
                    set_position(value, position(value) + 1);
                    parse_call_arguments(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        depth,
                        arguments,
                        open
                    )
                },
                _ => Result::Err(BodyError::ExpectedCallClose(position(value), open))
            }
        } else {
            Result::Err(BodyError::ExpectedCallClose(position(value), open))
        }
    }
}

parse_struct_fields(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    constructor: ExprId,
    start: usize,
    open: usize,
    fields: &mut Vec<StructField>
) -> Result<ExprId, BodyError> {
    if(position(value) >= limit(value)) {
        Result::Err(BodyError::InvalidStructField(position(value), open))
    } else if(super::lexer::token_code_at(source, position(value)) == 14) {
        set_position(value, position(value) + 1);
        Result::Ok(push_struct(value, constructor, fields, start, position(value)))
    } else {
        let name_token = position(value);
        handle super::lexer::token_kind_at(source, name_token) {
            TokenKind::Ident(name) => {
                let colon = name_token + 1;
                if(colon < limit(value)
                    and { super::lexer::token_code_at(source, colon) == 18 }) {
                    set_position(value, colon + 1);
                    let expression = try(parse_expression(
                        original,
                        source,
                        declarations,
                        nominal,
                        value,
                        owner,
                        0,
                        depth
                    ), @parse_struct_fields);
                    Vec::push(fields, StructField {
                        name: name,
                        name_token: name_token,
                        expression: expression
                    });
                    if(position(value) < limit(value)) {
                        handle super::lexer::token_code_at(source, position(value)) {
                            14 => {
                                set_position(value, position(value) + 1);
                                Result::Ok(push_struct(
                                    value,
                                    constructor,
                                    fields,
                                    start,
                                    position(value)
                                ))
                            },
                            17 => {
                                set_position(value, position(value) + 1);
                                parse_struct_fields(
                                    original,
                                    source,
                                    declarations,
                                    nominal,
                                    value,
                                    owner,
                                    depth,
                                    constructor,
                                    start,
                                    open,
                                    fields
                                )
                            },
                            _ => Result::Err(
                                BodyError::InvalidStructField(position(value), open)
                            )
                        }
                    } else {
                        Result::Err(BodyError::InvalidStructField(position(value), open))
                    }
                } else {
                    Result::Err(BodyError::InvalidStructField(colon, name_token))
                }
            },
            _ => Result::Err(BodyError::InvalidStructField(name_token, open))
        }
    }
}

parse_projection_name(
    original: &String,
    source: &super::lexer::LexedSource,
    value: &mut BodyParser,
    subject: ExprId,
    dot: usize
) -> Result<ExprId, BodyError> {
    let token = dot + 1;
    if(token >= limit(value)) {
        Result::Err(BodyError::ExpectedProjectionName(token, dot))
    } else {
        handle super::lexer::token_kind_at(source, token) {
            TokenKind::Ident(name) => {
                set_position(value, token + 1);
                Result::Ok(push_projection(
                    value,
                    subject,
                    ExpressionName::Identifier(name, token),
                    position(value)
                ))
            },
            TokenKind::Number(number) => if(super::lexer::number_is_float(&number)) {
                Result::Err(BodyError::ExpectedProjectionName(token, dot))
            } else {
                let text = range_text(
                    original,
                    source,
                    &super::syntax::token_span(token, token + 1)
                );
                handle parse_u64(&text) {
                    Result::Err(_) => Result::Err(
                        BodyError::ExpectedProjectionName(token, dot)
                    ),
                    Result::Ok(field) => if(field <= 4294967295) {
                        set_position(value, token + 1);
                        Result::Ok(push_projection(
                            value,
                            subject,
                            ExpressionName::TupleField(
                                wrapping_convert_to_u32(field),
                                token
                            ),
                            position(value)
                        ))
                    } else {
                        Result::Err(BodyError::ExpectedProjectionName(token, dot))
                    }
                }
            },
            _ => Result::Err(BodyError::ExpectedProjectionName(token, dot))
        }
    }
}

handler_clause_brace(
    source: &super::lexer::LexedSource,
    delimiters: &super::syntax::DelimiterMap,
    cursor: usize,
    limit: usize
) -> Bool {
    if(cursor >= limit) {
        false
    } else {
        let code = super::lexer::token_code_at(source, cursor);
        if(code == 24) {
            true
        } else if(code == 14) {
            false
        } else if(super::syntax::delimiter_is_open(delimiters, cursor)) {
            handle super::syntax::delimiter_partner(delimiters, cursor) {
                None => false,
                Some(close) => handler_clause_brace(
                    source,
                    delimiters,
                    close + 1,
                    limit
                )
            }
        } else {
            handler_clause_brace(source, delimiters, cursor + 1, limit)
        }
    }
}

parse_postfix(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    callee: ExprId
) -> Result<ExprId, BodyError> {
    if(position(value) >= limit(value)) {
        Result::Ok(callee)
    } else if(depth >= 128) {
        Result::Err(BodyError::ExpressionDepthLimit(position(value), position(value)))
    } else {
        handle super::lexer::token_code_at(source, position(value)) {
            11 => {
                let start = super::syntax::token_start(&node_tokens(&*value, callee));
                let open = position(value);
                set_position(value, open + 1);
                let arguments = Vec::new();
                try(parse_call_arguments(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth + 1,
                    &mut arguments,
                    open
                ), @parse_postfix);
                let call = push_call(value, callee, &arguments, start, position(value));
                parse_postfix(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth + 1,
                    call
                )
            },
            13 => if(handler_clause_brace(
                source,
                super::scanner::delimiter_map(declarations),
                position(value) + 1,
                limit(value)
            )) {
                Result::Ok(callee)
            } else if(node_is_single_identifier(&*value, callee)) {
                let start = super::syntax::token_start(&node_tokens(&*value, callee));
                let open = position(value);
                set_position(value, open + 1);
                let fields = Vec::new();
                let found = try(parse_struct_fields(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth + 1,
                    callee,
                    start,
                    open,
                    &mut fields
                ), @parse_postfix);
                parse_postfix(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth + 1,
                    found
                )
            } else {
                Result::Ok(callee)
            },
            21 => {
                let dot = position(value);
                let found = try(parse_projection_name(
                    original,
                    source,
                    value,
                    callee,
                    dot
                ), @parse_postfix);
                parse_postfix(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    depth + 1,
                    found
                )
            },
            _ => Result::Ok(callee)
        }
    }
}

infix_separated(
    source: &super::lexer::LexedSource,
    value: &BodyParser,
    left: ExprId,
    operator: OperatorUse
) -> Bool {
    super::lexer::token_code_at(source, operator.start) == 1
        or {
            let left_end = super::syntax::token_end(&node_tokens(value, left));
            let left_span = token_span(source, left_end - 1);
            let operator_span = token_span(source, operator.start);
            super::lexer::span_end(&left_span)
                != super::lexer::span_start(&operator_span)
                and { operator.end < limit(value) }
                and {
                    let last = token_span(source, operator.end - 1);
                    let next = token_span(source, operator.end);
                    super::lexer::span_end(&last)
                        != super::lexer::span_start(&next)
                }
        }
}

reduce_once(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) {
    let operator = pop_operator(pending);
    let right = pop_expr(output);
    let left = pop_expr(output);
    Vec::push(output, push_infix(value, operator, left, right))
}

prepare_operator(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>,
    incoming: OperatorUse
) -> Result<(), BodyError> {
    if(Vec::is_empty(pending)) {
        Result::Ok(())
    } else {
        let top = last_operator(pending);
        if(top.precedence > incoming.precedence) {
            reduce_once(value, output, pending);
            prepare_operator(value, output, pending, incoming)
        } else if(top.precedence == incoming.precedence) {
            if(top.form == incoming.form) {
                handle incoming.form {
                    2 => {
                        reduce_once(value, output, pending);
                        prepare_operator(value, output, pending, incoming)
                    },
                    3 => Result::Ok(()),
                    _ => Result::Err(BodyError::NonAssociativeChain(
                        incoming.start,
                        top.start
                    ))
                }
            } else {
                Result::Err(BodyError::IncompatibleAssociativity(
                    incoming.start,
                    top.start
                ))
            }
        } else { Result::Ok(()) }
    }
}

finish_chain(
    value: &mut BodyParser,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) -> Result<ExprId, BodyError> {
    if(Vec::is_empty(pending)) {
        Result::Ok(pop_expr(output))
    } else {
        reduce_once(value, output, pending);
        finish_chain(value, output, pending)
    }
}

parse_chain(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    minimum: u8,
    depth: u16,
    output: &mut Vec<ExprId>,
    pending: &mut Vec<OperatorUse>
) -> Result<ExprId, BodyError> {
    handle try(peek_operator(
        original,
        source,
        declarations,
        nominal,
        &*value,
        false,
        owner
    ), @parse_chain) {
        None => finish_chain(value, output, pending),
        Some(operator) => if(operator.precedence < minimum
            or { not(infix_separated(source, &*value, last_expr(output), operator)) }) {
            finish_chain(value, output, pending)
        } else {
            set_position(value, operator.end);
            let operand = try(parse_primary(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth
            ), @parse_chain);
            try(prepare_operator(value, output, pending, operator), @parse_chain);
            Vec::push(pending, operator);
            Vec::push(output, operand);
            parse_chain(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                minimum,
                depth,
                output,
                pending
            )
        }
    }
}

parse_expression(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    minimum: u8,
    depth: u16
) -> Result<ExprId, BodyError> {
    let first = try(parse_primary(
        original,
        source,
        declarations,
        nominal,
        value,
        owner,
        depth
    ), @parse_expression);
    let output = Vec::new();
    let pending = Vec::new();
    Vec::push(&mut output, first);
    parse_chain(
        original,
        source,
        declarations,
        nominal,
        value,
        owner,
        minimum,
        depth,
        &mut output,
        &mut pending
    )
}

parse_block_statement(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    statements: &mut Vec<BlockStatement>
) -> Result<(), BodyError> {
    let start = position(value);
    handle super::lexer::token_kind_at(source, start) {
        TokenKind::Keyword(Keyword::Let) => {
            let name_token = start + 1;
            let equals = name_token + 1;
            if(equals < limit(value)
                and { super::lexer::token_code_at(source, name_token) == 1 }
                and { super::lexer::token_code_at(source, equals) == 31 }) {
                set_position(value, equals + 1);
                let initializer = try(parse_expression(
                    original,
                    source,
                    declarations,
                    nominal,
                    value,
                    owner,
                    0,
                    depth
                ), @parse_block_statement);
                Vec::push(statements, BlockStatement::Let(initializer, name_token));
                Result::Ok(())
            } else {
                Result::Err(BodyError::InvalidLetSyntax(equals, start))
            }
        },
        _ => {
            Vec::push(statements, BlockStatement::Expression(try(parse_expression(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                0,
                depth
            ), @parse_block_statement)));
            Result::Ok(())
        }
    }
}

parse_block_after_statement(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize,
    close_code: u16,
    statements: &mut Vec<BlockStatement>
) -> Result<ExprId, BodyError> {
    if(position(value) < limit(value)) {
        let code = super::lexer::token_code_at(source, position(value));
        if(code == 22) {
            set_position(value, position(value) + 1);
            parse_block_contents(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                start,
                close_code,
                statements
            )
        } else if(code == 14 and { close_code == 14 }) {
            parse_block_contents(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                start,
                close_code,
                statements
            )
        } else {
            Result::Err(BodyError::ExpectedBlockClose(position(value), start))
        }
    } else {
        parse_block_contents(
            original,
            source,
            declarations,
            nominal,
            value,
            owner,
            depth,
            start,
            close_code,
            statements
        )
    }
}

parse_block_contents(
    original: &String,
    source: &super::lexer::LexedSource,
    declarations: &super::scanner::DeclarationIndex,
    nominal: &super::headers::NominalIndex,
    value: &mut BodyParser,
    owner: Option<ShellId>,
    depth: u16,
    start: usize,
    close_code: u16,
    statements: &mut Vec<BlockStatement>
) -> Result<ExprId, BodyError> {
    if(position(value) < limit(value)) {
        if(close_code == 14
            and { super::lexer::token_code_at(source, position(value)) == 14 }) {
            set_position(value, position(value) + 1);
            Result::Ok(push_block(value, statements, start, position(value)))
        } else {
            try(parse_block_statement(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                statements
            ), @parse_block_contents);
            parse_block_after_statement(
                original,
                source,
                declarations,
                nominal,
                value,
                owner,
                depth,
                start,
                close_code,
                statements
            )
        }
    } else if(close_code == 0) {
        Result::Ok(push_block(value, statements, start, position(value)))
    } else {
        Result::Err(BodyError::ExpectedBlockClose(position(value), start))
    }
}

pub parse_function_body(
    original: &String,
    headers: &super::headers::ParsedHeaders,
    declarations: &super::scanner::DeclarationIndex,
    shell: ShellId
) -> Result<ParsedBody, BodyError> {
    handle super::scanner::shell_at(declarations, shell) {
        None => Result::Err(BodyError::MissingBodyShell(shell)),
        Some(declaration) => if(super::scanner::shell_is_function(declaration)) {
            handle super::scanner::shell_body_span(declaration) {
                None => Result::Err(BodyError::MissingBodyShell(shell)),
                Some(body) => {
                    let start = super::syntax::token_start(&body);
                    let end = super::syntax::token_end(&body);
                    let parser = BodyParser {
                        cursor: super::syntax::cursor(start, end),
                        nodes: Arena::new(),
                        names: Vec::new(),
                        expression_uses: Vec::new(),
                        block_statements: Vec::new(),
                        struct_fields: Vec::new(),
                        handle_arms: Vec::new(),
                        pattern_binders: Vec::new()
                    };
                    let statements = Vec::new();
                    let root = try(parse_block_contents(
                        original,
                        super::headers::parsed_source(headers),
                        declarations,
                        super::headers::nominal_index(headers),
                        &mut parser,
                        shell_owner(declarations, shell),
                        0,
                        start,
                        0,
                        &mut statements
                    ), @parse_function_body);
                    let BodyParser {
                        cursor: _,
                        nodes,
                        names,
                        expression_uses,
                        block_statements,
                        struct_fields,
                        handle_arms,
                        pattern_binders
                    } = parser;
                    Result::Ok(ParsedBody {
                        shell: shell,
                        root: root,
                        nodes: nodes,
                        names: names,
                        expression_uses: expression_uses,
                        block_statements: block_statements,
                        struct_fields: struct_fields,
                        handle_arms: handle_arms,
                        pattern_binders: pattern_binders
                    })
                }
            }
        } else {
            Result::Err(BodyError::MissingBodyShell(shell))
        }
    }
}
