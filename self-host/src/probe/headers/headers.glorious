use super::super::frontend::headers::{
    CallableHeader,
    EffectHeader,
    EffectOperationHeader,
    EffectRow,
    EnumHeader,
    FixityHeader,
    HeaderIndex,
    HeaderRange,
    HeaderTypeView,
    NominalIndex,
    ParsedHeaders,
    StructHeader,
    DropHeader,
    UseHeader,
    TypeAliasHeader,
    EffectRowAliasHeader,
    TypeId
};
use super::super::frontend::lexer::{LexedSource, TokenKind};

bool_code(value: Bool) -> u8 { if(value) { 1 } else { 0 } }

write_header_error(
    output: &mut ByteBuf,
    source: &LexedSource,
    error: &super::super::frontend::headers::HeaderError
) {
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::headers::header_error_code(error)
    );
    let token = super::super::frontend::headers::header_error_token(error);
    handle super::super::frontend::lexer::token_at(source, token) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => {
            let span = super::super::frontend::lexer::token_span(found);
            ByteBuf::write_u64_le(
                output,
                wrapping_convert_to_u64(
                    super::super::frontend::lexer::span_start(&span)
                )
            );
            ByteBuf::write_u64_le(
                output,
                wrapping_convert_to_u64(
                    super::super::frontend::lexer::span_end(&span)
                )
            )
        }
    }
}

write_string(output: &mut ByteBuf, value: &String) {
    let bytes = String::as_bytes(value);
    ByteBuf::write_u32_le(
        output,
        wrapping_convert_to_u32(Bytes::len(&bytes))
    );
    ByteBuf::append_bytes(output, &bytes)
}

write_name(output: &mut ByteBuf, source: &LexedSource, name: Id<String>) {
    handle super::super::frontend::lexer::lexeme(source, name) {
        Result::Err(_) => unreachable(),
        Result::Ok(text) => write_string(output, text)
    }
}

write_optional_name(
    output: &mut ByteBuf,
    source: &LexedSource,
    value: &Option<super::super::frontend::headers::NameUse>
) {
    handle Option::as_ref(value) {
        Result::Err(_) => ByteBuf::push(output, 0),
        Result::Ok(name) => {
            ByteBuf::push(output, 1);
            write_name(
                output,
                source,
                super::super::frontend::headers::name_use_name(name)
            )
        }
    }
}

write_optional_name_token(
    output: &mut ByteBuf,
    source: &LexedSource,
    value: Option<usize>
) {
    handle value {
        None => ByteBuf::push(output, 0),
        Option::Some(token) => {
            ByteBuf::push(output, 1);
            handle super::super::frontend::lexer::token_kind_at(source, token) {
                TokenKind::Lifetime(name) => write_name(output, source, name),
                _ => unreachable()
            }
        }
    }
}

write_narrow_token_span(
    output: &mut ByteBuf,
    source: &LexedSource,
    tokens: &super::super::frontend::headers::HeaderTokenRange
) {
    let start = super::super::frontend::headers::token_range_start(tokens);
    let end = super::super::frontend::headers::token_range_end(tokens);
    let first = handle super::super::frontend::lexer::token_at(source, start) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => super::super::frontend::lexer::token_span(found)
    };
    let last = handle super::super::frontend::lexer::token_at(source, end - 1) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => super::super::frontend::lexer::token_span(found)
    };
    ByteBuf::write_u32_le(
        output,
        wrapping_convert_to_u32(
            super::super::frontend::lexer::span_start(&first)
        )
    );
    ByteBuf::write_u32_le(
        output,
        wrapping_convert_to_u32(
            super::super::frontend::lexer::span_end(&last)
        )
    )
}

write_type_node_span(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    start: usize,
    end: usize
) {
    let source = super::super::frontend::headers::parsed_source(parsed);
    let first = handle super::super::frontend::lexer::token_at(source, start) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::super::frontend::lexer::token_span(token)
    };
    let last = handle super::super::frontend::lexer::token_at(source, end - 1) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::super::frontend::lexer::token_span(token)
    };
    ByteBuf::write_u32_le(
        output,
        wrapping_convert_to_u32(
            super::super::frontend::lexer::span_start(&first)
        )
    );
    ByteBuf::write_u32_le(
        output,
        wrapping_convert_to_u32(
            super::super::frontend::lexer::span_end(&last)
        )
    )
}

write_type_edges<'a>(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    edges: Slice<'a, super::super::frontend::headers::TypeEdge>
) {
    for_range(Range::new(0, Slice::len(edges)), { current => {
        let edge = handle Slice::get(edges, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_type(
            output,
            parsed,
            super::super::frontend::headers::type_edge_type(edge)
        )
    }})
}

write_type(output: &mut ByteBuf, parsed: &ParsedHeaders, id: TypeId) {
    let index = super::super::frontend::headers::parsed_index(parsed);
    handle super::super::frontend::headers::header_type_view(index, id) {
        HeaderTypeView::Path(start, end, names) => {
            ByteBuf::push(output, 1);
            write_type_node_span(output, parsed, start, end);
            ByteBuf::write_u32_le(
                output,
                wrapping_convert_to_u32(Slice::len(names))
            );
            for_range(Range::new(0, Slice::len(names)), { current => {
                let name = handle Slice::get(names, current) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => found
                };
                write_name(
                    output,
                    super::super::frontend::headers::parsed_source(parsed),
                    super::super::frontend::headers::name_use_name(name)
                );
                let source = super::super::frontend::headers::parsed_source(parsed);
                let token = super::super::frontend::lexer::token_at(
                    source,
                    super::super::frontend::headers::name_use_token(name)
                );
                let span = handle token {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => super::super::frontend::lexer::token_span(found)
                };
                ByteBuf::write_u32_le(
                    output,
                    wrapping_convert_to_u32(
                        super::super::frontend::lexer::span_start(&span)
                    )
                );
                ByteBuf::write_u32_le(
                    output,
                    wrapping_convert_to_u32(
                        super::super::frontend::lexer::span_end(&span)
                    )
                )
            }})
        },
        HeaderTypeView::SharedReference(start, end, lifetime, child) => {
            ByteBuf::push(output, 2);
            write_type_node_span(output, parsed, start, end);
            write_optional_name_token(
                output,
                super::super::frontend::headers::parsed_source(parsed),
                lifetime
            );
            write_type(output, parsed, child)
        },
        HeaderTypeView::UniqueReference(start, end, lifetime, child) => {
            ByteBuf::push(output, 3);
            write_type_node_span(output, parsed, start, end);
            write_optional_name_token(
                output,
                super::super::frontend::headers::parsed_source(parsed),
                lifetime
            );
            write_type(output, parsed, child)
        },
        HeaderTypeView::Tuple(start, end, children) => {
            ByteBuf::push(output, 4);
            write_type_node_span(output, parsed, start, end);
            ByteBuf::write_u32_le(
                output,
                wrapping_convert_to_u32(Slice::len(children))
            );
            write_type_edges(output, parsed, children)
        },
        HeaderTypeView::Application(start, end, constructor, lifetimes, arguments) => {
            ByteBuf::push(output, 5);
            write_type_node_span(output, parsed, start, end);
            write_type(output, parsed, constructor);
            ByteBuf::write_u32_le(
                output,
                wrapping_convert_to_u32(Slice::len(lifetimes))
            );
            for_range(Range::new(0, Slice::len(lifetimes)), { current => {
                let lifetime = handle Slice::get(lifetimes, current) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => found
                };
                write_name(
                    output,
                    super::super::frontend::headers::parsed_source(parsed),
                    super::super::frontend::headers::name_use_name(lifetime)
                );
                let source = super::super::frontend::headers::parsed_source(parsed);
                let token = super::super::frontend::lexer::token_at(
                    source,
                    super::super::frontend::headers::name_use_token(lifetime)
                );
                let span = handle token {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => super::super::frontend::lexer::token_span(found)
                };
                ByteBuf::write_u32_le(
                    output,
                    wrapping_convert_to_u32(
                        super::super::frontend::lexer::span_start(&span)
                    )
                );
                ByteBuf::write_u32_le(
                    output,
                    wrapping_convert_to_u32(
                        super::super::frontend::lexer::span_end(&span)
                    )
                )
            }});
            ByteBuf::write_u32_le(
                output,
                wrapping_convert_to_u32(Slice::len(arguments))
            );
            write_type_edges(output, parsed, arguments)
        },
        HeaderTypeView::Projection(start, end, subject, trait_ref, item, item_token, arguments) => {
            ByteBuf::push(output, 7);
            write_type_node_span(output, parsed, start, end);
            write_type(output, parsed, subject);
            write_type(output, parsed, trait_ref);
            write_name(output, super::super::frontend::headers::parsed_source(parsed), item);
            let source = super::super::frontend::headers::parsed_source(parsed);
            let token = super::super::frontend::lexer::token_at(source, item_token);
            let span = handle token { Result::Err(_) => unreachable(), Result::Ok(found) => super::super::frontend::lexer::token_span(found) };
            ByteBuf::write_u32_le(output, wrapping_convert_to_u32(super::super::frontend::lexer::span_start(&span)));
            ByteBuf::write_u32_le(output, wrapping_convert_to_u32(super::super::frontend::lexer::span_end(&span)));
            ByteBuf::write_u32_le(output, wrapping_convert_to_u32(Slice::len(arguments)));
            for_range(Range::new(0, Slice::len(arguments)), { current => {
                let argument = handle Slice::get(arguments, current) { Result::Err(_) => unreachable(), Result::Ok(found) => found };
                ByteBuf::push(output, super::super::frontend::headers::goal_argument_kind_code(argument));
                handle super::super::frontend::headers::goal_argument_type(argument) {
                    Option::Some(ty) => { ByteBuf::push(output, 1); write_wide_type_span(output, parsed, ty); write_type(output, parsed, ty) },
                    None => { ByteBuf::push(output, 0); handle super::super::frontend::headers::goal_argument_name(argument) { None => unreachable(), Option::Some(name) => write_name(output, source, Id::from_u32(name)) } }
                }
            }})
        },
        HeaderTypeView::Never(start, end) => {
            ByteBuf::push(output, 6);
            write_type_node_span(output, parsed, start, end)
        }
    }
}

write_token_span(
    output: &mut ByteBuf,
    source: &LexedSource,
    range: &super::super::frontend::headers::HeaderTokenRange
) {
    if(super::super::frontend::syntax::token_is_empty(range)) {
        ByteBuf::write_u64_le(output, 0);
        ByteBuf::write_u64_le(output, 0)
    } else {
        let first = handle super::super::frontend::lexer::token_at(
            source,
            super::super::frontend::headers::token_range_start(range)
        ) { Result::Err(_) => unreachable(), Result::Ok(found) => found };
        let last = handle super::super::frontend::lexer::token_at(
            source,
            super::super::frontend::headers::token_range_end(range) - 1
        ) { Result::Err(_) => unreachable(), Result::Ok(found) => found };
        ByteBuf::write_u64_le(output, wrapping_convert_to_u64(
            super::super::frontend::lexer::span_start(
                &super::super::frontend::lexer::token_span(first)
            )
        ));
        ByteBuf::write_u64_le(output, wrapping_convert_to_u64(
            super::super::frontend::lexer::span_end(
                &super::super::frontend::lexer::token_span(last)
            )
        ))
    }
}

write_wide_type_span(output: &mut ByteBuf, parsed: &ParsedHeaders, id: TypeId) {
    let index = super::super::frontend::headers::parsed_index(parsed);
    let range = super::super::frontend::headers::type_tokens(index, id);
    write_token_span(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        &range
    )
}

write_where_contract(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    clause: &Option<super::super::frontend::headers::WhereClause>
) {
    handle Option::as_ref(clause) {
        Result::Err(_) => ByteBuf::push(output, 0),
        Result::Ok(found) => {
            ByteBuf::push(output, 1);
            let index = super::super::frontend::headers::parsed_index(parsed);
            write_token_span(
                output,
                super::super::frontend::headers::parsed_source(parsed),
                &super::super::frontend::headers::where_clause_tokens(*found)
            );
            ByteBuf::write_u32_le(output, super::super::frontend::headers::where_clause_goal_count(*found));
            for_range(Range::new(0, wrapping_convert_to_usize(
                super::super::frontend::headers::where_clause_goal_count(*found)
            )), { ordinal => {
                let goal = handle super::super::frontend::headers::where_goal_at(
                    index, *found, wrapping_convert_to_u32(ordinal)
                ) { Result::Err(_) => unreachable(), Result::Ok(value) => value };
                write_token_span(
                    output,
                    super::super::frontend::headers::parsed_source(parsed),
                    super::super::frontend::headers::where_goal_tokens(goal)
                );
                let higher = super::super::frontend::headers::where_goal_higher_ranked(goal);
                ByteBuf::write_u32_le(
                    output,
                    super::super::frontend::headers::range_count(higher)
                );
                write_generics(output, parsed, higher);
                write_wide_type_span(output, parsed, super::super::frontend::headers::where_goal_subject(goal));
                write_type(output, parsed, super::super::frontend::headers::where_goal_subject(goal));
                ByteBuf::push(output, bool_code(super::super::frontend::headers::where_goal_is_negative(goal)));
                let relation = super::super::frontend::headers::where_goal_relation(index, goal);
                ByteBuf::write_u32_le(output, wrapping_convert_to_u32(Slice::len(relation)));
                for_range(Range::new(0, Slice::len(relation)), { part => {
                    let name = handle Slice::get(relation, part) { Result::Err(_) => unreachable(), Result::Ok(value) => value };
                    write_name(output, super::super::frontend::headers::parsed_source(parsed), super::super::frontend::headers::name_use_name(name))
                }});
                ByteBuf::write_u32_le(output, super::super::frontend::headers::where_goal_argument_count(goal));
                for_range(Range::new(0, wrapping_convert_to_usize(super::super::frontend::headers::where_goal_argument_count(goal))), { part => {
                    let argument = handle super::super::frontend::headers::where_goal_argument_at(index, goal, wrapping_convert_to_u32(part)) { Result::Err(_) => unreachable(), Result::Ok(value) => value };
                    ByteBuf::push(output, super::super::frontend::headers::goal_argument_kind_code(argument));
                    handle super::super::frontend::headers::goal_argument_type(argument) {
                        None => { ByteBuf::push(output, 0) },
                        Option::Some(ty) => { ByteBuf::push(output, 1); write_wide_type_span(output, parsed, ty); write_type(output, parsed, ty) }
                    }
                }});
                ByteBuf::write_u32_le(output, super::super::frontend::headers::where_goal_binding_count(goal));
                for_range(Range::new(0, wrapping_convert_to_usize(super::super::frontend::headers::where_goal_binding_count(goal))), { part => {
                    let binding = handle super::super::frontend::headers::where_goal_binding_at(index, goal, wrapping_convert_to_u32(part)) { Result::Err(_) => unreachable(), Result::Ok(value) => value };
                    write_name(output, super::super::frontend::headers::parsed_source(parsed), super::super::frontend::headers::name_use_name(super::super::frontend::headers::associated_binding_name(binding)));
                    write_token_span(output, super::super::frontend::headers::parsed_source(parsed), super::super::frontend::headers::associated_binding_tokens(binding));
                    let argument_count = super::super::frontend::headers::associated_binding_argument_count(binding);
                    ByteBuf::write_u32_le(output, argument_count);
                    for_range(Range::new(0, wrapping_convert_to_usize(argument_count)), { ordinal => {
                        let argument = handle super::super::frontend::headers::associated_binding_argument_at(index, binding, wrapping_convert_to_u32(ordinal)) { Result::Err(_) => unreachable(), Result::Ok(value) => value };
                        ByteBuf::push(output, super::super::frontend::headers::goal_argument_kind_code(argument));
                        handle super::super::frontend::headers::goal_argument_type(argument) {
                            Option::Some(ty) => { ByteBuf::push(output, 1); write_wide_type_span(output, parsed, ty); write_type(output, parsed, ty) },
                            None => { ByteBuf::push(output, 0); handle super::super::frontend::headers::goal_argument_name(argument) { None => unreachable(), Option::Some(name) => write_name(output, super::super::frontend::headers::parsed_source(parsed), Id::from_u32(name)) } }
                        }
                    }});
                    handle super::super::frontend::headers::associated_binding_value(binding) {
                        super::super::frontend::headers::AssociatedBindingValue::Type(ty) => { ByteBuf::push(output, 1); write_wide_type_span(output, parsed, ty); write_type(output, parsed, ty) },
                        super::super::frontend::headers::AssociatedBindingValue::EffectRow(row) => { ByteBuf::push(output, 2); write_effect_row(output, parsed, &row) }
                    }
                }})
            }});
            let lifetime_count = super::super::frontend::headers::where_clause_lifetime_count(*found);
            ByteBuf::write_u32_le(output, lifetime_count);
            for_range(Range::new(0, wrapping_convert_to_usize(lifetime_count)), { ordinal => {
                let constraint = handle super::super::frontend::headers::lifetime_outlives_at(
                    index,
                    *found,
                    wrapping_convert_to_u32(ordinal)
                ) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(value) => value
                };
                write_outlives(output, parsed, constraint)
            }})
        }
    }
}

write_generics(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    range: &HeaderRange
) {
    let index = super::super::frontend::headers::parsed_index(parsed);
    for_range(Range::new(
        0,
        wrapping_convert_to_usize(
            super::super::frontend::headers::range_count(range)
        )
    ), { current => {
        let ordinal = wrapping_convert_to_usize(
            super::super::frontend::headers::range_start(range)
        ) + current;
        let parameter = handle
            super::super::frontend::headers::generic_param_at(index, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        ByteBuf::push(
            output,
            super::super::frontend::headers::generic_param_kind_code(parameter)
        );
        write_name(
            output,
            super::super::frontend::headers::parsed_source(parsed),
            super::super::frontend::headers::generic_param_name(parameter)
        )
    }})
}

write_parameters(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    range: &HeaderRange
) {
    let index = super::super::frontend::headers::parsed_index(parsed);
    for_range(Range::new(
        0,
        wrapping_convert_to_usize(
            super::super::frontend::headers::range_count(range)
        )
    ), { current => {
        let ordinal = wrapping_convert_to_usize(
            super::super::frontend::headers::range_start(range)
        ) + current;
        let parameter = handle
            super::super::frontend::headers::parameter_at(index, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_name(
            output,
            super::super::frontend::headers::parsed_source(parsed),
            super::super::frontend::headers::parameter_name(parameter)
        );
        write_type(
            output,
            parsed,
            super::super::frontend::headers::parameter_type(parameter)
        )
    }})
}

write_outlives(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &super::super::frontend::headers::LifetimeOutlives
) {
    let higher = super::super::frontend::headers::lifetime_outlives_higher_ranked(value);
    ByteBuf::write_u32_le(output, super::super::frontend::headers::range_count(higher));
    write_generics(output, parsed, higher);
    write_name(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::name_use_name(
            super::super::frontend::headers::lifetime_outlives_longer(value)
        )
    );
    write_name(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::name_use_name(
            super::super::frontend::headers::lifetime_outlives_shorter(value)
        )
    );
    write_narrow_token_span(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::lifetime_outlives_tokens(value)
    )
}

write_trait(output: &mut ByteBuf, parsed: &ParsedHeaders, value: &super::super::frontend::headers::TraitHeader) {
    let source = super::super::frontend::headers::parsed_source(parsed);
    ByteBuf::push(output, bool_code(super::super::frontend::headers::trait_public(value)));
    write_name(output, source, super::super::frontend::headers::trait_name(value));
    write_generics(output, parsed, super::super::frontend::headers::trait_generics(value));
    write_token_span(output, source, super::super::frontend::headers::trait_tokens(value));
}

write_impl(output: &mut ByteBuf, parsed: &ParsedHeaders, value: &super::super::frontend::headers::ImplHeader) {
    let source = super::super::frontend::headers::parsed_source(parsed);
    write_generics(output, parsed, super::super::frontend::headers::impl_generics(value));
    let index = super::super::frontend::headers::parsed_index(parsed);
    let path_count = super::super::frontend::headers::impl_trait_path_count(value);
    ByteBuf::write_u32_le(output, path_count);
    for_range(Range::new(0, wrapping_convert_to_usize(path_count)), { current => {
        write_name(output, source, super::super::frontend::headers::impl_trait_path_name(index, value, current));
    }});
    write_wide_type_span(output, parsed, super::super::frontend::headers::impl_self_type(value));
    write_type(output, parsed, super::super::frontend::headers::impl_self_type(value));
    write_where_contract(output, parsed, super::super::frontend::headers::impl_where_clause(value));
    write_token_span(output, source, super::super::frontend::headers::impl_tokens(value));
}

write_callable_where(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &CallableHeader
) {
    handle Option::as_ref(
        super::super::frontend::headers::callable_where_clause(value)
    ) {
        Result::Err(_) => ByteBuf::push(output, 0),
        Result::Ok(clause) => {
            ByteBuf::push(output, 1);
            let clause_tokens = super::super::frontend::headers::where_clause_tokens(*clause);
            write_narrow_token_span(
                output,
                super::super::frontend::headers::parsed_source(parsed),
                &clause_tokens
            );
            ByteBuf::write_u32_le(
                output,
                super::super::frontend::headers::where_clause_goal_count(*clause)
            );
            let count = super::super::frontend::headers::where_clause_lifetime_count(*clause);
            ByteBuf::write_u32_le(output, count);
            let index = super::super::frontend::headers::parsed_index(parsed);
            for_range(Range::new(0, wrapping_convert_to_usize(count)), { ordinal => {
                let found = handle super::super::frontend::headers::lifetime_outlives_at(
                    index, *clause, wrapping_convert_to_u32(ordinal)
                ) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(value) => value
                };
                write_outlives(output, parsed, found)
            }})
        }
    }
}

write_effect_row(output: &mut ByteBuf, parsed: &ParsedHeaders, row: &EffectRow) {
    let range = super::super::frontend::headers::effect_row_effects(row);
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::headers::range_count(range)
    );
    let index = super::super::frontend::headers::parsed_index(parsed);
    let edges = super::super::frontend::headers::type_edge_range(index, range);
    for_range(Range::new(0, Slice::len(edges)), { current => {
        let edge = handle Slice::get(edges, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let ty = super::super::frontend::headers::type_edge_type(edge);
        write_wide_type_span(output, parsed, ty);
        write_type(output, parsed, ty)
    }});
    write_token_span(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::effect_row_tokens(row)
    );
    write_optional_name(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::effect_row_tail(row)
    )
}

write_callable(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &CallableHeader
) {
    ByteBuf::push(
        output,
        bool_code(super::super::frontend::headers::callable_is_public(value))
    );
    write_name(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::callable_name(value)
    );
    let generics = super::super::frontend::headers::callable_generics(value);
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::headers::range_count(generics)
    );
    write_generics(output, parsed, generics);
    write_token_span(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::callable_generic_tokens(value)
    );
    let parameters = super::super::frontend::headers::callable_parameters(value);
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::headers::range_count(parameters)
    );
    write_parameters(output, parsed, parameters);
    handle super::super::frontend::headers::callable_result(value) {
        None => ByteBuf::push(output, 0),
        Option::Some(result) => {
            ByteBuf::push(output, 1);
            write_type(output, parsed, result)
        }
    };
    handle Option::as_ref(
        super::super::frontend::headers::callable_effects(value)
    ) {
        Result::Err(_) => ByteBuf::push(output, 0),
        Result::Ok(row) => {
            ByteBuf::push(output, 1);
            write_effect_row(output, parsed, row)
        }
    };
    write_where_contract(
        output,
        parsed,
        super::super::frontend::headers::callable_where_clause(value)
    )
}

write_callables(output: &mut ByteBuf, parsed: &ParsedHeaders) {
    let index = super::super::frontend::headers::parsed_index(parsed);
    for_range(Range::new(
        0,
        super::super::frontend::headers::callable_count(index)
    ), { current => {
        let value = handle
            super::super::frontend::headers::callable_at(index, current) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_callable(output, parsed, value)
    }})
}

write_common(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    public: Bool,
    name: Id<String>,
    generics: &HeaderRange
) {
    ByteBuf::push(output, bool_code(public));
    write_name(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        name
    );
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::headers::range_count(generics)
    );
    write_generics(output, parsed, generics)
}

write_alias(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &TypeAliasHeader
) {
    write_common(
        output,
        parsed,
        super::super::frontend::headers::alias_is_public(value),
        super::super::frontend::headers::alias_name(value),
        super::super::frontend::headers::alias_generics(value)
    );
    write_type(
        output,
        parsed,
        *super::super::frontend::headers::alias_target(value)
    )
}

write_effect_row_alias(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &EffectRowAliasHeader
) {
    ByteBuf::push(output, bool_code(
        super::super::frontend::headers::effect_row_alias_is_public(value)
    ));
    write_name(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::effect_row_alias_name(value)
    );
    write_effect_row(
        output,
        parsed,
        super::super::frontend::headers::effect_row_alias_row(value)
    );
    write_token_span(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::effect_row_alias_tokens(value)
    )
}

write_struct(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &StructHeader,
    include_field_spans: Bool
) {
    write_common(
        output,
        parsed,
        super::super::frontend::headers::struct_is_public(value),
        super::super::frontend::headers::struct_name(value),
        super::super::frontend::headers::struct_generics(value)
    );
    let fields = super::super::frontend::headers::struct_fields(value);
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::headers::range_count(fields)
    );
    let nominal = super::super::frontend::headers::nominal_index(parsed);
    for_range(Range::new(
        0,
        wrapping_convert_to_usize(
            super::super::frontend::headers::range_count(fields)
        )
    ), { current => {
        let ordinal = wrapping_convert_to_usize(
            super::super::frontend::headers::range_start(fields)
        ) + current;
        let field = handle
            super::super::frontend::headers::field_at(nominal, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        ByteBuf::push(
            output,
            if(super::super::frontend::headers::field_is_private(field)) {
                0
            } else { 1 }
        );
        write_name(
            output,
            super::super::frontend::headers::parsed_source(parsed),
            super::super::frontend::headers::field_name(field)
        );
        write_type(
            output,
            parsed,
            *super::super::frontend::headers::field_type(field)
        );
        if(include_field_spans) {
            let field_tokens = super::super::frontend::headers::field_tokens(field);
            let first = handle super::super::frontend::lexer::token_at(
                super::super::frontend::headers::parsed_source(parsed),
                super::super::frontend::headers::token_range_start(field_tokens)
            ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => super::super::frontend::lexer::token_span(found)
            };
            let last = handle super::super::frontend::lexer::token_at(
                super::super::frontend::headers::parsed_source(parsed),
                super::super::frontend::headers::token_range_end(field_tokens) - 1
            ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => super::super::frontend::lexer::token_span(found)
            };
            ByteBuf::write_u64_le(
                output,
                wrapping_convert_to_u64(
                    super::super::frontend::lexer::span_start(&first)
                )
            );
            ByteBuf::write_u64_le(
                output,
                wrapping_convert_to_u64(
                    super::super::frontend::lexer::span_end(&last)
                )
            )
        } else { () }
    }})
}

write_drop(output: &mut ByteBuf, parsed: &ParsedHeaders, value: &DropHeader) {
    write_token_span(output, super::super::frontend::headers::parsed_source(parsed), super::super::frontend::headers::drop_tokens(value));
    ByteBuf::write_u32_le(output, super::super::frontend::headers::range_count(super::super::frontend::headers::drop_generics(value)));
    write_generics(output, parsed, super::super::frontend::headers::drop_generics(value));
    write_wide_type_span(output, parsed, super::super::frontend::headers::drop_target(value));
    write_type(output, parsed, super::super::frontend::headers::drop_target(value));
    write_where_contract(output, parsed, super::super::frontend::headers::drop_where_clause(value));
}

write_use(output: &mut ByteBuf, parsed: &ParsedHeaders, value: &UseHeader) {
    write_token_span(output, super::super::frontend::headers::parsed_source(parsed), super::super::frontend::headers::use_tokens(value));
    ByteBuf::write_u32_le(output, super::super::frontend::headers::range_count(super::super::frontend::headers::use_generics(value)));
    write_generics(output, parsed, super::super::frontend::headers::use_generics(value));
    ByteBuf::write_u64_le(output, wrapping_convert_to_u64(super::super::frontend::headers::use_lower(value)));
    handle super::super::frontend::headers::use_upper(value) {
        None => ByteBuf::push(output, 0),
        Option::Some(upper) => { ByteBuf::push(output, 1); ByteBuf::write_u64_le(output, wrapping_convert_to_u64(upper)) }
    };
    write_wide_type_span(output, parsed, super::super::frontend::headers::use_target(value));
    write_type(output, parsed, super::super::frontend::headers::use_target(value));
    write_where_contract(output, parsed, super::super::frontend::headers::use_where_clause(value));
}

write_enum(output: &mut ByteBuf, parsed: &ParsedHeaders, value: &EnumHeader) {
    write_common(
        output,
        parsed,
        super::super::frontend::headers::enum_is_public(value),
        super::super::frontend::headers::enum_name(value),
        super::super::frontend::headers::enum_generics(value)
    );
    let variants = super::super::frontend::headers::enum_variants(value);
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::headers::range_count(variants)
    );
    let nominal = super::super::frontend::headers::nominal_index(parsed);
    let index = super::super::frontend::headers::parsed_index(parsed);
    for_range(Range::new(
        0,
        wrapping_convert_to_usize(
            super::super::frontend::headers::range_count(variants)
        )
    ), { current => {
        let ordinal = wrapping_convert_to_usize(
            super::super::frontend::headers::range_start(variants)
        ) + current;
        let variant = handle
            super::super::frontend::headers::variant_at(nominal, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_name(
            output,
            super::super::frontend::headers::parsed_source(parsed),
            super::super::frontend::headers::variant_name(variant)
        );
        let fields = super::super::frontend::headers::variant_fields(variant);
        ByteBuf::write_u32_le(
            output,
            super::super::frontend::headers::range_count(fields)
        );
        write_type_edges(
            output,
            parsed,
            super::super::frontend::headers::type_edge_range(index, fields)
        )
    }})
}

write_effect_operation(
    output: &mut ByteBuf,
    parsed: &ParsedHeaders,
    value: &EffectOperationHeader
) {
    write_name(
        output,
        super::super::frontend::headers::parsed_source(parsed),
        super::super::frontend::headers::effect_operation_name(value)
    );
    let generics = super::super::frontend::headers::effect_operation_generics(value);
    ByteBuf::write_u32_le(output, super::super::frontend::headers::range_count(generics));
    write_generics(output, parsed, generics);
    let parameters = super::super::frontend::headers::effect_operation_parameters(value);
    ByteBuf::write_u32_le(output, super::super::frontend::headers::range_count(parameters));
    write_parameters(output, parsed, parameters);
    handle super::super::frontend::headers::effect_operation_result(value) {
        None => ByteBuf::push(output, 0),
        Option::Some(result) => {
            ByteBuf::push(output, 1);
            write_type(output, parsed, result)
        }
    };
    ByteBuf::push(output, bool_code(
        super::super::frontend::headers::effect_operation_is_terminal(value)
    ));
    ByteBuf::write_u64_le(output, wrapping_convert_to_u64(
        super::super::frontend::headers::effect_operation_resumption_lower(value)
    ));
    handle super::super::frontend::headers::effect_operation_resumption_upper(value) {
        None => ByteBuf::push(output, 0),
        Option::Some(upper) => {
            ByteBuf::push(output, 1);
            ByteBuf::write_u64_le(output, wrapping_convert_to_u64(upper))
        }
    };
    ByteBuf::push(output, bool_code(
        super::super::frontend::headers::effect_operation_has_resumption_quantity(value)
    ));
    ByteBuf::push(output, bool_code(
        not(super::super::frontend::syntax::token_is_empty(
            super::super::frontend::headers::effect_operation_where_tokens(value)
        ))
    ))
}

write_effect(output: &mut ByteBuf, parsed: &ParsedHeaders, value: &EffectHeader) {
    write_common(
        output,
        parsed,
        super::super::frontend::headers::effect_is_public(value),
        super::super::frontend::headers::effect_name(value),
        super::super::frontend::headers::effect_generics(value)
    );
    ByteBuf::push(output, bool_code(not(super::super::frontend::syntax::token_is_empty(
        super::super::frontend::headers::effect_where_tokens(value)
    ))));
    let operations = super::super::frontend::headers::effect_operations(value);
    ByteBuf::write_u32_le(output, super::super::frontend::headers::range_count(operations));
    let nominal = super::super::frontend::headers::nominal_index(parsed);
    for_range(Range::new(0, wrapping_convert_to_usize(
        super::super::frontend::headers::range_count(operations)
    )), { ordinal => {
        let id = super::super::frontend::headers::effect_operation_id_at(value, ordinal);
        let operation = handle super::super::frontend::headers::effect_operation_by_id(
            nominal,
            id
        ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_effect_operation(output, parsed, operation)
    }})
}

write_fixity(
    output: &mut ByteBuf,
    original: &String,
    parsed: &ParsedHeaders,
    value: &FixityHeader
) {
    ByteBuf::push(
        output,
        bool_code(super::super::frontend::headers::fixity_is_public(value))
    );
    ByteBuf::push(
        output,
        super::super::frontend::headers::fixity_form_code(value)
    );
    ByteBuf::push(
        output,
        super::super::frontend::headers::fixity_precedence(value)
    );
    let source = super::super::frontend::headers::parsed_source(parsed);
    let first_token = super::super::frontend::headers::fixity_operator_start(value);
    let last_token =
        super::super::frontend::headers::fixity_operator_end(value) - 1;
    let first = handle super::super::frontend::lexer::token_at(source, first_token) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::super::frontend::lexer::token_span(token)
    };
    let last = handle super::super::frontend::lexer::token_at(source, last_token) {
        Result::Err(_) => unreachable(),
        Result::Ok(token) => super::super::frontend::lexer::token_span(token)
    };
    let spelling = super::super::frontend::lexer::text_slice(
        original,
        super::super::frontend::lexer::span_start(&first),
        super::super::frontend::lexer::span_end(&last)
    );
    write_string(output, &spelling)
}

write_interfaces(
    output: &mut ByteBuf,
    original: &String,
    parsed: &ParsedHeaders,
    include_field_spans: Bool
) {
    let nominal = super::super::frontend::headers::nominal_index(parsed);
    let index = super::super::frontend::headers::parsed_index(parsed);
    for_range(Range::new(
        0,
        super::super::frontend::headers::header_count(nominal)
    ), { current => {
        let kind = super::super::frontend::headers::header_kind(nominal, current);
        let declaration = wrapping_convert_to_usize(
            super::super::frontend::headers::header_index(nominal, current)
        );
        ByteBuf::push(output, kind);
        handle kind {
            3 => write_alias(output, parsed, handle
                super::super::frontend::headers::alias_at(nominal, declaration) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }),
            4 => write_effect_row_alias(output, parsed, handle
                super::super::frontend::headers::effect_row_alias_at(nominal, declaration) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }),
            6 => write_fixity(output, original, parsed, handle
                super::super::frontend::headers::fixity_at(nominal, declaration) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }),
            7 => write_effect(output, parsed, handle
                super::super::frontend::headers::effect_at(nominal, declaration) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }),
            8 => write_struct(output, parsed, handle
                super::super::frontend::headers::struct_at(nominal, declaration) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }, include_field_spans),
            9 => write_enum(output, parsed, handle
                super::super::frontend::headers::enum_at(nominal, declaration) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }),
            12 => write_callable(output, parsed, handle
                super::super::frontend::headers::callable_at(index, declaration) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }),
            13 => write_drop(output, parsed, handle
                super::super::frontend::headers::drop_at(nominal, declaration) {
                Result::Err(_) => unreachable(), Result::Ok(found) => found
            }),
            14 => write_use(output, parsed, handle
                super::super::frontend::headers::use_at(nominal, declaration) {
                Result::Err(_) => unreachable(), Result::Ok(found) => found
            }),
            15 => write_trait(output, parsed, handle
                super::super::frontend::headers::trait_at(nominal, declaration) {
                Result::Err(_) => unreachable(), Result::Ok(found) => found
            }),
            16 => write_impl(output, parsed, handle
                super::super::frontend::headers::impl_at(nominal, declaration) {
                Result::Err(_) => unreachable(), Result::Ok(found) => found
            }),
            _ => unreachable()
        }
    }})
}

encode_source(output: &mut ByteBuf, source: String, interfaces: Bool) {
    handle super::super::frontend::lexer::lex(&source) {
        Result::Err(_) => ByteBuf::push(output, 1),
        Result::Ok(lexed) =>
            handle super::super::frontend::scanner::scan(&lexed) {
            Result::Err(_) => ByteBuf::push(output, 2),
            Result::Ok(declarations) => {
            let header_lexed = handle super::super::frontend::lexer::lex(&source) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            };
            let diagnostic_lexed = handle super::super::frontend::lexer::lex(&source) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            };
            handle super::super::frontend::headers::parse(
                    &source,
                    header_lexed,
                    &declarations
                ) {
                Result::Err(error) => {
                    ByteBuf::push(output, 3);
                    write_header_error(output, &diagnostic_lexed, &error)
                },
                Result::Ok(parsed) => {
                    ByteBuf::push(output, 0);
                    if(interfaces) {
                        ByteBuf::write_u32_le(
                            output,
                            wrapping_convert_to_u32(
                                super::super::frontend::headers::header_count(
                                    super::super::frontend::headers::nominal_index(
                                        &parsed
                                    )
                                )
                            )
                        );
                        write_interfaces(output, &source, &parsed, false)
                    } else {
                        ByteBuf::write_u32_le(
                            output,
                            wrapping_convert_to_u32(
                                super::super::frontend::headers::callable_count(
                                    super::super::frontend::headers::parsed_index(
                                        &parsed
                                    )
                                )
                            )
                        );
                        write_callables(output, &parsed);
                        ByteBuf::write_u32_le(
                            output,
                            wrapping_convert_to_u32(
                                super::super::frontend::headers::effect_row_alias_count(
                                    super::super::frontend::headers::nominal_index(&parsed)
                                )
                            )
                        );
                        for_range(Range::new(
                            0,
                            super::super::frontend::headers::effect_row_alias_count(
                                super::super::frontend::headers::nominal_index(&parsed)
                            )
                        ), { current => {
                            let found = handle super::super::frontend::headers::effect_row_alias_at(
                                super::super::frontend::headers::nominal_index(&parsed), current
                            ) {
                                Result::Err(_) => unreachable(),
                                Result::Ok(value) => value
                            };
                            write_effect_row_alias(output, &parsed, found)
                        }});
                        ByteBuf::write_u32_le(
                            output,
                            wrapping_convert_to_u32(
                                super::super::frontend::headers::effect_count(
                                    super::super::frontend::headers::nominal_index(
                                        &parsed
                                    )
                                )
                            )
                        );
                        let nominal = super::super::frontend::headers::nominal_index(
                            &parsed
                        );
                        for_range(Range::new(
                            0,
                            super::super::frontend::headers::effect_count(nominal)
                        ), { current => {
                            let found = handle
                                super::super::frontend::headers::effect_at(
                                    nominal,
                                    current
                                ) {
                                Result::Err(_) => unreachable(),
                                Result::Ok(value) => value
                            };
                            write_effect(output, &parsed, found)
                        }});
                        ByteBuf::write_u32_le(
                            output,
                            wrapping_convert_to_u32(
                                super::super::frontend::headers::struct_count(nominal)
                            )
                        );
                        for_range(Range::new(
                            0,
                            super::super::frontend::headers::struct_count(nominal)
                        ), { current => {
                            let found = handle
                                super::super::frontend::headers::struct_at(
                                    nominal,
                                    current
                                ) {
                                Result::Err(_) => unreachable(),
                                Result::Ok(value) => value
                            };
                            write_struct(output, &parsed, found, true)
                        }});
                        ByteBuf::write_u32_le(output, wrapping_convert_to_u32(super::super::frontend::headers::drop_count(nominal)));
                        for_range(Range::new(0, super::super::frontend::headers::drop_count(nominal)), { current => {
                            let found = handle super::super::frontend::headers::drop_at(nominal, current) { Result::Err(_) => unreachable(), Result::Ok(value) => value };
                            write_drop(output, &parsed, found)
                        }});
                        ByteBuf::write_u32_le(output, wrapping_convert_to_u32(super::super::frontend::headers::use_count(nominal)));
                        for_range(Range::new(0, super::super::frontend::headers::use_count(nominal)), { current => {
                            let found = handle super::super::frontend::headers::use_at(nominal, current) { Result::Err(_) => unreachable(), Result::Ok(value) => value };
                            write_use(output, &parsed, found)
                        }})
                    }
                }
            }
            }
        }
    }
}

process_inputs(
    arguments: &Vec<String>,
    index: usize,
    output: &mut ByteBuf,
    interfaces: Bool
) / FileRead {
    for_range(Range::new(index, Vec::len(arguments)), { current => {
        let path = *Vec::index(arguments, current);
        let bytes = read_file(path);
        handle String::from_utf8(bytes) {
            Result::Err(_) => ByteBuf::push(output, 1),
            Result::Ok(source) => encode_source(output, source, interfaces)
        }
    }})
}

run_application(interfaces: Bool) / {
    ProcessArgs,
    FileRead,
    FileWrite,
    Diagnostic
} {
    let arguments = process_args();
    let count = Vec::len(&arguments);
    if(count < 2) {
        if(interfaces) {
            write_diagnostic(
                "usage: grandiose-self-host-interfaces <output> <input>..."
            )
        } else {
            write_diagnostic(
                "usage: grandiose-self-host-headers <output> <input>..."
            )
        }
    } else {
        let output_path = *Vec::index(&arguments, 0);
        let encoded = ByteBuf::new();
        ByteBuf::write_u32_le(
            &mut encoded,
            wrapping_convert_to_u32(count - 1)
        );
        process_inputs(&arguments, 1, &mut encoded, interfaces);
        write_file(output_path, ByteBuf::finish(encoded))
    }
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    run_application(false)
}

pub interface_application() / {
    ProcessArgs,
    FileRead,
    FileWrite,
    Diagnostic
} {
    run_application(true)
}
