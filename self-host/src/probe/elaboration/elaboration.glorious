use super::super::frontend::elaboration::{
    ConstructionFlavor,
    ConstructionField,
    CoreComputationId,
    CoreComputationView,
    CoreLocalId,
    CoreMatchArm,
    CoreValueId,
    CoreValueView,
    ElaborationError,
    InterfaceCallableId,
    TypedBody,
    TypedInterfaces,
    collect_interfaces,
    elaborate_function_body
};
use super::super::frontend::lexer::TokenKind;
use super::super::frontend::scanner::ShellId;

u32_from_usize(value: usize) -> u32 { wrapping_convert_to_u32(value) }
usize_from_u32(value: u32) -> usize { wrapping_convert_to_usize(value) }

// Read-only debugger entry point for mapping the self-host frontend's stable
// semantic type indices without running body elaboration or backend lowering.
// A zero tuple indicates that an earlier frontend phase failed or the index is
// outside the collected interface arena.
pub interface_type_metadata(
    original: String,
    index: usize
) -> (u32, u32, u32, u32) {
    handle super::super::frontend::lexer::lex(&original) {
        Result::Err(_) => (0, 0, 0, 0),
        Result::Ok(source) => handle
            super::super::frontend::scanner::scan(&source) {
            Result::Err(_) => (0, 0, 0, 0),
            Result::Ok(declarations) => handle
                super::super::frontend::headers::parse(
                    &original,
                    source,
                    &declarations
                ) {
                Result::Err(_) => (0, 0, 0, 0),
                Result::Ok(headers) => handle collect_interfaces(
                    &headers,
                    &declarations
                ) {
                    Result::Err(_) => (0, 0, 0, 0),
                    Result::Ok(interfaces) => if(
                        index < super::super::frontend::elaboration::interface_type_count(
                            &interfaces
                        )
                    ) {
                        (
                            wrapping_convert_to_u32(
                                super::super::frontend::elaboration::interface_type_tag_at(
                                    &interfaces, index
                                )
                            ),
                            super::super::frontend::elaboration::interface_type_a_at(
                                &interfaces, index
                            ),
                            super::super::frontend::elaboration::interface_type_b_at(
                                &interfaces, index
                            ),
                            super::super::frontend::elaboration::interface_type_c_at(
                                &interfaces, index
                            )
                        )
                    } else { (0, 0, 0, 0) }
                }
            }
        }
    }
}

// Focused interface-only probe. This intentionally stops before body
// elaboration or backend lowering, so header collection regressions stay
// isolated from later compiler stages.
pub interface_collection_status(original: String) -> u8 {
    handle super::super::frontend::lexer::lex(&original) {
        Result::Err(_) => 1,
        Result::Ok(source) => handle
            super::super::frontend::scanner::scan(&source) {
            Result::Err(_) => 2,
            Result::Ok(declarations) => handle
                super::super::frontend::headers::parse(
                    &original, source, &declarations
                ) {
                Result::Err(_) => 3,
                Result::Ok(headers) => handle collect_interfaces(
                    &headers, &declarations
                ) {
                    Result::Ok(_) => 0,
                    Result::Err(_) => 4
                }
            }
        }
    }
}

nominal_method_owner_pair_at(
    interfaces: &TypedInterfaces,
    method_index: usize,
    declaration_index: usize
) -> Bool {
    if(declaration_index < super::super::frontend::elaboration::interface_type_count(
        interfaces
    )) {
        if(super::super::frontend::elaboration::interface_type_c_at(
            interfaces, method_index
        ) == 2
            and { super::super::frontend::elaboration::interface_type_c_at(
                interfaces, declaration_index
            ) == 0 }
            and { super::super::frontend::elaboration::interface_type_a_at(
                interfaces, method_index
            ) == super::super::frontend::elaboration::interface_type_a_at(
                interfaces, declaration_index
            ) }) { true } else {
            nominal_method_owner_pair_at(
                interfaces, method_index, declaration_index + 1
            )
        }
    } else { false }
}

nominal_method_owner_pair_exists(
    interfaces: &TypedInterfaces,
    index: usize
) -> Bool {
    if(index < super::super::frontend::elaboration::interface_type_count(
        interfaces
    )) {
        nominal_method_owner_pair_at(interfaces, index, 0)
            or { nominal_method_owner_pair_exists(interfaces, index + 1) }
    } else { false }
}

// Trait/impl method binders use the enclosing shell, just like the nominal
// binders.  This probe proves the method's generic owner remains separately
// branded even when both binders have ordinal zero.
pub nominal_method_generic_owner_status(original: String) -> u8 {
    handle super::super::frontend::lexer::lex(&original) {
        Result::Err(_) => 1,
        Result::Ok(source) => handle
            super::super::frontend::scanner::scan(&source) {
            Result::Err(_) => 2,
            Result::Ok(declarations) => handle
                super::super::frontend::headers::parse(
                    &original, source, &declarations
                ) {
                    Result::Err(_) => 3,
                    Result::Ok(headers) => handle collect_interfaces(
                        &headers, &declarations
                    ) {
                        Result::Err(_) => 4,
                        Result::Ok(interfaces) => if(
                            nominal_method_owner_pair_exists(&interfaces, 0)
                        ) { 0 } else { 5 }
                    }
                }
            }
    }
}

// Header-only trait probe: semantic trait selection is intentionally not
// involved.  It proves that generic trait declarations retain each parsed
// supertrait application in the shared header type arena.
pub trait_header_collection_status(original: String) -> u8 {
    handle super::super::frontend::lexer::lex(&original) {
        Result::Err(_) => 1,
        Result::Ok(source) => handle super::super::frontend::scanner::scan(&source) {
            Result::Err(_) => 2,
            Result::Ok(declarations) => handle super::super::frontend::headers::parse(
                &original, source, &declarations
            ) {
                Result::Err(_) => 3,
                Result::Ok(headers) => {
                    let nominal = super::super::frontend::headers::nominal_index(&headers);
                    if(super::super::frontend::headers::trait_count(nominal) != 2
                        or { super::super::frontend::headers::impl_count(nominal) != 1 }) {
                        4
                    } else {
                        let child = handle super::super::frontend::headers::trait_at(nominal, 1) {
                            Result::Err(_) => unreachable(), Result::Ok(found) => found
                        };
                        let implementation = handle super::super::frontend::headers::impl_at(nominal, 0) {
                            Result::Err(_) => unreachable(), Result::Ok(found) => found
                        };
                        if(super::super::frontend::headers::range_count(
                            super::super::frontend::headers::trait_generics(child)
                        ) != 1
                            or { super::super::frontend::headers::range_count(
                                super::super::frontend::headers::trait_supertraits(child)
                            ) != 2 }
                            or { super::super::frontend::headers::range_count(
                                super::super::frontend::headers::impl_generics(implementation)
                            ) != 1 }) { 5 } else { 0 }
                    }
                }
            }
        }
    }
}

write_constraint_text(
    output: &mut ByteBuf,
    original: &String,
    headers: &super::super::frontend::headers::ParsedHeaders,
    start: usize,
    end: usize
) {
    if(start < end) {
        let source = super::super::frontend::headers::parsed_source(headers);
        let first = handle super::super::frontend::lexer::token_at(
            source, start
        ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) =>
                super::super::frontend::lexer::token_span(found)
        };
        let last = handle super::super::frontend::lexer::token_at(
            source, end - 1
        ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) =>
                super::super::frontend::lexer::token_span(found)
        };
        write_string(
            output,
            &super::super::frontend::lexer::text_slice(
                original,
                super::super::frontend::lexer::span_start(&first),
                super::super::frontend::lexer::span_end(&last)
            )
        )
    } else { write_string(output, &"") }
}

write_effect_type_elements<'a>(
    output: &mut ByteBuf,
    interfaces: &TypedInterfaces,
    elements: Slice<'a, super::super::frontend::elaboration::TypeId>,
    effect_shell: ShellId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId,
    ordinal: usize
) {
    if(ordinal < Slice::len(elements)) {
        let ty = handle Slice::get(elements, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => *found
        };
        write_effect_type(
            output, interfaces, ty, effect_shell, operation
        );
        write_effect_type_elements(
            output,
            interfaces,
            elements,
            effect_shell,
            operation,
            ordinal + 1
        )
    } else { () }
}

write_constraint_argument(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    interfaces: &TypedInterfaces,
    argument: super::super::frontend::elaboration::ConstraintArgumentId,
    effect_shell: ShellId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId
) {
    let kind = super::super::frontend::elaboration::constraint_argument_kind_code(
        interfaces, argument
    );
    ByteBuf::push(output, kind);
    handle kind {
        1 => write_effect_type(
            output,
            interfaces,
            handle super::super::frontend::elaboration::constraint_argument_type(
                interfaces, argument
            ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            },
            effect_shell,
            operation
        ),
        2 => write_name_id(
            output,
            source,
            Id::from_u32(handle
                super::super::frontend::elaboration::constraint_argument_name(
                    interfaces, argument
                ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            })
        ),
        3 => {
            ByteBuf::write_u32_le(output, handle
                super::super::frontend::elaboration::constraint_argument_lower(
                    interfaces, argument
                ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            });
            handle super::super::frontend::elaboration::constraint_argument_upper(
                interfaces, argument
            ) {
                Result::Err(_) => ByteBuf::push(output, 0),
                Result::Ok(found) => {
                    ByteBuf::push(output, 1);
                    ByteBuf::write_u32_le(output, found)
                }
            }
        },
        4 => ByteBuf::write_u32_le(output, handle
            super::super::frontend::elaboration::constraint_argument_lower(
                interfaces, argument
            ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        }),
        _ => unreachable()
    }
}

write_constraint_arguments(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    interfaces: &TypedInterfaces,
    goal: super::super::frontend::elaboration::ConstraintGoalId,
    effect_shell: ShellId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId,
    ordinal: u32
) {
    let count = super::super::frontend::elaboration::constraint_goal_argument_count(
        interfaces, goal
    );
    if(ordinal < count) {
        let argument = handle
            super::super::frontend::elaboration::constraint_goal_argument_id(
                interfaces, goal, ordinal
            ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_constraint_argument(
            output, source, interfaces, argument, effect_shell, operation
        );
        write_constraint_arguments(
            output, source, interfaces, goal, effect_shell, operation,
            ordinal + 1
        )
    } else { () }
}

write_binding_arguments(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    interfaces: &TypedInterfaces,
    binding: super::super::frontend::elaboration::ConstraintBindingId,
    effect_shell: ShellId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId,
    ordinal: u32
) {
    let count =
        super::super::frontend::elaboration::constraint_binding_argument_count(
            interfaces, binding
        );
    if(ordinal < count) {
        let argument = handle
            super::super::frontend::elaboration::constraint_binding_argument_id(
                interfaces, binding, ordinal
            ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_constraint_argument(
            output, source, interfaces, argument, effect_shell, operation
        );
        write_binding_arguments(
            output, source, interfaces, binding, effect_shell, operation,
            ordinal + 1
        )
    } else { () }
}

write_constraint_binding(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    interfaces: &TypedInterfaces,
    binding: super::super::frontend::elaboration::ConstraintBindingId,
    effect_shell: ShellId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId
) {
    write_name_id(
        output,
        source,
        Id::from_u32(
            super::super::frontend::elaboration::constraint_binding_name(
                interfaces, binding
            )
        )
    );
    let argument_count =
        super::super::frontend::elaboration::constraint_binding_argument_count(
            interfaces, binding
        );
    ByteBuf::write_u32_le(output, argument_count);
    write_binding_arguments(
        output, source, interfaces, binding, effect_shell, operation, 0
    );
    let kind =
        super::super::frontend::elaboration::constraint_binding_value_kind_code(
            interfaces, binding
        );
    ByteBuf::push(output, kind);
    if(kind == 1) {
        write_effect_type(
            output,
            interfaces,
            handle super::super::frontend::elaboration::constraint_binding_type(
                interfaces, binding
            ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            },
            effect_shell,
            operation
        )
    } else {
        let count =
            super::super::frontend::elaboration::constraint_binding_effect_count(
                interfaces, binding
            );
        ByteBuf::write_u32_le(output, count);
        for_range(Range::new(0, usize_from_u32(count)), { ordinal => {
            write_effect_type(
                output,
                interfaces,
                handle super::super::frontend::elaboration::constraint_binding_effect_at(
                    interfaces, binding, u32_from_usize(ordinal)
                ) {
                    Result::Err(_) => unreachable(),
                    Result::Ok(found) => found
                },
                effect_shell,
                operation
            )
        }});
        handle super::super::frontend::elaboration::constraint_binding_effect_tail(
            interfaces, binding
        ) {
            Result::Err(_) => ByteBuf::push(output, 0),
            Result::Ok(found) => {
                ByteBuf::push(output, 1);
                write_name_id(output, source, Id::from_u32(found))
            }
        }
    }
}

write_constraint_bindings(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    interfaces: &TypedInterfaces,
    goal: super::super::frontend::elaboration::ConstraintGoalId,
    effect_shell: ShellId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId,
    ordinal: u32
) {
    let count = super::super::frontend::elaboration::constraint_goal_binding_count(
        interfaces, goal
    );
    if(ordinal < count) {
        let binding = handle
            super::super::frontend::elaboration::constraint_goal_binding_id(
                interfaces, goal, ordinal
            ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_constraint_binding(
            output, source, interfaces, binding, effect_shell, operation
        );
        write_constraint_bindings(
            output, source, interfaces, goal, effect_shell, operation,
            ordinal + 1
        )
    } else { () }
}

write_constraint_goal(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    interfaces: &TypedInterfaces,
    goal: super::super::frontend::elaboration::ConstraintGoalId,
    effect_shell: ShellId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId
) {
    let binder_count =
        super::super::frontend::elaboration::constraint_goal_binder_count(
            interfaces, goal
        );
    ByteBuf::write_u32_le(output, binder_count);
    for_range(Range::new(0, usize_from_u32(binder_count)), { ordinal => {
        write_name_id(
            output,
            source,
            Id::from_u32(handle
                super::super::frontend::elaboration::constraint_goal_binder_name(
                    interfaces, goal, u32_from_usize(ordinal)
                ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            })
        )
    }});
    write_effect_type(
        output,
        interfaces,
        super::super::frontend::elaboration::constraint_goal_subject(
            interfaces, goal
        ),
        effect_shell,
        operation
    );
    ByteBuf::push(output, if(
        super::super::frontend::elaboration::constraint_goal_is_negative(
            interfaces, goal
        )
    ) { 1 } else { 0 });
    write_name_id(
        output,
        source,
        Id::from_u32(
            super::super::frontend::elaboration::constraint_goal_relation_name(
                interfaces, goal
            )
        )
    );
    let argument_count =
        super::super::frontend::elaboration::constraint_goal_argument_count(
            interfaces, goal
        );
    ByteBuf::write_u32_le(output, argument_count);
    write_constraint_arguments(
        output, source, interfaces, goal, effect_shell, operation, 0
    );
    let binding_count =
        super::super::frontend::elaboration::constraint_goal_binding_count(
            interfaces, goal
        );
    ByteBuf::write_u32_le(output, binding_count);
    write_constraint_bindings(
        output, source, interfaces, goal, effect_shell, operation, 0
    )
}

write_effect_constraint_goals(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    interfaces: &TypedInterfaces,
    effect_id: super::super::frontend::elaboration::InterfaceEffectId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId,
    operation_clause: Bool,
    ordinal: u32
) {
    let count = if(operation_clause) {
        super::super::frontend::elaboration::interface_effect_operation_constraint_goal_count(
            interfaces, operation
        )
    } else {
        super::super::frontend::elaboration::interface_effect_constraint_goal_count(
            interfaces, effect_id
        )
    };
    if(ordinal < count) {
        let goal = if(operation_clause) {
            handle super::super::frontend::elaboration::interface_effect_operation_constraint_goal_id(
                interfaces, operation, ordinal
            ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }
        } else {
            handle super::super::frontend::elaboration::interface_effect_constraint_goal_id(
                interfaces, effect_id, ordinal
            ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            }
        };
        write_constraint_goal(
            output,
            source,
            interfaces,
            goal,
            super::super::frontend::elaboration::interface_effect_shell(
                interfaces, effect_id
            ),
            operation
        );
        write_effect_constraint_goals(
            output, source, interfaces, effect_id, operation, operation_clause,
            ordinal + 1
        )
    } else { () }
}

write_effect_type(
    output: &mut ByteBuf,
    interfaces: &TypedInterfaces,
    ty: super::super::frontend::elaboration::TypeId,
    effect_shell: ShellId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId
) {
    handle super::super::frontend::elaboration::interface_type_at(
        interfaces, Id::to_usize(ty)
    ) {
        super::super::frontend::elaboration::InterfaceTypeView::Unit =>
            ByteBuf::push(output, 1),
        super::super::frontend::elaboration::InterfaceTypeView::Never =>
            ByteBuf::push(output, 2),
        super::super::frontend::elaboration::InterfaceTypeView::Scalar(kind) => {
            ByteBuf::push(output, 3);
            ByteBuf::push(output, kind)
        },
        super::super::frontend::elaboration::InterfaceTypeView::Tuple(elements) => {
            ByteBuf::push(output, 4);
            ByteBuf::write_u32_le(output, u32_from_usize(Slice::len(elements)));
            write_effect_type_elements(
                output, interfaces, elements, effect_shell, operation, 0
            )
        },
        super::super::frontend::elaboration::InterfaceTypeView::Nominal(id) => {
            ByteBuf::push(output, 5);
            ByteBuf::write_u32_le(output, id)
        },
        super::super::frontend::elaboration::InterfaceTypeView::SharedReference(child) => {
            ByteBuf::push(output, 6);
            write_effect_type(
                output, interfaces, Id::from_u32(child), effect_shell, operation
            )
        },
        super::super::frontend::elaboration::InterfaceTypeView::UniqueReference(child) => {
            ByteBuf::push(output, 7);
            write_effect_type(
                output, interfaces, Id::from_u32(child), effect_shell, operation
            )
        },
        super::super::frontend::elaboration::InterfaceTypeView::TypeParameter(
            owner_kind, owner, ordinal
        ) => {
            ByteBuf::push(output, 8);
            let role = if(owner_kind == 0 and { owner == Id::to_u32(effect_shell) }) {
                1
            } else {
                if(owner_kind == 1 and { owner == Id::to_u32(operation) }) {
                    2
                } else { 0 }
            };
            ByteBuf::push(output, role);
            ByteBuf::write_u32_le(output, ordinal)
        },
        super::super::frontend::elaboration::InterfaceTypeView::Array(child) => {
            ByteBuf::push(output, 9);
            write_effect_type(
                output, interfaces, Id::from_u32(child), effect_shell, operation
            )
        },
        super::super::frontend::elaboration::InterfaceTypeView::Application(
            constructor, elements
        ) => {
            ByteBuf::push(output, 10);
            write_effect_type(
                output,
                interfaces,
                Id::from_u32(constructor),
                effect_shell,
                operation
            );
            ByteBuf::write_u32_le(output, u32_from_usize(Slice::len(elements)));
            write_effect_type_elements(
                output, interfaces, elements, effect_shell, operation, 0
            )
        },
        super::super::frontend::elaboration::InterfaceTypeView::Text =>
            ByteBuf::push(output, 11),
        super::super::frontend::elaboration::InterfaceTypeView::Bytes =>
            ByteBuf::push(output, 12),
        super::super::frontend::elaboration::InterfaceTypeView::Effect(id) => {
            ByteBuf::push(output, 13);
            ByteBuf::write_u32_le(output, id)
        },
        // The probe wire format deliberately has no callable descriptor yet.
        // A future encoder must make that ABI explicit rather than silently
        // treating a closure as a nominal or effect type.
        super::super::frontend::elaboration::InterfaceTypeView::Callable(_) =>
            unreachable()
    }
}

write_effect_operation(
    output: &mut ByteBuf,
    original: &String,
    headers: &super::super::frontend::headers::ParsedHeaders,
    interfaces: &TypedInterfaces,
    effect_id: super::super::frontend::elaboration::InterfaceEffectId,
    operation:
        super::super::frontend::elaboration::InterfaceEffectOperationId
) {
    let source = super::super::frontend::headers::parsed_source(headers);
    write_name_id(
        output,
        source,
        Id::from_u32(
            super::super::frontend::elaboration::interface_effect_operation_name(
                interfaces, operation
            )
        )
    );
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::elaboration::interface_effect_operation_ordinal(
            interfaces, operation
        )
    );
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::elaboration::interface_effect_operation_generic_count(
            interfaces, operation
        )
    );
    write_constraint_text(
        output,
        original,
        headers,
        super::super::frontend::elaboration::interface_effect_operation_constraint_start(
            interfaces, operation
        ),
        super::super::frontend::elaboration::interface_effect_operation_constraint_end(
            interfaces, operation
        )
    );
    let constraint_count =
        super::super::frontend::elaboration::interface_effect_operation_constraint_goal_count(
            interfaces, operation
        );
    ByteBuf::write_u32_le(output, constraint_count);
    write_effect_constraint_goals(
        output, source, interfaces, effect_id, operation, true, 0
    );
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::elaboration::interface_effect_operation_constraint_lifetime_count(
            interfaces, operation
        )
    );
    let payload_count =
        super::super::frontend::elaboration::interface_effect_operation_payload_count(
            interfaces, operation
        );
    ByteBuf::write_u32_le(output, payload_count);
    for_range(Range::new(0, wrapping_convert_to_usize(payload_count)), { ordinal => {
        let ty = handle
            super::super::frontend::elaboration::interface_effect_operation_payload_at(
                interfaces, operation, u32_from_usize(ordinal)
            ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        write_effect_type(
            output,
            interfaces,
            ty,
            super::super::frontend::elaboration::interface_effect_shell(
                interfaces, effect_id
            ),
            operation
        )
    }});
    write_effect_type(
        output,
        interfaces,
        super::super::frontend::elaboration::interface_effect_operation_result(
            interfaces, operation
        ),
        super::super::frontend::elaboration::interface_effect_shell(
            interfaces, effect_id
        ),
        operation
    );
    ByteBuf::push(
        output,
        if(super::super::frontend::elaboration::interface_effect_operation_is_terminal(
            interfaces, operation
        )) { 1 } else { 0 }
    );
    ByteBuf::write_u32_le(
        output,
        super::super::frontend::elaboration::interface_effect_operation_resumption_lower(
            interfaces, operation
        )
    );
    handle super::super::frontend::elaboration::interface_effect_operation_resumption_upper(
        interfaces, operation
    ) {
        Result::Err(_) => ByteBuf::push(output, 0),
        Result::Ok(found) => {
            ByteBuf::push(output, 1);
            ByteBuf::write_u32_le(output, found)
        }
    }
}

write_effects(
    output: &mut ByteBuf,
    original: &String,
    headers: &super::super::frontend::headers::ParsedHeaders,
    interfaces: &TypedInterfaces,
    index: usize
) {
    let source = super::super::frontend::headers::parsed_source(headers);
    if(index < super::super::frontend::elaboration::interface_effect_count(
        interfaces
    )) {
        let id = handle
            super::super::frontend::elaboration::interface_effect_id_at(
                interfaces, index
            ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        ByteBuf::write_u32_le(
            output,
            super::super::frontend::elaboration::interface_effect_generic_count(
                interfaces, id
            )
        );
        write_constraint_text(
            output,
            original,
            headers,
            super::super::frontend::elaboration::interface_effect_constraint_start(
                interfaces, id
            ),
            super::super::frontend::elaboration::interface_effect_constraint_end(
                interfaces, id
            )
        );
        let count =
            super::super::frontend::elaboration::interface_effect_operation_count(
                interfaces, id
            );
        let constraint_count =
            super::super::frontend::elaboration::interface_effect_constraint_goal_count(
                interfaces, id
            );
        ByteBuf::write_u32_le(output, constraint_count);
        if(constraint_count > 0) {
            let first_operation = handle
                super::super::frontend::elaboration::interface_effect_operation_id(
                    interfaces, id, 0
                ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            };
            write_effect_constraint_goals(
                output, source, interfaces, id, first_operation, false, 0
            )
        } else { () };
        ByteBuf::write_u32_le(
            output,
            super::super::frontend::elaboration::interface_effect_constraint_lifetime_count(
                interfaces, id
            )
        );
        ByteBuf::write_u32_le(output, count);
        for_range(Range::new(0, wrapping_convert_to_usize(count)), { ordinal => {
            let operation = handle
                super::super::frontend::elaboration::interface_effect_operation_id(
                    interfaces, id, u32_from_usize(ordinal)
                ) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => found
            };
            write_effect_operation(
                output, original, headers, interfaces, id, operation
            )
        }});
        write_effects(output, original, headers, interfaces, index + 1)
    } else { () }
}

effect_error_code(value: ElaborationError) -> u8 {
    handle value {
        ElaborationError::DuplicateEffectGeneric(_, _) => 101,
        ElaborationError::DuplicateEffectOperation(_, _) => 102,
        ElaborationError::DuplicateEffectOperationGeneric(_, _) => 103,
        ElaborationError::TerminalOperationResumptionQuantity(_) => 104,
        ElaborationError::InvalidResumptionInterval(_) => 105,
        ElaborationError::ResumptionQuantityOverflow(_) => 106,
        ElaborationError::UnknownConstraintRelation(_) => 107,
        ElaborationError::InvalidConstraintRelation(_, _) => 108,
        ElaborationError::InvalidHigherRankedConstraintBinder(_) => 109,
        ElaborationError::ConstraintIntegerOverflow(_) => 110,
        ElaborationError::UnknownConstraintLifetime(_) => 111,
        _ => 4
    }
}

pub effect_interface_bytes(original: String) -> Bytes {
    let output = ByteBuf::new();
    handle super::super::frontend::lexer::lex(&original) {
        Result::Err(_) => ByteBuf::push(&mut output, 1),
        Result::Ok(source) => handle super::super::frontend::scanner::scan(
            &source
        ) {
            Result::Err(_) => ByteBuf::push(&mut output, 2),
            Result::Ok(declarations) => handle
                super::super::frontend::headers::parse(
                    &original, source, &declarations
                ) {
                Result::Err(_) => ByteBuf::push(&mut output, 3),
                Result::Ok(headers) => handle collect_interfaces(
                    &headers, &declarations
                ) {
                    Result::Err(error) =>
                        ByteBuf::push(&mut output, effect_error_code(error)),
                    Result::Ok(interfaces) => {
                        ByteBuf::push(&mut output, 0);
                        ByteBuf::write_u32_le(
                            &mut output,
                            u32_from_usize(
                                super::super::frontend::elaboration::interface_effect_count(
                                    &interfaces
                                )
                            )
                        );
                        write_effects(
                            &mut output,
                            &original,
                            &headers,
                            &interfaces,
                            0
                        )
                    }
                }
            }
        }
    };
    ByteBuf::finish(output)
}

process_effect_interface_inputs(
    arguments: &Vec<String>,
    index: usize,
    output: &mut ByteBuf
) / FileRead {
    if(index < Vec::len(arguments)) {
        let path = *Vec::index(arguments, index);
        let bytes = read_file(path);
        handle String::from_utf8(bytes) {
            Result::Err(_) => ByteBuf::push(&mut *output, 1),
            Result::Ok(source) => {
                let encoded = effect_interface_bytes(source);
                ByteBuf::append_bytes(&mut *output, &encoded)
            }
        };
        process_effect_interface_inputs(
            arguments, index + 1, &mut *output
        )
    } else { () }
}

pub effect_interface_application() / {
    ProcessArgs,
    FileRead,
    FileWrite,
    Diagnostic
} {
    let arguments = process_args();
    let count = Vec::len(&arguments);
    if(count < 2) {
        write_diagnostic(
            "usage: grandiose-self-host-effect-interfaces <output> <input>..."
        )
    } else {
        let output_path = *Vec::index(&arguments, 0);
        let encoded = ByteBuf::new();
        ByteBuf::write_u32_le(
            &mut encoded, u32_from_usize(count - 1)
        );
        process_effect_interface_inputs(&arguments, 1, &mut encoded);
        write_file(output_path, ByteBuf::finish(encoded))
    }
}

shell_parent_module(
    shell: &super::super::frontend::scanner::DeclarationShell
) -> Option<ShellId> {
    *super::super::frontend::scanner::shell_parent(shell)
}

write_string(output: &mut ByteBuf, value: &String) {
    let bytes = String::as_bytes(value);
    ByteBuf::write_u32_le(&mut *output, u32_from_usize(Bytes::len(&bytes)));
    ByteBuf::append_bytes( output, &bytes)
}

write_name_id(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    name: Id<String>
) {
    handle super::super::frontend::lexer::lexeme(source, name) {
        Result::Err(_) => unreachable(),
        Result::Ok(text) => write_string( output, text)
    }
}

write_name_token(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    token: usize
) {
    handle super::super::frontend::lexer::token_kind_at(source, token) {
        TokenKind::Ident(name) => write_name_id( output, source, name),
        _ => unreachable()
    }
}

shell_name_id(shell: &super::super::frontend::scanner::DeclarationShell) -> Id<String> {
    handle Option::as_ref(super::super::frontend::scanner::shell_name(shell)) {
        Result::Err(_) => unreachable(),
        Result::Ok(name) => *name
    }
}

module_depth(
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    module: Option<ShellId>
) -> usize {
    handle module {
        Result::Err(_) => 0,
        Result::Ok(index) => handle super::super::frontend::scanner::shell_at(
            declarations,
            index
        ) {
            Result::Err(_) => unreachable(),
            Result::Ok(shell) => 1 + module_depth(
                declarations,
                shell_parent_module(shell)
            )
        }
    }
}

write_module_components(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    module: Option<ShellId>
) {
    handle module {
        Result::Err(_) => (),
        Result::Ok(index) => handle super::super::frontend::scanner::shell_at(
            declarations,
            index
        ) {
            Result::Err(_) => unreachable(),
            Result::Ok(shell) => {
                let parent = shell_parent_module(shell);
                let name = shell_name_id(shell);
                write_module_components(
                    &mut *output,
                    source,
                    declarations,
                    parent
                );
                write_name_id( output, source, name)
            }
        }
    }
}

write_function_identity(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    shell_id: ShellId
) {
    handle super::super::frontend::scanner::shell_at(declarations, shell_id) {
        Result::Err(_) => unreachable(),
        Result::Ok(shell) => {
            let parent = shell_parent_module(shell);
            let name = shell_name_id(shell);
            ByteBuf::write_u32_le(
                &mut *output,
                u32_from_usize(module_depth(declarations, parent))
            );
            write_module_components(
                &mut *output,
                source,
                declarations,
                parent
            );
            write_name_id( output, source, name)
        }
    }
}

find_callable<'a>(
    headers: &'a super::super::frontend::headers::HeaderIndex,
    shell: ShellId,
    index: usize
) -> Option<&'a super::super::frontend::headers::CallableHeader> {
    if(index < super::super::frontend::headers::callable_count(headers)) {
        let callable = try(
            super::super::frontend::headers::callable_at(headers, index),
            @find_callable
        );
        if(super::super::frontend::headers::callable_shell(callable) == shell) {
            Result::Ok(callable)
        } else {
            find_callable(headers, shell, index + 1)
        }
    } else { Result::Err(()) }
}

value_uses_local(
    body: &TypedBody,
    value: CoreValueId,
    local: CoreLocalId
) -> Bool {
    handle super::super::frontend::elaboration::typed_body_value_at(
        body,
        value
    ) {
        CoreValueView::Local(_, found, _, _) => found == local,
        CoreValueView::Projection(_, subject, _) =>
            value_uses_local(body, subject, local),
        CoreValueView::Embedded(_, computation) =>
            computation_uses_local(body, computation, local),
        CoreValueView::Closure(_, site) =>
            closure_captures_use_local(
                body,
                super::super::frontend::elaboration::closure_site_captures(
                    body,
                    super::super::frontend::elaboration::closure_site_at(
                        body, site
                    )
                ),
                0,
                local
            ),
        _ => false
    }
}

closure_captures_use_local<'a>(
    body: &TypedBody,
    captures: Slice<'a, super::super::frontend::elaboration::CoreClosureCapture>,
    ordinal: usize,
    local: CoreLocalId
) -> Bool {
    if(ordinal < Slice::len(captures)) {
        let capture = handle Slice::get(captures, ordinal) {
            Result::Err(_) => unreachable(), Result::Ok(found) => found
        };
        if(value_uses_local(
            body,
            super::super::frontend::elaboration::core_closure_capture_value(capture),
            local
        )) { true } else {
            closure_captures_use_local(body, captures, ordinal + 1, local)
        }
    } else { false }
}

values_use_local<'a>(
    body: &TypedBody,
    values: Slice<'a, CoreValueId>,
    ordinal: usize,
    local: CoreLocalId
) -> Bool {
    if(ordinal < Slice::len(values)) {
        let value = handle Slice::get(values, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => *found
        };
        if(value_uses_local(body, value, local)) {
            true
        } else {
            values_use_local(body, values, ordinal + 1, local)
        }
    } else { false }
}

construction_fields_use_local<'a>(
    body: &TypedBody,
    fields: Slice<'a, ConstructionField>,
    ordinal: usize,
    local: CoreLocalId
) -> Bool {
    if(ordinal < Slice::len(fields)) {
        let field = handle Slice::get(fields, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        if(value_uses_local(
            body,
            super::super::frontend::elaboration::construction_field_value(field),
            local
        )) {
            true
        } else {
            construction_fields_use_local(body, fields, ordinal + 1, local)
        }
    } else { false }
}

match_arms_use_local<'a>(
    body: &TypedBody,
    arms: Slice<'a, CoreMatchArm>,
    ordinal: usize,
    local: CoreLocalId
) -> Bool {
    if(ordinal < Slice::len(arms)) {
        let arm = handle Slice::get(arms, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        if(computation_uses_local(
            body,
            super::super::frontend::elaboration::core_match_arm_body(arm),
            local
        )) {
            true
        } else {
            match_arms_use_local(body, arms, ordinal + 1, local)
        }
    } else { false }
}

computation_uses_local(
    body: &TypedBody,
    computation: CoreComputationId,
    local: CoreLocalId
) -> Bool {
    handle super::super::frontend::elaboration::typed_body_computation_at(
        body,
        computation
    ) {
        CoreComputationView::Pure(_, value) =>
            value_uses_local(body, value, local),
        CoreComputationView::Let(_, _, initializer, remainder) =>
            if(computation_uses_local(body, initializer, local)) {
                true
            } else {
                computation_uses_local(body, remainder, local)
            },
        CoreComputationView::Call(_, _, _, operands) =>
            values_use_local(body, operands, 0, local),
        CoreComputationView::CallIndirect(_, callee, _, operands) =>
            value_uses_local(body, callee, local)
                or { values_use_local(body, operands, 0, local) },
        CoreComputationView::Primitive(_, _, operands) =>
            values_use_local(body, operands, 0, local),
        CoreComputationView::Construct(_, _, fields) =>
            construction_fields_use_local(body, fields, 0, local),
        CoreComputationView::VariantDispatch(_, subject, arms) =>
            if(value_uses_local(body, subject, local)) {
                true
            } else {
                match_arms_use_local(body, arms, 0, local)
            },
        CoreComputationView::Perform(_, _, operands) =>
            values_use_local(body, operands, 0, local),
        CoreComputationView::Resume(_, resumption, result) =>
            value_uses_local(body, resumption, local)
                or { value_uses_local(body, result, local) },
        CoreComputationView::Handle(_, handled, _) =>
            computation_uses_local(body, handled, local)
    }
}

serialized_type_id(ty: u32) -> u32 {
    if(ty < 19) { ty } else { 2147483648 + (ty - 19) }
}

write_type_id(output: &mut ByteBuf, ty: u32) {
    ByteBuf::write_u32_le(output, serialized_type_id(ty))
}

write_value_expression(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    body: &TypedBody,
    value: CoreValueId,
    source_local_limit: u32,
    force_copy: Bool
) -> Result<(), ElaborationError> {
    handle super::super::frontend::elaboration::typed_body_value_at(
        body,
        value
    ) {
        CoreValueView::Unit(ty) => {
            ByteBuf::push(output, 0);
            write_type_id(output, Id::to_u32(ty));
            Result::Ok(())
        },
        CoreValueView::Text(ty, bytes) => {
            ByteBuf::push(output, 8);
            write_type_id(output, Id::to_u32(ty));
            ByteBuf::write_u32_le(output, u32_from_usize(Bytes::len(&bytes)));
            ByteBuf::append_bytes(output, &bytes);
            Result::Ok(())
        },
        CoreValueView::Bytes(ty, bytes) => {
            // Tag 11 distinguishes raw bytes from UTF-8 text (tag 8).  This
            // writes the decoded payload, including escapes, exactly as the
            // Rust Typed-Core oracle does.
            ByteBuf::push(output, 11);
            write_type_id(output, Id::to_u32(ty));
            ByteBuf::write_u32_le(output, u32_from_usize(Bytes::len(&bytes)));
            ByteBuf::append_bytes(output, &bytes);
            Result::Ok(())
        },
        CoreValueView::Integer(ty, constant_id) => {
            let constant =
                super::super::frontend::elaboration::typed_body_integer_constant_at(
                    body,
                    constant_id
                );
            // Core retains integer constants as four little-endian words.  The
            // probe wire format must retain all four too: rejecting nonzero
            // high words made valid u128/i128 literals look like elaboration
            // failures even though the bootstrap compiler accepts them.
            ByteBuf::push(output, 1);
            write_type_id(output, Id::to_u32(ty));
            ByteBuf::write_u32_le(
                output,
                super::super::frontend::elaboration::integer_constant_view_word(
                    &constant,
                    0
                )
            );
            ByteBuf::write_u32_le(
                output,
                super::super::frontend::elaboration::integer_constant_view_word(
                    &constant,
                    1
                )
            );
            ByteBuf::write_u32_le(
                output,
                super::super::frontend::elaboration::integer_constant_view_word(
                    &constant,
                    2
                )
            );
            ByteBuf::write_u32_le(
                output,
                super::super::frontend::elaboration::integer_constant_view_word(
                    &constant,
                    3
                )
            );
            Result::Ok(())
        },
        CoreValueView::Local(ty, local_id, copy, _) => {
            let local = Id::to_u32(local_id);
            if(local < source_local_limit) {
                ByteBuf::push(output, 2);
                write_type_id(output, Id::to_u32(ty));
                ByteBuf::write_u32_le(output, local);
                ByteBuf::push(
                    output,
                    if(force_copy) { 1 } else {
                        if(copy) { 1 } else { 0 }
                    }
                );
                Result::Ok(())
            } else {
                Result::Err(ElaborationError::InvalidLocalReference(
                    usize_from_u32(local),
                    source_local_limit,
                    local
                ))
            }
        },
        CoreValueView::Projection(ty, subject, field) => {
            ByteBuf::push(output, 7);
            write_type_id(output, Id::to_u32(ty));
            ByteBuf::write_u32_le(output, field);
            ByteBuf::push(output, 1);
            ByteBuf::write_u32_le(output, 0);
            write_value_expression(
                output,
                source,
                declarations,
                body,
                subject,
                source_local_limit,
                true
            )
        },
        CoreValueView::Embedded(_, _) => Result::Err(
            ElaborationError::EmbeddedValueSerializationUnsupported(
                Id::to_usize(value)
            )
        ),
        CoreValueView::Closure(_, _) => Result::Err(
            ElaborationError::UnsupportedExpression(Id::to_usize(value))
        )
    }
}

write_operand_expression(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    resolved: &super::super::frontend::resolution::ResolvedBody,
    body: &TypedBody,
    value: CoreValueId,
    source_local_limit: u32,
    force_copy: Bool
) -> Result<(), ElaborationError> {
    handle super::super::frontend::elaboration::typed_body_value_at(
        body,
        value
    ) {
        CoreValueView::Embedded(_, computation) => write_computation_expression(
            output,
            source,
            declarations,
            resolved,
            body,
            computation,
            source_local_limit,
            false
        ),
        _ => write_value_expression(
            output,
            source,
            declarations,
            body,
            value,
            source_local_limit,
            force_copy
        )
    }
}

construction_local_occurrences<'a>(
    body: &TypedBody,
    fields: Slice<'a, ConstructionField>,
    ordinal: usize,
    local: CoreLocalId,
    count: usize
) -> usize {
    if(ordinal < Slice::len(fields)) {
        let field = handle Slice::get(fields, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        construction_local_occurrences(
            body,
            fields,
            ordinal + 1,
            local,
            if(value_uses_local(
                body,
                super::super::frontend::elaboration::construction_field_value(
                    field
                ),
                local
            )) { count + 1 } else { count }
        )
    } else { count }
}

write_construct_fields<'a>(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    resolved: &super::super::frontend::resolution::ResolvedBody,
    body: &TypedBody,
    source_local_limit: u32,
    fields: Slice<'a, ConstructionField>
) -> Result<(), ElaborationError> {
    Slice::try_for_each(fields, { field => {
        let field_value =
            super::super::frontend::elaboration::construction_field_value(field);
        let force_copy = handle
            super::super::frontend::elaboration::typed_body_value_at(
                body,
                field_value
            ) {
            CoreValueView::Local(_, local, _, _) =>
                1 < construction_local_occurrences(
                    body,
                    fields,
                    0,
                    local,
                    0
                ),
            _ => false
        };
        ByteBuf::write_u32_le(
            output,
            super::super::frontend::elaboration::construction_field_ordinal(field)
        );
        write_operand_expression(
            output,
            source,
            declarations,
            resolved,
            body,
            field_value,
            source_local_limit,
            force_copy
        )
    }})
}

write_call_operands<'a>(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    resolved: &super::super::frontend::resolution::ResolvedBody,
    body: &TypedBody,
    source_local_limit: u32,
    operands: Slice<'a, CoreValueId>
) -> Result<(), ElaborationError> {
    Slice::try_for_each(operands, { value =>
        write_operand_expression(
            output,
            source,
            declarations,
            resolved,
            body,
            *value,
            source_local_limit,
            false
        )
    })
}

leading_let_count(
    body: &TypedBody,
    computation: CoreComputationId,
    count: u32
) -> u32 {
    handle super::super::frontend::elaboration::typed_body_computation_at(
        body,
        computation
    ) {
        CoreComputationView::Let(_, _, _, remainder) =>
            leading_let_count(body, remainder, count + 1),
        _ => count
    }
}

construction_flavor_word(value: ConstructionFlavor) -> u32 {
    handle value {
        ConstructionFlavor::Product => 0,
        ConstructionFlavor::Variant(ordinal) => ordinal + 1
    }
}

write_variant_dispatch_arms<'a>(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    resolved: &super::super::frontend::resolution::ResolvedBody,
    body: &TypedBody,
    source_local_limit: u32,
    arms: Slice<'a, super::super::frontend::elaboration::CoreMatchArm>,
    ordinal: usize,
    computation: CoreComputationId
) -> Result<(), ElaborationError> {
    if(ordinal < Slice::len(arms)) {
        let arm = handle Slice::get(arms, ordinal) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        // This protocol tag deliberately covers only nullary enum arms.  A
        // binding entry exists for every payload (including `_`), so zero is
        // also a checked proof that no payload shape was erased from the wire.
        if(Slice::len(
            super::super::frontend::elaboration::core_match_arm_bindings(
                body,
                arm
            )
        ) != 0) { Result::Err(
            ElaborationError::VariantDispatchSerializationUnsupported(
                Id::to_usize(computation)
            )
        ) } else {
            ByteBuf::write_u32_le(
                output,
                super::super::frontend::elaboration::core_match_arm_variant(arm)
            );
            try(write_computation_expression(
                output,
                source,
                declarations,
                resolved,
                body,
                super::super::frontend::elaboration::core_match_arm_body(arm),
                source_local_limit,
                true
            ), @write_variant_dispatch_arms);
            write_variant_dispatch_arms(
                output,
                source,
                declarations,
                resolved,
                body,
                source_local_limit,
                arms,
                ordinal + 1,
                computation
            )
        }
    } else { Result::Ok(()) }
}

write_computation_expression(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    resolved: &super::super::frontend::resolution::ResolvedBody,
    body: &TypedBody,
    computation: CoreComputationId,
    source_local_limit: u32,
    tail_position: Bool
) -> Result<(), ElaborationError> {
    handle super::super::frontend::elaboration::typed_body_computation_at(
        body,
        computation
    ) {
        CoreComputationView::Pure(_, value) => write_value_expression(
            output,
            source,
            declarations,
            body,
            value,
            source_local_limit,
            false
        ),
        CoreComputationView::Let(_, _, _, _) => write_block_expression(
            output,
            source,
            declarations,
            resolved,
            body,
            computation,
            source_local_limit,
            tail_position
        ),
        CoreComputationView::Call(ty, shell, _, operands) => {
            ByteBuf::push(output, if(tail_position) { 4 } else { 3 });
            write_type_id(output, Id::to_u32(ty));
            write_function_identity(output, source, declarations, shell);
            ByteBuf::write_u32_le(
                output,
                u32_from_usize(Slice::len(operands))
            );
            write_call_operands(
                output,
                source,
                declarations,
                resolved,
                body,
                source_local_limit,
                operands
            )
        },
        CoreComputationView::CallIndirect(_, _, _, _) => Result::Err(
            ElaborationError::UnsupportedExpression(Id::to_usize(computation))
        ),
        CoreComputationView::Primitive(ty, primitive, operands) => {
            ByteBuf::push(output, 9);
            write_type_id(output, Id::to_u32(ty));
            ByteBuf::write_u32_le(output, primitive);
            ByteBuf::write_u32_le(
                output,
                u32_from_usize(Slice::len(operands))
            );
            write_call_operands(
                output,
                source,
                declarations,
                resolved,
                body,
                source_local_limit,
                operands
            )
        },
        CoreComputationView::Construct(ty, flavor, fields) => {
            ByteBuf::push(output, 6);
            write_type_id(output, Id::to_u32(ty));
            write_type_id(output, Id::to_u32(ty));
            ByteBuf::write_u32_le(output, construction_flavor_word(flavor));
            ByteBuf::write_u32_le(
                output,
                u32_from_usize(Slice::len(fields))
            );
            write_construct_fields(
                output,
                source,
                declarations,
                resolved,
                body,
                source_local_limit,
                fields
            )
        },
        CoreComputationView::VariantDispatch(ty, subject, arms) => {
            // Rust's Core retains a general binary RefinementBranch, while the
            // self host retains an n-arm dispatch.  Tag 10 is their deliberately
            // tiny shared source projection: exactly two nullary enum arms.
            if(Slice::len(arms) != 2) { Result::Err(
                ElaborationError::VariantDispatchSerializationUnsupported(
                    Id::to_usize(computation)
                )
            ) } else {
                ByteBuf::push(output, 10);
                write_type_id(output, Id::to_u32(ty));
                try(write_value_expression(
                    output,
                    source,
                    declarations,
                    body,
                    subject,
                    source_local_limit,
                    // The Rust lowering's administrative handle-result local
                    // is a copy; nullary enums are provably copyable too.
                    true
                ), @write_computation_expression);
                ByteBuf::write_u32_le(output, 2);
                write_variant_dispatch_arms(
                    output,
                    source,
                    declarations,
                    resolved,
                    body,
                    source_local_limit,
                    arms,
                    0,
                    computation
                )
            }
        },
        // Effect-control bytecode lowering is intentionally still gated, but
        // the Typed Core probe must be able to observe a successfully
        // elaborated perform without treating it as an ordinary call.
        CoreComputationView::Perform(ty, operation, operands) => {
            ByteBuf::push(output, 11);
            write_type_id(output, Id::to_u32(ty));
            ByteBuf::write_u32_le(output, Id::to_u32(operation));
            ByteBuf::write_u32_le(output, u32_from_usize(Slice::len(operands)));
            write_call_operands(
                output, source, declarations, resolved, body,
                source_local_limit, operands
            )
        }
    }
}

write_block_statements(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    resolved: &super::super::frontend::resolution::ResolvedBody,
    body: &TypedBody,
    computation: CoreComputationId,
    source_local_limit: u32,
    tail_position: Bool
) -> Result<(), ElaborationError> {
    handle super::super::frontend::elaboration::typed_body_computation_at(
        body,
        computation
    ) {
        CoreComputationView::Let(_, local_id, initializer, remainder) => {
            let local = Id::to_u32(local_id);
            if(local < source_local_limit) {
                ByteBuf::push(output, 1);
                ByteBuf::write_u32_le(output, local);
                write_name_token(
                    output,
                    source,
                    super::super::frontend::resolution::local_name_token_at(
                        resolved,
                        usize_from_u32(
                            local - (
                                source_local_limit - u32_from_usize(
                                    super::super::frontend::resolution::local_count(
                                        resolved
                                    )
                                )
                            )
                        )
                    )
                );
                write_type_id(
                    output,
                    Id::to_u32(
                        super::super::frontend::elaboration::typed_body_local_type(
                            body,
                            local_id
                        )
                    )
                );
                try(write_computation_expression(
                    output,
                    source,
                    declarations,
                    resolved,
                    body,
                    initializer,
                    source_local_limit,
                    false
                ), @write_block_statements);
                write_block_statements(
                    output,
                    source,
                    declarations,
                    resolved,
                    body,
                    remainder,
                    source_local_limit,
                    tail_position
                )
            } else {
                if(computation_uses_local(body, remainder, local_id)) {
                    Result::Err(ElaborationError::InvalidLocalReference(
                        usize_from_u32(local),
                        source_local_limit,
                        local
                    ))
                } else {
                    ByteBuf::push(output, 2);
                    try(write_computation_expression(
                        output,
                        source,
                        declarations,
                        resolved,
                        body,
                        initializer,
                        source_local_limit,
                        false
                    ), @write_block_statements);
                    write_block_statements(
                        output,
                        source,
                        declarations,
                        resolved,
                        body,
                        remainder,
                        source_local_limit,
                        tail_position
                    )
                }
            }
        },
        _ => write_computation_expression(
            output,
            source,
            declarations,
            resolved,
            body,
            computation,
            source_local_limit,
            tail_position
        )
    }
}

write_block_expression(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    resolved: &super::super::frontend::resolution::ResolvedBody,
    body: &TypedBody,
    computation: CoreComputationId,
    source_local_limit: u32,
    tail_position: Bool
) -> Result<(), ElaborationError> {
    ByteBuf::push(output, 5);
    let ty = handle
        super::super::frontend::elaboration::typed_body_computation_at(
            body,
            computation
        ) {
        CoreComputationView::Pure(found, _) => found,
        CoreComputationView::Let(found, _, _, _) => found,
        CoreComputationView::Call(found, _, _, _) => found,
        CoreComputationView::CallIndirect(found, _, _, _) => found,
        CoreComputationView::Primitive(found, _, _) => found,
        CoreComputationView::Construct(found, _, _) => found,
        CoreComputationView::VariantDispatch(found, _, _) => found,
        CoreComputationView::Perform(found, _, _) => found,
        CoreComputationView::Resume(found, _, _) => found,
        CoreComputationView::Handle(found, _, _) => found
    };
    write_type_id(output, Id::to_u32(ty));
    ByteBuf::write_u32_le(
        output,
        leading_let_count(body, computation, 0)
    );
    write_block_statements(
        output,
        source,
        declarations,
        resolved,
        body,
        computation,
        source_local_limit,
        tail_position
    )
}


write_parameters(
    output: &mut ByteBuf,
    source: &super::super::frontend::lexer::LexedSource,
    headers: &super::super::frontend::headers::HeaderIndex,
    interfaces: &TypedInterfaces,
    callable: &super::super::frontend::headers::CallableHeader,
    interface_callable: InterfaceCallableId,
    ordinal: u32
) {
    let parameters = super::super::frontend::headers::callable_parameters(callable);
    if(ordinal < super::super::frontend::headers::range_count(parameters)) {
        let at = super::super::frontend::headers::range_start(parameters) + ordinal;
        handle super::super::frontend::headers::parameter_at(headers, usize_from_u32(at)) {
            Result::Err(_) => unreachable(),
            Result::Ok(parameter) => {
                ByteBuf::write_u32_le(&mut *output, ordinal);
                write_name_token(
                    &mut *output,
                    source,
                    super::super::frontend::headers::parameter_name_token(parameter)
                );
                write_type_id(
                    &mut *output,
                    Id::to_u32(
                        super::super::frontend::elaboration::interface_callable_parameter_at(
                        interfaces,
                        interface_callable,
                        usize_from_u32(ordinal)
                    ))
                );
                write_parameters(
                    output,
                    source,
                    headers,
                    interfaces,
                    callable,
                    interface_callable,
                    ordinal + 1
                )
            }
        }
    } else { () }
}

write_function(
    output: &mut ByteBuf,
    original: &String,
    headers: &super::super::frontend::headers::ParsedHeaders,
    resolution_index: &super::super::frontend::resolution::ResolutionIndex,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    interfaces: &mut TypedInterfaces,
    shell: ShellId
) -> Result<(), u8> {
    let index = super::super::frontend::headers::parsed_index(headers);
    handle find_callable(index, shell, 0) {
        Result::Err(_) => Result::Err(3),
        Result::Ok(callable) => handle super::super::frontend::bodies::parse_function_body(
            original,
            headers,
            declarations,
            shell
        ) {
            Result::Err(_) => Result::Err(3),
            Result::Ok(parsed) => handle
                super::super::frontend::resolution::resolve_function_body_indexed(
                    resolution_index,
                    headers,
                    declarations,
                    &parsed
                ) {
                Result::Err(found) => handle found {
                    super::super::frontend::resolution::ResolutionError::UnknownVariant(_) =>
                        Result::Err(4),
                    _ => Result::Err(3)
                },
                Result::Ok(resolved) => handle elaborate_function_body(
                    original,
                    headers,
                    declarations,
                    interfaces,
                    &parsed,
                    &resolved
                ) {
                    Result::Err(_) => Result::Err(4),
                    Result::Ok(typed) => handle
                        super::super::frontend::elaboration::interface_callable_for_shell(
                            interfaces,
                            shell
                        ) {
                        Result::Err(_) => Result::Err(4),
                        Result::Ok(interface_callable) => {
                            let source = super::super::frontend::headers::parsed_source(headers);
                            write_function_identity(
                                &mut *output,
                                source,
                                declarations,
                                shell
                            );
                            let parameter_count =
                                super::super::frontend::headers::range_count(
                                    super::super::frontend::headers::callable_parameters(callable)
                                );
                            ByteBuf::write_u32_le(
                                &mut *output,
                                parameter_count
                            );
                            write_parameters(
                                &mut *output,
                                source,
                                index,
                                interfaces,
                                callable,
                                interface_callable,
                                0
                            );
                            write_type_id(
                                &mut *output,
                                Id::to_u32(
                                    super::super::frontend::elaboration::typed_body_result_type(
                                        &typed
                                    )
                                )
                            );
                            let source_local_limit = parameter_count
                                + u32_from_usize(
                                    super::super::frontend::resolution::local_count(&resolved)
                                );
                            handle write_block_expression(
                                output,
                                source,
                                declarations,
                                &resolved,
                                &typed,
                                super::super::frontend::elaboration::typed_body_root(
                                    &typed
                                ),
                                source_local_limit,
                                true
                            ) {
                                Result::Err(_) => Result::Err(4),
                                Result::Ok(_) => Result::Ok(())
                            }
                        }
                    }
                }
            }
        }
    }
}

function_count(
    declarations: &super::super::frontend::scanner::DeclarationIndex
) -> usize {
    super::super::frontend::scanner::fold_shells(declarations, 0, { count, _, shell =>
        if(super::super::frontend::scanner::shell_kind_code(shell) == 12) {
            count + 1
        } else {
            count
        }
    })
}

write_functions(
    output: &mut ByteBuf,
    original: &String,
    headers: &super::super::frontend::headers::ParsedHeaders,
    resolution_index: &super::super::frontend::resolution::ResolutionIndex,
    declarations: &super::super::frontend::scanner::DeclarationIndex,
    interfaces: &mut TypedInterfaces
) -> Result<(), u8> {
    super::super::frontend::scanner::try_for_each_shell(declarations, { shell_id, shell => {
        if(super::super::frontend::scanner::shell_kind_code(shell) == 12) {
            try(
                write_function(
                    output,
                    original,
                    headers,
                    resolution_index,
                    declarations,
                    interfaces,
                    shell_id
                ),
                @write_functions
            );
        } else {
            ()
        };
        Result::Ok(())
    }})
}

encode_source(output: &mut ByteBuf, original: String) {
    handle super::super::frontend::lexer::lex(&original) {
        Result::Err(_) => ByteBuf::push( output, 1),
        Result::Ok(source) => handle super::super::frontend::scanner::scan(&source) {
            Result::Err(_) => ByteBuf::push( output, 2),
            Result::Ok(declarations) => handle super::super::frontend::headers::parse(
                &original,
                 source,
                &declarations
            ) {
                Result::Err(_) => ByteBuf::push( output, 3),
                Result::Ok(headers) => handle collect_interfaces(
                    &headers,
                    &declarations
                ) {
                    Result::Err(_) => ByteBuf::push( output, 4),
                    Result::Ok(interfaces) => handle
                        super::super::frontend::resolution::build_resolution_index(
                                &headers,
                                &declarations
                            ) {
                        Result::Err(_) => ByteBuf::push(output, 3),
                        Result::Ok(resolution_index) => {
                        let encoded = ByteBuf::new();
                        ByteBuf::write_u32_le(
                            &mut encoded,
                            u32_from_usize(function_count(&declarations))
                        );
                        handle write_functions(
                            &mut encoded,
                            &original,
                            &headers,
                            &resolution_index,
                            &declarations,
                            &mut interfaces
                        ) {
                            Result::Err(status) =>
                                ByteBuf::push( output, status),
                            Result::Ok(_) => {
                                ByteBuf::push(&mut *output, 0);
                                ByteBuf::append_bytes(
                                     output,
                                    &ByteBuf::finish( encoded)
                                )
                            }
                        }
                        }
                    }
                }
            }
        }
    }
}

process_inputs(
    arguments: &Vec<String>,
    index: usize,
    output: &mut ByteBuf
) / FileRead {
    if(index < Vec::len(arguments)) {
        let path = *Vec::index(arguments, index);
        let bytes = read_file(path);
        handle String::from_utf8(bytes) {
            Result::Err(_) => ByteBuf::push(&mut *output, 1),
            Result::Ok(source) => encode_source(&mut *output, source)
        };
        process_inputs(
            arguments,
            index + 1,
             output
        )
    } else { () }
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    let count = Vec::len(&arguments);
    if(count < 2) { write_diagnostic(
            "usage: grandiose-self-host-elaboration <output> <input>..."
        ) } else {
        let output_path = *Vec::index(&arguments, 0);
        let encoded = ByteBuf::new();
        ByteBuf::write_u32_le(
            &mut encoded,
            u32_from_usize(count - 1)
        );
        process_inputs(&arguments, 1, &mut encoded);
        write_file(output_path, ByteBuf::finish( encoded))
    }
}
