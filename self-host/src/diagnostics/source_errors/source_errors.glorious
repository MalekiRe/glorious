// Frontend phase errors are normalized without changing phase-local APIs.

use super::model;
use super::model::CompilerDiagnostic;
use super::model::DiagnosticClass;
use super::model::DiagnosticPhase;
use super::model::DiagnosticSite;
use super::model::DiagnosticSpace;
use super::super::frontend::lexer;
use super::super::frontend::bodies::BodyError;
use super::super::frontend::elaboration::ElaborationError;
use super::super::frontend::headers::HeaderError;
use super::super::frontend::lexer::LexError;
use super::super::frontend::resolution::ResolutionError;
use super::super::frontend::scanner::ScanError;
use super::super::frontend::scanner::ShellId;

struct DiagnosticShape {
    class: DiagnosticClass,
    primary: DiagnosticSite,
    related: Option<DiagnosticSite>,
    has_arguments: Bool,
    expected: u32,
    found: u32
}

impl Use<[0, *]> for DiagnosticShape {}

shape(
    class: DiagnosticClass,
    primary: DiagnosticSite,
    related: Option<DiagnosticSite>,
    expected: u32,
    found: u32
) -> DiagnosticShape {
    DiagnosticShape {
        class: class,
        primary: primary,
        related: related,
        has_arguments: false,
        expected: expected,
        found: found
    }
}

argument_shape(
    class: DiagnosticClass,
    primary: DiagnosticSite,
    related: Option<DiagnosticSite>,
    expected: u32,
    found: u32
) -> DiagnosticShape {
    DiagnosticShape {
        class: class,
        primary: primary,
        related: related,
        has_arguments: true,
        expected: expected,
        found: found
    }
}

token_shape(
    class: DiagnosticClass,
    token: usize,
    expected: u32,
    found: u32
) -> DiagnosticShape {
    shape(
        class,
        model::site(DiagnosticSpace::Token, token),
        None,
        expected,
        found
    )
}

token_pair_shape(
    class: DiagnosticClass,
    token: usize,
    related: usize,
    expected: u32,
    found: u32
) -> DiagnosticShape {
    shape(
        class,
        model::site(DiagnosticSpace::Token, token),
        model::related_site(DiagnosticSpace::Token, token, related),
        expected,
        found
    )
}

token_argument_shape(
    class: DiagnosticClass,
    token: usize,
    expected: u32,
    found: u32
) -> DiagnosticShape {
    argument_shape(
        class,
        model::site(DiagnosticSpace::Token, token),
        None,
        expected,
        found
    )
}

indexed_shape(
    class: DiagnosticClass,
    space: DiagnosticSpace,
    index: usize,
    expected: u32,
    found: u32
) -> DiagnosticShape {
    shape(
        class,
        model::site(space, index),
        None,
        expected,
        found
    )
}

indexed_argument_shape(
    class: DiagnosticClass,
    space: DiagnosticSpace,
    index: usize,
    expected: u32,
    found: u32
) -> DiagnosticShape {
    argument_shape(
        class,
        model::site(space, index),
        None,
        expected,
        found
    )
}

owner_from_shell(shell: Option<ShellId>) -> Option<DiagnosticSite> {
    handle shell {
        Result::Err(_) => None,
        Result::Ok(found) => model::owner_site(found)
    }
}

make_frontend_diagnostic(
    phase: DiagnosticPhase,
    local_code: u32,
    message: String,
    owner: Option<DiagnosticSite>,
    value: DiagnosticShape
) -> CompilerDiagnostic {
    let DiagnosticShape {
        class,
        primary,
        related,
        has_arguments,
        expected,
        found
    } = value;
    if(has_arguments) {
        model::make_argument_diagnostic(
            phase,
            class,
            local_code,
            message,
            primary,
            related,
            owner,
            expected,
            found
        )
    } else {
        model::make_diagnostic(
            phase,
            class,
            local_code,
            message,
            primary,
            related,
            owner,
            expected,
            found
        )
    }
}

lex_local_code(error: &LexError) -> u32 {
    handle *lexer::error_kind(error) {
        lexer::LexErrorKind::UnexpectedCharacter => 1,
        lexer::LexErrorKind::UnfinishedComment => 2,
        lexer::LexErrorKind::InvalidLabel => 3,
        lexer::LexErrorKind::InvalidDigit => 4,
        lexer::LexErrorKind::MisplacedDigitSeparator => 5,
        lexer::LexErrorKind::ExpectedDigits => 6,
        lexer::LexErrorKind::MalformedFloatExponent => 7,
        lexer::LexErrorKind::UnfinishedEscape => 8,
        lexer::LexErrorKind::InvalidCharacterEscape => 9,
        lexer::LexErrorKind::UnknownEscape => 10,
        lexer::LexErrorKind::MalformedHexEscape => 11,
        lexer::LexErrorKind::MalformedUnicodeEscape => 12,
        lexer::LexErrorKind::UnfinishedUnicodeEscape => 13,
        lexer::LexErrorKind::InvalidUnicodeScalar => 14,
        lexer::LexErrorKind::InvalidByteEscape => 15,
        lexer::LexErrorKind::UnfinishedString => 16,
        lexer::LexErrorKind::InvalidByteStringCharacter => 17,
        lexer::LexErrorKind::UnfinishedByteString => 18,
        lexer::LexErrorKind::EmptyByteLiteral => 19,
        lexer::LexErrorKind::InvalidByteLiteral => 20,
        lexer::LexErrorKind::UnfinishedByteLiteral => 21,
        lexer::LexErrorKind::UnfinishedCharacterLiteral => 22,
        lexer::LexErrorKind::EmptyCharacterLiteral => 23,
        lexer::LexErrorKind::InvalidLifetimeIdentifier => 24,
        lexer::LexErrorKind::InvalidCharacterLiteral => 25,
        lexer::LexErrorKind::ResourceLimit => 26
    }
}

pub lex_diagnostic(error: &LexError) -> CompilerDiagnostic {
    let span = lexer::error_span(error);
    let class = if(*lexer::error_kind(error) is lexer::LexErrorKind::ResourceLimit) {
        DiagnosticClass::ResourceLimit
    } else {
        DiagnosticClass::Syntax
    };
    model::make_diagnostic(
        DiagnosticPhase::Lex,
        class,
        lex_local_code(error),
        "self-host compiler: lexical analysis failed",
        model::span_site(
            DiagnosticSpace::SourceByte,
            lexer::span_start(&span),
            lexer::span_end(&span)
        ),
        None,
        None,
        0,
        0
    )
}

scan_shape(error: &ScanError) -> DiagnosticShape {
    handle *error {
        ScanError::UnexpectedClosingDelimiter(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        ScanError::MismatchedClosingDelimiter(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        ScanError::UnclosedDelimiter(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        ScanError::InvalidDeclarationStart(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        ScanError::IncompleteDeclaration(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        ScanError::ExpectedDeclarationName(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        ScanError::DeclarationIdExhausted(token, related) => token_pair_shape(
            DiagnosticClass::ResourceLimit,
            token,
            related,
            0,
            0
        )
    }
}

scan_local_code(error: &ScanError) -> u32 {
    handle *error {
        ScanError::UnexpectedClosingDelimiter(_, _) => 1,
        ScanError::MismatchedClosingDelimiter(_, _) => 2,
        ScanError::UnclosedDelimiter(_, _) => 3,
        ScanError::InvalidDeclarationStart(_, _) => 4,
        ScanError::IncompleteDeclaration(_, _) => 5,
        ScanError::ExpectedDeclarationName(_, _) => 6,
        ScanError::DeclarationIdExhausted(_, _) => 7
    }
}

pub scan_diagnostic(error: &ScanError) -> CompilerDiagnostic {
    make_frontend_diagnostic(
        DiagnosticPhase::Scan,
        scan_local_code(error),
        "self-host compiler: declaration scanning failed",
        None,
        scan_shape(error)
    )
}

header_local_code(error: &HeaderError) -> u32 {
    handle *error {
        HeaderError::ExpectedIdentifier(_, _) => 1,
        HeaderError::ExpectedLeftParenthesis(_, _) => 2,
        HeaderError::ExpectedRightParenthesis(_, _) => 3,
        HeaderError::ExpectedRightAngle(_, _) => 4,
        HeaderError::EmptyTypeArguments(_, _) => 5,
        HeaderError::EmptyGenericParameters(_, _) => 15,
        HeaderError::UnsupportedGenericParameterKind(_, _) => 6,
        HeaderError::ExpectedColon(_, _) => 7,
        HeaderError::ExpectedRightBrace(_, _) => 8,
        HeaderError::ExpectedSemicolon(_, _) => 16,
        HeaderError::UnexpectedTrailingHeaderToken(_, _) => 9,
        HeaderError::ExpectedEquals(_, _) => 10,
        HeaderError::ExpectedIntegerPrecedence(_, _) => 11,
        HeaderError::PrecedenceOutOfRange(_, _) => 17,
        HeaderError::ExpectedOperator(_, _) => 12,
        HeaderError::InvalidFixityForm(_, _) => 13,
        HeaderError::TypeArenaExhausted(_, _) => 14
    }
}

header_shape(error: &HeaderError) -> DiagnosticShape {
    handle *error {
        HeaderError::ExpectedIdentifier(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedLeftParenthesis(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedRightParenthesis(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedRightAngle(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::EmptyTypeArguments(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::EmptyGenericParameters(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::UnsupportedGenericParameterKind(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedColon(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedRightBrace(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedSemicolon(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::UnexpectedTrailingHeaderToken(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedEquals(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedIntegerPrecedence(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::PrecedenceOutOfRange(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::ExpectedOperator(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::InvalidFixityForm(token, related) =>
            token_pair_shape(DiagnosticClass::Syntax, token, related, 0, 0),
        HeaderError::TypeArenaExhausted(token, related) => token_pair_shape(
            DiagnosticClass::ResourceLimit,
            token,
            related,
            0,
            0
        )
    }
}

pub header_diagnostic(error: &HeaderError) -> CompilerDiagnostic {
    make_frontend_diagnostic(
        DiagnosticPhase::Headers,
        header_local_code(error),
        "self-host compiler: declaration header parsing failed",
        None,
        header_shape(error)
    )
}

body_local_code(error: &BodyError) -> u32 {
    handle *error {
        BodyError::ExpectedExpression(_, _) => 1,
        BodyError::ExpectedGroupingClose(_, _) => 2,
        BodyError::DuplicatePatternBinder(_, _) => 8,
        BodyError::IncompatibleAssociativity(_, _) => 3,
        BodyError::NonAssociativeChain(_, _) => 4,
        BodyError::ConflictingFixity(_, _) => 5,
        BodyError::ExpressionDepthLimit(_, _) => 6,
        BodyError::MissingBodyShell(_) => 7,
        BodyError::InvalidEncodedExpression(_, _) => 9,
        BodyError::ExpectedCallClose(_, _) => 10,
        BodyError::InvalidLetSyntax(_, _) => 11,
        BodyError::MissingEncodedName(_, _) => 17,
        BodyError::ExpectedBlockClose(_, _) => 12,
        BodyError::ExpectedIdentifier(_, _) => 13,
        BodyError::ExpectedTupleDelimiter(_, _) => 14,
        BodyError::InvalidHandleArm(_, _) => 15,
        BodyError::InvalidStructField(_, _) => 18,
        BodyError::ExpectedProjectionName(_, _) => 16
    }
}

body_shape(error: &BodyError) -> DiagnosticShape {
    handle *error {
        BodyError::ExpectedExpression(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::ExpectedGroupingClose(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::DuplicatePatternBinder(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::IncompatibleAssociativity(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::NonAssociativeChain(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::ConflictingFixity(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::ExpressionDepthLimit(token, related) => token_pair_shape(
            DiagnosticClass::ResourceLimit,
            token,
            related,
            0,
            0
        ),
        BodyError::MissingBodyShell(shell) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            0,
            0
        ),
        BodyError::InvalidEncodedExpression(token, related) => token_pair_shape(
            DiagnosticClass::Internal,
            token,
            related,
            0,
            0
        ),
        BodyError::ExpectedCallClose(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::InvalidLetSyntax(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::MissingEncodedName(token, related) => token_pair_shape(
            DiagnosticClass::Internal,
            token,
            related,
            0,
            0
        ),
        BodyError::ExpectedBlockClose(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::ExpectedIdentifier(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::ExpectedTupleDelimiter(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::InvalidHandleArm(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::InvalidStructField(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        ),
        BodyError::ExpectedProjectionName(token, related) => token_pair_shape(
            DiagnosticClass::Syntax,
            token,
            related,
            0,
            0
        )
    }
}

pub body_diagnostic(
    shell: ShellId,
    error: &BodyError
) -> CompilerDiagnostic {
    make_frontend_diagnostic(
        DiagnosticPhase::BodyParse,
        body_local_code(error),
        "self-host compiler: body parsing failed",
        model::owner_site(shell),
        body_shape(error)
    )
}

resolution_local_code(error: &ResolutionError) -> u32 {
    handle *error {
        ResolutionError::UnknownFunction(_) => 1,
        ResolutionError::UnknownStruct(_) => 5,
        ResolutionError::UnknownEnum(_) => 6,
        ResolutionError::UnknownVariant(_) => 4,
        ResolutionError::InvalidNamePath(_) => 7,
        ResolutionError::AmbiguousFunction(_, _) => 2,
        ResolutionError::AmbiguousStruct(_, _) => 8,
        ResolutionError::AmbiguousEnum(_, _) => 9,
        ResolutionError::DuplicateParameter(_, _) => 10,
        ResolutionError::MissingCallableHeader(_) => 3,
        ResolutionError::MissingDeclarationShell(_, _) => 11,
        ResolutionError::MissingStructHeader(_, _) => 12,
        ResolutionError::MissingEnumHeader(_, _) => 13,
        ResolutionError::MissingVariantHeader(_, _) => 14,
        ResolutionError::CorruptFunctionSearch(_) => 15,
        ResolutionError::CorruptStructSearch(_) => 16,
        ResolutionError::CorruptEnumSearch(_) => 17,
        ResolutionError::LocalIdExhausted(_, _) => 18,
        ResolutionError::ExpectedBindingIdentifier(_) => 19,
        ResolutionError::UnexpectedHandleTarget(_, _) => 20,
        ResolutionError::MissingParameterHeader(_) => 21,
        ResolutionError::MissingBodyShell(_) => 22,
        ResolutionError::MissingBodyCallable(_) => 23,
        ResolutionError::MissingParameterRange(_) => 24,
        ResolutionError::BodyParseFailure(_) => 25
    }
}

resolution_shape(error: &ResolutionError) -> DiagnosticShape {
    handle *error {
        ResolutionError::UnknownFunction(token) => token_shape(
            DiagnosticClass::Resolution,
            token,
            0,
            0
        ),
        ResolutionError::UnknownStruct(token) => token_shape(
            DiagnosticClass::Resolution,
            token,
            0,
            0
        ),
        ResolutionError::UnknownEnum(token) => token_shape(
            DiagnosticClass::Resolution,
            token,
            0,
            0
        ),
        ResolutionError::UnknownVariant(token) => token_shape(
            DiagnosticClass::Resolution,
            token,
            0,
            0
        ),
        ResolutionError::InvalidNamePath(token) => token_shape(
            DiagnosticClass::Resolution,
            token,
            0,
            0
        ),
        ResolutionError::AmbiguousFunction(token, declaration) => shape(
            DiagnosticClass::Resolution,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(
                DiagnosticSpace::Declaration,
                Id::to_usize(declaration)
            )),
            0,
            0
        ),
        ResolutionError::AmbiguousStruct(token, interface) => shape(
            DiagnosticClass::Resolution,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(DiagnosticSpace::Interface, interface)),
            0,
            0
        ),
        ResolutionError::AmbiguousEnum(token, interface) => shape(
            DiagnosticClass::Resolution,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(DiagnosticSpace::Interface, interface)),
            0,
            0
        ),
        ResolutionError::DuplicateParameter(token, related) => token_pair_shape(
            DiagnosticClass::Resolution,
            token,
            related,
            0,
            0
        ),
        ResolutionError::MissingCallableHeader(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Interface,
            index,
            0,
            0
        ),
        ResolutionError::MissingDeclarationShell(token, declaration) => shape(
            DiagnosticClass::Internal,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(
                DiagnosticSpace::Declaration,
                Id::to_usize(declaration)
            )),
            0,
            0
        ),
        ResolutionError::MissingStructHeader(token, interface) => shape(
            DiagnosticClass::Internal,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(DiagnosticSpace::Interface, interface)),
            0,
            0
        ),
        ResolutionError::MissingEnumHeader(token, interface) => shape(
            DiagnosticClass::Internal,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(DiagnosticSpace::Interface, interface)),
            0,
            0
        ),
        ResolutionError::MissingVariantHeader(token, interface) => shape(
            DiagnosticClass::Internal,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(DiagnosticSpace::Variant, interface)),
            0,
            0
        ),
        ResolutionError::CorruptFunctionSearch(token) => token_shape(
            DiagnosticClass::Internal,
            token,
            0,
            0
        ),
        ResolutionError::CorruptStructSearch(token) => token_shape(
            DiagnosticClass::Internal,
            token,
            0,
            0
        ),
        ResolutionError::CorruptEnumSearch(token) => token_shape(
            DiagnosticClass::Internal,
            token,
            0,
            0
        ),
        ResolutionError::LocalIdExhausted(token, count) => token_argument_shape(
            DiagnosticClass::ResourceLimit,
            token,
            0,
            wrapping_convert_to_u32(count)
        ),
        ResolutionError::ExpectedBindingIdentifier(token) => token_shape(
            DiagnosticClass::Resolution,
            token,
            0,
            0
        ),
        ResolutionError::UnexpectedHandleTarget(token, related) => token_pair_shape(
            DiagnosticClass::Resolution,
            token,
            related,
            0,
            0
        ),
        ResolutionError::MissingParameterHeader(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Interface,
            index,
            0,
            0
        ),
        ResolutionError::MissingBodyShell(shell) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            0,
            0
        ),
        ResolutionError::MissingBodyCallable(shell) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            0,
            0
        ),
        ResolutionError::MissingParameterRange(shell) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            0,
            0
        ),
        ResolutionError::BodyParseFailure(shell) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            0,
            0
        )
    }
}

resolution_message(phase: DiagnosticPhase) -> String {
    if(phase is DiagnosticPhase::ResolutionIndex) {
        "self-host compiler: declaration indexing failed"
    } else {
        "self-host compiler: body resolution failed"
    }
}

pub resolution_diagnostic(
    phase: DiagnosticPhase,
    shell: Option<ShellId>,
    error: &ResolutionError
) -> CompilerDiagnostic {
    make_frontend_diagnostic(
        phase,
        resolution_local_code(error),
        resolution_message(phase),
        owner_from_shell(shell),
        resolution_shape(error)
    )
}

elaboration_local_code(error: &ElaborationError) -> u32 {
    handle *error {
        ElaborationError::CyclicTypeAlias(_) => 1,
        ElaborationError::MissingAliasHeader(_) => 7,
        ElaborationError::MissingDeclarationShell(_) => 8,
        ElaborationError::GenericTypeAliasUnsupported(_) => 9,
        ElaborationError::MissingNominalType(_) => 10,
        ElaborationError::UnknownTypeName(_) => 11,
        ElaborationError::UnknownTypeModule(_) => 12,
        ElaborationError::NamedReferenceLifetimeUnsupported(_) => 13,
        ElaborationError::InvalidSignatureType(_) => 14,
        ElaborationError::MissingParameterHeader(_) => 15,
        ElaborationError::MissingCallableHeader(_) => 16,
        ElaborationError::UnsupportedCallableSignature(_) => 17,
        ElaborationError::MissingCallableType(_) => 18,
        ElaborationError::MissingNominalDeclaration(_) => 19,
        ElaborationError::MissingFieldHeader(_) => 20,
        ElaborationError::MissingVariantHeader(_) => 21,
        ElaborationError::MissingStructHeader(_) => 22,
        ElaborationError::MissingEnumHeader(_) => 23,
        ElaborationError::CyclicNominalType(_, _) => 24,
        ElaborationError::InvalidResolvedExpression(_, _) => 25,
        ElaborationError::TypeMismatch(_, _, _) => 3,
        ElaborationError::FloatLiteralUnsupported(_) => 2,
        ElaborationError::IntegerLiteralOutOfRange(_, _) => 5,
        ElaborationError::UnexpectedExpressionToken(_) => 26,
        ElaborationError::FunctionUsedAsValue(_) => 27,
        ElaborationError::MissingLocalType(_) => 28,
        ElaborationError::MissingCallableInterface(_, _) => 29,
        ElaborationError::ArgumentCountMismatch(_, _, _) => 4,
        ElaborationError::InvalidCallTarget(_, _) => 6,
        ElaborationError::InvalidTupleElement(_, _) => 30,
        ElaborationError::MissingTupleElement(_, _) => 31,
        ElaborationError::ExpectedTupleType(_, _) => 32,
        ElaborationError::UnknownStructField(_, _) => 33,
        ElaborationError::DuplicateOrInaccessibleField(_, _) => 34,
        ElaborationError::StructFieldCountMismatch(_, _, _) => 35,
        ElaborationError::InvalidStructTarget(_, _) => 36,
        ElaborationError::VariantPayloadCountMismatch(_, _, _) => 37,
        ElaborationError::MissingVariant(_, _) => 38,
        ElaborationError::UnknownProjectionField(_, _, _) => 39,
        ElaborationError::DuplicateMatchVariant(_, _, _) => 40,
        ElaborationError::VariantOwnerMismatch(_, _, _) => 41,
        ElaborationError::MissingMatchVariants(_, _, _) => 42,
        ElaborationError::ExpectedEnumType(_, _) => 43,
        ElaborationError::UnsupportedExpression(_) => 44,
        ElaborationError::MissingBodyCallable(_) => 45,
        ElaborationError::IntegerEncodingOverflow(_, _) => 46,
        ElaborationError::InvalidLocalReference(_, _, _) => 47,
        ElaborationError::EmbeddedValueSerializationUnsupported(_) => 48,
        ElaborationError::VariantDispatchSerializationUnsupported(_) => 49
    }
}

elaboration_arguments(error: &ElaborationError) -> (u32, u32) {
    handle *error {
        ElaborationError::CyclicNominalType(_, nominal) => (nominal, nominal),
        ElaborationError::TypeMismatch(_, expected, found) =>
            (expected, found),
        ElaborationError::IntegerLiteralOutOfRange(_, ty) => (ty, ty),
        ElaborationError::MissingCallableInterface(_, shell) =>
            (0, Id::to_u32(shell)),
        ElaborationError::ArgumentCountMismatch(_, expected, found) =>
            (expected, found),
        ElaborationError::InvalidCallTarget(_, found) => (0, found),
        ElaborationError::MissingTupleElement(_, expected) => (expected, 0),
        ElaborationError::ExpectedTupleType(_, ty) => (ty, ty),
        ElaborationError::UnknownStructField(_, name) => (0, name),
        ElaborationError::DuplicateOrInaccessibleField(_, field) =>
            (field, field),
        ElaborationError::StructFieldCountMismatch(_, expected, found) =>
            (expected, found),
        ElaborationError::InvalidStructTarget(_, found) => (4, found),
        ElaborationError::VariantPayloadCountMismatch(_, expected, found) =>
            (expected, found),
        ElaborationError::MissingVariant(_, variant) => (0, variant),
        ElaborationError::UnknownProjectionField(_, subject, name) =>
            (subject, name),
        ElaborationError::DuplicateMatchVariant(_, expected, found) =>
            (expected, found),
        ElaborationError::VariantOwnerMismatch(_, expected, found) =>
            (expected, found),
        ElaborationError::MissingMatchVariants(_, expected, found) =>
            (expected, found),
        ElaborationError::ExpectedEnumType(_, found) => (0, found),
        ElaborationError::MissingBodyCallable(shell) =>
            (0, Id::to_u32(shell)),
        ElaborationError::IntegerEncodingOverflow(_, ty) => (0, ty),
        ElaborationError::InvalidLocalReference(_, limit, local) =>
            (limit, local),
        ElaborationError::EmbeddedValueSerializationUnsupported(_) => (0, 5),
        ElaborationError::VariantDispatchSerializationUnsupported(_) =>
            (0, 12),
        _ => (0, 0)
    }
}

elaboration_shape(error: &ElaborationError) -> DiagnosticShape {
    let (expected, found) = elaboration_arguments(error);
    handle *error {
        ElaborationError::CyclicTypeAlias(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::MissingAliasHeader(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Token,
            index,
            expected,
            found
        ),
        ElaborationError::MissingDeclarationShell(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Token,
            index,
            expected,
            found
        ),
        ElaborationError::GenericTypeAliasUnsupported(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::MissingNominalType(token) => token_shape(
            DiagnosticClass::Internal,
            token,
            expected,
            found
        ),
        ElaborationError::UnknownTypeName(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::UnknownTypeModule(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::NamedReferenceLifetimeUnsupported(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::InvalidSignatureType(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::MissingParameterHeader(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Interface,
            index,
            expected,
            found
        ),
        ElaborationError::MissingCallableHeader(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Interface,
            index,
            expected,
            found
        ),
        ElaborationError::UnsupportedCallableSignature(shell) => indexed_shape(
            DiagnosticClass::Type,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            expected,
            found
        ),
        ElaborationError::MissingCallableType(shell) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            expected,
            found
        ),
        ElaborationError::MissingNominalDeclaration(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Interface,
            index,
            expected,
            found
        ),
        ElaborationError::MissingFieldHeader(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Field,
            index,
            expected,
            found
        ),
        ElaborationError::MissingVariantHeader(index) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Variant,
            index,
            expected,
            found
        ),
        ElaborationError::MissingStructHeader(shell) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            expected,
            found
        ),
        ElaborationError::MissingEnumHeader(shell) => indexed_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            expected,
            found
        ),
        ElaborationError::CyclicNominalType(token, nominal) => argument_shape(
            DiagnosticClass::Type,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(
                DiagnosticSpace::Type,
                wrapping_convert_to_usize(nominal)
            )),
            expected,
            found
        ),
        ElaborationError::InvalidResolvedExpression(expression, occurrence) => shape(
            DiagnosticClass::Internal,
            model::site(DiagnosticSpace::Expression, expression),
            Option::Some(model::site(
                DiagnosticSpace::ResolutionOccurrence,
                occurrence
            )),
            expected,
            found
        ),
        ElaborationError::TypeMismatch(token, _, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::FloatLiteralUnsupported(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::IntegerLiteralOutOfRange(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::UnexpectedExpressionToken(token) => token_shape(
            DiagnosticClass::Internal,
            token,
            expected,
            found
        ),
        ElaborationError::FunctionUsedAsValue(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::MissingLocalType(token) => token_shape(
            DiagnosticClass::Internal,
            token,
            expected,
            found
        ),
        ElaborationError::MissingCallableInterface(token, shell) => argument_shape(
            DiagnosticClass::Internal,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(
                DiagnosticSpace::Declaration,
                Id::to_usize(shell)
            )),
            expected,
            found
        ),
        ElaborationError::ArgumentCountMismatch(token, _, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::InvalidCallTarget(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::InvalidTupleElement(token, position) => shape(
            DiagnosticClass::Internal,
            model::site(DiagnosticSpace::Token, token),
            Option::Some(model::site(DiagnosticSpace::Field, position)),
            expected,
            found
        ),
        ElaborationError::MissingTupleElement(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::ExpectedTupleType(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::UnknownStructField(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::DuplicateOrInaccessibleField(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::StructFieldCountMismatch(token, _, _) =>
            token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::InvalidStructTarget(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::VariantPayloadCountMismatch(token, _, _) =>
            token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::MissingVariant(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::UnknownProjectionField(token, _, _) =>
            token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::DuplicateMatchVariant(token, _, _) =>
            token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::VariantOwnerMismatch(token, _, _) =>
            token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::MissingMatchVariants(token, _, _) =>
            token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::ExpectedEnumType(token, _) => token_argument_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::UnsupportedExpression(token) => token_shape(
            DiagnosticClass::Type,
            token,
            expected,
            found
        ),
        ElaborationError::MissingBodyCallable(shell) => indexed_argument_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Declaration,
            Id::to_usize(shell),
            expected,
            found
        ),
        ElaborationError::IntegerEncodingOverflow(index, _) =>
            indexed_argument_shape(
            DiagnosticClass::ResourceLimit,
            DiagnosticSpace::Artifact,
            index,
            expected,
            found
        ),
        ElaborationError::InvalidLocalReference(local, _, _) =>
            indexed_argument_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::Local,
            local,
            expected,
            found
        ),
        ElaborationError::EmbeddedValueSerializationUnsupported(value) =>
            indexed_argument_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::CoreValue,
            value,
            expected,
            found
        ),
        ElaborationError::VariantDispatchSerializationUnsupported(computation) =>
            indexed_argument_shape(
            DiagnosticClass::Internal,
            DiagnosticSpace::CoreComputation,
            computation,
            expected,
            found
        )
    }
}

elaboration_message(phase: DiagnosticPhase) -> String {
    if(phase is DiagnosticPhase::InterfaceCollection) {
        "self-host compiler: interface collection failed"
    } else {
        "self-host compiler: body elaboration failed"
    }
}

pub elaboration_diagnostic(
    phase: DiagnosticPhase,
    shell: Option<ShellId>,
    error: &ElaborationError
) -> CompilerDiagnostic {
    make_frontend_diagnostic(
        phase,
        elaboration_local_code(error),
        elaboration_message(phase),
        owner_from_shell(shell),
        elaboration_shape(error)
    )
}
