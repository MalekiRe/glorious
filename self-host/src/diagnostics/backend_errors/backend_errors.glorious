// Lowering, emission, and artifact-writer errors are exhaustively normalized.

use super::model;
use super::model::CompilerDiagnostic;
use super::model::DiagnosticClass;
use super::model::DiagnosticPhase;
use super::model::DiagnosticSpace;
use super::super::backend::artifact;
use super::super::backend::emission;
use super::super::backend::emission::EmissionError;
use super::super::backend::lowering::LoweringError;
use super::super::backend::lowering::MirFunctionId;
use super::super::frontend::scanner::ShellId;

pub lowering_diagnostic(
    shell: ShellId,
    error: &LoweringError
) -> CompilerDiagnostic {
    let owner = model::owner_site(shell);
    handle *error {
        LoweringError::UnsupportedScalar(ty) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            1,
            "self-host compiler: unsupported scalar reached ownership lowering",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::MissingLocal(local) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            2,
            "self-host compiler: ownership lowering is missing a local",
            model::site(DiagnosticSpace::Local, Id::to_usize(local)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::MissingProjectionSource(value) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            3,
            "self-host compiler: ownership lowering is missing a projection source",
            model::site(DiagnosticSpace::CoreValue, Id::to_usize(value)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::MissingValue(value) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            4,
            "self-host compiler: ownership lowering is missing a Core value",
            model::site(DiagnosticSpace::CoreValue, Id::to_usize(value)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::UnknownCallable(callable) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            5,
            "self-host compiler: ownership lowering cannot resolve a callable",
            model::site(DiagnosticSpace::Declaration, Id::to_usize(callable)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::InvalidConstructionType(ty) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            6,
            "self-host compiler: invalid construction type reached lowering",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::ConstructionFieldCount(ty, expected, found) => model::make_argument_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            7,
            "self-host compiler: construction field count changed before lowering",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            None,
            owner,
            expected,
            found
        ),
        LoweringError::UnexpectedVariant(ty, variant) => model::make_argument_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            8,
            "self-host compiler: an unexpected enum variant reached lowering",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            Option::Some(model::site(
                DiagnosticSpace::Variant,
                wrapping_convert_to_usize(variant)
            )),
            owner,
            0,
            variant
        ),
        LoweringError::MissingVariant(ty) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            9,
            "self-host compiler: enum construction is missing a variant",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::VariantOutOfRange(ty, variant) => model::make_argument_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            10,
            "self-host compiler: enum variant is out of range",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            Option::Some(model::site(
                DiagnosticSpace::Variant,
                wrapping_convert_to_usize(variant)
            )),
            owner,
            0,
            variant
        ),
        LoweringError::ConstructionFieldOrder(expected, found) => model::make_argument_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            11,
            "self-host compiler: construction fields are not in canonical order",
            model::site(
                DiagnosticSpace::Field,
                wrapping_convert_to_usize(found)
            ),
            Option::Some(model::site(
                DiagnosticSpace::Field,
                wrapping_convert_to_usize(expected)
            )),
            owner,
            expected,
            found
        ),
        LoweringError::MissingResult(ty) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            12,
            "self-host compiler: ownership lowering did not produce a result",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::MissingMatchSubject(value) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            13,
            "self-host compiler: match lowering is missing its subject",
            model::site(DiagnosticSpace::CoreValue, Id::to_usize(value)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::MissingMatchResult(computation) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            14,
            "self-host compiler: match lowering is missing an arm result",
            model::site(
                DiagnosticSpace::CoreComputation,
                Id::to_usize(computation)
            ),
            None,
            owner,
            0,
            0
        ),
        LoweringError::InvalidMatchType(ty) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            15,
            "self-host compiler: invalid match type reached lowering",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::MatchBindingCount(ty, expected, found) => model::make_argument_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            16,
            "self-host compiler: match binding count changed before lowering",
            model::site(DiagnosticSpace::Type, Id::to_usize(ty)),
            None,
            owner,
            expected,
            found
        ),
        LoweringError::MissingMatchFlow(computation) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            18,
            "self-host compiler: MIR match is missing PlaceFlow facts",
            model::site(
                DiagnosticSpace::CoreComputation,
                Id::to_usize(computation)
            ),
            None,
            owner,
            0,
            0
        ),
        LoweringError::MatchStateMismatch => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            17,
            "self-host compiler: match arms produced incompatible ownership state",
            model::site(DiagnosticSpace::Artifact, 0),
            None,
            owner,
            0,
            0
        ),
        LoweringError::MirCleanupCount(expected, found) =>
            model::make_argument_diagnostic(
                DiagnosticPhase::Lowering,
                DiagnosticClass::Internal,
                19,
                "self-host compiler: MIR cleanup coverage is incomplete",
                model::site(DiagnosticSpace::Artifact, 0),
                None,
                owner,
                expected,
                found
            ),
        LoweringError::InvalidMirCleanup(instruction) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            20,
            "self-host compiler: MIR cleanup range is invalid",
            model::site(
                DiagnosticSpace::Artifact,
                wrapping_convert_to_usize(instruction)
            ),
            None,
            owner,
            0,
            0
        ),
        LoweringError::InvalidMirRegister(register) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            21,
            "self-host compiler: MIR instruction references an invalid register",
            model::site(DiagnosticSpace::Register, Id::to_usize(register)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::UnboundMirBlock(block) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            22,
            "self-host compiler: MIR instruction references an unbound block",
            model::site(DiagnosticSpace::Block, Id::to_usize(block)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::InvalidMirRegisterPack(pack) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            23,
            "self-host compiler: MIR instruction references an invalid register pack",
            model::site(DiagnosticSpace::RegisterPack, Id::to_usize(pack)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::InvalidMirSwitchPack(pack) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            24,
            "self-host compiler: MIR instruction references an invalid switch pack",
            model::site(DiagnosticSpace::SwitchPack, Id::to_usize(pack)),
            None,
            owner,
            0,
            0
        ),
        LoweringError::InvalidMirFunction(function) => model::make_diagnostic(
            DiagnosticPhase::Lowering,
            DiagnosticClass::Internal,
            25,
            "self-host compiler: MIR call references an invalid function",
            model::site(DiagnosticSpace::Function, Id::to_usize(function)),
            None,
            owner,
            0,
            0
        )
    }
}

emission_name_diagnostic(name: emission::EmissionName) -> CompilerDiagnostic {
    handle name {
        emission::EmissionName::Type(ty) => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            4,
            "self-host compiler: emitted type name is missing from the canonical pool",
            model::site(DiagnosticSpace::MirType, Id::to_usize(ty)),
            None,
            None,
            0,
            0
        ),
        emission::EmissionName::StructField(ty, field) => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            11,
            "self-host compiler: emitted struct field name is missing from the canonical pool",
            model::site(DiagnosticSpace::MirType, Id::to_usize(ty)),
            Option::Some(model::site(DiagnosticSpace::Field, field)),
            None,
            0,
            0
        ),
        emission::EmissionName::Variant(ty, variant) => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            12,
            "self-host compiler: emitted variant name is missing from the canonical pool",
            model::site(DiagnosticSpace::MirType, Id::to_usize(ty)),
            Option::Some(model::site(DiagnosticSpace::Variant, variant)),
            None,
            0,
            0
        ),
        emission::EmissionName::VariantField(ty, variant, field) => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            13,
            "self-host compiler: emitted variant field name is missing from the canonical pool",
            model::site(DiagnosticSpace::MirType, Id::to_usize(ty)),
            Option::Some(model::site(DiagnosticSpace::Field, field)),
            Option::Some(model::site(DiagnosticSpace::Variant, variant)),
            0,
            0
        ),
        emission::EmissionName::Function(function) => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            14,
            "self-host compiler: emitted function name is missing from the canonical pool",
            model::site(DiagnosticSpace::Function, Id::to_usize(function)),
            None,
            None,
            0,
            0
        )
    }
}

protocol_validation_diagnostic(
    protocol: u32,
    reason: &emission::ProtocolValidationError
) -> CompilerDiagnostic {
    let site = model::site(
        DiagnosticSpace::Artifact,
        wrapping_convert_to_usize(protocol)
    );
    handle *reason {
        emission::ProtocolValidationError::CanonicalOrder => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 15,
            "self-host compiler: protocol identities are not strictly sorted and unique",
            site, None, None, 0, 0
        ),
        emission::ProtocolValidationError::Signature => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 16,
            "self-host compiler: protocol operation signature has an invalid type or outward-effect row",
            site, None, None, 0, 0
        ),
        emission::ProtocolValidationError::ResultType => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 17,
            "self-host compiler: protocol operation result type is not present in the artifact type table",
            site, None, None, 0, 0
        ),
        emission::ProtocolValidationError::TerminalContract => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 18,
            "self-host compiler: terminal operation must return Never and declare quantity [0,0]",
            site, None, None, 0, 0
        ),
        emission::ProtocolValidationError::Quantity => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 19,
            "self-host compiler: operation resumption lower bound exceeds its upper bound",
            site, None, None, 0, 0
        ),
        emission::ProtocolValidationError::TypeArgument => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 20,
            "self-host compiler: protocol type argument is not present in the artifact type table",
            site, None, None, 0, 0
        )
    }
}

handler_validation_diagnostic(
    definition: u32,
    reason: &emission::HandlerValidationError
) -> CompilerDiagnostic {
    let site = model::site(
        DiagnosticSpace::Artifact,
        wrapping_convert_to_usize(definition)
    );
    handle *reason {
        emission::HandlerValidationError::ResultType => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 21,
            "self-host compiler: handler result type is not present in the artifact type table",
            site, None, None, 0, 0
        ),
        emission::HandlerValidationError::UnknownProtocol => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 22,
            "self-host compiler: handler clause refers to an unknown protocol",
            site, None, None, 0, 0
        ),
        emission::HandlerValidationError::UnknownOperation => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 23,
            "self-host compiler: handler clause refers to an unknown operation",
            site, None, None, 0, 0
        ),
        emission::HandlerValidationError::DuplicateClause => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 24,
            "self-host compiler: handler definition contains duplicate protocol-operation clauses",
            site, None, None, 0, 0
        ),
        emission::HandlerValidationError::CallableSignature => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 25,
            "self-host compiler: handler clause callable signature does not match its operation and handler result",
            site, None, None, 0, 0
        ),
        emission::HandlerValidationError::TerminalResumption => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 26,
            "self-host compiler: terminal handler clause must not carry a resumption type",
            site, None, None, 0, 0
        ),
        emission::HandlerValidationError::ResumptionTypeUnavailable => model::make_diagnostic(
            DiagnosticPhase::Emission, DiagnosticClass::Emission, 27,
            "self-host compiler: nonterminal handler requires a structural Resumption MIR type that is not yet representable",
            site, None, None, 0, 0
        )
    }
}

effect_instruction_validation_diagnostic(
    function: MirFunctionId,
    instruction: u32,
    reason: &emission::EffectInstructionValidationError
) -> CompilerDiagnostic {
    let message = handle *reason {
        emission::EffectInstructionValidationError::UnknownHandler =>
            "self-host compiler: effect instruction refers to an unknown handler definition",
        emission::EffectInstructionValidationError::ClauseCount =>
            "self-host compiler: MakeHandler clause count does not match its handler definition",
        emission::EffectInstructionValidationError::SharedClauseFunctions =>
            "self-host compiler: MakeHandlerShared targets are empty, invalid, or misaligned with its clauses",
        emission::EffectInstructionValidationError::UnknownProtocol =>
            "self-host compiler: Perform refers to an unknown protocol",
        emission::EffectInstructionValidationError::UnknownOperation =>
            "self-host compiler: Perform refers to an unknown operation",
        emission::EffectInstructionValidationError::PerformContract =>
            "self-host compiler: Perform payload count, destination, or terminal control position is invalid",
        emission::EffectInstructionValidationError::TailResumeControl =>
            "self-host compiler: TailResume has an invalid receiver mode or is not terminal in its MIR block",
        emission::EffectInstructionValidationError::ReceiverMode =>
            "self-host compiler: Resume receiver mode is outside the frozen 0..=2 ABI",
        emission::EffectInstructionValidationError::FunctionEffectRow =>
            "self-host compiler: function outward-effect row is invalid or does not declare its performed protocol"
    };
    let code = handle *reason {
        emission::EffectInstructionValidationError::UnknownHandler => 28,
        emission::EffectInstructionValidationError::ClauseCount => 29,
        emission::EffectInstructionValidationError::SharedClauseFunctions => 30,
        emission::EffectInstructionValidationError::UnknownProtocol => 31,
        emission::EffectInstructionValidationError::UnknownOperation => 32,
        emission::EffectInstructionValidationError::PerformContract => 33,
        emission::EffectInstructionValidationError::TailResumeControl => 34,
        emission::EffectInstructionValidationError::ReceiverMode => 35,
        emission::EffectInstructionValidationError::FunctionEffectRow => 36
    };
    model::make_diagnostic(
        DiagnosticPhase::Emission,
        DiagnosticClass::Emission,
        code,
        message,
        model::site(DiagnosticSpace::Function, Id::to_usize(function)),
        Option::Some(model::site(
            DiagnosticSpace::Artifact,
            wrapping_convert_to_usize(instruction)
        )),
        None,
        0,
        0
    )
}

pub emission_diagnostic(error: &EmissionError) -> CompilerDiagnostic {
    handle *error {
        EmissionError::MissingConstant(register) => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            1,
            "self-host compiler: emitted constant is missing from the canonical pool",
            model::site(DiagnosticSpace::Register, Id::to_usize(register)),
            None,
            None,
            0,
            0
        ),
        EmissionError::MissingSwitchConstant(pack, variant) => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            2,
            "self-host compiler: emitted switch constant is missing from the canonical pool",
            model::site(DiagnosticSpace::SwitchPack, Id::to_usize(pack)),
            Option::Some(model::site(DiagnosticSpace::SwitchCase, variant)),
            None,
            0,
            0
        ),
        EmissionError::UnsupportedInstruction => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            3,
            "self-host compiler: MIR contains an unsupported instruction",
            model::site(DiagnosticSpace::Artifact, 0),
            None,
            None,
            0,
            0
        ),
        EmissionError::MissingName(name) => emission_name_diagnostic(name),
        EmissionError::MissingSignature(function) => model::make_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            5,
            "self-host compiler: emitted function signature is missing from the canonical pool",
            model::site(DiagnosticSpace::Function, Id::to_usize(function)),
            None,
            None,
            0,
            0
        ),
        EmissionError::StructFieldNameCount(ty, expected, found) => model::make_argument_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            6,
            "self-host compiler: struct field and field-name counts differ",
            model::site(DiagnosticSpace::MirType, Id::to_usize(ty)),
            None,
            None,
            wrapping_convert_to_u32(expected),
            wrapping_convert_to_u32(found)
        ),
        EmissionError::VariantFieldNameCount(ty, variant, expected, found) => model::make_argument_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            7,
            "self-host compiler: variant field and field-name counts differ",
            model::site(DiagnosticSpace::MirType, Id::to_usize(ty)),
            Option::Some(model::site(DiagnosticSpace::Variant, variant)),
            None,
            wrapping_convert_to_u32(expected),
            wrapping_convert_to_u32(found)
        ),
        EmissionError::UnsupportedType(ty, tag) => model::make_argument_diagnostic(
            DiagnosticPhase::Emission,
            DiagnosticClass::Emission,
            8,
            "self-host compiler: MIR contains an unsupported type",
            model::site(DiagnosticSpace::MirType, Id::to_usize(ty)),
            None,
            None,
            0,
            wrapping_convert_to_u32(tag)
        ),
        EmissionError::InvalidProtocol(protocol, reason) =>
            protocol_validation_diagnostic(protocol, &reason),
        EmissionError::InvalidHandlerDefinition(definition, reason) =>
            handler_validation_diagnostic(definition, &reason),
        EmissionError::InvalidEffectInstruction(function, instruction, reason) =>
            effect_instruction_validation_diagnostic(
                function, instruction, &reason
            ),
        EmissionError::ArtifactWrite(error) => handle error {
            artifact::ArtifactWriteError::InvalidSectionCount => model::make_argument_diagnostic(
                DiagnosticPhase::Emission,
                DiagnosticClass::Emission,
                9,
                "self-host compiler: artifact section count is invalid",
                model::site(DiagnosticSpace::Artifact, 0),
                None,
                None,
                14,
                0
            ),
            artifact::ArtifactWriteError::InvalidFixedSectionLength => model::make_diagnostic(
                DiagnosticPhase::Emission,
                DiagnosticClass::Emission,
                10,
                "self-host compiler: fixed artifact section length is invalid",
                model::site(DiagnosticSpace::Artifact, 0),
                None,
                None,
                0,
                0
            )
        }
    }
}
