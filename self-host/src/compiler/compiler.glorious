// The self-hosted compiler pipeline owns source semantics across frontend and
// backend phase boundaries. Frontend and backend modules remain reusable phase
// libraries; this module owns orchestration, cross-phase state, and the host
// application boundary.

use super::backend::emission;
use super::backend::lowering;
use super::frontend::bodies;
use super::frontend::elaboration;
use super::frontend::headers;
use super::frontend::lexer;
use super::frontend::resolution;
use super::frontend::scanner;

use super::backend::emission::EmissionError;
use super::backend::lowering::LoweringError;
use super::frontend::bodies::BodyError;
use super::frontend::elaboration::ElaborationError;
use super::frontend::elaboration::CallableInstanceId;
use super::frontend::elaboration::InterfaceCallableId;
use super::frontend::elaboration::InterfaceNominalView;
use super::frontend::elaboration::InterfaceTypeView;
use super::frontend::headers::HeaderError;
use super::frontend::lexer::LexError;
use super::frontend::resolution::ResolutionError;
use super::frontend::scanner::ScanError;
use super::frontend::scanner::ShellId;

pub enum InterfaceNameKind {
    Field,
    Variant
}

impl Use<[0, *]> for InterfaceNameKind {}

pub enum CompileError {
    Lex(LexError),
    Scan(ScanError),
    Headers(HeaderError),
    ResolutionIndex(ResolutionError),
    InterfaceCollection(ElaborationError),
    DeclarationName(ShellId),
    BodyParse(ShellId, BodyError),
    BodyResolution(ShellId, ResolutionError),
    BodyElaboration(ShellId, ElaborationError),
    Lowering(ShellId, LoweringError),
    InterfaceName(InterfaceNameKind, u32),
    UnsupportedInterfaceType(usize),
    Emission(EmissionError)
}

type MirFunctionArena = Arena<
    lowering::MirFunctionTag,
    lowering::MirFunction
>;

type MirTypeArena = lowering::MirTypes;

// One session owns all cross-body semantic state. Body syntax and resolution
// are deliberately absent: those live only in BodyCompilation and are released
// immediately after the corresponding function is lowered.
struct CompilerSession {
    // Own the augmented stream: parsed headers retain source references while
    // lowering bodies, so the injected interface must live for the session.
    original: String,
    headers: headers::ParsedHeaders,
    declarations: scanner::DeclarationIndex,
    resolution_index: resolution::ResolutionIndex,
    interfaces: elaboration::TypedInterfaces,
    enum_payload_expected_trace: Bool
}

// The body-local compilation object is the sole persistent bridge from parsed
// syntax to Typed Core. Keeping this object local prevents a whole-program AST
// or a second persistent HIR from becoming part of the architecture.
struct BodyCompilation {
    instance: CallableInstanceId,
    callable: InterfaceCallableId,
    name: String,
    syntax: bodies::ParsedBody,
    resolution: resolution::ResolvedBody
}

checked_u32(value: usize) -> u32 {
    checked_usize_to_u32(value) else { unreachable() }
}

usize_from_u32(value: u32) -> usize {
    if(value == 0) { 0 } else { wrapping_convert_to_usize(value) }
}

compile_error_message(value: &CompileError) -> String {
    handle *value {
        CompileError::Lex(_) =>
            "self-host compiler: lexical analysis fault!",
        CompileError::Scan(_) =>
            "self-host compiler: declaration scanning failed",
        CompileError::Headers(_) =>
            "self-host compiler: declaration header parsing failed",
        CompileError::ResolutionIndex(_) =>
            "self-host compiler: declaration indexing failed",
        CompileError::InterfaceCollection(_) =>
            "self-host compiler: interface collection failed",
        CompileError::DeclarationName(_) =>
            "self-host compiler: declaration name lookup failed",
        CompileError::BodyParse(_, _) =>
            "self-host compiler: body parsing failed",
        CompileError::BodyResolution(_, _) =>
            "self-host compiler: body resolution failed",
        CompileError::BodyElaboration(_, _) =>
            "self-host compiler: body elaboration failed",
        CompileError::Lowering(_, _) =>
            "self-host compiler: ownership lowering failed",
        CompileError::InterfaceName(_, _) =>
            "self-host compiler: interface name lookup failed",
        CompileError::UnsupportedInterfaceType(_) =>
            "self-host compiler: interface contains an unsupported type",
        CompileError::Emission(_) =>
            "self-host compiler: bytecode emission failed"
    }
}

function_name<'a>(
    session: &CompilerSession,
    shell: ShellId
) -> Result<String, CompileError> {
    handle scanner::shell_at(
        &session.declarations,
        shell
    ) {
        Result::Err(_) =>
            Result::Err(CompileError::DeclarationName(shell)),
        Result::Ok(declaration) => handle
            *scanner::shell_name(declaration) {
            Result::Err(_) =>
                Result::Err(CompileError::DeclarationName(shell)),
            Result::Ok(name) => handle lexer::lexeme(
                headers::parsed_source(&session.headers),
                name
            ) {
                Result::Err(_) =>
                    Result::Err(CompileError::DeclarationName(shell)),
                Result::Ok(found) => Result::Ok(*found)
            }
        }
    }
}

callable_name<'a>(
    session: &CompilerSession,
    callable: InterfaceCallableId
) -> Result<String, CompileError> {
    handle lexer::lexeme(
        headers::parsed_source(&session.headers),
        Id::from_u32(elaboration::interface_callable_name_raw(
            &session.interfaces, callable
        ))
    ) {
        Result::Err(_) => Result::Err(CompileError::DeclarationName(
            elaboration::interface_callable_shell(&session.interfaces, callable)
        )),
        Result::Ok(found) => {
            let shell = elaboration::interface_callable_shell(
                &session.interfaces, callable
            );
            handle scanner::shell_at(&session.declarations, shell) {
                Result::Ok(declaration) => if(
                    scanner::shell_kind(declaration)
                        is scanner::DeclarationKind::Function
                ) { Result::Ok(*found) } else {
                    let output = Formatter::new();
                    // Trait and impl members share their enclosing shell.
                    // Give lowered methods a deterministic private identity,
                    // so a member named `main` cannot become the entry point.
                    Formatter::literal(&mut output, &"$method$");
                    Formatter::append_u64(
                        &mut output, wrapping_convert_to_u64(Id::to_u32(shell))
                    );
                    Formatter::literal(&mut output, &"$");
                    Formatter::literal(&mut output, found);
                    handle Formatter::finish(output) {
                        Result::Err(_) => unreachable(),
                        Result::Ok(name) => Result::Ok(name)
                    }
                },
                Result::Err(_) => Result::Err(CompileError::DeclarationName(shell))
            }
        }
    }
}

enum RuntimeLeaf {
    Primitive(u32),
    Host(u32),
    Abort
}

// Generation-1 runtime authority is attached to exact declaration identities
// in the canonical trusted standard-library prefix. The spelling is checked
// as a schema guard, but never grants authority to another declaration.
runtime_leaf_identity(shell: ShellId, name: &String) -> Option<RuntimeLeaf> {
    handle Id::to_u32(shell) {
        0 => if(String::eq(name, &"__g1_text_byte_len")) {
            Option::Some(RuntimeLeaf::Primitive(64))
        } else { None },
        1 => if(String::eq(name, &"__g1_text_concat")) {
            Option::Some(RuntimeLeaf::Primitive(65))
        } else { None },
        2 => if(String::eq(name, &"__g1_text_eq")) {
            Option::Some(RuntimeLeaf::Primitive(66))
        } else { None },
        3 => if(String::eq(name, &"__g1_text_from_utf8_checked")) {
            Option::Some(RuntimeLeaf::Primitive(67))
        } else { None },
        4 => if(String::eq(name, &"__g1_text_as_bytes")) {
            Option::Some(RuntimeLeaf::Primitive(68))
        } else { None },
        5 => if(String::eq(name, &"__g1_bytes_len")) {
            Option::Some(RuntimeLeaf::Primitive(80))
        } else { None },
        6 => if(String::eq(name, &"__g1_bytes_concat")) {
            Option::Some(RuntimeLeaf::Primitive(81))
        } else { None },
        7 => if(String::eq(name, &"__g1_bytes_get")) {
            Option::Some(RuntimeLeaf::Primitive(82))
        } else { None },
        8 => if(String::eq(name, &"__g1_bytes_slice")) {
            Option::Some(RuntimeLeaf::Primitive(83))
        } else { None },
        9 => if(String::eq(name, &"__g1_bytes_from_array_move")) {
            Option::Some(RuntimeLeaf::Primitive(84))
        } else { None },
        10 => if(String::eq(name, &"__g1_bytes_to_array")) {
            Option::Some(RuntimeLeaf::Primitive(85))
        } else { None },
        11 => if(String::eq(name, &"__g1_bytes_utf8_valid_up_to")) {
            Option::Some(RuntimeLeaf::Primitive(86))
        } else { None },
        12 => if(String::eq(name, &"__g1_char_from_u32_checked")) {
            Option::Some(RuntimeLeaf::Primitive(48))
        } else { None },
        13 => if(String::eq(name, &"__g1_char_to_u32")) {
            Option::Some(RuntimeLeaf::Primitive(49))
        } else { None },
        14 => if(String::eq(name, &"__g1_abort")) {
            Option::Some(RuntimeLeaf::Abort)
        } else { None },
        15 => runtime_primitive_named(name, &"__g1_f32_add", 32),
        16 => runtime_primitive_named(name, &"__g1_f32_sub", 33),
        17 => runtime_primitive_named(name, &"__g1_f32_mul", 34),
        18 => runtime_primitive_named(name, &"__g1_f32_div", 35),
        19 => runtime_primitive_named(name, &"__g1_f32_rem", 36),
        20 => runtime_primitive_named(name, &"__g1_f32_neg", 44),
        21 => runtime_primitive_named(name, &"__g1_f32_eq", 37),
        22 => runtime_primitive_named(name, &"__g1_f32_ne", 38),
        23 => runtime_primitive_named(name, &"__g1_f32_lt", 39),
        24 => runtime_primitive_named(name, &"__g1_f32_le", 40),
        25 => runtime_primitive_named(name, &"__g1_f32_gt", 41),
        26 => runtime_primitive_named(name, &"__g1_f32_ge", 42),
        27 => runtime_primitive_named(name, &"__g1_f64_add", 32),
        28 => runtime_primitive_named(name, &"__g1_f64_sub", 33),
        29 => runtime_primitive_named(name, &"__g1_f64_mul", 34),
        30 => runtime_primitive_named(name, &"__g1_f64_div", 35),
        31 => runtime_primitive_named(name, &"__g1_f64_rem", 36),
        32 => runtime_primitive_named(name, &"__g1_f64_neg", 44),
        33 => runtime_primitive_named(name, &"__g1_f64_eq", 37),
        34 => runtime_primitive_named(name, &"__g1_f64_ne", 38),
        35 => runtime_primitive_named(name, &"__g1_f64_lt", 39),
        36 => runtime_primitive_named(name, &"__g1_f64_le", 40),
        37 => runtime_primitive_named(name, &"__g1_f64_gt", 41),
        38 => runtime_primitive_named(name, &"__g1_f64_ge", 42),
        39 => runtime_primitive_named(name, &"__g1_f32_to_f64", 43),
        40 => runtime_primitive_named(name, &"__g1_f64_to_f32", 43),
        41 => runtime_primitive_named(name, &"__g1_u8_to_f32", 45),
        42 => runtime_primitive_named(name, &"__g1_u16_to_f32", 45),
        43 => runtime_primitive_named(name, &"__g1_u32_to_f32", 45),
        44 => runtime_primitive_named(name, &"__g1_u64_to_f32", 45),
        45 => runtime_primitive_named(name, &"__g1_u128_to_f32", 45),
        46 => runtime_primitive_named(name, &"__g1_usize_to_f32", 45),
        47 => runtime_primitive_named(name, &"__g1_i8_to_f32", 45),
        48 => runtime_primitive_named(name, &"__g1_i16_to_f32", 45),
        49 => runtime_primitive_named(name, &"__g1_i32_to_f32", 45),
        50 => runtime_primitive_named(name, &"__g1_i64_to_f32", 45),
        51 => runtime_primitive_named(name, &"__g1_i128_to_f32", 45),
        52 => runtime_primitive_named(name, &"__g1_isize_to_f32", 45),
        53 => runtime_primitive_named(name, &"__g1_u8_to_f64", 45),
        54 => runtime_primitive_named(name, &"__g1_u16_to_f64", 45),
        55 => runtime_primitive_named(name, &"__g1_u32_to_f64", 45),
        56 => runtime_primitive_named(name, &"__g1_u64_to_f64", 45),
        57 => runtime_primitive_named(name, &"__g1_u128_to_f64", 45),
        58 => runtime_primitive_named(name, &"__g1_usize_to_f64", 45),
        59 => runtime_primitive_named(name, &"__g1_i8_to_f64", 45),
        60 => runtime_primitive_named(name, &"__g1_i16_to_f64", 45),
        61 => runtime_primitive_named(name, &"__g1_i32_to_f64", 45),
        62 => runtime_primitive_named(name, &"__g1_i64_to_f64", 45),
        63 => runtime_primitive_named(name, &"__g1_i128_to_f64", 45),
        64 => runtime_primitive_named(name, &"__g1_isize_to_f64", 45),
        65 => runtime_primitive_named(name, &"__g1_f32_to_u8_checked", 46),
        66 => runtime_primitive_named(name, &"__g1_f32_to_u16_checked", 46),
        67 => runtime_primitive_named(name, &"__g1_f32_to_u32_checked", 46),
        68 => runtime_primitive_named(name, &"__g1_f32_to_u64_checked", 46),
        69 => runtime_primitive_named(name, &"__g1_f32_to_u128_checked", 46),
        70 => runtime_primitive_named(name, &"__g1_f32_to_usize_checked", 46),
        71 => runtime_primitive_named(name, &"__g1_f32_to_i8_checked", 46),
        72 => runtime_primitive_named(name, &"__g1_f32_to_i16_checked", 46),
        73 => runtime_primitive_named(name, &"__g1_f32_to_i32_checked", 46),
        74 => runtime_primitive_named(name, &"__g1_f32_to_i64_checked", 46),
        75 => runtime_primitive_named(name, &"__g1_f32_to_i128_checked", 46),
        76 => runtime_primitive_named(name, &"__g1_f32_to_isize_checked", 46),
        77 => runtime_primitive_named(name, &"__g1_f64_to_u8_checked", 46),
        78 => runtime_primitive_named(name, &"__g1_f64_to_u16_checked", 46),
        79 => runtime_primitive_named(name, &"__g1_f64_to_u32_checked", 46),
        80 => runtime_primitive_named(name, &"__g1_f64_to_u64_checked", 46),
        81 => runtime_primitive_named(name, &"__g1_f64_to_u128_checked", 46),
        82 => runtime_primitive_named(name, &"__g1_f64_to_usize_checked", 46),
        83 => runtime_primitive_named(name, &"__g1_f64_to_i8_checked", 46),
        84 => runtime_primitive_named(name, &"__g1_f64_to_i16_checked", 46),
        85 => runtime_primitive_named(name, &"__g1_f64_to_i32_checked", 46),
        86 => runtime_primitive_named(name, &"__g1_f64_to_i64_checked", 46),
        87 => runtime_primitive_named(name, &"__g1_f64_to_i128_checked", 46),
        88 => runtime_primitive_named(name, &"__g1_f64_to_isize_checked", 46),
        89 => runtime_primitive_named(name, &"__g1_f32_to_bits", 47),
        90 => runtime_primitive_named(name, &"__g1_f32_from_bits", 50),
        91 => runtime_primitive_named(name, &"__g1_f64_to_bits", 47),
        92 => runtime_primitive_named(name, &"__g1_f64_from_bits", 50),
        93 => runtime_primitive_named(name, &"__g1_array_new", 96),
