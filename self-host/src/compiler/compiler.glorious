runtime_primitive_named(
    found: &String,
    expected: &String,
    primitive: u32
) -> Option<RuntimeLeaf> {
    if(String::eq(found, expected)) {
        Option::Some(RuntimeLeaf::Primitive(primitive))
    } else {
        None
    }
}

runtime_host_named(
    found: &String,
    expected: &String,
    import: u32
) -> Option<RuntimeLeaf> {
    if(String::eq(found, expected)) {
        Option::Some(RuntimeLeaf::Host(import))
    } else { None }
}

prepare_body<'a>(
    session: &CompilerSession,
    instance: CallableInstanceId
) -> Result<BodyCompilation, CompileError> {
    let callable = elaboration::callable_instance_callable(
        &session.interfaces,
        instance
    );
    let shell = elaboration::interface_callable_shell(
        &session.interfaces,
        callable
    );
    let name = try(callable_name(session, callable), @prepare_body);
    let header_index = elaboration::interface_callable_header_index(
        &session.interfaces, callable
    );
    let syntax = try(
        Result::map_err(
            handle scanner::shell_at(&session.declarations, shell) {
                Result::Err(_) => bodies::parse_function_body(
                    &session.original,
                    &session.headers,
                    &session.declarations,
                    shell
                ),
                Result::Ok(declaration) => if(
                    scanner::shell_kind(declaration)
                        is scanner::DeclarationKind::Impl
                ) {
                    bodies::parse_impl_method_body(
                        &session.original,
                        &session.headers,
                        &session.declarations,
                        header_index
                    )
                } else { bodies::parse_function_body(
                    &session.original,
                    &session.headers,
                    &session.declarations,
                    shell
                ) }
            },
            { found => CompileError::BodyParse(shell, found) }
        ),
        @prepare_body
    );
    let resolved = try(
        Result::map_err(
            resolution::resolve_function_body_indexed(
                &session.resolution_index,
                &session.headers,
                &session.declarations,
                &syntax
            ),
            { found => CompileError::BodyResolution(shell, found) }
        ),
        @prepare_body
    );
    Result::Ok(BodyCompilation {
        instance: instance,
        callable: callable,
        name: name,
        syntax: syntax,
        resolution: resolved
    })
}

lower_body<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    body: BodyCompilation
) -> Result<lowering::MirFunction, CompileError> {
    let BodyCompilation {
        instance,
        callable,
        name,
        syntax,
        resolution
    } = body;
    let shell = elaboration::interface_callable_shell(
        &session.interfaces,
        callable
    );
    // Do not capture `session` in the resumptive `map_err` handler below:
    // body elaboration may suspend while reporting a diagnostic.  The flag is
    // copyable request state, so snapshot it before entering that boundary.
    let enum_payload_expected_trace = session.enum_payload_expected_trace;
    let typed = try(
        Result::map_err(
            elaboration::elaborate_function_instance_body(
                &session.original,
                &session.headers,
                &session.declarations,
                &mut session.interfaces,
                &syntax,
                &resolution,
                instance,
                enum_payload_expected_trace
            ),
            { found => CompileError::BodyElaboration(shell, found) }
        ),
        @lower_body
    );
    try(lower_typed_body_types(
        session,
        map,
        types,
        type_names,
        &typed
    ), @lower_body);
    Result::map_err(
        lowering::lower_function(
            name,
            &session.interfaces,
            &typed,
            instance,
            &*map
        ),
        { found => CompileError::Lowering(shell, found) }
    )
}

lower_callable<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    instance: CallableInstanceId
) -> Result<lowering::MirFunction, CompileError> {
    let callable = elaboration::callable_instance_callable(
        &session.interfaces,
        instance
    );
    let shell = elaboration::interface_callable_shell(
        &session.interfaces,
        callable
    );
    let parameter_count = elaboration::callable_instance_parameter_count(
        &session.interfaces, instance
    );
    try(try_for_range(
        Range::new(0, usize_from_u32(parameter_count)),
        { index => {
        let semantic = elaboration::callable_instance_parameter_at(
            &session.interfaces, instance, index
        );
        try(lower_concrete_type(
            &mut *session,
            &mut *map,
            &mut *types,
            &mut *type_names,
            semantic
        ), @lower_callable);
        Result::Ok(())
        }}
    ), @lower_callable);
    let result = elaboration::callable_instance_result(
        &session.interfaces, instance
    );
    try(lower_concrete_type(
        session, map, types, type_names, result
    ), @lower_callable);
    let name = try(callable_name(&*session, callable), @lower_callable);
    handle runtime_leaf_identity(shell, &name) {
        Option::Some(RuntimeLeaf::Primitive(primitive)) => Result::map_err(
            lowering::lower_primitive_function(
                name,
                &session.interfaces,
                instance,
                primitive,
                &*map
            ),
            { found => CompileError::Lowering(shell, found) }
        ),
        Option::Some(RuntimeLeaf::Abort) => Result::map_err(
            lowering::lower_abort_function(
                name,
                &session.interfaces,
                instance,
                &*map
            ),
            { found => CompileError::Lowering(shell, found) }
        ),
        Option::Some(RuntimeLeaf::Host(import)) => Result::map_err(
            lowering::lower_host_function(
                name,
                &session.interfaces,
                instance,
                import,
                &*map
            ),
            { found => CompileError::Lowering(shell, found) }
        ),
        None => {
            let body = try(
                prepare_body(&*session, instance),
                @lower_callable
            );
            lower_body(
                &mut *session,
                &mut *map,
                &mut *types,
                &mut *type_names,
                body
            )
        }
    }
}

lower_functions<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    index: usize,
    output: &mut MirFunctionArena
) -> Result<(), CompileError> {
    if(index < elaboration::callable_instance_count(&session.interfaces)) {
        let instance = handle elaboration::callable_instance_id_at(
            &session.interfaces,
            index
        ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        let function = try(
            lower_callable(
                &mut *session,
                &mut *map,
                &mut *types,
                &mut *type_names,
                instance
            ),
            @lower_functions
        );
        handle Arena::alloc(&mut *output, function) {
            Result::Err(_) => unreachable(),
            Result::Ok(staged) => if(
                Id::to_u32(staged) == Id::to_u32(instance)
            ) {
                lower_functions(
                    session,
                    map,
                    types,
                    type_names,
                    index + 1,
                    output
                )
            } else { unreachable() }
        }
    } else { Result::Ok(()) }
}

find_entry(
    program: &lowering::MirProgram,
    index: usize
) -> Option<lowering::MirFunctionId> {
    let count = lowering::mir_program_function_count(program);
    handle find_range(Range::new(index, count), { current => {
        let function = lowering::mir_program_function_at(
            program,
            lowering::mir_function_id_from_usize(current)
        );
        String::eq(
            lowering::mir_function_name(function),
            &"main"
        ) and {
            lowering::mir_function_parameter_count(function) == 0
        } and {
            lowering::artifact_type_raw(
                lowering::mir_function_result(function)
            ) == 0
        }
    } }) {
        Option::Some(found) => Option::Some(
            lowering::mir_function_id_from_usize(found)
        ),
        None => None
    }
}

interface_name<'a>(
    session: &CompilerSession,
    raw: u32,
    kind: InterfaceNameKind,
    detail: u32
) -> Result<String, CompileError> {
    handle lexer::lexeme(
        headers::parsed_source(&session.headers),
        Id::from_u32(raw)
    ) {
        Result::Err(_) =>
            Result::Err(CompileError::InterfaceName(kind, detail)),
        Result::Ok(found) => Result::Ok(*found)
    }
}

collect_struct_fields<'a>(
    session: &CompilerSession,
    start: u32,
    count: u32,
    ordinal: u32,
    type_names: &mut Vec<String>,
    names: &mut Vec<u32>,
    types: &mut Vec<lowering::ArtifactTypeId>
) -> Result<(), CompileError> {
    try_for_range(Range::new(
        usize_from_u32(ordinal),
        usize_from_u32(count)
    ), { current => {
        let current_ordinal = checked_u32(current);
        let field = elaboration::interface_field_at_view(
            &session.interfaces,
            usize_from_u32(start + current_ordinal)
        );
        let name = try(interface_name(
            session,
            elaboration::interface_field_view_name(&field),
            InterfaceNameKind::Field,
            start + current_ordinal
        ), @collect_struct_fields);
        Vec::push(
            &mut *names,
            checked_u32(Vec::len(&*type_names))
        );
        Vec::push(&mut *type_names, name);
        Vec::push(
            &mut *types,
            lowering::artifact_type_id(
                elaboration::interface_field_view_type(&field)
            )
        );
        Result::Ok(())
    } })
}

ordinal_name(value: usize) -> String {
    let output = Formatter::new();
    Formatter::append_u64(
        &mut output,
        wrapping_convert_to_u64(value)
    );
    handle Formatter::finish(output) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

collect_variant_payloads<'a>(
    payloads: Slice<'a, elaboration::TypeId>,
    type_names: &mut Vec<String>,
    names: &mut Vec<u32>,
    types: &mut Vec<lowering::ArtifactTypeId>
) {
    Slice::for_each(payloads, { payload => {
        Vec::push(
            &mut *names,
            checked_u32(Vec::len(&*type_names))
        );
        Vec::push(
            &mut *type_names,
            ordinal_name(Vec::len(&*types))
        );
        Vec::push(
            &mut *types,
            lowering::artifact_type_id(Id::to_u32(*payload))
        )
    } })
}

collect_enum_variants<'a>(
    session: &CompilerSession,
    start: u32,
    count: u32,
    ordinal: u32,
    type_names: &mut Vec<String>,
    output: &mut Vec<lowering::MirVariant>
) -> Result<(), CompileError> {
    try_for_range(Range::new(
        usize_from_u32(ordinal),
        usize_from_u32(count)
    ), { current => {
        let current_ordinal = checked_u32(current);
        let variant = usize_from_u32(start + current_ordinal);
        let name = try(interface_name(
            session,
            elaboration::interface_variant_name_at(
                &session.interfaces,
                variant
            ),
            InterfaceNameKind::Variant,
            start + current_ordinal
        ), @collect_enum_variants);
        let name_index = checked_u32(Vec::len(&*type_names));
        Vec::push(&mut *type_names, name);
        let field_names = Vec::new();
        let field_types = Vec::new();
        collect_variant_payloads(
            elaboration::interface_variant_payloads_at(
                &session.interfaces,
                variant
            ),
            type_names,
            &mut field_names,
            &mut field_types
        );
        Vec::push(
            &mut *output,
            lowering::enum_variant(
                name_index,
                field_names,
                field_types
            )
        );
        Result::Ok(())
    } })
}

collect_types<'a>(
    session: &CompilerSession,
    index: usize,
    output: &mut MirTypeArena,
    type_names: &mut Vec<String>
) -> Result<(), CompileError> {
    let end = elaboration::interface_type_count(&session.interfaces);
    try_for_range(Range::new(index, end), { current => {
        handle elaboration::interface_type_at(
            &session.interfaces,
            current
        ) {
            InterfaceTypeView::Tuple(elements) => {
                let fields = Vec::new();
                Slice::for_each(elements, { element =>
                    Vec::push(
                        &mut fields,
                        lowering::artifact_type_id(Id::to_u32(*element))
                    )
                });
                lowering::push_tuple_type(
                    &mut *output,
                    fields,
                    if(
                        elaboration::interface_type_flags_at(
                            &session.interfaces,
                            current
                        ) % 2 == 1
                    ) { 1 } else { 0 }
                );
                Result::Ok(())
            },
            InterfaceTypeView::Nominal(nominal) => handle
                elaboration::interface_nominal_at_view(
                    &session.interfaces,
                    usize_from_u32(nominal)
                ) {
                InterfaceNominalView::Struct(shell, start, count) => {
                    let name = try(
                        function_name(session, shell),
                        @collect_types
                    );
                    let name_index = checked_u32(Vec::len(&*type_names));
                    Vec::push(&mut *type_names, name);
                    let field_names = Vec::new();
                    let field_types = Vec::new();
                    try(collect_struct_fields(
                        session,
                        start,
                        count,
                        0,
                        type_names,
                        &mut field_names,
                        &mut field_types
                    ), @collect_types);
                    lowering::push_struct_type(
                        &mut *output,
                        name_index,
                        field_names,
                        field_types,
                        if(
                            elaboration::interface_type_flags_at(
                                &session.interfaces,
                                current
                            ) % 2 == 1
                        ) { 1 } else { 0 }
                    );
                    Result::Ok(())
                },
                InterfaceNominalView::Enum(shell, start, count) => {
                    let name = try(
                        function_name(session, shell),
                        @collect_types
                    );
                    let name_index = checked_u32(Vec::len(&*type_names));
                    Vec::push(&mut *type_names, name);
                    let variants = Vec::new();
                    try(collect_enum_variants(
                        session,
                        start,
                        count,
                        0,
                        type_names,
                        &mut variants
                    ), @collect_types);
                    lowering::push_enum_type(
                        &mut *output,
                        name_index,
                        variants,
                        if(
                            elaboration::interface_type_flags_at(
                                &session.interfaces,
                                current
                            ) % 2 == 1
                        ) { 1 } else { 0 }
                    );
                    Result::Ok(())
                }
            },
            _ => Result::Err(
                CompileError::UnsupportedInterfaceType(current)
            )
        }
    } })
}

append_concrete_type_arguments<'a>(
    session: &CompilerSession,
    ty: elaboration::TypeId,
    output: &mut Formatter,
    ordinal: u32
) {
    let start = elaboration::interface_type_b_at(
        &session.interfaces,
        Id::to_usize(ty)
    );
    let count = elaboration::interface_type_c_at(
        &session.interfaces,
        Id::to_usize(ty)
    );
    if(ordinal < count) {
        if(ordinal == 0) {
            Formatter::literal(&mut *output, &"<")
        } else {
            Formatter::literal(&mut *output, &",")
        };
        let argument = elaboration::interface_type_element_at(
            &session.interfaces,
            usize_from_u32(start + ordinal)
        );
        Formatter::append_u64(
            &mut *output,
            wrapping_convert_to_u64(Id::to_u32(argument))
        );
        append_concrete_type_arguments(
            session, ty, output, ordinal + 1
        )
    } else {
        if(count == 0) { () } else {
            Formatter::literal(&mut *output, &">")
        }
    }
}

concrete_nominal_name<'a>(
    session: &CompilerSession,
    shell: ShellId,
    application: Option<elaboration::TypeId>
) -> Result<String, CompileError> {
    let base = try(function_name(session, shell), @concrete_nominal_name);
    handle application {
        None => Result::Ok(base),
        Option::Some(ty) => {
            let output = Formatter::new();
            Formatter::literal(&mut output, &base);
            append_concrete_type_arguments(session, ty, &mut output, 0);
            handle Formatter::finish(output) {
                Result::Err(_) => unreachable(),
                Result::Ok(found) => Result::Ok(found)
            }
        }
    }
}

concrete_member_type<'a>(
    session: &mut CompilerSession,
    application: Option<elaboration::TypeId>,
    member: elaboration::TypeId
) -> elaboration::TypeId {
    handle application {
        None => member,
        Option::Some(found) =>
            elaboration::instantiate_application_member_type(
                &session.headers,
                &mut session.interfaces,
                found,
                member
            )
    }
}

lower_concrete_type_elements<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    start: u32,
    count: u32,
    ordinal: u32,
    output: &mut Vec<lowering::ArtifactTypeId>
) -> Result<Bool, CompileError> {
    if(ordinal < count) {
        let semantic = elaboration::interface_type_element_at(
            &session.interfaces,
            usize_from_u32(start + ordinal)
        );
        let artifact = try(lower_concrete_type(
            session, map, types, type_names, semantic
        ), @lower_concrete_type_elements);
        let copyable = lowering::mapped_type_copyable(map, semantic);
        Vec::push(&mut *output, artifact);
        let following = try(lower_concrete_type_elements(
            session,
            map,
            types,
            type_names,
            start,
            count,
            ordinal + 1,
            output
        ), @lower_concrete_type_elements);
        Result::Ok(copyable and { following })
    } else { Result::Ok(true) }
}

lower_callable_parameter_types<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    signature: elaboration::CallableSignatureId,
    ordinal: usize,
    output: &mut Vec<lowering::ArtifactTypeId>
) -> Result<(), CompileError> {
    if(ordinal < elaboration::callable_signature_parameter_count(
        &session.interfaces, signature
    )) {
        let semantic = elaboration::callable_signature_parameter_at(
            &session.interfaces, signature, ordinal
        );
        let artifact = try(lower_concrete_type(
            session, map, types, type_names, semantic
        ), @lower_callable_parameter_types);
        Vec::push(&mut *output, artifact);
        lower_callable_parameter_types(
            session, map, types, type_names, signature, ordinal + 1, output
        )
    } else { Result::Ok(()) }
}

lower_concrete_struct_fields<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    application: Option<elaboration::TypeId>,
    start: u32,
    count: u32,
    ordinal: u32,
    field_names: &mut Vec<u32>,
    fields: &mut Vec<lowering::ArtifactTypeId>
) -> Result<Bool, CompileError> {
    if(ordinal < count) {
        let index = usize_from_u32(start + ordinal);
        let field = elaboration::interface_field_at_view(
            &session.interfaces, index
        );
        let name = try(interface_name(
            &*session,
            elaboration::interface_field_view_name(&field),
            InterfaceNameKind::Field,
            start + ordinal
        ), @lower_concrete_struct_fields);
        Vec::push(&mut *field_names, checked_u32(Vec::len(&*type_names)));
        Vec::push(&mut *type_names, name);
        let member = Id::from_u32(
            elaboration::interface_field_view_type(&field)
        );
        let semantic = concrete_member_type(session, application, member);
        let artifact = try(lower_concrete_type(
            session, map, types, type_names, semantic
        ), @lower_concrete_struct_fields);
        let copyable = lowering::mapped_type_copyable(map, semantic);
        Vec::push(&mut *fields, artifact);
        let following = try(lower_concrete_struct_fields(
            session,
            map,
            types,
            type_names,
            application,
            start,
            count,
            ordinal + 1,
            field_names,
            fields
        ), @lower_concrete_struct_fields);
        Result::Ok(copyable and { following })
    } else { Result::Ok(true) }
}

lower_concrete_variant_payloads<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    application: Option<elaboration::TypeId>,
    variant: usize,
    ordinal: u32,
    field_names: &mut Vec<u32>,
    fields: &mut Vec<lowering::ArtifactTypeId>
) -> Result<Bool, CompileError> {
    let count = elaboration::interface_variant_payload_count_at(
        &session.interfaces, variant
    );
    if(ordinal < count) {
        Vec::push(&mut *field_names, checked_u32(Vec::len(&*type_names)));
        Vec::push(&mut *type_names, ordinal_name(usize_from_u32(ordinal)));
        let member = elaboration::interface_variant_payload_at(
            &session.interfaces,
            variant,
            usize_from_u32(ordinal)
        );
        let semantic = concrete_member_type(session, application, member);
        let artifact = try(lower_concrete_type(
            session, map, types, type_names, semantic
        ), @lower_concrete_variant_payloads);
        let copyable = lowering::mapped_type_copyable(map, semantic);
        Vec::push(&mut *fields, artifact);
        let following = try(lower_concrete_variant_payloads(
            session,
            map,
            types,
            type_names,
            application,
            variant,
            ordinal + 1,
            field_names,
            fields
        ), @lower_concrete_variant_payloads);
        Result::Ok(copyable and { following })
    } else { Result::Ok(true) }
}

lower_concrete_enum_variants<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    application: Option<elaboration::TypeId>,
    start: u32,
    count: u32,
    ordinal: u32,
    output: &mut Vec<lowering::MirVariant>
) -> Result<Bool, CompileError> {
    if(ordinal < count) {
        let index = usize_from_u32(start + ordinal);
        let name = try(interface_name(
            &*session,
            elaboration::interface_variant_name_at(
                &session.interfaces, index
            ),
            InterfaceNameKind::Variant,
            start + ordinal
        ), @lower_concrete_enum_variants);
        let name_index = checked_u32(Vec::len(&*type_names));
        Vec::push(&mut *type_names, name);
        let field_names = Vec::new();
        let fields = Vec::new();
        let copyable = try(lower_concrete_variant_payloads(
            session,
            map,
            types,
            type_names,
            application,
            index,
            0,
            &mut field_names,
            &mut fields
        ), @lower_concrete_enum_variants);
        Vec::push(
            &mut *output,
            lowering::enum_variant(name_index, field_names, fields)
        );
        let following = try(lower_concrete_enum_variants(
            session,
            map,
            types,
            type_names,
            application,
            start,
            count,
            ordinal + 1,
            output
        ), @lower_concrete_enum_variants);
        Result::Ok(copyable and { following })
    } else { Result::Ok(true) }
}

lower_concrete_nominal<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    semantic: elaboration::TypeId,
    nominal: u32,
    application: Option<elaboration::TypeId>,
    reserved: lowering::MirTypeId
) -> Result<(), CompileError> {
    let view = elaboration::interface_nominal_at_view(
        &session.interfaces, usize_from_u32(nominal)
    );
    handle view {
        InterfaceNominalView::Struct(shell, start, count) => {
            let name = try(concrete_nominal_name(
                &*session, shell, application
            ), @lower_concrete_nominal);
            let name_index = checked_u32(Vec::len(&*type_names));
            Vec::push(&mut *type_names, name);
            let field_names = Vec::new();
            let fields = Vec::new();
            let copyable = try(lower_concrete_struct_fields(
                session,
                map,
                types,
                type_names,
                application,
                start,
                count,
                0,
                &mut field_names,
                &mut fields
            ), @lower_concrete_nominal);
            lowering::set_struct_type(
                types,
                reserved,
                name_index,
                field_names,
                fields,
                if(copyable) { 1 } else { 0 }
            );
            lowering::set_mapped_type_copyable(map, semantic, copyable);
            Result::Ok(())
        },
        InterfaceNominalView::Enum(shell, start, count) => {
            let name = try(concrete_nominal_name(
                &*session, shell, application
            ), @lower_concrete_nominal);
            let name_index = checked_u32(Vec::len(&*type_names));
            Vec::push(&mut *type_names, name);
            let variants = Vec::new();
            let copyable = try(lower_concrete_enum_variants(
                session,
                map,
                types,
                type_names,
                application,
                start,
                count,
                0,
                &mut variants
            ), @lower_concrete_nominal);
            lowering::set_enum_type(
                types,
                reserved,
                name_index,
                variants,
                if(copyable) { 1 } else { 0 }
            );
            lowering::set_mapped_type_copyable(map, semantic, copyable);
            Result::Ok(())
        }
    }
}

lower_concrete_type<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    semantic: elaboration::TypeId
) -> Result<lowering::ArtifactTypeId, CompileError> {
    handle lowering::mapped_artifact_type(&*map, semantic) {
        Option::Some(found) => Result::Ok(found),
        None => {
            let index = Id::to_usize(semantic);
            let tag = elaboration::interface_type_tag_at(
                &session.interfaces, index
            );
            let a = elaboration::interface_type_a_at(
                &session.interfaces, index
            );
            let b = elaboration::interface_type_b_at(
                &session.interfaces, index
            );
            let c = elaboration::interface_type_c_at(
                &session.interfaces, index
            );
            let reserved = lowering::reserve_mir_type(types);
            let artifact = lowering::mir_type_artifact_id(reserved);
            lowering::bind_artifact_type(
                map,
                elaboration::interface_type_count(&session.interfaces),
                semantic,
                artifact
            );
            if(tag == 4) {
                let fields = Vec::new();
                let copyable = try(lower_concrete_type_elements(
                    session,
                    map,
                    types,
                    type_names,
                    a,
                    b,
                    0,
                    &mut fields
                ), @lower_concrete_type);
                lowering::set_tuple_type(
                    types,
                    reserved,
                    fields,
                    if(copyable) { 1 } else { 0 }
                );
                lowering::set_mapped_type_copyable(map, semantic, copyable);
                Result::Ok(artifact)
            } else { if(tag == 9 or { tag == 6 } or { tag == 7 }) {
                let child = Id::from_u32(a);
                let element = try(lower_concrete_type(
                    session, map, types, type_names, child
                ), @lower_concrete_type);
                let kind = if(tag == 9) {
                    lowering::MirTypeKind::Array
                } else { if(tag == 6) {
                    lowering::MirTypeKind::SharedReference
                } else { lowering::MirTypeKind::UniqueReference } };
                let copyable = tag == 6;
                lowering::set_unary_structural_type(
                    types,
                    reserved,
                    kind,
                    element,
                    if(copyable) { 1 } else { 0 }
                );
                lowering::set_mapped_type_copyable(map, semantic, copyable);
                Result::Ok(artifact)
            } else { if(tag == 5) {
                if(elaboration::interface_nominal_generic_count(
                    &session.interfaces, usize_from_u32(a)
                ) == 0) {
                    try(lower_concrete_nominal(
                        session,
                        map,
                        types,
                        type_names,
                        semantic,
                        a,
                        None,
                        reserved
                    ), @lower_concrete_type);
                    Result::Ok(artifact)
                } else { Result::Err(
                    CompileError::UnsupportedInterfaceType(index)
                ) }
            } else { if(tag == 10) {
                let nominal = handle
                    elaboration::interface_application_nominal(
                        &session.interfaces, semantic
                    ) {
                    None => @lower_concrete_type(Result::Err(
                        CompileError::UnsupportedInterfaceType(index)
                    )),
                    Option::Some(found) => found
                };
                try(lower_concrete_nominal(
                    session,
                    map,
                    types,
                    type_names,
                    semantic,
                    nominal,
                    Option::Some(semantic),
                    reserved
                ), @lower_concrete_type);
                Result::Ok(artifact)
            } else { if(tag == 14) {
                let signature = Id::from_u32(a);
                // Lift the exact parameter/result types before publishing the
                // opaque callable descriptor. The first vertical slice is
                // deliberately pure: effect-row and captured closure lowering
                // remain separate scheduling work.
                if(elaboration::callable_signature_effect_count(
                    &session.interfaces, signature
                ) != 0 or {
                    Option::is_some(elaboration::callable_signature_effect_tail_at(
                        &session.interfaces, signature
                    ))
                }) {
                    @lower_concrete_type(Result::Err(
                        CompileError::UnsupportedInterfaceType(index)
                    ))
                } else { () };
                let parameters = Vec::new();
                try(lower_callable_parameter_types(
                    session,
                    map,
                    types,
                    type_names,
                    signature,
                    0,
                    &mut parameters
                ), @lower_concrete_type);
                let result = try(lower_concrete_type(
                    session,
                    map,
                    types,
                    type_names,
                    elaboration::callable_signature_result_at(
                        &session.interfaces, signature
                    )
                ), @lower_concrete_type);
                let name_index = checked_u32(Vec::len(&*type_names));
                Vec::push(&mut *type_names, "callable");
                lowering::set_callable_type(
                    types,
                    reserved,
                    name_index,
                    lowering::artifact_type_id(0),
                    lowering::mir_signature(parameters, result, Vec::new()),
                    2,
                    0,
                    false
                );
                lowering::set_mapped_type_copyable(map, semantic, false);
                Result::Ok(artifact)
            } else { if(tag == 3) {
                // Dynamically allocated scalars reach lowering only through the
                // focused-arena Bool marker (scalar kind 16).  The distributed
                // Bool is `Result<Unit, Unit>`: an enum of two nullary variants.
                let kinds = elaboration::interface_type_a_at(&session.interfaces, index);
                if(kinds == 16) {
                    let variants = Vec::new();
                    let ok_name = checked_u32(Vec::len(&*type_names));
                    Vec::push(&mut *type_names, ordinal_name(0));
                    Vec::push(&mut variants, lowering::enum_variant(ok_name, Vec::new(), Vec::new()));
                    let err_name = checked_u32(Vec::len(&*type_names));
                    Vec::push(&mut *type_names, ordinal_name(1));
                    Vec::push(&mut variants, lowering::enum_variant(err_name, Vec::new(), Vec::new()));
                    let bool_name = checked_u32(Vec::len(&*type_names));
                    Vec::push(&mut *type_names, ordinal_name(2));
                    lowering::set_enum_type(types, reserved, bool_name, variants, 1);
                    lowering::set_mapped_type_copyable(map, semantic, true);
                    Result::Ok(artifact)
                } else { c; Result::Err(
                    CompileError::UnsupportedInterfaceType(index)
                ) }
            } else { c; Result::Err(
                CompileError::UnsupportedInterfaceType(index)
            ) } } } } } }
        }
    }
}

lower_typed_body_types<'a>(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    body: &elaboration::TypedBody
) -> Result<(), CompileError> {
    let result = elaboration::typed_body_result_type(body);
    try(lower_concrete_type(
        session, map, types, type_names, result
    ), @lower_typed_body_types);
    elaboration::walk_core(
        body,
        elaboration::typed_body_root(body),
        @lower_typed_body_types,
        { _, view, failed => {
            let semantic = elaboration::core_node_view_type(view);
            handle lower_concrete_type(
                &mut *session,
                &mut *map,
                &mut *types,
                &mut *type_names,
                semantic
            ) {
                Result::Err(error) => failed(Result::Err(error)),
                Result::Ok(_) => bodies::Visit::Descend
            }
        }}
    );
    Result::Ok(())
}

// `compile_source` receives a bare user stream, whereas the bootstrap
// compiler compiles it through SourceBundle::distributed and therefore sees
// the distributed Result declaration. Keep this deliberately small until the
// self-host driver owns the complete standard-library bundle. Appending keeps
// every user token (and hence every reported user token index) unchanged.
//
// The scanner is authoritative here: an explicit root `Result` must not gain
// a second declaration from this compatibility prelude, because resolution
// correctly treats that duplicate type name as ambiguous.
source_declares_root_result(
    source: &lexer::LexedSource,
    declarations: &scanner::DeclarationIndex
) -> Bool {
    handle lexer::lexeme_id(source, &"Result") {
        Result::Err(_) => false,
        Result::Ok(name) => {
            let found = scanner::def_search(
                declarations,
                None,
                name,
                scanner::Namespace::Type
            );
            scanner::def_search_count(&found) != 0
        }
    }
}

minimal_interface_prelude(
    original: &String,
    source: &lexer::LexedSource,
    declarations: &scanner::DeclarationIndex
) -> String {
    let output = ByteBuf::new();
    ByteBuf::append_bytes(&mut output, &String::as_bytes(original));
    if(not(source_declares_root_result(source, declarations))) {
        ByteBuf::append_bytes(
            &mut output,
            &String::as_bytes(&"\nenum Result<T, E> { Ok(T), Err(E) }\n")
        )
    } else { () };
    handle String::from_utf8(ByteBuf::finish(output)) {
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    }
}

prepare_session(
    original: &String,
    enum_payload_expected_trace: Bool
) -> Result<CompilerSession, CompileError> {
    let scanned_source = try(
        Result::map_err(
            lexer::lex(original),
            { found => CompileError::Lex(found) }
        ),
        @prepare_session
    );
    let scanned_declarations = try(
        Result::map_err(
            scanner::scan(&scanned_source),
            { found => CompileError::Scan(found) }
        ),
        @prepare_session
    );
    let original = minimal_interface_prelude(
        original,
        &scanned_source,
        &scanned_declarations
    );
    let source = try(
        Result::map_err(
            lexer::lex(&original),
            { found => CompileError::Lex(found) }
        ),
        @prepare_session
    );
    let declarations = try(
        Result::map_err(
            scanner::scan(&source),
            { found => CompileError::Scan(found) }
        ),
        @prepare_session
    );
    let parsed_headers = try(
        Result::map_err(
            headers::parse(&original, source, &declarations),
            { found => CompileError::Headers(found) }
        ),
        @prepare_session
    );
    let resolution_index = try(
        Result::map_err(
            resolution::build_resolution_index(
                &parsed_headers,
                &declarations
            ),
            { found => CompileError::ResolutionIndex(found) }
        ),
        @prepare_session
    );
    let interfaces = try(
        Result::map_err(
            elaboration::collect_interfaces(
                &parsed_headers,
                &declarations
            ),
            { found => CompileError::InterfaceCollection(found) }
        ),
        @prepare_session
    );
    Result::Ok(CompilerSession {
        original: original,
        headers: parsed_headers,
        declarations: declarations,
        resolution_index: resolution_index,
        interfaces: interfaces,
        enum_payload_expected_trace: enum_payload_expected_trace
    })
}

// The initial seed has no substitutions.  In particular, a trait interface
// method can have no callable-local generic parameters while its signature
// still contains TraitSelf.  Do not turn those abstract interfaces into
// lowering work: instances are only safe to lower once their entire exposed
// signature is represented by concrete artifact types.
type_is_recursively_concrete(
    interfaces: &elaboration::TypedInterfaces,
    semantic: elaboration::TypeId
) -> Bool {
    let index = Id::to_usize(semantic);
    let tag = elaboration::interface_type_tag_at(interfaces, index);
    if(tag == 8 or { tag == 13 } or { tag == 14 }) {
        // TypeParameter includes declaration, impl, and TraitSelf owners;
        // effects and callable descriptors have no artifact type until the
        // backend lowers a closure environment and callable ABI.
        false
    } else { if(tag == 4 or { tag == 10 }) {
        let start = if(tag == 4) {
            elaboration::interface_type_a_at(interfaces, index)
        } else {
            elaboration::interface_type_b_at(interfaces, index)
        };
        let count = if(tag == 4) {
            elaboration::interface_type_b_at(interfaces, index)
        } else { elaboration::interface_type_c_at(interfaces, index) };
        type_elements_are_recursively_concrete(
            interfaces, start, count, 0
        )
    } else { if(tag == 9 or { tag == 6 } or { tag == 7 }) {
        type_is_recursively_concrete(
            interfaces,
            Id::from_u32(elaboration::interface_type_a_at(interfaces, index))
        )
    } else { if(tag == 5) {
        elaboration::interface_nominal_generic_count(
            interfaces,
            usize_from_u32(elaboration::interface_type_a_at(interfaces, index))
        ) == 0
    } else {
        // Unit, Never, scalar, Text, and Bytes have no type children.
        true
    } } } }
}

type_elements_are_recursively_concrete(
    interfaces: &elaboration::TypedInterfaces,
    start: u32,
    count: u32,
    offset: usize
) -> Bool {
    if(offset < usize_from_u32(count)) {
        let child = elaboration::interface_type_element_at(
            interfaces,
            usize_from_u32(start) + offset
        );
        type_is_recursively_concrete(interfaces, child) and {
            type_elements_are_recursively_concrete(
                interfaces, start, count, offset + 1
            )
        }
    } else { true }
}

callable_signature_is_recursively_concrete(
    interfaces: &elaboration::TypedInterfaces,
    callable: InterfaceCallableId,
    parameter: usize
) -> Bool {
    let parameter_count = elaboration::interface_callable_parameter_count(
        interfaces, callable
    );
    if(parameter < usize_from_u32(parameter_count)) {
        type_is_recursively_concrete(
            interfaces,
            elaboration::interface_callable_parameter_at(
                interfaces, callable, parameter
            )
        ) and {
            callable_signature_is_recursively_concrete(
                interfaces, callable, parameter + 1
            )
        }
    } else {
        type_is_recursively_concrete(
            interfaces,
            elaboration::interface_callable_result(interfaces, callable)
        )
    }
}

callable_is_trait_requirement(
    session: &CompilerSession,
    callable: InterfaceCallableId
) -> Bool {
    let shell = elaboration::interface_callable_shell(
        &session.interfaces, callable
    );
    handle scanner::shell_at(&session.declarations, shell) {
        Result::Err(_) => true,
        Result::Ok(declaration) => scanner::shell_kind(declaration)
            is scanner::DeclarationKind::Trait
    }
}

seed_concrete_callables<'a>(
    session: &mut CompilerSession,
    index: usize
) {
    if(index < elaboration::interface_callable_count(&session.interfaces)) {
        let callable = handle elaboration::interface_callable_id_at(
            &session.interfaces,
            index
        ) {
            Result::Err(_) => unreachable(),
            Result::Ok(found) => found
        };
        if(elaboration::interface_callable_generic_count(
            &session.interfaces,
            callable
        ) == 0 and {
            // A receiverless trait requirement can look concrete too, but it
            // has no body or selected implementation to lower.  Keep its
            // interface for future dispatch; only implementation members may
            // enter the initial direct-call seed.
            not callable_is_trait_requirement(&*session, callable)
        } and {
            callable_signature_is_recursively_concrete(
                &session.interfaces, callable, 0
            )
        }) {
            let substitutions = Vec::new();
            elaboration::intern_callable_instance(
                &mut session.interfaces,
                callable,
                &substitutions
            );
            ()
        } else { () };
        seed_concrete_callables(session, index + 1)
    } else { () }
}

effect_operation_name(
    session: &CompilerSession,
    operation: elaboration::InterfaceEffectOperationId
) -> Result<String, CompileError> {
    handle lexer::lexeme(
        headers::parsed_source(&session.headers),
        Id::from_u32(elaboration::interface_effect_operation_name(
            &session.interfaces, operation
        ))
    ) {
        Result::Err(_) => Result::Err(CompileError::InterfaceName(
            InterfaceNameKind::Field, Id::to_u32(operation)
        )),
        Result::Ok(found) => Result::Ok(*found)
    }
}

effect_operation_payload_type(
    session: &CompilerSession,
    operation: elaboration::InterfaceEffectOperationId,
    ordinal: u32
) -> elaboration::TypeId {
    handle elaboration::interface_effect_operation_payload_at(
        &session.interfaces, operation, ordinal
    ) { None => unreachable(), Option::Some(found) => found }
}

effect_operation_result_type(
    session: &CompilerSession,
    operation: elaboration::InterfaceEffectOperationId
) -> elaboration::TypeId {
    elaboration::interface_effect_operation_result(&session.interfaces, operation)
}

lower_effect_operation_payloads(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    operation: elaboration::InterfaceEffectOperationId,
    ordinal: u32,
    count: u32,
    output: &mut Vec<lowering::ArtifactTypeId>
) -> Result<(), CompileError> {
    if(ordinal < count) {
        let semantic = effect_operation_payload_type(&*session, operation, ordinal);
        handle lower_concrete_type(
            &mut *session, &mut *map, &mut *types, &mut *type_names, semantic
        ) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(artifact) => {
                Vec::push(&mut *output, artifact);
                lower_effect_operation_payloads(
                    session, map, types, type_names, operation, ordinal + 1, count, output
                )
            }
        }
    } else { Result::Ok(()) }
}

lower_effect_operations(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    protocol: elaboration::InterfaceEffectId,
    ordinal: u32,
    output: &mut Vec<lowering::MirOperation>
) -> Result<(), CompileError> {
    if(ordinal < elaboration::interface_effect_operation_count(
        &session.interfaces, protocol
    )) {
        let operation = handle elaboration::interface_effect_operation_id(
            &session.interfaces, protocol, ordinal
        ) { None => unreachable(), Option::Some(found) => found };
        let payloads = Vec::new();
        let count = elaboration::interface_effect_operation_payload_count(
            &session.interfaces, operation
        );
        handle lower_effect_operation_payloads(
            &mut *session, &mut *map, &mut *types, &mut *type_names,
            operation, 0, count, &mut payloads
        ) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(()) => {
                let result_semantic = effect_operation_result_type(&*session, operation);
                handle lower_concrete_type(
                    &mut *session, &mut *map, &mut *types, &mut *type_names,
                    result_semantic
                ) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(result) => handle effect_operation_name(&*session, operation) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(name) => {
                        Vec::push(&mut *output, lowering::mir_operation(
                            name,
                            lowering::mir_signature(
                                payloads, lowering::artifact_type_id(0), Vec::new()
                            ),
                            result,
                            elaboration::interface_effect_operation_resumption_lower(&session.interfaces, operation),
                            elaboration::interface_effect_operation_resumption_upper(&session.interfaces, operation),
                            elaboration::interface_effect_operation_is_terminal(&session.interfaces, operation)
                        ));
                        lower_effect_operations(
                            session, map, types, type_names, protocol, ordinal + 1, output
                        )
                    }
                }
            }
            }
        }
    } else { Result::Ok(()) }
}

lower_effect_protocols(
    session: &mut CompilerSession,
    map: &mut lowering::ArtifactTypeMap,
    types: &mut MirTypeArena,
    type_names: &mut Vec<String>,
    index: usize,
    output: &mut Arena<lowering::MirProtocolTag, lowering::MirProtocol>
) -> Result<(), CompileError> {
    if(index < elaboration::interface_effect_count(&session.interfaces)) {
        let protocol = handle elaboration::interface_effect_id_at(&session.interfaces, index) {
            None => unreachable(), Option::Some(found) => found
        };
        // A generic declaration is only a template.  The bootstrap compiler
        // materializes protocols for ground instances discovered at performs,
        // rows, or specialized bodies; it does not serialize an empty
        // declaration-shaped placeholder.  Until that instance collection is
        // available here, omit an unused template entirely.  In particular,
        // its declaration ordinal is not a runtime protocol identity.
        if(elaboration::interface_effect_generic_count(&session.interfaces, protocol) != 0) {
            lower_effect_protocols(session, map, types, type_names, index + 1, output)
        } else {
            let operations = Vec::new();
            handle lower_effect_operations(
                &mut *session, &mut *map, &mut *types, &mut *type_names,
                protocol, 0, &mut operations
            ) {
                Result::Err(error) => Result::Err(error),
                Result::Ok(()) => handle function_name(
                    &*session, elaboration::interface_effect_shell(&session.interfaces, protocol)
                ) {
                    Result::Err(error) => Result::Err(error),
                    Result::Ok(name) => {
                        lowering::alloc_mir_protocol(&mut *output, lowering::mir_protocol(
                            name, Vec::new(), operations
                        ));
                        lower_effect_protocols(session, map, types, type_names, index + 1, output)
                    }
                }
            }
        }
    } else { Result::Ok(()) }
}

compile_session<'a>(
    session: CompilerSession
) -> Result<Bytes, CompileError> {
    let functions = Arena::new();
    let types = lowering::mir_types();
    let type_map = lowering::artifact_type_map();
    let type_names = Vec::new();
    let protocols = lowering::mir_protocols();
    // Move the frontend session (CompilerSession and its whole frontend graph:
    // parsed headers, declaration and resolution indices, and the typed
    // interface arena) into a nested scope. Its ownership therefore ends as
    // soon as lowering finishes, before finish_program and emission allocate
    // the artifact. The `&mut session` reborrows are scoped to this block, so
    // binding it here (rather than merely wrapping the calls lexically) lets
    // the whole graph be dropped right away instead of lingering until the end
    // of compile_session.
    try({
        let session = session;
        seed_concrete_callables(&mut session, 0);
        handle lower_effect_protocols(
            &mut session,
            &mut type_map,
            &mut types,
            &mut type_names,
            0,
            &mut protocols
        ) {
            Result::Err(error) => Result::Err(error),
            Result::Ok(()) => lower_functions(
                &mut session,
                &mut type_map,
                &mut types,
                &mut type_names,
                0,
                &mut functions
            )
        }
    }, @compile_session);
    let program = lowering::finish_effect_program(
        functions,
        types,
        type_names,
        protocols,
        lowering::mir_handler_definitions()
    );
    let entry = find_entry(&program, 0);
    Result::map_err(
        emission::encode(&program, entry),
        { found => CompileError::Emission(found) }
    )
}

pub compile_source(original: &String) -> Result<Bytes, CompileError> {
    compile_source_with_enum_payload_trace(original, false)
}

compile_source_with_enum_payload_trace(
    original: &String,
    enum_payload_expected_trace: Bool
) -> Result<Bytes, CompileError> {
    let session = try(
        prepare_session(original, enum_payload_expected_trace),
        @compile_source_with_enum_payload_trace
    );
    compile_session(session)
}

// The native driver accepts an ordered list of source paths. The compiler
// itself deliberately keeps one source stream: headers and bodies resolve over
// the complete declaration set, and a newline at each file boundary prevents
// adjacent final/initial tokens from becoming one token. This is not a
// filesystem module resolver; external `mod name;` path discovery remains a
// distinct frontend capability. Keeping that distinction explicit avoids the
// duplicate-standard-library problem of bootstrap monolithic-source output.
append_ordered_sources(
    sources: &Vec<String>,
    index: usize,
    output: &mut ByteBuf
) {
    if(index < Vec::len(sources)) {
        if(index != 0) { ByteBuf::push(output, 10) } else { () };
        ByteBuf::append_bytes(
            output,
            &String::as_bytes(Vec::index(sources, index))
        );
        append_ordered_sources(sources, index + 1, output)
    } else { () }
}

pub compile_sources(sources: &Vec<String>) -> Result<Bytes, CompileError> {
    compile_sources_with_enum_payload_trace(sources, false)
}

// Kept separate from the ordinary API so an emitted compiler never enables
// tracing unless native_host_runtime has supplied its explicit marker.
pub compile_sources_with_enum_payload_trace(
    sources: &Vec<String>,
    enum_payload_expected_trace: Bool
) -> Result<Bytes, CompileError> {
    let merged = ByteBuf::new();
    append_ordered_sources(sources, 0, &mut merged);
    let original = handle String::from_utf8(ByteBuf::finish(merged)) {
        // The inputs are already valid Strings, so concatenation cannot make
        // invalid UTF-8. Keep the Result boundary explicit for this ABI.
        Result::Err(_) => unreachable(),
        Result::Ok(found) => found
    };
    compile_source_with_enum_payload_trace(
        &original,
        enum_payload_expected_trace
    )
}

pub application() / { ProcessArgs, FileRead, FileWrite, Diagnostic } {
    let arguments = process_args();
    if(Vec::len(&arguments) < 2) {
        write_diagnostic(
            "usage: grandiose-self-host-compiler <output.grbc> <input.glorious>"
        )
    } else {
        let output_path = *Vec::index(&arguments, 0);
        let input_path = *Vec::index(&arguments, 1);
        let enum_payload_expected_trace = if(Vec::len(&arguments) >= 3) {
            String::eq(
                Vec::index(&arguments, 2),
                &"--g1-self-host-enum-payload-trace"
            )
        } else { false };
        let bytes = read_file(input_path);
        handle String::from_utf8(bytes) {
            Result::Err(_) =>
                write_diagnostic("self-host compiler: input is not UTF-8"),
            Result::Ok(source) => handle compile_source_with_enum_payload_trace(
                &source,
                enum_payload_expected_trace
            ) {
                Result::Err(error) =>
                    write_diagnostic(compile_error_message(&error)),
                Result::Ok(artifact) =>
                    write_file(output_path, artifact)
            }
        }
    }
}
