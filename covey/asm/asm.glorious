// A system's machine code read from what `objdump -d -l --inlines
// --no-show-raw-insn -C --no-addresses` writes (upstream's devtools::asm):
// the instructions whose inline chain reaches a function, or lines of a
// file, normalized (addresses and offsets left out), and counts that say
// most about the code. Reading the binary is the caller's: this reads the
// text.
use std::vec::{Vec};
use std::text::{join};

// What to collect: a function by path, matched by its last segment; or the
// lines `first` to `last` of a file (a closure's body).
pub enum Target { Function(String), Lines(String, Int, Int) }

pub struct Code { pub instructions: Vec<String>, pub symbols: Vec<String> }

// One source location of an instruction's inline chain.
struct Frame { file: String, line: Int, function: Option<String> }

// The last segment of a path, `game::apply_damage` to `apply_damage`, its
// type arguments left out.
fn last_segment(path: &str) -> &str {
    let bare = match(path.find("<")) { Some(at) => path.slice(0, at), None => path };
    let parts = bare.split(":");
    let mut out = bare;
    let mut i = 0;
    while({ i < parts.len() }) { if(parts[i].is_empty()) { () } else { out = parts[i] }; i = i + 1 };
    out
}
// Each path in a type's name shortened to its last segment.
pub fn short_type(name: &str) -> String {
    let mut out = String::new();
    let mut word = String::new();
    let mut it = name.chars();
    let mut more = true;
    while({ more }) {
        match(it.next()) {
            Some(c) =>
                if(std::char::is_alphanumeric(c) or { c == '_' } or { c == ':' }) { word.push(c) }
                else { out.push_str(last_segment(word.as_str())); out.push(c); word.clear() },
            None => more = false
        }
    };
    out.push_str(last_segment(word.as_str()));
    out
}

// `file:line`, with ` (function)` after it or not.
fn parse_frame(text: &str) -> Option<Frame> {
    let (location, rest) = match(text.find(" (")) { Some(at) => (text.slice(0, at), Some(text.slice(at + 2, text.len()))), None => (text, None) };
    let parts = location.split(":");
    let count = parts.len();
    if(count < 2) { None } else {
        let file = join(parts.as_slice().split_at(count - 1).0, ":");
        let function = match(rest) {
            Some(r) =>
                let f = if(r.ends_with(")")) { r.slice(0, r.len() - 1) } else { r };
                if(f.starts_with("discriminator")) { None } else { Some(String::from(f)) },
            None => None
        };
        match(parts[count - 1].parse_int()) { Some(line) => Some(Frame { file: file, line: line, function: function }), None => None }
    }
}

// Whether a location is of the target, its function as said.
fn matches(target: &Target, frame: &Frame, function: &Option<String>) -> Bool {
    let file = frame.file.as_str();
    let line = frame.line;
    match(target) {
        Target::Function(name) => match(function) { Some(f) => last_segment(f.as_str()) == name.as_str(), None => false },
        Target::Lines(of, first, last) =>
            let same = file.ends_with(of.as_str()) or { of.as_str().ends_with(file) };
            let end = if(*last < 0) { *first } else { *last };
            same and { line >= *first } and { line <= end }
    }
}

fn is_hex(word: &str) -> Bool {
    let mut it = word.chars();
    let mut hex = true;
    let mut more = true;
    while({ more }) {
        match(it.next()) {
            Some(c) => if(std::char::is_digit(c) or { c >= 'a' and { c <= 'f' } } or { c >= 'A' and { c <= 'F' } }) { () } else { hex = false },
            None => more = false
        }
    };
    hex
}
// An instruction with its addresses and offsets left out.
fn normalize(instruction: &str) -> String {
    let ws = instruction.split_whitespace();
    let mut out = Vec::new();
    let mut i = 0;
    let mut going = true;
    while({ going and { i < ws.len() } }) {
        let word = ws[i];
        let hex = if(word.ends_with(",")) { word.slice(0, word.len() - 1) } else { word };
        let next_symbol = i + 1 < ws.len() and { ws[i + 1].starts_with("<") };
        if(hex.len() >= 4 and { is_hex(hex) } and { next_symbol }) {
            Vec::push(&mut out, String::from("<addr>"));
            let pieces = ws[i + 1].split("+");
            let bare = pieces[0];
            let bare = if(bare.ends_with(">")) { bare.slice(0, bare.len() - 1) } else { bare };
            Vec::push(&mut out, String::from(bare) + ">");
            i = i + 2
        } else if(word.starts_with("#")) { going = false }
        else {
            match(word.find("(%rip)")) {
                Some(at) => Vec::push(&mut out, String::from("<rip>") + word.slice(at + 6, word.len())),
                None => Vec::push(&mut out, String::from(word))
            };
            i = i + 1
        }
    };
    join(out, " ")
}

// The instructions of `target` in what objdump wrote, line by line; and
// whether it had line tables at all. Each location block (the innermost
// line, then the `inlined by` callers) is of the instructions after it; an
// instruction is the target's where any frame of its chain is.
pub fn scan(lines: Vec<&str>, target: Target) -> (Code, Bool) {
    let mut instructions = Vec::new();
    let mut symbols: Vec<String> = Vec::new();
    let mut symbol = String::new();
    let mut function: Option<String> = None;
    let mut matched = false;
    let mut saw_lines = false;
    let mut i = 0;
    while({ i < len_at(&lines) }) {
        let line = lines[i];
        let white = line.starts_with(" ") or { line.starts_with("\t") };
        if(line.starts_with("<") and { line.ends_with(">:") }) {
            symbol = String::from(line.slice(1, line.len() - 2));
            matched = false
        } else if(line.starts_with("inlined by ")) {
            match(parse_frame(line.slice(11, line.len()))) { Some(frame) => if(matches(&target, &frame, &frame.function)) { matched = true } else { () }, None => () }
        } else if(line.starts_with("/") or { line.starts_with("./") }) {
            match(parse_frame(line)) {
                Some(frame) => saw_lines = true; matched = matches(&target, &frame, &function),
                None => ()
            }
        } else if(line.ends_with(":") and { not(white) } and { line != ":" }) {
            let name = line.slice(0, line.len() - 1);
            function = Some(String::from(if(name.ends_with("()")) { name.slice(0, name.len() - 2) } else { name }))
        } else if(white and { matched }) {
            let instruction = line.trim();
            if(instruction.is_empty()) { () } else {
                Vec::push(&mut instructions, normalize(instruction));
                let mut known = false;
                let mut k = 0;
                while({ k < len_at(&symbols) }) { if(symbols[k].as_str() == symbol.as_str()) { known = true } else { () }; k = k + 1 };
                if(known) { () } else { Vec::push(&mut symbols, symbol.clone()) }
            }
        } else { () };
        i = i + 1
    };
    symbols.sort();
    (Code { instructions: instructions, symbols: symbols }, saw_lines)
}

// How many of the instructions pass a test.
fn count_of<'a>(code: &'a Code, test: fn(&'a str) -> Bool) -> Int {
    let mut n = 0;
    let mut k = 0;
    while({ k < code.instructions.len() }) { if(test(code.instructions[k].as_str())) { n = n + 1 } else { () }; k = k + 1 };
    n
}
// Counts that say most about the code.
pub fn stats(code: &Code) -> String {
    let vector = count_of(code, fn(i: &str) -> Bool { i.contains("%ymm") or { i.contains("%zmm") } or { i.contains("%xmm") and { i.contains("p") } } });
    let mut shortened = Vec::new();
    let mut k = 0;
    while({ k < code.symbols.len() }) { Vec::push(&mut shortened, short_type(code.symbols[k].as_str())); k = k + 1 };
    code.instructions.len().to_string() + " instructions (" + vector.to_string().as_str() + " vector, "
        + count_of(code, fn(i: &str) -> Bool { i.starts_with("call") }).to_string().as_str() + " calls, "
        + count_of(code, fn(i: &str) -> Bool { i.starts_with("j") }).to_string().as_str() + " branches) in "
        + join(shortened, ", ").as_str()
}
