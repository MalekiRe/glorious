// Upstream's tests/relations.rs, of joins inside systems, of fragmenting
// relations (kept as pairs: `Fragmenting`):
// - `fragmenting_joins_run_in_systems_and_infer_joined_components`: a
//   system writes the target's `Fuel` through `To<InSquad, &mut Fuel>`,
//   another each source's through `From<InSquad, &mut Fuel>`; the two run
//   one after the other. Then one target per row and the sources gathered,
//   and the targets and sources of a many-to-many relation.
//   `To<Tagged, &Name>` of a many-to-many relation is a list, of each
//   target. (`Fuel` is registered here: a world has what it is said to
//   have, not what its systems' joins name.)
// - `fragmenting_joins_read_targets_and_subtrees_inside_systems`: a query
//   of those `Related<InSquad>`, and one through nested joins,
//   `From<InSquad, From<InSquad, Entity>>`, counting two levels below.
// expect:
// 3 3
// 1000 1000 1000
// 1 10 []
// 2 10 []
// 3 11 []
// 10 -1 [1, 2]
// 11 -1 [3]
// 1 [10, 11] []
// 2 [11] []
// 3 [] []
// 10 [] [1]
// 11 [] [1, 2]
// --
// [(1, 0), (2, 1)]
// 2
// 0
mod ecs;

use ecs::{App, World, Entity, Query, Single, Relation, OneToMany, ManyToMany, Relates, Related, To, From, to};
use std::vec::sort;

struct Update
struct Name(Int)
struct Fuel(Int)
struct InSquad
impl Relation for InSquad { type Kind = OneToMany; }
impl ecs::Fragmenting for InSquad {}
impl Eq for InSquad { fn ==(a: InSquad, b: InSquad) -> Bool { true } }
impl Clone for InSquad { fn clone(a: &InSquad) -> InSquad { InSquad } }
struct Tagged
impl Relation for Tagged { type Kind = ManyToMany; }
impl ecs::Fragmenting for Tagged {}
impl Use<[0, *]> for Tagged {}
struct Log([(Int, Int)], Int)

fn fill_squads(members: &mut Query<(&Name, To<InSquad, (&mut Fuel,)>)>) {
    members.for_each() { name, squad => match(squad) { Some((mut fuel,)) => fuel.0 = fuel.0 + name.0;, None => () }; }
}
fn fill_members(squads: &mut Query<(From<InSquad, &mut Fuel>,), (ecs::With<Name>,)>) {
    squads.for_each() { (members,) =>
        let mut members = members;
        while({ match(pop_at(&mut members)) { Some(mut fuel) => fuel.0 = fuel.0 + 1000; true, None => false } }) { () };
    }
}

fn lines(all: [(Int, Str)]) -> [Str] {
    let mut keys = [];
    let mut i = 0;
    while({ i < len_at(&all) }) { keys = push(keys, all[i].0); i = i + 1 };
    let keys = std::vec::Vec::into_array(sort(keys));
    let mut out = [];
    let mut k = 0;
    while({ k < len_at(&keys) }) {
        let mut j = 0;
        while({ j < len_at(&all) }) { if(all[j].0 == keys[k]) { out = push(out, show(keys[k]) ++ " " ++ all[j].1) } else { () }; j = j + 1 };
        k = k + 1
    };
    out
}
fn say_all(xs: [Str]) { let mut i = 0; while({ i < len_at(&xs) }) { say(xs[i]); i = i + 1 } }
fn fuel<S>(world: &World<S>, e: Entity) -> Int where S: ecs::Get<Fuel> { match(world.get<Fuel>(e)) { Some(f) => f.0, None => 0 - 1 } }

fn watch(members: &mut Query<(&Name, To<InSquad, (&Name,)>), (Related<InSquad>,)>, trees: &mut Query<(&Name, From<InSquad, From<InSquad, Entity>>)>, log: &mut Single<(&mut Log,), ()>) {
    let mut seen = [];
    members.for_each() { name, squad => seen = push(seen, (name.0, match(squad) { Some((s,)) => s.0, None => 0 - 1 })); };
    let mut below = 0;
    trees.for_each() { name, children =>
        if(name.0 == 0) {
            let mut i = 0;
            while({ i < len_at(&children) }) { below = below + 1 + len_at(&children[i]); i = i + 1 }
        } else { () };
    };
    match(log.get_mut()) { Some((mut l,)) => l.0 = seen; l.1 = below;, None => () }
}

fn main() -> Int {
    let mut app = App::new().relation<InSquad>().relation<Tagged>().register<Name>().register<Fuel>()
        .add_systems(Update, fill_squads).add_systems(Update, fill_members).build();
    let alpha = app.world.spawn_bundle((Name(10), Fuel(0)));
    let beta = app.world.spawn_bundle((Name(11), Fuel(0)));
    let m1 = app.world.spawn_bundle((Name(1), Fuel(0), InSquad.to(alpha)));
    let m2 = app.world.spawn_bundle((Name(2), Fuel(0), InSquad.to(alpha)));
    let m3 = app.world.spawn_bundle((Name(3), Fuel(0), InSquad.to(alpha)));
    discard(app.world.insert(m3, InSquad.to(beta)));
    discard(app.world.relate(m1, Tagged, alpha));
    discard(app.world.relate(m1, Tagged, beta));
    discard(app.world.relate(m2, Tagged, beta));
    app.emit(&Update);
    say(show(fuel(&app.world, alpha)) ++ " " ++ show(fuel(&app.world, beta)));
    say(show(fuel(&app.world, m1)) ++ " " ++ show(fuel(&app.world, m2)) ++ " " ++ show(fuel(&app.world, m3)));

    let mut rows = [];
    app.world.query<(&Name, To<InSquad, (&Name,)>, From<InSquad, &Name>)>().for_each() { n, to, from =>
        let t = match(to) { Some((t,)) => t.0, None => 0 - 1 };
        let mut fs = [];
        let mut i = 0;
        while({ i < len_at(&from) }) { fs = push(fs, from[i].0); i = i + 1 };
        rows = push(rows, (n.0, show(t) ++ " " ++ show(sort(fs))));
    };
    say_all(lines(rows));
    let mut tags = [];
    app.world.query<(&Name, To<Tagged, &Name>, From<Tagged, &Name>)>().for_each() { n, to, from =>
        let mut ts = [];
        let mut i = 0;
        while({ i < len_at(&to) }) { ts = push(ts, to[i].0); i = i + 1 };
        let mut fs = [];
        let mut k = 0;
        while({ k < len_at(&from) }) { fs = push(fs, from[k].0); k = k + 1 };
        tags = push(tags, (n.0, show(sort(ts)) ++ " " ++ show(sort(fs))));
    };
    say_all(lines(tags));
    say("--");

    let mut app = App::new().relation<InSquad>().register<Name>().register<Log>().add_systems(Update, watch).build();
    let top = app.world.spawn_bundle((Name(0),));
    let mid = app.world.spawn_bundle((Name(1),));
    let leaf = app.world.spawn_bundle((Name(2),));
    discard(app.world.relate(mid, InSquad, top));
    discard(app.world.relate(leaf, InSquad, mid));
    let log = app.world.spawn_bundle((Log([], 0),));
    app.emit(&Update);
    match(app.world.get<Log>(log)) {
        Some(l) =>
            let mut firsts = [];
            let mut i = 0;
            while({ i < len_at(&l.0) }) { firsts = push(firsts, l.0[i].0 * 100 + l.0[i].1); i = i + 1 };
            let sorted = std::vec::Vec::into_array(sort(firsts));
            let mut shown = [];
            let mut k = 0;
            while({ k < len_at(&sorted) }) { shown = push(shown, "(" ++ show(sorted[k] / 100) ++ ", " ++ show(sorted[k] % 100) ++ ")"); k = k + 1 };
            say("[" ++ std::text::join(shown, ", ") ++ "]");
            say(l.1),
        None => ()
    };
    0
}
