// Covey: an entity component system in which the whole app is one type.
//
// A system is a plain function, and its parameters say what it touches:
//
//     fn integrate(positions: &mut Column<Position>, velocities: &Column<Velocity>) { .. }
//     fn wound(hit: &Hit, healths: &mut Column<Health>) { .. }
//     fn reap(healths: &Column<Health>, commands: &mut Commands<S>, ended: &mut Ended) { .. }
//
// A reference to a column is to a component's values; to the type a label
// carries, to the value emitted; to `Commands`, to what is asked to be done
// afterwards; and to any other type, to the world's one value of it, a
// resource. An app is built by saying what there is and what runs when:
//
//     app().register<Position>().register<Velocity>().insert_resource(Ended(0))
//          .add_systems(Update, (integrate, friction.run_if(moving), bound).chain())
//          .on<Hit>((wound, reap).chain())
//          .add_plugins(physics)
//
// The world's storage is a tuple of columns, one inside the next, and an
// app is that world with a list of the systems registered under each label.
// Both are types, so everything about a system is found when the program is
// compiled, by implementations that fit the types:
//
//   which column a parameter is          `Get`
//   which resource                       `Holds`
//   what each parameter asks for         `Parameter`, then `Fetch` for the list
//   that no component is asked for twice `AllApart`
//   which systems a label runs           `Dispatch`
//   a tuple of components given at once  `Bundle`, for tuples of any length
//   whether a condition holds            `Condition`, a function asking as a system does
//
// A system that asks for a component that was not registered, or a
// resource that was not inserted, or for either twice, does not compile. When
// the program runs, each of those calls is a call of a known function.

use std::tuple::{Tuple, nest};
use core::option::{as_ref, as_mut, is_none, is_some};
use core::value::{Default, default, discard};
use core::iter::{into_iter, next};

// An entity: a place in the columns, and which of the entities that have had
// that place this one is.
pub struct Entity { pub index: Int, pub generation: Int }
impl Clone for Entity { fn clone(e: &Entity) -> Entity { *e } }
impl Entity {
    // An entity no world has, to start with where one is needed.
    pub const PLACEHOLDER: Entity = Entity { index: -1, generation: -1 };
}

// One component's values: packed, each with the entity it belongs to, and
// for each entity's place where its value is among them. With each value,
// when it was put in and when it was last changed (`now`: the time a write
// through the column is now).
pub struct Column<T> { pub dense: [T], pub owners: [Entity], pub slots: [Int], added: [Int], changed: [Int], now: Int }

pub fn empty_column<T>() -> Column<T> { Column { dense: [], owners: [], slots: [], added: [], changed: [], now: 0 } }

// Where an entity's value is in a column, or -1.
pub fn slot_of<T>(column: &Column<T>, entity: Entity) -> Int {
    if(entity.index < 0) { -1 }
    else if(entity.index >= len_at(&column.slots)) { -1 }
    else {
        let at = column.slots[entity.index];
        if(at < 0) { -1 } else if(column.owners[at].generation == entity.generation) { at } else { -1 }
    }
}

// An entity's value in a column, kept: a system that has the column gives it.
pub fn give<T>(column: &mut Column<T>, entity: Entity, value: T) { column_insert(column, entity, value) }

fn column_insert<T>(column: &mut Column<T>, entity: Entity, value: T) {
    while({ len_at(&column.slots) <= entity.index }) { push_at(&mut column.slots, 0 - 1) };
    let at = column.slots[entity.index];
    if(at >= 0) {
        column.dense[at] = value;
        column.owners[at] = entity;
        column.changed[at] = column.now;
    } else {
        column.slots[entity.index] = len_at(&column.dense);
        push_at(&mut column.dense, value);
        push_at(&mut column.owners, entity);
        push_at(&mut column.added, column.now);
        push_at(&mut column.changed, column.now);
    }
}

// Take an entity's value out: the last value moves into its place.
fn column_remove<T>(column: &mut Column<T>, entity: Entity) -> Option<T> {
    let at = slot_of(&*column, entity);
    if(at < 0) { None } else {
        let last = len_at(&column.dense) - 1;
        let moved = column.owners[last];
        let _ = pop_at(&mut column.owners);
        match(pop_at(&mut column.added)) { Some(t) => if(at < last) { column.added[at] = t } else { () }, None => () };
        match(pop_at(&mut column.changed)) { Some(t) => if(at < last) { column.changed[at] = t } else { () }, None => () };
        match(pop_at(&mut column.dense)) {
            None => None,
            Some(final) =>
                column.slots[entity.index] = 0 - 1;
                if(at == last) { Some(final) } else {
                    column.owners[at] = moved;
                    column.slots[moved.index] = at;
                    Some(replace(&mut column.dense[at], final))
                }
        }
    }
}

// The column of `T` among a world's columns. Of the two implementations the
// first is for a tuple whose first column is `T`'s; the second looks further.
// A world that has no column of `T` has no implementation: a system that
// asks for one does not compile.
pub trait Get<T> {
    fn take(&mut Self) -> Column<T>
    fn put(&mut Self, Column<T>)
    fn has(&Self, Entity) -> Bool
    fn column(&Self) -> &Column<T>
    fn column_mut(&mut Self) -> &mut Column<T>
}
impl<T, R> Get<T> for (Column<T>, R) {
    fn take(columns: &mut (Column<T>, R)) -> Column<T> { replace(&mut columns.0, empty_column()) }
    fn put(columns: &mut (Column<T>, R), column: Column<T>) { columns.0 = column; }
    fn has(columns: &(Column<T>, R), entity: Entity) -> Bool { slot_of(&columns.0, entity) >= 0 }
    fn column(columns: &(Column<T>, R)) -> &Column<T> { &columns.0 }
    fn column_mut(columns: &mut (Column<T>, R)) -> &mut Column<T> { &mut columns.0 }
}
impl<T, H, R> Get<T> for (Column<H>, R) where R: Get<T> {
    fn take(columns: &mut (Column<H>, R)) -> Column<T> { <R as Get<T>>::take(&mut columns.1) }
    fn put(columns: &mut (Column<H>, R), column: Column<T>) { <R as Get<T>>::put(&mut columns.1, column) }
    fn has(columns: &(Column<H>, R), entity: Entity) -> Bool { <R as Get<T>>::has(&columns.1, entity) }
    fn column(columns: &(Column<H>, R)) -> &Column<T> { <R as Get<T>>::column(&columns.1) }
    fn column_mut(columns: &mut (Column<H>, R)) -> &mut Column<T> { <R as Get<T>>::column_mut(&mut columns.1) }
}
impl<T, H, R> Get<T> for (Resource<H>, R) where R: Get<T> {
    fn take(columns: &mut (Resource<H>, R)) -> Column<T> { <R as Get<T>>::take(&mut columns.1) }
    fn put(columns: &mut (Resource<H>, R), column: Column<T>) { <R as Get<T>>::put(&mut columns.1, column) }
    fn has(columns: &(Resource<H>, R), entity: Entity) -> Bool { <R as Get<T>>::has(&columns.1, entity) }
    fn column(columns: &(Resource<H>, R)) -> &Column<T> { <R as Get<T>>::column(&columns.1) }
    fn column_mut(columns: &mut (Resource<H>, R)) -> &mut Column<T> { <R as Get<T>>::column_mut(&mut columns.1) }
}

// A column taken out of the world, its writes of the world's time now.
fn take_at<T, S>(world: &mut World<S>) -> Column<T> where S: Get<T> {
    let mut column = <S as Get<T>>::take(&mut world.columns);
    column.now = world.tick;
    column
}

// One value the whole world has, kept among its columns: a score, a clock.
// While a system has it, it is out of its place.
pub struct Resource<T> { value: Option<T> }

// What a system names a resource by: `score: Res<Score>`, `speed: ResMut<Speed>`.
// A system that takes one runs only while the world has it; one that takes
// `Option<Res<T>>` runs either way.
pub type Res<'a, T> = &'a T;
pub type ResMut<'a, T> = &'a mut T;

// The resource of type `T` among a world's columns, found as a column is.
pub trait Holds<T> {
    fn slot(&Self) -> &Option<T>
    fn slot_mut(&mut Self) -> &mut Option<T>
}
impl<T, R> Holds<T> for (Resource<T>, R) {
    fn slot(columns: &(Resource<T>, R)) -> &Option<T> { &columns.0.value }
    fn slot_mut(columns: &mut (Resource<T>, R)) -> &mut Option<T> { &mut columns.0.value }
}
impl<T, H, R> Holds<T> for (Resource<H>, R) where R: Holds<T> {
    fn slot(columns: &(Resource<H>, R)) -> &Option<T> { <R as Holds<T>>::slot(&columns.1) }
    fn slot_mut(columns: &mut (Resource<H>, R)) -> &mut Option<T> { <R as Holds<T>>::slot_mut(&mut columns.1) }
}
impl<T, H, R> Holds<T> for (Column<H>, R) where R: Holds<T> {
    fn slot(columns: &(Column<H>, R)) -> &Option<T> { <R as Holds<T>>::slot(&columns.1) }
    fn slot_mut(columns: &mut (Column<H>, R)) -> &mut Option<T> { <R as Holds<T>>::slot_mut(&mut columns.1) }
}
// The resource taken out of its place, and put back.
fn lift<T, S>(columns: &mut S) -> Option<T> where S: Holds<T> { replace(<S as Holds<T>>::slot_mut(columns), None) }
fn lower<T, S>(columns: &mut S, value: T) where S: Holds<T> { *<S as Holds<T>>::slot_mut(columns) = Some(value); }

// What is done to every column of a world when an entity ends.
pub trait Columns {
    fn forget(&mut Self, Entity)
    fn empty() -> Self
    fn copy_onto(&mut Self, Entity, Entity)
}
impl Columns for () {
    fn forget(columns: &mut (), entity: Entity) { () }
    fn empty() { () }
    fn copy_onto(columns: &mut (), from: Entity, to: Entity) { () }
}
impl<H, R> Columns for (Column<H>, R) where R: Columns, H: Cloner {
    fn forget(columns: &mut (Column<H>, R), entity: Entity) {
        let _ = column_remove(&mut columns.0, entity);
        <R as Columns>::forget(&mut columns.1, entity)
    }
    fn empty() -> (Column<H>, R) { (empty_column(), <R as Columns>::empty()) }
    // (A component of a type that says how it is copied, `impl Cloner for
    // Label`, copied; any other left out.)
    fn copy_onto(columns: &mut (Column<H>, R), from: Entity, to: Entity) {
        match(<H as Cloner>::CLONER) {
            Some(copy) =>
                let at = slot_of(&columns.0, from);
                if(at >= 0) {
                    let value = copy(&columns.0.dense[at]);
                    column_insert(&mut columns.0, to, value)
                } else { () },
            None => ()
        };
        <R as Columns>::copy_onto(&mut columns.1, from, to)
    }
}
impl<H, R> Columns for (Resource<H>, R) where R: Columns {
    fn forget(columns: &mut (Resource<H>, R), entity: Entity) { <R as Columns>::forget(&mut columns.1, entity) }
    fn empty() -> (Resource<H>, R) { (Resource { value: None }, <R as Columns>::empty()) }
    fn copy_onto(columns: &mut (Resource<H>, R), from: Entity, to: Entity) { <R as Columns>::copy_onto(&mut columns.1, from, to) }
}

// Components that are never written in place, upstream's `Immutable`:
// `impl Mutability for Level { type Writes = Immutable; }`. A query's `&mut
// Level`, `get_mut<Level>`, a `ResMut<Level>` and a system's `&mut
// Column<Level>` are then refused; a new value is inserted instead, so its
// hooks see every change. Any other component is `Mutable`.
pub struct Mutable
pub struct Immutable
pub trait Mutability { type Writes; }
impl<T> Mutability for T { type Writes = Mutable; }
pub trait InPlace {}
impl InPlace for Mutable {}
pub trait Writable {}
impl<T> Writable for T where <T as Mutability>::Writes: InPlace {}

// How a component is copied when its entity is: `impl Cloner for Label {
// const CLONER: Option<fn(&Label) -> Label> = Some(clone); }`, as upstream's
// `Clone` components are. Any other is not copied (relations' links are not:
// a copy is linked anew).
pub trait Cloner { const CLONER: Option<fn(&Self) -> Self>; }
impl<T> Cloner for T { const CLONER: Option<fn(&T) -> T> = None; }

// The columns, and which entities there are.
pub struct World<S> { pub columns: S, generations: [Int], free: [Int], tick: Int, since: Int }

pub fn spawn<S>(world: &mut World<S>) -> Entity {
    match(pop_at(&mut world.free)) {
        Some(index) => Entity { index: index, generation: world.generations[index] },
        None =>
            push_at(&mut world.generations, 0);
            Entity { index: len_at(&world.generations) - 1, generation: 0 }
    }
}

pub fn alive<S>(world: &World<S>, entity: Entity) -> Bool {
    if(entity.index < 0) { false }
    else if(entity.index < len_at(&world.generations)) { world.generations[entity.index] == entity.generation }
    else { false }
}

// End an entity: what relates to it, and its own links, are undone, and
// every column forgets it.
pub fn despawn<S>(world: &mut World<S>, entity: Entity) where S: Columns, S: Unlinks<S> {
    if(alive(&*world, entity)) {
        world.generations[entity.index] = entity.generation + 1;
        push_at(&mut world.free, entity.index);
        <S as Unlinks<S>>::unlink(&mut world.columns, entity);
        <S as Columns>::forget(&mut world.columns, entity)
    };
}

// Relations. A relation is a kind of link from one entity to another, a
// type of its own (`ChildOf`), whose value is what the link carries (a
// berth). An entity that relates to another has a `Relates<R>`: the value,
// and the entity it relates to, one at a time. That one has a `Sources<R>`:
// the entities that relate to it, in the order they came to.
pub struct Relates<R> { pub relation: R, pub target: Entity }

// A relation says how many entities each side relates to: `impl Relation
// for Piloting { type Kind = OneToOne; }`. One target for each entity that
// relates (`OneToMany`: a ship docks at one station, a station has many), or
// one each way (`OneToOne`: relating to a target another relates to undoes
// that one's link).
pub trait Relation { type Kind; }
pub struct OneToMany
pub struct OneToOne
// Any number each way (`Allied`): an entity that relates has `Links<R>`, a
// link for each target, in the order made.
pub struct ManyToMany
pub struct Links<R> { pub list: [Relates<R>] }

// The columns a relation is stored in, by its kind.
pub trait KindColumns<R, S> { type Out; fn columns(S) -> Self::Out; }
impl<R, S> KindColumns<R, S> for OneToMany {
    type Out = (Column<Relates<R>>, (Column<Sources<R>>, S));
    fn columns(columns: S) -> (Column<Relates<R>>, (Column<Sources<R>>, S)) { (empty_column(), (empty_column(), columns)) }
}
impl<R, S> KindColumns<R, S> for OneToOne {
    type Out = (Column<Relates<R>>, (Column<Sources<R>>, S));
    fn columns(columns: S) -> (Column<Relates<R>>, (Column<Sources<R>>, S)) { (empty_column(), (empty_column(), columns)) }
}
impl<R, S> KindColumns<R, S> for ManyToMany {
    type Out = (Column<Links<R>>, (Column<Sources<R>>, S));
    fn columns(columns: S) -> (Column<Links<R>>, (Column<Sources<R>>, S)) { (empty_column(), (empty_column(), columns)) }
}
pub trait RelationColumns<S> { type Out; fn relation_columns(S) -> Self::Out; }
impl<R, S> RelationColumns<S> for R where R: Relation, <R as Relation>::Kind: KindColumns<R, S> {
    type Out = <<R as Relation>::Kind as KindColumns<R, S>>::Out;
    fn relation_columns(columns: S) -> <<R as Relation>::Kind as KindColumns<R, S>>::Out { <<R as Relation>::Kind as KindColumns<R, S>>::columns(columns) }
}

// What a source's link to `target` carried, taken out of its links.
fn take_link<R>(links: &mut Links<R>, target: Entity) -> Option<R> {
    let mut kept = [];
    let mut found = None;
    let mut rest = into_iter(replace(&mut links.list, []));
    while({ match(next(&mut rest)) {
        Some(link) =>
            let same = if(link.target.index == target.index) { link.target.generation == target.generation } else { false };
            if(same) { let Relates { relation, target: _ } = link; discard(replace(&mut found, Some(relation))) } else { push_at(&mut kept, link) };
            true,
        None => false } }) { () };
    links.list = kept;
    found
}

// Relate `source` to `target` too, by a relation of any number each way: what
// a link of the two carried before, if there was one.
fn link<R, S>(world: &mut World<S>, source: Entity, relation: R, target: Entity) -> Option<R>
    where S: Get<Links<R>>, S: Get<Sources<R>>, R: Use<[0, *]> {
    let mut column = take_at<Links<R>, S>(world);
    let at = slot_of(&column, source);
    let before = if(at >= 0) {
        let had = take_link(&mut column.dense[at], target);
        push_at(&mut column.dense[at].list, Relates { relation: relation, target: target });
        column.changed[at] = column.now;
        had
    } else { column_insert(&mut column, source, Links { list: [Relates { relation: relation, target: target }] }); None };
    <S as Get<Links<R>>>::put(&mut world.columns, column);
    match(before) {
        Some(_) => (),
        None =>
            let mut sources = take_at<Sources<R>, S>(world);
            let at = slot_of(&sources, target);
            if(at >= 0) { push_at(&mut sources.dense[at].list, source); sources.changed[at] = sources.now }
            else { column_insert(&mut sources, target, Sources { list: [source] }) };
            <S as Get<Sources<R>>>::put(&mut world.columns, sources)
    };
    before
}

// Undo `source`'s link to `target` by a relation of any number each way.
pub fn unlink_from<R, S>(world: &mut World<S>, source: Entity, target: Entity) -> Option<R> where S: Get<Links<R>>, S: Get<Sources<R>> {
    let column = <S as Get<Links<R>>>::column_mut(&mut world.columns);
    let at = slot_of(&*column, source);
    let had = if(at >= 0) { take_link(&mut column.dense[at], target) } else { None };
    match(had) {
        Some(r) => drop_source<R, S>(&mut world.columns, target, source); Some(r),
        None => None
    }
}

// What an entity relates to by a relation of any number each way.
fn targets_in<R, S>(columns: &S, source: Entity) -> [Entity] where S: Get<Links<R>> {
    let links = <S as Get<Links<R>>>::column(columns);
    let at = slot_of(links, source);
    let mut out = [];
    if(at >= 0) {
        let list = &links.dense[at].list;
        let mut i = 0;
        while({ i < len_at(list) }) { push_at(&mut out, list[i].target); i = i + 1 }
    };
    out
}

// How an entity is related to another, by the relation's kind.
pub trait Relating<R, S> { fn relate_by(&mut World<S>, Entity, R, Entity) -> Option<R> }
impl<R, S> Relating<R, S> for OneToMany where S: Get<Relates<R>>, S: Get<Sources<R>> {
    fn relate_by(world: &mut World<S>, source: Entity, relation: R, target: Entity) -> Option<R> { relate<R, S>(world, source, relation, target) }
}
impl<R, S> Relating<R, S> for OneToOne where S: Get<Relates<R>>, S: Get<Sources<R>> {
    fn relate_by(world: &mut World<S>, source: Entity, relation: R, target: Entity) -> Option<R> {
        let others = sources_in<R, S>(&world.columns, target);
        let mut i = 0;
        while({ i < len_at(&others) }) {
            let other = others[i];
            let same = if(other.index == source.index) { other.generation == source.generation } else { false };
            if(same) { () } else { discard(unrelate<R, S>(world, other)) };
            i = i + 1
        };
        relate<R, S>(world, source, relation, target)
    }
}
impl<R, S> Relating<R, S> for ManyToMany where S: Get<Links<R>>, S: Get<Sources<R>>, R: Use<[0, *]> {
    fn relate_by(world: &mut World<S>, source: Entity, relation: R, target: Entity) -> Option<R> { link<R, S>(world, source, relation, target) }
}
// A relation related by its kind.
pub trait RelateBy<S> { fn relate_as(&mut World<S>, Entity, Self, Entity) -> Option<Self> }
impl<R, S> RelateBy<S> for R where R: Relation, <R as Relation>::Kind: Relating<R, S> {
    fn relate_as(world: &mut World<S>, source: Entity, relation: R, target: Entity) -> Option<R> { <<R as Relation>::Kind as Relating<R, S>>::relate_by(world, source, relation, target) }
}

// The relation of a child to its parent.
pub struct ChildOf
impl Relation for ChildOf { type Kind = OneToMany; }
impl Clone for ChildOf { fn clone(c: &ChildOf) -> ChildOf { ChildOf } }
pub struct Sources<R> { pub list: [Entity] }

fn copied(list: &[Entity]) -> [Entity] {
    let mut out = [];
    let mut i = 0;
    while({ i < len_at(list) }) { push_at(&mut out, list[i]); i = i + 1 };
    out
}

fn without(list: &[Entity], entity: Entity) -> [Entity] {
    let mut out = [];
    let mut i = 0;
    while({ i < len_at(list) }) {
        let same = if(list[i].index == entity.index) { list[i].generation == entity.generation } else { false };
        if(same) { () } else { push_at(&mut out, list[i]) };
        i = i + 1
    };
    out
}

// `source` no longer among what relates to `target`.
fn drop_source<R, S>(columns: &mut S, target: Entity, source: Entity) where S: Get<Sources<R>> {
    let column = <S as Get<Sources<R>>>::column_mut(columns);
    let at = slot_of(&*column, target);
    if(at >= 0) {
        let kept = without(&column.dense[at].list, source);
        column.dense[at].list = kept
    };
}

// Relate `source` to `target` by `relation`, in place of what it related
// to by `R` before: what that link carried, if there was one.
pub fn relate<R, S>(world: &mut World<S>, source: Entity, relation: R, target: Entity) -> Option<R>
    where S: Get<Relates<R>>, S: Get<Sources<R>> {
    let before = unrelate<R, S>(world, source);
    let _ = insert(world, source, Relates { relation: relation, target: target });
    let mut column = take_at<Sources<R>, S>(world);
    let at = slot_of(&column, target);
    if(at >= 0) { push_at(&mut column.dense[at].list, source); column.changed[at] = column.now }
    else { column_insert(&mut column, target, Sources { list: [source] }) };
    <S as Get<Sources<R>>>::put(&mut world.columns, column);
    before
}

// Undo `source`'s link by `R`: what it carried, if there was one.
pub fn unrelate<R, S>(world: &mut World<S>, source: Entity) -> Option<R> where S: Get<Relates<R>>, S: Get<Sources<R>> {
    match(remove<Relates<R>, S>(world, source)) {
        Some(link) =>
            let Relates { relation, target } = link;
            drop_source<R, S>(&mut world.columns, target, source);
            Some(relation),
        None => None
    }
}

// What an entity relates to by `R`, among the world's columns.
fn target_in<R, S>(columns: &S, source: Entity) -> Option<Entity> where S: Get<Relates<R>> {
    let links = <S as Get<Relates<R>>>::column(columns);
    let at = slot_of(links, source);
    if(at >= 0) { Some(links.dense[at].target) } else { None }
}

// What relates to an entity by `R`, among the world's columns.
fn sources_in<R, S>(columns: &S, target: Entity) -> [Entity] where S: Get<Sources<R>> {
    let sources = <S as Get<Sources<R>>>::column(columns);
    let at = slot_of(sources, target);
    if(at >= 0) { copied(&sources.dense[at].list) } else { [] }
}

// What despawning an entity undoes of the relations it is in: of each
// relation's `Relates`, its link to what it relates to; of each `Sources`,
// the links of what relates to it. Found by the world's columns, as a column
// is.
pub trait Unlinks<S> { fn unlink(&mut S, Entity) }
impl<S> Unlinks<S> for () { fn unlink(columns: &mut S, entity: Entity) { () } }
impl<H, R, S> Unlinks<S> for (Column<H>, R) where R: Unlinks<S> {
    fn unlink(columns: &mut S, entity: Entity) { <R as Unlinks<S>>::unlink(columns, entity) }
}
impl<H, R, S> Unlinks<S> for (Resource<H>, R) where R: Unlinks<S> {
    fn unlink(columns: &mut S, entity: Entity) { <R as Unlinks<S>>::unlink(columns, entity) }
}
impl<X, R, S> Unlinks<S> for (Column<Relates<X>>, R) where S: Get<Relates<X>>, S: Get<Sources<X>>, R: Unlinks<S> {
    fn unlink(columns: &mut S, entity: Entity) {
        match(target_in<X, S>(&*columns, entity)) {
            Some(target) => drop_source<X, S>(columns, target, entity),
            None => ()
        };
        <R as Unlinks<S>>::unlink(columns, entity)
    }
}
impl<X, R, S> Unlinks<S> for (Column<Links<X>>, R) where S: Get<Links<X>>, S: Get<Sources<X>>, R: Unlinks<S> {
    fn unlink(columns: &mut S, entity: Entity) {
        let list = targets_in<X, S>(&*columns, entity);
        let mut i = 0;
        while({ i < len_at(&list) }) { drop_source<X, S>(columns, list[i], entity); i = i + 1 };
        <R as Unlinks<S>>::unlink(columns, entity)
    }
}
impl<X, R, S> Unlinks<S> for (Column<Sources<X>>, R) where X: Relation, <X as Relation>::Kind: UnlinksSources<X, S>, S: Get<Sources<X>>, R: Unlinks<S> {
    fn unlink(columns: &mut S, entity: Entity) {
        let list = sources_in<X, S>(&*columns, entity);
        <<X as Relation>::Kind as UnlinksSources<X, S>>::unlink_sources(columns, list, entity);
        <R as Unlinks<S>>::unlink(columns, entity)
    }
}
// What relates to an entity that ends no longer does, by the relation's kind.
pub trait UnlinksSources<X, S> { fn unlink_sources(&mut S, [Entity], Entity) }
impl<X, S> UnlinksSources<X, S> for OneToMany where S: Get<Relates<X>> {
    fn unlink_sources(columns: &mut S, list: [Entity], entity: Entity) { forget_links<X, S>(columns, list) }
}
impl<X, S> UnlinksSources<X, S> for OneToOne where S: Get<Relates<X>> {
    fn unlink_sources(columns: &mut S, list: [Entity], entity: Entity) { forget_links<X, S>(columns, list) }
}
impl<X, S> UnlinksSources<X, S> for ManyToMany where S: Get<Links<X>> {
    fn unlink_sources(columns: &mut S, list: [Entity], entity: Entity) {
        let column = <S as Get<Links<X>>>::column_mut(columns);
        let mut i = 0;
        while({ i < len_at(&list) }) {
            let at = slot_of(&*column, list[i]);
            if(at >= 0) { discard(take_link(&mut column.dense[at], entity)) };
            i = i + 1
        }
    }
}
fn forget_links<X, S>(columns: &mut S, list: [Entity]) where S: Get<Relates<X>> {
    let mut i = 0;
    while({ i < len_at(&list) }) {
        discard(column_remove(<S as Get<Relates<X>>>::column_mut(columns), list[i]));
        i = i + 1
    }
}

// Copies of what relates to `from` by `R`, related to `to` by copies of
// their links, and of what relates to those, in order.
fn copy_children<R, S>(world: &mut World<S>, from: Entity, to: Entity)
    where S: Columns, S: Get<Sources<R>>, S: Get<Relates<R>>, R: Clone, R: RelateBy<S> {
    let children = sources_in<R, S>(&world.columns, from);
    let mut i = 0;
    while({ i < len_at(&children) }) {
        let child = children[i];
        let links = <S as Get<Relates<R>>>::column(&world.columns);
        let at = slot_of(links, child);
        let link = if(at >= 0) { Some(clone(&links.dense[at].relation)) } else { None };
        match(world.clone_entity(child)) {
            Some(copy) =>
                match(link) {
                    Some(relation) => discard(world.relate(copy, relation, to)),
                    None => ()
                };
                copy_children<R, S>(world, child, copy),
            None => discard(link)
        };
        i = i + 1
    }
}

// Take a component from an entity.
pub fn remove<T, S>(world: &mut World<S>, entity: Entity) -> Option<T> where S: Get<T> {
    let mut column = take_at<T, S>(world);
    let taken = column_remove(&mut column, entity);
    <S as Get<T>>::put(&mut world.columns, column);
    taken
}

// Give an entity a component, or another value of one it has.
pub fn insert<T, S>(world: &mut World<S>, entity: Entity, value: T) -> Option<T> where S: Get<T> {
    let mut column = take_at<T, S>(world);
    // (Another value of one it has is a change, and not an addition.)
    let at = slot_of(&column, entity);
    let had = if(at >= 0) {
        column.changed[at] = column.now;
        Some(replace(&mut column.dense[at], value))
    } else { column_insert(&mut column, entity, value); None };
    <S as Get<T>>::put(&mut world.columns, column);
    had
}

// Components that come with another: `impl Requires for Bird { type
// Required = (Pos, Vel); }`. Putting a `Bird` on an entity gives it each of
// those it does not have, at its type's start (`Default`), and what those
// require; given with it, or had already, they stay as they are. Any other
// component requires nothing. (The world stores each: register it.)
pub trait Requires { type Required; }
impl<T> Requires for T { type Required = (); }

// Each of a list of components the entity does not have, put on it at its
// start, and what it requires.
pub trait Brings<S> { fn bring(&mut World<S>, Entity) }
impl<S> Brings<S> for () { fn bring(world: &mut World<S>, entity: Entity) { () } }
impl<H: Default, ..R, S> Brings<S> for (H, ..R)
    where S: Get<H>, H: Requires, <H as Requires>::Required: Brings<S>, (..R): Brings<S> {
    fn bring(world: &mut World<S>, entity: Entity) {
        if(<S as Get<H>>::has(&world.columns, entity)) { () } else {
            let _ = insert(world, entity, default<H>());
            <<H as Requires>::Required as Brings<S>>::bring(world, entity)
        };
        <(..R) as Brings<S>>::bring(world, entity)
    }
}
// What one component requires, brought.
pub trait BringsOne<S> { fn bring_one(&mut World<S>, Entity) }
impl<T, S> BringsOne<S> for T where T: Requires, <T as Requires>::Required: Brings<S> {
    fn bring_one(world: &mut World<S>, entity: Entity) { <<T as Requires>::Required as Brings<S>>::bring(world, entity) }
}
// What each of a list of components requires, brought.
pub trait BringsFor<S> { fn bring_for(&mut World<S>, Entity) }
impl<S> BringsFor<S> for () { fn bring_for(world: &mut World<S>, entity: Entity) { () } }
impl<H, ..R, S> BringsFor<S> for (H, ..R)
    where H: Requires, <H as Requires>::Required: Brings<S>, (..R): BringsFor<S> {
    fn bring_for(world: &mut World<S>, entity: Entity) {
        <<H as Requires>::Required as Brings<S>>::bring(world, entity);
        <(..R) as BringsFor<S>>::bring_for(world, entity)
    }
}

// Components of which an entity has at most one of each group: `impl OneOf
// for Walking { type Groups = (Locomotion, Life); }`. Putting one on an
// entity takes from it each other that shares a group with it. Any other
// component is of none.
pub trait OneOf { type Groups; }
impl<T> OneOf for T { type Groups = (); }

// Whether two types are one.
pub trait Same<T> { fn same() -> Bool }
impl<T> Same<T> for T { fn same() -> Bool { true } }
impl<T, U> Same<T> for U { fn same() -> Bool { false } }

// Whether a list of groups has `G`; whether two lists share one.
pub trait HasGroup<G> { fn has_group() -> Bool }
impl<G> HasGroup<G> for () { fn has_group() -> Bool { false } }
impl<G, H, ..R> HasGroup<G> for (H, ..R) where H: Same<G>, (..R): HasGroup<G> {
    fn has_group() -> Bool { if(<H as Same<G>>::same()) { true } else { <(..R) as HasGroup<G>>::has_group() } }
}
pub trait Shares<L> { fn shares() -> Bool }
impl<L> Shares<L> for () { fn shares() -> Bool { false } }
impl<H, ..R, L> Shares<L> for (H, ..R) where L: HasGroup<H>, (..R): Shares<L> {
    fn shares() -> Bool { if(<L as HasGroup<H>>::has_group()) { true } else { <(..R) as Shares<L>>::shares() } }
}

// Of a world's columns, each other component that shares a group with `T`,
// taken from the entity.
pub trait Evicts<T> { fn evict(&mut Self, Entity) }
impl<T> Evicts<T> for () { fn evict(columns: &mut (), entity: Entity) { () } }
impl<T, H, R> Evicts<T> for (Column<H>, R)
    where H: OneOf, T: OneOf, <H as OneOf>::Groups: Shares<<T as OneOf>::Groups>, H: Same<T>, R: Evicts<T> {
    fn evict(columns: &mut (Column<H>, R), entity: Entity) {
        if(<H as Same<T>>::same()) { () }
        else if(<<H as OneOf>::Groups as Shares<<T as OneOf>::Groups>>::shares()) { discard(column_remove(&mut columns.0, entity)) }
        else { () };
        <R as Evicts<T>>::evict(&mut columns.1, entity)
    }
}
impl<T, H, R> Evicts<T> for (Resource<H>, R) where R: Evicts<T> {
    fn evict(columns: &mut (Resource<H>, R), entity: Entity) { <R as Evicts<T>>::evict(&mut columns.1, entity) }
}

// Components given together: a tuple of them, each put in its column, and
// then what they require. Put on an entity, what it had of them comes back;
// taken from one, what it had of them.
pub trait Bundle<S> {
    type Had;
    fn put_all(Self, &mut World<S>, Entity) -> Self::Had
    fn take_all(&mut World<S>, Entity) -> Self::Had
}
impl<..T, S> Bundle<S> for (..T) where ..S: Get<T>, ..T: EvictOne<S>, (..T): BringsFor<S> {
    type Had = (..Option<T>);
    fn put_all(bundle: (..T), world: &mut World<S>, entity: Entity) -> (..Option<T>) {
        let (..t) = bundle;
        let had = (..put_one(world, entity, t));
        <(..T) as BringsFor<S>>::bring_for(world, entity);
        had
    }
    fn take_all(world: &mut World<S>, entity: Entity) -> (..Option<T>) { (..remove<T, S>(world, entity)) }
}

// What putting a component on an entity takes from it: nothing, of one of
// no group, which is not looked for among the columns.
pub trait EvictsBy<T, S> { fn evict_by(&mut S, Entity) }
impl<T, S> EvictsBy<T, S> for () { fn evict_by(columns: &mut S, entity: Entity) { () } }
impl<T, G, ..R, S> EvictsBy<T, S> for (G, ..R) where S: Evicts<T> {
    fn evict_by(columns: &mut S, entity: Entity) { <S as Evicts<T>>::evict(columns, entity) }
}
pub trait EvictOne<S> { fn evict_one(&mut S, Entity) }
impl<T, S> EvictOne<S> for T where T: OneOf, <T as OneOf>::Groups: EvictsBy<T, S> {
    fn evict_one(columns: &mut S, entity: Entity) { <<T as OneOf>::Groups as EvictsBy<T, S>>::evict_by(columns, entity) }
}

// A component put on an entity, the others of its groups taken first.
fn put_one<T, S>(world: &mut World<S>, entity: Entity, value: T) -> Option<T> where S: Get<T>, T: EvictOne<S> {
    <T as EvictOne<S>>::evict_one(&mut world.columns, entity);
    insert(world, entity, value)
}

// A new entity with the components given.
pub fn spawn_with<B, S>(world: &mut World<S>, bundle: B) -> Entity where B: Bundle<S> {
    let entity = spawn(world);
    <B as Bundle<S>>::put_all(bundle, world, entity);
    entity
}

// How many entities have the component.
pub fn count<T, S>(world: &mut World<S>) -> Int where S: Get<T> {
    let column = take_at<T, S>(world);
    let n = len_at(&column.dense);
    <S as Get<T>>::put(&mut world.columns, column);
    n
}

impl<S> World<S> {
    // A new entity with the components given.
    pub fn spawn_bundle<B>(world: &mut Self, bundle: B) -> Entity where B: Bundle<S> { spawn_with(world, bundle) }

    // An empty world of the columns `S`.
    pub fn new() -> World<S> where S: Columns { World { columns: <S as Columns>::empty(), generations: [], free: [], tick: 1, since: 0 } }

    // Give an entity a component, or another value of one it has: the one
    // it had, if it had one.
    pub fn insert<T>(world: &mut Self, entity: Entity, value: T) -> Option<T> where S: Get<T>, T: EvictOne<S>, T: BringsOne<S>, T: Use<[0, *]> {
        if(alive(&*world, entity)) {
            let had = put_one(world, entity, value);
            <T as BringsOne<S>>::bring_one(world, entity);
            had
        } else { discard(value); None }
    }

    // Give an entity components; what it had of them.
    pub fn insert_bundle<B>(world: &mut Self, entity: Entity, bundle: B) -> Option<B::Had> where B: Bundle<S> {
        if(alive(&*world, entity)) { Some(<B as Bundle<S>>::put_all(bundle, world, entity)) } else { discard(bundle); None }
    }

    // Take components from an entity; what it had of them.
    pub fn remove_bundle<B>(world: &mut Self, entity: Entity) -> B::Had where B: Bundle<S> {
        <B as Bundle<S>>::take_all(world, entity)
    }

    // New entities, one for each bundle, in order.
    pub fn spawn_batch<B>(world: &mut Self, bundles: [B]) -> [Entity] where B: Bundle<S> {
        let mut made = [];
        let mut rest = into_iter(bundles);
        while({ match(next(&mut rest)) { Some(b) => push_at(&mut made, spawn_with(world, b)); true, None => false } }) { () };
        made
    }

    // Whether the entity is there.
    pub fn contains(world: &Self, entity: Entity) -> Bool { alive(world, entity) }

    // Take a component from an entity.
    pub fn remove<T>(world: &mut Self, entity: Entity) -> Option<T> where S: Get<T> { remove<T, S>(world, entity) }

    // Relate an entity to another by `R`, in place of what it related to by
    // `R` before: what that link carried. (`ChildOf` of a child to its
    // parent: `world.relate(child, ChildOf, parent)`.)
    pub fn relate<R>(world: &mut Self, source: Entity, relation: R, target: Entity) -> Option<R>
        where R: RelateBy<S> {
        if(if(alive(&*world, source)) { alive(&*world, target) } else { false }) { <R as RelateBy<S>>::relate_as(world, source, relation, target) }
        else { discard(relation); None }
    }
    // Undo an entity's link by `R`: what it carried.
    pub fn unrelate<R>(world: &mut Self, source: Entity) -> Option<R> where S: Get<Relates<R>>, S: Get<Sources<R>> {
        unrelate<R, S>(world, source)
    }
    // Undo an entity's link to a target by a relation of any number each way.
    pub fn unlink<R>(world: &mut Self, source: Entity, target: Entity) -> Option<R> where S: Get<Links<R>>, S: Get<Sources<R>> {
        unlink_from<R, S>(world, source, target)
    }
    // What an entity relates to by a relation of any number each way.
    pub fn targets<R>(world: &Self, source: Entity) -> [Entity] where S: Get<Links<R>> { targets_in<R, S>(&world.columns, source) }
    // What an entity relates to by `R`, if anything.
    pub fn target<R>(world: &Self, source: Entity) -> Option<Entity> where S: Get<Relates<R>> {
        target_in<R, S>(&world.columns, source)
    }
    // What relates to an entity by `R`, in the order they came to.
    pub fn sources<R>(world: &Self, target: Entity) -> [Entity] where S: Get<Sources<R>> {
        sources_in<R, S>(&world.columns, target)
    }

    // A new entity with a copy of each of an entity's components that says
    // how it is copied (`Cloner`), and nothing else; `None` if it has ended.
    pub fn clone_entity(world: &mut Self, entity: Entity) -> Option<Entity> where S: Columns {
        if(alive(&*world, entity)) {
            let copy = spawn(world);
            <S as Columns>::copy_onto(&mut world.columns, entity, copy);
            Some(copy)
        } else { None }
    }
    // A copy of an entity and of all that relates to it by `R`, one parent
    // each, and what relates to those: each copy linked to its parent's
    // copy by a copy of what the link carries, in the order they came to.
    // The root's copy is not linked; `None` if the root has ended.
    pub fn clone_subtree<R>(world: &mut Self, root: Entity) -> Option<Entity>
        where S: Columns, S: Get<Sources<R>>, S: Get<Relates<R>>, R: Clone, R: RelateBy<S> {
        match(world.clone_entity(root)) {
            Some(copy) => copy_children<R, S>(world, root, copy); Some(copy),
            None => None
        }
    }

    // End an entity and, first, everything that relates to it by `R`, and
    // what relates to those, as upstream's `LINKED` relations end with their
    // target (`ChildOf`: a scene and all under it).
    pub fn despawn_linked<R>(world: &mut Self, entity: Entity)
        where S: Columns, S: Unlinks<S>, S: Get<Sources<R>>, S: Get<Relates<R>> {
        let under = sources_in<R, S>(&world.columns, entity);
        let mut i = 0;
        while({ i < len_at(&under) }) { world.despawn_linked<R>(under[i]); i = i + 1 };
        despawn(world, entity)
    }

    // End an entity; whether it was there.
    pub fn despawn(world: &mut Self, entity: Entity) -> Bool where S: Columns, S: Unlinks<S> {
        let was = alive(&*world, entity);
        despawn(world, entity);
        was
    }

    // An entity's component.
    pub fn get<T>(world: &Self, entity: Entity) -> Option<&T> where S: Get<T> {
        let column = <S as Get<T>>::column(&world.columns);
        let at = slot_of(column, entity);
        if(at < 0) { None } else { Some(&column.dense[at]) }
    }

    // An entity's component, to change: a change once `get_mut` is asked of it.
    pub fn get_mut<T>(world: &mut Self, entity: Entity) -> Option<Mut<'_, T>> where S: Get<T>, T: Writable {
        let now = world.tick;
        let column = <S as Get<T>>::column_mut(&mut world.columns);
        column.now = now;
        let at = slot_of(&*column, entity);
        if(at < 0) { None } else { Some(mut_at(column, at)) }
    }

    // How many entities have the component.
    pub fn count<T>(world: &mut Self) -> Int where S: Get<T> { count<T, S>(world) }

    // Every entity there is.
    pub fn entities(world: &Self) -> [Entity] { entities(world) }

    // A query of the world: `world.query<(Entity, &Score)>()`. While it is
    // had, the world is borrowed by it; its columns go back when it is let go.
    pub fn query<Q>(world: &mut Self) -> WorldQuery<'_, Q, (), S> where Q: Fill<S>, S: Hidden<Q, ()> {
        world.query_filtered<Q, ()>()
    }
    pub fn query_filtered<Q, N>(world: &mut Self) -> WorldQuery<'_, Q, N, S> where Q: Fill<S>, N: Only<S>, S: Hidden<Q, N> {
        let query = query_of<Q, N, S>(world);
        WorldQuery {
            world: world,
            query: query,
            put_back: fn(world: &mut World<S>, store: <Q as Item>::Store) { <Q as Fill<S>>::unfill(&mut world.columns, store) },
            blank: fn() -> <Q as Item>::Store { <Q as Fill<S>>::hollow() }
        }
    }

    // The resource, if the world has it (none while a system has it).
    pub fn resource<T>(world: &Self) -> Option<&T> where S: Holds<T> { as_ref(<S as Holds<T>>::slot(&world.columns)) }
    pub fn resource_mut<T>(world: &mut Self) -> Option<&mut T> where S: Holds<T> {
        as_mut(<S as Holds<T>>::slot_mut(&mut world.columns))
    }

    // Give the world the resource; the one it had, if it had one.
    pub fn insert_resource<T>(world: &mut Self, value: T) -> Option<T> where S: Holds<T> {
        replace(<S as Holds<T>>::slot_mut(&mut world.columns), Some(value))
    }
    pub fn remove_resource<T>(world: &mut Self) -> Option<T> where S: Holds<T> {
        replace(<S as Holds<T>>::slot_mut(&mut world.columns), None)
    }

    // The resource at its type's start, if the world does not have one.
    pub fn init_resource<T: Default>(world: &mut Self) where S: Holds<T> {
        let slot = <S as Holds<T>>::slot_mut(&mut world.columns);
        if(is_none(as_ref(&*slot))) { *slot = Some(default()) };
    }
}

// Every value of a component, folded into one.
pub fn fold_all<T, S, R>(world: &mut World<S>, start: R, f: for<'a> fn(R, &'a T) -> R) -> R where S: Get<T>, R: Use<[0, *]> {
    let column = take_at<T, S>(world);
    let mut result = start;
    let mut i = 0;
    while({ i < len_at(&column.dense) }) {
        result = f(result, &column.dense[i]);
        i = i + 1
    };
    <S as Get<T>>::put(&mut world.columns, column);
    result
}

// Every entity with an `A`, its `A` to change.
pub fn each<A>(column: &mut Column<A>, f: for<'a> fn(Entity, &'a mut A)) {
    let mut i = 0;
    while({ i < len_at(&column.dense) }) {
        f(column.owners[i], &mut column.dense[i]);
        i = i + 1
    }
}

// Every entity with an `A` and a `B`: its `A` to change, its `B` to read.
pub fn each2<A, B>(first: &mut Column<A>, second: &Column<B>, f: for<'a, 'b> fn(Entity, &'a mut A, &'b B)) {
    let mut i = 0;
    while({ i < len_at(&first.dense) }) {
        let entity = first.owners[i];
        let at = slot_of(second, entity);
        if(at >= 0) { f(entity, &mut first.dense[i], &second.dense[at]) };
        i = i + 1
    }
}

// A query: several columns, an entity at a time. `Query<(&mut Position,
// &Velocity)>` changes positions and reads velocities, of each entity that
// has both: as many columns as are written, each `&mut` or `&`.
pub trait Item {
    type Store;
    type Got<'a>;
    fn item_at<'a>(&'a mut Store, Entity) -> Option<Got<'a>>
}
// A component that may be changed: what is read of it through `get` is not
// a change; what is had of it through `get_mut` is, at the time it is had.
pub struct Mut<'a, T> { value: &'a mut T, tick: &'a mut Int, now: Int }
impl<'a, T> Mut<'a, T> {
    pub fn get(m: &Self) -> &T { &*m.value }
    pub fn get_mut(m: &mut Self) -> &mut T { *m.tick = m.now; &mut *m.value }
}
// A field of the component is read and written as one of a `Mut` (`hull.0`);
// written or borrowed `&mut`, the component is marked changed.
impl<'a, T> Deref for Mut<'a, T> { type Target = T; fn deref(m: &Mut<'a, T>) -> &T { &*m.value } }
impl<'a, T> DerefMut for Mut<'a, T> { type Target = T; fn deref_mut(m: &mut Mut<'a, T>) -> &mut T { *m.tick = m.now; &mut *m.value } }
fn mut_at<'a, A>(column: &'a mut Column<A>, at: Int) -> Mut<'a, A> {
    Mut { value: &mut column.dense[at], tick: &mut column.changed[at], now: column.now }
}

impl<A> Item for &mut A {
    type Store = Column<A>;
    type Got<'a> = Mut<'a, A>;
    fn item_at<'a>(store: &'a mut Column<A>, entity: Entity) -> Option<Mut<'a, A>> {
        let at = slot_of(&*store, entity);
        if(at >= 0) { Some(mut_at(store, at)) } else { None }
    }
}
impl<A> Item for &A {
    type Store = Column<A>;
    type Got<'a> = &'a A;
    fn item_at<'a>(store: &'a mut Column<A>, entity: Entity) -> Option<&'a A> {
        let at = slot_of(&*store, entity);
        if(at >= 0) { Some(&store.dense[at]) } else { None }
    }
}
impl Item for () {
    type Store = ();
    type Got<'a> = ();
    fn item_at<'a>(store: &'a mut (), entity: Entity) -> Option<()> { Some(()) }
}
// The entity itself.
impl Item for Entity {
    type Store = ();
    type Got<'a> = Entity;
    fn item_at<'a>(store: &'a mut (), entity: Entity) -> Option<Entity> { Some(entity) }
}
// Whether the entity has an `A`: every entity is found, with it or not.
pub struct Has<A>(A)
impl<A> Item for Has<A> {
    type Store = Column<A>;
    type Got<'a> = Bool;
    fn item_at<'a>(store: &'a mut Column<A>, entity: Entity) -> Option<Bool> { Some(slot_of(&*store, entity) >= 0) }
}
// Its `A` if it has one: every entity is found, with it or not.
impl<A> Item for Option<&mut A> {
    type Store = Column<A>;
    type Got<'a> = Option<Mut<'a, A>>;
    fn item_at<'a>(store: &'a mut Column<A>, entity: Entity) -> Option<Option<Mut<'a, A>>> { Some(<&mut A as Item>::item_at(store, entity)) }
}
impl<A> Item for Option<&A> {
    type Store = Column<A>;
    type Got<'a> = Option<&'a A>;
    fn item_at<'a>(store: &'a mut Column<A>, entity: Entity) -> Option<Option<&'a A>> { Some(<&A as Item>::item_at(store, entity)) }
}
// Of what the entity relates to by `R`: `To<ChildOf, &Name>`, its parent's
// name. None where it relates to nothing by `R`, or that has not what `Q`
// asks.
pub struct To<R, Q>(R, Q)
impl<R, Q> Item for To<R, Q> where Q: Item {
    type Store = (Column<Relates<R>>, Q::Store);
    type Got<'a> = Option<Q::Got<'a>>;
    fn item_at<'a>(store: &'a mut (Column<Relates<R>>, Q::Store), entity: Entity) -> Option<Option<Q::Got<'a>>> {
        let at = slot_of(&store.0, entity);
        if(at < 0) { Some(None) } else {
            let target = store.0.dense[at].target;
            Some(<Q as Item>::item_at(&mut store.1, target))
        }
    }
}
// Of each entity that relates to it by `R`, in the order they came to:
// `From<DockedAt, &Hull>`, the hulls of the ships docked at a station. (Of
// a component to read, or the entities themselves.)
pub struct From<R, Q>(R, Q)
impl<R, A> Item for From<R, &A> {
    type Store = (Column<Sources<R>>, Column<A>);
    type Got<'a> = [&'a A];
    fn item_at<'a>(store: &'a mut (Column<Sources<R>>, Column<A>), entity: Entity) -> Option<[&'a A]> {
        let mut out = [];
        let at = slot_of(&store.0, entity);
        if(at >= 0) {
            let list = &store.0.dense[at].list;
            let column = &store.1;
            let mut i = 0;
            while({ i < len_at(list) }) {
                let there = slot_of(column, list[i]);
                if(there >= 0) { push_at(&mut out, &column.dense[there]) };
                i = i + 1
            }
        };
        Some(out)
    }
}
impl<R> Item for From<R, Entity> {
    type Store = Column<Sources<R>>;
    type Got<'a> = [Entity];
    fn item_at<'a>(store: &'a mut Column<Sources<R>>, entity: Entity) -> Option<[Entity]> {
        let at = slot_of(&*store, entity);
        Some(if(at >= 0) { copied(&store.dense[at].list) } else { [] })
    }
}
// (The columns as a pair of the first and the rest's, so that each is a
// field of its own to borrow.)
impl<H, ..R> Item for (H, ..R) where H: Item, (..R): Item {
    type Store = (H::Store, <(..R) as Item>::Store);
    type Got<'a> = (H::Got<'a>, ..R::Got<'a>);
    fn item_at<'a>(store: &'a mut (H::Store, <(..R) as Item>::Store), entity: Entity) -> Option<(H::Got<'a>, ..R::Got<'a>)> {
        match(<H as Item>::item_at(&mut store.0, entity)) {
            Some(h) => match(<(..R) as Item>::item_at(&mut store.1, entity)) {
                Some(rest) => let (..r) = rest; Some((h, ..r)),
                None => None
            },
            None => None
        }
    }
}

// The columns a query asks for, taken out of the world while it is used and
// put back after: each is found as a column is.
fn take_now<A, S>(columns: &mut S, now: Int) -> Column<A> where S: Get<A> {
    let mut column = <S as Get<A>>::take(columns);
    column.now = now;
    column
}

pub trait Fill<S>: Item {
    fn fill(&mut S, Int) -> Self::Store
    fn unfill(&mut S, Self::Store)
    // What stands in the query's place once its columns are back.
    fn hollow() -> Self::Store
}
impl<A, S> Fill<S> for &mut A where S: Get<A>, A: Writable {
    fn fill(columns: &mut S, now: Int) -> <&mut A as Item>::Store { take_now<A, S>(columns, now) }
    fn unfill(columns: &mut S, column: <&mut A as Item>::Store) { <S as Get<A>>::put(columns, column) }
    fn hollow() -> <&mut A as Item>::Store { empty_column() }
}
impl<A, S> Fill<S> for &A where S: Get<A> {
    fn fill(columns: &mut S, now: Int) -> <&A as Item>::Store { take_now<A, S>(columns, now) }
    fn unfill(columns: &mut S, column: <&A as Item>::Store) { <S as Get<A>>::put(columns, column) }
    fn hollow() -> <&A as Item>::Store { empty_column() }
}
impl<S> Fill<S> for () {
    fn fill(columns: &mut S, now: Int) -> <() as Item>::Store { () }
    fn unfill(columns: &mut S, store: <() as Item>::Store) { () }
    fn hollow() -> <() as Item>::Store { () }
}
impl<S> Fill<S> for Entity {
    fn fill(columns: &mut S, now: Int) -> <Entity as Item>::Store { () }
    fn unfill(columns: &mut S, store: <Entity as Item>::Store) { () }
    fn hollow() -> <Entity as Item>::Store { () }
}
impl<A, S> Fill<S> for Has<A> where S: Get<A> {
    fn fill(columns: &mut S, now: Int) -> <Has<A> as Item>::Store { take_now<A, S>(columns, now) }
    fn unfill(columns: &mut S, column: <Has<A> as Item>::Store) { <S as Get<A>>::put(columns, column) }
    fn hollow() -> <Has<A> as Item>::Store { empty_column() }
}
impl<A, S> Fill<S> for Option<&mut A> where S: Get<A>, A: Writable {
    fn fill(columns: &mut S, now: Int) -> <Option<&mut A> as Item>::Store { take_now<A, S>(columns, now) }
    fn unfill(columns: &mut S, column: <Option<&mut A> as Item>::Store) { <S as Get<A>>::put(columns, column) }
    fn hollow() -> <Option<&mut A> as Item>::Store { empty_column() }
}
impl<A, S> Fill<S> for Option<&A> where S: Get<A> {
    fn fill(columns: &mut S, now: Int) -> <Option<&A> as Item>::Store { take_now<A, S>(columns, now) }
    fn unfill(columns: &mut S, column: <Option<&A> as Item>::Store) { <S as Get<A>>::put(columns, column) }
    fn hollow() -> <Option<&A> as Item>::Store { empty_column() }
}
impl<R, Q, S> Fill<S> for To<R, Q> where S: Get<Relates<R>>, Q: Fill<S>, Q: Item {
    fn fill(columns: &mut S, now: Int) -> <To<R, Q> as Item>::Store { (take_now<Relates<R>, S>(columns, now), <Q as Fill<S>>::fill(columns, now)) }
    fn unfill(columns: &mut S, store: <To<R, Q> as Item>::Store) {
        let (links, rest) = store;
        <S as Get<Relates<R>>>::put(columns, links);
        <Q as Fill<S>>::unfill(columns, rest)
    }
    fn hollow() -> <To<R, Q> as Item>::Store { (empty_column(), <Q as Fill<S>>::hollow()) }
}
impl<R, A, S> Fill<S> for From<R, &A> where S: Get<Sources<R>>, S: Get<A> {
    fn fill(columns: &mut S, now: Int) -> <From<R, &A> as Item>::Store { (take_now<Sources<R>, S>(columns, now), take_now<A, S>(columns, now)) }
    fn unfill(columns: &mut S, store: <From<R, &A> as Item>::Store) {
        let (sources, column) = store;
        <S as Get<Sources<R>>>::put(columns, sources);
        <S as Get<A>>::put(columns, column)
    }
    fn hollow() -> <From<R, &A> as Item>::Store { (empty_column(), empty_column()) }
}
impl<R, S> Fill<S> for From<R, Entity> where S: Get<Sources<R>> {
    fn fill(columns: &mut S, now: Int) -> <From<R, Entity> as Item>::Store { take_now<Sources<R>, S>(columns, now) }
    fn unfill(columns: &mut S, store: <From<R, Entity> as Item>::Store) { <S as Get<Sources<R>>>::put(columns, store) }
    fn hollow() -> <From<R, Entity> as Item>::Store { empty_column() }
}
impl<H, ..R, S> Fill<S> for (H, ..R) where H: Fill<S>, (..R): Fill<S>, H: Item, (..R): Item, ..R: Item {
    fn fill(columns: &mut S, now: Int) -> <(H, ..R) as Item>::Store { (<H as Fill<S>>::fill(columns, now), <(..R) as Fill<S>>::fill(columns, now)) }
    fn unfill(columns: &mut S, store: <(H, ..R) as Item>::Store) {
        let (h, rest) = store;
        <H as Fill<S>>::unfill(columns, h);
        <(..R) as Fill<S>>::unfill(columns, rest)
    }
    fn hollow() -> <(H, ..R) as Item>::Store { (<H as Fill<S>>::hollow(), <(..R) as Fill<S>>::hollow()) }
}

pub struct Query<Q, Only = (), St = <Q as Item>::Store> { store: St, entities: [Entity] }

// Which entities a query is of, beyond having its columns: `With<T>` those
// that have a `T`, `Without<T>` those that do not, a tuple those all of it
// lets through.
pub struct With<T>(T)
pub struct Without<T>(T)
pub trait Only<S> { fn lets(&S, Entity, Int) -> Bool }
impl<S> Only<S> for () { fn lets(columns: &S, entity: Entity, since: Int) -> Bool { true } }
impl<T, S> Only<S> for With<T> where S: Get<T> { fn lets(columns: &S, entity: Entity, since: Int) -> Bool { <S as Get<T>>::has(columns, entity) } }
impl<T, S> Only<S> for Without<T> where S: Get<T> { fn lets(columns: &S, entity: Entity, since: Int) -> Bool { not(<S as Get<T>>::has(columns, entity)) } }
// Those whose `T` was put in, or changed, since the system last ran (since
// the world began, outside a system).
pub struct Added<T>(T)
pub struct Changed<T>(T)
impl<T, S> Only<S> for Added<T> where S: Get<T> {
    fn lets(columns: &S, entity: Entity, since: Int) -> Bool {
        let column = <S as Get<T>>::column(columns);
        let at = slot_of(column, entity);
        if(at < 0) { false } else { column.added[at] > since }
    }
}
impl<T, S> Only<S> for Changed<T> where S: Get<T> {
    fn lets(columns: &S, entity: Entity, since: Int) -> Bool {
        let column = <S as Get<T>>::column(columns);
        let at = slot_of(column, entity);
        if(at < 0) { false } else { column.changed[at] > since }
    }
}
impl<H, ..R, S> Only<S> for (H, ..R) where H: Only<S>, (..R): Only<S> {
    fn lets(columns: &S, entity: Entity, since: Int) -> Bool {
        if(<H as Only<S>>::lets(columns, entity, since)) { <(..R) as Only<S>>::lets(columns, entity, since) } else { false }
    }
}

// Entities that are disabled: those with a component whose type says it
// disables, `Disabled` or one of the program's (`impl Disabling for Prefab`).
// A query is not of them unless it mentions that component: asks for it,
// optionally or not, tests for it (`Has`), or filters by it (`With`,
// `Without`, `MayHave`). Asking a world for a component directly sees them.
// (Every type says whether it disables: none does, but those that say so,
// as `Disabled` does.)
pub struct Disabled
pub trait Disabling { const DISABLES: Bool; }
impl<T> Disabling for T { const DISABLES: Bool = false; }
impl Disabling for Disabled { const DISABLES: Bool = true; }
// Those any of the filters lets through: `Or<(With<A>, With<B>)>`.
pub struct Or<T>(T)
pub trait AnyOnly<S> { fn any_lets(&S, Entity, Int) -> Bool }
impl<S> AnyOnly<S> for () { fn any_lets(columns: &S, entity: Entity, since: Int) -> Bool { false } }
impl<H, ..R, S> AnyOnly<S> for (H, ..R) where H: Only<S>, (..R): AnyOnly<S> {
    fn any_lets(columns: &S, entity: Entity, since: Int) -> Bool {
        if(<H as Only<S>>::lets(columns, entity, since)) { true } else { <(..R) as AnyOnly<S>>::any_lets(columns, entity, since) }
    }
}
impl<T, S> Only<S> for Or<T> where T: AnyOnly<S> {
    fn lets(columns: &S, entity: Entity, since: Int) -> Bool { <T as AnyOnly<S>>::any_lets(columns, entity, since) }
}
// Every entity, with it or not: a filter that mentions `T` and lets all through.
pub struct MayHave<T>(T)
impl<T, S> Only<S> for MayHave<T> { fn lets(columns: &S, entity: Entity, since: Int) -> Bool { true } }
// Does what a query asks for, or its filter, mention `D`?
pub trait Mentions<D> { fn mentions() -> Bool }
impl<D> Mentions<D> for () { fn mentions() -> Bool { false } }
impl<D> Mentions<D> for Entity { fn mentions() -> Bool { false } }
impl<A, D> Mentions<D> for &mut A where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for &A where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for Option<&mut A> where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for Option<&A> where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for Has<A> where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for With<A> where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for Without<A> where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for MayHave<A> where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for Added<A> where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<A, D> Mentions<D> for Changed<A> where A: Same<D> { fn mentions() -> Bool { <A as Same<D>>::same() } }
impl<T, D> Mentions<D> for Or<T> where T: Mentions<D> { fn mentions() -> Bool { <T as Mentions<D>>::mentions() } }
impl<R, Q, D> Mentions<D> for To<R, Q> { fn mentions() -> Bool { false } }
impl<R, Q, D> Mentions<D> for From<R, Q> { fn mentions() -> Bool { false } }
impl<H, ..R, D> Mentions<D> for (H, ..R) where H: Mentions<D>, (..R): Mentions<D> {
    fn mentions() -> Bool { if(<H as Mentions<D>>::mentions()) { true } else { <(..R) as Mentions<D>>::mentions() } }
}
// Is an entity hidden from a query of `Q` with `N` by a component it has?
pub trait Hidden<Q, N> { fn hidden(&Self, Entity) -> Bool }
impl<Q, N> Hidden<Q, N> for () { fn hidden(columns: &(), entity: Entity) -> Bool { false } }
impl<T, R, Q, N> Hidden<Q, N> for (Column<T>, R) where T: Disabling, Q: Mentions<T>, N: Mentions<T>, R: Hidden<Q, N> {
    fn hidden(columns: &(Column<T>, R), entity: Entity) -> Bool {
        let here = if(<T as Disabling>::DISABLES) {
            if(<Q as Mentions<T>>::mentions()) { false }
            else if(<N as Mentions<T>>::mentions()) { false }
            else { slot_of(&columns.0, entity) >= 0 }
        } else { false };
        if(here) { true } else { <R as Hidden<Q, N>>::hidden(&columns.1, entity) }
    }
}
impl<T, R, Q, N> Hidden<Q, N> for (Resource<T>, R) where R: Hidden<Q, N> {
    fn hidden(columns: &(Resource<T>, R), entity: Entity) -> Bool { <R as Hidden<Q, N>>::hidden(&columns.1, entity) }
}

impl<Q, N, St> Query<Q, N, St> {
    // What the query asks for, of each entity that has it.
    pub fn for_each(query: &mut Self, f: for<'a> fn(Q::Got<'a>)) where Q: Item<Store = St> {
        let mut i = 0;
        while({ i < len_at(&query.entities) }) {
            match(<Q as Item>::item_at(&mut query.store, query.entities[i])) { Some(got) => f(got), None => () };
            i = i + 1
        }
    }

    // What it asks for of one entity, if the query is of it.
    pub fn get_mut(query: &mut Self, entity: Entity) -> Option<Q::Got<'_>> where Q: Item<Store = St> {
        if(has_entity(&query.entities, entity)) { <Q as Item>::item_at(&mut query.store, entity) } else { None }
    }

    // How many entities it is of.
    pub fn count(query: &mut Self) -> Int where Q: Item<Store = St> {
        let mut n = 0;
        let mut i = 0;
        while({ i < len_at(&query.entities) }) {
            if(is_some(<Q as Item>::item_at(&mut query.store, query.entities[i]))) { n = n + 1 };
            i = i + 1
        };
        n
    }
}

fn has_entity(entities: &[Entity], entity: Entity) -> Bool {
    let mut i = 0;
    let mut found = false;
    while({ i < len_at(entities) }) {
        if(entities[i].index == entity.index) { if(entities[i].generation == entity.generation) { found = true }; };
        i = i + 1
    };
    found
}

// A query of a world, that has the world borrowed while it is had. Its
// columns go back when it is let go, by what it was made with: a `Drop`
// knows only the value's type, so how they go back is kept in the value.
pub struct WorldQuery<'w, Q, N, S, St = <Q as Item>::Store> {
    world: &'w mut World<S>,
    query: Query<Q, N, St>,
    put_back: fn(&mut World<S>, St) -> (),
    blank: fn() -> St
}
impl<'w, Q, N, S, St> Drop for WorldQuery<'w, Q, N, S, St> {
    fn drop(q: &mut WorldQuery<'w, Q, N, S, St>) {
        let store = replace(&mut q.query.store, (q.blank)());
        (q.put_back)(q.world, store)
    }
}

impl<'w, Q, N, S, St> WorldQuery<'w, Q, N, S, St> {
    pub fn for_each(q: &mut Self, f: for<'a> fn(Q::Got<'a>)) where Q: Item<Store = St> { q.query.for_each(f) }
    pub fn get_mut(q: &mut Self, entity: Entity) -> Option<Q::Got<'_>> where Q: Item<Store = St> { q.query.get_mut(entity) }
    pub fn count(q: &mut Self) -> Int where Q: Item<Store = St> { q.query.count() }
}

// A query of exactly one entity: a system that takes one runs only while
// there is exactly one.
pub struct Single<Q, Only = (), St = <Q as Item>::Store> { query: Query<Q, Only, St> }
impl<Q, N, St> Single<Q, N, St> {
    // What it asks for of the one entity.
    pub fn get_mut(single: &mut Self) -> Option<Q::Got<'_>> where Q: Item<Store = St> {
        let entity = single.query.entities[0];
        <Q as Item>::item_at(&mut single.query.store, entity)
    }
    pub fn entity(single: &Self) -> Entity { single.query.entities[0] }
}

// The entities a world has, oldest place first.
pub fn entities<S>(world: &World<S>) -> [Entity] {
    let mut out = [];
    let mut i = 0;
    while({ i < len_at(&world.generations) }) {
        let mut free = false;
        let mut j = 0;
        while({ j < len_at(&world.free) }) { if(world.free[j] == i) { free = true }; j = j + 1 };
        if(not(free)) { push_at(&mut out, Entity { index: i, generation: world.generations[i] }) };
        i = i + 1
    };
    out
}

// What a system asks to be done to the world once the systems have run, in
// the order asked: a system has no hold on the world itself. Each is a
// callable given the world when the emit is done.
pub struct Commands<S> { queue: [fn(&mut World<S>) -> ()], next: Int, made: Int }

impl<S> Commands<S> {
    // Do something to the world once the systems have run.
    pub fn queue(commands: &mut Self, f: fn(&mut World<S>) -> ()) { push_at(&mut commands.queue, f) }

    // A new entity with the components given, there once the systems have run.
    pub fn spawn<B>(commands: &mut Self, bundle: B) -> Entity where B: Bundle<S> {
        let entity = reserve(commands);
        push_at(&mut commands.queue, fn(world: &mut World<S>) { let _ = <B as Bundle<S>>::put_all(bundle, world, entity); });
        entity
    }

    // Give an entity components, or other values of ones it has.
    pub fn insert<B>(commands: &mut Self, entity: Entity, bundle: B) where B: Bundle<S> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) {
            if(alive(&*world, entity)) { let _ = <B as Bundle<S>>::put_all(bundle, world, entity); } else { discard(bundle) }
        })
    }

    // Take a component from an entity.
    pub fn remove<T>(commands: &mut Self, entity: Entity) where S: Get<T> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { let _ = remove<T, S>(world, entity); })
    }

    // End an entity.
    pub fn insert_resource<T>(commands: &mut Self, value: T) where S: Holds<T> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { let _ = world.insert_resource(value); })
    }
    pub fn remove_resource<T>(commands: &mut Self) where S: Holds<T> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { let _ = world.remove_resource<T>(); })
    }
    pub fn despawn(commands: &mut Self, entity: Entity) where S: Columns, S: Unlinks<S> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { despawn(world, entity) })
    }
    // Relate an entity to another by `R`, once the systems have run.
    pub fn relate<R>(commands: &mut Self, source: Entity, relation: R, target: Entity) where R: RelateBy<S> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { discard(world.relate(source, relation, target)) })
    }
}

pub fn end<S>(commands: &mut Commands<S>, entity: Entity) where S: Columns, S: Unlinks<S> {
    push_at(&mut commands.queue, fn(world: &mut World<S>) { despawn(world, entity) })
}

// A new entity, there once the systems have run: give it components through
// the columns the system has.
pub fn reserve<S>(commands: &mut Commands<S>) -> Entity {
    let entity = Entity { index: commands.next + commands.made, generation: 0 };
    commands.made = commands.made + 1;
    entity
}

// What was asked, done in the order asked.
fn apply<S>(commands: Commands<S>, world: &mut World<S>) {
    let Commands { queue, next: _, made } = commands;
    let mut k = 0;
    while({ k < made }) { push_at(&mut world.generations, 0); k = k + 1 };
    let mut each = into_iter(queue);
    while({ match(next(&mut each)) { Some(f) => f(world); true, None => false } }) { () }
}

// What a parameter of a system asks for, without the reference: a column
// to change, a column to read, the value emitted, or the commands. Found
// from the parameter's type, so a system is written as any function is.
pub struct Writes<A>(A)
pub struct Read<A>(A)
pub struct Asking
pub struct Querying<Q, Only, St>(Q, Only, St)
pub struct Singling<Q, Only, St>(Q, Only, St)
pub struct Shared<X>(X)
pub struct Owned<X>(X)
pub struct Maybe<X>(X)
pub struct MaybeOwned<X>(X)
pub trait Parameter { type Asks; }
impl<A> Parameter for &mut Column<A> { type Asks = Writes<A>; }
impl<A> Parameter for &Column<A> { type Asks = Read<A>; }
impl<S> Parameter for &mut Commands<S> { type Asks = Asking; }
impl<Q, Only, St> Parameter for &mut Query<Q, Only, St> { type Asks = Querying<Q, Only, St>; }
impl<Q, Only, St> Parameter for &mut Single<Q, Only, St> { type Asks = Singling<Q, Only, St>; }
// (Any other reference is to a resource, or for reading to the value
// emitted, which is told apart where the label is known: the narrower ones
// above are chosen first.)
impl<X> Parameter for &mut X { type Asks = Owned<X>; }
impl<X> Parameter for &X { type Asks = Shared<X>; }
impl<X> Parameter for Option<&mut X> { type Asks = MaybeOwned<X>; }
impl<X> Parameter for Option<&X> { type Asks = Maybe<X>; }

// A system takes a component once. Two of what it asks for are apart unless
// they are one column, which is only if the component has a trait nothing
// has: so such a system does not compile, and the message names the
// component.
pub trait ASystemTakesAComponentOnce {}
pub trait Apart {}
impl<X, Y> Apart for (X, Y) {}
impl<A> Apart for (Writes<A>, Writes<A>) where A: ASystemTakesAComponentOnce {}
impl<A> Apart for (Writes<A>, Read<A>) where A: ASystemTakesAComponentOnce {}
impl<A> Apart for (Read<A>, Writes<A>) where A: ASystemTakesAComponentOnce {}
impl<A> Apart for (Read<A>, Read<A>) where A: ASystemTakesAComponentOnce {}
impl<X> Apart for (Owned<X>, Owned<X>) where X: ASystemTakesAComponentOnce {}
impl<X> Apart for (Owned<X>, Shared<X>) where X: ASystemTakesAComponentOnce {}
impl<X> Apart for (Shared<X>, Owned<X>) where X: ASystemTakesAComponentOnce {}
// One thing asked for, apart from each of a list; and a list each of whose
// members is apart from those after it.
pub trait ApartFrom<X> {}
impl<X> ApartFrom<X> for () {}
impl<X, First, Rest> ApartFrom<X> for (First, Rest) where (X, First): Apart, Rest: ApartFrom<X> {}
pub trait AllApart {}
impl AllApart for () {}
impl<First, Rest> AllApart for (First, Rest) where Rest: ApartFrom<First>, Rest: AllApart {}

// What a system's parameters touch, each a list: a query touches each
// component its items read or write, so two of them, or one and a column,
// are seen apart as any two parameters are.
pub trait Concat<B> { type Out; }
impl<B> Concat<B> for () { type Out = B; }
impl<H, T, B> Concat<B> for (H, T) where T: Concat<B> { type Out = (H, <T as Concat<B>>::Out); }
pub trait ItemTouches { type List; }
impl<A> ItemTouches for &mut A { type List = (Writes<A>, ()); }
impl<A> ItemTouches for &A { type List = (Read<A>, ()); }
impl<A> ItemTouches for Option<&mut A> { type List = (Writes<A>, ()); }
impl<A> ItemTouches for Option<&A> { type List = (Read<A>, ()); }
impl<A> ItemTouches for Has<A> { type List = (Read<A>, ()); }
impl ItemTouches for Entity { type List = (); }
impl<R, Q> ItemTouches for To<R, Q> where Q: ItemTouches { type List = (Read<Relates<R>>, <Q as ItemTouches>::List); }
impl<R, A> ItemTouches for From<R, &A> { type List = (Read<Sources<R>>, (Read<A>, ())); }
impl<R> ItemTouches for From<R, Entity> { type List = (Read<Sources<R>>, ()); }
impl ItemTouches for () { type List = (); }
impl<H, ..R> ItemTouches for (H, ..R) where H: ItemTouches, (..R): ItemTouches,
    <H as ItemTouches>::List: Concat<<(..R) as ItemTouches>::List> {
    type List = <<H as ItemTouches>::List as Concat<<(..R) as ItemTouches>::List>>::Out;
}
pub trait Touches { type List; }
impl<A> Touches for Writes<A> { type List = (Writes<A>, ()); }
impl<A> Touches for Read<A> { type List = (Read<A>, ()); }
impl<X> Touches for Owned<X> { type List = (Owned<X>, ()); }
impl<X> Touches for Shared<X> { type List = (Shared<X>, ()); }
impl<X> Touches for Maybe<X> { type List = (Shared<X>, ()); }
impl<X> Touches for MaybeOwned<X> { type List = (Owned<X>, ()); }
impl Touches for Asking { type List = (); }
impl<T> Touches for Localing<T> { type List = (); }
impl<Q, N, St> Touches for Querying<Q, N, St> where Q: ItemTouches { type List = <Q as ItemTouches>::List; }
impl<Q, N, St> Touches for Singling<Q, N, St> where Q: ItemTouches { type List = <Q as ItemTouches>::List; }
pub trait AllTouches { type List; }
impl AllTouches for () { type List = (); }
impl<H, R> AllTouches for (H, R) where H: Touches, R: AllTouches,
    <H as Touches>::List: Concat<<R as AllTouches>::List> {
    type List = <<H as Touches>::List as Concat<<R as AllTouches>::List>>::Out;
}

// A function called with what was gathered for it, its arguments in order.
// What it gives back is what the call gives.
pub trait CallWith<G, O> { fn call_with(&Self, G) -> O }
impl<..P, O, F: Fn<(..P), Output = O>> CallWith<(..P), O> for F {
    fn call_with(f: &F, g: (..P)) -> O { let (..p) = g; (*f)(..p) }
}

// What a list of things asked for is met with, one at a time: a column is
// taken out of the world, lent, and put back when the function has run. What
// has been gathered so far goes along, and at the end of the list the
// function is called with it; what it gives back comes back up. (None if a
// resource was out of its place, which a system asking for each once rules
// out.)
pub trait Fetch<E, S, Gathered, F, O, Lc> {
    fn fetch(&E, &mut World<S>, &mut Commands<S>, &mut Lc, Gathered, &F) -> Option<O>
}
impl<E, S, ..G, F, O, Lc> Fetch<E, S, (..G), F, O, Lc> for () where F: CallWith<(..G), O> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> { Some(call_with(f, gathered)) }
}
impl<E, S, ..G, F, O, Lc, A, Rest> Fetch<E, S, (..G), F, O, Lc> for (Writes<A>, Rest)
    where S: Get<A>, Rest: Fetch<E, S, (..G, &mut Column<A>), F, O, Lc>, A: Writable {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        let (..g) = gathered;
        let mut a = take_at<A, S>(world);
        let made = <Rest as Fetch<E, S, (..G, &mut Column<A>), F, O, Lc>>::fetch(event, world, commands, state, (..g, &mut a), f);
        <S as Get<A>>::put(&mut world.columns, a);
        made
    }
}
impl<E, S, ..G, F, O, Lc, A, Rest> Fetch<E, S, (..G), F, O, Lc> for (Read<A>, Rest)
    where S: Get<A>, Rest: Fetch<E, S, (..G, &Column<A>), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        let (..g) = gathered;
        let a = take_at<A, S>(world);
        let made = <Rest as Fetch<E, S, (..G, &Column<A>), F, O, Lc>>::fetch(event, world, commands, state, (..g, &a), f);
        <S as Get<A>>::put(&mut world.columns, a);
        made
    }
}
// A shared reference to the label's type is the value emitted; to any other
// type, a resource.
impl<E, S, ..G, F, O, Lc, Rest> Fetch<E, S, (..G), F, O, Lc> for (Shared<E>, Rest) where Rest: Fetch<E, S, (..G, &E), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        let (..g) = gathered;
        <Rest as Fetch<E, S, (..G, &E), F, O, Lc>>::fetch(event, world, commands, state, (..g, event), f)
    }
}
impl<E, S, ..G, F, O, Lc, X, Rest> Fetch<E, S, (..G), F, O, Lc> for (Shared<X>, Rest)
    where S: Holds<X>, Rest: Fetch<E, S, (..G, &X), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        match(lift<X, S>(&mut world.columns)) {
            Some(value) =>
                let (..g) = gathered;
                let made = <Rest as Fetch<E, S, (..G, &X), F, O, Lc>>::fetch(event, world, commands, state, (..g, &value), f);
                lower<X, S>(&mut world.columns, value);
                made,
            None => discard(gathered); None
        }
    }
}
impl<E, S, ..G, F, O, Lc, X, Rest> Fetch<E, S, (..G), F, O, Lc> for (Owned<X>, Rest)
    where S: Holds<X>, Rest: Fetch<E, S, (..G, &mut X), F, O, Lc>, X: Writable {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        match(lift<X, S>(&mut world.columns)) {
            Some(value) =>
                let (..g) = gathered;
                let mut value = value;
                let made = <Rest as Fetch<E, S, (..G, &mut X), F, O, Lc>>::fetch(event, world, commands, state, (..g, &mut value), f);
                lower<X, S>(&mut world.columns, value);
                made,
            None => discard(gathered); None
        }
    }
}
impl<E, S, ..G, F, O, Lc, X, Rest> Fetch<E, S, (..G), F, O, Lc> for (Maybe<X>, Rest)
    where S: Holds<X>, Rest: Fetch<E, S, (..G, Option<&X>), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        match(lift<X, S>(&mut world.columns)) {
            Some(value) =>
                let (..g) = gathered;
                let made = <Rest as Fetch<E, S, (..G, Option<&X>), F, O, Lc>>::fetch(event, world, commands, state, (..g, Some(&value)), f);
                lower<X, S>(&mut world.columns, value);
                made,
            None => let (..g) = gathered; <Rest as Fetch<E, S, (..G, Option<&X>), F, O, Lc>>::fetch(event, world, commands, state, (..g, None), f)
        }
    }
}
impl<E, S, ..G, F, O, Lc, X, Rest> Fetch<E, S, (..G), F, O, Lc> for (MaybeOwned<X>, Rest)
    where S: Holds<X>, Rest: Fetch<E, S, (..G, Option<&mut X>), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        match(lift<X, S>(&mut world.columns)) {
            Some(value) =>
                let (..g) = gathered;
                let mut value = value;
                let made = <Rest as Fetch<E, S, (..G, Option<&mut X>), F, O, Lc>>::fetch(event, world, commands, state, (..g, Some(&mut value)), f);
                lower<X, S>(&mut world.columns, value);
                made,
            None => let (..g) = gathered; <Rest as Fetch<E, S, (..G, Option<&mut X>), F, O, Lc>>::fetch(event, world, commands, state, (..g, None), f)
        }
    }
}
// (The commands are given once: what comes after has none to give.)
// The entities a query of `Q` with `N` is of, in the world's columns.
fn query_of<Q, N, S>(world: &mut World<S>) -> Query<Q, N, <Q as Item>::Store> where Q: Fill<S>, N: Only<S>, S: Hidden<Q, N> {
    let all = entities(&*world);
    let mut found = [];
    let mut i = 0;
    while({ i < len_at(&all) }) {
        if(<N as Only<S>>::lets(&world.columns, all[i], world.since)) {
            if(not(<S as Hidden<Q, N>>::hidden(&world.columns, all[i]))) { push_at(&mut found, all[i]) };
        };
        i = i + 1
    };
    Query { store: <Q as Fill<S>>::fill(&mut world.columns, world.tick), entities: found }
}
impl<E, S, ..G, F, O, Lc, Q, N, St, Rest> Fetch<E, S, (..G), F, O, Lc> for (Querying<Q, N, St>, Rest)
    where Q: Item<Store = St>, Q: Fill<S>, N: Only<S>, S: Hidden<Q, N>, Rest: Fetch<E, S, (..G, &mut Query<Q, N, St>), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        let (..g) = gathered;
        let mut query = query_of<Q, N, S>(world);
        let made = <Rest as Fetch<E, S, (..G, &mut Query<Q, N, St>), F, O, Lc>>::fetch(event, world, commands, state, (..g, &mut query), f);
        let Query { store, entities } = query;
        <Q as Fill<S>>::unfill(&mut world.columns, store);
        made
    }
}
// (Not run unless the query is of exactly one entity.)
impl<E, S, ..G, F, O, Lc, Q, N, St, Rest> Fetch<E, S, (..G), F, O, Lc> for (Singling<Q, N, St>, Rest)
    where Q: Item<Store = St>, Q: Fill<S>, N: Only<S>, S: Hidden<Q, N>, Rest: Fetch<E, S, (..G, &mut Single<Q, N, St>), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        let Query { store, entities: all } = query_of<Q, N, S>(world);
        let mut store = store;
        let mut found = [];
        let mut i = 0;
        while({ i < len_at(&all) }) {
            if(is_some(<Q as Item>::item_at(&mut store, all[i]))) { push_at(&mut found, all[i]) };
            i = i + 1
        };
        if(len_at(&found) == 1) {
            let mut single = Single { query: Query { store: store, entities: found } };
            let (..g) = gathered;
            let made = <Rest as Fetch<E, S, (..G, &mut Single<Q, N, St>), F, O, Lc>>::fetch(event, world, commands, state, (..g, &mut single), f);
            let Single { query } = single;
            let Query { store, entities } = query;
            <Q as Fill<S>>::unfill(&mut world.columns, store);
            made
        } else {
            <Q as Fill<S>>::unfill(&mut world.columns, store);
            discard(gathered);
            None
        }
    }
}
impl<E, S, ..G, F, O, Lc, Rest> Fetch<E, S, (..G), F, O, Lc> for (Asking, Rest) where Rest: Fetch<E, S, (..G, &mut Commands<S>), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut Lc, gathered: (..G), f: &F) -> Option<O> {
        let (..g) = gathered;
        let mut none = Commands { queue: [], next: 0, made: 0 };
        <Rest as Fetch<E, S, (..G, &mut Commands<S>), F, O, Lc>>::fetch(event, world, &mut none, state, (..g, commands), f)
    }
}

// A system's own state, kept from one run to the next of the registration
// it is of: `count: &mut Local<Int>`, at its type's start the first time.
pub struct Local<T>(pub T)
pub struct Localing<T>(T)
impl<T> Parameter for &mut Local<T> { type Asks = Localing<T>; }
impl<E, S, ..G, F, O, T, Lc, Rest> Fetch<E, S, (..G), F, O, (Local<T>, Lc)> for (Localing<T>, Rest)
    where Rest: Fetch<E, S, (..G, &mut Local<T>), F, O, Lc> {
    fn fetch(event: &E, world: &mut World<S>, commands: &mut Commands<S>, state: &mut (Local<T>, Lc), gathered: (..G), f: &F) -> Option<O> {
        let (..g) = gathered;
        <Rest as Fetch<E, S, (..G, &mut Local<T>), F, O, Lc>>::fetch(event, world, commands, &mut state.1, (..g, &mut state.0), f)
    }
}

// What the locals of a list of things asked for start as.
pub trait Locals { type State; fn start() -> Self::State; }
impl Locals for () { type State = (); fn start() { () } }
impl<T: Default, R> Locals for (Localing<T>, R) where R: Locals {
    type State = (Local<T>, R::State);
    fn start() -> (Local<T>, R::State) { (Local(default()), <R as Locals>::start()) }
}
impl<X, R> Locals for (X, R) where R: Locals {
    type State = R::State;
    fn start() -> R::State { <R as Locals>::start() }
}

// Something that runs against a world when `E` is emitted: a function with
// its locals, as it was registered; two systems in a pair run one after the
// other.
pub trait System<E, S> {
    fn run(&mut Self, &E, &mut World<S>, &mut Commands<S>)
}
impl<E, S> System<E, S> for () {
    fn run(nothing: &mut (), event: &E, world: &mut World<S>, commands: &mut Commands<S>) { () }
}
impl<E, S, X, Y> System<E, S> for (X, Y) where X: System<E, S>, Y: System<E, S> {
    fn run(pair: &mut (X, Y), event: &E, world: &mut World<S>, commands: &mut Commands<S>) {
        <X as System<E, S>>::run(&mut pair.0, event, world, commands);
        <Y as System<E, S>>::run(&mut pair.1, event, world, commands)
    }
}
// A function, of however many parameters, each asking for something, no
// two for the same; and what its locals hold.
// (`last`: the world's time when it last ran, of which it sees what was
// put in or changed after.)
pub struct Sys<F, Lc> { f: F, locals: Lc, last: Int }
impl<E, S, ..P, ..A, L, Ts, F, Lc> System<E, S> for Sys<F, Lc>
    where F: Fn<(..P), Output = ()>, ..P: Parameter<Asks = A>, (..A): Tuple<Nested = L>, L: AllTouches<List = Ts>, Ts: AllApart, L: Fetch<E, S, (), F, (), Lc> {
    fn run(sys: &mut Sys<F, Lc>, event: &E, world: &mut World<S>, commands: &mut Commands<S>) {
        world.since = sys.last;
        let ran = is_some(<L as Fetch<E, S, (), F, (), Lc>>::fetch(event, world, commands, &mut sys.locals, (), &sys.f));
        world.since = 0;
        // (One that was not run, for want of what it asks, still sees what
        // changed before.)
        if(ran) { sys.last = world.tick; world.tick = world.tick + 1 };
    }
}

// What is registered under `E` in a world of `S`, made a system: each
// function given its locals, and seen to be one that can run there.
pub trait IntoSystem<E, S> { type Out; fn into_system(Self) -> Self::Out; }
impl<E, S> IntoSystem<E, S> for () { type Out = (); fn into_system(nothing: ()) { () } }
impl<E, S, X, Y> IntoSystem<E, S> for (X, Y) where X: IntoSystem<E, S>, Y: IntoSystem<E, S> {
    type Out = (<X as IntoSystem<E, S>>::Out, <Y as IntoSystem<E, S>>::Out);
    fn into_system(pair: (X, Y)) -> (<X as IntoSystem<E, S>>::Out, <Y as IntoSystem<E, S>>::Out) {
        let (x, y) = pair;
        (<X as IntoSystem<E, S>>::into_system(x), <Y as IntoSystem<E, S>>::into_system(y))
    }
}
impl<E, S, ..P, ..A, L, Ts, F, Lc> IntoSystem<E, S> for F
    where F: Fn<(..P), Output = ()>, ..P: Parameter<Asks = A>, (..A): Tuple<Nested = L>, L: AllTouches<List = Ts>, Ts: AllApart,
          L: Locals<State = Lc>, L: Fetch<E, S, (), F, (), Lc> {
    type Out = Sys<F, Lc>;
    fn into_system(f: F) -> Sys<F, Lc> { Sys { f: f, locals: <L as Locals>::start(), last: 0 } }
}

// A condition: a function whose parameters ask for what a system's may,
// and which says whether something is to run. (Its locals start anew each
// time it is asked.)
pub trait Condition<E, S> {
    fn holds(&Self, &E, &mut World<S>, &mut Commands<S>) -> Bool
}
impl<E, S, ..P, ..A, L, Ts, Lc> Condition<E, S> for fn(..P) -> Bool
    where ..P: Parameter<Asks = A>, (..A): Tuple<Nested = L>, L: AllTouches<List = Ts>, Ts: AllApart, L: Locals<State = Lc>,
          L: Fetch<E, S, (), fn(..P) -> Bool, Bool, Lc> {
    fn holds(f: &fn(..P) -> Bool, event: &E, world: &mut World<S>, commands: &mut Commands<S>) -> Bool {
        let mut locals = <L as Locals>::start();
        match(<L as Fetch<E, S, (), fn(..P) -> Bool, Bool, Lc>>::fetch(event, world, commands, &mut locals, (), f)) {
            Some(answer) => answer,
            None => false
        }
    }
}

// Systems that run only when a condition holds: `friction.run_if(moving)`.
pub struct RunIf<P, C> { systems: P, condition: C }
pub fn run_if<P, C>(systems: P, condition: C) -> RunIf<P, C> { RunIf { systems: systems, condition: condition } }
impl<E, S, P, C> System<E, S> for RunIf<P, C> where P: System<E, S>, C: Condition<E, S> {
    fn run(guarded: &mut RunIf<P, C>, event: &E, world: &mut World<S>, commands: &mut Commands<S>) {
        if(<C as Condition<E, S>>::holds(&guarded.condition, event, world, commands)) {
            <P as System<E, S>>::run(&mut guarded.systems, event, world, commands)
        };
    }
}
impl<E, S, P, C> IntoSystem<E, S> for RunIf<P, C> where P: IntoSystem<E, S>, C: Condition<E, S> {
    type Out = RunIf<<P as IntoSystem<E, S>>::Out, C>;
    fn into_system(guarded: RunIf<P, C>) -> RunIf<<P as IntoSystem<E, S>>::Out, C> {
        let RunIf { systems, condition } = guarded;
        RunIf { systems: <P as IntoSystem<E, S>>::into_system(systems), condition: condition }
    }
}

// Systems in the order written, however many: `(a, b, c).chain()`. A tuple
// is the pairs it is made of, and a pair of systems is a system.
pub fn chain<T, L>(systems: T) -> L where T: Tuple<Nested = L> { nest(systems) }

// The systems registered under a label.
pub struct On<E, P> { label: fn(E) -> (), systems: P }

// Run what is registered under `E`, in the order it was registered. Of the
// two implementations for a list the first is for one whose first entry is
// under `E`; the second passes over an entry under another label.
pub trait Dispatch<E, S> {
    fn dispatch(&mut Self, &E, &mut World<S>, &mut Commands<S>)
}
impl<E, S> Dispatch<E, S> for () {
    fn dispatch(nothing: &mut (), event: &E, world: &mut World<S>, commands: &mut Commands<S>) { () }
}
impl<E, P, T, S> Dispatch<E, S> for (On<E, P>, T) where P: System<E, S>, T: Dispatch<E, S> {
    fn dispatch(list: &mut (On<E, P>, T), event: &E, world: &mut World<S>, commands: &mut Commands<S>) {
        <T as Dispatch<E, S>>::dispatch(&mut list.1, event, world, commands);
        <P as System<E, S>>::run(&mut list.0.systems, event, world, commands)
    }
}
impl<E, F, P, T, S> Dispatch<E, S> for (On<F, P>, T) where T: Dispatch<E, S> {
    fn dispatch(list: &mut (On<F, P>, T), event: &E, world: &mut World<S>, commands: &mut Commands<S>) { <T as Dispatch<E, S>>::dispatch(&mut list.1, event, world, commands) }
}

// What an app is given by a plugin: a type of its own whose `build` adds to
// the app what the plugin has, or a function from an app to an app. What the
// app is then is found from `build` (`type Out = _;`).
// (Its `Components`, registered before it builds: none, unless it says.)
pub trait Plugin<S, L> {
    type Components = ();
    type Out;
    fn register(app: App<S, L>) -> App<<Self::Components as Registers<S>>::Out, L> { app.register_all<Self::Components>() }
    fn build(Self, App<<Self::Components as Registers<S>>::Out, L>) -> Self::Out;
}
impl<S, L, Y> Plugin<S, L> for fn(App<S, L>) -> Y {
    type Out = Y;
    fn build(f: fn(App<S, L>) -> Y, app: App<<<fn(App<S, L>) -> Y as Plugin<S, L>>::Components as Registers<S>>::Out, L>) -> Y { f(app) }
}

// The columns of a list of components, before a world's columns.
pub trait Registers<S> {
    type Out;
    fn register_all(S) -> Self::Out;
}
impl<S> Registers<S> for () {
    type Out = S;
    fn register_all(columns: S) -> S { columns }
}
impl<H, ..R, S> Registers<S> for (H, ..R) where (..R): Registers<S> {
    type Out = (Column<H>, <(..R) as Registers<S>>::Out);
    fn register_all(columns: S) -> (Column<H>, <(..R) as Registers<S>>::Out) { (empty_column(), <(..R) as Registers<S>>::register_all(columns)) }
}

// A world of columns `S` and the registered systems `L`.
// Hooks: systems run when a component is added to entities, put in (added
// or another value given), about to be replaced, or about to be taken away,
// given the entities (`trigger.entities`). Registered as any label's,
// `app.on<OnAdd<Health>, _, _>(systems)`, and fired by the app's own
// structural operations, `app.spawn_bundle`, `app.spawn_batch`,
// `app.insert`, `app.remove` and `app.despawn`, before they return: what
// the hooks command is done then, and may fire hooks of its own.
pub struct OnAdd<T> { pub entities: [Entity], none: [T] }
pub struct OnInsert<T> { pub entities: [Entity], none: [T] }
pub struct OnReplace<T> { pub entities: [Entity], none: [T] }
pub struct OnRemove<T> { pub entities: [Entity], none: [T] }
// (A bundle's components, each added and put in.)
pub trait Hooked<S, L> { fn added(&mut App<S, L>, [Entity]) }
impl<S, L> Hooked<S, L> for () { fn added(app: &mut App<S, L>, entities: [Entity]) { discard(entities) } }
impl<H, ..R, S, L> Hooked<S, L> for (H, ..R)
    where L: Dispatch<OnAdd<H>, S>, L: Dispatch<OnInsert<H>, S>, S: Columns, S: Unlinks<S>, (..R): Hooked<S, L> {
    fn added(app: &mut App<S, L>, entities: [Entity]) {
        if(len_at(&entities) > 0) {
            app.emit<OnAdd<H>>(&OnAdd { entities: clone(&entities), none: [] });
            app.emit<OnInsert<H>>(&OnInsert { entities: clone(&entities), none: [] })
        };
        <(..R) as Hooked<S, L>>::added(app, entities)
    }
}
// (The columns an entity has, each about to be taken away.)
pub trait RemoveHooks<S, L> { fn removing(&mut App<S, L>, Entity) }
impl<S, L> RemoveHooks<S, L> for () { fn removing(app: &mut App<S, L>, entity: Entity) { () } }
impl<T, R, S, L> RemoveHooks<S, L> for (Column<T>, R)
    where S: Get<T>, L: Dispatch<OnRemove<T>, S>, S: Columns, S: Unlinks<S>, R: RemoveHooks<S, L> {
    fn removing(app: &mut App<S, L>, entity: Entity) {
        if(<S as Get<T>>::has(&app.world.columns, entity)) { app.emit<OnRemove<T>>(&OnRemove { entities: [entity], none: [] }) };
        <R as RemoveHooks<S, L>>::removing(app, entity)
    }
}
impl<T, R, S, L> RemoveHooks<S, L> for (Resource<T>, R) where R: RemoveHooks<S, L> {
    fn removing(app: &mut App<S, L>, entity: Entity) { <R as RemoveHooks<S, L>>::removing(app, entity) }
}

// States: one type per state, each of a group (`impl State for Menu { type
// Group = Game; }`), of which one at most is active, kept as a resource (a
// place for each, `register_resource`). `app.set_state(state)` exits the
// group's active state, if there is one (`OnExit` systems run while it can
// still be read, and then it is taken away), enters the new one (put in;
// `OnEnter`), and then runs the `OnTransition<Old, New>` systems. No values
// are compared: another value of the active state is a transition too.
pub struct NoGroup
pub trait State { type Group; }
impl<T> State for T { type Group = NoGroup; }
pub struct OnEnter<T> { none: [T] }
pub struct OnExit<T> { none: [T] }
pub struct OnTransition<A, B> { none: [(A, B)] }
// (The resources of the group `G`: the active one exited, and what runs
// once `N` is entered.)
pub trait ExitGroup<G, N, S, L> { fn exit_group(&mut App<S, L>) -> Option<fn(&mut App<S, L>) -> ()> }
impl<G, N, S, L> ExitGroup<G, N, S, L> for () { fn exit_group(app: &mut App<S, L>) -> Option<fn(&mut App<S, L>) -> ()> { None } }
impl<X, R, G, N, S, L> ExitGroup<G, N, S, L> for (Resource<X>, R)
    where X: State, <X as State>::Group: Same<G>, S: Holds<X>, S: Columns, S: Unlinks<S>,
          L: Dispatch<OnExit<X>, S>, L: Dispatch<OnTransition<X, N>, S>, R: ExitGroup<G, N, S, L> {
    fn exit_group(app: &mut App<S, L>) -> Option<fn(&mut App<S, L>) -> ()> {
        let active = if(<<X as State>::Group as Same<G>>::same()) { is_some(app.world.resource<X>()) } else { false };
        if(active) {
            app.emit<OnExit<X>>(&OnExit { none: [] });
            discard(app.world.remove_resource<X>());
            Some(fn(app: &mut App<S, L>) { app.emit<OnTransition<X, N>>(&OnTransition { none: [] }) })
        } else { <R as ExitGroup<G, N, S, L>>::exit_group(app) }
    }
}
impl<X, R, G, N, S, L> ExitGroup<G, N, S, L> for (Column<X>, R) where R: ExitGroup<G, N, S, L> {
    fn exit_group(app: &mut App<S, L>) -> Option<fn(&mut App<S, L>) -> ()> { <R as ExitGroup<G, N, S, L>>::exit_group(app) }
}

pub struct App<S, L> { pub world: World<S>, systems: L }

impl<S, L> App<S, L> {
    // An app with nothing in its world and no systems.
    pub fn new() -> App<(), ()> {
        App { world: World { columns: (), generations: [], free: [], tick: 1, since: 0 }, systems: () }
    }

    // Give the world a resource.
    pub fn insert_resource<T>(app: Self, value: T) -> App<(Resource<T>, S), L> {
        let App { world, systems } = app;
        let World { columns, generations, free, tick, since } = world;
        App { world: World { columns: (Resource { value: Some(value) }, columns), generations: generations, free: free, tick: tick, since: since }, systems: systems }
    }

    // The resource at its type's start.
    pub fn init_resource<T: Default>(app: Self) -> App<(Resource<T>, S), L> { app.insert_resource(default<T>()) }

    // A place for a resource the world does not have yet. (Upstream finds
    // it from the systems that ask for it.)
    pub fn register_resource<T>(app: Self) -> App<(Resource<T>, S), L> {
        let App { world, systems } = app;
        let World { columns, generations, free, tick, since } = world;
        App { world: World { columns: (Resource { value: None }, columns), generations: generations, free: free, tick: tick, since: since }, systems: systems }
    }

    // Store a component.
    pub fn register<T>(app: Self) -> App<(Column<T>, S), L> {
        let App { world, systems } = app;
        let World { columns, generations, free, tick, since } = world;
        App { world: World { columns: (empty_column(), columns), generations: generations, free: free, tick: tick, since: since }, systems: systems }
    }

    // Register systems under a label, named by a value of it: `Update`.
    pub fn add_systems<E, P, Q>(app: Self, label: E, systems: P) -> App<S, (On<E, Q>, L)> where P: IntoSystem<E, S, Out = Q> {
        app.on<E, P, Q>(systems)
    }

    // Register systems under a label that carries something, named by its
    // type: `.on<Hit>(..)`. A system under it may take `&Hit` first.
    pub fn on<E, P, Q>(app: Self, systems: P) -> App<S, (On<E, Q>, L)> where P: IntoSystem<E, S, Out = Q> {
        let App { world, systems: before } = app;
        App { world: world, systems: (On { label: fn(event: E) { () }, systems: <P as IntoSystem<E, S>>::into_system(systems) }, before) }
    }

    // Add what a plugin has: its components, then what it builds.
    pub fn add_plugins<P>(app: Self, plugin: P) -> <P as Plugin<S, L>>::Out where P: Plugin<S, L> {
        <P as Plugin<S, L>>::build(plugin, <P as Plugin<S, L>>::register(app))
    }

    // Store a relation: what relates and what is related to.
    pub fn relation<R>(app: Self) -> App<<R as RelationColumns<S>>::Out, L> where R: RelationColumns<S> {
        let App { world, systems } = app;
        let World { columns, generations, free, tick, since } = world;
        App { world: World { columns: <R as RelationColumns<S>>::relation_columns(columns), generations: generations, free: free, tick: tick, since: since }, systems: systems }
    }

    // Store each of a list of components: `.register_all<(Position, Velocity)>()`.
    pub fn register_all<C>(app: Self) -> App<<C as Registers<S>>::Out, L> where C: Registers<S> {
        let App { world, systems } = app;
        let World { columns, generations, free, tick, since } = world;
        App { world: World { columns: <C as Registers<S>>::register_all(columns), generations: generations, free: free, tick: tick, since: since }, systems: systems }
    }

    // The app, ready to run.
    pub fn build(app: Self) -> Self { app }

    // Run every system registered under what is emitted, then do what they asked.
    // Make `state` its group's active state.
    pub fn set_state<T>(app: &mut Self, state: T)
        where T: State, S: ExitGroup<<T as State>::Group, T, S, L>, S: Holds<T>, S: Columns, S: Unlinks<S>, L: Dispatch<OnEnter<T>, S> {
        let after = <S as ExitGroup<<T as State>::Group, T, S, L>>::exit_group(app);
        discard(app.world.insert_resource(state));
        app.emit<OnEnter<T>>(&OnEnter { none: [] });
        match(after) { Some(f) => f(app), None => () }
    }
    // The world's structural operations, with the hooks they fire.
    pub fn spawn_bundle<B>(app: &mut Self, bundle: B) -> Entity where B: Bundle<S>, B: Hooked<S, L> {
        let entity = app.world.spawn_bundle(bundle);
        <B as Hooked<S, L>>::added(app, [entity]);
        entity
    }
    pub fn spawn_batch<B>(app: &mut Self, bundles: [B]) -> [Entity] where B: Bundle<S>, B: Hooked<S, L> {
        let made = app.world.spawn_batch(bundles);
        <B as Hooked<S, L>>::added(app, clone(&made));
        made
    }
    pub fn insert<T>(app: &mut Self, entity: Entity, value: T) -> Option<T>
        where S: Get<T>, T: EvictOne<S>, T: BringsOne<S>, T: Use<[0, *]>, S: Columns, S: Unlinks<S>,
              L: Dispatch<OnAdd<T>, S>, L: Dispatch<OnInsert<T>, S>, L: Dispatch<OnReplace<T>, S> {
        let had = <S as Get<T>>::has(&app.world.columns, entity);
        if(had) { app.emit<OnReplace<T>>(&OnReplace { entities: [entity], none: [] }) };
        let old = app.world.insert(entity, value);
        if(not(had)) { app.emit<OnAdd<T>>(&OnAdd { entities: [entity], none: [] }) };
        app.emit<OnInsert<T>>(&OnInsert { entities: [entity], none: [] });
        old
    }
    pub fn remove<T>(app: &mut Self, entity: Entity) -> Option<T> where S: Get<T>, S: Columns, S: Unlinks<S>, L: Dispatch<OnRemove<T>, S> {
        if(<S as Get<T>>::has(&app.world.columns, entity)) { app.emit<OnRemove<T>>(&OnRemove { entities: [entity], none: [] }) };
        app.world.remove<T>(entity)
    }
    pub fn despawn(app: &mut Self, entity: Entity) -> Bool where S: Columns, S: Unlinks<S>, S: RemoveHooks<S, L> {
        if(alive(&app.world, entity)) {
            <S as RemoveHooks<S, L>>::removing(app, entity);
            despawn(&mut app.world, entity);
            true
        } else { false }
    }

    pub fn emit<E>(app: &mut Self, event: &E) where L: Dispatch<E, S>, S: Columns, S: Unlinks<S> {
        let mut commands = Commands { queue: [], next: len_at(&app.world.generations), made: 0 };
        <L as Dispatch<E, S>>::dispatch(&mut app.systems, event, &mut app.world, &mut commands);
        apply(commands, &mut app.world)
    }
}
