// Covey: an entity component system in which the whole app is one type.
//
// A system is a plain function, and its parameters say what it touches:
//
//     fn integrate(positions: &mut Column<Position>, velocities: &Column<Velocity>) { .. }
//     fn wound(hit: &Hit, healths: &mut Column<Health>) { .. }
//     fn reap(healths: &Column<Health>, commands: &mut Commands<S>, ended: &mut Ended) { .. }
//
// A reference to a column is to a component's values; to the type a label
// carries, to the value emitted; to `Commands`, to what is asked to be done
// afterwards; and to any other type, to the world's one value of it, a
// resource. An app is built by saying what there is and what runs when:
//
//     app().register<Position>().register<Velocity>().insert_resource(Ended(0))
//          .add_systems(Update, (integrate, friction.run_if(moving), bound).chain())
//          .on<Hit>((wound, reap).chain())
//          .add_plugins(physics)
//
// The world's storage is a tuple of columns, one inside the next, and an
// app is that world with a list of the systems registered under each label.
// Both are types, so everything about a system is found when the program is
// compiled, by implementations that fit the types:
//
//   which column a parameter is          `Get`
//   which resource                       `Holds`
//   what each parameter asks for         `Parameter`, then `Fetch` for the list
//   that no component is asked for twice `AllApart`
//   which systems a label runs           `Dispatch`
//   a tuple of components given at once  `Bundle`, for tuples of any length
//   whether a condition holds            `Condition`, a function asking as a system does
//
// A system that asks for a component that was not registered, or a
// resource that was not inserted, or for either twice, does not compile. When
// the program runs, each of those calls is a call of a known function.

use std::tuple::{Tuple, nest};
use core::option::{as_ref, as_mut, is_none, is_some};
use core::value::{Default, default, discard};
use core::iter::{into_iter, next};

// An entity: a place in the columns, and which of the entities that have had
// that place this one is.
pub struct Entity { pub index: Int, pub generation: Int }
impl Entity {
    // An entity no world has, to start with where one is needed.
    pub const PLACEHOLDER: Entity = Entity { index: -1, generation: -1 };
}

// One component's values: packed, each with the entity it belongs to, and
// for each entity's place where its value is among them. With each value,
// when it was put in and when it was last changed (`now`: the time a write
// through the column is now).
pub struct Column<T> { pub dense: [T], pub owners: [Entity], pub slots: [Int], added: [Int], changed: [Int], now: Int }

pub fn empty_column<T>() -> Column<T> { Column { dense: [], owners: [], slots: [], added: [], changed: [], now: 0 } }

// Where an entity's value is in a column, or -1.
pub fn slot_of<T>(column: &Column<T>, entity: Entity) -> Int {
    if(entity.index < 0) { -1 }
    else if(entity.index >= len_at(&column.slots)) { -1 }
    else {
        let at = column.slots[entity.index];
        if(at < 0) { -1 } else if(column.owners[at].generation == entity.generation) { at } else { -1 }
    }
}

// An entity's value in a column, kept: a system that has the column gives it.
pub fn give<T>(column: &mut Column<T>, entity: Entity, value: T) { column_insert(column, entity, value) }

fn column_insert<T>(column: &mut Column<T>, entity: Entity, value: T) {
    while({ len_at(&column.slots) <= entity.index }) { push_at(&mut column.slots, 0 - 1) };
    let at = column.slots[entity.index];
    if(at >= 0) {
        column.dense[at] = value;
        column.owners[at] = entity;
        column.changed[at] = column.now;
    } else {
        column.slots[entity.index] = len_at(&column.dense);
        push_at(&mut column.dense, value);
        push_at(&mut column.owners, entity);
        push_at(&mut column.added, column.now);
        push_at(&mut column.changed, column.now);
    }
}

// Take an entity's value out: the last value moves into its place.
fn column_remove<T>(column: &mut Column<T>, entity: Entity) -> Option<T> {
    let at = slot_of(&*column, entity);
    if(at < 0) { None } else {
        let last = len_at(&column.dense) - 1;
        let moved = column.owners[last];
        let _ = pop_at(&mut column.owners);
        match(pop_at(&mut column.added)) { Some(t) => if(at < last) { column.added[at] = t } else { () }, None => () };
        match(pop_at(&mut column.changed)) { Some(t) => if(at < last) { column.changed[at] = t } else { () }, None => () };
        match(pop_at(&mut column.dense)) {
            None => None,
            Some(final) =>
                column.slots[entity.index] = 0 - 1;
                if(at == last) { Some(final) } else {
                    column.owners[at] = moved;
                    column.slots[moved.index] = at;
                    Some(replace(&mut column.dense[at], final))
                }
        }
    }
}

// The column of `T` among a world's columns. Of the two implementations the
// first is for a tuple whose first column is `T`'s; the second looks further.
// A world that has no column of `T` has no implementation: a system that
// asks for one does not compile.
pub trait Get<T> {
    fn take(&mut Self) -> Column<T>
    fn put(&mut Self, Column<T>)
    fn has(&Self, Entity) -> Bool
    fn column(&Self) -> &Column<T>
    fn column_mut(&mut Self) -> &mut Column<T>
}
impl<T, R> Get<T> for (Column<T>, R) {
    fn take(columns) { replace(&mut columns.0, empty_column()) }
    fn put(columns, column) { columns.0 = column; }
    fn has(columns, entity) { slot_of(&columns.0, entity) >= 0 }
    fn column(columns) { &columns.0 }
    fn column_mut(columns) { &mut columns.0 }
}
impl<T, H, R> Get<T> for (Column<H>, R) where R: Get<T> {
    fn take(columns) { <R as Get<T>>::take(&mut columns.1) }
    fn put(columns, column) { <R as Get<T>>::put(&mut columns.1, column) }
    fn has(columns, entity) { <R as Get<T>>::has(&columns.1, entity) }
    fn column(columns) { <R as Get<T>>::column(&columns.1) }
    fn column_mut(columns) { <R as Get<T>>::column_mut(&mut columns.1) }
}
impl<T, H, R> Get<T> for (Resource<H>, R) where R: Get<T> {
    fn take(columns) { <R as Get<T>>::take(&mut columns.1) }
    fn put(columns, column) { <R as Get<T>>::put(&mut columns.1, column) }
    fn has(columns, entity) { <R as Get<T>>::has(&columns.1, entity) }
    fn column(columns) { <R as Get<T>>::column(&columns.1) }
    fn column_mut(columns) { <R as Get<T>>::column_mut(&mut columns.1) }
}

// A column taken out of the world, its writes of the world's time now.
fn take_at<T, S>(world: &mut World<S>) -> Column<T> where S: Get<T> {
    let mut column = <S as Get<T>>::take(&mut world.columns);
    column.now = world.tick;
    column
}

// One value the whole world has, kept among its columns: a score, a clock.
// While a system has it, it is out of its place.
pub struct Resource<T> { value: Option<T> }

// What a system names a resource by: `score: Res<Score>`, `speed: ResMut<Speed>`.
// A system that takes one runs only while the world has it; one that takes
// `Option<Res<T>>` runs either way.
pub type Res<'a, T> = &'a T;
pub type ResMut<'a, T> = &'a mut T;

// The resource of type `T` among a world's columns, found as a column is.
pub trait Holds<T> {
    fn slot(&Self) -> &Option<T>
    fn slot_mut(&mut Self) -> &mut Option<T>
}
impl<T, R> Holds<T> for (Resource<T>, R) {
    fn slot(columns) { &columns.0.value }
    fn slot_mut(columns) { &mut columns.0.value }
}
impl<T, H, R> Holds<T> for (Resource<H>, R) where R: Holds<T> {
    fn slot(columns) { <R as Holds<T>>::slot(&columns.1) }
    fn slot_mut(columns) { <R as Holds<T>>::slot_mut(&mut columns.1) }
}
impl<T, H, R> Holds<T> for (Column<H>, R) where R: Holds<T> {
    fn slot(columns) { <R as Holds<T>>::slot(&columns.1) }
    fn slot_mut(columns) { <R as Holds<T>>::slot_mut(&mut columns.1) }
}
// The resource taken out of its place, and put back.
fn lift<T, S>(columns: &mut S) -> Option<T> where S: Holds<T> { replace(<S as Holds<T>>::slot_mut(columns), None) }
fn lower<T, S>(columns: &mut S, value: T) where S: Holds<T> { *<S as Holds<T>>::slot_mut(columns) = Some(value); }

// What is done to every column of a world when an entity ends.
pub trait Columns {
    fn forget(&mut Self, Entity)
    fn empty() -> Self
}
impl Columns for () {
    fn forget(columns, entity) { () }
    fn empty() { () }
}
impl<H, R> Columns for (Column<H>, R) where R: Columns {
    fn forget(columns, entity) {
        let _ = column_remove(&mut columns.0, entity);
        <R as Columns>::forget(&mut columns.1, entity)
    }
    fn empty() { (empty_column(), <R as Columns>::empty()) }
}
impl<H, R> Columns for (Resource<H>, R) where R: Columns {
    fn forget(columns, entity) { <R as Columns>::forget(&mut columns.1, entity) }
    fn empty() { (Resource { value: None }, <R as Columns>::empty()) }
}

// The columns, and which entities there are.
pub struct World<S> { pub columns: S, generations: [Int], free: [Int], tick: Int, since: Int }

pub fn spawn<S>(world: &mut World<S>) -> Entity {
    match(pop_at(&mut world.free)) {
        Some(index) => Entity { index: index, generation: world.generations[index] },
        None =>
            push_at(&mut world.generations, 0);
            Entity { index: len_at(&world.generations) - 1, generation: 0 }
    }
}

pub fn alive<S>(world: &World<S>, entity: Entity) -> Bool {
    if(entity.index < 0) { false }
    else if(entity.index < len_at(&world.generations)) { world.generations[entity.index] == entity.generation }
    else { false }
}

// End an entity: every column forgets it.
pub fn despawn<S>(world: &mut World<S>, entity: Entity) where S: Columns {
    if(alive(&*world, entity)) {
        world.generations[entity.index] = entity.generation + 1;
        push_at(&mut world.free, entity.index);
        <S as Columns>::forget(&mut world.columns, entity)
    } else { () }
}

// Take a component from an entity.
pub fn remove<T, S>(world: &mut World<S>, entity: Entity) -> Option<T> where S: Get<T> {
    let mut column = take_at<T, S>(world);
    let taken = column_remove(&mut column, entity);
    <S as Get<T>>::put(&mut world.columns, column);
    taken
}

// Give an entity a component, or another value of one it has.
pub fn insert<T, S>(world: &mut World<S>, entity: Entity, value: T) -> Option<T> where S: Get<T> {
    let mut column = take_at<T, S>(world);
    // (Another value of one it has is a change, and not an addition.)
    let at = slot_of(&column, entity);
    let had = if(at >= 0) {
        column.changed[at] = column.now;
        Some(replace(&mut column.dense[at], value))
    } else { column_insert(&mut column, entity, value); None };
    <S as Get<T>>::put(&mut world.columns, column);
    had
}

// Components given together: a tuple of them, each put in its column.
// Components given together. Put on an entity, what it had of them comes
// back; taken from one, what it had of them.
pub trait Bundle<S> {
    type Had;
    fn put_all(Self, &mut World<S>, Entity) -> Self::Had
    fn take_all(&mut World<S>, Entity) -> Self::Had
}
impl<..T, S> Bundle<S> for (..T) where ..S: Get<T> {
    type Had = (..Option<T>);
    fn put_all(bundle, world, entity) {
        let (..t) = bundle;
        (..insert(world, entity, t))
    }
    fn take_all(world, entity) { (..remove<T, S>(world, entity)) }
}

// A new entity with the components given.
pub fn spawn_with<B, S>(world: &mut World<S>, bundle: B) -> Entity where B: Bundle<S> {
    let entity = spawn(world);
    <B as Bundle<S>>::put_all(bundle, world, entity);
    entity
}

// How many entities have the component.
pub fn count<T, S>(world: &mut World<S>) -> Int where S: Get<T> {
    let column = take_at<T, S>(world);
    let n = len_at(&column.dense);
    <S as Get<T>>::put(&mut world.columns, column);
    n
}

impl<S> World<S> {
    // A new entity with the components given.
    pub fn spawn_bundle<B>(world: &mut Self, bundle: B) -> Entity where B: Bundle<S> { spawn_with(world, bundle) }

    // An empty world of the columns `S`.
    pub fn new() -> World<S> where S: Columns { World { columns: <S as Columns>::empty(), generations: [], free: [], tick: 1, since: 0 } }

    // Give an entity a component, or another value of one it has: the one
    // it had, if it had one.
    pub fn insert<T>(world: &mut Self, entity: Entity, value: T) -> Option<T> where S: Get<T> {
        if(alive(&*world, entity)) { insert(world, entity, value) } else { discard(value); None }
    }

    // Give an entity components; what it had of them.
    pub fn insert_bundle<B>(world: &mut Self, entity: Entity, bundle: B) -> Option<B::Had> where B: Bundle<S> {
        if(alive(&*world, entity)) { Some(<B as Bundle<S>>::put_all(bundle, world, entity)) } else { discard(bundle); None }
    }

    // Take components from an entity; what it had of them.
    pub fn remove_bundle<B>(world: &mut Self, entity: Entity) -> B::Had where B: Bundle<S> {
        <B as Bundle<S>>::take_all(world, entity)
    }

    // New entities, one for each bundle, in order.
    pub fn spawn_batch<B>(world: &mut Self, bundles: [B]) -> [Entity] where B: Bundle<S> {
        let mut made = [];
        let mut rest = into_iter(bundles);
        while({ match(next(&mut rest)) { Some(b) => push_at(&mut made, spawn_with(world, b)); true, None => false } }) { () };
        made
    }

    // Whether the entity is there.
    pub fn contains(world: &Self, entity: Entity) -> Bool { alive(world, entity) }

    // Take a component from an entity.
    pub fn remove<T>(world: &mut Self, entity: Entity) -> Option<T> where S: Get<T> { remove<T, S>(world, entity) }

    // End an entity; whether it was there.
    pub fn despawn(world: &mut Self, entity: Entity) -> Bool where S: Columns {
        let was = alive(&*world, entity);
        despawn(world, entity);
        was
    }

    // An entity's component.
    pub fn get<T>(world: &Self, entity: Entity) -> Option<&T> where S: Get<T> {
        let column = <S as Get<T>>::column(&world.columns);
        let at = slot_of(column, entity);
        if(at < 0) { None } else { Some(&column.dense[at]) }
    }

    // An entity's component, to change: a change once `get_mut` is asked of it.
    pub fn get_mut<T>(world: &mut Self, entity: Entity) -> Option<Mut<'_, T>> where S: Get<T> {
        let now = world.tick;
        let column = <S as Get<T>>::column_mut(&mut world.columns);
        column.now = now;
        let at = slot_of(&*column, entity);
        if(at < 0) { None } else { Some(mut_at(column, at)) }
    }

    // How many entities have the component.
    pub fn count<T>(world: &mut Self) -> Int where S: Get<T> { count<T, S>(world) }

    // Every entity there is.
    pub fn entities(world: &Self) -> [Entity] { entities(world) }

    // A query of the world: `world.query<(Entity, &Score)>()`. While it is
    // had, the world is borrowed by it; its columns go back when it is let go.
    pub fn query<Q>(world: &mut Self) -> WorldQuery<'_, Q, (), S> where Q: Fill<S> {
        world.query_filtered<Q, ()>()
    }
    pub fn query_filtered<Q, N>(world: &mut Self) -> WorldQuery<'_, Q, N, S> where Q: Fill<S>, N: Only<S> {
        let query = query_of<Q, N, S>(world);
        WorldQuery {
            world: world,
            query: query,
            put_back: fn(world: &mut World<S>, store: <Q as Item>::Store) { <Q as Fill<S>>::unfill(&mut world.columns, store) },
            blank: fn() -> <Q as Item>::Store { <Q as Fill<S>>::hollow() }
        }
    }

    // The resource, if the world has it (none while a system has it).
    pub fn resource<T>(world: &Self) -> Option<&T> where S: Holds<T> { as_ref(<S as Holds<T>>::slot(&world.columns)) }
    pub fn resource_mut<T>(world: &mut Self) -> Option<&mut T> where S: Holds<T> {
        as_mut(<S as Holds<T>>::slot_mut(&mut world.columns))
    }

    // Give the world the resource; the one it had, if it had one.
    pub fn insert_resource<T>(world: &mut Self, value: T) -> Option<T> where S: Holds<T> {
        replace(<S as Holds<T>>::slot_mut(&mut world.columns), Some(value))
    }
    pub fn remove_resource<T>(world: &mut Self) -> Option<T> where S: Holds<T> {
        replace(<S as Holds<T>>::slot_mut(&mut world.columns), None)
    }

    // The resource at its type's start, if the world does not have one.
    pub fn init_resource<T: Default>(world: &mut Self) where S: Holds<T> {
        let slot = <S as Holds<T>>::slot_mut(&mut world.columns);
        if(is_none(as_ref(&*slot))) { *slot = Some(default()) } else { () }
    }
}

// Every value of a component, folded into one.
pub fn fold_all<T, S, R>(world: &mut World<S>, start: R, f: for<'a> fn(R, &'a T) -> R) -> R where S: Get<T> {
    let column = take_at<T, S>(world);
    let mut result = start;
    let mut i = 0;
    while({ i < len_at(&column.dense) }) {
        result = f(result, &column.dense[i]);
        i = i + 1
    };
    <S as Get<T>>::put(&mut world.columns, column);
    result
}

// Every entity with an `A`, its `A` to change.
pub fn each<A>(column: &mut Column<A>, f: for<'a> fn(Entity, &'a mut A)) {
    let mut i = 0;
    while({ i < len_at(&column.dense) }) {
        f(column.owners[i], &mut column.dense[i]);
        i = i + 1
    }
}

// Every entity with an `A` and a `B`: its `A` to change, its `B` to read.
pub fn each2<A, B>(first: &mut Column<A>, second: &Column<B>, f: for<'a, 'b> fn(Entity, &'a mut A, &'b B)) {
    let mut i = 0;
    while({ i < len_at(&first.dense) }) {
        let entity = first.owners[i];
        let at = slot_of(second, entity);
        if(at >= 0) { f(entity, &mut first.dense[i], &second.dense[at]) } else { () };
        i = i + 1
    }
}

// A query: several columns, an entity at a time. `Query<(&mut Position,
// &Velocity)>` changes positions and reads velocities, of each entity that
// has both: as many columns as are written, each `&mut` or `&`.
pub trait Item {
    type Store;
    type Got<'a>;
    fn item_at<'a>(&'a mut Store, Entity) -> Option<Got<'a>>
}
// A component that may be changed: what is read of it through `get` is not
// a change; what is had of it through `get_mut` is, at the time it is had.
pub struct Mut<'a, T> { value: &'a mut T, tick: &'a mut Int, now: Int }
impl<'a, T> Mut<'a, T> {
    pub fn get(m: &Self) -> &T { &*m.value }
    pub fn get_mut(m: &mut Self) -> &mut T { *m.tick = m.now; &mut *m.value }
}
fn mut_at<'a, A>(column: &'a mut Column<A>, at: Int) -> Mut<'a, A> {
    Mut { value: &mut column.dense[at], tick: &mut column.changed[at], now: column.now }
}

impl<A> Item for &mut A {
    type Store = Column<A>;
    type Got<'a> = Mut<'a, A>;
    fn item_at(store, entity) {
        let at = slot_of(&*store, entity);
        if(at >= 0) { Some(mut_at(store, at)) } else { None }
    }
}
impl<A> Item for &A {
    type Store = Column<A>;
    type Got<'a> = &'a A;
    fn item_at(store, entity) {
        let at = slot_of(&*store, entity);
        if(at >= 0) { Some(&store.dense[at]) } else { None }
    }
}
impl Item for () {
    type Store = ();
    type Got<'a> = ();
    fn item_at(store, entity) { Some(()) }
}
// The entity itself.
impl Item for Entity {
    type Store = ();
    type Got<'a> = Entity;
    fn item_at(store, entity) { Some(entity) }
}
// Whether the entity has an `A`: every entity is found, with it or not.
pub struct Has<A>(A)
impl<A> Item for Has<A> {
    type Store = Column<A>;
    type Got<'a> = Bool;
    fn item_at(store, entity) { Some(slot_of(&*store, entity) >= 0) }
}
// Its `A` if it has one: every entity is found, with it or not.
impl<A> Item for Option<&mut A> {
    type Store = Column<A>;
    type Got<'a> = Option<Mut<'a, A>>;
    fn item_at(store, entity) { Some(<&mut A as Item>::item_at(store, entity)) }
}
impl<A> Item for Option<&A> {
    type Store = Column<A>;
    type Got<'a> = Option<&'a A>;
    fn item_at(store, entity) { Some(<&A as Item>::item_at(store, entity)) }
}
// (The columns as a pair of the first and the rest's, so that each is a
// field of its own to borrow.)
impl<H, ..R> Item for (H, ..R) where H: Item, (..R): Item {
    type Store = (H::Store, <(..R) as Item>::Store);
    type Got<'a> = (H::Got<'a>, ..R::Got<'a>);
    fn item_at(store, entity) {
        match(<H as Item>::item_at(&mut store.0, entity)) {
            Some(h) => match(<(..R) as Item>::item_at(&mut store.1, entity)) {
                Some(rest) => let (..r) = rest; Some((h, ..r)),
                None => None
            },
            None => None
        }
    }
}

// The columns a query asks for, taken out of the world while it is used and
// put back after: each is found as a column is.
fn take_now<A, S>(columns: &mut S, now: Int) -> Column<A> where S: Get<A> {
    let mut column = <S as Get<A>>::take(columns);
    column.now = now;
    column
}

pub trait Fill<S>: Item {
    fn fill(&mut S, Int) -> Self::Store
    fn unfill(&mut S, Self::Store)
    // What stands in the query's place once its columns are back.
    fn hollow() -> Self::Store
}
impl<A, S> Fill<S> for &mut A where S: Get<A> {
    fn fill(columns, now) { take_now<A, S>(columns, now) }
    fn unfill(columns, column) { <S as Get<A>>::put(columns, column) }
    fn hollow() { empty_column() }
}
impl<A, S> Fill<S> for &A where S: Get<A> {
    fn fill(columns, now) { take_now<A, S>(columns, now) }
    fn unfill(columns, column) { <S as Get<A>>::put(columns, column) }
    fn hollow() { empty_column() }
}
impl<S> Fill<S> for () {
    fn fill(columns, now) { () }
    fn unfill(columns, store) { () }
    fn hollow() { () }
}
impl<S> Fill<S> for Entity {
    fn fill(columns, now) { () }
    fn unfill(columns, store) { () }
    fn hollow() { () }
}
impl<A, S> Fill<S> for Has<A> where S: Get<A> {
    fn fill(columns, now) { take_now<A, S>(columns, now) }
    fn unfill(columns, column) { <S as Get<A>>::put(columns, column) }
    fn hollow() { empty_column() }
}
impl<A, S> Fill<S> for Option<&mut A> where S: Get<A> {
    fn fill(columns, now) { take_now<A, S>(columns, now) }
    fn unfill(columns, column) { <S as Get<A>>::put(columns, column) }
    fn hollow() { empty_column() }
}
impl<A, S> Fill<S> for Option<&A> where S: Get<A> {
    fn fill(columns, now) { take_now<A, S>(columns, now) }
    fn unfill(columns, column) { <S as Get<A>>::put(columns, column) }
    fn hollow() { empty_column() }
}
impl<H, ..R, S> Fill<S> for (H, ..R) where H: Fill<S>, (..R): Fill<S>, H: Item, (..R): Item, ..R: Item {
    fn fill(columns, now) { (<H as Fill<S>>::fill(columns, now), <(..R) as Fill<S>>::fill(columns, now)) }
    fn unfill(columns, store) {
        let (h, rest) = store;
        <H as Fill<S>>::unfill(columns, h);
        <(..R) as Fill<S>>::unfill(columns, rest)
    }
    fn hollow() { (<H as Fill<S>>::hollow(), <(..R) as Fill<S>>::hollow()) }
}

pub struct Query<Q, Only = (), St = <Q as Item>::Store> { store: St, entities: [Entity] }

// Which entities a query is of, beyond having its columns: `With<T>` those
// that have a `T`, `Without<T>` those that do not, a tuple those all of it
// lets through.
pub struct With<T>(T)
pub struct Without<T>(T)
pub trait Only<S> { fn lets(&S, Entity, Int) -> Bool }
impl<S> Only<S> for () { fn lets(columns, entity, since) { true } }
impl<T, S> Only<S> for With<T> where S: Get<T> { fn lets(columns, entity, since) { <S as Get<T>>::has(columns, entity) } }
impl<T, S> Only<S> for Without<T> where S: Get<T> { fn lets(columns, entity, since) { not(<S as Get<T>>::has(columns, entity)) } }
// Those whose `T` was put in, or changed, since the system last ran (since
// the world began, outside a system).
pub struct Added<T>(T)
pub struct Changed<T>(T)
impl<T, S> Only<S> for Added<T> where S: Get<T> {
    fn lets(columns, entity, since) {
        let column = <S as Get<T>>::column(columns);
        let at = slot_of(column, entity);
        if(at < 0) { false } else { column.added[at] > since }
    }
}
impl<T, S> Only<S> for Changed<T> where S: Get<T> {
    fn lets(columns, entity, since) {
        let column = <S as Get<T>>::column(columns);
        let at = slot_of(column, entity);
        if(at < 0) { false } else { column.changed[at] > since }
    }
}
impl<H, ..R, S> Only<S> for (H, ..R) where H: Only<S>, (..R): Only<S> {
    fn lets(columns, entity, since) {
        if(<H as Only<S>>::lets(columns, entity, since)) { <(..R) as Only<S>>::lets(columns, entity, since) } else { false }
    }
}

impl<Q, N, St> Query<Q, N, St> {
    // What the query asks for, of each entity that has it.
    pub fn for_each(query: &mut Self, f: for<'a> fn(Q::Got<'a>)) where Q: Item<Store = St> {
        let mut i = 0;
        while({ i < len_at(&query.entities) }) {
            match(<Q as Item>::item_at(&mut query.store, query.entities[i])) { Some(got) => f(got), None => () };
            i = i + 1
        }
    }

    // What it asks for of one entity, if the query is of it.
    pub fn get_mut(query: &mut Self, entity: Entity) -> Option<Q::Got<'_>> where Q: Item<Store = St> {
        if(has_entity(&query.entities, entity)) { <Q as Item>::item_at(&mut query.store, entity) } else { None }
    }

    // How many entities it is of.
    pub fn count(query: &mut Self) -> Int where Q: Item<Store = St> {
        let mut n = 0;
        let mut i = 0;
        while({ i < len_at(&query.entities) }) {
            if(is_some(<Q as Item>::item_at(&mut query.store, query.entities[i]))) { n = n + 1 } else { () };
            i = i + 1
        };
        n
    }
}

fn has_entity(entities: &[Entity], entity: Entity) -> Bool {
    let mut i = 0;
    let mut found = false;
    while({ i < len_at(entities) }) {
        if(entities[i].index == entity.index) { if(entities[i].generation == entity.generation) { found = true } else { () } } else { () };
        i = i + 1
    };
    found
}

// A query of a world, that has the world borrowed while it is had. Its
// columns go back when it is let go, by what it was made with: a `Drop`
// knows only the value's type, so how they go back is kept in the value.
pub struct WorldQuery<'w, Q, N, S, St = <Q as Item>::Store> {
    world: &'w mut World<S>,
    query: Query<Q, N, St>,
    put_back: fn(&mut World<S>, St) -> (),
    blank: fn() -> St
}
impl<'w, Q, N, S, St> Drop for WorldQuery<'w, Q, N, S, St> {
    fn drop(q) {
        let store = replace(&mut q.query.store, (q.blank)());
        (q.put_back)(q.world, store)
    }
}

impl<'w, Q, N, S, St> WorldQuery<'w, Q, N, S, St> {
    pub fn for_each(q: &mut Self, f: for<'a> fn(Q::Got<'a>)) where Q: Item<Store = St> { q.query.for_each(f) }
    pub fn get_mut(q: &mut Self, entity: Entity) -> Option<Q::Got<'_>> where Q: Item<Store = St> { q.query.get_mut(entity) }
    pub fn count(q: &mut Self) -> Int where Q: Item<Store = St> { q.query.count() }
}

// A query of exactly one entity: a system that takes one runs only while
// there is exactly one.
pub struct Single<Q, Only = (), St = <Q as Item>::Store> { query: Query<Q, Only, St> }
impl<Q, N, St> Single<Q, N, St> {
    // What it asks for of the one entity.
    pub fn get_mut(single: &mut Self) -> Option<Q::Got<'_>> where Q: Item<Store = St> {
        let entity = single.query.entities[0];
        <Q as Item>::item_at(&mut single.query.store, entity)
    }
    pub fn entity(single: &Self) -> Entity { single.query.entities[0] }
}

// The entities a world has, oldest place first.
pub fn entities<S>(world: &World<S>) -> [Entity] {
    let mut out = [];
    let mut i = 0;
    while({ i < len_at(&world.generations) }) {
        let mut free = false;
        let mut j = 0;
        while({ j < len_at(&world.free) }) { if(world.free[j] == i) { free = true } else { () }; j = j + 1 };
        if(not(free)) { push_at(&mut out, Entity { index: i, generation: world.generations[i] }) } else { () };
        i = i + 1
    };
    out
}

// What a system asks to be done to the world once the systems have run, in
// the order asked: a system has no hold on the world itself. Each is a
// callable given the world when the emit is done.
pub struct Commands<S> { queue: [fn(&mut World<S>) -> ()], next: Int, made: Int }

impl<S> Commands<S> {
    // Do something to the world once the systems have run.
    pub fn queue(commands: &mut Self, f: fn(&mut World<S>) -> ()) { push_at(&mut commands.queue, f) }

    // A new entity with the components given, there once the systems have run.
    pub fn spawn<B>(commands: &mut Self, bundle: B) -> Entity where B: Bundle<S> {
        let entity = reserve(commands);
        push_at(&mut commands.queue, fn(world: &mut World<S>) { let _ = <B as Bundle<S>>::put_all(bundle, world, entity); });
        entity
    }

    // Give an entity components, or other values of ones it has.
    pub fn insert<B>(commands: &mut Self, entity: Entity, bundle: B) where B: Bundle<S> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) {
            if(alive(&*world, entity)) { let _ = <B as Bundle<S>>::put_all(bundle, world, entity); } else { discard(bundle) }
        })
    }

    // Take a component from an entity.
    pub fn remove<T>(commands: &mut Self, entity: Entity) where S: Get<T> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { let _ = remove<T, S>(world, entity); })
    }

    // End an entity.
    pub fn insert_resource<T>(commands: &mut Self, value: T) where S: Holds<T> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { let _ = world.insert_resource(value); })
    }
    pub fn remove_resource<T>(commands: &mut Self) where S: Holds<T> {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { let _ = world.remove_resource<T>(); })
    }
    pub fn despawn(commands: &mut Self, entity: Entity) where S: Columns {
        push_at(&mut commands.queue, fn(world: &mut World<S>) { despawn(world, entity) })
    }
}

pub fn end<S>(commands: &mut Commands<S>, entity: Entity) where S: Columns {
    push_at(&mut commands.queue, fn(world: &mut World<S>) { despawn(world, entity) })
}

// A new entity, there once the systems have run: give it components through
// the columns the system has.
pub fn reserve<S>(commands: &mut Commands<S>) -> Entity {
    let entity = Entity { index: commands.next + commands.made, generation: 0 };
    commands.made = commands.made + 1;
    entity
}

// What was asked, done in the order asked.
fn apply<S>(commands: Commands<S>, world: &mut World<S>) {
    let Commands { queue, next: _, made } = commands;
    let mut k = 0;
    while({ k < made }) { push_at(&mut world.generations, 0); k = k + 1 };
    let mut each = into_iter(queue);
    while({ match(next(&mut each)) { Some(f) => f(world); true, None => false } }) { () }
}

// What a parameter of a system asks for, without the reference: a column
// to change, a column to read, the value emitted, or the commands. Found
// from the parameter's type, so a system is written as any function is.
pub struct Writes<A>(A)
pub struct Read<A>(A)
pub struct Asking
pub struct Querying<Q, Only, St>(Q, Only, St)
pub struct Singling<Q, Only, St>(Q, Only, St)
pub struct Shared<X>(X)
pub struct Owned<X>(X)
pub struct Maybe<X>(X)
pub struct MaybeOwned<X>(X)
pub trait Parameter { type Asks; }
impl<A> Parameter for &mut Column<A> { type Asks = Writes<A>; }
impl<A> Parameter for &Column<A> { type Asks = Read<A>; }
impl<S> Parameter for &mut Commands<S> { type Asks = Asking; }
impl<Q, Only, St> Parameter for &mut Query<Q, Only, St> { type Asks = Querying<Q, Only, St>; }
impl<Q, Only, St> Parameter for &mut Single<Q, Only, St> { type Asks = Singling<Q, Only, St>; }
// (Any other reference is to a resource, or for reading to the value
// emitted, which is told apart where the label is known: the narrower ones
// above are chosen first.)
impl<X> Parameter for &mut X { type Asks = Owned<X>; }
impl<X> Parameter for &X { type Asks = Shared<X>; }
impl<X> Parameter for Option<&mut X> { type Asks = MaybeOwned<X>; }
impl<X> Parameter for Option<&X> { type Asks = Maybe<X>; }

// A system takes a component once. Two of what it asks for are apart unless
// they are one column, which is only if the component has a trait nothing
// has: so such a system does not compile, and the message names the
// component.
pub trait ASystemTakesAComponentOnce {}
pub trait Apart {}
impl<X, Y> Apart for (X, Y) {}
impl<A> Apart for (Writes<A>, Writes<A>) where A: ASystemTakesAComponentOnce {}
impl<A> Apart for (Writes<A>, Read<A>) where A: ASystemTakesAComponentOnce {}
impl<A> Apart for (Read<A>, Writes<A>) where A: ASystemTakesAComponentOnce {}
impl<A> Apart for (Read<A>, Read<A>) where A: ASystemTakesAComponentOnce {}
impl<X> Apart for (Owned<X>, Owned<X>) where X: ASystemTakesAComponentOnce {}
impl<X> Apart for (Owned<X>, Shared<X>) where X: ASystemTakesAComponentOnce {}
impl<X> Apart for (Shared<X>, Owned<X>) where X: ASystemTakesAComponentOnce {}
// One thing asked for, apart from each of a list; and a list each of whose
// members is apart from those after it.
pub trait ApartFrom<X> {}
impl<X> ApartFrom<X> for () {}
impl<X, First, Rest> ApartFrom<X> for (First, Rest) where (X, First): Apart, Rest: ApartFrom<X> {}
pub trait AllApart {}
impl AllApart for () {}
impl<First, Rest> AllApart for (First, Rest) where Rest: ApartFrom<First>, Rest: AllApart {}

// What a system's parameters touch, each a list: a query touches each
// component its items read or write, so two of them, or one and a column,
// are seen apart as any two parameters are.
pub trait Concat<B> { type Out; }
impl<B> Concat<B> for () { type Out = B; }
impl<H, T, B> Concat<B> for (H, T) where T: Concat<B> { type Out = (H, <T as Concat<B>>::Out); }
pub trait ItemTouches { type List; }
impl<A> ItemTouches for &mut A { type List = (Writes<A>, ()); }
impl<A> ItemTouches for &A { type List = (Read<A>, ()); }
impl<A> ItemTouches for Option<&mut A> { type List = (Writes<A>, ()); }
impl<A> ItemTouches for Option<&A> { type List = (Read<A>, ()); }
impl<A> ItemTouches for Has<A> { type List = (Read<A>, ()); }
impl ItemTouches for Entity { type List = (); }
impl ItemTouches for () { type List = (); }
impl<H, ..R> ItemTouches for (H, ..R) where H: ItemTouches, (..R): ItemTouches,
    <H as ItemTouches>::List: Concat<<(..R) as ItemTouches>::List> {
    type List = <<H as ItemTouches>::List as Concat<<(..R) as ItemTouches>::List>>::Out;
}
pub trait Touches { type List; }
impl<A> Touches for Writes<A> { type List = (Writes<A>, ()); }
impl<A> Touches for Read<A> { type List = (Read<A>, ()); }
impl<X> Touches for Owned<X> { type List = (Owned<X>, ()); }
impl<X> Touches for Shared<X> { type List = (Shared<X>, ()); }
impl<X> Touches for Maybe<X> { type List = (Shared<X>, ()); }
impl<X> Touches for MaybeOwned<X> { type List = (Owned<X>, ()); }
impl Touches for Asking { type List = (); }
impl<T> Touches for Localing<T> { type List = (); }
impl<Q, N, St> Touches for Querying<Q, N, St> where Q: ItemTouches { type List = <Q as ItemTouches>::List; }
impl<Q, N, St> Touches for Singling<Q, N, St> where Q: ItemTouches { type List = <Q as ItemTouches>::List; }
pub trait AllTouches { type List; }
impl AllTouches for () { type List = (); }
impl<H, R> AllTouches for (H, R) where H: Touches, R: AllTouches,
    <H as Touches>::List: Concat<<R as AllTouches>::List> {
    type List = <<H as Touches>::List as Concat<<R as AllTouches>::List>>::Out;
}

// A function called with what was gathered for it, its arguments in order.
// What it gives back is what the call gives.
pub trait CallWith<G, O> { fn call_with(&Self, G) -> O }
impl<..P, O, F: Fn<(..P), Output = O>> CallWith<(..P), O> for F {
    fn call_with(f, g) { let (..p) = g; (*f)(..p) }
}

// What a list of things asked for is met with, one at a time: a column is
// taken out of the world, lent, and put back when the function has run. What
// has been gathered so far goes along, and at the end of the list the
// function is called with it; what it gives back comes back up. (None if a
// resource was out of its place, which a system asking for each once rules
// out.)
pub trait Fetch<E, S, Gathered, F, O, Lc> {
    fn fetch(&E, &mut World<S>, &mut Commands<S>, &mut Lc, Gathered, &F) -> Option<O>
}
impl<E, S, ..G, F, O, Lc> Fetch<E, S, (..G), F, O, Lc> for () where F: CallWith<(..G), O> {
    fn fetch(event, world, commands, state, gathered, f) { Some(call_with(f, gathered)) }
}
impl<E, S, ..G, F, O, Lc, A, Rest> Fetch<E, S, (..G), F, O, Lc> for (Writes<A>, Rest)
    where S: Get<A>, Rest: Fetch<E, S, (..G, &mut Column<A>), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        let (..g) = gathered;
        let mut a = take_at<A, S>(world);
        let made = <Rest as Fetch<E, S, (..G, &mut Column<A>), F, O, Lc>>::fetch(event, world, commands, state, (..g, &mut a), f);
        <S as Get<A>>::put(&mut world.columns, a);
        made
    }
}
impl<E, S, ..G, F, O, Lc, A, Rest> Fetch<E, S, (..G), F, O, Lc> for (Read<A>, Rest)
    where S: Get<A>, Rest: Fetch<E, S, (..G, &Column<A>), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        let (..g) = gathered;
        let a = take_at<A, S>(world);
        let made = <Rest as Fetch<E, S, (..G, &Column<A>), F, O, Lc>>::fetch(event, world, commands, state, (..g, &a), f);
        <S as Get<A>>::put(&mut world.columns, a);
        made
    }
}
// A shared reference to the label's type is the value emitted; to any other
// type, a resource.
impl<E, S, ..G, F, O, Lc, Rest> Fetch<E, S, (..G), F, O, Lc> for (Shared<E>, Rest) where Rest: Fetch<E, S, (..G, &E), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        let (..g) = gathered;
        <Rest as Fetch<E, S, (..G, &E), F, O, Lc>>::fetch(event, world, commands, state, (..g, event), f)
    }
}
impl<E, S, ..G, F, O, Lc, X, Rest> Fetch<E, S, (..G), F, O, Lc> for (Shared<X>, Rest)
    where S: Holds<X>, Rest: Fetch<E, S, (..G, &X), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        match(lift<X, S>(&mut world.columns)) {
            Some(value) =>
                let (..g) = gathered;
                let made = <Rest as Fetch<E, S, (..G, &X), F, O, Lc>>::fetch(event, world, commands, state, (..g, &value), f);
                lower<X, S>(&mut world.columns, value);
                made,
            None => discard(gathered); None
        }
    }
}
impl<E, S, ..G, F, O, Lc, X, Rest> Fetch<E, S, (..G), F, O, Lc> for (Owned<X>, Rest)
    where S: Holds<X>, Rest: Fetch<E, S, (..G, &mut X), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        match(lift<X, S>(&mut world.columns)) {
            Some(value) =>
                let (..g) = gathered;
                let mut value = value;
                let made = <Rest as Fetch<E, S, (..G, &mut X), F, O, Lc>>::fetch(event, world, commands, state, (..g, &mut value), f);
                lower<X, S>(&mut world.columns, value);
                made,
            None => discard(gathered); None
        }
    }
}
impl<E, S, ..G, F, O, Lc, X, Rest> Fetch<E, S, (..G), F, O, Lc> for (Maybe<X>, Rest)
    where S: Holds<X>, Rest: Fetch<E, S, (..G, Option<&X>), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        match(lift<X, S>(&mut world.columns)) {
            Some(value) =>
                let (..g) = gathered;
                let made = <Rest as Fetch<E, S, (..G, Option<&X>), F, O, Lc>>::fetch(event, world, commands, state, (..g, Some(&value)), f);
                lower<X, S>(&mut world.columns, value);
                made,
            None => let (..g) = gathered; <Rest as Fetch<E, S, (..G, Option<&X>), F, O, Lc>>::fetch(event, world, commands, state, (..g, None), f)
        }
    }
}
impl<E, S, ..G, F, O, Lc, X, Rest> Fetch<E, S, (..G), F, O, Lc> for (MaybeOwned<X>, Rest)
    where S: Holds<X>, Rest: Fetch<E, S, (..G, Option<&mut X>), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        match(lift<X, S>(&mut world.columns)) {
            Some(value) =>
                let (..g) = gathered;
                let mut value = value;
                let made = <Rest as Fetch<E, S, (..G, Option<&mut X>), F, O, Lc>>::fetch(event, world, commands, state, (..g, Some(&mut value)), f);
                lower<X, S>(&mut world.columns, value);
                made,
            None => let (..g) = gathered; <Rest as Fetch<E, S, (..G, Option<&mut X>), F, O, Lc>>::fetch(event, world, commands, state, (..g, None), f)
        }
    }
}
// (The commands are given once: what comes after has none to give.)
// The entities a query of `Q` with `N` is of, in the world's columns.
fn query_of<Q, N, S>(world: &mut World<S>) -> Query<Q, N, <Q as Item>::Store> where Q: Fill<S>, N: Only<S> {
    let all = entities(&*world);
    let mut found = [];
    let mut i = 0;
    while({ i < len_at(&all) }) {
        if(<N as Only<S>>::lets(&world.columns, all[i], world.since)) { push_at(&mut found, all[i]) } else { () };
        i = i + 1
    };
    Query { store: <Q as Fill<S>>::fill(&mut world.columns, world.tick), entities: found }
}
impl<E, S, ..G, F, O, Lc, Q, N, St, Rest> Fetch<E, S, (..G), F, O, Lc> for (Querying<Q, N, St>, Rest)
    where Q: Item<Store = St>, Q: Fill<S>, N: Only<S>, Rest: Fetch<E, S, (..G, &mut Query<Q, N, St>), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        let (..g) = gathered;
        let mut query = query_of<Q, N, S>(world);
        let made = <Rest as Fetch<E, S, (..G, &mut Query<Q, N, St>), F, O, Lc>>::fetch(event, world, commands, state, (..g, &mut query), f);
        let Query { store, entities } = query;
        <Q as Fill<S>>::unfill(&mut world.columns, store);
        made
    }
}
// (Not run unless the query is of exactly one entity.)
impl<E, S, ..G, F, O, Lc, Q, N, St, Rest> Fetch<E, S, (..G), F, O, Lc> for (Singling<Q, N, St>, Rest)
    where Q: Item<Store = St>, Q: Fill<S>, N: Only<S>, Rest: Fetch<E, S, (..G, &mut Single<Q, N, St>), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        let Query { store, entities: all } = query_of<Q, N, S>(world);
        let mut store = store;
        let mut found = [];
        let mut i = 0;
        while({ i < len_at(&all) }) {
            if(is_some(<Q as Item>::item_at(&mut store, all[i]))) { push_at(&mut found, all[i]) } else { () };
            i = i + 1
        };
        if(len_at(&found) == 1) {
            let mut single = Single { query: Query { store: store, entities: found } };
            let (..g) = gathered;
            let made = <Rest as Fetch<E, S, (..G, &mut Single<Q, N, St>), F, O, Lc>>::fetch(event, world, commands, state, (..g, &mut single), f);
            let Single { query } = single;
            let Query { store, entities } = query;
            <Q as Fill<S>>::unfill(&mut world.columns, store);
            made
        } else {
            <Q as Fill<S>>::unfill(&mut world.columns, store);
            discard(gathered);
            None
        }
    }
}
impl<E, S, ..G, F, O, Lc, Rest> Fetch<E, S, (..G), F, O, Lc> for (Asking, Rest) where Rest: Fetch<E, S, (..G, &mut Commands<S>), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        let (..g) = gathered;
        let mut none = Commands { queue: [], next: 0, made: 0 };
        <Rest as Fetch<E, S, (..G, &mut Commands<S>), F, O, Lc>>::fetch(event, world, &mut none, state, (..g, commands), f)
    }
}

// A system's own state, kept from one run to the next of the registration
// it is of: `count: &mut Local<Int>`, at its type's start the first time.
pub struct Local<T>(pub T)
pub struct Localing<T>(T)
impl<T> Parameter for &mut Local<T> { type Asks = Localing<T>; }
impl<E, S, ..G, F, O, T, Lc, Rest> Fetch<E, S, (..G), F, O, (Local<T>, Lc)> for (Localing<T>, Rest)
    where Rest: Fetch<E, S, (..G, &mut Local<T>), F, O, Lc> {
    fn fetch(event, world, commands, state, gathered, f) {
        let (..g) = gathered;
        <Rest as Fetch<E, S, (..G, &mut Local<T>), F, O, Lc>>::fetch(event, world, commands, &mut state.1, (..g, &mut state.0), f)
    }
}

// What the locals of a list of things asked for start as.
pub trait Locals { type State; fn start() -> Self::State; }
impl Locals for () { type State = (); fn start() { () } }
impl<T: Default, R> Locals for (Localing<T>, R) where R: Locals {
    type State = (Local<T>, R::State);
    fn start() { (Local(default()), <R as Locals>::start()) }
}
impl<X, R> Locals for (X, R) where R: Locals {
    type State = R::State;
    fn start() { <R as Locals>::start() }
}

// Something that runs against a world when `E` is emitted: a function with
// its locals, as it was registered; two systems in a pair run one after the
// other.
pub trait System<E, S> {
    fn run(&mut Self, &E, &mut World<S>, &mut Commands<S>)
}
impl<E, S> System<E, S> for () {
    fn run(nothing, event, world, commands) { () }
}
impl<E, S, X, Y> System<E, S> for (X, Y) where X: System<E, S>, Y: System<E, S> {
    fn run(pair, event, world, commands) {
        <X as System<E, S>>::run(&mut pair.0, event, world, commands);
        <Y as System<E, S>>::run(&mut pair.1, event, world, commands)
    }
}
// A function, of however many parameters, each asking for something, no
// two for the same; and what its locals hold.
// (`last`: the world's time when it last ran, of which it sees what was
// put in or changed after.)
pub struct Sys<F, Lc> { f: F, locals: Lc, last: Int }
impl<E, S, ..P, ..A, L, Ts, F, Lc> System<E, S> for Sys<F, Lc>
    where F: Fn<(..P), Output = ()>, ..P: Parameter<Asks = A>, (..A): Tuple<Nested = L>, L: AllTouches<List = Ts>, Ts: AllApart, L: Fetch<E, S, (), F, (), Lc> {
    fn run(sys, event, world, commands) {
        world.since = sys.last;
        let ran = is_some(<L as Fetch<E, S, (), F, (), Lc>>::fetch(event, world, commands, &mut sys.locals, (), &sys.f));
        world.since = 0;
        // (One that was not run, for want of what it asks, still sees what
        // changed before.)
        if(ran) { sys.last = world.tick; world.tick = world.tick + 1 } else { () }
    }
}

// What is registered under `E` in a world of `S`, made a system: each
// function given its locals, and seen to be one that can run there.
pub trait IntoSystem<E, S> { type Out; fn into_system(Self) -> Self::Out; }
impl<E, S> IntoSystem<E, S> for () { type Out = (); fn into_system(nothing) { () } }
impl<E, S, X, Y> IntoSystem<E, S> for (X, Y) where X: IntoSystem<E, S>, Y: IntoSystem<E, S> {
    type Out = (<X as IntoSystem<E, S>>::Out, <Y as IntoSystem<E, S>>::Out);
    fn into_system(pair) {
        let (x, y) = pair;
        (<X as IntoSystem<E, S>>::into_system(x), <Y as IntoSystem<E, S>>::into_system(y))
    }
}
impl<E, S, ..P, ..A, L, Ts, F, Lc> IntoSystem<E, S> for F
    where F: Fn<(..P), Output = ()>, ..P: Parameter<Asks = A>, (..A): Tuple<Nested = L>, L: AllTouches<List = Ts>, Ts: AllApart,
          L: Locals<State = Lc>, L: Fetch<E, S, (), F, (), Lc> {
    type Out = Sys<F, Lc>;
    fn into_system(f) { Sys { f: f, locals: <L as Locals>::start(), last: 0 } }
}

// A condition: a function whose parameters ask for what a system's may,
// and which says whether something is to run. (Its locals start anew each
// time it is asked.)
pub trait Condition<E, S> {
    fn holds(&Self, &E, &mut World<S>, &mut Commands<S>) -> Bool
}
impl<E, S, ..P, ..A, L, Ts, Lc> Condition<E, S> for fn(..P) -> Bool
    where ..P: Parameter<Asks = A>, (..A): Tuple<Nested = L>, L: AllTouches<List = Ts>, Ts: AllApart, L: Locals<State = Lc>,
          L: Fetch<E, S, (), fn(..P) -> Bool, Bool, Lc> {
    fn holds(f, event, world, commands) {
        let mut locals = <L as Locals>::start();
        match(<L as Fetch<E, S, (), fn(..P) -> Bool, Bool, Lc>>::fetch(event, world, commands, &mut locals, (), f)) {
            Some(answer) => answer,
            None => false
        }
    }
}

// Systems that run only when a condition holds: `friction.run_if(moving)`.
pub struct RunIf<P, C> { systems: P, condition: C }
pub fn run_if<P, C>(systems: P, condition: C) -> RunIf<P, C> { RunIf { systems: systems, condition: condition } }
impl<E, S, P, C> System<E, S> for RunIf<P, C> where P: System<E, S>, C: Condition<E, S> {
    fn run(guarded, event, world, commands) {
        if(<C as Condition<E, S>>::holds(&guarded.condition, event, world, commands)) {
            <P as System<E, S>>::run(&mut guarded.systems, event, world, commands)
        } else { () }
    }
}
impl<E, S, P, C> IntoSystem<E, S> for RunIf<P, C> where P: IntoSystem<E, S>, C: Condition<E, S> {
    type Out = RunIf<<P as IntoSystem<E, S>>::Out, C>;
    fn into_system(guarded) {
        let RunIf { systems, condition } = guarded;
        RunIf { systems: <P as IntoSystem<E, S>>::into_system(systems), condition: condition }
    }
}

// Systems in the order written, however many: `(a, b, c).chain()`. A tuple
// is the pairs it is made of, and a pair of systems is a system.
pub fn chain<T, L>(systems: T) -> L where T: Tuple<Nested = L> { nest(systems) }

// The systems registered under a label.
pub struct On<E, P> { label: fn(E) -> (), systems: P }

// Run what is registered under `E`, in the order it was registered. Of the
// two implementations for a list the first is for one whose first entry is
// under `E`; the second passes over an entry under another label.
pub trait Dispatch<E, S> {
    fn dispatch(&mut Self, &E, &mut World<S>, &mut Commands<S>)
}
impl<E, S> Dispatch<E, S> for () {
    fn dispatch(nothing, event, world, commands) { () }
}
impl<E, P, T, S> Dispatch<E, S> for (On<E, P>, T) where P: System<E, S>, T: Dispatch<E, S> {
    fn dispatch(list, event, world, commands) {
        <T as Dispatch<E, S>>::dispatch(&mut list.1, event, world, commands);
        <P as System<E, S>>::run(&mut list.0.systems, event, world, commands)
    }
}
impl<E, F, P, T, S> Dispatch<E, S> for (On<F, P>, T) where T: Dispatch<E, S> {
    fn dispatch(list, event, world, commands) { <T as Dispatch<E, S>>::dispatch(&mut list.1, event, world, commands) }
}

// What an app is given by a plugin: a type of its own whose `build` adds to
// the app what the plugin has, or a function from an app to an app. What the
// app is then is found from `build` (`type Out = _;`).
pub trait Plugin<S, L> {
    type Out;
    fn build(Self, App<S, L>) -> Self::Out;
}
impl<S, L, Y> Plugin<S, L> for fn(App<S, L>) -> Y {
    type Out = Y;
    fn build(f, app) { f(app) }
}

// A world of columns `S` and the registered systems `L`.
pub struct App<S, L> { pub world: World<S>, systems: L }

impl<S, L> App<S, L> {
    // An app with nothing in its world and no systems.
    pub fn new() -> App<(), ()> {
        App { world: World { columns: (), generations: [], free: [], tick: 1, since: 0 }, systems: () }
    }

    // Give the world a resource.
    pub fn insert_resource<T>(app: Self, value: T) -> App<(Resource<T>, S), L> {
        let App { world, systems } = app;
        let World { columns, generations, free, tick, since } = world;
        App { world: World { columns: (Resource { value: Some(value) }, columns), generations: generations, free: free, tick: tick, since: since }, systems: systems }
    }

    // The resource at its type's start.
    pub fn init_resource<T: Default>(app: Self) -> App<(Resource<T>, S), L> { app.insert_resource(default<T>()) }

    // A place for a resource the world does not have yet. (Upstream finds
    // it from the systems that ask for it.)
    pub fn register_resource<T>(app: Self) -> App<(Resource<T>, S), L> {
        let App { world, systems } = app;
        let World { columns, generations, free, tick, since } = world;
        App { world: World { columns: (Resource { value: None }, columns), generations: generations, free: free, tick: tick, since: since }, systems: systems }
    }

    // Store a component.
    pub fn register<T>(app: Self) -> App<(Column<T>, S), L> {
        let App { world, systems } = app;
        let World { columns, generations, free, tick, since } = world;
        App { world: World { columns: (empty_column(), columns), generations: generations, free: free, tick: tick, since: since }, systems: systems }
    }

    // Register systems under a label, named by a value of it: `Update`.
    pub fn add_systems<E, P, Q>(app: Self, label: E, systems: P) -> App<S, (On<E, Q>, L)> where P: IntoSystem<E, S, Out = Q> {
        app.on<E, P, Q>(systems)
    }

    // Register systems under a label that carries something, named by its
    // type: `.on<Hit>(..)`. A system under it may take `&Hit` first.
    pub fn on<E, P, Q>(app: Self, systems: P) -> App<S, (On<E, Q>, L)> where P: IntoSystem<E, S, Out = Q> {
        let App { world, systems: before } = app;
        App { world: world, systems: (On { label: fn(event: E) { () }, systems: <P as IntoSystem<E, S>>::into_system(systems) }, before) }
    }

    // Add what a plugin has: its components, resources and systems.
    pub fn add_plugins<P>(app: Self, plugin: P) -> <P as Plugin<S, L>>::Out where P: Plugin<S, L> {
        <P as Plugin<S, L>>::build(plugin, app)
    }

    // The app, ready to run.
    pub fn build(app: Self) -> Self { app }

    // Run every system registered under what is emitted, then do what they asked.
    pub fn emit<E>(app: &mut Self, event: &E) where L: Dispatch<E, S>, S: Columns {
        let mut commands = Commands { queue: [], next: len_at(&app.world.generations), made: 0 };
        <L as Dispatch<E, S>>::dispatch(&mut app.systems, event, &mut app.world, &mut commands);
        apply(commands, &mut app.world)
    }
}
