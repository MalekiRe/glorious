// A Model Context Protocol server over a live app (upstream's
// devtools::mcp): JSON-RPC requests sent through a channel, answered when
// the app's loop pumps the session, so every tool sees the app between
// frames. Tools: overview, entity, explain, history, emit, step, what_if,
// why_not, pause, resume (asm reads a binary: covey's `asm` module reads
// objdump's text; here it says so).
use std::reflect::{Described, NoValue, FlagValue, WholeValue, FloatValue, CharValue, TextValue, StructValue, ListValue, OpaqueValue};
use std::thread::{Sender, Receiver, channel, send, try_recv};
use std::text::{join};
use ecs::{App, World, Entity, StepReport, SystemInfo, Dispatch, Fires, Requests, Listed, Columns};
use reflected::{Edits, describe_component, set_field};
use std::vec::{Vec};

// JSON: what requests and replies are written in.
pub enum Json { JNull, JBool(Bool), JNum(Int), JStr(String), JArr(Vec<Json>), JObj(Vec<(String, Json)>) }

// A text's characters, one after another.
fn chars_of(text: &str) -> Vec<char> {
    let mut out = Vec::new();
    let mut it = text.chars();
    let mut more = true;
    while({ more }) { match(it.next()) { Some(c) => Vec::push(&mut out, c), None => more = false } };
    out
}
fn jat(cs: &Vec<char>, i: Int) -> char { if(i < len_at(cs)) { cs[i] } else { '\u{0}' } }
fn jskip(cs: &Vec<char>, i: Int) -> Int { if(std::char::is_space(jat(cs, i))) { jskip(cs, i + 1) } else { i } }
fn jstring(cs: &Vec<char>, i: Int) -> (String, Int) {
    let mut out = String::new();
    let mut j = i + 1;
    while({ if(j < len_at(cs)) { jat(cs, j) != '"' } else { false } }) {
        if(jat(cs, j) == '\\') {
            let e = jat(cs, j + 1);
            out.push(if(e == 'n') { '\n' } else if(e == 't') { '\t' } else { e });
            j = j + 2
        } else { out.push(jat(cs, j)); j = j + 1 }
    };
    (out, j + 1)
}
// A JSON value from `i`, and where it ends. (One function: what an array or
// an object holds is read by it again.)
fn jvalue(cs: &Vec<char>, i: Int) -> (Json, Int) {
    let i = jskip(cs, i);
    let c = jat(cs, i);
    if(if(c == '[') { true } else { c == '{' }) {
        let close = if(c == '[') { ']' } else { '}' };
        let mut items = Vec::new();
        let mut fields = Vec::new();
        let mut j = jskip(cs, i + 1);
        while({ if(j < len_at(cs)) { jat(cs, j) != close } else { false } }) {
            if(c == '{') {
                let (key, k) = jstring(cs, j);
                let k = jskip(cs, k);
                let (v, k2) = jvalue(cs, k + 1);
                Vec::push(&mut fields, (key, v));
                j = jskip(cs, k2)
            } else {
                let (v, k) = jvalue(cs, j);
                Vec::push(&mut items, v);
                j = jskip(cs, k)
            };
            if(jat(cs, j) == ',') { j = jskip(cs, j + 1) } else { () }
        };
        (if(c == '[') { JArr(items) } else { JObj(fields) }, j + 1)
    } else if(c == '"') { let (t, j) = jstring(cs, i); (JStr(t), j) }
    else if(c == 't') { (JBool(true), i + 4) }
    else if(c == 'f') { (JBool(false), i + 5) }
    else if(c == 'n') { (JNull, i + 4) }
    else {
        // (A number: its whole part; what follows a point is left out.)
        let negative = c == '-';
        let mut j = if(negative) { i + 1 } else { i };
        let mut n = 0;
        while({ std::char::is_digit(jat(cs, j)) }) { n = n * 10 + (int(jat(cs, j)) - int('0')); j = j + 1 };
        if(jat(cs, j) == '.') { j = j + 1; while({ std::char::is_digit(jat(cs, j)) }) { j = j + 1 } } else { () };
        (JNum(if(negative) { 0 - n } else { n }), j)
    }
}
pub fn parse_json(text: &str) -> Json { let cs = chars_of(text); let (v, _) = jvalue(&cs, 0); v }
// A text in quotes, what would end or break it written out.
fn jquote(t: &str) -> String {
    let mut out = String::from("\"");
    let cs = chars_of(t);
    let mut i = 0;
    while({ i < len_at(&cs) }) {
        let c = cs[i];
        if(c == '"') { out.push_str("\\\"") } else if(c == '\\') { out.push_str("\\\\") } else if(c == '\n') { out.push_str("\\n") } else { out.push(c) };
        i = i + 1
    };
    out + "\""
}
fn jitems(vs: &Vec<Json>) -> String { let mut out = Vec::new(); let mut i = 0; while({ i < len_at(vs) }) { Vec::push(&mut out, written(&vs[i])); i = i + 1 }; join(out, ",") }
// A JSON value written.
pub fn written(v: &Json) -> String {
    match(v) {
        JNull => String::from("null"),
        JBool(b) => String::from(if(*b) { "true" } else { "false" }),
        JNum(n) => n.to_string(),
        JStr(t) => jquote(t.as_str()),
        JArr(vs) => String::from("[") + jitems(vs).as_str() + "]",
        JObj(fs) =>
            let mut out = Vec::new();
            let mut i = 0;
            while({ i < len_at(fs) }) { let pair = &fs[i]; Vec::push(&mut out, jquote(pair.0.as_str()) + ":" + written(&pair.1).as_str()); i = i + 1 };
            String::from("{") + join(out, ",").as_str() + "}"
    }
}
// A field of an object.
pub fn field<'a>(v: &'a Json, name: &str) -> Option<&'a Json> {
    match(v) { JObj(fs) => field_in(fs, name), _ => None }
}
fn field_in<'a>(fs: &'a Vec<(String, Json)>, name: &str) -> Option<&'a Json> {
    let mut found: Option<&'a Json> = None;
    let mut i = 0;
    while({ i < len_at(fs) }) { let pair = &fs[i]; if(pair.0.as_str() == name) { found = Some(&pair.1) } else { () }; i = i + 1 };
    found
}
fn text_of(v: Option<&Json>) -> String { match(v) { Some(j) => match(j) { JStr(t) => t.clone(), JNum(n) => n.to_string(), _ => String::new() }, None => String::new() } }
fn num_of(v: Option<&Json>, otherwise: Int) -> Int { match(v) { Some(j) => match(j) { JNum(n) => *n, JStr(t) => match(t.as_str().parse_int()) { Some(n) => n, None => otherwise }, _ => otherwise }, None => otherwise } }
// An object of fields named as written.
pub fn object(fields: Vec<(&str, Json)>) -> Json {
    let mut out = Vec::new();
    let mut each = fields.into_iter();
    let mut more = true;
    while({ more }) { match(each.next()) { Some((name, value)) => Vec::push(&mut out, (String::from(name), value)), None => more = false } };
    JObj(out)
}
// A text value.
pub fn jstr(text: &str) -> Json { JStr(String::from(text)) }

// What a described value is written as: `Hp(44)`, `Pos { x: 1 }`.
pub fn value_text(d: &Described) -> String {
    match(d) {
        NoValue => String::from("()"),
        FlagValue(b) => String::from(if(*b) { "true" } else { "false" }),
        WholeValue(n) => n.to_string(),
        FloatValue(f) => f.to_string(),
        CharValue(c) => let mut out = String::from("'"); out.push(*c); out + "'",
        TextValue(t) => jquote(t.as_str()),
        StructValue(name, fs) =>
            // (Placed where every field's name is a number: `Hp(44)`.)
            let mut placed = true;
            let mut i = 0;
            while({ i < len_at(fs) }) { let pair = &fs[i]; if(pair.0.parse_int().is_none()) { placed = false } else { () }; i = i + 1 };
            let mut out = String::from(*name);
            if(len_at(fs) > 0) {
                out.push_str(if(placed) { "(" } else { " { " });
                let mut i = 0;
                while({ i < len_at(fs) }) {
                    let pair = &fs[i];
                    if(i > 0) { out.push_str(", ") } else { () };
                    if(placed) { () } else { out.push_str(pair.0); out.push_str(": ") };
                    out.push_str(value_text(&pair.1).as_str());
                    i = i + 1
                };
                out.push_str(if(placed) { ")" } else { " }" })
            } else { () };
            out,
        ListValue(vs) =>
            let mut out = Vec::new();
            let mut i = 0;
            while({ i < len_at(vs) }) { Vec::push(&mut out, value_text(&vs[i])); i = i + 1 };
            String::from("[") + join(out, ", ").as_str() + "]",
        OpaqueValue(n) => String::from(*n)
    }
}
// The first whole number in a described value.
fn number_in(d: &Described) -> Option<Int> {
    match(d) {
        WholeValue(n) => Some(*n),
        StructValue(_, fs) => if(len_at(fs) > 0) { let pair = &fs[0]; number_in(&pair.1) } else { None },
        _ => None
    }
}
// Whether `n` meets a condition written `< 48`, `>= 3`, `== 1`.
fn meets(n: Int, condition: &str) -> Bool {
    let parts = condition.split_whitespace();
    if(len_at(&parts) < 2) { false } else {
        match(parts[1].parse_int()) {
            Some(m) =>
                let op = parts[0];
                if(op == "<") { n < m } else if(op == "<=") { n <= m } else if(op == ">") { n > m }
                else if(op == ">=") { n >= m } else if(op == "==") { n == m } else if(op == "!=") { n != m } else { false },
            None => false
        }
    }
}
fn entity_text(e: Entity) -> String { e.index.to_string() + "v" + e.generation.to_string().as_str() }

// The other end of the session: requests sent, each with where its reply
// goes.
pub struct Client { requests: Sender<(String, Sender<String>)>, next: Int }
impl Client {
    // A request as written; the reply, once the session is pumped.
    pub fn send(client: &mut Self, text: &str) -> Receiver<String> {
        let (tx, rx) = channel();
        send(&client.requests, (String::from(text), tx));
        rx
    }
    // A tool called with its arguments.
    pub fn call(client: &mut Self, tool: &str, arguments: Json) -> Receiver<String> {
        client.next = client.next + 1;
        let request = object(Vec::from_array([("jsonrpc", jstr("2.0")), ("id", JNum(client.next + 100)), ("method", jstr("tools/call")),
            ("params", object(Vec::from_array([("name", jstr(tool)), ("arguments", arguments)])))]));
        client.send(written(&request).as_str())
    }
}

// The app's side: the labels it may emit or step by name, the frames it
// has emitted, and what each entity's components were at each.
pub struct Session<S, L> {
    requests: Receiver<(String, Sender<String>)>,
    labels: Vec<&'static str>, emits: Vec<fn(&mut App<S, L>) -> ()>, steps: Vec<fn(&mut App<S, L>) -> StepReport>,
    frame: Int, paused: Bool,
    recorded: Vec<(Int, Entity, &'static str, Described)>
}
// The names of systems, in order.
fn system_names(infos: &std::vec::Vec<SystemInfo>) -> std::vec::Vec<String> {
    let mut out = std::vec::Vec::new();
    let mut i = 0;
    while({ i < len_at(infos) }) { let info = &infos[i]; std::vec::Vec::push(&mut out, info.name.clone()); i = i + 1 };
    out
}
pub fn session_channel<S, L>() -> (Session<S, L>, Client) {
    let (tx, rx) = channel();
    (Session { requests: rx, labels: Vec::new(), emits: Vec::new(), steps: Vec::new(), frame: 0, paused: false, recorded: Vec::new() }, Client { requests: tx, next: 0 })
}
fn tool_names() -> Vec<&'static str> { Vec::from_array(["overview", "entity", "explain", "history", "emit", "step", "what_if", "why_not", "asm", "pause", "resume"]) }
fn reply_to(id: Json, result: Json) -> String { written(&object(Vec::from_array([("jsonrpc", jstr("2.0")), ("id", id), ("result", result)]))) }
fn tool_reply(id: Json, text: String, error: Bool) -> String {
    reply_to(id, object(Vec::from_array([("content", JArr(Vec::from_array([object(Vec::from_array([("type", jstr("text")), ("text", JStr(text))]))]))), ("isError", JBool(error))])))
}
fn place_of(labels: &Vec<&'static str>, name: &str) -> Int {
    let mut at = 0 - 1;
    let mut i = 0;
    while({ i < len_at(labels) }) { let label = labels[i]; if(label == name) { at = i } else { () }; i = i + 1 };
    at
}
fn entity_named<S>(world: &World<S>, text: &str) -> Option<Entity> {
    let parts = text.split("v");
    if(len_at(&parts) != 2) { None } else {
        match((parts[0].parse_int(), parts[1].parse_int())) {
            (Some(index), Some(generation)) =>
                let all = world.entities();
                let mut found = None;
                let mut i = 0;
                while({ i < len_at(&all) }) { if(if(all[i].index == index) { all[i].generation == generation } else { false }) { found = Some(all[i]) } else { () }; i = i + 1 };
                found,
            _ => None
        }
    }
}
impl<S, L> Session<S, L> {
    // A label the tools may emit or step, by its name.
    pub fn label<E>(session: &mut Self, name: &'static str, event: E) where L: Dispatch<E, S>, S: Fires<S, L>, S: Requests<S, L>, E: Use<[0, *]> {
        Vec::push(&mut session.labels, name);
        Vec::push(&mut session.emits, fn(app: &mut App<S, L>) { let ev = event; app.emit(&ev) });
        Vec::push(&mut session.steps, fn(app: &mut App<S, L>) -> StepReport { let ev = event; app.step(&ev) })
    }
    // This frame's values of each entity's components, kept.
    fn record(session: &mut Self, app: &App<S, L>) where S: Edits<S> {
        let all = app.world.entities();
        let names = app.world.component_names();
        let mut i = 0;
        while({ i < len_at(&all) }) {
            let mut k = 0;
            while({ k < len_at(&names) }) {
                match(describe_component(&app.world, all[i], names[k])) { Some(d) => Vec::push(&mut session.recorded, (session.frame, all[i], names[k], d)), None => () };
                k = k + 1
            };
            i = i + 1
        }
    }
    // Answer every request sent so far.
    pub fn pump(session: &mut Self, app: &mut App<S, L>) where S: Edits<S>, S: Columns, L: Listed<S> {
        let mut going = true;
        while({ going }) {
            match(try_recv(&session.requests)) {
                Some(request) => let (text, reply) = request; match(Session::answer(session, app, text.as_str())) { Some(r) => send(&reply, r), None => () },
                None => going = false
            }
        }
    }
    fn answer(session: &mut Self, app: &mut App<S, L>, text: &str) -> Option<String> where S: Edits<S>, S: Columns, L: Listed<S> {
        let request = parse_json(text);
        let method = text_of(field(&request, "method"));
        match(field(&request, "id")) {
            None => None,
            Some(id) =>
                let id = match(id) { JNum(n) => JNum(*n), JStr(t) => JStr(t.clone()), _ => JNull };
                if(method.as_str() == "initialize") {
                    Some(reply_to(id, object(Vec::from_array([("protocolVersion", jstr("2025-06-18")), ("capabilities", object(Vec::from_array([("tools", object(Vec::new()))]))),
                        ("serverInfo", object(Vec::from_array([("name", jstr("covey")), ("version", jstr("0.1"))])))]))))
                } else if(method.as_str() == "tools/list") {
                    Some(reply_to(id, object(Vec::from_array([("tools", JArr((std::vec::map(tool_names(), fn(n: &'static str) -> Json { object(Vec::from_array([("name", jstr(n)), ("inputSchema", object(Vec::from_array([("type", jstr("object"))])))])) }))))]))))
                } else if(method.as_str() == "tools/call") {
                    let tool = match(field(&request, "params")) { Some(p) => text_of(field(p, "name")), None => String::new() };
                    let args = match(field(&request, "params")) { Some(p) => match(field(p, "arguments")) { Some(a) => written(a), None => String::from("{}") }, None => String::from("{}") };
                    match(Session::tool(session, app, tool.as_str(), parse_json(args.as_str()))) {
                        Ok(t) => Some(tool_reply(id, t, false)),
                        Err(e) => Some(tool_reply(id, e, true))
                    }
                } else {
                    Some(written(&object(Vec::from_array([("jsonrpc", jstr("2.0")), ("id", id), ("error", object(Vec::from_array([("code", JNum(0 - 32601)), ("message", JStr(String::from("no method `") + method.as_str() + "`"))])))]))))
                }
        }
    }
    fn emit_frames(session: &mut Self, app: &mut App<S, L>, at: Int, count: Int) where S: Edits<S> {
        let mut k = 0;
        while({ k < count }) {
            let f = session.emits[at];
            f(app);
            Session::record(session, &*app);
            session.frame = session.frame + 1;
            k = k + 1
        }
    }
    fn tool(session: &mut Self, app: &mut App<S, L>, name: &str, args: Json) -> Result<String, String> where S: Edits<S>, S: Columns, L: Listed<S> {
        if(name == "pause") { session.paused = true; Ok(String::from("paused: the app waits for `resume`")) }
        else if(name == "resume") { session.paused = false; Ok(String::from("resumed")) }
        else if(name == "overview") {
            let infos = app.system_infos();
            Ok(String::from("frame ") + session.frame.to_string().as_str() + "\n" + len_at(&app.world.entities()).to_string().as_str() + " entities\ncomponents: " + join(app.world.component_names(), ", ").as_str()
                + "\nsystems: " + join(system_names(&infos), ", ").as_str()
                + "\nlabels you can emit/step: " + join(clone(&session.labels), ", ").as_str())
        }
        else if(name == "emit") {
            let label = text_of(field(&args, "label"));
            let count = num_of(field(&args, "count"), 1);
            let at = place_of(&session.labels, label.as_str());
            if(at < 0) { Err(String::from("no label `") + label.as_str() + "`: the labels are " + join(clone(&session.labels), ", ").as_str()) } else {
                Session::emit_frames(session, app, at, count);
                Ok(String::from("emitted `") + label.as_str() + "` " + count.to_string().as_str() + "x; now frame " + session.frame.to_string().as_str())
            }
        }
        else if(name == "step") {
            let label = text_of(field(&args, "label"));
            let at = place_of(&session.labels, label.as_str());
            if(at < 0) { Err(String::from("no label `") + label.as_str() + "`") } else {
                let f = session.steps[at];
                let report = f(app);
                let what = if(report.finished) { String::from("the pass finished") } else if(report.kind == 1) { String::from("system #") + report.index.to_string().as_str() } else { String::from("condition #") + report.index.to_string().as_str() };
                Ok(String::from("step ") + report.index.to_string().as_str() + ": " + what.as_str())
            }
        }
        else if(name == "entity") {
            let id = text_of(field(&args, "id"));
            match(entity_named(&app.world, id.as_str())) {
                Some(e) =>
                    let names = app.world.component_names();
                    let mut lines = Vec::from_array([String::from("entity ") + id.as_str()]);
                    let mut k = 0;
                    while({ k < len_at(&names) }) {
                        match(describe_component(&app.world, e, names[k])) { Some(d) => Vec::push(&mut lines, String::from(names[k]) + " = " + value_text(&d).as_str()), None => () };
                        k = k + 1
                    };
                    Ok(join(lines, "\n")),
                None => Err(String::from("entity ") + id.as_str() + " is not alive")
            }
        }
        else if(name == "explain") {
            let component = text_of(field(&args, "component"));
            let infos = app.system_infos();
            let mut lines = Vec::new();
            let mut i = 0;
            while({ i < len_at(&infos) }) {
                let info = &infos[i];
                if(std::vec::contains(info.writes(), component.as_str())) {
                    let reads = info.reads();
                    Vec::push(&mut lines, String::from("`") + component.as_str() + "` is written by `" + info.name.as_str() + "`; reads: " + (if(len_at(&reads) == 0) { String::from("-") } else { join(clone(&reads), ", ") }).as_str());
                    let mut r = 0;
                    while({ r < len_at(&reads) }) {
                        let mut j = 0;
                        while({ j < len_at(&infos) }) {
                            let other = &infos[j];
                            if(std::vec::contains(other.writes(), reads[r])) { Vec::push(&mut lines, String::from("  `") + reads[r] + "` is written by `" + other.name.as_str() + "`; reads: " + (if(len_at(&other.reads()) == 0) { String::from("-") } else { join(other.reads(), ", ") }).as_str()) } else { () };
                            j = j + 1
                        };
                        r = r + 1
                    }
                } else { () };
                i = i + 1
            };
            if(len_at(&lines) == 0) { Err(String::from("no system writes `") + component.as_str() + "`") } else { Ok(join(lines, "\n")) }
        }
        else if(name == "history") {
            let component = text_of(field(&args, "component"));
            let condition = text_of(field(&args, "condition"));
            let mut found: Option<String> = None;
            let mut i = 0;
            while({ i < len_at(&session.recorded) }) {
                let entry = &session.recorded[i];
                let (f, e, n, d) = (entry.0, entry.1, entry.2, &entry.3);
                if(found.is_none() and { n == component.as_str() }) {
                    match(number_in(d)) { Some(x) => if(meets(x, condition.as_str())) { found = Some(String::from("first at frame ") + f.to_string().as_str() + ": " + entity_text(e).as_str() + " " + n + " = " + value_text(d).as_str()) } else { () }, None => () }
                } else { () };
                i = i + 1
            };
            match(found) { Some(t) => Ok(t), None => Ok(String::from("never, over ") + session.frame.to_string().as_str() + " frames") }
        }
        else if(name == "what_if") {
            let label = text_of(field(&args, "label"));
            let frames = num_of(field(&args, "frames"), 1);
            let at = place_of(&session.labels, label.as_str());
            if(at < 0) { Err(String::from("no label `") + label.as_str() + "`") } else {
                // (A copy of the world to go back to; the edits made, the
                // frames run, what came of it said, and the world put back.)
                let saved = app.world.snapshot();
                let mut edited = Vec::new();
                match(field(&args, "edits")) {
                    Some(list) => match(list) {
                        JArr(edits) =>
                            let mut k = 0;
                            while({ k < len_at(edits) }) {
                                let edit = &edits[k];
                                match(entity_named(&app.world, text_of(field(edit, "entity")).as_str())) {
                                    Some(e) =>
                                        let component = text_of(field(edit, "component"));
                                        let at_field = text_of(field(edit, "field"));
                                        let value = text_of(field(edit, "value"));
                                        discard(set_field(&mut app.world, e, component.as_str(), at_field.as_str(), value.as_str()));
                                        Vec::push(&mut edited, e),
                                    None => ()
                                };
                                k = k + 1
                            },
                        _ => ()
                    },
                    None => ()
                };
                let mut k = 0;
                while({ k < frames }) { let f = session.emits[at]; f(app); k = k + 1 };
                let names = app.world.component_names();
                let mut lines = Vec::from_array([String::from("after ") + frames.to_string().as_str() + " frame(s) of `" + label.as_str() + "`:"]);
                let mut i = 0;
                while({ i < len_at(&edited) }) {
                    let mut n = 0;
                    while({ n < len_at(&names) }) {
                        match(describe_component(&app.world, edited[i], names[n])) { Some(d) => Vec::push(&mut lines, String::from(names[n]) + ": " + value_text(&d).as_str()), None => () };
                        n = n + 1
                    };
                    i = i + 1
                };
                app.world = saved;
                Ok(join(lines, "\n"))
            }
        }
        else if(name == "why_not") {
            let system = text_of(field(&args, "system"));
            match(entity_named(&app.world, text_of(field(&args, "entity")).as_str())) {
                Some(e) => match(app.why_not(system.as_str(), e)) { Some(why) => Ok(if(len_at(&why) == 0) { String::from("nothing: it runs on it") } else { join(why, "\n") }), None => Err(String::from("no system `") + system.as_str() + "`") },
                None => Err(String::from("the entity is not alive"))
            }
        }
        else if(name == "asm") { Err(String::from("asm reads a binary's machine code: covey's `asm` module reads what objdump writes of it")) }
        else { Err(String::from("no tool `") + name + "`") }
    }
}
