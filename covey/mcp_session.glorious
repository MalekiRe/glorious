// Upstream's tests/devtools.rs, `mcp_tools_serve_a_live_app_on_its_own_thread`:
// a Model Context Protocol session over a live app (module `mcp`): JSON-RPC
// requests sent through a channel and answered when the app's loop pumps
// the session; the tools emit frames, say the world, an entity and why a
// component has its value, the first frame a condition held, step one
// system, run frames on a copy with edits (the app untouched), and pause.
// expect:
// true
// true
// true
// emitted `Update` 3x; now frame 3
// 44
// true
// true
// true
// true
// first at frame 1
// step 0: system #
// true
// true
// true
// true
// paused: the app waits for `resume`
// resumed
// 0
use std::vec::{Vec};

pub mod ecs;
pub mod reflected;
mod mcp;

use ecs::{App, Query, chain};
use mcp::{Json, JStr, JNum, JArr, JObj, session_channel, parse_json, field, object, written, jstr};
use std::reflect::{Described};
use std::thread::{Receiver, try_recv};

pub struct Update
impl Use<[0, *]> for Update {}
pub struct Hp(pub Int)
impl Clone for Hp { fn clone(h: &Hp) -> Hp { Hp(h.0) } }
pub struct Damage(pub Int)
impl Clone for Damage { fn clone(d: &Damage) -> Damage { Damage(d.0) } }

fn ramp(q: &mut Query<(&mut Damage,), ()>) { q.for_each() { (mut d,) => d.0 = d.0 + 1; } }
fn apply_damage(q: &mut Query<(&Damage, &mut Hp), ()>) { q.for_each() { d, mut hp => hp.0 = hp.0 - d.0; } }

// The text of a tool's reply; whether it is marked an error.
fn reply_text(r: Receiver<String>) -> String {
    match(try_recv(&r)) {
        Some(t) => let reply = parse_json(t.as_str()); match(field(&reply, "result")) {
            Some(result) => match(field(result, "content")) {
                Some(content) => match(content) { JArr(items) => match(field(&items[0], "text")) { Some(x) => match(x) { JStr(s) => s.clone(), _ => String::new() }, None => String::new() }, _ => String::new() },
                None => String::new()
            },
            None => String::new()
        },
        None => String::from("no reply")
    }
}
fn is_error(r: Receiver<String>) -> Bool { match(try_recv(&r)) { Some(t) => t.as_str().contains("\"isError\":true"), None => false } }
// The first `n` bytes of a text, or all of it.
fn leading(text: &str, n: Int) -> &str { if(text.len() <= n) { text } else { text.slice(0, n) } }
fn args(pairs: Vec<(&str, &str)>) -> Json {
    let mut out = Vec::new();
    let mut each = pairs.into_iter();
    let mut more = true;
    while({ more }) { match(each.next()) { Some((k, v)) => Vec::push(&mut out, (k, jstr(v))), None => more = false } };
    object(out)
}

fn main() -> Int {
    let mut app = App::new().register<Hp>().register<Damage>().add_systems(Update, (ramp, apply_damage).chain()).build();
    let e = app.world.spawn_bundle((Hp(50), Damage(0)));
    let (mut session, mut client) = session_channel();
    session.label("Update", Update);

    let init = client.send("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\"}}");
    let list = client.send("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}");
    let none = client.send("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}");
    session.pump(&mut app);
    say(match(try_recv(&init)) { Some(t) => t.as_str().contains("\"serverInfo\""), None => false });
    let tools = match(try_recv(&list)) { Some(t) => t, None => String::new() };
    let wanted = ["overview", "explain", "history", "step", "what_if", "why_not", "asm"];
    let mut all_there = true;
    let mut k = 0;
    while({ k < 7 }) { let named = String::from("\"name\":\"") + wanted[k] + "\""; if(tools.as_str().contains(named.as_str())) { () } else { all_there = false }; k = k + 1 };
    say(all_there);
    say(match(try_recv(&none)) { Some(_) => false, None => true });

    let emitted = client.call("emit", object(Vec::from_array([("label", jstr("Update")), ("count", JNum(3))])));
    session.pump(&mut app);
    say(reply_text(emitted));
    say(match(app.world.get<Hp>(e)) { Some(h) => h.0, None => 0 - 1 });

    let entity_text = e.index.to_string() + "v" + e.generation.to_string().as_str();
    let entity = entity_text.as_str();
    let overview = client.call("overview", args(Vec::new()));
    let shown_entity = client.call("entity", args(Vec::from_array([("id", entity)])));
    let explained = client.call("explain", args(Vec::from_array([("entity", entity), ("component", "Hp")])));
    let first = client.call("history", args(Vec::from_array([("component", "Hp"), ("condition", "< 48"), ("mode", "first")])));
    let stepped = client.call("step", args(Vec::from_array([("label", "Update")])));
    let missing = client.call("entity", args(Vec::from_array([("id", "999v0")])));
    session.pump(&mut app);
    let overview = reply_text(overview);
    say(overview.as_str().starts_with("frame 3"));
    say(overview.as_str().contains("labels you can emit/step: Update"));
    say(reply_text(shown_entity).as_str().contains("Hp = Hp(44)"));
    let explained = reply_text(explained);
    say(explained.as_str().contains("apply_damage") and { explained.as_str().contains("reads:") } and { explained.as_str().contains("ramp") });
    let first_text = reply_text(first);
    say(leading(first_text.as_str(), 16));
    let stepped_text = reply_text(stepped);
    say(leading(stepped_text.as_str(), 16));
    say(is_error(missing));

    // (With Damage raised, Hp drops further in the edited copy only.)
    let what_if = client.call("what_if", object(Vec::from_array([("label", jstr("Update")), ("frames", JNum(1)),
        ("edits", JArr(Vec::from_array([args(Vec::from_array([("entity", entity), ("component", "Damage"), ("field", "0"), ("value", "20")]))])))])));
    let before = match(app.world.get<Hp>(e)) { Some(h) => h.0, None => 0 - 1 };
    session.pump(&mut app);
    let what_if = reply_text(what_if);
    say(what_if.as_str().contains("Hp: Hp(") and { what_if.as_str().contains("Damage: Damage(") });
    say(match(app.world.get<Hp>(e)) { Some(h) => h.0 == before, None => false });
    say(what_if.as_str().contains("Hp: Hp(23)"));

    let paused = client.call("pause", args(Vec::new()));
    let resumed = client.call("resume", args(Vec::new()));
    session.pump(&mut app);
    say(reply_text(paused));
    say(reply_text(resumed));
    0
}
