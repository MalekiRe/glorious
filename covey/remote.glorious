// Upstream's tests/remote.rs:
// - `bridges_run_at_the_sync_points_position_and_apply_commands_there`.
// - `conflicting_shared_state_and_exclusive_bridges_never_share_a_wave`.
// - `invalid_parameters_fail_and_until_retries_at_later_drives`.
// - `a_loop_runs_once_per_drive_while_a_chain_may_finish_in_one`.
// - `systems_hand_the_remote_to_other_threads`.
// - `envelope_commands_apply_when_the_emit_ends`.
// - `disjoint_bridges_run_in_parallel_in_one_wave`: two bridges that wait
//   for each other (`waits`, at a barrier) touch what is apart, so they run
//   at once, in one wave.
// - `an_envelope_point_runs_beside_disjoint_systems_and_infers_its_components`:
//   an envelope point in a parallel group runs its bridge on a thread of
//   its own beside a system apart from it, the two meeting at a barrier
//   (but for inferring its components: `A` is registered here).
// - `one_point_placed_twice_is_driven_by_one_driver_at_a_time`: a point
//   placed twice in a parallel group, both run at once (read-only
//   envelopes), each request run by one of them (4 threads of 5 bridges,
//   upstream's 8 of 20).
// - `a_waiting_envelope_point_runs_work_published_to_its_worker`: while an
//   envelope point's bridge waits, the systems beside it go on, one of them
//   waiting for another that comes after it (upstream asks which thread ran
//   `y`: here, that the emit ends).
// - `dropping_the_app_or_a_granted_bridge_never_strands_anyone`, its first
//   half: a request queued when its app ends is told the world is closed,
//   as is any asked after. (Its second, of a bridge granted and its future
//   dropped unpolled, is of Rust's futures.)
// Not ported: none further
// (a request is not failed when the app is dropped); the envelope sync
// points that run beside other systems
// (`an_envelope_point_runs_beside_disjoint_systems_and_infers_its_components`,
// `a_waiting_envelope_point_runs_work_published_to_its_worker`);
// `one_point_placed_twice_is_driven_by_one_driver_at_a_time`.
// expect:
// before 0
// after 1
// 5
// --
// 1
// 1
// 1
// --
// invalid
// 0
// 9
// --
// 1
// 1
// 1
// 1
// 1
// 6
// --
// 3
// --
// 0
// 1
// --
// 1 1
// --
// 2 2 2
// --
// 20
// --
// ran
// --
// closed
// closed
// 0
mod ecs;

use core::iter::{into_iter, next};

use ecs::{App, World, Entity, Commands, Query, Single, With, Remote, BridgeError, Schedule, sync_point, waits, parallel, chain};
use std::thread::{scope, Scope, Threads, join, yield_now, AtomicInt, load, store, fetch_add};

use std::vec::{Vec};

struct Update
struct Net
// (An envelope point: what its bridges ask is done when the emit ends.)
struct Reads
impl ecs::Enveloped for Reads { type Env = Query<(&A,), ()>; }
struct Writes
impl ecs::Enveloped for Writes { type Env = Query<(&mut A,), ()>; }
struct A(Int)
struct B(Int)
struct Player

fn before(q: &mut Query<(&A,), ()>) { say(String::from("before ") + q.count().to_string().as_str()) }
fn after(q: &mut Query<(&A,), (With<Player>,)>) { say(String::from("after ") + q.count().to_string().as_str()) }
fn spawn_a<S>(commands: &mut Commands<S>) -> Entity where S: ecs::Get<A>, S: ecs::Get<Player>, S: ecs::Columns, S: ecs::Unlinks<S> { commands.spawn((A(5), Player)) }
fn spawn_a3<S>(commands: &mut Commands<S>) where S: ecs::Get<A>, S: ecs::Columns, S: ecs::Unlinks<S> { discard(commands.spawn((A(3),))) }
fn wait_for<S>(remote: &Remote<S>, n: Int) / {Threads} { while({ remote.waiting() < n }) { yield_now() } }
// A barrier of two: each arrives, and goes on once both have.
fn meet(at: &AtomicInt) / {Threads} {
    let round = load(at) / 2;
    discard(fetch_add(at, 1));
    while({ load(at) < (round + 1) * 2 }) { yield_now() }
}

// `conflicting_shared_state_and_exclusive_bridges_never_share_a_wave`
struct Flight { now: AtomicInt, most: AtomicInt }
impl Use<[0, *]> for Flight {}
// (Upstream's waits here, to give another bridge the chance to overlap;
// a system run at a sync point runs to its end here, so none can, and a
// wait would be a callable that performs `Threads`, which a bridged system
// may not.)
fn enter(flight: &Flight) {
    let now = fetch_add(&flight.now, 1) + 1;
    if(now > load(&flight.most)) { store(&flight.most, now) } else { () };
    discard(fetch_add(&flight.now, 0 - 1))
}

fn needs_player(a: &mut Single<(&A,), (With<Player>,)>) { () }
fn player_a(a: &mut Single<(&A,), (With<Player>,)>) -> Int { match(a.get_mut()) { Some((x,)) => x.0, None => 0 } }

fn main() -> Int {
    let mut app = App::new().register<A>().register<Player>()
        .add_systems(Update, before)
        .add_systems(Update, sync_point(Net))
        .add_systems(Update, after)
        .build();
    let remote = app.world.remote();
    let entity = scope(fn(s: &Scope) -> Entity / {Threads} {
        let mine = remote.share();
        let worker = s.spawn({ let mut m = mine; match(m.bridge(Net, spawn_a)) { Ok(e) => e, Err(_) => Entity::PLACEHOLDER } });
        wait_for(&remote, 1);
        app.emit(&Update);
        join(worker)
    });
    say(match(app.world.get<A>(entity)) { Some(a) => a.0, None => 0 });
    say("--");

    let mut app = App::new().register<A>().register<B>().add_systems(Update, sync_point(Net)).build();
    let remote = app.world.remote();
    discard(app.world.spawn_bundle((A(0), B(0))));
    let mut case = 0;
    while({ case < 3 }) {
        let flight = Flight { now: (AtomicInt::new(0)), most: (AtomicInt::new(0)) };
        scope(fn(s: &Scope) / {Threads} {
            let mut side = 0;
            let mut workers = Vec::new();
            while({ side < 2 }) {
                let mine = remote.share();
                let f = Flight { now: std::thread::share(&flight.now), most: std::thread::share(&flight.most) };
                let k = case;
                Vec::push(&mut workers, s.spawn({
                    let mut m = mine;
                    let g = f;
                    if(k == 0) { discard(m.bridge(Net, fn(q: &mut Query<(&mut A,), ()>) { let h = g; enter(&h) })) }
                    else if(k == 1) { discard(m.bridge(Net, fn(q: &mut Query<(&B,), ()>) { let h = g; enter(&h) })) }
                    else { discard(m.bridge(Net, fn(q: &mut Query<(&B,), ()>) { let h = g; enter(&h) })) }
                }));
                side = side + 1
            };
            wait_for(&remote, 2);
            app.emit(&Update);
            let mut each = into_iter(workers);
            while({ match(next(&mut each)) { Some(w) => join(w); true, None => false } }) { () }
        });
        say(load(&flight.most));
        case = case + 1
    };
    say("--");

    let mut app = App::new().register<A>().register<Player>().add_systems(Update, sync_point(Net)).build();
    let remote = app.world.remote();
    let done = (AtomicInt::new(0));
    scope(fn(s: &Scope) / {Threads} {
        let mine = remote.share();
        let finished = std::thread::share(&done);
        let worker = s.spawn({
            let mut m = mine;
            let mut to = finished;
            match(m.bridge(Net, needs_player)) { Err(BridgeError::Invalid) => say("invalid"), Err(BridgeError::Closed) => say("closed"), Ok(_) => say("ran") };
            let value = ecs::Remote::until(&m, Net, player_a);
            store(&to, value)
        });
        wait_for(&remote, 1);
        app.emit(&Update);
        wait_for(&remote, 1);
        let mut i = 0;
        while({ i < 3 }) { app.emit(&Update); i = i + 1 };
        say(load(&done));
        discard(app.world.spawn_bundle((A(9), Player)));
        while({ load(&done) == 0 }) { app.emit(&Update); yield_now() };
        join(worker)
    });
    say(load(&done));
    say("--");

    let mut app = App::new().register<A>().add_systems(Update, sync_point(Net)).build();
    let remote = app.world.remote();
    let runs = (AtomicInt::new(0));
    let stop = (AtomicInt::new(0));
    scope(fn(s: &Scope) / {Threads} {
        let mine = remote.share();
        let (r, st) = (std::thread::share(&runs), std::thread::share(&stop));
        let worker = s.spawn({
            let mut m = mine;
            let (r2, st2) = (r, st);
            let mut going = true;
            while({ going }) {
                let done = match(m.bridge(Net, fn(q: &mut Query<(&A,), ()>) -> Bool { let (r3, st3) = (r2, st2); discard(fetch_add(&r3, 1)); load(&st3) == 1 })) { Ok(d) => d, Err(_) => true };
                if(done) { going = false } else { () }
            }
        });
        let mut emit = 1;
        while({ emit <= 5 }) {
            wait_for(&remote, 1);
            app.emit(&Update);
            say(if(load(&runs) <= emit) { 1 } else { 0 });
            emit = emit + 1
        };
        store(&stop, 1);
        while({ load(&runs) <= 5 }) { app.emit(&Update); yield_now() };
        join(worker)
    });
    say(load(&runs));
    say("--");

    // `systems_hand_the_remote_to_other_threads`
    let mut app = App::new().register<A>().add_systems(Update, sync_point(Net)).build();
    let remote = app.world.remote();
    discard(app.world.spawn_bundle((A(1),)));
    let got = scope(fn(s: &Scope) -> Int / {Threads} {
        let mine = remote.share();
        let worker = s.spawn({ let mut m = mine; match(m.bridge(Net, fn(q: &mut Query<(&mut A,), ()>) -> Int { q.for_each() { (mut a,) => a.0 = a.0 + 2; }; 3 })) { Ok(n) => n, Err(_) => 0 } });
        wait_for(&remote, 1);
        app.emit(&Update);
        join(worker)
    });
    say(got);
    say("--");

    // `envelope_commands_apply_when_the_emit_ends`
    let seen = AtomicInt::new(0 - 1);
    let during = std::thread::share(&seen);
    let mut app = App::new().register<A>()
        .add_systems(Update, (sync_point(Reads), fn(q: &mut Query<(&A,), ()>) { let d = during; store(&d, q.count()) }))
        .build();
    let remote = app.world.remote();
    scope(fn(s: &Scope) / {Threads} {
        let mine = remote.share();
        let worker = s.spawn({ let mut m = mine; discard(m.bridge(Reads, spawn_a3)) });
        wait_for(&remote, 1);
        app.emit(&Update);
        join(worker)
    });
    say(load(&seen));
    say(app.world.count<A>());
    say("--");

    let mut app = App::new().register<A>().register<B>().add_systems(Update, sync_point(Net)).build();
    let remote = app.world.remote();
    let both = app.world.spawn_bundle((A(0), B(0)));
    let barrier = AtomicInt::new(0);
    scope(fn(s: &Scope) / {Threads} {
        let first = remote.share();
        let second = remote.share();
        let b1 = std::thread::share(&barrier);
        let b2 = std::thread::share(&barrier);
        let one = s.spawn({
            let m = first;
            let at = b1;
            discard(m.bridge(Net, waits(fn(q: &mut Query<(&mut A,), ()>) / {Threads} {
                let b = at;
                meet(&b);
                q.for_each() { (mut a,) => a.0 = a.0 + 1; }
            })))
        });
        let two = s.spawn({
            let m = second;
            let at = b2;
            discard(m.bridge(Net, waits(fn(q: &mut Query<(&mut B,), ()>) / {Threads} {
                let b = at;
                meet(&b);
                q.for_each() { (mut b,) => b.0 = b.0 + 1; }
            })))
        });
        wait_for(&remote, 2);
        app.emit(&Update);
        join(one);
        join(two)
    });
    say((match(app.world.get<A>(both)) { Some(a) => a.0, None => 0 - 1 }).to_string() + " " + (match(app.world.get<B>(both)) { Some(b) => b.0, None => 0 - 1 }).to_string().as_str());
    say("--");

    let meeting = AtomicInt::new(0);
    let met = AtomicInt::new(0);
    let on_system = std::thread::share(&meeting);
    let system_met = std::thread::share(&met);
    let mut app = App::new().register<A>().register<B>()
        .add_systems(Update, parallel((sync_point(Writes), waits(fn(q: &mut Query<(&mut B,), ()>) / {Threads} {
            let b = on_system;
            let m = system_met;
            meet(&b);
            discard(fetch_add(&m, 1));
            q.for_each() { (mut x,) => x.0 = x.0 + 1; }
        }))))
        .build();
    let remote = app.world.remote();
    let entity = app.world.spawn_bundle((A(1), B(1)));
    scope(fn(s: &Scope) / {Threads} {
        let mine = remote.share();
        let at = std::thread::share(&meeting);
        let bridge_met = std::thread::share(&met);
        let worker = s.spawn({
            let m = mine;
            let b = at;
            let c = bridge_met;
            discard(m.bridge(Writes, waits(fn(q: &mut Query<(&mut A,), ()>) / {Threads} {
                let bb = b;
                let cc = c;
                meet(&bb);
                discard(fetch_add(&cc, 1));
                q.for_each() { (mut x,) => x.0 = x.0 + 1; }
            })))
        });
        wait_for(&remote, 1);
        app.emit(&Update);
        join(worker)
    });
    say((match(app.world.get<A>(entity)) { Some(a) => a.0, None => 0 - 1 }).to_string() + " " + (match(app.world.get<B>(entity)) { Some(b) => b.0, None => 0 - 1 }).to_string().as_str() + " " + load(&met).to_string().as_str());
    say("--");

    let mut app = App::new().register<A>().register<B>()
        .add_systems(Update, parallel((sync_point(Reads), sync_point(Reads), fn(q: &mut Query<(&B,), ()>) { () })))
        .build();
    discard(app.world.spawn_bundle((A(1), B(1))));
    let remote = app.world.remote();
    let finished = AtomicInt::new(0);
    let right = AtomicInt::new(0);
    scope(fn(s: &Scope) / {Threads} {
        let mut workers = Vec::new();
        let mut k = 0;
        while({ k < 4 }) {
            let mine = remote.share();
            let f = std::thread::share(&finished);
            let r = std::thread::share(&right);
            Vec::push(&mut workers, s.spawn({
                let m = mine;
                let ff = f;
                let rr = r;
                let mut n = 0;
                while({ n < 5 }) {
                    match(m.bridge(Reads, fn(q: &mut Query<(&A,), ()>) -> Int { let mut sum = 0; q.for_each() { (a,) => sum = sum + a.0; }; sum })) {
                        Ok(1) => discard(fetch_add(&rr, 1)),
                        _ => ()
                    };
                    n = n + 1
                };
                discard(fetch_add(&ff, 1))
            }));
            k = k + 1
        };
        while({ load(&finished) < 4 }) { app.emit(&Update); yield_now() };
        let mut each = into_iter(workers);
        while({ match(next(&mut each)) { Some(w) => join(w); true, None => false } }) { () }
    });
    say(load(&right));
    say("--");

    let started = AtomicInt::new(0);
    let y_ran = AtomicInt::new(0);
    let gate_at = std::thread::share(&started);
    let x_waits = std::thread::share(&y_ran);
    let y_flag = std::thread::share(&y_ran);
    let mut app = App::new().register<A>().register<B>()
        .add_systems(Update, parallel((sync_point(Writes), (
            waits(fn() / {Threads} { let g = gate_at; while({ load(&g) == 0 }) { yield_now() } }),
            parallel((
                waits(fn(q: &mut Query<(&B,), ()>) / {Threads} { let w = x_waits; while({ load(&w) == 0 }) { yield_now() } }),
                fn(q: &mut Query<(&B,), ()>) { let f = y_flag; store(&f, 1) }
            ))
        ).chain())))
        .build();
    let remote = app.world.remote();
    discard(app.world.spawn_bundle((A(0), B(0))));
    scope(fn(s: &Scope) / {Threads} {
        let mine = remote.share();
        let st = std::thread::share(&started);
        let yr = std::thread::share(&y_ran);
        let worker = s.spawn({
            let m = mine;
            let a = st;
            let b = yr;
            discard(m.bridge(Writes, waits(fn(q: &mut Query<(&mut A,), ()>) / {Threads} {
                let aa = a;
                let bb = b;
                store(&aa, 1);
                while({ load(&bb) == 0 }) { yield_now() }
            })))
        });
        wait_for(&remote, 1);
        app.emit(&Update);
        join(worker)
    });
    say(if(load(&y_ran) == 1) { "ran" } else { "not" });
    say("--");

    let app = App::new().register<A>().add_systems(Update, sync_point(Net)).build();
    let remote = app.world.remote();
    let mut held = Some(app);
    scope(fn(s: &Scope) / {Threads} {
        let mine = remote.share();
        let waiter = s.spawn({ let m = mine; match(m.bridge(Net, fn(q: &mut Query<(&A,), ()>) { () })) { Err(BridgeError::Closed) => "closed", Err(_) => "invalid", Ok(_) => "ran" } });
        wait_for(&remote, 1);
        discard(replace(&mut held, None));
        say(join(waiter))
    });
    say(scope(fn(s: &Scope) -> &'static str / {Threads} { match(remote.bridge(Net, fn(q: &mut Query<(&A,), ()>) { () })) { Err(BridgeError::Closed) => "closed", Err(_) => "invalid", Ok(_) => "ran" } }));
    0
}
