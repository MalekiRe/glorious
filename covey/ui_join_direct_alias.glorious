// Upstream's tests/ui/join_direct_alias.rs, refused when compiled: two joins of a one-to-one relation, each way, writing one component.
// expect:
// error containing: SameRow
mod ecs;

use ecs::{App, World, Entity, Query, Relation, OneToMany, OneToOne, ManyToMany, Relates, Sources, To, From, parallel};

struct Update
struct Value(Int)
struct Docked
impl Relation for Docked { type Kind = OneToMany; }
struct Partner
impl Relation for Partner { type Kind = OneToOne; }
struct Likes
impl Relation for Likes { type Kind = ManyToMany; }
fn system(q: &mut Query<(To<Partner, (&mut Value,)>, From<Partner, (&mut Value,)>), ()>) { q.for_each() { pair => discard(pair); } }
fn main() -> Int { let mut app = App::new().relation<Docked>().relation<Partner>().relation<Likes>().register<Value>().add_systems(Update, system).build(); app.emit(&Update); 0 }
