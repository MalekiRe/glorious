// Upstream's examples/simulation.rs: thirty-two active entities integrated
// and decaying over ten frames, a parallel group then a check, all run only
// while a global flag says so; a despawned entity and one whose filter
// component is taken away. (Positions are whole numbers here.)
// expect:
// 10 updates: 32 active entities integrated, health=90, local ticks=10; inactive entity unchanged
// condition skipped the group; resumed after despawn and filter removal with local ticks=11
// 0
mod ecs;

use ecs::{App, World, Entity, Query, Single, Local, With, parallel, chain, run_if};

struct Position(Int)
struct Velocity(Int)
struct Health(Int)
struct Time(Int)
struct Ticks(Int)
struct Running(Bool)
struct Active
struct Global
struct Update

fn integrate(query: &mut Query<(&mut Position, &Velocity), (With<Active>,)>, time: &mut Single<(&Time,), (With<Global>,)>) {
    let dt = match(time.get_mut()) { Some((t,)) => t.0, None => 0 };
    query.for_each() { mut position, velocity => position.0 = position.0 + velocity.0 * dt; }
}
fn decay(query: &mut Query<(&mut Health,), (With<Active>,)>, ticks: &mut Single<(&mut Ticks,), (With<Global>,)>, local: &mut Local<Int>) {
    query.for_each() { (mut health,) => health.0 = if(health.0 > 0) { health.0 - 1 } else { 0 }; };
    local.0 = local.0 + 1;
    let n = local.0;
    match(ticks.get_mut()) { Some((mut t,)) => t.0 = n;, None => () }
}
fn validate(query: &mut Query<(&Position, &Velocity), (With<Active>,)>, ticks: &mut Single<(&Ticks,), (With<Global>,)>) {
    let n = match(ticks.get_mut()) { Some((t,)) => t.0, None => 0 };
    query.for_each() { position, velocity => if(position.0 == velocity.0 * n) { () } else { abort("position is not velocity times ticks") }; }
}
fn running(state: &mut Single<(&Running,), (With<Global>,)>) -> Bool { match(state.get_mut()) { Some((r,)) => r.0, None => false } }

fn get_int<S>(world: &World<S>, e: Entity, which: Int) -> Int where S: ecs::Get<Position>, S: ecs::Get<Health>, S: ecs::Get<Ticks> {
    if(which == 0) { match(world.get<Position>(e)) { Some(p) => p.0, None => 0 - 1 } }
    else if(which == 1) { match(world.get<Health>(e)) { Some(h) => h.0, None => 0 - 1 } }
    else { match(world.get<Ticks>(e)) { Some(t) => t.0, None => 0 - 1 } }
}

fn main() -> Int {
    let mut app = App::new().register<Position>().register<Velocity>().register<Health>().register<Time>().register<Ticks>()
        .register<Running>().register<Active>().register<Global>()
        .add_systems(Update, run_if((parallel((integrate, decay)), validate).chain(), running))
        .build();
    let global = app.world.spawn_bundle((Global, Time(1), Ticks(0), Running(true)));
    let mut entities = [];
    let mut speed = 1;
    while({ speed <= 32 }) { push_at(&mut entities, app.world.spawn_bundle((Position(0), Velocity(speed), Health(100), Active))); speed = speed + 1 };
    let inactive = app.world.spawn_bundle((Position(50), Velocity(3), Health(100)));
    let mut k = 0;
    while({ k < 10 }) { app.emit(&Update); k = k + 1 };
    let mut i = 0;
    while({ i < len_at(&entities) }) {
        if(get_int(&app.world, entities[i], 0) == 10 * (i + 1)) { () } else { abort("position") };
        if(get_int(&app.world, entities[i], 1) == 90) { () } else { abort("health") };
        i = i + 1
    };
    if(get_int(&app.world, inactive, 0) == 50) { () } else { abort("inactive moved") };
    if(get_int(&app.world, inactive, 1) == 100) { () } else { abort("inactive decayed") };
    if(get_int(&app.world, global, 2) == 10) { () } else { abort("ticks") };
    say("10 updates: 32 active entities integrated, health=90, local ticks=10; inactive entity unchanged");

    match(app.world.get_mut<Running>(global)) { Some(mut r) => r.0 = false;, None => () };
    app.emit(&Update);
    if(get_int(&app.world, global, 2) == 10) { () } else { abort("ran while not running") };
    match(app.world.get_mut<Running>(global)) { Some(mut r) => r.0 = true;, None => () };
    discard(app.world.despawn(entities[0]));
    discard(app.world.remove<Active>(entities[1]));
    app.emit(&Update);
    if(match(app.world.get<Position>(entities[0])) { Some(_) => false, None => true }) { () } else { abort("despawned") };
    if(get_int(&app.world, entities[1], 0) == 20) { () } else { abort("filtered out") };
    if(get_int(&app.world, entities[1], 1) == 90) { () } else { abort("filtered health") };
    if(get_int(&app.world, entities[2], 0) == 33) { () } else { abort("third") };
    if(get_int(&app.world, global, 2) == 11) { () } else { abort("ticks 11") };
    say("condition skipped the group; resumed after despawn and filter removal with local ticks=11");
    0
}
