// A small world: things that move and tire.
//
// Systems are plain functions; what each touches is its parameters. They are
// registered under labels, and `emit` runs a label's systems in order: `Update`
// carries nothing, `Hit` how hard. What ends an entity is a command, done once
// the systems have run.
// expect:
// 3
// 2
// 1
// 2
// 12
mod ecs;

use ecs::{App, Plugin, Entity, Mut, Column, Commands, end, run_if, chain, spawn, fold_all, each, Query};

struct Position(Int)
struct Velocity(Int)
struct Health(Int)

// How many have ended: a resource, one for the whole world.
struct Ended(Int)

struct Update
// How much everything is hurt.
struct Hit(Int)

// Everything that moves, moves.
fn integrate(query: &mut Query<(&mut Position, &Velocity)>) {
    query.for_each() { mut position, velocity => position.0 = position.0 + velocity.0; }
}

// What moves, slows.
fn friction(velocities: &mut Column<Velocity>) {
    each(velocities, fn(entity: Entity, velocity: &mut Velocity) {
        velocity.0 = velocity.0 - 1;
    })
}

// Whether anything still moves.
fn moving(velocities: &Column<Velocity>) -> Bool {
    let mut i = 0;
    let mut any = false;
    while({ i < len_at(&velocities.dense) }) {
        if(velocities.dense[i].0 > 0) { any = true } else { () };
        i = i + 1
    };
    any
}

// Nothing leaves the field.
fn bound(positions: &mut Column<Position>) {
    each(positions, fn(entity: Entity, position: &mut Position) {
        if(position.0 > 1000) { position.0 = 1000 } else { () };
    })
}

// Everything that can be hurt is, by what the hit says.
fn wound(hit: &Hit, healths: &mut Column<Health>) {
    let mut i = 0;
    while({ i < len_at(&healths.dense) }) {
        healths.dense[i] = Health(healths.dense[i].0 - hit.0);
        i = i + 1
    }
}

// And what has no health left ends, and is counted.
fn reap<S>(healths: &Column<Health>, commands: &mut Commands<S>, ended: &mut Ended) {
    let mut i = 0;
    while({ i < len_at(&healths.dense) }) {
        if(healths.dense[i].0 <= 0) { commands.end(healths.owners[i]); ended.0 = ended.0 + 1 } else { () };
        i = i + 1
    }
}

// Plugins: one a type of its own, with the components it registers and what
// it builds found from `build`; one a function from an app to an app.
struct Physics
impl<S, L> Plugin<S, L> for Physics where S: ecs::Hidden<(&mut Position, &Velocity), ()> {
    type Components = (Position, Velocity);
    type Out = ecs::App<(ecs::Column<Position>, (ecs::Column<Velocity>, S)), (ecs::On<Update, (ecs::Sys<fn(&mut ecs::Query<(&mut Position, &Velocity), (), (ecs::Column<Position>, (ecs::Column<Velocity>, ()))>) -> (), ()>, (ecs::RunIf<ecs::Sys<fn(&mut ecs::Column<Velocity>) -> (), ()>, ecs::Cond<fn(&ecs::Column<Velocity>) -> Bool, ()>>, (ecs::Sys<fn(&mut ecs::Column<Position>) -> (), ()>, ())))>, L)>;
    fn build(physics: Physics, app: ecs::App<<(Position, Velocity) as ecs::Registers<S>>::Out, L>) -> ecs::App<(ecs::Column<Position>, (ecs::Column<Velocity>, S)), (ecs::On<Update, (ecs::Sys<fn(&mut ecs::Query<(&mut Position, &Velocity), (), (ecs::Column<Position>, (ecs::Column<Velocity>, ()))>) -> (), ()>, (ecs::RunIf<ecs::Sys<fn(&mut ecs::Column<Velocity>) -> (), ()>, ecs::Cond<fn(&ecs::Column<Velocity>) -> Bool, ()>>, (ecs::Sys<fn(&mut ecs::Column<Position>) -> (), ()>, ())))>, L)> {
        app.add_systems(Update, (integrate, friction.run_if(moving), bound).chain())
    }
}

fn combat<T, U>(app: ecs::App<T, U>) -> ecs::App<T, (ecs::On<Hit, ecs::SharedSystem<<(fn(&Hit, &mut ecs::Column<Health>) -> (), (fn(&ecs::Column<Health>, &mut ecs::Commands<T>, &mut Ended) -> (), ())) as ecs::IntoSystem<Hit, T>>::Out>>, U)> where T: ecs::Get<Health>, T: ecs::Holds<Ended>, T: ecs::Columns, T: ecs::Unlinks<T> {
    app.on<Hit>((wound, reap).chain())
}

fn main() -> Int {
    let mut game = App::new()
        .register<Health>()
        .insert_resource(Ended(0))
        .add_plugins(Physics)
        .add_plugins(combat).build();
    game.world.spawn_bundle((Position(0), Velocity(5), Health(3)));
    game.world.spawn_bundle((Position(100), Velocity(7), Health(1)));
    game.world.spawn_bundle((Position(1000), Health(2)));
    print(game.world.count<Health>());
    game.emit(&Update);
    game.emit(&Hit(1));
    print(game.world.count<Health>());
    game.emit(&Update);
    game.emit(&Hit(1));
    print(game.world.count<Health>());
    game.emit(&Update);
    match(game.world.resource<Ended>()) { Some(ended) => print(ended.0), None => () };
    game.world.fold_all(0, fn(sum: Int, position: &Position) -> Int { sum + position.0 })
}

