// A small world: things that move and tire.
//
// Systems are plain functions; what each touches is its parameters. They are
// registered under labels, and `emit` runs a label's systems in order.
// expect:
// 3
// 2
// 2
// 1012
mod ecs;

use ecs::{Entity, Column, app, register, add_systems, add_plugins, chain, emit, spawn, despawn, insert, count, fold_all, each, each2};

struct Position(Int)
struct Velocity(Int)
struct Health(Int)

struct Update
struct Tire

// Everything that moves, moves.
fn integrate(positions: &mut Column<Position>, velocities: &Column<Velocity>) {
    each2(positions, velocities, fn(entity: Entity, position: &mut Position, velocity: &Velocity) {
        position.0 = position.0 + velocity.0;
    })
}

// What moves, slows.
fn friction(velocities: &mut Column<Velocity>) {
    each(velocities, fn(entity: Entity, velocity: &mut Velocity) {
        velocity.0 = velocity.0 - 1;
    })
}

fn tire(healths: &mut Column<Health>) {
    each(healths, fn(entity: Entity, health: &mut Health) {
        health.0 = health.0 - 1;
    })
}

// A plugin: a function from an app to an app.
fn physics(app) {
    app.add_systems(Update, (integrate, friction).chain())
}

fn main() -> Int {
    let mut game = app()
        .register<Position>()
        .register<Velocity>()
        .register<Health>()
        .add_plugins(physics)
        .add_systems(Tire, tire);
    let a = game.world.spawn();
    game.world.insert(a, Position(0)); game.world.insert(a, Velocity(5)); game.world.insert(a, Health(3));
    let b = game.world.spawn();
    game.world.insert(b, Position(100)); game.world.insert(b, Velocity(7)); game.world.insert(b, Health(1));
    let c = game.world.spawn();
    game.world.insert(c, Position(1000)); game.world.insert(c, Health(2));
    print(game.world.count<Health, _>());
    game.emit(Update);
    game.emit(Tire);
    game.world.despawn(b);
    print(game.world.count<Health, _>());
    game.emit(Update);
    print(game.world.count<Position, _>());
    game.emit(Update);
    game.world.fold_all(0, fn(sum: Int, position: &Position) -> Int { sum + position.0 })
}
