// A small world: things that move and tire.
//
// Systems are plain functions; what each touches is its parameters. They are
// registered under labels, and `emit` runs a label's systems in order: `Update`
// carries nothing, `Hit` how hard. What ends an entity is a command, done once
// the systems have run.
// expect:
// 3
// 2
// 1
// 2
// 12
mod ecs;

use ecs::{Entity, Column, Commands, end, app, register, insert_resource, with_resource, add_systems, on, add_plugins, chain, emit, spawn, insert, count, fold_all, each, each2};

struct Position(Int)
struct Velocity(Int)
struct Health(Int)

// How many have ended: a resource, one for the whole world.
struct Ended(Int)

struct Update
// How much everything is hurt.
struct Hit(Int)

// Everything that moves, moves.
fn integrate(positions: &mut Column<Position>, velocities: &Column<Velocity>) {
    each2(positions, velocities, fn(entity: Entity, position: &mut Position, velocity: &Velocity) {
        position.0 = position.0 + velocity.0;
    })
}

// What moves, slows.
fn friction(velocities: &mut Column<Velocity>) {
    each(velocities, fn(entity: Entity, velocity: &mut Velocity) {
        velocity.0 = velocity.0 - 1;
    })
}

// Nothing leaves the field.
fn bound(positions: &mut Column<Position>) {
    each(positions, fn(entity: Entity, position: &mut Position) {
        if(position.0 > 1000) { position.0 = 1000 } else { () };
    })
}

// Everything that can be hurt is, by what the hit says.
fn wound(hit: &Hit, healths: &mut Column<Health>) {
    let mut i = 0;
    while({ i < len_at(&healths.dense) }) {
        healths.dense[i] = Health(healths.dense[i].0 - hit.0);
        i = i + 1
    }
}

// And what has no health left ends, and is counted.
fn reap(healths: &Column<Health>, commands: &mut Commands, ended: &mut Ended) {
    let mut i = 0;
    while({ i < len_at(&healths.dense) }) {
        if(healths.dense[i].0 <= 0) { commands.end(healths.owners[i]); ended.0 = ended.0 + 1 } else { () };
        i = i + 1
    }
}

// A plugin: a function from an app to an app.
fn physics(app) {
    app.add_systems(Update, (integrate, friction, bound).chain())
}

fn combat(app) {
    app.on<Hit>((wound, reap).chain())
}

fn main() -> Int {
    let mut game = app()
        .register<Position>()
        .register<Velocity>()
        .register<Health>()
        .insert_resource(Ended(0))
        .add_plugins(physics)
        .add_plugins(combat);
    let a = game.world.spawn();
    game.world.insert(a, Position(0)); game.world.insert(a, Velocity(5)); game.world.insert(a, Health(3));
    let b = game.world.spawn();
    game.world.insert(b, Position(100)); game.world.insert(b, Velocity(7)); game.world.insert(b, Health(1));
    let c = game.world.spawn();
    game.world.insert(c, Position(1000)); game.world.insert(c, Health(2));
    print(game.world.count<Health>());
    game.emit(Update);
    game.emit(Hit(1));
    print(game.world.count<Health>());
    game.emit(Update);
    game.emit(Hit(1));
    print(game.world.count<Health>());
    game.emit(Update);
    match(game.world.with_resource(fn(ended: &mut Ended) -> Int { ended.0 })) { Some(n) => print(n), None => () };
    game.world.fold_all(0, fn(sum: Int, position: &Position) -> Int { sum + position.0 })
}
