// Upstream's tests/devtools.rs, `values_are_described_and_edited_without_debug`:
// a component described by its name and its fields set from text, through
// reflection (`std::reflect`), with what is private (module `reflected`).
// expect:
// Armor{ value: 3 tough: false }
// value tough
// 200
// out of range
// true
// 200 true
// true
// 7
// no component `Nothing` in this world
// 0
use std::vec::{Vec};

pub mod ecs;
mod reflected;

use ecs::{App, World, Entity};
use reflected::{describe_component, editable_fields, set_field};
use std::reflect::{Described, NoValue, FlagValue, WholeValue, FloatValue, CharValue, TextValue, StructValue, ListValue, OpaqueValue};

pub struct Armor { pub value: u8, tough: Bool }
pub struct Hp(pub Int)

fn shown(d: Described) -> String {
    match(d) {
        NoValue => String::from("()"),
        FlagValue(b) => String::from(if(b) { "true" } else { "false" }),
        WholeValue(n) => n.to_string(),
        FloatValue(_) => String::from("float"),
        CharValue(_) => String::from("char"),
        TextValue(t) => t,
        StructValue(name, fields) =>
            let mut out = String::from(name) + "{";
            let mut each = fields.into_iter();
            let mut more = true;
            while({ more }) { match(each.next()) { Some((n, v)) => out.push_str(" "); out.push_str(n); out.push_str(": "); out.push_str(shown(v).as_str()), None => more = false } };
            out + " }",
        ListValue(_) => String::from("list"),
        OpaqueValue(n) => String::from("opaque ") + n
    }
}
fn said(r: Result<Described, String>) -> String { match(r) { Ok(d) => shown(d), Err(e) => e } }

fn main() -> Int {
    let mut app = App::new().register<Armor>().register<Hp>().build();
    let e = app.world.spawn_bundle((Armor { value: 3, tough: false }, Hp(1)));
    say(match(app.world.describe_component(e, "Armor")) { Some(d) => shown(d), None => String::from("none") });
    say(match(app.world.editable_fields("Armor")) { Some(fs) => std::text::join(fs, " "), None => String::from("none") });
    let before = app.world.tick();
    say(said(app.world.set_field(e, "Armor", "value", "200")));
    say(said(app.world.set_field(e, "Armor", "value", "300")));
    say(said(app.world.set_field(e, "Armor", "tough", "true")));
    match(app.world.get<Armor>(e)) { Some(a) => say(int(a.value).to_string() + " " + (if(a.tough) { "true" } else { "false" })), None => () };
    say(if(len_at(&app.world.changes_since<Armor>(before)) == 1) { "true" } else { "false" });
    say(said(app.world.set_field(e, "Hp", "0", "7")));
    say(said(app.world.set_field(e, "Nothing", "0", "7")));
    0
}
