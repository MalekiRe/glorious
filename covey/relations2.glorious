// Upstream's tests/relations.rs, the tests relations.glorious does not follow:
// - `many_to_many_matches_a_set_model_through_relates_unrelates_and_despawns`
//   (a fixed sequence of relates, unlinks and despawns against a set model).
// - `linked_hierarchies_reparent_and_despawn_recursively`.
// - `one_to_one_displaces_previous_partners_and_unlinks_on_removal`.
// - `commands_relate_freshly_spawned_entities`.
// - `fragmenting_one_to_many_groups_each_targets_sources_into_tables` and
//   `fragmenting_many_to_many_keys_tables_by_target_sets`: who relates to
//   whom; covey keeps no tables by target, so what they say of tables is
//   what queries see.
// - `descendants_come_parents_first_for_both_storages`.
// - `linked_fragmenting_relations_despawn_subtrees_and_terminate_on_cycles`.
// - `many_to_many_relations_allow_self_edges`.
// `churning_fragmenting_targets_reuses_dead_tables` and
// `fragmenting_bundle_values_become_pairs` are in fragmenting.glorious.
// expect:
// [1, 2]
// [0]
// [2]
// []
// --
// 4
// 3
// 0
// 0
// 1
// 2
// --
// 0
// 2
// 0
// 0
// 1
// --
// 3
// --
// [0, 2, 4]
// [1, 3, 5]
// [2, 4]
// [0, 1, 3, 5]
// --
// [0, 1]
// [1, 2]
// [0]
// []
// --
// 6
// 1
// --
// 1
// 1
// 1
// --
// 1
// 0
mod ecs;

use core::option::{is_some, is_none};

use ecs::{App, World, Entity, Commands, Query, Relation, ChildOf, OneToOne, OneToMany, ManyToMany, Relates, Sources};
use std::vec::sort;

struct Update
struct Name(Int)
struct Likes
impl Relation for Likes { type Kind = ManyToMany; }
struct Partner
impl Relation for Partner { type Kind = OneToOne; }
struct InSquad
impl Relation for InSquad { type Kind = OneToMany; }
struct Tagged
impl Relation for Tagged { type Kind = ManyToMany; }
struct Mount
impl Relation for Mount { type Kind = OneToMany; }

fn names<S>(world: &World<S>, es: [Entity]) -> [Int] where S: ecs::Get<Name> {
    sort(fold(es, [], fn(out: [Int], e: Entity) -> [Int] { match(world.get<Name>(e)) { Some(n) => push(out, n.0), None => out } }))
}
fn flag(b: Bool) { if(b) { say(1) } else { say(0) } }

fn family<S>(commands: &mut Commands<S>) where S: ecs::Get<Name>, S: ecs::Columns, S: ecs::Unlinks<S>, S: ecs::Get<ecs::Relates<ecs::ChildOf>>, S: ecs::Get<ecs::Sources<ecs::ChildOf>> {
    let parent = commands.spawn((Name(0),));
    let mut i = 1;
    while({ i <= 3 }) { let child = commands.spawn((Name(i),)); commands.relate(child, ChildOf, parent); i = i + 1 }
}

fn main() -> Int {
    let mut world = App::new().register<Name>().relation<Likes>().build().into_world();
    let a = world.spawn_bundle((Name(0),));
    let b = world.spawn_bundle((Name(1),));
    let c = world.spawn_bundle((Name(2),));
    discard(world.relate(a, Likes, b));
    discard(world.relate(a, Likes, c));
    discard(world.relate(c, Likes, a));
    say(names(&world, world.targets<Likes>(a)));
    say(names(&world, world.sources<Likes>(b)));
    discard(world.unlink<Likes>(a, b));
    discard(world.relate(b, Likes, b));
    discard(world.despawn(b));
    say(names(&world, world.sources<Likes>(a)));
    say(names(&world, world.sources<Likes>(b)));
    say("--");

    let mut world = App::new().register<Name>().relation<ChildOf>().build().into_world();
    let root = world.spawn_bundle((Name(0),));
    let other = world.spawn_bundle((Name(1),));
    let mut children = [];
    let mut i = 2;
    while({ i < 6 }) { let child = world.spawn_bundle((Name(i),)); discard(world.relate(child, ChildOf, root)); children = push(children, child); i = i + 1 };
    let grandchild = world.spawn_bundle((Name(9),));
    discard(world.relate(grandchild, ChildOf, children[1]));
    say(len_at(&world.sources<ChildOf>(root)));
    discard(world.relate(children[0], ChildOf, other));
    say(len_at(&world.sources<ChildOf>(root)));
    world.despawn_linked<ChildOf>(root);
    flag(world.contains(children[1]));
    flag(world.contains(grandchild));
    flag(if(world.contains(children[0])) { world.contains(other) } else { false });
    say(world.query<(&Name,)>().count());
    say("--");

    let mut world = App::new().register<Name>().relation<Partner>().build().into_world();
    let a = world.spawn_bundle((Name(0),));
    let b = world.spawn_bundle((Name(1),));
    let c = world.spawn_bundle((Name(2),));
    discard(world.relate(a, Partner, b));
    // `b` had one already: `a` is let go.
    discard(world.relate(c, Partner, b));
    flag(is_some(world.target<Partner>(a)));
    say(names(&world, world.sources<Partner>(b))[0]);
    // `c` moves to `a`; `b` is left with none.
    discard(world.relate(c, Partner, a));
    say(len_at(&world.sources<Partner>(b)));
    discard(world.unrelate<Partner>(c));
    say(len_at(&world.sources<Partner>(a)));
    discard(world.relate(a, Partner, b));
    discard(world.despawn(b));
    flag(if(world.contains(a)) { is_none(world.target<Partner>(a)) } else { false });
    say("--");

    let mut app = App::new().register<Name>().relation<ChildOf>().add_systems(Update, family).build();
    app.emit(&Update);
    let mut most = 0;
    let mut roots = [];
    app.world.query<(Entity, &Name)>().for_each() { e, n => if(n.0 == 0) { roots = push(roots, e) } else { () }; };
    let mut r = 0;
    while({ r < len_at(&roots) }) { most = len_at(&app.world.sources<ChildOf>(roots[r])); r = r + 1 };
    say(most);
    say("--");

    let mut world = App::new().register<Name>().relation<InSquad>().build().into_world();
    let alpha = world.spawn_bundle((Name(100),));
    let beta = world.spawn_bundle((Name(200),));
    let mut members = [];
    let mut i = 0;
    while({ i < 6 }) { let m = world.spawn_bundle((Name(i),)); discard(world.relate(m, InSquad, if(i % 2 == 0) { alpha } else { beta })); members = push(members, m); i = i + 1 };
    say(names(&world, world.sources<InSquad>(alpha)));
    say(names(&world, world.sources<InSquad>(beta)));
    discard(world.relate(members[0], InSquad, beta));
    say(names(&world, world.sources<InSquad>(alpha)));
    say(names(&world, world.sources<InSquad>(beta)));
    say("--");

    let mut world = App::new().register<Name>().relation<Tagged>().build().into_world();
    let red = world.spawn_bundle((Name(100),));
    let blue = world.spawn_bundle((Name(200),));
    let mut things = [];
    let mut i = 0;
    while({ i < 4 }) { things = push(things, world.spawn_bundle((Name(i),))); i = i + 1 };
    discard(world.relate(things[0], Tagged, red));
    discard(world.relate(things[1], Tagged, red));
    discard(world.relate(things[1], Tagged, blue));
    discard(world.relate(things[2], Tagged, blue));
    say(names(&world, world.sources<Tagged>(red)));
    say(names(&world, world.sources<Tagged>(blue)));
    discard(world.unlink<Tagged>(things[1], red));
    say(names(&world, world.sources<Tagged>(red)));
    discard(world.despawn(blue));
    say(names(&world, world.targets<Tagged>(things[2])));
    say("--");

    let mut world = App::new().register<Name>().relation<ChildOf>().build().into_world();
    let mut ns = [];
    let mut i = 0;
    while({ i < 7 }) { ns = push(ns, world.spawn_bundle((Name(i),))); i = i + 1 };
    let links = [(1, 0), (2, 0), (3, 1), (4, 1), (5, 2), (6, 5)];
    let mut i = 0;
    while({ i < len_at(&links) }) { let (child, parent) = links[i]; discard(world.relate(ns[child], ChildOf, ns[parent])); i = i + 1 };
    let order = world.descendants<ChildOf>(ns[0]);
    say(len_at(&order));
    let at = fn(e: Entity) -> Int { let mut k = 0 - 1; let mut j = 0; while({ j < len_at(&order) }) { if(order[j] == e) { k = j }; j = j + 1 }; k };
    let mut parents_first = true;
    let mut i = 0;
    while({ i < len_at(&links) }) { let (child, parent) = links[i]; if(parent != 0) { if(at(ns[parent]) > at(ns[child])) { parents_first = false } else { () } }; i = i + 1 };
    flag(parents_first);
    say("--");

    let mut world = App::new().register<Name>().relation<Mount>().build().into_world();
    let mut ns = [];
    let mut i = 0;
    while({ i < 6 }) { ns = push(ns, world.spawn_bundle((Name(i),))); i = i + 1 };
    discard(world.relate(ns[1], Mount, ns[0]));
    discard(world.relate(ns[2], Mount, ns[1]));
    discard(world.relate(ns[3], Mount, ns[0]));
    discard(world.relate(ns[4], Mount, ns[3]));
    world.despawn_linked<Mount>(ns[0]);
    flag(if(world.contains(ns[2])) { false } else { if(world.contains(ns[4])) { false } else { world.contains(ns[5]) } });
    let a = world.spawn_bundle((Name(7),));
    let b = world.spawn_bundle((Name(8),));
    discard(world.relate(a, Mount, b));
    discard(world.relate(b, Mount, a));
    world.despawn_linked<Mount>(a);
    flag(if(world.contains(a)) { false } else { if(world.contains(b)) { false } else { true } });
    flag(world.query<(&Name,)>().count() == 1);
    say("--");

    let mut world = App::new().register<Name>().relation<Likes>().build().into_world();
    let me = world.spawn_bundle((Name(0),));
    discard(world.relate(me, Likes, me));
    flag(names(&world, world.targets<Likes>(me)) == [0]);
    0
}
