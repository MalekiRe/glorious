// Upstream's tests/devtools.rs, `explains_why_components_exist_and_why_systems_are_ordered`:
// each system with where it is among the app's (`parallel[0] > chain[0]`)
// and what it writes; why one runs before another, or that nothing orders
// them; and why the world stores a component: registered, required by
// another, used by systems and how. (Covey's components are registered,
// not inferred from the systems: `Wings` is registered too.)
// expect:
// parallel[0] > chain[0]
// Damage
// true
// true
// true
// true
// true
// true
// 0
mod ecs;

use ecs::{App, Query, Requires, SystemInfo, parallel, chain};
use core::value::Default;

struct Update
struct Damage(Int)
struct Hp(Int)
struct Wings
impl Default for Wings { fn default() -> Wings { Wings } }
struct Bird
impl Requires for Bird { type Required = (Wings,); }

fn ramp(q: &mut Query<(&mut Damage,), ()>) { q.for_each() { (mut d,) => d.0 = d.0 + 1; } }
fn apply_damage(q: &mut Query<(&Damage, &mut Hp), ()>) { q.for_each() { d, mut hp => hp.0 = hp.0 - d.0; } }
fn birds(q: &mut Query<(&Bird,), ()>) { () }

fn id_of(infos: &[SystemInfo], name: Str) -> Int {
    let mut i = 0;
    let mut found = 0 - 1;
    while({ i < len_at(infos) }) { if(infos[i].name == name) { found = infos[i].id } else { () }; i = i + 1 };
    found
}
fn any_says(reasons: &Option<[Str]>, part: Str) -> Bool {
    match(reasons) { Some(rs) => std::vec::any(clone(rs), fn(r: Str) -> Bool { std::text::contains(r, part) }), None => false }
}
fn shown(b: Bool) -> Str { if(b) { "true" } else { "false" } }

fn main() -> Int {
    let app = App::new().register<Damage>().register<Hp>().register<Wings>().register<Bird>()
        .add_systems(Update, parallel(((ramp, apply_damage).chain(), birds)))
        .build();
    let infos = app.system_infos();
    let ramp_id = id_of(&infos, "ramp");
    let apply_id = id_of(&infos, "apply_damage");
    let birds_id = id_of(&infos, "birds");
    say(infos[ramp_id].path);
    say(std::text::join(infos[ramp_id].writes(), " "));
    say(shown(match(app.why_order(ramp_id, apply_id)) { Some(why) => std::text::contains(why, "chain"), None => false }));
    say(shown(match(app.why_order(apply_id, birds_id)) { Some(why) => std::text::starts_with(why, "no order"), None => false }));
    say(shown(any_says(&app.why_component("Wings"), "`Bird` requires it")));
    let bird = app.why_component("Bird");
    say(shown(match(&bird) { Some(rs) => std::vec::any(clone(rs), fn(r: Str) -> Bool { std::text::starts_with(r, "`register::<Bird>`") }), None => false }));
    say(shown(any_says(&bird, "uses it: Read")));
    say(shown(match(app.why_component("Hp")) { Some(rs) => std::vec::any(rs, fn(r: Str) -> Bool { if(std::text::contains(r, "apply_damage")) { std::text::contains(r, "Write") } else { false } }), None => false }));
    0
}
