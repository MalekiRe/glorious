// Upstream's tests/devtools.rs, `explains_why_components_exist_and_why_systems_are_ordered`:
// each system with where it is among the app's (`parallel[0] > chain[0]`)
// and what it writes; why one runs before another, or that nothing orders
// them; and why the world stores a component: registered, required by
// another, used by systems and how. (Covey's components are registered,
// not inferred from the systems: `Wings` is registered too.)
// expect:
// parallel[0] > chain[0]
// Damage
// true
// true
// true
// true
// true
// true
// 0
mod ecs;

use ecs::{App, Query, Requires, SystemInfo, parallel, chain};
use core::value::Default;

struct Update
struct Damage(Int)
struct Hp(Int)
struct Wings
impl Default for Wings { fn default() -> Wings { Wings } }
struct Bird
impl Requires for Bird { type Required = (Wings,); }

fn ramp(q: &mut Query<(&mut Damage,), ()>) { q.for_each() { (mut d,) => d.0 = d.0 + 1; } }
fn apply_damage(q: &mut Query<(&Damage, &mut Hp), ()>) { q.for_each() { d, mut hp => hp.0 = hp.0 - d.0; } }
fn birds(q: &mut Query<(&Bird,), ()>) { () }

fn id_of(infos: &Vec<SystemInfo>, name: &str) -> Int {
    let mut i = 0;
    let mut found = 0 - 1;
    while({ i < len_at(infos) }) { let info = &infos[i]; if(info.name.as_str() == name) { found = info.id } else { () }; i = i + 1 };
    found
}
// Whether one of the reasons has a text in it.
fn any_says(reasons: &Option<std::vec::Vec<String>>, part: &str) -> Bool {
    match(reasons) {
        Some(rs) =>
            let mut found = false;
            let mut i = 0;
            while({ i < len_at(rs) }) { let r = &rs[i]; if(r.as_str().contains(part)) { found = true } else { () }; i = i + 1 };
            found,
        None => false
    }
}
// Whether one of the reasons begins with a text.
fn any_begins(reasons: &Option<std::vec::Vec<String>>, start: &str) -> Bool {
    match(reasons) {
        Some(rs) =>
            let mut found = false;
            let mut i = 0;
            while({ i < len_at(rs) }) { let r = &rs[i]; if(r.as_str().starts_with(start)) { found = true } else { () }; i = i + 1 };
            found,
        None => false
    }
}

fn main() -> Int {
    let app = App::new().register<Damage>().register<Hp>().register<Wings>().register<Bird>()
        .add_systems(Update, parallel(((ramp, apply_damage).chain(), birds)))
        .build();
    let infos = app.system_infos();
    let ramp_id = id_of(&infos, "ramp");
    let apply_id = id_of(&infos, "apply_damage");
    let birds_id = id_of(&infos, "birds");
    let ramp_info = &infos[ramp_id];
    say(&ramp_info.path);
    say(std::text::join(ramp_info.writes(), " "));
    say(match(app.why_order(ramp_id, apply_id)) { Some(why) => why.as_str().contains("chain"), None => false });
    say(match(app.why_order(apply_id, birds_id)) { Some(why) => why.as_str().starts_with("no order"), None => false });
    say(any_says(&app.why_component("Wings"), "`Bird` requires it"));
    let bird = app.why_component("Bird");
    say(any_begins(&bird, "`register::<Bird>`"));
    say(any_says(&bird, "uses it: Read"));
    let hp = app.why_component("Hp");
    say(any_says(&hp, "`apply_damage` uses it: Write"));
    0
}
