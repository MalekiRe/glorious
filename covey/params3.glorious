// Upstream's tests/params.rs, three more of the file:
// - `structural_filters_apply_and_or_without_and_required_data`: `With`,
//   `Without`, `Or` and filters of several, of entities made of every mix.
// - `tuples_and_chains_run_conflicting_systems_in_registration_order`.
// - `exclusive_system_can_change_structure_before_a_typed_system`.
// expect:
// 1 3 5 7
// 0 2 4 6
// 1 5
// 3
// 1 2 3 5 6 7
// 1 2 3
//
// --
// 30
// 291
// --
// 11
// 11
// 21
// 0
mod ecs;

use ecs::{App, World, Entity, Query, Single, With, Without, Or, exclusive, chain};
use std::vec::sort;

struct Update
struct Position(Int)
struct Tag
struct Other
struct Global
struct Value(Int)

fn shown(values: [Int]) -> Str { std::text::join(std::vec::map(sort(values), fn(v: Int) -> Str { show(v) }), " ") }
fn values<F, S>(world: &mut World<S>) -> Str where S: ecs::Get<Position>, S: ecs::Hidden<(&Position,), F>, F: ecs::Only<S> {
    let mut out = [];
    world.query_filtered<(&Position,), F>().for_each() { (p,) => out = push(out, p.0); };
    shown(out)
}

fn add(value: &mut Single<(&mut Value,), ()>) { match(value.get_mut()) { Some((mut v,)) => v.0 = v.0 + 2;, None => () } }
fn multiply(value: &mut Single<(&mut Value,), ()>) { match(value.get_mut()) { Some((mut v,)) => v.0 = v.0 * 3;, None => () } }
fn subtract(value: &mut Single<(&mut Value,), ()>) { match(value.get_mut()) { Some((mut v,)) => v.0 = v.0 - 1;, None => () } }

fn toggle<S>(world: &mut World<S>) where S: ecs::Get<Position>, S: ecs::Get<Tag>, S: ecs::Hidden<(Entity, &Position), ()> {
    let entity = match(world.query<(Entity, &Position)>().single()) { Some((e, _)) => e, None => Entity::PLACEHOLDER };
    match(world.remove<Tag>(entity)) { Some(_) => (), None => discard(world.insert(entity, Tag)) }
}
fn tagged(query: &mut Query<(&mut Position,), (With<Tag>,)>) { query.for_each() { (mut p,) => p.0 = p.0 + 10; } }

fn main() -> Int {
    let mut world = App::new().register<Position>().register<Tag>().register<Other>().register<Global>().build().into_world();
    let mut mask = 0;
    while({ mask < 8 }) {
        let entity = world.spawn_bundle((Position(mask),));
        if(mask % 2 == 1) { discard(world.insert(entity, Tag)) };
        if((mask / 2) % 2 == 1) { discard(world.insert(entity, Other)) };
        if(mask >= 4) { discard(world.insert(entity, Global)) };
        mask = mask + 1
    };
    discard(world.spawn_bundle((Tag,)));
    say(values<(With<Tag>,), _>(&mut world));
    say(values<(Without<Tag>,), _>(&mut world));
    say(values<(With<Tag>, Without<Other>), _>(&mut world));
    say(values<(With<Tag>, With<Other>, Without<Global>), _>(&mut world));
    say(values<(Or<(With<Tag>, With<Other>)>,), _>(&mut world));
    say(values<(Or<(With<Tag>, With<Other>)>, Without<Global>), _>(&mut world));
    say(values<(With<Tag>, Without<Tag>), _>(&mut world));
    say("--");

    let mut app = App::new().register<Value>()
        .add_systems(Update, (add, multiply))
        .add_systems(Update, (subtract, (add, multiply).chain()).chain())
        .build();
    let entity = app.world.spawn_bundle((Value(1),));
    app.emit(&Update);
    say(match(app.world.get<Value>(entity)) { Some(v) => v.0, None => 0 });
    app.emit(&Update);
    say(match(app.world.get<Value>(entity)) { Some(v) => v.0, None => 0 });
    say("--");

    let mut app = App::new().register<Position>().register<Tag>()
        .add_systems(Update, (exclusive(toggle), tagged).chain())
        .build();
    let entity = app.world.spawn_bundle((Position(1),));
    let mut i = 0;
    while({ i < 3 }) {
        app.emit(&Update);
        say(match(app.world.get<Position>(entity)) { Some(p) => p.0, None => 0 });
        i = i + 1
    };
    0
}
