main() {
    let open = "[+";
    let close = "+]";
    let underflow = "<";
    let open_result = brainfuck_core::parse(Bytes::iter(&String::as_bytes(&open)));
    let close_result = brainfuck_core::parse(Bytes::iter(&String::as_bytes(&close)));
    assert(open_result is Result::Err(_));
    assert(close_result is Result::Err(_));
    let parsed = brainfuck_core::parse(Bytes::iter(&String::as_bytes(&underflow)));
    handle parsed {
        Result::Ok(program) => {
            let executed = brainfuck_core::run_with_io(
                &program,
                Bytes::iter(&String::as_bytes(&""))
            );
            assert(executed is Result::Err(_))
        },
        Result::Err(_) => assert(false)
    }
}
