main() {
    let source = "+++++[>++++++++<-]>++.";
    let parsed = brainfuck_core::parse(Bytes::iter(&String::as_bytes(&source)));
    handle parsed {
        Result::Ok(program) => {
            let output = brainfuck_core::run_with_io(&program, Bytes::iter(&String::as_bytes(&"")));
            handle output {
                Result::Ok(bytes) => {
                    let expected = "*";
                    assert(Bytes::eq(&Bytes::from_vec(bytes), &String::as_bytes(&expected)))
                },
                Result::Err(_) => assert(false)
            }
        },
        Result::Err(_) => assert(false)
    }
}
