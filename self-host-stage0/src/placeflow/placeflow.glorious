// M21 bootstrap place state. Projection paths, unique loans, and cleanup
// later enrich this source-owned available/shared-borrowed/moved transition.
use compiler_support::__g1_array_pop_move;

pub enum PlaceState { Available, SharedBorrowed, UniqueBorrowed, Moved }
pub enum ArgumentMode { Move, Borrow, UniqueBorrow }
pub enum CallAdmission { Value(PlaceState), Rejected }
pub enum MoveAdmission { Value(PlaceState), BorrowConflict, AlreadyMoved }
pub enum ClosureCaptureMode { DefaultMove, ExplicitMove, SharedBorrow, UniqueBorrow }
pub enum ClosureCaptureAdmission { Captured(PlaceState), Rejected }

// A frozen Core projection tracks the state of the selected place, not just
// its root. This fixed pair is the bootstrap aggregate layout: moving `.0`
// leaves `.1` readable, while moving the complete aggregate still requires
// both fields to be available.
pub struct PairPlaceState { first: PlaceState, second: PlaceState }
pub enum PairMoveAdmission { Value(PairPlaceState), BorrowConflict, AlreadyMoved }

// A source aggregate is not intrinsically a pair. This persistent field list
// carries an arbitrary number of independently tracked immediate projections;
// recursive/nested paths will reuse this same representation at each level.
pub enum FieldStates {
    Empty,
    Node(PlaceState, Bool, Array<FieldStates>),
}

pub enum FieldMoveAdmission {
    Value(FieldStates),
    Missing,
    BorrowConflict,
    AlreadyMoved,
}

pub enum FieldJoin {
    Value(FieldStates),
    ShapeMismatch,
}

// Rust PlaceFlow keys ownership by a root plus an arbitrary sequence of
// projections.  `FieldStates` above is intentionally retained as the compact
// one-level compatibility surface; this tree is the lossless representation
// for a nested source path such as `record.inner.value`.  Recursive values use
// the established one-element Array indirection so their layout is finite in
// the bootstrap compiler.
pub enum ProjectionPath {
    Field(i64, Bool, Array<ProjectionPath>),
}

pub enum NestedFieldStates {
    Empty,
    Node(PlaceState, Bool, Array<NestedFieldStates>, Bool, Array<NestedFieldStates>),
}

pub enum NestedMoveAdmission {
    Value(NestedFieldStates),
    Missing,
    BorrowConflict,
    AlreadyMoved,
}

pub enum NestedFieldJoin {
    Value(NestedFieldStates),
    ShapeMismatch,
}

// Successful whole-place admission must return the same nested shape.  This
// internal result therefore carries the validated subtree instead of merely a
// Boolean: a later reinitialization/join still sees the original projection
// layout rather than an invented empty child list.
enum NestedMoveCheck {
    Value(NestedFieldStates),
    BorrowConflict,
    AlreadyMoved,
}

pub fn available() -> PlaceState { PlaceState::Available }
pub fn move_out(state: PlaceState) -> PlaceState { handle state { PlaceState::Available => PlaceState::Moved, PlaceState::SharedBorrowed => PlaceState::SharedBorrowed, PlaceState::UniqueBorrowed => PlaceState::UniqueBorrowed, PlaceState::Moved => PlaceState::Moved, _ => PlaceState::Moved } }

pub fn borrow_shared(state: PlaceState) -> PlaceState { handle state { PlaceState::Available => PlaceState::SharedBorrowed, PlaceState::SharedBorrowed => PlaceState::SharedBorrowed, PlaceState::UniqueBorrowed => PlaceState::UniqueBorrowed, PlaceState::Moved => PlaceState::Moved, _ => PlaceState::Moved } }
pub fn borrow_unique(state: PlaceState) -> PlaceState { handle state { PlaceState::Available => PlaceState::UniqueBorrowed, PlaceState::SharedBorrowed => PlaceState::SharedBorrowed, PlaceState::UniqueBorrowed => PlaceState::UniqueBorrowed, PlaceState::Moved => PlaceState::Moved, _ => PlaceState::Moved } }
pub fn release_borrow(state: PlaceState) -> PlaceState { handle state { PlaceState::SharedBorrowed => PlaceState::Available, PlaceState::UniqueBorrowed => PlaceState::Available, PlaceState::Available => PlaceState::Available, PlaceState::Moved => PlaceState::Moved, _ => PlaceState::Moved } }

pub fn move_checked(state: PlaceState) -> MoveAdmission {
    handle state {
        PlaceState::Available => MoveAdmission::Value(PlaceState::Moved),
        PlaceState::SharedBorrowed => MoveAdmission::BorrowConflict,
        PlaceState::UniqueBorrowed => MoveAdmission::BorrowConflict,
        PlaceState::Moved => MoveAdmission::AlreadyMoved,
        _ => MoveAdmission::AlreadyMoved,
    }
}

// Captures have the language's default-move rule. `move` is an optional
// assertion of that default, not a second ownership operation; only `&` and
// `&mut` retain a live borrowed source place for the closure environment.
pub fn capture_for_closure(state: PlaceState, mode: ClosureCaptureMode) -> ClosureCaptureAdmission {
    handle mode {
        ClosureCaptureMode::DefaultMove => capture_move(state),
        ClosureCaptureMode::ExplicitMove => capture_move(state),
        ClosureCaptureMode::SharedBorrow => capture_borrow(state, ArgumentMode::Borrow),
        ClosureCaptureMode::UniqueBorrow => capture_borrow(state, ArgumentMode::UniqueBorrow),
        _ => ClosureCaptureAdmission::Rejected,
    }
}

fn capture_move(state: PlaceState) -> ClosureCaptureAdmission {
    handle move_checked(state) {
        MoveAdmission::Value(post) => ClosureCaptureAdmission::Captured(post),
        MoveAdmission::BorrowConflict => ClosureCaptureAdmission::Rejected,
        MoveAdmission::AlreadyMoved => ClosureCaptureAdmission::Rejected,
        _ => ClosureCaptureAdmission::Rejected,
    }
}

fn capture_borrow(state: PlaceState, mode: ArgumentMode) -> ClosureCaptureAdmission {
    handle call_argument(state, mode) {
        CallAdmission::Value(post) => ClosureCaptureAdmission::Captured(post),
        CallAdmission::Rejected => ClosureCaptureAdmission::Rejected,
        _ => ClosureCaptureAdmission::Rejected,
    }
}
// Assignment establishes a new initialized value even when an earlier value
// was moved. Later projection-aware flow refines this whole-place transition.
pub fn initialize(state: PlaceState) -> PlaceState { PlaceState::Available }
pub fn can_read(state: PlaceState) -> Bool { handle state { PlaceState::Available => true, PlaceState::SharedBorrowed => true, PlaceState::UniqueBorrowed => true, PlaceState::Moved => false, _ => false } }

// Reading through a live loan is valid, but returning ownership across a
// boundary is not. EscapeFlow consumes this stronger predicate rather than
// mistaking loan readability for ownership availability.
pub fn can_escape_owned(state: PlaceState) -> Bool { handle state { PlaceState::Available => true, PlaceState::SharedBorrowed => false, PlaceState::UniqueBorrowed => false, PlaceState::Moved => false, _ => false } }

pub fn empty_fields() -> FieldStates { FieldStates::Empty }

pub fn single_field(state: PlaceState) -> FieldStates {
    FieldStates::Node(state, false, [])
}

pub fn prepend_field(state: PlaceState, tail: FieldStates) -> FieldStates {
    FieldStates::Node(state, true, [tail])
}

pub fn path_field(index: i64) -> ProjectionPath {
    ProjectionPath::Field(index, false, [])
}

pub fn path_then(index: i64, tail: ProjectionPath) -> ProjectionPath {
    ProjectionPath::Field(index, true, [tail])
}

pub fn nested_empty_fields() -> NestedFieldStates { NestedFieldStates::Empty }

pub fn nested_single_field(state: PlaceState) -> NestedFieldStates {
    NestedFieldStates::Node(state, false, [], false, [])
}

pub fn nested_field_with_children(state: PlaceState, children: NestedFieldStates) -> NestedFieldStates {
    NestedFieldStates::Node(state, true, [children], false, [])
}

pub fn nested_prepend_field(state: PlaceState, children: NestedFieldStates, tail: NestedFieldStates) -> NestedFieldStates {
    NestedFieldStates::Node(state, true, [children], true, [tail])
}

// Reading a nested projection needs a readable state at every ancestor. A
// moved parent therefore hides every descendant, while a shared loan remains
// readable exactly as it does for an unprojected place.
pub fn can_read_path(value: NestedFieldStates, path: ProjectionPath) -> Bool {
    handle path {
        ProjectionPath::Field(index, has_tail, tail) => handle index < 0 {
            true => false_after_discard_nested(value, has_tail, tail),
            false => can_read_path_at(value, index, has_tail, tail),
            _ => false,
        },
        _ => false,
    }
}

fn false_after_discard_nested(value: NestedFieldStates, has_tail: Bool, tail: Array<ProjectionPath>) -> Bool {
    discard_nested_path_after(discard_nested_fields(value), has_tail, tail)
}

fn discard_nested_path_after(_: Bool, has_tail: Bool, tail: Array<ProjectionPath>) -> Bool {
    handle has_tail {
        true => discard_nested_path(__g1_array_pop_move<ProjectionPath>(&mut tail)),
        false => false,
        _ => false,
    }
}

fn can_read_path_at(value: NestedFieldStates, index: i64, has_path_tail: Bool, path_tail: Array<ProjectionPath>) -> Bool {
    handle value {
        NestedFieldStates::Empty => discard_nested_path_after(false, has_path_tail, path_tail),
        NestedFieldStates::Node(state, has_children, children, has_sibling, sibling) => handle index == 0 {
            true => can_read_selected_path(state, has_children, children, has_path_tail, path_tail),
            false => handle has_sibling {
                true => can_read_path_at(__g1_array_pop_move<NestedFieldStates>(&mut sibling), index - 1, has_path_tail, path_tail),
                false => discard_nested_path_after(false, has_path_tail, path_tail),
                _ => false,
            },
            _ => false,
        },
        _ => false,
    }
}

fn can_read_selected_path(state: PlaceState, has_children: Bool, children: Array<NestedFieldStates>, has_path_tail: Bool, path_tail: Array<ProjectionPath>) -> Bool {
    handle can_read(state) {
        true => handle has_path_tail {
            false => discard_nested_children_after(true, has_children, children),
            true => handle has_children {
                true => can_read_path(__g1_array_pop_move<NestedFieldStates>(&mut children), __g1_array_pop_move<ProjectionPath>(&mut path_tail)),
                false => discard_nested_path(__g1_array_pop_move<ProjectionPath>(&mut path_tail)),
                _ => false,
            },
            _ => false,
        },
        false => discard_nested_selected_after(false, has_children, children, has_path_tail, path_tail),
        _ => false,
    }
}

fn discard_nested_children_after(result: Bool, has_children: Bool, children: Array<NestedFieldStates>) -> Bool {
    handle has_children {
        true => discard_nested_children_return(result, discard_nested_fields(__g1_array_pop_move<NestedFieldStates>(&mut children))),
        false => result,
        _ => false,
    }
}

fn discard_nested_children_return(result: Bool, _: Bool) -> Bool { result }

fn discard_nested_selected_after(result: Bool, has_children: Bool, children: Array<NestedFieldStates>, has_path_tail: Bool, path_tail: Array<ProjectionPath>) -> Bool {
    discard_nested_path_after(discard_nested_children_after(result, has_children, children), has_path_tail, path_tail)
}

// Moving a leaf preserves all unrelated siblings. Moving an ancestor is only
// admitted when its entire child subtree is available, matching Rust's rule
// that a partial move prevents a later whole-place move.
pub fn move_path_checked(value: NestedFieldStates, path: ProjectionPath) -> NestedMoveAdmission {
    handle path {
        ProjectionPath::Field(index, has_tail, tail) => handle index < 0 {
            true => nested_missing_after(discard_nested_and_path(value, has_tail, tail)),
            false => move_path_at(value, index, has_tail, tail),
            _ => NestedMoveAdmission::Missing,
        },
        _ => NestedMoveAdmission::Missing,
    }
}

fn nested_missing_after(_: Bool) -> NestedMoveAdmission { NestedMoveAdmission::Missing }

fn discard_nested_and_path(value: NestedFieldStates, has_tail: Bool, tail: Array<ProjectionPath>) -> Bool {
    discard_nested_path_after(discard_nested_fields(value), has_tail, tail)
}

fn move_path_at(value: NestedFieldStates, index: i64, has_path_tail: Bool, path_tail: Array<ProjectionPath>) -> NestedMoveAdmission {
    handle value {
        NestedFieldStates::Empty => nested_missing_after(discard_nested_path_after(false, has_path_tail, path_tail)),
        NestedFieldStates::Node(state, has_children, children, has_sibling, sibling) => handle index == 0 {
            true => move_selected_path(state, has_children, children, has_sibling, sibling, has_path_tail, path_tail),
            false => handle has_sibling {
                true => rebuild_nested_sibling_move(state, has_children, children, move_path_at(__g1_array_pop_move<NestedFieldStates>(&mut sibling), index - 1, has_path_tail, path_tail)),
                false => nested_missing_after(discard_nested_path_after(false, has_path_tail, path_tail)),
                _ => NestedMoveAdmission::Missing,
            },
            _ => NestedMoveAdmission::Missing,
        },
        _ => NestedMoveAdmission::Missing,
    }
}

fn move_selected_path(state: PlaceState, has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>, has_path_tail: Bool, path_tail: Array<ProjectionPath>) -> NestedMoveAdmission {
    handle has_path_tail {
        false => move_whole_nested_field(state, has_children, children, has_sibling, sibling),
        true => move_child_path(state, has_children, children, has_sibling, sibling, path_tail),
        _ => NestedMoveAdmission::Missing,
    }
}

fn move_whole_nested_field(state: PlaceState, has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveAdmission {
    handle move_checked(state) {
        MoveAdmission::Value(next) => handle nested_children_move_check(has_children, children) {
            NestedMoveCheck::Value(checked_children) => NestedMoveAdmission::Value(rebuild_whole_nested_field(next, has_children, checked_children, has_sibling, sibling)),
            NestedMoveCheck::BorrowConflict => nested_conflict_after_sibling(has_sibling, sibling),
            NestedMoveCheck::AlreadyMoved => nested_moved_after_sibling(has_sibling, sibling),
            _ => NestedMoveAdmission::AlreadyMoved,
        },
        MoveAdmission::BorrowConflict => nested_conflict_after_all(has_children, children, has_sibling, sibling),
        MoveAdmission::AlreadyMoved => nested_moved_after_all(has_children, children, has_sibling, sibling),
        _ => NestedMoveAdmission::AlreadyMoved,
    }
}

fn rebuild_whole_nested_field(state: PlaceState, has_children: Bool, children: NestedFieldStates, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedFieldStates {
    handle has_children {
        true => NestedFieldStates::Node(state, true, [children], has_sibling, sibling),
        false => NestedFieldStates::Node(state, false, [], has_sibling, sibling),
        _ => NestedFieldStates::Empty,
    }
}

fn nested_children_move_check(has_children: Bool, children: Array<NestedFieldStates>) -> NestedMoveCheck {
    handle has_children {
        true => nested_fields_move_check(__g1_array_pop_move<NestedFieldStates>(&mut children)),
        false => NestedMoveCheck::Value(NestedFieldStates::Empty),
        _ => NestedMoveCheck::AlreadyMoved,
    }
}

fn nested_fields_move_check(value: NestedFieldStates) -> NestedMoveCheck {
    handle value {
        NestedFieldStates::Empty => NestedMoveCheck::Value(NestedFieldStates::Empty),
        NestedFieldStates::Node(state, has_children, children, has_sibling, sibling) => handle move_checked(state) {
            MoveAdmission::Value(_) => rebuild_nested_checked_children(state, has_children, children, has_sibling, sibling),
            MoveAdmission::BorrowConflict => nested_check_conflict_after_all(has_children, children, has_sibling, sibling),
            MoveAdmission::AlreadyMoved => nested_check_moved_after_all(has_children, children, has_sibling, sibling),
            _ => NestedMoveCheck::AlreadyMoved,
        },
        _ => NestedMoveCheck::AlreadyMoved,
    }
}

fn rebuild_nested_checked_children(state: PlaceState, has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveCheck {
    handle nested_children_move_check(has_children, children) {
        NestedMoveCheck::Value(checked_children) => rebuild_nested_checked_sibling(state, has_children, checked_children, has_sibling, sibling),
        NestedMoveCheck::BorrowConflict => nested_check_conflict_after_sibling(has_sibling, sibling),
        NestedMoveCheck::AlreadyMoved => nested_check_moved_after_sibling(has_sibling, sibling),
        _ => NestedMoveCheck::AlreadyMoved,
    }
}

fn rebuild_nested_checked_sibling(state: PlaceState, has_children: Bool, children: NestedFieldStates, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveCheck {
    handle has_sibling {
        true => handle nested_fields_move_check(__g1_array_pop_move<NestedFieldStates>(&mut sibling)) {
            NestedMoveCheck::Value(checked_sibling) => NestedMoveCheck::Value(rebuild_checked_nested_node(state, has_children, children, true, checked_sibling)),
            NestedMoveCheck::BorrowConflict => NestedMoveCheck::BorrowConflict,
            NestedMoveCheck::AlreadyMoved => NestedMoveCheck::AlreadyMoved,
            _ => NestedMoveCheck::AlreadyMoved,
        },
        false => NestedMoveCheck::Value(rebuild_checked_nested_node(state, has_children, children, false, NestedFieldStates::Empty)),
        _ => NestedMoveCheck::AlreadyMoved,
    }
}

fn rebuild_checked_nested_node(state: PlaceState, has_children: Bool, children: NestedFieldStates, has_sibling: Bool, sibling: NestedFieldStates) -> NestedFieldStates {
    handle has_children {
        true => handle has_sibling {
            true => NestedFieldStates::Node(state, true, [children], true, [sibling]),
            false => NestedFieldStates::Node(state, true, [children], false, []),
            _ => NestedFieldStates::Empty,
        },
        false => handle has_sibling {
            true => NestedFieldStates::Node(state, false, [], true, [sibling]),
            false => NestedFieldStates::Node(state, false, [], false, []),
            _ => NestedFieldStates::Empty,
        },
        _ => NestedFieldStates::Empty,
    }
}

fn nested_check_conflict_after_all(has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveCheck {
    nested_check_conflict_after_sibling(has_sibling, sibling)
}

fn nested_check_moved_after_all(has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveCheck {
    nested_check_moved_after_sibling(has_sibling, sibling)
}

fn nested_check_conflict_after_sibling(has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveCheck {
    nested_check_conflict_after(discard_nested_sibling(has_sibling, sibling))
}

fn nested_check_moved_after_sibling(has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveCheck {
    nested_check_moved_after(discard_nested_sibling(has_sibling, sibling))
}

fn nested_check_conflict_after(_: Bool) -> NestedMoveCheck { NestedMoveCheck::BorrowConflict }
fn nested_check_moved_after(_: Bool) -> NestedMoveCheck { NestedMoveCheck::AlreadyMoved }

fn children_move_admission(has_children: Bool, children: Array<NestedFieldStates>) -> MoveAdmission {
    handle has_children {
        true => nested_fields_move_admission(__g1_array_pop_move<NestedFieldStates>(&mut children)),
        false => MoveAdmission::Value(PlaceState::Available),
        _ => MoveAdmission::AlreadyMoved,
    }
}

fn nested_fields_move_admission(value: NestedFieldStates) -> MoveAdmission {
    handle value {
        NestedFieldStates::Empty => MoveAdmission::Value(PlaceState::Available),
        NestedFieldStates::Node(state, has_children, children, has_sibling, sibling) => combine_nested_move_admission(move_checked(state), children_move_admission(has_children, children), has_sibling, sibling),
        _ => MoveAdmission::AlreadyMoved,
    }
}

fn combine_nested_move_admission(head: MoveAdmission, children: MoveAdmission, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> MoveAdmission {
    handle head {
        MoveAdmission::BorrowConflict => discard_nested_sibling_for_admission(has_sibling, sibling, MoveAdmission::BorrowConflict),
        MoveAdmission::AlreadyMoved => discard_nested_sibling_for_admission(has_sibling, sibling, MoveAdmission::AlreadyMoved),
        MoveAdmission::Value(_) => handle children {
            MoveAdmission::BorrowConflict => discard_nested_sibling_for_admission(has_sibling, sibling, MoveAdmission::BorrowConflict),
            MoveAdmission::AlreadyMoved => discard_nested_sibling_for_admission(has_sibling, sibling, MoveAdmission::AlreadyMoved),
            MoveAdmission::Value(_) => handle has_sibling {
                true => nested_fields_move_admission(__g1_array_pop_move<NestedFieldStates>(&mut sibling)),
                false => MoveAdmission::Value(PlaceState::Available),
                _ => MoveAdmission::AlreadyMoved,
            },
            _ => MoveAdmission::AlreadyMoved,
        },
        _ => MoveAdmission::AlreadyMoved,
    }
}

fn discard_nested_sibling_for_admission(has_sibling: Bool, sibling: Array<NestedFieldStates>, result: MoveAdmission) -> MoveAdmission {
    handle has_sibling {
        true => return_nested_admission(result, discard_nested_fields(__g1_array_pop_move<NestedFieldStates>(&mut sibling))),
        false => result,
        _ => MoveAdmission::AlreadyMoved,
    }
}

fn return_nested_admission(result: MoveAdmission, _: Bool) -> MoveAdmission { result }

fn nested_conflict_after_sibling(has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveAdmission {
    nested_conflict_after(discard_nested_sibling(has_sibling, sibling))
}

fn nested_moved_after_sibling(has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveAdmission {
    nested_moved_after(discard_nested_sibling(has_sibling, sibling))
}

fn nested_conflict_after_all(has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveAdmission {
    nested_conflict_after(discard_nested_sibling(has_sibling, sibling))
}

fn nested_moved_after_all(has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> NestedMoveAdmission {
    nested_moved_after(discard_nested_sibling(has_sibling, sibling))
}

fn nested_conflict_after(_: Bool) -> NestedMoveAdmission { NestedMoveAdmission::BorrowConflict }
fn nested_moved_after(_: Bool) -> NestedMoveAdmission { NestedMoveAdmission::AlreadyMoved }

fn discard_nested_sibling(has_sibling: Bool, sibling: Array<NestedFieldStates>) -> Bool {
    handle has_sibling {
        true => discard_nested_fields(__g1_array_pop_move<NestedFieldStates>(&mut sibling)),
        false => true,
        _ => false,
    }
}

fn move_child_path(state: PlaceState, has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>, path_tail: Array<ProjectionPath>) -> NestedMoveAdmission {
    handle move_checked(state) {
        MoveAdmission::Value(_) => handle has_children {
            true => rebuild_nested_child_move(state, has_sibling, sibling, move_path_checked(__g1_array_pop_move<NestedFieldStates>(&mut children), __g1_array_pop_move<ProjectionPath>(&mut path_tail))),
            false => nested_missing_after(discard_nested_path(__g1_array_pop_move<ProjectionPath>(&mut path_tail))),
            _ => NestedMoveAdmission::Missing,
        },
        MoveAdmission::BorrowConflict => nested_conflict_after_all(has_children, children, has_sibling, sibling),
        MoveAdmission::AlreadyMoved => nested_moved_after_all(has_children, children, has_sibling, sibling),
        _ => NestedMoveAdmission::AlreadyMoved,
    }
}

fn rebuild_nested_child_move(state: PlaceState, has_sibling: Bool, sibling: Array<NestedFieldStates>, result: NestedMoveAdmission) -> NestedMoveAdmission {
    handle result {
        NestedMoveAdmission::Value(children) => NestedMoveAdmission::Value(NestedFieldStates::Node(state, true, [children], has_sibling, sibling)),
        NestedMoveAdmission::Missing => NestedMoveAdmission::Missing,
        NestedMoveAdmission::BorrowConflict => NestedMoveAdmission::BorrowConflict,
        NestedMoveAdmission::AlreadyMoved => NestedMoveAdmission::AlreadyMoved,
        _ => NestedMoveAdmission::Missing,
    }
}

fn rebuild_nested_sibling_move(state: PlaceState, has_children: Bool, children: Array<NestedFieldStates>, result: NestedMoveAdmission) -> NestedMoveAdmission {
    handle result {
        NestedMoveAdmission::Value(sibling) => NestedMoveAdmission::Value(NestedFieldStates::Node(state, has_children, children, true, [sibling])),
        NestedMoveAdmission::Missing => NestedMoveAdmission::Missing,
        NestedMoveAdmission::BorrowConflict => NestedMoveAdmission::BorrowConflict,
        NestedMoveAdmission::AlreadyMoved => NestedMoveAdmission::AlreadyMoved,
        _ => NestedMoveAdmission::Missing,
    }
}

// Assignment repairs exactly one frozen projection path. The surrounding
// ownership tree is retained, so a reinitialized descendant makes later
// whole-place admission possible only after every previously moved child has
// likewise been repaired.
pub fn initialize_path(value: NestedFieldStates, path: ProjectionPath) -> NestedFieldStates {
    handle path {
        ProjectionPath::Field(index, has_tail, tail) => handle index < 0 {
            true => value,
            false => initialize_path_at(value, index, has_tail, tail),
            _ => value,
        },
        _ => value,
    }
}

fn initialize_path_at(value: NestedFieldStates, index: i64, has_path_tail: Bool, path_tail: Array<ProjectionPath>) -> NestedFieldStates {
    handle value {
        NestedFieldStates::Empty => NestedFieldStates::Empty,
        NestedFieldStates::Node(state, has_children, children, has_sibling, sibling) => handle index == 0 {
            true => handle has_path_tail {
                false => NestedFieldStates::Node(initialize(state), has_children, children, has_sibling, sibling),
                true => initialize_path_child(state, has_children, children, has_sibling, sibling, path_tail),
                _ => NestedFieldStates::Node(state, has_children, children, has_sibling, sibling),
            },
            false => initialize_path_sibling(state, has_children, children, has_sibling, sibling, index, has_path_tail, path_tail),
            _ => NestedFieldStates::Node(state, has_children, children, has_sibling, sibling),
        },
        _ => NestedFieldStates::Empty,
    }
}

fn initialize_path_child(state: PlaceState, has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>, path_tail: Array<ProjectionPath>) -> NestedFieldStates {
    handle has_children {
        true => NestedFieldStates::Node(state, true, [initialize_path(__g1_array_pop_move<NestedFieldStates>(&mut children), __g1_array_pop_move<ProjectionPath>(&mut path_tail))], has_sibling, sibling),
        false => NestedFieldStates::Node(state, false, children, has_sibling, sibling),
        _ => NestedFieldStates::Node(state, has_children, children, has_sibling, sibling),
    }
}

fn initialize_path_sibling(state: PlaceState, has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>, index: i64, has_path_tail: Bool, path_tail: Array<ProjectionPath>) -> NestedFieldStates {
    handle has_sibling {
        true => NestedFieldStates::Node(state, has_children, children, true, [initialize_path_at(__g1_array_pop_move<NestedFieldStates>(&mut sibling), index - 1, has_path_tail, path_tail)]),
        false => NestedFieldStates::Node(state, has_children, children, false, sibling),
        _ => NestedFieldStates::Node(state, has_children, children, has_sibling, sibling),
    }
}

fn discard_nested_path(path: ProjectionPath) -> Bool {
    handle path {
        ProjectionPath::Field(_, has_tail, tail) => handle has_tail {
            true => discard_nested_path(__g1_array_pop_move<ProjectionPath>(&mut tail)),
            false => true,
            _ => false,
        },
        _ => false,
    }
}

fn discard_nested_fields(value: NestedFieldStates) -> Bool {
    handle value {
        NestedFieldStates::Empty => true,
        NestedFieldStates::Node(_, has_children, children, has_sibling, sibling) => handle discard_nested_children_after(true, has_children, children) {
            true => discard_nested_sibling(has_sibling, sibling),
            false => false,
            _ => false,
        },
        _ => false,
    }
}

// Returning/storing an aggregate consumes ownership of every projection. A
// nested borrowed or moved descendant is therefore visible at the same escape
// boundary as a root field and cannot be hidden by rebuilding its ancestors.
pub fn can_escape_nested_owned(value: NestedFieldStates) -> Bool {
    handle value {
        NestedFieldStates::Empty => true,
        NestedFieldStates::Node(state, has_children, children, has_sibling, sibling) => handle can_escape_owned(state) {
            true => handle nested_children_escape_owned(has_children, children) {
                true => nested_sibling_escape_owned(has_sibling, sibling),
                false => discard_nested_sibling_for_escape(has_sibling, sibling),
                _ => false,
            },
            false => discard_nested_all_for_escape(has_children, children, has_sibling, sibling),
            _ => false,
        },
        _ => false,
    }
}

fn nested_children_escape_owned(has_children: Bool, children: Array<NestedFieldStates>) -> Bool {
    handle has_children {
        true => can_escape_nested_owned(__g1_array_pop_move<NestedFieldStates>(&mut children)),
        false => true,
        _ => false,
    }
}

fn nested_sibling_escape_owned(has_sibling: Bool, sibling: Array<NestedFieldStates>) -> Bool {
    handle has_sibling {
        true => can_escape_nested_owned(__g1_array_pop_move<NestedFieldStates>(&mut sibling)),
        false => true,
        _ => false,
    }
}

fn discard_nested_sibling_for_escape(has_sibling: Bool, sibling: Array<NestedFieldStates>) -> Bool {
    handle has_sibling {
        true => false_after_nested_escape_discard(discard_nested_fields(__g1_array_pop_move<NestedFieldStates>(&mut sibling))),
        false => false,
        _ => false,
    }
}

fn discard_nested_all_for_escape(has_children: Bool, children: Array<NestedFieldStates>, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> Bool {
    handle has_children {
        true => discard_nested_children_for_escape(__g1_array_pop_move<NestedFieldStates>(&mut children), has_sibling, sibling),
        false => discard_nested_sibling_for_escape(has_sibling, sibling),
        _ => false,
    }
}

fn discard_nested_children_for_escape(children: NestedFieldStates, has_sibling: Bool, sibling: Array<NestedFieldStates>) -> Bool {
    discard_nested_sibling_for_escape(has_sibling, sibling)
}

fn false_after_nested_escape_discard(_: Bool) -> Bool { false }

// Nested control-flow joins retain the entire projection shape. A move along
// one predecessor poisons only that exact leaf after the merge; unrelated
// children and siblings remain independently readable.
pub fn join_nested_fields(left: NestedFieldStates, right: NestedFieldStates) -> NestedFieldJoin {
    handle (left, right) {
        (NestedFieldStates::Empty, NestedFieldStates::Empty) => NestedFieldJoin::Value(NestedFieldStates::Empty),
        (NestedFieldStates::Node(left_state, left_has_children, left_children, left_has_sibling, left_sibling), NestedFieldStates::Node(right_state, right_has_children, right_children, right_has_sibling, right_sibling)) => join_nested_nodes(left_state, left_has_children, left_children, left_has_sibling, left_sibling, right_state, right_has_children, right_children, right_has_sibling, right_sibling),
        _ => NestedFieldJoin::ShapeMismatch,
    }
}

fn join_nested_nodes(left_state: PlaceState, left_has_children: Bool, left_children: Array<NestedFieldStates>, left_has_sibling: Bool, left_sibling: Array<NestedFieldStates>, right_state: PlaceState, right_has_children: Bool, right_children: Array<NestedFieldStates>, right_has_sibling: Bool, right_sibling: Array<NestedFieldStates>) -> NestedFieldJoin {
    handle (left_has_children, right_has_children) {
        (true, true) => join_nested_children(left_state, __g1_array_pop_move<NestedFieldStates>(&mut left_children), left_has_sibling, left_sibling, right_state, __g1_array_pop_move<NestedFieldStates>(&mut right_children), right_has_sibling, right_sibling),
        (false, false) => join_nested_siblings_without_children(left_state, left_has_sibling, left_sibling, right_state, right_has_sibling, right_sibling),
        (true, false) => NestedFieldJoin::ShapeMismatch,
        (false, true) => NestedFieldJoin::ShapeMismatch,
        _ => NestedFieldJoin::ShapeMismatch,
    }
}

fn join_nested_children(left_state: PlaceState, left_children: NestedFieldStates, left_has_sibling: Bool, left_sibling: Array<NestedFieldStates>, right_state: PlaceState, right_children: NestedFieldStates, right_has_sibling: Bool, right_sibling: Array<NestedFieldStates>) -> NestedFieldJoin {
    handle join_nested_fields(left_children, right_children) {
        NestedFieldJoin::Value(children) => join_nested_siblings_with_children(join(left_state, right_state), true, children, left_has_sibling, left_sibling, right_has_sibling, right_sibling),
        NestedFieldJoin::ShapeMismatch => NestedFieldJoin::ShapeMismatch,
        _ => NestedFieldJoin::ShapeMismatch,
    }
}

fn join_nested_siblings_without_children(left_state: PlaceState, left_has_sibling: Bool, left_sibling: Array<NestedFieldStates>, right_state: PlaceState, right_has_sibling: Bool, right_sibling: Array<NestedFieldStates>) -> NestedFieldJoin {
    join_nested_siblings_with_children(join(left_state, right_state), false, NestedFieldStates::Empty, left_has_sibling, left_sibling, right_has_sibling, right_sibling)
}

fn join_nested_siblings_with_children(state: PlaceState, has_children: Bool, children: NestedFieldStates, left_has_sibling: Bool, left_sibling: Array<NestedFieldStates>, right_has_sibling: Bool, right_sibling: Array<NestedFieldStates>) -> NestedFieldJoin {
    handle (left_has_sibling, right_has_sibling) {
        (true, true) => rebuild_nested_join(state, has_children, children, join_nested_fields(__g1_array_pop_move<NestedFieldStates>(&mut left_sibling), __g1_array_pop_move<NestedFieldStates>(&mut right_sibling))),
        (false, false) => NestedFieldJoin::Value(rebuild_checked_nested_node(state, has_children, children, false, NestedFieldStates::Empty)),
        (true, false) => NestedFieldJoin::ShapeMismatch,
        (false, true) => NestedFieldJoin::ShapeMismatch,
        _ => NestedFieldJoin::ShapeMismatch,
    }
}

fn rebuild_nested_join(state: PlaceState, has_children: Bool, children: NestedFieldStates, joined: NestedFieldJoin) -> NestedFieldJoin {
    handle joined {
        NestedFieldJoin::Value(sibling) => NestedFieldJoin::Value(rebuild_checked_nested_node(state, has_children, children, true, sibling)),
        NestedFieldJoin::ShapeMismatch => NestedFieldJoin::ShapeMismatch,
        _ => NestedFieldJoin::ShapeMismatch,
    }
}


pub fn can_read_field(value: FieldStates, index: i64) -> Bool {
    handle index < 0 {
        true => discard_fields(value),
        false => can_read_field_nonnegative(value, index),
        _ => false,
    }
}

fn can_read_field_nonnegative(value: FieldStates, index: i64) -> Bool {
    handle value {
        FieldStates::Empty => false,
        FieldStates::Node(state, has_tail, tail) => handle index == 0 {
            true => can_read(state),
            false => handle has_tail {
                true => can_read_field_nonnegative(__g1_array_pop_move<FieldStates>(&mut tail), index - 1),
                false => false,
                _ => false,
            },
            _ => false,
        },
        _ => false,
    }
}

// A partial move changes only the selected immediate projection. All other
// fields remain in the returned persistent state, so a later root escape can
// still observe the moved child instead of accidentally reconstituting it.
pub fn move_field_checked(value: FieldStates, index: i64) -> FieldMoveAdmission {
    handle index < 0 {
        true => missing_after_discard(discard_fields(value)),
        false => move_field_nonnegative(value, index),
        _ => FieldMoveAdmission::Missing,
    }
}

fn missing_after_discard(_: Bool) -> FieldMoveAdmission { FieldMoveAdmission::Missing }

fn move_field_nonnegative(value: FieldStates, index: i64) -> FieldMoveAdmission {
    handle value {
        FieldStates::Empty => FieldMoveAdmission::Missing,
        FieldStates::Node(state, has_tail, tail) => handle index == 0 {
            true => move_field_head(state, has_tail, tail),
            false => move_field_tail(state, has_tail, tail, index),
            _ => FieldMoveAdmission::Missing,
        },
        _ => FieldMoveAdmission::Missing,
    }
}

fn move_field_head(state: PlaceState, has_tail: Bool, tail: Array<FieldStates>) -> FieldMoveAdmission {
    handle move_checked(state) {
        MoveAdmission::Value(next) => FieldMoveAdmission::Value(FieldStates::Node(next, has_tail, tail)),
        MoveAdmission::BorrowConflict => conflict_after_discard(has_tail, tail),
        MoveAdmission::AlreadyMoved => moved_after_discard(has_tail, tail),
        _ => FieldMoveAdmission::AlreadyMoved,
    }
}

fn move_field_tail(state: PlaceState, has_tail: Bool, tail: Array<FieldStates>, index: i64) -> FieldMoveAdmission {
    handle has_tail {
        true => rebuild_field_move(state, move_field_nonnegative(__g1_array_pop_move<FieldStates>(&mut tail), index - 1)),
        false => FieldMoveAdmission::Missing,
        _ => FieldMoveAdmission::Missing,
    }
}

fn rebuild_field_move(state: PlaceState, result: FieldMoveAdmission) -> FieldMoveAdmission {
    handle result {
        FieldMoveAdmission::Value(tail) => FieldMoveAdmission::Value(FieldStates::Node(state, true, [tail])),
        FieldMoveAdmission::Missing => FieldMoveAdmission::Missing,
        FieldMoveAdmission::BorrowConflict => FieldMoveAdmission::BorrowConflict,
        FieldMoveAdmission::AlreadyMoved => FieldMoveAdmission::AlreadyMoved,
        _ => FieldMoveAdmission::Missing,
    }
}

fn conflict_after_discard(has_tail: Bool, tail: Array<FieldStates>) -> FieldMoveAdmission {
    handle has_tail {
        true => conflict_after_discard_tail(discard_fields(__g1_array_pop_move<FieldStates>(&mut tail))),
        false => FieldMoveAdmission::BorrowConflict,
        _ => FieldMoveAdmission::BorrowConflict,
    }
}

fn conflict_after_discard_tail(_: Bool) -> FieldMoveAdmission { FieldMoveAdmission::BorrowConflict }

fn moved_after_discard(has_tail: Bool, tail: Array<FieldStates>) -> FieldMoveAdmission {
    handle has_tail {
        true => moved_after_discard_tail(discard_fields(__g1_array_pop_move<FieldStates>(&mut tail))),
        false => FieldMoveAdmission::AlreadyMoved,
        _ => FieldMoveAdmission::AlreadyMoved,
    }
}

fn moved_after_discard_tail(_: Bool) -> FieldMoveAdmission { FieldMoveAdmission::AlreadyMoved }

pub fn can_escape_fields_owned(value: FieldStates) -> Bool {
    handle value {
        FieldStates::Empty => true,
        FieldStates::Node(state, has_tail, tail) => handle can_escape_owned(state) {
            true => handle has_tail {
                true => can_escape_fields_owned(__g1_array_pop_move<FieldStates>(&mut tail)),
                false => true,
                _ => false,
            },
            false => discard_field_tail_for_escape(has_tail, tail),
            _ => false,
        },
        _ => false,
    }
}

fn discard_field_tail_for_escape(has_tail: Bool, tail: Array<FieldStates>) -> Bool {
    handle has_tail {
        true => discard_fields(__g1_array_pop_move<FieldStates>(&mut tail)),
        false => false,
        _ => false,
    }
}

fn discard_fields(value: FieldStates) -> Bool {
    handle value {
        FieldStates::Empty => false,
        FieldStates::Node(_, has_tail, tail) => handle has_tail {
            true => discard_fields(__g1_array_pop_move<FieldStates>(&mut tail)),
            false => false,
            _ => false,
        },
        _ => false,
    }
}

// A branch merge is field-wise, not aggregate-wise: moving `.1` along one
// predecessor must not poison `.2`, but it must make `.1` unavailable after
// the join. Differing aggregate shapes are rejected rather than guessed from
// list length or silently truncating a source projection path.
pub fn join_fields(left: FieldStates, right: FieldStates) -> FieldJoin {
    handle (left, right) {
        (FieldStates::Empty, FieldStates::Empty) => FieldJoin::Value(FieldStates::Empty),
        (FieldStates::Node(left_state, left_has_tail, left_tail), FieldStates::Node(right_state, right_has_tail, right_tail)) => join_field_nodes(left_state, left_has_tail, left_tail, right_state, right_has_tail, right_tail),
        _ => FieldJoin::ShapeMismatch,
    }
}

fn join_field_nodes(left_state: PlaceState, left_has_tail: Bool, left_tail: Array<FieldStates>, right_state: PlaceState, right_has_tail: Bool, right_tail: Array<FieldStates>) -> FieldJoin {
    handle (left_has_tail, right_has_tail) {
        (false, false) => FieldJoin::Value(FieldStates::Node(join(left_state, right_state), false, [])),
        (true, true) => rebuild_field_join(join(left_state, right_state), join_fields(__g1_array_pop_move<FieldStates>(&mut left_tail), __g1_array_pop_move<FieldStates>(&mut right_tail))),
        (true, false) => shape_mismatch_after_discard_tail(left_tail),
        (false, true) => shape_mismatch_after_discard_tail(right_tail),
        _ => FieldJoin::ShapeMismatch,
    }
}

fn rebuild_field_join(state: PlaceState, joined: FieldJoin) -> FieldJoin {
    handle joined {
        FieldJoin::Value(tail) => FieldJoin::Value(FieldStates::Node(state, true, [tail])),
        FieldJoin::ShapeMismatch => FieldJoin::ShapeMismatch,
        _ => FieldJoin::ShapeMismatch,
    }
}

fn shape_mismatch_after_discard_tail(tail: Array<FieldStates>) -> FieldJoin {
    shape_mismatch_after_discard(discard_fields(__g1_array_pop_move<FieldStates>(&mut tail)))
}

fn shape_mismatch_after_discard(_: Bool) -> FieldJoin { FieldJoin::ShapeMismatch }

pub fn pair(first: PlaceState, second: PlaceState) -> PairPlaceState {
    PairPlaceState { first: first, second: second }
}

pub fn pair_available() -> PairPlaceState { pair(available(), available()) }

pub fn move_first(value: PairPlaceState) -> PairPlaceState {
    PairPlaceState { first: move_out(value.first), second: value.second }
}

pub fn move_second(value: PairPlaceState) -> PairPlaceState {
    PairPlaceState { first: value.first, second: move_out(value.second) }
}

pub fn first_state(value: PairPlaceState) -> PlaceState { value.first }
pub fn second_state(value: PairPlaceState) -> PlaceState { value.second }
pub fn can_read_first(value: PairPlaceState) -> Bool { can_read(value.first) }
pub fn can_read_second(value: PairPlaceState) -> Bool { can_read(value.second) }

// Returning or moving the whole pair is valid only if every owned field is
// still available. Borrowed or moved projection states cannot be erased by
// reconstructing the root aggregate.
pub fn can_escape_pair_owned(value: PairPlaceState) -> Bool {
    handle can_escape_owned(value.first) {
        true => can_escape_owned(value.second),
        false => false,
        _ => false,
    }
}

pub fn move_pair_checked(value: PairPlaceState) -> PairMoveAdmission {
    handle (value.first, value.second) {
        (PlaceState::Available, PlaceState::Available) => PairMoveAdmission::Value(pair(PlaceState::Moved, PlaceState::Moved)),
        (PlaceState::Moved, _) => PairMoveAdmission::AlreadyMoved,
        (_, PlaceState::Moved) => PairMoveAdmission::AlreadyMoved,
        _ => PairMoveAdmission::BorrowConflict,
    }
}

pub fn join_pair(left: PairPlaceState, right: PairPlaceState) -> PairPlaceState {
    PairPlaceState { first: join(left.first, right.first), second: join(left.second, right.second) }
}

// A call boundary consumes an owned argument but only observes a borrowed
// one. Both modes require a live source place, so an already moved value
// cannot be reintroduced by passing it through a call expression.
pub fn call_argument(state: PlaceState, mode: ArgumentMode) -> CallAdmission {
    handle state {
        PlaceState::Available => handle mode {
            ArgumentMode::Move => CallAdmission::Value(PlaceState::Moved),
            ArgumentMode::Borrow => CallAdmission::Value(PlaceState::SharedBorrowed),
            ArgumentMode::UniqueBorrow => CallAdmission::Value(PlaceState::UniqueBorrowed),
            _ => CallAdmission::Rejected,
        },
        PlaceState::SharedBorrowed => handle mode {
            ArgumentMode::Move => CallAdmission::Rejected,
            ArgumentMode::Borrow => CallAdmission::Value(PlaceState::SharedBorrowed),
            ArgumentMode::UniqueBorrow => CallAdmission::Rejected,
            _ => CallAdmission::Rejected,
        },
        PlaceState::UniqueBorrowed => CallAdmission::Rejected,
        PlaceState::Moved => CallAdmission::Rejected,
        _ => CallAdmission::Rejected,
    }
}

// A path remains available after a control-flow merge only if every incoming
// path retained it. This is the conservative base of later projection and
// loan-state joins.
pub fn join(left: PlaceState, right: PlaceState) -> PlaceState {
    handle (left, right) {
        (PlaceState::Available, PlaceState::Available) => PlaceState::Available,
        (PlaceState::SharedBorrowed, PlaceState::SharedBorrowed) => PlaceState::SharedBorrowed,
        (PlaceState::UniqueBorrowed, PlaceState::UniqueBorrowed) => PlaceState::UniqueBorrowed,
        _ => PlaceState::Moved,
    }
}
