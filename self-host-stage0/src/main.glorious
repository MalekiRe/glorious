}

// Keep the canonical source-world artifact on the same manifest path used by
// the bootstrap probes: a fixed-record seed must decode, and an immediate
// successor must prove its predecessor/artifact linkage and commitments.
fn bootstrap_codec_smoke() -> i64 {
    score_manifest_decode(bootstrap::decode_manifest(bootstrap_seed_manifest()))
        + score(bootstrap::compare_manifest_bytes(bootstrap_seed_manifest(), bootstrap_successor_manifest()) == bootstrap::Convergence::Compatible)
}

fn score_manifest_decode(value: bootstrap::ManifestDecode) -> i64 {
    handle value {
        bootstrap::ManifestDecode::Seed(_) => 1,
        _ => 0,
    }
}

fn bootstrap_seed_manifest() -> Bytes {
    bootstrap::encode_seed_manifest_bytes(
        1, identity::digest_of_text("producer"), 0, 36, 1048576,
        identity::digest_of_text("world"), identity::digest_of_text("source"),
        identity::digest_of_text("codegen"), identity::digest_of_text("artifact"),
        identity::digest_of_text("artifact-bytes"),
    )
}

fn bootstrap_successor_manifest() -> Bytes {
    bootstrap::encode_successor_manifest_bytes(
        2, identity::digest_of_text("artifact"), 0, 36, 1048576,
        identity::digest_of_text("artifact"), identity::digest_of_text("world"),
        identity::digest_of_text("source"), identity::digest_of_text("codegen"),
        identity::digest_of_text("artifact"), identity::digest_of_text("artifact-bytes"),
    )
}

// The canonical source world must exercise a real source compilation route,
// not only facade-local proofs. This checked input travels through scanner,
// Body, Core, MIR, and verified G1 artifact admission.
fn source_artifact_smoke() -> i64 {
    handle service::compile_source_i64_arithmetic_entry(source::input(
        "self-host-stage0@0.1.0",
        "src/root-arithmetic.glorious",
        __g1_text_as_bytes("20 + 22"),
        identity::digest_of_text("20 + 22"),
    )) {
        vm_backend::ArtifactEmission::Artifact(bytes) => score(__g1_bytes_len(bytes) == 1280),
        vm_backend::ArtifactEmission::Rejected => 0,
        _ => 0,
    }
}

// The parameterized route proves that the source-world executable also keeps
// declaration binders, body references, typed call lowering, and the G1
// callee artifact coupled at one compiler boundary.
fn source_binary_call_artifact_smoke() -> i64 {
    handle service::compile_source_i64_binary_function_entry(source::input(
        "self-host-stage0@0.1.0",
        "src/root-binary.glorious",
        __g1_text_as_bytes("pub fn add(left: i64, right: i64) -> i64 { left + right }"),
        identity::digest_of_text("pub fn add(left: i64, right: i64) -> i64 { left + right }"),
    ), 20, 22) {
        vm_backend::ArtifactEmission::Artifact(bytes) => score(__g1_bytes_len(bytes) == 1288),
        vm_backend::ArtifactEmission::Rejected => 0,
        _ => 0,
    }
}

fn source_parameter_smoke() -> i64 {
    handle service::compile_source_i64_identity_function(source::input(
        "self-host-stage0@0.1.0",
        "src/root-identity.glorious",
        __g1_text_as_bytes("pub fn id(value: i64) -> i64 { value }"),
        identity::digest_of_text("pub fn id(value: i64) -> i64 { value }"),
    ), 42) {
        vm_backend::Execution::Returned(42) => 1,
        _ => 0,
    }
}

fn source_parameter_boolean_smoke() -> i64 {
    handle service::compile_source_bool_not_function(source::input(
        "self-host-stage0@0.1.0",
        "src/root-invert.glorious",
        __g1_text_as_bytes("pub fn invert(value: Bool) -> Bool { !value }"),
        identity::digest_of_text("pub fn invert(value: Bool) -> Bool { !value }"),
    ), false) {
        vm_backend::Execution::Returned(1) => 1,
        _ => 0,
    }
}

fn source_parameter_conditional_smoke() -> i64 {
    handle service::compile_source_i64_select_parameter_function(source::input(
        "self-host-stage0@0.1.0",
        "src/root-select.glorious",
        __g1_text_as_bytes("pub fn select(condition: Bool) -> i64 { if condition { 7 } else { 9 } }"),
        identity::digest_of_text("pub fn select(condition: Bool) -> i64 { if condition { 7 } else { 9 } }"),
    ), false) {
        vm_backend::Execution::Returned(9) => 1,
        _ => 0,
    }
}

// Keep literal-condition branch artifact selection in the compiler-scale
// harness as well as the focused service probe. The canonical source verifier
// must accept the selected i64 callable image before this contributes.
fn source_branch_artifact_smoke() -> i64 {
    handle service::compile_manifest_branch_bool_entry(true, 42, 9) {
        vm_backend::ArtifactEmission::Artifact(bytes) => score(vm_backend::verify_g1_i64_callable_artifact(bytes)),
        vm_backend::ArtifactEmission::Rejected => 0,
        _ => 0,
    }
}

fn regression_harness() -> i64 {
    bootstrap_quantity::smoke() + bootstrap_transaction::smoke() + bootstrap_result::smoke() + main_cli::default_exit() + main_cli_smoke() + integration_smoke() + identity_smoke() + scanner_smoke() + source_identity_smoke() + scanner_cursor_smoke() + scanner_checked_cursor_smoke() + scanner_checked_match_smoke() + header_smoke() + header_checked_smoke() + interface_smoke() + diagnostic_smoke() + diagnostic_provenance_smoke() + quantity_smoke() + operation_smoke() + output_smoke() + resolution_smoke() + core_smoke() + pattern_smoke() + coherence_smoke() + trait_solver_smoke() + flow_smoke() + mir_storage_smoke() + instance_smoke() + runtime_manifest_smoke() + vm_backend_smoke() + bootstrap_smoke() + artifact_cache_smoke() + revision_smoke() + query_smoke() + service_smoke() + keyed_service_smoke() + cached_keyed_service_smoke() + request_smoke() + boundary_scanner_smoke() + boundary_query_smoke() + boundary_cancellation_smoke() + boundary_cache_smoke() + boundary_bootstrap_smoke() + bootstrap_codec_smoke() + source_artifact_smoke() + source_binary_call_artifact_smoke() + source_parameter_smoke() + source_parameter_boolean_smoke() + source_parameter_conditional_smoke() + source_branch_artifact_smoke()
}

// A bound process-args host turns the complete source world into its first
// executable compiler-driver slice.  Without that explicit authority the
// canonical source-world run keeps executing the regression harness, so the
// seed cannot acquire ambient argv or filesystem behavior.
fn emit_vm_driver_exit() -> i64 {
    handle service::emit_vm_entry_from_process_args() {
        service::EmitUnitEntryResult::Written => 0,
        service::EmitUnitEntryResult::Rejected => emit_vm_driver_rejected(),
        _ => 1,
    }
}

fn emit_vm_driver_rejected() -> i64 {
    driver_rejected("self-host emit-vm rejected")
}

fn check_driver_exit() -> i64 {
    handle main_cli::parse_process_argv_check_request() {
        main_cli::CheckRequest::Value(package, source_path) => check_service_exit(service::check_file(package, source_path)),
        main_cli::CheckRequest::Invalid => driver_rejected("self-host check rejected"),
        _ => driver_rejected("self-host check rejected"),
    }
}

fn check_service_exit(outcome: service::ServiceOutcome) -> i64 {
    handle outcome {
        service::ServiceOutcome::Program => 0,
        _ => driver_rejected("self-host check rejected"),
    }
}

fn run_driver_exit() -> i64 {
    handle main_cli::parse_process_argv_run_request() {
        main_cli::RunRequest::Value(package, source_path) => run_service_exit(service::run_file(package, source_path)),
        main_cli::RunRequest::Invalid => driver_rejected("self-host run rejected"),
        _ => driver_rejected("self-host run rejected"),
    }
}

fn run_service_exit(outcome: vm_backend::Execution) -> i64 {
    handle outcome {
        vm_backend::Execution::Returned(value) => value,
        // `u32` is wholly representable by i64.  This checked conversion is
        // an explicit process-protocol adaptation, after the service has
        // retained the typed result through parsing, lowering, and execution.
        vm_backend::Execution::ReturnedU32(value) => __g1_int_convert_checked_to_i64<u32>(value),
        _ => driver_rejected("self-host run rejected"),
    }
}

fn verify_vm_driver_exit() -> i64 {
    handle service::verify_vm_entry_from_process_args() {
        service::VerifyVmEntryResult::Verified => 0,
        service::VerifyVmEntryResult::Rejected => driver_rejected("self-host verify-vm rejected"),
        _ => driver_rejected("self-host verify-vm rejected"),
    }
}

fn driver_rejected(message: Text) -> i64 {
    let diagnostic = diagnostic::request(
        diagnostic::code("G1000"),
        message,
    );
    let ignored = compiler_support::write_diagnostic(diagnostic::message(diagnostic));
    1
}

fn unsupported_command_exit() -> i64 {
    driver_rejected("self-host command not implemented")
}

pub fn main() -> i64 {
    handle main_cli::parse_process_argv_command_at(1) {
        main_cli::ArgvCommand::Value(main_cli::Command::EmitVm) => emit_vm_driver_exit(),
        main_cli::ArgvCommand::Value(main_cli::Command::Check) => check_driver_exit(),
        main_cli::ArgvCommand::Value(main_cli::Command::Run) => run_driver_exit(),
        main_cli::ArgvCommand::Value(main_cli::Command::VerifyVm) => verify_vm_driver_exit(),
        main_cli::ArgvCommand::Value(_) => unsupported_command_exit(),
        _ => regression_harness(),
    }
}
