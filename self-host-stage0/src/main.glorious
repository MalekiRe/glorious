        "self-host-stage0@0.1.0",
        "src/main.glorious",
        __g1_text_as_bytes("fn main"),
        identity::digest_of_text("wrong"),
    )))
}

fn header_checked_score(value: header::SourceHeaderAdmission) -> i64 {
    handle value {
        header::SourceHeaderAdmission::Value(prefix) => handle header::lead(prefix) {
            header::HeaderLead::Function => 1,
            _ => 0,
        },
        header::SourceHeaderAdmission::Unadmitted => 1,
        _ => 0,
    }
}

