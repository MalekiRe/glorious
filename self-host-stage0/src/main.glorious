            stack,
            fixity::fixity(fixity::FixityForm::InfixLeft, 20),
        ) {
            fixity::ReductionDecision::Reduce => 1,
            _ => 0,
        },
        _ => 0,
    }
}

fn header_checked_smoke() -> i64 {
    header_checked_score(header::declaration_checked(source::input(
        "self-host-stage0@0.1.0",
        "src/main.glorious",
        __g1_text_as_bytes("fn main"),
        identity::digest_of_text("fn main"),
