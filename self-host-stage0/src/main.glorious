}

fn trait_solver_smoke() -> i64 {
    handle trait_solver::solve(
        trait_solver::negative_implementation("Bootstrap", types::Type::Usize),
        trait_solver::goal("Bootstrap", types::Type::Usize),
    ) {
        trait_solver::Answer::Satisfied(_) => 0,
        trait_solver::Answer::Refuted(_) => 10,
        trait_solver::Answer::Unsatisfied => 0,
        trait_solver::Answer::Ambiguous => 0,
        _ => 0,
    }
}

fn flow_smoke() -> i64 {
    score(placeflow::can_read(placeflow::join(
        placeflow::available(),
        placeflow::available(),
    ))) + handle placeflow::call_argument(placeflow::available(), placeflow::ArgumentMode::Borrow) {
        placeflow::CallAdmission::Value(state) => score(placeflow::can_read(state)),
        _ => 0,
    } + handle useflow::consume(useflow::join(useflow::uses(2), useflow::uses(4))) {
        useflow::ConsumeResult::Value(state) => score(useflow::remaining(state) == 1),
        useflow::ConsumeResult::Exhausted => 0,
        _ => 0,
    } + score(useflow::remaining(useflow::uses(-1)) == 0) + handle escape::return_place(placeflow::join(
        placeflow::available(),
        placeflow::move_out(placeflow::available()),
    )) {
        escape::EscapeResult::Allowed => 0,
        escape::EscapeResult::Rejected => 1,
        _ => 0,
    } + handle escape::return_place(placeflow::initialize(placeflow::move_out(placeflow::available()))) {
        escape::EscapeResult::Allowed => 1,
        escape::EscapeResult::Rejected => 0,
        _ => 0,
    }
}

