fn main_cli_smoke() -> i64 {
    handle main_cli::select(main_cli::parse("run")) {
        main_cli::CommandResult::Accepted => main_cli::value_count(main_cli::parse_flag("--source")) + main_cli_invocation_smoke() + main_cli_option_smoke(),
        main_cli::CommandResult::Rejected => 0,
        _ => 0,
    }
}

// Keep result elimination at a direct function boundary. The bootstrap MIR
// lowering currently represents handlers as terminators, so nesting another
// handler under a selected branch would manufacture a continuation payload.
// This source-level split preserves the same CLI contract while producing the
// direct control-flow shape intended for the eventual self-hosted backend.
fn main_cli_invocation_smoke() -> i64 {
    handle main_cli::validate_invocation(main_cli::Command::EmitBootstrapVm, 3) {
        main_cli::InvocationResult::Accepted => 1,
        _ => 0,
    } + handle main_cli::validate_invocation(main_cli::Command::EmitBootstrapVm, 2) {
        main_cli::InvocationResult::MissingManifest => 1,
        _ => 0,
    }
}

fn main_cli_option_smoke() -> i64 {
    main_cli::value_count(main_cli::parse_flag("--capability"))
        + main_cli::value_count(main_cli::parse_flag("--runtime-host"))
        + handle main_cli::validate_diagnostic_format(1, "json") {
            main_cli::DiagnosticFormatResult::Value(main_cli::DiagnosticFormat::Json) => 1,
            _ => 0,
        } + handle main_cli::validate_unique_occurrences(2) {
            main_cli::OptionMultiplicity::Duplicate => 1,
            _ => 0,
        }
}

// Exercise the shared scalar vocabulary through the body-to-Core boundary in
// the production source world, rather than only through its isolated probe.
fn core_smoke() -> i64 {
    handle core::lower(body::Expression::U8(7), types::Type::U8) {
        core::CoreResult::Value(value) => score(core::result_is(value, types::Type::U8)),
        core::CoreResult::TypeError => 0,
        _ => 0,
    } + handle core::lower(body::Expression::Usize(7), types::Type::Usize) {
        core::CoreResult::Value(value) => score(core::result_is(value, types::Type::Usize)),
        core::CoreResult::TypeError => 0,
        _ => 0,
    } + handle core::lower(body::Expression::U32(7), types::Type::U32) {
        core::CoreResult::Value(value) => score(core::result_is(value, types::Type::U32)),
        core::CoreResult::TypeError => 0,
        _ => 0,
    } + handle core::lower(
        body::Expression::Call2(
            signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool),
            types::Type::I64,
            types::Type::U8,
        ),
        types::Type::Bool,
    ) {
        core::CoreResult::Value(value) => score(core::is_call(value)),
        core::CoreResult::TypeError => 0,
        _ => 0,
    } + compiler_pipeline_smoke()
}

fn compiler_pipeline_smoke() -> i64 {
    handle service::compile_i64_literal(7, types::Type::I64) {
        vm_backend::Execution::Returned(7) => 1,
        _ => 0,
    } + handle service::compile_i64_literal(7, types::Type::Bool) {
        vm_backend::Execution::Faulted => 1,
        _ => 0,
    } + handle service::compile_bool_literal(true, types::Type::Bool) {
        vm_backend::Execution::Returned(1) => 1,
        _ => 0,
    } + handle service::compile_bool_literal(false, types::Type::Bool) {
        vm_backend::Execution::Returned(0) => 1,
        _ => 0,
    } + handle service::compile_i64_arithmetic(body::Arithmetic::Add, 20, 22, types::Type::I64) {
        vm_backend::Execution::Returned(42) => 1,
        _ => 0,
    } + handle service::compile_i64_arithmetic(body::Arithmetic::Add, 20, 22, types::Type::Bool) {
        vm_backend::Execution::Faulted => 1,
        _ => 0,
    } + handle service::compile_i64_arithmetic(body::Arithmetic::Multiply, 6, 7, types::Type::I64) {
        vm_backend::Execution::Returned(42) => 1,
        _ => 0,
    } + handle service::compile_i64_arithmetic(body::Arithmetic::Divide, 84, 2, types::Type::I64) {
        vm_backend::Execution::Returned(42) => 1,
        _ => 0,
    } + handle service::compile_i64_arithmetic(body::Arithmetic::Divide, 84, 0, types::Type::I64) {
        vm_backend::Execution::Faulted => 1,
        _ => 0,
    }
}

fn pattern_smoke() -> i64 {
    score(pattern::matches(pattern::Pattern::U32(7), pattern::Value::U32(7)))
        + score(pattern::matches(pattern::Pattern::U64(7), pattern::Value::U64(7)))
        + score(pattern::matches(pattern::Pattern::U8(7), pattern::Value::U8(7)))
        + score(pattern::matches(pattern::Pattern::Usize(7), pattern::Value::Usize(7)))
}

