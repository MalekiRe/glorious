// The canonical-world gate executes this cross-module path. It intentionally
// uses production facades rather than a probe-only library, so duplicate-safe
// source topology and canonical dependency journaling are exercised together.
fn integration_smoke() -> i64 {
    let graph = module_graph::extend(module_graph::extend(module_graph::root("crate"), "crate.source"), "crate.source");
    let journal = dependency::record(dependency::record(dependency::record(dependency::journal(), "source"), "core"), "source");
    module_graph::count(graph) + dependency::recorded_count(journal) + handle dependency::record_at(
        dependency::revision_journal(revision::root(4)),
        revision::root(4),
        "core",
    ) {
        dependency::JournalPublication::Value(value) => score(dependency::revision_recorded_count(value) == 1),
        _ => 0,
    } + cached_keyed_publication_smoke()
}

fn score(value: Bool) -> i64 {
    handle value { true => 1, false => 0, _ => 0 }
}

fn score_index(value: usize, expected: usize) -> i64 {
    score(value == expected)
}

fn identity_smoke() -> i64 {
    score(identity::equals(identity::digest_of_text("canonical"), identity::digest_of_text("canonical")))
        + score(identity::same_module(
            identity::module_key("self-host-stage0@0.1.0", "src/main.glorious"),
            identity::module_key("self-host-stage0@0.1.0", "src/main.glorious"),
        ))
}

fn scanner_smoke() -> i64 {
    score(source::digest_matches_bytes(source::input(
        "self-host-stage0@0.1.0",
        "src/main.glorious",
        __g1_text_as_bytes("_"),
        identity::digest_of_text("_"),
    ))) + score(scanner::can_start_identifier(source::input(
        "self-host-stage0@0.1.0",
        "src/main.glorious",
        __g1_text_as_bytes("_"),
        identity::digest_of_text("_"),
    ))) + score(scanner::first_is_line_feed(source::input(
        "self-host-stage0@0.1.0",
        "src/empty.glorious",
        __g1_text_as_bytes(""),
        identity::digest_of_text(""),
    ))) + score_index(scanner::identifier_end(__g1_text_as_bytes("abc7_!")), 5)
        + score_index(scanner::decimal_end(__g1_text_as_bytes("123a")), 3)
}

fn source_identity_smoke() -> i64 {
    score(source::same_identity(
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("_"), identity::digest_of_text("_")),
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("_"), identity::digest_of_text("_")),
    )) + handle source::checked_byte_slice(
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("_"), identity::digest_of_text("_")),
        1,
        0,
    ) {
        source::SliceAdmission::OutOfBounds => 1,
        _ => 0,
    } + handle source::checked_byte_at(
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("_"), identity::digest_of_text("_")),
        0,
    ) {
        source::ByteAdmission::Value(_) => 1,
        _ => 0,
    } + handle source::checked_byte_at(
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("_"), identity::digest_of_text("_")),
        1,
    ) {
        source::ByteAdmission::OutOfBounds => 1,
        _ => 0,
    }
}

fn scanner_cursor_smoke() -> i64 {
    handle scanner::token_kind(scanner::next_token(
        __g1_text_as_bytes("name !="),
        scanner::first_token(__g1_text_as_bytes("name !=")),
    )) {
        scanner::TokenKind::Operator => 1,
        _ => 0,
    }
}

fn scanner_checked_cursor_smoke() -> i64 {
    scanner_checked_cursor_score(scanner::next_token_checked(
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("name 7"), identity::digest_of_text("name 7")),
        scanner::first_token(__g1_text_as_bytes("name 7")),
    )) + scanner_checked_cursor_score(scanner::next_token_checked(
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("name 7"), identity::digest_of_text("wrong")),
        scanner::first_token(__g1_text_as_bytes("name 7")),
    ))
}

fn scanner_checked_match_smoke() -> i64 {
    score(scanner::token_matches_checked(
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("fn answer"), identity::digest_of_text("fn answer")),
        scanner::first_token(__g1_text_as_bytes("fn answer")),
        "fn",
    )) + score(scanner::token_matches_checked(
        source::input("self-host-stage0@0.1.0", "src/main.glorious", __g1_text_as_bytes("fn answer"), identity::digest_of_text("wrong")),
        scanner::first_token(__g1_text_as_bytes("fn answer")),
        "fn",
    ) == false)
}

fn scanner_checked_cursor_score(value: scanner::SourceToken) -> i64 {
    handle value {
        scanner::SourceToken::Value(token) => handle scanner::token_kind(token) {
            scanner::TokenKind::Integer => 1,
            scanner::TokenKind::Float => 1,
            scanner::TokenKind::Invalid => 1,
            _ => 0,
        },
        scanner::SourceToken::Unadmitted => 1,
        _ => 0,
    }
}

