// M01 scaffold: stable vocabulary and source-attached structured values.
use identity::Digest;
use identity::FileKey;
use identity::equals;
use identity::same_file_key;
use compiler_support::text_eq;
use compiler_support::__g1_bytes_len;
pub enum Severity {
    Error,
    Warning,
    Note,
}

pub enum DiagnosticClass {
    Request,
    InputCorruption,
    Source,
    Recovery,
    Resource,
    Cancellation,
    Cache,
    Invariant,
    Verification,
    Runtime,
}

pub struct DiagnosticCode {
    text: Text,
}

pub struct SourceSpan {
    file: FileKey,
    start: usize,
    end: usize,
}

pub enum SpanAdmission {
    Value(SourceSpan),
    Invalid,
}

pub enum DiagnosticPrimary {
    Source(SourceSpan),
    None,
}

pub enum DiagnosticProvenance {
    Input(Digest),
    None,
}

pub struct Diagnostic {
    severity: Severity,
    class: DiagnosticClass,
    code: DiagnosticCode,
    primary: DiagnosticPrimary,
    provenance: DiagnosticProvenance,
    message: Text,
}

pub fn span(file: FileKey, start: usize, end: usize) -> SourceSpan {
    SourceSpan { file: file, start: start, end: end }
}

// Source-attached diagnostics never manufacture an inverted range. Later
// source-map validation extends this with file length and UTF-8 boundaries.
pub fn checked_span(file: FileKey, start: usize, end: usize) -> SpanAdmission {
    handle start <= end {
        true => SpanAdmission::Value(span(file, start, end)),
        false => SpanAdmission::Invalid,
        _ => SpanAdmission::Invalid,
    }
}

// Once the source bytes are available, reject both inverted and past-end
// ranges before a diagnostic enters canonicalization. The length is obtained
// once, so span validation stays constant-time regardless of source size.
pub fn checked_span_in(file: FileKey, bytes: Bytes, start: usize, end: usize) -> SpanAdmission {
    handle start <= end {
        true => checked_span_end_in(file, start, end, __g1_bytes_len(bytes)),
        false => SpanAdmission::Invalid,
        _ => SpanAdmission::Invalid,
    }
}

fn checked_span_end_in(file: FileKey, start: usize, end: usize, length: usize) -> SpanAdmission {
    handle end <= length {
        true => SpanAdmission::Value(span(file, start, end)),
        false => SpanAdmission::Invalid,
        _ => SpanAdmission::Invalid,
    }
}

pub fn end(span: SourceSpan) -> usize {
    span.end
}

pub fn start(span: SourceSpan) -> usize {
    span.start
}

pub fn code(text: Text) -> DiagnosticCode {
    DiagnosticCode { text: text }
}

pub fn error(class: DiagnosticClass, code: DiagnosticCode, span: SourceSpan, message: Text) -> Diagnostic {
    Diagnostic {
        severity: Severity::Error,
        class: class,
        code: code,
        primary: DiagnosticPrimary::Source(span),
        provenance: DiagnosticProvenance::None,
        message: message,
    }
}

pub fn warning(class: DiagnosticClass, code: DiagnosticCode, span: SourceSpan, message: Text) -> Diagnostic {
    Diagnostic {
        severity: Severity::Warning,
        class: class,
        code: code,
        primary: DiagnosticPrimary::Source(span),
        provenance: DiagnosticProvenance::None,
        message: message,
    }
}

pub fn note(class: DiagnosticClass, code: DiagnosticCode, span: SourceSpan, message: Text) -> Diagnostic {
    Diagnostic {
        severity: Severity::Note,
        class: class,
        code: code,
        primary: DiagnosticPrimary::Source(span),
        provenance: DiagnosticProvenance::None,
        message: message,
    }
}

// Request failures are intentionally unspanned: stage0 must report malformed
// worlds and command-line inputs even when no source file has been admitted.
pub fn request(code: DiagnosticCode, message: Text) -> Diagnostic {
    Diagnostic {
        severity: Severity::Error,
        class: DiagnosticClass::Request,
        code: code,
        primary: DiagnosticPrimary::None,
        provenance: DiagnosticProvenance::None,
        message: message,
    }
}

pub fn with_input(diagnostic: Diagnostic, input: Digest) -> Diagnostic {
    Diagnostic {
        severity: diagnostic.severity,
        class: diagnostic.class,
        code: diagnostic.code,
        primary: diagnostic.primary,
        provenance: DiagnosticProvenance::Input(input),
        message: diagnostic.message,
    }
}

pub fn is_error(diagnostic: Diagnostic) -> Bool {
    handle diagnostic.severity {
        Severity::Error => true,
        Severity::Warning => false,
        Severity::Note => false,
        _ => false,
    }
}

pub fn is_warning(diagnostic: Diagnostic) -> Bool {
    handle diagnostic.severity {
        Severity::Error => false,
        Severity::Warning => true,
        Severity::Note => false,
        _ => false,
    }
}

pub fn is_note(diagnostic: Diagnostic) -> Bool {
    handle diagnostic.severity {
        Severity::Error => false,
        Severity::Warning => false,
        Severity::Note => true,
        _ => false,
    }
}

pub fn has_code(diagnostic: Diagnostic, expected: Text) -> Bool {
    text_eq(diagnostic.code.text, expected)
}

pub fn has_message(diagnostic: Diagnostic, expected: Text) -> Bool {
    text_eq(diagnostic.message, expected)
}

// Rendering is deliberately outside diagnostic identity, but the service
// boundary may project the source-owned message after it has selected a
// structured diagnostic.  Host renderers never reconstruct this value.
pub fn message(diagnostic: Diagnostic) -> Text {
    diagnostic.message
}

pub fn has_severity(diagnostic: Diagnostic, expected: Severity) -> Bool {
    severity_matches(diagnostic.severity, expected)
}

fn severity_matches(actual: Severity, expected: Severity) -> Bool {
    handle (actual, expected) {
        (Severity::Error, Severity::Error) => true,
        (Severity::Warning, Severity::Warning) => true,
        (Severity::Note, Severity::Note) => true,
        _ => false,
    }
}

pub fn has_primary(diagnostic: Diagnostic) -> Bool {
    handle diagnostic.primary {
        DiagnosticPrimary::Source(_) => true,
        DiagnosticPrimary::None => false,
        _ => false,
    }
}

pub fn has_input(diagnostic: Diagnostic) -> Bool {
    handle diagnostic.provenance {
        DiagnosticProvenance::Input(_) => true,
        DiagnosticProvenance::None => false,
        _ => false,
    }
}

// Structured consumers must compare identity-bearing provenance directly,
// rather than reducing it to the lossy `has_input` predicate used by simple
// renderers. This keeps diagnostic deduplication and incremental invalidation
// source-owned.
pub fn has_input_digest(diagnostic: Diagnostic, expected: Digest) -> Bool {
    handle diagnostic.provenance {
        DiagnosticProvenance::Input(actual) => equals(actual, expected),
        DiagnosticProvenance::None => false,
        _ => false,
    }
}

pub fn has_primary_file(diagnostic: Diagnostic, expected: FileKey) -> Bool {
    handle diagnostic.primary {
        DiagnosticPrimary::Source(span) => same_file_key(span.file, expected),
        DiagnosticPrimary::None => false,
        _ => false,
    }
}

// Consumers that merge or suppress diagnostics need the complete canonical
// location, not merely a matching source file. Keep this comparison at the
// structured boundary so renderers never have to parse text to recover it.
pub fn has_primary_span(diagnostic: Diagnostic, expected: SourceSpan) -> Bool {
    handle diagnostic.primary {
        DiagnosticPrimary::Source(actual) => primary_span_matches(actual, expected),
        DiagnosticPrimary::None => false,
        _ => false,
    }
}

fn primary_span_matches(actual: SourceSpan, expected: SourceSpan) -> Bool {
    handle same_file_key(actual.file, expected.file) {
        true => handle actual.start == expected.start {
            true => actual.end == expected.end,
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

// Canonical diagnostic equality is the structured deduplication key used by
// request publication: text, stable classification/severity, source range,
// and input provenance must all agree. No renderer participates in this
// comparison, so text and JSON output cannot alter compiler behavior.
pub fn same(left: Diagnostic, right: Diagnostic) -> Bool {
    handle has_code(left, right.code.text) {
        true => handle has_message(left, right.message) {
            true => handle has_class(left, right.class) {
                true => handle has_severity(left, right.severity) {
                    true => same_primary(left.primary, right.primary, left.provenance, right.provenance),
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

fn same_primary(left: DiagnosticPrimary, right: DiagnosticPrimary, left_provenance: DiagnosticProvenance, right_provenance: DiagnosticProvenance) -> Bool {
    handle (left, right) {
        (DiagnosticPrimary::None, DiagnosticPrimary::None) => same_provenance(left_provenance, right_provenance),
        (DiagnosticPrimary::Source(left_span), DiagnosticPrimary::Source(right_span)) => handle primary_span_matches(left_span, right_span) {
            true => same_provenance(left_provenance, right_provenance),
            false => false,
            _ => false,
        },
        _ => false,
    }
}

fn same_provenance(left: DiagnosticProvenance, right: DiagnosticProvenance) -> Bool {
    handle (left, right) {
        (DiagnosticProvenance::None, DiagnosticProvenance::None) => true,
        (DiagnosticProvenance::Input(left_digest), DiagnosticProvenance::Input(right_digest)) => equals(left_digest, right_digest),
        _ => false,
    }
}

pub fn has_class(diagnostic: Diagnostic, expected: DiagnosticClass) -> Bool {
    handle (diagnostic.class, expected) {
        (DiagnosticClass::Request, DiagnosticClass::Request) => true,
        (DiagnosticClass::InputCorruption, DiagnosticClass::InputCorruption) => true,
        (DiagnosticClass::Source, DiagnosticClass::Source) => true,
        (DiagnosticClass::Recovery, DiagnosticClass::Recovery) => true,
        (DiagnosticClass::Resource, DiagnosticClass::Resource) => true,
        (DiagnosticClass::Cancellation, DiagnosticClass::Cancellation) => true,
        (DiagnosticClass::Cache, DiagnosticClass::Cache) => true,
        (DiagnosticClass::Invariant, DiagnosticClass::Invariant) => true,
        (DiagnosticClass::Verification, DiagnosticClass::Verification) => true,
        (DiagnosticClass::Runtime, DiagnosticClass::Runtime) => true,
        _ => false,
    }
}
