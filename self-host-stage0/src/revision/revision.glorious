// M31 scaffold: immutable snapshot lifecycle admission. Database-local IDs,
// parent worlds, session staging, cache retirement, and pin accounting extend
// this facade once the shared revision store is available.
pub enum SnapshotStatus { Active, Stale, Retired }
pub enum SnapshotAdmission { Value, Stale, Retired }
pub enum RevisionEvent { Keep, Supersede, Retire }

// Snapshot identity is source-owned and monotonic. Parent identity is kept
// separately from lifecycle state so a child can never be mistaken for its
// ancestor after a later retirement sweep.
pub struct Snapshot {
    id: i64,
    parent: i64,
    has_parent: Bool,
    status: SnapshotStatus,
}

pub enum SnapshotCreation { Value(Snapshot), ParentUnavailable, NonMonotonic }
pub enum RootCreation { Value(Snapshot), Invalid }
pub enum RetentionCollection { Active, Pinned(i64), Collected }
// Request-local package staging is distinct from immutable snapshot state.
// A failed package transaction is terminal and cannot be reopened under the
// same request, matching the Rust service's rollback authority boundary.
pub enum PackageSessionStatus { Open, Staged, Committed, RolledBack }
pub enum PackageSessionAdmission { Value(PackageSessionStatus), NotOpen, Unstaged, RolledBack }

// Retention bookkeeping is kept with the immutable world rather than with a
// global counter.  That makes a collection decision inspectable and prevents
// a child revision from consuming a parent revision's pins.
pub struct Retention {
    snapshot: Snapshot,
    snapshot_pins: i64,
    session_pins: i64,
}

pub fn root(id: i64) -> Snapshot {
    Snapshot { id: id, parent: 0, has_parent: false, status: SnapshotStatus::Active }
}

pub fn retention(snapshot: Snapshot) -> Retention {
    Retention { snapshot: snapshot, snapshot_pins: 0, session_pins: 0 }
}

pub fn pin_snapshot(value: Retention) -> Retention {
    Retention { snapshot: value.snapshot, snapshot_pins: value.snapshot_pins + 1, session_pins: value.session_pins }
}

pub fn pin_session(value: Retention) -> Retention {
    Retention { snapshot: value.snapshot, snapshot_pins: value.snapshot_pins, session_pins: value.session_pins + 1 }
}

pub fn release_snapshot(value: Retention) -> Retention {
    handle value.snapshot_pins > 0 {
        true => Retention { snapshot: value.snapshot, snapshot_pins: value.snapshot_pins - 1, session_pins: value.session_pins },
        false => value,
        _ => value,
    }
}

pub fn release_session(value: Retention) -> Retention {
    handle value.session_pins > 0 {
        true => Retention { snapshot: value.snapshot, snapshot_pins: value.snapshot_pins, session_pins: value.session_pins - 1 },
        false => value,
        _ => value,
    }
}

pub fn retention_pin_count(value: Retention) -> i64 {
    value.snapshot_pins + value.session_pins
}

// Retirement stops admission of new work but deliberately preserves the
// world record until its existing snapshots and sessions have drained.
pub fn retire_retention(value: Retention) -> Retention {
    Retention { snapshot: apply(value.snapshot, RevisionEvent::Retire), snapshot_pins: value.snapshot_pins, session_pins: value.session_pins }
}

pub fn collect_retired(value: Retention) -> RetentionCollection {
    handle value.snapshot.status {
        SnapshotStatus::Retired => handle retention_pin_count(value) == 0 {
            true => RetentionCollection::Collected,
            false => RetentionCollection::Pinned(retention_pin_count(value)),
            _ => RetentionCollection::Pinned(retention_pin_count(value)),
        },
        _ => RetentionCollection::Active,
    }
}

pub fn open_package(active_request: Bool) -> PackageSessionAdmission {
    handle active_request { true => PackageSessionAdmission::Value(PackageSessionStatus::Open), false => PackageSessionAdmission::RolledBack, _ => PackageSessionAdmission::RolledBack }
}

pub fn stage_package(status: PackageSessionStatus) -> PackageSessionAdmission {
    handle status {
        PackageSessionStatus::Open => PackageSessionAdmission::Value(PackageSessionStatus::Staged),
        PackageSessionStatus::RolledBack => PackageSessionAdmission::RolledBack,
        _ => PackageSessionAdmission::NotOpen,
    }
}

pub fn commit_package(status: PackageSessionStatus) -> PackageSessionAdmission {
    handle status {
        PackageSessionStatus::Staged => PackageSessionAdmission::Value(PackageSessionStatus::Committed),
        PackageSessionStatus::Open => PackageSessionAdmission::Unstaged,
        PackageSessionStatus::RolledBack => PackageSessionAdmission::RolledBack,
        _ => PackageSessionAdmission::NotOpen,
    }
}

pub fn rollback_package(status: PackageSessionStatus) -> PackageSessionStatus {
    handle status {
        PackageSessionStatus::Committed => PackageSessionStatus::Committed,
        _ => PackageSessionStatus::RolledBack,
    }
}

pub fn may_publish_package(status: PackageSessionStatus) -> Bool {
    handle status { PackageSessionStatus::Staged => true, _ => false }
}

// Revision IDs are ordered database identities, not arbitrary signed values.
// Keep unchecked `root` for the trusted seed path and make request-derived
// root construction reject invalid IDs before a snapshot is published.
pub fn root_checked(id: i64) -> RootCreation {
    handle id < 0 {
        true => RootCreation::Invalid,
        false => RootCreation::Value(root(id)),
        _ => RootCreation::Invalid,
    }
}

// A child can be created only from an active parent and must advance the
// lineage identity. This mirrors the database admission boundary before any
// revision-local cache/query work is published.
pub fn child(parent: Snapshot, id: i64) -> SnapshotCreation {
    handle parent.status {
        SnapshotStatus::Active => handle id > parent.id {
            true => SnapshotCreation::Value(Snapshot { id: id, parent: parent.id, has_parent: true, status: SnapshotStatus::Active }),
            false => SnapshotCreation::NonMonotonic,
            _ => SnapshotCreation::NonMonotonic,
        },
        SnapshotStatus::Stale => SnapshotCreation::ParentUnavailable,
        SnapshotStatus::Retired => SnapshotCreation::ParentUnavailable,
        _ => SnapshotCreation::ParentUnavailable,
    }
}

pub fn apply(snapshot: Snapshot, event: RevisionEvent) -> Snapshot {
    Snapshot {
        id: snapshot.id,
        parent: snapshot.parent,
        has_parent: snapshot.has_parent,
        status: transition(snapshot.status, event),
    }
}

pub fn parent_is(snapshot: Snapshot, parent: i64) -> Bool {
    handle snapshot.has_parent {
        true => snapshot.parent == parent,
        false => false,
        _ => false,
    }
}

pub fn same(left: Snapshot, right: Snapshot) -> Bool {
    left.id == right.id
}

pub fn is_active(snapshot: Snapshot) -> Bool {
    handle snapshot.status {
        SnapshotStatus::Active => true,
        SnapshotStatus::Stale => false,
        SnapshotStatus::Retired => false,
        _ => false,
    }
}
pub fn admit(status: SnapshotStatus) -> SnapshotAdmission {
    handle status {
        SnapshotStatus::Active => SnapshotAdmission::Value,
        SnapshotStatus::Stale => SnapshotAdmission::Stale,
        SnapshotStatus::Retired => SnapshotAdmission::Retired,
        _ => SnapshotAdmission::Retired,
    }
}

// Snapshot lifecycle is monotonic: replacement can stale an active snapshot,
// retirement is terminal, and neither stale nor retired state may revive.
pub fn transition(status: SnapshotStatus, event: RevisionEvent) -> SnapshotStatus {
    handle (status, event) {
        (SnapshotStatus::Active, RevisionEvent::Keep) => SnapshotStatus::Active,
        (SnapshotStatus::Active, RevisionEvent::Supersede) => SnapshotStatus::Stale,
        (SnapshotStatus::Active, RevisionEvent::Retire) => SnapshotStatus::Retired,
        (SnapshotStatus::Stale, RevisionEvent::Retire) => SnapshotStatus::Retired,
        (SnapshotStatus::Stale, _) => SnapshotStatus::Stale,
        (SnapshotStatus::Retired, _) => SnapshotStatus::Retired,
        _ => SnapshotStatus::Retired,
    }
}
