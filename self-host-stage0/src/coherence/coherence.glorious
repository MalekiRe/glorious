// M16 starts with concrete and generic-Self implementation-head overlap.
// The frozen trait-argument sequence is part of that head: implementations
// of `Trait<I64>` and `Trait<U64>` are disjoint, even when their Self type is
// identical. Orphan anchors are admitted before overlap; generic argument
// unification and where-bound satisfiability extend this same boundary.
use compiler_support::branch_bool;
use compiler_support::text_eq;
use compiler_support::__g1_array_pop_move;
use types::Type;
use types::same;
use types::GenericArgument;
use types::same_generic_argument;
use types::Lifetime;

pub struct ImplementationHead {
    trait_name: Text,
    self_type: Type,
    trait_arguments: TraitArguments,
    polarity: ImplementationPolarity,
    generic_self: Bool,
    trait_origin: ImplementationOrigin,
    self_origin: ImplementationOrigin,
}

// This persistent sequence retains every mixed-kind argument in declared
// order. It deliberately reuses M14's `GenericArgument`, so a type, effect
// row, lifetime, or structural constant can never collide merely because its
// immediate numeric payload happens to match.
pub enum TraitArguments {
    Empty,
    Node(GenericArgument, Bool, Array<TraitArguments>),
}

// Positive and negative declarations occupy the same coherence namespace:
// either polarity conflicts with another declaration of the same trait/self
// head. Later generic overlap uses this preserved polarity when explaining a
// conflict, instead of treating a negative implementation as absence.
pub enum ImplementationPolarity {
    Positive,
    Negative,
}

pub enum ImplementationOrigin { Local, Foreign }

pub enum ImplementationAdmission {
    Value(ImplementationHead),
    OrphanViolation,
}

pub enum Overlap {
    Disjoint,
    Conflict,
}

// Generic parameters belong to one implementation head, never to the other
// head being compared. The side tag keeps identically numbered source binders
// distinct while a persistent chain remembers repeated occurrences.
pub enum BindingSide { Left, Right }
pub enum OverlapBindings {
    Empty,
    Binding(BindingSide, i64, Type, Bool, Array<OverlapBindings>),
    LifetimeBinding(BindingSide, i64, Lifetime, Bool, Array<OverlapBindings>),
}
pub enum OverlapBindingLookup {
    Found(Type, OverlapBindings),
    Missing(OverlapBindings),
}
pub enum OverlapLifetimeBindingLookup {
    Found(Lifetime, OverlapBindings),
    Missing(OverlapBindings),
}
pub enum ArgumentOverlap {
    Value(OverlapBindings),
    Disjoint,
}

pub fn implementation(trait_name: Text, self_type: Type) -> ImplementationHead {
    implementation_with_arguments(trait_name, self_type, empty_trait_arguments())
}

pub fn negative_implementation(trait_name: Text, self_type: Type) -> ImplementationHead {
    negative_implementation_with_arguments(trait_name, self_type, empty_trait_arguments())
}

pub fn generic_implementation(trait_name: Text) -> ImplementationHead {
    generic_implementation_with_arguments(trait_name, empty_trait_arguments())
}

pub fn generic_negative_implementation(trait_name: Text) -> ImplementationHead {
    generic_negative_implementation_with_arguments(trait_name, empty_trait_arguments())
}

pub fn implementation_with_arguments(trait_name: Text, self_type: Type, trait_arguments: TraitArguments) -> ImplementationHead {
    ImplementationHead { trait_name: trait_name, self_type: self_type, trait_arguments: trait_arguments, polarity: ImplementationPolarity::Positive, generic_self: false, trait_origin: ImplementationOrigin::Local, self_origin: ImplementationOrigin::Local }
}

pub fn negative_implementation_with_arguments(trait_name: Text, self_type: Type, trait_arguments: TraitArguments) -> ImplementationHead {
    ImplementationHead { trait_name: trait_name, self_type: self_type, trait_arguments: trait_arguments, polarity: ImplementationPolarity::Negative, generic_self: false, trait_origin: ImplementationOrigin::Local, self_origin: ImplementationOrigin::Local }
}

pub fn generic_implementation_with_arguments(trait_name: Text, trait_arguments: TraitArguments) -> ImplementationHead {
    ImplementationHead { trait_name: trait_name, self_type: Type::Generic(0), trait_arguments: trait_arguments, polarity: ImplementationPolarity::Positive, generic_self: true, trait_origin: ImplementationOrigin::Local, self_origin: ImplementationOrigin::Local }
}

pub fn generic_negative_implementation_with_arguments(trait_name: Text, trait_arguments: TraitArguments) -> ImplementationHead {
    ImplementationHead { trait_name: trait_name, self_type: Type::Generic(0), trait_arguments: trait_arguments, polarity: ImplementationPolarity::Negative, generic_self: true, trait_origin: ImplementationOrigin::Local, self_origin: ImplementationOrigin::Local }
}

// A package may implement a foreign trait for a local Self type, or a local
// trait for a foreign Self type. If both are foreign, no local coherence
// authority exists and the head must not enter overlap collection.
pub fn implementation_with_origins(trait_name: Text, self_type: Type, trait_origin: ImplementationOrigin, self_origin: ImplementationOrigin) -> ImplementationAdmission {
    admit_implementation(ImplementationHead { trait_name: trait_name, self_type: self_type, trait_arguments: empty_trait_arguments(), polarity: ImplementationPolarity::Positive, generic_self: false, trait_origin: trait_origin, self_origin: self_origin })
}

fn admit_implementation(head: ImplementationHead) -> ImplementationAdmission {
    handle (head.trait_origin, head.self_origin) {
        (ImplementationOrigin::Foreign, ImplementationOrigin::Foreign) => ImplementationAdmission::OrphanViolation,
        _ => ImplementationAdmission::Value(head),
    }
}

pub fn empty_trait_arguments() -> TraitArguments { TraitArguments::Empty }

pub fn single_trait_argument(value: GenericArgument) -> TraitArguments {
    TraitArguments::Node(value, false, [])
}

pub fn prepend_trait_argument(value: GenericArgument, tail: TraitArguments) -> TraitArguments {
    TraitArguments::Node(value, true, [tail])
}

pub fn overlap(left: ImplementationHead, right: ImplementationHead) -> Overlap {
    handle (left, right) {
        (
            ImplementationHead { trait_name: left_trait, self_type: left_type, trait_arguments: left_arguments, polarity: _, generic_self: left_generic, trait_origin: _, self_origin: _ },
            ImplementationHead { trait_name: right_trait, self_type: right_type, trait_arguments: right_arguments, polarity: _, generic_self: right_generic, trait_origin: _, self_origin: _ },
        ) => overlap_parts(left_trait, left_type, left_arguments, left_generic, right_trait, right_type, right_arguments, right_generic),
    }
}

fn overlap_parts(left_trait: Text, left_type: Type, left_arguments: TraitArguments, left_generic: Bool, right_trait: Text, right_type: Type, right_arguments: TraitArguments, right_generic: Bool) -> Overlap {
    branch_bool(
        text_eq(left_trait, right_trait),
        () -> Overlap { overlap_same_trait_arguments(left_type, left_arguments, left_generic, right_type, right_arguments, right_generic) },
        () -> Overlap { Overlap::Disjoint },
    )
}

fn overlap_same_trait_arguments(left_type: Type, left_arguments: TraitArguments, left_generic: Bool, right_type: Type, right_arguments: TraitArguments, right_generic: Bool) -> Overlap {
    handle unify_trait_arguments(left_arguments, right_arguments, OverlapBindings::Empty) {
        ArgumentOverlap::Value(_) => overlap_same_trait(left_type, left_generic, right_type, right_generic),
        ArgumentOverlap::Disjoint => Overlap::Disjoint,
        _ => Overlap::Disjoint,
    }
}

// This compact head unifier covers direct type parameters in trait arguments.
// It is deliberately stricter than a wildcard comparison: a repeated `T`
// must agree with every concrete position it encounters. Nested type shapes
// remain arena-addressed until their structural matcher is introduced.
fn unify_trait_arguments(left: TraitArguments, right: TraitArguments, bindings: OverlapBindings) -> ArgumentOverlap {
    handle (left, right) {
        (TraitArguments::Empty, TraitArguments::Empty) => ArgumentOverlap::Value(bindings),
        (TraitArguments::Node(left_value, left_has_tail, left_tail), TraitArguments::Node(right_value, right_has_tail, right_tail)) => unify_trait_argument_node(left_value, left_has_tail, left_tail, right_value, right_has_tail, right_tail, bindings),
        _ => ArgumentOverlap::Disjoint,
    }
}

fn unify_trait_argument_node(left_value: GenericArgument, left_has_tail: Bool, left_tail: Array<TraitArguments>, right_value: GenericArgument, right_has_tail: Bool, right_tail: Array<TraitArguments>, bindings: OverlapBindings) -> ArgumentOverlap {
    handle unify_trait_argument(left_value, right_value, bindings) {
        ArgumentOverlap::Value(next_bindings) => unify_trait_argument_tails(left_has_tail, left_tail, right_has_tail, right_tail, next_bindings),
        ArgumentOverlap::Disjoint => ArgumentOverlap::Disjoint,
        _ => ArgumentOverlap::Disjoint,
    }
}

fn unify_trait_argument(left: GenericArgument, right: GenericArgument, bindings: OverlapBindings) -> ArgumentOverlap {
    handle (left, right) {
        (GenericArgument::Type(left), GenericArgument::Type(right)) => unify_trait_argument_type(left, right, bindings),
        (GenericArgument::Lifetime(left), GenericArgument::Lifetime(right)) => unify_trait_argument_lifetime(left, right, bindings),
        (left, right) => handle same_generic_argument(left, right) {
            true => ArgumentOverlap::Value(bindings),
            false => ArgumentOverlap::Disjoint,
            _ => ArgumentOverlap::Disjoint,
        },
    }
}

fn unify_trait_argument_lifetime(left: Lifetime, right: Lifetime, bindings: OverlapBindings) -> ArgumentOverlap {
    handle (left, right) {
        (Lifetime::Generic(_), Lifetime::Generic(_)) => ArgumentOverlap::Value(bindings),
        (Lifetime::Generic(index), right_value) => bind_overlap_lifetime(bindings, BindingSide::Left, index, right_value),
        (left_value, Lifetime::Generic(index)) => bind_overlap_lifetime(bindings, BindingSide::Right, index, left_value),
        (left_value, right_value) => handle same_lifetime(left_value, right_value) {
            true => ArgumentOverlap::Value(bindings),
            false => ArgumentOverlap::Disjoint,
            _ => ArgumentOverlap::Disjoint,
        },
    }
}

fn same_lifetime(left: Lifetime, right: Lifetime) -> Bool {
    handle (left, right) {
        (Lifetime::Static, Lifetime::Static) => true,
        (Lifetime::Generic(left), Lifetime::Generic(right)) => left == right,
        (Lifetime::Bound(left_depth, left_index), Lifetime::Bound(right_depth, right_index)) => handle left_depth == right_depth { true => left_index == right_index, false => false, _ => false },
        (Lifetime::Elided, Lifetime::Elided) => true,
        _ => false,
    }
}

fn unify_trait_argument_type(left: Type, right: Type, bindings: OverlapBindings) -> ArgumentOverlap {
    handle (left, right) {
        (Type::Generic(_), Type::Generic(_)) => ArgumentOverlap::Value(bindings),
        (Type::Generic(left_index), right_value) => bind_overlap_type(bindings, BindingSide::Left, left_index, right_value),
        (left_value, Type::Generic(right_index)) => bind_overlap_type(bindings, BindingSide::Right, right_index, left_value),
        (left_value, right_value) => handle same(left_value, right_value) {
            true => ArgumentOverlap::Value(bindings),
            false => ArgumentOverlap::Disjoint,
            _ => ArgumentOverlap::Disjoint,
        },
    }
}

fn unify_trait_argument_tails(left_has_tail: Bool, left_tail: Array<TraitArguments>, right_has_tail: Bool, right_tail: Array<TraitArguments>, bindings: OverlapBindings) -> ArgumentOverlap {
    handle (left_has_tail, right_has_tail) {
        (false, false) => ArgumentOverlap::Value(bindings),
        (true, true) => unify_trait_arguments(__g1_array_pop_move<TraitArguments>(&mut left_tail), __g1_array_pop_move<TraitArguments>(&mut right_tail), bindings),
        _ => ArgumentOverlap::Disjoint,
    }
}

fn bind_overlap_type(bindings: OverlapBindings, side: BindingSide, index: i64, value: Type) -> ArgumentOverlap {
    handle lookup_overlap_type(bindings, side, index) {
        OverlapBindingLookup::Found(previous, next_bindings) => handle same(previous, value) {
            true => ArgumentOverlap::Value(next_bindings),
            false => ArgumentOverlap::Disjoint,
            _ => ArgumentOverlap::Disjoint,
        },
        OverlapBindingLookup::Missing(next_bindings) => ArgumentOverlap::Value(insert_overlap_type(next_bindings, side, index, value)),
        _ => ArgumentOverlap::Disjoint,
    }
}

fn same_binding_side(left: BindingSide, right: BindingSide) -> Bool {
    handle (left, right) {
        (BindingSide::Left, BindingSide::Left) => true,
        (BindingSide::Right, BindingSide::Right) => true,
        _ => false,
    }
}

fn lookup_overlap_type(bindings: OverlapBindings, wanted_side: BindingSide, wanted_index: i64) -> OverlapBindingLookup {
    handle bindings {
        OverlapBindings::Empty => OverlapBindingLookup::Missing(OverlapBindings::Empty),
        OverlapBindings::Binding(side, index, value, has_tail, tail) => lookup_overlap_type_node(side, index, value, has_tail, tail, wanted_side, wanted_index),
        OverlapBindings::LifetimeBinding(side, index, value, has_tail, tail) => lookup_overlap_type_after_lifetime(side, index, value, has_tail, tail, wanted_side, wanted_index),
        _ => OverlapBindingLookup::Missing(OverlapBindings::Empty),
    }
}

fn lookup_overlap_type_after_lifetime(side: BindingSide, index: i64, value: Lifetime, has_tail: Bool, tail: Array<OverlapBindings>, wanted_side: BindingSide, wanted_index: i64) -> OverlapBindingLookup {
    handle has_tail {
        true => rebuild_overlap_type_after_lifetime(side, index, value, lookup_overlap_type(__g1_array_pop_move<OverlapBindings>(&mut tail), wanted_side, wanted_index)),
        false => OverlapBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, false, tail)),
        _ => OverlapBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, false, tail)),
    }
}

fn rebuild_overlap_type_after_lifetime(side: BindingSide, index: i64, value: Lifetime, lookup: OverlapBindingLookup) -> OverlapBindingLookup {
    handle lookup {
        OverlapBindingLookup::Found(found, bindings) => OverlapBindingLookup::Found(found, OverlapBindings::LifetimeBinding(side, index, value, true, [bindings])),
        OverlapBindingLookup::Missing(bindings) => OverlapBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, true, [bindings])),
        _ => OverlapBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, false, [])),
    }
}

fn lookup_overlap_type_node(side: BindingSide, index: i64, value: Type, has_tail: Bool, tail: Array<OverlapBindings>, wanted_side: BindingSide, wanted_index: i64) -> OverlapBindingLookup {
    handle same_binding_side(side, wanted_side) {
        true => handle index == wanted_index {
            true => OverlapBindingLookup::Found(value, OverlapBindings::Binding(side, index, value, has_tail, tail)),
            false => lookup_overlap_type_tail(side, index, value, has_tail, tail, wanted_side, wanted_index),
            _ => OverlapBindingLookup::Missing(OverlapBindings::Binding(side, index, value, has_tail, tail)),
        },
        false => lookup_overlap_type_tail(side, index, value, has_tail, tail, wanted_side, wanted_index),
        _ => OverlapBindingLookup::Missing(OverlapBindings::Binding(side, index, value, has_tail, tail)),
    }
}

fn lookup_overlap_type_tail(side: BindingSide, index: i64, value: Type, has_tail: Bool, tail: Array<OverlapBindings>, wanted_side: BindingSide, wanted_index: i64) -> OverlapBindingLookup {
    handle has_tail {
        true => rebuild_overlap_type_lookup(side, index, value, lookup_overlap_type(__g1_array_pop_move<OverlapBindings>(&mut tail), wanted_side, wanted_index)),
        false => OverlapBindingLookup::Missing(OverlapBindings::Binding(side, index, value, false, tail)),
        _ => OverlapBindingLookup::Missing(OverlapBindings::Binding(side, index, value, false, tail)),
    }
}

fn rebuild_overlap_type_lookup(side: BindingSide, index: i64, value: Type, lookup: OverlapBindingLookup) -> OverlapBindingLookup {
    handle lookup {
        OverlapBindingLookup::Found(found, bindings) => OverlapBindingLookup::Found(found, OverlapBindings::Binding(side, index, value, true, [bindings])),
        OverlapBindingLookup::Missing(bindings) => OverlapBindingLookup::Missing(OverlapBindings::Binding(side, index, value, true, [bindings])),
        _ => OverlapBindingLookup::Missing(OverlapBindings::Binding(side, index, value, false, [])),
    }
}

fn insert_overlap_type(bindings: OverlapBindings, side: BindingSide, index: i64, value: Type) -> OverlapBindings {
    handle bindings {
        OverlapBindings::Empty => OverlapBindings::Binding(side, index, value, false, []),
        OverlapBindings::Binding(existing_side, existing_index, existing_value, has_tail, tail) => handle has_tail {
            true => OverlapBindings::Binding(existing_side, existing_index, existing_value, true, [insert_overlap_type(__g1_array_pop_move<OverlapBindings>(&mut tail), side, index, value)]),
            false => OverlapBindings::Binding(existing_side, existing_index, existing_value, true, [OverlapBindings::Binding(side, index, value, false, [])]),
            _ => OverlapBindings::Binding(existing_side, existing_index, existing_value, has_tail, tail),
        },
        OverlapBindings::LifetimeBinding(existing_side, existing_index, existing_value, has_tail, tail) => handle has_tail {
            true => OverlapBindings::LifetimeBinding(existing_side, existing_index, existing_value, true, [insert_overlap_type(__g1_array_pop_move<OverlapBindings>(&mut tail), side, index, value)]),
            false => OverlapBindings::LifetimeBinding(existing_side, existing_index, existing_value, true, [OverlapBindings::Binding(side, index, value, false, [])]),
            _ => OverlapBindings::LifetimeBinding(existing_side, existing_index, existing_value, has_tail, tail),
        },
        _ => OverlapBindings::Binding(side, index, value, false, []),
    }
}

fn bind_overlap_lifetime(bindings: OverlapBindings, side: BindingSide, index: i64, value: Lifetime) -> ArgumentOverlap {
    handle lookup_overlap_lifetime(bindings, side, index) {
        OverlapLifetimeBindingLookup::Found(previous, next_bindings) => handle same_lifetime(previous, value) {
            true => ArgumentOverlap::Value(next_bindings),
            false => ArgumentOverlap::Disjoint,
            _ => ArgumentOverlap::Disjoint,
        },
        OverlapLifetimeBindingLookup::Missing(next_bindings) => ArgumentOverlap::Value(insert_overlap_lifetime(next_bindings, side, index, value)),
        _ => ArgumentOverlap::Disjoint,
    }
}

fn lookup_overlap_lifetime(bindings: OverlapBindings, wanted_side: BindingSide, wanted_index: i64) -> OverlapLifetimeBindingLookup {
    handle bindings {
        OverlapBindings::Empty => OverlapLifetimeBindingLookup::Missing(OverlapBindings::Empty),
        OverlapBindings::Binding(side, index, value, has_tail, tail) => lookup_overlap_lifetime_after_type(side, index, value, has_tail, tail, wanted_side, wanted_index),
        OverlapBindings::LifetimeBinding(side, index, value, has_tail, tail) => lookup_overlap_lifetime_node(side, index, value, has_tail, tail, wanted_side, wanted_index),
        _ => OverlapLifetimeBindingLookup::Missing(OverlapBindings::Empty),
    }
}

fn lookup_overlap_lifetime_node(side: BindingSide, index: i64, value: Lifetime, has_tail: Bool, tail: Array<OverlapBindings>, wanted_side: BindingSide, wanted_index: i64) -> OverlapLifetimeBindingLookup {
    handle same_binding_side(side, wanted_side) {
        true => handle index == wanted_index {
            true => OverlapLifetimeBindingLookup::Found(value, OverlapBindings::LifetimeBinding(side, index, value, has_tail, tail)),
            false => lookup_overlap_lifetime_tail(side, index, value, has_tail, tail, wanted_side, wanted_index),
            _ => OverlapLifetimeBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, has_tail, tail)),
        },
        false => lookup_overlap_lifetime_tail(side, index, value, has_tail, tail, wanted_side, wanted_index),
        _ => OverlapLifetimeBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, has_tail, tail)),
    }
}

fn lookup_overlap_lifetime_after_type(side: BindingSide, index: i64, value: Type, has_tail: Bool, tail: Array<OverlapBindings>, wanted_side: BindingSide, wanted_index: i64) -> OverlapLifetimeBindingLookup {
    handle has_tail {
        true => rebuild_overlap_lifetime_after_type(side, index, value, lookup_overlap_lifetime(__g1_array_pop_move<OverlapBindings>(&mut tail), wanted_side, wanted_index)),
        false => OverlapLifetimeBindingLookup::Missing(OverlapBindings::Binding(side, index, value, false, tail)),
        _ => OverlapLifetimeBindingLookup::Missing(OverlapBindings::Binding(side, index, value, false, tail)),
    }
}

fn lookup_overlap_lifetime_tail(side: BindingSide, index: i64, value: Lifetime, has_tail: Bool, tail: Array<OverlapBindings>, wanted_side: BindingSide, wanted_index: i64) -> OverlapLifetimeBindingLookup {
    handle has_tail {
        true => rebuild_overlap_lifetime_lookup(side, index, value, lookup_overlap_lifetime(__g1_array_pop_move<OverlapBindings>(&mut tail), wanted_side, wanted_index)),
        false => OverlapLifetimeBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, false, tail)),
        _ => OverlapLifetimeBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, false, tail)),
    }
}

fn rebuild_overlap_lifetime_after_type(side: BindingSide, index: i64, value: Type, lookup: OverlapLifetimeBindingLookup) -> OverlapLifetimeBindingLookup {
    handle lookup {
        OverlapLifetimeBindingLookup::Found(found, bindings) => OverlapLifetimeBindingLookup::Found(found, OverlapBindings::Binding(side, index, value, true, [bindings])),
        OverlapLifetimeBindingLookup::Missing(bindings) => OverlapLifetimeBindingLookup::Missing(OverlapBindings::Binding(side, index, value, true, [bindings])),
        _ => OverlapLifetimeBindingLookup::Missing(OverlapBindings::Binding(side, index, value, false, [])),
    }
}

fn rebuild_overlap_lifetime_lookup(side: BindingSide, index: i64, value: Lifetime, lookup: OverlapLifetimeBindingLookup) -> OverlapLifetimeBindingLookup {
    handle lookup {
        OverlapLifetimeBindingLookup::Found(found, bindings) => OverlapLifetimeBindingLookup::Found(found, OverlapBindings::LifetimeBinding(side, index, value, true, [bindings])),
        OverlapLifetimeBindingLookup::Missing(bindings) => OverlapLifetimeBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, true, [bindings])),
        _ => OverlapLifetimeBindingLookup::Missing(OverlapBindings::LifetimeBinding(side, index, value, false, [])),
    }
}

fn insert_overlap_lifetime(bindings: OverlapBindings, side: BindingSide, index: i64, value: Lifetime) -> OverlapBindings {
    handle bindings {
        OverlapBindings::Empty => OverlapBindings::LifetimeBinding(side, index, value, false, []),
        OverlapBindings::Binding(existing_side, existing_index, existing_value, has_tail, tail) => handle has_tail {
            true => OverlapBindings::Binding(existing_side, existing_index, existing_value, true, [insert_overlap_lifetime(__g1_array_pop_move<OverlapBindings>(&mut tail), side, index, value)]),
            false => OverlapBindings::Binding(existing_side, existing_index, existing_value, true, [OverlapBindings::LifetimeBinding(side, index, value, false, [])]),
            _ => OverlapBindings::Binding(existing_side, existing_index, existing_value, has_tail, tail),
        },
        OverlapBindings::LifetimeBinding(existing_side, existing_index, existing_value, has_tail, tail) => handle has_tail {
            true => OverlapBindings::LifetimeBinding(existing_side, existing_index, existing_value, true, [insert_overlap_lifetime(__g1_array_pop_move<OverlapBindings>(&mut tail), side, index, value)]),
            false => OverlapBindings::LifetimeBinding(existing_side, existing_index, existing_value, true, [OverlapBindings::LifetimeBinding(side, index, value, false, [])]),
            _ => OverlapBindings::LifetimeBinding(existing_side, existing_index, existing_value, has_tail, tail),
        },
        _ => OverlapBindings::LifetimeBinding(side, index, value, false, []),
    }
}

fn overlap_same_trait(left: Type, left_generic: Bool, right: Type, right_generic: Bool) -> Overlap {
    handle left_generic {
        true => Overlap::Conflict,
        false => handle right_generic {
            true => Overlap::Conflict,
            false => overlap_exact_self_type(left, right),
            _ => Overlap::Disjoint,
        },
        _ => Overlap::Disjoint,
    }
}

fn overlap_exact_self_type(left: Type, right: Type) -> Overlap {
    branch_bool(
        same(left, right),
        () -> Overlap { Overlap::Conflict },
        () -> Overlap { Overlap::Disjoint },
    )
}

pub fn same_trait_arguments(left: TraitArguments, right: TraitArguments) -> Bool {
    handle (left, right) {
        (TraitArguments::Empty, TraitArguments::Empty) => true,
        (TraitArguments::Node(left_value, left_has_tail, left_tail), TraitArguments::Node(right_value, right_has_tail, right_tail)) => same_trait_argument_node(left_value, left_has_tail, left_tail, right_value, right_has_tail, right_tail),
        (left, right) => discard_trait_argument_pair(left, right),
    }
}

fn same_trait_argument_node(left_value: GenericArgument, left_has_tail: Bool, left_tail: Array<TraitArguments>, right_value: GenericArgument, right_has_tail: Bool, right_tail: Array<TraitArguments>) -> Bool {
    handle same_generic_argument(left_value, right_value) {
        true => same_trait_argument_tails(left_has_tail, left_tail, right_has_tail, right_tail),
        false => discard_trait_argument_tails(left_has_tail, left_tail, right_has_tail, right_tail),
        _ => false,
    }
}

fn same_trait_argument_tails(left_has_tail: Bool, left_tail: Array<TraitArguments>, right_has_tail: Bool, right_tail: Array<TraitArguments>) -> Bool {
    handle (left_has_tail, right_has_tail) {
        (false, false) => true,
        (true, true) => same_trait_arguments(__g1_array_pop_move<TraitArguments>(&mut left_tail), __g1_array_pop_move<TraitArguments>(&mut right_tail)),
        (true, false) => discard_single_trait_argument_tail(left_tail),
        (false, true) => discard_single_trait_argument_tail(right_tail),
        _ => false,
    }
}

fn discard_trait_argument_tails(left_has_tail: Bool, left_tail: Array<TraitArguments>, right_has_tail: Bool, right_tail: Array<TraitArguments>) -> Bool {
    handle (left_has_tail, right_has_tail) {
        (false, false) => false,
        (true, true) => discard_trait_argument_pair(__g1_array_pop_move<TraitArguments>(&mut left_tail), __g1_array_pop_move<TraitArguments>(&mut right_tail)),
        (true, false) => discard_single_trait_argument_tail(left_tail),
        (false, true) => discard_single_trait_argument_tail(right_tail),
        _ => false,
    }
}

fn discard_single_trait_argument_tail(tail: Array<TraitArguments>) -> Bool {
    discard_trait_arguments(__g1_array_pop_move<TraitArguments>(&mut tail))
}

fn discard_trait_argument_pair(left: TraitArguments, right: TraitArguments) -> Bool {
    handle discard_trait_arguments(left) {
        true => handle discard_trait_arguments(right) { true => false, false => false, _ => false },
        false => handle discard_trait_arguments(right) { true => false, false => false, _ => false },
        _ => false,
    }
}

fn discard_trait_arguments(value: TraitArguments) -> Bool {
    handle value {
        TraitArguments::Empty => true,
        TraitArguments::Node(_, has_tail, tail) => handle has_tail {
            true => discard_trait_arguments(__g1_array_pop_move<TraitArguments>(&mut tail)),
            false => true,
            _ => false,
        },
        _ => false,
    }
}
