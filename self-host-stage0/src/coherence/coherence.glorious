// M16 starts with concrete and generic-Self implementation-head overlap.
// Generic argument unification, orphan checks, and where-bound
// satisfiability extend this same source-owned decision boundary.
use compiler_support::branch_bool;
use compiler_support::text_eq;
use types::Type;
use types::same;

pub struct ImplementationHead {
    trait_name: Text,
    self_type: Type,
    polarity: ImplementationPolarity,
    generic_self: Bool,
}

// Positive and negative declarations occupy the same coherence namespace:
// either polarity conflicts with another declaration of the same trait/self
// head. Later generic overlap uses this preserved polarity when explaining a
// conflict, instead of treating a negative implementation as absence.
pub enum ImplementationPolarity {
    Positive,
    Negative,
}

pub enum Overlap {
    Disjoint,
    Conflict,
}

pub fn implementation(trait_name: Text, self_type: Type) -> ImplementationHead {
    ImplementationHead { trait_name: trait_name, self_type: self_type, polarity: ImplementationPolarity::Positive, generic_self: false }
}

pub fn negative_implementation(trait_name: Text, self_type: Type) -> ImplementationHead {
    ImplementationHead { trait_name: trait_name, self_type: self_type, polarity: ImplementationPolarity::Negative, generic_self: false }
}

pub fn generic_implementation(trait_name: Text) -> ImplementationHead {
    ImplementationHead { trait_name: trait_name, self_type: Type::Generic(0), polarity: ImplementationPolarity::Positive, generic_self: true }
}

pub fn generic_negative_implementation(trait_name: Text) -> ImplementationHead {
    ImplementationHead { trait_name: trait_name, self_type: Type::Generic(0), polarity: ImplementationPolarity::Negative, generic_self: true }
}

pub fn overlap(left: ImplementationHead, right: ImplementationHead) -> Overlap {
    handle (left, right) {
        (
            ImplementationHead { trait_name: left_trait, self_type: left_type, polarity: _, generic_self: left_generic },
            ImplementationHead { trait_name: right_trait, self_type: right_type, polarity: _, generic_self: right_generic },
        ) => overlap_parts(left_trait, left_type, left_generic, right_trait, right_type, right_generic),
    }
}

fn overlap_parts(left_trait: Text, left_type: Type, left_generic: Bool, right_trait: Text, right_type: Type, right_generic: Bool) -> Overlap {
    branch_bool(
        text_eq(left_trait, right_trait),
        () -> Overlap { overlap_same_trait(left_type, left_generic, right_type, right_generic) },
        () -> Overlap { Overlap::Disjoint },
    )
}

fn overlap_same_trait(left: Type, left_generic: Bool, right: Type, right_generic: Bool) -> Overlap {
    handle left_generic {
        true => Overlap::Conflict,
        false => handle right_generic {
            true => Overlap::Conflict,
            false => overlap_exact_self_type(left, right),
            _ => Overlap::Disjoint,
        },
        _ => Overlap::Disjoint,
    }
}

fn overlap_exact_self_type(left: Type, right: Type) -> Overlap {
    branch_bool(
        same(left, right),
        () -> Overlap { Overlap::Conflict },
        () -> Overlap { Overlap::Disjoint },
    )
}
