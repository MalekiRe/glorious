// M05 scaffold: semantic request data. Source normalization and canonical
// fingerprints are added with M07/M30 instead of approximating them here.
use identity::Digest;
use identity::equals;
use compiler_support::branch_bool;
use compiler_support::__g1_int_wrapping_add;
use compiler_support::__g1_array_len;
use compiler_support::__g1_array_pop_move;
use compiler_support::__g1_int_convert_wrapping_to_u64;
use source::SourceInput;
use source::digest_matches_bytes;
use source::same_file_identity;
use source::byte_len_u64;
use source::identity_digest;
use source::has_valid_logical_path;
use identity::digest_of_digests2;
use identity::less_than;

pub enum CompilationMode {
    Check,
    Build,
    Test,
    Inspect,
    Ide,
    Bootstrap(BootstrapStage),
}

pub struct BootstrapLimits {
    max_sources: u64,
    max_total_source_bytes: u64,
}

// The first normalized multi-file request shape stays intentionally bounded:
// it proves the admission invariants now without introducing a mutable list
// representation into the bootstrap substrate. Later request collection work
// can extend this same record to arbitrary source counts.
pub struct SourceWorld2 {
    first: SourceInput,
    second: SourceInput,
}

pub enum SourceWorldAdmission {
    Value(SourceWorld2),
    TooManySources,
    TooManyBytes,
    DuplicateFileIdentity,
    DigestMismatch,
    InvalidLogicalPath,
}

// General request-world substrate. SourceWorld2 remains the compatibility
// facade for existing probes; a real self-host bundle needs arbitrary module
// cardinality while preserving the same immutable identity, digest, path,
// duplicate, and budget checks.
pub enum SourceSequence { Empty, Node(SourceInput, Bool, Array<SourceSequence>) }
pub struct SourceBundle { sources: SourceSequence }
pub enum SourceBundleAdmission { Value(SourceBundle), TooManySources, TooManyBytes, DuplicateFileIdentity, DigestMismatch, InvalidLogicalPath }
pub enum SourceSequenceIdentity { Value(Bool, SourceSequence) }
// The bundle fingerprint is built from a separate, sorted digest sequence.
// Keeping this intermediate free of SourceInput lets the world commitment
// consume an admitted bundle exactly once without copying source buffers.
pub enum DigestSequence { Empty, Node(Digest, Bool, Array<DigestSequence>) }

pub struct BootstrapStage {
    ordinal: u64,
    producer: Digest,
    // The source representation is widened; validation retains the exact
    // stage0 accepted range (0 through 3) without requiring a u8 comparison
    // primitive in the bootstrap profile.
    optimization_level: u64,
    limits: BootstrapLimits,
    expected_artifact: ExpectedArtifact,
}

pub enum ExpectedArtifact {
    Any,
    Exact(Digest),
}

pub enum BootstrapStageResult {
    Value(BootstrapStage),
    Invalid,
}

pub struct CompilerBuildIdentity {
    compiler: Digest,
    language_generation: u32,
    query_generation: u32,
    interface_generation: u32,
    cache_generation: u32,
    bytecode_generation: u32,
    verifier_generation: u32,
}

pub fn bootstrap_limits(max_sources: u64, max_total_source_bytes: u64) -> BootstrapLimits {
    BootstrapLimits { max_sources: max_sources, max_total_source_bytes: max_total_source_bytes }
}

pub fn source_world2(first: SourceInput, second: SourceInput, limits: BootstrapLimits) -> SourceWorldAdmission {
    branch_bool(
        limits.max_sources < 2,
        () -> SourceWorldAdmission { SourceWorldAdmission::TooManySources },
        () -> SourceWorldAdmission { admit_source_world2_first(first, second, limits) },
    )
}

