fn source_sequence_empty() -> SourceSequence { SourceSequence::Empty }

fn source_bundle_build(values: Array<SourceInput>, limits: BootstrapLimits, sources: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    handle __g1_array_len<SourceInput>(&values) == 0 {
        true => SourceBundleAdmission::Value(SourceBundle { sources: sources }),
        false => source_bundle_nonempty(values, limits, sources, count, total_bytes),
        _ => SourceBundleAdmission::TooManySources,
    }
}

fn source_bundle_nonempty(values: Array<SourceInput>, limits: BootstrapLimits, sources: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    let input = __g1_array_pop_move<SourceInput>(&mut values);
    source_bundle_admit_one(input, values, limits, sources, count, total_bytes)
}

fn source_bundle_admit_one(input: SourceInput, remaining: Array<SourceInput>, limits: BootstrapLimits, sources: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    handle digest_matches_bytes(input) {
        true => source_bundle_admit_path(input, remaining, limits, sources, count, total_bytes),
        false => SourceBundleAdmission::DigestMismatch,
        _ => SourceBundleAdmission::DigestMismatch,
    }
}

fn source_bundle_admit_path(input: SourceInput, remaining: Array<SourceInput>, limits: BootstrapLimits, sources: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    handle has_valid_logical_path(input) {
        true => source_bundle_admit_unique(input, remaining, limits, sources, count, total_bytes),
        false => SourceBundleAdmission::InvalidLogicalPath,
        _ => SourceBundleAdmission::InvalidLogicalPath,
    }
}

fn source_bundle_admit_unique(input: SourceInput, remaining: Array<SourceInput>, limits: BootstrapLimits, sources: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    handle source_sequence_contains_identity(sources, input) {
        true => SourceBundleAdmission::DuplicateFileIdentity,
        false => source_bundle_admit_size(input, remaining, limits, sources, count, total_bytes),
        _ => SourceBundleAdmission::DuplicateFileIdentity,
    }
}

fn source_bundle_admit_size(input: SourceInput, remaining: Array<SourceInput>, limits: BootstrapLimits, sources: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    let next_count = __g1_int_wrapping_add<u64>(count, 1);
    let next_bytes = __g1_int_wrapping_add<u64>(total_bytes, byte_len_u64(input));
    handle next_count < count {
        true => SourceBundleAdmission::TooManySources,
        false => handle next_bytes < total_bytes {
            true => SourceBundleAdmission::TooManyBytes,
            false => handle next_bytes > limits.max_total_source_bytes {
                true => SourceBundleAdmission::TooManyBytes,
                false => source_bundle_build(remaining, limits, source_sequence_prepend(input, sources), next_count, next_bytes),
                _ => SourceBundleAdmission::TooManyBytes,
            },
            _ => SourceBundleAdmission::TooManyBytes,
        },
        _ => SourceBundleAdmission::TooManySources,
    }
}

fn source_sequence_prepend(input: SourceInput, tail: SourceSequence) -> SourceSequence { SourceSequence::Node(input, true, [tail]) }

fn source_sequence_contains_identity(sources: SourceSequence, input: SourceInput) -> Bool {
