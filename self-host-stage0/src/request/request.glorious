fn source_sequence_empty() -> SourceSequence { SourceSequence::Empty }
pub fn source_sequence_one(input: SourceInput) -> SourceSequence { SourceSequence::Node(input, false, []) }
pub fn source_sequence_prepend_public(input: SourceInput, tail: SourceSequence) -> SourceSequence { SourceSequence::Node(input, true, [tail]) }

pub fn source_bundle(sources: SourceSequence, limits: BootstrapLimits) -> SourceBundleAdmission {
    source_bundle_sequence(sources, limits, source_sequence_empty(), 0, 0)
}
fn source_bundle_sequence(sources: SourceSequence, limits: BootstrapLimits, seen: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    handle sources {
        SourceSequence::Empty => SourceBundleAdmission::Value(SourceBundle { sources: seen }),
        SourceSequence::Node(input, has_tail, tail) => source_bundle_sequence_node(input, has_tail, tail, limits, seen, count, total_bytes),
        _ => SourceBundleAdmission::TooManySources,
    }
}
fn source_bundle_sequence_node(input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    // SourceInput owns its byte payload. Use exclusive branch callables rather
    // than `handle` arms so every continuation receives the single moved value.
    branch_bool(digest_matches_bytes(input),
        () -> SourceBundleAdmission { source_bundle_sequence_path(input, has_tail, tail, limits, seen, count, total_bytes) },
        () -> SourceBundleAdmission { SourceBundleAdmission::DigestMismatch },
    )
}
fn source_bundle_sequence_count(input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    let next_count = __g1_int_wrapping_add<u64>(count, 1);
    branch_bool(next_count > limits.max_sources,
        () -> SourceBundleAdmission { SourceBundleAdmission::TooManySources },
        () -> SourceBundleAdmission { source_bundle_sequence_tail(has_tail, tail, limits, source_sequence_prepend_public(input, seen), next_count, total_bytes) },
    )
}
fn source_bundle_sequence_path(input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    branch_bool(has_valid_logical_path(input),
        () -> SourceBundleAdmission { source_bundle_sequence_identity(input, has_tail, tail, limits, seen, count, total_bytes) },
        () -> SourceBundleAdmission { SourceBundleAdmission::InvalidLogicalPath },
    )
}
fn source_bundle_sequence_identity(input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    handle source_sequence_contains_identity_preserving(seen, input) {
        SourceSequenceIdentity::Value(matches, recovered_seen) => source_bundle_sequence_identity_checked(matches, input, has_tail, tail, limits, recovered_seen, count, total_bytes),
        _ => SourceBundleAdmission::DuplicateFileIdentity,
    }
}
fn source_bundle_sequence_identity_checked(matches: Bool, input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    // This is a direct sum-dispatch, not a callback boundary.  Keeping it as
    // `handle` preserves the recovered affine sequence on the non-duplicate
    // edge without making both branch closures candidates to capture it.
    handle matches {
        true => SourceBundleAdmission::DuplicateFileIdentity,
        false => source_bundle_sequence_size(input, has_tail, tail, limits, seen, count, total_bytes),
        _ => SourceBundleAdmission::DuplicateFileIdentity,
    }
}
fn source_bundle_sequence_size(input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    let next_count = __g1_int_wrapping_add<u64>(count, 1);
    let next_bytes = __g1_int_wrapping_add<u64>(total_bytes, byte_len_u64(input));
    branch_bool(next_count > limits.max_sources,
        () -> SourceBundleAdmission { SourceBundleAdmission::TooManySources },
        () -> SourceBundleAdmission { source_bundle_sequence_overflow(input, has_tail, tail, limits, seen, total_bytes, next_count, next_bytes) },
    )
}
fn source_bundle_sequence_overflow(input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, total_bytes: u64, next_count: u64, next_bytes: u64) -> SourceBundleAdmission {
    branch_bool(next_bytes < total_bytes,
        () -> SourceBundleAdmission { SourceBundleAdmission::TooManyBytes },
        () -> SourceBundleAdmission { source_bundle_sequence_limit(input, has_tail, tail, limits, seen, next_count, next_bytes) },
    )
}
fn source_bundle_sequence_limit(input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, next_count: u64, next_bytes: u64) -> SourceBundleAdmission {
    branch_bool(next_bytes > limits.max_total_source_bytes,
        () -> SourceBundleAdmission { SourceBundleAdmission::TooManyBytes },
        () -> SourceBundleAdmission { source_bundle_sequence_tail(has_tail, tail, limits, source_sequence_prepend_public(input, seen), next_count, next_bytes) },
    )
}
fn source_bundle_sequence_tail(has_tail: Bool, tail: Array<SourceSequence>, limits: BootstrapLimits, seen: SourceSequence, count: u64, total_bytes: u64) -> SourceBundleAdmission {
    // Both alternatives consume the same affine accumulator, so this must be
    // a lexical branch rather than construction of two independently owned
    // callback environments.
    handle has_tail {
        true => source_bundle_sequence(__g1_array_pop_move<SourceSequence>(&mut tail), limits, seen, count, total_bytes),
        false => SourceBundleAdmission::Value(SourceBundle { sources: seen }),
        _ => SourceBundleAdmission::TooManySources,
    }
}
pub fn source_bundle_count(bundle: SourceBundle) -> u64 { source_sequence_count_live(bundle.sources) }
pub fn source_bundle_sources(bundle: SourceBundle) -> SourceSequence { bundle.sources }
fn source_sequence_count_live(sources: SourceSequence) -> u64 { handle sources { SourceSequence::Empty => 0, SourceSequence::Node(_, has_tail, tail) => source_sequence_count_live_tail(has_tail, tail), _ => 0 } }
fn source_sequence_count_live_tail(has_tail: Bool, tail: Array<SourceSequence>) -> u64 { handle has_tail { true => __g1_int_wrapping_add<u64>(1, source_sequence_count_live(__g1_array_pop_move<SourceSequence>(&mut tail))), false => 1, _ => 0 } }
fn source_sequence_contains_identity_live(sources: SourceSequence, input: SourceInput) -> Bool { handle sources { SourceSequence::Empty => false, SourceSequence::Node(head, has_tail, tail) => source_sequence_contains_identity_live_node(head, has_tail, tail, input), _ => false } }
fn source_sequence_contains_identity_live_node(head: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, input: SourceInput) -> Bool { handle same_file_identity(head, input) { true => true, false => handle has_tail { true => source_sequence_contains_identity_live(__g1_array_pop_move<SourceSequence>(&mut tail), input), false => false, _ => false }, _ => false } }

// Duplicate detection consumes the recursive sequence while traversing it, so
// return that exact sequence with the answer. This preserves its affine
// ownership for the admitted-world continuation instead of copying a list
// that owns source buffers.
fn source_sequence_contains_identity_preserving(sources: SourceSequence, input: SourceInput) -> SourceSequenceIdentity {
    handle sources {
        SourceSequence::Empty => SourceSequenceIdentity::Value(false, SourceSequence::Empty),
        SourceSequence::Node(head, has_tail, tail) => source_sequence_contains_identity_preserving_node(head, has_tail, tail, input),
        _ => SourceSequenceIdentity::Value(true, SourceSequence::Empty),
    }
}
fn source_sequence_contains_identity_preserving_node(head: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, input: SourceInput) -> SourceSequenceIdentity {
    handle same_file_identity(head, input) {
        true => SourceSequenceIdentity::Value(true, SourceSequence::Node(head, has_tail, tail)),
        false => source_sequence_contains_identity_preserving_tail(head, has_tail, tail, input),
        _ => SourceSequenceIdentity::Value(true, SourceSequence::Node(head, has_tail, tail)),
    }
}
fn source_sequence_contains_identity_preserving_tail(head: SourceInput, has_tail: Bool, tail: Array<SourceSequence>, input: SourceInput) -> SourceSequenceIdentity {
    branch_bool(has_tail,
        () -> SourceSequenceIdentity { source_sequence_contains_identity_preserving_restore(head, __g1_array_pop_move<SourceSequence>(&mut tail), input) },
        () -> SourceSequenceIdentity { SourceSequenceIdentity::Value(false, SourceSequence::Node(head, false, [])) },
    )
}
fn source_sequence_contains_identity_preserving_restore(head: SourceInput, tail: SourceSequence, input: SourceInput) -> SourceSequenceIdentity {
    handle source_sequence_contains_identity_preserving(tail, input) {
        SourceSequenceIdentity::Value(matches, recovered_tail) => SourceSequenceIdentity::Value(matches, SourceSequence::Node(head, true, [recovered_tail])),
        _ => SourceSequenceIdentity::Value(true, SourceSequence::Node(head, false, [])),
    }
}

// A cache/manifest world must not depend on CLI source ordering.  Admission
// already rules out duplicate FileKey identities, so insertion sorting the
// complete source identities gives one canonical traversal for every bundle.
// The domain seed distinguishes an empty source world from a raw digest and
// the fold commits each sorted component with the same framed digest product
// used by the existing two-file world.
pub fn source_bundle_fingerprint(bundle: SourceBundle) -> Digest {
    source_bundle_fingerprint_sequence(bundle.sources)
}
fn source_bundle_fingerprint_sequence(sources: SourceSequence) -> Digest {
    source_bundle_fingerprint_fold(
        source_bundle_fingerprint_sort(sources),
        identity::digest_of_text("grandiose-stage0-source-bundle-v1"),
    )
}
fn source_bundle_fingerprint_sort(sources: SourceSequence) -> DigestSequence {
    handle sources {
        SourceSequence::Empty => DigestSequence::Empty,
        SourceSequence::Node(input, has_tail, tail) => source_bundle_fingerprint_sort_node(identity_digest(input), has_tail, tail),
        _ => DigestSequence::Empty,
    }
}
fn source_bundle_fingerprint_sort_node(head: Digest, has_tail: Bool, tail: Array<SourceSequence>) -> DigestSequence {
    branch_bool(has_tail,
        () -> DigestSequence { source_bundle_fingerprint_insert(head, source_bundle_fingerprint_sort(__g1_array_pop_move<SourceSequence>(&mut tail))) },
        () -> DigestSequence { DigestSequence::Node(head, false, []) },
    )
}
fn source_bundle_fingerprint_insert(value: Digest, sorted: DigestSequence) -> DigestSequence {
    handle sorted {
        DigestSequence::Empty => DigestSequence::Node(value, false, []),
        DigestSequence::Node(head, has_tail, tail) => source_bundle_fingerprint_insert_node(value, head, has_tail, tail),
        _ => DigestSequence::Node(value, false, []),
    }
}
fn source_bundle_fingerprint_insert_node(value: Digest, head: Digest, has_tail: Bool, tail: Array<DigestSequence>) -> DigestSequence {
    handle less_than(value, head) {
        true => DigestSequence::Node(value, true, [DigestSequence::Node(head, has_tail, tail)]),
        false => source_bundle_fingerprint_insert_after(value, head, has_tail, tail),
        _ => DigestSequence::Node(value, true, [DigestSequence::Node(head, has_tail, tail)]),
    }
}
fn source_bundle_fingerprint_insert_after(value: Digest, head: Digest, has_tail: Bool, tail: Array<DigestSequence>) -> DigestSequence {
    branch_bool(has_tail,
        () -> DigestSequence { DigestSequence::Node(head, true, [source_bundle_fingerprint_insert(value, __g1_array_pop_move<DigestSequence>(&mut tail))]) },
        () -> DigestSequence { DigestSequence::Node(head, true, [DigestSequence::Node(value, false, [])]) },
    )
}
fn source_bundle_fingerprint_fold(sorted: DigestSequence, accumulator: Digest) -> Digest {
    handle sorted {
        DigestSequence::Empty => accumulator,
        DigestSequence::Node(head, has_tail, tail) => source_bundle_fingerprint_fold_node(head, has_tail, tail, accumulator),
        _ => accumulator,
    }
}
fn source_bundle_fingerprint_fold_node(head: Digest, has_tail: Bool, tail: Array<DigestSequence>, accumulator: Digest) -> Digest {
    let next = digest_of_digests2(accumulator, head);
    branch_bool(has_tail,
        () -> Digest { source_bundle_fingerprint_fold(__g1_array_pop_move<DigestSequence>(&mut tail), next) },
        () -> Digest { next },
    )
}

// The normalized record stays opaque to callers, but compiler service layers
// may borrow its already-admitted immutable source members without rebuilding
// a path/digest pair or reopening a host file.
pub fn source_world2_first(world: SourceWorld2) -> SourceInput {
    world.first
}

pub fn source_world2_second(world: SourceWorld2) -> SourceInput {
    world.second
}

// Cache, query, and bootstrap products use one canonical world commitment.
// The two uniquely admitted FileKey/content components are sorted by their
// fixed-width identity digest, so source argument order cannot perturb cache
// reuse or bootstrap lineage.
pub fn source_world2_fingerprint(world: SourceWorld2) -> Digest {
    canonical_world_fingerprint(
        identity_digest(source_world2_first(world)),
        identity_digest(source_world2_second(world)),
    )
}

fn canonical_world_fingerprint(first: Digest, second: Digest) -> Digest {
    handle less_than(second, first) {
        true => digest_of_digests2(second, first),
        false => digest_of_digests2(first, second),
        _ => digest_of_digests2(first, second),
    }
}

fn admit_source_world2_first(first: SourceInput, second: SourceInput, limits: BootstrapLimits) -> SourceWorldAdmission {
    branch_bool(
        digest_matches_bytes(first),
        () -> SourceWorldAdmission { admit_source_world2_first_path(first, second, limits) },
        () -> SourceWorldAdmission { SourceWorldAdmission::DigestMismatch },
    )
}

fn admit_source_world2_first_path(first: SourceInput, second: SourceInput, limits: BootstrapLimits) -> SourceWorldAdmission {
    branch_bool(
        has_valid_logical_path(first),
        () -> SourceWorldAdmission { admit_source_world2_second(first, second, limits) },
        () -> SourceWorldAdmission { SourceWorldAdmission::InvalidLogicalPath },
    )
}

fn admit_source_world2_second(first: SourceInput, second: SourceInput, limits: BootstrapLimits) -> SourceWorldAdmission {
    branch_bool(
        digest_matches_bytes(second),
        () -> SourceWorldAdmission { admit_source_world2_second_path(first, second, limits) },
        () -> SourceWorldAdmission { SourceWorldAdmission::DigestMismatch },
    )
}

fn admit_source_world2_second_path(first: SourceInput, second: SourceInput, limits: BootstrapLimits) -> SourceWorldAdmission {
    branch_bool(
        has_valid_logical_path(second),
        () -> SourceWorldAdmission { admit_source_world2_identity(first, second, limits) },
        () -> SourceWorldAdmission { SourceWorldAdmission::InvalidLogicalPath },
    )
}

fn admit_source_world2_identity(first: SourceInput, second: SourceInput, limits: BootstrapLimits) -> SourceWorldAdmission {
    branch_bool(
        same_file_identity(first, second),
        () -> SourceWorldAdmission { SourceWorldAdmission::DuplicateFileIdentity },
        () -> SourceWorldAdmission { admit_source_world2_bytes(first, second, limits) },
    )
}

fn admit_source_world2_bytes(first: SourceInput, second: SourceInput, limits: BootstrapLimits) -> SourceWorldAdmission {
    let first_bytes = byte_len_u64(first);
    let total_bytes = __g1_int_wrapping_add<u64>(first_bytes, byte_len_u64(second));
    // Wraparound is itself over-budget: the finite request limit must not be
    // bypassed by a host-width arithmetic overflow.
    branch_bool(
        total_bytes < first_bytes,
        () -> SourceWorldAdmission { SourceWorldAdmission::TooManyBytes },
        () -> SourceWorldAdmission { admit_source_world2_limit(first, second, limits, total_bytes) },
    )
}

fn admit_source_world2_limit(first: SourceInput, second: SourceInput, limits: BootstrapLimits, total_bytes: u64) -> SourceWorldAdmission {
    branch_bool(
        total_bytes > limits.max_total_source_bytes,
        () -> SourceWorldAdmission { SourceWorldAdmission::TooManyBytes },
        () -> SourceWorldAdmission { SourceWorldAdmission::Value(SourceWorld2 { first: first, second: second }) },
    )
}

fn validate_bootstrap_byte_limit(
    ordinal: u64,
    producer: Digest,
    optimization_level: u64,
    limits: BootstrapLimits,
) -> BootstrapStageResult {
    branch_bool(
        limits.max_total_source_bytes == 0,
        () -> BootstrapStageResult { BootstrapStageResult::Invalid },
        () -> BootstrapStageResult {
            BootstrapStageResult::Value(BootstrapStage {
                ordinal: ordinal,
                producer: producer,
                optimization_level: optimization_level,
                limits: limits,
                expected_artifact: ExpectedArtifact::Any,
            })
        },
    )
}

fn validate_bootstrap_limits(
    ordinal: u64,
    producer: Digest,
    optimization_level: u64,
    limits: BootstrapLimits,
) -> BootstrapStageResult {
    branch_bool(
        limits.max_sources == 0,
        () -> BootstrapStageResult { BootstrapStageResult::Invalid },
        () -> BootstrapStageResult { validate_bootstrap_byte_limit(ordinal, producer, optimization_level, limits) },
    )
}

fn validate_bootstrap_optimization(
    ordinal: u64,
    producer: Digest,
    optimization_level: u64,
    limits: BootstrapLimits,
) -> BootstrapStageResult {
    branch_bool(
        optimization_level > 3,
        () -> BootstrapStageResult { BootstrapStageResult::Invalid },
        () -> BootstrapStageResult { validate_bootstrap_limits(ordinal, producer, optimization_level, limits) },
    )
}

// Keep malformed bootstrap configuration out of the request world before it
// reaches source loading, cache lookup, or code generation. Producer and
// predecessor commitments are validated once request/source identity is
// available in the later normalization layer.
fn validate_bootstrap_ordinal(
    ordinal: u64,
    producer: Digest,
    optimization_level: u64,
    limits: BootstrapLimits,
) -> BootstrapStageResult {
    branch_bool(
        ordinal > 3,
        () -> BootstrapStageResult { BootstrapStageResult::Invalid },
        () -> BootstrapStageResult { validate_bootstrap_optimization(ordinal, producer, optimization_level, limits) },
    )
}

pub fn bootstrap_stage(
    ordinal: u64,
    producer: Digest,
    optimization_level: u64,
    limits: BootstrapLimits,
) -> BootstrapStageResult {
    branch_bool(
        ordinal == 0,
        () -> BootstrapStageResult { BootstrapStageResult::Invalid },
        () -> BootstrapStageResult { validate_bootstrap_ordinal(ordinal, producer, optimization_level, limits) },
    )
}

pub fn bootstrap_ordinal(stage: BootstrapStage) -> u64 {
    stage.ordinal
}

// The request carries the optional predecessor-artifact commitment without
// fabricating one. Bootstrap validation later compares the emitted artifact
// against this exact digest when the caller supplied it.
pub fn with_expected_artifact(stage: BootstrapStage, expected: Digest) -> BootstrapStage {
    BootstrapStage {
        ordinal: stage.ordinal,
        producer: stage.producer,
        optimization_level: stage.optimization_level,
        limits: stage.limits,
        expected_artifact: ExpectedArtifact::Exact(expected),
    }
}

pub fn expected_artifact_matches(stage: BootstrapStage, artifact: Digest) -> Bool {
    handle stage.expected_artifact {
        ExpectedArtifact::Any => true,
        ExpectedArtifact::Exact(expected) => equals(expected, artifact),
        _ => false,
    }
}

pub fn stage0_build(compiler: Digest) -> CompilerBuildIdentity {
    CompilerBuildIdentity {
        compiler: compiler,
        language_generation: 1,
        query_generation: 1,
        interface_generation: 1,
        cache_generation: 2,
        bytecode_generation: 48,
        verifier_generation: 6,
    }
}

pub fn bytecode_generation(build: CompilerBuildIdentity) -> u32 {
    build.bytecode_generation
}

pub fn has_bytecode_generation(build: CompilerBuildIdentity, expected: u32) -> Bool {
    build.bytecode_generation == expected
}

// Cache keys and bootstrap manifests need the whole semantics-affecting build
// identity. Comparing only bytecode generation would permit a query/interface
// or verifier generation change to reuse an incompatible product.
pub fn same_build_identity(left: CompilerBuildIdentity, right: CompilerBuildIdentity) -> Bool {
    handle equals(left.compiler, right.compiler) {
        true => handle left.language_generation == right.language_generation {
            true => handle left.query_generation == right.query_generation {
                true => handle left.interface_generation == right.interface_generation {
                    true => handle left.cache_generation == right.cache_generation {
                        true => handle left.bytecode_generation == right.bytecode_generation {
                            true => left.verifier_generation == right.verifier_generation,
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
                    },
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}
