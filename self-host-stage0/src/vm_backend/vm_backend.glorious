                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

fn g1_i64_entry_payload_matches(bytes: Bytes, payload: Bytes) -> Bool {
    handle __g1_bytes_get(bytes, 796) == __g1_bytes_get(payload, 0) {
        true => handle __g1_bytes_get(bytes, 797) == __g1_bytes_get(payload, 1) {
            true => handle __g1_bytes_get(bytes, 798) == __g1_bytes_get(payload, 2) {
                true => handle __g1_bytes_get(bytes, 799) == __g1_bytes_get(payload, 3) {
                    true => handle __g1_bytes_get(bytes, 800) == __g1_bytes_get(payload, 4) {
                        true => handle __g1_bytes_get(bytes, 801) == __g1_bytes_get(payload, 5) {
                            true => handle __g1_bytes_get(bytes, 802) == __g1_bytes_get(payload, 6) {
                                true => __g1_bytes_get(bytes, 803) == __g1_bytes_get(payload, 7),
                                false => false,
                                _ => false,
                            },
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
