}

fn g1_i64_binary_duplicate_template_matches(bytes: Bytes, template: Bytes, index: usize) -> Bool {
    handle index == 1264 {
        true => true,
        false => handle g1_i64_binary_duplicate_dynamic_byte(index) {
            true => g1_i64_binary_duplicate_template_matches(bytes, template, __g1_int_wrapping_add<usize>(index, 1)),
            false => handle __g1_bytes_get(bytes, index) == __g1_bytes_get(template, index) {
                true => g1_i64_binary_duplicate_template_matches(bytes, template, __g1_int_wrapping_add<usize>(index, 1)),
                false => false,
                _ => false,
            },
            _ => false,
        },
        _ => false,
    }
}

fn g1_i64_binary_duplicate_dynamic_byte(index: usize) -> Bool {
    handle index >= 800 {
        true => handle index < 808 { true => true, false => g1_i64_binary_duplicate_code_byte(index), _ => false },
        false => g1_i64_binary_duplicate_code_byte(index),
        _ => false,
    }
}

fn g1_i64_binary_duplicate_code_byte(index: usize) -> Bool {
    handle index >= 1044 {
        true => handle index < 1048 { true => true, false => handle index >= 1056 { true => handle index < 1060 { true => true, false => handle index >= 1068 { true => index < 1072, false => false, _ => false }, _ => false }, _ => false }, _ => false },
        false => false,
        _ => false,
    }
}

fn g1_i64_binary_candidate_ordered(operation: G1I64Arithmetic, first: i64, second: i64, left_constant: u32, right_constant: u32) -> Bytes {
    g1_concat3(
        g1_concat8(g1_i64_binary_directory(), g1_unit_entry_name_table(__g1_bytes_from_array_move([109, 97, 105, 110])), g1_four_zero_padding_bytes(), g1_predefined_type_table(), g1_four_zero_padding_bytes(), g1_i64_binary_constant_table(first, second), g1_i64_callable_signature_table(), g1_append_field(g1_empty_variable_table(), g1_empty_variable_table())),
        g1_i64_binary_function_table(),
        g1_concat4(g1_i64_binary_code(operation, left_constant, right_constant), g1_append_field(g1_concat4(u32_le_bytes(1), u32_le_bytes(2), u32_le_bytes(1), u32_le_bytes(2)), g1_append_field(u32_le_bytes(1), u32_le_bytes(3))), g1_i64_binary_cleanup_table(), g1_empty_variable_table()),
    )
}


// Keep the scalar seed behind a source-owned structural gate as well as the
// independent VM verifier.  This checks the distinct i64 constant, Const,
// Return, operand, and two-PC cleanup shapes rather than treating a byte
// count as proof that the new executable family was encoded correctly.
pub fn g1_i64_entry_candidate_passes_source_verification() -> Bool {
    verify_g1_i64_entry_candidate(g1_i64_entry_candidate(42), 42)
}

pub fn g1_negative_i64_entry_candidate_passes_source_verification() -> Bool {
    verify_g1_i64_entry_candidate(g1_i64_entry_candidate(-1), -1)
}

fn verify_g1_i64_entry_candidate(bytes: Bytes, value: i64) -> Bool {
    handle verify_g1_i64_entry_artifact(bytes) {
        true => g1_i64_entry_payload_matches(bytes, u64_le_bytes(__g1_int_convert_wrapping_to_u64<i64>(value))),
        false => false,
        _ => false,
    }
}

// The terminal i64 entry has an unrestricted fixed-width scalar payload; all
// directory, type, instruction, and cleanup bytes remain fixed and are
// checked below for file-backed verification.
pub fn verify_g1_i64_entry_artifact(bytes: Bytes) -> Bool {
    handle g1_candidate_has_length_and_directory(bytes, 1008) {
        true => handle g1_magic_bytes_match(bytes) {
            true => handle __g1_bytes_get(bytes, 56) == 240 {
                true => handle __g1_bytes_get(bytes, 57) == 3 {
                    true => verify_g1_i64_entry_constant_and_code_shape(bytes),
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

fn verify_g1_i64_entry_constant_and_code(bytes: Bytes, value: i64) -> Bool {
    handle verify_g1_i64_entry_constant_and_code_shape(bytes) {
        true => g1_i64_entry_payload_matches(bytes, u64_le_bytes(__g1_int_convert_wrapping_to_u64<i64>(value))),
        false => false,
        _ => false,
    }
}

fn verify_g1_i64_entry_constant_and_code_shape(bytes: Bytes) -> Bool {
    handle __g1_bytes_get(bytes, 776) == 1 {
        true => handle __g1_bytes_get(bytes, 784) == 16 {
            true => handle __g1_bytes_get(bytes, 788) == 10 {
                true => handle __g1_bytes_get(bytes, 792) == 8 {
                    true => verify_g1_i64_entry_code_and_cleanup(bytes),
                    false => false,
