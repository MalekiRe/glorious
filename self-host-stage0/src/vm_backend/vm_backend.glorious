// `static.get_shared` adds the only public VM-side view of a segment: a
// `REF_SHARED<u8>` descriptor.  The descriptor is distinct from the static
// segment type, so a forged byte slice can never be substituted for the
// immutable compiler-owned storage.
fn g1_static_get_type_table() -> Bytes {
    let static_record = g1_static_data_type_record(
        __g1_bytes_from_array_move([67, 73, 84, 65, 84, 83, 95, 69, 83, 79, 73, 68, 78, 65, 82, 71]),
        1,
