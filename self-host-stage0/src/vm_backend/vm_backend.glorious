}

fn g1_i64_wire_payload_less_or_equal(bytes: Bytes, left_offset: usize, right_offset: usize, index: usize) -> Bool {
    handle index == 8 {
        true => true,
        false => {
            let left = __g1_int_convert_wrapping_to_u32<u8>(__g1_bytes_get(bytes, __g1_int_wrapping_add<usize>(left_offset, index)));
            let right = __g1_int_convert_wrapping_to_u32<u8>(__g1_bytes_get(bytes, __g1_int_wrapping_add<usize>(right_offset, index)));
