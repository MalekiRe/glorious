    let shared_u8_record = g1_variable_record(36, 17, u32_le_bytes(2));
    g1_append_field(
        u32_le_bytes(21),
        g1_append_field(
            g1_append_field(
                g1_append_field(g1_predefined_type_offsets(), u32_le_bytes(184)),
                u32_le_bytes(196),
            ),
            g1_append_field(g1_predefined_type_records(), g1_append_field(static_record, shared_u8_record)),
        ),
    )
}

