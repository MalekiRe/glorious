fn g1_i64_binary_function_table() -> Bytes {
    g1_append_field(
        g1_concat4(g1_concat4(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(2)), g1_concat4(u32_le_bytes(0), u32_le_bytes(7), u32_le_bytes(2), u32_le_bytes(0)), g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4294967295)), g1_append_field(u64_le_bytes(0), u64_le_bytes(0))),
        g1_concat4(g1_concat4(u32_le_bytes(0), u32_le_bytes(1), u32_le_bytes(0), u32_le_bytes(4)), g1_concat4(u32_le_bytes(7), u32_le_bytes(13), u32_le_bytes(4), u32_le_bytes(2)), g1_concat4(u32_le_bytes(4), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4294967295)), g1_append_field(u64_le_bytes(0), u64_le_bytes(0))),
    )
}

fn g1_i64_binary_primitive(operation: G1I64Arithmetic) -> u32 {
    handle operation {
        G1I64Arithmetic::Add => 5,
        G1I64Arithmetic::Subtract => 6,
        G1I64Arithmetic::Multiply => 7,
        G1I64Arithmetic::Divide => 3,
        _ => 4294967295,
    }
}

fn g1_i64_binary_code(operation: G1I64Arithmetic, left_constant: u32, right_constant: u32) -> Bytes {
    g1_append_field(
        g1_concat4(
            g1_concat4(u32_le_bytes(16418), u32_le_bytes(1), u32_le_bytes(1), u32_le_bytes(0)),
            g1_concat4(u32_le_bytes(0), u32_le_bytes(4134), u32_le_bytes(4294967295), u32_le_bytes(8193)),
            g1_concat4(u32_le_bytes(1), u32_le_bytes(left_constant), u32_le_bytes(8193), u32_le_bytes(2)),
            g1_concat4(u32_le_bytes(right_constant), u32_le_bytes(16453), u32_le_bytes(3), u32_le_bytes(g1_i64_binary_primitive(operation))),
        ),
        g1_concat4(u32_le_bytes(0), u32_le_bytes(2), u32_le_bytes(4134), u32_le_bytes(3)),
    )
}

fn g1_i64_binary_cleanup_plan(function: u32, first: u32, end: u32, operand_start: u32, operand_count: u32) -> Bytes {
    g1_concat3(g1_concat4(u32_le_bytes(function), u32_le_bytes(first), u32_le_bytes(end), u32_le_bytes(operand_start)), g1_append_field(u32_le_bytes(operand_count), u32_le_bytes(0)), __g1_bytes_from_array_move([]))
}

fn g1_i64_binary_cleanup_table() -> Bytes {
    g1_concat3(
        g1_append_field(g1_i64_binary_cleanup_plan(0, 0, 1, 0, 0), g1_i64_binary_cleanup_plan(0, 1, 2, 2, 1)),
        g1_append_field(g1_i64_binary_cleanup_plan(1, 0, 1, 0, 0), g1_i64_binary_cleanup_plan(1, 1, 2, 2, 1)),
        g1_append_field(g1_i64_binary_cleanup_plan(1, 2, 3, 3, 2), g1_i64_binary_cleanup_plan(1, 3, 4, 5, 1)),
    )
}

pub fn g1_i64_binary_candidate(operation: G1I64Arithmetic, left: i64, right: i64) -> Bytes {
    handle left == right {
        true => g1_i64_binary_duplicate_candidate(operation, left),
        false => handle g1_i64_wire_less_or_equal(left, right) {
            true => g1_i64_binary_candidate_ordered(operation, left, right, 0, 1),
            false => g1_i64_binary_candidate_ordered(operation, right, left, 1, 0),
            _ => __g1_bytes_from_array_move([]),
        },
        _ => __g1_bytes_from_array_move([]),
    }
}

fn g1_i64_binary_duplicate_candidate(operation: G1I64Arithmetic, value: i64) -> Bytes {
    g1_concat3(
        g1_concat8(g1_i64_binary_duplicate_directory(), g1_unit_entry_name_table(__g1_bytes_from_array_move([109, 97, 105, 110])), g1_four_zero_padding_bytes(), g1_predefined_type_table(), g1_four_zero_padding_bytes(), g1_i64_constant_table(value), g1_four_zero_padding_bytes(), g1_i64_callable_signature_table()),
        g1_append_field(g1_append_field(g1_empty_variable_table(), g1_empty_variable_table()), g1_i64_binary_function_table()),
        g1_concat4(g1_i64_binary_code(operation, 0, 0), g1_append_field(g1_concat4(u32_le_bytes(1), u32_le_bytes(2), u32_le_bytes(1), u32_le_bytes(2)), g1_append_field(u32_le_bytes(1), u32_le_bytes(3))), g1_i64_binary_cleanup_table(), g1_empty_variable_table()),
    )
}

// The caller supplies an already canonical two-constant pool. General source
// publication will grow this into a deduplicating wire-key pool builder.
pub fn emit_g1_i64_binary(operation: G1I64Arithmetic, left: i64, right: i64) -> ArtifactEmission {
    let candidate = g1_i64_binary_candidate(operation, left, right);
    handle g1_directory_is_readable(candidate) {
        true => handle __g1_bytes_len(candidate) == 1280 {
            true => ArtifactEmission::Artifact(candidate),
            false => handle __g1_bytes_len(candidate) == 1264 {
                true => ArtifactEmission::Artifact(candidate),
                false => ArtifactEmission::Rejected,
                _ => ArtifactEmission::Rejected,
            },
            _ => ArtifactEmission::Rejected,
        },
        false => ArtifactEmission::Rejected,
        _ => ArtifactEmission::Rejected,
    }
}

// File verification accepts the two canonical binary layouts emitted above.
// Constant payload bytes are intentionally value-agnostic (every eight-byte
// sequence is an i64), while every non-payload byte must match the canonical
// template and the operand references/opcode are checked independently.
pub fn verify_g1_i64_binary_artifact(bytes: Bytes) -> Bool {
    handle __g1_bytes_len(bytes) == 1280 {
        true => verify_g1_i64_binary_nonduplicate_artifact(bytes),
        false => handle __g1_bytes_len(bytes) == 1264 {
            true => verify_g1_i64_binary_duplicate_artifact(bytes),
            false => false,
            _ => false,
        },
        _ => false,
    }
}

fn verify_g1_i64_binary_nonduplicate_artifact(bytes: Bytes) -> Bool {
    let template = g1_i64_binary_candidate(G1I64Arithmetic::Add, 0, 1);
    handle g1_candidate_has_length_and_directory(bytes, 1280) {
        true => handle g1_i64_binary_nonduplicate_template_matches(bytes, template, 0) {
            true => verify_g1_i64_binary_nonduplicate_operands(bytes),
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

fn g1_i64_binary_nonduplicate_template_matches(bytes: Bytes, template: Bytes, index: usize) -> Bool {
    handle index == 1280 {
        true => true,
        false => handle g1_i64_binary_nonduplicate_dynamic_byte(index) {
            true => g1_i64_binary_nonduplicate_template_matches(bytes, template, __g1_int_wrapping_add<usize>(index, 1)),
            false => handle __g1_bytes_get(bytes, index) == __g1_bytes_get(template, index) {
                true => g1_i64_binary_nonduplicate_template_matches(bytes, template, __g1_int_wrapping_add<usize>(index, 1)),
                false => false,
                _ => false,
            },
            _ => false,
        },
        _ => false,
    }
}

fn g1_i64_binary_nonduplicate_dynamic_byte(index: usize) -> Bool {
    handle index >= 800 {
        true => handle index < 824 { true => true, false => g1_i64_binary_nonduplicate_code_byte(index), _ => false },
        false => g1_i64_binary_nonduplicate_code_byte(index),
        _ => false,
    }
}

fn g1_i64_binary_nonduplicate_code_byte(index: usize) -> Bool {
    handle index >= 1060 {
        true => handle index < 1064 { true => true, false => g1_i64_binary_nonduplicate_second_code_byte(index), _ => false },
        false => false,
        _ => false,
    }
}

fn g1_i64_binary_nonduplicate_second_code_byte(index: usize) -> Bool {
    handle index >= 1072 {
        true => handle index < 1076 { true => true, false => handle index >= 1084 { true => index < 1088, false => false, _ => false }, _ => false },
        false => false,
        _ => false,
    }
}

fn verify_g1_i64_binary_nonduplicate_operands(bytes: Bytes) -> Bool {
    handle g1_read_u32_le(bytes, 1060) {
        G1U32Read::Value(left) => handle g1_read_u32_le(bytes, 1072) {
            G1U32Read::Value(right) => handle g1_binary_operand_pair_is_valid(left, right) {
                true => verify_g1_i64_binary_opcode(bytes, 1084),
                false => false,
                _ => false,
            },
            _ => false,
        },
        _ => false,
    }
}

fn g1_binary_operand_pair_is_valid(left: u32, right: u32) -> Bool {
    handle left == 0 { true => right == 1, false => handle left == 1 { true => right == 0, false => false, _ => false }, _ => false }
}

fn verify_g1_i64_binary_opcode(bytes: Bytes, offset: usize) -> Bool {
    handle g1_read_u32_le(bytes, offset) {
        G1U32Read::Value(value) => handle value == 3 { true => true, false => handle value == 5 { true => true, false => handle value == 6 { true => true, false => value == 7, _ => false }, _ => false }, _ => false },
        _ => false,
    }
}

fn verify_g1_i64_binary_duplicate_artifact(bytes: Bytes) -> Bool {
    let template = g1_i64_binary_duplicate_candidate(G1I64Arithmetic::Add, 0);
    handle g1_candidate_has_length_and_directory(bytes, 1264) {
        true => handle g1_i64_binary_duplicate_template_matches(bytes, template, 0) {
            true => handle g1_read_u32_le(bytes, 1044) {
                G1U32Read::Value(left) => handle g1_read_u32_le(bytes, 1056) {
                    G1U32Read::Value(right) => handle left == 0 { true => handle right == 0 { true => verify_g1_i64_binary_opcode(bytes, 1068), false => false, _ => false }, false => false, _ => false },
                    _ => false,
