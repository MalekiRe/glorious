                        true => handle __g1_bytes_get(table, 277) == 17 {
                            true => __g1_bytes_get(table, 280) == 4,
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
                    },
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
