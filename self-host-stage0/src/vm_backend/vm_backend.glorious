pub fn emit_g1_i64_identity_call(value: i64) -> ArtifactEmission {
    let candidate = g1_i64_identity_call_candidate(value);
    handle verify_g1_i64_identity_call_candidate(candidate, value) {
        true => ArtifactEmission::Artifact(candidate),
        false => ArtifactEmission::Rejected,
        _ => ArtifactEmission::Rejected,
