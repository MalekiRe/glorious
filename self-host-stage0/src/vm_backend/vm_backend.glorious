}

// Every eight-byte i64 payload is a valid two's-complement scalar. This
// verifier therefore validates the complete fixed callable shape independently
// of its value; the value-sensitive candidate path above additionally checks
// that a requested source value occupies that payload.
pub fn verify_g1_i64_callable_artifact(bytes: Bytes) -> Bool {
    handle g1_candidate_has_length_and_directory(bytes, 1168) {
