fn g1_i64_binary_call_candidate_ordered(operation: G1I64Arithmetic, first: i64, second: i64, left_constant: u32, right_constant: u32) -> Bytes {
    g1_concat3(
        g1_concat8(g1_i64_binary_call_directory(), g1_unit_entry_name_table(__g1_bytes_from_array_move([109, 97, 105, 110])), g1_four_zero_padding_bytes(), g1_predefined_type_table(), g1_four_zero_padding_bytes(), g1_i64_binary_constant_table(first, second), g1_i64_binary_call_signature_table(), g1_append_field(g1_empty_variable_table(), g1_empty_variable_table())),
