// `static.subslice` uses two `usize` operands.  The canonical constants table
// therefore orders the `usize(1)` record (tag 12) before the sealed segment
// record (tag 19), with offsets derived from both variable-size records.
fn g1_static_subslice_constants(bytes: Bytes) -> Bytes {
    let index = g1_variable_record(12, 0, u64_le_bytes(1));
    let static_record = g1_variable_record(19, 0, g1_static_data_payload(
        __g1_bytes_from_array_move([67, 73, 84, 65, 84, 83, 95, 69, 83, 79, 73, 68, 78, 65, 82, 71]),
        1,
        bytes,
    ));
    let index_length = __g1_int_convert_wrapping_to_u32<usize>(__g1_bytes_len(index));
    let static_end = __g1_int_wrapping_add<u32>(index_length, __g1_int_convert_wrapping_to_u32<usize>(__g1_bytes_len(static_record)));
    g1_append_field(
        g1_append_field(
            u32_le_bytes(2),
            g1_concat3(u32_le_bytes(0), u32_le_bytes(index_length), u32_le_bytes(static_end)),
        ),
        g1_append_field(index, static_record),
    )
}

