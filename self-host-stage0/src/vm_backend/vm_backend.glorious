// The smallest executable artifact is composed from the same source-owned
// table encoders as later MIR-driven emission.  Its fixed unit-return words
// are a bootstrap seed, not a host-side compiler fallback.
pub fn g1_unit_entry_candidate() -> Bytes {
    g1_unit_entry_candidate_named_four_bytes(__g1_bytes_from_array_move([109, 97, 105, 110]))
}

// This seed layout deliberately accepts exactly four-byte names. A general
// encoder must shift every later section when the string table grows; it must
// not be approximated with trailing bytes inside the variable table.
pub fn g1_unit_entry_candidate_named_four_bytes(name: Bytes) -> Bytes {
    g1_concat3(
        g1_concat8(
            g1_unit_entry_directory(name), g1_unit_entry_name_slot(name),
            g1_predefined_type_table(), g1_four_zero_padding_bytes(),
            g1_empty_variable_table(), g1_unit_entry_signature_table(),
            g1_append_field(g1_empty_variable_table(), g1_empty_variable_table()), __g1_bytes_from_array_move([]),
        ),
        g1_append_field(g1_unit_entry_function_table(), g1_unit_entry_code()),
        g1_append_field(g1_unit_entry_cleanup_table(), g1_empty_variable_table()),
    )
}

// A name occupies the only variable-size section in this minimal executable.
// Every later directory entry therefore derives from the same byte length;
// this is a real layout encoder, not padding appended after a fixed image.
fn g1_unit_entry_candidate_named(name: Bytes) -> Bytes {
    g1_concat3(
        g1_concat8(
            g1_unit_entry_directory_named(name), g1_unit_entry_name_slot(name),
            g1_predefined_type_table(), g1_four_zero_padding_bytes(),
            g1_empty_variable_table(), g1_unit_entry_signature_table(),
            g1_append_field(g1_empty_variable_table(), g1_empty_variable_table()), __g1_bytes_from_array_move([]),
        ),
        g1_append_field(g1_unit_entry_function_table(), g1_unit_entry_code()),
        g1_append_field(g1_unit_entry_cleanup_table(), g1_empty_variable_table()),
    )
}

fn g1_unit_entry_sections_start(name: Bytes) -> usize {
    __g1_int_wrapping_add<usize>(
        __g1_int_wrapping_add<usize>(528, __g1_bytes_len(name)),
        g1_name_padding_length(__g1_bytes_len(name)),
    )
}

fn g1_unit_entry_offset(name: Bytes, relative: usize) -> usize {
    __g1_int_wrapping_add<usize>(g1_unit_entry_sections_start(name), relative)
}

fn g1_unit_entry_offset_u64(name: Bytes, relative: usize) -> u64 {
    g1_usize_as_u64(g1_unit_entry_offset(name, relative))
}

fn g1_unit_entry_directory_named(name: Bytes) -> Bytes {
    g1_append_field(
        g1_append_field(
            g1_append_field(
                g1_append_field(
                    g1_append_field(
                        g1_append_field(
                            g1_append_field(g1_header(0, 1, 1, g1_usize_as_u64(g1_unit_entry_offset(name, 400))), g1_directory_entry(1, 512, g1_usize_as_u64(__g1_int_wrapping_add<usize>(16, __g1_bytes_len(name))), 1, 0)),
                            g1_directory_entry(2, g1_unit_entry_offset_u64(name, 0), 236, 19, 0),
                        ),
                        g1_directory_entry(3, g1_unit_entry_offset_u64(name, 240), 8, 0, 0),
                    ),
                    g1_directory_entry(4, g1_unit_entry_offset_u64(name, 248), 32, 1, 0),
                ),
                g1_directory_entry(5, g1_unit_entry_offset_u64(name, 280), 0, 0, 24),
            ),
            g1_directory_entry(6, g1_unit_entry_offset_u64(name, 280), 8, 0, 0),
        ),
        g1_unit_entry_directory_tail_named(name),
    )
}

fn g1_unit_entry_directory_tail_named(name: Bytes) -> Bytes {
    g1_append_field(
        g1_append_field(
            g1_append_field(
                g1_append_field(
                    g1_append_field(
                        g1_append_field(
                            g1_append_field(g1_directory_entry(7, g1_unit_entry_offset_u64(name, 288), 8, 0, 0), g1_directory_entry(8, g1_unit_entry_offset_u64(name, 296), 64, 1, 64)),
                            g1_directory_entry(9, g1_unit_entry_offset_u64(name, 360), 8, 2, 4),
                        ),
                        g1_directory_entry(10, g1_unit_entry_offset_u64(name, 368), 0, 0, 4),
                    ),
                    g1_directory_entry(11, g1_unit_entry_offset_u64(name, 368), 24, 1, 24),
                ),
                g1_directory_entry(12, g1_unit_entry_offset_u64(name, 392), 0, 0, 16),
            ),
            g1_directory_entry(13, g1_unit_entry_offset_u64(name, 392), 0, 0, 16),
        ),
        g1_directory_entry(14, g1_unit_entry_offset_u64(name, 392), 8, 0, 0),
    )
}

pub fn g1_unit_entry_candidate_has_expected_length() -> Bool {
    __g1_bytes_len(g1_unit_entry_candidate()) == 936
}

// This source-side gate verifies the complete fixed-schema executable shape
// currently emitted by the bootstrap backend. It intentionally precedes the
// independent Rust VM verification: malformed source emission must not gain
// publication authority merely because it originated inside this module.
pub fn verify_g1_unit_entry_artifact(bytes: Bytes) -> Bool {
    verify_g1_unit_entry_artifact_named_four_bytes(bytes, __g1_bytes_from_array_move([109, 97, 105, 110]))
}

pub fn verify_g1_unit_entry_artifact_named_four_bytes(bytes: Bytes, name: Bytes) -> Bool {
    handle __g1_bytes_len(bytes) == 936 {
        true => handle __g1_bytes_len(name) == 4 {
            true => verify_g1_unit_entry_header(bytes, name),
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

fn verify_g1_unit_entry_header(bytes: Bytes, name: Bytes) -> Bool {
    handle g1_directory_is_canonical(bytes) {
        true => handle g1_magic_bytes_match(bytes) {
        true => handle __g1_bytes_get(bytes, 8) == 1 {
            true => handle __g1_bytes_get(bytes, 12) == 64 {
                true => handle __g1_bytes_get(bytes, 16) == 1 {
                    true => handle __g1_bytes_get(bytes, 28) == 0 {
                        true => handle __g1_bytes_get(bytes, 32) == 1 {
                            true => verify_g1_unit_entry_directory(bytes, name),
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
                    },
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
        },
        false => false,
        _ => false,
    }
}

fn verify_g1_unit_entry_directory(bytes: Bytes, name: Bytes) -> Bool {
    handle __g1_bytes_get(bytes, 48) == 64 {
        true => handle __g1_bytes_get(bytes, 56) == 168 {
            true => handle __g1_bytes_get(bytes, 57) == 3 {
                true => handle __g1_bytes_get(bytes, 64) == 1 {
                    true => handle __g1_bytes_get(bytes, 73) == 2 {
                        true => handle __g1_bytes_get(bytes, 80) == 20 {
                            true => handle __g1_bytes_get(bytes, 81) == 0 {
                                true => handle __g1_bytes_get(bytes, 96) == 2 {
                                true => handle __g1_bytes_get(bytes, 105) == 2 {
                                    true => verify_g1_unit_entry_name_and_types(bytes, name),
                                    false => false,
                                    _ => false,
                                },
                                false => false,
                                _ => false,
                            },
                            false => false,
                            _ => false,
                            },
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
                    },
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

fn verify_g1_unit_entry_name_and_types(bytes: Bytes, name: Bytes) -> Bool {
    handle __g1_bytes_get(bytes, 512) == 1 {
        true => handle __g1_bytes_get(bytes, 516) == 4 {
            true => handle __g1_bytes_get(bytes, 528) == __g1_bytes_get(name, 0) {
                true => handle __g1_bytes_get(bytes, 529) == __g1_bytes_get(name, 1) {
                    true => handle __g1_bytes_get(bytes, 530) == __g1_bytes_get(name, 2) {
                        true => handle __g1_bytes_get(bytes, 531) == __g1_bytes_get(name, 3) {
                            true => handle __g1_bytes_get(bytes, 536) == 19 {
                                true => verify_g1_unit_entry_code(bytes),
                                false => false,
                                _ => false,
                            },
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
