        false => false,
        _ => false,
    }
}

fn g1_unit_entry_directory_name_length_matches(bytes: Bytes, name: Bytes) -> Bool {
    __g1_bytes_get(bytes, 80) == __g1_bytes_get(g1_unit_entry_name_table(name), 4)
}

fn g1_unit_entry_name_length_matches(bytes: Bytes, name: Bytes) -> Bool {
    __g1_bytes_get(bytes, 516) == __g1_bytes_get(g1_unit_entry_name_table(name), 4)
}

fn g1_unit_entry_name_matches(bytes: Bytes, name: Bytes, index: usize) -> Bool {
    handle index == __g1_bytes_len(name) {
        true => true,
        false => handle __g1_bytes_get(bytes, __g1_int_wrapping_add<usize>(528, index)) == __g1_bytes_get(name, index) {
            true => g1_unit_entry_name_matches(bytes, name, __g1_int_wrapping_add<usize>(index, 1)),
            false => false,
            _ => false,
        },
        _ => false,
    }
}

fn verify_g1_unit_entry_code(bytes: Bytes) -> Bool {
    handle __g1_bytes_get(bytes, 896) == 38 {
        true => handle __g1_bytes_get(bytes, 897) == 16 {
            true => handle __g1_bytes_get(bytes, 900) == 255 {
                true => __g1_bytes_get(bytes, 903) == 255,
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

// This is the first MIR-selected G1 emission boundary.  It intentionally
// accepts only the unit-return lowering represented by the generated entry
// artifact; every other terminator remains an explicit rejection until its
// instruction and metadata encoders are implemented.
pub fn emit_g1_for_terminator(terminator: Terminator) -> ArtifactEmission {
    handle terminator {
        Terminator::Return => emit_verified_g1_unit_entry(),
        _ => ArtifactEmission::Rejected,
    }
}

fn emit_verified_g1_unit_entry() -> ArtifactEmission {
    let candidate = g1_unit_entry_candidate();
    handle verify_g1_unit_entry_artifact(candidate) {
        true => ArtifactEmission::Artifact(candidate),
        false => ArtifactEmission::Rejected,
        _ => ArtifactEmission::Rejected,
    }
}

pub fn emit_g1_named_unit_entry(name: Bytes) -> ArtifactEmission {
    handle __g1_bytes_len(name) == 0 {
        true => ArtifactEmission::Rejected,
        false => handle __g1_bytes_len(name) > 255 {
            true => ArtifactEmission::Rejected,
            false => emit_verified_named_g1_unit_entry(name),
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn emit_verified_named_g1_unit_entry(name: Bytes) -> ArtifactEmission {
    let candidate = g1_unit_entry_candidate_named(name);
    handle verify_g1_unit_entry_artifact_named(candidate, name) {
        true => ArtifactEmission::Artifact(candidate),
        false => ArtifactEmission::Rejected,
        _ => ArtifactEmission::Rejected,
    }
}

// The source verifier recomputes the complete canonical layout for the exact
// requested name. This checks every length-sensitive directory offset at once
// and remains independent of the Rust VM's later artifact verification.
fn verify_g1_unit_entry_artifact_named(bytes: Bytes, name: Bytes) -> Bool {
    handle g1_directory_is_canonical(bytes) {
        true => handle __g1_bytes_len(name) == 0 {
        true => false,
        false => handle __g1_bytes_len(name) > 255 {
            true => false,
            false => g1_bytes_equal(bytes, g1_unit_entry_candidate_named(name), 0),
            _ => false,
        },
        _ => false,
        },
        false => false,
        _ => false,
    }
}

fn g1_bytes_equal(left: Bytes, right: Bytes, index: usize) -> Bool {
    handle __g1_bytes_len(left) == __g1_bytes_len(right) {
        true => g1_bytes_equal_same_length(left, right, index),
        false => false,
        _ => false,
    }
}

fn g1_bytes_equal_same_length(left: Bytes, right: Bytes, index: usize) -> Bool {
    handle index == __g1_bytes_len(left) {
        true => true,
        false => handle __g1_bytes_get(left, index) == __g1_bytes_get(right, index) {
            true => g1_bytes_equal_same_length(left, right, __g1_int_wrapping_add<usize>(index, 1)),
            false => false,
            _ => false,
        },
        _ => false,
    }
}

// The public bootstrap codegen entrypoint accepts typed source Body IR and
// owns the complete Body→Core→MIR transition before artifact selection.
// Callers cannot manufacture a return terminator that does not follow a
// successful source-level admission.
pub fn emit_g1_for_body(expression: Expression, expected: Type) -> ArtifactEmission {
    emit_g1_for_terminator(mir::lower(lower_core(expression, expected)))
}

pub fn emit_g1_for_return_has_expected_length() -> Bool {
    handle emit_g1_for_terminator(Terminator::Return) {
        ArtifactEmission::Artifact(bytes) => __g1_bytes_len(bytes) == 936,
        ArtifactEmission::Rejected => false,
        _ => false,
    }
}

pub fn g1_unit_entry_candidate_passes_source_verification() -> Bool {
    verify_g1_unit_entry_artifact(g1_unit_entry_candidate())
}

pub fn g1_four_byte_named_entry_passes_source_verification() -> Bool {
    let name = __g1_bytes_from_array_move([98, 111, 111, 116]);
    verify_g1_unit_entry_artifact_named_four_bytes(g1_unit_entry_candidate_named_four_bytes(name), name)
}


pub fn g1_unit_entry_source_verifier_rejects_header_only() -> Bool {
    verify_g1_unit_entry_artifact(g1_empty_header()) == false
}

pub fn emit_g1_rejects_unimplemented_terminator() -> Bool {
    handle emit_g1_for_terminator(Terminator::Trap) {
        ArtifactEmission::Artifact(_) => false,
        ArtifactEmission::Rejected => true,
        _ => false,
    }
}

pub fn emit_g1_for_return_has_expected_length_from_unit_lowering() -> Bool {
    handle emit_g1_for_body(Expression::Unit, Type::Unit) {
        ArtifactEmission::Artifact(bytes) => __g1_bytes_len(bytes) == 936,
        ArtifactEmission::Rejected => false,
        _ => false,
    }
}

pub fn emit_g1_rejects_body_type_mismatch() -> Bool {
    handle emit_g1_for_body(Expression::I64(1), Type::Unit) {
        ArtifactEmission::Artifact(_) => false,
        ArtifactEmission::Rejected => true,
        _ => false,
    }
}

fn g1_empty_header_fields_match(header: Bytes) -> Bool {
    // Check one or more bytes from every fixed header field. Together with
    // the exact magic check above, these distinguish the canonical G1.0 empty
    // image preamble from the old Stage0 envelope and common endian mistakes.
    handle __g1_bytes_get(header, 8) == 1 {
        true => handle __g1_bytes_get(header, 12) == 64 {
            true => handle __g1_bytes_get(header, 20) == 14 {
                true => handle __g1_bytes_get(header, 24) == 32 {
                    true => handle __g1_bytes_get(header, 28) == 255 {
                        true => handle __g1_bytes_get(header, 32) == 1 {
                            true => handle __g1_bytes_get(header, 48) == 64 {
                                true => __g1_bytes_get(header, 57) == 2,
                                false => false,
                                _ => false,
                            },
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
                    },
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

fn g1_magic_bytes_match(value: Bytes) -> Bool {
    handle __g1_bytes_get(value, 0) == 71 {
        true => handle __g1_bytes_get(value, 1) == 82 {
            true => handle __g1_bytes_get(value, 2) == 66 {
                true => handle __g1_bytes_get(value, 3) == 67 {
                    true => handle __g1_bytes_get(value, 4) == 13 {
                        true => handle __g1_bytes_get(value, 5) == 10 {
                            true => handle __g1_bytes_get(value, 6) == 26 {
                                true => __g1_bytes_get(value, 7) == 10,
                                false => false,
                                _ => false,
                            },
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
                    },
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

// This is the first executable instruction family in the source backend. A
// divisor is checked at the semantic boundary before the manifest-bound leaf
// is invoked, so a malformed candidate cannot turn a zero divisor into a
// host failure. Additional VM instruction families extend this explicit
// outcome model rather than bypassing it through a host-side evaluator.
pub enum ArithmeticInstruction {
    Constant(i64),
    WrappingAdd(i64, i64),
    WrappingSub(i64, i64),
    WrappingMul(i64, i64),
    CheckedDiv(i64, i64),
}
pub enum ComparisonInstruction { EqualI64(i64, i64), LessI64(i64, i64), GreaterI64(i64, i64), EqualU64(u64, u64), NotEqualU64(u64, u64), LessU64(u64, u64), LessEqualU64(u64, u64), GreaterU64(u64, u64), GreaterEqualU64(u64, u64), EqualU8(u8, u8), NotEqualU8(u8, u8), LessU8(u8, u8), LessEqualU8(u8, u8), GreaterU8(u8, u8), GreaterEqualU8(u8, u8), EqualUsize(usize, usize), NotEqualUsize(usize, usize), LessUsize(usize, usize), LessEqualUsize(usize, usize), GreaterUsize(usize, usize), GreaterEqualUsize(usize, usize) }
pub enum ConditionalInstruction { SelectI64(Bool, i64, i64) }
pub enum BooleanInstruction { Not(Bool) }

// Calls stay separate from terminal returns so a typed call-shaped body cannot
// bypass future callee verification by attaching an arbitrary return payload.
// IdentityI64 is the bootstrap callable contract; later call targets extend
// this instruction family with the same candidate/verified split.
pub enum CallInstruction { IdentityI64(i64), AddI64(i64, i64) }

// Candidate programs are untrusted input to the backend. Only a successful
// verification produces this separate type, keeping execution authority out
// of decoding and construction paths.
pub enum CandidateProgram { Arithmetic(ArithmeticInstruction), U32Arithmetic(U32ArithmeticInstruction), UsizeArithmetic(UsizeArithmeticInstruction), Boolean(BooleanInstruction), Comparison(ComparisonInstruction), Conditional(ConditionalInstruction), Call(CallInstruction), Terminal(Terminator, i64), U32Terminal(Terminator, u32), Storage(StorageLowering), RuntimeImport(Text, Text, PrimitiveSignature), HostImport(Text, Text, HostSignature) }
pub enum VerifiedProgram { Arithmetic(ArithmeticInstruction), U32Arithmetic(U32ArithmeticInstruction), UsizeArithmetic(UsizeArithmeticInstruction), Boolean(BooleanInstruction), Comparison(ComparisonInstruction), Conditional(ConditionalInstruction), Call(CallInstruction), Terminal(Terminator, i64), U32Terminal(Terminator, u32), Storage(StorageLowering), RuntimeImport(Primitive), HostImport(HostCapability) }
pub enum Verification { Verified(VerifiedProgram), Rejected }

// The terminal tag remains a verifier boundary, while the return payload is
// kept explicit for the later candidate/verified interpreter path.
pub fn execute(terminator: Terminator) -> Execution { execute_value(terminator, 0) }
pub fn execute_value(terminator: Terminator, value: i64) -> Execution {
    handle terminator {
        Terminator::Return => Execution::Returned(value),
        Terminator::ParameterReturn => Execution::Returned(value),
        Terminator::BooleanReturn => Execution::Returned(value),
        Terminator::ArithmeticReturn => Execution::Returned(value),
        Terminator::ComparisonReturn => Execution::Returned(value),
        Terminator::ConditionalReturn => Execution::Returned(value),
        Terminator::CallReturn => Execution::Returned(value),
        Terminator::PatternReturn => Execution::Returned(value),
        Terminator::Trap => Execution::Faulted,
        _ => Execution::Faulted,
    }
}

// The backend consumes MIR's frozen ownership result. It deliberately has no
// dependency on storage-slot representations, so only MIR determines whether
// an ownership-consuming read reaches execution.
pub fn execute_storage(lowering: StorageLowering) -> Execution {
    handle lowering {
        StorageLowering::ReturnValue(value, _) => Execution::Returned(value),
        StorageLowering::Trap(_) => Execution::Faulted,
        _ => Execution::Faulted,
    }
}

pub fn execute_arithmetic(instruction: ArithmeticInstruction) -> Execution {
    handle instruction {
        ArithmeticInstruction::Constant(value) => Execution::Returned(value),
        ArithmeticInstruction::WrappingAdd(left, right) => Execution::Returned(__g1_int_wrapping_add<i64>(left, right)),
        ArithmeticInstruction::WrappingSub(left, right) => Execution::Returned(__g1_int_wrapping_sub<i64>(left, right)),
        ArithmeticInstruction::WrappingMul(left, right) => Execution::Returned(__g1_int_wrapping_mul<i64>(left, right)),
        ArithmeticInstruction::CheckedDiv(left, right) => execute_checked_div(left, right),
        _ => Execution::Faulted,
    }
}

fn execute_u32_arithmetic(instruction: U32ArithmeticInstruction) -> Execution {
    handle instruction {
        U32ArithmeticInstruction::CheckedAdd(left, right) => Execution::ReturnedU32(__g1_int_wrapping_add<u32>(left, right)),
        U32ArithmeticInstruction::CheckedSub(left, right) => Execution::ReturnedU32(__g1_int_wrapping_sub<u32>(left, right)),
        U32ArithmeticInstruction::CheckedMul(left, right) => Execution::ReturnedU32(__g1_int_wrapping_mul<u32>(left, right)),
        U32ArithmeticInstruction::CheckedDiv(left, right) => handle right == 0 { true => Execution::Faulted, false => Execution::ReturnedU32(__g1_int_checked_div<u32>(left, right)), _ => Execution::Faulted },
        U32ArithmeticInstruction::CheckedRem(left, right) => execute_u32_checked_remainder(left, right),
        _ => Execution::Faulted,
    }
}

fn execute_usize_arithmetic(instruction: UsizeArithmeticInstruction) -> Execution { handle instruction { UsizeArithmeticInstruction::CheckedAdd(left, right) => Execution::ReturnedUsize(__g1_int_wrapping_add<usize>(left, right)), _ => Execution::Faulted } }

fn execute_u32_checked_remainder(left: u32, right: u32) -> Execution {
    handle right == 0 {
        true => Execution::Faulted,
        false => {
            let quotient = __g1_int_checked_div<u32>(left, right);
            Execution::ReturnedU32(__g1_int_wrapping_sub<u32>(left, __g1_int_wrapping_mul<u32>(quotient, right)))
        },
        _ => Execution::Faulted,
    }
}

pub fn execute_call(instruction: CallInstruction) -> Execution {
    handle instruction {
        CallInstruction::IdentityI64(value) => Execution::Returned(value),
        CallInstruction::AddI64(left, right) => Execution::Returned(__g1_int_wrapping_add<i64>(left, right)),
        _ => Execution::Faulted,
    }
}

pub fn execute_comparison(instruction: ComparisonInstruction) -> Execution {
    handle instruction {
        ComparisonInstruction::EqualI64(left, right) => bool_execution(left == right),
        ComparisonInstruction::LessI64(left, right) => bool_execution(left < right),
        ComparisonInstruction::GreaterI64(left, right) => bool_execution(left > right),
        ComparisonInstruction::EqualU64(left, right) => bool_execution(left == right),
        ComparisonInstruction::NotEqualU64(left, right) => bool_execution(left != right),
        ComparisonInstruction::LessU64(left, right) => bool_execution(left < right),
        ComparisonInstruction::LessEqualU64(left, right) => bool_execution(left <= right),
        ComparisonInstruction::GreaterU64(left, right) => bool_execution(left > right),
        ComparisonInstruction::GreaterEqualU64(left, right) => bool_execution(left >= right),
        ComparisonInstruction::EqualU8(left, right) => bool_execution(left == right),
        ComparisonInstruction::NotEqualU8(left, right) => bool_execution(left != right),
        ComparisonInstruction::LessU8(left, right) => bool_execution(left < right),
        ComparisonInstruction::LessEqualU8(left, right) => bool_execution(left <= right),
        ComparisonInstruction::GreaterU8(left, right) => bool_execution(left > right),
        ComparisonInstruction::GreaterEqualU8(left, right) => bool_execution(left >= right),
        ComparisonInstruction::EqualUsize(left, right) => bool_execution(left == right),
        ComparisonInstruction::NotEqualUsize(left, right) => bool_execution(left != right),
        ComparisonInstruction::LessUsize(left, right) => bool_execution(left < right),
        ComparisonInstruction::LessEqualUsize(left, right) => bool_execution(left <= right),
        ComparisonInstruction::GreaterUsize(left, right) => bool_execution(left > right),
        ComparisonInstruction::GreaterEqualUsize(left, right) => bool_execution(left >= right),
        _ => Execution::Faulted,
    }
}

// A digest call is executable only after the candidate's package, selector,
// and exact Bytes -> Bytes signature have all passed manifest verification.
// This keeps a same-named user import from acquiring hashing authority.
pub fn execute_candidate_blake3(candidate: CandidateProgram, input: Bytes) -> BytesExecution {
    handle verify(candidate) {
        Verification::Verified(VerifiedProgram::RuntimeImport(Primitive::Blake3)) => BytesExecution::Bytes(__g1_blake3(input)),
        _ => BytesExecution::Faulted,
    }
}

pub fn execute_conditional(instruction: ConditionalInstruction) -> Execution {
    handle instruction {
        ConditionalInstruction::SelectI64(condition, when_true, when_false) => handle condition {
            true => Execution::Returned(when_true),
            false => Execution::Returned(when_false),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

pub fn execute_boolean(instruction: BooleanInstruction) -> Execution {
    handle instruction {
        BooleanInstruction::Not(value) => handle value { true => Execution::Returned(0), false => Execution::Returned(1), _ => Execution::Faulted },
        _ => Execution::Faulted,
    }
}

fn bool_execution(value: Bool) -> Execution { handle value { true => Execution::Returned(1), false => Execution::Returned(0), _ => Execution::Faulted } }

pub fn verify(candidate: CandidateProgram) -> Verification {
    handle candidate {
        CandidateProgram::Arithmetic(instruction) => verify_arithmetic(instruction),
        CandidateProgram::U32Arithmetic(instruction) => verify_u32_arithmetic(instruction),
        CandidateProgram::UsizeArithmetic(instruction) => verify_usize_arithmetic(instruction),
        CandidateProgram::Boolean(instruction) => Verification::Verified(VerifiedProgram::Boolean(instruction)),
        CandidateProgram::Comparison(instruction) => Verification::Verified(VerifiedProgram::Comparison(instruction)),
        CandidateProgram::Conditional(instruction) => Verification::Verified(VerifiedProgram::Conditional(instruction)),
        CandidateProgram::Call(instruction) => Verification::Verified(VerifiedProgram::Call(instruction)),
        CandidateProgram::Terminal(terminator, value) => Verification::Verified(VerifiedProgram::Terminal(terminator, value)),
        CandidateProgram::U32Terminal(terminator, value) => verify_u32_terminal(terminator, value),
        CandidateProgram::Storage(lowering) => verify_storage(lowering),
        CandidateProgram::RuntimeImport(package, name, signature) => verify_runtime_import(package, name, signature),
        CandidateProgram::HostImport(package, name, signature) => verify_host_import(package, name, signature),
        _ => Verification::Rejected,
    }
}

fn verify_usize_arithmetic(instruction: UsizeArithmeticInstruction) -> Verification { handle instruction { UsizeArithmeticInstruction::CheckedAdd(left, right) => { let result = __g1_int_wrapping_add<usize>(left, right); handle result < left { true => Verification::Rejected, false => Verification::Verified(VerifiedProgram::UsizeArithmetic(instruction)), _ => Verification::Rejected } }, _ => Verification::Rejected } }

fn verify_u32_arithmetic(instruction: U32ArithmeticInstruction) -> Verification {
    handle instruction {
        U32ArithmeticInstruction::CheckedAdd(left, right) => verify_u32_addition(left, right, instruction),
        U32ArithmeticInstruction::CheckedSub(left, right) => verify_u32_subtraction(left, right, instruction),
        U32ArithmeticInstruction::CheckedMul(left, right) => verify_u32_multiplication(left, right, instruction),
        U32ArithmeticInstruction::CheckedDiv(_, right) => handle right == 0 { true => Verification::Rejected, false => Verification::Verified(VerifiedProgram::U32Arithmetic(instruction)), _ => Verification::Rejected },
        U32ArithmeticInstruction::CheckedRem(_, right) => handle right == 0 { true => Verification::Rejected, false => Verification::Verified(VerifiedProgram::U32Arithmetic(instruction)), _ => Verification::Rejected },
        _ => Verification::Verified(VerifiedProgram::U32Arithmetic(instruction)),
    }
}

fn verify_u32_addition(left: u32, right: u32, instruction: U32ArithmeticInstruction) -> Verification {
    let result = __g1_int_wrapping_add<u32>(left, right);
    handle result < left {
        true => Verification::Rejected,
        false => Verification::Verified(VerifiedProgram::U32Arithmetic(instruction)),
        _ => Verification::Rejected,
    }
}

fn verify_u32_subtraction(left: u32, right: u32, instruction: U32ArithmeticInstruction) -> Verification {
    handle right > left {
        true => Verification::Rejected,
        false => Verification::Verified(VerifiedProgram::U32Arithmetic(instruction)),
        _ => Verification::Rejected,
    }
}

fn verify_u32_multiplication(left: u32, right: u32, instruction: U32ArithmeticInstruction) -> Verification {
    handle left == 0 {
        true => Verification::Verified(VerifiedProgram::U32Arithmetic(instruction)),
        false => verify_u32_multiplication_nonzero_left(left, right, instruction),
        _ => Verification::Rejected,
    }
}

fn verify_u32_multiplication_nonzero_left(left: u32, right: u32, instruction: U32ArithmeticInstruction) -> Verification {
    let result = __g1_int_wrapping_mul<u32>(left, right);
    handle __g1_int_checked_div<u32>(result, left) == right {
        true => Verification::Verified(VerifiedProgram::U32Arithmetic(instruction)),
        false => Verification::Rejected,
        _ => Verification::Rejected,
    }
}

fn verify_u32_terminal(terminator: Terminator, value: u32) -> Verification {
    handle terminator {
        Terminator::Return => Verification::Verified(VerifiedProgram::U32Terminal(terminator, value)),
        Terminator::ParameterReturn => Verification::Verified(VerifiedProgram::U32Terminal(terminator, value)),
        _ => Verification::Rejected,
    }
}

// Host-import candidates pass through the same manifest-bound declaration
// check as source declarations.  A verified import has authority but no
// executable value on its own; dispatch remains an explicit later opcode.
fn verify_runtime_import(package: Text, name: Text, signature: PrimitiveSignature) -> Verification {
    handle validate_bound_declaration(package, name, signature) {
        DeclarationValidation::Value(primitive) => Verification::Verified(VerifiedProgram::RuntimeImport(primitive)),
        DeclarationValidation::UnknownSelector => Verification::Rejected,
        DeclarationValidation::PackageMismatch => Verification::Rejected,
        DeclarationValidation::SignatureMismatch => Verification::Rejected,
        _ => Verification::Rejected,
    }
}

// Host capability imports are verified separately from VM primitives. The
// resulting value represents authority only; execution still requires a
// later explicit host-call instruction and launcher-installed handler.
fn verify_host_import(package: Text, name: Text, signature: HostSignature) -> Verification {
    handle validate_bound_host_declaration(package, name, signature) {
        HostDeclarationValidation::Value(capability) => Verification::Verified(VerifiedProgram::HostImport(capability)),
        HostDeclarationValidation::UnknownSelector => Verification::Rejected,
        HostDeclarationValidation::PackageMismatch => Verification::Rejected,
        HostDeclarationValidation::SignatureMismatch => Verification::Rejected,
        _ => Verification::Rejected,
    }
}

// A storage return is executable only when its payload came from an explicit
// move.  This preserves MIR's post-move proof across the candidate/verified
// boundary instead of allowing a hand-built candidate to claim a live slot.
fn verify_storage(lowering: StorageLowering) -> Verification {
    handle lowering {
        StorageLowering::ReturnValue(value, Slot::Moved) => Verification::Verified(VerifiedProgram::Storage(StorageLowering::ReturnValue(value, Slot::Moved))),
        StorageLowering::Trap(slot) => Verification::Verified(VerifiedProgram::Storage(StorageLowering::Trap(slot))),
        _ => Verification::Rejected,
    }
}

fn verify_arithmetic(instruction: ArithmeticInstruction) -> Verification {
    handle instruction {
        ArithmeticInstruction::CheckedDiv(left, right) => verify_checked_division(left, right, instruction),
        _ => Verification::Verified(VerifiedProgram::Arithmetic(instruction)),
    }
}

fn verify_checked_division(left: i64, right: i64, instruction: ArithmeticInstruction) -> Verification {
    handle right == 0 {
        true => Verification::Rejected,
        false => handle left == i64_minimum() {
            true => handle right == -1 {
                true => Verification::Rejected,
                false => Verification::Verified(VerifiedProgram::Arithmetic(instruction)),
                _ => Verification::Rejected,
            },
            false => Verification::Verified(VerifiedProgram::Arithmetic(instruction)),
            _ => Verification::Rejected,
        },
        _ => Verification::Rejected,
    }
}

fn i64_minimum() -> i64 {
    __g1_int_wrapping_add<i64>(-9223372036854775807, -1)
}

pub fn execute_verified(program: VerifiedProgram) -> Execution {
    handle program {
        VerifiedProgram::Arithmetic(instruction) => execute_arithmetic(instruction),
        VerifiedProgram::U32Arithmetic(instruction) => execute_u32_arithmetic(instruction),
        VerifiedProgram::UsizeArithmetic(instruction) => execute_usize_arithmetic(instruction),
        VerifiedProgram::Boolean(instruction) => execute_boolean(instruction),
        VerifiedProgram::Comparison(instruction) => execute_comparison(instruction),
        VerifiedProgram::Conditional(instruction) => execute_conditional(instruction),
        VerifiedProgram::Call(instruction) => execute_call(instruction),
        VerifiedProgram::Terminal(terminator, value) => execute_value(terminator, value),
        VerifiedProgram::U32Terminal(terminator, value) => execute_u32_value(terminator, value),
        VerifiedProgram::Storage(lowering) => execute_storage(lowering),
        VerifiedProgram::RuntimeImport(_) => Execution::Faulted,
        VerifiedProgram::HostImport(_) => Execution::Faulted,
        _ => Execution::Faulted,
    }
}

fn execute_u32_value(terminator: Terminator, value: u32) -> Execution {
    handle terminator {
        Terminator::Return => Execution::ReturnedU32(value),
        Terminator::ParameterReturn => Execution::ReturnedU32(value),
        _ => Execution::Faulted,
    }
}

pub fn execute_verified_host_import(program: VerifiedProgram, response: HostResponse) -> HostExecution {
    handle program {
        VerifiedProgram::HostImport(capability) => execute_host_import(capability, response),
        _ => HostExecution::Faulted,
    }
}

fn execute_host_import(capability: HostCapability, response: HostResponse) -> HostExecution {
    handle (capability, response) {
        (HostCapability::ProcessArgs, HostResponse::ProcessArgs(values)) => HostExecution::ProcessArgs(values),
        (HostCapability::FileRead, HostResponse::FileRead(bytes)) => HostExecution::FileRead(bytes),
        (HostCapability::FileWriteAtomic, HostResponse::FileWriteAtomic) => HostExecution::Unit,
        (HostCapability::DiagnosticWrite, HostResponse::DiagnosticWrite) => HostExecution::Unit,
        _ => HostExecution::Faulted,
    }
}

pub fn execute_candidate(candidate: CandidateProgram) -> Execution {
    handle verify(candidate) {
        Verification::Verified(program) => execute_verified(program),
        Verification::Rejected => Execution::Faulted,
        _ => Execution::Faulted,
    }
}

pub fn execute_candidate_host_import(candidate: CandidateProgram, response: HostResponse) -> HostExecution {
    handle verify(candidate) {
        Verification::Verified(program) => execute_verified_host_import(program, response),
        Verification::Rejected => HostExecution::Faulted,
        _ => HostExecution::Faulted,
    }
}

fn execute_checked_div(left: i64, right: i64) -> Execution {
    handle right == 0 {
        true => Execution::Faulted,
        false => Execution::Returned(__g1_int_checked_div<i64>(left, right)),
        _ => Execution::Faulted,
    }
}

pub fn returned_value(execution: Execution) -> i64 {
    handle execution {
        Execution::Returned(value) => value,
        Execution::ReturnedU32(_) => 0,
        Execution::Faulted => 0,
        _ => 0,
    }
}
