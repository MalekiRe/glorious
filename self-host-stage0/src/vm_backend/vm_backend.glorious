                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

// The generic file verifier validates the two-constant call layout without
// requiring caller-supplied values. It retains canonical wire ordering and
// permits only the two operand-reference permutations that encode a source
// binary expression over that ordered pool.
pub fn verify_g1_i64_binary_call_artifact(bytes: Bytes) -> Bool {
    handle g1_candidate_has_length_and_directory(bytes, 1288) {
        true => handle g1_magic_bytes_match(bytes) {
