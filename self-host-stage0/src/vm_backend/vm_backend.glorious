        g1_concat8(g1_i64_identity_call_directory(), g1_unit_entry_name_table(__g1_bytes_from_array_move([109, 97, 105, 110])), g1_four_zero_padding_bytes(), g1_predefined_type_table(), g1_four_zero_padding_bytes(), g1_i64_constant_table(value), g1_four_zero_padding_bytes(), g1_i64_identity_call_signature_table()),
