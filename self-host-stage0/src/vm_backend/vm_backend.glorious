pub fn emit_g1_i64_binary_call(operation: G1I64Arithmetic, left: i64, right: i64) -> ArtifactEmission {
    let candidate = g1_i64_binary_call_candidate(operation, left, right);
    handle verify_g1_i64_binary_call_candidate(candidate, operation, left, right) {
        true => ArtifactEmission::Artifact(candidate),
        _ => ArtifactEmission::Rejected,
    }
}

// First parameterized callee: the executable entry loads a scalar argument,
// calls `fn(i64) -> i64`, and discards its result at the Unit boundary.
fn g1_i64_identity_call_directory() -> Bytes {
    g1_append_field(
