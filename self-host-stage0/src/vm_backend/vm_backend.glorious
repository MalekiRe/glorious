        __g1_bytes_from_array_move([]),
    )
}

fn g1_static_get_directory_tail(protocol: usize, handler: usize, function: usize, code: usize, operands: usize, cleanup: usize, total: usize) -> Bytes {
    g1_append_field(
        g1_append_field(
            g1_append_field(
                g1_append_field(
                    g1_append_field(
                        g1_append_field(
                            g1_append_field(g1_directory_entry(6, g1_usize_as_u64(protocol), 8, 0, 0), g1_directory_entry(7, g1_usize_as_u64(handler), 8, 0, 0)),
                            g1_directory_entry(8, g1_usize_as_u64(function), 64, 1, 64),
                        ),
                        g1_directory_entry(9, g1_usize_as_u64(code), 72, 18, 4),
                    ),
                    g1_directory_entry(10, g1_usize_as_u64(operands), 60, 15, 4),
                ),
                g1_directory_entry(11, g1_usize_as_u64(cleanup), 144, 6, 24),
            ),
            g1_append_field(g1_directory_entry(12, g1_usize_as_u64(__g1_int_wrapping_sub<usize>(total, 8)), 0, 0, 16), g1_append_field(g1_directory_entry(13, g1_usize_as_u64(__g1_int_wrapping_sub<usize>(total, 8)), 0, 0, 16), g1_directory_entry(14, g1_usize_as_u64(__g1_int_wrapping_sub<usize>(total, 8)), 8, 0, 0))),
        ),
        __g1_bytes_from_array_move([]),
    )
}

fn g1_static_get_function_table() -> Bytes {
    g1_concat4(
        g1_concat4(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(5)),
        g1_concat4(u32_le_bytes(0), u32_le_bytes(18), u32_le_bytes(6), u32_le_bytes(0)),
        g1_concat4(u32_le_bytes(6), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4294967295)),
        g1_append_field(u64_le_bytes(0), u64_le_bytes(0)),
    )
}

fn g1_static_get_code() -> Bytes {
    g1_concat4(
        g1_concat4(u32_le_bytes(8193), u32_le_bytes(1), u32_le_bytes(1), u32_le_bytes(8193)),
        g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(16453), u32_le_bytes(3)),
        g1_concat4(u32_le_bytes(114), u32_le_bytes(0), u32_le_bytes(2), u32_le_bytes(8212)),
        g1_concat4(u32_le_bytes(4), u32_le_bytes(3), u32_le_bytes(4104), u32_le_bytes(3)),
    )
}

fn g1_static_get_code_tail() -> Bytes {
    g1_append_field(u32_le_bytes(4134), u32_le_bytes(4294967295))
}

fn g1_static_get_full_code() -> Bytes {
    g1_append_field(g1_static_get_code(), g1_static_get_code_tail())
}

fn g1_static_get_operands() -> Bytes {
    g1_append_field(
        g1_concat4(u32_le_bytes(1), u32_le_bytes(2), u32_le_bytes(1), u32_le_bytes(2)),
        g1_append_field(
            g1_concat4(u32_le_bytes(1), u32_le_bytes(3), u32_le_bytes(2), u32_le_bytes(1)),
            g1_append_field(g1_concat4(u32_le_bytes(4), u32_le_bytes(3), u32_le_bytes(2), u32_le_bytes(1)), g1_concat3(u32_le_bytes(4), u32_le_bytes(2), u32_le_bytes(1))),
        ),
    )
}

fn g1_static_get_cleanup_plan(first: u32, end: u32, operand_start: u32, operand_count: u32) -> Bytes {
    g1_concat3(
        g1_concat4(u32_le_bytes(0), u32_le_bytes(first), u32_le_bytes(end), u32_le_bytes(operand_start)),
        g1_append_field(u32_le_bytes(operand_count), u32_le_bytes(0)),
        __g1_bytes_from_array_move([]),
    )
}

fn g1_static_get_cleanup_table() -> Bytes {
    g1_concat4(
        g1_static_get_cleanup_plan(0, 1, 2, 0),
        g1_static_get_cleanup_plan(1, 2, 2, 1),
        g1_static_get_cleanup_plan(2, 3, 3, 2),
        g1_append_field(
            g1_static_get_cleanup_plan(3, 4, 5, 3),
            g1_append_field(g1_static_get_cleanup_plan(4, 5, 8, 4), g1_static_get_cleanup_plan(5, 6, 12, 3)),
        ),
    )
}

pub fn g1_static_utf8_get_entry_candidate(bytes: Bytes) -> Bytes {
    let constants = g1_static_subslice_constants(bytes);
    g1_append_field(
        g1_static_get_directory(constants),
        g1_append_field(
            g1_append_field(g1_unit_entry_name_slot(__g1_bytes_from_array_move([109, 97, 105, 110])), g1_static_get_type_table()),
            g1_append_field(
                g1_append_field(constants, g1_zero_bytes(g1_name_padding_length(__g1_bytes_len(constants)))),
                g1_append_field(
                    g1_append_field(g1_unit_entry_signature_table(), g1_append_field(g1_empty_variable_table(), g1_empty_variable_table())),
                    g1_append_field(
                        g1_append_field(g1_static_get_function_table(), g1_static_get_full_code()),
                        g1_append_field(
                            g1_append_field(g1_static_get_operands(), g1_four_zero_padding_bytes()),
                            g1_append_field(g1_static_get_cleanup_table(), g1_empty_variable_table()),
                        ),
                    ),
                ),
            ),
        ),
    )
}

pub fn g1_static_utf8_get_entry_candidate_has_expected_layout() -> Bool {
    let candidate = g1_static_utf8_get_entry_candidate(__g1_bytes_from_array_move([120, 121, 122]));
    handle __g1_bytes_len(candidate) == 1296 {
        true => handle g1_declared_total_matches_bytes(candidate) {
            true => handle g1_directory_is_readable(candidate) {
                true => handle __g1_bytes_get(candidate, 1008) == 1 {
                    true => handle __g1_bytes_get(candidate, 1032) == 69 {
                        true => handle __g1_bytes_get(candidate, 1036) == 3 {
                            true => handle __g1_bytes_get(candidate, 1040) == 114 {
                                true => handle __g1_bytes_get(candidate, 1052) == 20 {
                                    true => handle __g1_bytes_get(candidate, 1064) == 8 {
                                        true => __g1_bytes_get(candidate, 1080) == 1,
                                        false => false,
                                        _ => false,
                                    },
                                    false => false,
                                    _ => false,
                                },
                                false => false,
                                _ => false,
                            },
                            false => false,
                            _ => false,
                        },
                        false => false,
                        _ => false,
                    },
                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

fn g1_static_utf8_get_entry_vm_reference_digest() -> Bytes {
    __g1_bytes_from_array_move([56, 156, 17, 172, 16, 100, 93, 68, 112, 44, 215, 219, 4, 27, 204, 238, 249, 76, 29, 3, 112, 42, 244, 99, 66, 0, 197, 56, 234, 28, 68, 55])
}

pub fn g1_static_utf8_get_entry_matches_vm_reference() -> Bool {
    let candidate = g1_static_utf8_get_entry_candidate(__g1_bytes_from_array_move([120, 121, 122]));
    g1_bytes_equal(__g1_blake3(candidate), g1_static_utf8_get_entry_vm_reference_digest(), 0)
}
fn g1_unit_entry_directory(name: Bytes) -> Bytes {
    g1_append_field(
        g1_append_field(
            g1_append_field(
                g1_append_field(
                    g1_append_field(
                        g1_append_field(
                            g1_append_field(g1_header(0, 1, 1, 936), g1_directory_entry(1, 512, g1_usize_as_u64(__g1_int_wrapping_add<usize>(16, __g1_bytes_len(name))), 1, 0)),
                            g1_directory_entry(2, 536, 236, 19, 0),
                        ),
                        g1_directory_entry(3, 776, 8, 0, 0),
                    ),
                    g1_directory_entry(4, 784, 32, 1, 0),
                ),
                g1_directory_entry(5, 816, 0, 0, 24),
            ),
            g1_directory_entry(6, 816, 8, 0, 0),
        ),
        g1_unit_entry_directory_tail(),
    )
}

fn g1_unit_entry_directory_tail() -> Bytes {
    g1_append_field(
        g1_append_field(
            g1_append_field(
                g1_append_field(
                    g1_append_field(
                        g1_append_field(
                            g1_append_field(g1_directory_entry(7, 824, 8, 0, 0), g1_directory_entry(8, 832, 64, 1, 64)),
                            g1_directory_entry(9, 896, 8, 2, 4),
                        ),
                        g1_directory_entry(10, 904, 0, 0, 4),
                    ),
                    g1_directory_entry(11, 904, 24, 1, 24),
                ),
                g1_directory_entry(12, 928, 0, 0, 16),
            ),
            g1_directory_entry(13, 928, 0, 0, 16),
        ),
        g1_directory_entry(14, 928, 8, 0, 0),
    )
}


fn g1_unit_entry_name_table(name: Bytes) -> Bytes { g1_single_string_table(name) }

fn g1_unit_entry_name_slot(name: Bytes) -> Bytes {
    g1_append_field(g1_unit_entry_name_table(name), g1_unit_entry_name_padding(name))
}

fn g1_unit_entry_name_padding(name: Bytes) -> Bytes {
    g1_zero_bytes(g1_name_padding_length(__g1_bytes_len(name)))
}

fn g1_zero_bytes(count: usize) -> Bytes {
    handle count == 0 {
        true => __g1_bytes_from_array_move([]),
        false => __g1_bytes_concat(__g1_bytes_from_array_move([0]), g1_zero_bytes(__g1_int_wrapping_sub<usize>(count, 1))),
        _ => __g1_bytes_from_array_move([]),
    }
}

// Variable record sections begin on an eight-byte boundary.  The string
// table has a fixed sixteen-byte record prefix, so only the name payload's
// remainder determines the required canonical zero padding.
fn g1_name_padding_length(length: usize) -> usize {
    handle length < 8 {
        true => g1_name_padding_remainder(length),
        false => g1_name_padding_length(__g1_int_wrapping_sub<usize>(length, 8)),
        _ => 0,
    }
}

fn g1_name_padding_remainder(remainder: usize) -> usize {
    handle remainder == 0 { true => 0, false => g1_name_padding_one(remainder), _ => 0 }
}
fn g1_name_padding_one(remainder: usize) -> usize {
    handle remainder == 1 { true => 7, false => g1_name_padding_two(remainder), _ => 0 }
}
fn g1_name_padding_two(remainder: usize) -> usize {
    handle remainder == 2 { true => 6, false => g1_name_padding_three(remainder), _ => 0 }
}
fn g1_name_padding_three(remainder: usize) -> usize {
    handle remainder == 3 { true => 5, false => g1_name_padding_four(remainder), _ => 0 }
}
fn g1_name_padding_four(remainder: usize) -> usize {
    handle remainder == 4 { true => 4, false => g1_name_padding_five(remainder), _ => 0 }
}
fn g1_name_padding_five(remainder: usize) -> usize {
    handle remainder == 5 { true => 3, false => g1_name_padding_six(remainder), _ => 0 }
}
fn g1_name_padding_six(remainder: usize) -> usize {
    handle remainder == 6 { true => 2, false => 1, _ => 0 }
}

fn g1_unit_entry_signature_table() -> Bytes {
    g1_single_variable_record_section(
        0,
        0,
        g1_append_field(g1_append_field(u32_le_bytes(0), u32_le_bytes(0)), u32_le_bytes(0)),
    )
}

fn g1_unit_entry_function_table() -> Bytes {
    g1_append_field(
        g1_append_field(
            g1_append_field(
                g1_append_field(
                    g1_append_field(
                        g1_append_field(
                            g1_append_field(
                                g1_append_field(
                                    g1_append_field(
                                        g1_append_field(
                                            g1_append_field(g1_append_field(u32_le_bytes(0), u32_le_bytes(0)), u32_le_bytes(0)),
                                            u32_le_bytes(1),
                                        ),
                                        u32_le_bytes(0),
                                    ),
                                    u32_le_bytes(2),
                                ),
                                u32_le_bytes(1),
                            ),
                            u32_le_bytes(0),
                        ),
                        u32_le_bytes(1),
                    ),
                    u32_le_bytes(0),
                ),
                u32_le_bytes(0),
            ),
            u32_le_bytes(4294967295),
        ),
        g1_append_field(u64_le_bytes(0), u64_le_bytes(0)),
    )
}

fn g1_unit_entry_code() -> Bytes {
    g1_append_field(u32_le_bytes(4134), u32_le_bytes(4294967295))
}

fn g1_unit_entry_cleanup_table() -> Bytes {
    g1_append_field(
        g1_append_field(
            g1_append_field(u32_le_bytes(0), u32_le_bytes(0)),
            u32_le_bytes(1),
        ),
        g1_append_field(g1_append_field(u32_le_bytes(0), u32_le_bytes(0)), u32_le_bytes(0)),
    )
}

fn g1_i64_entry_directory() -> Bytes {
    g1_append_field(
        g1_concat4(
            g1_header(0, 1, 1, 1008), g1_directory_entry(1, 512, 20, 1, 0),
            g1_directory_entry(2, 536, 236, 19, 0), g1_directory_entry(3, 776, 28, 1, 0),
        ),
        g1_concat4(
            g1_directory_entry(4, 808, 32, 1, 0), g1_directory_entry(5, 840, 0, 0, 24),
            g1_directory_entry(6, 840, 8, 0, 0), g1_i64_entry_directory_tail(),
        ),
    )
}

fn g1_i64_entry_directory_tail() -> Bytes {
    g1_append_field(
        g1_concat4(
            g1_directory_entry(7, 848, 8, 0, 0), g1_directory_entry(8, 856, 64, 1, 64),
            g1_directory_entry(9, 920, 20, 5, 4), g1_directory_entry(10, 944, 4, 1, 4),
        ),
        g1_concat4(
            g1_directory_entry(11, 952, 48, 2, 24), g1_directory_entry(12, 1000, 0, 0, 16),
            g1_directory_entry(13, 1000, 0, 0, 16), g1_directory_entry(14, 1000, 8, 0, 0),
        ),
    )
}

fn g1_i64_entry_signature_table() -> Bytes {
    g1_single_variable_record_section(0, 0, g1_concat3(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(0)))
}

fn g1_i64_entry_function_table() -> Bytes {
    g1_concat4(
        g1_concat4(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(2)),
        g1_concat4(u32_le_bytes(0), u32_le_bytes(5), u32_le_bytes(2), u32_le_bytes(0)),
        g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4294967295)),
        g1_append_field(u64_le_bytes(0), u64_le_bytes(0)),
    )
}

fn g1_i64_entry_code() -> Bytes {
    // Const r1, constant[0]; Return Unit. Instruction words carry an operand
    // count in bits 12 through 19, followed by their fixed operands.
    g1_concat4(
        g1_append_field(u32_le_bytes(8193), u32_le_bytes(1)),
        g1_append_field(u32_le_bytes(0), u32_le_bytes(4134)),
        u32_le_bytes(4294967295),
        __g1_bytes_from_array_move([]),
    )
}

fn g1_i64_entry_cleanup_table() -> Bytes {
    // The return boundary owns the scalar loaded into r1.
    g1_append_field(
        g1_append_field(
            g1_concat4(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(1), u32_le_bytes(0)),
            g1_append_field(u32_le_bytes(0), u32_le_bytes(0)),
        ),
        g1_append_field(
            g1_concat4(u32_le_bytes(0), u32_le_bytes(1), u32_le_bytes(2), u32_le_bytes(0)),
            g1_append_field(u32_le_bytes(1), u32_le_bytes(0)),
        ),
    )
}

// The first scalar executable uses the common G1 constant envelope plus a
// register-backed return. It is intentionally separate from the unit seed
// until arbitrary MIR layout is encoded.
pub fn g1_i64_entry_candidate(value: i64) -> Bytes {
    g1_concat3(
        g1_concat8(
            g1_i64_entry_directory(), g1_unit_entry_name_table(__g1_bytes_from_array_move([109, 97, 105, 110])),
            g1_four_zero_padding_bytes(), g1_predefined_type_table(),
            g1_four_zero_padding_bytes(), g1_i64_constant_table(value),
            g1_four_zero_padding_bytes(), g1_i64_entry_signature_table(),
        ),
        g1_append_field(g1_append_field(g1_empty_variable_table(), g1_empty_variable_table()), g1_i64_entry_function_table()),
        g1_concat4(
            g1_i64_entry_code(), g1_four_zero_padding_bytes(),
            g1_append_field(u32_le_bytes(1), g1_four_zero_padding_bytes()),
            g1_append_field(g1_i64_entry_cleanup_table(), g1_empty_variable_table()),
        ),
    )
}

pub fn g1_i64_entry_candidate_has_expected_length() -> Bool { __g1_bytes_len(g1_i64_entry_candidate(42)) == 1008 }

// An executable G1 image must enter through a zero-argument Unit function.
// Scalar source declarations therefore become a private i64 callee behind
// that entry instead of pretending that the scalar function itself is an
// executable entrypoint.  Keeping both functions in one artifact is the
// first real call edge emitted by the source backend.
fn g1_i64_callable_directory() -> Bytes {
    g1_append_field(
        g1_concat4(
            g1_header(0, 1, 1, 1168), g1_directory_entry(1, 512, 20, 1, 0),
            g1_directory_entry(2, 536, 236, 19, 0), g1_directory_entry(3, 776, 28, 1, 0),
        ),
        g1_concat4(
            g1_directory_entry(4, 808, 56, 2, 0), g1_directory_entry(5, 864, 0, 0, 24),
            g1_directory_entry(6, 864, 8, 0, 0), g1_i64_callable_directory_tail(),
        ),
    )
}

fn g1_i64_callable_directory_tail() -> Bytes {
    g1_append_field(
        g1_concat4(
            g1_directory_entry(7, 872, 8, 0, 0), g1_directory_entry(8, 880, 128, 2, 64),
            g1_directory_entry(9, 1008, 48, 12, 4), g1_directory_entry(10, 1056, 4, 1, 4),
        ),
        g1_concat4(
            g1_directory_entry(11, 1064, 96, 4, 24), g1_directory_entry(12, 1160, 0, 0, 16),
            g1_directory_entry(13, 1160, 0, 0, 16), g1_directory_entry(14, 1160, 8, 0, 0),
        ),
    )
}

fn g1_i64_callable_signature_table() -> Bytes {
    let unit = g1_variable_record(0, 0, g1_concat3(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(0)));
    let scalar = g1_variable_record(0, 0, g1_concat3(u32_le_bytes(0), u32_le_bytes(10), u32_le_bytes(0)));
    g1_append_field(
        g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(20), u32_le_bytes(40)),
        g1_append_field(unit, scalar),
    )
}

fn g1_i64_callable_function_table() -> Bytes {
    g1_append_field(
        g1_concat4(
            g1_concat4(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(2)),
            g1_concat4(u32_le_bytes(0), u32_le_bytes(7), u32_le_bytes(2), u32_le_bytes(0)),
            g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4294967295)),
            g1_append_field(u64_le_bytes(0), u64_le_bytes(0)),
        ),
        g1_concat4(
            g1_concat4(u32_le_bytes(0), u32_le_bytes(1), u32_le_bytes(0), u32_le_bytes(2)),
            g1_concat4(u32_le_bytes(7), u32_le_bytes(5), u32_le_bytes(2), u32_le_bytes(2)),
            g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4294967295)),
            g1_append_field(u64_le_bytes(0), u64_le_bytes(0)),
        ),
    )
}

fn g1_i64_callable_code() -> Bytes {
    // Call function[1] into r1, then return Unit from the executable entry.
    // The callee loads constant[0] and returns its r1.
    g1_concat4(
        g1_concat4(u32_le_bytes(16418), u32_le_bytes(1), u32_le_bytes(1), u32_le_bytes(0)),
        g1_concat4(u32_le_bytes(0), u32_le_bytes(4134), u32_le_bytes(4294967295), u32_le_bytes(8193)),
        g1_append_field(u32_le_bytes(1), u32_le_bytes(0)),
        g1_append_field(u32_le_bytes(4134), u32_le_bytes(1)),
    )
}

fn g1_i64_callable_cleanup_table() -> Bytes {
    // Two contiguous plans per function cover every instruction boundary.
    g1_append_field(
        g1_i64_callable_cleanup_plan(0, 0, 1, 0, 0),
        g1_i64_callable_cleanup_plan(0, 1, 2, 0, 1),
    )
}

fn g1_i64_callable_cleanup_tail() -> Bytes {
    g1_append_field(
        g1_i64_callable_cleanup_plan(1, 0, 1, 0, 0),
        g1_i64_callable_cleanup_plan(1, 1, 2, 0, 1),
    )
}

fn g1_i64_callable_cleanup_plan(function: u32, first: u32, end: u32, operand_start: u32, operand_count: u32) -> Bytes {
    g1_concat3(
        g1_concat4(u32_le_bytes(function), u32_le_bytes(first), u32_le_bytes(end), u32_le_bytes(operand_start)),
        g1_append_field(u32_le_bytes(operand_count), u32_le_bytes(0)),
        __g1_bytes_from_array_move([]),
    )
}

pub fn g1_i64_callable_candidate(value: i64) -> Bytes {
    g1_concat3(
        g1_concat8(
            g1_i64_callable_directory(), g1_unit_entry_name_table(__g1_bytes_from_array_move([109, 97, 105, 110])),
            g1_four_zero_padding_bytes(), g1_predefined_type_table(),
            g1_four_zero_padding_bytes(), g1_i64_constant_table(value),
            g1_four_zero_padding_bytes(), g1_i64_callable_signature_table(),
        ),
        g1_append_field(g1_append_field(g1_empty_variable_table(), g1_empty_variable_table()), g1_i64_callable_function_table()),
        g1_concat4(
            g1_i64_callable_code(), g1_append_field(u32_le_bytes(1), g1_four_zero_padding_bytes()),
            g1_append_field(g1_i64_callable_cleanup_table(), g1_i64_callable_cleanup_tail()),
            g1_empty_variable_table(),
        ),
    )
}

pub fn g1_i64_callable_candidate_has_expected_length() -> Bool { __g1_bytes_len(g1_i64_callable_candidate(42)) == 1168 }

pub fn g1_i64_callable_candidate_passes_source_verification() -> Bool {
    verify_g1_i64_callable_candidate(g1_i64_callable_candidate(42), 42)
}

fn verify_g1_i64_callable_candidate(bytes: Bytes, value: i64) -> Bool {
    handle verify_g1_i64_callable_artifact(bytes) {
        true => g1_i64_entry_payload_matches(bytes, u64_le_bytes(__g1_int_convert_wrapping_to_u64<i64>(value))),
