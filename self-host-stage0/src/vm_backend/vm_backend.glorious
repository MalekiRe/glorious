                    false => false,
                    _ => false,
                },
                false => false,
                _ => false,
            },
            false => false,
            _ => false,
        },
        false => false,
        _ => false,
    }
}

// Publication stays behind a source-owned shape check; the conformance probe
// additionally sends this result through the independent Rust G1 verifier.
pub fn emit_g1_i64_callable(value: i64) -> ArtifactEmission {
    let candidate = g1_i64_callable_candidate(value);
    handle verify_g1_i64_callable_candidate(candidate, value) {
        true => ArtifactEmission::Artifact(candidate),
        false => ArtifactEmission::Rejected,
        _ => ArtifactEmission::Rejected,
    }
}

fn g1_i64_binary_constant_table(first: i64, second: i64) -> Bytes {
    let first_record = g1_variable_record(10, 0, u64_le_bytes(__g1_int_convert_wrapping_to_u64<i64>(first)));
    let second_record = g1_variable_record(10, 0, u64_le_bytes(__g1_int_convert_wrapping_to_u64<i64>(second)));
    g1_append_field(
        g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(16), u32_le_bytes(32)),
        g1_append_field(first_record, second_record),
    )
}

fn g1_i64_wire_less_or_equal(left: i64, right: i64) -> Bool {
    g1_i64_wire_less_or_equal_at(u64_le_bytes(__g1_int_convert_wrapping_to_u64<i64>(left)), u64_le_bytes(__g1_int_convert_wrapping_to_u64<i64>(right)), 0)
}

fn g1_i64_wire_less_or_equal_at(left: Bytes, right: Bytes, index: usize) -> Bool {
    handle index == 8 {
        true => true,
        false => {
            let left_byte = __g1_int_convert_wrapping_to_u32<u8>(__g1_bytes_get(left, index));
            let right_byte = __g1_int_convert_wrapping_to_u32<u8>(__g1_bytes_get(right, index));
            handle left_byte < right_byte {
                true => true,
                false => handle left_byte > right_byte {
                    true => false,
                    false => g1_i64_wire_less_or_equal_at(left, right, __g1_int_wrapping_add<usize>(index, 1)),
                    _ => false,
                },
                _ => false,
            }
        },
        _ => false,
    }
}

fn g1_i64_binary_directory() -> Bytes {
    g1_append_field(
        g1_concat4(g1_header(0, 1, 1, 1280), g1_directory_entry(1, 512, 20, 1, 0), g1_directory_entry(2, 536, 236, 19, 0), g1_directory_entry(3, 776, 48, 2, 0)),
        g1_concat4(g1_directory_entry(4, 824, 56, 2, 0), g1_directory_entry(5, 880, 0, 0, 24), g1_directory_entry(6, 880, 8, 0, 0), g1_i64_binary_directory_tail()),
    )
}

fn g1_i64_binary_directory_tail() -> Bytes {
    g1_append_field(
        g1_concat4(g1_directory_entry(7, 888, 8, 0, 0), g1_directory_entry(8, 896, 128, 2, 64), g1_directory_entry(9, 1024, 80, 20, 4), g1_directory_entry(10, 1104, 24, 6, 4)),
        g1_concat4(g1_directory_entry(11, 1128, 144, 6, 24), g1_directory_entry(12, 1272, 0, 0, 16), g1_directory_entry(13, 1272, 0, 0, 16), g1_directory_entry(14, 1272, 8, 0, 0)),
    )
}

fn g1_i64_binary_duplicate_directory() -> Bytes {
    g1_append_field(
        g1_concat4(g1_header(0, 1, 1, 1264), g1_directory_entry(1, 512, 20, 1, 0), g1_directory_entry(2, 536, 236, 19, 0), g1_directory_entry(3, 776, 28, 1, 0)),
        g1_concat4(g1_directory_entry(4, 808, 56, 2, 0), g1_directory_entry(5, 864, 0, 0, 24), g1_directory_entry(6, 864, 8, 0, 0), g1_i64_binary_duplicate_directory_tail()),
    )
}

fn g1_i64_binary_duplicate_directory_tail() -> Bytes {
    g1_append_field(
        g1_concat4(g1_directory_entry(7, 872, 8, 0, 0), g1_directory_entry(8, 880, 128, 2, 64), g1_directory_entry(9, 1008, 80, 20, 4), g1_directory_entry(10, 1088, 24, 6, 4)),
        g1_concat4(g1_directory_entry(11, 1112, 144, 6, 24), g1_directory_entry(12, 1256, 0, 0, 16), g1_directory_entry(13, 1256, 0, 0, 16), g1_directory_entry(14, 1256, 8, 0, 0)),
    )
}

// A binary source function is represented as a genuine two-argument callee:
// the Unit entry materializes the requested invocation values, passes r1/r2,
// and the callee applies the primitive to its parameter registers. Keeping
// that call boundary in the artifact is required for later general function
// lowering; it is not a folded-expression shortcut.
fn g1_i64_binary_call_directory() -> Bytes {
    g1_append_field(
        g1_concat4(g1_header(0, 1, 1, 1288), g1_directory_entry(1, 512, 20, 1, 0), g1_directory_entry(2, 536, 236, 19, 0), g1_directory_entry(3, 776, 48, 2, 0)),
        g1_concat4(g1_directory_entry(4, 824, 64, 2, 0), g1_directory_entry(5, 888, 0, 0, 24), g1_directory_entry(6, 888, 8, 0, 0), g1_i64_binary_call_directory_tail()),
    )
}

fn g1_i64_binary_call_directory_tail() -> Bytes {
    g1_append_field(
        g1_concat4(g1_directory_entry(7, 896, 8, 0, 0), g1_directory_entry(8, 904, 128, 2, 64), g1_directory_entry(9, 1032, 80, 20, 4), g1_directory_entry(10, 1112, 24, 6, 4)),
        g1_concat4(g1_directory_entry(11, 1136, 144, 6, 24), g1_directory_entry(12, 1280, 0, 0, 16), g1_directory_entry(13, 1280, 0, 0, 16), g1_directory_entry(14, 1280, 8, 0, 0)),
    )
}

fn g1_i64_binary_call_signature_table() -> Bytes {
    let unit = g1_variable_record(0, 0, g1_concat3(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(0)));
    let binary = g1_variable_record(0, 0, g1_append_field(g1_concat4(u32_le_bytes(2), u32_le_bytes(10), u32_le_bytes(0), u32_le_bytes(10)), u32_le_bytes(10)));
    g1_append_field(g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(20), u32_le_bytes(48)), g1_append_field(unit, binary))
}

fn g1_i64_binary_call_function_table() -> Bytes {
    g1_append_field(
        g1_concat4(g1_concat4(u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4)), g1_concat4(u32_le_bytes(0), u32_le_bytes(13), u32_le_bytes(4), u32_le_bytes(0)), g1_concat4(u32_le_bytes(4), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4294967295)), g1_append_field(u64_le_bytes(0), u64_le_bytes(0))),
        g1_concat4(g1_concat4(u32_le_bytes(0), u32_le_bytes(1), u32_le_bytes(0), u32_le_bytes(4)), g1_concat4(u32_le_bytes(13), u32_le_bytes(7), u32_le_bytes(2), u32_le_bytes(4)), g1_concat4(u32_le_bytes(2), u32_le_bytes(0), u32_le_bytes(0), u32_le_bytes(4294967295)), g1_append_field(u64_le_bytes(0), u64_le_bytes(0))),
    )
}

fn g1_i64_binary_call_code(operation: G1I64Arithmetic, left_constant: u32, right_constant: u32) -> Bytes {
    g1_append_field(
        g1_concat4(
            g1_concat4(u32_le_bytes(8193), u32_le_bytes(1), u32_le_bytes(left_constant), u32_le_bytes(8193)),
            g1_concat4(u32_le_bytes(2), u32_le_bytes(right_constant), u32_le_bytes(16418), u32_le_bytes(3)),
            g1_concat4(u32_le_bytes(1), u32_le_bytes(0), u32_le_bytes(2), u32_le_bytes(4134)),
            g1_concat4(u32_le_bytes(4294967295), u32_le_bytes(16453), u32_le_bytes(3), u32_le_bytes(g1_i64_binary_primitive(operation))),
        ),
        g1_concat4(u32_le_bytes(0), u32_le_bytes(2), u32_le_bytes(4134), u32_le_bytes(3)),
    )
}

fn g1_i64_binary_call_cleanup_table() -> Bytes {
    g1_concat3(
        g1_append_field(g1_i64_binary_cleanup_plan(0, 0, 1, 2, 0), g1_i64_binary_cleanup_plan(0, 1, 2, 2, 1)),
        g1_append_field(g1_i64_binary_cleanup_plan(0, 2, 3, 3, 2), g1_i64_binary_cleanup_plan(0, 3, 4, 5, 1)),
        g1_append_field(g1_i64_binary_cleanup_plan(1, 0, 1, 3, 2), g1_i64_binary_cleanup_plan(1, 1, 2, 5, 1)),
    )
}

pub fn g1_i64_binary_call_candidate(operation: G1I64Arithmetic, left: i64, right: i64) -> Bytes {
    handle g1_i64_wire_less_or_equal(left, right) {
        true => g1_i64_binary_call_candidate_ordered(operation, left, right, 0, 1),
        false => g1_i64_binary_call_candidate_ordered(operation, right, left, 1, 0),
        _ => __g1_bytes_from_array_move([]),
    }
}

pub fn g1_i64_binary_call_candidate_passes_source_verification() -> Bool {
    verify_g1_i64_binary_call_candidate(g1_i64_binary_call_candidate(G1I64Arithmetic::Add, 20, 22), G1I64Arithmetic::Add, 20, 22)
}

fn verify_g1_i64_binary_call_candidate(bytes: Bytes, operation: G1I64Arithmetic, left: i64, right: i64) -> Bool {
    handle g1_candidate_has_length_and_directory(bytes, 1288) {
        true => handle g1_magic_bytes_match(bytes) {
