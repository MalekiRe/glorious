// M27 bootstrap primitive authority. Full package/module declaration identity,
// ABI signatures, host imports, canonicalization, and schema tags extend this
// source-owned admission table.
use compiler_support::branch_bool;
use compiler_support::text_eq;
pub enum Primitive {
    BranchBool,
    Blake3,
    TextAsBytes,
    TextEq,
    BytesLen,
    BytesGet,
    BytesSlice,
    IntWrappingAdd,
    IntWrappingSub,
    IntWrappingMul,
    IntCheckedDiv,
    ArrayEmpty,
    ArrayLen,
    ArrayGetMove,
    ArrayPopMove,
    Unknown,
}

// Host effects are a second closed authority family.  They are not primitive
// leaves: an admitted host capability still needs an exact runtime-host
// symbol binding in the emitted artifact.
pub enum HostCapability { ProcessArgs, FileRead, FileWriteAtomic, DiagnosticWrite, Unknown }

// Host imports have their own closed ABI vocabulary.  Recognizing a host name
// is deliberately insufficient: a compiler artifact may bind it only after
// matching the declaration shape expected by the launcher.
pub enum HostSignature {
    ProcessArgsToTextArray,
    TextToBytes,
    TextBytesToUnit,
    TextToUnit,
}

pub enum HostDeclarationValidation { Value(HostCapability), UnknownSelector, PackageMismatch, SignatureMismatch }

// These bootstrap signature classes encode the trusted leaf boundary. They
// are intentionally coarse while Stage0's full generic declaration identity
// is ported, but they prevent a same-named declaration with a different ABI
// from acquiring primitive authority.
pub enum PrimitiveSignature {
    BranchBool,
    BytesToBytes,
    TextToBytes,
    TextTextToBool,
    BytesToUsize,
    BytesUsizeToU8,
    BytesUsizeUsizeToBytes,
    IntBinary,
    IntCheckedDiv,
    ArrayEmpty,
    ArrayLen,
    ArrayGetMove,
    ArrayPopMove,
}

pub enum DeclarationValidation { Value(Primitive), UnknownSelector, PackageMismatch, SignatureMismatch }

// This is the bootstrap authority table. Each admitted entry is explicitly
// bound by the runtime manifest; unknown spellings cannot acquire host power.
pub fn admitted(primitive: Primitive) -> Bool {
    handle primitive {
        Primitive::BranchBool => true,
        Primitive::Blake3 => true,
        Primitive::TextAsBytes => true,
        Primitive::TextEq => true,
        Primitive::BytesLen => true,
        Primitive::BytesGet => true,
        Primitive::BytesSlice => true,
        Primitive::IntWrappingAdd => true,
        Primitive::IntWrappingSub => true,
        Primitive::IntWrappingMul => true,
        Primitive::IntCheckedDiv => true,
        Primitive::ArrayEmpty => true,
        Primitive::ArrayLen => true,
        Primitive::ArrayGetMove => true,
        Primitive::ArrayPopMove => true,
        Primitive::Unknown => false,
        _ => false,
    }
}

// Selector resolution is deliberately exact and closed.  A caller must first
// obtain a role from this table, then pass the role through `admitted`; source
// spelling alone never carries runtime authority.
pub fn select(name: Text) -> Primitive {
    branch_bool(text_eq(name, "branch-bool"), () -> Primitive { Primitive::BranchBool }, () -> Primitive { select_after_branch(name) })
}

fn select_after_branch(name: Text) -> Primitive {
    branch_bool(text_eq(name, "blake3"), () -> Primitive { Primitive::Blake3 }, () -> Primitive { select_after_blake3(name) })
}

fn select_after_blake3(name: Text) -> Primitive {
    branch_bool(text_eq(name, "text-as-bytes"), () -> Primitive { Primitive::TextAsBytes }, () -> Primitive { select_after_text_bytes(name) })
}

fn select_after_text_bytes(name: Text) -> Primitive {
    branch_bool(text_eq(name, "text-eq"), () -> Primitive { Primitive::TextEq }, () -> Primitive { select_after_text_eq(name) })
}

fn select_after_text_eq(name: Text) -> Primitive {
    branch_bool(text_eq(name, "bytes-len"), () -> Primitive { Primitive::BytesLen }, () -> Primitive { select_after_bytes_len(name) })
}

fn select_after_bytes_len(name: Text) -> Primitive {
    branch_bool(text_eq(name, "bytes-get"), () -> Primitive { Primitive::BytesGet }, () -> Primitive { select_after_bytes_get(name) })
}

fn select_after_bytes_get(name: Text) -> Primitive {
    branch_bool(text_eq(name, "bytes-slice"), () -> Primitive { Primitive::BytesSlice }, () -> Primitive { select_after_bytes_slice(name) })
}

fn select_after_bytes_slice(name: Text) -> Primitive {
    branch_bool(text_eq(name, "int-wrapping-add"), () -> Primitive { Primitive::IntWrappingAdd }, () -> Primitive { select_after_wrapping_add(name) })
}

fn select_after_wrapping_add(name: Text) -> Primitive {
    branch_bool(text_eq(name, "int-wrapping-sub"), () -> Primitive { Primitive::IntWrappingSub }, () -> Primitive { select_after_wrapping_sub(name) })
}

fn select_after_wrapping_sub(name: Text) -> Primitive {
    branch_bool(text_eq(name, "int-wrapping-mul"), () -> Primitive { Primitive::IntWrappingMul }, () -> Primitive { select_after_wrapping_mul(name) })
}

fn select_after_wrapping_mul(name: Text) -> Primitive {
    branch_bool(text_eq(name, "int-checked-div"), () -> Primitive { Primitive::IntCheckedDiv }, () -> Primitive { select_after_checked_div(name) })
}

fn select_after_checked_div(name: Text) -> Primitive {
    branch_bool(text_eq(name, "array-empty"), () -> Primitive { Primitive::ArrayEmpty }, () -> Primitive { select_after_array_empty(name) })
}

fn select_after_array_empty(name: Text) -> Primitive {
    branch_bool(text_eq(name, "array-len"), () -> Primitive { Primitive::ArrayLen }, () -> Primitive { select_after_array_len(name) })
}

fn select_after_array_len(name: Text) -> Primitive {
    branch_bool(text_eq(name, "array-get-move"), () -> Primitive { Primitive::ArrayGetMove }, () -> Primitive { select_after_array_get_move(name) })
}

fn select_after_array_get_move(name: Text) -> Primitive {
    branch_bool(text_eq(name, "array-pop-move"), () -> Primitive { Primitive::ArrayPopMove }, () -> Primitive { Primitive::Unknown })
}

pub fn admitted_name(name: Text) -> Bool { admitted(select(name)) }

pub fn admitted_host(capability: HostCapability) -> Bool {
    handle capability {
        HostCapability::ProcessArgs => true,
        HostCapability::FileRead => true,
        HostCapability::FileWriteAtomic => true,
        HostCapability::DiagnosticWrite => true,
        HostCapability::Unknown => false,
        _ => false,
    }
}

pub fn select_host(name: Text) -> HostCapability {
    branch_bool(text_eq(name, "process_args"), () -> HostCapability { HostCapability::ProcessArgs }, () -> HostCapability { select_host_after_process_args(name) })
}

fn select_host_after_process_args(name: Text) -> HostCapability {
    branch_bool(text_eq(name, "file_read"), () -> HostCapability { HostCapability::FileRead }, () -> HostCapability { select_host_after_file_read(name) })
}

fn select_host_after_file_read(name: Text) -> HostCapability {
    branch_bool(text_eq(name, "file_write_atomic"), () -> HostCapability { HostCapability::FileWriteAtomic }, () -> HostCapability { select_host_after_atomic_write(name) })
}

fn select_host_after_atomic_write(name: Text) -> HostCapability {
    branch_bool(text_eq(name, "diagnostic"), () -> HostCapability { HostCapability::DiagnosticWrite }, () -> HostCapability { HostCapability::Unknown })
}

pub fn admitted_host_name(name: Text) -> Bool { admitted_host(select_host(name)) }

pub fn validate_host_declaration(name: Text, signature: HostSignature) -> HostDeclarationValidation {
    handle (select_host(name), signature) {
        (HostCapability::ProcessArgs, HostSignature::ProcessArgsToTextArray) => HostDeclarationValidation::Value(HostCapability::ProcessArgs),
        (HostCapability::FileRead, HostSignature::TextToBytes) => HostDeclarationValidation::Value(HostCapability::FileRead),
        (HostCapability::FileWriteAtomic, HostSignature::TextBytesToUnit) => HostDeclarationValidation::Value(HostCapability::FileWriteAtomic),
        (HostCapability::DiagnosticWrite, HostSignature::TextToUnit) => HostDeclarationValidation::Value(HostCapability::DiagnosticWrite),
        (HostCapability::Unknown, _) => HostDeclarationValidation::UnknownSelector,
        _ => HostDeclarationValidation::SignatureMismatch,
    }
}

// Just as primitive authority is package-bound, an artifact must name the
// runtime support package before it can acquire a host capability.
pub fn validate_bound_host_declaration(package: Text, name: Text, signature: HostSignature) -> HostDeclarationValidation {
    branch_bool(
        text_eq(package, "compiler-support@0.1.0"),
        () -> HostDeclarationValidation { validate_host_declaration(name, signature) },
        () -> HostDeclarationValidation { HostDeclarationValidation::PackageMismatch },
    )
}

// Name resolution alone is not authority. The declared bootstrap shape must
// match the selected primitive role before a runtime import can be bound.
pub fn validate_declaration(name: Text, signature: PrimitiveSignature) -> DeclarationValidation {
    handle (select(name), signature) {
        (Primitive::BranchBool, PrimitiveSignature::BranchBool) => DeclarationValidation::Value(Primitive::BranchBool),
        (Primitive::Blake3, PrimitiveSignature::BytesToBytes) => DeclarationValidation::Value(Primitive::Blake3),
        (Primitive::TextAsBytes, PrimitiveSignature::TextToBytes) => DeclarationValidation::Value(Primitive::TextAsBytes),
        (Primitive::TextEq, PrimitiveSignature::TextTextToBool) => DeclarationValidation::Value(Primitive::TextEq),
        (Primitive::BytesLen, PrimitiveSignature::BytesToUsize) => DeclarationValidation::Value(Primitive::BytesLen),
        (Primitive::BytesGet, PrimitiveSignature::BytesUsizeToU8) => DeclarationValidation::Value(Primitive::BytesGet),
        (Primitive::BytesSlice, PrimitiveSignature::BytesUsizeUsizeToBytes) => DeclarationValidation::Value(Primitive::BytesSlice),
        (Primitive::IntWrappingAdd, PrimitiveSignature::IntBinary) => DeclarationValidation::Value(Primitive::IntWrappingAdd),
        (Primitive::IntWrappingSub, PrimitiveSignature::IntBinary) => DeclarationValidation::Value(Primitive::IntWrappingSub),
        (Primitive::IntWrappingMul, PrimitiveSignature::IntBinary) => DeclarationValidation::Value(Primitive::IntWrappingMul),
        (Primitive::IntCheckedDiv, PrimitiveSignature::IntCheckedDiv) => DeclarationValidation::Value(Primitive::IntCheckedDiv),
        (Primitive::ArrayEmpty, PrimitiveSignature::ArrayEmpty) => DeclarationValidation::Value(Primitive::ArrayEmpty),
        (Primitive::ArrayLen, PrimitiveSignature::ArrayLen) => DeclarationValidation::Value(Primitive::ArrayLen),
        (Primitive::ArrayGetMove, PrimitiveSignature::ArrayGetMove) => DeclarationValidation::Value(Primitive::ArrayGetMove),
        (Primitive::ArrayPopMove, PrimitiveSignature::ArrayPopMove) => DeclarationValidation::Value(Primitive::ArrayPopMove),
        (Primitive::Unknown, _) => DeclarationValidation::UnknownSelector,
        _ => DeclarationValidation::SignatureMismatch,
    }
}

// Primitive authority belongs to the runtime package, not merely to a public
// spelling.  This keeps an identically named declaration in a user package
// from acquiring a host import before package identities are fully interned.
pub fn validate_bound_declaration(package: Text, name: Text, signature: PrimitiveSignature) -> DeclarationValidation {
    branch_bool(
        text_eq(package, "compiler-support@0.1.0"),
        () -> DeclarationValidation { validate_declaration(name, signature) },
        () -> DeclarationValidation { DeclarationValidation::PackageMismatch },
    )
}
