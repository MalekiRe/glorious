// M19 bootstrap body typing for scalar literal expressions. Full lexical
// scopes, calls, handlers, labels, and ownership facts extend this boundary.
use types::Type;
use signature::Callable;
use signature::Arguments;
use signature::accepts_call;
use compiler_support::branch_bool;
use pattern::Pattern;
use pattern::Value;
use pattern::matches;
use scanner::TokenKind;
use scanner::TokenStart;
use scanner::first_token;
use scanner::next_token;
use scanner::token_equals;
use scanner::token_kind;
use scanner::token_matches;
use scanner::token_start;
use scanner::SignedI64LiteralAdmission;
use scanner::signed_i64_literal_at;
use scanner::U32LiteralAdmission;
use scanner::u32_literal_at;
use scanner::ByteLiteralAdmission;
use scanner::string_literal_at;
use scanner::byte_string_literal_at;
use placeflow::PlaceState;
use placeflow::ClosureCaptureMode;
use placeflow::ClosureCaptureAdmission;
use placeflow::capture_for_closure;
use compiler_support::__g1_array_pop_move;
use compiler_support::__g1_bytes_len;
use compiler_support::__g1_bytes_slice;

pub enum Arithmetic { Add, Subtract, Multiply, Divide, Remainder }
pub enum Comparison { Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual }

pub enum Expression {
    Unit,
    Bool(Bool),
    BoolNot(Bool),
    ParameterBoolNot(Bool),
    I64(i64),
    ParameterI64(i64),
    I64Arithmetic(Arithmetic, i64, i64),
    // A source-addressable scalar place initialized and then replaced. The
    // complete MIR form grows explicit StorageLive/Store/DestroyIf actions;
    // this value keeps both writes visible through the current terminal path.
    I64Assignment(i64, i64),
    ParameterI64Arithmetic(Arithmetic, i64, i64),
    I64Comparison(Comparison, i64, i64),
    I64Select(Bool, i64, i64),
    ParameterI64Select(Bool, i64, i64),
    U8(u8),
    U8Comparison(Comparison, u8, u8),
    U32(u32),
    ParameterU32(u32),
    U32Arithmetic(Arithmetic, u32, u32),
    ParameterU32Arithmetic(Arithmetic, u32, u32),
    U64(u64),
    U64Comparison(Comparison, u64, u64),
    Usize(usize),
    UsizeArithmetic(Arithmetic, usize, usize),
    UsizeComparison(Comparison, usize, usize),
    // A quoted literal is lowered to the sealed compiler backing handle, not
    // to a public Str/Slice representation.  Std owns those wrappers.
    StaticData(types::StaticData),
    Call1(Callable, Type),
    Call2(Callable, Type, Type),
    ClosureCapture(PlaceState, ClosureCaptureMode, Type),
    PatternTest(Pattern, Value),
}

pub enum BodyKind { Literal, StaticData, Parameter, Boolean, ParameterBoolean, Arithmetic, Assignment, ParameterArithmetic, Comparison, Conditional, ParameterConditional, Call, ClosureCapture, PatternTest }
pub enum BodyAdmission { Value(BodyKind), TypeError }
// A reusable, source-owned declaration parser for the first scalar function
// family.  Service used to duplicate this state machine for every scalar
// width.  Keeping the grammatical shape here makes new scalar lowerings a
// type-directed choice rather than another handwritten parser.
pub enum ScalarBinaryAdmission { Value(Arithmetic), Rejected }
// A declaration-level binary body has already established its two binder
// identities.  Pair that parser proof with the invocation values once, so
// Core receives the parameter expression rather than Service rebuilding it
// from an operator side channel.
pub enum I64ParameterBinaryAdmission { Value(Expression), Rejected }
// A complete free scalar expression is useful to both execution and artifact
// emission. It keeps the signed scanner values and selected operator in one
// Body node before either downstream consumer sees the expression.
pub enum I64LiteralArithmeticAdmission { Value(Expression), Rejected }
pub enum I64LiteralComparisonAdmission { Value(Expression), Rejected }
pub enum U32LiteralArithmeticAdmission { Value(Expression), Rejected }
pub enum StaticLiteralAdmission { Value(Expression), Rejected }
pub enum MoveCaptureClosureSyntax { Captures(i64), NotMoveClosure, Rejected }
// A compact closure begins with a block delimiter, so its first two tokens
// decide whether it owns the closure grammar or remains an ordinary block.
// The value is the arity retained by the source AST boundary.
pub enum CompactClosureSyntax { Parameters(i64), NotCompactClosure, Rejected }
// Typed closures are selected by a balanced parameter list followed by `->`.
// Their type payload belongs to the header/type parser, but Body must retain
// this syntactic choice before a parenthesized value is lowered as grouping.
pub enum TypedClosureSyntax { Parameters(i64), NotTypedClosure, Rejected }
// `@name` is a first-class label value; adding `:` creates a label binder,
// while adding `(` transfers to an already active label.
pub enum LabelSyntax { Binder, Transfer, Value, NotLabel, Rejected }
// A demand-driven structural slice of BodySyntax. It deliberately records
// only container shape and element count: expression allocation, fixity, and
// type elaboration stay in later parser/Core work just as they do in stage0.
// `Group` is distinct from a one-element tuple, whose comma is source-significant.
pub enum DelimitedExpressionSyntax { Tuple(i64), Group, Array(i64), Block(i64), NotDelimitedExpression, Rejected }
// Body preserves source-order infix chains. Fixity resolves this form later;
// choosing precedence while scanning would make module-declared operators
// impossible to elaborate faithfully.
pub enum FlatOperatorChainSyntax { Operators(i64), NotOperatorChain, Rejected }
// Prefix shape is retained independently from ownership/type interpretation.
// `move` is the ordinary expression-level transfer; a capture list followed
// by a block is separately recognized as a move-capture closure.
pub enum PrefixExpressionSyntax { Move, SharedBorrow, UniqueBorrow, Deref, Operator, NotPrefix, Rejected }
// One prioritized entrypoint for the currently ported expression grammar.
// Its result is deliberately a syntax category, not an elaborated type or
// value. The eventual BodySyntax arena will allocate the corresponding node
// from this decision and retain token spans/children.
pub enum SourceExpressionSyntax { Atom, Delimited, Prefix, Postfix, PatternTest, FlatOperatorChain, CompactClosure, TypedClosure, MoveCaptureClosure, Label, LetAssignment, Rejected }
// Pattern spelling remains structural until Core resolves nominal paths and
// assigns binding environments. This covers the fixed-shape syntax families
// that do not require namespace lookup.
pub enum SourcePatternSyntax { Wildcard, Binding, Literal, Tuple(i64), Array(i64), NotPattern, Rejected }
pub enum PatternBindingValidation { Valid, DuplicateBinding, Rejected }
// Direct calls and fields are parser structure only. Namespace and layout
// resolution remain Core responsibilities, so positional `.0` and named
// `.field` travel through one syntax category.
pub enum PostfixExpressionSyntax { Value(i64, i64), NotPostfix, Rejected }
pub enum StructuralIsSyntax { Value, NotIs, Rejected }
enum DelimitedMode { Tuple, Array, Block }
// A narrow value-carrying label form is sufficient to connect compact label
// syntax to the existing scalar Body/Core/MIR route while the complete body
// arena and arbitrary label result elaboration are ported.
pub enum LabelI64TransferAdmission { Value(i64, TokenStart), NotLabel, Rejected }
// The first executable mutable-place slice retains source binder identity for
// `let value = initial; value = replacement; value` before full general
// place/MIR statement lowering lands.
pub enum LetI64AssignmentAdmission { Value(i64, i64, TokenStart), NotLet, Rejected }
// Keep the parser-owned expression node paired with the final lexical read.
// The enclosing declaration parser needs that token to check its closing
// delimiter, while Core/MIR must receive the Body node itself rather than
// having Service reconstruct one from extracted scalar payloads.
pub enum LetI64ExpressionAdmission { Value(Expression, TokenStart), NotLet, Rejected }
enum MoveCaptureNames { Empty, Node(TokenStart, Bool, Array<MoveCaptureNames>) }
enum MoveCaptureNameInsert { Added(MoveCaptureNames), Duplicate }
enum PatternBindingNames { Empty, Node(TokenStart, Bool, Array<PatternBindingNames>) }
enum PatternBindingInsert { Added(PatternBindingNames), Duplicate }
enum PostfixBase { Next(TokenStart), Rejected, NotBase }
enum CallArguments { Value(i64, TokenStart), Rejected }

pub fn prefix_expression_syntax(input: Bytes) -> PrefixExpressionSyntax {
    prefix_expression_start(input, first_token(input))
}

fn prefix_expression_start(input: Bytes, token: TokenStart) -> PrefixExpressionSyntax {
    handle token_matches(input, token, "move") {
        true => prefix_expression_value(input, next_token(input, token), PrefixExpressionSyntax::Move),
        false => handle token_matches(input, token, "&") {
            true => prefix_expression_borrow(input, next_token(input, token)),
            false => handle token_matches(input, token, "*") {
                true => prefix_expression_value(input, next_token(input, token), PrefixExpressionSyntax::Deref),
                false => prefix_expression_operator(input, token),
                _ => PrefixExpressionSyntax::Rejected,
            },
            _ => PrefixExpressionSyntax::Rejected,
        },
        _ => PrefixExpressionSyntax::Rejected,
    }
}

fn prefix_expression_borrow(input: Bytes, token: TokenStart) -> PrefixExpressionSyntax {
    handle token_matches(input, token, "mut") {
        true => prefix_expression_value(input, next_token(input, token), PrefixExpressionSyntax::UniqueBorrow),
        false => prefix_expression_value(input, token, PrefixExpressionSyntax::SharedBorrow),
        _ => PrefixExpressionSyntax::Rejected,
    }
}

fn prefix_expression_operator(input: Bytes, token: TokenStart) -> PrefixExpressionSyntax {
    handle token_kind(token) {
        TokenKind::Operator => prefix_expression_value(input, next_token(input, token), PrefixExpressionSyntax::Operator),
        _ => PrefixExpressionSyntax::NotPrefix,
    }
}

fn prefix_expression_value(input: Bytes, token: TokenStart, syntax: PrefixExpressionSyntax) -> PrefixExpressionSyntax {
    handle token_matches(input, token, "(") {
        true => prefix_expression_after_nested(input, skip_nested_delimiter(input, token), syntax),
        false => handle token_matches(input, token, "[") {
            true => prefix_expression_after_nested(input, skip_nested_delimiter(input, token), syntax),
            false => handle token_matches(input, token, "{") {
                true => prefix_expression_after_nested(input, skip_nested_delimiter(input, token), syntax),
                false => prefix_expression_scalar_value(input, token, syntax),
                _ => PrefixExpressionSyntax::Rejected,
            },
            _ => PrefixExpressionSyntax::Rejected,
        },
        _ => PrefixExpressionSyntax::Rejected,
    }
}

fn prefix_expression_after_nested(input: Bytes, nested: DelimitedSkip, syntax: PrefixExpressionSyntax) -> PrefixExpressionSyntax {
    handle nested {
        DelimitedSkip::Close(close) => prefix_expression_end(input, next_token(input, close), syntax),
        DelimitedSkip::Rejected => PrefixExpressionSyntax::Rejected,
        _ => PrefixExpressionSyntax::Rejected,
    }
}

fn prefix_expression_scalar_value(input: Bytes, token: TokenStart, syntax: PrefixExpressionSyntax) -> PrefixExpressionSyntax {
    handle token_kind(token) {
        TokenKind::Identifier => prefix_expression_end(input, next_token(input, token), syntax),
        TokenKind::Integer => prefix_expression_end(input, next_token(input, token), syntax),
        TokenKind::Float => prefix_expression_end(input, next_token(input, token), syntax),
        TokenKind::String => prefix_expression_end(input, next_token(input, token), syntax),
        TokenKind::Character => prefix_expression_end(input, next_token(input, token), syntax),
        _ => PrefixExpressionSyntax::Rejected,
    }
}

fn prefix_expression_end(input: Bytes, token: TokenStart, syntax: PrefixExpressionSyntax) -> PrefixExpressionSyntax {
    handle token_kind(token) {
        TokenKind::End => syntax,
        _ => PrefixExpressionSyntax::Rejected,
    }
}

// Preserve the source parser's contextual ordering: a leading `move` may be
// a capture closure, `{` may be a compact closure, and `(` may be a typed
// closure before any of those delimiters are treated as ordinary expressions.
pub fn source_expression_syntax(input: Bytes) -> SourceExpressionSyntax {
    source_expression_start(input, first_token(input))
}

fn source_expression_start(input: Bytes, token: TokenStart) -> SourceExpressionSyntax {
    handle token_matches(input, token, "move") {
        true => source_expression_move(input),
        false => handle token_matches(input, token, "{") {
            true => source_expression_compact_or_delimited(input),
            false => handle token_matches(input, token, "(") {
                true => source_expression_typed_or_delimited(input),
                false => handle token_matches(input, token, "[") {
                    true => source_expression_delimited(input),
                    false => handle token_matches(input, token, "@") {
                        true => source_expression_label(input),
                        false => handle token_matches(input, token, "let") {
                            true => source_expression_let(input, token),
                            false => source_expression_prefix_or_chain(input),
                            _ => SourceExpressionSyntax::Rejected,
                        },
                        _ => SourceExpressionSyntax::Rejected,
                    },
                    _ => SourceExpressionSyntax::Rejected,
                },
                _ => SourceExpressionSyntax::Rejected,
            },
            _ => SourceExpressionSyntax::Rejected,
        },
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_move(input: Bytes) -> SourceExpressionSyntax {
    handle move_capture_closure_syntax(input) {
        MoveCaptureClosureSyntax::Captures(_) => SourceExpressionSyntax::MoveCaptureClosure,
        MoveCaptureClosureSyntax::NotMoveClosure => source_expression_prefix_or_chain(input),
        MoveCaptureClosureSyntax::Rejected => SourceExpressionSyntax::Rejected,
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_compact_or_delimited(input: Bytes) -> SourceExpressionSyntax {
    handle compact_closure_syntax(input) {
        CompactClosureSyntax::Parameters(_) => SourceExpressionSyntax::CompactClosure,
        CompactClosureSyntax::NotCompactClosure => source_expression_delimited(input),
        CompactClosureSyntax::Rejected => SourceExpressionSyntax::Rejected,
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_typed_or_delimited(input: Bytes) -> SourceExpressionSyntax {
    handle typed_closure_syntax(input) {
        TypedClosureSyntax::Parameters(_) => SourceExpressionSyntax::TypedClosure,
        TypedClosureSyntax::NotTypedClosure => source_expression_delimited(input),
        TypedClosureSyntax::Rejected => SourceExpressionSyntax::Rejected,
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_label(input: Bytes) -> SourceExpressionSyntax {
    handle label_syntax(input) {
        LabelSyntax::Binder => SourceExpressionSyntax::Label,
        LabelSyntax::Transfer => SourceExpressionSyntax::Label,
        LabelSyntax::Value => SourceExpressionSyntax::Label,
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_let(input: Bytes, token: TokenStart) -> SourceExpressionSyntax {
    handle lower_let_i64_assignment_at(input, token) {
        LetI64ExpressionAdmission::Value(_, _) => SourceExpressionSyntax::LetAssignment,
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_delimited(input: Bytes) -> SourceExpressionSyntax {
    handle delimited_expression_syntax(input) {
        DelimitedExpressionSyntax::Tuple(_) => SourceExpressionSyntax::Delimited,
        DelimitedExpressionSyntax::Group => SourceExpressionSyntax::Delimited,
        DelimitedExpressionSyntax::Array(_) => SourceExpressionSyntax::Delimited,
        DelimitedExpressionSyntax::Block(_) => SourceExpressionSyntax::Delimited,
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_prefix_or_chain(input: Bytes) -> SourceExpressionSyntax {
    handle prefix_expression_syntax(input) {
        PrefixExpressionSyntax::Move => SourceExpressionSyntax::Prefix,
        PrefixExpressionSyntax::SharedBorrow => SourceExpressionSyntax::Prefix,
        PrefixExpressionSyntax::UniqueBorrow => SourceExpressionSyntax::Prefix,
        PrefixExpressionSyntax::Deref => SourceExpressionSyntax::Prefix,
        PrefixExpressionSyntax::Operator => SourceExpressionSyntax::Prefix,
        PrefixExpressionSyntax::NotPrefix => source_expression_is_postfix_or_chain(input),
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_is_postfix_or_chain(input: Bytes) -> SourceExpressionSyntax {
    handle structural_is_syntax(input) {
        StructuralIsSyntax::Value => SourceExpressionSyntax::PatternTest,
        StructuralIsSyntax::NotIs => source_expression_postfix_or_chain(input),
        StructuralIsSyntax::Rejected => SourceExpressionSyntax::Rejected,
        _ => SourceExpressionSyntax::Rejected,
    }
}

fn source_expression_postfix_or_chain(input: Bytes) -> SourceExpressionSyntax {
    handle postfix_expression_syntax(input) {
        PostfixExpressionSyntax::Value(_, _) => SourceExpressionSyntax::Postfix,
        PostfixExpressionSyntax::NotPostfix => source_expression_chain_or_atom(input),
        _ => SourceExpressionSyntax::Rejected,
    }
}

// `is` is the parser-known structural test. The subject is still an
// unresolved source name; the pattern half is parsed and duplicate-checked
// before Core assigns binding or nominal semantics.
pub fn structural_is_syntax(input: Bytes) -> StructuralIsSyntax {
    structural_is_subject(input, first_token(input))
}

fn structural_is_subject(input: Bytes, subject: TokenStart) -> StructuralIsSyntax {
    handle token_kind(subject) {
        TokenKind::Identifier => structural_is_keyword(input, next_token(input, subject)),
        _ => StructuralIsSyntax::NotIs,
    }
}

fn structural_is_keyword(input: Bytes, keyword: TokenStart) -> StructuralIsSyntax {
    handle token_matches(input, keyword, "is") {
        true => structural_is_pattern(input, next_token(input, keyword)),
        false => StructuralIsSyntax::NotIs,
        _ => StructuralIsSyntax::Rejected,
    }
}

fn structural_is_pattern(input: Bytes, pattern: TokenStart) -> StructuralIsSyntax {
    let suffix = __g1_bytes_slice(input, token_start(pattern), __g1_bytes_len(input));
    handle validate_pattern_bindings(suffix) {
        PatternBindingValidation::Valid => StructuralIsSyntax::Value,
        PatternBindingValidation::DuplicateBinding => StructuralIsSyntax::Rejected,
        PatternBindingValidation::Rejected => StructuralIsSyntax::Rejected,
        _ => StructuralIsSyntax::Rejected,
    }
}

fn source_expression_chain_or_atom(input: Bytes) -> SourceExpressionSyntax {
    handle flat_operator_chain_syntax(input) {
        FlatOperatorChainSyntax::Operators(_) => SourceExpressionSyntax::FlatOperatorChain,
        FlatOperatorChainSyntax::NotOperatorChain => SourceExpressionSyntax::Atom,
        _ => SourceExpressionSyntax::Rejected,
    }
}

pub fn source_pattern_syntax(input: Bytes) -> SourcePatternSyntax {
    source_pattern_start(input, first_token(input))
}

fn source_pattern_start(input: Bytes, token: TokenStart) -> SourcePatternSyntax {
    handle token_matches(input, token, "_") {
        true => source_pattern_end(input, next_token(input, token), SourcePatternSyntax::Wildcard),
        false => handle token_matches(input, token, "(") {
            true => source_pattern_delimited(input),
            false => handle token_matches(input, token, "[") {
                true => source_pattern_delimited(input),
                false => source_pattern_scalar(input, token),
                _ => SourcePatternSyntax::Rejected,
            },
            _ => SourcePatternSyntax::Rejected,
        },
        _ => SourcePatternSyntax::Rejected,
    }
}

fn source_pattern_scalar(input: Bytes, token: TokenStart) -> SourcePatternSyntax {
    handle token_kind(token) {
        TokenKind::Identifier => source_pattern_identifier(input, token),
        TokenKind::Integer => source_pattern_end(input, next_token(input, token), SourcePatternSyntax::Literal),
        TokenKind::Float => source_pattern_end(input, next_token(input, token), SourcePatternSyntax::Literal),
        TokenKind::String => source_pattern_end(input, next_token(input, token), SourcePatternSyntax::Literal),
        TokenKind::Character => source_pattern_end(input, next_token(input, token), SourcePatternSyntax::Literal),
        _ => SourcePatternSyntax::NotPattern,
    }
}

fn source_pattern_identifier(input: Bytes, token: TokenStart) -> SourcePatternSyntax {
    handle token_matches(input, token, "true") {
        true => source_pattern_end(input, next_token(input, token), SourcePatternSyntax::Literal),
        false => handle token_matches(input, token, "false") {
            true => source_pattern_end(input, next_token(input, token), SourcePatternSyntax::Literal),
            false => source_pattern_end(input, next_token(input, token), SourcePatternSyntax::Binding),
            _ => SourcePatternSyntax::Rejected,
        },
        _ => SourcePatternSyntax::Rejected,
    }
}

fn source_pattern_end(input: Bytes, token: TokenStart, syntax: SourcePatternSyntax) -> SourcePatternSyntax {
    handle token_kind(token) {
        TokenKind::End => syntax,
        _ => SourcePatternSyntax::Rejected,
    }
}

fn source_pattern_delimited(input: Bytes) -> SourcePatternSyntax {
    handle delimited_expression_syntax(input) {
        DelimitedExpressionSyntax::Tuple(count) => SourcePatternSyntax::Tuple(count),
        DelimitedExpressionSyntax::Array(count) => SourcePatternSyntax::Array(count),
        _ => SourcePatternSyntax::Rejected,
    }
}

// Binding identity is a parser invariant: duplicate names in one structural
// pattern are rejected before Core tries to build a binding environment.
// Nominal record/enum paths are intentionally outside this fixed-shape slice.
pub fn validate_pattern_bindings(input: Bytes) -> PatternBindingValidation {
    handle source_pattern_syntax(input) {
        SourcePatternSyntax::Wildcard => pattern_binding_tokens(input, first_token(input), PatternBindingNames::Empty),
        SourcePatternSyntax::Binding => pattern_binding_tokens(input, first_token(input), PatternBindingNames::Empty),
        SourcePatternSyntax::Literal => pattern_binding_tokens(input, first_token(input), PatternBindingNames::Empty),
        SourcePatternSyntax::Tuple(_) => pattern_binding_tokens(input, first_token(input), PatternBindingNames::Empty),
        SourcePatternSyntax::Array(_) => pattern_binding_tokens(input, first_token(input), PatternBindingNames::Empty),
        _ => PatternBindingValidation::Rejected,
    }
}

fn pattern_binding_tokens(input: Bytes, token: TokenStart, names: PatternBindingNames) -> PatternBindingValidation {
    handle token_kind(token) {
        TokenKind::End => PatternBindingValidation::Valid,
        TokenKind::Invalid => PatternBindingValidation::Rejected,
        TokenKind::Identifier => pattern_binding_identifier(input, token, names),
        _ => pattern_binding_tokens(input, next_token(input, token), names),
    }
}

fn pattern_binding_identifier(input: Bytes, token: TokenStart, names: PatternBindingNames) -> PatternBindingValidation {
    handle token_matches(input, token, "_") {
        true => pattern_binding_tokens(input, next_token(input, token), names),
        false => handle token_matches(input, token, "true") {
            true => pattern_binding_tokens(input, next_token(input, token), names),
            false => handle token_matches(input, token, "false") {
                true => pattern_binding_tokens(input, next_token(input, token), names),
                false => handle pattern_binding_insert(input, names, token) {
                    PatternBindingInsert::Added(next_names) => pattern_binding_tokens(input, next_token(input, token), next_names),
                    PatternBindingInsert::Duplicate => PatternBindingValidation::DuplicateBinding,
                    _ => PatternBindingValidation::Rejected,
                },
                _ => PatternBindingValidation::Rejected,
            },
            _ => PatternBindingValidation::Rejected,
        },
        _ => PatternBindingValidation::Rejected,
    }
}

fn pattern_binding_insert(input: Bytes, names: PatternBindingNames, wanted: TokenStart) -> PatternBindingInsert {
    handle names {
        PatternBindingNames::Empty => PatternBindingInsert::Added(PatternBindingNames::Node(wanted, false, [])),
        PatternBindingNames::Node(name, has_tail, tail) => handle token_equals(input, name, wanted) {
            true => PatternBindingInsert::Duplicate,
            false => pattern_binding_insert_tail(input, name, has_tail, tail, wanted),
            _ => PatternBindingInsert::Duplicate,
        },
        _ => PatternBindingInsert::Duplicate,
    }
}

fn pattern_binding_insert_tail(input: Bytes, name: TokenStart, has_tail: Bool, tail: Array<PatternBindingNames>, wanted: TokenStart) -> PatternBindingInsert {
    handle has_tail {
        true => handle pattern_binding_insert(input, __g1_array_pop_move<PatternBindingNames>(&mut tail), wanted) {
            PatternBindingInsert::Added(next_tail) => PatternBindingInsert::Added(PatternBindingNames::Node(name, true, [next_tail])),
            PatternBindingInsert::Duplicate => PatternBindingInsert::Duplicate,
            _ => PatternBindingInsert::Duplicate,
        },
        false => PatternBindingInsert::Added(PatternBindingNames::Node(name, true, [PatternBindingNames::Node(wanted, false, [])])),
        _ => PatternBindingInsert::Duplicate,
    }
}

pub fn postfix_expression_syntax(input: Bytes) -> PostfixExpressionSyntax {
    postfix_expression_base(input, first_token(input), 0, 0)
}

fn postfix_expression_base(input: Bytes, token: TokenStart, calls: i64, fields: i64) -> PostfixExpressionSyntax {
    handle postfix_base(input, token) {
        PostfixBase::Next(next) => postfix_expression_tail(input, next, calls, fields),
        PostfixBase::Rejected => PostfixExpressionSyntax::Rejected,
        PostfixBase::NotBase => PostfixExpressionSyntax::NotPostfix,
        _ => PostfixExpressionSyntax::Rejected,
    }
}

fn postfix_base(input: Bytes, token: TokenStart) -> PostfixBase {
    handle token_matches(input, token, "(") {
        true => postfix_base_nested(input, skip_nested_delimiter(input, token)),
        false => handle token_matches(input, token, "[") {
            true => postfix_base_nested(input, skip_nested_delimiter(input, token)),
            false => handle token_matches(input, token, "{") {
                true => postfix_base_nested(input, skip_nested_delimiter(input, token)),
                false => postfix_base_scalar(input, token),
                _ => PostfixBase::Rejected,
            },
            _ => PostfixBase::Rejected,
        },
        _ => PostfixBase::Rejected,
    }
}

fn postfix_base_nested(input: Bytes, nested: DelimitedSkip) -> PostfixBase {
    handle nested {
        DelimitedSkip::Close(close) => PostfixBase::Next(next_token(input, close)),
        DelimitedSkip::Rejected => PostfixBase::Rejected,
        _ => PostfixBase::Rejected,
    }
}

fn postfix_base_scalar(input: Bytes, token: TokenStart) -> PostfixBase {
    handle token_kind(token) {
        TokenKind::Identifier => PostfixBase::Next(next_token(input, token)),
        TokenKind::Integer => PostfixBase::Next(next_token(input, token)),
        TokenKind::Float => PostfixBase::Next(next_token(input, token)),
        TokenKind::String => PostfixBase::Next(next_token(input, token)),
        TokenKind::Character => PostfixBase::Next(next_token(input, token)),
        _ => PostfixBase::NotBase,
    }
}

fn postfix_expression_tail(input: Bytes, token: TokenStart, calls: i64, fields: i64) -> PostfixExpressionSyntax {
    handle token_kind(token) {
        TokenKind::End => handle calls == 0 {
            true => handle fields == 0 { true => PostfixExpressionSyntax::NotPostfix, false => PostfixExpressionSyntax::Value(calls, fields), _ => PostfixExpressionSyntax::Rejected },
            false => PostfixExpressionSyntax::Value(calls, fields),
            _ => PostfixExpressionSyntax::Rejected,
        },
        _ => handle token_matches(input, token, ".") {
            true => postfix_expression_field(input, next_token(input, token), calls, fields),
            false => handle token_matches(input, token, "(") {
                true => postfix_expression_call(input, token, calls, fields),
                false => postfix_expression_non_tail(calls, fields),
                _ => PostfixExpressionSyntax::Rejected,
            },
            _ => PostfixExpressionSyntax::Rejected,
        },
    }
}

fn postfix_expression_non_tail(calls: i64, fields: i64) -> PostfixExpressionSyntax {
    handle calls == 0 {
        true => handle fields == 0 {
            true => PostfixExpressionSyntax::NotPostfix,
            false => PostfixExpressionSyntax::Rejected,
            _ => PostfixExpressionSyntax::Rejected,
        },
        false => PostfixExpressionSyntax::Rejected,
        _ => PostfixExpressionSyntax::Rejected,
    }
}

fn postfix_expression_field(input: Bytes, token: TokenStart, calls: i64, fields: i64) -> PostfixExpressionSyntax {
    handle token_kind(token) {
        TokenKind::Identifier => postfix_expression_tail(input, next_token(input, token), calls, fields + 1),
        TokenKind::Integer => postfix_expression_tail(input, next_token(input, token), calls, fields + 1),
        _ => PostfixExpressionSyntax::Rejected,
    }
}

fn postfix_expression_call(input: Bytes, open: TokenStart, calls: i64, fields: i64) -> PostfixExpressionSyntax {
    handle call_arguments(input, next_token(input, open), 0, false) {
        CallArguments::Value(_, close) => postfix_expression_tail(input, next_token(input, close), calls + 1, fields),
        CallArguments::Rejected => PostfixExpressionSyntax::Rejected,
        _ => PostfixExpressionSyntax::Rejected,
    }
}

// Count source-order direct-call arguments without interpreting their
// expressions. Nested delimiters are atomic at this parser layer.
fn call_arguments(input: Bytes, token: TokenStart, count: i64, has_argument: Bool) -> CallArguments {
    handle token_matches(input, token, ")") {
        true => call_arguments_finish(token, count, has_argument),
        false => handle token_kind(token) {
            TokenKind::End => CallArguments::Rejected,
            _ => handle token_matches(input, token, ",") {
                true => handle has_argument { true => call_arguments(input, next_token(input, token), count + 1, false), false => CallArguments::Rejected, _ => CallArguments::Rejected },
                false => call_arguments_value(input, token, count, has_argument),
                _ => CallArguments::Rejected,
            },
        },
        _ => CallArguments::Rejected,
    }
}

fn call_arguments_finish(close: TokenStart, count: i64, has_argument: Bool) -> CallArguments {
    handle has_argument {
        true => CallArguments::Value(count + 1, close),
        false => CallArguments::Value(count, close),
        _ => CallArguments::Rejected,
    }
}

fn call_arguments_value(input: Bytes, token: TokenStart, count: i64, has_argument: Bool) -> CallArguments {
    handle token_matches(input, token, "(") {
        true => call_arguments_after_nested(input, skip_nested_delimiter(input, token), count),
        false => handle token_matches(input, token, "[") {
            true => call_arguments_after_nested(input, skip_nested_delimiter(input, token), count),
            false => handle token_matches(input, token, "{") {
                true => call_arguments_after_nested(input, skip_nested_delimiter(input, token), count),
                false => call_arguments(input, next_token(input, token), count, true),
                _ => CallArguments::Rejected,
            },
            _ => CallArguments::Rejected,
        },
        _ => CallArguments::Rejected,
    }
}

fn call_arguments_after_nested(input: Bytes, nested: DelimitedSkip, count: i64) -> CallArguments {
    handle nested {
        DelimitedSkip::Close(close) => call_arguments(input, next_token(input, close), count, true),
        DelimitedSkip::Rejected => CallArguments::Rejected,
        _ => CallArguments::Rejected,
    }
}

pub fn flat_operator_chain_syntax(input: Bytes) -> FlatOperatorChainSyntax {
    flat_operator_chain_first(input, first_token(input))
}

fn flat_operator_chain_first(input: Bytes, token: TokenStart) -> FlatOperatorChainSyntax {
    flat_operator_chain_operand(input, token, 0, false)
}

fn flat_operator_chain_operand(input: Bytes, token: TokenStart, operators: i64, saw_operator: Bool) -> FlatOperatorChainSyntax {
    handle token_matches(input, token, "(") {
        true => flat_operator_chain_after_nested(input, skip_nested_delimiter(input, token), operators, saw_operator),
        false => handle token_matches(input, token, "[") {
            true => flat_operator_chain_after_nested(input, skip_nested_delimiter(input, token), operators, saw_operator),
            false => handle token_matches(input, token, "{") {
                true => flat_operator_chain_after_nested(input, skip_nested_delimiter(input, token), operators, saw_operator),
                false => flat_operator_chain_scalar_operand(input, token, operators, saw_operator),
                _ => FlatOperatorChainSyntax::Rejected,
            },
            _ => FlatOperatorChainSyntax::Rejected,
        },
        _ => FlatOperatorChainSyntax::Rejected,
    }
}

fn flat_operator_chain_after_nested(input: Bytes, nested: DelimitedSkip, operators: i64, saw_operator: Bool) -> FlatOperatorChainSyntax {
    handle nested {
        DelimitedSkip::Close(close) => flat_operator_chain_after_operand(input, next_token(input, close), operators, saw_operator),
        DelimitedSkip::Rejected => FlatOperatorChainSyntax::Rejected,
        _ => FlatOperatorChainSyntax::Rejected,
    }
}

fn flat_operator_chain_scalar_operand(input: Bytes, token: TokenStart, operators: i64, saw_operator: Bool) -> FlatOperatorChainSyntax {
    handle token_kind(token) {
        TokenKind::Identifier => flat_operator_chain_after_operand(input, next_token(input, token), operators, saw_operator),
        TokenKind::Integer => flat_operator_chain_after_operand(input, next_token(input, token), operators, saw_operator),
        TokenKind::Float => flat_operator_chain_after_operand(input, next_token(input, token), operators, saw_operator),
        TokenKind::String => flat_operator_chain_after_operand(input, next_token(input, token), operators, saw_operator),
        TokenKind::Character => flat_operator_chain_after_operand(input, next_token(input, token), operators, saw_operator),
        _ => handle saw_operator { true => FlatOperatorChainSyntax::Rejected, false => FlatOperatorChainSyntax::NotOperatorChain, _ => FlatOperatorChainSyntax::Rejected },
    }
}

fn flat_operator_chain_after_operand(input: Bytes, token: TokenStart, operators: i64, saw_operator: Bool) -> FlatOperatorChainSyntax {
    handle token_kind(token) {
        TokenKind::End => handle saw_operator { true => FlatOperatorChainSyntax::Operators(operators), false => FlatOperatorChainSyntax::NotOperatorChain, _ => FlatOperatorChainSyntax::Rejected },
        TokenKind::Operator => flat_operator_chain_operand(input, next_token(input, token), operators + 1, true),
        _ => handle saw_operator { true => FlatOperatorChainSyntax::Rejected, false => FlatOperatorChainSyntax::NotOperatorChain, _ => FlatOperatorChainSyntax::Rejected },
    }
}

// Recognize the parser's three ordinary delimited expression surfaces with
// exact nesting validation. This is intentionally not a substitute for the
// arena parser: it is the shared structural boundary on which tuple/array/
// block AST allocation can be built without each later feature reimplementing
// bracket matching.
pub fn delimited_expression_syntax(input: Bytes) -> DelimitedExpressionSyntax {
    delimited_expression_start(input, first_token(input))
}

fn delimited_expression_start(input: Bytes, token: TokenStart) -> DelimitedExpressionSyntax {
    handle token_matches(input, token, "(") {
        true => delimited_expression_items(input, next_token(input, token), DelimitedMode::Tuple, 0, false, false),
        false => handle token_matches(input, token, "[") {
            true => delimited_expression_items(input, next_token(input, token), DelimitedMode::Array, 0, false, false),
            false => handle token_matches(input, token, "{") {
                true => delimited_expression_items(input, next_token(input, token), DelimitedMode::Block, 0, false, false),
                false => DelimitedExpressionSyntax::NotDelimitedExpression,
                _ => DelimitedExpressionSyntax::Rejected,
            },
            _ => DelimitedExpressionSyntax::Rejected,
        },
        _ => DelimitedExpressionSyntax::Rejected,
    }
}

// `count` contains completed elements; `has_element` says the current
// top-level element has at least one token; `saw_separator` retains the comma
// needed to distinguish `(value)` from `(value,)`.
fn delimited_expression_items(input: Bytes, token: TokenStart, mode: DelimitedMode, count: i64, has_element: Bool, saw_separator: Bool) -> DelimitedExpressionSyntax {
    handle delimited_expression_close(input, token, mode) {
        true => delimited_expression_finish(mode, count, has_element, saw_separator),
        false => delimited_expression_item(input, token, mode, count, has_element, saw_separator),
        _ => DelimitedExpressionSyntax::Rejected,
    }
}

fn delimited_expression_item(input: Bytes, token: TokenStart, mode: DelimitedMode, count: i64, has_element: Bool, saw_separator: Bool) -> DelimitedExpressionSyntax {
    handle token_kind(token) {
        TokenKind::End => DelimitedExpressionSyntax::Rejected,
        _ => handle delimited_expression_separator(input, token, mode) {
            true => delimited_expression_after_separator(input, token, mode, count, has_element),
            false => delimited_expression_non_separator(input, token, mode, count, has_element, saw_separator),
            _ => DelimitedExpressionSyntax::Rejected,
        },
    }
}

fn delimited_expression_after_separator(input: Bytes, token: TokenStart, mode: DelimitedMode, count: i64, has_element: Bool) -> DelimitedExpressionSyntax {
    handle has_element {
        true => delimited_expression_items(input, next_token(input, token), mode, count + 1, false, true),
        false => DelimitedExpressionSyntax::Rejected,
        _ => DelimitedExpressionSyntax::Rejected,
    }
}

fn delimited_expression_non_separator(input: Bytes, token: TokenStart, mode: DelimitedMode, count: i64, has_element: Bool, saw_separator: Bool) -> DelimitedExpressionSyntax {
    handle token_matches(input, token, "(") {
        true => delimited_expression_after_nested(input, skip_nested_delimiter(input, token), mode, count, saw_separator),
        false => handle token_matches(input, token, "[") {
            true => delimited_expression_after_nested(input, skip_nested_delimiter(input, token), mode, count, saw_separator),
            false => handle token_matches(input, token, "{") {
                true => delimited_expression_after_nested(input, skip_nested_delimiter(input, token), mode, count, saw_separator),
                false => delimited_expression_items(input, next_token(input, token), mode, count, true, saw_separator),
                _ => DelimitedExpressionSyntax::Rejected,
            },
            _ => DelimitedExpressionSyntax::Rejected,
        },
        _ => DelimitedExpressionSyntax::Rejected,
    }
}

fn delimited_expression_after_nested(input: Bytes, skipped: DelimitedSkip, mode: DelimitedMode, count: i64, saw_separator: Bool) -> DelimitedExpressionSyntax {
    handle skipped {
        DelimitedSkip::Close(token) => delimited_expression_items(input, next_token(input, token), mode, count, true, saw_separator),
        DelimitedSkip::Rejected => DelimitedExpressionSyntax::Rejected,
        _ => DelimitedExpressionSyntax::Rejected,
    }
}

fn delimited_expression_close(input: Bytes, token: TokenStart, mode: DelimitedMode) -> Bool {
    handle mode {
        DelimitedMode::Tuple => token_matches(input, token, ")"),
        DelimitedMode::Array => token_matches(input, token, "]"),
        DelimitedMode::Block => token_matches(input, token, "}"),
        _ => false,
    }
}

fn delimited_expression_separator(input: Bytes, token: TokenStart, mode: DelimitedMode) -> Bool {
    handle mode {
        DelimitedMode::Tuple => token_matches(input, token, ","),
        DelimitedMode::Array => token_matches(input, token, ","),
        DelimitedMode::Block => token_matches(input, token, ";"),
        _ => false,
    }
}

fn delimited_expression_finish(mode: DelimitedMode, count: i64, has_element: Bool, saw_separator: Bool) -> DelimitedExpressionSyntax {
    handle has_element {
        true => delimited_expression_finish_count(mode, count + 1, saw_separator),
        false => handle count == 0 {
            true => delimited_expression_finish_count(mode, 0, saw_separator),
            // A completed element followed by the delimiter's own separator
            // is valid for tuples, arrays, and block statements. In
            // particular `(value,)` must remain distinct from `(value)`.
            false => delimited_expression_finish_count(mode, count, saw_separator),
            _ => DelimitedExpressionSyntax::Rejected,
        },
        _ => DelimitedExpressionSyntax::Rejected,
    }
}

fn delimited_expression_finish_count(mode: DelimitedMode, count: i64, saw_separator: Bool) -> DelimitedExpressionSyntax {
    handle mode {
        DelimitedMode::Tuple => handle count == 1 {
            true => handle saw_separator { true => DelimitedExpressionSyntax::Tuple(1), false => DelimitedExpressionSyntax::Group, _ => DelimitedExpressionSyntax::Rejected },
            false => DelimitedExpressionSyntax::Tuple(count),
            _ => DelimitedExpressionSyntax::Rejected,
        },
        DelimitedMode::Array => DelimitedExpressionSyntax::Array(count),
        DelimitedMode::Block => DelimitedExpressionSyntax::Block(count),
        _ => DelimitedExpressionSyntax::Rejected,
    }
}

enum DelimitedSkip { Close(TokenStart), Rejected }

// Consume one nested delimiter exactly, recursively checking its own nested
// delimiters. Scanner emits strings as single tokens, so punctuation in a
// string cannot affect this structural pass.
fn skip_nested_delimiter(input: Bytes, open: TokenStart) -> DelimitedSkip {
    handle token_matches(input, open, "(") {
        true => skip_nested_until(input, next_token(input, open), ")"),
        false => handle token_matches(input, open, "[") {
            true => skip_nested_until(input, next_token(input, open), "]"),
            false => handle token_matches(input, open, "{") {
                true => skip_nested_until(input, next_token(input, open), "}"),
                false => DelimitedSkip::Rejected,
                _ => DelimitedSkip::Rejected,
            },
            _ => DelimitedSkip::Rejected,
        },
        _ => DelimitedSkip::Rejected,
    }
}

fn skip_nested_until(input: Bytes, token: TokenStart, close: Text) -> DelimitedSkip {
    handle token_matches(input, token, close) {
        true => DelimitedSkip::Close(token),
        false => handle token_kind(token) {
            TokenKind::End => DelimitedSkip::Rejected,
            _ => skip_nested_next(input, token, close),
        },
        _ => DelimitedSkip::Rejected,
    }
}

fn skip_nested_next(input: Bytes, token: TokenStart, close: Text) -> DelimitedSkip {
    handle token_matches(input, token, "(") {
        true => skip_nested_continue(input, skip_nested_delimiter(input, token), close),
        false => handle token_matches(input, token, "[") {
            true => skip_nested_continue(input, skip_nested_delimiter(input, token), close),
            false => handle token_matches(input, token, "{") {
                true => skip_nested_continue(input, skip_nested_delimiter(input, token), close),
                false => skip_nested_until(input, next_token(input, token), close),
                _ => DelimitedSkip::Rejected,
            },
            _ => DelimitedSkip::Rejected,
        },
        _ => DelimitedSkip::Rejected,
    }
}

fn skip_nested_continue(input: Bytes, nested: DelimitedSkip, close: Text) -> DelimitedSkip {
    handle nested {
        DelimitedSkip::Close(token) => skip_nested_until(input, next_token(input, token), close),
        DelimitedSkip::Rejected => DelimitedSkip::Rejected,
        _ => DelimitedSkip::Rejected,
    }
}

// Mirror the frozen parser's deliberately narrow lookahead: `{ => body }`,
// `{ name => body }`, and `{ name, ... => body }` are compact closures;
// `{ expression }` is an ordinary contextual block. Once a comma makes the
// closure form unambiguous, malformed parameter syntax is rejected instead
// of being silently reclassified as a block.
pub fn compact_closure_syntax(input: Bytes) -> CompactClosureSyntax {
    compact_closure_open(input, first_token(input))
}

fn compact_closure_open(input: Bytes, token: TokenStart) -> CompactClosureSyntax {
    handle token_matches(input, token, "{") {
        true => compact_closure_first(input, next_token(input, token)),
        false => CompactClosureSyntax::NotCompactClosure,
        _ => CompactClosureSyntax::Rejected,
    }
}

fn compact_closure_first(input: Bytes, token: TokenStart) -> CompactClosureSyntax {
    handle token_matches(input, token, "=>") {
        true => compact_closure_body_open(input, next_token(input, token), 0),
        false => handle token_kind(token) {
            TokenKind::Identifier => compact_closure_after_name(input, next_token(input, token), 1),
            _ => CompactClosureSyntax::NotCompactClosure,
        },
        _ => CompactClosureSyntax::Rejected,
    }
}

fn compact_closure_after_name(input: Bytes, token: TokenStart, count: i64) -> CompactClosureSyntax {
    handle token_matches(input, token, "=>") {
        true => compact_closure_body_open(input, next_token(input, token), count),
        false => handle token_matches(input, token, ",") {
            true => compact_closure_next_name(input, next_token(input, token), count),
            false => CompactClosureSyntax::NotCompactClosure,
            _ => CompactClosureSyntax::Rejected,
        },
        _ => CompactClosureSyntax::Rejected,
    }
}

fn compact_closure_next_name(input: Bytes, token: TokenStart, count: i64) -> CompactClosureSyntax {
    handle token_kind(token) {
        TokenKind::Identifier => compact_closure_after_name_required(input, next_token(input, token), count + 1),
        _ => CompactClosureSyntax::Rejected,
    }
}

// Reaching this state means an earlier comma selected compact-closure syntax;
// unlike the first parameter, a missing arrow is therefore malformed closure
// syntax, not a late fallback to a contextual block.
fn compact_closure_after_name_required(input: Bytes, token: TokenStart, count: i64) -> CompactClosureSyntax {
    handle token_matches(input, token, "=>") {
        true => compact_closure_body_open(input, next_token(input, token), count),
        false => handle token_matches(input, token, ",") {
            true => compact_closure_next_name(input, next_token(input, token), count),
            false => CompactClosureSyntax::Rejected,
            _ => CompactClosureSyntax::Rejected,
        },
        _ => CompactClosureSyntax::Rejected,
    }
}

fn compact_closure_body_open(input: Bytes, token: TokenStart, count: i64) -> CompactClosureSyntax {
    handle token_kind(token) {
        TokenKind::End => CompactClosureSyntax::Rejected,
        TokenKind::Punctuation => handle token_matches(input, token, "}") {
            true => CompactClosureSyntax::Rejected,
            false => compact_closure_body(input, token, count, 1),
            _ => CompactClosureSyntax::Rejected,
        },
        _ => compact_closure_body(input, token, count, 1),
    }
}

fn compact_closure_body(input: Bytes, token: TokenStart, count: i64, depth: i64) -> CompactClosureSyntax {
    handle token_matches(input, token, "{") {
        true => compact_closure_body(input, next_token(input, token), count, depth + 1),
        false => compact_closure_body_non_open(input, token, count, depth),
        _ => CompactClosureSyntax::Rejected,
    }
}

fn compact_closure_body_non_open(input: Bytes, token: TokenStart, count: i64, depth: i64) -> CompactClosureSyntax {
    handle token_matches(input, token, "}") {
        true => handle depth == 1 {
            true => handle token_kind(next_token(input, token)) {
                TokenKind::End => CompactClosureSyntax::Parameters(count),
                _ => CompactClosureSyntax::Rejected,
            },
            false => compact_closure_body(input, next_token(input, token), count, depth - 1),
            _ => CompactClosureSyntax::Rejected,
        },
        false => handle token_kind(token) {
            TokenKind::End => CompactClosureSyntax::Rejected,
            _ => compact_closure_body(input, next_token(input, token), count, depth),
        },
        _ => CompactClosureSyntax::Rejected,
    }
}

// Preserve the frozen `typed_closure_ahead` boundary. A `)` only closes the
// candidate list when all nested tuple/callable parentheses have closed; only
// then may an immediately following arrow claim the closure grammar.
pub fn typed_closure_syntax(input: Bytes) -> TypedClosureSyntax {
    typed_closure_open(input, first_token(input))
}

fn typed_closure_open(input: Bytes, token: TokenStart) -> TypedClosureSyntax {
    handle token_matches(input, token, "(") {
        true => typed_closure_parameters(input, next_token(input, token), 1, 0, false),
        false => TypedClosureSyntax::NotTypedClosure,
        _ => TypedClosureSyntax::Rejected,
    }
}

fn typed_closure_parameters(input: Bytes, token: TokenStart, depth: i64, count: i64, has_content: Bool) -> TypedClosureSyntax {
    handle token_matches(input, token, "(") {
        true => typed_closure_parameters(input, next_token(input, token), depth + 1, count, has_content),
        false => typed_closure_parameters_non_open(input, token, depth, count, has_content),
        _ => TypedClosureSyntax::Rejected,
    }
}

fn typed_closure_parameters_non_open(input: Bytes, token: TokenStart, depth: i64, count: i64, has_content: Bool) -> TypedClosureSyntax {
    handle token_matches(input, token, ")") {
        true => handle depth == 1 {
            true => typed_closure_after_parameters(input, next_token(input, token), count, has_content),
            false => typed_closure_parameters(input, next_token(input, token), depth - 1, count, has_content),
            _ => TypedClosureSyntax::Rejected,
        },
        false => typed_closure_parameters_not_paren(input, token, depth, count, has_content),
        _ => TypedClosureSyntax::Rejected,
    }
}

fn typed_closure_parameters_not_paren(input: Bytes, token: TokenStart, depth: i64, count: i64, has_content: Bool) -> TypedClosureSyntax {
    handle token_kind(token) {
        TokenKind::End => TypedClosureSyntax::Rejected,
        _ => handle depth == 1 {
            true => handle token_matches(input, token, ":") {
                true => typed_closure_parameters(input, next_token(input, token), depth, count + 1, true),
                false => typed_closure_parameters(input, next_token(input, token), depth, count, true),
                _ => TypedClosureSyntax::Rejected,
            },
            false => typed_closure_parameters(input, next_token(input, token), depth, count, has_content),
            _ => TypedClosureSyntax::Rejected,
        },
    }
}

fn typed_closure_after_parameters(input: Bytes, token: TokenStart, count: i64, has_content: Bool) -> TypedClosureSyntax {
    handle token_matches(input, token, "->") {
        true => typed_closure_parameter_shape(count, has_content),
        false => TypedClosureSyntax::NotTypedClosure,
        _ => TypedClosureSyntax::Rejected,
    }
}

fn typed_closure_parameter_shape(count: i64, has_content: Bool) -> TypedClosureSyntax {
    handle has_content {
        true => handle count > 0 {
            true => TypedClosureSyntax::Parameters(count),
            false => TypedClosureSyntax::Rejected,
            _ => TypedClosureSyntax::Rejected,
        },
        false => TypedClosureSyntax::Parameters(0),
        _ => TypedClosureSyntax::Rejected,
    }
}

// The compact label spelling is deliberately recognized before generic
// prefix-expression parsing. Its result type is opaque here because Header
// owns the full type grammar; this gate only retains the lexical construct
// that Core later brands and validates.
pub fn label_syntax(input: Bytes) -> LabelSyntax {
    label_start(input, first_token(input))
}

fn label_start(input: Bytes, token: TokenStart) -> LabelSyntax {
    handle token_matches(input, token, "@") {
        true => label_name(input, next_token(input, token)),
        false => LabelSyntax::NotLabel,
        _ => LabelSyntax::Rejected,
    }
}

fn label_name(input: Bytes, token: TokenStart) -> LabelSyntax {
    handle token_kind(token) {
        TokenKind::Identifier => label_suffix(input, next_token(input, token)),
        _ => LabelSyntax::Rejected,
    }
}

fn label_suffix(input: Bytes, token: TokenStart) -> LabelSyntax {
    handle token_matches(input, token, ":") {
        true => label_binder_type_start(input, next_token(input, token)),
        false => handle token_matches(input, token, "(") {
            true => label_transfer(input, next_token(input, token), 1),
            false => handle token_kind(token) {
                TokenKind::End => LabelSyntax::Value,
                _ => LabelSyntax::Rejected,
            },
            _ => LabelSyntax::Rejected,
        },
        _ => LabelSyntax::Rejected,
    }
}

fn label_binder_type_start(input: Bytes, token: TokenStart) -> LabelSyntax {
    handle token_kind(token) {
        TokenKind::End => LabelSyntax::Rejected,
        TokenKind::Punctuation => handle token_matches(input, token, "{") {
            true => LabelSyntax::Rejected,
            false => label_binder_type(input, next_token(input, token)),
            _ => LabelSyntax::Rejected,
        },
        _ => label_binder_type(input, next_token(input, token)),
    }
}

fn label_binder_type(input: Bytes, token: TokenStart) -> LabelSyntax {
    handle token_matches(input, token, "{") {
        true => label_binder_body(input, next_token(input, token), 1),
        false => handle token_kind(token) {
            TokenKind::End => LabelSyntax::Rejected,
            _ => label_binder_type(input, next_token(input, token)),
        },
        _ => LabelSyntax::Rejected,
    }
}

fn label_binder_body(input: Bytes, token: TokenStart, depth: i64) -> LabelSyntax {
    handle token_matches(input, token, "{") {
        true => label_binder_body(input, next_token(input, token), depth + 1),
        false => label_binder_body_non_open(input, token, depth),
        _ => LabelSyntax::Rejected,
    }
}

fn label_binder_body_non_open(input: Bytes, token: TokenStart, depth: i64) -> LabelSyntax {
    handle token_matches(input, token, "}") {
        true => handle depth == 1 {
            true => handle token_kind(next_token(input, token)) {
                TokenKind::End => LabelSyntax::Binder,
                _ => LabelSyntax::Rejected,
            },
            false => label_binder_body(input, next_token(input, token), depth - 1),
            _ => LabelSyntax::Rejected,
        },
        false => handle token_kind(token) {
            TokenKind::End => LabelSyntax::Rejected,
            _ => label_binder_body(input, next_token(input, token), depth),
        },
        _ => LabelSyntax::Rejected,
    }
}

fn label_transfer(input: Bytes, token: TokenStart, depth: i64) -> LabelSyntax {
    handle token_matches(input, token, "(") {
        true => label_transfer(input, next_token(input, token), depth + 1),
        false => label_transfer_non_open(input, token, depth),
        _ => LabelSyntax::Rejected,
    }
}

fn label_transfer_non_open(input: Bytes, token: TokenStart, depth: i64) -> LabelSyntax {
    handle token_matches(input, token, ")") {
        true => handle depth == 1 {
            true => handle token_kind(next_token(input, token)) {
                TokenKind::End => LabelSyntax::Transfer,
                _ => LabelSyntax::Rejected,
            },
            false => label_transfer(input, next_token(input, token), depth - 1),
            _ => LabelSyntax::Rejected,
        },
        false => handle token_kind(token) {
            TokenKind::End => LabelSyntax::Rejected,
            _ => label_transfer(input, next_token(input, token), depth),
        },
        _ => LabelSyntax::Rejected,
    }
}

// Parse `@name: i64 { @name(<i64>) }` from an already-positioned body
// cursor. The returned close token belongs to the label body so the enclosing
// declaration parser still owns its own final delimiter. Matching the source
// binder tokens (rather than accepting the same spelling loosely) is the
// first executable label-scope invariant in the source route.
pub fn label_i64_transfer_at(input: Bytes, token: TokenStart) -> LabelI64TransferAdmission {
    label_i64_start(input, token)
}

fn label_i64_start(input: Bytes, token: TokenStart) -> LabelI64TransferAdmission {
    handle token_matches(input, token, "@") {
        true => label_i64_name(input, next_token(input, token)),
        false => LabelI64TransferAdmission::NotLabel,
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_name(input: Bytes, name: TokenStart) -> LabelI64TransferAdmission {
    handle token_kind(name) {
        TokenKind::Identifier => label_i64_colon(input, name, next_token(input, name)),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_colon(input: Bytes, name: TokenStart, token: TokenStart) -> LabelI64TransferAdmission {
    handle token_matches(input, token, ":") {
        true => label_i64_type(input, name, next_token(input, token)),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_type(input: Bytes, name: TokenStart, token: TokenStart) -> LabelI64TransferAdmission {
    handle token_matches(input, token, "i64") {
        true => label_i64_open(input, name, next_token(input, token)),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_open(input: Bytes, name: TokenStart, token: TokenStart) -> LabelI64TransferAdmission {
    handle token_matches(input, token, "{") {
        true => label_i64_inner_sigil(input, name, next_token(input, token)),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_inner_sigil(input: Bytes, name: TokenStart, token: TokenStart) -> LabelI64TransferAdmission {
    handle token_matches(input, token, "@") {
        true => label_i64_target(input, name, next_token(input, token)),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_target(input: Bytes, name: TokenStart, target: TokenStart) -> LabelI64TransferAdmission {
    handle token_kind(target) {
        TokenKind::Identifier => handle token_equals(input, name, target) {
            true => label_i64_value_open(input, next_token(input, target)),
            false => LabelI64TransferAdmission::Rejected,
            _ => LabelI64TransferAdmission::Rejected,
        },
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_value_open(input: Bytes, token: TokenStart) -> LabelI64TransferAdmission {
    handle token_matches(input, token, "(") {
        true => label_i64_value(input, next_token(input, token)),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_value(input: Bytes, token: TokenStart) -> LabelI64TransferAdmission {
    handle signed_i64_literal_at(input, token) {
        SignedI64LiteralAdmission::Value(value, last) => label_i64_value_close(input, value, next_token(input, last)),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_value_close(input: Bytes, value: i64, token: TokenStart) -> LabelI64TransferAdmission {
    handle token_matches(input, token, ")") {
        true => label_i64_body_close(input, value, next_token(input, token)),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

fn label_i64_body_close(input: Bytes, value: i64, token: TokenStart) -> LabelI64TransferAdmission {
    handle token_matches(input, token, "}") {
        true => LabelI64TransferAdmission::Value(value, token),
        _ => LabelI64TransferAdmission::Rejected,
    }
}

// Parse the scalar source-place forms exercised by the frozen assignment
// contract. The initializer-only form and the replacement form share the
// exact binder token; a same-shaped but different spelling cannot become a
// synthetic local read or write.
pub fn let_i64_assignment_at(input: Bytes, token: TokenStart) -> LetI64AssignmentAdmission {
    let_i64_start(input, token)
}

// This is the first source parser entrypoint that produces a value-carrying
// Body expression. The raw admission remains available for delimiter-aware
// callers, but normal source lowering crosses into Core through this node.
pub fn lower_let_i64_assignment_at(input: Bytes, token: TokenStart) -> LetI64ExpressionAdmission {
    handle let_i64_assignment_at(input, token) {
        LetI64AssignmentAdmission::Value(initial, replacement, read) => LetI64ExpressionAdmission::Value(Expression::I64Assignment(initial, replacement), read),
        LetI64AssignmentAdmission::NotLet => LetI64ExpressionAdmission::NotLet,
        LetI64AssignmentAdmission::Rejected => LetI64ExpressionAdmission::Rejected,
        _ => LetI64ExpressionAdmission::Rejected,
    }
}

pub fn lower_let_i64_assignment(input: Bytes) -> LetI64ExpressionAdmission {
    lower_let_i64_assignment_at(input, first_token(input))
}

fn let_i64_start(input: Bytes, token: TokenStart) -> LetI64AssignmentAdmission {
    handle token_matches(input, token, "let") {
        true => let_i64_name(input, next_token(input, token)),
        false => LetI64AssignmentAdmission::NotLet,
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_name(input: Bytes, name: TokenStart) -> LetI64AssignmentAdmission {
    handle token_kind(name) {
        TokenKind::Identifier => let_i64_initializer_equals(input, name, next_token(input, name)),
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_initializer_equals(input: Bytes, name: TokenStart, token: TokenStart) -> LetI64AssignmentAdmission {
    handle token_matches(input, token, "=") {
        true => let_i64_initializer(input, name, next_token(input, token)),
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_initializer(input: Bytes, name: TokenStart, token: TokenStart) -> LetI64AssignmentAdmission {
    handle signed_i64_literal_at(input, token) {
        SignedI64LiteralAdmission::Value(value, last) => let_i64_initializer_semicolon(input, name, value, next_token(input, last)),
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_initializer_semicolon(input: Bytes, name: TokenStart, initial: i64, token: TokenStart) -> LetI64AssignmentAdmission {
    handle token_matches(input, token, ";") {
        true => let_i64_read_or_write(input, name, initial, next_token(input, token)),
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_read_or_write(input: Bytes, name: TokenStart, initial: i64, token: TokenStart) -> LetI64AssignmentAdmission {
    handle token_kind(token) {
        TokenKind::Identifier => handle token_equals(input, name, token) {
            true => let_i64_after_first_read(input, name, initial, next_token(input, token), token),
            false => LetI64AssignmentAdmission::Rejected,
            _ => LetI64AssignmentAdmission::Rejected,
        },
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_after_first_read(input: Bytes, name: TokenStart, initial: i64, token: TokenStart, read: TokenStart) -> LetI64AssignmentAdmission {
    handle token_matches(input, token, "=") {
        true => let_i64_replacement(input, name, initial, next_token(input, token)),
        false => LetI64AssignmentAdmission::Value(initial, initial, read),
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_replacement(input: Bytes, name: TokenStart, initial: i64, token: TokenStart) -> LetI64AssignmentAdmission {
    handle signed_i64_literal_at(input, token) {
        SignedI64LiteralAdmission::Value(value, last) => let_i64_replacement_semicolon(input, name, initial, value, next_token(input, last)),
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_replacement_semicolon(input: Bytes, name: TokenStart, initial: i64, replacement: i64, token: TokenStart) -> LetI64AssignmentAdmission {
    handle token_matches(input, token, ";") {
        true => let_i64_final_read(input, name, initial, replacement, next_token(input, token)),
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

fn let_i64_final_read(input: Bytes, name: TokenStart, initial: i64, replacement: i64, token: TokenStart) -> LetI64AssignmentAdmission {
    handle token_kind(token) {
        TokenKind::Identifier => handle token_equals(input, name, token) {
            true => LetI64AssignmentAdmission::Value(initial, replacement, token),
            false => LetI64AssignmentAdmission::Rejected,
            _ => LetI64AssignmentAdmission::Rejected,
        },
        _ => LetI64AssignmentAdmission::Rejected,
    }
}

// Recognize the real optional-capture surface without confusing it with the
// ordinary expression-level `move (value)`: only a capture list immediately
// followed by `{` forms a closure. The body remains opaque at this grammar
// gate; full expression parsing owns its contents.
pub fn move_capture_closure_syntax(input: Bytes) -> MoveCaptureClosureSyntax {
    move_capture_start(input, first_token(input))
}

fn move_capture_start(input: Bytes, token: TokenStart) -> MoveCaptureClosureSyntax {
    handle token_matches(input, token, "move") {
        true => move_capture_open(input, next_token(input, token)),
        false => MoveCaptureClosureSyntax::NotMoveClosure,
        _ => MoveCaptureClosureSyntax::Rejected,
    }
}

fn move_capture_open(input: Bytes, token: TokenStart) -> MoveCaptureClosureSyntax {
    handle token_matches(input, token, "(") {
        true => move_capture_items(input, next_token(input, token), 0, MoveCaptureNames::Empty),
        false => MoveCaptureClosureSyntax::NotMoveClosure,
        _ => MoveCaptureClosureSyntax::Rejected,
    }
}

fn move_capture_items(input: Bytes, token: TokenStart, count: i64, names: MoveCaptureNames) -> MoveCaptureClosureSyntax {
    handle token_matches(input, token, ")") {
        true => move_capture_body_open(input, next_token(input, token), count),
        false => handle token_kind(token) {
            TokenKind::Identifier => move_capture_item_name(input, token, next_token(input, token), count, names),
            _ => MoveCaptureClosureSyntax::Rejected,
        },
        _ => MoveCaptureClosureSyntax::Rejected,
    }
}

fn move_capture_item_name(input: Bytes, name: TokenStart, token: TokenStart, count: i64, names: MoveCaptureNames) -> MoveCaptureClosureSyntax {
    handle move_capture_name_insert(input, names, name) {
        MoveCaptureNameInsert::Added(next_names) => move_capture_separator(input, token, count + 1, next_names),
        MoveCaptureNameInsert::Duplicate => MoveCaptureClosureSyntax::Rejected,
        _ => MoveCaptureClosureSyntax::Rejected,
    }
}

fn move_capture_name_insert(input: Bytes, names: MoveCaptureNames, wanted: TokenStart) -> MoveCaptureNameInsert {
    handle names {
        MoveCaptureNames::Empty => MoveCaptureNameInsert::Added(MoveCaptureNames::Node(wanted, false, [])),
        MoveCaptureNames::Node(name, has_tail, tail) => handle token_equals(input, name, wanted) {
            true => MoveCaptureNameInsert::Duplicate,
            false => move_capture_name_insert_tail(input, name, has_tail, tail, wanted),
            _ => MoveCaptureNameInsert::Duplicate,
        },
        _ => MoveCaptureNameInsert::Duplicate,
    }
}

fn move_capture_name_insert_tail(input: Bytes, name: TokenStart, has_tail: Bool, tail: Array<MoveCaptureNames>, wanted: TokenStart) -> MoveCaptureNameInsert {
    handle has_tail {
        true => handle move_capture_name_insert(input, __g1_array_pop_move<MoveCaptureNames>(&mut tail), wanted) {
            MoveCaptureNameInsert::Added(next_tail) => MoveCaptureNameInsert::Added(MoveCaptureNames::Node(name, true, [next_tail])),
            MoveCaptureNameInsert::Duplicate => MoveCaptureNameInsert::Duplicate,
            _ => MoveCaptureNameInsert::Duplicate,
        },
        false => MoveCaptureNameInsert::Added(MoveCaptureNames::Node(name, true, [MoveCaptureNames::Node(wanted, false, [])])),
        _ => MoveCaptureNameInsert::Duplicate,
    }
}

fn move_capture_separator(input: Bytes, token: TokenStart, count: i64, names: MoveCaptureNames) -> MoveCaptureClosureSyntax {
    handle token_matches(input, token, ",") {
        true => move_capture_items_with_tail(input, next_token(input, token), count, names),
        false => handle token_matches(input, token, ")") {
            true => move_capture_body_open(input, next_token(input, token), count),
            false => MoveCaptureClosureSyntax::Rejected,
            _ => MoveCaptureClosureSyntax::Rejected,
        },
        _ => MoveCaptureClosureSyntax::Rejected,
    }
}

fn move_capture_items_with_tail(input: Bytes, token: TokenStart, count: i64, names: MoveCaptureNames) -> MoveCaptureClosureSyntax {
    move_capture_items(input, token, count, names)
}

fn move_capture_body_open(input: Bytes, token: TokenStart, count: i64) -> MoveCaptureClosureSyntax {
    handle token_matches(input, token, "{") {
        true => move_capture_body(input, next_token(input, token), count, 1),
        false => MoveCaptureClosureSyntax::NotMoveClosure,
        _ => MoveCaptureClosureSyntax::Rejected,
    }
}

fn move_capture_body(input: Bytes, token: TokenStart, count: i64, depth: i64) -> MoveCaptureClosureSyntax {
    handle token_matches(input, token, "{") {
        true => move_capture_body(input, next_token(input, token), count, depth + 1),
        false => move_capture_body_non_open(input, token, count, depth),
        _ => MoveCaptureClosureSyntax::Rejected,
    }
}

fn move_capture_body_non_open(input: Bytes, token: TokenStart, count: i64, depth: i64) -> MoveCaptureClosureSyntax {
    handle token_matches(input, token, "}") {
        true => handle depth == 1 {
            true => handle token_kind(next_token(input, token)) {
                TokenKind::End => MoveCaptureClosureSyntax::Captures(count),
                _ => MoveCaptureClosureSyntax::Rejected,
            },
            false => move_capture_body(input, next_token(input, token), count, depth - 1),
            _ => MoveCaptureClosureSyntax::Rejected,
        },
        false => handle token_kind(token) {
            TokenKind::End => MoveCaptureClosureSyntax::Rejected,
            _ => move_capture_body(input, next_token(input, token), count, depth),
        },
        _ => MoveCaptureClosureSyntax::Rejected,
    }
}

// Admit exactly `pub? fn name(left: T, right: T) -> T { return? left OP right ;? }`.
// The returned operator is intentionally syntax-only: type checking and VM
// selection remain in Core/MIR, while this layer proves binder identity,
// declared scalar spelling, and complete source consumption once.
pub fn scalar_binary_arithmetic(input: Bytes, scalar: Text) -> ScalarBinaryAdmission {
    scalar_binary_first(input, first_token(input), scalar)
}

pub fn lower_i64_parameter_binary(input: Bytes, left: i64, right: i64) -> I64ParameterBinaryAdmission {
    handle scalar_binary_arithmetic(input, "i64") {
        ScalarBinaryAdmission::Value(operation) => I64ParameterBinaryAdmission::Value(Expression::ParameterI64Arithmetic(operation, left, right)),
        _ => I64ParameterBinaryAdmission::Rejected,
    }
}

pub fn lower_i64_literal_arithmetic(input: Bytes) -> I64LiteralArithmeticAdmission {
    lower_i64_literal_arithmetic_left(input, first_token(input))
}

fn lower_i64_literal_arithmetic_left(input: Bytes, left: TokenStart) -> I64LiteralArithmeticAdmission {
    handle signed_i64_literal_at(input, left) {
        SignedI64LiteralAdmission::Value(left_value, last) => lower_i64_literal_arithmetic_operator(input, next_token(input, last), left_value),
        _ => I64LiteralArithmeticAdmission::Rejected,
    }
}

fn lower_i64_literal_arithmetic_operator(input: Bytes, token: TokenStart, left: i64) -> I64LiteralArithmeticAdmission {
    handle scalar_arithmetic_operator(input, token) {
        ScalarBinaryAdmission::Value(operation) => lower_i64_literal_arithmetic_right(input, next_token(input, token), operation, left),
        _ => I64LiteralArithmeticAdmission::Rejected,
    }
}

fn lower_i64_literal_arithmetic_right(input: Bytes, token: TokenStart, operation: Arithmetic, left: i64) -> I64LiteralArithmeticAdmission {
    handle signed_i64_literal_at(input, token) {
        SignedI64LiteralAdmission::Value(right, last) => lower_i64_literal_arithmetic_end(input, next_token(input, last), operation, left, right),
        _ => I64LiteralArithmeticAdmission::Rejected,
    }
}

fn lower_i64_literal_arithmetic_end(input: Bytes, token: TokenStart, operation: Arithmetic, left: i64, right: i64) -> I64LiteralArithmeticAdmission {
    handle token_kind(token) {
        TokenKind::End => I64LiteralArithmeticAdmission::Value(Expression::I64Arithmetic(operation, left, right)),
        _ => I64LiteralArithmeticAdmission::Rejected,
    }
}

pub fn lower_i64_literal_comparison(input: Bytes) -> I64LiteralComparisonAdmission {
    lower_i64_literal_comparison_left(input, first_token(input))
}

fn lower_i64_literal_comparison_left(input: Bytes, left: TokenStart) -> I64LiteralComparisonAdmission {
    handle signed_i64_literal_at(input, left) {
        SignedI64LiteralAdmission::Value(left_value, last) => lower_i64_literal_comparison_operator(input, next_token(input, last), left_value),
        _ => I64LiteralComparisonAdmission::Rejected,
    }
}

fn lower_i64_literal_comparison_operator(input: Bytes, token: TokenStart, left: i64) -> I64LiteralComparisonAdmission {
    handle i64_comparison_operator(input, token) {
        I64ComparisonOperator::Value(operation) => lower_i64_literal_comparison_right(input, next_token(input, token), operation, left),
        _ => I64LiteralComparisonAdmission::Rejected,
    }
}

fn lower_i64_literal_comparison_right(input: Bytes, token: TokenStart, operation: Comparison, left: i64) -> I64LiteralComparisonAdmission {
    handle signed_i64_literal_at(input, token) {
        SignedI64LiteralAdmission::Value(right, last) => lower_i64_literal_comparison_end(input, next_token(input, last), operation, left, right),
        _ => I64LiteralComparisonAdmission::Rejected,
    }
}

fn lower_i64_literal_comparison_end(input: Bytes, token: TokenStart, operation: Comparison, left: i64, right: i64) -> I64LiteralComparisonAdmission {
    handle token_kind(token) {
        TokenKind::End => I64LiteralComparisonAdmission::Value(Expression::I64Comparison(operation, left, right)),
        _ => I64LiteralComparisonAdmission::Rejected,
    }
}

enum I64ComparisonOperator { Value(Comparison), Rejected }
fn i64_comparison_operator(input: Bytes, token: TokenStart) -> I64ComparisonOperator {
    handle token_matches(input, token, "==") {
        true => I64ComparisonOperator::Value(Comparison::Equal),
        false => handle token_matches(input, token, "<") {
            true => I64ComparisonOperator::Value(Comparison::Less),
            false => handle token_matches(input, token, ">") {
                true => I64ComparisonOperator::Value(Comparison::Greater),
                _ => I64ComparisonOperator::Rejected,
            },
            _ => I64ComparisonOperator::Rejected,
        },
        _ => I64ComparisonOperator::Rejected,
    }
}

pub fn lower_u32_literal_arithmetic(input: Bytes) -> U32LiteralArithmeticAdmission {
    lower_u32_literal_arithmetic_left(input, first_token(input))
}

// Literal source owns only spelling and decoding.  The hidden static handle
// records a source-local segment identity; later artifact lowering interns it
// into the immutable program-data table.
pub fn lower_static_literal(input: Bytes) -> StaticLiteralAdmission {
    let token = first_token(input);
    handle string_literal_at(input, token) {
        ByteLiteralAdmission::Value(bytes, last) => static_utf8_literal_end(input, token, bytes, last),
        ByteLiteralAdmission::NotLiteral => static_raw_literal_start(input, token),
        _ => StaticLiteralAdmission::Rejected,
    }
}

fn static_utf8_literal_end(input: Bytes, first: TokenStart, bytes: Bytes, last: TokenStart) -> StaticLiteralAdmission {
    handle token_kind(next_token(input, last)) {
        TokenKind::End => StaticLiteralAdmission::Value(Expression::StaticData(types::static_utf8(token_start(first), bytes))),
        _ => StaticLiteralAdmission::Rejected,
    }
}

fn static_raw_literal_start(input: Bytes, token: TokenStart) -> StaticLiteralAdmission {
    handle byte_string_literal_at(input, token) {
        ByteLiteralAdmission::Value(bytes, last) => static_raw_literal_end(input, token, bytes, last),
        _ => StaticLiteralAdmission::Rejected,
    }
}

fn static_raw_literal_end(input: Bytes, first: TokenStart, bytes: Bytes, last: TokenStart) -> StaticLiteralAdmission {
    handle token_kind(next_token(input, last)) {
        TokenKind::End => StaticLiteralAdmission::Value(Expression::StaticData(types::static_raw_u8(token_start(first), bytes))),
        _ => StaticLiteralAdmission::Rejected,
    }
}

fn lower_u32_literal_arithmetic_left(input: Bytes, left: TokenStart) -> U32LiteralArithmeticAdmission {
    handle u32_literal_at(input, left) {
        U32LiteralAdmission::Value(left_value, last) => lower_u32_literal_arithmetic_operator(input, next_token(input, last), left_value),
        _ => U32LiteralArithmeticAdmission::Rejected,
    }
}

fn lower_u32_literal_arithmetic_operator(input: Bytes, token: TokenStart, left: u32) -> U32LiteralArithmeticAdmission {
    handle scalar_arithmetic_operator(input, token) {
        ScalarBinaryAdmission::Value(operation) => lower_u32_literal_arithmetic_right(input, next_token(input, token), operation, left),
        _ => U32LiteralArithmeticAdmission::Rejected,
    }
}

fn lower_u32_literal_arithmetic_right(input: Bytes, token: TokenStart, operation: Arithmetic, left: u32) -> U32LiteralArithmeticAdmission {
    handle u32_literal_at(input, token) {
        U32LiteralAdmission::Value(right, last) => lower_u32_literal_arithmetic_end(input, next_token(input, last), operation, left, right),
        _ => U32LiteralArithmeticAdmission::Rejected,
    }
}

fn lower_u32_literal_arithmetic_end(input: Bytes, token: TokenStart, operation: Arithmetic, left: u32, right: u32) -> U32LiteralArithmeticAdmission {
    handle token_kind(token) {
        TokenKind::End => U32LiteralArithmeticAdmission::Value(Expression::U32Arithmetic(operation, left, right)),
        _ => U32LiteralArithmeticAdmission::Rejected,
    }
}

fn scalar_binary_first(input: Bytes, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_matches(input, token, "pub") {
        true => scalar_binary_fn(input, next_token(input, token), scalar),
        false => scalar_binary_fn(input, token, scalar),
        _ => ScalarBinaryAdmission::Rejected,
    }
}
fn scalar_binary_fn(input: Bytes, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_matches(input, token, "fn") { true => scalar_binary_name(input, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_name(input: Bytes, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_kind(token) { TokenKind::Identifier => scalar_binary_open(input, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_open(input: Bytes, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_matches(input, token, "(") { true => scalar_binary_left(input, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_left(input: Bytes, left: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_kind(left) { TokenKind::Identifier => scalar_binary_left_colon(input, left, next_token(input, left), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_left_colon(input: Bytes, left: TokenStart, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_matches(input, token, ":") { true => scalar_binary_left_type(input, left, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_left_type(input: Bytes, left: TokenStart, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle scalar_type_matches(input, token, scalar) { true => scalar_binary_comma(input, left, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_comma(input: Bytes, left: TokenStart, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_matches(input, token, ",") { true => scalar_binary_right(input, left, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_right(input: Bytes, left: TokenStart, right: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_kind(right) { TokenKind::Identifier => scalar_binary_right_colon(input, left, right, next_token(input, right), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_right_colon(input: Bytes, left: TokenStart, right: TokenStart, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_matches(input, token, ":") { true => scalar_binary_right_type(input, left, right, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_right_type(input: Bytes, left: TokenStart, right: TokenStart, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle scalar_type_matches(input, token, scalar) { true => scalar_binary_parameters_close(input, left, right, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_parameters_close(input: Bytes, left: TokenStart, right: TokenStart, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_matches(input, token, ")") { true => scalar_binary_arrow(input, left, right, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_arrow(input: Bytes, left: TokenStart, right: TokenStart, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle token_matches(input, token, "->") { true => scalar_binary_result(input, left, right, next_token(input, token), scalar), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_result(input: Bytes, left: TokenStart, right: TokenStart, token: TokenStart, scalar: Text) -> ScalarBinaryAdmission {
    handle scalar_type_matches(input, token, scalar) { true => scalar_binary_body_open(input, left, right, next_token(input, token)), _ => ScalarBinaryAdmission::Rejected }
}
// `token_matches` is intentionally called with literal source spellings.
// This keeps the parser on the same direct scanner lowering path as the rest
// of Stage0 while the facade selects which scalar grammar it admits.
fn scalar_type_matches(input: Bytes, token: TokenStart, scalar: Text) -> Bool {
    handle scalar == "usize" {
        true => token_matches(input, token, "usize"),
        false => handle scalar == "u32" { true => token_matches(input, token, "u32"), false => handle scalar == "i64" { true => token_matches(input, token, "i64"), _ => false }, _ => false },
        _ => false,
    }
}
fn scalar_binary_body_open(input: Bytes, left: TokenStart, right: TokenStart, token: TokenStart) -> ScalarBinaryAdmission {
    handle token_matches(input, token, "{") { true => scalar_binary_body(input, left, right, next_token(input, token), false), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_body(input: Bytes, left: TokenStart, right: TokenStart, token: TokenStart, explicit_return: Bool) -> ScalarBinaryAdmission {
    handle token_matches(input, token, "return") {
        true => scalar_binary_body(input, left, right, next_token(input, token), true),
        false => handle token_equals(input, left, token) { true => scalar_binary_operator(input, right, next_token(input, token), explicit_return), _ => ScalarBinaryAdmission::Rejected },
        _ => ScalarBinaryAdmission::Rejected,
    }
}
fn scalar_binary_operator(input: Bytes, right: TokenStart, token: TokenStart, explicit_return: Bool) -> ScalarBinaryAdmission {
    handle scalar_arithmetic_operator(input, token) {
        ScalarBinaryAdmission::Value(operation) => scalar_binary_right_reference(input, right, operation, next_token(input, token), explicit_return),
        _ => ScalarBinaryAdmission::Rejected,
    }
}
fn scalar_binary_right_reference(input: Bytes, right: TokenStart, operation: Arithmetic, token: TokenStart, explicit_return: Bool) -> ScalarBinaryAdmission {
    handle token_equals(input, right, token) { true => scalar_binary_tail(input, operation, next_token(input, token), explicit_return), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_tail(input: Bytes, operation: Arithmetic, token: TokenStart, explicit_return: Bool) -> ScalarBinaryAdmission {
    handle explicit_return { true => handle token_matches(input, token, ";") { true => scalar_binary_close(input, operation, next_token(input, token)), _ => ScalarBinaryAdmission::Rejected }, false => scalar_binary_close(input, operation, token), _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_binary_close(input: Bytes, operation: Arithmetic, token: TokenStart) -> ScalarBinaryAdmission {
    handle token_matches(input, token, "}") { true => handle token_kind(next_token(input, token)) { TokenKind::End => ScalarBinaryAdmission::Value(operation), _ => ScalarBinaryAdmission::Rejected }, _ => ScalarBinaryAdmission::Rejected }
}
fn scalar_arithmetic_operator(input: Bytes, token: TokenStart) -> ScalarBinaryAdmission {
    handle token_matches(input, token, "+") { true => ScalarBinaryAdmission::Value(Arithmetic::Add), false => handle token_matches(input, token, "-") { true => ScalarBinaryAdmission::Value(Arithmetic::Subtract), false => handle token_matches(input, token, "*") { true => ScalarBinaryAdmission::Value(Arithmetic::Multiply), false => handle token_matches(input, token, "/") { true => ScalarBinaryAdmission::Value(Arithmetic::Divide), false => handle token_matches(input, token, "%") { true => ScalarBinaryAdmission::Value(Arithmetic::Remainder), _ => ScalarBinaryAdmission::Rejected }, _ => ScalarBinaryAdmission::Rejected }, _ => ScalarBinaryAdmission::Rejected }, _ => ScalarBinaryAdmission::Rejected }, _ => ScalarBinaryAdmission::Rejected }
}

pub fn has_type(expression: Expression, expected: Type) -> Bool {
    handle admit(expression, expected) {
        BodyAdmission::Value(_) => true,
        BodyAdmission::TypeError => false,
        _ => false,
    }
}

// Admission retains the expression category as well as the type decision, so
// later lowering cannot erase a call into an indistinguishable literal.
pub fn admit(expression: Expression, expected: Type) -> BodyAdmission {
    handle (expression, expected) {
        (Expression::Unit, Type::Unit) => BodyAdmission::Value(BodyKind::Literal),
        (Expression::Bool(_), Type::Bool) => BodyAdmission::Value(BodyKind::Literal),
        (Expression::BoolNot(_), Type::Bool) => BodyAdmission::Value(BodyKind::Boolean),
        (Expression::ParameterBoolNot(_), Type::Bool) => BodyAdmission::Value(BodyKind::ParameterBoolean),
        (Expression::I64(_), Type::I64) => BodyAdmission::Value(BodyKind::Literal),
        (Expression::ParameterI64(_), Type::I64) => BodyAdmission::Value(BodyKind::Parameter),
        (Expression::I64Arithmetic(_, _, _), Type::I64) => BodyAdmission::Value(BodyKind::Arithmetic),
        (Expression::I64Assignment(_, _), Type::I64) => BodyAdmission::Value(BodyKind::Assignment),
        (Expression::ParameterI64Arithmetic(_, _, _), Type::I64) => BodyAdmission::Value(BodyKind::ParameterArithmetic),
        (Expression::I64Comparison(_, _, _), Type::Bool) => BodyAdmission::Value(BodyKind::Comparison),
        (Expression::I64Select(_, _, _), Type::I64) => BodyAdmission::Value(BodyKind::Conditional),
        (Expression::ParameterI64Select(_, _, _), Type::I64) => BodyAdmission::Value(BodyKind::ParameterConditional),
        (Expression::U8(_), Type::U8) => BodyAdmission::Value(BodyKind::Literal),
        (Expression::U8Comparison(_, _, _), Type::Bool) => BodyAdmission::Value(BodyKind::Comparison),
        (Expression::U32(_), Type::U32) => BodyAdmission::Value(BodyKind::Literal),
        (Expression::ParameterU32(_), Type::U32) => BodyAdmission::Value(BodyKind::Parameter),
        (Expression::U32Arithmetic(_, _, _), Type::U32) => BodyAdmission::Value(BodyKind::Arithmetic),
        (Expression::ParameterU32Arithmetic(_, _, _), Type::U32) => BodyAdmission::Value(BodyKind::ParameterArithmetic),
        (Expression::U64(_), Type::U64) => BodyAdmission::Value(BodyKind::Literal),
        (Expression::U64Comparison(_, _, _), Type::Bool) => BodyAdmission::Value(BodyKind::Comparison),
        (Expression::Usize(_), Type::Usize) => BodyAdmission::Value(BodyKind::Literal),
        (Expression::UsizeArithmetic(_, _, _), Type::Usize) => BodyAdmission::Value(BodyKind::Arithmetic),
        (Expression::UsizeComparison(_, _, _), Type::Bool) => BodyAdmission::Value(BodyKind::Comparison),
        (Expression::StaticData(value), Type::StaticData(tag, alignment)) => admit_static_data(value, tag, alignment),
        (Expression::Call1(callable, argument), result) => admit_call(callable, Arguments::One(argument), result),
        (Expression::Call2(callable, first, second), result) => admit_call(callable, Arguments::Two(first, second), result),
        (Expression::ClosureCapture(state, mode, result), expected) => admit_closure_capture(state, mode, result, expected),
        (Expression::PatternTest(_, _), Type::Bool) => BodyAdmission::Value(BodyKind::PatternTest),
        _ => BodyAdmission::TypeError,
    }
}

fn admit_static_data(value: types::StaticData, tag: types::StaticDataTag, alignment: u32) -> BodyAdmission {
    handle types::static_matches_type(&value, tag, alignment) {
        true => BodyAdmission::Value(BodyKind::StaticData),
        false => BodyAdmission::TypeError,
        _ => BodyAdmission::TypeError,
    }
}

fn admit_closure_capture(state: PlaceState, mode: ClosureCaptureMode, result: Type, expected: Type) -> BodyAdmission {
    handle capture_for_closure(state, mode) {
        ClosureCaptureAdmission::Captured(_) => handle types::same(result, expected) {
            true => BodyAdmission::Value(BodyKind::ClosureCapture),
            false => BodyAdmission::TypeError,
            _ => BodyAdmission::TypeError,
        },
        ClosureCaptureAdmission::Rejected => BodyAdmission::TypeError,
        _ => BodyAdmission::TypeError,
    }
}

// Pattern tests are always boolean expressions; their boolean result remains
// source-owned and is not inferred from the admission result.
pub fn evaluate_pattern_test(expression: Expression) -> Bool {
    handle expression {
        Expression::PatternTest(pattern, value) => matches(pattern, value),
        _ => false,
    }
}

fn admit_call(callable: Callable, arguments: Arguments, result: Type) -> BodyAdmission {
    handle accepts_call(callable, arguments, result) {
        true => BodyAdmission::Value(BodyKind::Call),
        false => BodyAdmission::TypeError,
        _ => BodyAdmission::TypeError,
    }
}
