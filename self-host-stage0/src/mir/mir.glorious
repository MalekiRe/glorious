// M26 bootstrap MIR terminal lowering. Full locals, instructions, CFG edges,
// cleanup, optimization, and verification contracts extend this source-owned
// normal-return versus trap boundary.
use core::CoreResult;
use core::is_call;
use core::is_parameter;
use core::is_arithmetic;
use core::is_comparison;
use core::is_conditional;
use core::is_boolean;
use core::is_pattern_test;
use core::i64_arithmetic;
use core::I64ArithmeticValue;
use core::u32_arithmetic;
use core::U32ArithmeticValue;
use core::usize_arithmetic;
use core::UsizeArithmeticValue;
use core::u64_comparison;
use core::U64ComparisonValue;
use core::u8_comparison;
use core::U8ComparisonValue;
use core::usize_comparison;
use core::UsizeComparisonValue;
use core::i64_comparison;
use core::I64ComparisonValue;
use core::i64_select;
use core::I64SelectValue;
use core::call;
use core::CallValue;
use core::i64_literal;
use core::I64LiteralValue;
use core::u32_literal;
use core::U32LiteralValue;
use core::bool_literal;
use core::BoolLiteralValue;
use core::bool_not;
use core::BoolNotValue;
use core::parameter_i64;
use core::ParameterI64Value;
use core::parameter_u32;
use core::ParameterU32Value;
use body::Arithmetic;
use body::Comparison;
use signature::Callable;
use types::Type;
use mir_storage::Slot;
use mir_storage::MoveResult;
use mir_storage::move_out;
use mir_storage::FieldSlots;
use mir_storage::FieldMoveResult;
use mir_storage::move_field;
pub enum Terminator { Return, ParameterReturn, BooleanReturn, ArithmeticReturn, ComparisonReturn, ConditionalReturn, CallReturn, PatternReturn, Trap }

// These compact validators preserve the two invariants which make operation
// identity meaningful: every instruction has exactly one live identity, and
// a returned local is initialized on every incoming branch.
pub enum OperationArenaValidation { Valid, DuplicateLiveIdentity, MissingInstructionIdentity }
pub enum LocalLivenessValidation { Valid, ReturnReadsDeadLocal }

pub fn validate_operation_arena(first_live: Bool, second_live: Bool, instruction_has_identity: Bool) -> OperationArenaValidation {
    handle instruction_has_identity {
        false => OperationArenaValidation::MissingInstructionIdentity,
        true => handle (first_live, second_live) {
            (true, true) => OperationArenaValidation::DuplicateLiveIdentity,
            (false, false) => OperationArenaValidation::MissingInstructionIdentity,
            _ => OperationArenaValidation::Valid,
        },
        _ => OperationArenaValidation::MissingInstructionIdentity,
    }
}

pub fn validate_branch_return_liveness(left_initialized: Bool, right_initialized: Bool, return_reads_local: Bool) -> LocalLivenessValidation {
    handle return_reads_local {
        false => LocalLivenessValidation::Valid,
        true => handle (left_initialized, right_initialized) {
            (true, true) => LocalLivenessValidation::Valid,
            _ => LocalLivenessValidation::ReturnReadsDeadLocal,
        },
        _ => LocalLivenessValidation::ReturnReadsDeadLocal,
    }
}

// The terminal classification above remains useful for generic control-flow
// admission.  This companion form retains the operands required by the first
// executable MIR instruction family.
pub enum I64ArithmeticLowering { Return(Arithmetic, i64, i64), Trap }
pub enum U32ArithmeticLowering { Return(Arithmetic, u32, u32), Trap }
pub enum UsizeArithmeticLowering { Return(Arithmetic, usize, usize), Trap }
pub enum U64ComparisonLowering { Return(Comparison, u64, u64), Trap }
pub enum U8ComparisonLowering { Return(Comparison, u8, u8), Trap }
pub enum UsizeComparisonLowering { Return(Comparison, usize, usize), Trap }
pub enum I64ComparisonLowering { Return(Comparison, i64, i64), Trap }
pub enum I64SelectLowering { Return(Bool, i64, i64), Trap }
pub enum CallLowering { Unary(Callable, Type), Binary(Callable, Type, Type), Trap }
pub enum I64LiteralLowering { Return(i64), Trap }
pub enum U32LiteralLowering { Return(u32), Trap }
pub enum BoolLiteralLowering { Return(Bool), Trap }
pub enum BoolNotLowering { Return(Bool), Trap }
pub enum ParameterI64Lowering { Return(i64), Trap }
pub enum ParameterU32Lowering { Return(u32), Trap }

pub fn lower_i64_arithmetic(value: CoreResult) -> I64ArithmeticLowering {
    handle value {
        CoreResult::Value(core) => lower_i64_arithmetic_value(i64_arithmetic(core)),
        CoreResult::TypeError => I64ArithmeticLowering::Trap,
        _ => I64ArithmeticLowering::Trap,
    }
}

fn lower_i64_arithmetic_value(value: I64ArithmeticValue) -> I64ArithmeticLowering {
    handle value {
        I64ArithmeticValue::Value(operation, left, right) => I64ArithmeticLowering::Return(operation, left, right),
        I64ArithmeticValue::NotArithmetic => I64ArithmeticLowering::Trap,
        _ => I64ArithmeticLowering::Trap,
    }
}

pub fn lower_u32_arithmetic(value: CoreResult) -> U32ArithmeticLowering {
    handle value {
        CoreResult::Value(core) => lower_u32_arithmetic_value(u32_arithmetic(core)),
        _ => U32ArithmeticLowering::Trap,
    }
}

fn lower_u32_arithmetic_value(value: U32ArithmeticValue) -> U32ArithmeticLowering {
    handle value {
        U32ArithmeticValue::Value(operation, left, right) => U32ArithmeticLowering::Return(operation, left, right),
        _ => U32ArithmeticLowering::Trap,
    }
}

pub fn lower_usize_arithmetic(value: CoreResult) -> UsizeArithmeticLowering {
    handle value { CoreResult::Value(core) => lower_usize_arithmetic_value(usize_arithmetic(core)), _ => UsizeArithmeticLowering::Trap }
}
fn lower_usize_arithmetic_value(value: UsizeArithmeticValue) -> UsizeArithmeticLowering {
    handle value { UsizeArithmeticValue::Value(operation, left, right) => UsizeArithmeticLowering::Return(operation, left, right), _ => UsizeArithmeticLowering::Trap }
}

pub fn lower_u64_comparison(value: CoreResult) -> U64ComparisonLowering {
    handle value { CoreResult::Value(core) => lower_u64_comparison_value(u64_comparison(core)), _ => U64ComparisonLowering::Trap }
}
fn lower_u64_comparison_value(value: U64ComparisonValue) -> U64ComparisonLowering {
    handle value { U64ComparisonValue::Value(operation, left, right) => U64ComparisonLowering::Return(operation, left, right), _ => U64ComparisonLowering::Trap }
}
pub fn lower_u8_comparison(value: CoreResult) -> U8ComparisonLowering { handle value { CoreResult::Value(core) => lower_u8_comparison_value(u8_comparison(core)), _ => U8ComparisonLowering::Trap } }
fn lower_u8_comparison_value(value: U8ComparisonValue) -> U8ComparisonLowering { handle value { U8ComparisonValue::Value(operation, left, right) => U8ComparisonLowering::Return(operation, left, right), _ => U8ComparisonLowering::Trap } }
pub fn lower_usize_comparison(value: CoreResult) -> UsizeComparisonLowering { handle value { CoreResult::Value(core) => lower_usize_comparison_value(usize_comparison(core)), _ => UsizeComparisonLowering::Trap } }
fn lower_usize_comparison_value(value: UsizeComparisonValue) -> UsizeComparisonLowering { handle value { UsizeComparisonValue::Value(operation, left, right) => UsizeComparisonLowering::Return(operation, left, right), _ => UsizeComparisonLowering::Trap } }

pub fn lower_i64_comparison(value: CoreResult) -> I64ComparisonLowering {
    handle value {
        CoreResult::Value(core) => lower_i64_comparison_value(i64_comparison(core)),
        CoreResult::TypeError => I64ComparisonLowering::Trap,
        _ => I64ComparisonLowering::Trap,
    }
}

fn lower_i64_comparison_value(value: I64ComparisonValue) -> I64ComparisonLowering {
    handle value {
        I64ComparisonValue::Value(operation, left, right) => I64ComparisonLowering::Return(operation, left, right),
        I64ComparisonValue::NotComparison => I64ComparisonLowering::Trap,
        _ => I64ComparisonLowering::Trap,
    }
}

pub fn lower_i64_select(value: CoreResult) -> I64SelectLowering {
    handle value {
        CoreResult::Value(core) => lower_i64_select_value(i64_select(core)),
        CoreResult::TypeError => I64SelectLowering::Trap,
        _ => I64SelectLowering::Trap,
    }
}

fn lower_i64_select_value(value: I64SelectValue) -> I64SelectLowering {
    handle value {
        I64SelectValue::Value(condition, when_true, when_false) => I64SelectLowering::Return(condition, when_true, when_false),
        I64SelectValue::NotConditional => I64SelectLowering::Trap,
        _ => I64SelectLowering::Trap,
    }
}

pub fn lower_call(value: CoreResult) -> CallLowering {
    handle value {
        CoreResult::Value(core) => lower_call_value(call(core)),
        CoreResult::TypeError => CallLowering::Trap,
        _ => CallLowering::Trap,
    }
}

fn lower_call_value(value: CallValue) -> CallLowering {
    handle value {
        CallValue::Unary(callable, argument) => CallLowering::Unary(callable, argument),
        CallValue::Binary(callable, first, second) => CallLowering::Binary(callable, first, second),
        CallValue::NotCall => CallLowering::Trap,
        _ => CallLowering::Trap,
    }
}

pub fn lower_i64_literal(value: CoreResult) -> I64LiteralLowering { handle value { CoreResult::Value(core) => lower_i64_literal_value(i64_literal(core)), _ => I64LiteralLowering::Trap } }
fn lower_i64_literal_value(value: I64LiteralValue) -> I64LiteralLowering { handle value { I64LiteralValue::Value(number) => I64LiteralLowering::Return(number), _ => I64LiteralLowering::Trap } }

// This typed terminal is intentionally not executable until the G1 backend
// grows the corresponding u32 constant and instruction verifier. Retaining
// it here prevents a later encoder from receiving an erased i64 surrogate.
pub fn lower_u32_literal(value: CoreResult) -> U32LiteralLowering { handle value { CoreResult::Value(core) => lower_u32_literal_value(u32_literal(core)), _ => U32LiteralLowering::Trap } }
fn lower_u32_literal_value(value: U32LiteralValue) -> U32LiteralLowering { handle value { U32LiteralValue::Value(number) => U32LiteralLowering::Return(number), _ => U32LiteralLowering::Trap } }

pub fn lower_bool_literal(value: CoreResult) -> BoolLiteralLowering { handle value { CoreResult::Value(core) => lower_bool_literal_value(bool_literal(core)), _ => BoolLiteralLowering::Trap } }
fn lower_bool_literal_value(value: BoolLiteralValue) -> BoolLiteralLowering { handle value { BoolLiteralValue::Value(boolean) => BoolLiteralLowering::Return(boolean), _ => BoolLiteralLowering::Trap } }

pub fn lower_bool_not(value: CoreResult) -> BoolNotLowering { handle value { CoreResult::Value(core) => lower_bool_not_value(bool_not(core)), _ => BoolNotLowering::Trap } }
fn lower_bool_not_value(value: BoolNotValue) -> BoolNotLowering { handle value { BoolNotValue::Value(boolean) => BoolNotLowering::Return(boolean), _ => BoolNotLowering::Trap } }

pub fn lower_parameter_i64(value: CoreResult) -> ParameterI64Lowering { handle value { CoreResult::Value(core) => lower_parameter_i64_value(parameter_i64(core)), _ => ParameterI64Lowering::Trap } }
fn lower_parameter_i64_value(value: ParameterI64Value) -> ParameterI64Lowering { handle value { ParameterI64Value::Value(number) => ParameterI64Lowering::Return(number), _ => ParameterI64Lowering::Trap } }
pub fn lower_parameter_u32(value: CoreResult) -> ParameterU32Lowering { handle value { CoreResult::Value(core) => lower_parameter_u32_value(parameter_u32(core)), _ => ParameterU32Lowering::Trap } }
fn lower_parameter_u32_value(value: ParameterU32Value) -> ParameterU32Lowering { handle value { ParameterU32Value::Value(number) => ParameterU32Lowering::Return(number), _ => ParameterU32Lowering::Trap } }
pub fn lower(value: CoreResult) -> Terminator {
    handle value {
        CoreResult::Value(core) => handle is_call(core) {
            true => Terminator::CallReturn,
            false => lower_non_call(core),
            _ => Terminator::Trap,
        },
        CoreResult::TypeError => Terminator::Trap,
        _ => Terminator::Trap,
    }
}

fn lower_non_call(core: core::CoreValue) -> Terminator {
    handle is_parameter(core) {
        true => Terminator::ParameterReturn,
        false => lower_non_parameter(core),
        _ => Terminator::Trap,
    }
}

fn lower_non_parameter(core: core::CoreValue) -> Terminator {
    handle is_boolean(core) {
        true => Terminator::BooleanReturn,
        false => lower_non_boolean(core),
        _ => Terminator::Trap,
    }
}

fn lower_non_boolean(core: core::CoreValue) -> Terminator {
    handle is_arithmetic(core) {
        true => Terminator::ArithmeticReturn,
        false => lower_non_arithmetic(core),
        _ => Terminator::Trap,
    }
}

fn lower_non_arithmetic(core: core::CoreValue) -> Terminator {
    handle is_comparison(core) {
        true => Terminator::ComparisonReturn,
        false => lower_non_comparison(core),
        _ => Terminator::Trap,
    }
}

fn lower_non_comparison(core: core::CoreValue) -> Terminator {
    handle is_conditional(core) {
        true => Terminator::ConditionalReturn,
        false => lower_non_conditional(core),
        _ => Terminator::Trap,
    }
}

fn lower_non_conditional(core: core::CoreValue) -> Terminator {
    handle is_pattern_test(core) {
        true => Terminator::PatternReturn,
        false => Terminator::Return,
        _ => Terminator::Trap,
    }
}

// Storage-aware lowering preserves the result of an ownership-consuming read.
// In particular, `Moved` must stay distinct from `Uninitialized` in the
// storage module; MIR only turns either non-value state into an explicit trap
// edge, never into an invented return value.
pub enum StorageLowering {
    ReturnValue(i64, Slot),
    Trap(Slot),
}

pub enum FieldStorageLowering {
    ReturnValue(i64, FieldSlots),
    Trap(FieldSlots),
}

pub fn lower_move(slot: Slot) -> StorageLowering {
    lower_move_result(move_out(slot))
}

fn lower_move_result(result: MoveResult) -> StorageLowering {
    handle result {
        MoveResult::Value(value, post_move) => StorageLowering::ReturnValue(value, post_move),
        MoveResult::Empty(slot) => StorageLowering::Trap(slot),
        _ => StorageLowering::Trap(Slot::Uninitialized),
    }
}

// Field storage follows the same MIR post-state rule as a root move.  The
// aggregate is retained on both normal and trap edges so later cleanup sees
// the selected `Moved` slot and all untouched siblings exactly once.
pub fn lower_move_field(fields: FieldSlots, index: i64) -> FieldStorageLowering {
    lower_move_field_result(move_field(fields, index))
}

fn lower_move_field_result(result: FieldMoveResult) -> FieldStorageLowering {
    handle result {
        FieldMoveResult::Value(value, post_move) => FieldStorageLowering::ReturnValue(value, post_move),
        FieldMoveResult::Empty(post_move) => FieldStorageLowering::Trap(post_move),
        FieldMoveResult::Missing => FieldStorageLowering::Trap(FieldSlots::Empty),
        _ => FieldStorageLowering::Trap(FieldSlots::Empty),
    }
}
