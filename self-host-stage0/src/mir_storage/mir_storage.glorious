// M24 bootstrap storage slot lifecycle.  An unwritten slot and an explicitly
// moved-out slot both contain no readable value, but retain different cleanup
// provenance so later MIR storage events cannot infer a false initialization.
use compiler_support::__g1_array_pop_move;

pub enum Slot { Uninitialized, Value(i64), Moved, Partial(i64) }
pub enum TakeResult { Value(i64), Empty }
pub enum MoveResult { Value(i64, Slot), Empty(Slot) }
pub enum CleanupResult { Dropped(i64), Skipped }
pub enum ReplaceResult { Written(Slot), Replaced(i64, Slot) }
pub enum FieldSlots { Empty, Node(Slot, Bool, Array<FieldSlots>) }
pub enum FieldMoveResult { Value(i64, FieldSlots), Empty(FieldSlots), Missing }
pub enum NestedStoragePath { Field(i64, Bool, Array<NestedStoragePath>) }
pub enum NestedFieldSlots { Empty, Node(Slot, Bool, Array<NestedFieldSlots>, Bool, Array<NestedFieldSlots>) }
pub enum NestedFieldMoveResult { Value(i64, NestedFieldSlots), Empty(NestedFieldSlots), Missing }
enum NestedLiveCheck { Live(NestedFieldSlots), NotLive(NestedFieldSlots) }
pub fn empty() -> Slot { Slot::Uninitialized }
pub fn write(slot: Slot, value: i64) -> Slot { handle slot { Slot::Uninitialized => Slot::Value(value), Slot::Moved => Slot::Value(value), Slot::Partial(_) => Slot::Value(value), Slot::Value(_) => Slot::Value(value), _ => Slot::Value(value) } }
pub fn take(slot: Slot) -> TakeResult { handle slot { Slot::Uninitialized => TakeResult::Empty, Slot::Moved => TakeResult::Empty, Slot::Partial(_) => TakeResult::Empty, Slot::Value(value) => TakeResult::Value(value), _ => TakeResult::Empty } }

// Storage cleanup is driven by the explicit slot state, never by the type or
// a reconstructed source place. An unwritten/moved slot has no resident value
// to drop; overwriting a live slot retains that displaced value as an explicit
// event for later MIR cleanup ordering.
pub fn cleanup(slot: Slot) -> CleanupResult {
    handle slot {
        Slot::Value(value) => CleanupResult::Dropped(value),
        Slot::Uninitialized => CleanupResult::Skipped,
        Slot::Moved => CleanupResult::Skipped,
        Slot::Partial(_) => CleanupResult::Skipped,
        _ => CleanupResult::Skipped,
    }
}

pub fn replace(slot: Slot, value: i64) -> ReplaceResult {
    handle slot {
        Slot::Value(previous) => ReplaceResult::Replaced(previous, Slot::Value(value)),
        Slot::Uninitialized => ReplaceResult::Written(Slot::Value(value)),
        Slot::Moved => ReplaceResult::Written(Slot::Value(value)),
        Slot::Partial(_) => ReplaceResult::Written(Slot::Value(value)),
        _ => ReplaceResult::Written(Slot::Value(value)),
    }
}

// A MIR move exposes both the moved payload and the replacement slot. This
// keeps the post-state explicit so later place/projection storage cannot
// accidentally keep a moved value live.
pub fn move_out(slot: Slot) -> MoveResult {
    handle slot {
        Slot::Uninitialized => MoveResult::Empty(Slot::Uninitialized),
        Slot::Moved => MoveResult::Empty(Slot::Moved),
        Slot::Partial(value) => MoveResult::Empty(Slot::Partial(value)),
        Slot::Value(value) => MoveResult::Value(value, Slot::Moved),
        _ => MoveResult::Empty(Slot::Uninitialized),
    }
}

// Reinitialization consumes the explicit post-move slot rather than creating
// a fresh slot identity. This is the compact precursor to MIR's storage
// event bookkeeping.
pub fn write_after_move(result: MoveResult, value: i64) -> Slot {
    handle result {
        MoveResult::Value(_, slot) => write(slot, value),
        MoveResult::Empty(slot) => write(slot, value),
        _ => Slot::Uninitialized,
    }
}

pub fn is_empty(slot: Slot) -> Bool {
    handle slot {
        Slot::Uninitialized => true,
        Slot::Moved => true,
        Slot::Value(_) => false,
        Slot::Partial(_) => false,
        _ => false,
    }
}

pub fn was_moved(slot: Slot) -> Bool {
    handle slot { Slot::Moved => true, Slot::Partial(_) => true, Slot::Uninitialized => false, Slot::Value(_) => false, _ => false }
}

pub fn empty_fields() -> FieldSlots { FieldSlots::Empty }
pub fn single_field(slot: Slot) -> FieldSlots { FieldSlots::Node(slot, false, []) }
pub fn prepend_field(slot: Slot, tail: FieldSlots) -> FieldSlots { FieldSlots::Node(slot, true, [tail]) }

// Field storage mirrors PlaceFlow's projection rule: moving one initialized
// slot does not erase its siblings, but the returned aggregate records the
// exact `Moved` post-state for that one selected field.
pub fn move_field(value: FieldSlots, index: i64) -> FieldMoveResult {
    handle index < 0 {
        true => FieldMoveResult::Missing,
        false => move_field_nonnegative(value, index),
        _ => FieldMoveResult::Missing,
    }
}

fn move_field_nonnegative(value: FieldSlots, index: i64) -> FieldMoveResult {
    handle value {
        FieldSlots::Empty => FieldMoveResult::Missing,
        FieldSlots::Node(slot, has_tail, tail) => handle index == 0 {
            true => move_field_head(move_out(slot), has_tail, tail),
            false => move_field_tail(slot, has_tail, tail, index),
            _ => FieldMoveResult::Missing,
        },
        _ => FieldMoveResult::Missing,
    }
}

fn move_field_head(result: MoveResult, has_tail: Bool, tail: Array<FieldSlots>) -> FieldMoveResult {
    handle result {
        MoveResult::Value(value, post) => FieldMoveResult::Value(value, FieldSlots::Node(post, has_tail, tail)),
        MoveResult::Empty(post) => FieldMoveResult::Empty(FieldSlots::Node(post, has_tail, tail)),
        _ => FieldMoveResult::Missing,
    }
}

fn move_field_tail(slot: Slot, has_tail: Bool, tail: Array<FieldSlots>, index: i64) -> FieldMoveResult {
    handle has_tail {
        true => rebuild_field_move(slot, move_field_nonnegative(__g1_array_pop_move<FieldSlots>(&mut tail), index - 1)),
        false => FieldMoveResult::Missing,
        _ => FieldMoveResult::Missing,
    }
}

fn rebuild_field_move(slot: Slot, result: FieldMoveResult) -> FieldMoveResult {
    handle result {
        FieldMoveResult::Value(value, tail) => FieldMoveResult::Value(value, FieldSlots::Node(slot, true, [tail])),
        FieldMoveResult::Empty(tail) => FieldMoveResult::Empty(FieldSlots::Node(slot, true, [tail])),
        FieldMoveResult::Missing => FieldMoveResult::Missing,
        _ => FieldMoveResult::Missing,
    }
}

// Assignment reinitializes exactly one selected field. An invalid projection
// preserves the aggregate rather than appending an invented slot.
pub fn write_field(value: FieldSlots, index: i64, replacement: i64) -> FieldSlots {
    handle index < 0 {
        true => value,
        false => write_field_nonnegative(value, index, replacement),
        _ => value,
    }
}

fn write_field_nonnegative(value: FieldSlots, index: i64, replacement: i64) -> FieldSlots {
    handle value {
        FieldSlots::Empty => FieldSlots::Empty,
        FieldSlots::Node(slot, has_tail, tail) => handle index == 0 {
            true => FieldSlots::Node(write(slot, replacement), has_tail, tail),
            false => write_field_tail(slot, has_tail, tail, index, replacement),
            _ => FieldSlots::Node(slot, has_tail, tail),
        },
        _ => FieldSlots::Empty,
    }
}

fn write_field_tail(slot: Slot, has_tail: Bool, tail: Array<FieldSlots>, index: i64, replacement: i64) -> FieldSlots {
    handle has_tail {
        true => FieldSlots::Node(slot, true, [write_field_nonnegative(__g1_array_pop_move<FieldSlots>(&mut tail), index - 1, replacement)]),
        false => FieldSlots::Node(slot, false, tail),
        _ => FieldSlots::Node(slot, has_tail, tail),
    }
}

// A nested source projection needs a path-specific post-state. `Partial`
// records that an ancestor itself was not moved but one of its descendants
// was; it permits sibling projection access while rejecting a later whole
// ancestor move. The recursive layout is Array-indirected for bootstrap size
// finiteness, exactly like the ownership tree in PlaceFlow.
pub fn storage_path_field(index: i64) -> NestedStoragePath { NestedStoragePath::Field(index, false, []) }
pub fn storage_path_then(index: i64, tail: NestedStoragePath) -> NestedStoragePath { NestedStoragePath::Field(index, true, [tail]) }
pub fn nested_empty_fields() -> NestedFieldSlots { NestedFieldSlots::Empty }
pub fn nested_single_field(slot: Slot) -> NestedFieldSlots { NestedFieldSlots::Node(slot, false, [], false, []) }
pub fn nested_prepend_field(slot: Slot, children: NestedFieldSlots, tail: NestedFieldSlots) -> NestedFieldSlots { NestedFieldSlots::Node(slot, true, [children], true, [tail]) }

pub fn move_nested_field(value: NestedFieldSlots, path: NestedStoragePath) -> NestedFieldMoveResult {
    handle path {
        NestedStoragePath::Field(index, has_tail, tail) => handle index < 0 {
            true => NestedFieldMoveResult::Missing,
            false => move_nested_field_at(value, index, has_tail, tail),
            _ => NestedFieldMoveResult::Missing,
        },
        _ => NestedFieldMoveResult::Missing,
    }
}

fn move_nested_field_at(value: NestedFieldSlots, index: i64, has_path_tail: Bool, path_tail: Array<NestedStoragePath>) -> NestedFieldMoveResult {
    handle value {
        NestedFieldSlots::Empty => NestedFieldMoveResult::Missing,
        NestedFieldSlots::Node(slot, has_children, children, has_sibling, sibling) => handle index == 0 {
            true => move_nested_selected(slot, has_children, children, has_sibling, sibling, has_path_tail, path_tail),
            false => handle has_sibling {
                true => rebuild_nested_sibling_move(slot, has_children, children, move_nested_field_at(__g1_array_pop_move<NestedFieldSlots>(&mut sibling), index - 1, has_path_tail, path_tail)),
                false => NestedFieldMoveResult::Missing,
                _ => NestedFieldMoveResult::Missing,
            },
            _ => NestedFieldMoveResult::Missing,
        },
        _ => NestedFieldMoveResult::Missing,
    }
}

fn move_nested_selected(slot: Slot, has_children: Bool, children: Array<NestedFieldSlots>, has_sibling: Bool, sibling: Array<NestedFieldSlots>, has_path_tail: Bool, path_tail: Array<NestedStoragePath>) -> NestedFieldMoveResult {
    handle has_path_tail {
        false => move_nested_head(move_out(slot), has_children, children, has_sibling, sibling),
        true => move_nested_child(slot, has_children, children, has_sibling, sibling, path_tail),
        _ => NestedFieldMoveResult::Missing,
    }
}

fn move_nested_head(result: MoveResult, has_children: Bool, children: Array<NestedFieldSlots>, has_sibling: Bool, sibling: Array<NestedFieldSlots>) -> NestedFieldMoveResult {
    handle result {
        MoveResult::Value(value, post) => NestedFieldMoveResult::Value(value, NestedFieldSlots::Node(post, has_children, children, has_sibling, sibling)),
        MoveResult::Empty(post) => NestedFieldMoveResult::Empty(NestedFieldSlots::Node(post, has_children, children, has_sibling, sibling)),
        _ => NestedFieldMoveResult::Missing,
    }
}

fn move_nested_child(slot: Slot, has_children: Bool, children: Array<NestedFieldSlots>, has_sibling: Bool, sibling: Array<NestedFieldSlots>, path_tail: Array<NestedStoragePath>) -> NestedFieldMoveResult {
    handle nested_parent_live(slot) {
        true => handle has_children {
            true => rebuild_nested_child_move(slot, has_sibling, sibling, move_nested_field(__g1_array_pop_move<NestedFieldSlots>(&mut children), __g1_array_pop_move<NestedStoragePath>(&mut path_tail))),
            false => NestedFieldMoveResult::Missing,
            _ => NestedFieldMoveResult::Missing,
        },
        false => NestedFieldMoveResult::Empty(NestedFieldSlots::Node(slot, has_children, children, has_sibling, sibling)),
        _ => NestedFieldMoveResult::Missing,
    }
}

fn nested_parent_live(slot: Slot) -> Bool {
    handle slot {
        Slot::Value(_) => true,
        Slot::Partial(_) => true,
        Slot::Uninitialized => false,
        Slot::Moved => false,
        _ => false,
    }
}

fn partial_slot(slot: Slot) -> Slot {
    handle slot {
        Slot::Value(value) => Slot::Partial(value),
        Slot::Partial(value) => Slot::Partial(value),
        Slot::Uninitialized => Slot::Uninitialized,
        Slot::Moved => Slot::Moved,
        _ => Slot::Moved,
    }
}

fn rebuild_nested_child_move(slot: Slot, has_sibling: Bool, sibling: Array<NestedFieldSlots>, result: NestedFieldMoveResult) -> NestedFieldMoveResult {
    handle result {
        NestedFieldMoveResult::Value(value, children) => NestedFieldMoveResult::Value(value, NestedFieldSlots::Node(partial_slot(slot), true, [children], has_sibling, sibling)),
        NestedFieldMoveResult::Empty(children) => NestedFieldMoveResult::Empty(NestedFieldSlots::Node(slot, true, [children], has_sibling, sibling)),
        NestedFieldMoveResult::Missing => NestedFieldMoveResult::Missing,
        _ => NestedFieldMoveResult::Missing,
    }
}

fn rebuild_nested_sibling_move(slot: Slot, has_children: Bool, children: Array<NestedFieldSlots>, result: NestedFieldMoveResult) -> NestedFieldMoveResult {
    handle result {
        NestedFieldMoveResult::Value(value, sibling) => NestedFieldMoveResult::Value(value, NestedFieldSlots::Node(slot, has_children, children, true, [sibling])),
        NestedFieldMoveResult::Empty(sibling) => NestedFieldMoveResult::Empty(NestedFieldSlots::Node(slot, has_children, children, true, [sibling])),
        NestedFieldMoveResult::Missing => NestedFieldMoveResult::Missing,
        _ => NestedFieldMoveResult::Missing,
    }
}

// Reinitializing a nested field preserves the existing tree and restores a
// `Partial(original)` ancestor to `Value(original)` exactly when every child
// is live again. This avoids both a false whole-place move rejection after a
// complete repair and an unsound restoration while another descendant remains
// moved.
pub fn write_nested_field(value: NestedFieldSlots, path: NestedStoragePath, replacement: i64) -> NestedFieldSlots {
    handle path {
        NestedStoragePath::Field(index, has_tail, tail) => handle index < 0 {
            true => value,
            false => write_nested_field_at(value, index, has_tail, tail, replacement),
            _ => value,
        },
        _ => value,
    }
}

fn write_nested_field_at(value: NestedFieldSlots, index: i64, has_path_tail: Bool, path_tail: Array<NestedStoragePath>, replacement: i64) -> NestedFieldSlots {
    handle value {
        NestedFieldSlots::Empty => NestedFieldSlots::Empty,
        NestedFieldSlots::Node(slot, has_children, children, has_sibling, sibling) => handle index == 0 {
            true => handle has_path_tail {
                false => NestedFieldSlots::Node(write(slot, replacement), has_children, children, has_sibling, sibling),
                true => write_nested_child(slot, has_children, children, has_sibling, sibling, path_tail, replacement),
                _ => NestedFieldSlots::Node(slot, has_children, children, has_sibling, sibling),
            },
            false => write_nested_sibling(slot, has_children, children, has_sibling, sibling, index, has_path_tail, path_tail, replacement),
            _ => NestedFieldSlots::Node(slot, has_children, children, has_sibling, sibling),
        },
        _ => NestedFieldSlots::Empty,
    }
}

fn write_nested_child(slot: Slot, has_children: Bool, children: Array<NestedFieldSlots>, has_sibling: Bool, sibling: Array<NestedFieldSlots>, path_tail: Array<NestedStoragePath>, replacement: i64) -> NestedFieldSlots {
    handle has_children {
        true => rebuild_written_nested_parent(slot, write_nested_field(__g1_array_pop_move<NestedFieldSlots>(&mut children), __g1_array_pop_move<NestedStoragePath>(&mut path_tail), replacement), has_sibling, sibling),
        false => NestedFieldSlots::Node(slot, false, children, has_sibling, sibling),
        _ => NestedFieldSlots::Node(slot, has_children, children, has_sibling, sibling),
    }
}

fn write_nested_sibling(slot: Slot, has_children: Bool, children: Array<NestedFieldSlots>, has_sibling: Bool, sibling: Array<NestedFieldSlots>, index: i64, has_path_tail: Bool, path_tail: Array<NestedStoragePath>, replacement: i64) -> NestedFieldSlots {
    handle has_sibling {
        true => NestedFieldSlots::Node(slot, has_children, children, true, [write_nested_field_at(__g1_array_pop_move<NestedFieldSlots>(&mut sibling), index - 1, has_path_tail, path_tail, replacement)]),
        false => NestedFieldSlots::Node(slot, has_children, children, false, sibling),
        _ => NestedFieldSlots::Node(slot, has_children, children, has_sibling, sibling),
    }
}

fn rebuild_written_nested_parent(slot: Slot, children: NestedFieldSlots, has_sibling: Bool, sibling: Array<NestedFieldSlots>) -> NestedFieldSlots {
    handle nested_live_check(children) {
        NestedLiveCheck::Live(children) => NestedFieldSlots::Node(restore_partial_slot(slot), true, [children], has_sibling, sibling),
        NestedLiveCheck::NotLive(children) => NestedFieldSlots::Node(slot, true, [children], has_sibling, sibling),
        _ => NestedFieldSlots::Empty,
    }
}

fn restore_partial_slot(slot: Slot) -> Slot {
    handle slot {
        Slot::Partial(value) => Slot::Value(value),
        Slot::Value(value) => Slot::Value(value),
        Slot::Uninitialized => Slot::Uninitialized,
        Slot::Moved => Slot::Moved,
        _ => Slot::Moved,
    }
}

fn nested_live_check(value: NestedFieldSlots) -> NestedLiveCheck {
    handle value {
        NestedFieldSlots::Empty => NestedLiveCheck::Live(NestedFieldSlots::Empty),
        NestedFieldSlots::Node(slot, has_children, children, has_sibling, sibling) => rebuild_nested_live_check(slot, has_children, children, has_sibling, sibling),
        _ => NestedLiveCheck::NotLive(NestedFieldSlots::Empty),
    }
}

fn rebuild_nested_live_check(slot: Slot, has_children: Bool, children: Array<NestedFieldSlots>, has_sibling: Bool, sibling: Array<NestedFieldSlots>) -> NestedLiveCheck {
    handle nested_children_live_check(has_children, children) {
        NestedLiveCheck::Live(children) => rebuild_nested_live_sibling(slot, has_children, children, true, has_sibling, sibling),
        NestedLiveCheck::NotLive(children) => rebuild_nested_live_sibling(slot, has_children, children, false, has_sibling, sibling),
        _ => NestedLiveCheck::NotLive(NestedFieldSlots::Empty),
    }
}

fn nested_children_live_check(has_children: Bool, children: Array<NestedFieldSlots>) -> NestedLiveCheck {
    handle has_children {
        true => nested_live_check(__g1_array_pop_move<NestedFieldSlots>(&mut children)),
        false => NestedLiveCheck::Live(NestedFieldSlots::Empty),
        _ => NestedLiveCheck::NotLive(NestedFieldSlots::Empty),
    }
}

fn rebuild_nested_live_sibling(slot: Slot, has_children: Bool, children: NestedFieldSlots, children_live: Bool, has_sibling: Bool, sibling: Array<NestedFieldSlots>) -> NestedLiveCheck {
    handle nested_sibling_live_check(has_sibling, sibling) {
        NestedLiveCheck::Live(sibling) => nested_live_result(slot, has_children, children, children_live, has_sibling, sibling, true),
        NestedLiveCheck::NotLive(sibling) => nested_live_result(slot, has_children, children, children_live, has_sibling, sibling, false),
        _ => NestedLiveCheck::NotLive(NestedFieldSlots::Empty),
    }
}

fn nested_sibling_live_check(has_sibling: Bool, sibling: Array<NestedFieldSlots>) -> NestedLiveCheck {
    handle has_sibling {
        true => nested_live_check(__g1_array_pop_move<NestedFieldSlots>(&mut sibling)),
        false => NestedLiveCheck::Live(NestedFieldSlots::Empty),
        _ => NestedLiveCheck::NotLive(NestedFieldSlots::Empty),
    }
}

fn nested_live_result(slot: Slot, has_children: Bool, children: NestedFieldSlots, children_live: Bool, has_sibling: Bool, sibling: NestedFieldSlots, sibling_live: Bool) -> NestedLiveCheck {
    handle slot_is_live(slot) {
        true => handle (children_live, sibling_live) {
            (true, true) => NestedLiveCheck::Live(rebuild_checked_nested_slot(slot, has_children, children, has_sibling, sibling)),
            _ => NestedLiveCheck::NotLive(rebuild_checked_nested_slot(slot, has_children, children, has_sibling, sibling)),
        },
        false => NestedLiveCheck::NotLive(rebuild_checked_nested_slot(slot, has_children, children, has_sibling, sibling)),
        _ => NestedLiveCheck::NotLive(rebuild_checked_nested_slot(slot, has_children, children, has_sibling, sibling)),
    }
}

fn slot_is_live(slot: Slot) -> Bool {
    handle slot { Slot::Value(_) => true, Slot::Partial(_) => false, Slot::Uninitialized => false, Slot::Moved => false, _ => false }
}

fn rebuild_checked_nested_slot(slot: Slot, has_children: Bool, children: NestedFieldSlots, has_sibling: Bool, sibling: NestedFieldSlots) -> NestedFieldSlots {
    handle has_children {
        true => handle has_sibling {
            true => NestedFieldSlots::Node(slot, true, [children], true, [sibling]),
            false => NestedFieldSlots::Node(slot, true, [children], false, []),
            _ => NestedFieldSlots::Empty,
        },
        false => handle has_sibling {
            true => NestedFieldSlots::Node(slot, false, [], true, [sibling]),
            false => NestedFieldSlots::Node(slot, false, [], false, []),
            _ => NestedFieldSlots::Empty,
        },
        _ => NestedFieldSlots::Empty,
    }
}
