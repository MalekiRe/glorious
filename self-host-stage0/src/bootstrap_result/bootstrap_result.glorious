// Result and Option are ordinary source types. Decision/control helpers will
// be layered on these values only after the manifest-bound branch primitive is
// admitted with its full authority and verifier contract.
pub enum Option<T> {
    Some(T),
    None,
}

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

pub fn some_i64() -> Option<i64> {
    Option::Some(1)
}

pub fn smoke() -> i64 {
    let proof = some_i64();
    0
}
