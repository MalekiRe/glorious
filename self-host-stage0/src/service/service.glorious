fn compile_usize_comparison_right_reference(bytes: Bytes, right: TokenStart, operation: Comparison, reference: TokenStart, left_value: usize, right_value: usize, explicit_return: Bool) -> Execution { handle token_equals(bytes, right, reference) { true => compile_usize_comparison_tail(bytes, operation, next_token(bytes, reference), left_value, right_value, explicit_return), _ => Execution::Faulted } }
fn compile_usize_comparison_tail(bytes: Bytes, operation: Comparison, tail: TokenStart, left_value: usize, right_value: usize, explicit_return: Bool) -> Execution { handle explicit_return { true => handle token_matches(bytes, tail, ";") { true => compile_usize_comparison_close(bytes, operation, next_token(bytes, tail), left_value, right_value), _ => Execution::Faulted }, false => compile_usize_comparison_close(bytes, operation, tail, left_value, right_value), _ => Execution::Faulted } }
fn compile_usize_comparison_close(bytes: Bytes, operation: Comparison, close: TokenStart, left_value: usize, right_value: usize) -> Execution { handle token_matches(bytes, close, "}") { true => handle token_kind(next_token(bytes, close)) { TokenKind::End => compile_usize_comparison(operation, left_value, right_value, Type::Bool), _ => Execution::Faulted }, _ => Execution::Faulted } }

fn compile_u32_identity_first(bytes: Bytes, first: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, first, "pub") {
        true => compile_u32_identity_fn(bytes, next_token(bytes, first), argument),
        false => compile_u32_identity_fn(bytes, first, argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_fn(bytes: Bytes, function: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, function, "fn") {
        true => compile_u32_identity_name(bytes, next_token(bytes, function), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_name(bytes: Bytes, name: TokenStart, argument: u32) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_u32_identity_open(bytes, next_token(bytes, name), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_open(bytes: Bytes, open: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, open, "(") {
        true => compile_u32_identity_binder(bytes, next_token(bytes, open), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_binder(bytes: Bytes, binder: TokenStart, argument: u32) -> Execution {
    handle token_kind(binder) {
        TokenKind::Identifier => compile_u32_identity_colon(bytes, binder, next_token(bytes, binder), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_colon(bytes: Bytes, binder: TokenStart, colon: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, colon, ":") {
        true => compile_u32_identity_type(bytes, binder, next_token(bytes, colon), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_type(bytes: Bytes, binder: TokenStart, parameter_type: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, parameter_type, "u32") {
        true => compile_u32_identity_close(bytes, binder, next_token(bytes, parameter_type), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_close(bytes: Bytes, binder: TokenStart, close: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, close, ")") {
        true => compile_u32_identity_arrow(bytes, binder, next_token(bytes, close), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_arrow(bytes: Bytes, binder: TokenStart, arrow: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, arrow, "->") {
        true => compile_u32_identity_result(bytes, binder, next_token(bytes, arrow), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_result(bytes: Bytes, binder: TokenStart, result: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, result, "u32") {
        true => compile_u32_identity_body_open(bytes, binder, next_token(bytes, result), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_body_open(bytes: Bytes, binder: TokenStart, open: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, open, "{") {
        true => compile_u32_identity_body(bytes, binder, next_token(bytes, open), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_body(bytes: Bytes, binder: TokenStart, reference: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, reference, "return") {
        true => compile_u32_identity_return_reference(bytes, binder, next_token(bytes, reference), argument),
        false => compile_u32_identity_reference(bytes, binder, reference, argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_reference(bytes: Bytes, binder: TokenStart, reference: TokenStart, argument: u32) -> Execution {
    handle token_equals(bytes, binder, reference) {
        true => compile_u32_identity_close_body(bytes, next_token(bytes, reference), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_return_reference(bytes: Bytes, binder: TokenStart, reference: TokenStart, argument: u32) -> Execution {
    handle token_equals(bytes, binder, reference) {
        true => compile_u32_identity_semicolon(bytes, next_token(bytes, reference), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_semicolon(bytes: Bytes, semicolon: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, semicolon, ";") {
        true => compile_u32_identity_close_body(bytes, next_token(bytes, semicolon), argument),
        _ => Execution::Faulted,
    }
}

fn compile_u32_identity_close_body(bytes: Bytes, close: TokenStart, argument: u32) -> Execution {
    handle token_matches(bytes, close, "}") {
        true => handle token_kind(next_token(bytes, close)) {
            TokenKind::End => compile_u32_identity_call(argument, Type::U32),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

// Parameter-reference declarations retain their source-owned binder check;
// only after that check succeeds may the supplied invocation value become the
// entry argument for the parameterized G1 callee.
pub fn compile_source_i64_identity_function_entry(input: SourceInput, argument: i64) -> ArtifactEmission {
    handle compile_source_i64_identity_function(input, argument) {
        Execution::Returned(_) => emit_g1_i64_identity_call(argument),
        _ => ArtifactEmission::Rejected,
    }
}

// The first two-parameter source body. This exact bootstrap production keeps
// both binder/reference relationships source-owned, then uses the ordinary
// two-argument typed call lowering for execution.
pub fn compile_source_i64_add_function(input: SourceInput, left_value: i64, right_value: i64) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_i64_add_function(input, left_value, right_value),
        _ => Execution::Faulted,
    }
}

// The binary-body parser is representation-independent of the callable name:
// it selects the operation from the source token, so the same verified route
// covers addition, subtraction, multiplication, and division.
pub fn compile_source_i64_binary_function(input: SourceInput, left_value: i64, right_value: i64) -> Execution {
    compile_source_i64_add_function(input, left_value, right_value)
}

// The two binder values stay explicit at the service boundary. Once the
// source declaration has proven that its body is an admitted binary operation
// over those exact binders, lower that operation to the canonical primitive
// artifact instead of publishing the interpreter result.
pub fn compile_source_i64_binary_function_entry(input: SourceInput, left_value: i64, right_value: i64) -> ArtifactEmission {
    // Retain the source-owned immutable view once: the declaration verifier
    // consumes `input`, while emission only needs this already-admitted byte
    // cursor and must not re-request the same view.
    let input_bytes = source::bytes(input);
    handle compile_source_i64_binary_function(input, left_value, right_value) {
        Execution::Returned(_) => emit_admitted_i64_binary_function(input_bytes, left_value, right_value),
        _ => ArtifactEmission::Rejected,
    }
}

// The artifact path shares M19's declaration proof with the `usize` service
// route.  This removes the former second, weaker body scan between source
// admission and G1 emission: the selected opcode now comes from the same
// binder-identity and explicit-return validation that accepted the function.
fn emit_admitted_i64_binary_function(input: Bytes, left: i64, right: i64) -> ArtifactEmission {
    handle scalar_binary_arithmetic(input, "i64") {
        ScalarBinaryAdmission::Value(Arithmetic::Add) => emit_g1_i64_binary_call(G1I64Arithmetic::Add, left, right),
        ScalarBinaryAdmission::Value(Arithmetic::Subtract) => emit_g1_i64_binary_call(G1I64Arithmetic::Subtract, left, right),
        ScalarBinaryAdmission::Value(Arithmetic::Multiply) => emit_g1_i64_binary_call(G1I64Arithmetic::Multiply, left, right),
        ScalarBinaryAdmission::Value(Arithmetic::Divide) => handle right == 0 { true => ArtifactEmission::Rejected, false => emit_g1_i64_binary_call(G1I64Arithmetic::Divide, left, right), _ => ArtifactEmission::Rejected },
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_admitted_i64_binary_function_entry(input_bytes: Bytes, token: TokenStart, left_value: i64, right_value: i64) -> ArtifactEmission {
    handle token_matches(input_bytes, token, "{") {
        true => compile_admitted_i64_binary_function_left(input_bytes, next_token(input_bytes, token), left_value, right_value),
        false => handle token_kind(token) {
            TokenKind::End => ArtifactEmission::Rejected,
            _ => compile_admitted_i64_binary_function_entry(input_bytes, next_token(input_bytes, token), left_value, right_value),
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_admitted_i64_binary_function_left(input_bytes: Bytes, left: TokenStart, left_value: i64, right_value: i64) -> ArtifactEmission {
    handle token_kind(left) {
        TokenKind::Identifier => compile_admitted_i64_binary_function_operator(input_bytes, next_token(input_bytes, left), left_value, right_value),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_admitted_i64_binary_function_operator(input_bytes: Bytes, operator: TokenStart, left_value: i64, right_value: i64) -> ArtifactEmission {
    let right = next_token(input_bytes, operator);
    handle token_kind(right) {
        TokenKind::Identifier => compile_admitted_i64_binary_function_close(input_bytes, operator, next_token(input_bytes, right), left_value, right_value),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_admitted_i64_binary_function_close(input_bytes: Bytes, operator: TokenStart, close: TokenStart, left_value: i64, right_value: i64) -> ArtifactEmission {
    handle token_matches(input_bytes, close, "}") {
        true => handle token_kind(next_token(input_bytes, close)) {
            TokenKind::End => emit_source_i64_binary_call_operator(input_bytes, operator, left_value, right_value),
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn emit_source_i64_binary_call_operator(input_bytes: Bytes, operator: TokenStart, left: i64, right: i64) -> ArtifactEmission {
    handle token_matches(input_bytes, operator, "+") {
        true => emit_g1_i64_binary_call(G1I64Arithmetic::Add, left, right),
        false => handle token_matches(input_bytes, operator, "-") {
            true => emit_g1_i64_binary_call(G1I64Arithmetic::Subtract, left, right),
            false => handle token_matches(input_bytes, operator, "*") {
                true => emit_g1_i64_binary_call(G1I64Arithmetic::Multiply, left, right),
                false => handle token_matches(input_bytes, operator, "/") {
                    true => handle right == 0 { true => ArtifactEmission::Rejected, false => emit_g1_i64_binary_call(G1I64Arithmetic::Divide, left, right), _ => ArtifactEmission::Rejected },
                    _ => ArtifactEmission::Rejected,
                },
                _ => ArtifactEmission::Rejected,
            },
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

// Boolean binder/reference parsing follows the same declaration route as the
// scalar functions, with the unary source token selecting existing typed
// boolean lowering.
pub fn compile_source_bool_not_function(input: SourceInput, argument: Bool) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_bool_not_function(input, argument),
        _ => Execution::Faulted,
    }
}

// The first source-defined conditional body. Its condition and branches are
// scanner-owned literals; the resulting choice goes through normal typed
// conditional lowering rather than a service-side branch.
pub fn compile_source_i64_select_function(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_i64_select_function(input),
        _ => Execution::Faulted,
    }
}

// The literal-condition declaration route can now publish a verified i64
// artifact. Its condition is fully source-admitted and compile-time known;
// parameterized selection remains an execution-only route pending branch
// bytecode emission.
pub fn compile_source_i64_select_function_entry(input: SourceInput) -> ArtifactEmission {
    handle compile_source_i64_select_function(input) {
        Execution::Returned(value) => emit_g1_i64_callable(value),
        Execution::Faulted => ArtifactEmission::Rejected,
        _ => ArtifactEmission::Rejected,
    }
}

// A bound boolean condition extends source control flow beyond literal test
// cases. The service supplies an invocation value only after source binder
// and body-reference spans have been proved identical.
pub fn compile_source_i64_select_parameter_function(input: SourceInput, condition: Bool) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_i64_select_parameter_function(input, condition),
        _ => Execution::Faulted,
    }
}

fn compile_lexically_valid_i64_select_parameter_function(input: SourceInput, condition: Bool) -> Execution {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => compile_named_i64_select_parameter_function(input, prefix, condition),
        _ => Execution::Faulted,
    }
}

fn compile_named_i64_select_parameter_function(input: SourceInput, prefix: header::HeaderPrefix, condition: Bool) -> Execution {
    handle definition_from_prefix(prefix) {
        DefinitionAdmission::Value(_) => compile_declared_i64_select_parameter_function(input, condition),
        _ => Execution::Faulted,
    }
}

fn compile_declared_i64_select_parameter_function(input: SourceInput, condition: Bool) -> Execution {
    let input_bytes = source::bytes(input);
    let public = first_token(input_bytes);
    handle token_matches(input_bytes, public, "pub") {
        true => compile_i64_select_parameter_keyword(input_bytes, next_token(input_bytes, public), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_keyword(input_bytes: Bytes, function: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, function, "fn") {
        true => compile_i64_select_parameter_name(input_bytes, next_token(input_bytes, function), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_name(input_bytes: Bytes, name: TokenStart, condition: Bool) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_i64_select_parameter_open(input_bytes, next_token(input_bytes, name), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_open(input_bytes: Bytes, open: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_i64_select_parameter_binder(input_bytes, next_token(input_bytes, open), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_binder(input_bytes: Bytes, binder: TokenStart, condition: Bool) -> Execution {
    handle token_kind(binder) {
        TokenKind::Identifier => compile_i64_select_parameter_colon(input_bytes, binder, next_token(input_bytes, binder), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_colon(input_bytes: Bytes, binder: TokenStart, colon: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, colon, ":") {
        true => compile_i64_select_parameter_type(input_bytes, binder, next_token(input_bytes, colon), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_type(input_bytes: Bytes, binder: TokenStart, parameter_type: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, parameter_type, "Bool") {
        true => compile_i64_select_parameter_close(input_bytes, binder, next_token(input_bytes, parameter_type), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_close(input_bytes: Bytes, binder: TokenStart, close: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, close, ")") {
        true => compile_i64_select_parameter_arrow(input_bytes, binder, next_token(input_bytes, close), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_arrow(input_bytes: Bytes, binder: TokenStart, arrow: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_i64_select_parameter_result(input_bytes, binder, next_token(input_bytes, arrow), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_result(input_bytes: Bytes, binder: TokenStart, result: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, result, "i64") {
        true => compile_i64_select_parameter_body(input_bytes, binder, next_token(input_bytes, result), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_body(input_bytes: Bytes, binder: TokenStart, open: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_i64_select_parameter_return_or_if(input_bytes, binder, next_token(input_bytes, open), condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_return_or_if(input_bytes: Bytes, binder: TokenStart, keyword: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, keyword, "return") {
        true => compile_i64_select_parameter_if_return(input_bytes, binder, next_token(input_bytes, keyword), condition),
        false => compile_i64_select_parameter_if(input_bytes, binder, keyword, condition),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_if(input_bytes: Bytes, binder: TokenStart, keyword: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, keyword, "if") {
        true => compile_i64_select_parameter_reference(input_bytes, binder, next_token(input_bytes, keyword), condition, false),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_if_return(input_bytes: Bytes, binder: TokenStart, keyword: TokenStart, condition: Bool) -> Execution {
    handle token_matches(input_bytes, keyword, "if") {
        true => compile_i64_select_parameter_reference(input_bytes, binder, next_token(input_bytes, keyword), condition, true),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_parameter_reference(input_bytes: Bytes, binder: TokenStart, reference: TokenStart, condition: Bool, explicit_return: Bool) -> Execution {
    handle token_equals(input_bytes, binder, reference) {
        true => compile_i64_select_then_open(input_bytes, condition, next_token(input_bytes, reference), explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_lexically_valid_i64_select_function(input: SourceInput) -> Execution {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => compile_named_i64_select_function(input, prefix),
        _ => Execution::Faulted,
    }
}

fn compile_named_i64_select_function(input: SourceInput, prefix: header::HeaderPrefix) -> Execution {
    handle definition_from_prefix(prefix) {
        DefinitionAdmission::Value(_) => compile_declared_i64_select_function(input),
        _ => Execution::Faulted,
    }
}

fn compile_declared_i64_select_function(input: SourceInput) -> Execution {
    let input_bytes = source::bytes(input);
    let public = first_token(input_bytes);
    handle token_matches(input_bytes, public, "pub") {
        true => compile_i64_select_keyword(input_bytes, next_token(input_bytes, public)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_keyword(input_bytes: Bytes, function: TokenStart) -> Execution {
    handle token_matches(input_bytes, function, "fn") {
        true => compile_i64_select_name(input_bytes, next_token(input_bytes, function)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_name(input_bytes: Bytes, name: TokenStart) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_i64_select_open_parameters(input_bytes, next_token(input_bytes, name)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_open_parameters(input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_i64_select_close_parameters(input_bytes, next_token(input_bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_close_parameters(input_bytes: Bytes, close: TokenStart) -> Execution {
    handle token_matches(input_bytes, close, ")") {
        true => compile_i64_select_arrow(input_bytes, next_token(input_bytes, close)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_arrow(input_bytes: Bytes, arrow: TokenStart) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_i64_select_result(input_bytes, next_token(input_bytes, arrow)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_result(input_bytes: Bytes, result: TokenStart) -> Execution {
    handle token_matches(input_bytes, result, "i64") {
        true => compile_i64_select_open_body(input_bytes, next_token(input_bytes, result)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_open_body(input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_i64_select_return_or_if(input_bytes, next_token(input_bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_return_or_if(input_bytes: Bytes, keyword: TokenStart) -> Execution {
    handle token_matches(input_bytes, keyword, "return") {
        true => compile_i64_select_if_return(input_bytes, next_token(input_bytes, keyword)),
        false => compile_i64_select_if(input_bytes, keyword),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_if(input_bytes: Bytes, keyword: TokenStart) -> Execution {
    handle token_matches(input_bytes, keyword, "if") {
        true => compile_i64_select_condition(input_bytes, next_token(input_bytes, keyword), false),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_if_return(input_bytes: Bytes, keyword: TokenStart) -> Execution {
    handle token_matches(input_bytes, keyword, "if") {
        true => compile_i64_select_condition(input_bytes, next_token(input_bytes, keyword), true),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_condition(input_bytes: Bytes, condition: TokenStart, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, condition, "true") {
        true => compile_i64_select_then_open(input_bytes, true, next_token(input_bytes, condition), explicit_return),
        false => handle token_matches(input_bytes, condition, "false") {
            true => compile_i64_select_then_open(input_bytes, false, next_token(input_bytes, condition), explicit_return),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_then_open(input_bytes: Bytes, condition: Bool, open: TokenStart, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_i64_select_then_value(input_bytes, condition, next_token(input_bytes, open), explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_then_value(input_bytes: Bytes, condition: Bool, value: TokenStart, explicit_return: Bool) -> Execution {
    handle signed_i64_literal_at(input_bytes, value) {
        SignedI64LiteralAdmission::Value(_, last) => compile_i64_select_then_close(input_bytes, condition, value, next_token(input_bytes, last), explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_then_close(input_bytes: Bytes, condition: Bool, value: TokenStart, close: TokenStart, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_i64_select_else(input_bytes, condition, value, next_token(input_bytes, close), explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_else(input_bytes: Bytes, condition: Bool, then_value: TokenStart, keyword: TokenStart, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, keyword, "else") {
        true => compile_i64_select_else_open(input_bytes, condition, then_value, next_token(input_bytes, keyword), explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_else_open(input_bytes: Bytes, condition: Bool, then_value: TokenStart, open: TokenStart, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_i64_select_else_value(input_bytes, condition, then_value, next_token(input_bytes, open), explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_else_value(input_bytes: Bytes, condition: Bool, then_value: TokenStart, else_value: TokenStart, explicit_return: Bool) -> Execution {
    handle signed_i64_literal_at(input_bytes, else_value) {
        SignedI64LiteralAdmission::Value(_, last) => compile_i64_select_else_close(input_bytes, condition, then_value, else_value, next_token(input_bytes, last), explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_else_close(input_bytes: Bytes, condition: Bool, then_value: TokenStart, else_value: TokenStart, close: TokenStart, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_i64_select_end_body(input_bytes, condition, then_value, else_value, next_token(input_bytes, close), explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_end_body(input_bytes: Bytes, condition: Bool, then_value: TokenStart, else_value: TokenStart, close: TokenStart, explicit_return: Bool) -> Execution {
    handle explicit_return {
        true => compile_i64_select_return_semicolon(input_bytes, condition, then_value, else_value, close),
        false => compile_i64_select_end_body_without_return(input_bytes, condition, then_value, else_value, close),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_end_body_without_return(input_bytes: Bytes, condition: Bool, then_value: TokenStart, else_value: TokenStart, close: TokenStart) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_i64_select_end(input_bytes, condition, then_value, else_value, next_token(input_bytes, close)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_return_semicolon(input_bytes: Bytes, condition: Bool, then_value: TokenStart, else_value: TokenStart, semicolon: TokenStart) -> Execution {
    handle token_matches(input_bytes, semicolon, ";") {
        true => compile_i64_select_end_body_without_return(input_bytes, condition, then_value, else_value, next_token(input_bytes, semicolon)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_end(input_bytes: Bytes, condition: Bool, then_value: TokenStart, else_value: TokenStart, end: TokenStart) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_i64_select_values(input_bytes, condition, then_value, else_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_values(input_bytes: Bytes, condition: Bool, then_value: TokenStart, else_value: TokenStart) -> Execution {
    handle signed_i64_literal_at(input_bytes, then_value) {
        SignedI64LiteralAdmission::Value(then_value, _) => compile_i64_select_else_literal(input_bytes, condition, then_value, else_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_select_else_literal(input_bytes: Bytes, condition: Bool, then_value: i64, else_token: TokenStart) -> Execution {
    handle signed_i64_literal_at(input_bytes, else_token) {
        SignedI64LiteralAdmission::Value(else_value, _) => compile_parameter_i64_select(condition, then_value, else_value, Type::I64),
        _ => Execution::Faulted,
    }
}

fn compile_lexically_valid_bool_not_function(input: SourceInput, argument: Bool) -> Execution {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => compile_named_bool_not_function(input, prefix, argument),
        _ => Execution::Faulted,
    }
}

fn compile_named_bool_not_function(input: SourceInput, prefix: header::HeaderPrefix, argument: Bool) -> Execution {
    handle definition_from_prefix(prefix) {
        DefinitionAdmission::Value(_) => compile_declared_bool_not_function(input, argument),
        _ => Execution::Faulted,
    }
}

fn compile_declared_bool_not_function(input: SourceInput, argument: Bool) -> Execution {
    let input_bytes = source::bytes(input);
    let public = first_token(input_bytes);
    handle token_matches(input_bytes, public, "pub") {
        true => compile_bool_not_keyword(input_bytes, next_token(input_bytes, public), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_keyword(input_bytes: Bytes, function: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, function, "fn") {
        true => compile_bool_not_name(input_bytes, next_token(input_bytes, function), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_name(input_bytes: Bytes, name: TokenStart, argument: Bool) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_bool_not_open(input_bytes, next_token(input_bytes, name), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_open(input_bytes: Bytes, open: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_bool_not_parameter(input_bytes, next_token(input_bytes, open), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_parameter(input_bytes: Bytes, parameter: TokenStart, argument: Bool) -> Execution {
    handle token_kind(parameter) {
        TokenKind::Identifier => compile_bool_not_colon(input_bytes, parameter, next_token(input_bytes, parameter), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_colon(input_bytes: Bytes, parameter: TokenStart, colon: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, colon, ":") {
        true => compile_bool_not_parameter_type(input_bytes, parameter, next_token(input_bytes, colon), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_parameter_type(input_bytes: Bytes, parameter: TokenStart, parameter_type: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, parameter_type, "Bool") {
        true => compile_bool_not_close_parameters(input_bytes, parameter, next_token(input_bytes, parameter_type), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_close_parameters(input_bytes: Bytes, parameter: TokenStart, close: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, close, ")") {
        true => compile_bool_not_arrow(input_bytes, parameter, next_token(input_bytes, close), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_arrow(input_bytes: Bytes, parameter: TokenStart, arrow: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_bool_not_result(input_bytes, parameter, next_token(input_bytes, arrow), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_result(input_bytes: Bytes, parameter: TokenStart, result: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, result, "Bool") {
        true => compile_bool_not_open_body(input_bytes, parameter, next_token(input_bytes, result), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_open_body(input_bytes: Bytes, parameter: TokenStart, open: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_bool_not_operator(input_bytes, parameter, next_token(input_bytes, open), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_operator(input_bytes: Bytes, parameter: TokenStart, operator: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, operator, "!") {
        true => compile_bool_not_reference(input_bytes, parameter, next_token(input_bytes, operator), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_reference(input_bytes: Bytes, parameter: TokenStart, reference: TokenStart, argument: Bool) -> Execution {
    handle token_equals(input_bytes, parameter, reference) {
        true => compile_bool_not_close(input_bytes, next_token(input_bytes, reference), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_close(input_bytes: Bytes, close: TokenStart, argument: Bool) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_bool_not_end(input_bytes, next_token(input_bytes, close), argument),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_end(input_bytes: Bytes, end: TokenStart, argument: Bool) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_parameter_bool_not(argument, Type::Bool),
        _ => Execution::Faulted,
    }
}

// A production Bool run must validate a complete declaration.  The raw
// scanner Bool-literal helper remains useful for expression probes, but must
// never admit a file merely because it contains `true` or `false` somewhere.
pub fn compile_source_bool_function(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_bool_function(input),
        _ => Execution::Faulted,
    }
}

fn compile_lexically_valid_bool_function(input: SourceInput) -> Execution {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => handle definition_from_prefix(prefix) {
            DefinitionAdmission::Value(_) => compile_declared_bool_function(source::bytes(input)),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_declared_bool_function(input_bytes: Bytes) -> Execution {
    let first = first_token(input_bytes);
    handle token_matches(input_bytes, first, "pub") {
        true => compile_bool_function_keyword(input_bytes, next_token(input_bytes, first)),
        false => compile_bool_function_keyword(input_bytes, first),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_keyword(input_bytes: Bytes, function: TokenStart) -> Execution {
    handle token_matches(input_bytes, function, "fn") {
        true => compile_bool_function_name(input_bytes, next_token(input_bytes, function)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_name(input_bytes: Bytes, name: TokenStart) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_bool_function_open(input_bytes, next_token(input_bytes, name)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_open(input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_bool_function_close_parameters(input_bytes, next_token(input_bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_close_parameters(input_bytes: Bytes, close: TokenStart) -> Execution {
    handle token_matches(input_bytes, close, ")") {
        true => compile_bool_function_arrow(input_bytes, next_token(input_bytes, close)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_arrow(input_bytes: Bytes, arrow: TokenStart) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_bool_function_result(input_bytes, next_token(input_bytes, arrow)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_result(input_bytes: Bytes, result: TokenStart) -> Execution {
    handle token_matches(input_bytes, result, "Bool") {
        true => compile_bool_function_body_open(input_bytes, next_token(input_bytes, result)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_body_open(input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_bool_function_value(input_bytes, next_token(input_bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_value(input_bytes: Bytes, value: TokenStart) -> Execution {
    handle token_matches(input_bytes, value, "true") {
        true => compile_bool_function_close(input_bytes, next_token(input_bytes, value), true),
        false => handle token_matches(input_bytes, value, "false") {
            true => compile_bool_function_close(input_bytes, next_token(input_bytes, value), false),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_close(input_bytes: Bytes, close: TokenStart, value: Bool) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_bool_function_end(input_bytes, next_token(input_bytes, close), value),
        _ => Execution::Faulted,
    }
}

fn compile_bool_function_end(input_bytes: Bytes, end: TokenStart, value: Bool) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_bool_literal(value, Type::Bool),
        _ => Execution::Faulted,
    }
}

// Source-level scalar comparisons are Bool declarations, so their operands
// and operator must be admitted as one complete function before the existing
// typed Body→Core→MIR comparison lowering may execute.
pub fn compile_source_i64_comparison_function(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => handle named_declaration_checked(input) {
            SourceHeaderAdmission::Value(prefix) => handle definition_from_prefix(prefix) {
                DefinitionAdmission::Value(_) => compile_i64_comparison_decl(source::bytes(input)),
                _ => Execution::Faulted,
            },
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_decl(bytes: Bytes) -> Execution {
    let first = first_token(bytes);
    handle token_matches(bytes, first, "pub") {
        true => compile_i64_comparison_fn(bytes, next_token(bytes, first)),
        false => compile_i64_comparison_fn(bytes, first),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_fn(bytes: Bytes, function: TokenStart) -> Execution {
    handle token_matches(bytes, function, "fn") {
        true => compile_i64_comparison_name(bytes, next_token(bytes, function)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_name(bytes: Bytes, name: TokenStart) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_i64_comparison_open(bytes, next_token(bytes, name)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_open(bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(bytes, open, "(") {
        true => compile_i64_comparison_close_parameters(bytes, next_token(bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_close_parameters(bytes: Bytes, close: TokenStart) -> Execution {
    handle token_matches(bytes, close, ")") {
        true => compile_i64_comparison_arrow(bytes, next_token(bytes, close)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_arrow(bytes: Bytes, arrow: TokenStart) -> Execution {
    handle token_matches(bytes, arrow, "->") {
        true => compile_i64_comparison_result(bytes, next_token(bytes, arrow)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_result(bytes: Bytes, result: TokenStart) -> Execution {
    handle token_matches(bytes, result, "Bool") {
        true => compile_i64_comparison_body_open(bytes, next_token(bytes, result)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_body_open(bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(bytes, open, "{") {
        true => compile_i64_comparison_left(bytes, next_token(bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_left(bytes: Bytes, left: TokenStart) -> Execution {
    handle signed_i64_literal_at(bytes, left) {
        SignedI64LiteralAdmission::Value(value, last) => compile_i64_comparison_operator(bytes, next_token(bytes, last), value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_operator(bytes: Bytes, operator: TokenStart, left: i64) -> Execution {
    let right = next_token(bytes, operator);
    handle signed_i64_literal_at(bytes, right) {
        SignedI64LiteralAdmission::Value(value, last) => compile_i64_comparison_close(bytes, operator, next_token(bytes, last), left, value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_close(bytes: Bytes, operator: TokenStart, close: TokenStart, left: i64, right: i64) -> Execution {
    handle token_matches(bytes, close, "}") {
        true => handle token_kind(next_token(bytes, close)) {
            TokenKind::End => compile_i64_comparison_operator_value(bytes, operator, left, right),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_i64_comparison_operator_value(bytes: Bytes, operator: TokenStart, left: i64, right: i64) -> Execution {
    handle token_matches(bytes, operator, "==") {
        true => compile_i64_comparison(Comparison::Equal, left, right, Type::Bool),
        false => handle token_matches(bytes, operator, "<") {
            true => compile_i64_comparison(Comparison::Less, left, right, Type::Bool),
            false => handle token_matches(bytes, operator, ">") {
                true => compile_i64_comparison(Comparison::Greater, left, right, Type::Bool),
                _ => Execution::Faulted,
            },
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

// Keep literal Boolean negation on the same declaration-admission path as
// ordinary Bool literals.  The runtime `run` command has no caller-supplied
// parameters, so this complements (rather than substitutes for) the typed
// binder/reference route above.  Every token, including the terminal EOF,
// remains checked before normal Body→Core→MIR boolean lowering executes.
pub fn compile_source_bool_not_literal_function(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_bool_not_literal_function(input),
        _ => Execution::Faulted,
    }
}

fn compile_lexically_valid_bool_not_literal_function(input: SourceInput) -> Execution {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => handle definition_from_prefix(prefix) {
            DefinitionAdmission::Value(_) => compile_declared_bool_not_literal_function(source::bytes(input)),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_declared_bool_not_literal_function(input_bytes: Bytes) -> Execution {
    let first = first_token(input_bytes);
    handle token_matches(input_bytes, first, "pub") {
        true => compile_bool_not_literal_keyword(input_bytes, next_token(input_bytes, first)),
        false => compile_bool_not_literal_keyword(input_bytes, first),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_keyword(input_bytes: Bytes, function: TokenStart) -> Execution {
    handle token_matches(input_bytes, function, "fn") {
        true => compile_bool_not_literal_name(input_bytes, next_token(input_bytes, function)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_name(input_bytes: Bytes, name: TokenStart) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_bool_not_literal_open(input_bytes, next_token(input_bytes, name)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_open(input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_bool_not_literal_close_parameters(input_bytes, next_token(input_bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_close_parameters(input_bytes: Bytes, close: TokenStart) -> Execution {
    handle token_matches(input_bytes, close, ")") {
        true => compile_bool_not_literal_arrow(input_bytes, next_token(input_bytes, close)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_arrow(input_bytes: Bytes, arrow: TokenStart) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_bool_not_literal_result(input_bytes, next_token(input_bytes, arrow)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_result(input_bytes: Bytes, result: TokenStart) -> Execution {
    handle token_matches(input_bytes, result, "Bool") {
        true => compile_bool_not_literal_body_open(input_bytes, next_token(input_bytes, result)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_body_open(input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_bool_not_literal_operator(input_bytes, next_token(input_bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_operator(input_bytes: Bytes, operator: TokenStart) -> Execution {
    handle token_matches(input_bytes, operator, "!") {
        true => compile_bool_not_literal_value(input_bytes, next_token(input_bytes, operator)),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_value(input_bytes: Bytes, value: TokenStart) -> Execution {
    handle token_matches(input_bytes, value, "true") {
        true => compile_bool_not_literal_close(input_bytes, next_token(input_bytes, value), true),
        false => handle token_matches(input_bytes, value, "false") {
            true => compile_bool_not_literal_close(input_bytes, next_token(input_bytes, value), false),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_close(input_bytes: Bytes, close: TokenStart, value: Bool) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_bool_not_literal_end(input_bytes, next_token(input_bytes, close), value),
        _ => Execution::Faulted,
    }
}

fn compile_bool_not_literal_end(input_bytes: Bytes, end: TokenStart, value: Bool) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_bool_not(value, Type::Bool),
        _ => Execution::Faulted,
    }
}

fn compile_lexically_valid_i64_add_function(input: SourceInput, left_value: i64, right_value: i64) -> Execution {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => compile_named_i64_add_function(input, prefix, left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_named_i64_add_function(input: SourceInput, prefix: header::HeaderPrefix, left_value: i64, right_value: i64) -> Execution {
    handle definition_from_prefix(prefix) {
        DefinitionAdmission::Value(_) => compile_declared_i64_add_function(input, left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_declared_i64_add_function(input: SourceInput, left_value: i64, right_value: i64) -> Execution {
    let input_bytes = source::bytes(input);
    let public = first_token(input_bytes);
    handle token_matches(input_bytes, public, "pub") {
        true => compile_i64_add_keyword(input_bytes, next_token(input_bytes, public), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_keyword(input_bytes: Bytes, function: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, function, "fn") {
        true => compile_i64_add_name(input_bytes, next_token(input_bytes, function), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_name(input_bytes: Bytes, name: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_i64_add_open(input_bytes, next_token(input_bytes, name), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_open(input_bytes: Bytes, open: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_i64_add_left_name(input_bytes, next_token(input_bytes, open), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_left_name(input_bytes: Bytes, left: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_kind(left) {
        TokenKind::Identifier => compile_i64_add_left_colon(input_bytes, left, next_token(input_bytes, left), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_left_colon(input_bytes: Bytes, left: TokenStart, colon: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, colon, ":") {
        true => compile_i64_add_left_type(input_bytes, left, next_token(input_bytes, colon), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_left_type(input_bytes: Bytes, left: TokenStart, left_type: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, left_type, "i64") {
        true => compile_i64_add_comma(input_bytes, left, next_token(input_bytes, left_type), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_comma(input_bytes: Bytes, left: TokenStart, comma: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, comma, ",") {
        true => compile_i64_add_right_name(input_bytes, left, next_token(input_bytes, comma), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_right_name(input_bytes: Bytes, left: TokenStart, right: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_kind(right) {
        TokenKind::Identifier => compile_i64_add_right_colon(input_bytes, left, right, next_token(input_bytes, right), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_right_colon(input_bytes: Bytes, left: TokenStart, right: TokenStart, colon: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, colon, ":") {
        true => compile_i64_add_right_type(input_bytes, left, right, next_token(input_bytes, colon), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_right_type(input_bytes: Bytes, left: TokenStart, right: TokenStart, right_type: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, right_type, "i64") {
        true => compile_i64_add_close_parameters(input_bytes, left, right, next_token(input_bytes, right_type), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_close_parameters(input_bytes: Bytes, left: TokenStart, right: TokenStart, close: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, close, ")") {
        true => compile_i64_add_arrow(input_bytes, left, right, next_token(input_bytes, close), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_arrow(input_bytes: Bytes, left: TokenStart, right: TokenStart, arrow: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_i64_add_result(input_bytes, left, right, next_token(input_bytes, arrow), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_result(input_bytes: Bytes, left: TokenStart, right: TokenStart, result: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, result, "i64") {
        true => compile_i64_add_open_body(input_bytes, left, right, next_token(input_bytes, result), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_open_body(input_bytes: Bytes, left: TokenStart, right: TokenStart, open: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_i64_add_body_left(input_bytes, left, right, next_token(input_bytes, open), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_body_left(input_bytes: Bytes, left: TokenStart, right: TokenStart, body_left: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, body_left, "return") {
        true => compile_i64_add_return_body_left(input_bytes, left, right, next_token(input_bytes, body_left), left_value, right_value),
        false => compile_i64_add_body_left_expression(input_bytes, left, right, body_left, left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_body_left_expression(input_bytes: Bytes, left: TokenStart, right: TokenStart, body_left: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_equals(input_bytes, left, body_left) {
        true => compile_i64_add_operator(input_bytes, right, next_token(input_bytes, body_left), left_value, right_value, false),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_return_body_left(input_bytes: Bytes, left: TokenStart, right: TokenStart, body_left: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_equals(input_bytes, left, body_left) {
        true => compile_i64_add_operator(input_bytes, right, next_token(input_bytes, body_left), left_value, right_value, true),
        _ => Execution::Faulted,
    }
}

fn compile_i64_add_operator(input_bytes: Bytes, right: TokenStart, operator: TokenStart, left_value: i64, right_value: i64, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, operator, "+") {
        true => compile_i64_binary_body_right(input_bytes, ScannedArithmetic::Add, right, next_token(input_bytes, operator), left_value, right_value, explicit_return),
        false => compile_i64_subtract_operator(input_bytes, right, operator, left_value, right_value, explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_subtract_operator(input_bytes: Bytes, right: TokenStart, operator: TokenStart, left_value: i64, right_value: i64, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, operator, "-") {
        true => compile_i64_binary_body_right(input_bytes, ScannedArithmetic::Subtract, right, next_token(input_bytes, operator), left_value, right_value, explicit_return),
        false => compile_i64_multiply_operator(input_bytes, right, operator, left_value, right_value, explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_multiply_operator(input_bytes: Bytes, right: TokenStart, operator: TokenStart, left_value: i64, right_value: i64, explicit_return: Bool) -> Execution {
    handle token_matches(input_bytes, operator, "*") {
        true => compile_i64_binary_body_right(input_bytes, ScannedArithmetic::Multiply, right, next_token(input_bytes, operator), left_value, right_value, explicit_return),
        false => handle token_matches(input_bytes, operator, "/") {
            true => compile_i64_binary_body_right(input_bytes, ScannedArithmetic::Divide, right, next_token(input_bytes, operator), left_value, right_value, explicit_return),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_i64_binary_body_right(input_bytes: Bytes, operation: ScannedArithmetic, right: TokenStart, body_right: TokenStart, left_value: i64, right_value: i64, explicit_return: Bool) -> Execution {
    handle token_equals(input_bytes, right, body_right) {
        true => compile_i64_binary_close(input_bytes, operation, next_token(input_bytes, body_right), left_value, right_value, explicit_return),
        _ => Execution::Faulted,
    }
}

fn compile_i64_binary_close(input_bytes: Bytes, operation: ScannedArithmetic, close: TokenStart, left_value: i64, right_value: i64, explicit_return: Bool) -> Execution {
    handle explicit_return {
        true => compile_i64_binary_return_semicolon(input_bytes, operation, close, left_value, right_value),
        false => compile_i64_binary_close_expression(input_bytes, operation, close, left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_binary_close_expression(input_bytes: Bytes, operation: ScannedArithmetic, close: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_i64_binary_end(input_bytes, operation, next_token(input_bytes, close), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_binary_return_semicolon(input_bytes: Bytes, operation: ScannedArithmetic, semicolon: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_matches(input_bytes, semicolon, ";") {
        true => compile_i64_binary_close_expression(input_bytes, operation, next_token(input_bytes, semicolon), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_binary_end(input_bytes: Bytes, operation: ScannedArithmetic, end: TokenStart, left_value: i64, right_value: i64) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_parameter_arithmetic(operation, left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_lexically_valid_i64_identity_function(input: SourceInput, argument: i64) -> Execution {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => compile_named_i64_identity_function(input, prefix, argument),
        _ => Execution::Faulted,
    }
}

fn compile_named_i64_identity_function(input: SourceInput, prefix: header::HeaderPrefix, argument: i64) -> Execution {
    handle definition_from_prefix(prefix) {
        DefinitionAdmission::Value(_) => compile_declared_i64_identity_function(input, argument),
        _ => Execution::Faulted,
    }
}

fn compile_declared_i64_identity_function(input: SourceInput, argument: i64) -> Execution {
    let input_bytes = source::bytes(input);
    let first = first_token(input_bytes);
    handle token_matches(input_bytes, first, "fn") {
        true => compile_i64_identity_after_keyword(input_bytes, first, argument),
        false => compile_i64_identity_visibility(input_bytes, first, argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_visibility(input_bytes: Bytes, first: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, first, "pub") {
        true => compile_i64_identity_after_keyword(input_bytes, next_token(input_bytes, first), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_after_keyword(input_bytes: Bytes, function: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, function, "fn") {
        true => compile_i64_identity_after_function(input_bytes, function, argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_after_function(input_bytes: Bytes, function: TokenStart, argument: i64) -> Execution {
    let name = next_token(input_bytes, function);
    handle token_kind(name) {
        TokenKind::Identifier => compile_i64_identity_parameter(input_bytes, next_token(input_bytes, name), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_parameter(input_bytes: Bytes, open: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_i64_identity_parameter_name(input_bytes, next_token(input_bytes, open), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_parameter_name(input_bytes: Bytes, parameter: TokenStart, argument: i64) -> Execution {
    handle token_kind(parameter) {
        TokenKind::Identifier => compile_i64_identity_parameter_type(input_bytes, parameter, next_token(input_bytes, parameter), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_parameter_type(input_bytes: Bytes, parameter: TokenStart, colon: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, colon, ":") {
        true => compile_i64_identity_parameter_i64(input_bytes, parameter, next_token(input_bytes, colon), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_parameter_i64(input_bytes: Bytes, parameter: TokenStart, parameter_type: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, parameter_type, "i64") {
        true => compile_i64_identity_close_parameters(input_bytes, parameter, next_token(input_bytes, parameter_type), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_close_parameters(input_bytes: Bytes, parameter: TokenStart, close: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, close, ")") {
        true => compile_i64_identity_arrow(input_bytes, parameter, next_token(input_bytes, close), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_arrow(input_bytes: Bytes, parameter: TokenStart, arrow: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_i64_identity_result(input_bytes, parameter, next_token(input_bytes, arrow), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_result(input_bytes: Bytes, parameter: TokenStart, result: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, result, "i64") {
        true => compile_i64_identity_open_body(input_bytes, parameter, next_token(input_bytes, result), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_open_body(input_bytes: Bytes, parameter: TokenStart, open: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_i64_identity_body(input_bytes, parameter, next_token(input_bytes, open), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_body(input_bytes: Bytes, parameter: TokenStart, reference: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, reference, "return") {
        true => compile_i64_identity_return_reference(input_bytes, parameter, next_token(input_bytes, reference), argument),
        false => compile_i64_identity_reference(input_bytes, parameter, reference, argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_reference(input_bytes: Bytes, parameter: TokenStart, reference: TokenStart, argument: i64) -> Execution {
    handle token_equals(input_bytes, parameter, reference) {
        true => compile_i64_identity_close(input_bytes, next_token(input_bytes, reference), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_return_reference(input_bytes: Bytes, parameter: TokenStart, reference: TokenStart, argument: i64) -> Execution {
    handle token_equals(input_bytes, parameter, reference) {
        true => compile_i64_identity_return_semicolon(input_bytes, next_token(input_bytes, reference), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_return_semicolon(input_bytes: Bytes, semicolon: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, semicolon, ";") {
        true => compile_i64_identity_close(input_bytes, next_token(input_bytes, semicolon), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_close(input_bytes: Bytes, close: TokenStart, argument: i64) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_i64_identity_end(input_bytes, next_token(input_bytes, close), argument),
        _ => Execution::Faulted,
    }
}

fn compile_i64_identity_end(input_bytes: Bytes, end: TokenStart, argument: i64) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_i64_parameter_reference(argument, Type::I64),
        _ => Execution::Faulted,
    }
}

fn compile_lexically_valid_i64_function(input: SourceInput) -> Execution {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => compile_named_i64_function(input, prefix),
        _ => Execution::Faulted,
    }
}

fn compile_named_i64_function(input: SourceInput, prefix: header::HeaderPrefix) -> Execution {
    handle definition_from_prefix(prefix) {
        DefinitionAdmission::Value(_) => compile_declared_i64_function(input),
        _ => Execution::Faulted,
    }
}

fn compile_declared_i64_function(input: SourceInput) -> Execution {
    let input_bytes = source::bytes(input);
    let first = first_token(input_bytes);
    handle token_matches(input_bytes, first, "fn") {
        true => compile_i64_function_after_keyword(input, input_bytes, first),
        false => compile_i64_function_visibility(input, input_bytes, first),
        _ => Execution::Faulted,
    }
}

// Visibility remains header-owned, but the body cursor must consume `pub`
// before it can find the declaration keyword. Keeping this here means the
// source body route accepts public compiler entrypoints that interface
// collection already admitted instead of requiring an unprefixed form.
fn compile_i64_function_visibility(input: SourceInput, input_bytes: Bytes, first: TokenStart) -> Execution {
    handle token_matches(input_bytes, first, "pub") {
        true => compile_i64_function_public_keyword(input, input_bytes, first),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_public_keyword(input: SourceInput, input_bytes: Bytes, public: TokenStart) -> Execution {
    let function = next_token(input_bytes, public);
    handle token_matches(input_bytes, function, "fn") {
        true => compile_i64_function_after_keyword(input, input_bytes, function),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_after_keyword(input: SourceInput, input_bytes: Bytes, function: TokenStart) -> Execution {
    let name = next_token(input_bytes, function);
    handle token_kind(name) {
        TokenKind::Identifier => compile_i64_function_after_name(input, input_bytes, name),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_after_name(input: SourceInput, input_bytes: Bytes, name: TokenStart) -> Execution {
    let next = next_token(input_bytes, name);
    handle token_matches(input_bytes, next, "{") {
        true => compile_i64_function_body(input, input_bytes, next),
        false => compile_i64_function_parameters(input, input_bytes, next),
        _ => Execution::Faulted,
    }
}

// The bootstrap shorthand may omit a signature, but ordinary source uses an
// empty parameter list followed by `-> i64`.  Parse that production through
// the same token cursor, preserving a small source-level subset that already
// matches the spelling used by real compiler functions.
fn compile_i64_function_parameters(input: SourceInput, input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_i64_function_empty_parameters(input, input_bytes, open),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_empty_parameters(input: SourceInput, input_bytes: Bytes, open: TokenStart) -> Execution {
    let first = next_token(input_bytes, open);
    handle token_matches(input_bytes, first, ")") {
        true => compile_i64_function_after_parameters(input, input_bytes, first),
        false => compile_i64_function_parameter_name(input, input_bytes, first),
        _ => Execution::Faulted,
    }
}

// A first typed parameter unlocks ordinary declarations whose body does not
// reference its argument yet. Identifier-expression lowering is a later body
// extension; until then, retain the declared type and reject untyped or
// multi-parameter forms rather than treating them as an unchecked token blob.
fn compile_i64_function_parameter_name(input: SourceInput, input_bytes: Bytes, name: TokenStart) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_i64_function_parameter_colon(input, input_bytes, name),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_parameter_colon(input: SourceInput, input_bytes: Bytes, name: TokenStart) -> Execution {
    let colon = next_token(input_bytes, name);
    handle token_matches(input_bytes, colon, ":") {
        true => compile_i64_function_parameter_type(input, input_bytes, colon),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_parameter_type(input: SourceInput, input_bytes: Bytes, colon: TokenStart) -> Execution {
    let parameter_type = next_token(input_bytes, colon);
    handle token_matches(input_bytes, parameter_type, "i64") {
        true => compile_i64_function_parameter_close(input, input_bytes, parameter_type),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_parameter_close(input: SourceInput, input_bytes: Bytes, parameter_type: TokenStart) -> Execution {
    let close = next_token(input_bytes, parameter_type);
    handle token_matches(input_bytes, close, ")") {
        true => compile_i64_function_after_parameters(input, input_bytes, close),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_after_parameters(input: SourceInput, input_bytes: Bytes, close: TokenStart) -> Execution {
    let next = next_token(input_bytes, close);
    handle token_matches(input_bytes, next, "{") {
        true => compile_i64_function_body(input, input_bytes, next),
        false => compile_i64_function_return_annotation(input, input_bytes, next),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_annotation(input: SourceInput, input_bytes: Bytes, arrow: TokenStart) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_i64_function_return_type(input, input_bytes, arrow),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_type(input: SourceInput, input_bytes: Bytes, arrow: TokenStart) -> Execution {
    let result = next_token(input_bytes, arrow);
    handle token_matches(input_bytes, result, "i64") {
        true => compile_i64_function_return_body(input, input_bytes, result),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_body(input: SourceInput, input_bytes: Bytes, result: TokenStart) -> Execution {
    let open = next_token(input_bytes, result);
    handle token_matches(input_bytes, open, "{") {
        true => compile_i64_function_body(input, input_bytes, open),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_body(input: SourceInput, input_bytes: Bytes, open: TokenStart) -> Execution {
    let literal = next_token(input_bytes, open);
    handle token_matches(input_bytes, literal, "return") {
        true => compile_i64_function_return_literal(input, input_bytes, next_token(input_bytes, literal)),
        false => handle signed_i64_literal_at_checked(input, literal) {
            SignedI64LiteralAdmission::Value(value, last) => compile_i64_function_after_left(input, input_bytes, last, value),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

// The explicit return form is kept deliberately narrow for this current G1
// scalar path: `return <i64-literal>;` and one literal binary expression have
// checked terminators and feed the same typed lowering as expression bodies.
// Rich return expressions extend this cursor rather than treating `return` as
// a launcher shortcut.
fn compile_i64_function_return_literal(input: SourceInput, input_bytes: Bytes, literal: TokenStart) -> Execution {
    handle signed_i64_literal_at_checked(input, literal) {
        SignedI64LiteralAdmission::Value(value, last) => compile_i64_function_return_after_left(input, input_bytes, next_token(input_bytes, last), value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_after_left(input: SourceInput, input_bytes: Bytes, next: TokenStart, left: i64) -> Execution {
    handle token_matches(input_bytes, next, ";") {
        true => compile_i64_function_return_semicolon(input_bytes, next, left),
        false => compile_i64_function_return_arithmetic(input, input_bytes, next, left),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_arithmetic(input: SourceInput, input_bytes: Bytes, operator: TokenStart, left: i64) -> Execution {
    let right = next_token(input_bytes, operator);
    handle signed_i64_literal_at_checked(input, right) {
        SignedI64LiteralAdmission::Value(value, last) => compile_i64_function_return_arithmetic_semicolon(input_bytes, operator, next_token(input_bytes, last), left, value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_arithmetic_semicolon(input_bytes: Bytes, operator: TokenStart, semicolon: TokenStart, left: i64, right: i64) -> Execution {
    handle token_matches(input_bytes, semicolon, ";") {
        true => compile_i64_function_return_arithmetic_close(input_bytes, operator, next_token(input_bytes, semicolon), left, right),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_arithmetic_close(input_bytes: Bytes, operator: TokenStart, close: TokenStart, left: i64, right: i64) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_i64_function_return_arithmetic_end(input_bytes, operator, close, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_arithmetic_end(input_bytes: Bytes, operator: TokenStart, close: TokenStart, left: i64, right: i64) -> Execution {
    handle token_kind(next_token(input_bytes, close)) {
        TokenKind::End => compile_i64_function_arithmetic_operator(input_bytes, operator, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_semicolon(input_bytes: Bytes, semicolon: TokenStart, value: i64) -> Execution {
    handle token_matches(input_bytes, semicolon, ";") {
        true => compile_i64_function_return_close(input_bytes, next_token(input_bytes, semicolon), value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_return_close(input_bytes: Bytes, close: TokenStart, value: i64) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_i64_function_end(input_bytes, close, value),
        _ => Execution::Faulted,
    }
}

// A closing brace completes a scalar body. Otherwise the next token is an
// infix operator, and the right literal is decoded by the same scanner-owned
// path before normal typed arithmetic lowering selects its semantics.
fn compile_i64_function_after_left(input: SourceInput, input_bytes: Bytes, left: TokenStart, value: i64) -> Execution {
    let next = next_token(input_bytes, left);
    handle token_matches(input_bytes, next, "}") {
        true => compile_i64_function_end(input_bytes, next, value),
        false => compile_i64_function_arithmetic(input, input_bytes, next, value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_arithmetic(input: SourceInput, input_bytes: Bytes, operator: TokenStart, left: i64) -> Execution {
    let right = next_token(input_bytes, operator);
    handle signed_i64_literal_at_checked(input, right) {
        SignedI64LiteralAdmission::Value(value, last) => compile_i64_function_arithmetic_close(input_bytes, operator, last, left, value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_arithmetic_close(input_bytes: Bytes, operator: TokenStart, right: TokenStart, left: i64, value: i64) -> Execution {
    let close = next_token(input_bytes, right);
    handle token_matches(input_bytes, close, "}") {
        true => compile_i64_function_arithmetic_end(input_bytes, operator, close, left, value),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_arithmetic_end(input_bytes: Bytes, operator: TokenStart, close: TokenStart, left: i64, right: i64) -> Execution {
    handle token_kind(next_token(input_bytes, close)) {
        TokenKind::End => compile_i64_function_arithmetic_operator(input_bytes, operator, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_arithmetic_operator(input_bytes: Bytes, operator: TokenStart, left: i64, right: i64) -> Execution {
    handle token_matches(input_bytes, operator, "+") {
        true => compile_scanned_arithmetic(ScannedArithmetic::Add, left, right),
        false => compile_i64_function_subtract_operator(input_bytes, operator, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_subtract_operator(input_bytes: Bytes, operator: TokenStart, left: i64, right: i64) -> Execution {
    handle token_matches(input_bytes, operator, "-") {
        true => compile_scanned_arithmetic(ScannedArithmetic::Subtract, left, right),
        false => compile_i64_function_multiply_operator(input_bytes, operator, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_multiply_operator(input_bytes: Bytes, operator: TokenStart, left: i64, right: i64) -> Execution {
    handle token_matches(input_bytes, operator, "*") {
        true => compile_scanned_arithmetic(ScannedArithmetic::Multiply, left, right),
        false => handle token_matches(input_bytes, operator, "/") {
            true => compile_scanned_arithmetic(ScannedArithmetic::Divide, left, right),
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_i64_function_end(input_bytes: Bytes, close: TokenStart, value: i64) -> Execution {
    handle token_kind(next_token(input_bytes, close)) {
        TokenKind::End => compile_i64_literal(value, Type::I64),
        _ => Execution::Faulted,
    }
}

pub fn compile_source_bool_literal(input: SourceInput) -> Execution {
    handle first_bool_literal_checked(input) {
        BoolLiteralAdmission::Value(value) => compile_bool_literal(value, Type::Bool),
        _ => Execution::Faulted,
    }
}

pub fn compile_source_i64_arithmetic(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_signed_i64_arithmetic(source::bytes(input)),
        _ => Execution::Faulted,
    }
}

// Source u32 arithmetic owns lexical admission, operator selection, and
// complete-input checking. The typed service bridge below then preserves the
// unsigned payload through Core, MIR, and verified execution.
pub fn compile_source_u32_arithmetic(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_u32_arithmetic_source_bytes(source::bytes(input)),
        _ => Execution::Faulted,
    }
}

// Narrow declaration admission for the first unsigned source function. It is
// intentionally no-argument: parameter and artifact calling conventions are
// separate typed contracts, while this establishes that a real source header
// and body cannot bypass the u32 scanner/lowering path.
pub fn compile_source_u32_function(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => handle named_declaration_checked(input) {
            SourceHeaderAdmission::Value(prefix) => handle definition_from_prefix(prefix) {
                DefinitionAdmission::Value(_) => compile_u32_function_first(source::bytes(input), first_token(source::bytes(input))),
                _ => Execution::Faulted,
            },
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_first(input_bytes: Bytes, first: TokenStart) -> Execution {
    handle token_matches(input_bytes, first, "pub") {
        true => compile_u32_function_keyword(input_bytes, next_token(input_bytes, first)),
        false => compile_u32_function_keyword(input_bytes, first),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_keyword(input_bytes: Bytes, function: TokenStart) -> Execution {
    handle token_matches(input_bytes, function, "fn") {
        true => compile_u32_function_name(input_bytes, next_token(input_bytes, function)),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_name(input_bytes: Bytes, name: TokenStart) -> Execution {
    handle token_kind(name) {
        TokenKind::Identifier => compile_u32_function_open_parameters(input_bytes, next_token(input_bytes, name)),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_open_parameters(input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "(") {
        true => compile_u32_function_close_parameters(input_bytes, next_token(input_bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_close_parameters(input_bytes: Bytes, close: TokenStart) -> Execution {
    handle token_matches(input_bytes, close, ")") {
        true => compile_u32_function_arrow(input_bytes, next_token(input_bytes, close)),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_arrow(input_bytes: Bytes, arrow: TokenStart) -> Execution {
    handle token_matches(input_bytes, arrow, "->") {
        true => compile_u32_function_result(input_bytes, next_token(input_bytes, arrow)),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_result(input_bytes: Bytes, result: TokenStart) -> Execution {
    handle token_matches(input_bytes, result, "u32") {
        true => compile_u32_function_open_body(input_bytes, next_token(input_bytes, result)),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_open_body(input_bytes: Bytes, open: TokenStart) -> Execution {
    handle token_matches(input_bytes, open, "{") {
        true => compile_u32_function_return_or_left(input_bytes, next_token(input_bytes, open)),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_return_or_left(input_bytes: Bytes, token: TokenStart) -> Execution {
    handle token_matches(input_bytes, token, "return") {
        true => compile_u32_function_return_left(input_bytes, next_token(input_bytes, token)),
        false => compile_u32_function_left(input_bytes, token),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_left(input_bytes: Bytes, left: TokenStart) -> Execution {
    handle u32_literal_at(input_bytes, left) {
        U32LiteralAdmission::Value(left_value, left_last) => compile_u32_function_literal_or_operator(input_bytes, next_token(input_bytes, left_last), left_value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_literal_or_operator(input_bytes: Bytes, token: TokenStart, value: u32) -> Execution {
    handle token_matches(input_bytes, token, "}") {
        true => compile_u32_function_literal_end(input_bytes, next_token(input_bytes, token), value),
        false => compile_u32_function_operator(input_bytes, token, value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_literal_end(input_bytes: Bytes, end: TokenStart, value: u32) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_u32_literal(value, Type::U32),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_operator(input_bytes: Bytes, operator: TokenStart, left: u32) -> Execution {
    let right = next_token(input_bytes, operator);
    handle u32_literal_at(input_bytes, right) {
        U32LiteralAdmission::Value(right_value, right_last) => compile_u32_function_close(input_bytes, operator, next_token(input_bytes, right_last), left, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_close(input_bytes: Bytes, operator: TokenStart, close: TokenStart, left: u32, right: u32) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_u32_function_end(input_bytes, operator, next_token(input_bytes, close), left, right),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_end(input_bytes: Bytes, operator: TokenStart, end: TokenStart, left: u32, right: u32) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_u32_arithmetic_source_operation(input_bytes, operator, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_return_left(input_bytes: Bytes, left: TokenStart) -> Execution {
    handle u32_literal_at(input_bytes, left) {
        U32LiteralAdmission::Value(left_value, left_last) => compile_u32_function_return_literal_or_operator(input_bytes, next_token(input_bytes, left_last), left_value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_return_literal_or_operator(input_bytes: Bytes, token: TokenStart, value: u32) -> Execution {
    handle token_matches(input_bytes, token, ";") {
        true => compile_u32_function_return_literal_close(input_bytes, next_token(input_bytes, token), value),
        false => compile_u32_function_return_operator(input_bytes, token, value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_return_literal_close(input_bytes: Bytes, close: TokenStart, value: u32) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_u32_function_literal_end(input_bytes, next_token(input_bytes, close), value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_return_operator(input_bytes: Bytes, operator: TokenStart, left: u32) -> Execution {
    let right = next_token(input_bytes, operator);
    handle u32_literal_at(input_bytes, right) {
        U32LiteralAdmission::Value(right_value, right_last) => compile_u32_function_return_semicolon(input_bytes, operator, next_token(input_bytes, right_last), left, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_return_semicolon(input_bytes: Bytes, operator: TokenStart, semicolon: TokenStart, left: u32, right: u32) -> Execution {
    handle token_matches(input_bytes, semicolon, ";") {
        true => compile_u32_function_return_close(input_bytes, operator, next_token(input_bytes, semicolon), left, right),
        _ => Execution::Faulted,
    }
}

fn compile_u32_function_return_close(input_bytes: Bytes, operator: TokenStart, close: TokenStart, left: u32, right: u32) -> Execution {
    handle token_matches(input_bytes, close, "}") {
        true => compile_u32_function_end(input_bytes, operator, next_token(input_bytes, close), left, right),
        _ => Execution::Faulted,
    }
}

fn compile_u32_arithmetic_source_bytes(input_bytes: Bytes) -> Execution {
    let left = first_token(input_bytes);
    handle u32_literal_at(input_bytes, left) {
        U32LiteralAdmission::Value(left_value, left_last) => compile_u32_arithmetic_source_operator(input_bytes, next_token(input_bytes, left_last), left_value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_arithmetic_source_operator(input_bytes: Bytes, operator: TokenStart, left: u32) -> Execution {
    let right = next_token(input_bytes, operator);
    handle u32_literal_at(input_bytes, right) {
        U32LiteralAdmission::Value(right_value, right_last) => compile_u32_arithmetic_source_end(input_bytes, operator, next_token(input_bytes, right_last), left, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_arithmetic_source_end(input_bytes: Bytes, operator: TokenStart, end: TokenStart, left: u32, right: u32) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_u32_arithmetic_source_operation(input_bytes, operator, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_u32_arithmetic_source_operation(input_bytes: Bytes, operator: TokenStart, left: u32, right: u32) -> Execution {
    handle token_matches(input_bytes, operator, "+") {
        true => compile_u32_arithmetic(Arithmetic::Add, left, right, Type::U32),
        false => handle token_matches(input_bytes, operator, "-") {
            true => compile_u32_arithmetic(Arithmetic::Subtract, left, right, Type::U32),
            false => handle token_matches(input_bytes, operator, "*") {
                true => compile_u32_arithmetic(Arithmetic::Multiply, left, right, Type::U32),
                false => handle token_matches(input_bytes, operator, "/") {
                    true => compile_u32_arithmetic(Arithmetic::Divide, left, right, Type::U32),
                    false => handle token_matches(input_bytes, operator, "%") {
                        true => compile_u32_arithmetic(Arithmetic::Remainder, left, right, Type::U32),
                        _ => Execution::Faulted,
                    },
                },
                _ => Execution::Faulted,
            },
            _ => Execution::Faulted,
        },
        _ => Execution::Faulted,
    }
}

fn compile_signed_i64_arithmetic(bytes: Bytes) -> Execution {
    let left = first_token(bytes);
    handle signed_i64_literal_at(bytes, left) {
        SignedI64LiteralAdmission::Value(left_value, left_last) => compile_signed_i64_arithmetic_operator(bytes, next_token(bytes, left_last), left_value),
        _ => Execution::Faulted,
    }
}

fn compile_signed_i64_arithmetic_operator(bytes: Bytes, operator: TokenStart, left: i64) -> Execution {
    let right = next_token(bytes, operator);
    handle signed_i64_literal_at(bytes, right) {
        SignedI64LiteralAdmission::Value(right_value, right_last) => compile_signed_i64_arithmetic_end(bytes, operator, next_token(bytes, right_last), left, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_signed_i64_arithmetic_end(bytes: Bytes, operator: TokenStart, end: TokenStart, left: i64, right: i64) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_i64_function_arithmetic_operator(bytes, operator, left, right),
        _ => Execution::Faulted,
    }
}

pub fn compile_source_i64_comparison(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_signed_i64_comparison(source::bytes(input)),
        _ => Execution::Faulted,
    }
}

fn compile_signed_i64_comparison(bytes: Bytes) -> Execution {
    let left = first_token(bytes);
    handle signed_i64_literal_at(bytes, left) {
        SignedI64LiteralAdmission::Value(left_value, left_last) => compile_signed_i64_comparison_operator(bytes, next_token(bytes, left_last), left_value),
        _ => Execution::Faulted,
    }
}

fn compile_signed_i64_comparison_operator(bytes: Bytes, operator: TokenStart, left: i64) -> Execution {
    let right = next_token(bytes, operator);
    handle signed_i64_literal_at(bytes, right) {
        SignedI64LiteralAdmission::Value(right_value, right_last) => compile_signed_i64_comparison_end(bytes, operator, next_token(bytes, right_last), left, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_signed_i64_comparison_end(bytes: Bytes, operator: TokenStart, end: TokenStart, left: i64, right: i64) -> Execution {
    handle token_kind(end) {
        TokenKind::End => compile_i64_comparison_operator_value(bytes, operator, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_scanned_comparison(operation: ScannedComparison, left: i64, right: i64) -> Execution {
    handle operation {
        ScannedComparison::Equal => compile_i64_comparison(Comparison::Equal, left, right, Type::Bool),
        ScannedComparison::Less => compile_i64_comparison(Comparison::Less, left, right, Type::Bool),
        ScannedComparison::Greater => compile_i64_comparison(Comparison::Greater, left, right, Type::Bool),
        _ => Execution::Faulted,
    }
}

fn compile_scanned_arithmetic(operation: ScannedArithmetic, left: i64, right: i64) -> Execution {
    handle operation {
        ScannedArithmetic::Add => compile_i64_arithmetic(Arithmetic::Add, left, right, Type::I64),
        ScannedArithmetic::Subtract => compile_i64_arithmetic(Arithmetic::Subtract, left, right, Type::I64),
        ScannedArithmetic::Multiply => compile_i64_arithmetic(Arithmetic::Multiply, left, right, Type::I64),
        ScannedArithmetic::Divide => compile_i64_arithmetic(Arithmetic::Divide, left, right, Type::I64),
        _ => Execution::Faulted,
    }
}

// A binary function body has proven that both operands are its declared
// binders. Preserve that source fact in IR instead of lowering it as a pair
// of source literals merely because bootstrap execution carries concrete
// request values.
fn compile_parameter_arithmetic(operation: ScannedArithmetic, left: i64, right: i64) -> Execution {
    handle operation {
        ScannedArithmetic::Add => compile_parameter_arithmetic_body(Arithmetic::Add, left, right),
        ScannedArithmetic::Subtract => compile_parameter_arithmetic_body(Arithmetic::Subtract, left, right),
        ScannedArithmetic::Multiply => compile_parameter_arithmetic_body(Arithmetic::Multiply, left, right),
        ScannedArithmetic::Divide => compile_parameter_arithmetic_body(Arithmetic::Divide, left, right),
        _ => Execution::Faulted,
    }
}

fn compile_parameter_arithmetic_body(operation: Arithmetic, left: i64, right: i64) -> Execution {
    handle lower_mir(lower(Expression::ParameterI64Arithmetic(operation, left, right), Type::I64)) {
        mir::Terminator::ArithmeticReturn => execute_arithmetic(operation, left, right),
        _ => Execution::Faulted,
    }
}

fn finish_source_header(prefix: header::HeaderPrefix) -> ServiceOutcome {
    handle definition_from_prefix(prefix) {
        DefinitionAdmission::Value(_) => ServiceOutcome::Program,
        DefinitionAdmission::NotDeclaration => ServiceOutcome::Diagnostics,
        _ => ServiceOutcome::Diagnostics,
    }
}

pub fn compile_i64_literal(value: i64, expected: Type) -> Execution {
    execute_i64_literal_lowering(mir::lower_i64_literal(lower(Expression::I64(value), expected)))
}

pub fn compile_u32_literal(value: u32, expected: Type) -> Execution {
    execute_u32_literal_lowering(mir::lower_u32_literal(lower(Expression::U32(value), expected)))
}

pub fn compile_u32_identity_call(value: u32, expected: Type) -> Execution {
    execute_parameter_u32_lowering(mir::lower_parameter_u32(lower(Expression::ParameterU32(value), expected)))
}

pub fn compile_bool_literal(value: Bool, expected: Type) -> Execution {
    execute_bool_literal_lowering(mir::lower_bool_literal(lower(Expression::Bool(value), expected)))
}

pub fn compile_bool_not(value: Bool, expected: Type) -> Execution {
    execute_bool_not_lowering(mir::lower_bool_not(lower(Expression::BoolNot(value), expected)))
}

fn compile_parameter_bool_not(value: Bool, expected: Type) -> Execution {
    execute_bool_not_lowering(mir::lower_bool_not(lower(Expression::ParameterBoolNot(value), expected)))
}

// The bootstrap callable has explicit source-selected identity semantics. Its
// argument and result types travel through Body/Core/MIR first; the VM only
// receives an IdentityI64 instruction after CallReturn is admitted.
pub fn compile_i64_identity_call(value: i64, expected: Type) -> Execution {
    execute_call_lowering(mir::lower_call(lower(Expression::Call1(signature::callable(Type::I64, Type::I64), Type::I64), expected)), value, 0)
}

// The parser establishes binder/reference equality before this entrypoint.
// The concrete bound value then crosses Body, Core, MIR, and verified terminal
// execution as a local parameter rather than as a synthetic callable.
pub fn compile_i64_parameter_reference(value: i64, expected: Type) -> Execution {
    execute_parameter_i64_lowering(mir::lower_parameter_i64(lower(Expression::ParameterI64(value), expected)))
}

// A binary callable has its own arity contract in Body. Its arithmetic
// behavior is represented as a verified CallInstruction, not as an
// I64Arithmetic expression, so CallReturn remains observable to the backend.
pub fn compile_i64_add_call(left: i64, right: i64, expected: Type) -> Execution {
    execute_call_lowering(mir::lower_call(lower(Expression::Call2(signature::binary(Type::I64, Type::I64, Type::I64), Type::I64, Type::I64), expected)), left, right)
}

// This is the first pattern-producing codegen path.  Both the admission
// shape and result payload come from the same source-owned boolean pattern;
// a caller cannot claim a successful pattern while emitting an unrelated
// value.  Wider scalar and structural pattern lowering extend this boundary.
pub fn compile_bool_is_true(value: Bool, expected: Type) -> Execution {
    handle value {
        true => compile_bool_true_pattern(expected),
        false => compile_bool_false_pattern(expected),
        _ => Execution::Faulted,
    }
}

// Integer equality uses the same PatternTest IR shape, but unlike the
// boolean convenience form it takes both sides from the caller.  The
// comparison chooses only the terminal payload; the pattern-shaped body must
// still reach PatternReturn before that payload can execute.
pub fn compile_i64_equals(pattern: i64, value: i64, expected: Type) -> Execution {
    handle pattern == value {
        true => compile_i64_equal_pattern(pattern, value, expected),
        false => compile_i64_unequal_pattern(pattern, value, expected),
        _ => Execution::Faulted,
    }
}

// Wide pattern payloads stay typed at the source boundary. This uses the
// shared PatternTest route rather than coercing a u64 literal through i64;
// canonical encoded VM pattern instructions remain a later backend task.
pub fn compile_u64_equals(pattern: u64, value: u64, expected: Type) -> Execution {
    handle pattern == value {
        true => compile_pattern(Expression::PatternTest(Pattern::U64(pattern), Value::U64(value)), expected, 1),
        false => compile_pattern(Expression::PatternTest(Pattern::U64(pattern), Value::U64(value)), expected, 0),
        _ => Execution::Faulted,
    }
}

// Structural matching keeps the unselected pair field in the source IR even
// though PairFirst intentionally discards it. This exercises the distinct
// structural-pattern path rather than reducing pair matching to scalar input
// before Body/Core/MIR see it.
pub fn compile_i64_pair_first_equals(pattern: i64, first: i64, second: i64, expected: Type) -> Execution {
    handle pattern == first {
        true => compile_i64_pair_first_match(pattern, first, second, expected),
        false => compile_i64_pair_first_mismatch(pattern, first, second, expected),
        _ => Execution::Faulted,
    }
}

fn compile_i64_pair_first_match(pattern: i64, first: i64, second: i64, expected: Type) -> Execution {
    compile_pattern(Expression::PatternTest(Pattern::PairFirst(pattern), Value::Pair(first, second)), expected, 1)
}

fn compile_i64_pair_first_mismatch(pattern: i64, first: i64, second: i64, expected: Type) -> Execution {
    compile_pattern(Expression::PatternTest(Pattern::PairFirst(pattern), Value::Pair(first, second)), expected, 0)
}

pub fn compile_i64_pair_second_equals(pattern: i64, first: i64, second: i64, expected: Type) -> Execution {
    handle pattern == second {
        true => compile_pattern(Expression::PatternTest(Pattern::PairSecond(pattern), Value::Pair(first, second)), expected, 1),
        false => compile_pattern(Expression::PatternTest(Pattern::PairSecond(pattern), Value::Pair(first, second)), expected, 0),
        _ => Execution::Faulted,
    }
}

pub fn compile_i64_variant_equals(tag: i64, payload: i64, actual_tag: i64, actual_payload: i64, expected: Type) -> Execution {
    handle tag == actual_tag {
        true => compile_i64_variant_payload_equals(tag, payload, actual_tag, actual_payload, expected),
        false => compile_pattern(Expression::PatternTest(Pattern::Variant(tag, payload), Value::Variant(actual_tag, actual_payload)), expected, 0),
        _ => Execution::Faulted,
    }
}

fn compile_i64_variant_payload_equals(tag: i64, payload: i64, actual_tag: i64, actual_payload: i64, expected: Type) -> Execution {
    handle payload == actual_payload {
        true => compile_pattern(Expression::PatternTest(Pattern::Variant(tag, payload), Value::Variant(actual_tag, actual_payload)), expected, 1),
        false => compile_pattern(Expression::PatternTest(Pattern::Variant(tag, payload), Value::Variant(actual_tag, actual_payload)), expected, 0),
        _ => Execution::Faulted,
    }
}

fn compile_i64_equal_pattern(pattern: i64, value: i64, expected: Type) -> Execution {
    compile_pattern(Expression::PatternTest(Pattern::I64(pattern), Value::I64(value)), expected, 1)
}

fn compile_i64_unequal_pattern(pattern: i64, value: i64, expected: Type) -> Execution {
    compile_pattern(Expression::PatternTest(Pattern::I64(pattern), Value::I64(value)), expected, 0)
}

fn compile_bool_true_pattern(expected: Type) -> Execution {
    compile_pattern(Expression::PatternTest(Pattern::Bool(true), Value::Bool(true)), expected, 1)
}

fn compile_bool_false_pattern(expected: Type) -> Execution {
    compile_pattern(Expression::PatternTest(Pattern::Bool(true), Value::Bool(false)), expected, 0)
}

// All source pattern families use one terminal emission boundary. Keeping the
// PatternReturn check here prevents a new facade from attaching a successful
// payload to literal, arithmetic, call, or trap lowering.
fn compile_pattern(expression: Expression, expected: Type, result: i64) -> Execution {
    handle lower_mir(lower(expression, expected)) {
        mir::Terminator::PatternReturn => execute_candidate(CandidateProgram::Terminal(mir::Terminator::PatternReturn, result)),
        _ => Execution::Faulted,
    }
}

// Arithmetic reaches the same source body, Core, and MIR admission path as
// literals. Only the admitted arithmetic terminator may select the verified
// arithmetic instruction, keeping the VM payload tied to source structure.
pub fn compile_i64_arithmetic(operation: Arithmetic, left: i64, right: i64, expected: Type) -> Execution {
    handle lower_mir(lower(Expression::I64Arithmetic(operation, left, right), expected)) {
        mir::Terminator::ArithmeticReturn => execute_arithmetic(operation, left, right),
        _ => Execution::Faulted,
    }
}

// This is the typed service bridge for the unsigned pipeline. Textual u32
// admission and G1 artifact emission remain separate layers, so callers can
// exercise the real Body→Core→MIR→verified-VM route without an i64 proxy.
pub fn compile_u32_arithmetic(operation: Arithmetic, left: u32, right: u32, expected: Type) -> Execution {
    execute_u32_arithmetic_lowering(mir::lower_u32_arithmetic(lower(Expression::U32Arithmetic(operation, left, right), expected)))
}

pub fn compile_usize_arithmetic(operation: Arithmetic, left: usize, right: usize, expected: Type) -> Execution {
    execute_usize_arithmetic_lowering(mir::lower_usize_arithmetic(lower(Expression::UsizeArithmetic(operation, left, right), expected)))
}

fn compile_u32_parameter_arithmetic(operation: Arithmetic, left: u32, right: u32) -> Execution {
    execute_u32_arithmetic_lowering(mir::lower_u32_arithmetic(lower(Expression::ParameterU32Arithmetic(operation, left, right), Type::U32)))
}

fn execute_arithmetic(operation: Arithmetic, left: i64, right: i64) -> Execution {
    handle operation {
        Arithmetic::Add => execute_candidate(CandidateProgram::Arithmetic(ArithmeticInstruction::WrappingAdd(left, right))),
        Arithmetic::Subtract => execute_candidate(CandidateProgram::Arithmetic(ArithmeticInstruction::WrappingSub(left, right))),
        Arithmetic::Multiply => execute_candidate(CandidateProgram::Arithmetic(ArithmeticInstruction::WrappingMul(left, right))),
        Arithmetic::Divide => execute_candidate(CandidateProgram::Arithmetic(ArithmeticInstruction::CheckedDiv(left, right))),
        _ => Execution::Faulted,
    }
}

// Comparisons have their own Boolean-producing IR path.  They are not
// encoded as patterns: the VM instruction keeps ordinary relational
// semantics distinct from structural matching before control-flow lowering.
pub fn compile_i64_comparison(operation: Comparison, left: i64, right: i64, expected: Type) -> Execution {
    execute_i64_comparison_lowering(mir::lower_i64_comparison(lower(Expression::I64Comparison(operation, left, right), expected)))
}

pub fn compile_u64_comparison(operation: Comparison, left: u64, right: u64, expected: Type) -> Execution {
    execute_u64_comparison_lowering(mir::lower_u64_comparison(lower(Expression::U64Comparison(operation, left, right), expected)))
}
pub fn compile_u8_comparison(operation: Comparison, left: u8, right: u8, expected: Type) -> Execution {
    execute_u8_comparison_lowering(mir::lower_u8_comparison(lower(Expression::U8Comparison(operation, left, right), expected)))
}
pub fn compile_usize_comparison(operation: Comparison, left: usize, right: usize, expected: Type) -> Execution {
    execute_usize_comparison_lowering(mir::lower_usize_comparison(lower(Expression::UsizeComparison(operation, left, right), expected)))
}

// Conditional values are selected only after the typed conditional reaches
// MIR.  The VM sees both branches explicitly and receives no host callback
// for source control flow.
pub fn compile_i64_select(condition: Bool, when_true: i64, when_false: i64, expected: Type) -> Execution {
    execute_i64_select_lowering(mir::lower_i64_select(lower(Expression::I64Select(condition, when_true, when_false), expected)))
}

// The manifest branch primitive receives thunks, not precompiled branch
// results. Each selected arm still travels through typed literal lowering;
// the unselected arm is never admitted or executed on this path.
pub fn compile_manifest_branch_bool(condition: Bool, when_true: i64, when_false: i64, expected: Type) -> Execution {
    branch_bool(
        condition,
        () -> Execution { compile_i64_literal(when_true, expected) },
        () -> Execution { compile_i64_literal(when_false, expected) },
    )
}

// Literal-thunk branches with a compile-time Bool can reuse the canonical
// select artifact encoder. Runtime Bool parameters still require real CFG
// emission and are deliberately rejected rather than folded through host code.
pub fn compile_manifest_branch_bool_entry(condition: Bool, when_true: i64, when_false: i64) -> ArtifactEmission {
    emit_g1_for_i64_select_body(Expression::I64Select(condition, when_true, when_false), Type::I64)
}

// Preserve operand order around a lazy branch.  The left continuation waits
// for the selected thunk, while the right continuation receives its already
// admitted pure left operand only after branch selection has completed.
pub fn compile_manifest_branch_bool_add_left(condition: Bool, left: i64, when_true: i64, when_false: i64) -> Execution {
    continue_manifest_branch_add_left(compile_manifest_branch_bool(condition, when_true, when_false, Type::I64), left)
}
fn continue_manifest_branch_add_left(selected: Execution, left: i64) -> Execution {
    handle selected { Execution::Returned(right) => compile_i64_arithmetic(Arithmetic::Add, left, right, Type::I64), _ => Execution::Faulted }
}
pub fn compile_manifest_branch_bool_add_right(condition: Bool, when_true: i64, when_false: i64, right: i64) -> Execution {
    continue_manifest_branch_add_right(compile_manifest_branch_bool(condition, when_true, when_false, Type::I64), right)
}

// Source callable entry for the manifest branch form.  Header and binder
// admission are kept separate from the body cursor so the later thunk parser
// cannot mistake an unrelated identifier for the runtime condition.
pub fn compile_source_manifest_branch_bool_function(input: SourceInput, condition: Bool) -> Execution {
    handle token_stream_checked(input) { TokenStreamAdmission::Valid => compile_manifest_branch_first(source::bytes(input), first_token(source::bytes(input)), condition), _ => Execution::Faulted }
}
enum ManifestBranchContinuation { Plain, AddLeft(i64), ReturnPlain, ReturnAddLeft(i64) }
fn compile_manifest_branch_first(bytes: Bytes, first: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, first, "pub") { true => compile_manifest_branch_fn(bytes, next_token(bytes, first), condition), false => compile_manifest_branch_fn(bytes, first, condition), _ => Execution::Faulted } }
fn compile_manifest_branch_fn(bytes: Bytes, function: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, function, "fn") { true => compile_manifest_branch_name(bytes, next_token(bytes, function), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_name(bytes: Bytes, name: TokenStart, condition: Bool) -> Execution { handle token_kind(name) { TokenKind::Identifier => compile_manifest_branch_open(bytes, next_token(bytes, name), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_open(bytes: Bytes, open: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, open, "(") { true => compile_manifest_branch_binder(bytes, next_token(bytes, open), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_binder(bytes: Bytes, binder: TokenStart, condition: Bool) -> Execution { handle token_kind(binder) { TokenKind::Identifier => compile_manifest_branch_colon(bytes, binder, next_token(bytes, binder), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_colon(bytes: Bytes, binder: TokenStart, colon: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, colon, ":") { true => compile_manifest_branch_type(bytes, binder, next_token(bytes, colon), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_type(bytes: Bytes, binder: TokenStart, type_token: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, type_token, "Bool") { true => compile_manifest_branch_close(bytes, binder, next_token(bytes, type_token), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_close(bytes: Bytes, binder: TokenStart, close: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, close, ")") { true => compile_manifest_branch_arrow(bytes, binder, next_token(bytes, close), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_arrow(bytes: Bytes, binder: TokenStart, arrow: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, arrow, "->") { true => compile_manifest_branch_result(bytes, binder, next_token(bytes, arrow), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_result(bytes: Bytes, binder: TokenStart, result: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, result, "i64") { true => compile_manifest_branch_body_open(bytes, binder, next_token(bytes, result), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_body_open(bytes: Bytes, binder: TokenStart, open: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, open, "{") { true => compile_manifest_branch_body_expression(bytes, binder, next_token(bytes, open), condition), _ => Execution::Faulted } }
fn compile_manifest_branch_body_expression(bytes: Bytes, binder: TokenStart, first: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, first, "return") { true => compile_manifest_branch_expression(bytes, binder, next_token(bytes, first), condition, ManifestBranchContinuation::ReturnPlain), false => compile_manifest_branch_expression(bytes, binder, first, condition, ManifestBranchContinuation::Plain), _ => Execution::Faulted } }
fn compile_manifest_branch_expression(bytes: Bytes, binder: TokenStart, first: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, first, "branch_bool") { true => compile_manifest_branch_open_call(bytes, binder, next_token(bytes, first), condition, continuation), false => handle signed_i64_literal_at(bytes, first) { SignedI64LiteralAdmission::Value(left, last) => compile_manifest_branch_left_plus(bytes, binder, left, next_token(bytes, last), condition, continuation), _ => Execution::Faulted }, _ => Execution::Faulted } }
fn compile_manifest_branch_left_plus(bytes: Bytes, binder: TokenStart, left: i64, plus: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, plus, "+") { true => compile_manifest_branch_left_name(bytes, binder, left, next_token(bytes, plus), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_left_name(bytes: Bytes, binder: TokenStart, left: i64, name: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, name, "branch_bool") { true => compile_manifest_branch_open_call(bytes, binder, next_token(bytes, name), condition, manifest_branch_add_left_continuation(continuation, left)), _ => Execution::Faulted } }
fn manifest_branch_add_left_continuation(continuation: ManifestBranchContinuation, left: i64) -> ManifestBranchContinuation { handle continuation { ManifestBranchContinuation::Plain => ManifestBranchContinuation::AddLeft(left), ManifestBranchContinuation::ReturnPlain => ManifestBranchContinuation::ReturnAddLeft(left), _ => ManifestBranchContinuation::Plain } }
fn compile_manifest_branch_open_call(bytes: Bytes, binder: TokenStart, open: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, open, "(") { true => compile_manifest_branch_reference(bytes, binder, next_token(bytes, open), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_reference(bytes: Bytes, binder: TokenStart, reference: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_equals(bytes, binder, reference) { true => compile_manifest_branch_comma(bytes, next_token(bytes, reference), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_comma(bytes: Bytes, comma: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, comma, ",") { true => compile_manifest_branch_first_thunk_open(bytes, next_token(bytes, comma), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_first_thunk_open(bytes: Bytes, open: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, open, "(") { true => compile_manifest_branch_first_thunk_close(bytes, next_token(bytes, open), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_first_thunk_close(bytes: Bytes, close: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, close, ")") { true => compile_manifest_branch_first_thunk_arrow(bytes, next_token(bytes, close), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_first_thunk_arrow(bytes: Bytes, arrow: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, arrow, "->") { true => compile_manifest_branch_first_thunk_type(bytes, next_token(bytes, arrow), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_first_thunk_type(bytes: Bytes, type_token: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, type_token, "i64") { true => compile_manifest_branch_first_thunk_body(bytes, next_token(bytes, type_token), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_first_thunk_body(bytes: Bytes, open: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, open, "{") { true => compile_manifest_branch_first_value(bytes, next_token(bytes, open), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_first_value(bytes: Bytes, value: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle signed_i64_literal_at(bytes, value) { SignedI64LiteralAdmission::Value(first, last) => compile_manifest_branch_first_close(bytes, first, next_token(bytes, last), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_first_close(bytes: Bytes, first: i64, close: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, close, "}") { true => compile_manifest_branch_second_comma(bytes, first, next_token(bytes, close), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_second_comma(bytes: Bytes, first: i64, comma: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, comma, ",") { true => compile_manifest_branch_second_open(bytes, first, next_token(bytes, comma), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_second_open(bytes: Bytes, first: i64, open: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, open, "(") { true => compile_manifest_branch_second_close(bytes, first, next_token(bytes, open), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_second_close(bytes: Bytes, first: i64, close: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, close, ")") { true => compile_manifest_branch_second_arrow(bytes, first, next_token(bytes, close), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_second_arrow(bytes: Bytes, first: i64, arrow: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, arrow, "->") { true => compile_manifest_branch_second_type(bytes, first, next_token(bytes, arrow), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_second_type(bytes: Bytes, first: i64, type_token: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, type_token, "i64") { true => compile_manifest_branch_second_body(bytes, first, next_token(bytes, type_token), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_second_body(bytes: Bytes, first: i64, open: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, open, "{") { true => compile_manifest_branch_second_value(bytes, first, next_token(bytes, open), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_second_value(bytes: Bytes, first: i64, value: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle signed_i64_literal_at(bytes, value) { SignedI64LiteralAdmission::Value(second, last) => compile_manifest_branch_second_end(bytes, first, second, next_token(bytes, last), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_second_end(bytes: Bytes, first: i64, second: i64, close_thunk: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, close_thunk, "}") { true => compile_manifest_branch_call_close(bytes, first, second, next_token(bytes, close_thunk), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_call_close(bytes: Bytes, first: i64, second: i64, close_call: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle token_matches(bytes, close_call, ")") { true => compile_manifest_branch_after_call(bytes, first, second, next_token(bytes, close_call), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_after_call(bytes: Bytes, first: i64, second: i64, next: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle continuation { ManifestBranchContinuation::AddLeft(left) => handle token_matches(bytes, next, "}") { true => compile_manifest_branch_left_close(bytes, first, second, left, next_token(bytes, next), condition), _ => Execution::Faulted }, ManifestBranchContinuation::ReturnAddLeft(left) => handle token_matches(bytes, next, ";") { true => compile_manifest_branch_return_left_close(bytes, first, second, left, next_token(bytes, next), condition), _ => Execution::Faulted }, ManifestBranchContinuation::ReturnPlain => handle token_matches(bytes, next, ";") { true => compile_manifest_branch_return_end(bytes, first, second, next_token(bytes, next), condition), false => handle token_matches(bytes, next, "+") { true => compile_manifest_branch_right_value(bytes, first, second, next_token(bytes, next), condition, ManifestBranchContinuation::ReturnPlain), _ => Execution::Faulted }, _ => Execution::Faulted }, ManifestBranchContinuation::Plain => handle token_matches(bytes, next, "}") { true => compile_manifest_branch_end(bytes, first, second, next_token(bytes, next), condition), false => handle token_matches(bytes, next, "+") { true => compile_manifest_branch_right_value(bytes, first, second, next_token(bytes, next), condition, ManifestBranchContinuation::Plain), _ => Execution::Faulted }, _ => Execution::Faulted }, _ => Execution::Faulted } }
fn compile_manifest_branch_left_close(bytes: Bytes, first: i64, second: i64, left: i64, end: TokenStart, condition: Bool) -> Execution { handle token_kind(end) { TokenKind::End => compile_manifest_branch_bool_add_left(condition, left, first, second), _ => Execution::Faulted } }
fn compile_manifest_branch_return_left_close(bytes: Bytes, first: i64, second: i64, left: i64, close: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, close, "}") { true => handle token_kind(next_token(bytes, close)) { TokenKind::End => compile_manifest_branch_bool_add_left(condition, left, first, second), _ => Execution::Faulted }, _ => Execution::Faulted } }
fn compile_manifest_branch_return_end(bytes: Bytes, first: i64, second: i64, close: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, close, "}") { true => handle token_kind(next_token(bytes, close)) { TokenKind::End => compile_manifest_branch_bool(condition, first, second, Type::I64), _ => Execution::Faulted }, _ => Execution::Faulted } }
fn compile_manifest_branch_right_value(bytes: Bytes, first: i64, second: i64, value: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle signed_i64_literal_at(bytes, value) { SignedI64LiteralAdmission::Value(right, last) => compile_manifest_branch_right_close(bytes, first, second, right, next_token(bytes, last), condition, continuation), _ => Execution::Faulted } }
fn compile_manifest_branch_right_close(bytes: Bytes, first: i64, second: i64, right: i64, close: TokenStart, condition: Bool, continuation: ManifestBranchContinuation) -> Execution { handle continuation { ManifestBranchContinuation::Plain => handle token_matches(bytes, close, "}") { true => handle token_kind(next_token(bytes, close)) { TokenKind::End => compile_manifest_branch_bool_add_right(condition, first, second, right), _ => Execution::Faulted }, _ => Execution::Faulted }, ManifestBranchContinuation::ReturnPlain => handle token_matches(bytes, close, ";") { true => compile_manifest_branch_return_right_close(bytes, first, second, right, next_token(bytes, close), condition), _ => Execution::Faulted }, _ => Execution::Faulted } }
fn compile_manifest_branch_return_right_close(bytes: Bytes, first: i64, second: i64, right: i64, close: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, close, "}") { true => handle token_kind(next_token(bytes, close)) { TokenKind::End => compile_manifest_branch_bool_add_right(condition, first, second, right), _ => Execution::Faulted }, _ => Execution::Faulted } }
fn compile_manifest_branch_end(bytes: Bytes, first: i64, second: i64, end: TokenStart, condition: Bool) -> Execution { handle token_kind(end) { TokenKind::End => compile_manifest_branch_bool(condition, first, second, Type::I64), _ => Execution::Faulted } }
fn compile_manifest_branch_function_close(bytes: Bytes, first: i64, second: i64, close_function: TokenStart, condition: Bool) -> Execution { handle token_matches(bytes, close_function, "}") { true => handle token_kind(next_token(bytes, close_function)) { TokenKind::End => compile_manifest_branch_bool(condition, first, second, Type::I64), _ => Execution::Faulted }, _ => Execution::Faulted } }
fn continue_manifest_branch_add_right(selected: Execution, right: i64) -> Execution {
    handle selected { Execution::Returned(left) => compile_i64_arithmetic(Arithmetic::Add, left, right, Type::I64), _ => Execution::Faulted }
}

fn compile_parameter_i64_select(condition: Bool, when_true: i64, when_false: i64, expected: Type) -> Execution {
    execute_i64_select_lowering(mir::lower_i64_select(lower(Expression::ParameterI64Select(condition, when_true, when_false), expected)))
}


// Query execution is selected before a terminal compiler outcome exists. A
// cache miss is normal work, not a synthetic diagnostic; only a rejected
// (for example stale) query frame is refused at this boundary.
pub fn dispatch_query(policy: RecoveryPolicy, slot: QuerySlot, snapshot: Snapshot) -> ServiceDispatch {
    handle decide_at(policy, slot, snapshot) {
        QueryDecision::Reuse => ServiceDispatch::Reuse,
        QueryDecision::Compute => ServiceDispatch::Recompute,
        QueryDecision::Reject => ServiceDispatch::Rejected,
        _ => ServiceDispatch::Rejected,
    }
}

// Service dispatch retains the query engine's dependency gate. A stale
// dependency is ordinary recomputation, while a rejected query frame stays
// rejected rather than being revived by dependency state.
pub fn dispatch_query_with_dependencies(policy: RecoveryPolicy, slot: QuerySlot, snapshot: Snapshot, dependencies: DependencyStatus) -> ServiceDispatch {
    handle decide_with_dependencies(policy, slot, snapshot, dependencies) {
        QueryDecision::Reuse => ServiceDispatch::Reuse,
        QueryDecision::Compute => ServiceDispatch::Recompute,
        QueryDecision::Reject => ServiceDispatch::Rejected,
        _ => ServiceDispatch::Rejected,
    }
}

// Cancellation is evaluated by the query engine before this service can
// choose reuse or recomputation. The service only maps that owned decision
// into its public dispatch vocabulary.
pub fn dispatch_query_with_cancellation(policy: RecoveryPolicy, slot: QuerySlot, snapshot: Snapshot, dependencies: DependencyStatus, cancellation: Cancellation) -> ServiceDispatch {
    handle decide_with_cancellation(policy, slot, snapshot, dependencies, cancellation) {
        QueryDecision::Reuse => ServiceDispatch::Reuse,
        QueryDecision::Compute => ServiceDispatch::Recompute,
        QueryDecision::Reject => ServiceDispatch::Rejected,
        _ => ServiceDispatch::Rejected,
    }
}

// The service carries the query key through dispatch so that a same-revision
// entry from another query family is normal recomputation, never cache reuse.
pub fn dispatch_keyed_query_with_dependencies(policy: RecoveryPolicy, slot: QuerySlot, key: i64, snapshot: Snapshot, dependencies: DependencyStatus) -> ServiceDispatch {
    handle decide_keyed_with_dependencies(policy, slot, key, snapshot, dependencies) {
        QueryDecision::Reuse => ServiceDispatch::Reuse,
        QueryDecision::Compute => ServiceDispatch::Recompute,
        QueryDecision::Reject => ServiceDispatch::Rejected,
        _ => ServiceDispatch::Rejected,
    }
}

// Cache absence is expected operational work, distinct from a corrupt or
// verifier-rejected entry. The service therefore recomputes on a miss but
// refuses a rejected cache payload.
pub fn dispatch_cache(admission: CacheAdmission) -> ServiceDispatch {
    handle admission {
        CacheAdmission::Hit => ServiceDispatch::Reuse,
        CacheAdmission::Miss => ServiceDispatch::Recompute,
        CacheAdmission::Rejected => ServiceDispatch::Rejected,
        _ => ServiceDispatch::Rejected,
    }
}

// Cache and query admission are independent: a verified cache hit still
// cannot bypass a stale, wrong-key, or dependency-red query frame. A cache
// miss is ordinary recomputation, while either boundary may reject.
pub fn dispatch_cached_keyed_query(admission: CacheAdmission, policy: RecoveryPolicy, slot: QuerySlot, key: i64, snapshot: Snapshot, dependencies: DependencyStatus) -> ServiceDispatch {
    handle dispatch_cache(admission) {
        ServiceDispatch::Reuse => dispatch_keyed_query_with_dependencies(policy, slot, key, snapshot, dependencies),
        ServiceDispatch::Recompute => ServiceDispatch::Recompute,
        ServiceDispatch::Rejected => ServiceDispatch::Rejected,
        _ => ServiceDispatch::Rejected,
    }
}

// This is the request-facing counterpart of `dispatch_cached_keyed_query`.
// It keeps the full build identity attached until the exact point at which the
// service chooses reuse or recompilation.
pub fn dispatch_build_cached_keyed_query(entry: BuildBootstrapEntry, policy: RecoveryPolicy, slot: QuerySlot, key: i64, snapshot: Snapshot, dependencies: DependencyStatus) -> ServiceDispatch {
    dispatch_cached_keyed_query(admit_build_bootstrap(entry), policy, slot, key, snapshot, dependencies)
}

// This cache-only form is the source-world boundary before a stable typed
// query-key encoding is available. The world digest is derived internally;
// callers can commit an expected artifact world but cannot substitute an
// arbitrary actual-world digest for the request they are dispatching.
pub fn dispatch_build_source_world_cache(
    expected_build: CompilerBuildIdentity,
    actual_build: CompilerBuildIdentity,
    expected_world: Digest,
    actual_world: SourceWorld2,
    expected_artifact: Digest,
    actual_artifact: Digest,
    admission: ArtifactAdmission,
) -> ServiceDispatch {
    dispatch_cache(admit_build_source_world(
        expected_build,
        actual_build,
        expected_world,
        actual_world,
        expected_artifact,
        actual_artifact,
        admission,
    ))
}

// General request dispatch carries the admitted arbitrary-file bundle all the
// way to cache reuse.  This is intentionally parallel to the two-file facade
// while callers migrate: neither source order nor a caller-supplied actual
// world digest can influence the reuse decision.
pub fn dispatch_build_source_bundle_cache(
    expected_build: CompilerBuildIdentity,
    actual_build: CompilerBuildIdentity,
    expected_world: Digest,
    actual_bundle: SourceBundle,
    expected_artifact: Digest,
    actual_artifact: Digest,
    admission: ArtifactAdmission,
) -> ServiceDispatch {
    dispatch_cache(admit_build_source_bundle(
        expected_build,
        actual_build,
        expected_world,
        actual_bundle,
        expected_artifact,
        actual_artifact,
        admission,
    ))
}

// Publication is a distinct final authority boundary. A staged byte payload
// may become a program only after the output transaction commits; discarded
// or already-consumed publications cannot be reported as successful output.
pub fn finish_publication(result: CommitResult) -> ServiceOutcome {
    handle result {
        CommitResult::Value(_) => ServiceOutcome::Program,
        CommitResult::NotStaged => ServiceOutcome::VerificationFailed,
        _ => ServiceOutcome::VerificationFailed,
    }
}

// Cancellation is distinct from an invalid output transition. This adapter
// preserves that distinction when request-level publication reaches service.
pub fn finish_operation_publication(result: PublicationResult<Bytes>) -> ServiceOutcome {
    handle result {
        PublicationResult::Value(_) => ServiceOutcome::Program,
        PublicationResult::Cancelled => ServiceOutcome::Cancelled,
        _ => ServiceOutcome::VerificationFailed,
    }
}

// A verified cache entry is not sufficient authority to publish: it must also
// belong to the requested key, active snapshot, and dependency state. This
// is the end-to-end boundary used by a compiler request after either cached
// reuse or recomputation has produced a staged artifact. A rejected dispatch
// does not inspect (and therefore cannot commit) the supplied publication.
// Compatibility adapter for callers that already own a final commit result.
// New request orchestration must use `publish_cached_keyed` below so the
// output transition itself remains behind dispatch admission.
pub fn finish_cached_keyed_publication(admission: CacheAdmission, policy: RecoveryPolicy, slot: QuerySlot, key: i64, snapshot: Snapshot, dependencies: DependencyStatus, publication: CommitResult) -> ServiceOutcome {
    handle dispatch_cached_keyed_query(admission, policy, slot, key, snapshot, dependencies) {
        ServiceDispatch::Reuse => finish_publication(publication),
        ServiceDispatch::Recompute => finish_publication(publication),
        ServiceDispatch::Rejected => ServiceOutcome::Diagnostics,
        _ => ServiceOutcome::Diagnostics,
    }
}

// The production admission boundary receives a staged value and performs the
// irreversible output transition only after cache/query/dependency admission.
// Thus a rejected frame cannot publish even under eager argument evaluation.
pub fn publish_cached_keyed(admission: CacheAdmission, policy: RecoveryPolicy, slot: QuerySlot, key: i64, snapshot: Snapshot, dependencies: DependencyStatus, publication: Publication) -> ServiceOutcome {
    branch_bool(
        permits_cached_keyed_publication(admission, policy, slot, key, snapshot, dependencies),
        () -> ServiceOutcome { finish_publication(commit(publication)) },
        () -> ServiceOutcome { ServiceOutcome::Diagnostics },
    )
}

// The request-facing cache boundary owns admission rather than trusting its
// caller to have performed it. This makes compiler generation, query,
// interface, cache, bytecode, and verifier identities mandatory inputs to a
// reuse decision before a publication can become visible.
pub fn publish_build_cached_keyed(entry: BuildBootstrapEntry, policy: RecoveryPolicy, slot: QuerySlot, key: i64, snapshot: Snapshot, dependencies: DependencyStatus, publication: Publication) -> ServiceOutcome {
    publish_cached_keyed(admit_build_bootstrap(entry), policy, slot, key, snapshot, dependencies, publication)
}

// Keep the enum elimination separate from the affine publication value. This
// specializes to a direct CFG branch and lets the MIR backend prove that the
// commit exists only on an admissible path.
pub fn permits_cached_keyed_publication(admission: CacheAdmission, policy: RecoveryPolicy, slot: QuerySlot, key: i64, snapshot: Snapshot, dependencies: DependencyStatus) -> Bool {
    handle dispatch_cached_keyed_query(admission, policy, slot, key, snapshot, dependencies) {
        ServiceDispatch::Reuse => true,
        ServiceDispatch::Recompute => true,
        ServiceDispatch::Rejected => false,
        _ => false,
    }
}

pub fn finish(event: ServiceEvent) -> ServiceOutcome {
    handle event {
        ServiceEvent::PublishedVerifiedProgram => ServiceOutcome::Program,
        ServiceEvent::Cancelled => ServiceOutcome::Cancelled,
        ServiceEvent::Diagnostics => ServiceOutcome::Diagnostics,
        ServiceEvent::VerificationFailed => ServiceOutcome::VerificationFailed,
        _ => ServiceOutcome::VerificationFailed,
    }
}
