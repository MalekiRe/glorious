pub enum ServiceEvent { PublishedVerifiedProgram, Cancelled, Diagnostics, VerificationFailed }
pub enum ServiceOutcome { Program, Cancelled, Diagnostics, VerificationFailed }
pub enum ServiceDispatch { Reuse, Recompute, Rejected }
pub enum VerifyVmEntryResult { Verified, Rejected }

// This is the production source-owned `emit-vm` entry boundary.  The launcher
// supplies only argv and the two explicit file capabilities; command shape,
// source selection, artifact selection, and publication remain in compiler
// source.  Tests may pass an argv array directly, while an executable entry
// obtains it through the separately capability-bound process adapter below.
pub fn emit_vm_entry_from_argv(argv: Array<Text>) -> EmitUnitEntryResult {
    dispatch_emit_vm_request(parse_argv_emit_vm_request(argv))
}

pub fn emit_vm_entry_from_process_args() -> EmitUnitEntryResult {
    dispatch_emit_vm_request(parse_process_argv_emit_vm_request())
}

fn dispatch_emit_vm_request(request: EmitVmRequest) -> EmitUnitEntryResult {
    handle request {
        EmitVmRequest::Value(package, source_path, output_path) => emit_file_vm_entry(package, source_path, output_path),
        EmitVmRequest::Invalid => EmitUnitEntryResult::Rejected,
        _ => EmitUnitEntryResult::Rejected,
    }
}

// `verify-vm` shares the same source-owned argv admission as emission, but
// it never grants publication authority. The only capability it reaches is
// the immutable artifact read consumed by the bounded G1 verifier.
pub fn verify_vm_entry_from_argv(argv: Array<Text>) -> VerifyVmEntryResult {
    dispatch_verify_vm_request(parse_argv_verify_vm_request(argv))
}

pub fn verify_vm_entry_from_process_args() -> VerifyVmEntryResult {
    dispatch_verify_vm_request(parse_process_argv_verify_vm_request())
}

fn dispatch_verify_vm_request(request: VerifyVmRequest) -> VerifyVmEntryResult {
    handle request {
        VerifyVmRequest::Value(package, artifact_path) => handle verify_file_vm_artifact(package, artifact_path) {
            true => VerifyVmEntryResult::Verified,
            false => VerifyVmEntryResult::Rejected,
            _ => VerifyVmEntryResult::Rejected,
        },
        VerifyVmRequest::Invalid => VerifyVmEntryResult::Rejected,
        _ => VerifyVmEntryResult::Rejected,
    }
}

// A request-owned source record enters the compiler service only through the
// scanner's digest-checked entry point. This is deliberately the earliest
// source-to-service slice: parsing and type checking will refine `Program`,
// but substituted or otherwise unadmitted bytes already become diagnostics
// and cannot reach the compilation pipeline.
pub fn admit_source(input: SourceInput) -> ServiceOutcome {
    handle first_token_checked(input) {
        SourceToken::Value(_) => ServiceOutcome::Program,
        SourceToken::Unadmitted => ServiceOutcome::Diagnostics,
        _ => ServiceOutcome::Diagnostics,
    }
}

// Request-world admission remains separate from parsing until the source
// collection becomes iterable. The service still classifies the normalized
// request before a caller can start a partial compilation pipeline.
pub fn admit_source_world(world: SourceWorldAdmission) -> ServiceOutcome {
    handle world {
        SourceWorldAdmission::Value(_) => ServiceOutcome::Program,
        _ => ServiceOutcome::Diagnostics,
    }
}

// An admitted request world advances both of its immutable members through
// the ordinary lexical/header/interface boundary. This avoids the dangerous
// partial-world behavior where one source could publish a usable service
// result while its sibling has not been checked yet.
pub fn compile_source_world_headers(world: SourceWorldAdmission) -> ServiceOutcome {
    handle exact_from_source_world2_admission(world) {
        ExactGraphAdmission::Value(_) => compile_admitted_source_world_headers(world),
        ExactGraphAdmission::Unadmitted => ServiceOutcome::Diagnostics,
        _ => ServiceOutcome::Diagnostics,
    }
}

// The scalable request path is deliberately independent of SourceWorld2:
// every admitted member must cross the same lexical/header/interface gate
// before the service can report a usable compilation result.
pub fn compile_source_bundle_headers(bundle: SourceBundleAdmission) -> ServiceOutcome {
    handle bundle {
        SourceBundleAdmission::Value(value) => compile_source_sequence_headers(source_bundle_sources(value)),
        _ => ServiceOutcome::Diagnostics,
    }
}
fn compile_source_sequence_headers(sources: SourceSequence) -> ServiceOutcome {
    handle sources {
        SourceSequence::Empty => ServiceOutcome::Program,
        SourceSequence::Node(input, has_tail, tail) => compile_source_sequence_header_one(input, has_tail, tail),
        _ => ServiceOutcome::Diagnostics,
    }
}
fn compile_source_sequence_header_one(input: SourceInput, has_tail: Bool, tail: Array<SourceSequence>) -> ServiceOutcome {
    handle compile_source_header(input) {
        ServiceOutcome::Program => branch_bool(has_tail,
            () -> ServiceOutcome { compile_source_sequence_headers(__g1_array_pop_move<SourceSequence>(&mut tail)) },
            () -> ServiceOutcome { ServiceOutcome::Program },
        ),
        _ => ServiceOutcome::Diagnostics,
    }
}

fn compile_admitted_source_world_headers(world: SourceWorldAdmission) -> ServiceOutcome {
    handle world {
        SourceWorldAdmission::Value(value) => compile_source_world_first(value),
        _ => ServiceOutcome::Diagnostics,
    }
}

fn compile_source_world_first(world: request::SourceWorld2) -> ServiceOutcome {
    handle compile_source_header(source_world2_first(world)) {
        ServiceOutcome::Program => compile_source_world_second(world),
        _ => ServiceOutcome::Diagnostics,
    }
}

fn compile_source_world_second(world: request::SourceWorld2) -> ServiceOutcome {
    handle compile_source_header(source_world2_second(world)) {
        ServiceOutcome::Program => ServiceOutcome::Program,
        _ => ServiceOutcome::Diagnostics,
    }
}


// This is the first compiler-service path that carries source all the way
// through scanner, header parsing, and interface collection. The service
// accepts a source request only when its immutable identity is admitted and
// its leading declaration produces a real interface definition. Later body
// parsing and type checking extend this same result, rather than bypassing
// source admission with a separately constructed Body expression.
pub fn compile_source_header(input: SourceInput) -> ServiceOutcome {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_source_header(input),
        _ => ServiceOutcome::Diagnostics,
    }
}

pub fn compile_source_named_header(input: SourceInput) -> ServiceOutcome {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_named_header(input),
        _ => ServiceOutcome::Diagnostics,
    }
}

fn compile_lexically_valid_named_header(input: SourceInput) -> ServiceOutcome {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => finish_source_header(prefix),
        _ => ServiceOutcome::Diagnostics,
    }
}

fn compile_lexically_valid_source_header(input: SourceInput) -> ServiceOutcome {
    // General source-header admission still includes nameless declaration
    // forms (imports, implementations, and fixities), but every form with a
    // required identifier now crosses M09's checked name gate before an
    // interface definition can be manufactured.
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => finish_complete_source_headers(input, prefix),
        SourceHeaderAdmission::Unadmitted => ServiceOutcome::Diagnostics,
        _ => ServiceOutcome::Diagnostics,
    }
}

fn finish_complete_source_headers(input: SourceInput, prefix: header::HeaderPrefix) -> ServiceOutcome {
    handle declaration_sequence_checked(input) {
        HeaderSequenceAdmission::Value(_) => finish_source_header(prefix),
        HeaderSequenceAdmission::Rejected => ServiceOutcome::Diagnostics,
        HeaderSequenceAdmission::Unadmitted => ServiceOutcome::Diagnostics,
        _ => ServiceOutcome::Diagnostics,
    }
}

// The capability boundary is intentionally outside all compiler semantics:
// source owns the read and immutable digest, then the same scanner/header/
// interface route handles a file-backed request as an in-memory one.
pub fn compile_file_header(package: Text, logical_path: Text) -> ServiceOutcome {
    handle package_is_valid(package) {
        true => compile_source_header(input_from_file(package, logical_path)),
        false => ServiceOutcome::Diagnostics,
        _ => ServiceOutcome::Diagnostics,
    }
}

// Check-mode must not stop after a valid declaration prefix: lexical errors
// elsewhere in the same immutable source are compiler errors too. This keeps
// the header-only service useful for libraries while making its file-backed
// command boundary consume the complete scanner admission.
pub fn check_file(package: Text, logical_path: Text) -> ServiceOutcome {
    handle package_is_valid(package) {
        true => check_file_valid_package(input_from_file(package, logical_path)),
        false => ServiceOutcome::Diagnostics,
        _ => ServiceOutcome::Diagnostics,
    }
}

fn check_file_valid_package(input: SourceInput) -> ServiceOutcome {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_source_header(input),
        _ => ServiceOutcome::Diagnostics,
    }
}

pub fn compile_file_i64_literal(package: Text, logical_path: Text) -> Execution {
    compile_source_i64_literal(input_from_file(package, logical_path))
}

// File-backed declarations use the identical immutable source route as an
// in-memory request. The only host effect remains the explicit SourceInput
// construction at this boundary; parsing and lowering never receive a path.
pub fn compile_file_i64_function(package: Text, logical_path: Text) -> Execution {
    compile_source_i64_function(input_from_file(package, logical_path))
}

// Unsigned declarations use the same file-backed SourceInput boundary as
// signed declarations.  Keeping this as a separate typed entrypoint prevents
// a caller from observing a u32 result through an i64-only helper.
pub fn compile_file_u32_function(package: Text, logical_path: Text) -> Execution {
    compile_source_u32_function(input_from_file(package, logical_path))
}

// The executable `run` mode selects the currently admitted i64 declaration
// forms from one immutable source input.  This is compiler policy, not a host
// retry: the input stays source-owned while ordinary literal/arithmetic and
// literal-conditional lowering decide their own acceptance.
pub fn run_file(package: Text, logical_path: Text) -> Execution {
    handle package_is_valid(package) {
        true => run_file_valid_package(package, logical_path),
        false => Execution::Faulted,
        _ => Execution::Faulted,
    }
}

fn run_file_valid_package(package: Text, logical_path: Text) -> Execution {
    let input = input_from_file(package, logical_path);
    handle executable_source_declares_main(input) {
        true => run_source(input),
        false => Execution::Faulted,
        _ => Execution::Faulted,
    }
}

// Stage0 invokes the program entrypoint, rather than selecting an arbitrary
// declaration solely because its body is executable.  Keep that policy at
// the file-backed command boundary: lower-level source APIs remain generic
// so callers can compile and test named declarations normally.
fn executable_source_declares_main(input: SourceInput) -> Bool {
    let bytes = source::bytes(input);
    executable_source_declares_main_after_visibility(bytes, first_token(bytes))
}

fn executable_source_declares_main_after_visibility(bytes: Bytes, token: TokenStart) -> Bool {
    handle token_matches(bytes, token, "pub") {
        true => executable_source_declares_main_function(bytes, next_token(bytes, token)),
        false => executable_source_declares_main_function(bytes, token),
        _ => false,
    }
}

fn executable_source_declares_main_function(bytes: Bytes, token: TokenStart) -> Bool {
    handle token_matches(bytes, token, "fn") {
        true => token_matches(bytes, next_token(bytes, token), "main"),
        false => false,
        _ => false,
    }
}

pub fn package_is_valid(package: Text) -> Bool {
    package_alias_is_valid(package_key(package))
}

// This is the first file-backed verifier path. It deliberately accepts only
// the canonical G1 Unit-entry image already reconstructed and checked by the
// source backend; other G1 shapes stay rejected until the general source
// decoder/verifier is available rather than being delegated to the Rust VM.
pub fn verify_file_vm_artifact(package: Text, logical_path: Text) -> Bool {
    handle package_is_valid(package) {
        true => verify_file_vm_artifact_valid_package(input_from_file(package, logical_path)),
        false => false,
        _ => false,
    }
}

fn verify_file_vm_artifact_valid_package(input: SourceInput) -> Bool {
    let bytes = source::bytes(input);
    handle vm_backend::verify_g1_unit_entry_artifact(bytes) {
        true => true,
        false => handle vm_backend::verify_g1_i64_callable_artifact(bytes) {
            true => true,
            false => handle vm_backend::verify_g1_i64_binary_artifact(bytes) {
                true => true,
                false => handle vm_backend::verify_g1_i64_identity_call_artifact(bytes) {
                    true => true,
                    false => handle vm_backend::verify_g1_i64_binary_call_artifact(bytes) {
                        true => true,
                        false => vm_backend::verify_g1_i64_entry_artifact(bytes),
                        _ => false,
                    },
                    _ => false,
                },
                _ => false,
            },
            _ => false,
        },
        _ => false,
    }
}

fn run_source(input: SourceInput) -> Execution {
    handle compile_source_i64_function(input) {
        Execution::Returned(value) => Execution::Returned(value),
        Execution::Faulted => run_source_after_i64_function(input),
        _ => Execution::Faulted,
    }
}

fn run_source_after_i64_function(input: SourceInput) -> Execution {
    handle compile_source_i64_select_function(input) {
        Execution::Returned(value) => Execution::Returned(value),
        Execution::Faulted => run_source_after_i64_select(input),
        _ => Execution::Faulted,
    }
}

fn run_source_after_i64_select(input: SourceInput) -> Execution {
    handle compile_source_i64_comparison_function(input) {
        Execution::Returned(value) => Execution::Returned(value),
        Execution::Faulted => run_source_after_i64_comparison(input),
        _ => Execution::Faulted,
    }
}

fn run_source_after_i64_comparison(input: SourceInput) -> Execution {
    handle compile_source_bool_function(input) {
        Execution::Returned(value) => Execution::Returned(value),
        Execution::Faulted => run_source_after_bool_function(input),
        _ => Execution::Faulted,
    }
}

// The run dispatcher preserves the unsigned execution variant all the way to
// its public service result.  The i64-only process driver remains an explicit
// separate protocol boundary instead of silently narrowing or reinterpreting
// an unsigned result.
fn run_source_after_bool_function(input: SourceInput) -> Execution {
    handle compile_source_bool_not_literal_function(input) {
        Execution::Returned(value) => Execution::Returned(value),
        Execution::Faulted => compile_source_u32_function(input),
        _ => Execution::Faulted,
    }
}

// File-backed primitive emission follows the same immutable SourceInput
// boundary as all other declaration services.
pub fn compile_file_i64_function_arithmetic_entry(package: Text, logical_path: Text) -> ArtifactEmission {
    compile_source_i64_function_arithmetic_entry(input_from_file(package, logical_path))
}

pub fn compile_file_i64_add_function(package: Text, logical_path: Text, left: i64, right: i64) -> Execution {
    compile_source_i64_add_function(input_from_file(package, logical_path), left, right)
}

// Parameter values are request data, not a host-side semantic fallback. The
// immutable file source still proves the binder/body relation before those
// values are materialized by the Unit entry and passed to the G1 callee.
pub fn compile_file_i64_binary_function_entry(package: Text, logical_path: Text, left: i64, right: i64) -> ArtifactEmission {
    compile_source_i64_binary_function_entry(input_from_file(package, logical_path), left, right)
}

pub fn compile_file_i64_select_function(package: Text, logical_path: Text) -> Execution {
    compile_source_i64_select_function(input_from_file(package, logical_path))
}

pub fn compile_file_i64_select_function_entry(package: Text, logical_path: Text) -> ArtifactEmission {
    compile_source_i64_select_function_entry(input_from_file(package, logical_path))
}

// File-backed G1 compilation deliberately reuses the immutable-source route;
// neither the service nor the backend receives a host path after this outer
// capability boundary.  This is the production counterpart of the in-memory
// unit-entry probe and is the route a source-owned `emit-vm` command uses.
pub fn compile_file_unit_entry(package: Text, logical_path: Text) -> ArtifactEmission {
    compile_source_unit_entry(input_from_file(package, logical_path))
}

pub enum EmitUnitEntryResult { Written, Rejected }

// Publication is kept separate from compilation: only a verified-shaped
// artifact returned by the backend may be staged and atomically published.
// A malformed source never reaches the file-write capability.
pub fn emit_file_unit_entry(package: Text, logical_path: Text, output_path: Text) -> EmitUnitEntryResult {
    handle compile_file_unit_entry(package, logical_path) {
        ArtifactEmission::Artifact(bytes) => emit_unit_entry_bytes(output_path, bytes),
        ArtifactEmission::Rejected => EmitUnitEntryResult::Rejected,
        _ => EmitUnitEntryResult::Rejected,
    }
}

pub fn emit_file_i64_function_arithmetic_entry(package: Text, logical_path: Text, output_path: Text) -> EmitUnitEntryResult {
    handle compile_file_i64_function_arithmetic_entry(package, logical_path) {
        ArtifactEmission::Artifact(bytes) => emit_unit_entry_bytes(output_path, bytes),
        ArtifactEmission::Rejected => EmitUnitEntryResult::Rejected,
        _ => EmitUnitEntryResult::Rejected,
    }
}

pub fn emit_file_i64_binary_function_entry(package: Text, logical_path: Text, left: i64, right: i64, output_path: Text) -> EmitUnitEntryResult {
    handle compile_file_i64_binary_function_entry(package, logical_path, left, right) {
        ArtifactEmission::Artifact(bytes) => emit_unit_entry_bytes(output_path, bytes),
        ArtifactEmission::Rejected => EmitUnitEntryResult::Rejected,
        _ => EmitUnitEntryResult::Rejected,
    }
}

pub fn emit_file_i64_select_function_entry(package: Text, logical_path: Text, output_path: Text) -> EmitUnitEntryResult {
    handle compile_file_i64_select_function_entry(package, logical_path) {
        ArtifactEmission::Artifact(bytes) => emit_unit_entry_bytes(output_path, bytes),
        ArtifactEmission::Rejected => EmitUnitEntryResult::Rejected,
        _ => EmitUnitEntryResult::Rejected,
    }
}

// `emit-vm` selects the first fully admitted executable source form. This is
// a compiler-owned dispatch point; it does not inspect a path or delegate
// language selection to the host launcher.
pub fn emit_file_vm_entry(package: Text, logical_path: Text, output_path: Text) -> EmitUnitEntryResult {
    handle package_is_valid(package) {
        true => emit_file_vm_entry_valid_package(package, logical_path, output_path),
        false => EmitUnitEntryResult::Rejected,
        _ => EmitUnitEntryResult::Rejected,
    }
}

fn emit_file_vm_entry_valid_package(package: Text, logical_path: Text, output_path: Text) -> EmitUnitEntryResult {
    let input = input_from_file(package, logical_path);
    handle executable_source_declares_main(input) {
        true => emit_file_vm_main_entry(input, output_path),
        false => EmitUnitEntryResult::Rejected,
        _ => EmitUnitEntryResult::Rejected,
    }
}

fn emit_file_vm_main_entry(input: SourceInput, output_path: Text) -> EmitUnitEntryResult {
    handle compile_source_unit_entry(input) {
        ArtifactEmission::Artifact(bytes) => emit_unit_entry_bytes(output_path, bytes),
        ArtifactEmission::Rejected => emit_source_i64_function_arithmetic_or_scalar_entry_to_file(input, output_path),
        _ => EmitUnitEntryResult::Rejected,
    }
}

fn emit_source_i64_function_arithmetic_or_scalar_entry_to_file(input: SourceInput, output_path: Text) -> EmitUnitEntryResult {
    handle compile_source_i64_function_arithmetic_entry(input) {
        ArtifactEmission::Artifact(bytes) => emit_unit_entry_bytes(output_path, bytes),
        ArtifactEmission::Rejected => emit_source_i64_function_select_or_scalar_entry_to_file(input, output_path),
        _ => EmitUnitEntryResult::Rejected,
    }
}

fn emit_source_i64_function_select_or_scalar_entry_to_file(input: SourceInput, output_path: Text) -> EmitUnitEntryResult {
    handle compile_source_i64_select_function_entry(input) {
        ArtifactEmission::Artifact(bytes) => emit_unit_entry_bytes(output_path, bytes),
        ArtifactEmission::Rejected => emit_source_i64_function_scalar_entry_to_file(input, output_path),
        _ => EmitUnitEntryResult::Rejected,
    }
}

fn emit_source_i64_function_scalar_entry_to_file(input: SourceInput, output_path: Text) -> EmitUnitEntryResult {
    handle compile_source_i64_function_entry(input) {
        ArtifactEmission::Artifact(bytes) => emit_unit_entry_bytes(output_path, bytes),
        _ => EmitUnitEntryResult::Rejected,
    }
}

fn emit_unit_entry_bytes(output_path: Text, bytes: Bytes) -> EmitUnitEntryResult {
    handle output::write_to(output::stage(output_path, bytes), output_path) {
        output::WriteResult::Written => EmitUnitEntryResult::Written,
        output::WriteResult::NotStaged => EmitUnitEntryResult::Rejected,
        output::WriteResult::TargetMismatch => EmitUnitEntryResult::Rejected,
        _ => EmitUnitEntryResult::Rejected,
    }
}

// This expression path is sourced from immutable text rather than a
// host-supplied integer. It reuses the existing typed Body→Core→MIR→VM
// literal lowering after scanner-owned decimal decoding succeeds.
pub fn compile_source_i64_literal(input: SourceInput) -> Execution {
    handle signed_i64_literal_at_checked(input, first_token(source::bytes(input))) {
        SignedI64LiteralAdmission::Value(value, last) => compile_source_i64_literal_end(source::bytes(input), last, value),
        _ => Execution::Faulted,
    }
}

fn compile_source_i64_literal_end(bytes: Bytes, last: TokenStart, value: i64) -> Execution {
    handle token_kind(next_token(bytes, last)) {
        TokenKind::End => compile_i64_literal(value, Type::I64),
        _ => Execution::Faulted,
    }
}

// The first source-text-to-artifact route.  The scanner, header, and
// interface admission remain mandatory before this deliberately strict unit
// entry grammar reaches typed G1 emission.
pub fn compile_source_unit_entry(input: SourceInput) -> ArtifactEmission {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_unit_entry(input),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_lexically_valid_unit_entry(input: SourceInput) -> ArtifactEmission {
    handle named_declaration_checked(input) {
        SourceHeaderAdmission::Value(prefix) => handle definition_from_prefix(prefix) {
            DefinitionAdmission::Value(_) => compile_unit_entry_visibility(source::bytes(input), first_token(source::bytes(input))),
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_unit_entry_visibility(bytes: Bytes, first: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, first, "fn") {
        true => compile_unit_entry_tokens(bytes, first),
        false => handle token_matches(bytes, first, "pub") {
            true => compile_unit_entry_tokens(bytes, next_token(bytes, first)),
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_unit_entry_tokens(bytes: Bytes, function: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, function, "fn") {
        true => compile_unit_entry_name(bytes, next_token(bytes, function)),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_name(bytes: Bytes, name: TokenStart) -> ArtifactEmission {
    handle token_kind(name) {
        TokenKind::Identifier => compile_unit_entry_open(bytes, next_token(bytes, name), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_open(bytes: Bytes, open: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, open, "(") {
        true => compile_unit_entry_close_parameters(bytes, next_token(bytes, open), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_close_parameters(bytes: Bytes, close: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, close, ")") {
        true => compile_unit_entry_arrow(bytes, next_token(bytes, close), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_arrow(bytes: Bytes, arrow: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, arrow, "->") {
        true => compile_unit_entry_result(bytes, next_token(bytes, arrow), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_result(bytes: Bytes, result: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, result, "Unit") {
        true => compile_unit_entry_body_open(bytes, next_token(bytes, result), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_body_open(bytes: Bytes, open: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, open, "{") {
        true => compile_unit_entry_body_first(bytes, next_token(bytes, open), name),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_unit_entry_body_first(bytes: Bytes, first: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, first, "return") {
        true => compile_unit_entry_return_value_open(bytes, next_token(bytes, first), name),
        false => compile_unit_entry_value_open(bytes, first, name),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_unit_entry_return_value_open(bytes: Bytes, open: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, open, "(") {
        true => compile_unit_entry_return_value_close(bytes, next_token(bytes, open), name),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_unit_entry_return_value_close(bytes: Bytes, close: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, close, ")") {
        true => compile_unit_entry_return_semicolon(bytes, next_token(bytes, close), name),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_unit_entry_return_semicolon(bytes: Bytes, semicolon: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, semicolon, ";") {
        true => compile_unit_entry_body_close(bytes, next_token(bytes, semicolon), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_value_open(bytes: Bytes, open: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, open, "(") {
        true => compile_unit_entry_value_close(bytes, next_token(bytes, open), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_value_close(bytes: Bytes, close: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, close, ")") {
        true => compile_unit_entry_body_close(bytes, next_token(bytes, close), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_body_close(bytes: Bytes, close: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_matches(bytes, close, "}") {
        true => compile_unit_entry_end(bytes, next_token(bytes, close), name),
        _ => ArtifactEmission::Rejected,
    }
}
fn compile_unit_entry_end(bytes: Bytes, end: TokenStart, name: TokenStart) -> ArtifactEmission {
    handle token_kind(end) {
        TokenKind::End => emit_g1_named_unit_entry(__g1_bytes_slice(bytes, token_start(name), token_end(name))),
        _ => ArtifactEmission::Rejected,
    }
}

// This is the first source-defined declaration body that reaches the typed
// lowering pipeline.  It recognizes the deliberately narrow bootstrap form
// `fn name { decimal }`: scanner-owned tokens establish the complete shape,
// then the body literal reuses the ordinary Body→Core→MIR→VM path.  Rich
// signatures and expressions extend this parser rather than bypassing it.
pub fn compile_source_i64_function(input: SourceInput) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_i64_function(input),
        _ => Execution::Faulted,
    }
}

// The artifact route deliberately reuses the ordinary source declaration
// admission and typed Body→Core→MIR execution path.  The resulting scalar is
// encoded as a private G1 i64 function behind a valid Unit entrypoint.
pub fn compile_source_i64_function_entry(input: SourceInput) -> ArtifactEmission {
    handle compile_source_i64_function(input) {
        Execution::Returned(value) => emit_g1_i64_callable(value),
        Execution::Faulted => ArtifactEmission::Rejected,
        _ => ArtifactEmission::Rejected,
    }
}

// This shorthand declaration route preserves the existing declaration/body
// admission, then carries the source operands and operator all the way to
// the G1 primitive encoder rather than publishing the interpreter's folded
// result. Signatures and parameterized bodies extend this same cursor path.
pub fn compile_source_i64_function_arithmetic_entry(input: SourceInput) -> ArtifactEmission {
    handle compile_source_i64_function(input) {
        Execution::Returned(_) => compile_admitted_i64_function_arithmetic(source::bytes(input)),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_admitted_i64_function_arithmetic(input_bytes: Bytes) -> ArtifactEmission {
    compile_i64_function_arithmetic_find_body(input_bytes, first_token(input_bytes))
}

fn compile_i64_function_arithmetic_find_body(input_bytes: Bytes, token: TokenStart) -> ArtifactEmission {
    handle token_matches(input_bytes, token, "{") {
        true => compile_i64_function_arithmetic_left(input_bytes, next_token(input_bytes, token)),
        false => handle token_kind(token) {
            TokenKind::End => ArtifactEmission::Rejected,
            _ => compile_i64_function_arithmetic_find_body(input_bytes, next_token(input_bytes, token)),
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_i64_function_arithmetic_left(input_bytes: Bytes, left: TokenStart) -> ArtifactEmission {
    handle token_matches(input_bytes, left, "return") {
        true => compile_i64_function_return_arithmetic_left(input_bytes, next_token(input_bytes, left)),
        false => handle signed_i64_literal_at(input_bytes, left) {
            SignedI64LiteralAdmission::Value(value, last) => compile_i64_function_arithmetic_operator_entry(input_bytes, next_token(input_bytes, last), value),
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_i64_function_return_arithmetic_left(input_bytes: Bytes, left: TokenStart) -> ArtifactEmission {
    handle signed_i64_literal_at(input_bytes, left) {
        SignedI64LiteralAdmission::Value(value, last) => compile_i64_function_return_arithmetic_operator_entry(input_bytes, next_token(input_bytes, last), value),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_i64_function_arithmetic_operator_entry(input_bytes: Bytes, operator: TokenStart, left: i64) -> ArtifactEmission {
    let right = next_token(input_bytes, operator);
    handle signed_i64_literal_at(input_bytes, right) {
        SignedI64LiteralAdmission::Value(value, last) => compile_i64_function_arithmetic_finish(input_bytes, operator, next_token(input_bytes, last), left, value),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_i64_function_return_arithmetic_operator_entry(input_bytes: Bytes, operator: TokenStart, left: i64) -> ArtifactEmission {
    let right = next_token(input_bytes, operator);
    handle signed_i64_literal_at(input_bytes, right) {
        SignedI64LiteralAdmission::Value(value, last) => compile_i64_function_return_arithmetic_finish(input_bytes, operator, next_token(input_bytes, last), left, value),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_i64_function_return_arithmetic_finish(input_bytes: Bytes, operator: TokenStart, semicolon: TokenStart, left: i64, right: i64) -> ArtifactEmission {
    handle token_matches(input_bytes, semicolon, ";") {
        true => compile_i64_function_return_arithmetic_artifact_close(input_bytes, operator, next_token(input_bytes, semicolon), left, right),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_i64_function_return_arithmetic_artifact_close(input_bytes: Bytes, operator: TokenStart, close: TokenStart, left: i64, right: i64) -> ArtifactEmission {
    handle token_matches(input_bytes, close, "}") {
        true => handle token_kind(next_token(input_bytes, close)) {
            TokenKind::End => emit_source_i64_binary_operator(input_bytes, operator, left, right),
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_i64_function_arithmetic_finish(input_bytes: Bytes, operator: TokenStart, close: TokenStart, left: i64, right: i64) -> ArtifactEmission {
    handle token_matches(input_bytes, close, "}") {
        true => handle token_kind(next_token(input_bytes, close)) {
            TokenKind::End => emit_source_i64_binary_operator(input_bytes, operator, left, right),
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

fn emit_source_i64_binary_operator(input_bytes: Bytes, operator: TokenStart, left: i64, right: i64) -> ArtifactEmission {
    handle token_matches(input_bytes, operator, "+") {
        true => emit_source_i64_binary(ScannedArithmetic::Add, left, right),
        false => handle token_matches(input_bytes, operator, "-") {
            true => emit_source_i64_binary(ScannedArithmetic::Subtract, left, right),
            false => handle token_matches(input_bytes, operator, "*") {
                true => emit_source_i64_binary(ScannedArithmetic::Multiply, left, right),
                false => handle token_matches(input_bytes, operator, "/") {
                    true => emit_source_i64_binary(ScannedArithmetic::Divide, left, right),
                    _ => ArtifactEmission::Rejected,
                },
                _ => ArtifactEmission::Rejected,
            },
            _ => ArtifactEmission::Rejected,
        },
        _ => ArtifactEmission::Rejected,
    }
}

// A scanner-admitted arithmetic expression crosses the same typed
// Body→Core→MIR boundary as ordinary compilation before it reaches the G1
// primitive encoder.  This avoids treating a lexed operator as sufficient
// authority to select bytecode.
pub fn compile_source_i64_arithmetic_entry(input: SourceInput) -> ArtifactEmission {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_signed_i64_arithmetic_artifact(source::bytes(input)),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_signed_i64_arithmetic_artifact(bytes: Bytes) -> ArtifactEmission {
    let left = first_token(bytes);
    handle signed_i64_literal_at(bytes, left) {
        SignedI64LiteralAdmission::Value(left_value, left_last) => compile_signed_i64_arithmetic_artifact_operator(bytes, next_token(bytes, left_last), left_value),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_signed_i64_arithmetic_artifact_operator(bytes: Bytes, operator: TokenStart, left: i64) -> ArtifactEmission {
    let right = next_token(bytes, operator);
    handle signed_i64_literal_at(bytes, right) {
        SignedI64LiteralAdmission::Value(right_value, right_last) => compile_signed_i64_arithmetic_artifact_end(bytes, operator, next_token(bytes, right_last), left, right_value),
        _ => ArtifactEmission::Rejected,
    }
}

fn compile_signed_i64_arithmetic_artifact_end(bytes: Bytes, operator: TokenStart, end: TokenStart, left: i64, right: i64) -> ArtifactEmission {
    handle token_kind(end) {
        TokenKind::End => emit_source_i64_binary_operator(bytes, operator, left, right),
        _ => ArtifactEmission::Rejected,
    }
}

fn emit_source_i64_binary(operation: ScannedArithmetic, left: i64, right: i64) -> ArtifactEmission {
    handle operation {
        ScannedArithmetic::Add => emit_admitted_source_i64_binary(Arithmetic::Add, left, right),
        ScannedArithmetic::Subtract => emit_admitted_source_i64_binary(Arithmetic::Subtract, left, right),
        ScannedArithmetic::Multiply => emit_admitted_source_i64_binary(Arithmetic::Multiply, left, right),
        ScannedArithmetic::Divide => emit_admitted_source_i64_binary(Arithmetic::Divide, left, right),
        _ => ArtifactEmission::Rejected,
    }
}

fn emit_admitted_source_i64_binary(body_operation: Arithmetic, left: i64, right: i64) -> ArtifactEmission {
    emit_g1_for_i64_arithmetic_body(Expression::I64Arithmetic(body_operation, left, right), Type::I64)
}

// The first source-defined parameter-reference body. The invocation value is
// supplied by the service request, while binder/reference equality remains in
// scanner-owned source spans before typed callable lowering runs.
pub fn compile_source_i64_identity_function(input: SourceInput, argument: i64) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_lexically_valid_i64_identity_function(input, argument),
        _ => Execution::Faulted,
    }
}

// Unsigned identity is a distinct callable contract: the source binder and
// reference are proved from immutable spans before the supplied u32 enters
// the typed parameter lowering.
pub fn compile_source_u32_identity_function(input: SourceInput, argument: u32) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_u32_identity_first(source::bytes(input), first_token(source::bytes(input)), argument),
        _ => Execution::Faulted,
    }
}

// Two supplied u32 arguments remain parameter operands all the way through
// typed lowering.  The scanner spans establish both binder references before
// their request values can be admitted to the checked arithmetic backend.
pub fn compile_source_u32_binary_function(input: SourceInput, left_value: u32, right_value: u32) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_u32_binary_first(source::bytes(input), first_token(source::bytes(input)), left_value, right_value),
        _ => Execution::Faulted,
    }
}

fn compile_u32_binary_first(bytes: Bytes, first: TokenStart, left_value: u32, right_value: u32) -> Execution {
    handle token_matches(bytes, first, "pub") { true => compile_u32_binary_fn(bytes, next_token(bytes, first), left_value, right_value), false => compile_u32_binary_fn(bytes, first, left_value, right_value), _ => Execution::Faulted }
}
fn compile_u32_binary_fn(bytes: Bytes, function: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, function, "fn") { true => compile_u32_binary_name(bytes, next_token(bytes, function), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_name(bytes: Bytes, name: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_kind(name) { TokenKind::Identifier => compile_u32_binary_open(bytes, next_token(bytes, name), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_open(bytes: Bytes, open: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, open, "(") { true => compile_u32_binary_left(bytes, next_token(bytes, open), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_left(bytes: Bytes, left: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_kind(left) { TokenKind::Identifier => compile_u32_binary_left_colon(bytes, left, next_token(bytes, left), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_left_colon(bytes: Bytes, left: TokenStart, colon: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, colon, ":") { true => compile_u32_binary_left_type(bytes, left, next_token(bytes, colon), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_left_type(bytes: Bytes, left: TokenStart, left_type: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, left_type, "u32") { true => compile_u32_binary_comma(bytes, left, next_token(bytes, left_type), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_comma(bytes: Bytes, left: TokenStart, comma: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, comma, ",") { true => compile_u32_binary_right(bytes, left, next_token(bytes, comma), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_right(bytes: Bytes, left: TokenStart, right: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_kind(right) { TokenKind::Identifier => compile_u32_binary_right_colon(bytes, left, right, next_token(bytes, right), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_right_colon(bytes: Bytes, left: TokenStart, right: TokenStart, colon: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, colon, ":") { true => compile_u32_binary_right_type(bytes, left, right, next_token(bytes, colon), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_right_type(bytes: Bytes, left: TokenStart, right: TokenStart, right_type: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, right_type, "u32") { true => compile_u32_binary_close_parameters(bytes, left, right, next_token(bytes, right_type), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_close_parameters(bytes: Bytes, left: TokenStart, right: TokenStart, close: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, close, ")") { true => compile_u32_binary_arrow(bytes, left, right, next_token(bytes, close), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_arrow(bytes: Bytes, left: TokenStart, right: TokenStart, arrow: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, arrow, "->") { true => compile_u32_binary_result(bytes, left, right, next_token(bytes, arrow), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_result(bytes: Bytes, left: TokenStart, right: TokenStart, result: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, result, "u32") { true => compile_u32_binary_body_open(bytes, left, right, next_token(bytes, result), left_value, right_value), _ => Execution::Faulted } }
fn compile_u32_binary_body_open(bytes: Bytes, left: TokenStart, right: TokenStart, open: TokenStart, left_value: u32, right_value: u32) -> Execution { handle token_matches(bytes, open, "{") { true => compile_u32_binary_body(bytes, left, right, next_token(bytes, open), left_value, right_value, false), _ => Execution::Faulted } }
fn compile_u32_binary_body(bytes: Bytes, left: TokenStart, right: TokenStart, body_left: TokenStart, left_value: u32, right_value: u32, explicit_return: Bool) -> Execution {
    handle token_matches(bytes, body_left, "return") { true => compile_u32_binary_body(bytes, left, right, next_token(bytes, body_left), left_value, right_value, true), false => handle token_equals(bytes, left, body_left) { true => compile_u32_binary_operator(bytes, left, right, next_token(bytes, body_left), left_value, right_value, explicit_return), _ => Execution::Faulted }, _ => Execution::Faulted }
}
fn compile_u32_binary_operator(bytes: Bytes, left: TokenStart, right: TokenStart, operator: TokenStart, left_value: u32, right_value: u32, explicit_return: Bool) -> Execution {
    handle token_matches(bytes, operator, "+") { true => compile_u32_binary_right_reference(bytes, left, right, Arithmetic::Add, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, "-") { true => compile_u32_binary_right_reference(bytes, left, right, Arithmetic::Subtract, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, "*") { true => compile_u32_binary_right_reference(bytes, left, right, Arithmetic::Multiply, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, "/") { true => compile_u32_binary_right_reference(bytes, left, right, Arithmetic::Divide, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, "%") { true => compile_u32_binary_right_reference(bytes, left, right, Arithmetic::Remainder, next_token(bytes, operator), left_value, right_value, explicit_return), _ => Execution::Faulted }, _ => Execution::Faulted }, _ => Execution::Faulted }, _ => Execution::Faulted }, _ => Execution::Faulted }
}
fn compile_u32_binary_right_reference(bytes: Bytes, left: TokenStart, right: TokenStart, operation: Arithmetic, reference: TokenStart, left_value: u32, right_value: u32, explicit_return: Bool) -> Execution {
    handle token_equals(bytes, right, reference) { true => compile_u32_binary_tail(bytes, operation, next_token(bytes, reference), left_value, right_value, explicit_return), _ => Execution::Faulted }
}
fn compile_u32_binary_tail(bytes: Bytes, operation: Arithmetic, tail: TokenStart, left_value: u32, right_value: u32, explicit_return: Bool) -> Execution {
    handle explicit_return { true => handle token_matches(bytes, tail, ";") { true => compile_u32_binary_close(bytes, operation, next_token(bytes, tail), left_value, right_value), _ => Execution::Faulted }, false => compile_u32_binary_close(bytes, operation, tail, left_value, right_value), _ => Execution::Faulted }
}
fn compile_u32_binary_close(bytes: Bytes, operation: Arithmetic, close: TokenStart, left_value: u32, right_value: u32) -> Execution {
    handle token_matches(bytes, close, "}") { true => handle token_kind(next_token(bytes, close)) { TokenKind::End => compile_u32_parameter_arithmetic(operation, left_value, right_value), _ => Execution::Faulted }, _ => Execution::Faulted }
}

// Keep the source-shaped usize callable distinct from the direct service
// bridge.  The scanner proves both binder references and the sole supported
// checked operation before values can reach the candidate/verified backend.
// This public compatibility name routes through M19's shared declaration
// parser rather than carrying a separate `usize +` parser in the service
// layer. The current VM scalar family has one `usize` opcode, so source
// operators without a corresponding verified instruction remain rejected.
pub fn compile_source_usize_add_function(input: SourceInput, left_value: usize, right_value: usize) -> Execution {
    handle token_stream_checked(input) {
        TokenStreamAdmission::Valid => compile_source_usize_binary_admitted(source::bytes(input), left_value, right_value),
        _ => Execution::Faulted,
    }
}

pub fn compile_source_usize_binary_function(input: SourceInput, left_value: usize, right_value: usize) -> Execution {
    compile_source_usize_add_function(input, left_value, right_value)
}

fn compile_source_usize_binary_admitted(input: Bytes, left_value: usize, right_value: usize) -> Execution {
    handle scalar_binary_arithmetic(input, "usize") {
        ScalarBinaryAdmission::Value(Arithmetic::Add) => compile_usize_arithmetic(Arithmetic::Add, left_value, right_value, Type::Usize),
        _ => Execution::Faulted,
    }
}

// The first wide-integer relation path keeps u64 operands distinct from the
// signed comparison instruction family.  It deliberately accepts a single
// source relation so binder proof, typed comparison, and VM execution stay
// independently inspectable while the full declaration grammar grows.
pub fn compile_source_u64_comparison_function(input: SourceInput, left_value: u64, right_value: u64) -> Execution {
    handle token_stream_checked(input) { TokenStreamAdmission::Valid => compile_u64_comparison_first(source::bytes(input), first_token(source::bytes(input)), left_value, right_value), _ => Execution::Faulted }
}
