fn compile_u64_comparison_left_colon(bytes: Bytes, left: TokenStart, colon: TokenStart, left_value: u64, right_value: u64) -> Execution { handle token_matches(bytes, colon, ":") { true => compile_u64_comparison_left_type(bytes, left, next_token(bytes, colon), left_value, right_value), _ => Execution::Faulted } }
fn compile_u64_comparison_left_type(bytes: Bytes, left: TokenStart, left_type: TokenStart, left_value: u64, right_value: u64) -> Execution { handle token_matches(bytes, left_type, "u64") { true => compile_u64_comparison_comma(bytes, left, next_token(bytes, left_type), left_value, right_value), _ => Execution::Faulted } }
