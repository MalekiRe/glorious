    handle token_matches(bytes, operator, "==") { true => compile_u64_comparison_right_reference(bytes, right, Comparison::Equal, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, "!=") { true => compile_u64_comparison_right_reference(bytes, right, Comparison::NotEqual, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, "<") { true => compile_u64_comparison_right_reference(bytes, right, Comparison::Less, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, "<=") { true => compile_u64_comparison_right_reference(bytes, right, Comparison::LessEqual, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, ">") { true => compile_u64_comparison_right_reference(bytes, right, Comparison::Greater, next_token(bytes, operator), left_value, right_value, explicit_return), false => handle token_matches(bytes, operator, ">=") { true => compile_u64_comparison_right_reference(bytes, right, Comparison::GreaterEqual, next_token(bytes, operator), left_value, right_value, explicit_return), _ => Execution::Faulted }, _ => Execution::Faulted }, _ => Execution::Faulted }, _ => Execution::Faulted }, _ => Execution::Faulted }, _ => Execution::Faulted }
}
fn compile_u64_comparison_right_reference(bytes: Bytes, right: TokenStart, operation: Comparison, reference: TokenStart, left_value: u64, right_value: u64, explicit_return: Bool) -> Execution { handle token_equals(bytes, right, reference) { true => compile_u64_comparison_tail(bytes, operation, next_token(bytes, reference), left_value, right_value, explicit_return), _ => Execution::Faulted } }
