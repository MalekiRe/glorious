fn compile_u64_comparison_close_parameters(bytes: Bytes, left: TokenStart, right: TokenStart, close: TokenStart, left_value: u64, right_value: u64) -> Execution { handle token_matches(bytes, close, ")") { true => compile_u64_comparison_arrow(bytes, left, right, next_token(bytes, close), left_value, right_value), _ => Execution::Faulted } }
