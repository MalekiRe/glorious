// First bootstrap-toolkit proof. This is deliberately an ordinary Grandiose
// implementation; it does not receive a compiler or VM semantic fallback.
pub struct Interval {
    lower: i64,
    upper: i64,
}

pub fn zero() -> Interval {
    Interval { lower: 0, upper: 0 }
}

pub fn once() -> Interval {
    Interval { lower: 1, upper: 1 }
}

pub fn sequence_lower(left: Interval, right: Interval) -> i64 {
    left.lower + right.lower
}

pub fn sequence_upper(left: Interval, right: Interval) -> i64 {
    left.upper + right.upper
}

pub fn smoke() -> i64 {
    sequence_lower(once(), once()) * 20 + sequence_upper(zero(), once())
}
