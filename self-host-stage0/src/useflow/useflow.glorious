// M22 bootstrap finite-use accounting.  The interval stays source-owned so
// the same lower/upper contract can later be shared with Quantity and handler
// replay accounting; a value is never silently treated as unrestricted.
use compiler_support::branch_bool;
use placeflow::PlaceState;
use placeflow::can_read;
use placeflow::FieldStates;
use placeflow::can_read_field;
use placeflow::NestedFieldStates;
use placeflow::ProjectionPath;
use placeflow::can_read_path;
pub enum UseUpper { Finite(i64), Infinite }
pub struct UseState { lower: i64, upper: UseUpper }
pub enum ConsumeResult { Value(UseState), Exhausted }
pub enum UseConstruction { Value(UseState), Invalid }
pub enum PlaceConsume { Value(UseState), PlaceUnavailable, Exhausted }

pub fn uses(count: i64) -> UseState {
    branch_bool(
        count < 0,
        () -> UseState { UseState { lower: 0, upper: UseUpper::Finite(0) } },
        () -> UseState { UseState { lower: count, upper: UseUpper::Finite(count) } },
    )
}

pub fn bounded(lower: i64, upper: i64) -> UseConstruction {
    branch_bool(
        invalid_bounds(lower, upper),
        () -> UseConstruction { UseConstruction::Invalid },
        () -> UseConstruction { UseConstruction::Value(UseState { lower: lower, upper: UseUpper::Finite(upper) }) },
    )
}

// Internal phases only call this after their own bound arithmetic; this
// direct helper gives the use-summary checker a concrete interval value once
// those bounds are already known valid.
pub fn bounded_value(lower: i64, upper: i64) -> UseState {
    UseState { lower: lower, upper: UseUpper::Finite(upper) }
}

pub fn at_least(lower: i64) -> UseState {
    branch_bool(lower < 0,
        () -> UseState { UseState { lower: 0, upper: UseUpper::Infinite } },
        () -> UseState { UseState { lower: lower, upper: UseUpper::Infinite } })
}

pub fn consume(state: UseState) -> ConsumeResult {
    handle state.upper {
        UseUpper::Finite(0) => ConsumeResult::Exhausted,
        UseUpper::Finite(upper) => ConsumeResult::Value(UseState { lower: subtract_one_if_positive(state.lower), upper: UseUpper::Finite(upper - 1) }),
        UseUpper::Infinite => ConsumeResult::Value(UseState { lower: subtract_one_if_positive(state.lower), upper: UseUpper::Infinite }),
        _ => ConsumeResult::Exhausted,
    }
}

// Quantitative permission is meaningful only when the shared ownership flow
// says the capability can still be read. This keeps UseFlow from treating a
// moved callable as independently invocable.
pub fn consume_from_place(place: PlaceState, state: UseState) -> PlaceConsume {
    branch_bool(can_read(place),
        () -> PlaceConsume { consume_readable(state) },
        () -> PlaceConsume { PlaceConsume::PlaceUnavailable })
}

// Quantitative capability follows the selected frozen projection. A live
// sibling cannot make a moved field callable again merely because both share
// one aggregate root.
pub fn consume_from_field(place: FieldStates, index: i64, state: UseState) -> PlaceConsume {
    branch_bool(can_read_field(place, index),
        () -> PlaceConsume { consume_readable(state) },
        () -> PlaceConsume { PlaceConsume::PlaceUnavailable })
}

// The quantitative contract follows the complete frozen projection path, not
// merely its root or first field. A callable moved from `slot.inner.callback`
// cannot regain an invocation through a readable sibling or ancestor.
pub fn consume_from_path(place: NestedFieldStates, path: ProjectionPath, state: UseState) -> PlaceConsume {
    branch_bool(can_read_path(place, path),
        () -> PlaceConsume { consume_readable(state) },
        () -> PlaceConsume { PlaceConsume::PlaceUnavailable })
}

fn consume_readable(state: UseState) -> PlaceConsume {
    handle consume(state) {
        ConsumeResult::Value(next) => PlaceConsume::Value(next),
        ConsumeResult::Exhausted => PlaceConsume::Exhausted,
        _ => PlaceConsume::Exhausted,
    }
}

pub fn remaining(state: UseState) -> i64 { state.lower }
pub fn permits_another(state: UseState) -> Bool {
    handle state.upper { UseUpper::Finite(0) => false, UseUpper::Finite(_) => true, UseUpper::Infinite => true, _ => false }
}

// A declaration is a principal interval and an observed control-flow summary
// is permitted exactly when every possible observed use count lies inside it.
// This is deliberately distinct from `join`: exclusive branches form a hull,
// then the declaration checks that hull once at the callable boundary.
pub fn contains(principal: UseState, actual: UseState) -> Bool {
    branch_bool(
        principal.lower <= actual.lower,
        () -> Bool { upper_contains(principal.upper, actual.upper) },
        () -> Bool { false },
    )
}

// Only the ownership-relevant three intervals are legal source principal
// declarations. Zero remains a real flow result for an unselected branch,
// but a user cannot declare a permanently unusable value just to bypass
// ownership checking.
pub fn is_public_principal_use(value: UseState) -> Bool {
    handle (value.lower, value.upper) {
        (0, UseUpper::Infinite) => true,
        (0, UseUpper::Finite(1)) => true,
        (1, UseUpper::Finite(1)) => true,
        _ => false,
    }
}

// A value that may have travelled through either branch is usable only as
// often as the least permissive incoming state permits.
pub fn join(left: UseState, right: UseState) -> UseState {
    UseState { lower: lesser(left.lower, right.lower), upper: greater_upper(left.upper, right.upper) }
}

fn lesser(left: i64, right: i64) -> i64 {
    branch_bool(left < right,
        () -> i64 { left },
        () -> i64 { right })
}

fn subtract_one_if_positive(value: i64) -> i64 {
    branch_bool(value > 0, () -> i64 { value - 1 }, () -> i64 { 0 })
}

fn invalid_bounds(lower: i64, upper: i64) -> Bool {
    branch_bool(lower < 0,
        () -> Bool { true },
        () -> Bool { invalid_nonnegative_bounds(lower, upper) })
}

fn invalid_nonnegative_bounds(lower: i64, upper: i64) -> Bool {
    branch_bool(upper < 0,
        () -> Bool { true },
        () -> Bool { lower > upper })
}

fn greater_upper(left: UseUpper, right: UseUpper) -> UseUpper {
    handle (left, right) {
        (UseUpper::Infinite, _) => UseUpper::Infinite,
        (_, UseUpper::Infinite) => UseUpper::Infinite,
        (UseUpper::Finite(left), UseUpper::Finite(right)) => branch_bool(left < right,
            () -> UseUpper { UseUpper::Finite(right) },
            () -> UseUpper { UseUpper::Finite(left) }),
        _ => UseUpper::Finite(0),
    }
}

fn upper_contains(principal: UseUpper, actual: UseUpper) -> Bool {
    handle (principal, actual) {
        (UseUpper::Infinite, _) => true,
        (UseUpper::Finite(_), UseUpper::Infinite) => false,
        (UseUpper::Finite(principal), UseUpper::Finite(actual)) => actual <= principal,
        _ => false,
    }
}
