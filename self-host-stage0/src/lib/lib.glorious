// M35 scaffold: canonical source-level public-module inventory. Re-exports
// are bound to the facades once module packages are assembled as one source
// world; this table prevents an omitted module from becoming invisible.
pub enum PublicModule {
    Diagnostic, Quantity, Identity, Operation, Request, Output, Source, Scanner,
    Header, Interface, ModuleGraph, Fixity, Resolution, Types, Signature, Coherence,
    TraitSolver, Pattern, Body, Core, Placeflow, Useflow, Escape, MirStorage,
    Instance, Mir, RuntimeManifest, VmBackend, Bootstrap, Dependency, Revision,
    Query, ArtifactCache, Service,
}
pub fn required(module: PublicModule) -> Bool {
    handle module {
        PublicModule::Diagnostic => true, PublicModule::Quantity => true, PublicModule::Identity => true, PublicModule::Operation => true, PublicModule::Request => true, PublicModule::Output => true, PublicModule::Source => true, PublicModule::Scanner => true,
        PublicModule::Header => true, PublicModule::Interface => true, PublicModule::ModuleGraph => true, PublicModule::Fixity => true, PublicModule::Resolution => true, PublicModule::Types => true, PublicModule::Signature => true, PublicModule::Coherence => true,
        PublicModule::TraitSolver => true, PublicModule::Pattern => true, PublicModule::Body => true, PublicModule::Core => true, PublicModule::Placeflow => true, PublicModule::Useflow => true, PublicModule::Escape => true, PublicModule::MirStorage => true,
        PublicModule::Instance => true, PublicModule::Mir => true, PublicModule::RuntimeManifest => true, PublicModule::VmBackend => true, PublicModule::Bootstrap => true, PublicModule::Dependency => true, PublicModule::Revision => true,
        PublicModule::Query => true, PublicModule::ArtifactCache => true, PublicModule::Service => true, _ => false,
    }
}
