// M13's first resolver boundary: visibility is evaluated from stable logical
// package/module names, never from host paths or ambient process state.
use compiler_support::branch_bool;
use compiler_support::text_eq;
use compiler_support::__g1_array_pop_move;
use interface::Definition;
use interface::DefinitionAdmission;
use interface::NamedDefinitionAdmission;
use interface::NamedDefinitionParts;
use interface::is_exported;
use source::SourceInput;
use identity::PackageKey;
use identity::ModuleKey;
use identity::Digest;
use identity::equals;
use identity::package_key;
use identity::module_key;
use identity::same_package;
use identity::same_module;

pub enum Visibility {
    Public,
    Package,
    Private,
}

pub struct Binding {
    package: PackageKey,
    module: ModuleKey,
    visibility: Visibility,
}

// Keep lookup spelling with its visibility owner.  A caller can then retain
// the distinction between a known-but-inaccessible name and a name that was
// never declared in this namespace.
pub struct NamedBinding { name: Text, binding: Binding }
pub struct SourceBinding { name: Digest, binding: Binding }

// The interface supplies namespace-unique declarations; resolution retains
// them as one immutable sequence so a lookup can walk past unrelated names
// without collapsing an inaccessible matching declaration into `Missing`.
pub enum BindingSet {
    Empty,
    Node(NamedBinding, Bool, Array<BindingSet>),
}

pub enum BindingAdmission {
    Value(Binding),
    NotDeclaration,
}

pub enum SourceBindingAdmission { Value(SourceBinding), NotDeclaration }

pub enum SourceBindingSet {
    Empty,
    Node(SourceBinding, Bool, Array<SourceBindingSet>),
}

// Preserve a denied lookup separately from an absent header.  Downstream
// diagnostics and import recovery must not collapse an inaccessible binding
// into an unresolved name.
pub enum Lookup { Resolved, Inaccessible, Missing }

pub fn binding(package: Text, module: Text, visibility: Visibility) -> Binding {
    Binding { package: package_key(package), module: module_key(package, module), visibility: visibility }
}

pub fn named_binding(name: Text, package: Text, module: Text, visibility: Visibility) -> NamedBinding {
    NamedBinding { name: name, binding: binding(package, module, visibility) }
}

pub fn empty_bindings() -> BindingSet { BindingSet::Empty }

pub fn prepend_binding(value: NamedBinding, tail: BindingSet) -> BindingSet {
    BindingSet::Node(value, true, [tail])
}

pub fn single_binding(value: NamedBinding) -> BindingSet {
    BindingSet::Node(value, false, [])
}

pub fn empty_source_bindings() -> SourceBindingSet { SourceBindingSet::Empty }
pub fn single_source_binding(value: SourceBinding) -> SourceBindingSet { SourceBindingSet::Node(value, false, []) }
pub fn prepend_source_binding(value: SourceBinding, tail: SourceBindingSet) -> SourceBindingSet { SourceBindingSet::Node(value, true, [tail]) }

// Resolution consumes the interface's export decision instead of maintaining
// a second public-declaration rule. Non-exportable declarations remain local
// to the declaring module at this early boundary.
pub fn binding_from_definition(package: Text, module: Text, definition: Definition) -> Binding {
    branch_bool(
        is_exported(definition),
        () -> Binding { binding(package, module, Visibility::Public) },
        () -> Binding { binding(package, module, Visibility::Private) },
    )
}

// Keep source-derived admission explicit through resolution: invalid header
// input must not become a private binding simply because it reached this
// layer. Later collection adds names and identity to this same result.
pub fn binding_from_header(package: Text, module: Text, input: Bytes) -> BindingAdmission {
    handle interface::definition_from_header(input) {
        DefinitionAdmission::Value(definition) => BindingAdmission::Value(binding_from_definition(package, module, definition)),
        DefinitionAdmission::NotDeclaration => BindingAdmission::NotDeclaration,
        _ => BindingAdmission::NotDeclaration,
    }
}

// The ordinary header facade remains useful for callers with an already
// interned text name. Source collection instead retains the exact scanned
// token digest supplied by M09/M10, so resolution cannot accept a separately
// fabricated spelling for a declaration it did not parse.
pub fn source_binding_from_header_checked(package: Text, module: Text, input: SourceInput) -> SourceBindingAdmission {
    handle interface::named_definition_from_header_checked(input) {
        NamedDefinitionAdmission::Value(named) => source_binding_from_parts(package, module, interface::named_definition_parts(named)),
        NamedDefinitionAdmission::NotDeclaration => SourceBindingAdmission::NotDeclaration,
        _ => SourceBindingAdmission::NotDeclaration,
    }
}

fn source_binding_from_parts(package: Text, module: Text, parts: NamedDefinitionParts) -> SourceBindingAdmission {
    handle parts {
        NamedDefinitionParts::Value(definition, name) => SourceBindingAdmission::Value(SourceBinding { name: name, binding: binding_from_definition(package, module, definition) }),
        _ => SourceBindingAdmission::NotDeclaration,
    }
}

pub fn visible_from(binding: Binding, package: Text, module: Text) -> Bool {
    handle binding.visibility {
        Visibility::Public => true,
        Visibility::Package => same_package(binding.package, package_key(package)),
        Visibility::Private => private_visible(binding.package, binding.module, package, module),
        _ => false,
    }
}

pub fn lookup(binding: Binding, package: Text, module: Text) -> Lookup {
    branch_bool(visible_from(binding, package, module),
        () -> Lookup { Lookup::Resolved },
        () -> Lookup { Lookup::Inaccessible })
}

pub fn lookup_named(value: NamedBinding, name: Text, package: Text, module: Text) -> Lookup {
    branch_bool(
        text_eq(value.name, name),
        () -> Lookup { lookup(value.binding, package, module) },
        () -> Lookup { Lookup::Missing },
    )
}

pub fn lookup_bindings(values: BindingSet, name: Text, package: Text, module: Text) -> Lookup {
    handle values {
        BindingSet::Empty => Lookup::Missing,
        BindingSet::Node(value, has_tail, tail) => lookup_binding_node(value, has_tail, tail, name, package, module),
        _ => Lookup::Missing,
    }
}

pub fn lookup_source_bindings(values: SourceBindingSet, name: Digest, package: Text, module: Text) -> Lookup {
    handle values {
        SourceBindingSet::Empty => Lookup::Missing,
        SourceBindingSet::Node(value, has_tail, tail) => lookup_source_binding_node(value, has_tail, tail, name, package, module),
        _ => Lookup::Missing,
    }
}

fn lookup_source_binding_node(value: SourceBinding, has_tail: Bool, tail: Array<SourceBindingSet>, name: Digest, package: Text, module: Text) -> Lookup {
    handle equals(value.name, name) {
        true => lookup(value.binding, package, module),
        false => lookup_source_binding_tail(has_tail, tail, name, package, module),
        _ => Lookup::Missing,
    }
}

fn lookup_source_binding_tail(has_tail: Bool, tail: Array<SourceBindingSet>, name: Digest, package: Text, module: Text) -> Lookup {
    handle has_tail {
        true => lookup_source_bindings(__g1_array_pop_move<SourceBindingSet>(&mut tail), name, package, module),
        false => Lookup::Missing,
        _ => Lookup::Missing,
    }
}

fn lookup_binding_node(value: NamedBinding, has_tail: Bool, tail: Array<BindingSet>, name: Text, package: Text, module: Text) -> Lookup {
    handle text_eq(value.name, name) {
        true => lookup(value.binding, package, module),
        false => lookup_binding_tail(has_tail, tail, name, package, module),
        _ => Lookup::Missing,
    }
}

fn lookup_binding_tail(has_tail: Bool, tail: Array<BindingSet>, name: Text, package: Text, module: Text) -> Lookup {
    handle has_tail {
        true => lookup_bindings(__g1_array_pop_move<BindingSet>(&mut tail), name, package, module),
        false => Lookup::Missing,
        _ => Lookup::Missing,
    }
}

fn private_visible(owner_package: PackageKey, owner_module: ModuleKey, package: Text, module: Text) -> Bool {
    branch_bool(
        same_package(owner_package, package_key(package)),
        () -> Bool { same_module(owner_module, module_key(package, module)) },
        () -> Bool { false },
    )
}
