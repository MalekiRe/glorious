// M12's reduction decision is independent of token storage: callers supply
// the two already-resolved fixities and receive a deterministic parser action.
use compiler_support::branch_bool;
use compiler_support::text_eq;
use header::HeaderLead;

pub enum FixityForm {
    Prefix,
    InfixLeft,
    InfixRight,
    InfixNonAssociative,
}

pub struct Fixity {
    form: FixityForm,
    precedence: i64,
}

pub enum ReductionDecision {
    Reduce,
    Shift,
    Ambiguous,
}

pub enum FixityLookup { Found(Fixity), Missing }

pub fn fixity(form: FixityForm, precedence: i64) -> Fixity {
    Fixity { form: form, precedence: precedence }
}

// Header parsing owns the declaration keyword; this adapter owns the
// semantic associativity. Keeping the conversion explicit prevents a parser
// caller from treating an ordinary identifier as a source-declared fixity.
pub fn declared(lead: HeaderLead, precedence: i64) -> FixityLookup {
    // Stage0 stores declared precedence as u8. The bootstrap facade uses an
    // i64 transport value, so reject before constructing a Fixity rather than
    // allowing negative or overflowing values to influence reduction.
    branch_bool(precedence >= 0,
        () -> FixityLookup { declared_nonnegative(lead, precedence) },
        () -> FixityLookup { FixityLookup::Missing })
}

fn declared_nonnegative(lead: HeaderLead, precedence: i64) -> FixityLookup {
    branch_bool(precedence <= 255,
        () -> FixityLookup { declared_in_range(lead, precedence) },
        () -> FixityLookup { FixityLookup::Missing })
}

fn declared_in_range(lead: HeaderLead, precedence: i64) -> FixityLookup {
    handle lead {
        HeaderLead::Prefix => FixityLookup::Found(fixity(FixityForm::Prefix, precedence)),
        HeaderLead::InfixLeft => FixityLookup::Found(fixity(FixityForm::InfixLeft, precedence)),
        HeaderLead::InfixRight => FixityLookup::Found(fixity(FixityForm::InfixRight, precedence)),
        HeaderLead::InfixNonAssociative => FixityLookup::Found(fixity(FixityForm::InfixNonAssociative, precedence)),
        _ => FixityLookup::Missing,
    }
}

// Isolated packages have no separately compiled prelude, so the stage0
// operator vocabulary is represented here rather than delegated to parser
// heuristics. Module/import declarations can later replace these entries.
pub fn prelude_infix(operator: Text) -> FixityLookup { prelude_plus(operator) }

fn prelude_plus(operator: Text) -> FixityLookup {
    handle text_eq(operator, "+") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 30)),
        false => prelude_minus(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_minus(operator: Text) -> FixityLookup {
    handle text_eq(operator, "-") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 30)),
        false => prelude_multiply(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_multiply(operator: Text) -> FixityLookup {
    handle text_eq(operator, "*") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 40)),
        false => prelude_divide(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_divide(operator: Text) -> FixityLookup {
    handle text_eq(operator, "/") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 40)),
        false => prelude_remainder(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_remainder(operator: Text) -> FixityLookup {
    handle text_eq(operator, "%") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 40)),
        false => prelude_equal(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_equal(operator: Text) -> FixityLookup {
    handle text_eq(operator, "==") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 20)),
        false => prelude_not_equal(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_not_equal(operator: Text) -> FixityLookup {
    handle text_eq(operator, "!=") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 20)),
        false => prelude_less(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_less(operator: Text) -> FixityLookup {
    handle text_eq(operator, "<") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 20)),
        false => prelude_less_equal(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_less_equal(operator: Text) -> FixityLookup {
    handle text_eq(operator, "<=") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 20)),
        false => prelude_greater(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_greater(operator: Text) -> FixityLookup {
    handle text_eq(operator, ">") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 20)),
        false => prelude_greater_equal(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_greater_equal(operator: Text) -> FixityLookup {
    handle text_eq(operator, ">=") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 20)),
        false => prelude_or(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_or(operator: Text) -> FixityLookup {
    handle text_eq(operator, "or") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 2)),
        false => prelude_and(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_and(operator: Text) -> FixityLookup {
    handle text_eq(operator, "and") {
        true => FixityLookup::Found(fixity(FixityForm::InfixLeft, 3)),
        false => FixityLookup::Missing,
        _ => FixityLookup::Missing,
    }
}

pub fn prelude_prefix(operator: Text) -> FixityLookup {
    handle text_eq(operator, "+") {
        true => FixityLookup::Found(fixity(FixityForm::Prefix, 50)),
        false => prelude_prefix_minus(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_prefix_minus(operator: Text) -> FixityLookup {
    handle text_eq(operator, "-") {
        true => FixityLookup::Found(fixity(FixityForm::Prefix, 50)),
        false => prelude_prefix_not(operator),
        _ => FixityLookup::Missing,
    }
}

fn prelude_prefix_not(operator: Text) -> FixityLookup {
    handle text_eq(operator, "!") {
        true => FixityLookup::Found(fixity(FixityForm::Prefix, 50)),
        false => FixityLookup::Missing,
        _ => FixityLookup::Missing,
    }
}

// Given the operator on the parser stack and the next infix operator, decide
// whether to reduce the stack. Equal precedence is governed by the incoming
// operator: a right-associative incoming operator shifts; every other infix
// operator reduces. A non-associative operator on either side is diagnosed.
pub fn reduction(stack: Fixity, incoming: Fixity) -> ReductionDecision {
    branch_bool(
        stack.precedence > incoming.precedence,
        () -> ReductionDecision { ReductionDecision::Reduce },
        () -> ReductionDecision { reduction_after_greater(stack, incoming) },
    )
}

fn reduction_after_greater(stack: Fixity, incoming: Fixity) -> ReductionDecision {
    branch_bool(
        incoming.precedence > stack.precedence,
        () -> ReductionDecision { ReductionDecision::Shift },
        () -> ReductionDecision { equal_precedence(stack.form, incoming.form) },
    )
}

fn equal_precedence(stack: FixityForm, incoming: FixityForm) -> ReductionDecision {
    handle stack {
        FixityForm::InfixNonAssociative => ReductionDecision::Ambiguous,
        FixityForm::Prefix => ReductionDecision::Ambiguous,
        _ => equal_precedence_after_stack(incoming),
    }
}

fn equal_precedence_after_stack(incoming: FixityForm) -> ReductionDecision {
    handle incoming {
        FixityForm::InfixRight => ReductionDecision::Shift,
        FixityForm::InfixLeft => ReductionDecision::Reduce,
        FixityForm::InfixNonAssociative => ReductionDecision::Ambiguous,
        FixityForm::Prefix => ReductionDecision::Ambiguous,
        _ => ReductionDecision::Ambiguous,
    }
}
