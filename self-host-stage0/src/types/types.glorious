// M14 begins with the closed bootstrap type vocabulary. Generic terms,
// lifetimes, effects, projections, and structural constants extend this
// source-owned equality boundary in later slices.
use compiler_support::text_eq;
use compiler_support::__g1_array_pop_move;

pub enum Type {
    Unit,
    Never,
    Bool,
    U8,
    U16,
    U32,
    U64,
    U128,
    I8,
    I16,
    I32,
    I64,
    I128,
    Usize,
    Isize,
    F32,
    F64,
    Char,
    Text,
    Bytes,
    Named(Text),
    // Nominal identity preserves the declaration and the canonical mixed-kind
    // generic-argument arena node. The arena is indirect so passing a nominal
    // through Body/Core/MIR does not duplicate an affine argument sequence.
    Nominal(i64, i64),
    // A reference names an immutable type-arena node. The arena owns the
    // recursive graph; this term stays an unrestricted compiler handle rather
    // than embedding an affine array in every type value.
    Reference(i64),
    // A source-visible borrow keeps mutability and region identity separate
    // from the arena index of its referent. `Reference` above remains the
    // internal recursive type-node handle; this variant models `&T`/`&mut T`.
    Borrowed(Mutability, Lifetime, i64),
    // The element type lives in the persistent arena, keeping recursive array
    // structure indirect while inference can still inspect it for occurs
    // checking.
    Array(i64),
    Generic(i64),
    // Body-local type uncertainty. It is kept distinct from declaration
    // generics and is resolved by `TypeInference` before an interface or VM
    // boundary can observe a concrete type.
    Inference(i64),
    Projection(Text, i64),
}

// Lifetimes are their own term kind. A region can never be encoded as an
// ordinary type-generic slot: static, declaration-generic, higher-ranked
// bound, and elided regions have distinct substitution and escape behavior.
pub enum Lifetime {
    Static,
    Generic(i64),
    Bound(i64, i64),
    Elided,
}

pub enum Mutability {
    Shared,
    Mutable,
}

// An effect is a nominal protocol identity, optionally applied to an already
// canonicalized generic-argument arena node.  The argument node keeps the
// bootstrap representation finite while ensuring `State<I64>` and
// `State<Text>` cannot collapse merely because they share a protocol name.
pub enum EffectInstance {
    Named(i64),
    Applied(i64, i64),
    // subject, trait definition, canonical trait-argument node, associated
    // row declaration. This delayed term is normalized by trait solving; it
    // is not a concrete protocol instance and therefore has its own identity.
    Projection(i64, i64, i64, i64),
}

// An open effect row has exactly one typed tail.  Inference tails are
// body-local uncertainty; generic tails are declaration-owned row binders.
// Keeping them separate prevents a type/lifetime placeholder from escaping as
// a row variable at a signature boundary.
pub enum EffectTail {
    Inferred(i64),
    Generic(i64),
}

// Effects are stored as an array-indirected persistent chain.  A closed row
// ends at Empty; an open row ends at an EffectTail. `canonical_effect_row`
// sorts and deduplicates the named prefix before equality or interface use,
// giving source code the frozen stage0 set semantics without making the row
// an untyped number.
pub enum EffectRow {
    Empty,
    Node(EffectInstance, Bool, Array<EffectRow>),
    Open(EffectTail),
}

// A callable stores the identity of an already-canonicalized effect row, not
// the affine row chain itself. The row arena owns the structural data; this
// compact key lets a callable travel through Body, Core, MIR, and the VM
// without duplicating or prematurely consuming its declaration contract.
pub enum EffectRowIdentity {
    Empty,
    Canonical(i64),
}

// Structural constants are compile-time identity terms, never runtime values
// or value types.  U32 expressions retain their source shape until a later
// normalization slice; quantity constants use their own opaque canonical
// identity and cannot be unified with an integer expression.
pub enum StructuralU32 {
    Literal(i64),
    Generic(i64),
    Binary(StructuralU32Operator, Array<StructuralU32>),
}

pub enum StructuralU32Operator {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
}

pub enum StructuralConstant {
    U32(StructuralU32),
    Quantity(i64),
}

// A declared generic slot retains its semantic kind until runtime lowering.
// In particular, a lifetime or effect row with the same numeric arena handle
// is never accepted as a value type argument.
pub enum GenericArgument {
    Type(Type),
    EffectRow(EffectRowIdentity),
    Lifetime(Lifetime),
    StructuralConstant(StructuralConstant),
}

// A compiler term has a kind.  Keeping the kinds explicit at the bootstrap
// boundary prevents an effect row, lifetime, or structural constant with the
// same numeric payload from being accepted as a value type by signatures or
// trait goals.
pub enum Term {
    ValueType(Type),
    EffectRow(EffectRow),
    Lifetime(Lifetime),
    StructuralConstant(StructuralConstant),
}

// Recursive type structure lives in a persistent arena rather than inside
// `Type` itself. Each node owns at most one array-indirected predecessor,
// making the representation finite while `Type::Reference` remains a cheap
// immutable node handle suitable for solver keys and repeated inspection.
pub enum TypeArena {
    Empty,
    Node(i64, Type, Bool, Array<TypeArena>),
}

pub enum TypeLookup {
    Found(Type),
    Missing,
}

pub enum TypeArenaAdmission {
    Value(TypeArena),
    DuplicateNode,
}

pub enum TypeArenaLookup {
    Found(Type, TypeArena),
    Missing(TypeArena),
}

// Persistent body-local type-variable bindings. The tail indirection gives
// each unification step ownership of one state snapshot while preserving the
// bindings needed by later zonking and mismatch diagnostics.
pub enum TypeInference {
    Empty,
    Binding(i64, Type, Bool, Array<TypeInference>),
}

pub enum InferenceLookup {
    Found(Type, TypeInference),
    Missing(TypeInference),
}

pub enum InferenceUnification {
    Unified(TypeInference),
    Mismatch(TypeInference),
    Occurs(TypeInference),
}

pub enum InferenceZonk {
    Value(Type, TypeInference),
    Unresolved(TypeInference),
}

// This is the concrete expected-result boundary used before body-local
// inference variables enter the full unifier. `Never` may satisfy an expected
// result of any value type, but it does not make unrelated concrete types
// equal to each other.
pub enum ShapeUnification {
    Unified(Type),
    Mismatch,
}

pub fn same(left: Type, right: Type) -> Bool {
    handle (left, right) {
        (Type::Unit, Type::Unit) => true,
        (Type::Never, Type::Never) => true,
        (Type::Bool, Type::Bool) => true,
        (Type::U8, Type::U8) => true,
        (Type::U16, Type::U16) => true,
        (Type::U32, Type::U32) => true,
        (Type::U64, Type::U64) => true,
        (Type::U128, Type::U128) => true,
        (Type::I8, Type::I8) => true,
        (Type::I16, Type::I16) => true,
        (Type::I32, Type::I32) => true,
        (Type::I64, Type::I64) => true,
        (Type::I128, Type::I128) => true,
        (Type::Usize, Type::Usize) => true,
        (Type::Isize, Type::Isize) => true,
        (Type::F32, Type::F32) => true,
        (Type::F64, Type::F64) => true,
        (Type::Char, Type::Char) => true,
        (Type::Text, Type::Text) => true,
        (Type::Bytes, Type::Bytes) => true,
        (Type::Named(left), Type::Named(right)) => text_eq(left, right),
        (Type::Nominal(left_definition, left_arguments), Type::Nominal(right_definition, right_arguments)) => same_nominal(left_definition, left_arguments, right_definition, right_arguments),
        (Type::Reference(left), Type::Reference(right)) => left == right,
        (Type::Borrowed(left_mutability, left_lifetime, left_referent), Type::Borrowed(right_mutability, right_lifetime, right_referent)) => same_borrow(left_mutability, left_lifetime, left_referent, right_mutability, right_lifetime, right_referent),
        (Type::Array(left), Type::Array(right)) => left == right,
        (Type::Generic(left), Type::Generic(right)) => left == right,
        (Type::Inference(left), Type::Inference(right)) => left == right,
        (Type::Projection(left_name, left_subject), Type::Projection(right_name, right_subject)) => projection_same(left_name, left_subject, right_name, right_subject),
        _ => false,
    }
}

pub fn unify_expected(left: Type, right: Type) -> ShapeUnification {
    handle left {
        Type::Never => ShapeUnification::Unified(right),
        value => unify_non_bottom(value, right),
    }
}

fn unify_non_bottom(left: Type, right: Type) -> ShapeUnification {
    handle right {
        Type::Never => ShapeUnification::Unified(left),
        value => unify_concrete(left, value),
    }
}

fn unify_concrete(left: Type, right: Type) -> ShapeUnification {
    handle same(left, right) {
        true => ShapeUnification::Unified(left),
        false => ShapeUnification::Mismatch,
        _ => ShapeUnification::Mismatch,
    }
}

pub fn reference(referent_node: i64) -> Type { Type::Reference(referent_node) }

pub fn nominal(definition: i64, arguments_node: i64) -> Type {
    Type::Nominal(definition, arguments_node)
}

pub fn inference_variable(index: i64) -> Type { Type::Inference(index) }

pub fn array_type(element_node: i64) -> Type { Type::Array(element_node) }

pub fn empty_inference() -> TypeInference { TypeInference::Empty }

pub fn lookup_inference(state: TypeInference, wanted: i64) -> InferenceLookup {
    handle state {
        TypeInference::Empty => InferenceLookup::Missing(TypeInference::Empty),
        TypeInference::Binding(node, value, has_tail, tail) => lookup_inference_node(node, value, has_tail, tail, wanted),
        _ => InferenceLookup::Missing(TypeInference::Empty),
    }
}

fn lookup_inference_node(node: i64, value: Type, has_tail: Bool, tail: Array<TypeInference>, wanted: i64) -> InferenceLookup {
    handle node == wanted {
        true => InferenceLookup::Found(value, TypeInference::Binding(node, value, has_tail, tail)),
        false => lookup_inference_tail(node, value, has_tail, tail, wanted),
        _ => InferenceLookup::Missing(TypeInference::Binding(node, value, has_tail, tail)),
    }
}

fn lookup_inference_tail(node: i64, value: Type, has_tail: Bool, tail: Array<TypeInference>, wanted: i64) -> InferenceLookup {
    handle has_tail {
        true => rebuild_inference_lookup(node, value, lookup_inference(__g1_array_pop_move<TypeInference>(&mut tail), wanted)),
        false => InferenceLookup::Missing(TypeInference::Binding(node, value, false, tail)),
        _ => InferenceLookup::Missing(TypeInference::Binding(node, value, false, tail)),
    }
}

fn rebuild_inference_lookup(node: i64, value: Type, lookup: InferenceLookup) -> InferenceLookup {
    handle lookup {
        InferenceLookup::Found(found, state) => InferenceLookup::Found(found, TypeInference::Binding(node, value, true, [state])),
        InferenceLookup::Missing(state) => InferenceLookup::Missing(TypeInference::Binding(node, value, true, [state])),
        _ => InferenceLookup::Missing(TypeInference::Binding(node, value, false, [])),
    }
}

fn bind_inference(state: TypeInference, variable: i64, value: Type) -> TypeInference {
    handle state {
        TypeInference::Empty => TypeInference::Binding(variable, value, false, []),
        TypeInference::Binding(node, existing, has_tail, tail) => bind_inference_node(node, existing, has_tail, tail, variable, value),
        _ => TypeInference::Binding(variable, value, false, []),
    }
}

fn bind_inference_node(node: i64, existing: Type, has_tail: Bool, tail: Array<TypeInference>, variable: i64, value: Type) -> TypeInference {
    handle node == variable {
        true => TypeInference::Binding(node, existing, has_tail, tail),
        false => bind_inference_tail(node, existing, has_tail, tail, variable, value),
        _ => TypeInference::Binding(node, existing, has_tail, tail),
    }
}

fn bind_inference_tail(node: i64, existing: Type, has_tail: Bool, tail: Array<TypeInference>, variable: i64, value: Type) -> TypeInference {
    handle has_tail {
        true => TypeInference::Binding(node, existing, true, [bind_inference(__g1_array_pop_move<TypeInference>(&mut tail), variable, value)]),
        false => TypeInference::Binding(node, existing, true, [TypeInference::Binding(variable, value, false, [])]),
        _ => TypeInference::Binding(node, existing, has_tail, tail),
    }
}

pub fn unify_inference(state: TypeInference, left: Type, right: Type) -> InferenceUnification {
    handle (left, right) {
        (Type::Inference(left), Type::Inference(right)) => unify_inference_variables(state, left, right),
        (Type::Inference(variable), value) => unify_inference_variable(state, variable, value),
        (value, Type::Inference(variable)) => unify_inference_variable(state, variable, value),
        (left, right) => unify_concrete_inference(state, left, right),
    }
}

pub fn continue_unification(previous: InferenceUnification, left: Type, right: Type) -> InferenceUnification {
    handle previous {
        InferenceUnification::Unified(state) => unify_inference(state, left, right),
        InferenceUnification::Mismatch(state) => InferenceUnification::Mismatch(state),
        InferenceUnification::Occurs(state) => InferenceUnification::Occurs(state),
        _ => InferenceUnification::Mismatch(TypeInference::Empty),
    }
}

// The arena is consumed only to inspect the proposed recursive shape. A full
// inference context owns this arena beside its bindings; this bootstrap entry
// proves the soundness boundary for the immediate `?T = Array<?T>` case.
pub fn unify_inference_with_occurs(state: TypeInference, arena: TypeArena, left: Type, right: Type) -> InferenceUnification {
    handle (left, right) {
        (Type::Inference(variable), value) => unify_inference_checked_binding(state, arena, variable, value),
        (value, Type::Inference(variable)) => unify_inference_checked_binding(state, arena, variable, value),
        (left, right) => unify_inference(state, left, right),
    }
}

fn unify_inference_checked_binding(state: TypeInference, arena: TypeArena, variable: i64, value: Type) -> InferenceUnification {
    handle occurs_in_type(arena, variable, value) {
        true => InferenceUnification::Occurs(state),
        false => unify_inference(state, Type::Inference(variable), value),
        _ => InferenceUnification::Mismatch(state),
    }
}

fn occurs_in_type(arena: TypeArena, variable: i64, value: Type) -> Bool {
    handle value {
        Type::Inference(found) => found == variable,
        Type::Array(element_node) => occurs_in_array_element(arena, variable, element_node),
        // Every indirect type constructor has the same recursive ownership
        // boundary as Array. Leaving references, borrows, or delayed
        // projections opaque here would admit `?T = &?T` (or a recursive
        // projection) and let a cyclic inference term cross a frozen type
        // boundary.
        Type::Reference(referent_node) => occurs_in_array_element(arena, variable, referent_node),
        Type::Borrowed(_, _, referent_node) => occurs_in_array_element(arena, variable, referent_node),
        Type::Projection(_, subject_node) => occurs_in_array_element(arena, variable, subject_node),
        _ => false,
    }
}

fn occurs_in_array_element(arena: TypeArena, variable: i64, element_node: i64) -> Bool {
    handle lookup_type_preserving(arena, element_node) {
        TypeArenaLookup::Found(element, next_arena) => occurs_in_type(next_arena, variable, element),
        TypeArenaLookup::Missing(_) => false,
        _ => false,
    }
}

fn unify_inference_variables(state: TypeInference, left: i64, right: i64) -> InferenceUnification {
    handle left == right {
        true => InferenceUnification::Unified(state),
        false => unify_inference_variable(state, left, Type::Inference(right)),
        _ => InferenceUnification::Mismatch(state),
    }
}

fn unify_inference_variable(state: TypeInference, variable: i64, value: Type) -> InferenceUnification {
    handle lookup_inference(state, variable) {
        InferenceLookup::Found(bound, next_state) => unify_inference(next_state, bound, value),
        InferenceLookup::Missing(next_state) => bind_unbound_inference(next_state, variable, value),
        _ => InferenceUnification::Mismatch(TypeInference::Empty),
    }
}

fn bind_unbound_inference(state: TypeInference, variable: i64, value: Type) -> InferenceUnification {
    handle value {
        Type::Inference(other) => bind_inference_alias(state, variable, other),
        value => InferenceUnification::Unified(bind_inference(state, variable, value)),
    }
}

fn bind_inference_alias(state: TypeInference, variable: i64, other: i64) -> InferenceUnification {
    handle variable == other {
        true => InferenceUnification::Unified(state),
        false => handle lookup_inference(state, other) {
            InferenceLookup::Found(bound, next_state) => unify_inference_variable(next_state, variable, bound),
            InferenceLookup::Missing(next_state) => InferenceUnification::Unified(bind_inference(next_state, variable, Type::Inference(other))),
            _ => InferenceUnification::Mismatch(TypeInference::Empty),
        },
        _ => InferenceUnification::Mismatch(state),
    }
}

fn unify_concrete_inference(state: TypeInference, left: Type, right: Type) -> InferenceUnification {
    handle unify_expected(left, right) {
        ShapeUnification::Unified(_) => InferenceUnification::Unified(state),
        ShapeUnification::Mismatch => InferenceUnification::Mismatch(state),
        _ => InferenceUnification::Mismatch(state),
    }
}

pub fn zonk_inference(state: TypeInference, value: Type) -> InferenceZonk {
    handle value {
        Type::Inference(variable) => zonk_inference_lookup(lookup_inference(state, variable)),
        value => InferenceZonk::Value(value, state),
    }
}

fn zonk_inference_lookup(lookup: InferenceLookup) -> InferenceZonk {
    handle lookup {
        InferenceLookup::Found(value, state) => zonk_inference(state, value),
        InferenceLookup::Missing(state) => InferenceZonk::Unresolved(state),
        _ => InferenceZonk::Unresolved(TypeInference::Empty),
    }
}

fn same_nominal(left_definition: i64, left_arguments: i64, right_definition: i64, right_arguments: i64) -> Bool {
    handle left_definition == right_definition {
        true => left_arguments == right_arguments,
        false => false,
        _ => false,
    }
}

pub fn type_argument(value: Type) -> GenericArgument { GenericArgument::Type(value) }

pub fn effect_row_argument(value: EffectRowIdentity) -> GenericArgument {
    GenericArgument::EffectRow(value)
}

pub fn lifetime_argument(value: Lifetime) -> GenericArgument {
    GenericArgument::Lifetime(value)
}

pub fn structural_constant_argument(value: StructuralConstant) -> GenericArgument {
    GenericArgument::StructuralConstant(value)
}

pub fn same_generic_argument(left: GenericArgument, right: GenericArgument) -> Bool {
    handle (left, right) {
        (GenericArgument::Type(left), GenericArgument::Type(right)) => same(left, right),
        (GenericArgument::EffectRow(left), GenericArgument::EffectRow(right)) => same_effect_identity(left, right),
        (GenericArgument::Lifetime(left), GenericArgument::Lifetime(right)) => same_lifetime(left, right),
        (GenericArgument::StructuralConstant(left), GenericArgument::StructuralConstant(right)) => same_structural_constant(left, right),
        _ => false,
    }
}

pub fn shared_borrow(lifetime: Lifetime, referent_node: i64) -> Type {
    Type::Borrowed(Mutability::Shared, lifetime, referent_node)
}

pub fn mutable_borrow(lifetime: Lifetime, referent_node: i64) -> Type {
    Type::Borrowed(Mutability::Mutable, lifetime, referent_node)
}

fn same_borrow(
    left_mutability: Mutability,
    left_lifetime: Lifetime,
    left_referent: i64,
    right_mutability: Mutability,
    right_lifetime: Lifetime,
    right_referent: i64,
) -> Bool {
    handle same_mutability(left_mutability, right_mutability) {
        true => same_borrow_lifetime(left_lifetime, left_referent, right_lifetime, right_referent),
        false => false,
        _ => false,
    }
}

fn same_borrow_lifetime(left_lifetime: Lifetime, left_referent: i64, right_lifetime: Lifetime, right_referent: i64) -> Bool {
    handle same_lifetime(left_lifetime, right_lifetime) {
        true => left_referent == right_referent,
        false => false,
        _ => false,
    }
}

fn same_mutability(left: Mutability, right: Mutability) -> Bool {
    handle (left, right) {
        (Mutability::Shared, Mutability::Shared) => true,
        (Mutability::Mutable, Mutability::Mutable) => true,
        _ => false,
    }
}

pub fn same_lifetime(left: Lifetime, right: Lifetime) -> Bool {
    handle (left, right) {
        (Lifetime::Static, Lifetime::Static) => true,
        (Lifetime::Generic(left), Lifetime::Generic(right)) => left == right,
        (Lifetime::Bound(left_depth, left_index), Lifetime::Bound(right_depth, right_index)) => same_bound_lifetime(left_depth, left_index, right_depth, right_index),
        (Lifetime::Elided, Lifetime::Elided) => true,
        _ => false,
    }
}

pub fn named_effect(definition: i64) -> EffectInstance { EffectInstance::Named(definition) }

pub fn applied_effect(definition: i64, arguments: i64) -> EffectInstance {
    EffectInstance::Applied(definition, arguments)
}

pub fn projected_effect_row(subject: i64, trait_definition: i64, trait_arguments: i64, associated_row: i64) -> EffectInstance {
    EffectInstance::Projection(subject, trait_definition, trait_arguments, associated_row)
}

pub fn empty_effect_row() -> EffectRow { EffectRow::Empty }

pub fn empty_effect_identity() -> EffectRowIdentity { EffectRowIdentity::Empty }

pub fn canonical_effect_identity(node: i64) -> EffectRowIdentity {
    EffectRowIdentity::Canonical(node)
}

pub fn same_effect_identity(left: EffectRowIdentity, right: EffectRowIdentity) -> Bool {
    handle (left, right) {
        (EffectRowIdentity::Empty, EffectRowIdentity::Empty) => true,
        (EffectRowIdentity::Canonical(left), EffectRowIdentity::Canonical(right)) => left == right,
        _ => false,
    }
}

pub fn singleton_effect_row(effect: EffectInstance) -> EffectRow {
    EffectRow::Node(effect, false, [])
}

pub fn prepend_effect(effect: EffectInstance, tail: EffectRow) -> EffectRow {
    EffectRow::Node(effect, true, [tail])
}

pub fn generic_effect_tail(index: i64) -> EffectRow {
    EffectRow::Open(EffectTail::Generic(index))
}

pub fn inferred_effect_tail(index: i64) -> EffectRow {
    EffectRow::Open(EffectTail::Inferred(index))
}

pub fn same_effect_instance(left: EffectInstance, right: EffectInstance) -> Bool {
    handle (left, right) {
        (EffectInstance::Named(left), EffectInstance::Named(right)) => left == right,
        (EffectInstance::Applied(left_definition, left_arguments), EffectInstance::Applied(right_definition, right_arguments)) => same_applied_effect(left_definition, left_arguments, right_definition, right_arguments),
        (EffectInstance::Projection(left_subject, left_trait, left_arguments, left_row), EffectInstance::Projection(right_subject, right_trait, right_arguments, right_row)) => same_projected_effect_row(left_subject, left_trait, left_arguments, left_row, right_subject, right_trait, right_arguments, right_row),
        _ => false,
    }
}

fn same_applied_effect(left_definition: i64, left_arguments: i64, right_definition: i64, right_arguments: i64) -> Bool {
    handle left_definition == right_definition {
        true => left_arguments == right_arguments,
        false => false,
        _ => false,
    }
}

fn same_projected_effect_row(
    left_subject: i64,
    left_trait: i64,
    left_arguments: i64,
    left_row: i64,
    right_subject: i64,
    right_trait: i64,
    right_arguments: i64,
    right_row: i64,
) -> Bool {
    handle left_subject == right_subject {
        true => same_projected_effect_row_trait(left_trait, left_arguments, left_row, right_trait, right_arguments, right_row),
        false => false,
        _ => false,
    }
}

fn same_projected_effect_row_trait(
    left_trait: i64,
    left_arguments: i64,
    left_row: i64,
    right_trait: i64,
    right_arguments: i64,
    right_row: i64,
) -> Bool {
    handle left_trait == right_trait {
        true => same_projected_effect_row_arguments(left_arguments, left_row, right_arguments, right_row),
        false => false,
        _ => false,
    }
}

fn same_projected_effect_row_arguments(left_arguments: i64, left_row: i64, right_arguments: i64, right_row: i64) -> Bool {
    handle left_arguments == right_arguments {
        true => left_row == right_row,
        false => false,
        _ => false,
    }
}

pub fn same_effect_tail(left: EffectTail, right: EffectTail) -> Bool {
    handle (left, right) {
        (EffectTail::Inferred(left), EffectTail::Inferred(right)) => left == right,
        (EffectTail::Generic(left), EffectTail::Generic(right)) => left == right,
        _ => false,
    }
}

pub fn same_effect_row(left: EffectRow, right: EffectRow) -> Bool {
    same_effect_row_ordered(canonical_effect_row(left), canonical_effect_row(right))
}

pub fn canonical_effect_row(value: EffectRow) -> EffectRow {
    handle value {
        EffectRow::Empty => EffectRow::Empty,
        EffectRow::Open(tail) => EffectRow::Open(tail),
        EffectRow::Node(effect, has_tail, tail) => canonical_effect_row_node(effect, has_tail, tail),
        _ => EffectRow::Empty,
    }
}

fn canonical_effect_row_node(effect: EffectInstance, has_tail: Bool, tail: Array<EffectRow>) -> EffectRow {
    handle has_tail {
        true => insert_effect(effect, canonical_effect_row(__g1_array_pop_move<EffectRow>(&mut tail))),
        false => singleton_effect_row(effect),
        _ => EffectRow::Empty,
    }
}

fn insert_effect(effect: EffectInstance, row: EffectRow) -> EffectRow {
    handle row {
        EffectRow::Empty => singleton_effect_row(effect),
        EffectRow::Open(tail) => prepend_effect(effect, EffectRow::Open(tail)),
        EffectRow::Node(head, has_tail, tail) => insert_effect_node(effect, head, has_tail, tail),
        _ => EffectRow::Empty,
    }
}

fn insert_effect_node(effect: EffectInstance, head: EffectInstance, has_tail: Bool, tail: Array<EffectRow>) -> EffectRow {
    handle same_effect_instance(effect, head) {
        true => EffectRow::Node(head, has_tail, tail),
        false => insert_distinct_effect(effect, head, has_tail, tail),
        _ => EffectRow::Empty,
    }
}

fn insert_distinct_effect(effect: EffectInstance, head: EffectInstance, has_tail: Bool, tail: Array<EffectRow>) -> EffectRow {
    handle effect_instance_less(effect, head) {
        true => EffectRow::Node(effect, true, [EffectRow::Node(head, has_tail, tail)]),
        false => insert_after_effect_head(effect, head, has_tail, tail),
        _ => EffectRow::Empty,
    }
}

fn insert_after_effect_head(effect: EffectInstance, head: EffectInstance, has_tail: Bool, tail: Array<EffectRow>) -> EffectRow {
    handle has_tail {
        true => EffectRow::Node(head, true, [insert_effect(effect, __g1_array_pop_move<EffectRow>(&mut tail))]),
        false => EffectRow::Node(head, true, [singleton_effect_row(effect)]),
        _ => EffectRow::Empty,
    }
}

fn effect_instance_less(left: EffectInstance, right: EffectInstance) -> Bool {
    handle (left, right) {
        (EffectInstance::Named(left), EffectInstance::Named(right)) => left < right,
        (EffectInstance::Named(_), EffectInstance::Applied(_, _)) => true,
        (EffectInstance::Named(_), EffectInstance::Projection(_, _, _, _)) => true,
        (EffectInstance::Applied(_, _), EffectInstance::Named(_)) => false,
        (EffectInstance::Applied(left_definition, left_arguments), EffectInstance::Applied(right_definition, right_arguments)) => applied_effect_less(left_definition, left_arguments, right_definition, right_arguments),
        (EffectInstance::Applied(_, _), EffectInstance::Projection(_, _, _, _)) => true,
        (EffectInstance::Projection(_, _, _, _), EffectInstance::Named(_)) => false,
        (EffectInstance::Projection(_, _, _, _), EffectInstance::Applied(_, _)) => false,
        (EffectInstance::Projection(left_subject, left_trait, left_arguments, left_row), EffectInstance::Projection(right_subject, right_trait, right_arguments, right_row)) => projected_effect_row_less(left_subject, left_trait, left_arguments, left_row, right_subject, right_trait, right_arguments, right_row),
        _ => false,
    }
}

fn applied_effect_less(left_definition: i64, left_arguments: i64, right_definition: i64, right_arguments: i64) -> Bool {
    handle left_definition == right_definition {
        true => left_arguments < right_arguments,
        false => left_definition < right_definition,
        _ => false,
    }
}

fn projected_effect_row_less(
    left_subject: i64,
    left_trait: i64,
    left_arguments: i64,
    left_row: i64,
    right_subject: i64,
    right_trait: i64,
    right_arguments: i64,
    right_row: i64,
) -> Bool {
    handle left_subject == right_subject {
        true => projected_effect_row_less_trait(left_trait, left_arguments, left_row, right_trait, right_arguments, right_row),
        false => left_subject < right_subject,
        _ => false,
    }
}

fn projected_effect_row_less_trait(
    left_trait: i64,
    left_arguments: i64,
    left_row: i64,
    right_trait: i64,
    right_arguments: i64,
    right_row: i64,
) -> Bool {
    handle left_trait == right_trait {
        true => projected_effect_row_less_arguments(left_arguments, left_row, right_arguments, right_row),
        false => left_trait < right_trait,
        _ => false,
    }
}

fn projected_effect_row_less_arguments(left_arguments: i64, left_row: i64, right_arguments: i64, right_row: i64) -> Bool {
    handle left_arguments == right_arguments {
        true => left_row < right_row,
        false => left_arguments < right_arguments,
        _ => false,
    }
}

fn same_effect_row_ordered(left: EffectRow, right: EffectRow) -> Bool {
    handle (left, right) {
        (EffectRow::Empty, EffectRow::Empty) => true,
        (EffectRow::Open(left), EffectRow::Open(right)) => same_effect_tail(left, right),
        (EffectRow::Node(left_effect, left_has_tail, left_tail), EffectRow::Node(right_effect, right_has_tail, right_tail)) => same_effect_row_node(left_effect, left_has_tail, left_tail, right_effect, right_has_tail, right_tail),
        _ => false,
    }
}

pub fn structural_u32_literal(value: i64) -> StructuralU32 {
    StructuralU32::Literal(value)
}

pub fn structural_u32_generic(index: i64) -> StructuralU32 {
    StructuralU32::Generic(index)
}

pub fn u32_add(left: StructuralU32, right: StructuralU32) -> StructuralU32 {
    StructuralU32::Binary(StructuralU32Operator::Add, [left, right])
}

pub fn u32_sub(left: StructuralU32, right: StructuralU32) -> StructuralU32 {
    StructuralU32::Binary(StructuralU32Operator::Sub, [left, right])
}

pub fn u32_mul(left: StructuralU32, right: StructuralU32) -> StructuralU32 {
    StructuralU32::Binary(StructuralU32Operator::Mul, [left, right])
}

pub fn u32_div(left: StructuralU32, right: StructuralU32) -> StructuralU32 {
    StructuralU32::Binary(StructuralU32Operator::Div, [left, right])
}

pub fn u32_rem(left: StructuralU32, right: StructuralU32) -> StructuralU32 {
    StructuralU32::Binary(StructuralU32Operator::Rem, [left, right])
}

pub fn u32_constant(value: StructuralU32) -> StructuralConstant {
    StructuralConstant::U32(value)
}

pub fn quantity_constant(identity: i64) -> StructuralConstant {
    StructuralConstant::Quantity(identity)
}

pub fn same_structural_constant(left: StructuralConstant, right: StructuralConstant) -> Bool {
    handle (left, right) {
        (StructuralConstant::U32(left), StructuralConstant::U32(right)) => same_structural_u32(left, right),
        (StructuralConstant::Quantity(left), StructuralConstant::Quantity(right)) => left == right,
        _ => false,
    }
}

fn same_structural_u32(left: StructuralU32, right: StructuralU32) -> Bool {
    handle (left, right) {
        (StructuralU32::Literal(left), StructuralU32::Literal(right)) => left == right,
        (StructuralU32::Generic(left), StructuralU32::Generic(right)) => left == right,
        (StructuralU32::Binary(left_operator, left_terms), StructuralU32::Binary(right_operator, right_terms)) => same_structural_u32_binary(left_operator, left_terms, right_operator, right_terms),
        _ => false,
    }
}

fn same_structural_u32_binary(
    left_operator: StructuralU32Operator,
    left_terms: Array<StructuralU32>,
    right_operator: StructuralU32Operator,
    right_terms: Array<StructuralU32>,
) -> Bool {
    handle same_structural_u32_operator(left_operator, right_operator) {
        true => same_structural_u32_pair(left_terms, right_terms),
        false => false,
        _ => false,
    }
}

fn same_structural_u32_operator(left: StructuralU32Operator, right: StructuralU32Operator) -> Bool {
    handle (left, right) {
        (StructuralU32Operator::Add, StructuralU32Operator::Add) => true,
        (StructuralU32Operator::Sub, StructuralU32Operator::Sub) => true,
        (StructuralU32Operator::Mul, StructuralU32Operator::Mul) => true,
        (StructuralU32Operator::Div, StructuralU32Operator::Div) => true,
        (StructuralU32Operator::Rem, StructuralU32Operator::Rem) => true,
        _ => false,
    }
}

fn same_structural_u32_pair(left: Array<StructuralU32>, right: Array<StructuralU32>) -> Bool {
    handle same_structural_u32(
        __g1_array_pop_move<StructuralU32>(&mut left),
        __g1_array_pop_move<StructuralU32>(&mut right)) {
        true => same_structural_u32(
            __g1_array_pop_move<StructuralU32>(&mut left),
            __g1_array_pop_move<StructuralU32>(&mut right)),
        false => false,
        _ => false,
    }
}

fn same_effect_row_node(
    left_effect: EffectInstance,
    left_has_tail: Bool,
    left_tail: Array<EffectRow>,
    right_effect: EffectInstance,
    right_has_tail: Bool,
    right_tail: Array<EffectRow>,
) -> Bool {
    handle same_effect_instance(left_effect, right_effect) {
        true => same_effect_row_tails(left_has_tail, left_tail, right_has_tail, right_tail),
        false => false,
        _ => false,
    }
}

fn same_effect_row_tails(
    left_has_tail: Bool,
    left_tail: Array<EffectRow>,
    right_has_tail: Bool,
    right_tail: Array<EffectRow>,
) -> Bool {
    handle (left_has_tail, right_has_tail) {
        (false, false) => true,
        (true, true) => same_effect_row_ordered(
            __g1_array_pop_move<EffectRow>(&mut left_tail),
            __g1_array_pop_move<EffectRow>(&mut right_tail)),
        _ => false,
    }
}

fn same_bound_lifetime(left_depth: i64, left_index: i64, right_depth: i64, right_index: i64) -> Bool {
    handle left_depth == right_depth {
        true => left_index == right_index,
        false => false,
        _ => false,
    }
}

pub fn empty_arena() -> TypeArena { TypeArena::Empty }

pub fn singleton_type(node: i64, value: Type) -> TypeArena {
    TypeArena::Node(node, value, false, [])
}

// Checked insertion preserves the arena's stable node identity contract. It
// never lets a later declaration shadow an existing recursive type node.
pub fn checked_insert_type(arena: TypeArena, node: i64, value: Type) -> TypeArenaAdmission {
    handle arena {
        TypeArena::Empty => TypeArenaAdmission::Value(TypeArena::Node(node, value, false, [])),
        TypeArena::Node(existing, existing_value, has_tail, tail) => checked_insert_head(existing, existing_value, has_tail, tail, node, value),
        _ => TypeArenaAdmission::DuplicateNode,
    }
}

pub fn lookup_type(arena: TypeArena, wanted: i64) -> TypeLookup {
    handle arena {
        TypeArena::Empty => TypeLookup::Missing,
        TypeArena::Node(node, value, has_tail, tail) => lookup_type_node(node, value, has_tail, tail, wanted),
        _ => TypeLookup::Missing,
    }
}

// This lookup reconstructs the persistent arena in its answer. Recursive
// analyses such as occurs checking can therefore inspect a node and continue
// walking child nodes without losing the arena that owns them.
pub fn lookup_type_preserving(arena: TypeArena, wanted: i64) -> TypeArenaLookup {
    handle arena {
        TypeArena::Empty => TypeArenaLookup::Missing(TypeArena::Empty),
        TypeArena::Node(node, value, has_tail, tail) => lookup_type_preserving_node(node, value, has_tail, tail, wanted),
        _ => TypeArenaLookup::Missing(TypeArena::Empty),
    }
}

fn lookup_type_preserving_node(node: i64, value: Type, has_tail: Bool, tail: Array<TypeArena>, wanted: i64) -> TypeArenaLookup {
    handle node == wanted {
        true => TypeArenaLookup::Found(value, TypeArena::Node(node, value, has_tail, tail)),
        false => lookup_type_preserving_tail(node, value, has_tail, tail, wanted),
        _ => TypeArenaLookup::Missing(TypeArena::Node(node, value, has_tail, tail)),
    }
}

fn lookup_type_preserving_tail(node: i64, value: Type, has_tail: Bool, tail: Array<TypeArena>, wanted: i64) -> TypeArenaLookup {
    handle has_tail {
        true => rebuild_type_arena_lookup(node, value, lookup_type_preserving(__g1_array_pop_move<TypeArena>(&mut tail), wanted)),
        false => TypeArenaLookup::Missing(TypeArena::Node(node, value, false, tail)),
        _ => TypeArenaLookup::Missing(TypeArena::Node(node, value, false, tail)),
    }
}

fn rebuild_type_arena_lookup(node: i64, value: Type, lookup: TypeArenaLookup) -> TypeArenaLookup {
    handle lookup {
        TypeArenaLookup::Found(found, arena) => TypeArenaLookup::Found(found, TypeArena::Node(node, value, true, [arena])),
        TypeArenaLookup::Missing(arena) => TypeArenaLookup::Missing(TypeArena::Node(node, value, true, [arena])),
        _ => TypeArenaLookup::Missing(TypeArena::Node(node, value, false, [])),
    }
}

pub fn resolve_reference(arena: TypeArena, value: Type) -> TypeLookup {
    handle value {
        Type::Reference(node) => lookup_type(arena, node),
        _ => TypeLookup::Missing,
    }
}

fn lookup_type_node(
    node: i64,
    value: Type,
    has_tail: Bool,
    tail: Array<TypeArena>,
    wanted: i64,
) -> TypeLookup {
    handle node == wanted {
        true => TypeLookup::Found(value),
        false => lookup_type_tail(has_tail, tail, wanted),
        _ => TypeLookup::Missing,
    }
}

fn lookup_type_tail(has_tail: Bool, tail: Array<TypeArena>, wanted: i64) -> TypeLookup {
    handle has_tail {
        true => lookup_type(__g1_array_pop_move<TypeArena>(&mut tail), wanted),
        false => TypeLookup::Missing,
        _ => TypeLookup::Missing,
    }
}

fn checked_insert_head(
    existing: i64,
    existing_value: Type,
    has_tail: Bool,
    tail: Array<TypeArena>,
    node: i64,
    value: Type,
) -> TypeArenaAdmission {
    handle existing == node {
        true => TypeArenaAdmission::DuplicateNode,
        false => checked_insert_tail(existing, existing_value, has_tail, tail, node, value),
        _ => TypeArenaAdmission::DuplicateNode,
    }
}

fn checked_insert_tail(
    existing: i64,
    existing_value: Type,
    has_tail: Bool,
    tail: Array<TypeArena>,
    node: i64,
    value: Type,
) -> TypeArenaAdmission {
    handle has_tail {
        true => checked_insert_rebuild(
            existing,
            existing_value,
            __g1_array_pop_move<TypeArena>(&mut tail),
            node,
            value),
        false => TypeArenaAdmission::Value(TypeArena::Node(
            existing,
            existing_value,
            true,
            [TypeArena::Node(node, value, false, [])])),
        _ => TypeArenaAdmission::DuplicateNode,
    }
}

fn checked_insert_rebuild(
    existing: i64,
    existing_value: Type,
    tail: TypeArena,
    node: i64,
    value: Type,
) -> TypeArenaAdmission {
    handle checked_insert_type(tail, node, value) {
        TypeArenaAdmission::Value(next) => TypeArenaAdmission::Value(TypeArena::Node(existing, existing_value, true, [next])),
        TypeArenaAdmission::DuplicateNode => TypeArenaAdmission::DuplicateNode,
        _ => TypeArenaAdmission::DuplicateNode,
    }
}

pub fn same_term(left: Term, right: Term) -> Bool {
    handle (left, right) {
        (Term::ValueType(left), Term::ValueType(right)) => same(left, right),
        (Term::EffectRow(left), Term::EffectRow(right)) => same_effect_row(left, right),
        (Term::Lifetime(left), Term::Lifetime(right)) => same_lifetime(left, right),
        (Term::StructuralConstant(left), Term::StructuralConstant(right)) => same_structural_constant(left, right),
        _ => false,
    }
}

fn projection_same(left_name: Text, left_subject: i64, right_name: Text, right_subject: i64) -> Bool { handle text_eq(left_name, right_name) { true => left_subject == right_subject, false => false, _ => false } }
