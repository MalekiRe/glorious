// M17's bootstrap solver answers a concrete trait/self goal against one
// concrete implementation. Candidate sets, recursion, projections, and
// explanations extend this deterministic source-owned answer shape.
use compiler_support::branch_bool;
use compiler_support::text_eq;
use compiler_support::__g1_array_pop_move;
use types::Type;
use types::same;
use types::GenericArgument;
use types::same_generic_argument;
use types::Lifetime;
use coherence::ImplementationPolarity;
use coherence::TraitArguments;
use coherence::empty_trait_arguments;
use coherence::same_trait_arguments;
use operation::Budget;
use operation::BudgetResult;
use operation::budget;
use operation::charge;

pub struct Implementation {
    evidence: i64,
    trait_name: Text,
    self_type: Type,
    trait_arguments: TraitArguments,
    polarity: ImplementationPolarity,
    generic_self: Bool,
}

pub struct Goal {
    trait_name: Text,
    self_type: Type,
    trait_arguments: TraitArguments,
}

// Candidate enumeration is persistent and source-owned. The full solver
// populates this from frozen interfaces and tables; this bootstrap worklist
// retains every candidate/goal pair so ambiguity and contradiction are folded
// over an arbitrary set rather than only the historical pair/three helpers.
pub struct CandidateQuery {
    candidate: Implementation,
    goal: Goal,
}

pub enum CandidateSet {
    Empty,
    Node(CandidateQuery, Bool, Array<CandidateSet>),
}

pub enum Answer {
    Satisfied(i64),
    Refuted(i64),
    Unsatisfied,
    Ambiguous,
    // Resource exhaustion is distinct from an ordinary absent candidate.
    // Callers must not cache a partial candidate scan as a negative answer.
    Overflow,
}

// Rule-head variables are not inference variables: they are rigidly owned by
// one implementation declaration and acquire a value only while that rule is
// matched against one goal.  Keep their bindings in a persistent chain so a
// repeated parameter is checked against its first occurrence rather than
// independently accepting every argument.  This is the source counterpart of
// stage0's implementation substitution environment.
pub enum GenericBindings {
    Empty,
    Binding(i64, Type, Bool, Array<GenericBindings>),
    LifetimeBinding(i64, Lifetime, Bool, Array<GenericBindings>),
}

pub enum GenericBindingLookup {
    Found(Type, GenericBindings),
    Missing(GenericBindings),
}

pub enum GenericLifetimeBindingLookup {
    Found(Lifetime, GenericBindings),
    Missing(GenericBindings),
}

pub enum GenericMatch {
    Matched(GenericBindings),
    Mismatched,
}

pub fn implementation(trait_name: Text, self_type: Type) -> Implementation {
    identified_implementation(0, trait_name, self_type)
}

pub fn negative_implementation(trait_name: Text, self_type: Type) -> Implementation {
    identified_negative_implementation(0, trait_name, self_type)
}

// Evidence is a stable declaration identity in the complete solver.  The
// bootstrap form keeps it as an integer so candidate-set selection cannot
// accidentally turn two distinct applicable implementations into one answer.
pub fn identified_implementation(evidence: i64, trait_name: Text, self_type: Type) -> Implementation {
    identified_implementation_with_arguments(evidence, trait_name, self_type, empty_trait_arguments())
}

pub fn identified_negative_implementation(evidence: i64, trait_name: Text, self_type: Type) -> Implementation {
    identified_negative_implementation_with_arguments(evidence, trait_name, self_type, empty_trait_arguments())
}

pub fn identified_implementation_with_arguments(evidence: i64, trait_name: Text, self_type: Type, trait_arguments: TraitArguments) -> Implementation {
    Implementation { evidence: evidence, trait_name: trait_name, self_type: self_type, trait_arguments: trait_arguments, polarity: ImplementationPolarity::Positive, generic_self: false }
}

pub fn identified_negative_implementation_with_arguments(evidence: i64, trait_name: Text, self_type: Type, trait_arguments: TraitArguments) -> Implementation {
    Implementation { evidence: evidence, trait_name: trait_name, self_type: self_type, trait_arguments: trait_arguments, polarity: ImplementationPolarity::Negative, generic_self: false }
}

// A declared implementation binder is distinct from `Type::Generic` in an
// ordinary goal: only this implementation form treats its Self slot as a
// universal match. Where-obligation solving remains a later tabled slice.
pub fn generic_implementation(evidence: i64, trait_name: Text) -> Implementation {
    generic_implementation_with_arguments(evidence, trait_name, empty_trait_arguments())
}

pub fn generic_negative_implementation(evidence: i64, trait_name: Text) -> Implementation {
    generic_negative_implementation_with_arguments(evidence, trait_name, empty_trait_arguments())
}

pub fn generic_implementation_with_arguments(evidence: i64, trait_name: Text, trait_arguments: TraitArguments) -> Implementation {
    Implementation { evidence: evidence, trait_name: trait_name, self_type: Type::Generic(0), trait_arguments: trait_arguments, polarity: ImplementationPolarity::Positive, generic_self: true }
}

pub fn generic_negative_implementation_with_arguments(evidence: i64, trait_name: Text, trait_arguments: TraitArguments) -> Implementation {
    Implementation { evidence: evidence, trait_name: trait_name, self_type: Type::Generic(0), trait_arguments: trait_arguments, polarity: ImplementationPolarity::Negative, generic_self: true }
}

pub fn goal(trait_name: Text, self_type: Type) -> Goal {
    goal_with_arguments(trait_name, self_type, empty_trait_arguments())
}

pub fn goal_with_arguments(trait_name: Text, self_type: Type, trait_arguments: TraitArguments) -> Goal {
    Goal { trait_name: trait_name, self_type: self_type, trait_arguments: trait_arguments }
}

pub fn candidate_query(candidate: Implementation, goal: Goal) -> CandidateQuery {
    CandidateQuery { candidate: candidate, goal: goal }
}

pub fn empty_candidates() -> CandidateSet { CandidateSet::Empty }

pub fn single_candidate(candidate: Implementation, goal: Goal) -> CandidateSet {
    CandidateSet::Node(candidate_query(candidate, goal), false, [])
}

pub fn prepend_candidate(candidate: Implementation, goal: Goal, tail: CandidateSet) -> CandidateSet {
    CandidateSet::Node(candidate_query(candidate, goal), true, [tail])
}

pub fn solve(candidate: Implementation, goal: Goal) -> Answer {
    handle (candidate, goal) {
        (
            Implementation { evidence, trait_name, self_type, trait_arguments, polarity, generic_self },
            Goal { trait_name: requested_trait, self_type: requested_type, trait_arguments: requested_arguments },
        ) => solve_goal_parts(
            evidence,
            trait_name,
            self_type,
            trait_arguments,
            polarity,
            generic_self,
            requested_trait,
            requested_type,
            requested_arguments,
        ),
    }
}

// Destructure the affine candidate and goal before branching. The old
// closure-shaped form read `candidate.trait_name` and then tried to move the
// complete candidate into the successful branch, which is valid only while
// every field is implicitly copyable. Recursive `Type` terms are not.
fn solve_goal_parts(
    evidence: i64,
    candidate_trait: Text,
    candidate_type: Type,
    candidate_arguments: TraitArguments,
    polarity: ImplementationPolarity,
    generic_self: Bool,
    requested_trait: Text,
    requested_type: Type,
    requested_arguments: TraitArguments,
) -> Answer {
    handle text_eq(candidate_trait, requested_trait) {
        true => solve_candidate_head(evidence, candidate_type, candidate_arguments, polarity, generic_self, requested_type, requested_arguments),
        false => Answer::Unsatisfied,
        _ => Answer::Unsatisfied,
    }
}

fn solve_candidate_head(evidence: i64, candidate_type: Type, candidate_arguments: TraitArguments, polarity: ImplementationPolarity, generic_self: Bool, requested_type: Type, requested_arguments: TraitArguments) -> Answer {
    handle match_candidate_self(candidate_type, generic_self, requested_type, GenericBindings::Empty) {
        GenericMatch::Matched(bindings) => solve_candidate_arguments(evidence, candidate_arguments, polarity, requested_arguments, bindings),
        GenericMatch::Mismatched => Answer::Unsatisfied,
        _ => Answer::Unsatisfied,
    }
}

fn match_candidate_self(candidate_type: Type, generic_self: Bool, requested_type: Type, bindings: GenericBindings) -> GenericMatch {
    handle generic_self {
        true => match_template_type(Type::Generic(0), requested_type, bindings),
        false => match_template_type(candidate_type, requested_type, bindings),
        _ => GenericMatch::Mismatched,
    }
}

fn solve_candidate_arguments(evidence: i64, candidate_arguments: TraitArguments, polarity: ImplementationPolarity, requested_arguments: TraitArguments, bindings: GenericBindings) -> Answer {
    handle match_trait_arguments(candidate_arguments, requested_arguments, bindings) {
        GenericMatch::Matched(_) => answer_for_polarity(polarity, evidence),
        GenericMatch::Mismatched => Answer::Unsatisfied,
        _ => Answer::Unsatisfied,
    }
}

// Only a direct `Type::Generic` can occur in this compact source head at the
// moment.  Nested nominal/array terms remain arena-addressed and are added
// with their structural matcher; they must not be treated as wildcard handles
// here.  All non-binder terms retain exact M14 identity.
fn match_template_type(template: Type, actual: Type, bindings: GenericBindings) -> GenericMatch {
    handle template {
        Type::Generic(index) => bind_generic_type(bindings, index, actual),
        value => handle same(value, actual) {
            true => GenericMatch::Matched(bindings),
            false => GenericMatch::Mismatched,
            _ => GenericMatch::Mismatched,
        },
    }
}

fn match_trait_arguments(template: TraitArguments, actual: TraitArguments, bindings: GenericBindings) -> GenericMatch {
    handle (template, actual) {
        (TraitArguments::Empty, TraitArguments::Empty) => GenericMatch::Matched(bindings),
        (TraitArguments::Node(template_value, template_has_tail, template_tail), TraitArguments::Node(actual_value, actual_has_tail, actual_tail)) => match_trait_argument_node(template_value, template_has_tail, template_tail, actual_value, actual_has_tail, actual_tail, bindings),
        _ => GenericMatch::Mismatched,
    }
}

fn match_trait_argument_node(template_value: GenericArgument, template_has_tail: Bool, template_tail: Array<TraitArguments>, actual_value: GenericArgument, actual_has_tail: Bool, actual_tail: Array<TraitArguments>, bindings: GenericBindings) -> GenericMatch {
    handle match_template_argument(template_value, actual_value, bindings) {
        GenericMatch::Matched(next_bindings) => match_trait_argument_tails(template_has_tail, template_tail, actual_has_tail, actual_tail, next_bindings),
        GenericMatch::Mismatched => GenericMatch::Mismatched,
        _ => GenericMatch::Mismatched,
    }
}

fn match_template_argument(template: GenericArgument, actual: GenericArgument, bindings: GenericBindings) -> GenericMatch {
    handle (template, actual) {
        (GenericArgument::Type(template), GenericArgument::Type(actual)) => match_template_type(template, actual, bindings),
        (GenericArgument::Lifetime(Lifetime::Generic(index)), GenericArgument::Lifetime(actual)) => bind_generic_lifetime(bindings, index, actual),
        (template, actual) => handle same_generic_argument(template, actual) {
            true => GenericMatch::Matched(bindings),
            false => GenericMatch::Mismatched,
            _ => GenericMatch::Mismatched,
        },
    }
}

fn match_trait_argument_tails(template_has_tail: Bool, template_tail: Array<TraitArguments>, actual_has_tail: Bool, actual_tail: Array<TraitArguments>, bindings: GenericBindings) -> GenericMatch {
    handle (template_has_tail, actual_has_tail) {
        (false, false) => GenericMatch::Matched(bindings),
        (true, true) => match_trait_arguments(__g1_array_pop_move<TraitArguments>(&mut template_tail), __g1_array_pop_move<TraitArguments>(&mut actual_tail), bindings),
        _ => GenericMatch::Mismatched,
    }
}

fn bind_generic_type(bindings: GenericBindings, index: i64, value: Type) -> GenericMatch {
    handle lookup_generic_type(bindings, index) {
        GenericBindingLookup::Found(previous, next_bindings) => handle same(previous, value) {
            true => GenericMatch::Matched(next_bindings),
            false => GenericMatch::Mismatched,
            _ => GenericMatch::Mismatched,
        },
        GenericBindingLookup::Missing(next_bindings) => GenericMatch::Matched(insert_generic_type(next_bindings, index, value)),
        _ => GenericMatch::Mismatched,
    }
}

fn lookup_generic_type(bindings: GenericBindings, wanted: i64) -> GenericBindingLookup {
    handle bindings {
        GenericBindings::Empty => GenericBindingLookup::Missing(GenericBindings::Empty),
        GenericBindings::Binding(index, value, has_tail, tail) => lookup_generic_type_node(index, value, has_tail, tail, wanted),
        GenericBindings::LifetimeBinding(index, value, has_tail, tail) => lookup_generic_type_after_lifetime(index, value, has_tail, tail, wanted),
        _ => GenericBindingLookup::Missing(GenericBindings::Empty),
    }
}

fn lookup_generic_type_after_lifetime(index: i64, value: Lifetime, has_tail: Bool, tail: Array<GenericBindings>, wanted: i64) -> GenericBindingLookup {
    handle has_tail {
        true => rebuild_generic_type_after_lifetime(index, value, lookup_generic_type(__g1_array_pop_move<GenericBindings>(&mut tail), wanted)),
        false => GenericBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, false, tail)),
        _ => GenericBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, false, tail)),
    }
}

fn rebuild_generic_type_after_lifetime(index: i64, value: Lifetime, lookup: GenericBindingLookup) -> GenericBindingLookup {
    handle lookup {
        GenericBindingLookup::Found(found, bindings) => GenericBindingLookup::Found(found, GenericBindings::LifetimeBinding(index, value, true, [bindings])),
        GenericBindingLookup::Missing(bindings) => GenericBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, true, [bindings])),
        _ => GenericBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, false, [])),
    }
}

fn lookup_generic_type_node(index: i64, value: Type, has_tail: Bool, tail: Array<GenericBindings>, wanted: i64) -> GenericBindingLookup {
    handle index == wanted {
        true => GenericBindingLookup::Found(value, GenericBindings::Binding(index, value, has_tail, tail)),
        false => lookup_generic_type_tail(index, value, has_tail, tail, wanted),
        _ => GenericBindingLookup::Missing(GenericBindings::Binding(index, value, has_tail, tail)),
    }
}

fn lookup_generic_type_tail(index: i64, value: Type, has_tail: Bool, tail: Array<GenericBindings>, wanted: i64) -> GenericBindingLookup {
    handle has_tail {
        true => rebuild_generic_type_lookup(index, value, lookup_generic_type(__g1_array_pop_move<GenericBindings>(&mut tail), wanted)),
        false => GenericBindingLookup::Missing(GenericBindings::Binding(index, value, false, tail)),
        _ => GenericBindingLookup::Missing(GenericBindings::Binding(index, value, false, tail)),
    }
}

fn rebuild_generic_type_lookup(index: i64, value: Type, lookup: GenericBindingLookup) -> GenericBindingLookup {
    handle lookup {
        GenericBindingLookup::Found(found, bindings) => GenericBindingLookup::Found(found, GenericBindings::Binding(index, value, true, [bindings])),
        GenericBindingLookup::Missing(bindings) => GenericBindingLookup::Missing(GenericBindings::Binding(index, value, true, [bindings])),
        _ => GenericBindingLookup::Missing(GenericBindings::Binding(index, value, false, [])),
    }
}

fn insert_generic_type(bindings: GenericBindings, index: i64, value: Type) -> GenericBindings {
    handle bindings {
        GenericBindings::Empty => GenericBindings::Binding(index, value, false, []),
        GenericBindings::Binding(existing_index, existing_value, has_tail, tail) => handle has_tail {
            true => GenericBindings::Binding(existing_index, existing_value, true, [insert_generic_type(__g1_array_pop_move<GenericBindings>(&mut tail), index, value)]),
            false => GenericBindings::Binding(existing_index, existing_value, true, [GenericBindings::Binding(index, value, false, [])]),
            _ => GenericBindings::Binding(existing_index, existing_value, has_tail, tail),
        },
        GenericBindings::LifetimeBinding(existing_index, existing_value, has_tail, tail) => handle has_tail {
            true => GenericBindings::LifetimeBinding(existing_index, existing_value, true, [insert_generic_type(__g1_array_pop_move<GenericBindings>(&mut tail), index, value)]),
            false => GenericBindings::LifetimeBinding(existing_index, existing_value, true, [GenericBindings::Binding(index, value, false, [])]),
            _ => GenericBindings::LifetimeBinding(existing_index, existing_value, has_tail, tail),
        },
        _ => GenericBindings::Binding(index, value, false, []),
    }
}

fn bind_generic_lifetime(bindings: GenericBindings, index: i64, value: Lifetime) -> GenericMatch {
    handle lookup_generic_lifetime(bindings, index) {
        GenericLifetimeBindingLookup::Found(previous, next_bindings) => handle same_lifetime(previous, value) {
            true => GenericMatch::Matched(next_bindings),
            false => GenericMatch::Mismatched,
            _ => GenericMatch::Mismatched,
        },
        GenericLifetimeBindingLookup::Missing(next_bindings) => GenericMatch::Matched(insert_generic_lifetime(next_bindings, index, value)),
        _ => GenericMatch::Mismatched,
    }
}

fn same_lifetime(left: Lifetime, right: Lifetime) -> Bool {
    handle (left, right) {
        (Lifetime::Static, Lifetime::Static) => true,
        (Lifetime::Generic(left), Lifetime::Generic(right)) => left == right,
        (Lifetime::Bound(left_depth, left_index), Lifetime::Bound(right_depth, right_index)) => handle left_depth == right_depth { true => left_index == right_index, false => false, _ => false },
        (Lifetime::Elided, Lifetime::Elided) => true,
        _ => false,
    }
}

fn lookup_generic_lifetime(bindings: GenericBindings, wanted: i64) -> GenericLifetimeBindingLookup {
    handle bindings {
        GenericBindings::Empty => GenericLifetimeBindingLookup::Missing(GenericBindings::Empty),
        GenericBindings::Binding(index, value, has_tail, tail) => lookup_generic_lifetime_after_type(index, value, has_tail, tail, wanted),
        GenericBindings::LifetimeBinding(index, value, has_tail, tail) => lookup_generic_lifetime_node(index, value, has_tail, tail, wanted),
        _ => GenericLifetimeBindingLookup::Missing(GenericBindings::Empty),
    }
}

fn lookup_generic_lifetime_node(index: i64, value: Lifetime, has_tail: Bool, tail: Array<GenericBindings>, wanted: i64) -> GenericLifetimeBindingLookup {
    handle index == wanted {
        true => GenericLifetimeBindingLookup::Found(value, GenericBindings::LifetimeBinding(index, value, has_tail, tail)),
        false => lookup_generic_lifetime_tail(index, value, has_tail, tail, wanted),
        _ => GenericLifetimeBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, has_tail, tail)),
    }
}

fn lookup_generic_lifetime_after_type(index: i64, value: Type, has_tail: Bool, tail: Array<GenericBindings>, wanted: i64) -> GenericLifetimeBindingLookup {
    handle has_tail {
        true => rebuild_generic_lifetime_after_type(index, value, lookup_generic_lifetime(__g1_array_pop_move<GenericBindings>(&mut tail), wanted)),
        false => GenericLifetimeBindingLookup::Missing(GenericBindings::Binding(index, value, false, tail)),
        _ => GenericLifetimeBindingLookup::Missing(GenericBindings::Binding(index, value, false, tail)),
    }
}

fn lookup_generic_lifetime_tail(index: i64, value: Lifetime, has_tail: Bool, tail: Array<GenericBindings>, wanted: i64) -> GenericLifetimeBindingLookup {
    handle has_tail {
        true => rebuild_generic_lifetime_lookup(index, value, lookup_generic_lifetime(__g1_array_pop_move<GenericBindings>(&mut tail), wanted)),
        false => GenericLifetimeBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, false, tail)),
        _ => GenericLifetimeBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, false, tail)),
    }
}

fn rebuild_generic_lifetime_after_type(index: i64, value: Type, lookup: GenericLifetimeBindingLookup) -> GenericLifetimeBindingLookup {
    handle lookup {
        GenericLifetimeBindingLookup::Found(found, bindings) => GenericLifetimeBindingLookup::Found(found, GenericBindings::Binding(index, value, true, [bindings])),
        GenericLifetimeBindingLookup::Missing(bindings) => GenericLifetimeBindingLookup::Missing(GenericBindings::Binding(index, value, true, [bindings])),
        _ => GenericLifetimeBindingLookup::Missing(GenericBindings::Binding(index, value, false, [])),
    }
}

fn rebuild_generic_lifetime_lookup(index: i64, value: Lifetime, lookup: GenericLifetimeBindingLookup) -> GenericLifetimeBindingLookup {
    handle lookup {
        GenericLifetimeBindingLookup::Found(found, bindings) => GenericLifetimeBindingLookup::Found(found, GenericBindings::LifetimeBinding(index, value, true, [bindings])),
        GenericLifetimeBindingLookup::Missing(bindings) => GenericLifetimeBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, true, [bindings])),
        _ => GenericLifetimeBindingLookup::Missing(GenericBindings::LifetimeBinding(index, value, false, [])),
    }
}

fn insert_generic_lifetime(bindings: GenericBindings, index: i64, value: Lifetime) -> GenericBindings {
    handle bindings {
        GenericBindings::Empty => GenericBindings::LifetimeBinding(index, value, false, []),
        GenericBindings::Binding(existing_index, existing_value, has_tail, tail) => handle has_tail {
            true => GenericBindings::Binding(existing_index, existing_value, true, [insert_generic_lifetime(__g1_array_pop_move<GenericBindings>(&mut tail), index, value)]),
            false => GenericBindings::Binding(existing_index, existing_value, true, [GenericBindings::LifetimeBinding(index, value, false, [])]),
            _ => GenericBindings::Binding(existing_index, existing_value, has_tail, tail),
        },
        GenericBindings::LifetimeBinding(existing_index, existing_value, has_tail, tail) => handle has_tail {
            true => GenericBindings::LifetimeBinding(existing_index, existing_value, true, [insert_generic_lifetime(__g1_array_pop_move<GenericBindings>(&mut tail), index, value)]),
            false => GenericBindings::LifetimeBinding(existing_index, existing_value, true, [GenericBindings::LifetimeBinding(index, value, false, [])]),
            _ => GenericBindings::LifetimeBinding(existing_index, existing_value, has_tail, tail),
        },
        _ => GenericBindings::LifetimeBinding(index, value, false, []),
    }
}

// A qualified call first selects on the exact supplied receiver type. This
// admits `impl Trait for &T` without conflating it with `impl Trait for T`.
// The caller supplies the optional legacy referent query separately because
// the bootstrap language is affine: neither candidate nor goal may be reused
// after the exact query consumes it. The fallback runs only when exact
// selection has no solution, never after positive, negative, ambiguous, or
// resource-limited evidence.
pub fn solve_prefer_exact_receiver(
    exact_candidate: Implementation,
    exact_goal: Goal,
    referent_candidate: Implementation,
    referent_goal: Goal,
) -> Answer {
    fallback_after_exact(
        solve(exact_candidate, exact_goal),
        referent_candidate,
        referent_goal,
    )
}

fn fallback_after_exact(
    exact: Answer,
    referent_candidate: Implementation,
    referent_goal: Goal,
) -> Answer {
    handle exact {
        Answer::Unsatisfied => solve(referent_candidate, referent_goal),
        Answer::Satisfied(evidence) => Answer::Satisfied(evidence),
        Answer::Refuted(evidence) => Answer::Refuted(evidence),
        Answer::Ambiguous => Answer::Ambiguous,
        Answer::Overflow => Answer::Overflow,
        _ => Answer::Unsatisfied,
    }
}

// The full tabled solver shares request-scoped step accounting with parsing,
// query execution, and MIR worklists.  This bootstrap slice makes that
// authority explicit before candidate enumeration: every inspected candidate
// consumes one unit, and an exhausted budget has a terminal answer distinct
// from `Unsatisfied`.
pub fn solve_with_step_limit(limit: i64, candidate: Implementation, goal: Goal) -> Answer {
    solve_with_budget(budget(limit), candidate, goal)
}

fn solve_with_budget(steps: Budget, candidate: Implementation, goal: Goal) -> Answer {
    handle charge(steps, 1) {
        BudgetResult::Value(_) => solve(candidate, goal),
        BudgetResult::Error(_) => Answer::Overflow,
        _ => Answer::Overflow,
    }
}

// Candidate sets cannot silently choose a positive implementation over an
// equally applicable negative one. The compact two-candidate form is the
// bootstrap predecessor of the full worklist and explanation engine.
pub fn solve_pair(
    first: Implementation,
    first_goal: Goal,
    second: Implementation,
    second_goal: Goal,
) -> Answer {
    combine_answers(solve(first, first_goal), solve(second, second_goal))
}

pub fn solve_candidates(candidates: CandidateSet) -> Answer {
    handle candidates {
        CandidateSet::Empty => Answer::Unsatisfied,
        CandidateSet::Node(query, has_tail, tail) => solve_candidate_node(query, has_tail, tail),
        _ => Answer::Unsatisfied,
    }
}

// Worklist search consumes one shared step per inspected candidate. An empty
// tail is not work, but every candidate is charged before it can contribute
// evidence; this prevents a finite budget from publishing a partial answer.
pub fn solve_candidates_with_step_limit(limit: i64, candidates: CandidateSet) -> Answer {
    solve_candidates_with_budget(budget(limit), candidates)
}

fn solve_candidates_with_budget(steps: Budget, candidates: CandidateSet) -> Answer {
    handle candidates {
        CandidateSet::Empty => Answer::Unsatisfied,
        CandidateSet::Node(query, has_tail, tail) => solve_candidate_with_budget(steps, query, has_tail, tail),
        _ => Answer::Unsatisfied,
    }
}

fn solve_candidate_with_budget(steps: Budget, query: CandidateQuery, has_tail: Bool, tail: Array<CandidateSet>) -> Answer {
    handle charge(steps, 1) {
        BudgetResult::Value(next) => solve_charged_candidate(next, query, has_tail, tail),
        BudgetResult::Error(_) => Answer::Overflow,
        _ => Answer::Overflow,
    }
}

fn solve_charged_candidate(steps: Budget, query: CandidateQuery, has_tail: Bool, tail: Array<CandidateSet>) -> Answer {
    handle query {
        CandidateQuery { candidate, goal } => handle has_tail {
            true => combine_budgeted_answers(solve(candidate, goal), solve_candidates_with_budget(steps, __g1_array_pop_move<CandidateSet>(&mut tail))),
            false => solve(candidate, goal),
            _ => Answer::Unsatisfied,
        },
    }
}

// Search exhaustion is terminal. The ordinary candidate fold intentionally
// lets a satisfied answer dominate an unrelated unsatisfied candidate, but
// it must never dominate an uninspected tail whose budget was exhausted.
fn combine_budgeted_answers(first: Answer, second: Answer) -> Answer {
    handle second {
        Answer::Overflow => Answer::Overflow,
        value => combine_answers(first, value),
    }
}

fn solve_candidate_node(query: CandidateQuery, has_tail: Bool, tail: Array<CandidateSet>) -> Answer {
    handle query {
        CandidateQuery { candidate, goal } => handle has_tail {
            true => combine_answers(solve(candidate, goal), solve_candidates(__g1_array_pop_move<CandidateSet>(&mut tail))),
            false => solve(candidate, goal),
            _ => Answer::Unsatisfied,
        },
    }
}

// This is the bootstrap form of a generic implementation with one where
// obligation. A tabled solver will discover and recurse through such
// obligations from an implementation header; keeping the two candidate goals
// explicit here preserves the crucial answer policy first: a selected generic
// implementation is not evidence until its required trait goal succeeds.
pub fn solve_generic_with_where(
    generic_candidate: Implementation,
    generic_goal: Goal,
    required_candidate: Implementation,
    required_goal: Goal,
) -> Answer {
    complete_where_obligation(
        solve(generic_candidate, generic_goal),
        solve(required_candidate, required_goal),
    )
}

// An implementation may have more than one where-bound. Reuse the same
// candidate/goal worklist representation, but require every obligation to
// prove before the selected generic evidence can be published.
pub fn solve_generic_with_obligations(
    generic_candidate: Implementation,
    generic_goal: Goal,
    obligations: CandidateSet,
) -> Answer {
    complete_where_obligation(solve(generic_candidate, generic_goal), solve_obligations(obligations))
}

fn solve_obligations(obligations: CandidateSet) -> Answer {
    handle obligations {
        CandidateSet::Empty => Answer::Satisfied(0),
        CandidateSet::Node(query, has_tail, tail) => solve_obligation_node(query, has_tail, tail),
        _ => Answer::Unsatisfied,
    }
}

fn solve_obligation_node(query: CandidateQuery, has_tail: Bool, tail: Array<CandidateSet>) -> Answer {
    handle query {
        CandidateQuery { candidate, goal } => continue_obligation_answer(solve(candidate, goal), has_tail, tail),
    }
}

fn continue_obligation_answer(answer: Answer, has_tail: Bool, tail: Array<CandidateSet>) -> Answer {
    handle answer {
        Answer::Satisfied(_) => handle has_tail {
            true => solve_obligations(__g1_array_pop_move<CandidateSet>(&mut tail)),
            false => Answer::Satisfied(0),
            _ => Answer::Unsatisfied,
        },
        Answer::Refuted(_) => discard_obligation_tail(has_tail, tail, Answer::Refuted(0)),
        Answer::Unsatisfied => discard_obligation_tail(has_tail, tail, Answer::Unsatisfied),
        Answer::Ambiguous => discard_obligation_tail(has_tail, tail, Answer::Ambiguous),
        Answer::Overflow => discard_obligation_tail(has_tail, tail, Answer::Overflow),
        _ => Answer::Unsatisfied,
    }
}

fn discard_obligation_tail(has_tail: Bool, tail: Array<CandidateSet>, answer: Answer) -> Answer {
    handle has_tail {
        true => discard_obligation_tail_after(discard_candidates(__g1_array_pop_move<CandidateSet>(&mut tail)), answer),
        false => answer,
        _ => Answer::Unsatisfied,
    }
}

fn discard_obligation_tail_after(_: Bool, answer: Answer) -> Answer { answer }

fn discard_candidates(value: CandidateSet) -> Bool {
    handle value {
        CandidateSet::Empty => true,
        CandidateSet::Node(_, has_tail, tail) => handle has_tail {
            true => discard_candidates(__g1_array_pop_move<CandidateSet>(&mut tail)),
            false => true,
            _ => false,
        },
        _ => false,
    }
}

fn complete_where_obligation(selected: Answer, required: Answer) -> Answer {
    handle selected {
        Answer::Satisfied(evidence) => complete_selected_where(evidence, required),
        Answer::Refuted(evidence) => Answer::Refuted(evidence),
        Answer::Unsatisfied => Answer::Unsatisfied,
        Answer::Ambiguous => Answer::Ambiguous,
        Answer::Overflow => Answer::Overflow,
        _ => Answer::Unsatisfied,
    }
}

fn complete_selected_where(evidence: i64, required: Answer) -> Answer {
    handle required {
        Answer::Satisfied(_) => Answer::Satisfied(evidence),
        Answer::Refuted(_) => Answer::Unsatisfied,
        Answer::Unsatisfied => Answer::Unsatisfied,
        Answer::Ambiguous => Answer::Ambiguous,
        Answer::Overflow => Answer::Overflow,
        _ => Answer::Unsatisfied,
    }
}

// Preserve evaluation order under a finite budget.  A later candidate is not
// silently skipped when the budget runs out: the terminal resource outcome
// wins over a partial selection, matching the stage0 solver's step-limit
// contract.
pub fn solve_pair_with_step_limit(
    limit: i64,
    first: Implementation,
    first_goal: Goal,
    second: Implementation,
    second_goal: Goal,
) -> Answer {
    solve_pair_with_budget(budget(limit), first, first_goal, second, second_goal)
}

fn solve_pair_with_budget(
    steps: Budget,
    first: Implementation,
    first_goal: Goal,
    second: Implementation,
    second_goal: Goal,
) -> Answer {
    handle charge(steps, 1) {
        BudgetResult::Value(after_first) => solve_second_with_budget(after_first, first, first_goal, second, second_goal),
        BudgetResult::Error(_) => Answer::Overflow,
        _ => Answer::Overflow,
    }
}

fn solve_second_with_budget(
    steps: Budget,
    first: Implementation,
    first_goal: Goal,
    second: Implementation,
    second_goal: Goal,
) -> Answer {
    handle charge(steps, 1) {
        BudgetResult::Value(_) => combine_answers(solve(first, first_goal), solve(second, second_goal)),
        BudgetResult::Error(_) => Answer::Overflow,
        _ => Answer::Overflow,
    }
}

// This fold is deliberately expressed through the same combination boundary
// as two candidates.  It is the bounded bootstrap form of the tabled
// worklist: adding an irrelevant candidate cannot erase ambiguity, while a
// contradictory negative candidate cannot be hidden behind it.
pub fn solve_three(
    first: Implementation,
    first_goal: Goal,
    second: Implementation,
    second_goal: Goal,
    third: Implementation,
    third_goal: Goal,
) -> Answer {
    combine_answers(
        combine_answers(solve(first, first_goal), solve(second, second_goal)),
        solve(third, third_goal),
    )
}

fn combine_answers(first: Answer, second: Answer) -> Answer {
    handle (first, second) {
        (Answer::Ambiguous, Answer::Refuted(_)) => Answer::Unsatisfied,
        (Answer::Refuted(_), Answer::Ambiguous) => Answer::Unsatisfied,
        (Answer::Ambiguous, _) => Answer::Ambiguous,
        (_, Answer::Ambiguous) => Answer::Ambiguous,
        (Answer::Satisfied(_), Answer::Refuted(_)) => Answer::Unsatisfied,
        (Answer::Refuted(_), Answer::Satisfied(_)) => Answer::Unsatisfied,
        (Answer::Satisfied(first_evidence), Answer::Satisfied(second_evidence)) => combine_satisfied(first_evidence, second_evidence),
        (Answer::Refuted(first_evidence), Answer::Refuted(second_evidence)) => Answer::Refuted(first_evidence),
        (Answer::Satisfied(first_evidence), _) => Answer::Satisfied(first_evidence),
        (_, Answer::Satisfied(second_evidence)) => Answer::Satisfied(second_evidence),
        (Answer::Refuted(first_evidence), _) => Answer::Refuted(first_evidence),
        (_, Answer::Refuted(second_evidence)) => Answer::Refuted(second_evidence),
        _ => Answer::Unsatisfied,
    }
}

fn combine_satisfied(first_evidence: i64, second_evidence: i64) -> Answer {
    branch_bool(
        first_evidence == second_evidence,
        () -> Answer { Answer::Satisfied(first_evidence) },
        () -> Answer { Answer::Ambiguous },
    )
}

fn solve_same_trait_parts(
    evidence: i64,
    candidate_type: Type,
    polarity: ImplementationPolarity,
    generic_self: Bool,
    requested_type: Type,
) -> Answer {
    handle generic_self {
        true => answer_for_polarity(polarity, evidence),
        false => solve_exact_self_type(evidence, candidate_type, polarity, requested_type),
        _ => Answer::Unsatisfied,
    }
}

fn solve_exact_self_type(evidence: i64, candidate_type: Type, polarity: ImplementationPolarity, requested_type: Type) -> Answer {
    handle same(candidate_type, requested_type) {
        true => answer_for_polarity(polarity, evidence),
        false => Answer::Unsatisfied,
        _ => Answer::Unsatisfied,
    }
}

fn answer_for_polarity(polarity: ImplementationPolarity, evidence: i64) -> Answer {
    handle polarity {
        ImplementationPolarity::Positive => Answer::Satisfied(evidence),
        ImplementationPolarity::Negative => Answer::Refuted(evidence),
        _ => Answer::Unsatisfied,
    }
}
