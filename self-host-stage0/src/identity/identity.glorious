// M03 scaffold. `compiler_support::__g1_blake3` has authority only because
// the canonical source world binds its exact declaration through the runtime
// manifest; this wrapper name has no intrinsic authority.
use compiler_support::__g1_blake3;
use compiler_support::__g1_bytes_get;
use compiler_support::__g1_bytes_len;
use compiler_support::__g1_bytes_concat;
use compiler_support::__g1_bytes_from_array_move;
use compiler_support::__g1_int_shr;
use compiler_support::__g1_int_convert_wrapping_to_u8;
use compiler_support::__g1_int_convert_wrapping_to_u64;
use compiler_support::__g1_int_wrapping_add;
use compiler_support::__g1_text_as_bytes;
use compiler_support::branch_bool;
use compiler_support::text_eq;

pub struct Digest {
    bytes: Bytes,
}

// Digest values arriving through a binary/cache boundary must retain Rust
// Stage0's fixed `[u8; 32]` contract. Hashing arbitrary source bytes remains
// valid, but reconstruction is deliberately fallible so truncated or padded
// fingerprints cannot enter file, definition, or cache identities.
pub enum DigestAdmission {
    Value(Digest),
    Invalid,
}

// A file identity is distinct from a content digest even though both use the
// same fixed-width wire representation.  Keeping this wrapper prevents a
// caller from attaching bytes' content hash where Stage0 requires the owning
// package/path identity.
pub struct FileKey {
    digest: Digest,
}

// Package spelling is logical compiler identity, never a host path.  This
// wrapper keeps it separate from arbitrary text before module/file keys are
// constructed.
pub struct PackageKey {
    text: Text,
}

// Definition identity is semantic and stable under unrelated body edits. It
// is intentionally not a source span or a host allocation identity.
pub struct DefKey {
    digest: Digest,
}

// A module is identified by the manifest package and its logical path.  This
// deliberately carries no checkout path, file descriptor, or arena ordinal.
pub struct ModuleKey {
    package: PackageKey,
    path: Text,
}

pub fn module_key(package: Text, path: Text) -> ModuleKey {
    ModuleKey { package: package_key(package), path: path }
}

pub fn package_key(text: Text) -> PackageKey { PackageKey { text: text } }

pub fn package_text(key: PackageKey) -> Text { key.text }

pub fn file_key(package: Text, logical_path: Text) -> FileKey {
    FileKey { digest: digest_of_parts2(__g1_text_as_bytes(package), __g1_text_as_bytes(logical_path)) }
}

pub fn same_file_key(left: FileKey, right: FileKey) -> Bool { equals(left.digest, right.digest) }

pub fn file_key_digest(key: FileKey) -> Digest { key.digest }

pub fn same_package(left: PackageKey, right: PackageKey) -> Bool { text_eq(left.text, right.text) }

// This is the source counterpart of Rust's package_module_alias admission.
// Only the name before `@` participates; hyphens normalize to underscores,
// and the resulting identifier must start with ASCII alpha/underscore and
// otherwise contain only ASCII alphanumeric/underscore characters.
pub fn package_alias_is_valid(key: PackageKey) -> Bool {
    package_alias_first_byte_valid(__g1_text_as_bytes(key.text))
}

fn package_alias_first_byte_valid(bytes: Bytes) -> Bool {
    handle __g1_bytes_len(bytes) == 0 {
        true => false,
        false => package_alias_first_byte_is_identifier_start(bytes, __g1_bytes_get(bytes, 0)),
        _ => false,
    }
}

fn package_alias_first_byte_is_identifier_start(bytes: Bytes, byte: u8) -> Bool {
    handle package_alias_is_identifier_start(byte) {
        true => package_alias_rest_is_valid(bytes, 1),
        false => false,
        _ => false,
    }
}

fn package_alias_rest_is_valid(bytes: Bytes, index: usize) -> Bool {
    handle index == __g1_bytes_len(bytes) {
        true => true,
        false => package_alias_rest_byte_is_valid(bytes, index, __g1_bytes_get(bytes, index)),
        _ => false,
    }
}

fn package_alias_rest_byte_is_valid(bytes: Bytes, index: usize, byte: u8) -> Bool {
    handle byte == 64 {
        true => true,
        false => handle package_alias_is_identifier_continue(byte) {
            true => package_alias_rest_is_valid(bytes, __g1_int_wrapping_add<usize>(index, 1)),
            false => false,
            _ => false,
        },
        _ => false,
    }
}

fn package_alias_is_identifier_start(byte: u8) -> Bool {
    handle byte >= 65 {
        true => handle byte <= 90 {
            true => true,
            false => package_alias_is_lower_or_underscore(byte),
            _ => false,
        },
        false => package_alias_is_lower_or_underscore(byte),
        _ => false,
    }
}

fn package_alias_is_lower_or_underscore(byte: u8) -> Bool {
    handle byte >= 97 {
        true => handle byte <= 122 {
            true => true,
            false => byte == 95,
            _ => false,
        },
        false => byte == 95,
        _ => false,
    }
}

fn package_alias_is_identifier_continue(byte: u8) -> Bool {
    handle package_alias_is_identifier_start(byte) {
        true => true,
        false => package_alias_is_digit_or_hyphen(byte),
        _ => false,
    }
}

fn package_alias_is_digit_or_hyphen(byte: u8) -> Bool {
    handle byte >= 48 {
        true => handle byte <= 57 {
            true => true,
            false => byte == 45,
            _ => false,
        },
        false => byte == 45,
        _ => false,
    }
}

pub fn same_package_module_alias(left: PackageKey, right: PackageKey) -> Bool {
    package_alias_bytes_equal(__g1_text_as_bytes(left.text), __g1_text_as_bytes(right.text), 0)
}

fn package_alias_bytes_equal(left: Bytes, right: Bytes, index: usize) -> Bool {
    let left_end = package_alias_at_end(left, index);
    let right_end = package_alias_at_end(right, index);
    handle left_end {
        true => right_end,
        false => handle right_end {
            true => false,
            false => handle package_alias_normalize(__g1_bytes_get(left, index)) == package_alias_normalize(__g1_bytes_get(right, index)) {
                true => package_alias_bytes_equal(left, right, __g1_int_wrapping_add<usize>(index, 1)),
                false => false,
                _ => false,
            },
            _ => false,
        },
        _ => false,
    }
}

fn package_alias_at_end(bytes: Bytes, index: usize) -> Bool {
    handle index == __g1_bytes_len(bytes) {
        true => true,
        false => __g1_bytes_get(bytes, index) == 64,
        _ => true,
    }
}

fn package_alias_normalize(byte: u8) -> u8 {
    handle byte == 45 { true => 95, false => byte, _ => byte }
}

pub fn same_module(left: ModuleKey, right: ModuleKey) -> Bool {
    branch_bool(
        same_package(left.package, right.package),
        () -> Bool { text_eq(left.path, right.path) },
        () -> Bool { false },
    )
}

pub fn digest_of_bytes(bytes: Bytes) -> Digest {
    Digest { bytes: __g1_blake3(bytes) }
}

pub fn digest_from_bytes(bytes: Bytes) -> DigestAdmission {
    handle __g1_bytes_len(bytes) == 32 {
        true => DigestAdmission::Value(Digest { bytes: bytes }),
        false => DigestAdmission::Invalid,
        _ => DigestAdmission::Invalid,
    }
}

pub fn digest_bytes(digest: Digest) -> Bytes { digest.bytes }

pub fn digest_of_text(text: Text) -> Digest {
    digest_of_bytes(__g1_text_as_bytes(text))
}

// Source-owned byte composition keeps compound identities out of the host.
// It is deliberately separate from Rust's length-framed `Digest::of_parts`:
// callers that need that wire format will encode the lengths explicitly.
pub fn digest_of_concatenated_bytes(left: Bytes, right: Bytes) -> Digest {
    digest_of_bytes(__g1_bytes_concat(left, right))
}

// Rust stage0's stable semantic keys frame every digest component with a
// little-endian u64 length. Preserve that boundary in source: `a|bc` and
// `ab|c` must never alias merely because their raw concatenation is equal.
// The two-part primitive is the allocation-free kernel for package/path and
// owner/name identities; larger products compose it only through explicit
// framing rather than a host-side hasher.
pub fn digest_of_parts2(left: Bytes, right: Bytes) -> Digest {
    digest_of_bytes(
        __g1_bytes_concat(
            __g1_bytes_concat(u64_le_bytes(__g1_int_convert_wrapping_to_u64<usize>(__g1_bytes_len(left))), left),
            __g1_bytes_concat(u64_le_bytes(__g1_int_convert_wrapping_to_u64<usize>(__g1_bytes_len(right))), right),
        )
    )
}

pub fn digest_of_parts3(first: Bytes, second: Bytes, third: Bytes) -> Digest {
    digest_of_bytes(
        __g1_bytes_concat(
            __g1_bytes_concat(
                __g1_bytes_concat(u64_le_bytes(__g1_int_convert_wrapping_to_u64<usize>(__g1_bytes_len(first))), first),
                __g1_bytes_concat(u64_le_bytes(__g1_int_convert_wrapping_to_u64<usize>(__g1_bytes_len(second))), second),
            ),
            __g1_bytes_concat(u64_le_bytes(__g1_int_convert_wrapping_to_u64<usize>(__g1_bytes_len(third))), third),
        )
    )
}

// Higher-level immutable identities compose digest components through the
// same length-framed form as raw byte parts. This preserves component
// boundaries (rather than hashing a potentially ambiguous concatenation)
// without exposing digest representation outside this module.
pub fn digest_of_digests2(left: Digest, right: Digest) -> Digest {
    digest_of_parts2(left.bytes, right.bytes)
}

pub fn def_key_from_digest(digest: Digest) -> DefKey { DefKey { digest: digest } }

pub fn same_def_key(left: DefKey, right: DefKey) -> Bool { equals(left.digest, right.digest) }

// Keep the Rust stage0 domain string and three length-framed components
// exactly: domain, owning implementation digest, and method name.
pub fn implementation_method_key(implementation: DefKey, name: Text) -> DefKey {
    DefKey {
        digest: digest_of_parts3(
            __g1_text_as_bytes("grandiose-stage0-implementation-method-v1"),
            implementation.digest.bytes,
            __g1_text_as_bytes(name),
        )
    }
}

// A minimal source-owned binary constructor used by the upcoming canonical
// wire encoder. The array transfers ownership into Bytes exactly once.
pub fn byte_pair(first: u8, second: u8) -> Bytes {
    __g1_bytes_from_array_move([first, second])
}

pub fn digest_of_byte_pair(first: u8, second: u8) -> Digest {
    digest_of_bytes(byte_pair(first, second))
}

// The G1 container uses fixed-width little-endian scalar fields. Keep the
// conversion here so all later section encoders use one canonical source
// implementation instead of host-side integer serialization.
pub fn u32_le_bytes(value: u32) -> Bytes {
    __g1_bytes_from_array_move([
        __g1_int_convert_wrapping_to_u8<u32>(value),
        __g1_int_convert_wrapping_to_u8<u32>(__g1_int_shr<u32>(value, 8)),
        __g1_int_convert_wrapping_to_u8<u32>(__g1_int_shr<u32>(value, 16)),
        __g1_int_convert_wrapping_to_u8<u32>(__g1_int_shr<u32>(value, 24)),
    ])
}

pub fn u16_le_bytes(value: u16) -> Bytes {
    __g1_bytes_from_array_move([
        __g1_int_convert_wrapping_to_u8<u16>(value),
        __g1_int_convert_wrapping_to_u8<u16>(__g1_int_shr<u16>(value, 8)),
    ])
}

// Bootstrap commitments and selected container fields are u64. Encode them
// directly rather than narrowing through a host integer representation.
pub fn u64_le_bytes(value: u64) -> Bytes {
    __g1_bytes_from_array_move([
        __g1_int_convert_wrapping_to_u8<u64>(value),
        __g1_int_convert_wrapping_to_u8<u64>(__g1_int_shr<u64>(value, 8)),
        __g1_int_convert_wrapping_to_u8<u64>(__g1_int_shr<u64>(value, 16)),
        __g1_int_convert_wrapping_to_u8<u64>(__g1_int_shr<u64>(value, 24)),
        __g1_int_convert_wrapping_to_u8<u64>(__g1_int_shr<u64>(value, 32)),
        __g1_int_convert_wrapping_to_u8<u64>(__g1_int_shr<u64>(value, 40)),
        __g1_int_convert_wrapping_to_u8<u64>(__g1_int_shr<u64>(value, 48)),
        __g1_int_convert_wrapping_to_u8<u64>(__g1_int_shr<u64>(value, 56)),
    ])
}

pub fn first_byte(digest: Digest) -> u8 {
    __g1_bytes_get(digest.bytes, 0)
}

// Digest identity is exact bytes, never a prefix or a formatted text value.
// The comparison is bounded once by the manifest-produced buffer length and
// then walks it directly, avoiding both allocation and a host equality path.
pub fn equals(left: Digest, right: Digest) -> Bool {
    let length = __g1_bytes_len(left.bytes);
    handle length == __g1_bytes_len(right.bytes) {
        true => equal_bytes(left.bytes, right.bytes, 0, length),
        false => false,
        _ => false,
    }
}

// Canonical source worlds sort fixed-width digest commitments without using a
// host string/path comparator. This lexicographic byte order is stable across
// hosts and lets callers normalize a set of distinct immutable identities.
pub fn less_than(left: Digest, right: Digest) -> Bool {
    less_than_bytes(left.bytes, right.bytes, 0, __g1_bytes_len(left.bytes))
}

fn less_than_bytes(left: Bytes, right: Bytes, index: usize, length: usize) -> Bool {
    handle index == length {
        true => false,
        false => less_than_at(left, right, index, length),
        _ => false,
    }
}

fn less_than_at(left: Bytes, right: Bytes, index: usize, length: usize) -> Bool {
    let left_byte = __g1_bytes_get(left, index);
    let right_byte = __g1_bytes_get(right, index);
    handle left_byte == right_byte {
        true => less_than_bytes(left, right, __g1_int_wrapping_add<usize>(index, 1), length),
        false => left_byte < right_byte,
        _ => false,
    }
}

fn equal_bytes(left: Bytes, right: Bytes, index: usize, length: usize) -> Bool {
    handle index == length {
        true => true,
        false => equal_bytes_at(left, right, index, length),
        _ => false,
    }
}

fn equal_bytes_at(left: Bytes, right: Bytes, index: usize, length: usize) -> Bool {
    handle __g1_bytes_get(left, index) == __g1_bytes_get(right, index) {
        true => equal_bytes(left, right, __g1_int_wrapping_add<usize>(index, 1), length),
        false => false,
        _ => false,
    }
}
