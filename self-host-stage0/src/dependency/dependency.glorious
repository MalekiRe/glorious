// M30 scaffold: the value-validation kernel for revision-owned dependency
// facts. Canonical edge storage, traversal, cycle traces, and transactions
// are deliberately deferred to the shared collection/worklist substrate.
use compiler_support::branch_bool;
use bootstrap_indirection::TextSequence;
use bootstrap_indirection::text_empty;
use bootstrap_indirection::text_insert_unique;
use bootstrap_indirection::text_length;
use bootstrap_indirection::text_contains;
use bootstrap_indirection::text_rank;
use bootstrap_indirection::text_insert_sorted_unique;
use revision::Snapshot;
use revision::same;
use revision::is_active;

pub enum DependencyNode {
    Input,
    Interface,
    Fixity,
    Body,
    Core,
    Instance,
    Mir,
    Artifact,
}

pub enum DependencyStatus {
    Cold,
    Green,
    Red(DependencyNode),
    // These are structural validation outcomes, not ordinary cache misses.
    // They must fail closed before a parent fingerprint is considered.
    Cycle(DependencyNode),
    Incomplete(DependencyNode),
}

// Query publication consumes this normalized decision rather than repeating
// the cold/green/red match at each call site. Only a green dependency may
// reuse a prior value; red and cold inputs must recompute.
pub enum ReuseDecision { Reuse, Recompute }

// The full ledger later uses typed stable identities and revision-owned
// transactions. This compact journal already establishes its essential
// deterministic rule: a repeated dependency is represented once, in first
// observation order, rather than as an ambient invalidation edge.
pub struct DependencyJournal {
    nodes: TextSequence,
}

// A dependency record belongs to exactly the immutable source world that
// observed it. This prevents a stale request or sibling revision from adding
// an edge that a later query might mistake for reusable evidence.
pub struct RevisionJournal { snapshot: Snapshot, journal: DependencyJournal }
pub enum JournalPublication { Value(RevisionJournal), CrossRevision, Inactive }

pub fn journal() -> DependencyJournal {
    DependencyJournal { nodes: text_empty() }
}

pub fn revision_journal(snapshot: Snapshot) -> RevisionJournal {
    RevisionJournal { snapshot: snapshot, journal: journal() }
}

pub fn record_at(value: RevisionJournal, target: Snapshot, node: Text) -> JournalPublication {
    handle is_active(target) {
        true => record_active(value, target, node),
        false => JournalPublication::Inactive,
        _ => JournalPublication::Inactive,
    }
}

fn record_active(value: RevisionJournal, target: Snapshot, node: Text) -> JournalPublication {
    handle same(value.snapshot, target) {
        true => JournalPublication::Value(RevisionJournal { snapshot: value.snapshot, journal: record(value.journal, node) }),
        false => JournalPublication::CrossRevision,
        _ => JournalPublication::CrossRevision,
    }
}

pub fn revision_recorded_count(value: RevisionJournal) -> i64 {
    recorded_count(value.journal)
}

pub fn record(journal: DependencyJournal, node: Text) -> DependencyJournal {
    DependencyJournal { nodes: text_insert_sorted_unique(journal.nodes, node) }
}

pub fn recorded_count(journal: DependencyJournal) -> i64 {
    text_length(journal.nodes)
}

pub fn recorded(journal: DependencyJournal, node: Text) -> Bool {
    text_contains(journal.nodes, node)
}

pub fn recorded_rank(journal: DependencyJournal, node: Text) -> i64 {
    text_rank(journal.nodes, node)
}

fn validate_retained(fingerprint_matches: Bool, changed: DependencyNode) -> DependencyStatus {
    branch_bool(
        fingerprint_matches,
        () -> DependencyStatus { DependencyStatus::Green },
        () -> DependencyStatus { DependencyStatus::Red(changed) },
    )
}

pub fn validate_value(parent_retained: Bool, fingerprint_matches: Bool, changed: DependencyNode) -> DependencyStatus {
    branch_bool(
        parent_retained,
        () -> DependencyStatus { validate_retained(fingerprint_matches, changed) },
        () -> DependencyStatus { DependencyStatus::Cold },
    )
}

// This is the value-validation rule used by the full ledger walk. A changed
// dependency makes the product eligible for checking, but does not make an
// independently recomputed equal product red. Structural failures are the
// exception: incomplete staging wins over cycles, and both fail closed.
pub fn validate_with_dependency(parent_retained: Bool, fingerprint_matches: Bool, dependency: DependencyStatus, changed: DependencyNode) -> DependencyStatus {
    handle dependency {
        DependencyStatus::Incomplete(missing) => DependencyStatus::Incomplete(missing),
        DependencyStatus::Cycle(member) => DependencyStatus::Cycle(member),
        DependencyStatus::Cold => validate_value(parent_retained, fingerprint_matches, changed),
        DependencyStatus::Green => validate_value(parent_retained, fingerprint_matches, changed),
        DependencyStatus::Red(_) => validate_value(parent_retained, fingerprint_matches, changed),
        _ => DependencyStatus::Incomplete(changed),
    }
}

pub fn is_cycle(status: DependencyStatus) -> Bool {
    handle status { DependencyStatus::Cycle(_) => true, _ => false }
}

pub fn is_incomplete(status: DependencyStatus) -> Bool {
    handle status { DependencyStatus::Incomplete(_) => true, _ => false }
}

pub fn reuse_decision(status: DependencyStatus) -> ReuseDecision {
    handle status {
        DependencyStatus::Green => ReuseDecision::Reuse,
        DependencyStatus::Cold => ReuseDecision::Recompute,
        DependencyStatus::Red(_) => ReuseDecision::Recompute,
        DependencyStatus::Cycle(_) => ReuseDecision::Recompute,
        DependencyStatus::Incomplete(_) => ReuseDecision::Recompute,
        _ => ReuseDecision::Recompute,
    }
}
