// M36 scaffold: source-owned CLI command selection. The outer Rust launcher
// remains capability adaptation only; argv decoding, request construction,
// diagnostic formatting, and output policy grow here with the effect profile.
use compiler_support::text_eq;
use compiler_support::__g1_array_len;
use compiler_support::__g1_array_pop_move;
use compiler_support::__g1_array_get_move;
use compiler_support::__g1_int_wrapping_add;
use compiler_support::process_args_get;
pub enum Command {
    Check,
    Run,
    RunVm,
    EmitVm,
    EmitBootstrapVm,
    VerifyVm,
    VerifyBootstrap,
    Unknown,
}
pub enum CommandResult { Accepted, Rejected }
pub enum ArgvCommand { Value(Command), Empty }
pub enum EmitVmArguments { Value(Text, Text), Invalid }
pub enum EmitVmRequest { Value(Text, Text, Text), Invalid }
pub enum CheckRequest { Value(Text, Text), Invalid }
pub enum RunRequest { Value(Text, Text), Invalid }
// The request records the artifact and first guest index. Its caller retains
// the original argv payload and can therefore pass only the suffix after
// `--` to the guest; launcher options before the separator cannot leak.
pub enum RunVmRequest { Value(Text, usize), Invalid }
pub enum GuestArgument { Value(Text), Missing }
pub enum VerifyVmRequest { Value(Text, Text), Invalid }

// This is the source-owned positional part of the command adapter.  Paths
// remain host capabilities, but the required shape of each request is compiler
// policy and must therefore be validated before a host attempts any read or
// write.  Keeping every failure category distinct preserves the stage0 CLI's
// diagnostic boundary for a self-hosted entrypoint.
pub enum InvocationResult {
    Accepted,
    Rejected,
    MissingSource,
    MissingOutput,
    MissingManifest,
    MissingVerificationInput,
    ExtraArguments,
}

// Command-line policy belongs to the self-hosted compiler even while the
// seed launcher still transports argv and performs host I/O.  The value count
// is deliberately explicit so a later source-owned argv cursor cannot accept
// a dangling or partially specified option.
pub enum Flag {
    Diagnostics,
    Capability,
    RuntimeHost,
    RootPackage,
    Source,
    RuntimeStandardLibrary,
    RuntimeLeaf,
    Help,
    Unknown,
}
pub enum FlagResult { Accepted, MissingValue, UnknownFlag }
pub enum DiagnosticFormat { Text, Json }
pub enum DiagnosticFormatResult { Value(DiagnosticFormat), MissingValue, InvalidValue }
pub enum OptionMultiplicity { Accepted, Duplicate }

// Keep command spelling in source. The outer launcher supplies argument text
// only; it does not select compiler behavior on behalf of this module.
pub fn parse(command: Text) -> Command {
    handle text_eq(command, "check") {
        true => Command::Check,
        false => parse_run(command),
        _ => Command::Unknown,
    }
}

fn parse_run(command: Text) -> Command {
    handle text_eq(command, "run") {
        true => Command::Run,
        false => parse_run_vm(command),
        _ => Command::Unknown,
    }
}

fn parse_run_vm(command: Text) -> Command {
    handle text_eq(command, "run-vm") {
        true => Command::RunVm,
        false => parse_emit_vm(command),
        _ => Command::Unknown,
    }
}

fn parse_emit_vm(command: Text) -> Command {
    handle text_eq(command, "emit-vm") {
        true => Command::EmitVm,
        false => parse_emit_bootstrap_vm(command),
        _ => Command::Unknown,
    }
}

fn parse_emit_bootstrap_vm(command: Text) -> Command {
    handle text_eq(command, "emit-bootstrap-vm") {
        true => Command::EmitBootstrapVm,
        false => parse_verify_vm(command),
        _ => Command::Unknown,
    }
}

fn parse_verify_vm(command: Text) -> Command {
    handle text_eq(command, "verify-vm") {
        true => Command::VerifyVm,
        false => parse_verify_bootstrap(command),
        _ => Command::Unknown,
    }
}

fn parse_verify_bootstrap(command: Text) -> Command {
    handle text_eq(command, "verify-bootstrap") {
        true => Command::VerifyBootstrap,
        false => Command::Unknown,
        _ => Command::Unknown,
    }
}

pub fn select(command: Command) -> CommandResult {
    handle command {
        Command::Check => CommandResult::Accepted,
        Command::Run => CommandResult::Accepted,
        Command::RunVm => CommandResult::Accepted,
        Command::EmitVm => CommandResult::Accepted,
        Command::EmitBootstrapVm => CommandResult::Accepted,
        Command::VerifyVm => CommandResult::Accepted,
        Command::VerifyBootstrap => CommandResult::Accepted,
        Command::Unknown => CommandResult::Rejected,
        _ => CommandResult::Rejected,
    }
}

pub fn validate_invocation(command: Command, positional_count: i64) -> InvocationResult {
    handle command {
        Command::Check => validate_source_only(positional_count),
        Command::Run => validate_source_only(positional_count),
        Command::RunVm => validate_run_vm(positional_count),
        Command::EmitVm => validate_emit_vm(positional_count),
        Command::EmitBootstrapVm => validate_emit_bootstrap_vm(positional_count),
        Command::VerifyVm => validate_verify_vm(positional_count),
        Command::VerifyBootstrap => validate_verify_bootstrap(positional_count),
        Command::Unknown => InvocationResult::Rejected,
        _ => InvocationResult::Rejected,
    }
}

fn validate_run_vm(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 0,
        () -> InvocationResult { InvocationResult::MissingVerificationInput },
        () -> InvocationResult { InvocationResult::Accepted })
}

fn validate_source_only(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 0,
        () -> InvocationResult { InvocationResult::MissingSource },
        () -> InvocationResult { validate_exactly_one(positional_count) })
}

fn validate_exactly_one(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 1,
        () -> InvocationResult { InvocationResult::Accepted },
        () -> InvocationResult { InvocationResult::ExtraArguments })
}

fn validate_emit_vm(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 0,
        () -> InvocationResult { InvocationResult::MissingSource },
        () -> InvocationResult { validate_emit_vm_output(positional_count) })
}

fn validate_emit_vm_output(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 1,
        () -> InvocationResult { InvocationResult::MissingOutput },
        () -> InvocationResult { validate_exactly_two(positional_count) })
}

fn validate_exactly_two(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 2,
        () -> InvocationResult { InvocationResult::Accepted },
        () -> InvocationResult { InvocationResult::ExtraArguments })
}

fn validate_emit_bootstrap_vm(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 0,
        () -> InvocationResult { InvocationResult::MissingSource },
        () -> InvocationResult { validate_bootstrap_output(positional_count) })
}

fn validate_bootstrap_output(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 1,
        () -> InvocationResult { InvocationResult::MissingOutput },
        () -> InvocationResult { validate_bootstrap_manifest(positional_count) })
}

fn validate_bootstrap_manifest(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 2,
        () -> InvocationResult { InvocationResult::MissingManifest },
        () -> InvocationResult { validate_exactly_three(positional_count) })
}

fn validate_exactly_three(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 3,
        () -> InvocationResult { InvocationResult::Accepted },
        () -> InvocationResult { InvocationResult::ExtraArguments })
}

fn validate_verify_vm(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 0,
        () -> InvocationResult { InvocationResult::MissingVerificationInput },
        () -> InvocationResult { validate_exactly_one(positional_count) })
}

fn validate_verify_bootstrap(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count < 4,
        () -> InvocationResult { InvocationResult::MissingVerificationInput },
        () -> InvocationResult { validate_exactly_four(positional_count) })
}

fn validate_exactly_four(positional_count: i64) -> InvocationResult {
    compiler_support::branch_bool(positional_count == 4,
        () -> InvocationResult { InvocationResult::Accepted },
        () -> InvocationResult { InvocationResult::ExtraArguments })
}

pub fn parse_flag(flag: Text) -> Flag {
    handle text_eq(flag, "--diagnostics") {
        true => Flag::Diagnostics,
        false => parse_capability_flag(flag),
        _ => Flag::Unknown,
    }
}

fn parse_capability_flag(flag: Text) -> Flag {
    handle text_eq(flag, "--capability") {
        true => Flag::Capability,
        false => parse_runtime_host_flag(flag),
        _ => Flag::Unknown,
    }
}

fn parse_runtime_host_flag(flag: Text) -> Flag {
    handle text_eq(flag, "--runtime-host") {
        true => Flag::RuntimeHost,
        false => parse_root_package_flag(flag),
        _ => Flag::Unknown,
    }
}

fn parse_root_package_flag(flag: Text) -> Flag {
    handle text_eq(flag, "--root-package") {
        true => Flag::RootPackage,
        false => parse_source_flag(flag),
        _ => Flag::Unknown,
    }
}

fn parse_source_flag(flag: Text) -> Flag {
    handle text_eq(flag, "--source") {
        true => Flag::Source,
        false => parse_runtime_library_flag(flag),
        _ => Flag::Unknown,
    }
}

fn parse_runtime_library_flag(flag: Text) -> Flag {
    handle text_eq(flag, "--runtime-standard-library") {
        true => Flag::RuntimeStandardLibrary,
        false => parse_runtime_leaf_flag(flag),
        _ => Flag::Unknown,
    }
}

fn parse_runtime_leaf_flag(flag: Text) -> Flag {
    handle text_eq(flag, "--runtime-leaf") {
        true => Flag::RuntimeLeaf,
        false => parse_help_flag(flag),
        _ => Flag::Unknown,
    }
}

fn parse_help_flag(flag: Text) -> Flag {
    handle text_eq(flag, "--help") {
        true => Flag::Help,
        false => Flag::Unknown,
        _ => Flag::Unknown,
    }
}

pub fn value_count(flag: Flag) -> i64 {
    handle flag {
        Flag::Diagnostics => 1,
        Flag::Capability => 1,
        Flag::RuntimeHost => 4,
        Flag::RootPackage => 1,
        Flag::Source => 3,
        Flag::RuntimeStandardLibrary => 1,
        Flag::RuntimeLeaf => 3,
        Flag::Help => 0,
        Flag::Unknown => 0,
        _ => 0,
    }
}

// Keep malformed options distinct from options with missing trailing values.
// The command adapter can then retain a stable diagnostic category without
// guessing from a zero arity (which is also valid for `--help`).
pub fn validate_flag(flag: Flag, supplied_values: i64) -> FlagResult {
    handle flag {
        Flag::Unknown => FlagResult::UnknownFlag,
        Flag::Diagnostics => require_values(1, supplied_values),
        Flag::Capability => require_values(1, supplied_values),
        Flag::RuntimeHost => require_values(4, supplied_values),
        Flag::RootPackage => require_values(1, supplied_values),
        Flag::Source => require_values(3, supplied_values),
        Flag::RuntimeStandardLibrary => require_values(1, supplied_values),
        Flag::RuntimeLeaf => require_values(3, supplied_values),
        Flag::Help => require_values(0, supplied_values),
        _ => FlagResult::UnknownFlag,
    }
}

// Diagnostic rendering is source policy. The host carries text only after the
// compiler has selected this closed format vocabulary.
pub fn parse_diagnostic_format(value: Text) -> DiagnosticFormatResult {
    handle text_eq(value, "text") {
        true => DiagnosticFormatResult::Value(DiagnosticFormat::Text),
        false => parse_json_diagnostic_format(value),
        _ => DiagnosticFormatResult::InvalidValue,
    }
}

fn parse_json_diagnostic_format(value: Text) -> DiagnosticFormatResult {
    handle text_eq(value, "json") {
        true => DiagnosticFormatResult::Value(DiagnosticFormat::Json),
        false => DiagnosticFormatResult::InvalidValue,
        _ => DiagnosticFormatResult::InvalidValue,
    }
}

pub fn validate_diagnostic_format(supplied_values: i64, value: Text) -> DiagnosticFormatResult {
    compiler_support::branch_bool(supplied_values == 0,
        () -> DiagnosticFormatResult { DiagnosticFormatResult::MissingValue },
        () -> DiagnosticFormatResult { parse_diagnostic_format(value) })
}

// Diagnostics, runtime standard library, and root package are unique options;
// repeatable capabilities and source declarations bypass this check.
pub fn validate_unique_occurrences(occurrences: i64) -> OptionMultiplicity {
    compiler_support::branch_bool(occurrences <= 1,
        () -> OptionMultiplicity { OptionMultiplicity::Accepted },
        () -> OptionMultiplicity { OptionMultiplicity::Duplicate })
}

fn require_values(required: i64, supplied: i64) -> FlagResult {
    compiler_support::branch_bool(supplied < required,
        () -> FlagResult { FlagResult::MissingValue },
        () -> FlagResult { FlagResult::Accepted })
}
pub fn default_exit() -> i64 { 0 }

// A source-owned argv cursor begins with a bounded, non-consuming length
// query. Parsing consumes only after this check establishes availability.
pub fn argv_count(values: &Array<Text>) -> usize { __g1_array_len<Text>(values) }

// The bootstrap argv cursor deliberately checks availability before its
// ownership-consuming pop.  More complete option grouping extends this
// cursor, but no source CLI path may pop an empty process argument array.
pub fn parse_last_argv_command(values: Array<Text>) -> ArgvCommand {
    handle __g1_array_len<Text>(&values) == 0 {
        true => ArgvCommand::Empty,
        false => parse_last_nonempty_argv_command(values),
        _ => ArgvCommand::Empty,
    }
}

// Indexed movement selects the command token in a normal argv layout. The
// array is passed by value, and bounds are checked before the unique move.
pub fn parse_argv_command_at(values: Array<Text>, index: usize) -> ArgvCommand {
    parse_argv_command_at_length(values, index, __g1_array_len<Text>(&values))
}

// The source CLI owns command selection even when argv originates from the
// host. The capability is consumed exactly once at this outer boundary, then
// the ordinary bounded cursor handles index validation and token parsing.
pub fn parse_process_argv_command_at(index: usize) -> ArgvCommand {
    parse_argv_command_at(process_args_get(), index)
}

// `emit-vm` consumes exactly two source-owned positionals after its command
// token.  The extraction is bounded before either affine Text is moved, so a
// malformed argv cannot turn into a partial compiler request.  General flag
// grouping grows from this same cursor without moving CLI policy to Rust.
pub fn parse_argv_emit_vm_at(values: Array<Text>, command_index: usize) -> EmitVmArguments {
    parse_argv_emit_vm_at_length(values, command_index, __g1_array_len<Text>(&values))
}

pub fn parse_process_argv_emit_vm_at(command_index: usize) -> EmitVmArguments {
    parse_argv_emit_vm_at(process_args_get(), command_index)
}

// The public compiler invocation convention is `grc emit-vm SOURCE OUTPUT`.
// Keep this process boundary in source; launchers merely supply the argument
// vector and never select the command or interpret its positionals.
pub fn parse_process_argv_emit_vm() -> EmitVmArguments {
    parse_process_argv_emit_vm_at(1)
}

// The first complete request-shaped command form keeps root package identity
// in source argv policy.  It accepts the normal default package spelling and
// the explicit `--root-package PACKAGE` prefix; broader option collection
// extends this typed request rather than making a host launcher choose one.
pub fn parse_argv_emit_vm_request(values: Array<Text>) -> EmitVmRequest {
    parse_argv_emit_vm_request_length(values, __g1_array_len<Text>(&values))
}

pub fn parse_process_argv_emit_vm_request() -> EmitVmRequest {
    parse_argv_emit_vm_request(process_args_get())
}

// `check` shares the same request identity policy as `emit-vm`, but it has
// one source positional and performs no publication.  Keeping it a separate
// typed result prevents command dispatch from treating a check path as an
// artifact-output path.
pub fn parse_argv_check_request(values: Array<Text>) -> CheckRequest {
    parse_argv_check_request_length(values, __g1_array_len<Text>(&values))
}

pub fn parse_process_argv_check_request() -> CheckRequest {
    parse_argv_check_request(process_args_get())
}

// `run` has the same root/source request shape as `check`, while the service
// selects execution rather than header-only admission.
pub fn parse_argv_run_request(values: Array<Text>) -> RunRequest {
    parse_argv_run_request_length(values, __g1_array_len<Text>(&values))
}

pub fn parse_process_argv_run_request() -> RunRequest {
    parse_argv_run_request(process_args_get())
}

pub fn parse_argv_run_vm_request(values: Array<Text>) -> RunVmRequest {
    parse_argv_run_vm_request_length(values, __g1_array_len<Text>(&values))
}

pub fn parse_process_argv_run_vm_request() -> RunVmRequest { parse_argv_run_vm_request(process_args_get()) }

// Guest payload remains owned by the original argv capability, but the
// separator decision and bounded suffix indexing are source-owned. Checked
// usize addition preserves the normal VM overflow boundary before an array
// access can be formed.
pub fn run_vm_guest_argument(values: Array<Text>, request: RunVmRequest, offset: usize) -> GuestArgument {
    handle request {
        RunVmRequest::Value(_, guest_start) => run_vm_guest_argument_from_start(values, guest_start, offset),
        RunVmRequest::Invalid => GuestArgument::Missing,
        _ => GuestArgument::Missing,
    }
}

fn run_vm_guest_argument_from_start(values: Array<Text>, guest_start: usize, offset: usize) -> GuestArgument {
    let length = __g1_array_len<Text>(&values);
    let index = guest_start + offset;
    handle index < length {
        true => GuestArgument::Value(__g1_array_get_move<Text>(&mut values, index)),
        false => GuestArgument::Missing,
        _ => GuestArgument::Missing,
    }
}

fn parse_argv_run_vm_request_length(values: Array<Text>, length: usize) -> RunVmRequest {
    handle length == 3 {
        true => parse_run_vm_program(values, 3),
        false => handle length > 3 {
            true => parse_run_vm_separator(values),
            false => RunVmRequest::Invalid,
            _ => RunVmRequest::Invalid,
        },
        _ => RunVmRequest::Invalid,
    }
}

fn parse_run_vm_program(values: Array<Text>, guest_start: usize) -> RunVmRequest {
    handle text_eq(__g1_array_get_move<Text>(&mut values, 1), "run-vm") {
        true => RunVmRequest::Value(__g1_array_get_move<Text>(&mut values, 2), guest_start),
        false => RunVmRequest::Invalid,
        _ => RunVmRequest::Invalid,
    }
}

fn parse_run_vm_separator(values: Array<Text>) -> RunVmRequest {
    handle text_eq(__g1_array_get_move<Text>(&mut values, 3), "--") {
        true => parse_run_vm_program(values, 4),
        false => RunVmRequest::Invalid,
        _ => RunVmRequest::Invalid,
    }
}

// The first verifier request uses the same root-package/path identity as the
// existing file-backed commands. Its artifact interpretation remains in the
// backend; argv owns only the bounded request shape.
pub fn parse_argv_verify_vm_request(values: Array<Text>) -> VerifyVmRequest {
    parse_argv_verify_vm_request_length(values, __g1_array_len<Text>(&values))
}

pub fn parse_process_argv_verify_vm_request() -> VerifyVmRequest {
    parse_argv_verify_vm_request(process_args_get())
}

fn parse_argv_run_request_length(values: Array<Text>, length: usize) -> RunRequest {
    handle length == 3 {
        true => parse_default_run_request(values),
        false => handle length == 5 {
            true => parse_root_package_run_request(values),
            false => RunRequest::Invalid,
            _ => RunRequest::Invalid,
        },
        _ => RunRequest::Invalid,
    }
}

fn parse_default_run_request(values: Array<Text>) -> RunRequest {
    handle parse(__g1_array_get_move<Text>(&mut values, 1)) {
        Command::Run => RunRequest::Value("command@0.1.0", __g1_array_get_move<Text>(&mut values, 2)),
        _ => RunRequest::Invalid,
    }
}

fn parse_root_package_run_request(values: Array<Text>) -> RunRequest {
    handle parse_flag(__g1_array_get_move<Text>(&mut values, 1)) {
        Flag::RootPackage => parse_root_package_run_command(values),
        _ => RunRequest::Invalid,
    }
}

fn parse_root_package_run_command(values: Array<Text>) -> RunRequest {
    let package = __g1_array_get_move<Text>(&mut values, 2);
    handle parse(__g1_array_get_move<Text>(&mut values, 3)) {
        Command::Run => RunRequest::Value(package, __g1_array_get_move<Text>(&mut values, 4)),
        _ => RunRequest::Invalid,
    }
}

fn parse_argv_verify_vm_request_length(values: Array<Text>, length: usize) -> VerifyVmRequest {
    handle length == 3 {
        true => parse_default_verify_vm_request(values),
        false => handle length == 5 {
            true => parse_root_package_verify_vm_request(values),
            false => VerifyVmRequest::Invalid,
            _ => VerifyVmRequest::Invalid,
        },
        _ => VerifyVmRequest::Invalid,
    }
}

fn parse_default_verify_vm_request(values: Array<Text>) -> VerifyVmRequest {
    handle parse(__g1_array_get_move<Text>(&mut values, 1)) {
        Command::VerifyVm => VerifyVmRequest::Value("command@0.1.0", __g1_array_get_move<Text>(&mut values, 2)),
        _ => VerifyVmRequest::Invalid,
    }
}

fn parse_root_package_verify_vm_request(values: Array<Text>) -> VerifyVmRequest {
    handle parse_flag(__g1_array_get_move<Text>(&mut values, 1)) {
        Flag::RootPackage => parse_root_package_verify_vm_command(values),
        _ => VerifyVmRequest::Invalid,
    }
}

fn parse_root_package_verify_vm_command(values: Array<Text>) -> VerifyVmRequest {
    let package = __g1_array_get_move<Text>(&mut values, 2);
    handle parse(__g1_array_get_move<Text>(&mut values, 3)) {
        Command::VerifyVm => VerifyVmRequest::Value(package, __g1_array_get_move<Text>(&mut values, 4)),
        _ => VerifyVmRequest::Invalid,
    }
}

fn parse_argv_check_request_length(values: Array<Text>, length: usize) -> CheckRequest {
    handle length == 3 {
        true => parse_default_check_request(values),
        false => handle length == 5 {
            true => parse_root_package_check_request(values),
            false => CheckRequest::Invalid,
            _ => CheckRequest::Invalid,
        },
        _ => CheckRequest::Invalid,
    }
}

fn parse_default_check_request(values: Array<Text>) -> CheckRequest {
    handle parse(__g1_array_get_move<Text>(&mut values, 1)) {
        Command::Check => CheckRequest::Value("command@0.1.0", __g1_array_get_move<Text>(&mut values, 2)),
        _ => CheckRequest::Invalid,
    }
}

fn parse_root_package_check_request(values: Array<Text>) -> CheckRequest {
    handle parse_flag(__g1_array_get_move<Text>(&mut values, 1)) {
        Flag::RootPackage => parse_root_package_check_command(values),
        _ => CheckRequest::Invalid,
    }
}

fn parse_root_package_check_command(values: Array<Text>) -> CheckRequest {
    let package = __g1_array_get_move<Text>(&mut values, 2);
    handle parse(__g1_array_get_move<Text>(&mut values, 3)) {
        Command::Check => CheckRequest::Value(package, __g1_array_get_move<Text>(&mut values, 4)),
        _ => CheckRequest::Invalid,
    }
}

fn parse_argv_emit_vm_request_length(values: Array<Text>, length: usize) -> EmitVmRequest {
    handle length == 4 {
        true => parse_default_emit_vm_request(values),
        false => handle length == 6 {
            true => parse_root_package_emit_vm_request(values),
            false => EmitVmRequest::Invalid,
            _ => EmitVmRequest::Invalid,
        },
        _ => EmitVmRequest::Invalid,
    }
}

fn parse_default_emit_vm_request(values: Array<Text>) -> EmitVmRequest {
    handle parse(__g1_array_get_move<Text>(&mut values, 1)) {
        Command::EmitVm => EmitVmRequest::Value(
            "command@0.1.0",
            __g1_array_get_move<Text>(&mut values, 2),
            __g1_array_get_move<Text>(&mut values, 3),
        ),
        _ => EmitVmRequest::Invalid,
    }
}

fn parse_root_package_emit_vm_request(values: Array<Text>) -> EmitVmRequest {
    handle parse_flag(__g1_array_get_move<Text>(&mut values, 1)) {
        Flag::RootPackage => parse_root_package_emit_vm_command(values),
        _ => EmitVmRequest::Invalid,
    }
}

fn parse_root_package_emit_vm_command(values: Array<Text>) -> EmitVmRequest {
    let package = __g1_array_get_move<Text>(&mut values, 2);
    handle parse(__g1_array_get_move<Text>(&mut values, 3)) {
        Command::EmitVm => EmitVmRequest::Value(
            package,
            __g1_array_get_move<Text>(&mut values, 4),
            __g1_array_get_move<Text>(&mut values, 5),
        ),
        _ => EmitVmRequest::Invalid,
    }
}

fn parse_argv_emit_vm_at_length(values: Array<Text>, command_index: usize, length: usize) -> EmitVmArguments {
    let source_index = argv_next_index(command_index);
    let output_index = argv_next_index(source_index);
    let end_index = argv_next_index(output_index);
    handle end_index == length {
        true => parse_exact_emit_vm_arguments(values, command_index, source_index, output_index),
        false => EmitVmArguments::Invalid,
        _ => EmitVmArguments::Invalid,
    }
}

fn parse_exact_emit_vm_arguments(values: Array<Text>, command_index: usize, source_index: usize, output_index: usize) -> EmitVmArguments {
    handle parse(__g1_array_get_move<Text>(&mut values, command_index)) {
        Command::EmitVm => EmitVmArguments::Value(
            __g1_array_get_move<Text>(&mut values, source_index),
            __g1_array_get_move<Text>(&mut values, output_index),
        ),
        _ => EmitVmArguments::Invalid,
    }
}

fn argv_next_index(index: usize) -> usize { __g1_int_wrapping_add<usize>(index, 1) }

// The ordinary command discovery path is source-owned as well.  It walks the
// supplied argv from the tail, retaining no borrowed array state across the
// recursive step: `pop_move`'s temporary unique borrow ends at the runtime
// leaf boundary before the remaining owned array is passed onward.
pub fn parse_process_argv_command() -> ArgvCommand {
    find_argv_command(process_args_get())
}

fn find_argv_command(values: Array<Text>) -> ArgvCommand {
    handle __g1_array_len<Text>(&values) == 0 {
        true => ArgvCommand::Empty,
        false => find_nonempty_argv_command(values),
        _ => ArgvCommand::Empty,
    }
}

fn find_nonempty_argv_command(values: Array<Text>) -> ArgvCommand {
    let command = parse(__g1_array_pop_move<Text>(&mut values));
    handle command {
        Command::Unknown => find_argv_command(values),
        Command::Check => ArgvCommand::Value(Command::Check),
        Command::Run => ArgvCommand::Value(Command::Run),
        Command::EmitVm => ArgvCommand::Value(Command::EmitVm),
        Command::EmitBootstrapVm => ArgvCommand::Value(Command::EmitBootstrapVm),
        Command::VerifyVm => ArgvCommand::Value(Command::VerifyVm),
        Command::VerifyBootstrap => ArgvCommand::Value(Command::VerifyBootstrap),
        _ => ArgvCommand::Empty,
    }
}

fn parse_argv_command_at_length(values: Array<Text>, index: usize, length: usize) -> ArgvCommand {
    handle index < length {
        true => ArgvCommand::Value(parse(__g1_array_get_move<Text>(&mut values, index))),
        false => ArgvCommand::Empty,
        _ => ArgvCommand::Empty,
    }
}


fn parse_last_nonempty_argv_command(values: Array<Text>) -> ArgvCommand {
    ArgvCommand::Value(parse(__g1_array_pop_move<Text>(&mut values)))
}
