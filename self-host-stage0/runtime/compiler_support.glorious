// These bodies are never interpreted. The runtime manifest seals these exact
// declaration identities after validating their ABIs.
pub fn branch_bool<T>(condition: Bool, on_true: () -> T, on_false: () -> T) -> T {
    let ignored = on_true();
    on_false()
}
