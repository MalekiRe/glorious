pub fn __g1_array_len<T>(value: &Array<T>) -> usize { 0 }
pub fn __g1_array_get_move<T>(value: &mut Array<T>, index: usize) -> T { __g1_array_get_move<T>(value, index) }
pub fn __g1_array_pop_move<T>(value: &mut Array<T>) -> T { __g1_array_pop_move<T>(value) }

// This opaque body is selected only by an explicit runtime-host manifest
// binding. It has no ambient authority when compiled as ordinary source.
pub fn write_file_atomically(path: Text, bytes: Bytes) -> () { () }

// Command-line input is an explicit host capability.  It remains opaque to
// ordinary source execution and is linked only by the exact process_args
// runtime-host declaration carried by a verified artifact.
pub fn process_args_get() -> Array<Text> { [] }

// Source loading is also explicit: the compiler owns logical-path policy,
// while this boundary only transports bytes for an already-authorized path.
pub fn read_file(path: Text) -> Bytes { __g1_text_as_bytes(path) }

// Diagnostic emission is a host effect selected only after the source
// compiler has classified and rendered a diagnostic.
pub fn write_diagnostic(text: Text) -> () { () }

pub fn text_eq(left: Text, right: Text) -> Bool {
    __g1_text_eq(left, right) == 1
}
