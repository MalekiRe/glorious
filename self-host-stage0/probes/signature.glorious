use signature_library::signature;
use signature_library::types;

pub fn score(value: Bool) -> i64 {
    handle value {
        true => 1,
        false => 0,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(signature::accepts_argument(
        signature::callable(types::Type::I64, types::Type::Bool), types::Type::I64))
        + score(signature::accepts_argument(
            signature::callable(types::Type::I64, types::Type::Bool), types::Type::U64))
        + score(signature::result_matches(
            signature::callable(types::Type::I64, types::Type::Bool), types::Type::Bool))
        + score(signature::accepts(
            signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool),
            signature::Arguments::Two(types::Type::I64, types::Type::U8)))
        + score(signature::accepts(
            signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool),
            signature::Arguments::Two(types::Type::I64, types::Type::U64)))
        + score(signature::accepts(
            signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool),
            signature::Arguments::One(types::Type::I64)))
        + score(signature::result_matches(
            signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool), types::Type::Bool))
        + score(signature::same_callable(signature::callable(types::Type::I64, types::Type::Bool), signature::callable(types::Type::I64, types::Type::Bool)))
        + score(signature::same_callable(signature::callable(types::Type::I64, types::Type::Bool), signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool)))
        + score(signature::same_callable(signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool), signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool)))
        + score(signature::same_callable(signature::binary(types::Type::I64, types::Type::U8, types::Type::Bool), signature::binary(types::Type::I64, types::Type::U64, types::Type::Bool)))
        + score(signature::accepts_argument(signature::callable(types::Type::Projection("Item", 2), types::Type::Bool), types::Type::Projection("Item", 2)))
        + score(signature::accepts_argument(signature::callable(types::Type::Projection("Item", 2), types::Type::Bool), types::Type::Projection("Other", 2)))
}
