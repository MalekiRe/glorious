use diagnostic_library::diagnostic;
use diagnostic_library::header;
use diagnostic_library::identity;
use compiler_support::__g1_text_as_bytes;

pub fn score(value: Bool) -> i64 { handle value { true => 1, false => 0, _ => 0 } }
pub fn score_span(value: diagnostic::SpanAdmission) -> i64 { handle value { diagnostic::SpanAdmission::Value(_) => 1, diagnostic::SpanAdmission::Invalid => 0, _ => 0 } }
pub fn source_file() -> identity::FileKey { identity::file_key("diagnostic-probe", "source.glorious") }
pub fn main() -> i64 {
    score(diagnostic::end(header::span(header::header(
        header::HeaderKind::Function,
        diagnostic::span(source_file(), 1, 42),
    ))) == 42)
        + score(diagnostic::start(diagnostic::span(source_file(), 1, 42)) == 1)
        + score_span(diagnostic::checked_span(source_file(), 1, 42))
        + score_span(diagnostic::checked_span(source_file(), 42, 1))
        + score_span(diagnostic::checked_span_in(source_file(), __g1_text_as_bytes("abc"), 1, 3))
        + score_span(diagnostic::checked_span_in(source_file(), __g1_text_as_bytes("abc"), 1, 4))
        + score(diagnostic::is_error(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source")))
        + score(diagnostic::has_code(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), "G4000"))
        + score(diagnostic::has_message(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), "bad source"))
        + score(diagnostic::message(diagnostic::request(diagnostic::code("G1000"), "bad request")) == "bad request")
        + score(diagnostic::has_severity(diagnostic::warning(diagnostic::DiagnosticClass::Source, diagnostic::code("G4001"), diagnostic::span(source_file(), 1, 2), "warning"), diagnostic::Severity::Warning))
        + score(diagnostic::has_primary(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source")))
        + score(diagnostic::has_input(diagnostic::with_input(diagnostic::request(diagnostic::code("G1000"), "bad request"), identity::digest_of_text("world"))))
        + score(diagnostic::has_input_digest(diagnostic::with_input(diagnostic::request(diagnostic::code("G1000"), "bad request"), identity::digest_of_text("world")), identity::digest_of_text("world")))
        + score_not_input(diagnostic::with_input(diagnostic::request(diagnostic::code("G1000"), "bad request"), identity::digest_of_text("world")), identity::digest_of_text("other"))
        + score(diagnostic::has_primary_file(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), source_file()))
        + score(diagnostic::has_primary_span(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), diagnostic::span(source_file(), 1, 2)))
        + score_not_span(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), diagnostic::span(source_file(), 1, 3))
        + score(diagnostic::has_class(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), diagnostic::DiagnosticClass::Source))
        + score(diagnostic::has_primary(diagnostic::request(diagnostic::code("G1000"), "bad request")))
        + score_not_error(diagnostic::warning(diagnostic::DiagnosticClass::Source, diagnostic::code("G4001"), diagnostic::span(source_file(), 1, 2), "warning"))
        + score_not_error(diagnostic::note(diagnostic::DiagnosticClass::Source, diagnostic::code("G4002"), diagnostic::span(source_file(), 1, 2), "note"))
        + score(diagnostic::is_warning(diagnostic::warning(diagnostic::DiagnosticClass::Source, diagnostic::code("G4001"), diagnostic::span(source_file(), 1, 2), "warning")))
        + score(diagnostic::is_note(diagnostic::note(diagnostic::DiagnosticClass::Source, diagnostic::code("G4002"), diagnostic::span(source_file(), 1, 2), "note")))
        + score(diagnostic::same(diagnostic::with_input(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), identity::digest_of_text("world")), diagnostic::with_input(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), identity::digest_of_text("world"))))
        + score_not_same(diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "bad source"), diagnostic::error(diagnostic::DiagnosticClass::Source, diagnostic::code("G4000"), diagnostic::span(source_file(), 1, 2), "other source"))
}

pub fn score_not_error(value: diagnostic::Diagnostic) -> i64 { handle diagnostic::is_error(value) { true => 0, false => 1, _ => 0 } }
pub fn score_not_input(value: diagnostic::Diagnostic, expected: identity::Digest) -> i64 { handle diagnostic::has_input_digest(value, expected) { true => 0, false => 1, _ => 0 } }
pub fn score_not_span(value: diagnostic::Diagnostic, expected: diagnostic::SourceSpan) -> i64 { handle diagnostic::has_primary_span(value, expected) { true => 0, false => 1, _ => 0 } }
pub fn score_not_same(left: diagnostic::Diagnostic, right: diagnostic::Diagnostic) -> i64 { handle diagnostic::same(left, right) { true => 0, false => 1, _ => 0 } }
