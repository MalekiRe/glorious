use compiler_support::__g1_text_as_bytes;
use output_library::output;

pub fn main() -> u8 {
    handle output::write_to(output::stage("publication.grbc", __g1_text_as_bytes("verified bytes")), "publication.grbc") {
        output::WriteResult::Written => 65,
        output::WriteResult::NotStaged => 0,
        output::WriteResult::TargetMismatch => 0,
        _ => 0,
    }
}
