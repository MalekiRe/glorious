use service_library::service;
use service_library::query;
use service_library::revision;
use service_library::output;
use service_library::operation;
use service_library::dependency;
use service_library::artifact_cache;
use service_library::source;
use service_library::identity;
use compiler_support::__g1_text_as_bytes;
pub fn score(value: service::ServiceOutcome) -> i64 { handle value { service::ServiceOutcome::Program => 1, service::ServiceOutcome::Cancelled => 10, service::ServiceOutcome::Diagnostics => 100, service::ServiceOutcome::VerificationFailed => 1000, _ => 0 } }
pub fn score_dispatch(value: service::ServiceDispatch) -> i64 { handle value { service::ServiceDispatch::Reuse => 1, service::ServiceDispatch::Recompute => 10, service::ServiceDispatch::Rejected => 100, _ => 0 } }
pub fn cancellation_dispatch_score() -> i64 {
    score_dispatch(service::dispatch_query_with_cancellation(query::RecoveryPolicy::Allow, complete(revision::root(1)), revision::root(1), dependency::DependencyStatus::Green, operation::active()))
        + score_dispatch(service::dispatch_query_with_cancellation(query::RecoveryPolicy::Allow, complete(revision::root(1)), revision::root(1), dependency::DependencyStatus::Green, operation::cancel(operation::active())))
        + score_dispatch(service::dispatch_query_with_cancellation(query::RecoveryPolicy::Allow, ready(revision::root(1)), revision::root(1), dependency::DependencyStatus::Green, operation::cancel(operation::active())))
}
pub fn ready(snapshot: revision::Snapshot) -> query::QuerySlot { query::begin_at(query::slot(snapshot)) }
pub fn complete(snapshot: revision::Snapshot) -> query::QuerySlot { handle query::publish_at(ready(snapshot), snapshot, query::QueryCompleteness::Complete) { query::QueryPublication::Value(slot) => slot, _ => query::slot(snapshot) } }
pub fn main() -> i64 { score(service::finish(service::ServiceEvent::PublishedVerifiedProgram)) + score(service::finish(service::ServiceEvent::Cancelled)) + score(service::finish(service::ServiceEvent::Diagnostics)) + score(service::finish(service::ServiceEvent::VerificationFailed)) + score_dispatch(service::dispatch_query(query::RecoveryPolicy::Allow, complete(revision::root(1)), revision::root(1))) + score_dispatch(service::dispatch_query(query::RecoveryPolicy::Allow, query::slot(revision::root(1)), revision::root(2))) + score_dispatch(service::dispatch_query(query::RecoveryPolicy::Allow, query::slot(revision::root(1)), revision::apply(revision::root(1), revision::RevisionEvent::Supersede))) + score(service::finish_publication(output::commit(output::stage("artifact", __g1_text_as_bytes("ok"))))) + score(service::finish_publication(output::commit(output::discard(output::stage("artifact", __g1_text_as_bytes("discard")))))) + score(service::finish_operation_publication(operation::publish(operation::stage_publication(__g1_text_as_bytes("artifact")), operation::cancel(operation::active())))) + score_dispatch(service::dispatch_query_with_dependencies(query::RecoveryPolicy::Allow, complete(revision::root(1)), revision::root(1), dependency::DependencyStatus::Green)) + score_dispatch(service::dispatch_query_with_dependencies(query::RecoveryPolicy::Allow, complete(revision::root(1)), revision::root(1), dependency::DependencyStatus::Red(dependency::DependencyNode::Core))) + score_dispatch(service::dispatch_query_with_dependencies(query::RecoveryPolicy::Allow, ready(revision::root(1)), revision::root(1), dependency::DependencyStatus::Green)) + score_dispatch(service::dispatch_cache(artifact_cache::CacheAdmission::Hit)) + score_dispatch(service::dispatch_cache(artifact_cache::CacheAdmission::Miss)) + score_dispatch(service::dispatch_cache(artifact_cache::CacheAdmission::Rejected)) + score(service::finish_cached_keyed_publication(artifact_cache::CacheAdmission::Hit, query::RecoveryPolicy::Allow, complete(revision::root(5)), 0, revision::root(5), dependency::DependencyStatus::Green, output::commit(output::stage("artifact", __g1_text_as_bytes("ok"))))) + score(service::finish_cached_keyed_publication(artifact_cache::CacheAdmission::Hit, query::RecoveryPolicy::Allow, complete(revision::root(5)), 1, revision::root(5), dependency::DependencyStatus::Green, output::commit(output::stage("artifact", __g1_text_as_bytes("must-not-publish"))))) + score(service::finish_cached_keyed_publication(artifact_cache::CacheAdmission::Rejected, query::RecoveryPolicy::Allow, complete(revision::root(5)), 0, revision::root(5), dependency::DependencyStatus::Green, output::commit(output::stage("artifact", __g1_text_as_bytes("must-not-publish"))))) + score(service::admit_source(source::input("service", "valid", __g1_text_as_bytes("value"), identity::digest_of_text("value")))) + score(service::admit_source(source::input("service", "invalid", __g1_text_as_bytes("value"), identity::digest_of_text("other")))) + score(service::compile_source_header(source::input("service", "header", __g1_text_as_bytes("pub fn main"), identity::digest_of_text("pub fn main")))) + score(service::compile_source_header(source::input("service", "missing-name", __g1_text_as_bytes("pub fn"), identity::digest_of_text("pub fn")))) + score(service::compile_source_header(source::input("service", "not-header", __g1_text_as_bytes("value"), identity::digest_of_text("value")))) }
