use runtime_manifest_library::runtime_manifest;
pub fn score(value: Bool) -> i64 { handle value { true => 1, false => 0, _ => 0 } }
pub fn score_validation(value: runtime_manifest::DeclarationValidation) -> i64 { handle value { runtime_manifest::DeclarationValidation::Value(_) => 1, runtime_manifest::DeclarationValidation::UnknownSelector => 10, runtime_manifest::DeclarationValidation::PackageMismatch => 1000, runtime_manifest::DeclarationValidation::SignatureMismatch => 100, _ => 0 } }
pub fn score_host_validation(value: runtime_manifest::HostDeclarationValidation) -> i64 { handle value { runtime_manifest::HostDeclarationValidation::Value(_) => 1, runtime_manifest::HostDeclarationValidation::UnknownSelector => 100, runtime_manifest::HostDeclarationValidation::PackageMismatch => 1000, runtime_manifest::HostDeclarationValidation::SignatureMismatch => 10, _ => 0 } }
pub fn main() -> i64 {
    score(runtime_manifest::admitted(runtime_manifest::Primitive::Blake3))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::ArrayPopMove))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::ArrayLen))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::TextAsBytes))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::BytesLen))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::BytesGet))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::BytesSlice))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::IntWrappingAdd))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::IntWrappingSub))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::IntWrappingMul))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::IntCheckedDiv))
        + score(runtime_manifest::admitted(runtime_manifest::Primitive::Unknown))
        + score(runtime_manifest::admitted_name("blake3"))
        + score(runtime_manifest::admitted_name("array-pop-move"))
        + score(runtime_manifest::admitted_name("blake3-shadow"))
        + score_validation(runtime_manifest::validate_declaration("blake3", runtime_manifest::PrimitiveSignature::BytesToBytes))
        + score_validation(runtime_manifest::validate_declaration("blake3", runtime_manifest::PrimitiveSignature::TextToBytes))
        + score_validation(runtime_manifest::validate_declaration("blake3-shadow", runtime_manifest::PrimitiveSignature::BytesToBytes))
        + score_validation(runtime_manifest::validate_declaration("int-wrapping-add", runtime_manifest::PrimitiveSignature::IntBinary))
        + score_validation(runtime_manifest::validate_declaration("int-wrapping-sub", runtime_manifest::PrimitiveSignature::IntBinary))
        + score_validation(runtime_manifest::validate_bound_declaration("compiler-support@0.1.0", "text-eq", runtime_manifest::PrimitiveSignature::TextTextToBool))
        + score_validation(runtime_manifest::validate_bound_declaration("compiler_support", "text-eq", runtime_manifest::PrimitiveSignature::TextTextToBool))
        + score_validation(runtime_manifest::validate_bound_declaration("user_package", "text-eq", runtime_manifest::PrimitiveSignature::TextTextToBool))
        + score(runtime_manifest::admitted_host(runtime_manifest::HostCapability::ProcessArgs))
        + score(runtime_manifest::admitted_host(runtime_manifest::HostCapability::FileRead))
        + score(runtime_manifest::admitted_host_name("file_write_atomic"))
        + score(runtime_manifest::admitted_host_name("unknown-host"))
        + score_host_validation(runtime_manifest::validate_host_declaration("process_args", runtime_manifest::HostSignature::ProcessArgsToTextArray))
        + score_host_validation(runtime_manifest::validate_bound_host_declaration("compiler-support@0.1.0", "file_read", runtime_manifest::HostSignature::TextToBytes))
        + score_host_validation(runtime_manifest::validate_bound_host_declaration("compiler_support", "file_read", runtime_manifest::HostSignature::TextToBytes))
        + score_host_validation(runtime_manifest::validate_host_declaration("file_write_atomic", runtime_manifest::HostSignature::TextToUnit))
        + score_host_validation(runtime_manifest::validate_host_declaration("unknown-host", runtime_manifest::HostSignature::TextToUnit))
        + score_host_validation(runtime_manifest::validate_bound_host_declaration("user_package", "diagnostic", runtime_manifest::HostSignature::TextToUnit))
}
