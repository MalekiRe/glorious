use service_library::service;
use service_library::vm_backend;

pub fn score(value: service::ServiceOutcome) -> i64 {
    handle value {
        service::ServiceOutcome::Program => 1,
        _ => 0,
    }
}

pub fn entry_score(value: service::ServiceOutcome) -> i64 {
    handle value {
        service::ServiceOutcome::Program => 10,
        _ => 0,
    }
}

pub fn execution_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(number) => number,
        _ => 0,
    }
}

pub fn u32_execution_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::ReturnedU32(42) => 42,
        _ => 0,
    }
}

pub fn artifact_score(value: vm_backend::ArtifactEmission) -> i64 {
    handle value {
        vm_backend::ArtifactEmission::Artifact(_) => 1,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(service::compile_file_header("service-file", "self-host-stage0/probes/service.glorious"))
        + entry_score(service::compile_file_header("stage0-entry", "self-host-stage0/src/main.glorious"))
        + execution_score(service::compile_file_i64_literal("file-literal", "self-host-stage0/probes/file_i64_input.glorious"))
        + execution_score(service::compile_file_i64_function("file-function", "self-host-stage0/probes/file_i64_function.glorious"))
        + u32_execution_score(service::compile_file_u32_function("file-u32-function", "self-host-stage0/probes/file_u32_main.glorious"))
        + u32_execution_score(service::run_file("file-u32-run", "self-host-stage0/probes/file_u32_main.glorious"))
        + artifact_score(service::compile_file_i64_function_arithmetic_entry("file-function-artifact", "self-host-stage0/probes/file_i64_function.glorious"))
        + execution_score(service::compile_file_i64_add_function("file-add", "self-host-stage0/probes/file_i64_add_function.glorious", 20, 22))
        + artifact_score(service::compile_file_i64_binary_function_entry("file-add-artifact", "self-host-stage0/probes/file_i64_add_function.glorious", 20, 22))
        + execution_score(service::compile_file_i64_select_function("file-select", "self-host-stage0/probes/file_i64_select_function.glorious"))
        + artifact_score(service::compile_file_i64_select_function_entry("file-select-artifact", "self-host-stage0/probes/file_i64_select_function.glorious"))
}
