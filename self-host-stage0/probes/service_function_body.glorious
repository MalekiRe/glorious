pub fn score_service_world(value: service::ServiceOutcome) -> i64 {
    handle value { service::ServiceOutcome::Program => 10, service::ServiceOutcome::Diagnostics => 100, _ => 0 }
}

pub fn score_fault(value: vm_backend::Execution) -> i64 {
    handle value { vm_backend::Execution::Faulted => 1, _ => 0 }
}

pub fn cache_world_one_fingerprint() -> identity::Digest { request::source_world2_fingerprint(cache_world_one()) }
pub fn cache_world_one() -> request::SourceWorld2 {
    handle request::source_world2(
        source::input("service-cache", "src/one", __g1_text_as_bytes("one"), identity::digest_of_text("one")),
        source::input("service-cache", "src/two", __g1_text_as_bytes("two"), identity::digest_of_text("two")),
        request::bootstrap_limits(2, 6),
    ) { request::SourceWorldAdmission::Value(value) => value, _ => cache_world_one() }
}
pub fn cache_world_changed() -> request::SourceWorld2 {
    handle request::source_world2(
        source::input("service-cache", "src/one", __g1_text_as_bytes("one"), identity::digest_of_text("one")),
        source::input("service-cache", "src/two", __g1_text_as_bytes("three"), identity::digest_of_text("three")),
        request::bootstrap_limits(2, 8),
    ) { request::SourceWorldAdmission::Value(value) => value, _ => cache_world_changed() }
}
pub fn score_world_dispatch(value: service::ServiceDispatch) -> i64 {
    handle value { service::ServiceDispatch::Reuse => 1, service::ServiceDispatch::Recompute => 10, _ => 0 }
}
