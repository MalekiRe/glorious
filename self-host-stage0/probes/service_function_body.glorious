        + score_u32(service::compile_source_u32_binary_function(source::input("service", "u32-binary-remainder", __g1_text_as_bytes("pub fn remainder(left: u32, right: u32) -> u32 { return left % right; }"), identity::digest_of_text("pub fn remainder(left: u32, right: u32) -> u32 { return left % right; }")), 85, 43))
