use service_library::service;
use service_library::source;
use service_library::identity;
use service_library::request;
use service_library::bootstrap;
use service_library::vm_backend;
use service_library::body;
use service_library::types;
use compiler_support::__g1_text_as_bytes;
use compiler_support::__g1_int_wrapping_add;
use compiler_support::__g1_int_wrapping_sub;

pub fn score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(number) => number,
        vm_backend::Execution::Faulted => 100,
        _ => 0,
    }
}

pub fn score_artifact(value: vm_backend::ArtifactEmission) -> i64 {
    handle value {
        vm_backend::ArtifactEmission::Artifact(_) => 1,
        vm_backend::ArtifactEmission::Rejected => 0,
        _ => 0,
    }
}
pub fn score_verified_i64_artifact(value: vm_backend::ArtifactEmission) -> i64 {
    handle value {
        vm_backend::ArtifactEmission::Artifact(bytes) => handle vm_backend::verify_g1_i64_callable_artifact(bytes) { true => 1, _ => 0 },
        vm_backend::ArtifactEmission::Rejected => 0,
        _ => 0,
    }
}

pub fn score_u32(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::ReturnedU32(42) => 1, _ => 0 } }
pub fn score_usize(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::ReturnedUsize(42) => 1, _ => 0 } }
pub fn score_u32_value(value: vm_backend::Execution, expected: u32) -> i64 { handle value { vm_backend::Execution::ReturnedU32(actual) => handle actual == expected { true => 1, false => 0, _ => 0 }, _ => 0 } }
pub fn score_bool(value: vm_backend::Execution, expected: Bool) -> i64 { handle (value, expected) { (vm_backend::Execution::Returned(1), true) => 1, (vm_backend::Execution::Returned(0), false) => 1, _ => 0 } }

pub fn score_negative_seven(value: vm_backend::Execution) -> i64 {
    handle value { vm_backend::Execution::Returned(number) => __g1_int_wrapping_add<i64>(number, 7), vm_backend::Execution::Faulted => 100, _ => 100 }
}

pub fn score_negative_three(value: vm_backend::Execution) -> i64 {
    handle value { vm_backend::Execution::Returned(number) => __g1_int_wrapping_add<i64>(number, 3), vm_backend::Execution::Faulted => 100, _ => 100 }
}

pub fn score_i64_minimum(value: vm_backend::Execution) -> i64 {
    handle value { vm_backend::Execution::Returned(number) => __g1_int_wrapping_add<i64>(__g1_int_wrapping_add<i64>(number, 9223372036854775807), 1), vm_backend::Execution::Faulted => 100, _ => 100 }
}

pub fn main() -> i64 {
    score(service::compile_source_i64_function(source::input("service", "body", __g1_text_as_bytes("fn answer { 1_234 }"), identity::digest_of_text("fn answer { 1_234 }"))))
