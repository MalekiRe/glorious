        + score_usize(service::compile_usize_arithmetic(body::Arithmetic::Add, 20, 22, types::Type::Usize))
        + score_usize(service::compile_source_usize_add_function(source::input("service", "usize-binary-add", __g1_text_as_bytes("pub fn add(left: usize, right: usize) -> usize { left + right }"), identity::digest_of_text("pub fn add(left: usize, right: usize) -> usize { left + right }")), 20, 22))
