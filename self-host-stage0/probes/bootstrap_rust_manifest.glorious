// The normal compiler emits this file; this probe proves its manifest bytes
// cross the source-owned bounded decoder unchanged.
use bootstrap_library::bootstrap;
use compiler_support::read_file;

pub fn main() -> i64 {
    let bytes = read_file("self-host-stage1.manifest");
    handle bootstrap::decode_manifest(bytes) {
        bootstrap::ManifestDecode::Seed(_) => handle bootstrap::manifest_roundtrip_is_canonical(bytes) {
            true => 2,
            _ => 0,
        },
        _ => 0,
    }
}
