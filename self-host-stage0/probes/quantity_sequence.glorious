use quantity_library::quantity;

pub fn score(result: quantity::QuantityResult) -> i64 {
    handle result {
        quantity::QuantityResult::Value(_) => 1,
        quantity::QuantityResult::Error(_) => 0,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(quantity::sequence(quantity::exact(1), quantity::exact(2)))
        + score(quantity::sequence(quantity::exact(18446744073709551615), quantity::once()))
}
