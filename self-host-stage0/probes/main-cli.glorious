use main_cli_library::main_cli;
use compiler_support::__g1_array_empty;
pub fn score(value: main_cli::CommandResult) -> i64 { handle value { main_cli::CommandResult::Accepted => 1, main_cli::CommandResult::Rejected => 10, _ => 0 } }
pub fn main() -> i64 {
    score(main_cli::select(main_cli::Command::Run))
    + score(main_cli::select(main_cli::Command::RunVm))
    + score(main_cli::select(main_cli::Command::VerifyBootstrap))
    + score(main_cli::select(main_cli::Command::Unknown))
    + score(main_cli::select(main_cli::parse("check")))
        + score(main_cli::select(main_cli::parse("run")))
        + score(main_cli::select(main_cli::parse("run-vm")))
        + score(main_cli::select(main_cli::parse("emit-vm")))
        + score(main_cli::select(main_cli::parse("emit-bootstrap-vm")))
        + score(main_cli::select(main_cli::parse("verify-vm")))
        + score(main_cli::select(main_cli::parse("verify-bootstrap")))
        + score(main_cli::select(main_cli::parse("unexpected")))
        + main_cli::value_count(main_cli::parse_flag("--root-package"))
        + main_cli::value_count(main_cli::parse_flag("--source"))
        + main_cli::value_count(main_cli::parse_flag("--runtime-standard-library"))
        + main_cli::value_count(main_cli::parse_flag("--runtime-leaf"))
        + main_cli::value_count(main_cli::parse_flag("--help"))
        + main_cli::value_count(main_cli::parse_flag("--unexpected"))
        + score_flag(main_cli::validate_flag(main_cli::parse_flag("--source"), 3))
        + score_flag(main_cli::validate_flag(main_cli::parse_flag("--source"), 2))
        + score_flag(main_cli::validate_flag(main_cli::parse_flag("--unexpected"), 0))
        + main_cli::value_count(main_cli::parse_flag("--diagnostics"))
        + main_cli::value_count(main_cli::parse_flag("--capability"))
        + main_cli::value_count(main_cli::parse_flag("--runtime-host"))
        + score_flag(main_cli::validate_flag(main_cli::parse_flag("--runtime-host"), 3))
        + score_flag(main_cli::validate_flag(main_cli::parse_flag("--runtime-host"), 4))
        + score_format(main_cli::validate_diagnostic_format(1, "text"))
        + score_format(main_cli::validate_diagnostic_format(1, "json"))
        + score_format(main_cli::validate_diagnostic_format(0, "text"))
        + score_format(main_cli::validate_diagnostic_format(1, "yaml"))
        + score_multiplicity(main_cli::validate_unique_occurrences(1))
        + score_multiplicity(main_cli::validate_unique_occurrences(2))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::Check, 0))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::Run, 1))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::RunVm, 1))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::RunVm, 0))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::EmitVm, 1))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::EmitVm, 2))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::EmitBootstrapVm, 2))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::EmitBootstrapVm, 3))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::VerifyVm, 0))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::VerifyBootstrap, 3))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::VerifyBootstrap, 4))
        + score_invocation(main_cli::validate_invocation(main_cli::Command::Check, 2))
        + score_argv(main_cli::parse_last_argv_command(__g1_array_empty<Text>()))
        + score_argv(main_cli::parse_last_argv_command(["run"]))
        + score_argv(main_cli::parse_argv_command_at(["run", "check"], 0))
        + score_emit_vm(main_cli::parse_argv_emit_vm_at(["grc", "emit-vm", "input.glorious", "output.grbc"], 1))
        + score_emit_vm(main_cli::parse_argv_emit_vm_at(["grc", "emit-vm", "input.glorious"], 1))
        + score_emit_vm_request(main_cli::parse_argv_emit_vm_request(["grc", "emit-vm", "input.glorious", "output.grbc"]), "command@0.1.0")
        + score_emit_vm_request(main_cli::parse_argv_emit_vm_request(["grc", "--root-package", "custom@0.1.0", "emit-vm", "input.glorious", "output.grbc"]), "custom@0.1.0")
        + score_emit_vm_request(main_cli::parse_argv_emit_vm_request(["grc", "--root-package", "custom@0.1.0", "emit-vm", "input.glorious"]), "")
        + score_check_request(main_cli::parse_argv_check_request(["grc", "check", "input.glorious"]), "command@0.1.0")
        + score_check_request(main_cli::parse_argv_check_request(["grc", "--root-package", "custom@0.1.0", "check", "input.glorious"]), "custom@0.1.0")
        + score_check_request(main_cli::parse_argv_check_request(["grc", "--root-package", "custom@0.1.0", "check"]), "")
        + score_run_request(main_cli::parse_argv_run_request(["grc", "run", "input.glorious"]), "command@0.1.0")
        + score_run_request(main_cli::parse_argv_run_request(["grc", "--root-package", "custom@0.1.0", "run", "input.glorious"]), "custom@0.1.0")
        + score_run_request(main_cli::parse_argv_run_request(["grc", "--root-package", "custom@0.1.0", "run"]), "")
        + score_run_vm_request(main_cli::parse_argv_run_vm_request(["grc", "run-vm", "program.g0vp", "--", "emit-vm", "input.glorious", "output.grbc"]), 4)
        + score_run_vm_request(main_cli::parse_argv_run_vm_request(["grc", "run-vm", "program.g0vp", "launcher-option"]), 0)
        + score_guest_argument(main_cli::run_vm_guest_argument(["grc", "run-vm", "program.g0vp", "--", "emit-vm", "input.glorious"], main_cli::parse_argv_run_vm_request(["grc", "run-vm", "program.g0vp", "--", "emit-vm", "input.glorious"]), 0), "emit-vm")
        + score_guest_argument(main_cli::run_vm_guest_argument(["grc", "run-vm", "program.g0vp", "--", "emit-vm", "input.glorious"], main_cli::parse_argv_run_vm_request(["grc", "run-vm", "program.g0vp", "--", "emit-vm", "input.glorious"]), 1), "input.glorious")
        + score_guest_argument(main_cli::run_vm_guest_argument(["grc", "run-vm", "program.g0vp"], main_cli::parse_argv_run_vm_request(["grc", "run-vm", "program.g0vp"]), 0), "")
        + score_guest_argument(main_cli::run_vm_guest_argument(["grc", "run-vm", "program.g0vp", "launcher-option"], main_cli::parse_argv_run_vm_request(["grc", "run-vm", "program.g0vp", "launcher-option"]), 0), "")
}

pub fn score_flag(value: main_cli::FlagResult) -> i64 { handle value { main_cli::FlagResult::Accepted => 1, main_cli::FlagResult::MissingValue => 10, main_cli::FlagResult::UnknownFlag => 100, _ => 0 } }
pub fn score_invocation(value: main_cli::InvocationResult) -> i64 { handle value { main_cli::InvocationResult::Accepted => 1, main_cli::InvocationResult::Rejected => 10, main_cli::InvocationResult::MissingSource => 100, main_cli::InvocationResult::MissingOutput => 1000, main_cli::InvocationResult::MissingManifest => 10000, main_cli::InvocationResult::MissingVerificationInput => 100000, main_cli::InvocationResult::ExtraArguments => 1000000, _ => 0 } }
pub fn score_format(value: main_cli::DiagnosticFormatResult) -> i64 { handle value { main_cli::DiagnosticFormatResult::Value(main_cli::DiagnosticFormat::Text) => 1, main_cli::DiagnosticFormatResult::Value(main_cli::DiagnosticFormat::Json) => 10, main_cli::DiagnosticFormatResult::MissingValue => 100, main_cli::DiagnosticFormatResult::InvalidValue => 1000, _ => 0 } }
pub fn score_multiplicity(value: main_cli::OptionMultiplicity) -> i64 { handle value { main_cli::OptionMultiplicity::Accepted => 1, main_cli::OptionMultiplicity::Duplicate => 10, _ => 0 } }
pub fn score_argv(value: main_cli::ArgvCommand) -> i64 { handle value { main_cli::ArgvCommand::Empty => 10000000, main_cli::ArgvCommand::Value(main_cli::Command::Run) => 100000000, _ => 0 } }
pub fn score_emit_vm(value: main_cli::EmitVmArguments) -> i64 { handle value { main_cli::EmitVmArguments::Value(_, _) => 1000000000, main_cli::EmitVmArguments::Invalid => 10000000000, _ => 0 } }
pub fn score_emit_vm_request(value: main_cli::EmitVmRequest, expected_package: Text) -> i64 {
    handle value {
        main_cli::EmitVmRequest::Value(package, _, _) => handle compiler_support::text_eq(package, expected_package) { true => 10000000000, _ => 0 },
        main_cli::EmitVmRequest::Invalid => 100000000000,
        _ => 0,
    }
}
pub fn score_check_request(value: main_cli::CheckRequest, expected_package: Text) -> i64 {
    handle value {
        main_cli::CheckRequest::Value(package, _) => handle compiler_support::text_eq(package, expected_package) { true => 1000000000000, _ => 0 },
        main_cli::CheckRequest::Invalid => 10000000000000,
        _ => 0,
    }
}
pub fn score_run_request(value: main_cli::RunRequest, expected_package: Text) -> i64 {
    handle value {
        main_cli::RunRequest::Value(package, _) => handle compiler_support::text_eq(package, expected_package) { true => 100000000000000, _ => 0 },
        main_cli::RunRequest::Invalid => 1000000000000000,
        _ => 0,
    }
}
pub fn score_run_vm_request(value: main_cli::RunVmRequest, expected_guest_start: usize) -> i64 {
    handle value {
        main_cli::RunVmRequest::Value(_, guest_start) => handle guest_start == expected_guest_start { true => 10000000000000000, false => 0, _ => 0 },
        main_cli::RunVmRequest::Invalid => handle expected_guest_start == 0 { true => 100000000000000000, false => 0, _ => 0 },
        _ => 0,
    }
}
pub fn score_guest_argument(value: main_cli::GuestArgument, expected: Text) -> i64 {
    handle value {
        main_cli::GuestArgument::Value(actual) => handle compiler_support::text_eq(actual, expected) { true => 1000000000000000000, _ => 0 },
        main_cli::GuestArgument::Missing => handle compiler_support::text_eq(expected, "") { true => 1000000000000000000, _ => 0 },
        _ => 0,
    }
}
