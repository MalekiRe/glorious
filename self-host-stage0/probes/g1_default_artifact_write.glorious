use compiler_support::write_file_atomically;
use g1_artifact_library::vm_backend;
use g1_artifact_library::body;
use g1_artifact_library::types;

pub fn main() -> u8 {
    handle vm_backend::emit_g1_for_body(body::Expression::Unit, types::Type::Unit) {
        vm_backend::ArtifactEmission::Artifact(bytes) => write_unit_artifacts(bytes),
        vm_backend::ArtifactEmission::Rejected => 0,
        _ => 0,
    }
}

fn write_unit_artifacts(bytes: Bytes) -> u8 {
    let ignored = write_file_atomically("default.grbc", bytes);
    let ignored_minimal = write_file_atomically("minimal.grbc", vm_backend::g1_minimal_library_candidate());
    let ignored_i64 = write_file_atomically("i64.grbc", vm_backend::g1_i64_entry_candidate(42));
    let ignored_i64_negative = write_file_atomically("i64-negative.grbc", vm_backend::g1_i64_entry_candidate(-1));
    let ignored_i64_callable = write_file_atomically("i64-callable.grbc", vm_backend::g1_i64_callable_candidate(42));
    let ignored_i64_callable_negative = write_file_atomically("i64-callable-negative.grbc", vm_backend::g1_i64_callable_candidate(-1));
    let ignored_i64_add = write_file_atomically("i64-add.grbc", vm_backend::g1_i64_binary_candidate(vm_backend::G1I64Arithmetic::Add, 2, 40));
    let ignored_i64_add_reversed = write_file_atomically("i64-add-reversed.grbc", vm_backend::g1_i64_binary_candidate(vm_backend::G1I64Arithmetic::Add, 40, 2));
    let ignored_i64_add_duplicate = write_file_atomically("i64-add-duplicate.grbc", vm_backend::g1_i64_binary_candidate(vm_backend::G1I64Arithmetic::Add, 2, 2));
    let ignored_i64_subtract = write_file_atomically("i64-subtract.grbc", vm_backend::g1_i64_binary_candidate(vm_backend::G1I64Arithmetic::Subtract, 40, 2));
    let ignored_i64_multiply = write_file_atomically("i64-multiply.grbc", vm_backend::g1_i64_binary_candidate(vm_backend::G1I64Arithmetic::Multiply, 6, 7));
    let ignored_i64_divide = write_file_atomically("i64-divide.grbc", vm_backend::g1_i64_binary_candidate(vm_backend::G1I64Arithmetic::Divide, 42, 2));
    let ignored_i64_identity = write_file_atomically("i64-identity-call.grbc", vm_backend::g1_i64_identity_call_candidate(42));
    let ignored_i64_binary_call = write_file_atomically("i64-binary-call.grbc", vm_backend::g1_i64_binary_call_candidate(vm_backend::G1I64Arithmetic::Add, 20, 22));
    let ignored_i64_binary_call_subtract = write_file_atomically("i64-binary-call-subtract.grbc", vm_backend::g1_i64_binary_call_candidate(vm_backend::G1I64Arithmetic::Subtract, 42, 2));
    let ignored_i64_binary_call_multiply = write_file_atomically("i64-binary-call-multiply.grbc", vm_backend::g1_i64_binary_call_candidate(vm_backend::G1I64Arithmetic::Multiply, 6, 7));
    let ignored_i64_binary_call_divide = write_file_atomically("i64-binary-call-divide.grbc", vm_backend::g1_i64_binary_call_candidate(vm_backend::G1I64Arithmetic::Divide, 42, 2));
    131
}
