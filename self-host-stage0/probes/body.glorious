pub fn score(value: Bool) -> i64 { handle value { true => 1, false => 0, _ => 0 } }
pub fn score_admission(value: body::BodyAdmission) -> i64 { handle value { body::BodyAdmission::Value(body::BodyKind::Call) => 1, body::BodyAdmission::Value(body::BodyKind::Literal) => 0, body::BodyAdmission::TypeError => 0, _ => 0 } }
pub fn score_pattern_admission(value: body::BodyAdmission) -> i64 { handle value { body::BodyAdmission::Value(body::BodyKind::PatternTest) => 1, _ => 0 } }
pub fn score_capture_admission(value: body::BodyAdmission) -> i64 { handle value { body::BodyAdmission::Value(body::BodyKind::ClosureCapture) => 1, _ => 0 } }
pub fn score_move_capture_syntax(value: body::MoveCaptureClosureSyntax) -> i64 { handle value { body::MoveCaptureClosureSyntax::Captures(2) => 1, _ => 0 } }
pub fn score_nested_move_capture_syntax(value: body::MoveCaptureClosureSyntax) -> i64 { handle value { body::MoveCaptureClosureSyntax::Captures(1) => 1, _ => 0 } }
pub fn score_not_move_capture(value: body::MoveCaptureClosureSyntax) -> i64 { handle value { body::MoveCaptureClosureSyntax::NotMoveClosure => 1, _ => 0 } }
pub fn score_rejected_move_capture(value: body::MoveCaptureClosureSyntax) -> i64 { handle value { body::MoveCaptureClosureSyntax::Rejected => 1, _ => 0 } }
pub fn score_compact_closure(value: body::CompactClosureSyntax) -> i64 { handle value { body::CompactClosureSyntax::Parameters(2) => 1, _ => 0 } }
pub fn score_empty_compact_closure(value: body::CompactClosureSyntax) -> i64 { handle value { body::CompactClosureSyntax::Parameters(0) => 1, _ => 0 } }
