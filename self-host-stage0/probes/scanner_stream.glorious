use compiler_support::__g1_text_as_bytes;
use scanner_library::identity;
use scanner_library::scanner;
use scanner_library::source;

pub fn score(value: scanner::TokenStreamAdmission) -> i64 {
    handle value {
        scanner::TokenStreamAdmission::Valid => 1,
        scanner::TokenStreamAdmission::Invalid => 100,
        scanner::TokenStreamAdmission::Unadmitted => 10000,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(scanner::token_stream_checked(source::input("scanner", "valid", __g1_text_as_bytes("name 7"), identity::digest_of_text("name 7"))))
        + score(scanner::token_stream_checked(source::input("scanner", "invalid", __g1_text_as_bytes("1__2"), identity::digest_of_text("1__2"))))
        + score(scanner::token_stream_checked(source::input("scanner", "unterminated-string", __g1_text_as_bytes("\"open"), identity::digest_of_text("\"open"))))
        + score(scanner::token_stream_checked(source::input("scanner", "unterminated-comment", __g1_text_as_bytes("/* open"), identity::digest_of_text("/* open"))))
        + score(scanner::token_stream_checked(source::input("scanner", "bad-escape", __g1_text_as_bytes("\"\\q\""), identity::digest_of_text("\"\\q\""))))
        + score(scanner::token_stream_checked(source::input("scanner", "valid-unicode-escape", __g1_text_as_bytes("\"\\u{1f600}\""), identity::digest_of_text("\"\\u{1f600}\""))))
        + score(scanner::token_stream_checked(source::input("scanner", "surrogate-unicode-escape", __g1_text_as_bytes("\"\\u{d800}\""), identity::digest_of_text("\"\\u{d800}\""))))
        + score(scanner::token_stream_checked(source::input("scanner", "oversized-unicode-escape", __g1_text_as_bytes("\"\\u{110000}\""), identity::digest_of_text("\"\\u{110000}\""))))
        + score(scanner::token_stream_checked(source::input("scanner", "invalid-character", __g1_text_as_bytes("@"), identity::digest_of_text("@"))))
        + score(scanner::token_stream_checked(source::input("scanner", "forged", __g1_text_as_bytes("answer"), identity::digest_of_text("wrong"))))
}
