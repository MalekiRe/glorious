use service_library::service;

pub fn main() -> u8 {
    handle service::emit_file_unit_entry("g1-file-artifact", "unit-entry-input.glorious", "unit-entry-output.grbc") {
        service::EmitUnitEntryResult::Written => emit_arithmetic(),
        service::EmitUnitEntryResult::Rejected => 0,
        _ => 0,
    }
}

fn emit_arithmetic() -> u8 {
    handle service::emit_file_i64_function_arithmetic_entry("g1-file-artifact", "arithmetic-input.glorious", "arithmetic-output.grbc") {
        service::EmitUnitEntryResult::Written => 140,
        _ => 0,
    }
}
