use compiler_support::__g1_text_as_bytes;
use compiler_support::__g1_bytes_len;
use compiler_support::__g1_bytes_concat;
use identity_library::identity;
pub fn tenth(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64) -> i64 { j }
pub fn tenth_bytes(a: Bytes, b: Bytes, c: Bytes, d: Bytes, e: Bytes, f: Bytes, g: Bytes, h: Bytes, i: Bytes, j: Bytes) -> Bytes { j }
pub struct Envelope { value: Bytes }
pub fn envelope(value: Bytes) -> Envelope { Envelope { value: value } }
pub fn unwrap(value: Envelope) -> Bytes { value.value }
pub fn u32_score(value: u32) -> i64 { handle value == 36 { true => 42, false => 0, _ => 0 } }
pub fn u64_score(value: u64) -> i64 { handle value == 1048576 { true => 42, false => 0, _ => 0 } }
pub fn digest_score(value: identity::Digest) -> i64 { handle __g1_bytes_len(identity::digest_bytes(value)) == 32 { true => 42, false => 0, _ => 0 } }
pub fn concat8(a: Bytes, b: Bytes, c: Bytes, d: Bytes, e: Bytes, f: Bytes, g: Bytes, h: Bytes) -> Bytes { __g1_bytes_concat(__g1_bytes_concat(__g1_bytes_concat(a, b), __g1_bytes_concat(c, d)), __g1_bytes_concat(__g1_bytes_concat(e, f), __g1_bytes_concat(g, h))) }
pub fn byte_score(value: Bytes) -> i64 { handle __g1_bytes_len(value) == 42 { true => 42, false => 0, _ => 0 } }
pub fn main() -> i64 {
    tenth(1, 2, 3, 4, 5, 6, 7, 8, 9, 42)
        + byte_score(tenth_bytes(__g1_text_as_bytes("a"), __g1_text_as_bytes("b"), __g1_text_as_bytes("c"), __g1_text_as_bytes("d"), __g1_text_as_bytes("e"), __g1_text_as_bytes("f"), __g1_text_as_bytes("g"), __g1_text_as_bytes("h"), __g1_text_as_bytes("i"), __g1_text_as_bytes("abcdefghijklmnopqrstuvwxyzabcdefghijklmnop")))
        + byte_score(unwrap(envelope(__g1_text_as_bytes("abcdefghijklmnopqrstuvwxyzabcdefghijklmnop"))))
        + u32_score(36)
        + u64_score(1048576)
        + digest_score(identity::digest_of_text("digest"))
        + byte_score(concat8(__g1_text_as_bytes("abcdefg"), __g1_text_as_bytes("abcdefg"), __g1_text_as_bytes("abcdefg"), __g1_text_as_bytes("abcdefg"), __g1_text_as_bytes("abcdefg"), __g1_text_as_bytes("abcdefg"), __g1_text_as_bytes(""), __g1_text_as_bytes("")))
}
