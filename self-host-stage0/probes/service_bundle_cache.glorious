// Direct regression for the scalable request path: cache reuse is derived
// from the admitted source bundle, never from an externally supplied world.
use service_library::service;
use service_library::request;
use service_library::source;
use service_library::identity;
use service_library::bootstrap;
use compiler_support::__g1_text_as_bytes;

pub fn main() -> i64 {
    score(service::dispatch_build_source_bundle_cache(
        request::stage0_build(identity::digest_of_text("seed")),
        request::stage0_build(identity::digest_of_text("seed")),
        bundle_fingerprint(),
        bundle_world(),
        identity::digest_of_text("artifact"),
        identity::digest_of_text("artifact"),
        bootstrap::ArtifactAdmission::Verified,
    ))
}

pub fn score(value: service::ServiceDispatch) -> i64 {
    handle value {
        service::ServiceDispatch::Reuse => 1,
        _ => 0,
    }
}

pub fn bundle_fingerprint() -> identity::Digest {
    request::source_bundle_fingerprint(bundle_world())
}

pub fn bundle_world() -> request::SourceBundle {
    handle request::source_bundle(
        request::source_sequence_one(source::input(
            "service-bundle-probe",
            "src/main.glorious",
            __g1_text_as_bytes("pub fn main"),
            identity::digest_of_text("pub fn main"),
        )),
        request::bootstrap_limits(1, 11),
    ) {
        request::SourceBundleAdmission::Value(value) => value,
        _ => bundle_world(),
    }
}
