use interface_library::interface;
use interface_library::header;
use interface_library::source;
use interface_library::identity;
use compiler_support::__g1_text_as_bytes;

pub fn score(value: Bool) -> i64 {
    handle value {
        true => 1,
        false => 0,
        _ => 0,
    }
}

pub fn score_definition_set(value: interface::DefinitionSetAdmission) -> i64 {
    handle value {
        interface::DefinitionSetAdmission::Value(_) => 1,
        interface::DefinitionSetAdmission::Duplicate => 10,
        _ => 0,
    }
}

pub fn duplicate_value_score(value: interface::DefinitionSetAdmission) -> i64 {
    handle value {
        interface::DefinitionSetAdmission::Value(set) => score_definition_set(interface::insert_definition(
            set,
            "main",
            interface::definition(interface::DefinitionKind::Function, true))),
        interface::DefinitionSetAdmission::Duplicate => 0,
        _ => 0,
    }
}

pub fn type_value_same_name_score(value: interface::DefinitionSetAdmission) -> i64 {
    handle value {
        interface::DefinitionSetAdmission::Value(set) => score_definition_set(interface::insert_definition(
            set,
            "Item",
            interface::definition(interface::DefinitionKind::Struct, true))),
        interface::DefinitionSetAdmission::Duplicate => 0,
        _ => 0,
    }
}

pub fn implementation_same_name_score(value: interface::DefinitionSetAdmission) -> i64 {
    handle value {
        interface::DefinitionSetAdmission::Value(set) => score_definition_set(interface::insert_definition(
            set,
            "anonymous",
            interface::definition(interface::DefinitionKind::Implementation, false))),
        interface::DefinitionSetAdmission::Duplicate => 0,
        _ => 0,
    }
}

pub fn named_definition_score(value: interface::NamedDefinitionAdmission, expected: usize) -> i64 {
    handle value {
        interface::NamedDefinitionAdmission::Value(named) => handle interface::named_definition_name_start(named) == expected { true => 1, false => 0, _ => 0 },
        interface::NamedDefinitionAdmission::NotDeclaration => 0,
        _ => 0,
    }
}

pub fn named_definition_missing_score(value: interface::NamedDefinitionAdmission) -> i64 {
    handle value {
        interface::NamedDefinitionAdmission::Value(_) => 0,
        interface::NamedDefinitionAdmission::NotDeclaration => 1,
        _ => 0,
    }
}

pub fn source_named_set(value: interface::NamedDefinitionAdmission) -> interface::SourceDefinitionSetAdmission {
    handle value {
        interface::NamedDefinitionAdmission::Value(named) => interface::insert_named_definition(interface::empty_source_definitions(), named),
        interface::NamedDefinitionAdmission::NotDeclaration => interface::SourceDefinitionSetAdmission::Duplicate,
        _ => interface::SourceDefinitionSetAdmission::Duplicate,
    }
}

pub fn source_named_append_score(first: interface::SourceDefinitionSetAdmission, second: interface::NamedDefinitionAdmission) -> i64 {
    handle first {
        interface::SourceDefinitionSetAdmission::Value(set) => handle second {
            interface::NamedDefinitionAdmission::Value(named) => source_definition_set_score(interface::insert_named_definition(set, named)),
            interface::NamedDefinitionAdmission::NotDeclaration => 0,
            _ => 0,
        },
        interface::SourceDefinitionSetAdmission::Duplicate => 0,
        _ => 0,
    }
}

pub fn source_definition_set_score(value: interface::SourceDefinitionSetAdmission) -> i64 {
    handle value {
        interface::SourceDefinitionSetAdmission::Value(_) => 1,
        interface::SourceDefinitionSetAdmission::Duplicate => 10,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(interface::is_exported(interface::definition(interface::DefinitionKind::Function, true)))
        + score(interface::is_exported(interface::definition(interface::DefinitionKind::Struct, false)))
        + score(interface::is_exported(interface::definition(interface::DefinitionKind::Import, true)))
        + score_admission(interface::definition_from_header(__g1_text_as_bytes("pub fn main")))
        + score_admission(interface::definition_from_header(__g1_text_as_bytes("fn internal")))
        + score_admission(interface::definition_from_lead(header::leading(__g1_text_as_bytes("impl Gate for i64")), true))
        + score_admission(interface::definition_from_lead(header::leading(__g1_text_as_bytes("value")), true))
        + score_admission(interface::definition_from_header(__g1_text_as_bytes("pub infixl +")))
        + score_admission(interface::definition_from_header(__g1_text_as_bytes("infixr **")))
        + score_fixity(interface::definition_from_header(__g1_text_as_bytes("pub prefix !")))
        + score_admission(interface::definition_from_header(__g1_text_as_bytes("pub host io fn read")))
        + score_admission(interface::definition_from_header(__g1_text_as_bytes("pub let alias = value")))
        + score_admission(interface::definition_from_header(__g1_text_as_bytes("pub auto trait Marker")))
        + score_auto_trait(interface::definition_from_header(__g1_text_as_bytes("pub auto trait Marker")))
        + score_definition_set(interface::insert_definition(
            interface::empty_definitions(),
            "main",
            interface::definition(interface::DefinitionKind::Function, true)))
        + duplicate_value_score(interface::insert_definition(
            interface::empty_definitions(),
            "main",
            interface::definition(interface::DefinitionKind::Function, true)))
        + type_value_same_name_score(interface::insert_definition(
            interface::empty_definitions(),
            "Item",
            interface::definition(interface::DefinitionKind::Function, true)))
        + implementation_same_name_score(interface::insert_definition(
            interface::empty_definitions(),
            "anonymous",
            interface::definition(interface::DefinitionKind::Implementation, false)))
        + named_definition_score(interface::named_definition_from_header_checked(source::input(
            "package", "src/named.glorious", __g1_text_as_bytes("pub fn main"), identity::digest_of_text("pub fn main"))), 7)
        + named_definition_missing_score(interface::named_definition_from_header_checked(source::input(
            "package", "src/missing.glorious", __g1_text_as_bytes("pub fn"), identity::digest_of_text("pub fn"))))
        + source_named_append_score(
            source_named_set(interface::named_definition_from_header_checked(source::input(
                "package", "src/first.glorious", __g1_text_as_bytes("fn main"), identity::digest_of_text("fn main")))),
            interface::named_definition_from_header_checked(source::input(
                "package", "src/second.glorious", __g1_text_as_bytes("pub fn main"), identity::digest_of_text("pub fn main"))))
        + source_named_append_score(
            source_named_set(interface::named_definition_from_header_checked(source::input(
                "package", "src/value.glorious", __g1_text_as_bytes("fn Item"), identity::digest_of_text("fn Item")))),
            interface::named_definition_from_header_checked(source::input(
                "package", "src/type.glorious", __g1_text_as_bytes("struct Item"), identity::digest_of_text("struct Item"))))
}

pub fn score_admission(value: interface::DefinitionAdmission) -> i64 {
    handle value {
        interface::DefinitionAdmission::Value(definition) => score(interface::is_exported(definition)),
        interface::DefinitionAdmission::NotDeclaration => 0,
        _ => 0,
    }
}

pub fn score_fixity(value: interface::DefinitionAdmission) -> i64 {
    handle value {
        interface::DefinitionAdmission::Value(definition) => handle interface::namespace(definition) {
            interface::DefinitionNamespace::Operator => 1,
            _ => 0,
        },
        interface::DefinitionAdmission::NotDeclaration => 0,
        _ => 0,
    }
}

pub fn score_auto_trait(value: interface::DefinitionAdmission) -> i64 {
    handle value {
        interface::DefinitionAdmission::Value(definition) => score(interface::is_auto_trait(definition)),
        interface::DefinitionAdmission::NotDeclaration => 0,
        _ => 0,
    }
}
