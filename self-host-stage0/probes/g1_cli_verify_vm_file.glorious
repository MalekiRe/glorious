// Exercises the production source-owned verify-vm path. The first argv is a
// canonical root-package form, the second is deliberately malformed, and
// the third points at invalid bytes; neither rejection can be promoted by the
// CLI adapter into a verified artifact.
use service_library::service;

pub fn main() -> u8 {
    score(
        service::verify_vm_entry_from_argv(["grc", "--root-package", "g1-cli-verify", "verify-vm", "valid.grbc"]),
        service::verify_vm_entry_from_argv(["grc", "--root-package", "g1-cli-verify", "verify-vm"]),
        service::verify_vm_entry_from_argv(["grc", "verify-vm", "invalid.grbc"]),
    )
}

fn score(valid: service::VerifyVmEntryResult, malformed: service::VerifyVmEntryResult, invalid: service::VerifyVmEntryResult) -> u8 {
    handle valid {
        service::VerifyVmEntryResult::Verified => handle malformed {
            service::VerifyVmEntryResult::Rejected => handle invalid {
                service::VerifyVmEntryResult::Rejected => 137,
                _ => 0,
            },
            _ => 0,
        },
        _ => 0,
    }
}
