use operation_library::operation;

pub fn score(result: operation::PublicationResult<i64>) -> i64 {
    handle result {
        operation::PublicationResult::Value(value) => value,
        operation::PublicationResult::Cancelled => 0,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(operation::publish(operation::stage_publication(7), operation::active()))
        + score(operation::publish(operation::stage_publication(9), operation::cancel(operation::active())))
}
