pub fn nested_generic_close_score() -> i64 {
    let input = __g1_text_as_bytes("Outer<Inner<T>>");
    let outer = scanner::first_token(input);
    let outer_open = scanner::next_token(input, outer);
    let inner = scanner::next_token(input, outer_open);
    let inner_open = scanner::next_token(input, inner);
    let parameter = scanner::next_token(input, inner_open);
    let first_close = scanner::next_token(input, parameter);
    let second_close = scanner::next_token(input, first_close);
    score(scanner::token_matches(input, first_close, ">")) + score(scanner::token_matches(input, second_close, ">"))
}

pub fn checked_token_score(value: scanner::SourceToken) -> i64 { handle value { scanner::SourceToken::Value(token) => token_score(scanner::token_kind(token)), scanner::SourceToken::Unadmitted => 0, _ => 0 } }
pub fn unadmitted_score(value: scanner::SourceToken) -> i64 { handle value { scanner::SourceToken::Value(_) => 0, scanner::SourceToken::Unadmitted => 1, _ => 0 } }
pub fn i64_max_score(value: scanner::I64LiteralAdmission) -> i64 { handle value { scanner::I64LiteralAdmission::Value(9223372036854775807) => 1, _ => 0 } }
pub fn i64_overflow_score(value: scanner::I64LiteralAdmission) -> i64 { handle value { scanner::I64LiteralAdmission::NotI64Literal => 1, _ => 0 } }
pub fn signed_i64_score(value: scanner::SignedI64LiteralAdmission) -> i64 { handle value { scanner::SignedI64LiteralAdmission::Value(number, _) => __g1_int_wrapping_add<i64>(number, 8), _ => 0 } }
pub fn signed_i64_minimum_score(value: scanner::SignedI64LiteralAdmission) -> i64 { handle value { scanner::SignedI64LiteralAdmission::Value(number, _) => __g1_int_wrapping_add<i64>(__g1_int_wrapping_add<i64>(number, 9223372036854775807), 2), _ => 0 } }
pub fn signed_i64_overflow_score(value: scanner::SignedI64LiteralAdmission) -> i64 { handle value { scanner::SignedI64LiteralAdmission::NotI64Literal => 1, _ => 0 } }
pub fn u32_literal_score(value: scanner::U32LiteralAdmission) -> i64 { handle value { scanner::U32LiteralAdmission::Value(4294967295, _) => 1, _ => 0 } }
pub fn u32_rejection_score(value: scanner::U32LiteralAdmission) -> i64 { handle value { scanner::U32LiteralAdmission::NotU32Literal => 1, _ => 0 } }
