use compiler_support::__g1_text_as_bytes;
use scanner_library::scanner;

pub fn score(value: Bool) -> i64 { handle value { true => 1, false => 0, _ => 0 } }
pub fn kind_score(value: scanner::TokenKind) -> i64 { handle value { scanner::TokenKind::String => 10, _ => 0 } }

// Keep this probe shallow: the bootstrap evaluator does not yet flatten a
// large source-level addition tree, so escape coverage must not depend on the
// stack depth of the broad scanner smoke test.
pub fn main() -> i64 {
    kind_score(scanner::token_kind(scanner::first_token(__g1_text_as_bytes("\"\\\\n\""))))
        + score(scanner::token_end(scanner::first_token(__g1_text_as_bytes("\"\\\\n\""))) == 4)
        + 100 * score(scanner::token_end(scanner::first_token(__g1_text_as_bytes("\"\\\\n\""))) == 5)
}
