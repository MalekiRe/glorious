use service_library::service;
use service_library::query;
use service_library::revision;
use service_library::output;
use service_library::dependency;
use service_library::artifact_cache;
use service_library::bootstrap;
use service_library::identity;
use service_library::request;
use compiler_support::__g1_text_as_bytes;

pub fn score(value: service::ServiceOutcome) -> i64 {
    handle value {
        service::ServiceOutcome::Program => 1,
        service::ServiceOutcome::Diagnostics => 100,
        _ => 0,
    }
}

pub fn score_dispatch(value: service::ServiceDispatch) -> i64 {
    handle value {
        service::ServiceDispatch::Reuse => 1,
        service::ServiceDispatch::Recompute => 10,
        service::ServiceDispatch::Rejected => 100,
        _ => 0,
    }
}

pub fn ready(snapshot: revision::Snapshot) -> query::QuerySlot {
    query::begin_at(query::keyed_slot(7, snapshot))
}

pub fn complete(snapshot: revision::Snapshot) -> query::QuerySlot {
    handle query::publish_at(ready(snapshot), snapshot, query::QueryCompleteness::Complete) {
        query::QueryPublication::Value(slot) => slot,
        _ => query::keyed_slot(7, snapshot),
    }
}

pub fn main() -> i64 {
    score(service::publish_cached_keyed(
        artifact_cache::CacheAdmission::Hit,
        query::RecoveryPolicy::Allow,
        complete(revision::root(7)),
        7,
        revision::root(7),
        dependency::DependencyStatus::Green,
        output::stage("artifact", __g1_text_as_bytes("ok")),
    )) + score(service::publish_cached_keyed(
        artifact_cache::CacheAdmission::Rejected,
        query::RecoveryPolicy::Allow,
        complete(revision::root(7)),
        7,
        revision::root(7),
        dependency::DependencyStatus::Green,
        output::stage("artifact", __g1_text_as_bytes("must-not-publish")),
    )) + score(service::publish_build_cached_keyed(
        artifact_cache::build_bootstrap_entry(request::stage0_build(identity::digest_of_text("seed")), request::stage0_build(identity::digest_of_text("seed")), identity::digest_of_text("world"), identity::digest_of_text("world"), identity::digest_of_text("artifact"), identity::digest_of_text("artifact"), bootstrap::ArtifactAdmission::Verified),
        query::RecoveryPolicy::Allow,
        complete(revision::root(7)),
        7,
        revision::root(7),
        dependency::DependencyStatus::Green,
        output::stage("artifact", __g1_text_as_bytes("build-ok")),
    )) + score(service::publish_build_cached_keyed(
        artifact_cache::build_bootstrap_entry(request::stage0_build(identity::digest_of_text("seed")), request::stage0_build(identity::digest_of_text("changed-seed")), identity::digest_of_text("world"), identity::digest_of_text("world"), identity::digest_of_text("artifact"), identity::digest_of_text("artifact"), bootstrap::ArtifactAdmission::Verified),
        query::RecoveryPolicy::Allow,
        complete(revision::root(7)),
        7,
        revision::root(7),
        dependency::DependencyStatus::Green,
        output::stage("artifact", __g1_text_as_bytes("wrong-build")),
    )) + score_dispatch(service::dispatch_build_cached_keyed_query(
        artifact_cache::build_bootstrap_entry(request::stage0_build(identity::digest_of_text("seed")), request::stage0_build(identity::digest_of_text("seed")), identity::digest_of_text("world"), identity::digest_of_text("world"), identity::digest_of_text("artifact"), identity::digest_of_text("artifact"), bootstrap::ArtifactAdmission::Verified),
        query::RecoveryPolicy::Allow,
        complete(revision::root(7)),
        7,
        revision::root(7),
        dependency::DependencyStatus::Green,
    )) + score_dispatch(service::dispatch_build_cached_keyed_query(
        artifact_cache::build_bootstrap_entry(request::stage0_build(identity::digest_of_text("seed")), request::stage0_build(identity::digest_of_text("changed-seed")), identity::digest_of_text("world"), identity::digest_of_text("world"), identity::digest_of_text("artifact"), identity::digest_of_text("artifact"), bootstrap::ArtifactAdmission::Verified),
        query::RecoveryPolicy::Allow,
        complete(revision::root(7)),
        7,
        revision::root(7),
        dependency::DependencyStatus::Green,
    ))
}
