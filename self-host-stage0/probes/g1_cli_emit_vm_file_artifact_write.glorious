// This exercises the production source-owned compiler entrypoint: argv
// selection, file-backed compilation, and atomic publication are one service
// boundary rather than probe-local composition.
use service_library::service;

pub fn main() -> u8 {
    publish_both(
        service::emit_vm_entry_from_argv([
            "grc", "--root-package", "g1-cli-artifact", "emit-vm", "arithmetic-input.glorious", "arithmetic-output.grbc",
        ]),
        service::emit_vm_entry_from_argv([
            "grc", "--root-package", "g1-cli-artifact", "emit-vm", "select-input.glorious", "select-output.grbc",
        ]),
        service::emit_vm_entry_from_argv([
            "grc", "--root-package", "g1-cli-artifact", "emit-vm", "return-input.glorious", "return-output.grbc",
        ]),
        service::emit_vm_entry_from_argv([
            "grc", "--root-package", "g1-cli-artifact", "emit-vm", "return-select-input.glorious", "return-select-output.grbc",
        ]),
        service::emit_vm_entry_from_argv([
            "grc", "--root-package", "g1-cli-artifact", "emit-vm", "arithmetic-input.glorious", "invalid-output.grbc", "extra",
        ]),
        service::emit_vm_entry_from_argv([
            "grc", "--root-package", "g1-cli-artifact", "emit-vm", "return-invalid-input.glorious", "return-invalid-output.grbc",
        ]),
        service::emit_vm_entry_from_argv([
            "grc", "--root-package", "g1-cli-artifact", "emit-vm", "return-select-invalid-input.glorious", "return-select-invalid-output.grbc",
        ]),
    )
}

fn publish_both(first: service::EmitUnitEntryResult, second: service::EmitUnitEntryResult, third: service::EmitUnitEntryResult, returned_select: service::EmitUnitEntryResult, malformed: service::EmitUnitEntryResult, malformed_return: service::EmitUnitEntryResult, malformed_return_select: service::EmitUnitEntryResult) -> u8 {
    handle first {
        service::EmitUnitEntryResult::Written => handle second {
            service::EmitUnitEntryResult::Written => handle third {
                service::EmitUnitEntryResult::Written => handle returned_select {
                    service::EmitUnitEntryResult::Written => handle malformed {
                        service::EmitUnitEntryResult::Rejected => handle malformed_return {
                            service::EmitUnitEntryResult::Rejected => handle malformed_return_select {
                                service::EmitUnitEntryResult::Rejected => 136,
                                _ => 0,
                            },
                            _ => 0,
                        },
                        _ => 0,
                    },
                    _ => 0,
                },
                _ => 0,
            },
            service::EmitUnitEntryResult::Rejected => 0,
            _ => 0,
        },
        service::EmitUnitEntryResult::Rejected => 0,
        _ => 0,
    }
}
