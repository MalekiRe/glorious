use mir_storage_library::mir_storage;
pub fn score(value: mir_storage::TakeResult) -> i64 { handle value { mir_storage::TakeResult::Value(value) => value, mir_storage::TakeResult::Empty => 0, _ => 0 } }
pub fn score_bool(value: Bool) -> i64 { handle value { true => 1, false => 0, _ => 0 } }
pub fn score_cleanup(value: mir_storage::CleanupResult) -> i64 { handle value { mir_storage::CleanupResult::Dropped(value) => value, mir_storage::CleanupResult::Skipped => 1, _ => 0 } }
pub fn score_replace(value: mir_storage::ReplaceResult) -> i64 {
    handle value {
        mir_storage::ReplaceResult::Written(slot) => score(mir_storage::take(slot)),
        mir_storage::ReplaceResult::Replaced(previous, slot) => previous + score(mir_storage::take(slot)),
        _ => 0,
    }
}
pub fn score_move(value: mir_storage::MoveResult) -> i64 {
    handle value {
        mir_storage::MoveResult::Value(value, remainder) => value + score_bool(mir_storage::is_empty(remainder)) + score_bool(mir_storage::was_moved(remainder)),
        mir_storage::MoveResult::Empty(remainder) => score_bool(mir_storage::is_empty(remainder)) + score_bool(mir_storage::was_moved(remainder)),
        _ => 0,
    }
}
pub fn field_slots() -> mir_storage::FieldSlots { mir_storage::prepend_field(mir_storage::write(mir_storage::empty(), 3), mir_storage::prepend_field(mir_storage::write(mir_storage::empty(), 5), mir_storage::single_field(mir_storage::write(mir_storage::empty(), 7)))) }
pub fn score_field_move(value: mir_storage::FieldMoveResult) -> i64 { handle value { mir_storage::FieldMoveResult::Value(value, _) => value, mir_storage::FieldMoveResult::Empty(_) => 0, mir_storage::FieldMoveResult::Missing => 0, _ => 0 } }
pub fn score_field_empty(value: mir_storage::FieldMoveResult) -> i64 { handle value { mir_storage::FieldMoveResult::Empty(_) => 1, _ => 0 } }
pub fn move_field_again(value: mir_storage::FieldMoveResult, index: i64) -> mir_storage::FieldMoveResult { handle value { mir_storage::FieldMoveResult::Value(_, fields) => mir_storage::move_field(fields, index), mir_storage::FieldMoveResult::Empty(fields) => mir_storage::move_field(fields, index), mir_storage::FieldMoveResult::Missing => mir_storage::FieldMoveResult::Missing, _ => mir_storage::FieldMoveResult::Missing } }
pub fn write_after_field_move(value: mir_storage::FieldMoveResult, index: i64, replacement: i64) -> mir_storage::FieldSlots { handle value { mir_storage::FieldMoveResult::Value(_, fields) => mir_storage::write_field(fields, index, replacement), mir_storage::FieldMoveResult::Empty(fields) => mir_storage::write_field(fields, index, replacement), mir_storage::FieldMoveResult::Missing => mir_storage::empty_fields(), _ => mir_storage::empty_fields() } }
pub fn nested_slots() -> mir_storage::NestedFieldSlots { mir_storage::nested_prepend_field(mir_storage::write(mir_storage::empty(), 11), mir_storage::nested_prepend_field(mir_storage::write(mir_storage::empty(), 3), mir_storage::nested_empty_fields(), mir_storage::nested_single_field(mir_storage::write(mir_storage::empty(), 5))), mir_storage::nested_single_field(mir_storage::write(mir_storage::empty(), 7))) }
pub fn nested_target() -> mir_storage::NestedStoragePath { mir_storage::storage_path_then(0, mir_storage::storage_path_field(1)) }
pub fn nested_first_child() -> mir_storage::NestedStoragePath { mir_storage::storage_path_then(0, mir_storage::storage_path_field(0)) }
pub fn nested_parent() -> mir_storage::NestedStoragePath { mir_storage::storage_path_field(0) }
pub fn score_nested_move(value: mir_storage::NestedFieldMoveResult) -> i64 { handle value { mir_storage::NestedFieldMoveResult::Value(number, _) => number, mir_storage::NestedFieldMoveResult::Empty(_) => 0, mir_storage::NestedFieldMoveResult::Missing => 0, _ => 0 } }
pub fn nested_again(value: mir_storage::NestedFieldMoveResult, path: mir_storage::NestedStoragePath) -> mir_storage::NestedFieldMoveResult { handle value { mir_storage::NestedFieldMoveResult::Value(_, fields) => mir_storage::move_nested_field(fields, path), mir_storage::NestedFieldMoveResult::Empty(fields) => mir_storage::move_nested_field(fields, path), mir_storage::NestedFieldMoveResult::Missing => mir_storage::NestedFieldMoveResult::Missing, _ => mir_storage::NestedFieldMoveResult::Missing } }
pub fn nested_empty_score(value: mir_storage::NestedFieldMoveResult) -> i64 { handle value { mir_storage::NestedFieldMoveResult::Empty(_) => 1, _ => 0 } }
pub fn write_nested_again(value: mir_storage::NestedFieldMoveResult, path: mir_storage::NestedStoragePath, replacement: i64) -> mir_storage::NestedFieldSlots { handle value { mir_storage::NestedFieldMoveResult::Value(_, fields) => mir_storage::write_nested_field(fields, path, replacement), mir_storage::NestedFieldMoveResult::Empty(fields) => mir_storage::write_nested_field(fields, path, replacement), mir_storage::NestedFieldMoveResult::Missing => mir_storage::nested_empty_fields(), _ => mir_storage::nested_empty_fields() } }
pub fn main() -> i64 {
    score(mir_storage::take(mir_storage::write(mir_storage::empty(), 7)))
        + score(mir_storage::take(mir_storage::empty()))
        + score_move(mir_storage::move_out(mir_storage::write(mir_storage::empty(), 5)))
        + score_move(mir_storage::move_out(mir_storage::empty()))
        + score_bool(mir_storage::was_moved(mir_storage::empty()))
        + score(mir_storage::take(mir_storage::write_after_move(mir_storage::move_out(mir_storage::write(mir_storage::empty(), 2)), 1)))
        + score_move(mir_storage::move_out(mir_storage::Slot::Moved))
        + score(mir_storage::take(mir_storage::write(mir_storage::Slot::Moved, 9)))
        + score_cleanup(mir_storage::cleanup(mir_storage::write(mir_storage::empty(), 7)))
        + score_cleanup(mir_storage::cleanup(mir_storage::empty()))
        + score_cleanup(mir_storage::cleanup(mir_storage::Slot::Moved))
        + score_replace(mir_storage::replace(mir_storage::empty(), 3))
        + score_replace(mir_storage::replace(mir_storage::write(mir_storage::empty(), 5), 9))
        + score_field_move(mir_storage::move_field(field_slots(), 1))
        + score_field_move(move_field_again(mir_storage::move_field(field_slots(), 1), 2))
        + score_field_move(mir_storage::move_field(write_after_field_move(mir_storage::move_field(field_slots(), 1), 1, 9), 1))
        + score_field_empty(move_field_again(mir_storage::move_field(field_slots(), 1), 1))
        + score_nested_move(mir_storage::move_nested_field(nested_slots(), nested_target()))
        + score_nested_move(nested_again(mir_storage::move_nested_field(nested_slots(), nested_target()), nested_first_child()))
        + nested_empty_score(nested_again(mir_storage::move_nested_field(nested_slots(), nested_target()), nested_parent()))
        + score_nested_move(mir_storage::move_nested_field(write_nested_again(mir_storage::move_nested_field(nested_slots(), nested_target()), nested_target(), 9), nested_target()))
        + score_nested_move(mir_storage::move_nested_field(write_nested_again(mir_storage::move_nested_field(nested_slots(), nested_target()), nested_target(), 9), nested_parent()))
}
