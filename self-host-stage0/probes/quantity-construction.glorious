use quantity_library::quantity;

pub fn score(result: quantity::QuantityResult) -> i64 {
    handle result {
        quantity::QuantityResult::Value(_) => 1,
        quantity::QuantityResult::Error(_) => 0,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(quantity::new(2, quantity::QuantityUpper::Finite(3)))
        + score(quantity::new(3, quantity::QuantityUpper::Finite(2)))
        + score(quantity::new(9, quantity::QuantityUpper::Infinite))
}
