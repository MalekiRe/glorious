use service_library::service;
use service_library::body;
use service_library::types;
use service_library::vm_backend;
use compiler_support::__g1_int_wrapping_add;

pub fn score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(7) => 1,
        vm_backend::Execution::Faulted => 10,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(service::compile_i64_literal(7, types::Type::I64))
        + score(service::compile_i64_literal(7, types::Type::Bool))
        + bool_score(service::compile_bool_literal(true, types::Type::Bool))
        + bool_score(service::compile_bool_literal(false, types::Type::Bool))
        + bool_score(service::compile_bool_not(true, types::Type::Bool))
        + bool_score(service::compile_bool_not(false, types::Type::Bool))
        + bool_fault_score(service::compile_bool_not(true, types::Type::I64))
        + identity_call_score(service::compile_i64_identity_call(42, types::Type::I64))
        + identity_call_score(service::compile_i64_identity_call(42, types::Type::Bool))
        + add_call_score(service::compile_i64_add_call(20, 22, types::Type::I64))
        + add_call_score(service::compile_i64_add_call(20, 22, types::Type::Bool))
        + pattern_true_score(service::compile_bool_is_true(true, types::Type::Bool))
        + pattern_false_score(service::compile_bool_is_true(false, types::Type::Bool))
        + pattern_true_score(service::compile_i64_equals(42, 42, types::Type::Bool))
        + pattern_false_score(service::compile_i64_equals(42, 43, types::Type::Bool))
        + pattern_true_score(service::compile_i64_pair_first_equals(42, 42, 7, types::Type::Bool))
        + pattern_false_score(service::compile_i64_pair_first_equals(42, 43, 7, types::Type::Bool))
        + pattern_true_score(service::compile_i64_pair_second_equals(42, 7, 42, types::Type::Bool))
        + pattern_false_score(service::compile_i64_pair_second_equals(42, 7, 43, types::Type::Bool))
        + pattern_true_score(service::compile_i64_variant_equals(2, 42, 2, 42, types::Type::Bool))
        + pattern_false_score(service::compile_i64_variant_equals(2, 42, 2, 43, types::Type::Bool))
        + add_score(service::compile_i64_arithmetic(body::Arithmetic::Add, 20, 22, types::Type::I64))
        + add_score(service::compile_i64_arithmetic(body::Arithmetic::Add, 20, 22, types::Type::Bool))
        + subtract_score(service::compile_i64_arithmetic(body::Arithmetic::Subtract, 84, 42, types::Type::I64))
        + multiply_score(service::compile_i64_arithmetic(body::Arithmetic::Multiply, 6, 7, types::Type::I64))
        + divide_score(service::compile_i64_arithmetic(body::Arithmetic::Divide, 84, 2, types::Type::I64))
        + divide_score(service::compile_i64_arithmetic(body::Arithmetic::Divide, 84, 0, types::Type::I64))
        + overflow_score(service::compile_i64_arithmetic(body::Arithmetic::Add, 9223372036854775807, 1, types::Type::I64))
        + division_hazard_score(service::compile_i64_arithmetic(body::Arithmetic::Divide, __g1_int_wrapping_add<i64>(-9223372036854775807, -1), -1, types::Type::I64))
        + comparison_true_score(service::compile_i64_comparison(body::Comparison::Equal, 42, 42, types::Type::Bool))
        + comparison_false_score(service::compile_i64_comparison(body::Comparison::Less, 42, 7, types::Type::Bool))
        + comparison_true_score(service::compile_i64_comparison(body::Comparison::Greater, 42, 7, types::Type::Bool))
        + comparison_fault_score(service::compile_i64_comparison(body::Comparison::Equal, 42, 42, types::Type::I64))
        + select_true_score(service::compile_i64_select(true, 42, 7, types::Type::I64))
        + select_false_score(service::compile_i64_select(false, 42, 7, types::Type::I64))
        + select_fault_score(service::compile_i64_select(true, 42, 7, types::Type::Bool))
}

pub fn add_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(42) => 10000,
        vm_backend::Execution::Faulted => 100000,
        _ => 0,
    }
}

pub fn subtract_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(42) => 100000000000000000,
        _ => 0,
    }
}

pub fn multiply_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(42) => 1000000,
        _ => 0,
    }
}

pub fn divide_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(42) => 10000000,
        vm_backend::Execution::Faulted => 100000000,
        _ => 0,
    }
}

pub fn overflow_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(result) => handle result < 0 {
            true => 1000000000,
            false => 0,
            _ => 0,
        },
        _ => 0,
    }
}

pub fn division_hazard_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Faulted => 10000000000,
        _ => 0,
    }
}

pub fn comparison_true_score(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::Returned(1) => 1000000000000, _ => 0 } }
pub fn comparison_false_score(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::Returned(0) => 10000000000000, _ => 0 } }
pub fn comparison_fault_score(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::Faulted => 100000000000000, _ => 0 } }
pub fn select_true_score(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::Returned(42) => 1000000000000000, _ => 0 } }
pub fn select_false_score(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::Returned(7) => 10000000000000000, _ => 0 } }
pub fn select_fault_score(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::Faulted => 100000000000000000, _ => 0 } }

pub fn pattern_true_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(1) => 100000000000,
        _ => 0,
    }
}

pub fn pattern_false_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(0) => 1000000000000,
        _ => 0,
    }
}

pub fn identity_call_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(42) => 10000000000000,
        vm_backend::Execution::Faulted => 100000000000000,
        _ => 0,
    }
}

pub fn add_call_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(42) => 1000000000000000,
        vm_backend::Execution::Faulted => 10000000000000000,
        _ => 0,
    }
}




pub fn bool_score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(1) => 100,
        vm_backend::Execution::Returned(0) => 1000,
        _ => 0,
    }
}

pub fn bool_fault_score(value: vm_backend::Execution) -> i64 {
    handle value { vm_backend::Execution::Faulted => 10000, _ => 0 }
}
