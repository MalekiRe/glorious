use resolution_library::resolution;
use resolution_library::interface;
use resolution_library::source;
use resolution_library::identity;
use resolution_library::scanner;
use compiler_support::__g1_text_as_bytes;

pub fn score(value: Bool) -> i64 {
    handle value {
        true => 1,
        false => 0,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(resolution::visible_from(
        resolution::binding("pkg", "pkg.root", resolution::Visibility::Public),
        "other", "other.module"))
        + score(resolution::visible_from(
            resolution::binding("pkg", "pkg.root", resolution::Visibility::Package),
            "pkg", "pkg.child"))
        + score(resolution::visible_from(
            resolution::binding("pkg", "pkg.root", resolution::Visibility::Private),
            "pkg", "pkg.root"))
        + score(resolution::visible_from(
            resolution::binding("pkg", "pkg.root", resolution::Visibility::Private),
            "pkg", "pkg.child"))
        + score(resolution::visible_from(
            resolution::binding_from_definition("pkg", "pkg.root", interface::definition(interface::DefinitionKind::Function, true)),
            "other", "other.module"))
        + score(resolution::visible_from(
            resolution::binding_from_definition("pkg", "pkg.root", interface::definition(interface::DefinitionKind::Implementation, true)),
            "pkg", "pkg.child"))
        + score_admission(resolution::binding_from_header("pkg", "pkg.root", __g1_text_as_bytes("pub fn exported")), "other", "other.module")
        + score_admission(resolution::binding_from_header("pkg", "pkg.root", __g1_text_as_bytes("fn private")), "pkg", "pkg.root")
        + score_admission(resolution::binding_from_header("pkg", "pkg.root", __g1_text_as_bytes("value")), "pkg", "pkg.root")
        + score_lookup(resolution::lookup(resolution::binding("pkg", "pkg.root", resolution::Visibility::Private), "pkg", "pkg.root"))
        + score_lookup(resolution::lookup(resolution::binding("pkg", "pkg.root", resolution::Visibility::Private), "pkg", "pkg.child"))
        + score_named_lookup(resolution::lookup_named(resolution::named_binding("local", "pkg", "pkg.root", resolution::Visibility::Private), "local", "pkg", "pkg.root"))
        + score_named_lookup(resolution::lookup_named(resolution::named_binding("local", "pkg", "pkg.root", resolution::Visibility::Private), "local", "pkg", "pkg.child"))
        + score_named_lookup(resolution::lookup_named(resolution::named_binding("local", "pkg", "pkg.root", resolution::Visibility::Private), "other", "pkg", "pkg.root"))
        + score_named_lookup(resolution::lookup_bindings(
            resolution::prepend_binding(
                resolution::named_binding("other", "pkg", "pkg.root", resolution::Visibility::Public),
                resolution::single_binding(resolution::named_binding("local", "pkg", "pkg.root", resolution::Visibility::Private))),
            "local", "pkg", "pkg.root"))
        + score_named_lookup(resolution::lookup_bindings(
            resolution::prepend_binding(
                resolution::named_binding("other", "pkg", "pkg.root", resolution::Visibility::Public),
                resolution::single_binding(resolution::named_binding("local", "pkg", "pkg.root", resolution::Visibility::Private))),
            "local", "pkg", "pkg.child"))
        + score_named_lookup(resolution::lookup_bindings(
            resolution::single_binding(resolution::named_binding("local", "pkg", "pkg.root", resolution::Visibility::Private)),
            "absent", "pkg", "pkg.root"))
        + source_binding_lookup_score(
            resolution::source_binding_from_header_checked("pkg", "pkg.root", source::input(
                "pkg", "src/visible.glorious", __g1_text_as_bytes("pub fn visible"), identity::digest_of_text("pub fn visible"))),
            scanner::token_digest(__g1_text_as_bytes("visible"), scanner::first_token(__g1_text_as_bytes("visible"))),
            "other", "other.module")
        + source_binding_lookup_score(
            resolution::source_binding_from_header_checked("pkg", "pkg.root", source::input(
                "pkg", "src/local.glorious", __g1_text_as_bytes("fn local"), identity::digest_of_text("fn local"))),
            scanner::token_digest(__g1_text_as_bytes("local"), scanner::first_token(__g1_text_as_bytes("local"))),
            "pkg", "pkg.child")
        + source_binding_lookup_score(
            resolution::source_binding_from_header_checked("pkg", "pkg.root", source::input(
                "pkg", "src/missing.glorious", __g1_text_as_bytes("fn local"), identity::digest_of_text("fn local"))),
            scanner::token_digest(__g1_text_as_bytes("absent"), scanner::first_token(__g1_text_as_bytes("absent"))),
            "pkg", "pkg.root")
}

pub fn score_admission(value: resolution::BindingAdmission, package: Text, module: Text) -> i64 {
    handle value {
        resolution::BindingAdmission::Value(binding) => score(resolution::visible_from(binding, package, module)),
        resolution::BindingAdmission::NotDeclaration => 0,
        _ => 0,
    }
}

pub fn score_lookup(value: resolution::Lookup) -> i64 {
    handle value { resolution::Lookup::Resolved => 1, resolution::Lookup::Inaccessible => 0, resolution::Lookup::Missing => 0, _ => 0 }
}

pub fn score_named_lookup(value: resolution::Lookup) -> i64 {
    handle value { resolution::Lookup::Resolved => 1, resolution::Lookup::Inaccessible => 10, resolution::Lookup::Missing => 100, _ => 0 }
}

pub fn source_binding_lookup_score(value: resolution::SourceBindingAdmission, name: identity::Digest, package: Text, module: Text) -> i64 {
    handle value {
        resolution::SourceBindingAdmission::Value(binding) => score_named_lookup(resolution::lookup_source_bindings(
            resolution::single_source_binding(binding), name, package, module)),
        resolution::SourceBindingAdmission::NotDeclaration => 0,
        _ => 0,
    }
}
