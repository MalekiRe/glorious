use bootstrap_indirection_library::bootstrap_indirection;

pub fn score(value: Bool) -> i64 {
    handle value {
        true => 1,
        false => 0,
        _ => 0,
    }
}

pub fn main() -> i64 {
    bootstrap_indirection::length(bootstrap_indirection::prepend(1,
        bootstrap_indirection::prepend(2, bootstrap_indirection::singleton(3))))
        + score(bootstrap_indirection::contains(bootstrap_indirection::prepend(1,
            bootstrap_indirection::prepend(2, bootstrap_indirection::singleton(3))), 2))
        + score(bootstrap_indirection::contains(bootstrap_indirection::prepend(1,
            bootstrap_indirection::prepend(2, bootstrap_indirection::singleton(3))), 9))
        + score(bootstrap_indirection::text_same("module", "module"))
        + score(bootstrap_indirection::text_contains(
            bootstrap_indirection::text_prepend("root",
                bootstrap_indirection::text_singleton("child")),
            "child"))
}
