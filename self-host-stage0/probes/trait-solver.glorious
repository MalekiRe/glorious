use trait_solver_library::trait_solver;
use trait_solver_library::types;
use trait_solver_library::coherence;

pub fn score(value: trait_solver::Answer) -> i64 {
    handle value {
        trait_solver::Answer::Satisfied(_) => 1,
        trait_solver::Answer::Refuted(_) => 10,
        trait_solver::Answer::Unsatisfied => 0,
        trait_solver::Answer::Ambiguous => 100,
        trait_solver::Answer::Overflow => 1000,
        _ => 0,
    }
}

pub fn unsatisfied_score(value: trait_solver::Answer) -> i64 {
    handle value {
        trait_solver::Answer::Unsatisfied => 1,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(trait_solver::solve(
        trait_solver::implementation("Show", types::Type::I64),
        trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve(
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Eq", types::Type::I64)))
        + score(trait_solver::solve(
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::U64)))
        + score(trait_solver::solve(
            trait_solver::negative_implementation("Show", types::Type::U8),
            trait_solver::goal("Show", types::Type::U8)))
        + score(trait_solver::solve(
            trait_solver::implementation("Show", types::Type::Projection("Item", 2)),
            trait_solver::goal("Show", types::Type::Projection("Item", 2))))
        + score(trait_solver::solve(
            trait_solver::generic_implementation(40, "Show"),
            trait_solver::goal("Show", types::shared_borrow(types::Lifetime::Static, 64))))
        + score(trait_solver::solve(
            trait_solver::generic_negative_implementation(41, "Blocked"),
            trait_solver::goal("Blocked", types::Type::I64)))
        + score(trait_solver::solve_pair(
            trait_solver::identified_implementation(42, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::generic_implementation(43, "Show"),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_generic_with_where(
            trait_solver::generic_implementation(44, "Show"),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::implementation("Bound", types::Type::I64),
            trait_solver::goal("Bound", types::Type::I64)))
        + score(trait_solver::solve_generic_with_where(
            trait_solver::generic_implementation(45, "Show"),
            trait_solver::goal("Show", types::Type::U8),
            trait_solver::implementation("Bound", types::Type::I64),
            trait_solver::goal("Bound", types::Type::U8)))
        + score(trait_solver::solve_pair(
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::negative_implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_pair(
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::negative_implementation("Show", types::Type::U8),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_pair(
            trait_solver::identified_implementation(11, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::identified_implementation(12, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_pair(
            trait_solver::identified_implementation(13, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::identified_implementation(13, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_three(
            trait_solver::identified_implementation(21, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::identified_implementation(22, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::negative_implementation("Show", types::Type::U8),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_three(
            trait_solver::identified_implementation(23, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::identified_implementation(23, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::identified_implementation(23, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_with_step_limit(
            0,
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_pair_with_step_limit(
            1,
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_pair_with_step_limit(
            2,
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::implementation("Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_prefer_exact_receiver(
            trait_solver::identified_implementation(30, "Show", types::shared_borrow(types::Lifetime::Static, 64)),
            trait_solver::goal("Show", types::shared_borrow(types::Lifetime::Static, 64)),
            trait_solver::identified_implementation(31, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve_prefer_exact_receiver(
            trait_solver::identified_implementation(32, "Show", types::Type::I64),
            trait_solver::goal("Show", types::shared_borrow(types::Lifetime::Static, 64)),
            trait_solver::identified_implementation(33, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64)))
        + score(trait_solver::solve(
            trait_solver::identified_implementation(34, "Show", types::shared_borrow(types::Lifetime::Static, 64)),
            trait_solver::goal("Show", types::shared_borrow(types::Lifetime::Static, 65))))
        + score(trait_solver::solve(
            trait_solver::identified_implementation_with_arguments(
                50,
                "Convert",
                types::Type::I64,
                coherence::single_trait_argument(types::type_argument(types::Type::I64))),
            trait_solver::goal_with_arguments(
                "Convert",
                types::Type::I64,
                coherence::single_trait_argument(types::type_argument(types::Type::I64)))))
        + unsatisfied_score(trait_solver::solve(
            trait_solver::identified_implementation_with_arguments(
                51,
                "Convert",
                types::Type::I64,
                coherence::single_trait_argument(types::type_argument(types::Type::I64))),
            trait_solver::goal_with_arguments(
                "Convert",
                types::Type::I64,
                coherence::single_trait_argument(types::type_argument(types::Type::U64)))))
        + score(trait_solver::solve_candidates(trait_solver::prepend_candidate(
            trait_solver::identified_implementation(60, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::single_candidate(
                trait_solver::generic_implementation(60, "Show"),
                trait_solver::goal("Show", types::Type::I64)))))
        + score(trait_solver::solve_candidates(trait_solver::prepend_candidate(
            trait_solver::identified_implementation(61, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::single_candidate(
                trait_solver::identified_implementation(62, "Show", types::Type::I64),
                trait_solver::goal("Show", types::Type::I64)))))
        + unsatisfied_score(trait_solver::solve_candidates(trait_solver::prepend_candidate(
            trait_solver::identified_implementation(63, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::single_candidate(
                trait_solver::negative_implementation("Show", types::Type::I64),
                trait_solver::goal("Show", types::Type::I64)))))
        + score(trait_solver::solve_candidates_with_step_limit(1, trait_solver::prepend_candidate(
            trait_solver::identified_implementation(64, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::single_candidate(
                trait_solver::identified_implementation(64, "Show", types::Type::I64),
                trait_solver::goal("Show", types::Type::I64)))))
        + score(trait_solver::solve_candidates_with_step_limit(2, trait_solver::prepend_candidate(
            trait_solver::identified_implementation(65, "Show", types::Type::I64),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::single_candidate(
                trait_solver::identified_implementation(65, "Show", types::Type::I64),
                trait_solver::goal("Show", types::Type::I64)))))
        + score(trait_solver::solve_generic_with_obligations(
            trait_solver::generic_implementation(70, "Show"),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::prepend_candidate(
                trait_solver::implementation("Bound", types::Type::I64),
                trait_solver::goal("Bound", types::Type::I64),
                trait_solver::single_candidate(
                    trait_solver::implementation("Other", types::Type::I64),
                    trait_solver::goal("Other", types::Type::I64)))))
        + unsatisfied_score(trait_solver::solve_generic_with_obligations(
            trait_solver::generic_implementation(71, "Show"),
            trait_solver::goal("Show", types::Type::I64),
            trait_solver::prepend_candidate(
                trait_solver::implementation("Bound", types::Type::I64),
                trait_solver::goal("Bound", types::Type::I64),
                trait_solver::single_candidate(
                    trait_solver::implementation("Other", types::Type::I64),
                    trait_solver::goal("Other", types::Type::U8)))))
        + score(trait_solver::solve(
            trait_solver::generic_implementation_with_arguments(
                72,
                "Convert",
                coherence::single_trait_argument(types::type_argument(types::Type::Generic(1)))),
            trait_solver::goal_with_arguments(
                "Convert",
                types::Type::I64,
                coherence::single_trait_argument(types::type_argument(types::Type::I64)))))
        + unsatisfied_score(trait_solver::solve(
            trait_solver::generic_implementation_with_arguments(
                73,
                "Pair",
                coherence::prepend_trait_argument(
                    types::type_argument(types::Type::Generic(2)),
                    coherence::single_trait_argument(types::type_argument(types::Type::Generic(2))))),
            trait_solver::goal_with_arguments(
                "Pair",
                types::Type::I64,
                coherence::prepend_trait_argument(
                    types::type_argument(types::Type::I64),
                    coherence::single_trait_argument(types::type_argument(types::Type::U64))))))
        + score(trait_solver::solve(
            trait_solver::generic_implementation_with_arguments(
                74,
                "Mirror",
                coherence::single_trait_argument(types::type_argument(types::Type::Generic(0)))),
            trait_solver::goal_with_arguments(
                "Mirror",
                types::Type::I64,
                coherence::single_trait_argument(types::type_argument(types::Type::I64)))))
        + unsatisfied_score(trait_solver::solve(
            trait_solver::generic_implementation_with_arguments(
                75,
                "Mirror",
                coherence::single_trait_argument(types::type_argument(types::Type::Generic(0)))),
            trait_solver::goal_with_arguments(
                "Mirror",
                types::Type::I64,
                coherence::single_trait_argument(types::type_argument(types::Type::U64)))))
        + score(trait_solver::solve(
            trait_solver::generic_implementation_with_arguments(
                76,
                "Region",
                coherence::single_trait_argument(types::lifetime_argument(types::Lifetime::Generic(8)))),
            trait_solver::goal_with_arguments(
                "Region",
                types::Type::I64,
                coherence::single_trait_argument(types::lifetime_argument(types::Lifetime::Static)))))
        + unsatisfied_score(trait_solver::solve(
            trait_solver::generic_implementation_with_arguments(
                77,
                "SameRegion",
                coherence::prepend_trait_argument(
                    types::lifetime_argument(types::Lifetime::Generic(9)),
                    coherence::single_trait_argument(types::lifetime_argument(types::Lifetime::Generic(9))))),
            trait_solver::goal_with_arguments(
                "SameRegion",
                types::Type::I64,
                coherence::prepend_trait_argument(
                    types::lifetime_argument(types::Lifetime::Static),
                    coherence::single_trait_argument(types::lifetime_argument(types::Lifetime::Elided))))))
}
