use useflow_library::useflow;
use useflow_library::placeflow;
pub fn score(value: useflow::ConsumeResult) -> i64 { handle value { useflow::ConsumeResult::Value(state) => useflow::remaining(state), useflow::ConsumeResult::Exhausted => 0, _ => 0 } }
pub fn bool_score(value: Bool) -> i64 { handle value { true => 1, false => 0, _ => 0 } }
pub fn false_score(value: Bool) -> i64 { handle value { true => 0, false => 1, _ => 0 } }
pub fn field_states() -> placeflow::FieldStates { placeflow::prepend_field(placeflow::available(), placeflow::prepend_field(placeflow::available(), placeflow::single_field(placeflow::available()))) }
pub fn moved_field_states(value: placeflow::FieldMoveAdmission) -> placeflow::FieldStates { handle value { placeflow::FieldMoveAdmission::Value(fields) => fields, _ => placeflow::empty_fields() } }
pub fn nested_fields() -> placeflow::NestedFieldStates { placeflow::nested_prepend_field(placeflow::available(), placeflow::nested_prepend_field(placeflow::available(), placeflow::nested_empty_fields(), placeflow::nested_single_field(placeflow::available())), placeflow::nested_single_field(placeflow::available())) }
pub fn nested_target() -> placeflow::ProjectionPath { placeflow::path_then(0, placeflow::path_field(1)) }
pub fn nested_sibling() -> placeflow::ProjectionPath { placeflow::path_then(0, placeflow::path_field(0)) }
pub fn moved_nested_fields(value: placeflow::NestedMoveAdmission) -> placeflow::NestedFieldStates { handle value { placeflow::NestedMoveAdmission::Value(fields) => fields, _ => placeflow::nested_empty_fields() } }
pub fn reinitialized_nested_fields(value: placeflow::NestedMoveAdmission) -> placeflow::NestedFieldStates { handle value { placeflow::NestedMoveAdmission::Value(fields) => placeflow::initialize_path(fields, nested_target()), _ => placeflow::nested_empty_fields() } }
pub fn main() -> i64 {
    score(useflow::consume(useflow::uses(2)))
        + score(useflow::consume(useflow::uses(0)))
        + useflow::remaining(useflow::join(useflow::uses(2), useflow::uses(5)))
        + useflow::remaining(useflow::join(useflow::uses(0), useflow::uses(2)))
        + handle useflow::remaining(useflow::uses(-1)) == 0 { true => 1, false => 0, _ => 0 }
        + handle useflow::bounded(1, 3) { useflow::UseConstruction::Value(_) => 1, useflow::UseConstruction::Invalid => 0, _ => 0 }
        + handle useflow::bounded(3, 1) { useflow::UseConstruction::Invalid => 1, useflow::UseConstruction::Value(_) => 0, _ => 0 }
        + handle useflow_library::remains_permitted_after_one(useflow::at_least(1)) { true => 1, false => 0, _ => 0 }
        + score_place_consume(useflow::consume_from_place(placeflow::available(), useflow::uses(1)))
        + score_place_consume(useflow::consume_from_place(placeflow::move_out(placeflow::available()), useflow::uses(1)))
        + score_place_consume(useflow::consume_from_place(placeflow::available(), useflow::uses(0)))
        + bool_score(useflow::contains(useflow::bounded_value(0, 1), useflow::uses(0)))
        + bool_score(useflow::contains(useflow::bounded_value(0, 1), useflow::uses(1)))
        + false_score(useflow::contains(useflow::bounded_value(0, 1), useflow::uses(2)))
        + false_score(useflow::contains(useflow::uses(1), useflow::bounded_value(0, 1)))
        + bool_score(useflow::contains(useflow::at_least(0), useflow::uses(3)))
        + bool_score(useflow::is_public_principal_use(useflow::at_least(0)))
        + bool_score(useflow::is_public_principal_use(useflow::bounded_value(0, 1)))
        + bool_score(useflow::is_public_principal_use(useflow::uses(1)))
        + false_score(useflow::is_public_principal_use(useflow::uses(0)))
        + score_place_consume(useflow::consume_from_field(field_states(), 2, useflow::uses(1)))
        + score_place_consume(useflow::consume_from_field(moved_field_states(placeflow::move_field_checked(field_states(), 1)), 1, useflow::uses(1)))
        + score_place_consume(useflow::consume_from_field(moved_field_states(placeflow::move_field_checked(field_states(), 1)), 2, useflow::uses(1)))
        + score_place_consume(useflow::consume_from_path(nested_fields(), nested_target(), useflow::uses(1)))
        + score_place_consume(useflow::consume_from_path(moved_nested_fields(placeflow::move_path_checked(nested_fields(), nested_target())), nested_target(), useflow::uses(1)))
        + score_place_consume(useflow::consume_from_path(moved_nested_fields(placeflow::move_path_checked(nested_fields(), nested_target())), nested_sibling(), useflow::uses(1)))
        + score_place_consume(useflow::consume_from_path(reinitialized_nested_fields(placeflow::move_path_checked(nested_fields(), nested_target())), nested_target(), useflow::uses(1)))
}

pub fn score_place_consume(value: useflow::PlaceConsume) -> i64 { handle value { useflow::PlaceConsume::Value(_) => 1, useflow::PlaceConsume::PlaceUnavailable => 10, useflow::PlaceConsume::Exhausted => 100, _ => 0 } }
