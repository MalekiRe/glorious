use compiler_support::__g1_bytes_from_array_move;

pub fn score(value: vm_backend::Execution) -> i64 {
    handle value {
        vm_backend::Execution::Returned(number) => number,
        vm_backend::Execution::Faulted => 100,
        _ => 0,
    }
}
pub fn score_negative_seven(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::Returned(number) => __g1_int_wrapping_add<i64>(number, 7), vm_backend::Execution::Faulted => 100, _ => 100 } }
pub fn score_static_len(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::ReturnedUsize(number) => number, vm_backend::Execution::Faulted => 100, _ => 100 } }
pub fn score_static_byte(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::ReturnedU32(number) => number, vm_backend::Execution::Faulted => 100, _ => 100 } }
pub fn score_static_fault(value: vm_backend::Execution) -> i64 { handle value { vm_backend::Execution::Faulted => 1, _ => 0 } }
pub fn static_utf8_input() -> source::SourceInput { source::input("service", "static-utf8-ops", __g1_text_as_bytes("\"sealed\""), identity::digest_of_text("\"sealed\"")) }
pub fn static_raw_input() -> source::SourceInput { source::input("service", "static-raw-ops", __g1_text_as_bytes("b\"raw\""), identity::digest_of_text("b\"raw\"")) }

pub fn main() -> i64 {
    score(service::compile_source_i64_literal(source::input("service", "decimal", __g1_text_as_bytes("1_234"), identity::digest_of_text("1_234"))))
        + score_negative_seven(service::compile_source_i64_literal(source::input("service", "negative", __g1_text_as_bytes("-7"), identity::digest_of_text("-7"))))
        + score(service::compile_source_i64_literal(source::input("service", "trailing-literal", __g1_text_as_bytes("7 trailing"), identity::digest_of_text("7 trailing"))))
        + score(service::compile_source_i64_literal(source::input("service", "radix", __g1_text_as_bytes("0x7"), identity::digest_of_text("0x7"))))
        + score(service::compile_source_i64_literal(source::input("service", "forged", __g1_text_as_bytes("7"), identity::digest_of_text("8"))))
        + score(service::compile_source_bool_literal(source::input("service", "true", __g1_text_as_bytes("true"), identity::digest_of_text("true"))))
        + score(service::compile_source_bool_literal(source::input("service", "false", __g1_text_as_bytes("false"), identity::digest_of_text("false"))))
        + score(service::compile_source_bool_literal(source::input("service", "identifier", __g1_text_as_bytes("truth"), identity::digest_of_text("truth"))))
        + score(service::compile_source_i64_arithmetic(source::input("service", "addition", __g1_text_as_bytes("1_000 + 234"), identity::digest_of_text("1_000 + 234"))))
        + score(service::compile_source_i64_arithmetic(source::input("service", "division", __g1_text_as_bytes("8 / 2"), identity::digest_of_text("8 / 2"))))
        + score(service::compile_source_i64_arithmetic(source::input("service", "trailing", __g1_text_as_bytes("1 + 2 3"), identity::digest_of_text("1 + 2 3"))))
        + score(service::compile_source_i64_comparison(source::input("service", "equal", __g1_text_as_bytes("7 == 7"), identity::digest_of_text("7 == 7"))))
        + score(service::compile_source_i64_comparison(source::input("service", "less", __g1_text_as_bytes("2 < 5"), identity::digest_of_text("2 < 5"))))
        + score(service::compile_source_i64_comparison(source::input("service", "greater", __g1_text_as_bytes("5 > 2"), identity::digest_of_text("5 > 2"))))
        + score(service::compile_source_i64_comparison(source::input("service", "signed-less", __g1_text_as_bytes("-7 < 3"), identity::digest_of_text("-7 < 3"))))
        + score(service::compile_source_i64_comparison(source::input("service", "unsupported", __g1_text_as_bytes("2 <= 5"), identity::digest_of_text("2 <= 5"))))
        + score_static_len(service::compile_source_static_utf8_len(source::input("service", "static-utf8", __g1_text_as_bytes("\"sealed\""), identity::digest_of_text("\"sealed\""))))
        + score_static_len(service::compile_source_static_raw_len(source::input("service", "static-raw", __g1_text_as_bytes("b\"raw\""), identity::digest_of_text("b\"raw\""))))
        + score_static_len(service::compile_source_static_utf8_len(source::input("service", "static-unicode", __g1_bytes_from_array_move([34, 92, 117, 123, 49, 70, 54, 48, 48, 125, 34]), identity::digest_of_bytes(__g1_bytes_from_array_move([34, 92, 117, 123, 49, 70, 54, 48, 48, 125, 34])))))
        + score_static_len(service::compile_source_static_utf8_subslice_len(static_utf8_input(), 1, 3))
        + score_static_len(service::compile_source_static_raw_subslice_len(static_raw_input(), 1, 2))
        + score_static_byte(service::compile_source_static_utf8_get_shared(static_utf8_input(), 2))
        + score_static_byte(service::compile_source_static_raw_get_shared(static_raw_input(), 1))
        + score_static_fault(service::compile_source_static_utf8_subslice_len(static_utf8_input(), 5, 2))
        + score_static_fault(service::compile_source_static_raw_get_shared(static_raw_input(), 3))
}
