use quantity_library::quantity;

pub fn score(result: quantity::QuantityResult) -> i64 {
    handle result {
        quantity::QuantityResult::Value(_) => 1,
        quantity::QuantityResult::Error(_) => 0,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(quantity::intersection(quantity::affine(), quantity::once()))
        + score(quantity::intersection(quantity::exact(1), quantity::exact(3)))
}
