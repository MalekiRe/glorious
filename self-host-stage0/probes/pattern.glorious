use pattern_library::pattern;

pub fn score(value: Bool) -> i64 {
    handle value { true => 1, false => 0, _ => 0 }
}
pub fn score_detail(value: pattern::StructuralMatch) -> i64 { handle value { pattern::StructuralMatch::Exact => 1, pattern::StructuralMatch::FirstSelected => 10, pattern::StructuralMatch::SecondSelected => 100, pattern::StructuralMatch::No => 0, _ => 0 } }

pub fn main() -> i64 {
    score(pattern::matches(pattern::Pattern::Any, pattern::Value::I64(9)))
        + score(pattern::matches(pattern::Pattern::Bind("value"), pattern::Value::Bool(false)))
        + score(pattern::matches(pattern::Pattern::Bool(true), pattern::Value::Bool(true)))
        + score(pattern::matches(pattern::Pattern::I64(4), pattern::Value::I64(4)))
        + score(pattern::matches(pattern::Pattern::U8(4), pattern::Value::U8(4)))
        + score(pattern::matches(pattern::Pattern::U32(4), pattern::Value::U32(4)))
        + score(pattern::matches(pattern::Pattern::U64(4), pattern::Value::U64(4)))
        + score(pattern::matches(pattern::Pattern::Usize(4), pattern::Value::Usize(4)))
        + score(pattern::matches(pattern::Pattern::I64(4), pattern::Value::I64(5)))
        + score(pattern::matches(pattern::Pattern::Pair(3, 4), pattern::Value::Pair(3, 4)))
        + score(pattern::matches(pattern::Pattern::PairFirst(3), pattern::Value::Pair(3, 9)))
        + score(pattern::matches(pattern::Pattern::PairSecond(9), pattern::Value::Pair(3, 9)))
        + score(pattern::matches(pattern::Pattern::Variant(2, 7), pattern::Value::Variant(2, 7)))
        + score_detail(pattern::match_detail(pattern::Pattern::PairFirst(3), pattern::Value::Pair(3, 9)))
        + score_detail(pattern::match_detail(pattern::Pattern::PairSecond(9), pattern::Value::Pair(3, 9)))
        + score_detail(pattern::match_detail(pattern::Pattern::Variant(2, 7), pattern::Value::Variant(2, 8)))
}
