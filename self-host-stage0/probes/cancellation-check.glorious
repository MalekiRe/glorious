use operation_library::operation;

pub fn score(result: operation::CancellationResult) -> i64 {
    handle result {
        operation::CancellationResult::Active => 1,
        operation::CancellationResult::Cancelled => 0,
        _ => 0,
    }
}

pub fn main() -> i64 {
    score(operation::check(operation::active()))
        + score(operation::check(operation::cancel(operation::active())))
}
