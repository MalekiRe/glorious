  ⟨"struct Col<T> { items: [T] }\nstruct World { a: Col<Int>, b: Col<Str> }\ntrait Get<T> { fn take(&mut Self) -> Col<T>; fn put(&mut Self, Col<T>); }\nimpl Get<Int> for World { fn take(w) { let c = w.a; w.a = Col { items: [] }; c } fn put(w, c) { w.a = c } }\nimpl Get<Str> for World { fn take(w) { let c = w.b; w.b = Col { items: [] }; c } fn put(w, c) { w.b = c } }\n\n// What a parameter of a system is, without the reference: which column, and whether to change it.\nstruct Changed<A>(A)\nstruct Read<A>(A)\ntrait Kind { type Marker; }\nimpl<A> Kind for &mut Col<A> { type Marker = Changed<A>; }\nimpl<A> Kind for &Col<A> { type Marker = Read<A>; }\n\n// A function called with what was gathered for it, last first.\ntrait CallWith<Gathered> { fn call_gathered(&Self, Gathered) }\nimpl<P> CallWith<((), P)> for fn(P) -> () { fn call_gathered(f, g) { (*f)(g.1) } }\nimpl<P, Q> CallWith<(((), P), Q)> for fn(P, Q) -> () { fn call_gathered(f, g) { (*f)(g.0.1, g.1) } }\n\n// The columns a list of markers names, each taken out of the world, lent, and put back.\ntrait Fetch<W, Gathered, F> { fn fetch(&mut W, Gathered, &F) }\nimpl<W, G, F> Fetch<W, G, F> for () where F: CallWith<G> {\n    fn fetch(world, gathered, f) { call_gathered(f, gathered) }\n}\nimpl<W, G, F, A, Rest> Fetch<W, G, F> for (Changed<A>, Rest) where W: Get<A>, Rest: Fetch<W, (G, &mut Col<A>), F> {\n    fn fetch(world, gathered, f) {\n        let mut a = <W as Get<A>>::take(world);\n        <Rest as Fetch<W, (G, &mut Col<A>), F>>::fetch(world, (gathered, &mut a), f);\n        <W as Get<A>>::put(world, a)\n    }\n}\nimpl<W, G, F, A, Rest> Fetch<W, G, F> for (Read<A>, Rest) where W: Get<A>, Rest: Fetch<W, (G, &Col<A>), F> {\n    fn fetch(world, gathered, f) {\n        let a = <W as Get<A>>::take(world);\n        <Rest as Fetch<W, (G, &Col<A>), F>>::fetch(world, (gathered, &a), f);\n        <W as Get<A>>::put(world, a)\n    }\n}\n\ntrait System<W> { fn run(&Self, &mut W) }\nimpl<W, P, MP> System<W> for fn(P) -> () whe