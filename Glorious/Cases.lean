  ⟨"fn f { 0 => 1 }  fn main() { f(5) }",
    [], "error: in `f`: the clauses of `f` do not cover every case"⟩,
  ⟨"fn main() { let (a, b) = (1, 2, 3); a }",
    [], "error: 1:13: in `main`: a tuple pattern: expected `(_, _)`, found `(Int, Int, Int)`"⟩,
  ⟨"fn main() { if(1) { 2 } }",
