#### A condition of an implementation that says what a type left to another trait's implementations is, `where P: Kind<Marker = M>`, decides `M`: here from a function's parameter type, a reference.
trait Kind { type Marker; }
struct Changed<A>(A)
struct Read<A>(A)
impl<A> Kind for &mut [A] { type Marker = Changed<A>; }
impl<A> Kind for &[A] { type Marker = Read<A>; }
trait Name { fn name() -> Str }
impl<A> Name for Changed<A> { fn name() -> Str { "changed" } }
impl<A> Name for Read<A> { fn name() -> Str { "read" } }
trait Describe { fn describe(&Self) -> Str }
impl<P, M> Describe for fn(P) -> () where P: Kind<Marker = M>, M: Name { fn describe(f: &fn(P) -> ()) -> Str { <M as Name>::name() } }
fn grow(xs: &mut [Int]) { () }
fn look(xs: &[Int]) { () }
fn main() -> Str { let g = grow; let l = look; describe(&g) ++ " " ++ describe(&l) }
