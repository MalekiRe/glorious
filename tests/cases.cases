#### Instances of one effect, told apart by their type arguments: `Store<Int>` and `Store<Str>` are two effects, each handled by the nearest handler of exactly that one. A function about an instance of its caller's choosing is written out once for each choice.
effect Store<C> { take() -> [C], put([C]) }
fn store<C, R, e: EffectRow>(first: [C], app: fn() -> R / {Store<C> | e}) -> R / e {
    let mut column = first;
    handle app() { take(k) => k(replace(&mut column, [])), put(c, k) => column = c; k(()) }
}
fn main() -> Int {
    store([1, 2], { store(["a"], { let ps = take<Int>(); let ns = take<Str>(); let n = ps[0] + len(ns); put(ps); put(ns); n }) })
}
#### expect
2
#### case
effect Store<C> { take() -> [C], put([C]) }
fn store<C, R, e: EffectRow>(first: [C], app: fn() -> R / {Store<C> | e}) -> R / e {
    let mut column = first;
    handle app() { take(k) => k(replace(&mut column, [])), put(c, k) => column = c; k(()) }
}
fn each_mut<C>(f: for<'a> fn(&'a mut C)) / {Store<C>} {
    let mut column = take<C>();
    let mut i = 0;
    while({ i < len_at(&column) }) { f(&mut column[i]); i = i + 1 };
    put(column)
}
fn total() -> Int / {Store<Int>} { let c = take<Int>(); let n = fold(c, 0, { (acc, x) => acc + x }); put(c); n }
fn main() -> Int {
    store([1, 2, 3], { store(["a", "bc"], {
        each_mut(fn(x: &mut Int) { *x = *x * 2; });
        each_mut(fn(s: &mut Str) { *s = *s ++ "!"; });
        let names = take<Str>(); say(names[1]); put(names);
        total()
    }) })
}
