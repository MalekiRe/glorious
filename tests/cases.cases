#### case
#### A trait's function need not take the type: what it gives decides.
trait Num { fn zero() -> Self; fn add(Self, Self) -> Self }
impl Num for Int { fn zero() -> Int { 0 } fn add(a: Int, b: Int) -> Int { a + b } }
enum Pair<T> { P(T, T) }
impl<T> Num for Pair<T> where T: Num { fn zero() -> Pair<T> { P(zero(), zero()) } fn add(a: Pair<T>, b: Pair<T>) -> Pair<T> { match(a) { P(x, y) => match(b) { P(u, v) => P(add(x, u), add(y, v)) } } } }
fn double<T>(x: T) -> T where T: Num, T: Use<[0, *]> { add(x, x) }
fn main() -> Int { match(double(add(P(1, 2), zero()))) { P(a, b) => a * 10 + b } }
#### expect
24
