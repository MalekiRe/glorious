impl<T, R> Get<T> for (Column<T>, R) { fn column(w: &(Column<T>, R)) -> &Column<T> { &w.0 } fn column_mut(w: &mut (Column<T>, R)) -> &mut Column<T> { &mut w.0 } }
impl<T, H, R> Get<T> for (Column<H>, R) where R: Get<T> { fn column(w: &(Column<H>, R)) -> &Column<T> { <R as Get<T>>::column(&w.1) } fn column_mut(w: &mut (Column<H>, R)) -> &mut Column<T> { <R as Get<T>>::column_mut(&mut w.1) } }
struct Position(Int)
struct Velocity(Int)
fn count<T, W>(world: &W) -> Int where W: Get<T> { let c = <W as Get<T>>::column(world); len_at(&c.items) }
fn main() -> Int {
    let world = (Column { items: [Position(1), Position(2)] }, (Column { items: [Velocity(10)] }, ()));
    count<Position, (Column<Position>, (Column<Velocity>, ()))>(&world) * 10 + count<Velocity, (Column<Position>, (Column<Velocity>, ()))>(&world)
}
#### expect
21
