#### Base64, with padding as the options say (library 23).
use std::bytes::{base64_encode, base64_decode, Base64Alphabet, Padding, Base64Options, Base64ErrorKind};
use std::slice::{Slice};

fn enc(text: Str, alphabet: Base64Alphabet, padding: Padding) -> Str {
    let bytes = std::text::utf8(text);
    base64_encode(Slice::of(&bytes), Base64Options { alphabet: alphabet, padding: padding })
}
fn dec(text: Str, padding: Padding) -> Str {
    match(base64_decode(text, Base64Options { alphabet: Base64Alphabet::Standard, padding: padding })) {
        Ok(bytes) => match(std::text::from_utf8(bytes)) { Some(s) => s, None => "(not text)" },
        Err(e) => "error at " ++ show(e.offset) ++ match(e.kind) { Base64ErrorKind::InvalidDigit => " digit", Base64ErrorKind::InvalidPadding => " padding", Base64ErrorKind::NonCanonicalTail => " tail", Base64ErrorKind::IncorrectLength => " length" }
    }
}
fn main() -> Int {
    say(enc("", Base64Alphabet::Standard, Padding::Required));
    say(enc("f", Base64Alphabet::Standard, Padding::Required));
    say(enc("fo", Base64Alphabet::Standard, Padding::Required));
    say(enc("foo", Base64Alphabet::Standard, Padding::Required));
    say(enc("foobar", Base64Alphabet::Standard, Padding::Forbidden));
    say(enc("fo", Base64Alphabet::Standard, Padding::Forbidden));
    let odd = [251u8, 255u8];
    say(base64_encode(Slice::of(&odd), Base64Options { alphabet: Base64Alphabet::UrlSafe, padding: Padding::Forbidden }));
    say(dec("Zm9vYmFy", Padding::Required));
    say(dec("Zm8=", Padding::Required));
    say(dec("Zm8", Padding::Required));
    say(dec("Zm8", Padding::Optional));
    say(dec("Zm9=", Padding::Required));
    say(dec("Zm 8", Padding::Optional));
    say(dec("Z", Padding::Forbidden));
    0
}

