#### case
#### A dot call of a type's own function, written with types, where a
#### function of the name without type parameters is in scope (the
#### prelude's `get`): the type's own; and one of a function declared after.
struct A { n: Int }
fn first(a: &A) -> Int { a.get<Int>(3) + a.n }
impl A { fn get<T>(a: &Self, x: T) -> T { x } }
fn main() -> Int { let a = A { n: 1 }; first(&a) }
#### expect
4
#### case
#### A field by number of an element that is a reference: read through it.
struct P(Int)
fn total(ps: [&P]) -> Int { let mut s = 0; let mut i = 0; while({ i < len_at(&ps) }) { s = s + ps[i].0; i = i + 1 }; s }
fn main() -> Int { let a = P(2); let b = P(3); total([&a, &b]) }
#### expect
5
#### case
#### A function named as a value is for every lifetime of what it is given:
#### called with borrows of what was made after it.
fn get(r: &Int) -> Int { *r }
fn main() -> Int { let f = get; let x = 7; let a = f(&x); let y = 8; a + f(&y) }
#### expect
15
#### case
#### A function that calls itself inside a `while` of its own performs
#### nothing of the loop's.
fn walk(n: Int) -> Int { let mut i = 0; let mut s = 0; while({ i < n }) { s = s + walk(n - 1); i = i + 1 }; s + 1 }
fn main() -> Int { walk(3) }
#### expect
16
#### case
#### A trait's function called at what another trait leaves to an
#### implementation, by a condition the implementation writes of it.
trait Assoc { type Out; }
trait Act { fn act() -> Int }
struct A
struct B
impl Assoc for A { type Out = B; }
impl Act for B { fn act() -> Int { 7 } }
trait Go { fn go() -> Int }
impl<H> Go for (H,) where H: Assoc, <H as Assoc>::Out: Act { fn go() -> Int { <<H as Assoc>::Out as Act>::act() } }
fn main() -> Int { <(A,) as Go>::go() }
#### expect
7
