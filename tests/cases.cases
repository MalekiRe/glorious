effect Update { update() }
effect Log { log(Int) }
fn physics(app: fn() -> Int / {Update, Log}) -> Int / {Update, Log} {
    handle app() { update(k) => log(1); log(2); update(); k(()) }
}
fn audio(app: fn() -> Int / {Update, Log}) -> Int / {Update, Log} {
    handle app() { update(k) => log(3); update(); k(()) }
}
fn base(app: fn() -> Int / {Update, Log}) -> Int / {Log} {
    handle app() { update(k) => k(()) }
}
fn main() -> Int {
