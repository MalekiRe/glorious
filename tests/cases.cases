struct File(Int)
impl Use<[1, 1]> for File {}
fn close(File(fd): File) { host_write(fd) }
fn drain(o: Option<File>) { match(o) { Ok(f) => close(f), Err(_) => () } }
fn main() -> Int { let mut slot = None; defer drain(replace(&mut slot, None)); let old = replace(&mut slot, Some(File(3))); drain(old); host_write(1); 0 }
