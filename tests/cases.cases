#### case
#### `v[i].f()` and `let s = &v[i]; s.f()` where `f` takes a reference: the
#### element is borrowed where it is.
use std::vec::{Vec};
use std::text::{join};

struct Student { name: Str, scores: Vec<Int> }

impl Student {
    fn new(name: Str) -> Self { Student { name, scores: Vec::new() } }
    fn add(s: &mut Self, score: Int) { s.scores.push(score) }
    fn average(s: &Self) -> Int {
        if(s.scores.is_empty()) { 0 } else {
            let mut total = 0;
            let mut i = 0;
            while({ i < s.scores.len() }) { total = total + s.scores[i]; i = i + 1 };
            total / s.scores.len()
        }
    }
    fn grade(s: &Self) -> Str {
        let a = s.average();
        if(a >= 90) { "A" } else { if(a >= 80) { "B" } else { if(a >= 70) { "C" } else { "F" } } }
    }
}

struct Class { students: Vec<Student> }

impl Class {
    fn top(s: &Self) -> Option<Str> {
        let mut best = 0 - 1;
        let mut who = None;
        let mut i = 0;
        while({ i < s.students.len() }) {
            let a = s.students[i].average();
            if(a > best) { best = a; let st = &s.students[i]; who = Some(st.name) } else { () };
            i = i + 1
        };
        who
    }
}

fn main() -> Int {
    let mut ann = Student::new("ann");
    ann.add(95); ann.add(88);
    let mut bob = Student::new("bob");
    bob.add(72); bob.add(65);
    let mut class = Class { students: Vec::new() };
    class.students.push(ann);
    class.students.push(bob);
    let mut lines = Vec::new();
    let mut i = 0;
    while({ i < class.students.len() }) {
        let s = &class.students[i];
        Vec::push(&mut lines, s.name ++ ": " ++ show(s.average()) ++ " " ++ s.grade());
        i = i + 1
    };
    say(join(Vec::into_array(lines), "; "));
    match(class.top()) { Some(n) => say(n), None => () };
    class.students.len()
}
#### expect
ann: 91 A; bob: 68 F
ann
2
