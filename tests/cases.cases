#### Slices and iteration in the library specification's shape.
use core::slice::{Slice};
use core::iter::{Iterator, range, into_iter, fold, collect, map_collect, count, find_map, for_each};
fn main() -> Int {
    let a = [10, 20, 30, 40, 50];
    let s = Slice::of(&a);
    say(Slice::len(&s));
    say(match(Slice::last(&s)) { Some(r) => *r, None => 0 });
    match(Slice::sub(&s, 1, 4)) {
        Some(mid) =>
            let mut it = Slice::iter(&mid);
            say(fold(&mut it, 0, { (acc, r) => acc + *r })),
        None => say(0 - 1)
    };
    let mut r = range(0, 5);
    say(map_collect(&mut r, { (x) => x * x }));
    let mut texts = into_iter(["a", "bb", "ccc"]);
    say(find_map(&mut texts, { (t) => if(length(t) == 2) { Some(t) } else { None } }));
    say(count(&mut texts));
    let mut total = 0;
    let mut again = range(1, 4);
    for_each(&mut again, { (x) => total = total + x; });
    say(total);
    let mut all = Slice::iter(&s);
    say(count(&mut all));
    0 }
