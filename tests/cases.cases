#### case
#### A growable buffer of plain data over memory the program allocates and
#### frees: grown by allocating twice as much, copying, and freeing.
struct Buf<T> { at: *mut T, cap: Int, len: Int }
fn new_buf<T>() -> Buf<T> where T: Layout { Buf { at: unsafe { alloc_of(1) }, cap: 1, len: 0 } }
fn push_buf<T>(b: Buf<T>, v: T) -> Buf<T> where T: Repr, T: Layout {
    let b = if(b.len == b.cap) {
        let bigger: *mut T = unsafe { alloc_of(2 * b.cap) };
        unsafe { copy_of(bigger, ptr_const(b.at), b.len); free_of(b.at) };
        Buf { at: bigger, cap: 2 * b.cap, len: b.len }
    } else { b };
    unsafe { ptr_store(ptr_offset(b.at, b.len), v) };
    Buf { at: b.at, cap: b.cap, len: b.len + 1 }
}
fn get_buf<T>(b: &Buf<T>, i: Int) -> T where T: Repr, T: Layout { unsafe { ptr_load(ptr_const(ptr_offset(b.at, i))) } }
fn fill(b: Buf<(Int, u16)>, i: Int) -> Buf<(Int, u16)> {
    if(i < 10) { tail fill(push_buf(b, (i * i, u16(i))), i + 1) } else { b }
}
fn main() -> Int {
    let b = fill(new_buf(), 0);
    let (sq, n) = get_buf(&b, 7);
    print(b.cap);
    unsafe { free_of(b.at) };
    sq + int(n)
}
