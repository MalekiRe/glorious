#### The library's tables hold values that have to be used without losing one.
use std::index::{Arena};
use std::value::{Rejected};
struct Ticket(Int);
impl Use<[1, 1]> for Ticket {}
fn redeem(t: Ticket) -> Int { match(t) { Ticket(n) => n } }
struct Kind;
fn redeem_all(ts: [Ticket], sum: Int) -> Int { match(pop(ts)) { Some((rest, t)) => redeem_all(rest, sum + redeem(t)), None => sum } }
fn add(a: &mut Arena<Kind, Ticket>, n: Int) -> Int { match(Arena::insert(a, Ticket(n))) { Ok(_) => 0, Err(Rejected { value, error: _ }) => redeem(value) } }
fn main() -> Int {
    let mut a: Arena<Kind, Ticket> = Arena::new();
    add(&mut a, 1);
    let m = Arena::mark(&a);
    add(&mut a, 20);
    add(&mut a, 300);
    let back = match(Arena::rollback_take(&mut a, m)) { Ok(ts) => redeem_all(ts, 0), Err(_) => 0 };
    back + redeem_all(Arena::into_vec(a), 0) * 1000
}
