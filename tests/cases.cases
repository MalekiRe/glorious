    if(n == 30) { guess } else { improve(x, (guess + x / guess) / 2.0, n + 1) }
}
fn harmonic(n: Int, sum: f64) -> f64 { if(n == 0) { sum } else { harmonic(n - 1, sum + 1.0 / f64(n)) } }
