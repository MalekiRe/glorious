#### case
#### A trait whose function performs an effect, over a `Vec` behind a
#### reference: `hs.len()` is the `Vec`'s own, given the reference as it is.
use std::vec::{Vec};

effect Emit { emit(Str) }

struct Listener { name: Str, threshold: Int }

trait Handler {
    fn on_value(h: &Self, value: Int) -> Bool / { Emit };
}

impl Handler for Listener {
    fn on_value(l: &Listener, value: Int) -> Bool / {Emit} {
        if(value >= l.threshold) { emit(l.name ++ " saw " ++ show(value)); true } else { false }
    }
}

fn dispatch<H: Handler>(hs: &Vec<H>, value: Int) -> Int / { Emit } {
    let mut n = 0;
    let mut i = 0;
    while({ i < hs.len() }) {
        if(on_value(&hs[i], value)) { n = n + 1 } else { () };
        i = i + 1
    };
    n
}

fn main() -> Int {
    let mut hs = Vec::new();
    hs.push(Listener { name: "low", threshold: 1 });
    hs.push(Listener { name: "high", threshold: 10 });
    let mut log = Vec::new();
    let total = handle {
        dispatch(&hs, 5) + dispatch(&hs, 15)
    }() {
        emit(m, k) => log.push(m); k(())
    };
    let mut i = 0;
    while({ i < log.len() }) { say(log[i]); i = i + 1 };
    total
}

#### expect
low saw 5
low saw 15
high saw 15
3
