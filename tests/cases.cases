#### case
#### An implementation's condition says what a trait leaves to a parameter's implementation: an iterator made from an iterator.
use core::iter::{Iterator, range, fold, next};
struct Map<I, A, B> { inner: I, f: fn(A) -> B }
impl<I, A, B> Iterator for Map<I, A, B> where I: Iterator<Item = A> {
    type Item = B;
    fn next(it: &mut Map<I, A, B>) -> Option<B> {
        match(next(&mut it.inner)) {
            Some(x) => Some((it.f)(x)),
            None => None
        }
    }
}
fn main() -> Int {
    let mut m = Map { inner: range(0, 5), f: { (n) => n * n } };
    fold(&mut m, 0, { (acc, x) => acc + x }) }
#### expect
30
#### case
#### The library's adapter types, chained; nothing is done until `collect` asks.
use core::iter::{Iterator, range, into_iter, map, filter, take, skip, enumerate, zip, chain, collect, fold};
fn main() -> Int {
    say(collect(&mut take(map(filter(range(0, 100), { (n) => *n % 2 == 0 }), { (n) => n * n }), 5)));
    say(collect(&mut skip(range(0, 6), 4)));
    say(collect(&mut enumerate(into_iter(["a", "b"]))));
    say(collect(&mut zip(range(0, 10), into_iter(["x", "y", "z"]))));
    say(collect(&mut chain(range(0, 2), range(7, 9))));
    fold(&mut map(range(1, 4), { (n) => n * 10 }), 0, { (acc, x) => acc + x }) }
#### expect
[0, 4, 16, 36, 64]
[4, 5]
[(0, a), (1, b)]
[(0, x), (1, y), (2, z)]
[0, 1, 7, 8]
