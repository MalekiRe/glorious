#### case
#### An iterator by reference over a list a program declares.
use core::iter::{Iterator, fold};
enum List<T> { Nil, Cons(T, List<T>) }
struct Links<'a, T> { at: &'a List<T> }
impl<'a, T> Iterator for Links<'a, T> {
    type Item = &'a T;
    fn next(it: &mut Links<'a, T>) -> Option<&'a T> {
        match(it.at) {
            &Cons(x, rest) => it.at = rest; Some(x),
            &Nil => None
        }
    }
}
fn main() -> Int {
    let l = Cons(1, Cons(2, Cons(3, Nil)));
    let mut it = Links { at: &l };
    fold(&mut it, 0, { (acc, x) => acc * 10 + *x }) }
#### expect
123
#### case
#### A generic function lends a variable of its own to a function of a trait: regions are found through both calls.
