#### A generator given up with `close_generator` runs its cleanups.
use std::generator::*;
fn noisy() -> Int / {Yield<Int, ()>} { defer { say(77); } yield(1); yield(2); 0 }
fn main() -> Int {
    let g = generator({ noisy() });
    match(resume(g, ())) {
        Yielded { value, rest } => close_generator(rest); value,
        Complete(_) => 0
    } }
