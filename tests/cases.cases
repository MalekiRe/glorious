#### case
#### `std::time`: durations added and taken away with nothing lost, moments of one clock and of two, and a clock the program answers itself.
use std::time::{Duration, Instant, TimeError, Clock, monotonic_now};
use std::cmp::{Ordering};
fn dur(s: u64, n: u32) -> Duration { match(Duration::from_parts(s, n)) { Ok(d) => d, Err(_) => Duration::zero() } }
fn text(d: Duration) -> Str { show(Duration::seconds(d)) ++ "s+" ++ show(Duration::subsec_nanos(d)) ++ "ns" }
fn why(e: TimeError) -> Str { match(e) { TimeError::Overflow => "overflow", TimeError::BeforeOrigin => "before", TimeError::DifferentClock => "another clock", TimeError::Unsupported => "unsupported" } }
fn main() -> Int {
    say(match(Duration::from_parts(1u64, 1000000000u32)) { Ok(_) => "taken", Err(e) => why(e) });
    say(match(Duration::checked_add(dur(1u64, 600000000u32), dur(2u64, 700000000u32))) { Some(d) => text(d), None => "none" });
    say(match(Duration::checked_sub(dur(5u64, 100u32), dur(2u64, 200u32))) { Some(d) => text(d), None => "none" });
    say(match(Duration::checked_sub(dur(1u64, 0u32), dur(1u64, 1u32))) { Some(d) => text(d), None => "none" });
    say(match(Duration::checked_add(dur(18446744073709551615u64, 999999999u32), dur(0u64, 1u32))) { Some(d) => text(d), None => "none" });
    let a = Instant::at(0u32, dur(10u64, 0u32));
    let b = Instant::at(0u32, dur(12u64, 500u32));
    let other = Instant::at(1u32, dur(12u64, 500u32));
    say(match(Instant::duration_since(b, a)) { Ok(d) => text(d), Err(e) => why(e) });
    say(match(Instant::duration_since(a, b)) { Ok(d) => text(d), Err(e) => why(e) });
    say(match(Instant::duration_since(other, a)) { Ok(d) => text(d), Err(e) => why(e) });
    say(match(Instant::compare(a, b)) { Ok(Ordering::Less) => "earlier", Ok(_) => "not earlier", Err(e) => why(e) });
    // A clock answered by the program: each look at it is a second and a half later.
    let mut ticks = 0;
    let elapsed = handle {
        match(monotonic_now()) { Err(e) => why(e), Ok(start) => match(monotonic_now()) { Err(e) => why(e), Ok(end) =>
            match(Instant::duration_since(end, start)) { Ok(d) => text(d), Err(e) => why(e) } } }
    }() { monotonic(k) => ticks = ticks + 1; k(ticks * 1500000000), now(k) => k(0) };
    say(elapsed);
    ticks
}

