impl Col for Int { fn n() -> Int { 3 } }
struct Cmd<S> { s: [S] }
fn end<S>(c: &mut Cmd<S>) -> Int where S: Col { <S as Col>::n() }
fn reap<S>(c: &mut Cmd<S>) -> Int where S: Col { end(c) }
struct W<F> { f: F }
trait Into2<S> { type Out; fn into2(Self) -> Self::Out; }
impl<S, F> Into2<S> for F where F: Fn<(&mut Cmd<S>,), Output = Int>, S: Get<Int> { type Out = W<F>; fn into2(f: F) -> W<F> { W { f: f } } }
struct App<S, L> { s: S, l: L }
impl<S, L> App<S, L> {
    pub fn on<P, Q>(app: Self, p: P) -> App<S, (Q, L)> where P: Into2<S, Out = Q> {
        let App { s, l } = app;
        App { s: s, l: (<P as Into2<S>>::into2(p), l) }
    }
}
fn plugin<T, U>(app: App<T, U>) -> App<T, (<fn(&mut Cmd<T>) -> Int as Into2<T>>::Out, U)> where T: Get<Int>, T: Col { app.on(reap) }
fn main() -> Int {
    let mut c = Cmd { s: [] };
    let a = plugin(App { s: 1, l: () });
    (a.l.0.f)(&mut c)
}
