fn even<T>(n: Int, x: T) -> Int where T: Show { if(n == 0) { show(x) } else { odd(n - 1, x) } }
fn odd<T>(n: Int, x: T) -> Int where T: Show { if(n == 0) { 0 - show(x) } else { even(n - 1, x) } }
fn main() -> Int { even(3, 5) + even(2, 7) }
