#### case
#### Loops are a handler, a tail call and two terminal operations.
effect State { get(), put(value) }
  fn with_state<T, e: EffectRow>(initial: (Int, Int), body: fn() -> T / {State | e}) -> T / {| e} {
      let run = handle body() {
          result => { s => result },
          get(k) => { s => (k(s))(s) },
          put(value, k) => { s => (k(()))(value) }
      };
      run(initial)
  }
  fn main() -> Int {
      with_state((0, 0)) {
          loop {
              let (i, total) = get();
              if(i == 5) { break(total) };
              put((i + 1, total + i))
          }
      }
  }
#### expect
10
