#### case
effect Yield<Y, R> { yield(Y) -> R }
enum GeneratorStep<Y, T, G> { Yielded(Y, G), Complete(T) }
trait Generator<R> {
    type Yield;
    type Return;
    fn resume(Self, R) -> GeneratorStep<Self::Yield, Self::Return, Self>;
}
struct Coroutine<Y, R, T>(fn(R) -> GeneratorStep<Y, T, Coroutine<Y, R, T>>)
impl<Y, R, T> Generator<R> for Coroutine<Y, R, T> {
    type Yield = Y;
    type Return = T;
    fn resume(g: Coroutine<Y, R, T>, input: R) -> GeneratorStep<Y, T, Coroutine<Y, R, T>> { match(g) { Coroutine(k) => k(input) } }
}
fn begin<Y, R, T>(body: fn() -> T / {Yield<Y, R>}) -> Coroutine<Y, R, T> {
    Coroutine({ (first) => handle body() {
        done => Complete(done),
        yield(value, k) => Yielded(value, Coroutine(k))
    } })
}
fn drain<G: Generator<()>>(g: G, total: Int) -> Int where G: Generator<(), Yield = Int, Return = Int> {
    match(resume(g, ())) {
        Yielded(v, rest) => drain(rest, total + v),
        Complete(last) => total * 100 + last
    }
}
fn main() -> Int {
    let g = begin({ yield(1); yield(2); yield(3); 9 });
    drain(g, 0) }
