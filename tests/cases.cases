#### case
#### The map changed where it is, as the specification has it: what a key
#### stands for may have a `drop`, and what `insert` replaces is given back.
use std::hash::{HashMap};
struct H(Int)
impl Drop for H { fn drop(h: &mut H) { say(h.0) } }
fn main() -> Int {
    let mut m = HashMap::new();
    let mut i = 0;
    while({ i < 20 }) { m.insert(i, i * i); i = i + 1 };
    say(m.len());
    match(m.get(&7)) { Some(v) => say(*v), None => say(0 - 1) };
    match(m.get_mut(&3)) { Some(v) => *v = 100, None => () };
    say(m.insert(3, 5));
    say(m.remove(&4));
    say(m.contains_key(&4));
    let mut words = HashMap::new();
    words.insert("a", 1);
    match(words.get_mut(&"a")) { Some(n) => *n = *n + 1, None => () };
    match(words.get(&"a")) { Some(n) => say(*n), None => () };
    let mut hs = HashMap::new();
    hs.insert(1, H(10));
    match(hs.insert(1, H(11))) { Some(old) => say(100 + old.0), None => () };
    say(m.len());
    0
}

