        let p = mem_alloc(16usize, 8usize);
        <[u16; 3] as Repr>::repr_store(p, a);
        let b: [u16; 3] = <[u16; 3] as Repr>::repr_load(p);
        print(ptr_read(repr_at(p, 2), -16));
        mem_free(p);
        int(b[0]) + int(b[1]) + int(b[2])
    }
}
#### expect
6
16
8
24
#### case
#### A cell in a generic function, used at two types laid out otherwise: the
#### function is copied for each.
fn twice<T>(x: T, f: fn(&T) -> Int) -> Int { let mut c = x; f(&c) + f(&c) }
fn first(r: &Int) -> Int { *r }
fn both(r: &(Int, Int)) -> Int { match(r) { &(a, b) => *a * 10 + *b } }
fn main() -> Int { twice(3, first) * 1000 + twice((1, 2), both) }
#### expect
6024
#### case
#### What an `is` found, in a program where a type has a `drop`: destroyed as
#### the tuple it is.
struct File(Int)
impl Drop for File { fn drop(p: &mut File) { () } }
fn main() -> Int { let o = Some(4); if(o is Some(x)) { x } else { 0 } }
