  pub struct Point { pub x: Int, pub y: Int }
  pub fn origin() -> geometry::Point { Point { x: 0, y: 0 } }
  pub fn shift(p: Point, dx: Int) -> Point { Point { x: p.x + dx, y: p.y } }
  fn secret() -> Int { 42 }
  pub fn reveal() -> Int { secret() }
}
fn main() -> Int { let p = geometry::shift(geometry::origin(), 3); p.x + geometry::reveal() }
