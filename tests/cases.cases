#### case
#### `std::random`: the seeded generator against xoshiro256** worked out outside, a seed of zeros, numbers below a bound drawn without bias, a bound of nothing refused.
use std::random::{SeededRng, RandomSource, RandomError, random_u64, random_below, fill};
fn zeros(n: Int, out: [u8]) -> [u8] { if(n == 0) { out } else { zeros(n - 1, push(out, 0u8)) } }
fn shown(r: Result<u64, RandomError>) -> Str { match(r) { Ok(n) => show(n), Err(RandomError::InvalidRange) => "no such range", Err(_) => "failed" } }
fn main() -> Int {
    let mut rng = SeededRng::from_seed([1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8, 32u8]);
    say(SeededRng::next_u64(&mut rng));
    say(SeededRng::next_u64(&mut rng));
    say(SeededRng::next_u64(&mut rng));
    let mut nothing = SeededRng::from_seed(zeros(32, []));
    say(SeededRng::next_u64(&mut nothing));
    let mut again = SeededRng::from_seed([1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8, 32u8]);
    say(shown(random_below(&mut again, 10u64)));
    say(shown(random_below(&mut again, 1000u64)));
    say(shown(random_below(&mut again, 7u64)));
    say(shown(random_below(&mut again, 9223372036854775813u64)));
    say(shown(random_below(&mut again, 0u64)));
    let bytes = match(fill(&mut again, 11)) { Ok(b) => len(b), Err(_) => 0 - 1 };
    say(SeededRng::algorithm_version());
    bytes
}

