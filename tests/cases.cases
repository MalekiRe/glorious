#### Buffered writers and readers: what is kept is written by `finish`, or comes back (library 28.2).
use std::stream::{Read, Write, MemoryCursor, read, write, flush, write_str, BufferWriter, BufferReader, FinishWriteFailure};
use std::host::{IoError};
// A writer that takes so many bytes and then fails.
struct Full { taken: [u8], room: Int }
impl Write for Full {
    type Effects = {};
    fn write(w: &mut Full, bytes: [u8]) -> Result<Int, IoError> {
        if(w.room <= 0) { Err(IoError { code: 28 }) } else {
            let n = if(len(bytes) > w.room) { w.room } else { len(bytes) };
            w.room = w.room - n;
            Ok(n)
        }
    }
    fn flush(w: &mut Full) -> Result<(), IoError> { Ok(()) }
}
fn main() -> Int {
    let mut out = BufferWriter::new(MemoryCursor::new([]), 4);
    write(&mut out, [1u8, 2u8]);
    say(BufferWriter::buffered(&out));
    write(&mut out, [3u8, 4u8, 5u8]);
    say(BufferWriter::buffered(&out));
    write(&mut out, [6u8]);
    say(match(BufferWriter::finish(out)) { Ok(inner) => MemoryCursor::into_inner(inner), Err(_) => [] });
    // A writer that fills: what was not written comes back with it.
    let mut small = BufferWriter::new(Full { taken: [], room: 3 }, 100);
    write(&mut small, [1u8, 2u8, 3u8, 4u8, 5u8]);
    say(match(BufferWriter::finish(small)) { Ok(_) => [], Err(failure) => failure.pending });
    // Reading a little at a time from a reader asked rarely.
    let mut source = MemoryCursor::new([]);
    write_str(&mut source, "abcdefgh");
    let mut reader = BufferReader::new(source, 5);
    say(match(read(&mut reader, 2)) { Ok(got) => got, Err(_) => [] });
    say(match(read(&mut reader, 2)) { Ok(got) => got, Err(_) => [] });
    match(BufferReader::into_parts(reader)) { (inner, kept) => MemoryCursor::position(&inner) * 10 + len(kept) }
}

