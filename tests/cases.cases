#### Paths taken apart and put together as text (library 29.1).
use std::path::{PathBuf, PathComponent};

fn show_all(cs: [PathComponent], i: Int, out: Str) -> Str {
    if(i >= len(cs)) { out } else {
        show_all(cs, i + 1, out ++ match(cs[i]) { PathComponent::Root => "<root>", PathComponent::Current => "<.>", PathComponent::Parent => "<..>", PathComponent::Normal(n) => "[" ++ n ++ "]" })
    }
}
fn or_none(o: Option<Str>) -> Str { match(o) { Some(s) => s, None => "(none)" } }
fn main() -> Int {
    let p = PathBuf::from_str("/usr/local/./lib/../archive.tar.gz");
    say(show_all(PathBuf::components(&p), 0, ""));
    say(or_none(PathBuf::file_name(&p)));
    say(or_none(PathBuf::extension(&p)));
    say(match(PathBuf::parent(&p)) { Some(up) => PathBuf::as_str(&up), None => "(none)" });
    say(PathBuf::is_absolute(&p));
    let hidden = PathBuf::from_str("home/.profile");
    say(or_none(PathBuf::extension(&hidden)));
    let mut q = PathBuf::from_str("a/b");
    PathBuf::push(&mut q, &PathBuf::from_str("c.txt"));
    say(PathBuf::as_str(&q));
    PathBuf::push(&mut q, &PathBuf::from_str("/etc"));
    say(PathBuf::as_str(&q));
    say(PathBuf::pop(&mut q));
    say(PathBuf::as_str(&q));
    say(PathBuf::pop(&mut q));
    0
}

