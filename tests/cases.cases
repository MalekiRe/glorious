#### A type's own functions where the type has a lifetime: a slice that holds a reference to an array.
struct Slice<'a, T> { items: &'a [T], from: Int, to: Int }
impl<'a, T> Slice<'a, T> {
    fn of(items: &'a [T]) -> Self { Self { items: items, from: 0, to: len_at(items) } }
    fn len(s: &Self) -> Int { s.to - s.from }
    fn get(s: &Self, i: Int) -> Option<&'a T> { if(i < 0) { None } else { if(s.from + i < s.to) { element(s.items, s.from + i) } else { None } } }
}
