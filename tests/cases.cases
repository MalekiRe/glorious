#### State threaded through resumptions: a counter written with a handler.
effect Counter { next() }
  fn counting<T, e: EffectRow>(body: fn() -> T / {Counter | e}, start: Int) -> (T, Int) / {| e} {
      let run = handle body() {
          result => { n => (result, n) },
          next(k) => { n => (k(n))(n + 1) }
      };
      run(start)
  }
  fn main() -> (Int, Int) { counting({ next() * 100 + next() * 10 + next() }, 1) }
#### expect
(123, 4)
