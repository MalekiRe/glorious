fn find<T>(target: T, a: T, b: T, c: T) -> Option<T> where T: Eq, T: Use<[0, *]> {
      let check = { x => if(x == target) { @find(Some(x)) } };
      check(a); check(b); check(c);
      None
  }
  fn main() -> (Option<Int>, Option<Int>) { (find(2, 1, 2, 3), find(9, 1, 2, 3)) }
