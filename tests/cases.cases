use std::text::{words};
fn main() -> Int {
    let mut counts = HashMap::new();
    let ws = words("a b a c b a");
    let mut i = 0;
    while({ i < len(ws) }) { let n = counts.entry(ws[i]).or_insert(0); *n = *n + 1; i = i + 1 };
