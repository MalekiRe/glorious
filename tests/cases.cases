#### case
#### Of two implementations for one type, `(Yes, X)` and `(No, X)`, what one
#### says of a type is not taken from the first while the type's first part
#### is not yet known (it was, the type then made to fit it: `Yes`).
struct Yes
struct No
struct Global
struct Tag
struct W<T>(T)
trait SameIs<T> { type Is; }
impl<T> SameIs<T> for T { type Is = Yes; }
impl<T, U> SameIs<T> for U { type Is = No; }
trait ShowIs { fn shown() -> Int }
impl ShowIs for Yes { fn shown() -> Int { 1 } }
impl ShowIs for No { fn shown() -> Int { 0 } }
fn shown_of<X>() -> Int where X: ShowIs { <X as ShowIs>::shown() }
trait OfW<T> { type Is; }
impl<T, U> OfW<T> for W<U> where U: SameIs<T> { type Is = <U as SameIs<T>>::Is; }
fn same<A, B, X>() -> Int where A: SameIs<B, Is = X>, X: ShowIs { shown_of<X>() }
fn ofw<A, B, X>() -> Int where A: OfW<B, Is = X>, X: ShowIs { shown_of<X>() }
trait Either { type Out; }
impl<X> Either for (Yes, X) { type Out = Yes; }
impl<X> Either for (No, X) { type Out = X; }
trait WithoutOf<T> { type Is; }
impl<T, U> WithoutOf<T> for W<U> where U: SameIs<T> { type Is = <U as SameIs<T>>::Is; }
impl<T> WithoutOf<T> for () { type Is = No; }
impl<T, H, ..R> WithoutOf<T> for (H, ..R) where H: WithoutOf<T>, (..R): WithoutOf<T>, (<H as WithoutOf<T>>::Is, <(..R) as WithoutOf<T>>::Is): Either { type Is = <(<H as WithoutOf<T>>::Is, <(..R) as WithoutOf<T>>::Is) as Either>::Out; }
trait Pair<T> { type Is; }
impl<T, H, R> Pair<T> for (H, R) where H: WithoutOf<T>, R: WithoutOf<T>, (<H as WithoutOf<T>>::Is, <R as WithoutOf<T>>::Is): Either { type Is = <(<H as WithoutOf<T>>::Is, <R as WithoutOf<T>>::Is) as Either>::Out; }
fn wo<A, B, X>() -> Int where A: WithoutOf<B, Is = X>, X: ShowIs { shown_of<X>() }
fn pr<A, B, X>() -> Int where A: Pair<B, Is = X>, X: ShowIs { shown_of<X>() }
fn main() -> Int { pr<(W<Global>, W<Tag>), Tag>() * 100 + wo<(W<Global>,), Tag>() * 10 + wo<(W<Tag>, W<Global>), Global>() }

#### expect
101
#### case
#### `K::Got` in an implementation of a trait that leaves a `Got` too: of
#### the trait written of `K` here (`K: KindOf<T>`, `K` found from `R`'s
#### `Kind`), not the one implemented; and a field read of it once known.
trait Item { type Got<'a>; fn get<'a>(&'a Self) -> Got<'a> }
trait KindOf<T> { type Got<'a>; fn get_by<'a>(&'a T) -> Got<'a> }
trait Rel { type Kind; }
struct One
struct Many
struct Pair(Int)
struct Lot
impl Rel for Pair { type Kind = One; }
impl Rel for Lot { type Kind = Many; }
impl<T> KindOf<T> for One { type Got<'a> = &'a T; fn get_by<'a>(t: &'a T) -> &'a T { t } }
impl<T> KindOf<T> for Many { type Got<'a> = [&'a T]; fn get_by<'a>(t: &'a T) -> [&'a T] { [t, t] } }
struct Wrap<R, T> { value: T, rel: [R] }
impl<R, T, K> Item for Wrap<R, T> where R: Rel<Kind = K>, K: KindOf<T> {
    type Got<'a> = K::Got<'a>;
    fn get<'a>(w: &'a Wrap<R, T>) -> K::Got<'a> { <K as KindOf<T>>::get_by(&w.value) }
}
fn main() -> Int {
    let a: Wrap<Pair, (Int,)> = Wrap { value: (5,), rel: [] };
    let x = a.get().0;
    x
}

#### expect
5
