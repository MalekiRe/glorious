enum List<T> { Nil, Cons(T, List<T>) }
trait Sum { fn sum(Self) -> Int }
impl Sum for Int { fn sum(x: Int) -> Int { x } }
impl<T> Sum for List<T> where T: Sum { fn sum(l: List<T>) -> Int { match(l) { Nil => 0, Cons(h, t) => sum(h) + sum(t) } } }
fn main() -> Int { sum(Cons(Cons(1, Cons(2, Nil)), Cons(Cons(3, Nil), Nil))) }
