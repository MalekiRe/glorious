#### Tasks: work spawned and joined, handles that cannot be let go, and tasks that take turns (library 30.4).
use std::task::{Task, TaskError, CancelOutcome, Spawn, TaskControl, spawn, join, cancel_task, run_inline, yield_now, round_robin};
use std::generator::{Yield, Coroutine, generator};

fn worker(name: Str, steps: Int) -> Coroutine<(), (), Int> {
    generator({ count(name, steps, 0) })
}
fn count(name: Str, steps: Int, i: Int) -> Int / {Yield<(), ()>} {
    if(i >= steps) { length(name) * 100 + steps } else { say(name ++ show(i)); yield_now(); count(name, steps, i + 1) }
}
fn main() -> Int {
    // Work spawned and joined.
    let n = run_inline({
        let a = spawn({ 6 * 7 });
        let b = spawn({ 5 });
        let first = match(join(a)) { Ok(x) => x, Err(_) => 0 };
        let second = match(cancel_task(b)) { CancelOutcome::Completed(n) => n, CancelOutcome::Cancelled => 0 };
        first * 10 + second
    });
    say(n);
    // Three tasks taking turns.
    say(round_robin([worker("a", 2), worker("bb", 1), worker("ccc", 3)]));
    0
}

