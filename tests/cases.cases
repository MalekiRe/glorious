trait Shape { fn area(&Self) -> Int }
struct Sq(Int)
struct Rect(Int, Int)
impl Shape for Sq { fn area(s: &Sq) -> Int { s.0 * s.0 } }
impl Shape for Rect { fn area(r: &Rect) -> Int { r.0 * r.1 } }
impl<A, B> Shape for (A, B) where A: Shape, B: Shape { fn area(p: &(A, B)) -> Int { area(&p.0) + area(&p.1) } }
fn total<T: Shape>(shape: &T, times: Int) -> Int {
    let mut sum = 0;
    let mut i = 0;
    while({ i < times }) { sum = (sum + area(shape)) % 1000003; i = i + 1 };
    sum
}
