#### What a block is given need not be the body of an `if`.
fn zero<T>(_: T) -> Int { 0 }
    fn main() -> Int {
      let n = 3;
      let r = if(2 < 1) { n };
      let r2 = match(2 < 1) { Ok(_) => r, Err(_) => Err(zero) };
      r2 else { n + 1 }
    }
