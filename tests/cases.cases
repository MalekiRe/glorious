#### `std::fingerprint`, the part quick enough for the Lean machines: the 64-bit hash against its known values, a number written the least byte first, and digests refused for their length.
use std::fingerprint::{Hasher, Digest256};
use std::slice::{Slice};
use std::text::{utf8};
fn hash_text(text: Str) -> u64 { let mut h = Hasher::new(); let bytes = utf8(text); Hasher::write(&mut h, Slice::of(&bytes)); Hasher::finish(&h) }
fn main() -> Int {
    say(hash_text(""));
    say(hash_text("a"));
    say(hash_text("foobar"));
    let mut h = Hasher::new();
    Hasher::write_u32(&mut h, 1u32);
    let mut bytes = Hasher::new();
    Hasher::write_u8(&mut bytes, 1u8); Hasher::write_u8(&mut bytes, 0u8); Hasher::write_u8(&mut bytes, 0u8); Hasher::write_u8(&mut bytes, 0u8);
    say(Hasher::finish(&h) == Hasher::finish(&bytes));
    say(match(Digest256::parse_hex("00ff")) { Ok(_) => "parsed", Err(_) => "refused" });
    say(match(Digest256::from_bytes([1u8, 2u8])) { Some(_) => "a digest", None => "not thirty-two bytes" });
    0
}

