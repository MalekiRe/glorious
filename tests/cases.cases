#### case
#### An array written out of values that have to be used; pushing and popping through a reference.
struct Ticket(Int);
impl Use<[1, 1]> for Ticket {}
fn redeem(t: Ticket) -> Int { match(t) { Ticket(n) => n } }
fn redeem_all(ts: [Ticket], sum: Int) -> Int { match(pop(ts)) { Some((rest, t)) => redeem_all(rest, sum + redeem(t)), None => sum } }
fn taken_from<T>(items: [T], count: Int, taken: [T]) -> ([T], [T]) {
    if(count <= 0) { (items, taken) } else {
        match(pop(items)) {
            Some((rest, last)) => tail taken_from(rest, count - 1, push(taken, last)),
            None => ([], taken)
        }
    }
}
fn turned<T>(from: [T], onto: [T]) -> [T] {
    match(pop(from)) { Some((rest, last)) => tail turned(rest, push(onto, last)), None => onto }
}
struct A<T> { items: [T] }
fn roll<T>(a: &mut A<T>, length: Int) -> Result<[T], Int> {
    if(length > len_at(&a.items)) { Err(1) } else {
        let count = len_at(&a.items) - length;
        let items = &mut a.items;
        match(taken_from(replace(items, []), count, [])) {
            (kept, taken) => restore_at(items, kept); Ok(turned(taken, []))
        }
    }
}
fn main() -> Int { match(taken_from([Ticket(1), Ticket(2)], 1, [])) { (a, b) => redeem_all(a, 0) + redeem_all(b, 0) } }
#### expect
error: 22:30: in `roll`: `restore_at` is unsafe: it can be named only in `unsafe { .. }` or in an `unsafe fn`
