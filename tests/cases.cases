#### case
#### Budgets with tickets that have to be given back, and a log of what to undo (library 25.2, 25.3).
use std::budget::{StepBudget, MemoryBudget, MemoryCharge, DepthBudget, DepthPermit, UndoLog};
use std::value::{Rejected};

// A ticket is given back to where it came from; one that came back is tried again.
fn give_back(b: &mut MemoryBudget, charge: MemoryCharge) -> Int {
    match(MemoryBudget::release(b, charge)) { Ok(_) => 1, Err(Rejected { value, error: _ }) => give_back(b, value) }
}
fn out(b: &mut DepthBudget, permit: DepthPermit) -> Int {
    match(DepthBudget::leave(b, permit)) { Ok(_) => 1, Err(Rejected { value, error: _ }) => out(b, value) }
}
fn main() -> Int {
    let mut steps = StepBudget::new(10);
    say(StepBudget::charge(&mut steps, 4) is Ok(_));
    say(match(StepBudget::charge(&mut steps, 7)) { Ok(_) => 0 - 1, Err(e) => e.remaining });
    let mut memory = MemoryBudget::named(100, 1);
    let mut other = MemoryBudget::named(100, 2);
    let got = match(MemoryBudget::charge(&mut memory, 60)) {
        Ok(charge) =>
            say(MemoryBudget::remaining(&memory));
            // Given to the wrong budget, it comes back; then to the right one.
            match(MemoryBudget::release(&mut other, charge)) {
                Ok(_) => 0 - 1,
                Err(Rejected { value, error: _ }) => 10 + give_back(&mut memory, value)
            },
        Err(_) => 0
    };
    say(got);
    say(MemoryBudget::remaining(&memory));
    let mut depth = DepthBudget::new(2);
    let level = match(DepthBudget::enter(&mut depth)) {
        Ok(outer) => match(DepthBudget::enter(&mut depth)) {
            Ok(inner) =>
                let third = match(DepthBudget::enter(&mut depth)) { Ok(p) => out(&mut depth, p), Err(e) => 100 };
                // The last given is the first given back: the outer one comes back.
                match(DepthBudget::leave(&mut depth, outer)) {
                    Ok(_) => out(&mut depth, inner) - 50,
                    Err(Rejected { value, error: _ }) => third + 10 * out(&mut depth, inner) + out(&mut depth, value)
                },
            Err(_) => out(&mut depth, outer)
        },
        Err(_) => 0
    };
    say(level);
    say(DepthBudget::depth(&depth));
    let mut log: UndoLog<Str> = UndoLog::new();
    UndoLog::push(&mut log, "a");
    let mark = UndoLog::mark(&log);
    UndoLog::push(&mut log, "b");
    UndoLog::push(&mut log, "c");
    say(match(UndoLog::rollback_take(&mut log, mark)) { Ok(records) => records, Err(_) => [] });
    UndoLog::len(&log)
}

