effect Update { update() }
struct Position(Int)
struct Velocity(Int)
fn integrate() / {Store<Position>, Store<Velocity>} {
    let mut ps = take<Position>(); let vs = take<Velocity>();
    let mut i = 0;
    while({ i < len_at(&ps) }) { let Position(p) = ps[i]; let Velocity(v) = vs[i]; ps[i] = Position(p + v); i = i + 1 };
    put(ps); put(vs)
}
fn physics<R, e: EffectRow>(app: fn() -> R / {Update, Store<Position>, Store<Velocity> | e}) -> R / {Update, Store<Position>, Store<Velocity> | e} {
    handle app() { update(k) => integrate(); update(); k(()) }
}
fn main() -> Int {
    store([Position(0), Position(10)], { store([Velocity(1), Velocity(2)], {
        handle physics({ update(); update(); update(); let ps = take<Position>(); let Position(a) = ps[0]; let Position(b) = ps[1]; put(ps); a * 100 + b }) { update(k) => k(()) }
    }) })
}
