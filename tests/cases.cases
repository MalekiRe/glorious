#### What a program is told of its own functions: the name of the one a
#### callable is of, and none of one written in place.
use std::any::fn_name;
fn mover(x: Int) -> Int { x + 1 }
fn named<F>(f: F) -> Str where F: Fn<(Int,), Output = Int> { let (n, g) = fn_name(f); discard(g(1)); n }
fn main() -> Int { say(named(mover)); say(named(fn(x: Int) -> Int { x })); 0 }
#### expect
mover

0
#### case
#### A thread runs later, after the block a borrow it held would be of may
#### have ended: what it uses it is given, a copy, not a borrow.
use std::thread::{scope, Scope, Threads, yield_now};
fn main() -> Int {
    scope(fn(s: &Scope) -> Int / {Threads} {
        let mut i = 0;
        while({ i < 2 }) { let mut v = [1, 2]; discard(s.spawn({ push_at(&mut v, 3); len_at(&v) })); i = i + 1 };
        yield_now();
        0
    })
}
#### expect
error: 5:48: in `main`: `F: 'static` says it borrows nothing, as a thread's does, which runs after the block a borrow would be of may have ended: give it what it uses (`let m = mine;` in its block)
#### case
use std::thread::{scope, Scope, Threads, join};
fn main() -> Int {
    scope(fn(s: &Scope) -> Int / {Threads} {
        let v = [1, 2];
        let h = s.spawn({ let mut w = v; push_at(&mut w, 3); len_at(&w) });
        join(h)
    })
}
#### expect
3
