#### A row of effects a trait leaves to an implementation: one function over a sink that performs nothing and one that does.
effect Out { out(Int) }
trait Sink {
    type Effects: EffectRow;
    fn put(&mut Self, Int) / { | Self::Effects };
}
struct Total(Int)
impl Sink for Total { type Effects = {}; fn put(t: &mut Total, n: Int) { t.0 = t.0 + n; } }
struct Loud
impl Sink for Loud { type Effects = {Out}; fn put(l: &mut Loud, n: Int) -> () / {Out} { out(n) } }
fn feed<S: Sink>(s: &mut S, upto: Int) / { | S::Effects } { if(upto > 0) { put(s, upto); feed(s, upto - 1) } else { () } }
fn main() -> Int {
    let mut t = Total(0);
    feed(&mut t, 4);
    let mut l = Loud;
    let heard = handle { feed(&mut l, 3); 0 }() { out(v, k) => v + k(()) };
    t.0 * 100 + heard }
#### expect
1006
