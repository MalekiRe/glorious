struct Column<T> { items: [T] }
trait Get<T> { fn take(&mut Self) -> Column<T>; fn put(&mut Self, Column<T>) }
impl<T, R> Get<T> for (Column<T>, R) {
    fn take(w: &mut (Column<T>, R)) -> Column<T> { replace(&mut w.0, Column { items: [] }) }
    fn put(w: &mut (Column<T>, R), c: Column<T>) { w.0 = c; }
}
impl<T, H, R> Get<T> for (Column<H>, R) where R: Get<T> {
    fn take(w: &mut (Column<H>, R)) -> Column<T> { <R as Get<T>>::take(&mut w.1) }
    fn put(w: &mut (Column<H>, R), c: Column<T>) { <R as Get<T>>::put(&mut w.1, c) }
}
trait System<W> { fn run(Self, &mut W) }
impl<W, A> System<W> for fn(&mut Column<A>) -> () where W: Get<A> {
    fn run(f: fn(&mut Column<A>) -> (), world: &mut W) {
        let mut a = <W as Get<A>>::take(world);
        f(&mut a);
        <W as Get<A>>::put(world, a)
    }
}
impl<W, A, B> System<W> for fn(&mut Column<A>, &Column<B>) -> () where W: Get<A>, W: Get<B> {
    fn run(f: fn(&mut Column<A>, &Column<B>) -> (), world: &mut W) {
        let mut a = <W as Get<A>>::take(world);
        let b = <W as Get<B>>::take(world);
        f(&mut a, &b);
        <W as Get<A>>::put(world, a);
        <W as Get<B>>::put(world, b)
    }
}
struct Position(Int)
struct Velocity(Int)
fn integrate(positions: &mut Column<Position>, velocities: &Column<Velocity>) {
    let mut i = 0;
    while({ i < len_at(&positions.items) }) {
        let Position(p) = positions.items[i];
        let Velocity(v) = velocities.items[i];
        positions.items[i] = Position(p + v);
        i = i + 1
    }
}
fn friction(velocities: &mut Column<Velocity>) {
    let mut i = 0;
    while({ i < len_at(&velocities.items) }) { let Velocity(v) = velocities.items[i]; velocities.items[i] = Velocity(v - 1); i = i + 1 }
}
fn main() -> Int {
    let mut world = (Column { items: [Position(0), Position(100)] }, (Column { items: [Velocity(5), Velocity(7)] }, ()));
    run(integrate, &mut world); run(friction, &mut world); run(integrate, &mut world);
    let ps = <(Column<Position>, (Column<Velocity>, ())) as Get<Position>>::take(&mut world);
    let Position(a) = ps.items[0]; let Position(b) = ps.items[1];
    a * 1000 + b
}
#### expect
9113
