fn go(o: &mut O) -> Int { let a = set(&mut o.i, 5); let b = set(&mut o.i, 6); o.k = o.k + o.i.n; a + b * 10 + o.k * 100 }
fn main() -> Int { let mut o = O { i: I { n: 1 }, k: 2 }; go(&mut o) + o.i.n * 1000 }
#### expect
6851
