#### An operation that says nothing can be stopped early; one declared `[1, 1]` is always resumed, so a value that has to be used can wait across it.
effect Yield { yield(Int) }
fn gen() / {Yield} { yield(1); yield(2); () }
fn find<T, U, V, e: EffectRow>(generator: fn() -> T / {Yield | e}, wanted: fn(Int) -> Result<U, V> / {| e}) -> Option<Int> / {| e} { handle generator() { _ => None, yield(value, k) => if(wanted(value)) { cancel(k); Some(value) } else { k(()) } } }
fn main() -> Option<Int> { find({ gen() }, { x => x > 1 }) }
#### expect
Ok(2)
