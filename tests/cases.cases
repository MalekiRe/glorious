#### A family of types, one for each type it is asked at: the trait takes the parameter and leaves a type to its implementations. A function may ask for it at two types.
trait Family<T> { type Of; fn single(T) -> Of }
struct Arrays
struct Options
impl<T> Family<T> for Arrays { type Of = [T]; fn single(x: T) -> [T] { [x] } }
impl<T> Family<T> for Options { type Of = Option<T>; fn single(x: T) -> Option<T> { Some(x) } }
fn twice<F, A, B>(a: Int, b: Str) -> (A, B) where F: Family<Int, Of = A>, F: Family<Str, Of = B> { (<F as Family<Int>>::single(a), <F as Family<Str>>::single(b)) }
fn main() -> Int { let p: ([Int], [Str]) = twice<Arrays>(3, "x"); let q: (Option<Int>, Option<Str>) = twice<Options>(4, "y"); len(p.0) + len(p.1) + match(q.0) { Some(n) => n, None => 0 } }
