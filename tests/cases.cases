pub struct Col<T>(T)
pub trait Registers<S> { type Out; fn register_all(S) -> Self::Out; }
impl<S> Registers<S> for () { type Out = S; fn register_all(c: S) -> S { c } }
impl<H, ..R, S> Registers<S> for (H, ..R) where (..R): Registers<S>, H: Default {
    type Out = (Col<H>, <(..R) as Registers<S>>::Out);
    fn register_all(c: S) -> (Col<H>, <(..R) as Registers<S>>::Out) { (Col(default<H>()), <(..R) as Registers<S>>::register_all(c)) }
}
pub struct App<S> { s: S }
impl<S> App<S> {
    pub fn register_all<C>(app: Self) -> App<<C as Registers<S>>::Out> where C: Registers<S> {
        let App { s } = app;
        App { s: <C as Registers<S>>::register_all(s) }
    }
}
use core::value::{Default, default};
pub trait Plugin<S> {
    type Components = ();
    fn register(app: App<S>) -> App<<Self::Components as Registers<S>>::Out> { app.register_all<Self::Components>() }
