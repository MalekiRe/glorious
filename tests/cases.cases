#### A condition on a type made from an implementation's type parameters, `where (M, ()): Fetch<..>`, is what the implementation's functions are given: a system's parameters, each fetched by what it asks for, for any shape of parameter list.
struct Col<T> { items: [T] }
struct World { a: Col<Int>, b: Col<Str> }
trait Get<T> { fn take(&mut Self) -> Col<T>; fn put(&mut Self, Col<T>); }
impl Get<Int> for World { fn take(w: &mut World) -> Col<Int> { let c = w.a; w.a = Col { items: [] }; c } fn put(w: &mut World, c: Col<Int>) { w.a = c } }
impl Get<Str> for World { fn take(w: &mut World) -> Col<Str> { let c = w.b; w.b = Col { items: [] }; c } fn put(w: &mut World, c: Col<Str>) { w.b = c } }

// What a parameter of a system is, without the reference: which column, and whether to change it.
struct Changed<A>(A)
struct Read<A>(A)
trait Kind { type Marker; }
impl<A> Kind for &mut Col<A> { type Marker = Changed<A>; }
impl<A> Kind for &Col<A> { type Marker = Read<A>; }

// A function called with what was gathered for it, last first.
trait CallWith<Gathered> { fn call_gathered(&Self, Gathered) }
impl<P> CallWith<((), P)> for fn(P) -> () { fn call_gathered(f: &fn(P) -> (), g: ((), P)) { (*f)(g.1) } }
impl<P, Q> CallWith<(((), P), Q)> for fn(P, Q) -> () { fn call_gathered(f: &fn(P, Q) -> (), g: (((), P), Q)) { (*f)(g.0.1, g.1) } }

// The columns a list of markers names, each taken out of the world, lent, and put back.
trait Fetch<W, Gathered, F> { fn fetch(&mut W, Gathered, &F) }
impl<W, G, F> Fetch<W, G, F> for () where F: CallWith<G> {
    fn fetch(world: &mut W, gathered: G, f: &F) { call_gathered(f, gathered) }
}
impl<W, G, F, A, Rest> Fetch<W, G, F> for (Changed<A>, Rest) where W: Get<A>, Rest: Fetch<W, (G, &mut Col<A>), F> {
    fn fetch(world: &mut W, gathered: G, f: &F) {
        let mut a = <W as Get<A>>::take(world);
        <Rest as Fetch<W, (G, &mut Col<A>), F>>::fetch(world, (gathered, &mut a), f);
        <W as Get<A>>::put(world, a)
    }
}
impl<W, G, F, A, Rest> Fetch<W, G, F> for (Read<A>, Rest) where W: Get<A>, Rest: Fetch<W, (G, &Col<A>), F> {
    fn fetch(world: &mut W, gathered: G, f: &F) {
        let a = <W as Get<A>>::take(world);
        <Rest as Fetch<W, (G, &Col<A>), F>>::fetch(world, (gathered, &a), f);
        <W as Get<A>>::put(world, a)
    }
}

trait System<W> { fn run(&Self, &mut W) }
impl<W, P, MP> System<W> for fn(P) -> () where P: Kind<Marker = MP>, (MP, ()): Fetch<W, (), fn(P) -> ()> {
    fn run(f: &fn(P) -> (), world: &mut W) { <(MP, ()) as Fetch<W, (), fn(P) -> ()>>::fetch(world, (), f) }
}
impl<W, P, Q, MP, MQ> System<W> for fn(P, Q) -> () where P: Kind<Marker = MP>, Q: Kind<Marker = MQ>, (MP, (MQ, ())): Fetch<W, (), fn(P, Q) -> ()> {
    fn run(f: &fn(P, Q) -> (), world: &mut W) { <(MP, (MQ, ())) as Fetch<W, (), fn(P, Q) -> ()>>::fetch(world, (), f) }
}

fn grow(ints: &mut Col<Int>) { push_at(&mut ints.items, 7) }
fn both(ints: &mut Col<Int>, words: &Col<Str>) { push_at(&mut ints.items, len_at(&words.items)) }
fn main() -> Int {
    let mut world = World { a: Col { items: [1] }, b: Col { items: ["x", "y"] } };
    let g = grow;
    run(&g, &mut world);
    let h = both;
    run(&h, &mut world);
    len_at(&world.a.items) * 10 + world.a.items[2]
}

