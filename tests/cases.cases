#### A private type's own `pub` functions may mention it; an iterator over a
#### `Vec` mapped and folded.
use std::vec::{Vec};
use std::iterator::{Iterator, map, fold};

struct Point { x: Int, y: Int }

impl Point {
    pub fn new(x: Int, y: Int) -> Self { Point { x, y } }
    pub fn manhattan(s: &Self) -> Int { s.x.abs() + s.y.abs() }
}

fn main() -> Int {
    let mut pts = Vec::new();
    pts.push(Point::new(1, 2));
    pts.push(Point::new(0 - 3, 4));
    let mut it = pts.iter().map({ p => p.manhattan() });
    fold(&mut it, 0, { (a, b) => a + b })
}
