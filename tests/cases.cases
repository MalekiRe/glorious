#### Text built up into a sink the caller owns; a type says how it is written.
use alloc::fmt::{Formatter, Display, format};
use alloc::string::{String};
struct Point { x: Int, y: Int }
impl Display for Point {
    fn fmt(p: &Point, out: &mut Formatter) {
        Formatter::write_str(out, "Point {"); Formatter::newline(out);
        Formatter::indent(out);
        Formatter::write_str(out, "x: "); Formatter::display(out, &p.x); Formatter::newline(out);
        Formatter::write_str(out, "y: "); Formatter::display(out, &p.y); Formatter::newline(out);
        Formatter::dedent(out);
        Formatter::write_str(out, "}");
    }
}
fn main() -> Int {
    let p = Point { x: 3, y: 4 };
    let written = format(&p);
    say(String::to_str(&written));
    let mut f = Formatter::new();
    Formatter::quoted(&mut f, "a \"b\"");
    say(match(Formatter::dedent(&mut f)) { Ok(_) => "ok", Err(_) => "cannot" });
    say(match(Formatter::finish(f)) { Ok(s) => String::to_str(&s), Err(_) => "?" });
    0 }
