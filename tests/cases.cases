#### A query over columns as head and rest, its columns as nested pairs

struct Entity { index: Int, generation: Int }
struct Column<T> { dense: [T], owners: [Entity], slots: [Int] }
fn slot_of<T>(column: &Column<T>, entity: Entity) -> Int {
    if(entity.index < len_at(&column.slots)) {
        let at = column.slots[entity.index];
        if(at >= 0) { if(column.owners[at].generation == entity.generation) { at } else { 0 - 1 } } else { 0 - 1 }
    } else { 0 - 1 }
}

trait Item { type Store; type Got<'a>; fn item_at<'a>(&'a mut Store, Entity) -> Option<Got<'a>> }
impl<A> Item for &mut A { type Store = Column<A>; type Got<'a> = &'a mut A;
    fn item_at<'a>(store: &'a mut Column<A>, entity: Entity) -> Option<&'a mut A> { let i = slot_of(&*store, entity); if(i >= 0) { Some(&mut store.dense[i]) } else { None } } }
impl<A> Item for &A { type Store = Column<A>; type Got<'a> = &'a A;
    fn item_at<'a>(store: &'a mut Column<A>, entity: Entity) -> Option<&'a A> { let i = slot_of(&*store, entity); if(i >= 0) { Some(&store.dense[i]) } else { None } } }


trait AllSome { type Out; fn all_some(Self) -> Option<Out> }
impl AllSome for () { type Out = (); fn all_some(x: ()) -> Option<()> { Some(()) } }
impl<H, ..R> AllSome for (Option<H>, ..R) where (..R): AllSome, <(..R) as AllSome>::Out: Spread {
    type Out = (H, ..<(..R) as AllSome>::Out);
    fn all_some(x: (Option<H>, ..R)) -> Option<(H, ..<(..R) as AllSome>::Out)> {
        let (h, ..r) = x;
        match(h) {
            Some(v) => match(all_some((..r))) { Some(w) => Some(spread_cons(v, w)), None => None },
            None => None
        }
    }
}

impl Item for () {
    type Store = ();
    type Got<'a> = ();
    fn item_at<'a>(store: &'a mut (), entity: Entity) -> Option<()> { Some(()) }
}
impl<H, ..R> Item for (H, ..R) where H: Item, (..R): Item {
    type Store = (H::Store, <(..R) as Item>::Store);
    type Got<'a> = (H::Got<'a>, ..R::Got<'a>);
    fn item_at<'a>(store: &'a mut (H::Store, <(..R) as Item>::Store), entity: Entity) -> Option<(H::Got<'a>, ..R::Got<'a>)> {
        match(<H as Item>::item_at(&mut store.0, entity)) {
            Some(h) => match(<(..R) as Item>::item_at(&mut store.1, entity)) {
                Some(rest) => let (..r) = rest; Some((h, ..r)),
                None => None
            },
            None => None
        }
    }
}

struct Position(Int)
struct Velocity(Int)


struct Query<Q, St = <Q as Item>::Store> { store: St, entities: [Entity] }

fn each<Q>(query: &mut Query<Q>, f: for<'a> fn(Entity, Q::Got<'a>)) where Q: Item {
    let mut i = 0;
    while({ i < len_at(&query.entities) }) {
        let entity = query.entities[i];
        match(<Q as Item>::item_at(&mut query.store, entity)) { Some(got) => f(entity, got), None => () };
        i = i + 1
    }
}

fn movement(query: &mut Query<(&mut Position, &Velocity)>) {
    each(query, fn(entity: Entity, got: (&mut Position, &Velocity)) { let (p, v) = got; (*p).0 = (*p).0 + (*v).0 })
}

fn main() -> Int {
    let e0 = Entity { index: 0, generation: 0 };
    let e1 = Entity { index: 1, generation: 0 };
    let ps = Column { dense: [Position(1), Position(2)], owners: [e0, e1], slots: [0, 1] };
    let vs = Column { dense: [Velocity(10)], owners: [e1], slots: [0 - 1, 0] };
    let mut query: Query<(&mut Position, &Velocity)> = Query { store: (ps, (vs, ())), entities: [e0, e1] };
    movement(&mut query);
    movement(&mut query);
    query.store.0.dense[1].0
}

