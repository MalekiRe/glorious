struct Col<T> { dense: [T], owners: [Int] }

fn find<T>(c: &Col<T>, e: Int) -> Int {
    let mut i = 0;
    let mut found = 0 - 1;
    while({ i < len_at(&c.owners) }) { if(c.owners[i] == e) { found = i } else { () }; i = i + 1 };
    found
}

trait Item { type Store; type Got<'a>; fn at<'a>(&'a mut Store, Int) -> Option<Got<'a>> }
struct W<T>(T)
struct R<T>(T)
impl<T> Item for W<T> { type Store = Col<T>; type Got<'a> = &'a mut T;
    fn at<'a>(store: &'a mut Col<T>, e: Int) -> Option<&'a mut T> { let i = find(&*store, e); if(i >= 0) { Some(&mut store.dense[i]) } else { None } } }
impl<T> Item for R<T> { type Store = Col<T>; type Got<'a> = &'a T;
    fn at<'a>(store: &'a mut Col<T>, e: Int) -> Option<&'a T> { let i = find(&*store, e); if(i >= 0) { Some(&store.dense[i]) } else { None } } }

