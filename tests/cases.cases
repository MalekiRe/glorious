#### case
#### A cursor, and a parser tried and repeated up to a limit (library 26.1).
use std::parse::{Cursor, ParseStep, ParseError, attempt, many};
use std::slice::{Slice};

fn digit<'a>(c: &mut Cursor<'a, char>) -> ParseStep<Int, Str> {
    match(Cursor::next(c)) {
        Some(ch) => match(std::char::digit(*ch)) { Some(n) => ParseStep::Matched(n), None => if(*ch == '!') { ParseStep::Failed("bang") } else { ParseStep::NoMatch } },
        None => ParseStep::NoMatch
    }
}
fn stuck<'a>(c: &mut Cursor<'a, char>) -> ParseStep<Int, Str> { ParseStep::Matched(0) }
fn run(text: Str, limit: Int) -> Int {
    let input = chars(text);
    let mut c = Cursor::new(Slice::of(&input));
    match(many(&mut c, limit, digit)) {
        Ok(found) => say(found); Cursor::position(&c),
        Err((found, ParseError::User(e))) => say(found); say(e); 0 - Cursor::position(&c),
        Err((found, ParseError::NoProgress)) => say(found); 0 - 100,
        Err((found, ParseError::Limit(_))) => say(found); 0 - 200
    }
}
fn main() -> Int {
    say(run("123ab", 10));
    say(run("12!", 10));
    say(run("12345", 3));
    let input = chars("ab");
    let mut c = Cursor::new(Slice::of(&input));
    say(match(many(&mut c, 5, stuck)) { Err((found, ParseError::NoProgress)) => len(found), _ => 0 - 1 });
    // What a parser that finds nothing read is given back.
    say(match(attempt(&mut c, digit)) { ParseStep::NoMatch => Cursor::position(&c), _ => 0 - 1 });
    0
}

