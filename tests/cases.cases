#### A condition saying what a type made of an implementation's parameters leaves, `F: Then<X, Out = Y>`, decides `Y` where the implementation is used.
trait Gathered { type Flat; fn flatten(Self) -> Flat }
impl Gathered for () { type Flat = (); fn flatten(nothing: ()) { () } }
impl<G, X, F, Y> Gathered for (G, X) where G: Gathered<Flat = F>, F: Then<X, Out = Y> {
    type Flat = Y;
    fn flatten(g: (G, X)) -> Y { let (before, last) = g; then(flatten(before), last) }
}
trait Then<X> { type Out; fn then(Self, X) -> Out }
impl<X> Then<X> for () { type Out = (X,); fn then(t: (), x: X) -> (X,) { (x,) } }
impl<H, ..R, X> Then<X> for (H, ..R) where (..R): Then<X>, <(..R) as Then<X>>::Out: Spread { type Out = (H, ..<(..R) as Then<X>>::Out); fn then(t: (H, ..R), x: X) -> (H, ..<(..R) as Then<X>>::Out) { let (h, ..r) = t; spread_cons(h, then((..r), x)) } }
trait CallWith<G, O> { fn call_with(&Self, G) -> O }
impl<G, ..P, O> CallWith<G, O> for fn(..P) -> O where G: Gathered<Flat = (..P)> {
    fn call_with(f: &fn(..P) -> O, g: G) -> O { let (..p) = flatten(g); (*f)(..p) }
}
fn add(a: Int, b: Int) -> Int { a + b }
fn main() -> Int { let t: (Int, Int) = flatten((((), 1), 2)); t.0 + t.1 }
#### expect
3
#### case
trait Gathered { type Flat; fn flatten(Self) -> Flat }
impl Gathered for () { type Flat = (); fn flatten(nothing: ()) { () } }
impl<G, X, F, Y> Gathered for (G, X) where G: Gathered<Flat = F>, F: Then<X, Out = Y> {
    type Flat = Y;
    fn flatten(g: (G, X)) -> Y { let (before, last) = g; then(flatten(before), last) }
}
trait Then<X> { type Out; fn then(Self, X) -> Out }
impl<X> Then<X> for () { type Out = (X,); fn then(t: (), x: X) -> (X,) { (x,) } }
impl<H, ..R, X> Then<X> for (H, ..R) where (..R): Then<X>, <(..R) as Then<X>>::Out: Spread { type Out = (H, ..<(..R) as Then<X>>::Out); fn then(t: (H, ..R), x: X) -> (H, ..<(..R) as Then<X>>::Out) { let (h, ..r) = t; spread_cons(h, then((..r), x)) } }
trait CallWith<G, O> { fn call_with(&Self, G) -> O }
impl<G, ..P, O> CallWith<G, O> for fn(..P) -> O where G: Gathered<Flat = (..P)> {
    fn call_with(f: &fn(..P) -> O, g: G) -> O { let (..p) = flatten(g); (*f)(..p) }
