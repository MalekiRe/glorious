#### case
#### `std::diagnostic`: a diagnostic written out with its places, notes up to a limit, refused when too long, a place in no text, a bag that gives back what it has no room for, and the order they come out in.
use std::diagnostic::{Severity, Diagnostic, DiagnosticBag, DiagnosticCode, RenderOptions, render_diagnostic};
use std::source::{SourceMap, SourceSpan, SourceId};

fn shown(d: &Diagnostic, sources: &SourceMap, most_notes: Int, most_bytes: Int) -> Str {
    match(render_diagnostic(d, sources, RenderOptions { maximum_notes: most_notes, maximum_bytes: most_bytes })) {
        Ok(text) => text,
        Err(_) => "(too long)\n"
    }
}

fn report(sources: &SourceMap, id: SourceId, elsewhere: SourceId) -> Int {
    let mut unknown = Diagnostic::new(Severity::Error, DiagnosticCode::from_u32(17u32), "unknown name `z`");
    Diagnostic::primary(&mut unknown, SourceSpan { source: id, start: 23, end: 24 }, "not declared");
    Diagnostic::secondary(&mut unknown, SourceSpan { source: id, start: 4, end: 5 }, "`x` is declared here");
    Diagnostic::note(&mut unknown, "names are looked for in the block they are written in");
    Diagnostic::note(&mut unknown, "and in the blocks around it");
    Diagnostic::help(&mut unknown, "declare it with `let z = ..;`");
    say(shown(&unknown, sources, 8, 400));
    say(shown(&unknown, sources, 1, 400));
    say(shown(&unknown, sources, 8, 40));
    let mut unused = Diagnostic::new(Severity::Warning, DiagnosticCode::from_u32(3u32), "`y` is never used");
    Diagnostic::primary(&mut unused, SourceSpan { source: id, start: 15, end: 16 }, "");
    let mut lost = Diagnostic::new(Severity::Note, DiagnosticCode::from_u32(1u32), "somewhere else");
    Diagnostic::primary(&mut lost, SourceSpan { source: elsewhere, start: 0, end: 1 }, "in a text nobody has");
    say(shown(&lost, sources, 8, 400));
    let mut bag = DiagnosticBag::new(2);
    let a = match(DiagnosticBag::push(&mut bag, unknown)) { Ok(_) => "kept", Err(_) => "given back" };
    let b = match(DiagnosticBag::push(&mut bag, unused)) { Ok(_) => "kept", Err(_) => "given back" };
    let c = match(DiagnosticBag::push(&mut bag, lost)) { Ok(_) => "kept", Err(d) => "given back: " ++ Diagnostic::message(&d) };
    say(a ++ ", " ++ b ++ ", " ++ c);
    say(DiagnosticBag::has_errors(&bag));
    let n = DiagnosticBag::len(&bag);
    let all = DiagnosticBag::into_vec(bag);
    say(Diagnostic::code(&all[0]));
    say(Diagnostic::code(&all[1]));
    n
}

fn main() -> Int {
    let mut sources = SourceMap::new();
    let mut others = SourceMap::new();
    match(SourceMap::insert(&mut others, "a", "")) { Ok(_) => (), Err(_) => () };
    match(SourceMap::insert(&mut sources, "main.gl", "let x = 1;\nlet y = x + z;\n")) {
        Err(_) => 0 - 1,
        Ok(id) => match(SourceMap::insert(&mut others, "b", "")) {
            Err(_) => 0 - 2,
            Ok(elsewhere) => report(&sources, id, elsewhere)
        }
    }
}

