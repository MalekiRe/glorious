use std::vec::{Vec};
use std::iterator::{Iterator, fold};
fn main() -> Int {
    let mut v = Vec::new();
    v.extend([5, 1, 4, 2, 3]);
    say(v.contains(&4));
    say(v.swap_remove(1));
    say(Vec::into_array(v.clone()));
    v.retain({ x => *x > 2 });
    say(Vec::into_array(v.clone()));
    let _ = v.rotate_left(1);
    say(Vec::into_array(v.clone()));
    let _ = v.swap(0, 2);
    say(Vec::into_array(v.clone()));
    v.resize(5, 0);
    say(Vec::into_array(v.clone()));
    match(v.split_off(3)) { Ok(back) => say(Vec::into_array(back)), Err(_) => () };
    say(v.replace(0, 9));
    *v.index_mut(1) = 7;
    let mut it = v.into_iter();
    fold(&mut it, 0, { (a, x) => a * 10 + x })
}

