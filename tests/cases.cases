#### A trait can leave a type to its implementations.
trait Container { type Item; fn first(Self) -> Item }
struct Ints(Int, Int)
struct Flags(Bool)
impl Container for Ints { type Item = Int; fn first(c: Ints) -> Int { c.0 } }
impl Container for Flags { type Item = Bool; fn first(c: Flags) -> Bool { c.0 } }
fn main() -> Int { let n = first(Ints(4, 5)) + 1; if(first(Flags(1 < 2))) { n } else { 0 } }
#### expect
