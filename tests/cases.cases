use alloc::vec::{Vec};
use core::iter::{fold};
use alloc::fmt::{format, Display};
use alloc::string::{String};
fn main() -> Int {
    let mut v = Vec::new();
    Vec::push(&mut v, 3); Vec::push(&mut v, 4);
    let mut it = Vec::iter(&v);
    let total = fold(&mut it, 0, { (acc, r) => acc + *r });
    let s = String::from_str("hi");
    say(String::to_str(&format(&s)));
    total }
