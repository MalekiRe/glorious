#### Bytes read and written a number at a time (library 23).
use std::slice::{Slice};
use std::bytes::{ByteBuf, ByteReader, hex_encode, hex_decode};

fn check(ok: Bool, n: Int) -> Int { if(ok) { 0 } else { say(n); 1 } }
fn main() -> Int {
    let mut b = ByteBuf::new();
    ByteBuf::push(&mut b, 7u8);
    ByteBuf::write_u16_le(&mut b, 513u16);
    ByteBuf::write_u32_be(&mut b, 16909060u32);
    ByteBuf::write_var_u64(&mut b, 300u64);
    ByteBuf::write_u64_le(&mut b, 18446744073709551615u64);
    ByteBuf::align_zeroed(&mut b, 8);
    let m = ByteBuf::mark(&b);
    ByteBuf::write_u16_le(&mut b, 0u16);
    let end = ByteBuf::len(&b);
    ByteBuf::patch_u16_le(&mut b, end - 2, 65535u16);
    say(hex_encode(ByteBuf::as_slice(&b)));
    ByteBuf::truncate_to(&mut b, m);
    let bytes = ByteBuf::finish(b);
    say(len(bytes));
    let mut r = ByteReader::new(Slice::of(&bytes));
    let mut bad = 0;
    bad = bad + check(ByteReader::read_u8(&mut r) is Ok(7u8), 1);
    bad = bad + check(ByteReader::read_u16_le(&mut r) is Ok(513u16), 2);
    bad = bad + check(ByteReader::read_u32_be(&mut r) is Ok(16909060u32), 3);
    bad = bad + check(ByteReader::read_var_u64(&mut r) is Ok(300u64), 4);
    let mark = ByteReader::mark(&r);
    bad = bad + check(match(ByteReader::read_i64_le(&mut r)) { Ok(n) => int(n) == 0 - 1, Err(_) => false }, 5);
    ByteReader::restore(&mut r, mark);
    bad = bad + check(ByteReader::read_u64_le(&mut r) is Ok(18446744073709551615u64), 6);
    say(ByteReader::position(&r));
    // A read past the end fails and stays where it was.
    let before = ByteReader::position(&r);
    bad = bad + check(ByteReader::read_u64_le(&mut r) is Err(_), 7);
    bad = bad + check(ByteReader::position(&r) == before, 8);
    let left = ByteReader::remaining_len(&r);
    ByteReader::skip(&mut r, left);
    bad = bad + check(ByteReader::finish(r) is Ok(_), 9);
    say(match(hex_decode("00ff7F")) { Ok(found) => found, Err(_) => [] });
    say(match(hex_decode("0g")) { Ok(_) => 0 - 1, Err(e) => e.offset });
    // The one shortest way: a redundant last byte is refused.
    let padded = [128u8, 0u8];
    let mut p = ByteReader::new(Slice::of(&padded));
    bad = bad + check(ByteReader::read_var_u64(&mut p) is Err(_), 10);
    let text = [104u8, 105u8, 33u8];
    let mut t = ByteReader::new(Slice::of(&text));
    say(match(ByteReader::read_str(&mut t, 2)) { Ok(s) => s, Err(_) => "?" });
    bad
}

