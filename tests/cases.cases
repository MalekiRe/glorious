trait Iterator { type Item; fn next(&mut Self) -> Option<Self::Item>; }
struct Slice<'a, T> { items: &'a [T], from: Int, to: Int }
struct SliceIter<'a, T> { items: &'a [T], at: Int, end: Int }
impl<'a, T> Slice<'a, T> {
    fn of(items: &'a [T]) -> Self { Self { items: items, from: 0, to: len_at(items) } }
    fn iter(s: &Self) -> SliceIter<'a, T> { SliceIter { items: s.items, at: s.from, end: s.to } }
}
impl<'a, T> Iterator for SliceIter<'a, T> {
    type Item = &'a T;
    fn next(it: &mut SliceIter<'a, T>) -> Option<&'a T> { if(it.at < it.end) { let i = it.at; it.at = i + 1; element(it.items, i) } else { None } }
}
fn total<'a, I: Iterator<Item = &'a Int>>(it: &mut I, acc: Int) -> Int { match(next(it)) { Some(r) => tail total(it, acc + *r), None => acc } }
fn main() -> Int { let a = [1, 2, 3, 4]; let s = Slice::of(&a); let mut it = Slice::iter(&s); total(&mut it, 0) }
#### expect
10
