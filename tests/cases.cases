#### Streams: bytes written to memory and read back, performing nothing.
use std::stream::{Read, Write, MemoryCursor, write_all, write_str, read_to_end, read};
use alloc::string::{String};
fn main() -> Int {
    let mut c = MemoryCursor::new([]);
    write_str(&mut c, "hello, ");
    write_str(&mut c, "streams");
    let first = match(read(&mut c, 5)) { Ok(b) => len(b), Err(_) => 0 - 1 };
    let rest = match(read_to_end(&mut c, 1000)) { Ok(b) => b, Err(_) => [] };
    say(match(String::from_utf8(rest)) { Ok(s) => String::to_str(&s), Err(_) => "?" });
    first * 100 + MemoryCursor::position(&c) }
#### expect
, streams
514
