#### case
trait Container { type Item; fn first(Self) -> Item }
struct Ints(Int, Int)
impl Container for Ints { type Item = Int; fn first(c: Ints) -> Int { c.0 } }
fn head<C>(c: C) -> C::Item where C: Container { first(c) }
fn main() -> Int { head(Ints(7, 8)) + 1 }
#### expect
8
#### case
trait Container { type Item; fn first(Self) -> Item }
struct Wrap<T>(T)
impl<T> Container for Wrap<T> { type Item = T; fn first(w: Wrap<T>) -> T { match(w) { Wrap(x) => x } } }
fn twice<T, U>(c: T) -> U where T: Container { let a = first(c); a }
