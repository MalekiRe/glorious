#### case
#### Tables with places of their own kind, and sets and queues of places (library 24).
use std::index::{Id, IndexVec, Arena, GenArena, StringInterner, BitSet, SparseSet, WorkQueue};

struct Function;
struct Name;
fn ids<Tag>(found: [Id<Tag>], i: Int, out: [Int]) -> [Int] { if(i >= len(found)) { out } else { ids(found, i + 1, push(out, Id::index(found[i]))) } }
fn id<Tag>(n: Int) -> Id<Tag> { match(Id::at(n)) { Ok(found) => found, Err(_) => Id::from_u32(0u32) } }
fn main() -> Int {
    let mut names: IndexVec<Function, Str> = IndexVec::new();
    let a = match(IndexVec::push(&mut names, "main")) { Ok(found) => found, Err(_) => id(99) };
    let b = match(IndexVec::push(&mut names, "helper")) { Ok(found) => found, Err(_) => id(99) };
    say(Id::index(b));
    say(match(IndexVec::get(&names, a)) { Some(name) => *name, None => "?" });
    // An arena cut back to a mark.
    let mut arena: Arena<Function, Int> = Arena::new();
    Arena::insert(&mut arena, 10);
    let mark = Arena::mark(&arena);
    Arena::insert(&mut arena, 20);
    Arena::insert(&mut arena, 30);
    say(match(Arena::rollback_take(&mut arena, mark)) { Ok(taken) => taken, Err(_) => [] });
    say(Arena::len(&arena));
    // A place used again refuses its old name.
    let mut pool: GenArena<Function, Str> = GenArena::new();
    match(GenArena::insert(&mut pool, "one")) {
        Ok(first) =>
            say(match(GenArena::remove(&mut pool, first)) { Some(text) => text, None => "?" });
            match(GenArena::insert(&mut pool, "two")) {
                Ok(second) =>
                    say(GenArena::contains(&pool, first));
                    say(match(GenArena::get(&pool, second)) { Some(text) => *text, None => "?" });
                    (),
                Err(_) => ()
            },
        Err(_) => ()
    };
    say(GenArena::into_vec(pool));
    // Texts kept once.
    let mut texts: StringInterner<Name> = StringInterner::new();
    let x = match(StringInterner::intern(&mut texts, "x")) { Ok(found) => found, Err(_) => id(99) };
    let y = match(StringInterner::intern(&mut texts, "y")) { Ok(found) => found, Err(_) => id(99) };
    let again = match(StringInterner::intern(&mut texts, "x")) { Ok(found) => found, Err(_) => id(99) };
    say((Id::index(x), Id::index(y), Id::index(again)));
    say(StringInterner::len(&texts));
    say(match(StringInterner::get(&texts, y)) { Some(text) => text, None => "?" });
    // Sets of places.
    let mut seen: BitSet<Function> = BitSet::new();
    BitSet::insert(&mut seen, id(5)); BitSet::insert(&mut seen, id(1)); say(BitSet::insert(&mut seen, id(5)));
    let mut more: BitSet<Function> = BitSet::new();
    BitSet::insert(&mut more, id(1)); BitSet::insert(&mut more, id(8));
    say(BitSet::union_with(&mut seen, &more));
    say(ids(BitSet::to_vec(&seen), 0, []));
    say(BitSet::is_subset(&more, &seen));
    say(BitSet::subtract(&mut seen, &more));
    say((ids(BitSet::to_vec(&seen), 0, []), BitSet::len(&seen)));
    let mut sparse: SparseSet<Function> = SparseSet::new();
    SparseSet::insert(&mut sparse, id(7)); SparseSet::insert(&mut sparse, id(2)); SparseSet::insert(&mut sparse, id(4));
    SparseSet::remove(&mut sparse, id(7));
    say((ids(SparseSet::to_vec(&sparse), 0, []), SparseSet::contains(&sparse, id(7)), SparseSet::contains(&sparse, id(4))));
    // Each waits once, first in first out.
    let mut work: WorkQueue<Function> = WorkQueue::new();
    WorkQueue::push(&mut work, id(3)); WorkQueue::push(&mut work, id(1)); say(WorkQueue::push(&mut work, id(3)));
    let p = match(WorkQueue::pop(&mut work)) { Some(found) => Id::index(found), None => 0 - 1 };
    say(WorkQueue::push(&mut work, id(3)));
    let q = match(WorkQueue::pop(&mut work)) { Some(found) => Id::index(found), None => 0 - 1 };
    let r = match(WorkQueue::pop(&mut work)) { Some(found) => Id::index(found), None => 0 - 1 };
    say((p, q, r));
    say(WorkQueue::is_empty(&work));
    0
}

