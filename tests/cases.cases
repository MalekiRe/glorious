#### What is there, where it is: `as_ref`, `as_mut`, `take`; and maps looked into and changed in place.
use core::option::{as_ref, as_mut, take};
fn main() -> Int {
    let mut a = Some(4);
    match(as_mut(&mut a)) { Some(r) => *r = *r * 2;, None => () };
    let seen = match(as_ref(&a)) { Some(r) => *r, None => 0 };
    let had = take(&mut a);
    say(had); say(a);
    seen }
#### expect
Ok(8)
Err(())
8
