  effect H { h() -> Int }
  fn work() -> Int / {H, A} { let r = @out { defer @out(1); h() }; r + a() }
  fn main() -> Int { handle (handle work() { h(k) => cancel(k); 7 }) { a(k2) => k2(100) } }
#### expect
