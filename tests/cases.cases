trait Total { fn total(Self) -> Int }
impl<const N: Int> Total for [Int; N] where N: Known {
    fn total(xs: [Int; N]) -> Int { let mut sum = 0; let mut i = 0; while({ i < N::VALUE }) { sum = sum + xs[i]; i = i + 1 }; sum }
}
