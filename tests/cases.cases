#### A row with several unknown parts: a function over two streams performs what reading the one and writing the other do.
use std::stream::{Read, Write, MemoryCursor, read, write, write_str, read_to_end};
use std::host::{IoError};
fn copy<R: Read, W: Write>(reader: &mut R, writer: &mut W, done: Int) -> Result<Int, IoError> {
    match(read(reader, 4)) {
        Ok(got) =>
            if(len(got) == 0) { Ok(done) }
            else { match(write(writer, got)) { Ok(n) => copy(reader, writer, done + n), Err(e) => Err(e) } },
        Err(e) => Err(e)
    }
}
fn main() -> Int {
    let mut from = MemoryCursor::new([]);
    write_str(&mut from, "0123456789");
    let mut to = MemoryCursor::new([]);
    match(copy(&mut from, &mut to, 0)) { Ok(n) => n * 100 + len(MemoryCursor::into_inner(to)), Err(_) => 0 - 1 } }
