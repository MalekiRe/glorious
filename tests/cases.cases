#### Generators: a computation that yields is a value; resuming it uses it up.
use std::generator::*;
fn main() -> Int {
    let g = generator({ yield(1); yield(2); 9 });
    match(resume(g, ())) {
        Yielded { value, rest } => match(resume(rest, ())) {
            Yielded { value: second, rest: more } => match(resume(more, ())) { Complete(last) => value * 100 + second * 10 + last, Yielded { value: v, rest: r } => 0 - 1 },
            Complete(_) => 0 - 2
        },
        Complete(_) => 0 - 3
    } }
#### expect
129
