#### A function a program defines can choose between two blocks the same way.
effect Ask { ask() -> Int }
    fn pick<T, U, V, F0, F1, e: EffectRow>(c: Result<T, U>, a: F0, b: F1) -> V / {| e} where F0: Fn<(), Output = V, Effects = {| e}>, F0: Use<[0, 1]>, F1: Fn<(fn() -> V / {| e},), Output = V, Effects = {| e}>, F1: Use<[0, 1]> { match(c) { Ok(_) => a(), Err(_) => b(a) } }
    fn main() -> Int { handle ask() + 1 { ask(k) => pick(2 < 1, { k(1) }, { k(2) }) } }
#### expect
3
