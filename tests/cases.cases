enum Maybe<T> { Nothing, Just(T) }
trait Show { fn show(Self) -> Int }
impl Show for Int { fn show(x: Int) -> Int { x } }
impl<T> Show for Maybe<T> where T: Show { fn show(o: Maybe<T>) -> Int { match(o) { Just(v) => show(v) + 100, Nothing => 0 } } }
fn twice<T>(x: T) -> Int where T: Show, T: Use<[0, *]> { show(x) + show(x) }
fn main() -> Int { twice(1) + twice(Just(2)) + twice(Just(Just(3))) }
#### expect
612
