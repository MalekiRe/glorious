#### case
#### A type's own functions with dot calls on fields through references,
#### `@finish` of `Board::finish`, a field of an element borrowed.
use std::vec::{Vec};

enum Status { Open, Done }
struct Task { id: Int, title: Str, status: Status, priority: Int }

impl Show for Status { fn show(s: Status) -> Str { match(s) { Open => "open", Done => "done" } } }
impl Show for Task { fn show(t: Task) -> Str { "#" ++ show(t.id) ++ " " ++ t.title ++ " [" ++ show(t.status) ++ "]" } }

effect Log { log(Str) }

struct Board { tasks: Vec<Task>, next: Int }

impl Board {
    fn new() -> Board { Board { tasks: Vec::new(), next: 1 } }
    fn add(b: &mut Board, title: Str, priority: Int) -> Int / { Log } {
        let id = b.next;
        b.next = b.next + 1;
        b.tasks.push(Task { id: id, title: title, status: Open, priority: priority });
        log("added " ++ title);
        id
    }
    fn finish(b: &mut Board, id: Int) -> Result<(), Str> / { Log } {
        let mut i = 0;
        while({ i < b.tasks.len() }) {
            if(b.tasks[i].id == id) {
                match(b.tasks[i].status) {
                    Done => return(Err("already done"), @finish),
                    Open => b.tasks[i].status = Done
                };
                log("finished " ++ show(id));
                return(Ok(()), @finish)
            } else { () };
            i = i + 1
        };
        Err("no such task")
    }
    fn open_count(b: &Board) -> Int {
        let mut n = 0;
        let mut i = 0;
        while({ i < b.tasks.len() }) {
            match(&b.tasks[i].status) { &Open => n = n + 1, &Done => () };
            i = i + 1
        };
        n
    }
}

fn main() -> Int {
    let mut lines = Vec::new();
    let mut b = Board::new();
    let r = handle {
        b.add("write parser", 2);
        b.add("fix lexer", 1);
        let t = b.add("ship", 3);
        let first = b.finish(t);
        let again = b.finish(t);
        let missing = b.finish(99);
        (first, again, missing)
    }() {
        log(m, k) => Vec::push(&mut lines, m); k(())
    };
    say(r);
    say(lines.len());
    b.open_count()
}

#### expect
(Ok(()), Err(already done), Err(no such task))
4
2
