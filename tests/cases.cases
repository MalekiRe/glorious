#### case
#### Reflection (std::reflect): what is not `pub` is seen and set only by
#### the unsafe functions; the safe ones see a type that is not `pub` as
#### opaque, and none of its fields that are not `pub`.
use std::reflect::{describe, describe_unchecked, set_field, set_field_unchecked, type_info, type_info_unchecked, Described, NoValue, FlagValue, WholeValue, FloatValue, CharValue, TextValue, StructValue, ListValue, OpaqueValue};
pub struct Armor { pub value: u8, tough: Bool }
pub struct Hp(pub Int)
struct Secret { code: Int }
enum Shape { Dot, Line(Int, Int) }
fn show_d(d: Described) -> Str {
    match(d) {
        NoValue => "()",
        FlagValue(b) => if(b) { "true" } else { "false" },
        WholeValue(n) => show(n),
        FloatValue(_) => "float",
        CharValue(_) => "char",
        TextValue(t) => t,
        StructValue(name, fields) => name ++ "{" ++ fold(fields, "", fn(out: Str, f: (Str, Described)) -> Str { let (n, v) = f; out ++ " " ++ n ++ ": " ++ show_d(v) }) ++ " }",
        ListValue(_) => "list",
        OpaqueValue(n) => "opaque " ++ n
    }
}
fn main() -> Int {
    let mut a = Armor { value: 3, tough: false };
    say(show_d(describe(&a)));
    say(show_d(unsafe { describe_unchecked(&a) }));
    say(match(set_field(&mut a, "value", "200")) { Ok(d) => show_d(d), Err(e) => e });
    say(match(set_field(&mut a, "value", "300")) { Ok(d) => show_d(d), Err(e) => e });
    say(match(set_field(&mut a, "tough", "true")) { Ok(d) => show_d(d), Err(e) => e });
    say(match(unsafe { set_field_unchecked(&mut a, "tough", "true") }) { Ok(d) => show_d(d), Err(e) => e });
    say(show_d(unsafe { describe_unchecked(&a) }));
    let s = Secret { code: 7 };
    say(show_d(describe(&s)));
    say(show_d(unsafe { describe_unchecked(&s) }));
    say(show_d(describe(&Shape::Line(1, 2))));
    let info = type_info<Armor>();
    say(len_at(&info.variants[0].fields));
    let all = unsafe { type_info_unchecked<Armor>() };
    say(all.variants[0].fields[1].name);
    0
}

