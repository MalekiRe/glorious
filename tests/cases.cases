#### case
#### Reaching, ordering and grouping the nodes of a graph (library 26.2).
use std::graph::{Graph, GraphError, successors, reachable, topological_order, strongly_connected_components};
use std::budget::{StepBudget};
use std::slice::{Slice};

// Each node leads to those listed at its place.
struct Edges { to: [[Int]] }
impl Graph for Edges {
    type Node = Int;
    fn successors(g: &Edges, node: Int) -> [Int] { match(element(&g.to, node)) { Some(next) => *next, None => [] } }
}
fn main() -> Int {
    // 0 -> 1 -> 2 -> 0 is a circle; 2 -> 3 -> 4; 5 is apart.
    let g = Edges { to: [[1], [2], [0, 3], [4], [], [4]] };
    let mut budget = StepBudget::new(1000);
    say(match(reachable(&g, 3, &mut budget)) { Ok(found) => found, Err(_) => [] });
    say(match(reachable(&g, 0, &mut budget)) { Ok(found) => found, Err(_) => [] });
    let tail_nodes = [5, 3];
    say(match(topological_order(&g, Slice::of(&tail_nodes), &mut budget)) { Ok(order) => order, Err(_) => [] });
    let all = [0, 5];
    say(match(topological_order(&g, Slice::of(&all), &mut budget)) { Ok(_) => [], Err(GraphError::Cycle(c)) => c.nodes, Err(GraphError::Limit(_)) => [0 - 1] });
    say(match(strongly_connected_components(&g, Slice::of(&all), &mut budget)) { Ok(groups) => groups, Err(_) => [] });
    let mut small = StepBudget::new(2);
    say(match(reachable(&g, 0, &mut small)) { Ok(_) => 0 - 1, Err(e) => e.remaining });
    1000 - StepBudget::remaining(&budget)
}

