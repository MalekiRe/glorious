#### case
use std::future::{Future, FutureStep, Await, await, poll, ready, block_on};

// Done after so many polls.
struct Countdown { left: Int, value: Int }
impl Future for Countdown {
    type Output = Int;
    fn poll(c: Countdown) -> FutureStep<Int, Countdown> { if(c.left <= 0) { FutureStep::Ready(c.value) } else { say(c.left); FutureStep::Pending(Countdown { left: c.left - 1, value: c.value }) } }
}
fn main() -> Int {
    let a = block_on({ await(Countdown { left: 2, value: 40 }) + await(Countdown { left: 1, value: 2 }) });
    let b = block_on({ length(await(ready("done"))) });
    a * 10 + b
}

