#### case
#### Texts by number, and places in them by line and by UTF-16 column (library 25.1).
use std::source::{SourceMap, SourceSpan, SourceError, Utf16Location};

fn main() -> Int {
    let mut map = SourceMap::new();
    match(SourceMap::insert(&mut map, "a.gl", "let x = 1;\nsay(\"h\u{e9}\u{1F600}!\");\nend")) {
        Err(_) => 0 - 1,
        Ok(id) =>
            say(match(SourceMap::name(&map, id)) { Some(n) => n, None => "?" });
            say(match(SourceMap::locate(&map, id, 15)) { Ok(at) => (at.line, at.column_bytes), Err(_) => (0 - 1, 0) });
            say(match(SourceMap::line_range(&map, id, 1)) { Ok(range) => range, Err(_) => (0 - 1, 0) });
            say(match(SourceMap::slice(&map, SourceSpan { source: id, start: 11, end: 14 })) { Ok(text) => text, Err(_) => "?" });
            // `é` is two bytes and one unit; the face is four bytes and two units.
            say(match(SourceMap::to_utf16(&map, id, 24)) { Ok(at) => (at.line, at.column_units), Err(_) => (0 - 1, 0) });
            say(match(SourceMap::from_utf16(&map, id, Utf16Location { line: 1, column_units: 9 })) { Ok(at) => at, Err(_) => 0 - 1 });
            // Inside the face: a place between its two units, or among its bytes.
            say(match(SourceMap::from_utf16(&map, id, Utf16Location { line: 1, column_units: 8 })) { Ok(at) => at, Err(SourceError::InvalidBoundary) => 0 - 2, Err(_) => 0 - 1 });
            say(match(SourceMap::locate(&map, id, 20)) { Ok(_) => 0, Err(SourceError::InvalidBoundary) => 0 - 2, Err(_) => 0 - 1 });
            say(match(SourceMap::locate(&map, id, 999)) { Ok(_) => 0, Err(SourceError::InvalidRange) => 0 - 3, Err(_) => 0 - 1 });
            say(match(SourceMap::line_range(&map, id, 2)) { Ok(range) => range, Err(_) => (0 - 1, 0) });
            SourceMap::len(&map)
    }
}

