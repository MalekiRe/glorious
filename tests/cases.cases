#### case
#### (A value of a type a function is generic in, taken by a pattern and
#### used after a loop: a loop is a call that comes back, not a path on
#### which it is left unused.)
mod m {
use core::iter::{into_iter, next};
pub struct World<S> { pub columns: S, pub generations: [Int], pub free: [Int] }
pub struct Commands<S> { pub queue: [fn(&mut World<S>) -> ()], pub next: Int, pub made: Int }
impl<S> Commands<S> {
    pub fn queue(commands: &mut Self, f: fn(&mut World<S>) -> ()) { push_at(&mut commands.queue, f) }
}
pub struct WQ<'w, S> { world: &'w mut World<S>, put_back: fn(&mut World<S>) -> () }
impl<'w, S> Drop for WQ<'w, S> { fn drop(q: &mut WQ<'w, S>) { (q.put_back)(q.world) } }
pub fn apply<S>(commands: Commands<S>, world: &mut World<S>) {
    let Commands { queue, next: _, made } = commands;
    let mut k = 0;
    while({ k < made }) { push_at(&mut world.generations, 0); k = k + 1 };
    let mut each = into_iter(queue);
    while({ match(next(&mut each)) { Some(f) => f(world); true, None => false } }) { () }
}
}
use m::{World, Commands, apply};
fn main() -> Int {
    let mut w = World { columns: 5, generations: [], free: [] };
    let mut c = Commands { queue: [], next: 0, made: 2 };
    c.queue(fn(w: &mut World<Int>) { w.columns = w.columns + 1 });
    apply(c, &mut w);
    w.columns + len_at(&w.generations)
}
