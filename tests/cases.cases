#### Sizes and alignments as the specification lays types out (4.4): fields
#### in order at their alignment, an enum's tag, a field of the type itself
#### a pointer (`Str`).
struct Unit
struct Pair(u8, i32)
struct Point { x: Int, y: Int }
enum Shape { Dot, Line(Point, Point), Flag(u8) }
struct Wrap<T>(T, u8)
fn main() -> Int {
    say(size_of<()>());
    say(size_of<Unit>());
    say(size_of<u8>());
    say(size_of<Pair>());
    say(align_of<Pair>());
    say(size_of<Point>());
