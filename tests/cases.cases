#### `where I::Item: Ord`.
use std::iterator::{Iterator, range, next};
fn biggest<I: Iterator>(it: &mut I) -> Option<I::Item> where I::Item: Ord { match(next(it)) { Some(x) => Some(go(it, x)), None => None } }
fn go<I: Iterator>(it: &mut I, best: I::Item) -> I::Item where I::Item: Ord, ItemOfI: Use<[0, *]> { match(next(it)) { Some(x) => if(best < x) { go(it, x) } else { go(it, best) }, None => best } }
fn main() -> Int { let mut r = range(2, 7); match(biggest(&mut r)) { Some(n) => n, None => 0 } }
