#### Library conformance S44: taking the last element off an array of values that have to be used hands each on.
struct Ticket(Int);
impl Use<[1, 1]> for Ticket {}
fn redeem(t: Ticket) -> Int { match(t) { Ticket(n) => n } }
fn drain(items: [Ticket], total: Int) -> Int { match(pop(items)) { Some((rest, t)) => let got = redeem(t); tail drain(rest, total + got), None => total } }
fn main() -> Int { drain([Ticket(1), Ticket(2)], 0) }
#### expect
3
