#### One function over a stream in memory, which performs nothing, and the host's standard output.
use std::stream::{Write, Stdout, MemoryCursor, write_str};
use std::host::{run_host};
fn greet<W: Write>(w: &mut W) / { | <W as Write>::Effects } { write_str(w, "hi from a stream\n"); () }
fn main() -> Int {
    let mut memory = MemoryCursor::new([]);
    greet(&mut memory);
    let n = len(MemoryCursor::into_inner(memory));
    run_host({ let mut out = Stdout; greet(&mut out); n }) }
