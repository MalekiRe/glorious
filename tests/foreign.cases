#### A `#[repr(C)]` struct is written to memory and read from it as C lays it out.
#[repr(C)]
struct Timespec { sec: i64, nsec: i64 }
#[repr(C)]
struct Mixed { a: u8, b: i32, c: f64, d: u16 }
extern "C" { fn malloc(n: usize) -> usize; fn free(p: usize); fn clock_gettime(clock: i32, at: usize) -> i32; }
fn main() -> Int { unsafe {
    say(Mixed::c_size());
    let p = malloc(Mixed::c_size());
    Mixed::c_write(Mixed { a: 7u8, b: 0i32 - 5i32, c: 2.5, d: 65535u16 }, p);
    say(ptr_read(p + 4usize, 32));
    let m = Mixed::c_read(p);
    say(m.a); say(m.b); say(m.c); say(m.d);
    free(p);
    let t = malloc(Timespec::c_size());
    clock_gettime(0i32, t);
    let now = Timespec::c_read(t);
    free(t);
    say(now.sec > 1000000000);
    0 } }
