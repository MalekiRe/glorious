#### case
#### The same with the release written as a cleanup, before the memory is used.
use std::ffi::{Layout, Allocation, allocate, write_bytes, read_bytes};
fn sum_at(at: usize) -> Int {
    unsafe { write_bytes(at, [1u8, 2u8, 3u8]) };
    let back = unsafe { read_bytes(at, 3) };
    int(back[0]) + int(back[1]) + int(back[2])
}
fn work(memory: Allocation) -> Int {
    defer { Allocation::release(memory); }
    sum_at(Allocation::as_ptr(&memory))
}
fn main() -> Int {
    match(Layout::from_size_align(16, 8)) {
        Ok(layout) => match(allocate(layout)) { Ok(memory) => work(memory), Err(_) => 0 - 1 },
        Err(_) => 0 - 2
    }
}
#### expect
6
#### case
#### One stream in memory and one of the host's: the function over both performs what the host's does.
use std::stream::{Read, Write, MemoryCursor, read, write, write_str, read_to_end};
use std::host::{IoError, run_host};
use std::stream::{Stdout};
fn copy<R: Read, W: Write>(reader: &mut R, writer: &mut W, done: Int) -> Result<Int, IoError>
    / { | <R as Read>::Effects, <W as Write>::Effects } {
    match(read(reader, 4)) {
        Ok(got) =>
            if(len(got) == 0) { Ok(done) }
            else { match(write(writer, got)) { Ok(n) => copy(reader, writer, done + n), Err(e) => Err(e) } },
        Err(e) => Err(e)
    }
}
fn main() -> Int {
    let mut from = MemoryCursor::new([]);
    write_str(&mut from, "0123456789");
    run_host({ let mut to = Stdout; match(copy(&mut from, &mut to, 0)) { Ok(n) => n, Err(_) => 0 - 1 } }) }
#### expect
012345678910
#### case
#### `copy_stream`, up to a limit, and then onto the host's output.
use std::stream::{MemoryCursor, Stdout, write_str, copy_stream};
use std::host::{run_host};
fn main() -> Int {
    let mut from = MemoryCursor::new([]);
    write_str(&mut from, "copied across\n");
    let mut to = MemoryCursor::new([]);
    let a = match(copy_stream(&mut from, &mut to, 6)) { Ok(n) => n, Err(_) => 0 - 1 };
    let mut again = MemoryCursor::new(MemoryCursor::into_inner(to));
    run_host({ let mut out = Stdout; match(copy_stream(&mut again, &mut out, 100)) { Ok(n) => a * 100 + n, Err(_) => 0 - 1 } }) }
#### expect
copied606
#### case
#### A function over two streams called from another over two.
use std::stream::{Read, Write, MemoryCursor, read, write, write_str, read_to_end};
use std::host::{IoError, run_host};
use std::stream::{Stdout};
fn copy<R: Read, W: Write>(reader: &mut R, writer: &mut W, done: Int) -> Result<Int, IoError>
    / { | <R as Read>::Effects, <W as Write>::Effects } {
    match(read(reader, 4)) {
        Ok(got) =>
            if(len(got) == 0) { Ok(done) }
            else { match(write(writer, got)) { Ok(n) => copy(reader, writer, done + n), Err(e) => Err(e) } },
        Err(e) => Err(e)
    }
}
fn twice<A: Read, B: Write>(a: &mut A, b: &mut B) -> Int / { | <A as Read>::Effects, <B as Write>::Effects } { match(copy(a, b, 0)) { Ok(n) => n * 2, Err(_) => 0 } }
fn main() -> Int {
    let mut from = MemoryCursor::new([]);
    write_str(&mut from, "0123456789");
    run_host({ let mut to = Stdout; twice(&mut from, &mut to) }) }
#### expect
012345678920
#### case
#### Texts for C in memory of their own, C's truth value, and memory filled and copied (library 22.2, 22.4).
use std::ffi::{CString, CStr, CStrError, NulError, c_bool_from_bool, bool_from_c_bool, null, ptr_is_null, ptr_add, ptr_write_bytes, ptr_copy, read_bytes, bytes_at, Layout, allocate, Allocation};
use std::slice::{Slice};
use std::value::{Rejected};
extern "C" { fn strlen(s: usize) -> usize; fn toupper(c: i32) -> i32; }
fn main() -> Int {
    // A text given to C, and its bytes taken back.
    match(CString::from_str("hello")) {
        Err(_) => 0 - 1,
        Ok(text) =>
            say(unsafe { strlen(CString::as_ptr(&text)) });
            say(match(unsafe { bytes_at(CString::as_ptr(&text), 100) }) { Ok(bytes) => len(bytes), Err(_) => 0 - 1 });
            say(CString::into_bytes(text));
            // A zero inside is refused, and says where.
            say(match(CString::from_vec([104u8, 0u8, 105u8])) { Ok(made) => CString::release(made); 0 - 1, Err(Rejected { value, error }) => error.position * 10 + len(value) });
            let raw = [111u8, 107u8, 0u8];
            say(match(CStr::from_bytes_with_nul(Slice::of(&raw))) { Ok(view) => match(CStr::to_str(view)) { Some(s) => s, None => "?" }, Err(_) => "bad" });
            let cut = [111u8, 107u8];
            say(match(CStr::from_bytes_with_nul(Slice::of(&cut))) { Ok(_) => "ok", Err(CStrError::MissingTerminator) => "no zero", Err(_) => "bad" });
            say(bool_from_c_bool(c_bool_from_bool(true)));
            say(ptr_is_null(null()));
            // Memory filled, and copied along itself.
            match(Layout::from_size_align(8, 1)) {
                Err(_) => 0 - 2,
                Ok(layout) => match(allocate(layout)) {
                    Err(_) => 0 - 3,
                    Ok(memory) =>
                        let at = Allocation::as_ptr(&memory);
                        unsafe { ptr_write_bytes(at, 7u8, 8) };
                        unsafe { ptr_write_bytes(at, 1u8, 2) };
                        unsafe { ptr_copy(at, ptr_add(at, 1), 4) };
                        say(unsafe { read_bytes(at, 8) });
                        Allocation::release(memory);
                        0
                }
            }
    }
}

#### expect
5
6
[104, 101, 108, 108, 111]
13
ok
no zero
true
true
[1, 1, 1, 7, 7, 7, 7, 7]
0
