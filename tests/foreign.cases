#### case
#### Threads of the system's (`spawn_os`, started through C): four
#### machines at once, sharing an atomic and a mutex; each increment is
#### seen, and what each gave is joined.
use std::thread::{spawn_os, join_os, AtomicInt, fetch_add, load, Mutex, lock, share};
fn sum_range(from: Int, to: Int) -> Int { let mut s = 0; let mut i = from; while({ i < to }) { s = s + i; i = i + 1 }; s }
fn main() -> Int {
    let counter = AtomicInt::new(0);
    let total = Mutex::new(0);
    let mut threads = [];
    let mut k = 0;
    while({ k < 4 }) {
        let c = share(&counter);
        let m = share(&total);
        let from = k * 1000;
        push_at(&mut threads, spawn_os(fn() -> Int { let c2 = c; let m2 = m; let mut i = 0; while({ i < 500 }) { lock(&m2, fn(n: &mut Int) { *n = *n + 1 }); i = i + 1 }; discard(fetch_add(&c2, 1)); sum_range(from, from + 1000) }));
        k = k + 1
    };
    let mut sum = 0;
    let mut ts = threads;
    while({ len_at(&ts) > 0 }) { sum = sum + join_os(remove_at(&mut ts, 0)) };
    say(sum);
    say(load(&counter));
    say(lock(&total, fn(n: &mut Int) -> Int { *n }));
    0
}
#### expect
7998000
4
2000
0
#### case
#### What a program asks of the machine it runs on is effects, which `run_host` answers with the operating system.
use std::host::{run_host, println, read_text, write_text, env, now, monotonic, random_bytes, current_dir, args};
fn main() -> Int { run_host({
    println("hello, host");
    let wrote = write_text("/tmp/glorious-host-test.txt", "one\ntwo\n");
    let back = read_text("/tmp/glorious-host-test.txt");
    println(match(back) { Ok(text) => text, Err(e) => "error" });
    let missing = read_text("/tmp/glorious-no-such-file");
    println(match(missing) { Ok(_) => "found", Err(e) => "no file: " ++ show(e.code) });
    let home = env("HOME");
    println(match(home) { Ok(Some(_)) => "HOME is set", _ => "no HOME" });
    let a = monotonic(); let b = monotonic();
    println(if(b >= a) { "the clock goes on" } else { "the clock went back" });
    println(match(random_bytes(8)) { Ok(bytes) => show(len(bytes)), Err(_) => "no chance" });
    println(match(current_dir()) { Ok(_) => "somewhere", Err(_) => "nowhere" });
    println(match(args()) { Ok(a) => if(len(a) > 0) { "started" } else { "?" }, Err(_) => "?" });
    0 }) }
