#### case
#### Memory that has to be given back: an `Allocation` is borrowed for its address and then released.
use std::ffi::{Layout, Allocation, allocate, write_bytes, read_bytes};
fn sum_at(at: usize) -> Int {
    unsafe { write_bytes(at, [1u8, 2u8, 3u8]) };
    let back = unsafe { read_bytes(at, 3) };
    int(back[0]) + int(back[1]) + int(back[2])
}
fn work(memory: Allocation) -> Int {
    let n = sum_at(Allocation::as_ptr(&memory));
    Allocation::release(memory);
    n
}
fn main() -> Int {
    match(Layout::from_size_align(16, 8)) {
        Ok(layout) => match(allocate(layout)) { Ok(memory) => work(memory), Err(_) => 0 - 1 },
        Err(_) => 0 - 2
    }
}
#### expect
6
