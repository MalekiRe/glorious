#### C calls back: a function, and a block that holds a value.
extern "C" { fn qsort(base: usize, n: usize, size: usize, cmp: usize); fn malloc(n: usize) -> usize; fn free(p: usize); }
fn order(a: usize, b: usize) -> Int { unsafe { let x = ptr_read(a, 64); let y = ptr_read(b, 64); if(x < y) { 0 - 1 } else { if(x > y) { 1 } else { 0 } } } }
fn main() -> Int { unsafe {
    let p = malloc(40usize);
    ptr_write(p, 64, 30); ptr_write(p + 8usize, 64, 10); ptr_write(p + 16usize, 64, 50); ptr_write(p + 24usize, 64, 20); ptr_write(p + 32usize, 64, 40);
    let cmp = c_callback(order, 2);
    qsort(p, 5usize, 8usize, cmp);
    say(ptr_read(p, 64)); say(ptr_read(p + 8usize, 64)); say(ptr_read(p + 32usize, 64));
    free(p); 0 } }
