extern "C" { fn qsort(base: usize, n: usize, size: usize, cmp: usize); fn malloc(n: usize) -> usize; fn free(p: usize); }
fn main() -> Int { unsafe {
    let p = malloc(24usize);
    ptr_write(p, 64, 3); ptr_write(p + 8usize, 64, 1); ptr_write(p + 16usize, 64, 2);
    let sign = 0 - 1;
    let cmp = c_callback({ (a, b) => unsafe { sign * (ptr_read(a, 64) - ptr_read(b, 64)) } }, 2);
    qsort(p, 3usize, 8usize, cmp);
    say(ptr_read(p, 64)); say(ptr_read(p + 16usize, 64));
    free(p); 0 } }
