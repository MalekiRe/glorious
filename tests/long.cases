#### case
#### BLAKE3 of inputs from nothing to five chunks, against the reference implementation's digests.
use std::fingerprint::{blake3, Digest256};
use std::slice::{Slice};
fn pattern(n: Int, i: Int, out: [u8]) -> [u8] { if(i == n) { out } else { pattern(n, i + 1, push(out, to(i % 251))) } }
fn each(lengths: [Int], i: Int) -> Int {
    if(i == len(lengths)) { 0 } else {
        let bytes = pattern(lengths[i], 0, []);
        let d = blake3(Slice::of(&bytes));
        say(Digest256::to_hex(&d));
        each(lengths, i + 1)
    }
}
fn main() -> Int { each([0, 1, 3, 63, 64, 65, 1023, 1024, 1025, 2048, 2049, 3072, 3073, 4096, 5000], 0) }

