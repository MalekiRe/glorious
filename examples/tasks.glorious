// Cooperative tasks: a round-robin scheduler written in the language.
// expect:
// (1, 0)
// (2, 0)
// (1, 1)
// 0
// (2, 1)
// (1, 2)
// 99
// ()

enum List { Nil, Cons(head, tail) }

fn append(a, b) {
    match(a) {
        Nil => b,
        Cons(head, rest) => Cons(head, append(rest, b))
    }
}

effect Task {
    [1, 1] yield_now(),
    [1, 1] spawn(task)
}

// Run every task in a list, in turn.
fn run_all(tasks) {
    match(tasks) {
        Nil => (),
        Cons(task, rest) => task(); run_all(rest)
    }
}

// A waiting task holds a resumption, which has to be used, and once. So the
// queue is never copied or overwritten: what it holds is taken out with
// `replace`, and whatever `replace` gives back is run.
fn push(queue, task) {
    let waiting = replace(queue, Nil);
    run_all(replace(queue, append(waiting, Cons(task, Nil))))
}

fn run_next(queue) {
    match(replace(queue, Nil)) {
        Nil => (),
        Cons(task, rest) => run_all(replace(queue, rest)); task()
    }
}

// Run a task under the scheduler. Yielding puts the rest of the task at the
// back of the queue. Spawning queues the rest of the parent and runs the child.
fn run_task(queue, task) {
    handle task() {
        _ => run_next(queue),
        yield_now(k) => push(queue, { k(()) }); run_next(queue),
        spawn(child, k) => push(queue, { k(()) }); run_task(queue, child)
    }
}

// The queue ends empty; the cleanup says what happens to a task if it does not.
fn run(main_task) {
    let mut queue = Nil;
    defer run_all(replace(&mut queue, Nil));
    run_task(&mut queue, main_task)
}

fn worker(name, steps) {
    let mut i = 0;
    while({ i < steps }) {
        print((name, i));
        yield_now();
        i = i + 1
    }
}

fn main() {
    run({
        spawn({ worker(1, 3) });
        spawn({ worker(2, 2) });
        print(0)
    });
    print(99)
}
