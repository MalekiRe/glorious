// Generators and folds, written in the language rather than built into it.
// expect:
// (385, Ok(15))

// `[1, 1]`: whoever handles `yield` has to resume the generator or cancel it.
effect Yield { [1, 1] yield(value) }

// Yield the integers from `i` up to but not including `to`.
fn count(i, to) {
    match(i < to) {
        Ok(_) => yield(i); tail count(i + 1, to),
        Err(_) => ()
    }
}

// Fold over everything a generator yields. The handler turns each `yield`
// into a function of the accumulator, so the state is threaded through the
// resumptions without any mutable variable.
fn fold(generator, initial, step) {
    let run = handle generator() {
        _ => { acc => acc },
        yield(value, k) => { acc => (k(()))(step(acc, value)) }
    };
    run(initial)
}

// Stop a generator early: the first value satisfying `wanted`, if any. The
// rest of the generator is cancelled, which runs its cleanups. `wanted` is
// called while the generator is held, so its type says it performs nothing:
// it comes back, and the generator is not left behind.
fn find(generator, wanted: fn(Int) -> Result<(), ()> / {}) {
    handle generator() {
        _ => None,
        yield(value, k) => if(wanted(value)) { cancel(k); Some(value) } else { k(()) }
    }
}

fn main() {
    let squares = fold({ count(1, 11) }, 0, fn(acc, x) { acc + x * x });
    let first_big = find({ count(1, 1000000) }, { x => x * x > 200 });
    (squares, first_big)
}
