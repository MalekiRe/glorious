// Read integers until the input runs out; print a running total.
// input: 5 10 -3
// expect:
// 5
// 15
// 12
// 12
// 12
fn main() {
    let total = running(0);
    print(total);
    total
}

fn running(total) {
    match(read()) {
        Some(n) => print(total + n); tail running(total + n),
        None => total
    }
}
