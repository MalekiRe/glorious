// Values written as text, read into a tree and written out again.
// expect:
// {"name": "glorious", "tags": ["a", "b"], "size": 42, "ok": true, "none": null}
// 42
// 2
// 1:15: a value
// 1:7: `,` or `]`
// 0

use std::vec::{Vec};

// A `Vec` with one more at its end.
fn pushed<T>(v: Vec<T>, x: T) -> Vec<T> { let mut v = v; v.push(x); v }
use std::text::{join};

enum Json { Null, Bool(Bool), Num(Int), Text(String), List(Vec<Json>), Object(Vec<(String, Json)>) }

struct ParseError { at: Int, wanted: &'static str }

// Where reading has got to in the text.
struct Reader { chars: Vec<char>, at: Int }

fn peek(r: &Reader) -> Option<char> { match(element(&r.chars, r.at)) { Some(c) => Some(*c), None => None } }

fn skip_spaces(r: &mut Reader) {
    match(peek(&*r)) { Some(' ') => r.at = r.at + 1; skip_spaces(r), _ => () }
}

fn expect(r: &mut Reader, c: char, wanted: &'static str) -> Result<(), ParseError> {
    skip_spaces(r);
    if(peek(&*r) is Some(found) and { found == c }) { r.at = r.at + 1; Ok(()) } else { Err(ParseError { at: r.at, wanted: wanted }) }
}

fn word(r: &mut Reader, text: &str, value: Json) -> Result<Json, ParseError> {
    let letters = std::vec::collect(&mut text.chars());
    if(matches(&*r, &letters, 0)) { r.at = r.at + len(letters); Ok(value) } else { Err(ParseError { at: r.at, wanted: "a value" }) }
}

fn matches(r: &Reader, letters: &Vec<char>, i: Int) -> Bool {
    match(element(letters, i)) {
        None => true,
        Some(c) => match(element(&r.chars, r.at + i)) { Some(d) => if(*c == *d) { matches(r, letters, i + 1) } else { false }, None => false }
    }
}

fn digits(r: &mut Reader, value: Int) -> Int {
    match(peek(&*r)) {
        Some(c) => if('0' <= c and { c <= '9' }) { r.at = r.at + 1; digits(r, value * 10 + (int(c) - int('0'))) } else { value },
        None => value
    }
}

// A `String` with one more character at its end.
fn with_char(s: String, c: char) -> String { let mut s = s; s.push(c); s }

fn text(r: &mut Reader, out: String) -> Result<String, ParseError> {
    match(peek(&*r)) {
        None => Err(ParseError { at: r.at, wanted: "`\"` to end the text" }),
        Some('"') => r.at = r.at + 1; Ok(out),
        Some(c) => r.at = r.at + 1; text(r, with_char(out, c))
    }
}

fn value(r: &mut Reader) -> Result<Json, ParseError> {
    skip_spaces(r);
    match(peek(&*r)) {
        Some('n') => word(r, "null", Json::Null),
        Some('t') => word(r, "true", Json::Bool(true)),
        Some('f') => word(r, "false", Json::Bool(false)),
        Some('"') => r.at = r.at + 1; match(text(r, String::new())) { Ok(s) => Ok(Json::Text(s)), Err(e) => Err(e) },
        Some('[') => r.at = r.at + 1; let mut out = Vec::new(); match(items(r, &mut out)) { Ok(_) => Ok(Json::List(out)), Err(e) => Err(e) },
        Some('{') => r.at = r.at + 1; let mut out = Vec::new(); match(fields(r, &mut out)) { Ok(_) => Ok(Json::Object(out)), Err(e) => Err(e) },
        Some(c) => if('0' <= c and { c <= '9' }) { Ok(Json::Num(digits(r, 0))) } else { Err(ParseError { at: r.at, wanted: "a value" }) },
        None => Err(ParseError { at: r.at, wanted: "a value" })
    }
}

fn items(r: &mut Reader, out: &mut Vec<Json>) -> Result<(), ParseError> {
    skip_spaces(r);
    if(peek(&*r) is Some(']')) { r.at = r.at + 1; Ok(()) } else {
        match(value(r)) {
            Err(e) => Err(e),
            Ok(item) =>
                out.push(item);
                skip_spaces(r);
                match(peek(&*r)) {
                    Some(',') => r.at = r.at + 1; items(r, out),
                    Some(']') => r.at = r.at + 1; Ok(()),
                    _ => Err(ParseError { at: r.at, wanted: "`,` or `]`" })
                }
        }
    }
}

fn fields(r: &mut Reader, out: &mut Vec<(String, Json)>) -> Result<(), ParseError> {
    skip_spaces(r);
    if(peek(&*r) is Some('}')) { r.at = r.at + 1; Ok(()) } else {
        match(expect(r, '"', "a name")) {
            Err(e) => Err(e),
            Ok(_) => match(text(r, String::new())) {
                Err(e) => Err(e),
                Ok(name) => match(expect(r, ':', "`:`")) {
                    Err(e) => Err(e),
                    Ok(_) => match(value(r)) {
                        Err(e) => Err(e),
                        Ok(item) =>
                            out.push((name, item));
                            skip_spaces(r);
                            match(peek(&*r)) {
                                Some(',') => r.at = r.at + 1; fields(r, out),
                                Some('}') => r.at = r.at + 1; Ok(()),
                                _ => Err(ParseError { at: r.at, wanted: "`,` or `}`" })
                            }
                    }
                }
            }
        }
    }
}

fn parse(text: &str) -> Result<Json, ParseError> {
    let mut r = Reader { chars: std::vec::collect(&mut text.chars()), at: 0 };
    value(&mut r)
}

fn written(j: &Json) -> String {
    match(j) {
        &Json::Null => String::from("null"),
        &Json::Bool(b) => String::from(if(*b) { "true" } else { "false" }),
        &Json::Num(n) => n.to_string(),
        &Json::Text(s) => String::from("\"") + s.as_str() + "\"",
        &Json::List(items) => String::from("[") + join(each(items, 0, Vec::new()), ", ").as_str() + "]",
        &Json::Object(pairs) => String::from("{") + join(each_field(pairs, 0, Vec::new()), ", ").as_str() + "}"
    }
}
fn each(items: &Vec<Json>, i: Int, out: Vec<String>) -> Vec<String> {
    match(element(items, i)) { Some(item) => each(items, i + 1, pushed(out, written(item))), None => out }
}
fn each_field(pairs: &Vec<(String, Json)>, i: Int, out: Vec<String>) -> Vec<String> {
    match(element(pairs, i)) {
        Some(pair) => each_field(pairs, i + 1, pushed(out, String::from("\"") + pair.0.as_str() + "\": " + written(&pair.1).as_str())),
        None => out
    }
}

// The value under a name, of an object.
fn get<'a>(j: &'a Json, name: &str) -> Option<&'a Json> {
    match(j) { &Json::Object(pairs) => find(pairs, name, 0), _ => None }
}
fn find<'a>(pairs: &'a Vec<(String, Json)>, name: &str, i: Int) -> Option<&'a Json> {
    match(element(pairs, i)) {
        Some(pair) => if(pair.0.as_str() == name) { Some(&pair.1) } else { find(pairs, name, i + 1) },
        None => None
    }
}

fn report(text: &str) -> String {
    match(parse(text)) { Ok(_) => String::from("fine"), Err(e) => String::from("1:") + (e.at + 1).to_string().as_str() + ": " + e.wanted }
}

fn main() -> Int {
    match(parse("{\"name\": \"glorious\", \"tags\": [\"a\", \"b\"], \"size\": 42, \"ok\": true, \"none\": null}")) {
        Err(e) => say(e.wanted); 0 - 1,
        Ok(doc) =>
            say(written(&doc));
            say(match(get(&doc, "size")) { Some(&Json::Num(n)) => *n, _ => 0 - 1 });
            say(match(get(&doc, "tags")) { Some(&Json::List(items)) => len_at(items), _ => 0 - 1 });
            say(report("{\"a\": 1, \"b\": }"));
            say(report("[1, 2 3]"));
            0
    }
}
