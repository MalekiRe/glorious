// A calculator: text to tokens, tokens to a tree, the tree to a number.
// Names can be given values with `let`, and what goes wrong is said with
// the place in the text it went wrong at.
// expect:
// 7
// -9
// 36
// 1:4: expected division by nothing
// 1:10: expected a number, a name or `(`
// 1:5: expected no value for `y`
// 1:3: expected a character that means nothing here
// 1:3: expected nothing more
// 0

use std::parse::{Cursor};
use std::source::{SourceMap, SourceId};
use std::map::{Map};

use std::vec::{Vec};
// A `Vec` with one more at its end.
fn pushed<T>(v: Vec<T>, x: T) -> Vec<T> { let mut v = v; v.push(x); v }

enum Token<'a> { Num(Int), Name(&'a str), Plus, Minus, Star, Slash, Open, Close, Let, Equals }

// A token and where it starts.
struct Spot<'a> { token: Token<'a>, at: Int }

enum Expr<'a> {
    Num(Int),
    Name(&'a str, Int),
    Neg(Expr<'a>),
    Binary(Op, Expr<'a>, Expr<'a>, Int),
    Let(&'a str, Expr<'a>, Expr<'a>)
}
enum Op { Plus, Minus, Star, Slash }

// What can go wrong, with where.
effect Fail { fail(message: String, at: Int) -> ! }

fn is_digit(c: char) -> Bool { '0' <= c and { c <= '9' } }
fn is_letter(c: char) -> Bool { ('a' <= c and { c <= 'z' }) or { c == '_' } }

// The digits at the front of some characters as a number, and how many.
fn number(chars: &Vec<char>, at: Int, value: Int) -> (Int, Int) {
    match(element(chars, at)) {
        Some(c) => if(is_digit(*c)) { tail number(chars, at + 1, value * 10 + (int(*c) - int('0'))) } else { (value, at) },
        None => (value, at)
    }
}

// Where the letters at the front of some characters end.
fn word_end(chars: &Vec<char>, at: Int) -> Int {
    match(element(chars, at)) {
        Some(c) => if(is_letter(*c)) { tail word_end(chars, at + 1) } else { at },
        None => at
    }
}

fn tokens<'a>(text: &'a str, chars: &Vec<char>, at: Int, out: Vec<Spot<'a>>) -> Vec<Spot<'a>> / {Fail} {
    match(element(chars, at)) {
        None => out,
        Some(c) =>
            let ch = *c;
            if(ch == ' ') { tail tokens(text, chars, at + 1, out) } else {
                if(is_digit(ch)) { match(number(chars, at, 0)) { (n, end) => tokens(text, chars, end, pushed(out, Spot { token: Token::Num(n), at: at })) } } else {
                    if(is_letter(ch)) {
                        let end = word_end(chars, at);
                        let w = text.slice(at, end);
                        tokens(text, chars, end, pushed(out, Spot { token: if(w == "let") { Token::Let } else { Token::Name(w) }, at: at }))
                    } else {
                        let simple = match(ch) {
                            '+' => Token::Plus, '-' => Token::Minus, '*' => Token::Star, '/' => Token::Slash,
                            '(' => Token::Open, ')' => Token::Close, '=' => Token::Equals,
                            _ => fail(String::from("a character that means nothing here"), at)
                        };
                        tokens(text, chars, at + 1, pushed(out, Spot { token: simple, at: at }))
                    }
                }
            }
    }
}

// Where the next token is, or the end.
fn here<'a>(c: &Cursor<'a, Spot<'a>>, end: Int) -> Int { match(Cursor::peek(c)) { Some(spot) => spot.at, None => end } }

// The next token and where it is, without going past it; and going past it.
fn look<'a>(c: &Cursor<'a, Spot<'a>>) -> Option<(Token<'a>, Int)> { match(Cursor::peek(c)) { Some(spot) => Some((spot.token, spot.at)), None => None } }
fn take<'a>(c: &mut Cursor<'a, Spot<'a>>) -> Option<(Token<'a>, Int)> { match(Cursor::next(c)) { Some(spot) => Some((spot.token, spot.at)), None => None } }

// expr := `let` name `=` expr expr | sum
fn expr<'a>(c: &mut Cursor<'a, Spot<'a>>, end: Int) -> Expr<'a> / {Fail} {
    match(look(&*c)) {
        Some((Token::Let, _)) =>
            take(c);
            let name = match(take(c)) { Some((Token::Name(n), _)) => n, _ => fail(String::from("a name after `let`"), here(&*c, end)) };
            match(take(c)) { Some((Token::Equals, _)) => (), _ => fail(String::from("`=` after the name"), here(&*c, end)) };
            let value = sum(c, end);
            Expr::Let(name, value, expr(c, end)),
        _ => sum(c, end)
    }
}

// sum := product ((`+` | `-`) product)*
fn sum<'a>(c: &mut Cursor<'a, Spot<'a>>, end: Int) -> Expr<'a> / {Fail} { let first = product(c, end); more_sum(c, end, first) }
fn more_sum<'a>(c: &mut Cursor<'a, Spot<'a>>, end: Int, left: Expr<'a>) -> Expr<'a> / {Fail} {
    match(look(&*c)) {
        Some((Token::Plus, at)) => take(c); let right = product(c, end); more_sum(c, end, Expr::Binary(Op::Plus, left, right, at)),
        Some((Token::Minus, at)) => take(c); let right = product(c, end); more_sum(c, end, Expr::Binary(Op::Minus, left, right, at)),
        _ => left
    }
}

// product := unary ((`*` | `/`) unary)*
fn product<'a>(c: &mut Cursor<'a, Spot<'a>>, end: Int) -> Expr<'a> / {Fail} { let first = unary(c, end); more_product(c, end, first) }
fn more_product<'a>(c: &mut Cursor<'a, Spot<'a>>, end: Int, left: Expr<'a>) -> Expr<'a> / {Fail} {
    match(look(&*c)) {
        Some((Token::Star, at)) => take(c); let right = unary(c, end); more_product(c, end, Expr::Binary(Op::Star, left, right, at)),
        Some((Token::Slash, at)) => take(c); let right = unary(c, end); more_product(c, end, Expr::Binary(Op::Slash, left, right, at)),
        _ => left
    }
}

// unary := `-` unary | number | name | `(` expr `)`
fn unary<'a>(c: &mut Cursor<'a, Spot<'a>>, end: Int) -> Expr<'a> / {Fail} {
    let at = here(&*c, end);
    match(take(c)) {
        Some((Token::Minus, _)) => Expr::Neg(unary(c, end)),
        Some((Token::Num(n), _)) => Expr::Num(n),
        Some((Token::Name(n), spot)) => Expr::Name(n, spot),
        Some((Token::Open, _)) =>
            let inside = expr(c, end);
            match(take(c)) { Some((Token::Close, _)) => inside, _ => fail(String::from("`)` to close"), here(&*c, end)) },
        _ => fail(String::from("a number, a name or `(`"), at)
    }
}

fn eval<'a>(e: Expr<'a>, names: Map<&'a str, Int>) -> Int / {Fail} {
    match(e) {
        Expr::Num(n) => n,
        Expr::Name(n, at) => match(std::map::get(names, n)) { Some(v) => v, None => fail(String::from("no value for `") + n + "`", at) },
        Expr::Neg(inner) => 0 - eval(inner, names),
        Expr::Binary(op, l, r, at) =>
            let a = eval(l, names);
            let b = eval(r, names);
            match(op) {
                Op::Plus => a + b, Op::Minus => a - b, Op::Star => a * b,
                Op::Slash => if(b == 0) { fail(String::from("division by nothing"), at) } else { a / b }
            },
        Expr::Let(name, value, body) => let v = eval(value, names); eval(body, std::map::insert(names, name, v))
    }
}

// The value of a text, or what went wrong, said with its line and column.
fn calculate(text: &str) -> String {
    let mut sources = SourceMap::new();
    match(SourceMap::insert(&mut sources, "input", text)) {
        Ok(id) => worked_out(text, &sources, id),
        Err(_) => String::from("too many texts")
    }
}

fn worked_out(text: &str, sources: &SourceMap, id: SourceId) -> String {
    let chars = std::vec::collect(&mut text.chars());
    let end = len_at(&chars);
    handle {
        let spots = tokens(text, &chars, 0, Vec::new());
        let mut c = Cursor::new(spots.as_slice());
        let tree = expr(&mut c, end);
        if(not Cursor::is_done(&c)) { fail(String::from("nothing more"), here(&c, end)) } else { eval(tree, std::map::new()).to_string() }
    }() {
        fail(message, at) => match(SourceMap::locate(sources, id, at)) {
            Ok(place) => (place.line + 1).to_string() + ":" + (place.column_bytes + 1).to_string().as_str() + ": expected " + message.as_str(),
            Err(_) => message
        }
    }
}

fn main() -> Int {
    say(calculate("1 + 2 * 3"));
    say(calculate("(1 + 2) * -3"));
    say(calculate("let x = 6 let y = x * 7 y - x"));
    say(calculate("10 / (5 - 5)"));
    say(calculate("2 * (3 + "));
    say(calculate("4 + y"));
    say(calculate("7 $ 2"));
    say(calculate("1 2"));
    0
}
