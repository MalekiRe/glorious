// Backtracking search. The search tries each alternative in turn by ordinary
// recursion and reports every solution through an effect; the handler resumes
// it once per solution, as a generator's consumer would.
// expect:
// Cons(Cons(2, Cons(8, Nil)), Cons(Cons(2, Cons(5, Cons(3, Nil))), Nil))

// A list of lists appears below, so the element type is a parameter.
enum List<T> { Nil, Cons(T, List<T>) }

// `[1, 1]`: whoever handles `found` has to resume the search.
effect Search<T> { [1, 1] found(T) }

// Report every subset of the items. `picked` holds the items chosen so far,
// most recent first.
fn subsets<T>(items: List<T>, picked: List<T>) -> () / {Search<List<T>>} where T: Use<[0, *]> {
    match(items) {
        Nil => found(picked),
        Cons(head, rest) =>
            subsets(rest, Cons(head, picked));
            subsets(rest, picked)
    }
}

fn sum(list: List<Int>) -> Int {
    match(list) {
        Nil => 0,
        Cons(head, rest) => head + sum(rest)
    }
}

// The subsets of 3, 5, 8, 2 that add up to 10.
fn main() -> List<List<Int>> {
    let mut solutions = Nil;
    handle subsets(Cons(3, Cons(5, Cons(8, Cons(2, Nil)))), Nil) {
        found(picked) =>
            if(sum(picked) == 10) { solutions = Cons(picked, solutions) };
            ()
    };
    solutions
}
