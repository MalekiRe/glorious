
// An owned text that grows where it is, as Rust's `String`: its bytes, which
// are UTF-8, in a `Vec` of them. (`std::text` names it again.)
struct String { bytes: Vec<u8> }

impl String {
    pub fn new() -> Self { Self { bytes: Vec::new() } }
    pub fn with_capacity(capacity: Int) -> Self { Self { bytes: Vec::with_capacity(capacity) } }
    // Of borrowed text, its bytes copied: `String::from("abc")`.
    pub fn from(text: &str) -> Self { let mut s = String::new(); String::push_str(&mut s, text); s }
    pub fn from_str(text: &str) -> Self { String::from(text) }
    // Of a `Str`, its characters as UTF-8.
    pub fn from_text(text: Str) -> Self { let mut s = String::new(); String::push_text(&mut s, text); s }
    // Of bytes that are UTF-8; the bytes given back if they are not.
    pub fn from_utf8(bytes: Vec<u8>) -> Result<Self, Vec<u8>> {
        match(string_utf8_from(&bytes, 0)) { Ok(_) => Ok(Self { bytes: bytes }), Err(_) => Err(bytes) }
    }
    pub fn into_bytes(value: Self) -> Vec<u8> { match(value) { String { bytes } => bytes } }
    pub fn as_bytes<'a>(value: &'a Self) -> &'a [u8] { Vec::as_slice(&value.bytes) }
    // The text as a `Str`.
    pub fn to_str(value: &Self) -> Str { str_decode(&String::as_str(value), 0, StrEnd) }
    // How many bytes.
    pub fn len(value: &Self) -> Int { Vec::len(&value.bytes) }
    pub fn is_empty(value: &Self) -> Bool { Vec::len(&value.bytes) == 0 }
    pub fn capacity(value: &Self) -> Int { Vec::capacity(&value.bytes) }
    // Borrowed text's bytes put after these.
    pub fn push_str(value: &mut Self, text: &str) {
        let mut i = 0;
        while({ i < text.len() }) { Vec::push(&mut value.bytes, text.byte(i)); i = i + 1 }
    }
    // A `Str`'s characters, as UTF-8, put after these.
    pub fn push_text(value: &mut Self, text: Str) {
        match(text) { StrEnd => (), StrChar(c, rest) => String::push(value, c); tail String::push_text(value, rest) }
    }
    // A character, as UTF-8, put after these.
    pub fn push(value: &mut Self, c: char) { string_encode(char_bits(c), &mut value.bytes) }
    pub fn clear(value: &mut Self) { Vec::clear(&mut value.bytes) }
    pub fn truncate(value: &mut Self, length: Int) { Vec::truncate(&mut value.bytes, length) }
    // The text, borrowed where it is.
    pub fn as_str<'a>(value: &'a Self) -> &'a str {
        unsafe { str_at(ptr_mut_address(Vec::as_mut_ptr(&value.bytes)), Vec::len(&value.bytes)) }
    }
}

// A `&String` is a `&str` wherever one is wanted, as Rust's is.
coerce string_as_str
fn string_as_str<'a>(s: &'a String) -> &'a str { String::as_str(s) }

// `owned + "more"`: the text put after, in the same memory where there is
// room.
impl<'a> Add<&'a str> for String {
    type Output = String;
    fn +(a: String, b: &'a str) -> String { let mut a = a; String::push_str(&mut a, b); a }
}
impl Clone for String { fn clone(s: &String) -> String { String { bytes: clone(&s.bytes) } } }
impl Eq for String { fn ==(a: String, b: String) -> Bool { a.bytes == b.bytes } }
impl Show for String { fn fmt(s: &String) -> Str { String::to_str(s) } }

// A character's code as UTF-8, put after `out`.
fn string_encode(code: Int, out: &mut Vec<u8>) {
    if(code < 128) { Vec::push(out, u8(code)) } else {
        if(code < 2048) { Vec::push(out, u8(192 + code / 64)); Vec::push(out, u8(128 + code % 64)) } else {
            if(code < 65536) {
                Vec::push(out, u8(224 + code / 4096)); Vec::push(out, u8(128 + code / 64 % 64)); Vec::push(out, u8(128 + code % 64))
            } else {
                Vec::push(out, u8(240 + code / 262144)); Vec::push(out, u8(128 + code / 4096 % 64));
                Vec::push(out, u8(128 + code / 64 % 64)); Vec::push(out, u8(128 + code % 64))
            }
        }
    }
}
// Are the bytes from a place on UTF-8?
fn string_utf8_from(bytes: &Vec<u8>, i: Int) -> Bool {
    let n = Vec::len(bytes);
    if(i >= n) { true } else {
        let b0 = int(*Vec::index(bytes, i));
        let more = if(b0 < 128) { 0 } else { if(b0 < 192) { -1 } else { if(b0 < 224) { 1 } else { if(b0 < 240) { 2 } else { if(b0 < 248) { 3 } else { -1 } } } } };
        if(more < 0 or { i + more >= n }) { false } else {
            if(string_continued(bytes, i + 1, more)) { tail string_utf8_from(bytes, i + more + 1) } else { false }
        }
    }
}
fn string_continued(bytes: &Vec<u8>, i: Int, left: Int) -> Bool {
    if(left == 0) { true } else {
        let b = int(*Vec::index(bytes, i));
        if(b >= 128 and { b < 192 }) { tail string_continued(bytes, i + 1, left - 1) } else { false }
    }
}

// What a value is written as for a reader, `{}`, as Rust's `Display`; and for
// a programmer, `{:?}`, as Rust's `Debug`. Each writes into a `Formatter`.
trait Display { fn fmt(&Self, &mut Formatter) }
trait Debug { fn fmt(&Self, &mut Formatter) }

// Why writing failed.
enum FormatError { OutputLimit, InvalidIndent }

// Where a value is written: the text so far, how deep the indentation is,
// how wide a step of it is, and whether the line being written has nothing
// on it yet.
struct Formatter { text: String, depth: Int, width: Int, fresh: Bool }

impl Formatter {
    pub fn new() -> Self { Self { text: String::new(), depth: 0, width: 4, fresh: true } }
    // Indentation is written before the first thing on a line, not on a
    // line that stays empty.
    pub fn write_str(value: &mut Self, text: &str) {
        if(value.fresh and { not(text.is_empty()) }) {
            let mut i = 0;
            while({ i < value.depth * value.width }) { String::push(&mut value.text, ' '); i = i + 1 };
            value.fresh = false
        } else { () };
        String::push_str(&mut value.text, text)
    }
    // A `Str`, written as `write_str` writes.
    pub fn write_text(value: &mut Self, text: Str) {
        let s = String::from_text(text);
        Formatter::write_str(value, String::as_str(&s))
    }
    pub fn write_char(value: &mut Self, character: char) {
        let mut s = String::new();
        String::push(&mut s, character);
        Formatter::write_str(value, String::as_str(&s))
    }
    pub fn newline(value: &mut Self) {
        String::push_str(&mut value.text, "\n");
        value.fresh = true
    }
    pub fn indent(value: &mut Self) -> Result<(), FormatError> {
        value.depth = value.depth + 1;
        Ok(())
    }
    pub fn dedent(value: &mut Self) -> Result<(), FormatError> {
        let depth = value.depth;
        value.depth = if(depth > 0) { depth - 1 } else { 0 };
        if(depth > 0) { Ok(()) } else { Err(InvalidIndent) }
    }
    // Text in quotes, with what would end or break it written out, as
    // Rust's `{:?}` of a `&str`.
    pub fn quoted(value: &mut Self, text: &str) {
        Formatter::write_str(value, "\"");
        let mut i = 0;
        while({ i < text.len() }) {
            let b = text.byte(i);
            match(int(b)) {
                34 => Formatter::write_str(value, "\\\""),
                92 => Formatter::write_str(value, "\\\\"),
                10 => Formatter::write_str(value, "\\n"),
                9 => Formatter::write_str(value, "\\t"),
                13 => Formatter::write_str(value, "\\r"),
                _ => String::push_str_byte(&mut value.text, b)
            };
            i = i + 1
        };
        Formatter::write_str(value, "\"")
    }
    pub fn display<T: Display>(value: &mut Self, item: &T) where T: Use<[1, 1]> { Display::fmt(item, value) }
    pub fn debug<T: Debug>(value: &mut Self, item: &T) where T: Use<[1, 1]> { Debug::fmt(item, value) }
    pub fn finish(value: Self) -> Result<String, FormatError> {
        match(value) { Formatter { text, depth, width, fresh } => Ok(text) }
    }
}
impl String {
    // One byte put after these, as it is.
    fn push_str_byte(value: &mut Self, b: u8) { Vec::push(&mut value.bytes, b) }
}

// What a value is written as, by `Display` and by `Debug`.
fn format<T: Display>(value: &T) -> String where T: Use<[1, 1]> {
    let mut out = Formatter::new();
    Display::fmt(value, &mut out);
    match(out) { Formatter { text, depth, width, fresh } => text }
}
fn format_debug<T: Debug>(value: &T) -> String where T: Use<[1, 1]> {
    let mut out = Formatter::new();
    Debug::fmt(value, &mut out);
    match(out) { Formatter { text, depth, width, fresh } => text }
}
// `x.to_string()`: what `Display` writes it as, as Rust's.
fn to_string<T: Display>(value: &T) -> String where T: Use<[1, 1]> { format(value) }

impl<'a, T> Display for &'a T where T: Display { fn fmt(r: &&'a T, out: &mut Formatter) { Display::fmt(*r, out) } }
impl<'a, T> Display for &'a mut T where T: Display { fn fmt(r: &&'a mut T, out: &mut Formatter) { Display::fmt(&**r, out) } }
impl<'a, T> Debug for &'a T where T: Debug { fn fmt(r: &&'a T, out: &mut Formatter) { Debug::fmt(*r, out) } }
impl<'a, T> Debug for &'a mut T where T: Debug { fn fmt(r: &&'a mut T, out: &mut Formatter) { Debug::fmt(&**r, out) } }

impl Display for Int { fn fmt(n: &Int, out: &mut Formatter) { Formatter::write_text(out, show(*n)) } }
impl Debug for Int { fn fmt(n: &Int, out: &mut Formatter) { Formatter::write_text(out, show(*n)) } }
impl Display for char { fn fmt(c: &char, out: &mut Formatter) { Formatter::write_char(out, *c) } }
impl Debug for char {
    fn fmt(c: &char, out: &mut Formatter) {
        let mut s = String::new();
        String::push(&mut s, *c);
        Formatter::write_str(out, "'");
        match(char_bits(*c)) {
            39 => Formatter::write_str(out, "\\'"),
            92 => Formatter::write_str(out, "\\\\"),
            10 => Formatter::write_str(out, "\\n"),
            _ => Formatter::write_str(out, String::as_str(&s))
        };
        Formatter::write_str(out, "'")
    }
}
impl<'a> Display for StrRef<'a> { fn fmt(s: &StrRef<'a>, out: &mut Formatter) { Formatter::write_str(out, *s) } }
impl<'a> Debug for StrRef<'a> { fn fmt(s: &StrRef<'a>, out: &mut Formatter) { Formatter::quoted(out, *s) } }
impl Display for String { fn fmt(s: &String, out: &mut Formatter) { Formatter::write_str(out, String::as_str(s)) } }
impl Debug for String { fn fmt(s: &String, out: &mut Formatter) { Formatter::quoted(out, String::as_str(s)) } }
impl Display for Str { fn fmt(text: &Str, out: &mut Formatter) { Formatter::write_text(out, *text) } }
impl Debug for Str { fn fmt(text: &Str, out: &mut Formatter) { let s = String::from_text(*text); Formatter::quoted(out, String::as_str(&s)) } }
impl Display for () { fn fmt(u: &(), out: &mut Formatter) { Formatter::write_str(out, "()") } }
impl Debug for () { fn fmt(u: &(), out: &mut Formatter) { Formatter::write_str(out, "()") } }

// `[a, b]`, each element as `Debug` writes it.
impl<T> Debug for Vec<T> where T: Debug, T: Use<[1, 1]> {
    fn fmt(v: &Vec<T>, out: &mut Formatter) {
        Formatter::write_str(out, "[");
        let mut i = 0;
        while({ i < Vec::len(v) }) {
            if(i > 0) { Formatter::write_str(out, ", ") } else { () };
            Debug::fmt(Vec::index(v, i), out);
            i = i + 1
        };
        Formatter::write_str(out, "]")
    }
}
impl<'a, T> Debug for SliceRef<'a, T> where T: Debug {
    fn fmt(s: &SliceRef<'a, T>, out: &mut Formatter) {
        Formatter::write_str(out, "[");
        let mut i = 0;
        while({ i < s.len() }) {
            if(i > 0) { Formatter::write_str(out, ", ") } else { () };
            Debug::fmt(element_at(s, i), out);
            i = i + 1
        };
        Formatter::write_str(out, "]")
    }
}

impl Display for f64 { fn fmt(x: &f64, out: &mut Formatter) { Formatter::write_text(out, Show::fmt(x)) } }
impl Debug for f64 { fn fmt(x: &f64, out: &mut Formatter) { Formatter::write_text(out, Show::fmt(x)) } }
impl Display for f32 { fn fmt(x: &f32, out: &mut Formatter) { Formatter::write_text(out, Show::fmt(x)) } }
impl Debug for f32 { fn fmt(x: &f32, out: &mut Formatter) { Formatter::write_text(out, Show::fmt(x)) } }

// Truth, `Result<(), ()>`, as `true` and `false` (preferred, as the more
// particular implementation, over the one of every `Result`).
impl Display for Result<(), ()> {
    fn fmt(b: &Result<(), ()>, out: &mut Formatter) { match(b) { Ok(_) => Formatter::write_str(out, "true"), Err(_) => Formatter::write_str(out, "false") } }
}
impl Debug for Result<(), ()> {
    fn fmt(b: &Result<(), ()>, out: &mut Formatter) { match(b) { Ok(_) => Formatter::write_str(out, "true"), Err(_) => Formatter::write_str(out, "false") } }
}
impl<T, E> Debug for Result<T, E> where T: Debug, E: Debug {
    fn fmt(r: &Result<T, E>, out: &mut Formatter) {
        match(r) {
            Ok(value) => Formatter::write_str(out, "Ok("); Debug::fmt(value, out); Formatter::write_str(out, ")"),
            Err(error) => Formatter::write_str(out, "Err("); Debug::fmt(error, out); Formatter::write_str(out, ")")
        }
    }
}
impl<A, B> Debug for (A, B) where A: Debug, B: Debug {
    fn fmt(p: &(A, B), out: &mut Formatter) {
        Formatter::write_str(out, "("); Debug::fmt(&(*p).0, out); Formatter::write_str(out, ", "); Debug::fmt(&(*p).1, out); Formatter::write_str(out, ")")
    }
}
impl<A, B, C> Debug for (A, B, C) where A: Debug, B: Debug, C: Debug {
    fn fmt(p: &(A, B, C), out: &mut Formatter) {
        Formatter::write_str(out, "("); Debug::fmt(&(*p).0, out); Formatter::write_str(out, ", "); Debug::fmt(&(*p).1, out);
        Formatter::write_str(out, ", "); Debug::fmt(&(*p).2, out); Formatter::write_str(out, ")")
    }
}
impl<T, N> Debug for Fixed<T, N> where T: Debug, N: Known {
    fn fmt(a: &Fixed<T, N>, out: &mut Formatter) {
        Formatter::write_str(out, "[");
        let mut i = 0;
        while({ i < size_at(a) }) {
            if(i > 0) { Formatter::write_str(out, ", ") } else { () };
            Debug::fmt(element_at(a, i), out);
            i = i + 1
        };
        Formatter::write_str(out, "]")
    }
}
