
// Every scalar type is held as an `Int`: `i8_bits(x)` is that `Int` and
// `i8_of(n)` the `i8` an `Int` is, neither doing anything. What follows says
// what each type's operations are. A result that does not fit its type has no
// meaning: the program stops.
type i64 = Int;

// The `Int` a whole number or a character is; of a floating point number,
// what is before its point.
trait ToInt { fn int(Self) -> Int }
impl ToInt for Int { fn int(x: Int) -> Int { x } }

// A whole number of one type as one of another, `let b: u8 = to(n)`, if it
// fits: through the widest type, which holds every value but the upper half
// of `u128`.
trait Whole {
    fn whole(Self) -> i128
    fn of_whole(i128) -> Self
}
impl Whole for Int {
    fn whole(x: Int) -> i128 { i128_of(x) }
    fn of_whole(n: i128) -> Int { int_fit(i128_bits(n), 64) }
}
impl Whole for char {
    fn whole(c: char) -> i128 { i128_of(char_bits(c)) }
    fn of_whole(n: i128) -> char { char(int_fit(i128_bits(n), 64)) else { '\u{FFFD}' } }
}
fn to<T, U>(x: T) -> U where T: Whole, U: Whole, T: Use<[1, 1]>, U: Use<[1, 1]> { of_whole(whole(x)) }

// One type made from another: `impl From<Meters> for Feet`.
trait From<T> { fn from(T) -> Self }

// Text: the characters, one after another.
enum Str { StrEnd, StrChar(char, Str) }

infixr 5 ++
fn ++(a: Str, b: Str) -> Str {
    match(a) {
        StrEnd => b,
        StrChar(c, rest) => StrChar(c, rest ++ b)
    }
}

fn length(text: Str) -> Int {
    match(text) {
        StrEnd => 0,
        StrChar(_, rest) => int_add(1, length(rest))
    }
}

impl Eq for Str {
    fn ==(a: Str, b: Str) -> Bool {
        match((a, b)) {
            (StrEnd, StrEnd) => true,
            (StrChar(c, x), StrChar(d, y)) =>
                match(int_eq(char_bits(c), char_bits(d))) { 0 => false, _ => x == y },
            _ => false
        }
    }
}

// A value as text.
// What can be written as text, looked at where it is: nothing of it is
// copied or taken. `show(x)` writes what it is given; `show(&x)` what `x` is.
trait Show { fn fmt(&Self) -> Str }
fn show<T>(value: T) -> Str where T: Show { let held = value; fmt(&held) }
impl<'a, T> Show for &'a T where T: Show { fn fmt(r: &&'a T) -> Str { fmt(*r) } }
impl<'a, T> Show for &'a mut T where T: Show { fn fmt(r: &&'a mut T) -> Str { fmt(&**r) } }
impl Show for Str { fn fmt(text: &Str) -> Str { *text } }
impl Show for char { fn fmt(c: &char) -> Str { StrChar(*c, StrEnd) } }

// How numbers are written as text. Only what is `pub` is the prelude's.
mod number_text {
    // The digits of a number that is not positive, the first first, before `rest`.
    pub fn digits_before(n: Int, rest: Str) -> Str {
        let digit = char_of(int_sub(48, int_rem(n, 10)));
        match(int_div(n, 10)) {
            0 => StrChar(digit, rest),
            more => tail digits_before(more, StrChar(digit, rest))
        }
    }

    // A floating point number as text: the fewest digits that give it back.
    // `wide` is the bits of the number without its sign, as 64 bits; `held` is
    // what the digits must give back, and with `single` that is asked of the 32
    // bits they are brought back to.
    fn float_shortest(wide: Int, held: Int, single: Int, p: Int) -> (Int, Int) {
        let digits = f64_digits(wide, p);
        let exp10 = f64_exp10(wide, p);
        let back = f64_of_decimal(digits, exp10);
        let got = match(single) { 0 => back, _ => f64_narrow(back, 0) };
        match(int_eq(got, held)) {
            0 => tail float_shortest(wide, held, single, int_add(p, 1)),
            _ => (digits, exp10)
        }
    }

    fn zeros(count: Int, rest: Str) -> Str {
        match(count) {
            0 => rest,
            _ => StrChar('0', zeros(int_sub(count, 1), rest))
        }
    }

    // The digits with a point after the first `before` of them.
    fn point_after(digits: Str, before: Int) -> Str {
        match(before) {
            0 => StrChar('.', digits),
            _ => match(digits) {
                StrChar(c, rest) => StrChar(c, point_after(rest, int_sub(before, 1))),
                StrEnd => StrEnd
            }
        }
    }

    fn float_scientific<T>(digits: Str, exponent: T) -> Str where T: Show {
        match(digits) {
            StrChar(c, StrEnd) => StrChar(c, StrChar('e', show(exponent))),
            StrChar(c, rest) => StrChar(c, StrChar('.', rest ++ StrChar('e', show(exponent)))),
            StrEnd => StrEnd
        }
    }

    // `exp10` is the power of ten of the last digit, `first` that of the first.
    fn float_placed(digits: Str, exp10: Int, first: Int) -> Str {
        match(int_add(int_lt(first, -5), int_lt(16, first))) {
            0 => match(int_lt(exp10, 0)) {
                0 => digits ++ zeros(exp10, ".0"),
                _ => match(int_lt(first, 0)) {
                    0 => point_after(digits, int_add(first, 1)),
                    _ => StrChar('0', StrChar('.', zeros(int_sub(-1, first), digits)))
                }
            },
            _ => float_scientific(digits, first)
        }
    }

    // The digits of 128 bits read without a sign.
    pub fn unsigned_digits(n: Int, rest: Str) -> Str {
        let digit = char_of(int_add(48, uw_rem(n, 10)));
        match(uw_div(n, 10)) {
            0 => StrChar(digit, rest),
            more => tail unsigned_digits(more, StrChar(digit, rest))
        }
    }

    pub fn float_text(negative: Int, wide: Int, held: Int, single: Int, infinite: Int) -> Str {
        let sign = match(negative) { 0 => "", _ => "-" };
        match(f64_eq(wide, wide)) {
            0 => "NaN",
            _ => match(int_eq(held, infinite)) {
                0 => match(held) {
                    0 => sign ++ "0.0",
                    _ =>
                        let (digits, exp10) = float_shortest(wide, held, single, 1);
                        let text = digits_before(int_sub(0, digits), StrEnd);
                        sign ++ float_placed(text, exp10, int_add(exp10, int_sub(length(text), 1)))
                },
                _ => sign ++ "inf"
            }
        }
    }
}
use number_text::{digits_before, float_text, unsigned_digits};

// A whole number of any width as text.
fn show_whole(n: Int) -> Str {
    match(int_lt(n, 0)) {
        0 => digits_before(wide_sub(0, n), StrEnd),
        _ => StrChar('-', digits_before(n, StrEnd))
    }
}

impl Show for Int { fn fmt(n: &Int) -> Str { show_whole(*n) } }

// A tuple and a `Result` as text, if their parts are. Truth is `Ok(())`.
impl Show for () { fn fmt(u: &()) -> Str { "()" } }
impl<A, B> Show for (A, B) where A: Show, B: Show {
    fn fmt(p: &(A, B)) -> Str { "(" ++ fmt(&(*p).0) ++ ", " ++ fmt(&(*p).1) ++ ")" }
}
impl<A, B, C> Show for (A, B, C) where A: Show, B: Show, C: Show {
    fn fmt(p: &(A, B, C)) -> Str { "(" ++ fmt(&(*p).0) ++ ", " ++ fmt(&(*p).1) ++ ", " ++ fmt(&(*p).2) ++ ")" }
}
impl<T, E> Show for Result<T, E> where T: Show, E: Show {
    fn fmt(r: &Result<T, E>) -> Str {
        match(r) {
            Ok(value) => "Ok(" ++ fmt(value) ++ ")",
            Err(error) => "Err(" ++ fmt(error) ++ ")"
        }
    }
}
// Truth, `Result<(), ()>`, as `true` and `false` (preferred, as the more
// particular implementation, over the one of every `Result`).
impl Show for Result<(), ()> {
    fn fmt(b: &Result<(), ()>) -> Str { match(b) { Ok(_) => "true", Err(_) => "false" } }
}

// An array: its elements, one after another. The machines build its values
// and read a place of one in a step; the constructor written here builds
// none, and says only that an array holds values of the one type. An array
// is a value: changing one makes another.
struct Array<T>(T)

// (An intrinsic, declared with the arrays it gives one of.) The name of the function a callable is of, as its characters' codes, and
// the callable back.
#[intrinsic] unsafe fn host_fn_name<T>(value: T, at: Int) -> (Int, T) where T: Use<[1, 1]>;

// An address, with what is said to be there: `*const T` and `*mut T`. To
// have one says nothing of what is at the address; reading and writing
// there is unsafe, and the library's to give.
struct Ptr<T>(usize)
struct PtrMut<T>(usize)

fn ptr_at<T>(address: usize) -> *const T { Ptr(address) }
// How many bytes a value of what a pointer is to takes, and at what
// alignment: as the type is laid out, which the program's types say.
// (Of a `*mut T`: what its `T` is, the program's types say, where an
// address made from it is a `*mut` of anything.)
// A slice, `&'a [T]`: so many `T`s one after another from an address,
// borrowed for as long as `'a`. `&'a mut [T]` is a `SliceMut`, the same to
// change them through.
struct SliceRef<'a, T> { at: *mut T, len: Int, life: &'a () }
struct SliceMut<'a, T> { at: *mut T, len: Int, life: &'a mut () }
// So many `T`s from where a pointer points, borrowed for as long as the
// caller says: the caller's to get right.
unsafe fn slice_at<'a, T>(at: *mut T, len: Int) -> &'a [T] { SliceRef { at: at, len: len, life: transmute(ptr_mut_address(at)) } }
unsafe fn slice_mut_at<'a, T>(at: *mut T, len: Int) -> &'a mut [T] { SliceMut { at: at, len: len, life: transmute(ptr_mut_address(at)) } }
// All of a `[T; N]`'s elements, borrowed: a `&[T; N]` is a `&[T]` wherever
// one is wanted, as in Rust.
// (Its length from the array, not from `N`: a coercion is given no
// trait.)
coerce fixed_slice
fn fixed_slice<'a, T, N>(a: &'a [T; N]) -> &'a [T] {
    unsafe { SliceRef { at: fixed_ptr(a), len: fixed_len_at(a), life: transmute(a) } }
}
coerce fixed_slice_mut
fn fixed_slice_mut<'a, T, N>(a: &'a mut [T; N]) -> &'a mut [T] {
    unsafe { SliceMut { at: fixed_ptr(&*a), len: fixed_len_at(&*a), life: transmute(a) } }
}
// An array's elements as a slice, and by reference, as Rust's arrays have.
impl<T, N> Fixed<T, N> {
    fn as_slice<'a>(a: &'a Self) -> &'a [T] { fixed_slice(a) }
    fn as_mut_slice<'a>(a: &'a mut Self) -> &'a mut [T] { fixed_slice_mut(a) }
    fn iter<'a>(a: &'a Self) -> SliceIter<'a, T> { SliceIter { rest: fixed_slice(a) } }
}
impl<'a, T> SliceRef<'a, T> {
    fn len(s: &Self) -> Int { s.len }
    fn is_empty(s: &Self) -> Bool { int_eq(s.len, 0) == 1 }
    // The element at a place, if there is one there.
    fn get(s: &Self, i: Int) -> Option<&'a T> {
        match(int_mul(int_lt(-1, i), int_lt(i, s.len))) {
            0 => None,
            _ => Some(unsafe { ptr_ref_at(s.at, slice_place(s.at, i)) })
        }
    }
    fn first(s: &Self) -> Option<&'a T> { SliceRef::get(s, 0) }
    fn last(s: &Self) -> Option<&'a T> { SliceRef::get(s, int_sub(s.len, 1)) }
    // The elements from one place up to, not including, another, if both
    // are places of it (`s.get(from..to)` in Rust).
    fn sub(s: &Self, from: Int, to: Int) -> Option<&'a [T]> {
        match(int_mul(int_mul(int_lt(-1, from), int_eq(int_lt(to, from), 0)), int_eq(int_lt(s.len, to), 0))) {
            0 => None,
            _ => Some(unsafe { slice_at(ptr_mut_at(slice_place(s.at, from)), int_sub(to, from)) })
        }
    }
    // What is before a place, and what is from it on; the program stops
    // where the place is past its end, as Rust's does.
    fn split_at(s: &Self, mid: Int) -> (&'a [T], &'a [T]) {
        match(int_mul(int_lt(-1, mid), int_eq(int_lt(s.len, mid), 0))) {
            0 => abort("`split_at` of a place past a slice's end"),
            _ => unsafe { (slice_at(s.at, mid), slice_at(ptr_mut_at(slice_place(s.at, mid)), int_sub(s.len, mid))) }
        }
    }
    // The first element and the rest, if there is one.
    fn split_first(s: &Self) -> Option<(&'a T, &'a [T])> {
        match(int_lt(0, s.len)) {
            0 => None,
            _ => Some(unsafe { (ptr_ref_at(s.at, ptr_mut_address(s.at)), slice_at(ptr_mut_at(slice_place(s.at, 1)), int_sub(s.len, 1))) })
        }
    }
    // Its elements by reference, first to last.
    fn iter(s: &Self) -> SliceIter<'a, T> { SliceIter { rest: *s } }
    // Where its elements are.
    fn as_ptr(s: &Self) -> *mut T { s.at }
}
impl<'a, T> SliceMut<'a, T> {
    fn len(s: &Self) -> Int { s.len }
    fn is_empty(s: &Self) -> Bool { int_eq(s.len, 0) == 1 }
    fn get(s: &Self, i: Int) -> Option<&T> {
        match(int_mul(int_lt(-1, i), int_lt(i, s.len))) {
            0 => None,
            _ => Some(unsafe { ptr_ref_at(s.at, slice_place(s.at, i)) })
        }
    }
    fn get_mut(s: &mut Self, i: Int) -> Option<&mut T> {
        match(int_mul(int_lt(-1, i), int_lt(i, s.len))) {
            0 => None,
            _ => Some(unsafe { ptr_mut_ref_at(s.at, slice_place(s.at, i)) })
        }
    }
    // The same elements, to read.
    fn as_slice<'b>(s: &'b Self) -> &'b [T] { unsafe { slice_at(s.at, s.len) } }
    fn as_ptr(s: &Self) -> *mut T { s.at }
}
// A slice's elements by reference, first to last (`Iterator` is
// `std::iterator`'s).
struct SliceIter<'a, T> { rest: &'a [T] }
impl<'a, T> SliceIter<'a, T> {
    // The next element, if there is one.
    fn next_ref(it: &mut Self) -> Option<&'a T> {
        match(it.rest.split_first()) {
            Some((first, rest)) => it.rest = rest; Some(first),
            None => None
        }
    }
    // What is left.
    fn as_slice(it: &Self) -> &'a [T] { it.rest }
}
// The address of the element at a place, from the first's.
fn slice_place<T>(at: *mut T, i: Int) -> usize { usize_of(int_add(usize_bits(ptr_mut_address(at)), int_mul(i, usize_bits(size_of_at(at))))) }
impl<'a, T> Indexed for SliceRef<'a, T> {
    type Element = T;
    fn element_at(s: &SliceRef<'a, T>, i: Int) -> &T {
        match(int_mul(int_lt(-1, i), int_lt(i, s.len))) {
            0 => abort("a place of a slice that is not there"),
            _ => unsafe { ptr_ref_at(s.at, slice_place(s.at, i)) }
        }
    }
    fn size_at(s: &SliceRef<'a, T>) -> Int { s.len }
}
impl<'a, T> Indexed for SliceMut<'a, T> {
    type Element = T;
    fn element_at(s: &SliceMut<'a, T>, i: Int) -> &T {
        match(int_mul(int_lt(-1, i), int_lt(i, s.len))) {
            0 => abort("a place of a slice that is not there"),
            _ => unsafe { ptr_ref_at(s.at, slice_place(s.at, i)) }
        }
    }
    fn size_at(s: &SliceMut<'a, T>) -> Int { s.len }
}
impl<'a, T> IndexedMut for SliceMut<'a, T> {
    fn place_at(i: Int, s: &mut SliceMut<'a, T>) -> &mut T {
        match(int_mul(int_lt(-1, i), int_lt(i, s.len))) {
            0 => abort("a place of a slice that is not there"),
            _ => unsafe { ptr_mut_ref_at(s.at, slice_place(s.at, i)) }
        }
    }
}
// `s[i]` of a slice: the element, read where it is.
impl<'a, T> Index for SliceRef<'a, T> {
    type Elem = T;
    fn index(s: SliceRef<'a, T>, i: Int) -> T { *element_at(&s, i) }
    fn index_set(s: SliceRef<'a, T>, i: Int, v: T) -> SliceRef<'a, T> { abort("an element of a `&[T]` written: it is borrowed to read") }
}
impl<'a, T> Index for SliceMut<'a, T> {
    type Elem = T;
    fn index(s: SliceMut<'a, T>, i: Int) -> T { *element_at(&s, i) }
    fn index_set(s: SliceMut<'a, T>, i: Int, v: T) -> SliceMut<'a, T> {
        let mut s = s;
        let _ = replace(place_at(i, &mut s), v);
        s
    }
}
impl<'a, T> Len for SliceRef<'a, T> { fn len(s: SliceRef<'a, T>) -> Int { s.len } }
impl<'a, T> Len for SliceMut<'a, T> { fn len(s: SliceMut<'a, T>) -> Int { s.len } }

// Text borrowed, `&'a str`: so many bytes of UTF-8 at an address, there for
// as long as `'a`.
struct StrRef<'a> { at: usize, len: Int, life: &'a () }
// So many bytes of text at an address, borrowed for as long as the caller
// says: the caller's to get right.
unsafe fn str_at<'a>(at: usize, len: Int) -> &'a str { StrRef { at: at, len: len, life: transmute(at) } }
impl<'a> StrRef<'a> {
    // How many bytes.
    fn len(s: &Self) -> Int { s.len }
    fn is_empty(s: &Self) -> Bool { int_eq(s.len, 0) == 1 }
    // The byte at a place, which is there.
    fn byte(s: &Self, i: Int) -> u8 { u8_of(unsafe { ptr_read(usize_of(int_add(usize_bits(s.at), i)), -8) }) }
    // Where its bytes are.
    fn address(s: &Self) -> usize { s.at }
}
// The characters UTF-8 bytes from a place on are, as a `Str`; `rest` after.
fn str_chars(s: &StrRef, i: Int, out: Str) -> Str {
    match(int_lt(i, 0)) {
        0 => out,
        _ => tail str_chars(s, int_sub(i, 1), StrChar(str_char_at(s, i), out))
    }
}
fn str_char_at(s: &StrRef, i: Int) -> char { char_of(u8_bits(StrRef::byte(s, i))) }
impl<'a> Show for StrRef<'a> {
    fn fmt(s: &StrRef<'a>) -> Str { str_decode(s, 0, StrEnd) }
}
// The text's characters, decoded from UTF-8 from a place on, before `rest`
// reversed and then put back in order.
fn str_decode(s: &StrRef, i: Int, back: Str) -> Str {
    match(int_lt(i, s.len)) {
        0 => str_reversed(back, StrEnd),
        _ =>
            let b0 = u8_bits(StrRef::byte(s, i));
            let (code, n) = match(int_lt(b0, 128)) {
                1 => (b0, 1),
                _ => match(int_lt(b0, 224)) {
                    1 => (int_add(int_mul(int_sub(b0, 192), 64), int_sub(u8_bits(StrRef::byte(s, int_add(i, 1))), 128)), 2),
                    _ => match(int_lt(b0, 240)) {
                        1 => (int_add(int_mul(int_add(int_mul(int_sub(b0, 224), 64), int_sub(u8_bits(StrRef::byte(s, int_add(i, 1))), 128)), 64),
                              int_sub(u8_bits(StrRef::byte(s, int_add(i, 2))), 128)), 3),
                        _ => (int_add(int_mul(int_add(int_mul(int_add(int_mul(int_sub(b0, 240), 64), int_sub(u8_bits(StrRef::byte(s, int_add(i, 1))), 128)), 64),
                              int_sub(u8_bits(StrRef::byte(s, int_add(i, 2))), 128)), 64), int_sub(u8_bits(StrRef::byte(s, int_add(i, 3))), 128)), 4)
                    }
                }
            };
            tail str_decode(s, int_add(i, n), StrChar(char_of(code), back))
    }
}
fn str_reversed(a: Str, out: Str) -> Str {
    match(a) { StrEnd => out, StrChar(c, rest) => tail str_reversed(rest, StrChar(c, out)) }
}
// Two texts are equal where their bytes are.
impl<'a> Eq for StrRef<'a> {
    fn ==(a: StrRef<'a>, b: StrRef<'a>) -> Bool {
        match(int_eq(a.len, b.len)) { 0 => false, _ => str_same(&a, &b, 0) }
    }
}
fn str_same(a: &StrRef, b: &StrRef, i: Int) -> Bool {
    match(int_lt(i, a.len)) {
        0 => true,
        _ => match(int_eq(u8_bits(StrRef::byte(a, i)), u8_bits(StrRef::byte(b, i)))) { 0 => false, _ => tail str_same(a, b, int_add(i, 1)) }
    }
}
#[intrinsic] fn size_of_at<T>(p: *mut T) -> usize;
#[intrinsic] fn align_of_at<T>(p: *mut T) -> usize;
// A `T` at an address, as a reference for as long as the caller says, for a
// pointer to `T`s (`base`, for its type): the caller's to get right.
#[intrinsic] unsafe fn ptr_ref_at<'a, T>(base: *mut T, at: usize) -> &'a T;
#[intrinsic] unsafe fn ptr_mut_ref_at<'a, T>(base: *mut T, at: usize) -> &'a mut T;
// Where a `[T; N]`'s elements are, one after another, in memory.
#[intrinsic] unsafe fn fixed_ptr<T, N>(a: &[T; N]) -> *mut T;
#[intrinsic] fn fixed_len_at<T, N>(a: &[T; N]) -> Int;
fn ptr_mut_at<T>(address: usize) -> *mut T { PtrMut(address) }
fn ptr_address<T>(p: *const T) -> usize { p.0 }
fn ptr_mut_address<T>(p: *mut T) -> usize { p.0 }
fn ptr_const<T>(p: *mut T) -> *const T { Ptr(p.0) }
// The address so many `T`s on.
fn ptr_offset<T>(p: *mut T, n: Int) -> *mut T where T: Layout { PtrMut(usize_of(int_add(usize_bits(p.0), int_mul(n, size_of<T>())))) }
// What is at the address, copied out; and what is put there, moved in, what
// was there neither given back nor destroyed. The address is a `T`'s.
unsafe fn ptr_load<T>(p: *const T) -> T where T: Repr { <T as Repr>::repr_load(p.0) }
unsafe fn ptr_store<T>(p: *mut T, value: T) where T: Repr { <T as Repr>::repr_store(p.0, value) }
// Memory for so many `T`s, zeroed; and memory freed. Each is the memory's
// owner's to get right.
unsafe fn alloc_of<T>(count: Int) -> *mut T where T: Layout {
    PtrMut(mem_alloc(usize_of(int_mul(count, size_of<T>())), usize_of(align_of<T>())))
}
unsafe fn free_of<T>(p: *mut T) { mem_free(p.0) }
// So many `T`s copied from one place to another.
unsafe fn copy_of<T>(to: *mut T, from: *const T, count: Int) where T: Layout {
    mem_copy(to.0, from.0, usize_of(int_mul(count, size_of<T>())))
}

// `a[i]` is `index(a, i)`, and `a[i] = v` makes `a` be `index_set(a, i, v)`.
// A place that is not there has no meaning: the program stops.
trait Index {
    type Elem;
    fn index(Self, Int) -> Elem
    fn index_set(Self, Int, Elem) -> Self
}
trait Len { fn len(Self) -> Int }
impl Len for Str { fn len(text: Str) -> Int { length(text) } }

// Whole numbers as types, for how long a `[T; N]` is: the bits from the
// lowest, `B1<B0<B1<Z>>>` for five. What number a type stands for is its
// `VALUE`.
struct Z
struct B0<N>
struct B1<N>
trait Known { const VALUE: Int; }
impl Known for Z { const VALUE: Int = 0; }
impl<N> Known for B0<N> where N: Known { const VALUE: Int = int_mul(2, N::VALUE); }
impl<N> Known for B1<N> where N: Known { const VALUE: Int = int_add(int_mul(2, N::VALUE), 1); }

// `[T; N]`: an array of exactly `N` elements.
struct Fixed<T, N>(Array<T>)
// (Built by the machines, one constructor of `N` fields for each `N`, the
// length in its type: the field written here only says what it holds.)
impl<T, N> Index for Fixed<T, N> {
    type Elem = T;
    fn index(a: Fixed<T, N>, i: Int) -> T { fixed_get(a, i) }
    fn index_set(a: Fixed<T, N>, i: Int, v: T) -> Fixed<T, N> { fixed_set(a, i, v) }
}
impl<T, N> Len for Fixed<T, N> where N: Known { fn len(a: Fixed<T, N>) -> Int { N::VALUE } }
// In memory, its elements one after another, as Rust lays out `[T; N]`.
impl<T, N> Layout for Fixed<T, N> where T: Layout, N: Known {
    const SIZE: Int = int_mul(N::VALUE, size_of<T>());
    const ALIGN: Int = align_of<T>();
}
// (Each element written where it goes; the array let go of, its elements
// written out. Read back, the first fills it and each after is put in its
// place.)
impl<T, N> Repr for Fixed<T, N> where T: Repr, T: Layout, N: Known, T: Use<[0, *]> {
    unsafe fn repr_store(at: usize, value: Fixed<T, N>) { fixed_store_from(at, value, 0, N::VALUE) }
    unsafe fn repr_load(at: usize) -> Fixed<T, N> {
        match(int_eq(N::VALUE, 0)) {
            1 => unsafe { transmute(fixed_make()) },
            _ =>
                let mut out = fixed_fill(unsafe { <T as Repr>::repr_load(at) }, N::VALUE);
                let mut i = 1;
                while({ int_lt(i, N::VALUE) == 1 }) {
                    out = fixed_set(out, i, unsafe { <T as Repr>::repr_load(repr_at(at, int_mul(i, size_of<T>()))) });
                    i = int_add(i, 1)
                };
                out
        }
    }
}
// (Plain data, copied: each element written where it goes.)
unsafe fn fixed_store_from<T, N>(at: usize, a: Fixed<T, N>, i: Int, n: Int) where T: Repr, T: Layout, T: Use<[0, *]> {
    match(int_lt(i, n)) {
        0 => (),
        _ => <T as Repr>::repr_store(repr_at(at, int_mul(i, size_of<T>())), fixed_get(a, i)); tail fixed_store_from(at, a, int_add(i, 1), n)
    }
}
// `N` of one value: `[x; N]`.
fn fixed_repeat<T, N>(x: T) -> Fixed<T, N> where N: Known, T: Use<[0, *]> { fixed_fill(x, N::VALUE) }
// `[x; 4]`: four of `x`.
fn fixed_repeat_of<N, T>(x: T) -> Fixed<T, N> where N: Known, T: Use<[0, *]> { fixed_fill(x, N::VALUE) }
// `[]` of a length its type says, `[T; 0]`.
fn no_elements<T>() -> [T; 0] { fixed_make() }

// What `[first, ..rest]` in a pattern is read with: whether a slice (or an
// array) has so many elements, or exactly so many, and what is left without
// its first or its last. Of a `&[T]` an element is a `&T`, and the rest a
// `&[T]`, as Rust binds them.
enum ArrayRest<A> { RestFits(A), RestShort(A) }
trait RestOf {
    type Part;
    fn rest_len(&Self) -> Int
    fn rest_first(Self) -> (Part, Self)
    fn rest_last(Self) -> (Self, Part)
}
fn rest_fits<A>(a: A, n: Int) -> ArrayRest<A> where A: RestOf {
    match(int_lt(<A as RestOf>::rest_len(&a), n)) { 0 => RestFits(a), _ => RestShort(a) }
}
fn rest_exact<A>(a: A, n: Int) -> ArrayRest<A> where A: RestOf {
    match(int_eq(<A as RestOf>::rest_len(&a), n)) { 1 => RestFits(a), _ => RestShort(a) }
}
// Where none comes: the clauses were shown to cover every shorter one.
fn rest_unreached<A, R>(a: A) -> R where A: Use<[1, 1]>, R: Use<[1, 1]> { match(int_div(1, 0)) { _ => tail rest_unreached(a) } }
impl<'a, T> RestOf for SliceRef<'a, T> {
    type Part = &'a T;
    fn rest_len(s: &SliceRef<'a, T>) -> Int { s.len }
    fn rest_first(s: SliceRef<'a, T>) -> (&'a T, SliceRef<'a, T>) {
        unsafe { (ptr_ref_at(s.at, ptr_mut_address(s.at)), slice_at(ptr_mut_at(slice_place(s.at, 1)), int_sub(s.len, 1))) }
    }
    fn rest_last(s: SliceRef<'a, T>) -> (SliceRef<'a, T>, &'a T) {
        unsafe { (slice_at(s.at, int_sub(s.len, 1)), ptr_ref_at(s.at, slice_place(s.at, int_sub(s.len, 1)))) }
    }
}
impl<'a, T> RestOf for SliceMut<'a, T> {
    type Part = &'a mut T;
    fn rest_len(s: &SliceMut<'a, T>) -> Int { s.len }
    fn rest_first(s: SliceMut<'a, T>) -> (&'a mut T, SliceMut<'a, T>) {
        unsafe { (ptr_mut_ref_at(s.at, ptr_mut_address(s.at)), slice_mut_at(ptr_mut_at(slice_place(s.at, 1)), int_sub(s.len, 1))) }
    }
    fn rest_last(s: SliceMut<'a, T>) -> (SliceMut<'a, T>, &'a mut T) {
        unsafe { (slice_mut_at(s.at, int_sub(s.len, 1)), ptr_mut_ref_at(s.at, slice_place(s.at, int_sub(s.len, 1)))) }
    }
}

// How many elements what a reference points to has (an array, a `[T; N]`,
// a `Vec`, a slice).
fn len_at<A>(a: &A) -> Int where A: Indexed { size_at(a) }

// The element at a place, by reference, if the place is there.
fn element<A, T>(a: &A, i: Int) -> Option<&T> where A: Indexed<Element = T> {
    match(int_mul(int_lt(-1, i), int_lt(i, size_at(a)))) {
        0 => None,
        _ => Some(element_at(a, i))
    }
}

// `&a[i]` and `&mut a[i]`: the element where it is. A place that is not
// there has no meaning: the program stops, as it does for `a[i]`.
// What holds elements in order: one borrowed in place, to read or to write
// through. `&a[i]` and `a[i] = v` are of these.
trait Indexed {
    type Element;
    fn element_at(&Self, Int) -> &Element
    fn size_at(&Self) -> Int
}
trait IndexedMut: Indexed {
    fn place_at(Int, &mut Self) -> &mut Self::Element
}
impl<T, N> Indexed for Fixed<T, N> where N: Known {
    type Element = T;
    fn element_at(a: &Fixed<T, N>, i: Int) -> &T { fixed_at(a, i) }
    fn size_at(a: &Fixed<T, N>) -> Int { N::VALUE }
}
impl<T, N> IndexedMut for Fixed<T, N> where N: Known { fn place_at(i: Int, a: &mut Fixed<T, N>) -> &mut <Fixed<T, N> as Indexed>::Element { fixed_at(a, i) } }
// A reference to one is one: `a[i]` of an `a: &mut [T]` is of what it is to.
impl<'a, A> Indexed for &'a A where A: Indexed {
    type Element = A::Element;
    fn element_at<'b>(r: &'b &'a A, i: Int) -> &'b A::Element { element_at(*r, i) }
    fn size_at(r: &&'a A) -> Int { size_at(*r) }
}
impl<'a, A> Indexed for &'a mut A where A: Indexed {
    type Element = A::Element;
    fn element_at<'b>(r: &'b &'a mut A, i: Int) -> &'b A::Element { element_at(&*(*r), i) }
    fn size_at(r: &&'a mut A) -> Int { size_at(&*(*r)) }
}
impl<'a, A> IndexedMut for &'a mut A where A: IndexedMut {
    fn place_at<'b>(i: Int, r: &'b mut &'a mut A) -> &'b mut A::Element { place_at(i, &mut *(*r)) }
}
// How many a reference's elements are, as `len` of what it is to.
impl<'a, A> Len for &'a A where A: Indexed { fn len(r: &'a A) -> Int { size_at(r) } }
impl<'a, A> Len for &'a mut A where A: Indexed { fn len(r: &'a mut A) -> Int { size_at(&*r) } }

// `a[i]` of a reference to an array: the element, read through it. (`a[i] =
// v` writes through it where it is, as of a variable's array.)
impl<'a, A> Index for &'a A where A: Indexed {
    type Elem = A::Element;
    fn index(r: &'a A, i: Int) -> A::Element { *element_at(r, i) }
    fn index_set(r: &'a A, i: Int, v: A::Element) -> &'a A { r }
}
impl<'a, A> Index for &'a mut A where A: Indexed {
    type Elem = A::Element;
    fn index(r: &'a mut A, i: Int) -> A::Element { *element_at(&*r, i) }
    fn index_set(r: &'a mut A, i: Int, v: A::Element) -> &'a mut A { r }
}

// The same to write through.
fn element_mut<A, T>(a: &mut A, i: Int) -> Option<&mut T> where A: IndexedMut, A: Indexed<Element = T> {
    match(int_mul(int_lt(-1, i), int_lt(i, size_at(&*a)))) {
        0 => None,
        _ => Some(place_at(i, a))
    }
}

// Characters as a text (`std::text::chars` is a text's characters).
fn text<A>(a: A) -> Str where A: Indexed<Element = char> { let held = a; text_before(&held, size_at(&held), StrEnd) }
fn text_before<A>(a: &A, i: Int, rest: Str) -> Str where A: Indexed<Element = char> {
    match(i) {
        0 => rest,
        _ => tail text_before(a, int_sub(i, 1), StrChar(*element_at(a, int_sub(i, 1)), rest))
    }
}

// `f(f(f(init, a[0]), a[1]), ..)`, of the elements of anything that has
// them one after another: an array, a `[T; N]`, a `Vec`, a slice.
fn fold<A, T, U, e: EffectRow>(a: A, init: U, f: fn(U, T) -> U / {| e}) -> U / {| e}
where A: Indexed<Element = T>, T: Use<[0, *]>, U: Use<[1, 1]> {
    let held = a;
    fold_from(&held, size_at(&held), 0, init, f)
}
fn fold_from<A, T, U, e: EffectRow>(a: &A, n: Int, i: Int, acc: U, f: fn(U, T) -> U / {| e}) -> U / {| e}
where A: Indexed<Element = T>, T: Use<[0, *]>, U: Use<[1, 1]> {
    match(int_lt(i, n)) {
        0 => acc,
        _ => tail fold_from(a, n, int_add(i, 1), f(acc, *element_at(a, i)), f)
    }
}
fn each<A, T, e: EffectRow>(a: A, f: fn(T) -> () / {| e}) -> () / {| e} where A: Indexed<Element = T>, T: Use<[0, *]> { fold(a, (), fn(done, x) { f(x) }) }

// Elements one after another, each written where it is: `[a, b]`.
fn elements_text<A, T>(a: &A) -> Str where A: Indexed<Element = T>, T: Show { "[" ++ elements_from(a, size_at(a), 0, StrEnd) ++ "]" }
fn elements_from<A, T>(a: &A, n: Int, i: Int, text: Str) -> Str where A: Indexed<Element = T>, T: Show {
    match(int_lt(i, n)) {
        0 => text,
        _ => tail elements_from(a, n, int_add(i, 1), match(i) { 0 => fmt(element_at(a, i)), _ => text ++ ", " ++ fmt(element_at(a, i)) })
    }
}

// A slice written as an array is.
impl<'a, T> Show for SliceRef<'a, T> where T: Show { fn fmt(s: &SliceRef<'a, T>) -> Str { elements_text(s) } }

// A `[T; N]` written as an array is.
impl<T, N> Show for Fixed<T, N> where T: Show, N: Known { fn fmt(a: &Fixed<T, N>) -> Str { elements_text(a) } }

// Write a value as text.
fn say<T>(value: T) where T: Show { host_write(show(value)) }

// A value owned anew, from one read through a reference (the library
// specification's §3.1): of what is copied as it is read, the copy; of a
// tuple, a `Result` or an array, each part's.
trait Clone { fn clone(value: &Self) -> Self }

// What a value stands for where a field is read of it that it does not show:
// the field is of what `deref` gives, and of what `deref_mut` gives where it
// is written or borrowed `&mut` (a `Mut<T>` as its `T`).
trait Deref { type Target; fn deref(value: &Self) -> &Target }
trait DerefMut { type Target; fn deref_mut(value: &mut Self) -> &mut Target }
impl Clone for Int { fn clone(v: &Int) -> Int { *v } }
impl Clone for Str { fn clone(v: &Str) -> Str { *v } }
impl Clone for char { fn clone(v: &char) -> char { *v } }
impl Clone for () { fn clone(v: &()) { () } }
impl<A, B> Clone for (A, B) where A: Clone, B: Clone { fn clone(p: &(A, B)) -> (A, B) { (clone(&p.0), clone(&p.1)) } }
impl<A, B, C> Clone for (A, B, C) where A: Clone, B: Clone, C: Clone {
    fn clone(p: &(A, B, C)) -> (A, B, C) { (clone(&p.0), clone(&p.1), clone(&p.2)) }
}
impl<T, E> Clone for Result<T, E> where T: Clone, E: Clone {
    fn clone(r: &Result<T, E>) -> Result<T, E> { match(r) { &Ok(v) => Ok(clone(v)), &Err(e) => Err(clone(e)) } }
}

// Of a result: what `Ok` holds, or else leaving for the label with the error
// (`try(r, @f)` in a function that gives a `Result`); the same with the
// error made another first; leaving with an error unless a condition holds;
// and of an option, what `Some` holds or else leaving with what a fallback
// gives. (The library specification's §6. There is no `?`.)
fn try<T, E, R, L, e: EffectRow>(value: Result<T, E>, target: L) -> T / {| e} where L: Label<Result<R, E>>, T: Use<[1, 1]>, E: Use<[1, 1]>, R: Use<[1, 1]> {
    match(value) { Ok(v) => v, Err(e) => target(Err(e)) }
}
fn try_map_error<T, E, D, R, L, e: EffectRow>(value: Result<T, E>, target: L, map_error: fn(E) -> D / {| e}) -> T / {| e} where L: Label<Result<R, D>>, T: Use<[1, 1]>, E: Use<[1, 1]>, D: Use<[1, 1]>, R: Use<[1, 1]> {
    match(value) { Ok(v) => v, Err(e) => target(Err(map_error(e))) }
}
fn ensure<R, E, L, e: EffectRow>(condition: Result<(), ()>, target: L, make_error: fn() -> E / {| e}) -> () / {| e} where L: Label<Result<R, E>>, R: Use<[1, 1]>, E: Use<[1, 1]> {
    match(condition) { Ok(_) => (), Err(_) => target(Err(make_error())) }
}
fn some_or_leave<T, R, L, e: EffectRow>(value: Result<T, ()>, target: L, fallback: fn() -> R / {| e}) -> T / {| e} where L: Label<R>, T: Use<[1, 1]>, R: Use<[1, 1]> {
    match(value) { Ok(v) => v, Err(_) => target(fallback()) }
}

// Stopping: what is said is written, and the program stops there, with no
// cleanup run (the library specification's §6.1).
fn abort<T>(message: Str) -> T { host_write(message); fixed_get(no_elements(), 0) }
fn unreachable<T>(message: Str) -> T where T: Use<[1, 1]> { abort(message) }
// What an `Option` or a `Result` has, asked of it as a value's own: `o.map(f)`.
// (An `Option<T>` is a `Result<T, ()>`, so each is both's.)
impl<T, E> Result<T, E> {
    fn is_some(value: &Self) -> Bool { match(value) { &Ok(_) => true, &Err(_) => false } }
    fn is_none(value: &Self) -> Bool { match(value) { &Ok(_) => false, &Err(_) => true } }
    fn is_ok(value: &Self) -> Bool { match(value) { &Ok(_) => true, &Err(_) => false } }
    fn is_err(value: &Self) -> Bool { match(value) { &Ok(_) => false, &Err(_) => true } }
    fn unwrap(value: Self) -> T where T: Use<[1, 1]> { match(value) { Ok(x) => x, Err(_) => abort("unwrap of nothing") } }
    fn expect(value: Self, message: Str) -> T where T: Use<[1, 1]> { match(value) { Ok(x) => x, Err(_) => abort(message) } }
    fn unwrap_or(value: Self, other: T) -> T { match(value) { Ok(x) => x, Err(_) => other } }
    fn unwrap_or_else<e: EffectRow>(value: Self, other: fn(E) -> T / {| e}) -> T / {| e} where T: Use<[1, 1]>, E: Use<[1, 1]> { match(value) { Ok(x) => x, Err(e) => other(e) } }
    fn map<V, e: EffectRow>(value: Self, f: fn(T) -> V / {| e}) -> Result<V, E> / {| e} where V: Use<[1, 1]>, T: Use<[1, 1]> { match(value) { Ok(x) => Ok(f(x)), Err(e) => Err(e) } }
    fn map_err<V, e: EffectRow>(value: Self, f: fn(E) -> V / {| e}) -> Result<T, V> / {| e} where V: Use<[1, 1]>, E: Use<[1, 1]> { match(value) { Ok(x) => Ok(x), Err(e) => Err(f(e)) } }
    fn and_then<V, e: EffectRow>(value: Self, f: fn(T) -> Result<V, E> / {| e}) -> Result<V, E> / {| e} where V: Use<[1, 1]>, T: Use<[1, 1]>, E: Use<[1, 1]> { match(value) { Ok(x) => f(x), Err(e) => Err(e) } }
    fn or_else<V, e: EffectRow>(value: Self, f: fn(E) -> Result<T, V> / {| e}) -> Result<T, V> / {| e} where V: Use<[1, 1]>, T: Use<[1, 1]>, E: Use<[1, 1]> { match(value) { Ok(x) => Ok(x), Err(e) => f(e) } }
    fn ok_or<D>(value: Self, error: D) -> Result<T, D> where T: Use<[1, 1]> { match(value) { Ok(x) => Ok(x), Err(_) => Err(error) } }
    fn ok(value: Self) -> Option<T> where T: Use<[1, 1]> { match(value) { Ok(x) => Some(x), Err(_) => None } }
    fn filter<e: EffectRow>(value: Self, keep: for<'a> fn(&'a T) -> Bool / {| e}) -> Result<T, ()> / {| e} {
        match(value) { Ok(x) => if(keep(&x)) { Ok(x) } else { Err(()) }, Err(_) => Err(()) }
    }
}
fn assert(condition: Result<(), ()>) { match(condition) { Ok(_) => (), Err(_) => abort("assertion failed") } }
fn assert_message(condition: Result<(), ()>, message: Str) { match(condition) { Ok(_) => (), Err(_) => abort(message) } }
fn assert_eq<T>(left: &T, right: &T) where T: Eq, T: Show, T: Use<[0, *]> {
    match(*left == *right) { Ok(_) => (), Err(_) => abort(show(*left) ++ " is not " ++ show(*right)) }
}
fn assert_ne<T>(left: &T, right: &T) where T: Eq, T: Show, T: Use<[0, *]> {
    match(*left == *right) { Ok(_) => abort(show(*left) ++ " is what it should not be"), Err(_) => () }
}


// Values made of values that can be compared can be compared.
impl Eq for () { fn ==(a: (), b: ()) -> Bool { true } }
impl<A, B> Eq for (A, B) where A: Eq, B: Eq {
    fn ==(x: (A, B), y: (A, B)) -> Bool { match((x, y)) { ((a, b), (c, d)) => a == c and { b == d } } }
}
impl<A, B, C> Eq for (A, B, C) where A: Eq, B: Eq, C: Eq {
    fn ==(x: (A, B, C), y: (A, B, C)) -> Bool { match((x, y)) { ((a, b, c), (d, e, f)) => a == d and { b == e } and { c == f } } }
}
impl<T, E> Eq for Result<T, E> where T: Eq, E: Eq {
    fn ==(x: Result<T, E>, y: Result<T, E>) -> Bool {
        match((x, y)) {
            (Ok(a), Ok(b)) => a == b,
            (Err(a), Err(b)) => a == b,
            _ => false
        }
    }
}
impl<T, N> Eq for Fixed<T, N> where T: Eq, T: Use<[0, *]>, N: Known {
    fn ==(a: Fixed<T, N>, b: Fixed<T, N>) -> Bool { fixed_same(&a, &b, 0) }
}
fn fixed_same<T, N>(a: &Fixed<T, N>, b: &Fixed<T, N>, i: Int) -> Bool where T: Eq, T: Use<[0, *]>, N: Known {
    match(int_lt(i, N::VALUE)) {
        0 => true,
        _ => if(*element_at(a, i) == *element_at(b, i)) { fixed_same(a, b, int_add(i, 1)) } else { false }
    }
}

// Pairs in order: by the first, and then by the second. Texts as in a
// dictionary of character codes.
impl<A, B> Ord for (A, B) where A: Ord, B: Ord, A: Use<[0, *]> {
    fn <(x: (A, B), y: (A, B)) -> Bool { match((x, y)) { ((a, b), (c, d)) => a < c or { a == c and { b < d } } } }
}
impl Ord for Str {
    fn <(a: Str, b: Str) -> Bool {
        match((a, b)) {
            (_, StrEnd) => false,
            (StrEnd, _) => true,
            (StrChar(c, x), StrChar(d, y)) =>
                match(int_lt(char_bits(c), char_bits(d))) {
                    0 => match(int_eq(char_bits(c), char_bits(d))) { 0 => false, _ => x < y },
                    _ => true
                }
        }
    }
}

// A character is its code: any but the codes kept for pairs, up to 10FFFF.
impl Eq for char { fn ==(a: char, b: char) -> Bool { bool(int_eq(char_bits(a), char_bits(b))) } }
impl Ord for char { fn <(a: char, b: char) -> Bool { bool(int_lt(char_bits(a), char_bits(b))) } }
impl ToInt for char { fn int(c: char) -> Int { char_bits(c) } }
fn char(code: Int) -> Option<char> {
    match(int_add(int_lt(code, 0), int_add(int_lt(1114111, code),
            int_mul(int_lt(55295, code), int_lt(code, 57344))))) {
        0 => Some(char_of(code)),
        _ => None
    }
}

// Floating point. `f64_add` and the rest take and give the bits.
impl Add for f64 { fn +(a: f64, b: f64) -> f64 { f64_of(f64_add(f64_bits(a), f64_bits(b))) } }
impl Sub for f64 { fn -(a: f64, b: f64) -> f64 { f64_of(f64_sub(f64_bits(a), f64_bits(b))) } }
impl Mul for f64 { fn *(a: f64, b: f64) -> f64 { f64_of(f64_mul(f64_bits(a), f64_bits(b))) } }
impl Div for f64 { fn /(a: f64, b: f64) -> f64 { f64_of(f64_div(f64_bits(a), f64_bits(b))) } }
// Not `0.0 - a`, which is `0.0` where this is `-0.0`.
impl Neg for f64 { fn negate(a: f64) -> f64 { f64_of(f64_sub(-9223372036854775808, f64_bits(a))) } }
impl Eq for f64 {
    fn ==(a: f64, b: f64) -> Bool { bool(f64_eq(f64_bits(a), f64_bits(b))) }
    fn !=(a: f64, b: f64) -> Bool { not bool(f64_eq(f64_bits(a), f64_bits(b))) }
}
// Not one from another by `not`: nothing is smaller than a NaN, or larger.
impl Ord for f64 {
    fn <(a: f64, b: f64) -> Bool { bool(f64_lt(f64_bits(a), f64_bits(b))) }
    fn >(a: f64, b: f64) -> Bool { bool(f64_lt(f64_bits(b), f64_bits(a))) }
    fn <=(a: f64, b: f64) -> Bool { bool(int_add(f64_lt(f64_bits(a), f64_bits(b)), f64_eq(f64_bits(a), f64_bits(b)))) }
    fn >=(a: f64, b: f64) -> Bool { bool(int_add(f64_lt(f64_bits(b), f64_bits(a)), f64_eq(f64_bits(a), f64_bits(b)))) }
}
impl ToInt for f64 { fn int(x: f64) -> Int { f64_to_int(f64_bits(x), 0) } }

// What a floating point number has beside arithmetic. `round` is to the
// nearest whole number, a half to the even one.
trait Real {
    fn sqrt(Self) -> Self
    fn floor(Self) -> Self
    fn ceil(Self) -> Self
    fn trunc(Self) -> Self
    fn round(Self) -> Self
}
// How far from zero, as a value of the same type.
trait Abs { fn abs(Self) -> Self }
impl Abs for Int { fn abs(n: Int) -> Int { match(int_lt(n, 0)) { 0 => n, _ => int_sub(0, n) } } }
impl Abs for f64 { fn abs(x: f64) -> f64 { f64_of(int_and(f64_bits(x), 9223372036854775807)) } }
impl Abs for f32 { fn abs(x: f32) -> f32 { narrow(abs(widen(x))) } }
impl Real for f64 {
    fn sqrt(x: f64) -> f64 { f64_of(f64_sqrt(f64_bits(x), 0)) }
    fn floor(x: f64) -> f64 { f64_of(f64_round(f64_bits(x), 0)) }
    fn ceil(x: f64) -> f64 { f64_of(f64_round(f64_bits(x), 1)) }
    fn trunc(x: f64) -> f64 { f64_of(f64_round(f64_bits(x), 2)) }
    fn round(x: f64) -> f64 { f64_of(f64_round(f64_bits(x), 3)) }
}
fn f64(n: Int) -> f64 { f64_of(f64_of_int(n, 0)) }

// A 32-bit number is computed with as a 64-bit one and the result brought
// back to the nearest it can hold, which is the nearest to the true result.
fn widen(x: f32) -> f64 { f64_of(f64_widen(f32_bits(x), 0)) }
fn narrow(x: f64) -> f32 { f32_of(f64_narrow(f64_bits(x), 0)) }
impl Add for f32 { fn +(a: f32, b: f32) -> f32 { narrow(widen(a) + widen(b)) } }
impl Sub for f32 { fn -(a: f32, b: f32) -> f32 { narrow(widen(a) - widen(b)) } }
impl Mul for f32 { fn *(a: f32, b: f32) -> f32 { narrow(widen(a) * widen(b)) } }
impl Div for f32 { fn /(a: f32, b: f32) -> f32 { narrow(widen(a) / widen(b)) } }
impl Neg for f32 { fn negate(a: f32) -> f32 { narrow(negate(widen(a))) } }
impl Eq for f32 {
    fn ==(a: f32, b: f32) -> Bool { widen(a) == widen(b) }
    fn !=(a: f32, b: f32) -> Bool { widen(a) != widen(b) }
}
impl Ord for f32 {
    fn <(a: f32, b: f32) -> Bool { widen(a) < widen(b) }
    fn >(a: f32, b: f32) -> Bool { widen(a) > widen(b) }
    fn <=(a: f32, b: f32) -> Bool { widen(a) <= widen(b) }
    fn >=(a: f32, b: f32) -> Bool { widen(a) >= widen(b) }
}
impl ToInt for f32 { fn int(x: f32) -> Int { int(widen(x)) } }
impl Real for f32 {
    fn sqrt(x: f32) -> f32 { narrow(sqrt(widen(x))) }
    fn floor(x: f32) -> f32 { narrow(floor(widen(x))) }
    fn ceil(x: f32) -> f32 { narrow(ceil(widen(x))) }
    fn trunc(x: f32) -> f32 { narrow(trunc(widen(x))) }
    fn round(x: f32) -> f32 { narrow(round(widen(x))) }
}
fn f32(n: Int) -> f32 { narrow(f64(n)) }

impl Show for f64 {
    fn fmt(x: &f64) -> Str {
        let bits = f64_bits(*x);
        match(int_lt(bits, 0)) {
            0 => float_text(0, bits, bits, 0, 9218868437227405312),
            _ =>
                let rest = int_sub(bits, -9223372036854775808);
                float_text(1, rest, rest, 0, 9218868437227405312)
        }
    }
}

impl Show for f32 {
    fn fmt(x: &f32) -> Str {
        let bits = f32_bits(*x);
        match(int_lt(bits, 2147483648)) {
            0 =>
                let rest = int_sub(bits, 2147483648);
                float_text(1, f64_widen(rest, 0), rest, 1, 2139095040),
            _ => float_text(0, f64_widen(bits, 0), bits, 1, 2139095040)
        }
    }
}
