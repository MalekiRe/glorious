
// How large a value of a type is, and how it is aligned, in bytes, as the
// specification lays types out (4.4): its fields in their order, each at its
// alignment; an enum a tag where it has more than one constructor, then the
// widest of its constructors' fields. A type with no fields and one
// constructor is nothing (`size_of<()>()` is 0). Every type has one: the
// lowering lays it out from the type (`Lower.Layout`), as Rust's
// `size_of::<T>()` is the compiler's, `T` known at each copy of what asks
// (`FnSig.targs`).
fn size_of<T>() -> Int { let p: *mut T = PtrMut(usize_of(0)); usize_bits(size_of_at(p)) }
fn align_of<T>() -> Int { let p: *mut T = PtrMut(usize_of(0)); usize_bits(align_of_at(p)) }
// A type with one value, which is nothing: no payload, no finalizer (the
// specification's `nil_represented`, 4): `()`, a struct with no fields, a
// tuple or struct of such. Each that is has it, and no other.
trait NilRepresented {}

// What a value is in memory: its bytes from an address, as its type lays
// them out, written there and read back. Writing one moves it into memory
// (what was there neither given back nor destroyed), and reading one copies
// what is there: which of them may be done when is the caller's to get right
// (`std::ptr`).
unsafe fn repr_store<T>(at: usize, value: T) where T: Use<[1, 1]> { let p: *mut T = PtrMut(at); overwrite(ptr_mut_ref_at(p, at), value) }
unsafe fn repr_load<T>(at: usize) -> T { let p: *mut T = PtrMut(at); read_out(ptr_ref_at(p, at)) }
// (An address so many bytes on.)
fn repr_at(at: usize, offset: Int) -> usize { usize_of(int_add(usize_bits(at), offset)) }
