// Queues and heaps: collections changed where they are, through a `&mut`
// reference, in the shape the library specification gives them (16).

use std::vec::{Vec};
// (Where Rust keeps its maps and sets.)
pub use std::hash::{HashMap, HashSet};

// A queue with two ends. What is at the front is kept turned round, so that
// both ends are the ends of a `Vec`: putting and taking at either end takes
// time that does not grow with the queue, counted over many of them.
pub struct VecDeque<T> { front: Vec<T>, back: Vec<T> }

// The elements of one onto the other, last first.
fn turned<T>(from: &mut Vec<T>, onto: &mut Vec<T>) where T: Use<[1, 1]> {
    match(Vec::pop(from)) {
        Some(last) => Vec::push(onto, last); tail turned(from, onto),
        None => ()
    }
}

impl<T> VecDeque<T> {
    pub fn new() -> Self { Self { front: Vec::new(), back: Vec::new() } }
    pub fn from_vec(items: Vec<T>) -> Self where T: Use<[1, 1]> { Self { front: Vec::new(), back: items } }
    pub fn into_vec(value: Self) -> Vec<T> where T: Use<[1, 1]> {
        match(value) { VecDeque { front, back } =>
            let mut f = front;
            let mut out = Vec::new();
            turned(&mut f, &mut out);
            Vec::append(&mut out, back);
            out }
    }
    pub fn len(value: &Self) -> Int { Vec::len(&value.front) + Vec::len(&value.back) }
    pub fn is_empty(value: &Self) -> Bool { VecDeque::len(value) == 0 }
    pub fn push_back(value: &mut Self, item: T) where T: Use<[1, 1]> { Vec::push(&mut value.back, item) }
    pub fn push_front(value: &mut Self, item: T) where T: Use<[1, 1]> { Vec::push(&mut value.front, item) }
    pub fn pop_front(value: &mut Self) -> Option<T> where T: Use<[1, 1]> {
        // With nothing kept at the front, what is at the back is turned
        // round to be it.
        if(Vec::len(&value.front) == 0) { turned(&mut value.back, &mut value.front) } else { () };
        Vec::pop(&mut value.front)
    }
    pub fn pop_back(value: &mut Self) -> Option<T> where T: Use<[1, 1]> {
        if(Vec::len(&value.back) == 0) { turned(&mut value.front, &mut value.back) } else { () };
        Vec::pop(&mut value.back)
    }
    // The element so far from the front, by reference.
    pub fn get<'a>(value: &'a Self, index: Int) -> Option<&'a T> where T: Use<[1, 1]> {
        let ahead = Vec::len(&value.front);
        if(index < ahead) { Vec::get(&value.front, ahead - 1 - index) } else { Vec::get(&value.back, index - ahead) }
    }
    pub fn front<'a>(value: &'a Self) -> Option<&'a T> where T: Use<[1, 1]> { VecDeque::get(value, 0) }
    pub fn back<'a>(value: &'a Self) -> Option<&'a T> where T: Use<[1, 1]> { VecDeque::get(value, VecDeque::len(value) - 1) }
}

// A heap: the greatest element is the one taken. Its elements are compared
// by copying, so they are of a type used any number of times.
pub struct BinaryHeap<T> { items: Vec<T> }

fn at<T>(a: &Vec<T>, i: Int) -> T where T: Use<[0, *]> { *Vec::index(a, i) }

// The element at `i` moved up to where nothing above it is smaller.
fn rise<T>(a: &mut Vec<T>, i: Int) where T: Ord, T: Use<[0, *]> {
    if(i == 0) { () } else {
        let parent = (i - 1) / 2;
        if(at(&*a, parent) < at(&*a, i)) { std::value::discard(Vec::swap(a, parent, i)); tail rise(a, parent) } else { () }
    }
}

// The element at `i` moved down to where nothing below it is greater.
fn sink<T>(a: &mut Vec<T>, i: Int, n: Int) where T: Ord, T: Use<[0, *]> {
    let left = 2 * i + 1;
    let right = left + 1;
    let over_left = if(left < n) { if(at(&*a, i) < at(&*a, left)) { left } else { i } } else { i };
    let most = if(right < n) { if(at(&*a, over_left) < at(&*a, right)) { right } else { over_left } } else { over_left };
    if(most == i) { () } else { std::value::discard(Vec::swap(a, i, most)); tail sink(a, most, n) }
}

fn heapify<T>(a: &mut Vec<T>, i: Int) where T: Ord, T: Use<[0, *]> {
    if(i < 0) { () } else { let n = Vec::len(&*a); sink(a, i, n); tail heapify(a, i - 1) }
}

impl<T> BinaryHeap<T> {
    pub fn new() -> Self { Self { items: Vec::new() } }
    pub fn from_vec(items: Vec<T>) -> Self where T: Ord, T: Use<[0, *]> {
        let mut all = items;
        let n = Vec::len(&all);
        heapify(&mut all, n / 2);
        Self { items: all }
    }
    pub fn into_vec(value: Self) -> Vec<T> where T: Use<[1, 1]> { match(value) { BinaryHeap { items } => items } }
    // Greatest first.
    pub fn into_sorted_vec(value: Self) -> Vec<T> where T: Ord, T: Use<[0, *]> {
        let mut heap = value;
        let mut out = Vec::new();
        while({ BinaryHeap::len(&heap) > 0 }, { match(BinaryHeap::pop(&mut heap)) { Some(top) => Vec::push(&mut out, top), None => () } });
        out
    }
    pub fn len(value: &Self) -> Int { Vec::len(&value.items) }
    pub fn is_empty(value: &Self) -> Bool { Vec::len(&value.items) == 0 }
    pub fn peek<'a>(value: &'a Self) -> Option<&'a T> where T: Use<[1, 1]> { Vec::get(&value.items, 0) }
    pub fn push(value: &mut Self, item: T) where T: Ord, T: Use<[0, *]> {
        Vec::push(&mut value.items, item);
        let n = Vec::len(&value.items);
        rise(&mut value.items, n - 1)
    }
    pub fn pop(value: &mut Self) -> Option<T> where T: Ord, T: Use<[0, *]> {
        let n = Vec::len(&value.items);
        if(n == 0) { None } else {
            std::value::discard(Vec::swap(&mut value.items, 0, n - 1));
            let top = Vec::pop(&mut value.items);
            sink(&mut value.items, 0, n - 1);
            top
        }
    }
}
