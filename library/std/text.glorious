// Texts: `String`, owned, and `&str`, borrowed, are the prelude's, with their
// functions (`s.trim()`, `s.split(",")`, `owned.push_str(more)`); what is here
// is what is a function of neither.

pub use prelude::{String, Chars, AsStr};

// Texts one after another, with another between each two: Rust's `join` of
// a slice of them (of `&str`, of `String`, of anything written as text).
pub fn join<A, S>(parts: A, between: &str) -> String where A: Indexed<Element = S>, S: Display {
    let held = parts;
    let mut out = Formatter::new();
    let n = size_at(&held);
    let mut i = 0;
    while({ i < n }) {
        if(i > 0) { Formatter::write_str(&mut out, between) } else { () };
        Display::fmt(element_at(&held, i), &mut out);
        i = i + 1
    };
    match(Formatter::finish(out)) { Ok(text) => text, Err(_) => String::new() }
}
pub fn concat<A, S>(parts: A) -> String where A: Indexed<Element = S>, S: Display { join(parts, "") }

// Why bytes are not text.
pub enum Utf8Error { Invalid }

// Bytes as borrowed text, if they are UTF-8: Rust's `std::str::from_utf8`.
pub fn from_utf8<'a>(bytes: &'a [u8]) -> Result<&'a str, Utf8Error> {
    match(str_from_utf8(bytes)) { Some(text) => Ok(text), None => Err(Utf8Error::Invalid) }
}

// A text put to a width, in characters, with a character before it, or
// after it.
pub fn pad_start(text: &str, width: Int, with: char) -> String {
    let mut out = String::new();
    let mut n = char_count(text);
    while({ n < width }) { String::push(&mut out, with); n = n + 1 };
    String::push_str(&mut out, text);
    out
}
pub fn pad_end(text: &str, width: Int, with: char) -> String {
    let mut out = String::from(text);
    let mut n = char_count(text);
    while({ n < width }) { String::push(&mut out, with); n = n + 1 };
    out
}
fn char_count(text: &str) -> Int {
    let mut it = StrRef::chars(text);
    let mut n = 0;
    while({ it.next().is_some() }) { n = n + 1 };
    n
}

// Texts in order of their bytes. (Sorted by their views: a `String` is not
// copied to be compared.)
pub fn sort_strings(texts: Vec<String>) -> Vec<String> {
    let mut views: Vec<&str> = Vec::new();
    let mut i = 0;
    while({ i < len_at(&texts) }) { let text = &texts[i]; Vec::push(&mut views, text.as_str()); i = i + 1 };
    views.sort();
    let mut out = Vec::new();
    let mut k = 0;
    while({ k < len_at(&views) }) { Vec::push(&mut out, String::from(views[k])); k = k + 1 };
    out
}
