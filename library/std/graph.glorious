// Going over a graph from what each node leads to, as the library
// specification has it (26.2). The order found is the order the nodes and
// what they lead to are given in, never a table's.

use std::hash::{Hash, HashMap, HashSet};
use std::budget::{StepBudget, BudgetExceeded};
use std::vec::{Vec};

// Something with nodes, each leading to others.
pub trait Graph {
    type Node;
    fn successors(&Self, Self::Node) -> Vec<Self::Node>
}

// Nodes that lead round to the first of them.
pub struct Cycle<N> { pub nodes: Vec<N> }
pub enum GraphError<N> { Cycle(Cycle<N>), Limit(BudgetExceeded) }

// More onto a stack so that the first of them comes off first.
fn stacked<N>(stack: &mut Vec<N>, more: &mut Vec<N>) where N: Use<[0, *]> {
    match(Vec::pop(more)) { Some(last) => Vec::push(stack, last); tail stacked(stack, more), None => () }
}

fn reach<N: Eq + Hash, G: Graph<Node = N>>(graph: &G, stack: &mut Vec<N>, seen: &mut HashSet<N>, out: &mut Vec<N>, budget: &mut StepBudget)
    -> Result<(), BudgetExceeded> where N: Use<[0, *]> {
    match(Vec::pop(stack)) {
        None => Ok(()),
        Some(node) => match(StepBudget::charge(budget, 1)) {
            Err(e) => Err(e),
            Ok(_) =>
                if(HashSet::insert(seen, node)) {
                    stacked(stack, &mut successors(graph, node));
                    Vec::push(out, node)
                } else { () };
                tail reach(graph, stack, seen, out, budget)
        }
    }
}

// Every node that can be got to from one, itself first, each once. A step
// is charged for each node looked at.
pub fn reachable<N: Eq + Hash, G: Graph<Node = N>>(graph: &G, start: N, budget: &mut StepBudget)
    -> Result<Vec<N>, BudgetExceeded> where N: Use<[0, *]> {
    let mut stack = Vec::new();
    Vec::push(&mut stack, start);
    let mut out = Vec::new();
    let mut seen = HashSet::new();
    match(reach(graph, &mut stack, &mut seen, &mut out, budget)) { Ok(_) => Ok(out), Err(e) => Err(e) }
}

// The nodes on the way from one of them to the end of the way.
fn way_from<N: Eq>(way: &Vec<N>, node: N, i: Int, found: Bool, out: &mut Vec<N>) where N: Use<[0, *]> {
    if(i >= Vec::len(way)) { () } else {
        let at = *Vec::index(way, i);
        let here = found or { at == node };
        if(here) { Vec::push(out, at) } else { () };
        tail way_from(way, node, i + 1, here, out)
    }
}

// Each of some nodes looked at in turn, and from it what it leads to: the
// nodes done with, each after all it leads to. (A node is being looked at,
// `1`, or done with, `2`; one met again while being looked at is on a way
// that comes back to itself.)
fn visit_each<N: Eq + Hash, G: Graph<Node = N>>(graph: &G, nodes: &Vec<N>, i: Int, state: &mut HashMap<N, Int>, done: &mut Vec<N>, way: &mut Vec<N>, budget: &mut StepBudget)
    -> Result<(), GraphError<N>> where N: Use<[0, *]> {
    if(i >= Vec::len(nodes)) { Ok(()) } else {
        let node = nodes[i];
        match(StepBudget::charge(budget, 1)) {
            Err(e) => Err(GraphError::Limit(e)),
            Ok(_) => match(state_of(&*state, node)) {
                Some(2) => visit_each(graph, nodes, i + 1, state, done, way, budget),
                Some(_) => let mut found = Vec::new(); way_from(&*way, node, 0, false, &mut found); Err(GraphError::Cycle(Cycle { nodes: found })),
                None =>
                    let next = successors(graph, node);
                    Vec::push(way, node);
                    std::value::discard(HashMap::insert(state, node, 1));
                    let below = visit_each(graph, &next, 0, state, done, way, budget);
                    std::value::discard(Vec::pop(way));
                    match(below) {
                        Ok(_) => Vec::push(done, node); std::value::discard(HashMap::insert(state, node, 2)); visit_each(graph, nodes, i + 1, state, done, way, budget),
                        Err(e) => Err(e)
                    }
            }
        }
    }
}

fn state_of<N: Eq + Hash>(state: &HashMap<N, Int>, node: N) -> Option<Int> where N: Use<[0, *]> {
    match(HashMap::get(state, &node)) { Some(n) => Some(*n), None => None }
}

fn copied<'a, N>(nodes: &'a [N], i: Int, out: &mut Vec<N>) where N: Use<[0, *]> {
    match(nodes.get(i)) { Some(node) => Vec::push(out, *node); tail copied(nodes, i + 1, out), None => () }
}

// The nodes that can be got to from those given, each before every node it
// leads to; or nodes that lead round in a circle, where there are some.
pub fn topological_order<'a, N: Eq + Hash, G: Graph<Node = N>>(graph: &G, nodes: &'a [N], budget: &mut StepBudget)
    -> Result<Vec<N>, GraphError<N>> where N: Use<[0, *]> {
    let mut given = Vec::new();
    copied(nodes, 0, &mut given);
    let mut done = Vec::new();
    let mut way = Vec::new();
    let mut state = HashMap::new();
    match(visit_each(graph, &given, 0, &mut state, &mut done, &mut way, budget)) {
        Ok(_) => Vec::reverse(&mut done); Ok(done),
        Err(e) => Err(e)
    }
}

// What is known while the groups are looked for: when each node was first
// seen, the earliest it can get back to, the nodes not yet in a group.
struct Search<N> { seen: HashMap<N, Int>, low: HashMap<N, Int>, open: HashMap<N, Bool>, stack: Vec<N>, next: Int, groups: Vec<Vec<N>> }

fn number<N: Eq + Hash>(m: &HashMap<N, Int>, node: N) -> Int where N: Use<[0, *]> { match(HashMap::get(m, &node)) { Some(n) => *n, None => 0 - 1 } }

fn lower<N: Eq + Hash>(s: &mut Search<N>, node: N, to: Int) where N: Use<[0, *]> {
    if(to < number(&s.low, node)) { std::value::discard(HashMap::insert(&mut s.low, node, to)) } else { () }
}

// The nodes at the top of the stack down to one of them, as a group.
fn closed<N: Eq + Hash>(s: &mut Search<N>, root: N, group: &mut Vec<N>) where N: Use<[0, *]> {
    match(Vec::pop(&mut s.stack)) {
        None => (),
        Some(node) =>
            std::value::discard(HashMap::insert(&mut s.open, node, false));
            Vec::push(group, node);
            if(node == root) { () } else { tail closed(s, root, group) }
    }
}

// A node seen for the first time: numbered, and not yet in a group.
fn entered<N: Eq + Hash>(s: &mut Search<N>, node: N) where N: Use<[0, *]> {
    let at = s.next;
    std::value::discard(HashMap::insert(&mut s.seen, node, at));
    std::value::discard(HashMap::insert(&mut s.low, node, at));
    std::value::discard(HashMap::insert(&mut s.open, node, true));
    Vec::push(&mut s.stack, node);
    s.next = at + 1
}

fn lowered<N: Eq + Hash>(s: &mut Search<N>, from: Option<N>, to: Int) where N: Use<[0, *]> {
    match(from) { Some(node) => lower(s, node, to), None => () }
}

// Each of the nodes one leads to, in turn. One not seen before is gone into,
// and is the root of a group if nothing under it gets back above it.
fn search_each<N: Eq + Hash, G: Graph<Node = N>>(graph: &G, from: Option<N>, nodes: &Vec<N>, i: Int, s: &mut Search<N>, budget: &mut StepBudget)
    -> Result<(), BudgetExceeded> where N: Use<[0, *]> {
    if(i >= Vec::len(nodes)) { Ok(()) } else {
        let to = nodes[i];
        let first = number(&s.seen, to);
        if(first < 0) {
            match(StepBudget::charge(budget, 1)) {
                Err(e) => Err(e),
                Ok(_) =>
                    entered(s, to);
                    let next = successors(graph, to);
                    match(search_each(graph, Some(to), &next, 0, s, budget)) {
                        Err(e) => Err(e),
                        Ok(_) =>
                            let reached = number(&s.low, to);
                            if(reached == number(&s.seen, to)) {
                                let mut group = Vec::new();
                                closed(s, to, &mut group);
                                Vec::push(&mut s.groups, group)
                            } else { () };
                            lowered(s, from, reached);
                            search_each(graph, from, nodes, i + 1, s, budget)
                    }
            }
        } else {
            let still = match(HashMap::get(&s.open, &to)) { Some(open) => *open, None => false };
            if(still) { lowered(s, from, first) } else { () };
            search_each(graph, from, nodes, i + 1, s, budget)
        }
    }
}

// The nodes that can be got to from those given, in groups: two nodes are
// in one group when each can be got to from the other. A group comes before
// any group that leads to it.
pub fn strongly_connected_components<'a, N: Eq + Hash, G: Graph<Node = N>>(graph: &G, nodes: &'a [N], budget: &mut StepBudget)
    -> Result<Vec<Vec<N>>, BudgetExceeded> where N: Use<[0, *]> {
    let mut s = Search { seen: HashMap::new(), low: HashMap::new(), open: HashMap::new(), stack: Vec::new(), next: 0, groups: Vec::new() };
    let mut given = Vec::new();
    copied(nodes, 0, &mut given);
    match(search_each(graph, None, &given, 0, &mut s, budget)) {
        Ok(_) => match(s) { Search { seen: _, low: _, open: _, stack: _, next: _, groups } => Ok(groups) },
        Err(e) => Err(e)
    }
}
