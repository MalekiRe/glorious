// What a compiler has to say about a program, kept as what it is (how bad,
// which code, where, with what beside it) and written out at the end, as the
// library specification has it (21).
//
// What a bag gives back is a `Vec`.

use std::source::{SourceMap, SourceSpan, SourceId};
use std::fmt::{FormatError};
use std::vec::{Vec, IntoIter};
use std::iterator::{Iterator, next};

pub enum Severity { Note, Warning, Error }

pub struct DiagnosticCode(u32)

impl DiagnosticCode {
    pub fn from_u32(value: u32) -> Self { DiagnosticCode(value) }
    pub fn to_u32(value: Self) -> u32 { value.0 }
}

// A place something is said of: the first is what the diagnostic is about.
struct Label { span: SourceSpan, text: String, primary: Bool }

pub struct Diagnostic { severity: Severity, code: DiagnosticCode, message: String, labels: Vec<Label>, notes: Vec<String>, helps: Vec<String> }

impl Diagnostic {
    pub fn new(severity: Severity, code: DiagnosticCode, message: &str) -> Self {
        Self { severity: severity, code: code, message: String::from(message), labels: Vec::new(), notes: Vec::new(), helps: Vec::new() }
    }
    pub fn primary(value: &mut Self, span: SourceSpan, label: &str) { Vec::push(&mut value.labels, Label { span: span, text: String::from(label), primary: true }) }
    pub fn secondary(value: &mut Self, span: SourceSpan, label: &str) { Vec::push(&mut value.labels, Label { span: span, text: String::from(label), primary: false }) }
    pub fn note(value: &mut Self, text: &str) { Vec::push(&mut value.notes, String::from(text)) }
    pub fn help(value: &mut Self, text: &str) { Vec::push(&mut value.helps, String::from(text)) }
    pub fn is_error(value: &Self) -> Bool { rank(&value.severity) == 0 }
    pub fn code(value: &Self) -> u32 { value.code.0 }
    pub fn message<'a>(value: &'a Self) -> &'a str { String::as_str(&value.message) }
}

// Errors first.
fn rank(s: &Severity) -> Int { match(s) { &Severity::Error => 0, &Severity::Warning => 1, &Severity::Note => 2 } }
fn word(s: &Severity, out: &mut String) {
    match(s) { &Severity::Error => String::push_str(out, "error"), &Severity::Warning => String::push_str(out, "warning"), &Severity::Note => String::push_str(out, "note") }
}

// Where a diagnostic is put among others: by the text its first primary
// place is in, then how far in, then how bad, then its code. One with no
// place comes after those that have one.
fn first_place(labels: &Vec<Label>, i: Int) -> (Int, Int) {
    match(element(labels, i)) {
        None => (4294967296, 0),
        Some(label) => if(label.primary) { (int(SourceId::to_u32(label.span.source)), label.span.start) } else { first_place(labels, i + 1) }
    }
}
fn comes_before(a: &Diagnostic, b: &Diagnostic) -> Bool {
    let pa = first_place(&a.labels, 0);
    let pb = first_place(&b.labels, 0);
    if(pa.0 != pb.0) { pa.0 < pb.0 } else {
        if(pa.1 != pb.1) { pa.1 < pb.1 } else {
            if(rank(&a.severity) != rank(&b.severity)) { rank(&a.severity) < rank(&b.severity) } else { int(a.code.0) < int(b.code.0) }
        }
    }
}

// Diagnostics up to a limit: one more is given back, not lost.
pub struct DiagnosticBag { items: Vec<Diagnostic>, limit: Int, errors: Int }

impl DiagnosticBag {
    pub fn new(limit: Int) -> Self { Self { items: Vec::new(), limit: limit, errors: 0 } }
    pub fn push(value: &mut Self, diagnostic: Diagnostic) -> Result<(), Diagnostic> {
        if(Vec::len(&value.items) >= value.limit) { Err(diagnostic) } else {
            value.errors = value.errors + (if(Diagnostic::is_error(&diagnostic)) { 1 } else { 0 });
            Vec::push(&mut value.items, diagnostic);
            Ok(())
        }
    }
    pub fn len(value: &Self) -> Int { Vec::len(&value.items) }
    pub fn has_errors(value: &Self) -> Bool { value.errors > 0 }
    // Every diagnostic, in the order above; those the order does not tell
    // apart stay as they were pushed.
    pub fn into_vec(value: Self) -> Vec<Diagnostic> {
        match(value) { DiagnosticBag { items, limit, errors } =>
            let mut each = Vec::into_iter(items);
            let mut placed = Vec::new();
            in_order(&mut each, &mut placed);
            placed }
    }
}

// Each put where it belongs among those already placed: after every one
// it does not come before.
fn in_order(left: &mut IntoIter<Diagnostic>, placed: &mut Vec<Diagnostic>) {
    match(next(left)) {
        None => (),
        Some(d) => placed_at(placed, d); tail in_order(left, placed)
    }
}
fn placed_at(placed: &mut Vec<Diagnostic>, d: Diagnostic) {
    let at = place_of(&*placed, &d, 0);
    std::value::discard(Vec::insert(placed, at, d))
}
fn place_of(placed: &Vec<Diagnostic>, d: &Diagnostic, i: Int) -> Int {
    match(Vec::get(placed, i)) {
        None => i,
        Some(there) => if(comes_before(d, there)) { i } else { tail place_of(placed, d, i + 1) }
    }
}

pub struct RenderOptions { pub maximum_notes: Int, pub maximum_bytes: Int }

// A place as `name:line:column`, both counted from one; a place that is in
// no text the map has, or not in it, is `<unknown>`.
fn place_text(span: &SourceSpan, sources: &SourceMap, out: &mut String) {
    match(SourceMap::name(sources, span.source)) {
        None => String::push_str(out, "<unknown>"),
        Some(name) => match(SourceMap::locate(sources, span.source, span.start)) {
            Err(_) => String::push_str(out, "<unknown>"),
            Ok(at) =>
                String::push_str(out, name);
                String::push_str(out, ":");
                String::push_str(out, String::as_str(&to_string(&(at.line + 1))));
                String::push_str(out, ":");
                String::push_str(out, String::as_str(&to_string(&(at.column_bytes + 1))))
        }
    }
}

fn labels_text(labels: &Vec<Label>, sources: &SourceMap, out: &mut String) {
    let mut i = 0;
    while({ i < Vec::len(labels) }) {
        let label = Vec::index(labels, i);
        String::push_str(out, if(label.primary) { "  --> " } else { "  ::: " });
        place_text(&label.span, sources, out);
        if(String::is_empty(&label.text)) { () } else { String::push_str(out, ": "); String::push_str(out, String::as_str(&label.text)) };
        String::push_str(out, "\n");
        i = i + 1
    }
}

fn lines_text(kind: &str, lines: &Vec<String>, most: Int, out: &mut String) {
    let mut i = 0;
    let n = Vec::len(lines);
    while({ i < n and { i < most } }) {
        String::push_str(out, "  ");
        String::push_str(out, kind);
        String::push_str(out, ": ");
        String::push_str(out, String::as_str(Vec::index(lines, i)));
        String::push_str(out, "\n");
        i = i + 1
    };
    if(n > most) {
        String::push_str(out, "  (");
        String::push_str(out, String::as_str(&to_string(&(n - most))));
        String::push_str(out, " more)\n")
    } else { () }
}

// The diagnostic as text: its severity, code and message, each place, then
// its notes (as many as are allowed, and how many more there are) and what
// would help. Longer than is allowed, it is refused, not cut short.
pub fn render_diagnostic(value: &Diagnostic, sources: &SourceMap, options: RenderOptions) -> Result<String, FormatError> {
    let mut all = String::new();
    word(&value.severity, &mut all);
    String::push_str(&mut all, "[");
    String::push_str(&mut all, String::as_str(&to_string(&value.code.0)));
    String::push_str(&mut all, "]: ");
    String::push_str(&mut all, String::as_str(&value.message));
    String::push_str(&mut all, "\n");
    labels_text(&value.labels, sources, &mut all);
    lines_text("note", &value.notes, options.maximum_notes, &mut all);
    lines_text("help", &value.helps, Vec::len(&value.helps), &mut all);
    if(String::len(&all) > options.maximum_bytes) { Err(FormatError::OutputLimit) } else { Ok(all) }
}
