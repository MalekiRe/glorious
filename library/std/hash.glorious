// Hashing, and a map and a set that find a key in a step or two: a `Vec` of
// buckets, each the keys whose hash falls there, doubled when it fills. A
// map is changed where it is, as Rust's is; one whose earlier versions are
// kept is `std::map`'s.

use std::vec::{Vec};

// A whole number for a value: equal values have equal numbers.
pub trait Hash { fn hash(Self) -> Int }

// Mixing, kept within what `Int` holds: a multiply and a fold of the high
// bits into the low ones.
fn mix(h: Int) -> Int {
    let m = int_and(wide_mul(int_and(h, 4294967295), 2654435761), 9223372036854775807);
    int_xor(m, int_shr(m, 29))
}
pub fn combine(a: Int, b: Int) -> Int { mix(int_xor(mix(a), int_add(int_and(b, 4611686018427387903), 1))) }

impl Hash for Int { fn hash(n: Int) -> Int { mix(int_and(n, 9223372036854775807)) } }
impl Hash for char { fn hash(c: char) -> Int { mix(int(c)) } }
impl Hash for () { fn hash(u: ()) -> Int { 7 } }
impl Hash for Str {
    fn hash(text: Str) -> Int { hash_text(text, 5381) }
}
fn hash_text(text: Str, h: Int) -> Int {
    match(text) { StrEnd => h, StrChar(c, rest) => tail hash_text(rest, combine(h, int(c))) }
}
impl<A, B> Hash for (A, B) where A: Hash, B: Hash {
    fn hash(p: (A, B)) -> Int { match(p) { (a, b) => combine(hash(a), hash(b)) } }
}
impl<T> Hash for Array<T> where T: Hash, T: Use<[0, *]> {
    fn hash(a: Array<T>) -> Int { fold(a, 17, fn(h, x) { combine(h, hash(x)) }) }
}

// A map: its buckets, and how many keys it has. A key is hashed and
// compared as a value, so it is one that is copied (a number, a text); what
// a key stands for may be anything.
pub struct HashMap<K, V> { buckets: Vec<Vec<(K, V)>>, count: Int }

// So many empty buckets.
fn empty_buckets<K, V>(n: Int) -> Vec<Vec<(K, V)>> where K: Use<[1, 1]>, V: Use<[1, 1]> {
    let mut out = Vec::with_capacity(n);
    fill_empty(&mut out, n);
    out
}
fn fill_empty<K, V>(out: &mut Vec<Vec<(K, V)>>, n: Int) where K: Use<[1, 1]>, V: Use<[1, 1]> {
    if(n <= 0) { () } else { Vec::push(out, Vec::new()); tail fill_empty(out, n - 1) }
}

// Where a key is in a bucket. (Each pair is looked at where it is: what
// the key stands for may be no value that is copied.)
fn slot_in<K: Eq, V>(bucket: &Vec<(K, V)>, key: K, i: Int) -> Option<Int> where K: Use<[0, *]>, V: Use<[1, 1]> {
    match(Vec::get(bucket, i)) {
        Some(p) => match(p) { &(k, _) => if(*k == key) { Some(i) } else { tail slot_in(bucket, key, i + 1) } },
        None => None
    }
}

// Each pair of a bucket put in a map that is known not to have its key; the
// bucket, emptied, given back.
fn moved_into<K, V>(bucket: Vec<(K, V)>, to: &mut HashMap<K, V>) where K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
    let mut bucket = bucket;
    match(Vec::pop(&mut bucket)) {
        Some((k, v)) => HashMap::put_new(to, k, v); tail moved_into(bucket, to),
        None => match(Vec::finish_empty(bucket)) { Ok(_) => (), Err(rest) => tail moved_into(rest, to) }
    }
}
// Each bucket's pairs onto a `Vec`; the buckets, emptied, given back.
fn pairs_onto<K, V>(buckets: Vec<Vec<(K, V)>>, out: &mut Vec<(K, V)>) where K: Use<[1, 1]>, V: Use<[1, 1]> {
    let mut buckets = buckets;
    match(Vec::pop(&mut buckets)) {
        Some(bucket) => bucket_onto(bucket, out); tail pairs_onto(buckets, out),
        None => match(Vec::finish_empty(buckets)) { Ok(_) => (), Err(rest) => tail pairs_onto(rest, out) }
    }
}
fn bucket_onto<K, V>(bucket: Vec<(K, V)>, out: &mut Vec<(K, V)>) where K: Use<[1, 1]>, V: Use<[1, 1]> {
    let mut bucket = bucket;
    match(Vec::pop(&mut bucket)) {
        Some(pair) => Vec::push(out, pair); tail bucket_onto(bucket, out),
        None => match(Vec::finish_empty(bucket)) { Ok(_) => (), Err(rest) => tail bucket_onto(rest, out) }
    }
}
// The keys of the buckets from one on.
fn keys_onto<K, V>(buckets: &Vec<Vec<(K, V)>>, b: Int, i: Int, out: &mut Vec<K>) where K: Use<[0, *]>, V: Use<[1, 1]> {
    match(Vec::get(buckets, b)) {
        Some(bucket) =>
            match(Vec::get(bucket, i)) {
                Some(p) => match(p) { &(k, _) => Vec::push(out, *k); tail keys_onto(buckets, b, i + 1, out) },
                None => tail keys_onto(buckets, b + 1, 0, out)
            },
        None => ()
    }
}

impl<K, V> HashMap<K, V> {
    pub fn new() -> Self where K: Use<[1, 1]>, V: Use<[1, 1]> { Self { buckets: empty_buckets(8), count: 0 } }
    pub fn len(value: &Self) -> Int { value.count }
    pub fn is_empty(value: &Self) -> Bool { value.count == 0 }
    // The bucket a key falls in.
    fn bucket_of(value: &Self, key: K) -> Int where K: Hash, K: Use<[0, *]> { int_rem(hash(key), Vec::len(&value.buckets)) }
    pub fn contains_key(value: &Self, key: &K) -> Bool where K: Eq, K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        match(HashMap::get(value, key)) { Some(_) => true, None => false }
    }
    pub fn get<'a>(value: &'a Self, key: &K) -> Option<&'a V> where K: Eq, K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        let at = HashMap::bucket_of(value, *key);
        match(slot_in(&value.buckets[at], *key, 0)) {
            Some(i) => Some(&value.buckets[at][i].1),
            None => None
        }
    }
    pub fn get_mut<'a>(value: &'a mut Self, key: &K) -> Option<&'a mut V> where K: Eq, K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        let at = HashMap::bucket_of(&*value, *key);
        match(slot_in(&value.buckets[at], *key, 0)) {
            Some(i) => Some(&mut value.buckets[at][i].1),
            None => None
        }
    }
    // What the key stood for before, if anything.
    pub fn insert(value: &mut Self, key: K, item: V) -> Option<V> where K: Eq, K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        let at = HashMap::bucket_of(&*value, key);
        match(slot_in(&value.buckets[at], key, 0)) {
            Some(i) => Some(replace(&mut value.buckets[at][i].1, item)),
            None => std::value::discard(HashMap::insert_new(value, key, item)); None
        }
    }
    // What the key stood for, taken out.
    pub fn remove(value: &mut Self, key: &K) -> Option<V> where K: Eq, K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        let at = HashMap::bucket_of(&*value, *key);
        match(slot_in(&value.buckets[at], *key, 0)) {
            // (The last of the bucket takes its place.)
            Some(i) => match(Vec::swap_remove(&mut value.buckets[at], i)) {
                Some((_, v)) => value.count = value.count - 1; Some(v),
                None => None
            },
            None => None
        }
    }
    pub fn clear(value: &mut Self) where K: Use<[1, 1]>, V: Use<[1, 1]> {
        value.buckets = empty_buckets(8);
        value.count = 0
    }
    // The place of a key: what it stands for, or where it would.
    pub fn entry<'a>(value: &'a mut Self, key: K) -> Entry<'a, K, V> where K: Eq, K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        if(HashMap::contains_key(&*value, &key)) {
            match(HashMap::get_mut(value, &key)) { Some(v) => Occupied(v), None => unreachable("a key that is there") }
        } else { Vacant(value, key) }
    }
    // A key known not to be there, standing for the item from now on: where
    // the item now is.
    fn insert_new<'a>(value: &'a mut Self, key: K, item: V) -> &'a mut V where K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        if(value.count + 1 > Vec::len(&value.buckets)) { HashMap::regrow(value) } else { () };
        HashMap::put_new(value, key, item)
    }
    // The same, with room enough.
    fn put_new<'a>(value: &'a mut Self, key: K, item: V) -> &'a mut V where K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        let at = HashMap::bucket_of(&*value, key);
        Vec::push(&mut value.buckets[at], (key, item));
        value.count = value.count + 1;
        let last = Vec::len(&value.buckets[at]) - 1;
        &mut value.buckets[at][last].1
    }
    // Its keys and what they stand for, in no order one can rely on.
    pub fn into_entries(value: Self) -> Vec<(K, V)> where K: Use<[1, 1]>, V: Use<[1, 1]> {
        let mut out = Vec::with_capacity(value.count);
        pairs_onto(value.buckets, &mut out);
        out
    }
    // Its keys, in no order one can rely on.
    pub fn keys(value: &Self) -> Vec<K> where K: Use<[0, *]>, V: Use<[1, 1]> {
        let mut out = Vec::with_capacity(value.count);
        keys_onto(&value.buckets, 0, 0, &mut out);
        out
    }
    // A map of the pairs (an array, a `[(K, V); N]`, a `Vec`); a key given
    // twice stands for the later.
    pub fn from<A>(pairs: A) -> Self where A: std::vec::ToVec<Elem = (K, V)>, K: Eq, K: Hash, K: Use<[0, *]> {
        let mut all = std::vec::to_vec(pairs);
        Vec::reverse(&mut all);
        let mut m = HashMap::new();
        HashMap::insert_all(&mut m, all);
        m
    }
    fn insert_all(value: &mut Self, pairs: Vec<(K, V)>) where K: Eq, K: Hash, K: Use<[0, *]> {
        let mut pairs = pairs;
        match(Vec::pop(&mut pairs)) {
            Some((k, v)) => std::value::discard(HashMap::insert(value, k, v)); tail HashMap::insert_all(value, pairs),
            None => match(Vec::finish_empty(pairs)) { Ok(_) => (), Err(rest) => tail HashMap::insert_all(value, rest) }
        }
    }
    // With twice the buckets: each key moved to where it now falls.
    fn regrow(value: &mut Self) where K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        let size = Vec::len(&value.buckets) * 2;
        let old = replace(&mut value.buckets, empty_buckets(size));
        value.count = 0;
        let mut pairs = Vec::new();
        pairs_onto(old, &mut pairs);
        moved_into(pairs, value)
    }
}

// What a key stands for, or the map it would be put in.
pub enum Entry<'a, K, V> { Occupied(&'a mut V), Vacant(&'a mut HashMap<K, V>, K) }

impl<'a, K, V> Entry<'a, K, V> {
    // What it stands for; or, if nothing, the item, put there.
    pub fn or_insert(e: Self, item: V) -> &'a mut V where K: Hash, K: Use<[0, *]> {
        match(e) { Occupied(v) => v, Vacant(m, k) => HashMap::insert_new(m, k, item) }
    }
    pub fn or_insert_with<e: EffectRow>(e: Self, make: fn() -> V / {| e}) -> &'a mut V / {| e} where K: Hash, K: Use<[0, *]>, V: Use<[1, 1]> {
        match(e) { Occupied(v) => v, Vacant(m, k) => HashMap::insert_new(m, k, make()) }
    }
    pub fn or_insert_default(e: Self) -> &'a mut V where K: Hash, V: std::value::Default, K: Use<[0, *]>, V: Use<[1, 1]> {
        match(e) { Occupied(v) => v, Vacant(m, k) => HashMap::insert_new(m, k, std::value::default()) }
    }
}

// A set of values: a map from each to nothing.
pub struct HashSet<T>(HashMap<T, ()>)

impl<T> HashSet<T> {
    pub fn new() -> Self where T: Use<[1, 1]> { HashSet(HashMap::new()) }
    pub fn len(value: &Self) -> Int { HashMap::len(&value.0) }
    pub fn is_empty(value: &Self) -> Bool { HashMap::len(&value.0) == 0 }
    pub fn contains(value: &Self, item: &T) -> Bool where T: Eq, T: Hash, T: Use<[0, *]> {
        HashMap::contains_key(&value.0, item)
    }
    // Whether it was not there before.
    pub fn insert(value: &mut Self, item: T) -> Bool where T: Eq, T: Hash, T: Use<[0, *]> {
        match(HashMap::insert(&mut value.0, item, ())) { Some(_) => false, None => true }
    }
    // Whether it was there.
    pub fn remove(value: &mut Self, item: &T) -> Bool where T: Eq, T: Hash, T: Use<[0, *]> {
        match(HashMap::remove(&mut value.0, item)) { Some(_) => true, None => false }
    }
    pub fn clear(value: &mut Self) where T: Use<[1, 1]> { HashMap::clear(&mut value.0) }
    // Its values, in no order one can rely on.
    pub fn into_vec(value: Self) -> Vec<T> where T: Use<[0, *]> {
        match(value) { HashSet(m) => HashMap::keys(&m) }
    }
}
