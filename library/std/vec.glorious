// What has elements one after another: an array, a `[T; N]`, a `Vec`, a
// slice (`Indexed`). Nothing here changes what it is given; what each makes
// of elements is a `Vec`.

pub fn is_empty<T>(a: T) -> Bool where T: Len, T: Use<[1, 1]> { len(a) == 0 }

pub fn first<A, T>(a: A) -> Option<T> where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    if(size_at(&held) == 0) { None } else { Some(*element_at(&held, 0)) }
}
pub fn last<A, T>(a: A) -> Option<T> where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    let n = size_at(&held);
    if(n == 0) { None } else { Some(*element_at(&held, n - 1)) }
}

// The numbers from `from` up to, not including, `to`.
pub fn range(from: Int, to: Int) -> Vec<Int> { let mut out = Vec::new(); range_onto(from, to, &mut out); out }
fn range_onto(i: Int, to: Int, out: &mut Vec<Int>) {
    if(i < to) { Vec::push(out, i); tail range_onto(i + 1, to, out) } else { () }
}

// `n` elements, the one at each place what `f` gives for the place.
pub fn from_fn<T, e: EffectRow>(n: Int, f: fn(Int) -> T / {| e}) -> Vec<T> / {| e} { let mut out = Vec::new(); from_fn_onto(n, f, 0, &mut out); out }
fn from_fn_onto<T, e: EffectRow>(n: Int, f: fn(Int) -> T / {| e}, i: Int, out: &mut Vec<T>) / {| e} {
    if(i < n) { Vec::push(out, f(i)); tail from_fn_onto(n, f, i + 1, out) } else { () }
}

// The elements from `i` up to `to`, each copied onto `out`.
fn copy_onto<A, T>(a: &A, i: Int, to: Int, out: &mut Vec<T>) where A: Indexed<Element = T>, T: Use<[0, *]> {
    if(i < to) { Vec::push(out, *element_at(a, i)); tail copy_onto(a, i + 1, to, out) } else { () }
}
// The elements from `from` up to `to`.
fn between<A, T>(a: &A, from: Int, to: Int) -> Vec<T> where A: Indexed<Element = T>, T: Use<[0, *]> { let mut out = Vec::new(); copy_onto(a, from, to, &mut out); out }

pub fn map<A, T, U, e: EffectRow>(a: A, f: fn(T) -> U / {| e}) -> Vec<U> / {| e} where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    let mut out = Vec::new();
    map_elements_onto(&held, size_at(&held), f, 0, &mut out);
    out
}
fn map_elements_onto<A, T, U, e: EffectRow>(a: &A, n: Int, f: fn(T) -> U / {| e}, i: Int, out: &mut Vec<U>) / {| e} where A: Indexed<Element = T>, T: Use<[0, *]> {
    if(i < n) { Vec::push(out, f(*element_at(a, i))); tail map_elements_onto(a, n, f, i + 1, out) } else { () }
}

// The elements `keep` says yes to.
pub fn filter<A, T, U, V, e: EffectRow>(a: A, keep: fn(T) -> Result<U, V> / {| e}) -> Vec<T> / {| e} where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    let mut out = Vec::new();
    filter_onto(&held, size_at(&held), keep, 0, &mut out);
    out
}
fn filter_onto<A, T, U, V, e: EffectRow>(a: &A, n: Int, keep: fn(T) -> Result<U, V> / {| e}, i: Int, out: &mut Vec<T>) / {| e} where A: Indexed<Element = T>, T: Use<[0, *]> {
    if(i < n) {
        let x = *element_at(a, i);
        if(keep(x)) { Vec::push(out, x) } else { () };
        tail filter_onto(a, n, keep, i + 1, out)
    } else { () }
}

// Each element with its place.
pub fn enumerate<A, T>(a: A) -> Vec<(Int, T)> where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    let mut out = Vec::new();
    enumerate_onto(&held, size_at(&held), 0, &mut out);
    out
}
fn enumerate_onto<A, T>(a: &A, n: Int, i: Int, out: &mut Vec<(Int, T)>) where A: Indexed<Element = T>, T: Use<[0, *]> {
    if(i < n) { Vec::push(out, (i, *element_at(a, i))); tail enumerate_onto(a, n, i + 1, out) } else { () }
}

pub fn reverse<A, T>(a: A) -> Vec<T> where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    let mut out = Vec::new();
    reverse_onto(&held, size_at(&held), &mut out);
    out
}
fn reverse_onto<A, T>(a: &A, i: Int, out: &mut Vec<T>) where A: Indexed<Element = T>, T: Use<[0, *]> {
    if(i > 0) { Vec::push(out, *element_at(a, i - 1)); tail reverse_onto(a, i - 1, out) } else { () }
}

// One after another.
pub fn append<A, B, T>(a: A, b: B) -> Vec<T> where A: Indexed<Element = T>, B: Indexed<Element = T>, T: Use<[0, *]> {
    let x = a;
    let y = b;
    let mut out = Vec::new();
    copy_onto(&x, 0, size_at(&x), &mut out);
    copy_onto(&y, 0, size_at(&y), &mut out);
    out
}

// What has elements, each of what has elements: theirs one after another.
pub fn concat<A, B, T>(parts: A) -> Vec<T> where A: Indexed<Element = B>, B: Indexed<Element = T>, T: Use<[0, *]> {
    let held = parts;
    let mut out = Vec::new();
    concat_onto(&held, size_at(&held), 0, &mut out);
    out
}
fn concat_onto<A, B, T>(parts: &A, n: Int, i: Int, out: &mut Vec<T>) where A: Indexed<Element = B>, B: Indexed<Element = T>, T: Use<[0, *]> {
    if(i < n) { let part = element_at(parts, i); copy_onto(part, 0, size_at(part), out); tail concat_onto(parts, n, i + 1, out) } else { () }
}

// The first `n` elements, and the rest.
pub fn take<A, T>(a: A, n: Int) -> Vec<T> where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    let m = size_at(&held);
    between(&held, 0, if(n < m) { n } else { m })
}
pub fn drop<A, T>(a: A, n: Int) -> Vec<T> where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    let m = size_at(&held);
    between(&held, if(n < m) { n } else { m }, m)
}

// Pairs of the elements at the same places, as many as the shorter has.
pub fn zip<A, B, T, U>(a: A, b: B) -> Vec<(T, U)> where A: Indexed<Element = T>, B: Indexed<Element = U>, T: Use<[0, *]>, U: Use<[0, *]> {
    let x = a;
    let y = b;
    let n = if(size_at(&x) < size_at(&y)) { size_at(&x) } else { size_at(&y) };
    let mut out = Vec::new();
    zip_onto(&x, &y, n, 0, &mut out);
    out
}
fn zip_onto<A, B, T, U>(a: &A, b: &B, n: Int, i: Int, out: &mut Vec<(T, U)>) where A: Indexed<Element = T>, B: Indexed<Element = U>, T: Use<[0, *]>, U: Use<[0, *]> {
    if(i < n) { Vec::push(out, (*element_at(a, i), *element_at(b, i))); tail zip_onto(a, b, n, i + 1, out) } else { () }
}

// The place of the first element `wanted` says yes to.
pub fn position<A, T, V, W, e: EffectRow>(a: A, wanted: fn(T) -> Result<V, W> / {| e}) -> Option<Int> / {| e} where A: Indexed<Element = T>, T: Use<[0, *]>, V: Use<[1, 1]>, W: Use<[1, 1]> {
    let held = a;
    position_from(&held, size_at(&held), wanted, 0)
}
fn position_from<A, T, V, W, e: EffectRow>(a: &A, n: Int, wanted: fn(T) -> Result<V, W> / {| e}, i: Int) -> Option<Int> / {| e} where A: Indexed<Element = T>, T: Use<[0, *]> {
    if(i < n) {
        if(wanted(*element_at(a, i))) { Some(i) } else { tail position_from(a, n, wanted, i + 1) }
    } else { None }
}

// The first element `wanted` says yes to.
pub fn find<A, T, V, W, e: EffectRow>(a: A, wanted: fn(T) -> Result<V, W> / {| e}) -> Option<T> / {| e} where A: Indexed<Element = T>, T: Use<[0, *]>, V: Use<[1, 1]>, W: Use<[1, 1]> {
    let held = a;
    match(position_from(&held, size_at(&held), wanted, 0)) { Some(i) => Some(*element_at(&held, i)), None => None }
}

pub fn any<A, T, V, W, e: EffectRow>(a: A, wanted: fn(T) -> Result<V, W> / {| e}) -> Bool / {| e} where A: Indexed<Element = T>, T: Use<[0, *]>, V: Use<[1, 1]>, W: Use<[1, 1]> { match(position(a, wanted)) { Some(_) => true, None => false } }
pub fn all<A, T, V, W, e: EffectRow>(a: A, wanted: fn(T) -> Result<V, W> / {| e}) -> Bool / {| e} where A: Indexed<Element = T>, T: Use<[0, *]>, V: Use<[1, 1]>, W: Use<[1, 1]> { not any(a, { x => not wanted(x) }) }
pub fn contains<A, T>(a: A, x: T) -> Bool where A: Indexed<Element = T>, T: Eq, T: Use<[0, *]> { any(a, { y => y == x }) }

// How many elements `wanted` says yes to.
pub fn count<A, T, U, V, e: EffectRow>(a: A, wanted: fn(T) -> Result<U, V> / {| e}) -> Int / {| e} where A: Indexed<Element = T>, T: Use<[0, *]> { fold(a, 0, fn(n, x) { if(wanted(x)) { n + 1 } else { n } }) }

pub fn sum<A>(a: A) -> Int where A: Indexed<Element = Int> { fold(a, 0, fn(total, x) { total + x }) }
pub fn product<A>(a: A) -> Int where A: Indexed<Element = Int> { fold(a, 1, fn(total, x) { total * x }) }

// The least and the greatest, if there is any element.
pub fn minimum<A, T>(a: A) -> Option<T> where A: Indexed<Element = T>, T: Ord, T: Use<[0, *]> {
    let held = a;
    let n = size_at(&held);
    if(n == 0) { None } else { Some(least_from(&held, n, 1, *element_at(&held, 0))) }
}
fn least_from<A, T>(a: &A, n: Int, i: Int, m: T) -> T where A: Indexed<Element = T>, T: Ord, T: Use<[0, *]> {
    if(i < n) { let x = *element_at(a, i); tail least_from(a, n, i + 1, if(x < m) { x } else { m }) } else { m }
}
pub fn maximum<A, T>(a: A) -> Option<T> where A: Indexed<Element = T>, T: Ord, T: Use<[0, *]> {
    let held = a;
    let n = size_at(&held);
    if(n == 0) { None } else { Some(greatest_from(&held, n, 1, *element_at(&held, 0))) }
}
fn greatest_from<A, T>(a: &A, n: Int, i: Int, m: T) -> T where A: Indexed<Element = T>, T: Ord, T: Use<[0, *]> {
    if(i < n) { let x = *element_at(a, i); tail greatest_from(a, n, i + 1, if(m < x) { x } else { m }) } else { m }
}

// The array with the elements at two places changed over.
pub fn swap<T>(a: T, i: Int, j: Int) -> T where T: Index, T: Use<[0, *]> {
    let x = a[i];
    let y = a[j];
    index_set(index_set(a, i, y), j, x)
}

// The elements in order, by `<`. Elements that are equal stay as they were
// to each other.
pub fn sort<A, T>(a: A) -> Vec<T> where A: Indexed<Element = T>, T: Ord, T: Use<[0, *]> { sort_by(a, fn(x, y) { x < y }) }

// The elements in the order `before` gives: `before(x, y)` says `x` comes
// before `y`.
pub fn sort_by<A, T, e: EffectRow>(a: A, before: fn(T, T) -> Bool / {| e}) -> Vec<T> / {| e} where A: Indexed<Element = T>, T: Use<[0, *]> {
    let held = a;
    let mut out = between(&held, 0, size_at(&held));
    Vec::sort_by(&mut out, before);
    out
}

// Where `x` is among elements in order, or where it would go.
pub fn binary_search<A, T>(a: A, x: T) -> Result<Int, Int> where A: Indexed<Element = T>, T: Ord, T: Use<[0, *]> { let held = a; search_in(&held, x, 0, size_at(&held)) }
fn search_in<A, T>(a: &A, x: T, low: Int, high: Int) -> Result<Int, Int> where A: Indexed<Element = T>, T: Ord, T: Use<[0, *]> {
    if(low < high) {
        let mid = low + (high - low) / 2;
        let y = *element_at(a, mid);
        if(y < x) { tail search_in(a, x, mid + 1, high) }
        else { if(x < y) { tail search_in(a, x, low, mid) } else { Ok(mid) } }
    } else { Err(low) }
}

// The elements without one that is equal to the one before it.
pub fn dedup<A, T>(a: A) -> Vec<T> where A: Indexed<Element = T>, T: Eq, T: Use<[0, *]> {
    let held = a;
    let mut out = Vec::new();
    dedup_onto(&held, size_at(&held), 0, &mut out);
    out
}
fn dedup_onto<A, T>(a: &A, n: Int, i: Int, out: &mut Vec<T>) where A: Indexed<Element = T>, T: Eq, T: Use<[0, *]> {
    if(i < n) {
        let x = *element_at(a, i);
        if(i > 0 and { *element_at(a, i - 1) == x }) { () } else { Vec::push(out, x) };
        tail dedup_onto(a, n, i + 1, out)
    } else { () }
}

// `f(f(init, a0, b0), a1, b1)` and so on, of pairs one after another.
pub fn fold_pairs<A, T, U, V, e: EffectRow>(pairs: A, init: V, f: fn(V, T, U) -> V / {| e}) -> V / {| e} where A: Indexed<Element = (T, U)>, T: Use<[0, *]>, U: Use<[0, *]>, V: Use<[1, 1]> { fold(pairs, init, fn(acc, pair) { match(pair) { (a, b) => f(acc, a, b) } }) }

// How long an array is (the prelude's `len`, of arrays alone).
pub fn len_of<T>(a: [T]) -> Int where T: Use<[1, 1]> { len(a) }

// What gives all its elements away, as a `Vec` of them (`Vec::from_array`).
pub trait ToVec { type Elem; fn to_vec(Self) -> Vec<Elem> }
impl<T> ToVec for Vec<T> { type Elem = T; fn to_vec(v: Vec<T>) -> Vec<T> { v } }
impl<T> ToVec for [T] where T: Use<[1, 1]> { type Elem = T; fn to_vec(a: [T]) -> Vec<T> { of_array(a) } }
impl<T, N> ToVec for [T; N] where T: Use<[1, 1]> { type Elem = T; fn to_vec(a: [T; N]) -> Vec<T> { of_array(fixed_to_array(a)) } }
fn of_array<T>(items: [T]) -> Vec<T> where T: Use<[1, 1]> {
    let mut v = Vec::new();
    push_each(&mut v, turned(items, array_empty()));
    v
}

// A growable array changed where it is, in the shape the library
// specification gives it (15): functions of the type, `&mut Self` to change
// one, `Option<&T>` to look at an element. Sizes and places are `Int`. Its
// elements are in memory it allocates and frees, one after another, each laid
// out as its type is; it holds room for `cap` of them, and `len` are there.
use std::slice::{Slice, SliceIter};
use std::iterator::{Iterator, IntoIterator};

pub struct Vec<T> { at: *mut T, cap: Int, len: Int }

// The elements of one array onto another, last first.
fn turned<T>(from: [T], onto: [T]) -> [T] where T: Use<[1, 1]> {
    match(pop(from)) {
        Some((rest, last)) => tail turned(rest, push(onto, last)),
        None => onto
    }
}

// Each element of an array, last first, pushed.
fn push_each<T>(v: &mut Vec<T>, reversed: [T]) where T: Use<[1, 1]> {
    match(pop(reversed)) {
        Some((rest, x)) => Vec::push(v, x); push_each(v, rest),
        None => ()
    }
}

// The elements from `lo` up to `hi` in order: each half in order, then
// merged into `scratch` and moved back, each element's bytes.
fn sort_range<T, e: EffectRow>(v: &mut Vec<T>, scratch: usize, lo: Int, hi: Int, before: fn(T, T) -> Bool / {| e}) / {| e} where T: Use<[0, *]> {
    if(hi - lo > 1) {
        let mid = (lo + hi) / 2;
        sort_range(v, scratch, lo, mid, before);
        sort_range(v, scratch, mid, hi, before);
        let size = elem_size(&*v);
        let mut i = lo;
        let mut j = mid;
        let mut k = 0;
        while({ i < mid and { j < hi } }) {
            let from = if(before(*at_ref(&*v, j), *at_ref(&*v, i))) { j = j + 1; j - 1 } else { i = i + 1; i - 1 };
            unsafe { mem_copy(usize_of(usize_bits(scratch) + k * size), slot(&*v, from), usize_of(size)) };
            k = k + 1
        };
        // (What is left of the first half goes before the second's rest,
        // which is in its place already.)
        unsafe { mem_copy(usize_of(usize_bits(scratch) + k * size), slot(&*v, i), usize_of((mid - i) * size)) };
        let placed = k + mid - i;
        unsafe { mem_copy(slot(&*v, lo), scratch, usize_of(placed * size)) }
    } else { () }
}

// The elements of a `Vec` given away one by one, first to last; those not
// asked for are destroyed with it, and its memory freed.
pub struct IntoIter<T> { at: *mut T, cap: Int, len: Int, next: Int }
impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(it: &mut IntoIter<T>) -> Option<T> {
        if(it.next < it.len) {
            let v = Vec { at: it.at, cap: 0, len: 0 };
            let x = unsafe { take_at(&v, it.next) };
            unsafe { forget(v) };
            it.next = it.next + 1;
            Some(x)
        } else { None }
    }
}
impl<T> Drop for IntoIter<T> {
    fn drop(it: &mut IntoIter<T>) {
        let v = Vec { at: it.at, cap: 0, len: 0 };
        while({ it.next < it.len }) { std::value::discard(unsafe { take_at(&v, it.next) }); it.next = it.next + 1 };
        unsafe { forget(v) };
        if(it.cap > 0) { unsafe { mem_free(ptr_mut_address(it.at)) } } else { () };
        it.cap = 0
    }
}
// A value let go of without being destroyed: the caller's to get right.
unsafe fn forget<T>(value: T) { let _: VecParts<()> = transmute(value); () }

// What a `Vec` is, taken apart without its elements being destroyed.
struct VecParts<T> { at: *mut T, cap: Int, len: Int }
// A `Vec` taken apart, which nothing destroys; read field by field, so that
// what it holds is the type its parts point to.
fn parts_of<T>(value: Vec<T>) -> VecParts<T> { let parts = parts_at(&value); unsafe { forget(value) }; parts }
fn parts_at<T>(v: &Vec<T>) -> VecParts<T> { VecParts { at: v.at, cap: v.cap, len: v.len } }

// How many bytes one element takes.
fn elem_size<T>(v: &Vec<T>) -> Int { usize_bits(size_of_at(v.at)) }
// The address of the element at a place.
fn slot<T>(v: &Vec<T>, i: Int) -> usize { usize_of(usize_bits(ptr_mut_address(v.at)) + i * elem_size(v)) }
// The element at a place, which is there, by reference.
fn at_ref<'a, T>(v: &'a Vec<T>, i: Int) -> &'a T { unsafe { ptr_ref_at(v.at, slot(v, i)) } }
fn at_mut<'a, T>(v: &'a mut Vec<T>, i: Int) -> &'a mut T { let s = slot(&*v, i); let base = v.at; unsafe { ptr_mut_ref_at(base, s) } }
// The element at a place moved out, what is left there not to be used again.
unsafe fn take_at<T>(v: &Vec<T>, i: Int) -> T { read_out(at_ref(v, i)) }
// An element moved to a place where none is.
unsafe fn put_at<T>(v: &mut Vec<T>, i: Int, item: T) where T: Use<[1, 1]> { overwrite(at_mut(v, i), item) }
// The same, where the place is one an element was taken out of.
fn place<T>(v: &mut Vec<T>, i: Int, item: T) where T: Use<[1, 1]> { unsafe { put_at(v, i, item) } }
// So many elements moved, from one place to another, as if through a buffer.
unsafe fn move_within<T>(v: &mut Vec<T>, from: Int, to: Int, count: Int) {
    if(count > 0) { mem_copy(slot(&*v, to), slot(&*v, from), usize_of(count * elem_size(&*v))) } else { () }
}
// Room for at least so many in all: more memory, what is there moved to it.
fn reserve_total<T>(v: &mut Vec<T>, want: Int) {
    if(want > v.cap) {
        let size = elem_size(&*v);
        let doubled = if(v.cap == 0) { 4 } else { v.cap * 2 };
        let cap = if(doubled < want) { want } else { doubled };
        let fresh = unsafe { mem_alloc(usize_of(cap * size), align_of_at(v.at)) };
        if(v.cap > 0) {
            unsafe { mem_copy(fresh, ptr_mut_address(v.at), usize_of(v.len * size)); mem_free(ptr_mut_address(v.at)) }
        } else { () };
        v.at = ptr_mut_at(fresh);
        v.cap = cap
    } else { () }
}
// A place that is not there stops the program.
fn must_be_at<T>(v: &Vec<T>, i: Int) {
    if(i < 0 or { i >= v.len }) { abort("a place of a `Vec` that is not there") } else { () }
}

// The elements destroyed, and the memory freed.
impl<T> Drop for Vec<T> {
    fn drop(v: &mut Vec<T>) {
        while({ v.len > 0 }) { v.len = v.len - 1; std::value::discard(unsafe { take_at(&*v, v.len) }) };
        if(v.cap > 0) { unsafe { mem_free(ptr_mut_address(v.at)) } } else { () };
        v.cap = 0
    }
}

// `v[i]`, and `v[i] = x`: a place that is not there stops the program.
impl<T> Index for Vec<T> {
    type Elem = T;
    fn index(v: Vec<T>, i: Int) -> T { arr_get(Vec::into_array(v), i) }
    fn index_set(v: Vec<T>, i: Int, x: T) -> Vec<T> {
        let mut v = v;
        must_be_at(&v, i);
        std::value::discard(replace(at_mut(&mut v, i), x));
        v
    }
}
impl<T> Indexed for Vec<T> {
    type Element = T;
    fn element_at(v: &Vec<T>, i: Int) -> &T { must_be_at(v, i); at_ref(v, i) }
    fn size_at(v: &Vec<T>) -> Int { v.len }
}
impl<T> IndexedMut for Vec<T> {
    fn place_at(i: Int, v: &mut Vec<T>) -> &mut <Vec<T> as Indexed>::Element { must_be_at(&*v, i); at_mut(v, i) }
}
// Written as an array is: `[a, b]`.
impl<T> Show for Vec<T> where T: Show { fn fmt(v: &Vec<T>) -> Str { elements_text(v) } }
// Equal where each element is.
impl<T> Eq for Vec<T> where T: Eq, T: Use<[0, *]> {
    fn ==(a: Vec<T>, b: Vec<T>) -> Bool {
        if(a.len != b.len) { false } else {
            let mut i = 0;
            let mut same = true;
            while({ same and { i < a.len } }) { same = *at_ref(&a, i) == *at_ref(&b, i); i = i + 1 };
            same
        }
    }
}
impl<T> Len for Vec<T> { fn len(v: Vec<T>) -> Int { v.len } }

impl<T> Clone for Vec<T> where T: Clone, T: Use<[1, 1]> {
    fn clone(v: &Vec<T>) -> Vec<T> {
        let mut out = Vec::with_capacity(v.len);
        let mut i = 0;
        while({ i < v.len }) { Vec::push(&mut out, clone(at_ref(v, i))); i = i + 1 };
        out
    }
}

impl<T> Vec<T> {
    pub fn new() -> Self { Self { at: ptr_mut_at(0usize), cap: 0, len: 0 } }
    pub fn with_capacity(capacity: Int) -> Self { let mut v = Vec::new(); reserve_total(&mut v, capacity); v }
    // Of the elements of an array, a `[T; N]` or a `Vec`, given away.
    pub fn from_array<A>(items: A) -> Self where A: ToVec<Elem = T> { to_vec(items) }
    pub fn into_array(value: Self) -> [T] where T: Use<[1, 1]> {
        let parts = parts_of(value);
        let v = Vec { at: parts.at, cap: 0, len: 0 };
        let mut out = array_empty();
        let mut i = 0;
        while({ i < parts.len }) { push_at(&mut out, unsafe { take_at(&v, i) }); i = i + 1 };
        if(parts.cap > 0) { unsafe { mem_free(ptr_mut_address(parts.at)) } } else { () };
        out
    }
    pub fn len(value: &Self) -> Int { value.len }
    // Where its elements are.
    pub fn as_mut_ptr(value: &Self) -> *mut T { value.at }
    pub fn is_empty(value: &Self) -> Bool { value.len == 0 }
    pub fn get<'a>(value: &'a Self, index: Int) -> Option<&'a T> where T: Use<[1, 1]> {
        if(index < 0 or { index >= value.len }) { None } else { Some(at_ref(value, index)) }
    }
    pub fn get_mut<'a>(value: &'a mut Self, index: Int) -> Option<&'a mut T> where T: Use<[1, 1]> {
        if(index < 0 or { index >= value.len }) { None } else { Some(at_mut(value, index)) }
    }
    pub fn first<'a>(value: &'a Self) -> Option<&'a T> where T: Use<[1, 1]> { Vec::get(value, 0) }
    pub fn last<'a>(value: &'a Self) -> Option<&'a T> where T: Use<[1, 1]> { Vec::get(value, value.len - 1) }
    pub fn push(value: &mut Self, item: T) where T: Use<[1, 1]> {
        let n = value.len;
        reserve_total(value, n + 1);
        unsafe { put_at(value, n, item) };
        value.len = n + 1
    }
    pub fn pop(value: &mut Self) -> Option<T> where T: Use<[1, 1]> {
        if(value.len == 0) { None } else { value.len = value.len - 1; Some(unsafe { take_at(&*value, value.len) }) }
    }
    // The item put at a place, what was there and after it moving up; the
    // item given back if there is no such place.
    pub fn insert(value: &mut Self, index: Int, item: T) -> Result<(), T> where T: Use<[1, 1]> {
        if(index < 0 or { index > value.len }) { Err(item) } else {
            let n = value.len;
            reserve_total(value, n + 1);
            unsafe { move_within(value, index, index + 1, n - index); put_at(value, index, item) };
            value.len = n + 1;
            Ok(())
        }
    }
    // The element at a place taken out, what was after it moving down.
    pub fn remove(value: &mut Self, index: Int) -> Option<T> {
        if(index < 0 or { index >= value.len }) { None } else {
            let taken = unsafe { take_at(&*value, index) };
            let n = value.len;
            unsafe { move_within(value, index + 1, index, n - index - 1) };
            value.len = n - 1;
            Some(taken)
        }
    }
    // Everything of another put after what is here.
    pub fn append(value: &mut Self, source: Self) where T: Use<[1, 1]> {
        let mut source = source;
        let n = source.len;
        let want = value.len + n;
        reserve_total(value, want);
        let mut i = 0;
        while({ i < n }) { let x = unsafe { take_at(&source, i) }; Vec::push(value, x); i = i + 1 };
        source.len = 0
    }
    pub fn reverse(value: &mut Self) where T: Use<[1, 1]> {
        let mut i = 0;
        let mut j = value.len - 1;
        while({ i < j }) {
            let a = unsafe { take_at(&*value, i) };
            let b = unsafe { take_at(&*value, j) };
            unsafe { put_at(value, i, b); put_at(value, j, a) };
            i = i + 1;
            j = j - 1
        }
    }
    // In order, by `<`, equal ones as they were to each other; or in the
    // order `before` gives.
    pub fn sort(value: &mut Self) where T: Ord, T: Use<[0, *]> { Vec::sort_by(value, { (a, b) => a < b }) }
    pub fn sort_by<e: EffectRow>(value: &mut Self, before: fn(T, T) -> Bool / {| e}) / {| e} where T: Use<[0, *]> {
        // (Merged a half at a time through memory of the same size, each
        // element moved as its bytes: stable, n log n.)
        let n = value.len;
        if(n > 1) {
            let scratch = unsafe { mem_alloc(usize_of(n * elem_size(&*value)), align_of_at(value.at)) };
            sort_range(value, scratch, 0, n, before);
            unsafe { mem_free(scratch) }
        } else { () }
    }
    // How many it holds room for without growing.
    pub fn capacity(value: &Self) -> Int { value.cap }
    pub fn reserve(value: &mut Self, additional: Int) { let want = value.len + additional; reserve_total(value, want) }
    pub fn shrink_to_fit(value: &mut Self) { () }
    // The element at a place, which must be there.
    pub fn index<'a>(value: &'a Self, index: Int) -> &'a T where T: Use<[1, 1]> { must_be_at(value, index); at_ref(value, index) }
    pub fn index_mut<'a>(value: &'a mut Self, index: Int) -> &'a mut T where T: Use<[1, 1]> { must_be_at(&*value, index); at_mut(value, index) }
    pub fn first_mut<'a>(value: &'a mut Self) -> Option<&'a mut T> where T: Use<[1, 1]> { Vec::get_mut(value, 0) }
    pub fn last_mut<'a>(value: &'a mut Self) -> Option<&'a mut T> where T: Use<[1, 1]> { let n = value.len; Vec::get_mut(value, n - 1) }
    // The element at a place, the last put in its place.
    pub fn swap_remove(value: &mut Self, index: Int) -> Option<T> where T: Use<[1, 1]> {
        if(index < 0 or { index >= value.len }) { None } else {
            let taken = unsafe { take_at(&*value, index) };
            let n = value.len - 1;
            if(index < n) { let last = unsafe { take_at(&*value, n) }; unsafe { put_at(value, index, last) } } else { () };
            value.len = n;
            Some(taken)
        }
    }
    // What is at a place, with another put there; or the other given back.
    pub fn replace(value: &mut Self, index: Int, item: T) -> Result<T, T> where T: Use<[1, 1]> {
        if(index < 0 or { index >= value.len }) { Err(item) } else { Ok(replace(at_mut(value, index), item)) }
    }
    // The elements at two places changed over.
    pub fn swap(value: &mut Self, left: Int, right: Int) -> Result<(), ()> where T: Use<[1, 1]> {
        let n = value.len;
        if(left < 0 or { right < 0 } or { left >= n } or { right >= n }) { Err(()) } else {
            if(left != right) {
                let a = unsafe { take_at(&*value, left) };
                let b = unsafe { take_at(&*value, right) };
                unsafe { put_at(value, left, b); put_at(value, right, a) }
            } else { () };
            Ok(())
        }
    }
    // The elements turned: the first `count` taken from the front to the back.
    pub fn rotate_left(value: &mut Self, count: Int) -> Result<(), ()> where T: Use<[1, 1]> {
        let n = value.len;
        if(count < 0 or { count > n }) { Err(()) } else {
            let rest = Vec::split_off_at(value, count);
            let front = replace(value, rest);
            Vec::append(value, front);
            Ok(())
        }
    }
    pub fn rotate_right(value: &mut Self, count: Int) -> Result<(), ()> where T: Use<[1, 1]> {
        let n = value.len;
        if(count < 0 or { count > n }) { Err(()) } else { Vec::rotate_left(value, n - count) }
    }
    // The elements from a place on, taken off into a new one.
    pub fn split_off(value: &mut Self, index: Int) -> Result<Self, ()> where T: Use<[1, 1]> {
        if(index < 0 or { index > value.len }) { Err(()) } else { Ok(Vec::split_off_at(value, index)) }
    }
    fn split_off_at(value: &mut Self, index: Int) -> Self where T: Use<[1, 1]> {
        let n = value.len;
        let mut off = Vec::with_capacity(n - index);
        let mut i = index;
        while({ i < n }) { let x = unsafe { take_at(&*value, i) }; Vec::push(&mut off, x); i = i + 1 };
        value.len = index;
        off
    }
    // So many elements: those after the length let go, or copies of the
    // fill put on.
    pub fn resize(value: &mut Self, length: Int, fill: T) where T: Use<[0, *]> {
        if(length < value.len) { Vec::truncate(value, length) }
        else { while({ value.len < length }) { Vec::push(value, fill) } }
    }
    // Those for which the test holds, kept in order; the rest let go.
    pub fn retain<e: EffectRow>(value: &mut Self, keep: for<'a> fn(&'a T) -> Bool / {| e}) / {| e} {
        let n = value.len;
        let mut kept = 0;
        let mut i = 0;
        while({ i < n }) {
            let x = unsafe { take_at(&*value, i) };
            if(keep(&x)) { place(value, kept, x); kept = kept + 1 } else { std::value::discard(x) };
            i = i + 1
        };
        value.len = kept
    }
    pub fn into_iter(value: Self) -> IntoIter<T> {
        let parts = parts_of(value);
        IntoIter { at: parts.at, cap: parts.cap, len: parts.len, next: 0 }
    }
    pub fn finish_empty(value: Self) -> Result<(), Self> {
        let parts = parts_of(value);
        if(parts.len == 0) {
            if(parts.cap > 0) { unsafe { mem_free(ptr_mut_address(parts.at)) } } else { () };
            Ok(())
        } else { Err(Vec { at: parts.at, cap: parts.cap, len: parts.len }) }
    }
    // Is a value equal to one of the elements?
    pub fn contains(value: &Self, item: &T) -> Bool where T: Eq, T: Use<[0, *]> {
        let mut i = 0;
        let mut found = false;
        while({ i < value.len and { not found } }) { if(*at_ref(value, i) == *item) { found = true } else { () }; i = i + 1 };
        found
    }
    pub fn extend(value: &mut Self, more: [T]) where T: Use<[1, 1]> { push_each(value, turned(more, array_empty())) }
    // Only so many kept: the rest are let go.
    pub fn truncate(value: &mut Self, length: Int) {
        while({ value.len > length and { value.len > 0 } }) {
            value.len = value.len - 1;
            std::value::discard(unsafe { take_at(&*value, value.len) })
        }
    }
    pub fn clear(value: &mut Self) { Vec::truncate(value, 0) }
    // The elements as a slice: looked at where they are.
    pub fn as_slice<'a>(value: &'a Self) -> Slice<'a, T> where T: Use<[1, 1]> { Slice::of_memory(value, value.at, value.len) }
    // Its elements, borrowed where they are.
    pub fn as_elements<'a>(value: &'a Self) -> SliceRef<'a, T> { unsafe { slice_at(value.at, value.len) } }
    // The elements one after another, by reference.
    pub fn iter<'a>(value: &'a Self) -> SliceIter<'a, T> where T: Use<[1, 1]> { Slice::iter(&Vec::as_slice(value)) }
}

// Of iterators and what gives its elements away (here, not in
// `std::iterator`, which this module uses).
impl<T> IntoIterator for Vec<T> { type Iter = IntoIter<T>; fn into_iter(v: Vec<T>) -> IntoIter<T> { Vec::into_iter(v) } }

// The values left, as a `Vec`.
pub fn collect<I: Iterator>(it: &mut I) -> Vec<I::Item> where I: Use<[1, 1]> {
    let mut out = Vec::new();
    collect_onto(it, &mut out);
    out
}
fn collect_onto<I: Iterator>(it: &mut I, out: &mut Vec<I::Item>) where I: Use<[1, 1]> {
    match(Iterator::next(it)) {
        Some(x) => Vec::push(out, x); tail collect_onto(it, out),
        None => ()
    }
}

// What a function makes of each value, as a `Vec`.
pub fn map_collect<I: Iterator, B, e: EffectRow>(it: &mut I, f: fn(I::Item) -> B / {| e}) -> Vec<B> / {| e} where I: Use<[1, 1]>, B: Use<[1, 1]> {
    let mut out = Vec::new();
    map_onto(it, f, &mut out);
    out
}
fn map_onto<I: Iterator, B, e: EffectRow>(it: &mut I, f: fn(I::Item) -> B / {| e}, out: &mut Vec<B>) / {| e} where I: Use<[1, 1]>, B: Use<[1, 1]> {
    match(Iterator::next(it)) {
        Some(x) => Vec::push(out, f(x)); tail map_onto(it, f, out),
        None => ()
    }
}

