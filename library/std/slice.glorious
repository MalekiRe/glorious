// Slices, `&'a [T]` and `&'a mut [T]`: the prelude's `SliceRef` and
// `SliceMut`, so many elements one after another from an address, borrowed;
// a `&[T; N]` and a `&Vec<T>` are one wherever one is wanted. Their
// functions are their own (`len`, `get`, `first`, `last`, `sub`,
// `split_at`, `split_first`, `iter`); iterating them is `std::iterator`'s.

pub use std::iterator::{Iterator};
