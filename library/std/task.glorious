// Work started and waited for, as the library specification has it (30.4),
// and tasks that take turns. Nothing here runs two things at once.

use std::generator::{Yield, yield, Coroutine, Generator, GeneratorStep, resume};
use std::vec::{Vec, IntoIter, ToVec};
use std::collections::{VecDeque};
use std::iterator::{Iterator, next};

// Work that was started: its result is had by waiting for it. A handle has
// to be given to `join` or `cancel_task`: there is no letting it go.
pub struct Task<T> { result: T }
impl Use<[1, 1]> for Task {}

pub enum TaskError { Cancelled, Failed, ProviderClosed }
pub enum CancelOutcome<T> { Cancelled, Completed(T) }

// Starting work that makes a `T`: whoever handles this says when it runs.
// Whoever asks is always answered, with the handle.
// (The work performs nothing, which is what lets a provider run it and be
// sure to answer.)
pub effect Spawn<T> { [1, 1] spawn(work: fn() -> T / {}) -> Task<T> }

// Waiting for work, and asking it to stop: what it made is never lost, and
// whoever asks is always answered.
pub effect TaskControl<T> {
    [1, 1] join(task: Task<T>) -> Result<T, TaskError>,
    [1, 1] cancel_task(task: Task<T>) -> CancelOutcome<T>
}

// The simplest provider: work runs where it is spawned, to its end, so
// waiting for it finds it done and asking it to stop finds it finished.
pub fn run_inline<T, R>(body: fn() -> R / {Spawn<T>, TaskControl<T>}) -> R where T: Use<[1, 1]>, R: Use<[1, 1]> {
    handle body() {
        spawn(work, k) => k(Task { result: work() }),
        join(task, k) => match(task) { Task { result } => k(Ok(result)) },
        cancel_task(task, k) => match(task) { Task { result } => k(CancelOutcome::Completed(result)) }
    }
}

// Giving way to the other tasks.
pub fn yield_now() / {Yield<(), ()>} { yield(()) }

// One step of each task still going, the first given first; then again
// with those that gave way, until none is left.
fn turns<T>(waiting: &mut VecDeque<(Int, Coroutine<(), (), T>)>, done: &mut Vec<(Int, T)>) where T: Use<[1, 1]> {
    match(VecDeque::pop_front(waiting)) {
        Some((i, task)) => match(resume(task, ())) {
            GeneratorStep::Yielded { value: _, rest: more } => VecDeque::push_back(waiting, (i, more)); tail turns(waiting, done),
            GeneratorStep::Complete(result) => Vec::push(done, (i, result)); tail turns(waiting, done)
        },
        None => ()
    }
}

fn numbered<T>(tasks: &mut IntoIter<Coroutine<(), (), T>>, waiting: &mut VecDeque<(Int, Coroutine<(), (), T>)>, done: &mut Vec<(Int, T)>, i: Int) where T: Use<[1, 1]> {
    match(next(tasks)) {
        Some(task) => VecDeque::push_back(waiting, (i, task)); tail numbered(tasks, waiting, done, i + 1),
        None => ()
    }
}

// What the task numbered `k` made taken out of what was made, as they ended.
fn numbered_at<T>(done: &Vec<(Int, T)>, k: Int, j: Int) -> Int {
    if(j >= Vec::len(done)) { j } else { match(Vec::get(done, j)) { Some(pair) => if((*pair).0 == k) { j } else { tail numbered_at(done, k, j + 1) }, None => j } }
}
fn made<T>(done: &mut Vec<(Int, T)>, k: Int, n: Int, out: &mut Vec<T>) where T: Use<[1, 1]> {
    if(k >= n) { () } else {
        let at = numbered_at(&*done, k, 0);
        match(Vec::swap_remove(done, at)) {
            Some((_, r)) => Vec::push(out, r),
            None => ()
        };
        tail made(done, k + 1, n, out)
    }
}

// Tasks that take turns (an array, a `[T; N]` or a `Vec` of them): each runs
// until it gives way with `yield_now` or ends, then the next, round and
// round. What each made, in the order the tasks were given.
pub fn round_robin<A, T>(tasks: A) -> Vec<T> where A: ToVec<Elem = Coroutine<(), (), T>>, T: Use<[1, 1]> {
    let mut given = Vec::into_iter(Vec::from_array(tasks));
    let mut waiting = VecDeque::new();
    let mut done = Vec::new();
    numbered(&mut given, &mut waiting, &mut done, 0);
    turns(&mut waiting, &mut done);
    let n = Vec::len(&done);
    let mut out = Vec::new();
    made(&mut done, 0, n, &mut out);
    out
}
