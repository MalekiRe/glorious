// Paths taken apart and put together as text, as the library specification
// has them (29.1), for paths written with `/`. Nothing here looks at a file
// system: a link is not followed, and a path is not shown to stay inside
// another.

use std::text::{join};
use std::vec::{Vec};

// A path, kept as it is written.
pub struct PathBuf { text: String }

pub enum PathComponent { Root, Current, Parent, Normal(String) }
pub enum PathError { InvalidEncoding, InvalidComponent, UnsupportedPrefix }

// The names between the `/`s, those that are nothing left out.
fn names<'a>(text: &'a str) -> Vec<&'a str> {
    let mut out = Vec::new();
    let parts = text.split("/");
    let mut i = 0;
    while({ i < Vec::len(&parts) }) {
        let part = *Vec::index(&parts, i);
        if(part.is_empty()) { () } else { Vec::push(&mut out, part) };
        i = i + 1
    };
    out
}

fn component(name: &str) -> PathComponent {
    if(name == ".") { PathComponent::Current } else { if(name == "..") { PathComponent::Parent } else { PathComponent::Normal(String::from(name)) } }
}

// The place of the last `.` in a name, if it has one after its first
// byte: a name that only begins with one has no extension.
fn last_dot(name: &str) -> Option<Int> {
    let mut i = name.len() - 1;
    let mut found = None;
    while({ found.is_none() and { i > 0 } }) { if(int(name.byte(i)) == 46) { found = Some(i) } else { () }; i = i - 1 };
    found
}

impl PathBuf {
    pub fn new() -> Self { Self { text: String::new() } }
    pub fn from_str(text: &str) -> Self { Self { text: String::from(text) } }
    pub fn as_str<'a>(p: &'a Self) -> &'a str { String::as_str(&p.text) }
    pub fn is_absolute(p: &Self) -> Bool { PathBuf::as_str(p).starts_with("/") }
    // What it is made of, in order: the root if it starts at it, then each
    // name, with `.` and `..` told from the others.
    pub fn components(p: &Self) -> Vec<PathComponent> {
        let mut out = Vec::new();
        if(PathBuf::is_absolute(p)) { Vec::push(&mut out, PathComponent::Root) } else { () };
        let parts = names(PathBuf::as_str(p));
        let mut i = 0;
        while({ i < Vec::len(&parts) }) { Vec::push(&mut out, component(*Vec::index(&parts, i))); i = i + 1 };
        out
    }
    // The last name, if the path ends in one.
    pub fn file_name<'a>(p: &'a Self) -> Option<&'a str> {
        let parts = names(PathBuf::as_str(p));
        let n = Vec::len(&parts);
        if(n == 0) { None } else {
            let last = *Vec::index(&parts, n - 1);
            if(last == "." or { last == ".." }) { None } else { Some(last) }
        }
    }
    // What follows the last `.` of the last name.
    pub fn extension<'a>(p: &'a Self) -> Option<&'a str> {
        match(PathBuf::file_name(p)) {
            None => None,
            Some(name) => match(last_dot(name)) { Some(at) => Some(name.slice(at + 1, name.len())), None => None }
        }
    }
    // The path without its last name: none for the root and for a path of
    // no names.
    pub fn parent(p: &Self) -> Option<PathBuf> {
        let parts = names(PathBuf::as_str(p));
        let n = Vec::len(&parts);
        if(n == 0) { None } else {
            let front = match(Vec::as_slice(&parts).sub(0, n - 1)) { Some(names) => names, None => abort("a path's names are there") };
            let before = join(front, "/");
            let mut text = String::new();
            if(PathBuf::is_absolute(p)) { String::push_str(&mut text, "/") } else { () };
            String::push_str(&mut text, String::as_str(&before));
            Some(PathBuf { text: text })
        }
    }
    // Another path after this one; one that starts at the root takes its
    // place.
    pub fn join(p: &Self, other: &Self) -> PathBuf {
        let mine = PathBuf::as_str(p);
        let theirs = PathBuf::as_str(other);
        if(theirs.starts_with("/") or { mine.is_empty() }) { PathBuf::from_str(theirs) } else {
            let mut text = String::from(mine);
            if(theirs.is_empty()) { () } else {
                if(mine.ends_with("/")) { () } else { String::push_str(&mut text, "/") };
                String::push_str(&mut text, theirs)
            };
            PathBuf { text: text }
        }
    }
    pub fn push(p: &mut Self, other: &Self) -> Result<(), PathError> {
        let joined = PathBuf::join(&*p, other);
        p.text = joined.text;
        Ok(())
    }
    // The last name taken off: whether there was one.
    pub fn pop(p: &mut Self) -> Bool {
        match(PathBuf::parent(&*p)) { Some(up) => p.text = up.text; true, None => false }
    }
}
