{
  "name": "grandiose",
  "displayName": "Grandiose",
  "description": "Language support for Grandiose: syntax highlighting, diagnostics, navigation, formatting via grand-lsp",
  "version": "0.1.0",
  "publisher": "grandiose-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MalekiRe/glorious.git"
  },
  "bugs": {
    "url": "https://github.com/MalekiRe/glorious/issues"
  },
  "homepage": "https://github.com/MalekiRe/glorious/tree/main/editors/vscode",
  "keywords": ["grandiose", "glorious", "language-server", "lsp"],
  "engines": {
    "node": ">=22",
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:grandiose"],
  "contributes": {
    "languages": [
      {
        "id": "grandiose",
        "aliases": ["Grandiose"],
        "extensions": [".glorious", ".gr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "grandiose",
        "scopeName": "source.grandiose",
        "path": "./syntaxes/grandiose.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Grandiose",
      "properties": {
        "grandiose.serverPath": {
          "type": "string",
          "default": "grand-lsp",
          "description": "Path to the grand-lsp executable (or `grand` to use `grand lsp`)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  },
  "scripts": {
    "validate": "node scripts/validate-manifest.mjs && node --check extension.js && vsce ls --no-yarn",
    "package": "npm run validate && vsce package --no-yarn --no-update-package-json"
  }
}
